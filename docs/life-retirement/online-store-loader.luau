({ f.position, point }, nil, \"move\", now)\n\t\t\tf.homing = (f.homing or 0) + 1\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\n-- A fly standing on a surface with its heading along the surface's normal (a flight that ended square on to the wall, a fly spawned on the wall) has no way to\n-- turn or walk and no frame to be drawn in: its heading is laid on the surface, head up a wall (along the world's up, or along -Z on a level face).\nfunction K.upright(f: any)\n\tlocal up = if math.abs(f.normal.Y) > 0.9 then Vector3.new(0, 0, -1) else Vector3.yAxis\n\tf.heading = (up - f.normal * up:Dot(f.normal)).Unit\n\tf.homeHeading = f.heading\nend\n\n-- The sidestep (a profile with body.sidestep): carries on one under way, or begins one when the fly is alert, watched from its own side and the perch behind\n-- is free. True while it is moving round.\nfunction K.sidestep(f: any, now: number, _dt: number): boolean\n\tlocal s = f.side\n\tif s ~= nil then\n\t\tlocal t = math.clamp((now - s.t0) / s.time, 0, 1)\n\t\tlocal u = 1 - t\n\t\tf.position = s.from * (u * u) + s.ctrl * (2 * u * t) + s.to * (t * t)\n\t\tif t >= 1 then\n\t\t\tf.side = nil\n\t\t\tf.normal = s.normal\n\t\t\tf.restSpot = f.position; f.homeHeading = f.heading; f.walkLeft = 0; f.fidgetUntil = 0\n\t\tend\n\t\treturn true\n\tend\n\tif f.state ~= \"ALERT\" or not f.senses.hasLastSeen or now < (f.sideNext or 0) then return false end\n\tlocal perch = f.perch\n\tif perch == nil or perch.behind == nil then return false end\n\tif (f.senses.lastSeenPosition - f.position):Dot(f.normal) <= 0 then return false end -- already on the far side from the spider\n\tlocal other: any = nil\n\tfor _, c in f.graph.perches do if c.id == perch.behind then other = c; break end end\n\tif other == nil or not other.valid or other.occupant ~= \"\" or other.reserved ~= \"\" then return false end\n\tlocal spec = f.profile.body.sidestep\n\tif perch.occupant == f.id then perch.occupant = \"\" end\n\tother.occupant = f.id\n\tf.perch = other\n\tlocal to = f.graph:rest(other)\n\tlocal round: Vector3 = perch.round or (f.position + to) / 2\n\tf.side = { from = f.position, to = to, ctrl = round * 2 - (f.position + to) / 2, t0 = now, time = spec.time, normal = other.normal }\n\tf.sideNext = now + spec.time + spec.rest\n\tf.sidesteps = (f.sidesteps or 0) + 1\n\treturn true\nend\n\n-- The profile of the same animal for the other part of the day, or nil when `p` is already the right one (or has none).\nfunction K.counterpart(p: any, dusk: boolean): any\n\tlocal name = if dusk then p.body.dusk else p.body.day\n\tif name == nil then return nil end\n\treturn (Species :: any)[name]\nend\n\n-- Dusk or day for a director of a kind with a dusk profile: swaps the director's profile (what it spawns) and every fly's.\nfunction K.light(d: any, dusk: boolean)\n\tlocal to = K.counterpart(d.p, dusk)\n\tif to == nil then return end\n\tlocal from = d.p\n\td.p = to\n\tfor _, f in d.flies do\n\t\tif f.profile == from then\n\t\t\tlocal rate = from.behavior.restless_per_s\n\t\t\tf.restlessRate = if rate > 0 then f.restlessRate / rate * to.behavior.restless_per_s else to.behavior.restless_per_s\n\t\t\tf.profile = to\n\t\t\tf.perchedSince = d.now\n\t\tend\n\tend\n\td.dusk = dusk\nend\n\n-- Whether an hour of the life clock is the moths' time: from `from` (dusk) through the night to `to` (dawn).\nfunction K.isDusk(hour: number, from: number, to: number): boolean\n\treturn hour >= from or hour < to\nend\n\n-- (ROBLOX-120) The ear (a profile with body.hear), each tick before the fly's senses: the spider at `stimulus` moving within range hushes it.\nfunction K.hear(f: any, now: number, dt: number, stimulus: Vector3)\n\tlocal h = f.profile.body.hear\n\tlocal last = f.heardFrom\n\tf.heardFrom = stimulus\n\tif last == nil or dt <= 0 or not f:alive() then return end\n\tif (stimulus - last).Magnitude / dt >= h.still and (stimulus - f.position).Magnitude <= h.range then\n\t\tif now >= (f.hushUntil or 0) then f.hushes = (f.hushes or 0) + 1 end\n\t\tf.hushUntil = now + h.hold\n\tend\n\tf.hushed = now < (f.hushUntil or 0) -- (what the drawing and the client's ears read, with no clock of the director's)\nend\n-- (ROBLOX-120) Whether it is hushed (it heard the spider lately): it holds still.\nfunction K.hushed(f: any, now: number): boolean\n\treturn f.profile.body.hear ~= nil and now < (f.hushUntil or 0)\nend\n-- (ROBLOX-120) Whether it is singing now: a chirping profile (the night's), a male (an odd serial), perched and calm, not hushed, alive.\nfunction K.chirping(f: any): boolean\n\treturn f.profile.body.chirp == true and f.serial % 2 == 1 and f.state == \"PERCHED\" and f.hop == nil and f.hushed ~= true and f:alive()\nend\n\n-- The grip on a struggling prey, each tick before the jaws' own step: a moth's first grip may slip, a crane fly may leave a leg, a cricket kicks (ROBLOX-120: its kicks\n-- take grip; the jaws' own step lets it go when the grip is gone). Returns \"slip\" or \"shed\" when the prey got away (it is out of the jaws and `escape` has taken it),\n-- else nil.\nfunction K.grip(feeding: any, escape: (any) -> ()): string?\n\tlocal f = feeding.held\n\tif f == nil or not feeding.struggling then return nil end\n\tlocal b = f.profile.body\n\tif b.kick ~= nil and feeding.elapsed > 0 then\n\t\tif f.kickAt == nil then f.kickAt = f.rng:draw(b.kick.first) end\n\t\tif feeding.elapsed >= f.kickAt then\n\t\t\tlocal strength = 1 - (feeding.tire or 0.5) * math.clamp(feeding.elapsed / math.max(feeding.venom, 1e-3), 0, 1)\n\t\t\tfeeding.grip -= b.kick.size * strength\n\t\t\tf.kicks = (f.kicks or 0) + 1\n\t\t\tf.kickAt = feeding.elapsed + f.rng:draw(b.kick.every)\n\t\tend\n\tend\n\tlocal what: string? = nil\n\tif b.slip_chance ~= nil and not f.slipDrawn then\n\t\tf.slipDrawn = true\n\t\tif f.rng:next() < b.slip_chance then what = \"slip\" end\n\tend\n\tif what == nil and b.shed_chance ~= nil and not f.shedDrawn then\n\t\tf.shedDrawn = true\n\t\tif f.rng:next() < b.shed_chance then f.shedAt = f.rng:draw(b.shed_after) end\n\tend\n\tif what == nil and f.shedAt ~= nil and feeding.elapsed >= f.shedAt then\n\t\tf.shedAt = nil\n\t\tf.legsLost = (f.legsLost or 0) + 1\n\t\twhat = \"shed\"\n\tend\n\tif what == nil then return nil end\n\tfeeding.held = nil\n\tfeeding.struggling = false\n\tfeeding.feeding = false\n\tfeeding.note = if what == \"slip\" then \"It slipped free.\" else \"It left a leg and got away.\"\n\tescape(f)\n\treturn what\nend\n\nreturn K\n",18728,3417754962},{"Shared/Prey/PreyMath","--!strict\n-- Frozen scripts/prey/prey_math.gd: explicit evidence, utility and swept-contact math.\nlocal M = {}\nlocal EPS = 1e-6\nfunction M.sweepClosest(a0: Vector3,a1: Vector3,b0: Vector3,b1: Vector3): (number,number)\n local d=a0-b0; local dv=a1-b1-d\n local t=if dv:Dot(dv)>EPS*EPS then math.clamp(-d:Dot(dv)/dv:Dot(dv),0,1) else 0\n return t,(d+dv*t).Magnitude\nend\nfunction M.apparentAngle(radius: number,distance: number): number return 2*math.atan(math.max(radius,0)/math.max(distance,EPS)) end\nfunction M.bearingRate(a: Vector3,b: Vector3,dt: number): number\n if dt<=EPS or a:Dot(a)<EPS or b:Dot(b)<EPS then return 0 end\n return math.deg(math.acos(math.clamp(a.Unit:Dot(b.Unit),-1,1)))/dt\nend\nfunction M.loomRate(old: number,angle: number,dt: number,scale: number): number\n return if dt<=EPS or angle<=EPS then 0 else scale*math.max(0,((angle-old)/dt)/angle)\nend\nfunction M.distanceWeight(d: number,full: number,zero: number): number\n if zero<=full then return if d<=full then 1 else 0 end\n return math.clamp((zero-d)/(zero-full),0,1)\nend\nfunction M.facingWeight(angle: number,front: number,rear: number,gain: number): number\n if angle<=front then return 1 end\n if angle>=rear or rear<=front then return gain end\n local t=(angle-front)/(rear-front); return 1+(gain-1)*t*t*(3-2*t)\nend\nfunction M.awarenessGain(motion: number,threshold: number,scale: number,distance: number,facing: number,visible: number,vigilance: number): number\n return if motion<=threshold or scale<=EPS then 0 else (motion-threshold)/scale*distance*facing*math.clamp(visible,0,1)*math.max(vigilance,0)\nend\nfunction M.integrateAwareness(a: number,gain: number,dt: number,decay: number,maximum: number): number\n return math.clamp(a+(if gain>0 then gain else -decay)*math.max(dt,0),0,maximum)\nend\nfunction M.threat(a: number,calm: number,flee: number): number\n if flee<=calm then return if a>=flee then 1 else 0 end\n return math.clamp((a-calm)/(flee-calm),0,1)\nend\nfunction M.scoreRest(w: any,fatigue: number,shelter: number,food: number,threat: number): number\n return w.rest_base+w.rest_fatigue*fatigue+w.rest_shelter*shelter+w.rest_food*food-w.rest_threat*threat\nend\nfunction M.scoreMove(w: any,restless: number,food: number,shelter: number,travel: number,fatigue: number,threat: number): number\n return w.move_restless*restless+w.move_food*food+w.move_shelter*shelter-w.move_travel*travel-w.move_fatigue*fatigue-w.move_threat*threat\nend\nfunction M.scoreFlee(w: any,threat: number,shelter: number,away: number,travel: number): number\n return threat*(w.flee_threat+w.flee_shelter*shelter+w.flee_away*away-w.flee_travel*travel)\nend\nfunction M.pickGoal(scores: {[string]:number},current: string,hysteresis: number): string\n local best,value=current,-math.huge\n for _,g in {'rest','move','flee'} do\n  if scores[g] then local v=scores[g]+(if g==current then hysteresis else 0); if v>value+1e-9 then best,value=g,v end end\n end\n return best\nend\nfunction M.pathLength(points: {Vector3}): number\n local total=0; for i=2,#points do total+=(points[i]-points[i-1]).Magnitude end; return total\nend\nfunction M.pointAt(points: {Vector3},s: number): Vector3\n if #points==0 then return Vector3.zero end\n if s<=0 or #points==1 then return points[1] end\n for i=2,#points do local n=(points[i]-points[i-1]).Magnitude\n  if s<=n then return if n<EPS then points[i-1] else points[i-1]:Lerp(points[i],s/n) end; s-=n\n end\n return points[#points]\nend\nfunction M.distanceToPath(points: {Vector3},p: Vector3): number\n if #points==0 then return math.huge end\n local best=(points[1]-p).Magnitude\n for i=2,#points do local a=points[i-1];local ab=points[i]-a\n  local t=if ab:Dot(ab)<EPS*EPS then 0 else math.clamp((p-a):Dot(ab)/ab:Dot(ab),0,1)\n  best=math.min(best,(a+ab*t-p).Magnitude)\n end\n return best\nend\nfunction M.targetSpeed(remaining: number,top: number,landing: number,slow: number): number\n return if slow<=EPS or remaining>=slow then top else landing+(top-landing)*math.clamp(remaining/slow,0,1)\nend\nfunction M.stepSpeed(speed: number,target: number,accel: number,dt: number): number\n return if speed>=target then target else math.min(speed+accel*dt,target)\nend\nfunction M.inView(cf: CFrame,fov: number,aspect: number,p: Vector3,margin: number): boolean\n local v=cf:PointToObjectSpace(p);if v.Z>=-EPS then return false end\n return math.atan2(math.abs(v.X),-v.Z)<=math.atan(math.tan(math.rad(fov)*.5)*math.max(aspect,.1))+math.rad(margin)\n  and math.atan2(math.abs(v.Y),-v.Z)<=math.rad(fov)*.5+math.rad(margin)\nend\nreturn M\n",4477,3501987459},{"Shared/Prey/PreyPopulation","--!strict\n-- Frozen prey_population.gd: delayed, twice-unseen vent entries; never teleport a replacement onto a perch.\nlocal R=require(script.Parent.PreyRandom)\nlocal P={};P.__index=P\nfunction P.new(profile: any,seed: number,target: number): any\n return setmetatable({p=profile,rng=R.new(seed),target=target,owed={},eligible={},rest={},nextCheck=0,entries=0,deferred=0},P)\nend\nfunction P.step(self: any,now: number,living: number,vents: {any},safe: (any)->boolean,enter: (any)->boolean)\n local missing=math.max(0,self.target-living)\n while #self.owed>missing do table.remove(self.owed) end\n while #self.owed<missing do table.insert(self.owed,now+self.rng:draw(self.p.replenish_delay_s)) end\n table.sort(self.owed)\n if #self.owed==0 or now<self.owed[1] or now<self.nextCheck then return end\n self.nextCheck=now+self.p.replenish_retry_s\n for _,vent in vents do\n  if now>=(self.rest[vent.id] or 0) and safe(vent) then\n   local old=self.eligible[vent.id]\n   self.eligible[vent.id]=now\n   if old and now-old<=self.p.replenish_retry_s*1.6+1e-6 and enter(vent) then\n    table.remove(self.owed,1);self.rest[vent.id]=now+6;self.eligible[vent.id]=nil;self.entries+=1;return\n   end\n  else self.eligible[vent.id]=nil end\n end\n self.deferred+=1\nend\nreturn P\n",1245,273397863},{"Shared/Prey/PreyRandom","--!strict\n-- A repeatable port stream (Park-Miller); Godot's random inputs are exported for parity fixtures.\nlocal R={};R.__index=R\nfunction R.new(seed: number): any return setmetatable({state=math.max(1,math.floor(seed)%2147483647)},R) end\nfunction R.next(self: any): number self.state=(self.state*16807)%2147483647;return self.state/2147483647 end\nfunction R.draw(self: any,pair: {number}): number return pair[1]+(pair[2]-pair[1])*self:next() end\n-- ROBLOX-106: a stream whose seed is a hash of whole numbers (FNV-1a, 32 bits, exact in doubles), drawn twice before use. The draws of W4's rules use it so that the\n-- streams of neighbouring days, nights, visits or legs are not fixed offsets of one another (a plain Park-Miller seed made from a linear mix gives first draws that step\n-- round the unit interval by a constant, which reads as a schedule).\nfunction R.mixed(...: number): any\n\tlocal h = 2166136261\n\tfor i = 1, select(\"#\", ...) do\n\t\tlocal v = math.floor((select(i, ...))) % 4294967296\n\t\tfor k = 0, 3 do\n\t\t\th = bit32.bxor(h, bit32.band(bit32.rshift(v, 8 * k), 255))\n\t\t\th = (h * 403 + bit32.lshift(h, 24)) % 4294967296 -- (h x 16777619, the FNV prime, mod 2^32: 16777619 = 2^24 + 403)\n\t\tend\n\tend\n\tlocal r = R.new(h % 2147483646 + 1)\n\tr:next()\n\tr:next()\n\treturn r\nend\nreturn R\n",1287,758420489},{"Shared/Prey/PreyWorld","--!strict\n-- The prey of the whole world (ROBLOX-96, W3): one Prey/PreyDirector per region that has prey, run only where the spider is. The sill's director is the one the\n-- client always had (`home`: its flies, its seed 914, its Feeding, which is the jaws and the only one that advances the reserves); the bed's is made from\n-- World/Garden.prey(region) with the region's own seed (WorldMap.seed) when the bed has first arrived whole and the spider is in it or beside it, and it keeps\n-- its own PreyRandom streams and its own clock ever after: crossing a seam rerolls nothing, and a region the spider has left simply waits (its clock stops) with its\n-- flies where they were. The gate is Client/WorldClient:regionReady (`world`): a region's director is never made, and never steps, while a box of the region may\n-- be missing, since every perch and every flight is a raycast. A neighbour's prey runs only when the farthest of its perches is inside ACTIVE_RADIUS (the\n-- streaming radius always sent) of the spider. The woodlice (Prey/Woodlouse) run beside the bed's director under the same gate, and are never swept.\n-- The directors share one set of casts (PreyDirector.casts: one probe, one set of closures) so a checkpoint names them once; the bed's director and its woodlice\n-- live in `garden` (the table Persistence/Checkpoint records as its `garden` root), so a rest under the stone keeps the bed's prey and puts it back where it was.\n-- ROBLOX-101 (W3b part A): the bestiary's prey, a director per kind per region (World/Garden.bestiary: springtails and leafhoppers in the bed, moths and crane\n-- flies on the wall and the outer sill), kept in the region's entry as `kinds` ({ [kind] = director }) and run in the spec's order beside W3's director, under the\n-- same gate. Each is made with its kind's profile, its own seed and the tier's target (`tier`: \"full\" or \"low\", the client's detail tier, read when a director is\n-- made). The moths and the crane flies follow the life clock's hour (`before`'s `hour`): restless from dusk through the night (Prey/PreyKinds.light). A moth's\n-- slip and a crane fly's shed leg are decided here, on the jaws, before their step (PreyKinds.grip), and the last of them is kept as `event` for the screen.\n-- The prey outside the sill never runs while the spider is on the sill itself (its neighbour the outer sill has prey now): the sill plays as it always did.\n-- ROBLOX-105 (W3b part B): the garden's ambient bugs that are not food (World/Garden.ambient: ladybirds on the bed's plants, millipedes and a snail on its soil\n-- and a harvestman in its litter, a harvestman on the house wall), a colony per kind per region (Prey/Ladybird, Millipede, Snail, Harvestman), kept in the\n-- region's entry as `ambient` ({ [kind] = colony }), made under the same gate and stepped beside the woodlice. None of them, and no longer the woodlice, is\n-- shown to the spider's senses: the perception modules know only movement, possible prey and fly-like prey, and a movement contact carries no name the HUD\n-- could caption \"not food\", so (Nathan's W3 call) they are left out of `percepts` rather than shown as movement the player might hunt. A strike that comes\n-- within one of them is refused (`event` { kind = \"refused\", prey = kind }, UI/PreyText) and the creature answers (a ladybird bleeds, a millipede coils, the\n-- snail withdraws, a woodlouse runs for cover); nothing of theirs is ever held.\nlocal PreyDirector = require(script.Parent.PreyDirector)\nlocal PreyKinds = require(script.Parent.PreyKinds)\nlocal Woodlouse = require(script.Parent.Woodlouse)\nlocal Ladybird = require(script.Parent.Ladybird)\nlocal Millipede = require(script.Parent.Millipede)\nlocal Snail = require(script.Parent.Snail)\nlocal Harvestman = require(script.Parent.Harvestman)\nlocal Ant = require(script.Parent.Ant) -- (ROBLOX-119: the meadow's ants)\nlocal Skater = require(script.Parent.Skater) -- (ROBLOX-122: the pond's water striders)\nlocal Species = require(script.Parent.Parent.Data.Species)\nlocal Garden = require(script.Parent.Parent.World.Garden)\nlocal Region = require(script.Parent.Parent.World.Region)\n\nlocal PreyWorld = {}\nPreyWorld.__index = PreyWorld\n\n-- (ROBLOX-105) The ambient colonies' classes by kind.\nPreyWorld.AMBIENT = { ladybird = Ladybird, millipede = Millipede, snail = Snail, harvestman = Harvestman, ant = Ant, skater = Skater } :: { [string]: any }\n-- (ROBLOX-105) Whether the woodlice and the ambient bugs are shown to the spider's senses (see the head of this file: they are not).\nPreyWorld.SENSED = false\n\n-- A neighbouring region's prey runs while its farthest perch is inside this many studs of the spider (Workspace.StreamingMinRadius, 96: what is always sent).\nPreyWorld.ACTIVE_RADIUS = 96\n\n-- `home`: the sill's director; `world`: the client's world (WorldClient: `region`, `home`, `map`, `regionReady`); `garden`: the table the checkpoint records\n-- ({ [regionId] = { prey = director?, bugs = woodlice? } }); `root`: the folder the casts include (nil: no engine, no director is ever made); `casts`: the home's\n-- casts, when it has them (PreyDirector.casts), else new ones.\nfunction PreyWorld.new(home: any, world: any, garden: { [string]: any }, root: Instance?, casts: any?): any\n\treturn setmetatable({\n\t\thome = home, world = world, garden = garden, root = root,\n\t\tcasts = casts or (if root ~= nil then PreyDirector.casts(root) else nil),\n\t\tclock = 0, -- a running clock for the drawing (the directors' own stop while they wait)\n\t\tactive = {} :: { string }, -- the regions whose prey ran this tick\n\t\tview = { flies = {}, feeding = home.feeding }, -- what the sound and the drawing read: the active flies and the jaws\n\t\tmade = 0, -- directors made so far\n\t\ttier = \"full\", -- (ROBLOX-101) the detail tier, for how many of the bestiary's prey a region holds\n\t\thour = nil :: number?, -- (ROBLOX-101) the life clock's hour, when the client gives it\n\t\tevent = nil :: any, -- (ROBLOX-101) the last prey that got out of the jaws by its own trick: { kind = \"slip\" | \"shed\", prey = prey kind }; (ROBLOX-105) or a strike refused\n\t\tstrikeEnd = -1, -- (ROBLOX-105) the ambient strike's window: open until this clock time\n\t\tstrikeMode = \"attached\", -- the motor's mode last tick\n\t\tstrikeFrom = nil :: Vector3?, -- where the spider was last tick\n\t\trefused = 0, -- strikes refused so far\n\t}, PreyWorld)\nend\n\n-- The farthest a region's prey can be from the spider: over the perches and vents of its directors where it has them, else of its specs (W3's and the\n-- bestiary's).\nlocal function reach(self: any, region: any, pos: Vector3): number\n\tlocal far = 0\n\tlocal function over(list: { any }) for _, p in list do far = math.max(far, (p.position - pos).Magnitude) end end\n\tif region.id == self.world.home then\n\t\tover(self.home.graph.perches); over(self.home.vents)\n\t\treturn far\n\tend\n\tlocal entry = self.garden[region.id] or {}\n\tlocal any = false\n\tlocal spec = Garden.prey(region)\n\tif entry.prey ~= nil then over(entry.prey.graph.perches); over(entry.prey.vents); any = true\n\telseif spec ~= nil then over(spec.perches); over(spec.vents); any = true end\n\tfor _, k in (Garden.bestiary(region) or {}) :: { any } do\n\t\tlocal d = if entry.kinds ~= nil then entry.kinds[k.kind] else nil\n\t\tif d ~= nil then over(d.graph.perches); over(d.vents) else over(k.perches); over(k.vents) end\n\t\tany = true\n\tend\n\treturn if any then far else math.huge\nend\n\n-- Whether a region has prey at all: the sill's (the home), or a kind Garden places prey in (W3's or the bestiary's). (ROBLOX-116: or woodlice or ambient bugs alone,\n-- as the hut garden's lawn by the trough and the stone has: every region of the test garden with those has prey too, so nothing there changes.)\nfunction PreyWorld.hasPrey(self: any, region: any): boolean\n\treturn region.id == self.world.home or Garden.prey(region) ~= nil or Garden.bestiary(region) ~= nil or Garden.bugs(region) ~= nil or Garden.ambient(region) ~= nil\nend\n\n-- The ids of the regions whose prey runs at this place: the spider's own, and each neighbour with prey whose farthest perch is within ACTIVE_RADIUS (none while\n-- the spider is on the sill itself: ROBLOX-101 keeps the sill as it was now that the outer sill has prey).\nfunction PreyWorld.activeAt(self: any, pos: Vector3): { string }\n\tlocal here = self.world.region\n\tlocal out: { string } = {}\n\tif self:hasPrey(here) then table.insert(out, here.id) end\n\tif here.id == self.world.home then return out end\n\tfor _, n in here.neighbors do\n\t\tlocal r = self.world.map.region(n.id)\n\t\tif r ~= nil and self:hasPrey(r) and reach(self, r, pos) <= PreyWorld.ACTIVE_RADIUS then table.insert(out, r.id) end\n\tend\n\treturn out\nend\n\n-- The region's director, made now if the region is whole and it has none yet (nil for a region with no prey, or one not yet whole). The sill's is the home.\nfunction PreyWorld.director(self: any, id: string): any\n\tif id == self.world.home then return self.home end\n\tlocal entry = self.garden[id]\n\tif entry ~= nil and entry.prey ~= nil then\n\t\tentry.prey.feeding = self.home.feeding -- (a return to a rest rebuilds the jaws: every director eats with the home's)\n\t\treturn entry.prey\n\tend\n\tlocal region = self.world.map.region(id)\n\tlocal spec = if region ~= nil then Garden.prey(region) else nil\n\tif spec == nil then return nil end\n\tif self.root == nil or not self.world:regionReady(id) then return nil end\n\tlocal d = PreyDirector.engine(self.root, Species.fungus_gnat_prototype, spec.seed, spec.target, false, spec, self.casts)\n\td.feeding = self.home.feeding -- one jaws, one reserve\n\tentry = entry or {}\n\tentry.prey = d\n\tself.garden[id] = entry\n\tself.made += 1\n\treturn d\nend\n\n-- The region's bestiary directors in the spec's order, each made now if the region is whole and it has none yet (an empty list for a region without any).\nfunction PreyWorld.kinds(self: any, id: string): { any }\n\tlocal out = {}\n\tif id == self.world.home then return out end\n\tlocal region = self.world.map.region(id)\n\tlocal specs = if region ~= nil then Garden.bestiary(region) else nil\n\tif specs == nil then return out end\n\tlocal entry = self.garden[id]\n\tfor _, spec in specs do\n\t\tlocal d = if entry ~= nil and entry.kinds ~= nil then entry.kinds[spec.kind] else nil\n\t\tif d == nil and self.root ~= nil and self.world:regionReady(id) then\n\t\t\tlocal target = if self.tier == \"low\" then spec.low else spec.target\n\t\t\td = PreyDirector.engine(self.root, (Species :: any)[spec.profile], spec.seed, target, false, spec, self.casts)\n\t\t\tentry = entry or {}\n\t\t\tentry.kinds = entry.kinds or {}\n\t\t\tentry.kinds[spec.kind] = d\n\t\t\tself.garden[id] = entry\n\t\t\tself.made += 1\n\t\tend\n\t\tif d ~= nil then\n\t\t\td.feeding = self.home.feeding -- (one jaws: a return to a rest rebuilds them)\n\t\t\ttable.insert(out, d)\n\t\tend\n\tend\n\treturn out\nend\n\n-- Every director of a region: W3's (the bed's gnats and aphids), then the bestiary's.\nfunction PreyWorld.directors(self: any, id: string): { any }\n\tlocal out = {}\n\tlocal d = self:director(id)\n\tif d ~= nil then table.insert(out, d) end\n\tfor _, k in self:kinds(id) do table.insert(out, k) end\n\treturn out\nend\n\n-- The region's woodlice, made with its director's gate (nil for a region without any, or one not yet whole).\nfunction PreyWorld.bugs(self: any, id: string): any\n\tif id == self.world.home then return nil end\n\tlocal entry = self.garden[id]\n\tif entry ~= nil and entry.bugs ~= nil then return entry.bugs end\n\tlocal region = self.world.map.region(id)\n\tlocal spec = if region ~= nil then Garden.bugs(region) else nil\n\tif spec == nil then return nil end\n\tif not self.world:regionReady(id) then return nil end\n\tlocal soil: any, boxes = nil, {}\n\tfor _, p in Region.pieces(region) do\n\t\tif p.id == region.id .. \"_soil\" then soil = { min = p.lo, max = p.hi }\n\t\telseif p.lo.Y <= region.origin.Y + 0.01 then table.insert(boxes, { min = p.lo, max = p.hi }) end\n\tend\n\tfor _, b in Garden.standingFrom(region) do table.insert(boxes, b) end -- (ROBLOX-107: the drainpipe's foot, wall_west's box, on a chunk of the bushes' litter)\n\tif soil == nil then return nil end\n\tlocal w = Woodlouse.new(spec, soil, boxes)\n\tentry = entry or {}\n\tentry.bugs = w\n\tself.garden[id] = entry\n\treturn w\nend\n\n-- The region's ambient colonies in Garden.AMBIENT's order, each made now if the region is whole and it has none yet (an empty list for a region without any).\n-- A colony on the soil needs the soil and the standing boxes, as the woodlice do.\nfunction PreyWorld.ambient(self: any, id: string): { any }\n\tlocal out = {}\n\tif id == self.world.home then return out end\n\tlocal region = self.world.map.region(id)\n\tlocal specs = if region ~= nil then Garden.ambient(region) else nil\n\tif specs == nil then return out end\n\tlocal entry = self.garden[id]\n\tlocal soil: any, boxes: { any }? = nil, nil\n\tfor _, spec in specs do\n\t\tlocal c = if entry ~= nil and entry.ambient ~= nil then entry.ambient[spec.kind] else nil\n\t\tif c == nil and self.world:regionReady(id) then\n\t\t\tlocal count = if self.tier == \"low\" then spec.low else spec.full\n\t\t\tif spec.surface == \"soil\" and soil == nil then\n\t\t\t\tboxes = {}\n\t\t\t\tfor _, p in Region.pieces(region) do\n\t\t\t\t\tif p.id == region.id .. \"_soil\" then soil = { min = p.lo, max = p.hi }\n\t\t\t\t\telseif p.lo.Y <= region.origin.Y + 0.01 then table.insert(boxes :: any, { min = p.lo, max = p.hi }) end\n\t\t\t\tend\n\t\t\t\tfor _, b in Garden.standingFrom(region) do table.insert(boxes :: any, b) end\n\t\t\tend\n\t\t\tif spec.kind == \"ladybird\" then c = Ladybird.new(spec, count, Garden.plants(region) or {})\n\t\t\telseif spec.kind == \"millipede\" and soil ~= nil then c = Millipede.new(spec, count, soil, boxes :: any)\n\t\t\telseif spec.kind == \"snail\" and soil ~= nil then c = Snail.new(spec, count, soil, boxes :: any)\n\t\t\telseif spec.kind == \"harvestman\" then c = Harvestman.new(spec, count, soil, boxes)\n\t\t\telseif spec.kind == \"ant\" and soil ~= nil then c = Ant.new(spec, count, soil, boxes)\n\t\t\telseif spec.kind == \"skater\" then c = Skater.new(spec, count) end\n\t\t\tif c ~= nil then\n\t\t\t\tentry = entry or {}\n\t\t\t\tentry.ambient = entry.ambient or {}\n\t\t\t\tentry.ambient[spec.kind] = c\n\t\t\t\tself.garden[id] = entry\n\t\t\tend\n\t\tend\n\t\tif c ~= nil then table.insert(out, c) end\n\tend\n\treturn out\nend\n\n-- Every percept of the active regions: their flies (the woodlice and the ambient bugs only if SENSED, as movement).\nfunction PreyWorld.percepts(self: any): { any }\n\tlocal out = {}\n\tfor _, id in self.active do\n\t\tfor _, d in self:directors(id) do for _, p in d:percepts() do table.insert(out, p) end end\n\t\tlocal w = if PreyWorld.SENSED then self:bugs(id) else nil\n\t\tif w ~= nil then for _, p in w:percepts() do table.insert(out, p) end end\n\tend\n\treturn out\nend\n\n-- Before the motor (the client's order): which regions are active at this place, then each active director's `before` and its woodlice.\n-- `hour` (ROBLOX-101): the life clock's hour, for the kinds that fly from dusk (nil: the last one given, or day).\nfunction PreyWorld.before(self: any, dt: number, position: Vector3, observer: any, sensor: any, cast: any, camera: any, hour: number?)\n\tself.clock += dt\n\tif hour ~= nil then self.hour = hour end\n\tself.active = self:activeAt(position)\n\tfor _, id in self.active do\n\t\tfor _, d in self:directors(id) do\n\t\t\tlocal dusk = Garden.BESTIARY.dusk\n\t\t\tif PreyKinds.counterpart(d.p, true) ~= nil or PreyKinds.counterpart(d.p, false) ~= nil then\n\t\t\t\tPreyKinds.light(d, self.hour ~= nil and PreyKinds.isDusk(self.hour, dusk.from, dusk.to))\n\t\t\tend\n\t\t\td:before(dt, position, observer, sensor, cast, camera)\n\t\tend\n\t\tlocal w = self:bugs(id)\n\t\tif w ~= nil then w:step(dt, position) end\n\t\tlocal list = self:ambient(id)\n\t\tif #list > 0 then\n\t\t\tlocal region = self.world.map.region(id)\n\t\t\tlocal aphids = {}\n\t\t\tlocal d = self:director(id)\n\t\t\tif d ~= nil then for _, f in d.flies do table.insert(aphids, f) end end\n\t\t\tlocal ctx = { hour = self.hour, flies = aphids, plants = if region ~= nil then Garden.plants(region) else nil, ripple = self.ripple } -- (ROBLOX-122: `ripple`, a spider struggling in the water: Life/Water)\n\t\t\tfor _, c in list do c:step(dt, position, ctx) end\n\t\tend\n\tend\nend\n\n-- Whether the home's prey ran this tick.\nfunction PreyWorld.homeActive(self: any): boolean\n\treturn table.find(self.active, self.world.home) ~= nil\nend\n\n-- A fly that tore free goes back to the director it belongs to (returned).\nfunction PreyWorld.escape(self: any, f: any): any\n\tif not self.home:owns(f) then\n\t\tfor _, entry in self.garden do\n\t\t\tif entry.prey ~= nil and entry.prey:owns(f) then entry.prey:escape(f); return entry.prey end\n\t\t\tfor _, d in entry.kinds or {} do\n\t\t\t\tif d:owns(f) then d:escape(f); return d end\n\t\t\tend\n\t\tend\n\tend\n\tself.home:escape(f)\n\treturn self.home\nend\n\n-- (ROBLOX-101) A prey that got out of the jaws by its own trick cannot be struck again for this long (seconds): it leaves from the spider's mouth while the\n-- strike that took it may still be open, and a slip that is caught again on the same tick would be no slip.\nPreyWorld.FREE_S = 0.5\n\n-- After the motor: the home's `after` always (the jaws, the reserves, once a tick; with no sweep where its prey did not run), every other active director's\n-- `afterShared`. Then the view the sound and the drawing read.\nfunction PreyWorld.after(self: any, dt: number, motor: any, sensor: any, cast: any)\n\tif not self:homeActive() then self.home.previousPosition = motor.pos end\n\t-- (ROBLOX-101) a moth's slip, a crane fly's shed leg: out of the jaws before they step\n\tlocal held = self.home.feeding.held\n\tlocal trick = PreyKinds.grip(self.home.feeding, function(f)\n\t\tlocal d = self:escape(f)\n\t\tf.freeUntil = d.now + PreyWorld.FREE_S\n\tend)\n\tif trick ~= nil then self.event = { kind = trick, prey = held.profile.body.prey_kind } end\n\tself.home:after(dt, motor, sensor, cast, function(f) self:escape(f) end)\n\tfor _, id in self.active do\n\t\tif id ~= self.world.home then\n\t\t\tfor _, d in self:directors(id) do d:afterShared(motor, sensor, cast) end\n\t\tend\n\tend\n\tself:strikeAmbient(motor)\n\tlocal flies = {}\n\tfor _, id in self.active do\n\t\tfor _, d in self:directors(id) do for _, f in d.flies do table.insert(flies, f) end end\n\tend\n\tself.view.flies = flies\n\tself.view.feeding = self.home.feeding\nend\n\n-- The active regions' flies, for the drawing and the notebook's watcher.\nfunction PreyWorld.flies(self: any): { any }\n\treturn self.view.flies\nend\n\n-- (ROBLOX-105) The strike against what is not food: a window opened by a leap (the motor's `launched` as it leaves the ground, as the directors' own) and closed\n-- just after it lands; while it is open and the jaws are empty, a sweep of the spider's body from last tick's place to this one against every woodlouse and\n-- ambient bug of the active regions. The first one within its radius (and the directors' 0.3) is refused: `event`, the creature's answer, the window shut.\nfunction PreyWorld.strikeAmbient(self: any, motor: any)\n\tlocal mode = motor.mode\n\tif mode == \"air\" and self.strikeMode ~= \"air\" then\n\t\tfor _, e in motor.events or {} do if e.kind == \"launched\" then self.strikeEnd = self.clock + 4; break end end\n\tend\n\tif self.strikeMode == \"air\" and mode ~= \"air\" then self.strikeEnd = math.min(self.strikeEnd, self.clock + 0.05) end\n\tself.strikeMode = mode\n\tlocal from = self.strikeFrom or motor.pos\n\tself.strikeFrom = motor.pos\n\tif self.clock > self.strikeEnd or self.home.feeding.held ~= nil then return end\n\tlocal seg = motor.pos - from\n\tlocal len2 = seg:Dot(seg)\n\tfor _, id in self.active do\n\t\tlocal colonies = {}\n\t\tlocal w = self:bugs(id)\n\t\tif w ~= nil then table.insert(colonies, { c = w, kind = \"woodlouse\" }) end\n\t\tfor _, c in self:ambient(id) do table.insert(colonies, { c = c, kind = c.kind }) end\n\t\tfor _, e in colonies do\n\t\t\tfor _, t in e.c:targets() do\n\t\t\t\tlocal u = if len2 > 1e-12 then math.clamp((t.position - from):Dot(seg) / len2, 0, 1) else 0\n\t\t\t\tif ((from + seg * u) - t.position).Magnitude <= t.radius + 0.3 then\n\t\t\t\t\te.c:struck(t.creature)\n\t\t\t\t\tself.event = { kind = \"refused\", prey = e.kind }\n\t\t\t\t\tself.refused += 1\n\t\t\t\t\tself.strikeEnd = -1\n\t\t\t\t\treturn\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- (ROBLOX-105) Every woodlouse and ambient bug of the active regions, for the drawing (Client/BugBodies: a creature with no `kind` is a woodlouse) and the\n-- notebook's close look.\nfunction PreyWorld.crawlers(self: any): { any }\n\tlocal out = {}\n\tfor _, id in self.active do\n\t\tlocal w = self:bugs(id)\n\t\tif w ~= nil then for _, l in w.lice do table.insert(out, l) end end\n\t\tfor _, c in self:ambient(id) do for _, b in c:creatures() do table.insert(out, b) end end\n\tend\n\treturn out\nend\n\n-- The active regions' woodlice, for the drawing.\nfunction PreyWorld.woodlice(self: any): { any }\n\tlocal out = {}\n\tfor _, id in self.active do\n\t\tlocal w = self:bugs(id)\n\t\tif w ~= nil then for _, l in w.lice do table.insert(out, l) end end\n\tend\n\treturn out\nend\n\n-- Every capture made, in every region.\nfunction PreyWorld.captures(self: any): number\n\tlocal n = self.home.captures\n\tfor _, entry in self.garden do\n\t\tif entry.prey ~= nil then n += entry.prey.captures end\n\t\tfor _, d in entry.kinds or {} do n += d.captures end\n\tend\n\treturn n\nend\n\nreturn PreyWorld\n",20920,3531897909},{"Shared/Prey/Skater","--!strict\n-- Water striders (ROBLOX-122, the pond's edge): ambient, not the spider's food here. Common water striders (Gerridae) on the open water of the pond's margin\n-- (World/Pond.LIFE.skaters): they stand on the surface on their long water-repellent middle and hind legs, row with the middle pair in a quick stroke and glide,\n-- turn, rest, and keep to the open water between the pads and the stems. They are predators of what falls onto the water and struggles there, the sources say, a\n-- spider among it, and they find it by its ripples: while the spider is struggling in the water (`ctx.ripple`, Life/Water through Prey/PreyWorld) the ones within\n-- RIPPLE turn and skate toward it, a few studs off. They do not harm it here (the struggle is the water's). By night they rest where they are. A strike at one is\n-- refused (Prey/PreyWorld, UI/PreyText): it skates off. Pure and seeded, no raycast; a checkpoint records the colony with the region's prey. The speeds are the game's.\nlocal R = require(script.Parent.PreyRandom)\n\nlocal Skaters = {}\nSkaters.__index = Skaters\n\nSkaters.HOVER = 0.15 -- the body's middle over the surface: up on its legs\nSkaters.BODY = 1.2 -- studs long: a strider of about 12 mm (the sources: 1/2 to 3/4 inch for the large one, Gerris under 1/2 inch)\nSkaters.RADIUS = 0.4\nSkaters.STROKE = { 18, 36 } -- studs a second at a stroke's start\nSkaters.DRAG = 3.2 -- how fast a glide slows (a second's share)\nSkaters.REST = { 0.4, 2.5 } -- seconds between strokes\nSkaters.EDGE = 2.0\nSkaters.RIPPLE = 60 -- studs: how far a struggling thing's ripples draw them\nSkaters.CLOSE = 5 -- and how near they come\nSkaters.NIGHT = { from = 20.5, to = 6.5 }\n\n-- `spec`: World/Pond.ambient's (kind \"skater\", `water` the open water's rectangle, `boxes` the stems, pads and stones it skates round); `count`: the tier's.\nfunction Skaters.new(spec: any, count: number): any\n\tlocal self: any = setmetatable({ kind = \"skater\", rng = R.new(spec.seed + 6011), now = 0, items = {}, boxes = {}, waterMin = spec.water.min, waterMax = spec.water.max }, Skaters)\n\tself.top = spec.water.max.Y\n\tfor _, b in (spec.boxes or {}) :: { any } do table.insert(self.boxes, { min = b.min, max = b.max }) end\n\tfor i, s in spec.starts do\n\t\tif i > count then break end\n\t\tlocal surf = Vector3.new(s.pos.X, self.top, s.pos.Z)\n\t\tlocal pos = surf + Vector3.yAxis * Skaters.HOVER\n\t\ttable.insert(self.items, {\n\t\t\tid = (spec.prefix or \"\") .. \"skater_\" .. i, kind = \"skater\", surface = surf, position = pos, prevPosition = pos, normal = Vector3.yAxis, heading = s.heading,\n\t\t\tspeed = 0, state = \"rest\", until_ = self.rng:draw(Skaters.REST), hidden = false,\n\t\t})\n\tend\n\treturn self\nend\n\n-- Whether a point of the surface is open water to skate: inside the rectangle, clear of what stands in it.\nfunction Skaters.free(self: any, p: Vector3): boolean\n\tif p.X < self.waterMin.X + Skaters.EDGE or p.X > self.waterMax.X - Skaters.EDGE or p.Z < self.waterMin.Z + Skaters.EDGE or p.Z > self.waterMax.Z - Skaters.EDGE then return false end\n\tfor _, b in self.boxes do\n\t\tif b.max.Y >= self.top - 0.5 and p.X > b.min.X - 0.8 and p.X < b.max.X + 0.8 and p.Z > b.min.Z - 0.8 and p.Z < b.max.Z + 0.8 then return false end\n\tend\n\treturn true\nend\n\nlocal function turned(h: Vector3, degrees: number): Vector3\n\treturn CFrame.fromAxisAngle(Vector3.yAxis, math.rad(degrees)):VectorToWorldSpace(h).Unit\nend\nlocal function night(hour: number?): boolean\n\treturn hour ~= nil and (hour >= Skaters.NIGHT.from or hour < Skaters.NIGHT.to)\nend\n\n-- One fixed tick. `ctx.hour`: the life clock's hour (nil: day); `ctx.ripple`: where something struggles in the water now (nil: nothing).\nfunction Skaters.step(self: any, dt: number, _spider: Vector3, ctx: any)\n\tself.now += dt\n\tlocal now = self.now\n\tlocal ripple: any = if ctx ~= nil then ctx.ripple else nil\n\tlocal resting = night(if ctx ~= nil then ctx.hour else nil)\n\tfor _, a in self.items do\n\t\ta.prevPosition = a.position\n\t\tlocal toward: any = nil\n\t\tif ripple ~= nil then\n\t\t\tlocal d = Vector3.new(ripple.X - a.surface.X, 0, ripple.Z - a.surface.Z)\n\t\t\tif d.Magnitude < Skaters.RIPPLE and d.Magnitude > Skaters.CLOSE then toward = d.Unit end\n\t\tend\n\t\tif a.state == \"glide\" then\n\t\t\ta.speed *= math.max(0, 1 - Skaters.DRAG * dt)\n\t\t\tlocal nextPos = a.surface + a.heading * (a.speed * dt)\n\t\t\tif self:free(nextPos) then\n\t\t\t\ta.surface = nextPos\n\t\t\telse\n\t\t\t\ta.heading = turned(-a.heading, self.rng:draw({ -40, 40 }))\n\t\t\t\ta.speed *= 0.4\n\t\t\tend\n\t\t\tif a.speed < 1.0 then\n\t\t\t\ta.state, a.speed = \"rest\", 0\n\t\t\t\ta.until_ = now + (if toward ~= nil then 0.2 else self.rng:draw(Skaters.REST))\n\t\t\tend\n\t\telseif now >= a.until_ and not resting or (toward ~= nil and now >= a.until_) then\n\t\t\t-- a stroke: a turn now and then, or toward the ripples\n\t\t\tif toward ~= nil then a.heading = toward\n\t\t\telseif self.rng:next() < 0.6 then a.heading = turned(a.heading, self.rng:draw({ -120, 120 })) end\n\t\t\ta.state, a.speed = \"glide\", self.rng:draw(Skaters.STROKE)\n\t\t\ta.strokeAt = now\n\t\tend\n\t\ta.position = a.surface + Vector3.yAxis * Skaters.HOVER\n\tend\nend\n\n-- What a strike may hit: a strider on the water.\nfunction Skaters.targets(self: any): { any }\n\tlocal out = {}\n\tfor _, a in self.items do table.insert(out, { creature = a, position = a.position, radius = Skaters.RADIUS }) end\n\treturn out\nend\n\n-- Struck: it skates off at once, away.\nfunction Skaters.struck(self: any, a: any)\n\ta.heading = -a.heading\n\ta.state, a.speed = \"glide\", Skaters.STROKE[2]\nend\n\nfunction Skaters.creatures(self: any): { any } return self.items end\n\nfunction Skaters.problems(self: any, lo: Vector3, hi: Vector3): { string }\n\tlocal out: { string } = {}\n\tlocal states = { rest = true, glide = true }\n\tif type(self.items) ~= \"table\" then return { \"skaters: no list\" } end\n\tfor i, a in self.items do\n\t\tif type(a) ~= \"table\" or not states[a.state] then table.insert(out, `skaters: {i} is in no known state`); continue end\n\t\tlocal p = a.position\n\t\tif (typeof(p) ~= \"Vector3\" and type(p) ~= \"table\") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then\n\t\t\ttable.insert(out, `skaters: {i} is outside its region`)\n\t\tend\n\tend\n\treturn out\nend\n\nreturn Skaters\n",6168,604495580},{"Shared/Prey/Snail","--!strict\n-- The garden snail (ROBLOX-105, W3b part B): ambient, not food, three times the spider's length. It crawls very slowly over the bed's soil and up the foot of the\n-- house wall (World/Garden.AMBIENT.wallFoot) from one seeded goal to the next (Prey/PlantWalk over a straight leg on the soil, the corner where the soil meets\n-- the brick, and up the brick), resting between; it is a night animal, so by day it mostly rests and from dusk it mostly crawls (the life clock's hour, as the\n-- moths'). It leaves a slime trail (`trail`, points dropped as it goes, drawn by Client/BugBodies fading over FADE_S). Its eye stalks draw in when the spider\n-- comes within EYES_WU and stay in until it has gone past CALM_WU; it does not crawl with them in. Struck, it withdraws into its shell for a while and the strike\n-- is refused (Prey/PreyWorld, UI/PreyText). Pure and seeded, no raycast; a checkpoint records it with the region's prey.\n-- Sources (docs/NOTEBOOK_SOURCES.md, the snail page): the shell 28 to 32 mm across; the eyes on the longer upper tentacles, which are retractable; mucus from\n-- the foot that aids its movement and leaves a slimy trail; mostly nocturnal, out by day after rain. The speeds, waits and distances are the game's.\nlocal R = require(script.Parent.PreyRandom)\nlocal PlantWalk = require(script.Parent.PlantWalk)\n\nlocal Snails = {}\nSnails.__index = Snails\n\nSnails.SHELL = 3.0 -- studs across: 28 to 32 mm\nSnails.RADIUS = 1.5\nSnails.CRAWL = { 0.07, 0.12 } -- studs a second: about a millimetre a second\nSnails.EYES_WU = 5.0 -- the spider this near: the eye stalks draw in\nSnails.CALM_WU = 7.0 -- and come out again once it is this far\nSnails.IN_RATE = 3.0 -- the stalks' travel a second, in and out\nSnails.OUT_RATE = 0.25\nSnails.SHELL_S = { 25, 45 } -- in its shell this long, struck\nSnails.REST_DAY = { 90, 240 }\nSnails.REST_NIGHT = { 8, 30 }\nSnails.DROP = 0.5 -- a trail point every this many studs crawled\nSnails.TRAIL = 25 -- trail points kept (the drawing shows the newest 24 legs at the full tier)\nSnails.FADE_S = 240 -- seconds for a trail to fade\nSnails.EDGE = 2.0\nSnails.WALL = -24 -- the house wall's face (z)\n\n-- `spec`: one of World/Garden.ambient's (kind \"snail\"); `count`: the tier's; `soil` the soil's top box; `boxes` the standing boxes' footprints.\nfunction Snails.new(spec: any, count: number, soil: { min: Vector3, max: Vector3 }, boxes: { { min: Vector3, max: Vector3 } }): any\n\tlocal self: any = setmetatable({ kind = \"snail\", rng = R.new(spec.seed + 4057), now = 0, boxes = {}, items = {}, rect = spec.rect,\n\t\tsoilMin = soil.min, soilMax = soil.max, top = soil.max.Y }, Snails)\n\tfor _, b in boxes do table.insert(self.boxes, { min = b.min, max = b.max }) end\n\tfor i, s in spec.starts do\n\t\tif i > count then break end\n\t\tlocal surf = Vector3.new(s.pos.X, self.top, s.pos.Z)\n\t\ttable.insert(self.items, {\n\t\t\tid = (spec.prefix or \"\") .. \"snail_\" .. i, kind = \"snail\", surface = surf, position = surf, prevPosition = surf, normal = Vector3.yAxis, heading = s.heading,\n\t\t\tspeed = self.rng:draw(Snails.CRAWL), state = \"rest\", until_ = self.rng:draw({ 3, 12 }), walk = nil, eyes = 1.0, trail = {}, lastDrop = surf,\n\t\t\tcrawled = 0, hidden = false,\n\t\t})\n\tend\n\treturn self\nend\n\n-- Whether a point on the soil is clear for the shell (inside the soil's edge, in no standing box's footprint grown by `margin`).\nfunction Snails.free(self: any, p: Vector3, margin: number): boolean\n\tif p.X < self.soilMin.X + Snails.EDGE or p.X > self.soilMax.X - Snails.EDGE or p.Z < self.soilMin.Z + Snails.EDGE or p.Z > self.soilMax.Z - 0.6 then return false end\n\tfor _, b in self.boxes do\n\t\tif p.X > b.min.X - margin and p.X < b.max.X + margin and p.Z > b.min.Z - margin and p.Z < b.max.Z + margin then return false end\n\tend\n\treturn true\nend\n\n-- Whether a straight leg over the soil is clear all the way.\nlocal function clearLeg(self: any, a: Vector3, b: Vector3): boolean\n\tlocal n = math.max(1, math.ceil((b - a).Magnitude / 0.5))\n\tfor i = 0, n do\n\t\tif not self:free(a:Lerp(b, i / n), 1.0) then return false end\n\tend\n\treturn true\nend\n\n-- A new goal and the walk to it: a seeded spot on the soil, or (a third of the time) on the wall's foot, by way of the corner. False when no clear leg was found.\nlocal function setOff(self: any, s: any): boolean\n\tlocal Y, Z = Vector3.yAxis, -Vector3.zAxis\n\tlocal onWall = s.normal.Z < -0.5\n\tfor _ = 1, 8 do\n\t\tlocal path: { any }\n\t\tif self.rng:next() < 0.33 and self.rect ~= nil then\n\t\t\t-- the wall's foot: up the brick from the corner below the goal\n\t\t\tlocal x = self.rng:draw(self.rect.x)\n\t\t\tlocal y = self.top + self.rng:draw(self.rect.y)\n\t\t\tlocal foot = Vector3.new(x, self.top, Snails.WALL)\n\t\t\tlocal goal = Vector3.new(x, y, Snails.WALL)\n\t\t\tif onWall then\n\t\t\t\tpath = { { pos = goal, normal = Z } }\n\t\t\telse\n\t\t\t\tlocal approach = Vector3.new(x, self.top, Snails.WALL - 2.0)\n\t\t\t\tif not clearLeg(self, s.surface, approach) then continue end\n\t\t\t\tpath = { { pos = approach, normal = Y }, { pos = foot, normal = (Y + Z).Unit }, { pos = goal, normal = Z } }\n\t\t\tend\n\t\telse\n\t\t\tlocal goal = Vector3.new(self.rng:draw({ self.soilMin.X + Snails.EDGE, self.soilMax.X - Snails.EDGE }), self.top,\n\t\t\t\tself.rng:draw({ self.soilMin.Z + Snails.EDGE, self.soilMax.Z - 2.5 }))\n\t\t\tif onWall then\n\t\t\t\tlocal foot = Vector3.new(s.surface.X, self.top, Snails.WALL)\n\t\t\t\tlocal away = Vector3.new(s.surface.X, self.top, Snails.WALL - 2.0)\n\t\t\t\tif not self:free(away, 1.0) or not clearLeg(self, away, goal) then continue end\n\t\t\t\tpath = { { pos = foot, normal = (Y + Z).Unit }, { pos = away, normal = Y }, { pos = goal, normal = Y } }\n\t\t\telse\n\t\t\t\tif not self:free(goal, 1.0) or not clearLeg(self, s.surface, goal) then continue end\n\t\t\t\tpath = { { pos = goal, normal = Y } }\n\t\t\tend\n\t\tend\n\t\ts.walk = PlantWalk.new(path, s.surface, s.normal)\n\t\ts.state = \"crawl\"\n\t\treturn true\n\tend\n\treturn false\nend\n\nlocal function night(hour: number?): boolean\n\treturn hour ~= nil and (hour >= 18 or hour < 6)\nend\n\n-- One fixed tick. `ctx.hour`: the life clock's hour (nil: day).\nfunction Snails.step(self: any, dt: number, spider: Vector3, ctx: any)\n\tself.now += dt\n\tlocal now = self.now\n\tlocal hour = if ctx ~= nil then ctx.hour else nil\n\t-- the trail dries\n\tfor _, s in self.items do\n\t\ts.prevPosition = s.position\n\t\twhile #s.trail > 0 and now - s.trail[#s.trail].t > Snails.FADE_S do table.remove(s.trail) end\n\t\tlocal d = (spider - s.position).Magnitude\n\t\tif s.state ~= \"shell\" then\n\t\t\tif d <= Snails.EYES_WU then s.eyes = math.max(0, s.eyes - Snails.IN_RATE * dt)\n\t\t\telseif d >= Snails.CALM_WU then s.eyes = math.min(1, s.eyes + Snails.OUT_RATE * dt) end\n\t\tend\n\t\tif s.state == \"shell\" then\n\t\t\tif now >= s.until_ then\n\t\t\t\t-- out again: a crawl it was on goes on (once its eyes are out), else it rests a little\n\t\t\t\tif s.walk ~= nil then s.state = \"crawl\" else s.state = \"rest\"; s.until_ = now + self.rng:draw({ 4, 10 }) end\n\t\t\tend\n\t\telseif s.state == \"rest\" then\n\t\t\tif now >= s.until_ and s.eyes >= 0.6 then\n\t\t\t\tif not setOff(self, s) then s.until_ = now + self.rng:draw({ 5, 15 }) end\n\t\t\tend\n\t\telseif s.state == \"crawl\" and s.walk ~= nil then\n\t\t\tif s.eyes >= 0.6 then\n\t\t\t\tlocal p, n, dir, done = PlantWalk.advance(s.walk, s.speed * dt)\n\t\t\t\ts.crawled += (p - s.surface).Magnitude\n\t\t\t\ts.surface, s.normal = p, n\n\t\t\t\tif dir.Magnitude > 0.5 then s.heading = dir end\n\t\t\t\ts.position = p\n\t\t\t\tif (p - s.lastDrop).Magnitude >= Snails.DROP then\n\t\t\t\t\ttable.insert(s.trail, 1, { p = p, n = n, t = now })\n\t\t\t\t\twhile #s.trail > Snails.TRAIL do table.remove(s.trail) end\n\t\t\t\t\ts.lastDrop = p\n\t\t\t\tend\n\t\t\t\tif done then\n\t\t\t\t\ts.walk = nil\n\t\t\t\t\ts.state = \"rest\"\n\t\t\t\t\ts.until_ = now + self.rng:draw(if night(hour) then Snails.REST_NIGHT else Snails.REST_DAY)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- What a strike may hit: the shell.\nfunction Snails.targets(self: any): { any }\n\tlocal out = {}\n\tfor _, s in self.items do\n\t\ttable.insert(out, { creature = s, position = s.position + s.normal * (Snails.SHELL * 0.5), radius = Snails.RADIUS })\n\tend\n\treturn out\nend\n\n-- Struck by the spider: into its shell.\nfunction Snails.struck(self: any, s: any)\n\ts.state = \"shell\"\n\ts.eyes = 0\n\ts.until_ = self.now + self.rng:draw(Snails.SHELL_S) -- (a crawl under way is kept and taken up again once it is out)\nend\n\nfunction Snails.creatures(self: any): { any } return self.items end\n\nfunction Snails.problems(self: any, lo: Vector3, hi: Vector3): { string }\n\tlocal out: { string } = {}\n\tlocal states = { rest = true, crawl = true, shell = true }\n\tif type(self.items) ~= \"table\" then return { \"snails: no list\" } end\n\tfor i, s in self.items do\n\t\tif type(s) ~= \"table\" or not states[s.state] then table.insert(out, `snails: {i} is in no known state`); continue end\n\t\tlocal p = s.position\n\t\tif (typeof(p) ~= \"Vector3\" and type(p) ~= \"table\") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then\n\t\t\ttable.insert(out, `snails: {i} is outside its region`)\n\t\tend\n\t\tif type(s.trail) ~= \"table\" or #s.trail > Snails.TRAIL then table.insert(out, `snails: {i} has a trail beyond belief`) end\n\t\tif type(s.eyes) ~= \"number\" or s.eyes < 0 or s.eyes > 1 then table.insert(out, `snails: {i}'s eyes are nowhere`) end\n\t\tif s.state == \"crawl\" and s.walk == nil then table.insert(out, `snails: {i} crawls nowhere`) end\n\t\tif s.walk ~= nil then\n\t\t\tlocal why = PlantWalk.problem(s.walk)\n\t\t\tif why ~= nil then table.insert(out, `snails: {i}: {why}`) end\n\t\tend\n\tend\n\treturn out\nend\n\nreturn Snails\n",9416,2144455822},{"Shared/Prey/StationMouse","--!strict\n-- One ambient house mouse: authored floor routes, seeded pauses, no prey or\n-- damage interface. It adds life without becoming another source of meals.\nlocal Mouse = {}\nMouse.__index = Mouse\nlocal v = Vector3.new\nMouse.ROUTE = table.freeze({\n\tv(-132,-70,88), v(-110,-70,88), v(-110,-70,150),\n\tv(-105,-70,215), v(20,-70,215), v(125,-70,215),\n\tv(195,-70,215), v(214,-70,220), v(245,-70,220),\n})\nMouse.SPEED = 24\nMouse.FLEE_SPEED = 42\nfunction Mouse.new(seed: number): any\n\treturn setmetatable({pos=Mouse.ROUTE[1],heading=Vector3.xAxis,leg=1,direction=1,\n\t\twait=8,seed=math.max(1,seed % 2147483647),moving=false,distance=0},Mouse)\nend\nlocal function random(self: any): number\n\tself.seed=self.seed*16807%2147483647\n\treturn (self.seed-1)/2147483646\nend\nfunction Mouse.step(self: any, dt: number, spider: Vector3?, cat: Vector3?)\n\tlocal alarm=(spider~=nil and (spider-self.pos).Magnitude<9)\n\t\tor (cat~=nil and (cat-self.pos).Magnitude<65)\n\tself.moving=false\n\tif self.wait>0 then\n\t\tself.wait=math.max(0,self.wait-dt)\n\t\t-- A refuge is a safe stopping place even while the cat passes.\n\t\tif self.leg==1 or self.leg==#Mouse.ROUTE or not alarm then return end\n\t\tself.wait=0\n\tend\n\tlocal target=Mouse.ROUTE[self.leg+self.direction]\n\tlocal delta=target-self.pos\n\tlocal length=delta.Magnitude\n\tlocal travel=math.min(length,(if alarm then Mouse.FLEE_SPEED else Mouse.SPEED)*dt)\n\tif length>1e-6 then\n\t\tself.heading=delta.Unit;self.pos+=self.heading*travel\n\t\tself.distance+=travel;self.moving=travel>0\n\tend\n\tif travel>=length then\n\t\tself.leg+=self.direction\n\t\tif self.leg==1 or self.leg==#Mouse.ROUTE then\n\t\t\tself.direction=-self.direction;self.wait=12+random(self)*18\n\t\telse self.wait=if alarm then 0 else .3+random(self)*1.8 end\n\tend\nend\nreturn Mouse\n",1745,531248123},{"Shared/Prey/Woodlouse","--!strict\n-- Woodlice (ROBLOX-96, W3): the garden's first ambient bugs, a seeded few in the bed that walk slowly about the soil, go under the big stone, the other stones' feet\n-- or the litter when the spider comes near, and come back out when it has gone. They are not prey: nothing here can be struck, caught or eaten (Prey/PreyWorld never\n-- sweeps them), and to the spider's senses they are movement and nothing finer (`percepts` caps them at \"movement\", as the wasp's, the rival's and the mate's are;\n-- the perception modules are untouched). A colony is one plain object, pure and seeded (a Prey/PreyRandom stream of its own from the region's seed), with no\n-- raycast: the soil is flat and the standing boxes (the mounds, the stones, the plants) are footprints it steers round. A checkpoint records it with the region's\n-- prey (Persistence/Checkpoint's `garden` root) and puts it back where it was.\n-- Sources for the rules (docs/NOTEBOOK_SOURCES.md, the ground-life page): woodlice are isopod crustaceans with seven pairs of walking legs that live in damp dark\n-- places under stones and litter and come out mostly at night (Hopkin 1991; Sutton 1972); their tegumental glands give a secretion that repels spiders and other\n-- predators (Gorvett 1956), which is why a jumping spider here leaves them alone. The numbers below (speeds, distances, waits) are the game's.\nlocal R = require(script.Parent.PreyRandom)\n\nlocal Woodlice = {}\nWoodlice.__index = Woodlice\n\nWoodlice.HOVER = 0.12 -- the body's centre above the soil (half its height)\nWoodlice.LENGTH = 1.0 -- studs; a common woodlouse is about a centimetre long\nWoodlice.RADIUS = 0.35 -- as the senses see it\nWoodlice.HIDE_WU = 4.0 -- the spider this near sends a woodlouse to cover\nWoodlice.OUT_WU = 6.0 -- it stays under cover until the spider is this far\nWoodlice.WALK = { 0.35, 0.65 } -- studs a second, each louse its own\nWoodlice.FLEE = 1.2\nWoodlice.RETURN_S = { 8, 15 } -- how long it waits under cover once the spider has gone\nWoodlice.EDGE = 1.0 -- how far inside the soil's edge it keeps\n\nexport type Louse = {\n\tid: string, position: Vector3, prevPosition: Vector3, heading: Vector3, speed: number,\n\tstate: string, -- walk | pause | hiding | hidden | emerging\n\thide: number, -- the hide spot it is making for or under (an index into `hides`), 0 for none\n\tuntil_: number, -- when the pause, the wait under cover or the emerging ends\n\tnextTurn: number,\n}\n\n-- `spec`: World/Garden.bugs (the starting places, the hide spots, the seed, and the id prefix a region other than the bed gives its woodlice, ROBLOX-107); `soil` the soil's top box { min, max }; `boxes` the standing boxes' footprints\n-- ({ min, max }, their y ignored).\nfunction Woodlice.new(spec: any, soil: { min: Vector3, max: Vector3 }, boxes: { { min: Vector3, max: Vector3 } }): any\n\tlocal self: any = setmetatable({\n\t\trng = R.new(spec.seed + 1013), now = 0, hides = {}, boxes = {}, lice = {},\n\t\tsoilMin = soil.min, soilMax = soil.max, top = soil.max.Y,\n\t}, Woodlice)\n\tfor _, h in spec.hides do table.insert(self.hides, { pos = h.pos, kind = h.kind }) end\n\tfor _, b in boxes do table.insert(self.boxes, { min = b.min, max = b.max }) end\n\tfor i, w in spec.woodlice do\n\t\tlocal pos = Vector3.new(w.pos.X, self.top + Woodlice.HOVER, w.pos.Z)\n\t\ttable.insert(self.lice, {\n\t\t\tid = (spec.prefix or \"\") .. \"louse_\" .. i, position = pos, prevPosition = pos, heading = w.heading, speed = self.rng:draw(Woodlice.WALK),\n\t\t\tstate = \"walk\", hide = 0, until_ = 0, nextTurn = self.rng:draw({ 1, 3 }),\n\t\t})\n\tend\n\treturn self\nend\n\n-- Whether a point on the soil is free to stand on: inside the soil's edge and in no standing box's footprint (grown by `margin`).\nfunction Woodlice.free(self: any, p: Vector3, margin: number): boolean\n\tif p.X < self.soilMin.X + Woodlice.EDGE or p.X > self.soilMax.X - Woodlice.EDGE or p.Z < self.soilMin.Z + Woodlice.EDGE or p.Z > self.soilMax.Z - Woodlice.EDGE then return false end\n\tfor _, b in self.boxes do\n\t\tif p.X > b.min.X - margin and p.X < b.max.X + margin and p.Z > b.min.Z - margin and p.Z < b.max.Z + margin then return false end\n\tend\n\treturn true\nend\n\nlocal function flat(v: Vector3): Vector3\n\treturn Vector3.new(v.X, 0, v.Z)\nend\n\n-- The hide spot nearest the louse.\nfunction Woodlice.nearestHide(self: any, p: Vector3): number\n\tlocal best, bestD = 0, math.huge\n\tfor i, h in self.hides do\n\t\tlocal d = (flat(h.pos) - flat(p)).Magnitude\n\t\tif d < bestD then best, bestD = i, d end\n\tend\n\treturn best\nend\n\nlocal function turned(heading: Vector3, degrees: number): Vector3\n\tlocal a = math.atan2(heading.Z, heading.X) + math.rad(degrees)\n\treturn Vector3.new(math.cos(a), 0, math.sin(a))\nend\n\n-- One fixed tick. `spider`: where the spider is.\nfunction Woodlice.step(self: any, dt: number, spider: Vector3)\n\tself.now += dt\n\tlocal now = self.now\n\tfor _, w in self.lice do\n\t\tw.prevPosition = w.position\n\t\tlocal d = (flat(spider) - flat(w.position)).Magnitude\n\t\tlocal near = d <= Woodlice.HIDE_WU and math.abs(spider.Y - w.position.Y) < 6\n\t\tif w.state == \"walk\" or w.state == \"pause\" or w.state == \"emerging\" then\n\t\t\tif near and #self.hides > 0 then\n\t\t\t\tw.state = \"hiding\"\n\t\t\t\tw.hide = self:nearestHide(w.position)\n\t\t\tend\n\t\tend\n\t\tif w.state == \"hiding\" then\n\t\t\tlocal goal = self.hides[w.hide].pos\n\t\t\tlocal to = flat(goal) - flat(w.position)\n\t\t\tif to.Magnitude <= 0.25 then\n\t\t\t\tw.position = Vector3.new(goal.X, w.position.Y, goal.Z)\n\t\t\t\tw.state = \"hidden\"\n\t\t\t\tw.until_ = math.huge\n\t\t\telse\n\t\t\t\tw.heading = to.Unit\n\t\t\t\tlocal step = math.min(to.Magnitude, Woodlice.FLEE * dt)\n\t\t\t\tw.position += w.heading * step\n\t\t\tend\n\t\telseif w.state == \"hidden\" then\n\t\t\tif d >= Woodlice.OUT_WU or (spider - w.position).Magnitude >= Woodlice.OUT_WU then\n\t\t\t\tif w.until_ == math.huge then w.until_ = now + self.rng:draw(Woodlice.RETURN_S) end\n\t\t\t\tif now >= w.until_ then\n\t\t\t\t\tw.state = \"emerging\"\n\t\t\t\t\tw.heading = turned(w.heading, self.rng:draw({ 120, 240 }))\n\t\t\t\t\tw.until_ = now + 1.5\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tw.until_ = math.huge -- (the spider came back: the wait starts again once it goes)\n\t\t\tend\n\t\telseif w.state == \"pause\" then\n\t\t\tif now >= w.until_ then w.state = \"walk\"; w.nextTurn = now + self.rng:draw({ 1, 3 }) end\n\t\telseif w.state == \"walk\" or w.state == \"emerging\" then\n\t\t\tif w.state == \"emerging\" and now >= w.until_ then w.state = \"walk\" end\n\t\t\tlocal paused = false\n\t\t\tif now >= w.nextTurn then\n\t\t\t\tw.heading = turned(w.heading, self.rng:draw({ -50, 50 }))\n\t\t\t\tw.nextTurn = now + self.rng:draw({ 1, 3 })\n\t\t\t\tif self.rng:next() < 0.25 then w.state = \"pause\"; w.until_ = now + self.rng:draw({ 1, 4 }); paused = true end\n\t\t\tend\n\t\t\tif not paused then\n\t\t\t\tlocal nextPos = w.position + w.heading * (w.speed * dt)\n\t\t\t\tif self:free(nextPos, 0.3) then\n\t\t\t\t\tw.position = nextPos\n\t\t\t\telse\n\t\t\t\t\tw.heading = turned(w.heading, self.rng:draw({ 90, 180 }))\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- The woodlice the spider could see: movement to its senses, never prey.\nfunction Woodlice.percepts(self: any): { any }\n\tlocal out = {}\n\tfor _, w in self.lice do\n\t\tif w.state ~= \"hidden\" then\n\t\t\ttable.insert(out, { id = w.id, position = w.position, radius = Woodlice.RADIUS, velocity = Vector3.zero, maxCategory = \"movement\" })\n\t\tend\n\tend\n\treturn out\nend\n\n-- (ROBLOX-105) What a strike may hit: { creature, position, radius } for each louse not under cover.\nfunction Woodlice.targets(self: any): { any }\n\tlocal out = {}\n\tfor _, w in self.lice do\n\t\tif w.state ~= \"hidden\" then table.insert(out, { creature = w, position = w.position, radius = Woodlice.RADIUS }) end\n\tend\n\treturn out\nend\n\n-- (ROBLOX-105) Struck by the spider (the strike is refused, Prey/PreyWorld): it makes for cover.\nfunction Woodlice.struck(self: any, w: any)\n\tif w.state ~= \"hidden\" and #self.hides > 0 then\n\t\tw.state = \"hiding\"\n\t\tw.hide = self:nearestHide(w.position)\n\tend\nend\n\n-- How many are under cover now.\nfunction Woodlice.hiddenCount(self: any): number\n\tlocal n = 0\n\tfor _, w in self.lice do if w.state == \"hidden\" then n += 1 end end\n\treturn n\nend\n\n-- What is wrong with a colony put back from a record (an empty list for a good one): the states, finite places inside the box given.\nfunction Woodlice.problems(self: any, lo: Vector3, hi: Vector3): { string }\n\tlocal out: { string } = {}\n\tlocal states = { walk = true, pause = true, hiding = true, hidden = true, emerging = true }\n\tif type(self.lice) ~= \"table\" then return { \"woodlice: no list\" } end\n\tfor i, w in self.lice do\n\t\tif type(w) ~= \"table\" or not states[w.state] then table.insert(out, `woodlice: louse {i} is in no known state`); continue end\n\t\tlocal p = w.position\n\t\tif typeof(p) ~= \"Vector3\" and type(p) ~= \"table\" then table.insert(out, `woodlice: louse {i} has no position`); continue end\n\t\tif p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then table.insert(out, `woodlice: louse {i} is outside its region`) end\n\t\tif w.hide ~= 0 and (type(self.hides) ~= \"table\" or self.hides[w.hide] == nil) then table.insert(out, `woodlice: louse {i} hides in no known spot`) end\n\tend\n\treturn out\nend\n\nreturn Woodlice\n",9035,116950832},{"Shared/Rig/Anatomy","--!strict\n-- Where the parts of the body sit, worked out from the appearance table alone: pure, Vector3 only, so tests/look.luau checks\n-- it. Body frame as in SpiderRig: +Y up, -Z forward. SpiderRig turns the layout into parts; Setae uses it to keep hairs off\n-- the eyes and to grow the palps' fluff. Nothing here is placed by eye: eyes, cheeks and palps are found on the head's surface.\n\nlocal Anatomy = {}\n\n-- `kind`: \"ame\" (the principal eyes), \"ale\", \"ple\", \"pme\" or \"tubercle\" (a tarantula's bead). `margin` (ROBLOX-93): the eye's place on the head's (or the tubercle's) surface is found from\n-- its offsets across and along, so it is only on the surface where those lie inside the ellipse the surface covers: `margin` is 1 minus the sum of their squared shares of\n-- the radii, 0 at the rim (where the place is clamped) and 1 at the middle. The tests keep every eye of every look at 0.02 or more.\nexport type Eye = { name: string, side: number, kind: string, at: Vector3, radii: Vector3, reflectance: number, principal: boolean, margin: number }\nexport type Glint = { side: number, at: Vector3, radii: Vector3 }\nexport type Palp = { side: number, base: Vector3, tip: Vector3 }\nexport type Zone = { at: Vector3, radius: number }\n-- One segment of a fang, an ellipsoid whose long axis (local Z) runs along `dir`; `index` counts from the chelicera (1) out to the tip.\nexport type Fang = { side: number, index: number, at: Vector3, dir: Vector3, radii: Vector3 }\nexport type Layout = {\n\theadCenter: Vector3, headRadii: Vector3,\n\tabdomenCenter: Vector3, abdomenRadii: Vector3,\n\tfaceCenter: Vector3, faceRadii: Vector3,\n\tpedicelCenter: Vector3, pedicelRadii: Vector3,\n\tneck: Vector3,\n\teyes: { Eye },\n\tglints: { Glint },\n\tcheeks: { { side: number, at: Vector3, radii: Vector3 } },\n\tjaws: { { side: number, at: Vector3, radii: Vector3 } },\n\tpalps: { Palp },\n\tfangs: { Fang }, -- empty for an appearance without a `fang` table (ROBLOX-84)\n\tspinneret: Vector3,\n\thairFree: { Zone },\n\ttubercle: { center: Vector3, radii: Vector3 }?, -- a tarantula's ocular tubercle, which carries its eyes\n}\n\nlocal function v3(t: { number }): Vector3\n\treturn Vector3.new(t[1], t[2], t[3])\nend\nAnatomy.v3 = v3\n\n-- z of an ellipsoid's front (-Z) surface at lateral offsets x, y from its centre.\nfunction Anatomy.frontZ(c: Vector3, r: Vector3, x: number, y: number): number\n\tlocal q = 1 - (x / r.X) ^ 2 - (y / r.Y) ^ 2\n\treturn c.Z - r.Z * math.sqrt(math.max(q, 0))\nend\n\n-- y of an ellipsoid's top surface at offsets x, z from its centre.\nfunction Anatomy.topY(c: Vector3, r: Vector3, x: number, z: number): number\n\tlocal q = 1 - (x / r.X) ^ 2 - (z / r.Z) ^ 2\n\treturn c.Y + r.Y * math.sqrt(math.max(q, 0))\nend\n\n-- x of an ellipsoid's +X side surface at offsets y, z from its centre.\nfunction Anatomy.sideX(c: Vector3, r: Vector3, y: number, z: number): number\n\tlocal q = 1 - (y / r.Y) ^ 2 - (z / r.Z) ^ 2\n\treturn c.X + r.X * math.sqrt(math.max(q, 0))\nend\n\n-- Outward unit normal of an ellipsoid at a point on its surface.\nfunction Anatomy.normalAt(c: Vector3, r: Vector3, p: Vector3): Vector3\n\tlocal d = p - c\n\treturn Vector3.new(d.X / (r.X * r.X), d.Y / (r.Y * r.Y), d.Z / (r.Z * r.Z)).Unit\nend\n\n-- The point of an ellipsoid in direction `dir` (unit-sphere coordinates) and its outward normal.\nfunction Anatomy.ellipsoidPoint(c: Vector3, r: Vector3, dir: Vector3): (Vector3, Vector3)\n\tlocal u = dir.Unit\n\tlocal p = c + Vector3.new(u.X * r.X, u.Y * r.Y, u.Z * r.Z)\n\treturn p, Anatomy.normalAt(c, r, p)\nend\n\n-- Does the segment from a to b come within `pad` studs of the eye (its ellipsoid, axes along the body frame's, each radius grown by `pad`)? The segment's closest point in the\n-- ellipsoid's own space (every axis divided by its radius) is found exactly, not sampled: the squared distance there is a quadratic in the segment's parameter.\nfunction Anatomy.touchesEye(eye: Eye, a: Vector3, b: Vector3, pad: number): boolean\n\tlocal r = eye.radii + Vector3.one * pad\n\tlocal u0 = Vector3.new((a.X - eye.at.X) / r.X, (a.Y - eye.at.Y) / r.Y, (a.Z - eye.at.Z) / r.Z)\n\tlocal d = Vector3.new((b.X - a.X) / r.X, (b.Y - a.Y) / r.Y, (b.Z - a.Z) / r.Z)\n\tlocal dd = d:Dot(d)\n\tlocal t = if dd > 1e-12 then math.clamp(-u0:Dot(d) / dd, 0, 1) else 0\n\treturn (u0 + d * t).Magnitude < 1\nend\n\nfunction Anatomy.layout(look: any): Layout\n\tlocal hc, hr = v3(look.headCenter), v3(look.headRadii)\n\tlocal ac, ar = v3(look.abdomenCenter), v3(look.abdomenRadii)\n\tlocal e = look.eye\n\tlocal eyes: { Eye } = {}\n\tlocal glints: { Glint } = {}\n\tlocal zones: { Zone } = {}\n\tlocal function addEye(name: string, kind: string, side: number, anchor: Vector3, r: Vector3, out: number, reflectance: number, principal: boolean, margin: number): Vector3\n\t\tlocal n = Anatomy.normalAt(hc, hr, anchor)\n\t\tlocal at = anchor + n * (out * math.min(r.X, r.Y, r.Z))\n\t\ttable.insert(eyes, { name = name, side = side, kind = kind, at = at, radii = r, reflectance = reflectance, principal = principal, margin = margin })\n\t\ttable.insert(zones, { at = at, radius = math.max(r.X, r.Y, r.Z) * 1.15 + 0.012 })\n\t\treturn at\n\tend\n\tlocal tub = look.tubercle\n\tif tub then\n\t\t-- A tarantula (ROBLOX-81): no big front pair; eight tiny eyes clustered on a small mound, their beads standing a little out of it, and one\n\t\t-- catchlight on the first bead of each side. Placed on the mound's surface like the others are on the head's.\n\t\tlocal tc, tr = v3(tub.center), v3(tub.radii)\n\t\tfor _, side in { -1, 1 } do\n\t\t\tfor n, spec in tub.eyes do\n\t\t\t\tlocal dx, dz = side * spec.x, spec.z\n\t\t\t\tlocal q = math.sqrt(math.max(1 - (dx / tr.X) ^ 2 - (dz / tr.Z) ^ 2, 0.05))\n\t\t\t\tlocal anchor = Vector3.new(tc.X + dx, tc.Y + tr.Y * q, tc.Z + dz)\n\t\t\t\tlocal at = anchor + Anatomy.normalAt(tc, tr, anchor) * (0.3 * spec.r)\n\t\t\t\tlocal r3 = Vector3.one * spec.r\n\t\t\t\ttable.insert(eyes, { name = \"Eye\", side = side, kind = \"tubercle\", at = at, radii = r3, reflectance = tub.eyeReflectance, principal = false, margin = 1 - (dx / tr.X) ^ 2 - (dz / tr.Z) ^ 2 })\n\t\t\t\ttable.insert(zones, { at = at, radius = spec.r * 1.15 + 0.012 })\n\t\t\t\tif n == 1 then\n\t\t\t\t\tlocal g = tub.glint\n\t\t\t\t\ttable.insert(glints, { side = side, at = at + Vector3.new(side * g.dx, g.dy, -spec.r * 0.75), radii = Vector3.new(g.r, g.r, g.r * 0.45) })\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tlocal frontSides: { number } = if tub then {} else { -1, 1 } -- (a tarantula's eyes are on its tubercle, above)\n\tfor _, side in frontSides do\n\t\t-- Principal eyes on the front of the face, two catchlights each.\n\t\tlocal a = e.ame\n\t\tlocal ar3 = v3(a.radii)\n\t\tlocal ax, ay = side * a.x, a.y\n\t\tlocal anchor = Vector3.new(hc.X + ax, ay, Anatomy.frontZ(hc, hr, ax, ay - hc.Y))\n\t\tlocal at = addEye(\"PrincipalEye\", \"ame\", side, anchor, ar3, a.out, a.reflectance, true, 1 - (ax / hr.X) ^ 2 - ((ay - hc.Y) / hr.Y) ^ 2)\n\t\tfor _, g in a.glints do\n\t\t\tlocal depth = math.sqrt(math.max(1 - (g.dx / ar3.X) ^ 2 - (g.dy / ar3.Y) ^ 2, 0))\n\t\t\tlocal gz = -ar3.Z * depth\n\t\t\ttable.insert(glints, {\n\t\t\t\tside = side,\n\t\t\t\tat = at + Vector3.new(g.dx, g.dy, gz - g.r * 0.2),\n\t\t\t\tradii = Vector3.new(g.r, g.r, g.r * 0.45),\n\t\t\t})\n\t\tend\n\t\t-- Anterior lateral eyes at the sides of the face.\n\t\tlocal l = e.ale\n\t\tlocal lx, ly = side * l.x, l.y\n\t\taddEye(\"Eye\", \"ale\", side, Vector3.new(hc.X + lx, ly, Anatomy.frontZ(hc, hr, lx, ly - hc.Y)), Vector3.one * l.r, l.out, l.reflectance, false, 1 - (lx / hr.X) ^ 2 - ((ly - hc.Y) / hr.Y) ^ 2)\n\t\t-- Posterior lateral and median eyes on the dome.\n\t\tfor n, d in { e.ple, e.pme } do\n\t\t\tlocal dx, dz = side * d.x, d.z\n\t\t\taddEye(\"Eye\", if n == 1 then \"ple\" else \"pme\", side, Vector3.new(hc.X + dx, Anatomy.topY(hc, hr, dx, dz - hc.Z), dz), Vector3.one * d.r, d.out, d.reflectance, false, 1 - (dx / hr.X) ^ 2 - ((dz - hc.Z) / hr.Z) ^ 2)\n\t\tend\n\tend\n\tlocal cheeks, jaws, palps = {}, {}, {}\n\tlocal ch, cl, pl = look.cheek, look.chelicerae, look.palp\n\tfor _, side in { -1, 1 } do\n\t\tif ch then -- an appearance without pale cheeks (the ant-mimicking spider) has none\n\t\t\tlocal cx = Anatomy.sideX(hc, hr, ch.y - hc.Y, ch.z - hc.Z) - ch.inset\n\t\t\ttable.insert(cheeks, { side = side, at = Vector3.new(side * cx, ch.y, ch.z), radii = v3(ch.radii) })\n\t\tend\n\t\tlocal jaw = Vector3.new(side * cl.x, cl.y, cl.z)\n\t\ttable.insert(jaws, { side = side, at = jaw, radii = v3(cl.radii) })\n\t\ttable.insert(zones, { at = jaw, radius = math.max(cl.radii[1], cl.radii[2], cl.radii[3]) * 1.1 + 0.01 })\n\t\tlocal px = side * pl.x\n\t\tlocal base = Vector3.new(px, pl.y, Anatomy.frontZ(hc, hr, px, pl.y - hc.Y))\n\t\ttable.insert(palps, { side = side, base = base, tip = base + Vector3.new(side * pl.spread, -pl.drop, -pl.reach) })\n\tend\n\t-- Fangs (ROBLOX-84): each hangs from the lower front of its chelicera as a short chain of ellipsoids, every segment `length` studs long and\n\t-- turned to its own direction (x is mirrored for the left one; -Z forward, -Y down), so a chain of two curves in and a single one points\n\t-- straight out. Where the base is, how long and how thick are in the appearance's `fang` table.\n\tlocal fangs: { Fang } = {}\n\tlocal fg = look.fang\n\tif fg then\n\t\tfor _, side in { -1, 1 } do\n\t\t\tlocal p = Vector3.new(side * fg.x, fg.y, fg.z)\n\t\t\tfor index, seg in fg.segments do\n\t\t\t\tlocal dir = Vector3.new(side * seg.dir[1], seg.dir[2], seg.dir[3]).Unit\n\t\t\t\ttable.insert(fangs, { side = side, index = index, at = p + dir * (seg.length * 0.5), dir = dir, radii = Vector3.new(seg.radius, seg.radius, seg.length * 0.5 + seg.radius * 0.35) })\n\t\t\t\tp += dir * seg.length\n\t\t\tend\n\t\tend\n\tend\n\treturn {\n\t\theadCenter = hc, headRadii = hr, abdomenCenter = ac, abdomenRadii = ar,\n\t\tfaceCenter = v3(look.face.center), faceRadii = v3(look.face.radii),\n\t\tpedicelCenter = v3(look.pedicel.center), pedicelRadii = v3(look.pedicel.radii),\n\t\tneck = v3(look.neck),\n\t\teyes = eyes, glints = glints, cheeks = cheeks, jaws = jaws, palps = palps, fangs = fangs,\n\t\tspinneret = Vector3.new(0, ac.Y + 0.02, ac.Z + ar.Z - 0.005),\n\t\thairFree = zones,\n\t\ttubercle = if tub then { center = v3(tub.center), radii = v3(tub.radii) } else nil,\n\t}\nend\n\nreturn Anatomy\n",9933,614088936},{"Shared/Rig/AntMimicPose","--!strict\n-- The ant-mimicking spider's antennae and walk as a pose (ROBLOX-64): pure and Vector3-free, display only. SpiderRig reads the pose, turns\n-- the drawn body and raises legs I; nothing here moves the collider, the path, the speed, the senses, the jump or the silk. All\n-- numbers are in Data/AntMimic (documented ones from Shamble et al. 2017, the rest marked artistic).\n--\n-- Standing still, legs I go up (above head height) and wave in phase like ant antennae; walking, all eight legs walk and the drawn body\n-- yaws and sways along a sine of the distance walked, wavelength ten body lengths. A stop shorter than the mimic's mean stop (83.3 ms)\n-- is not drawn as a pause. step(dt, standing, moving, distance) adds the dt it is handed, so slow motion slows the waving as it slows\n-- everything else; the wobble depends on distance only.\n\nlocal AntMimic = require(script.Parent.Parent.Data.AntMimic)\n\nlocal AntMimicPose = {}\nAntMimicPose.__index = AntMimicPose\n\nexport type Pose = {\n\tantennae: number, -- 0..1: legs I raised (0 they are legs)\n\thigh: number, -- 0..1: the display pose (higher and wider)\n\twave: number, -- 0..1: legs I swept from \"up\" toward \"swept\"; both legs share the one value (they move in phase)\n\tyaw: number, -- radians: the drawn body's turn about its up axis\n\tlateral: number, -- studs: the drawn body's sway to its right\n\twalking: boolean, -- drawn as walking (a stop shorter than the hold does not end it)\n\tshownSeconds: number, -- seconds the antennae have been fully up\n}\n\nlocal TAU = math.pi * 2\n\nlocal function smooth(x: number): number\n\tlocal c = math.clamp(x, 0, 1)\n\treturn c * c * (3 - 2 * c)\nend\n\nAntMimicPose.BODY_LENGTH = AntMimic.bodyLengthStuds -- the drawn body's length (studs) at full growth: a wavelength is ten of them\n\nAntMimicPose.NONE = { antennae = 0, high = 0, wave = 0, yaw = 0, lateral = 0, walking = false, shownSeconds = 0 } :: Pose\n\nexport type State = typeof(setmetatable(\n\t{} :: {\n\t\twalked: number, still: number, walking: boolean, antennae: number, high: number, walkLevel: number, phase: number, shown: number,\n\t\temphasis: boolean, reduced: boolean, bodyLength: number,\n\t},\n\tAntMimicPose\n))\n\nfunction AntMimicPose.new(): State\n\treturn setmetatable({\n\t\twalked = 0, still = 0, walking = false, antennae = 0, high = 0, walkLevel = 0, phase = 0, shown = 0,\n\t\temphasis = false, reduced = false, bodyLength = AntMimic.bodyLengthStuds,\n\t}, AntMimicPose)\nend\n\n-- The display key: legs I high and waving faster. Refused (false) unless the spider is standing still on a surface.\nfunction AntMimicPose.start(self: State, standing: boolean, moving: boolean): boolean\n\tif self.emphasis or not standing or moving then return false end\n\tself.emphasis = true\n\treturn true\nend\n\nfunction AntMimicPose.stop(self: State)\n\tself.emphasis = false\nend\n\n-- The display pose is on.\nfunction AntMimicPose.displaying(self: State): boolean\n\treturn self.emphasis\nend\n\n-- The pose after one step of dt seconds (the simulation's). standing: on a surface and not in a jump, on the line or resting; moving: walking\n-- (or asked to); distance: studs the spider actually moved this step.\nfunction AntMimicPose.step(self: State, dt: number, standing: boolean, moving: boolean, distance: number): Pose\n\tlocal a, w = AntMimic.antennae, AntMimic.walk\n\tif standing and not moving then self.still += dt else self.still = 0 end\n\tif not standing or moving then self.emphasis = false end\n\t-- Walking carries over a stop shorter than the mimic's mean stop; a spider that was not walking is not.\n\tlocal walking = standing and (moving or (self.walking and self.still < w.stopHoldSeconds))\n\tself.walking = walking\n\tif standing and moving and distance > 0 and distance <= w.teleportStuds then\n\t\tself.walked += distance\n\tend\n\t-- The antennae: up after a short stillness (at once for the display key), down quickly when it moves.\n\tlocal up = standing and not walking and (self.emphasis or self.still >= a.delaySeconds)\n\tif up then\n\t\tself.antennae = math.min(1, self.antennae + dt / a.riseSeconds)\n\telse\n\t\tself.antennae = math.max(0, self.antennae - dt / a.fallSeconds)\n\tend\n\tself.high = math.clamp(self.high + (if self.emphasis then dt else -dt) / a.riseSeconds, 0, 1)\n\t-- The drawn wobble eases in and out.\n\tif walking then\n\t\tself.walkLevel = math.min(1, self.walkLevel + dt / w.easeInSeconds)\n\telse\n\t\tself.walkLevel = math.max(0, self.walkLevel - dt / w.easeOutSeconds)\n\tend\n\tlocal shownA, shownHigh, shownWalk = smooth(self.antennae), smooth(self.high), smooth(self.walkLevel)\n\tlocal hz = a.waveHz + (a.highWaveHz - a.waveHz) * shownHigh\n\tself.phase = (self.phase + TAU * hz * dt) % TAU\n\tif self.antennae >= 0.999 then self.shown += dt else self.shown = 0 end\n\tlocal amp = if self.reduced then AntMimic.reducedMotion else 1\n\tlocal amount = a.waveAmount + (a.highWaveAmount - a.waveAmount) * shownHigh\n\tlocal wavelength = AntMimic.path.wavelengthBodyLengths.used * self.bodyLength\n\tlocal turn = TAU * self.walked / wavelength\n\treturn {\n\t\tantennae = shownA,\n\t\thigh = shownHigh,\n\t\twave = if self.reduced then 0 else shownA * amount * (0.5 + 0.5 * math.sin(self.phase)),\n\t\t-- The path is x = A sin(s), so the heading follows its slope, cos(s): the body turns most where the sway crosses the middle.\n\t\tyaw = shownWalk * math.rad(w.yawDeg) * amp * math.cos(turn),\n\t\tlateral = shownWalk * w.lateralStuds * amp * math.sin(turn),\n\t\twalking = walking,\n\t\tshownSeconds = self.shown,\n\t}\nend\n\nreturn AntMimicPose\n",5418,466100452},{"Shared/Rig/CatPose","--!strict\n-- The ranger's cat drawn (ROBLOX-118; its sim is Predator/Cat): a domestic cat at true size, a brown mackerel tabby, posed from what the cat is doing. Pure: a list\n-- of parts (each an ellipsoid, a ball or a cylinder with its size, its frame in the cat's own frame, its colour and whether the low tier keeps it), so\n-- Client/CatBody draws it, tools/preview/scene.py renders it and tests/preserve.luau measures it, all from these same numbers.\n--\n-- The cat's frame: its origin on the surface it stands on, under the middle of its body; forward -Z (CFrame.lookAt's), up +Y, right +X. Studs are centimetres.\n-- True size (a domestic cat, Felis catus): about 46 cm from the nose to the root of the tail, a tail about 28 cm, 23 to 25 cm at the shoulder, the head about\n-- 9.5 cm across, the ears 4.5 cm tall, the eyes about 2 cm across (the shoulder here 24, the body 46 from the nose's tip to the hips' back).\n--\n-- Poses: walk (a lateral-sequence walk, each foot 62% of its stride on the ground, the tail up), jump (stretched out), sit (on its haunches, the tail round its\n-- feet), rest (lying as a loaf, its eyes half shut: it purrs as it settles), sleep (curled round itself, its eyes shut, its tail over its nose), eat (head down\n-- to the bowl), groom (sitting, licking a raised forepaw), watch (still, its head following what moved, its tail's tip twitching), stalk (low, slow), crouch (low\n-- at the front, the hindquarters' wiggle), swat (a forepaw out at the thing and back). It breathes always (about 25 breaths a minute awake and 20 asleep), and\n-- now and then, sitting or lying awake, it gives a slow blink.\nlocal CatPose = {}\n\nexport type Part = { name: string, kind: string, size: Vector3, cf: CFrame, color: string, full: boolean }\nexport type State = {\n\tpose: string, t: number, -- the pose and the seconds the cat has lived (the breath, the gait, the blink, the twitch)\n\tspeed: number?, -- studs a second over the ground (the gait)\n\tlook: Vector3?, -- the point its head follows, in its own frame\n\tpaw: Vector3?, -- where its pat is aimed, in its own frame\n\tswat: number?, -- how far through the pat (0..1)\n\tseated: boolean?, -- (watch) sitting rather than standing\n}\n\nlocal v = Vector3.new\nlocal TAU = 2 * math.pi\nCatPose.COLORS = table.freeze({\n\tfur = \"8a7a66\", stripe = \"4b4036\", light = \"c9bba5\", white = \"e8e0d2\", nose = \"c98a85\", inner = \"d6a49a\", iris = \"b9a33a\", pupil = \"141210\",\n\tcollar = \"a8322c\", bell = \"c9a33a\", whisker = \"f2eee6\",\n})\nlocal C = CatPose.COLORS\n\n-- An ellipsoid of `size` (x across, y up, z along) whose long axis runs from a to b.\nlocal function along(a: Vector3, b: Vector3): CFrame\n\tlocal d = b - a\n\tif d.Magnitude < 1e-4 then return CFrame.new(a) end\n\tlocal up = if math.abs(d.Unit.Y) > 0.98 then Vector3.xAxis else Vector3.yAxis\n\treturn CFrame.lookAt((a + b) * 0.5, b, up)\nend\n\n-- The skeleton of a pose: where the body's three masses are and how they are pitched, the neck, the head's place and turn, each leg's joints, the tail's points,\n-- how far the eyes are shut and how much the breath swells.\ntype Leg = { a: Vector3, b: Vector3, c: Vector3, d: Vector3? } -- front: shoulder, elbow, paw; hind: hip, stifle, hock, paw\ntype Skeleton = {\n\tchest: Vector3, chestPitch: number, belly: Vector3, bellyPitch: number, hips: Vector3, hipsPitch: number, yawBody: { number }?,\n\tneckA: Vector3, neckB: Vector3, head: Vector3, headYaw: number, headPitch: number, headRoll: number,\n\tfl: Leg, fr: Leg, hl: Leg, hr: Leg, tail: { Vector3 }, shut: number, breath: number, low: boolean?,\n}\n\nlocal function frontLeg(shoulder: Vector3, paw: Vector3): Leg\n\tlocal wrist = paw + v(0, 2.2, 0.4)\n\tlocal elbow = (shoulder + wrist) * 0.5 + v(0, 0, 1.8)\n\treturn { a = shoulder, b = elbow, c = wrist, d = paw }\nend\nlocal function hindLeg(hip: Vector3, paw: Vector3, heel: Vector3?): Leg\n\tlocal hock = heel or (paw + v(0, 5, 3.4))\n\tlocal stifle = (hip + hock) * 0.5 + v(0, 0, -3.6)\n\treturn { a = hip, b = stifle, c = hock, d = paw }\nend\n\n-- The tail's eleven points from its root along a curve: `dirs` gives its direction at the root and at the tip; `sway` swings it sideways.\nlocal function tailCurve(root: Vector3, d0: Vector3, d1: Vector3, length: number, sway: number): { Vector3 }\n\tlocal pts = { root }\n\tlocal p = root\n\tfor i = 1, 10 do\n\t\tlocal s = i / 10\n\t\tlocal d = d0:Lerp(d1, s * s)\n\t\td = (d + v(sway * s, 0, 0))\n\t\tp = p + d.Unit * (length / 10)\n\t\ttable.insert(pts, p)\n\tend\n\treturn pts\nend\n-- The tail lying round the feet: an arc on the ground about `centre`, from `a0` to `a1` radians (0 behind, +pi/2 to its right), radius `r`.\nlocal function tailRound(root: Vector3, centre: Vector3, r: number, a0: number, a1: number, y: number): { Vector3 }\n\tlocal pts = { root }\n\tfor i = 1, 10 do\n\t\tlocal a = a0 + (a1 - a0) * (i / 10)\n\t\ttable.insert(pts, v(centre.X + r * math.sin(a), y, centre.Z + r * math.cos(a)))\n\tend\n\treturn pts\nend\n\n-- The slow blink: shut over 0.35 s, held 0.4 s, opened over 0.6 s, once every 7 to 11 s (from the clock alone, so it is the same on every client).\nlocal function blink(t: number): number\n\tlocal period = 9.0\n\tlocal k = t % period\n\tlocal start = 6.5 + 1.5 * math.sin(math.floor(t / period) * 1.7)\n\tlocal x = k - start\n\tif x < 0 or x > 1.35 then return 0 end\n\tif x < 0.35 then return x / 0.35 end\n\tif x < 0.75 then return 1 end\n\treturn 1 - (x - 0.75) / 0.6\nend\n\nlocal function standing(t: number, speed: number, low: number): Skeleton\n\t-- the walk: a lateral sequence (left hind, left fore, right hind, right fore a quarter apart), each foot on the ground 62% of the time\n\tlocal moving = speed > 1\n\tlocal period = if speed > 30 then 0.5 else 0.9\n\tlocal reach = if moving then speed * period * 0.62 / 2 else 0\n\tlocal function foot(neutral: Vector3, phase: number): Vector3\n\t\tif not moving then return neutral end\n\t\tlocal p = ((t / period) + phase) % 1\n\t\tif p < 0.62 then return neutral + v(0, 0, reach * (2 * p / 0.62 - 1)) end\n\t\tlocal s = (p - 0.62) / 0.38\n\t\treturn neutral + v(0, 3.5 * math.sin(s * math.pi), reach * (1 - 2 * s))\n\tend\n\tlocal bob = if moving then 0.4 * math.sin(TAU * t / period * 2) else 0\n\tlocal y = -low\n\tlocal sk: Skeleton = {\n\t\tchest = v(0, 16 + y + bob, -11), chestPitch = 0, belly = v(0, 15.5 + y + bob, 1), bellyPitch = 0, hips = v(0, 16.5 + y * 0.8 + bob, 11.5), hipsPitch = 0,\n\t\tneckA = v(0, 19 + y + bob, -15.5), neckB = v(0, 24 + y * 1.2 + bob, -20.5), head = v(0, 25.5 + y * 1.3 + bob, -24), headYaw = 0, headPitch = 0, headRoll = 0,\n\t\tfl = frontLeg(v(-3.8, 16 + y, -12.5), foot(v(-3.8, 1, -13.5), 0.25)), fr = frontLeg(v(3.8, 16 + y, -12.5), foot(v(3.8, 1, -13.5), 0.75)),\n\t\thl = hindLeg(v(-4.2, 16 + y * 0.8, 12), foot(v(-4.2, 1, 12.5), 0)), hr = hindLeg(v(4.2, 16 + y * 0.8, 12), foot(v(4.2, 1, 12.5), 0.5)),\n\t\ttail = {}, shut = 0, breath = 0,\n\t}\n\t-- the tail held up in a loose question mark, swinging a little as it walks\n\tsk.tail = tailCurve(v(0, 18.5 + y * 0.8 + bob, 18), v(0, 0.6, 0.8), v(0, 0.7, -0.6), 28, 0.25 * math.sin(TAU * t * 0.7))\n\treturn sk\nend\n\nlocal function sitting(t: number): Skeleton\n\tlocal sk: Skeleton = {\n\t\tchest = v(0, 17, -6), chestPitch = -55, belly = v(0, 11.5, 1), bellyPitch = -40, hips = v(0, 7, 7), hipsPitch = -10,\n\t\tneckA = v(0, 21, -8), neckB = v(0, 26, -10), head = v(0, 29, -12.5), headYaw = 0, headPitch = 0, headRoll = 0,\n\t\tfl = frontLeg(v(-3.6, 15, -7), v(-3.4, 1, -10.5)), fr = frontLeg(v(3.6, 15, -7), v(3.4, 1, -10.5)),\n\t\thl = hindLeg(v(-4.8, 8, 8), v(-4.6, 1, -3), v(-4.9, 1.6, 7)), hr = hindLeg(v(4.8, 8, 8), v(4.6, 1, -3), v(4.9, 1.6, 7)),\n\t\ttail = tailRound(v(0, 3, 13.5), v(0, 1.5, 3), 11, 0.15, 2.7, 1.5), shut = 0, breath = 0,\n\t}\n\treturn sk\nend\n\nlocal function lying(t: number): Skeleton\n\tlocal sk: Skeleton = {\n\t\tchest = v(0, 8, -8), chestPitch = 0, belly = v(0, 8.5, 1), bellyPitch = 0, hips = v(0, 8, 10), hipsPitch = 0,\n\t\tneckA = v(0, 11, -12), neckB = v(0, 14, -15.5), head = v(0, 15, -18.5), headYaw = 0, headPitch = -8, headRoll = 0,\n\t\tfl = frontLeg(v(-3.4, 7, -9), v(-3, 1.1, -13.5)), fr = frontLeg(v(3.4, 7, -9), v(3, 1.1, -13.5)),\n\t\thl = hindLeg(v(-4.6, 7, 10), v(-4.8, 1.1, 3), v(-5, 1.6, 12)), hr = hindLeg(v(4.6, 7, 10), v(4.8, 1.1, 3), v(5, 1.6, 12)),\n\t\ttail = tailRound(v(0, 3, 16), v(0, 1.5, 0), 12.5, 0.2, 2.5, 1.6), shut = 0.5, breath = 0,\n\t}\n\treturn sk\nend\n\n-- Curled asleep: the body round an arc, the head tucked against the hindquarters, the tail over the nose.\nlocal function curled(): Skeleton\n\tlocal R = 5.5\n\tlocal function onArc(deg: number, y: number, r: number?): Vector3\n\t\tlocal a = math.rad(deg)\n\t\treturn v((r or R) * math.sin(a), y, -(r or R) * math.cos(a))\n\tend\n\tlocal sk: Skeleton = {\n\t\tchest = onArc(-35, 7), chestPitch = 0, belly = onArc(45, 7.5), bellyPitch = 0, hips = onArc(125, 7), hipsPitch = 0,\n\t\tyawBody = { 125, 45, -35 }, -- (each mass turned along the arc, its front toward the head: 90 degrees less its place on the arc)\n\t\tneckA = onArc(-60, 7.5, 6), neckB = onArc(-80, 8, 8), head = onArc(-95, 8, 10.5), headYaw = 35, headPitch = -18, headRoll = 28, -- (its head laid on its paws, its face turned out)\n\t\tfl = frontLeg(onArc(-30, 5, 6), onArc(-75, 1.2, 5)), fr = frontLeg(onArc(-20, 5, 10), onArc(-60, 1.2, 8)),\n\t\thl = hindLeg(onArc(130, 5, 6), onArc(80, 1.2, 4), onArc(150, 1.6, 4)), hr = hindLeg(onArc(140, 5, 11), onArc(95, 1.2, 9), onArc(165, 1.6, 9)),\n\t\ttail = {}, shut = 1, breath = 0,\n\t}\n\tlocal pts = { onArc(140, 4.5, 8) }\n\tfor i = 1, 10 do table.insert(pts, onArc(140 + i * 22, 2.6, 11.5)) end\n\tsk.tail = pts\n\treturn sk\nend\n\nlocal function jumping(t: number): Skeleton\n\tlocal sk = standing(t, 0, 0)\n\tsk.chest, sk.belly, sk.hips = v(0, 17, -13), v(0, 16, 1), v(0, 15, 13)\n\tsk.chestPitch, sk.hipsPitch = 8, -8\n\tsk.fl = frontLeg(v(-3.6, 16, -14), v(-3.4, 8, -27))\n\tsk.fr = frontLeg(v(3.6, 16, -14), v(3.4, 8, -27))\n\tsk.hl = hindLeg(v(-4.2, 15, 13), v(-4, 7, 30), v(-4.1, 9, 24))\n\tsk.hr = hindLeg(v(4.2, 15, 13), v(4, 7, 30), v(4.1, 9, 24))\n\tsk.tail = tailCurve(v(0, 17, 19), v(0, 0.1, 1), v(0, 0.2, 1), 28, 0)\n\treturn sk\nend\n\n-- Turns the head toward a point in the cat's frame (clamped as a cat's neck allows), from where its neck meets it.\nlocal function lookAt(sk: Skeleton, target: Vector3)\n\tlocal d = target - sk.neckB\n\tlocal yaw = math.deg(math.atan2(-d.X, -d.Z))\n\tlocal pitch = math.deg(math.atan2(d.Y, math.sqrt(d.X * d.X + d.Z * d.Z)))\n\tsk.headYaw = math.clamp(yaw, -75, 75)\n\tsk.headPitch = math.clamp(pitch, -45, 55)\nend\n\n-- The skeleton for a state.\nfunction CatPose.skeleton(state: State): Skeleton\n\tlocal t = state.t\n\tlocal pose = state.pose\n\tlocal sk: Skeleton\n\tif pose == \"walk\" then\n\t\tsk = standing(t, state.speed or 60, 0)\n\telseif pose == \"jump\" then\n\t\tsk = jumping(t)\n\telseif pose == \"sit\" then\n\t\tsk = sitting(t)\n\t\tsk.headYaw = 25 * math.sin(t * 0.21) -- (it looks about, slowly)\n\t\tsk.shut = 0\n\telseif pose == \"rest\" then\n\t\tsk = lying(t)\n\telseif pose == \"sleep\" then\n\t\tsk = curled()\n\telseif pose == \"eat\" then\n\t\tsk = standing(t, 0, 0)\n\t\tsk.neckA, sk.neckB, sk.head = v(0, 17, -16), v(0, 12, -22), v(0, 8.5, -25)\n\t\tsk.headPitch = -55 + 4 * math.sin(t * 6)\n\telseif pose == \"groom\" then\n\t\tsk = sitting(t)\n\t\tsk.fr = frontLeg(v(3.6, 15, -7), v(2.4, 21, -14.5))\n\t\tsk.head = v(1.2, 26.5, -12.5)\n\t\tsk.headYaw, sk.headPitch = -20, -35 + 6 * math.sin(t * 7)\n\telseif pose == \"stalk\" then\n\t\tsk = standing(t, state.speed or 20, 6)\n\t\tsk.head = sk.head + v(0, -2, -2)\n\t\tsk.tail = tailCurve(sk.hips + v(0, 2, 6), v(0, -0.1, 1), v(0, 0.15, 1), 28, 0.3 * math.sin(t * 9))\n\telseif pose == \"crouch\" or pose == \"swat\" then\n\t\tsk = standing(t, 0, 7)\n\t\tsk.hips = sk.hips + v(1.2 * math.sin(TAU * 3 * t), 2.5, 0) -- (the wiggle before the pat)\n\t\tsk.hl, sk.hr = hindLeg(v(-4.2, 11.5, 12), v(-4.2, 1, 13)), hindLeg(v(4.2, 11.5, 12), v(4.2, 1, 13))\n\t\tsk.tail = tailCurve(sk.hips + v(0, 2, 6), v(0, 0, 1), v(0, 0.3, 1), 28, 0.5 * math.sin(t * 11))\n\t\tif pose == \"swat\" then\n\t\t\tlocal k = math.clamp(state.swat or 0, 0, 1)\n\t\t\tlocal out = math.sin(k * math.pi) -- (out to the far end of its reach halfway through, and back)\n\t\t\tlocal target = state.paw or v(3.5, 2, -34)\n\t\t\tlocal shoulder = v(3.8, 10, -12.5)\n\t\t\tlocal d = target - shoulder\n\t\t\tif d.Magnitude > 26 then d = d.Unit * 26 end\n\t\t\tsk.fr = frontLeg(shoulder, shoulder:Lerp(shoulder + d, out) + v(0, 3 * out, 0))\n\t\tend\n\telse -- \"watch\"\n\t\tsk = if state.seated then sitting(t) else standing(t, 0, 2)\n\t\tsk.tail[#sk.tail] = sk.tail[#sk.tail] + v(0.8 * math.sin(t * 10), 0, 0) -- (its tail's tip twitches)\n\tend\n\tif state.look ~= nil and pose ~= \"sleep\" and pose ~= \"eat\" and pose ~= \"groom\" then lookAt(sk, state.look) end\n\t-- the breath, and the eyes: shut asleep, half shut lying awake, a slow blink now and then sitting or lying awake, wide open watching\n\tsk.breath = 0.025 * math.sin(TAU * t / (if pose == \"sleep\" then 3.0 else 2.4))\n\tif pose == \"sit\" or pose == \"rest\" or pose == \"groom\" then sk.shut = math.max(sk.shut, blink(t)) end\n\tif pose == \"watch\" or pose == \"stalk\" or pose == \"crouch\" or pose == \"swat\" then sk.shut = 0 end\n\treturn sk\nend\n\n-- The parts of a state, in a fixed order (the same names and count for every pose).\nfunction CatPose.parts(state: State): { Part }\n\tlocal sk = CatPose.skeleton(state)\n\tlocal out: { Part } = {}\n\tlocal function add(name: string, kind: string, size: Vector3, cf: CFrame, color: string, full: boolean)\n\t\ttable.insert(out, { name = name, kind = kind, size = size, cf = cf, color = color, full = full })\n\tend\n\tlocal b = 1 + sk.breath\n\tlocal function mass(c: Vector3, pitch: number, yaw: number?): CFrame\n\t\treturn CFrame.new(c) * CFrame.Angles(0, math.rad(yaw or 0), 0) * CFrame.Angles(math.rad(pitch), 0, 0)\n\tend\n\tlocal yaws = sk.yawBody or { 0, 0, 0 }\n\tlocal chestCF, bellyCF, hipsCF = mass(sk.chest, -sk.chestPitch, yaws[1]), mass(sk.belly, -sk.bellyPitch, yaws[2]), mass(sk.hips, -sk.hipsPitch, yaws[3])\n\tadd(\"Chest\", \"ellipsoid\", v(12 * b, 14 * b, 16), chestCF, C.fur, false)\n\tadd(\"Belly\", \"ellipsoid\", v(12.5 * b, 12 * b, 22), bellyCF, C.fur, false)\n\tadd(\"Hips\", \"ellipsoid\", v(12, 13, 12), hipsCF, C.fur, false)\n\tadd(\"BellyFur\", \"ellipsoid\", v(9.5, 7, 18), bellyCF * CFrame.new(0, -3.2, 0), C.light, true)\n\tadd(\"Bib\", \"ellipsoid\", v(8, 10, 6), chestCF * CFrame.new(0, -1.5, -5.6), C.light, true)\n\t-- the tabby's stripes: bands round each of the body's masses, a little proud of it (so they follow it however it lies)\n\t-- (each band is the mass's own cross-section where it lies, a millimetre proud: an ellipsoid's section at z is its x and y scaled by sqrt(1 - (z / half its length)^2))\n\tlocal bands: { { any } } = { { chestCF, -2.5, v(12 * b, 14 * b, 16) }, { chestCF, 3.5, v(12 * b, 14 * b, 16) }, { bellyCF, -5.5, v(12.5 * b, 12 * b, 22) },\n\t\t{ bellyCF, 4.5, v(12.5 * b, 12 * b, 22) }, { hipsCF, -2.5, v(12, 13, 12) }, { hipsCF, 3, v(12, 13, 12) } }\n\tfor i, band in bands do\n\t\tlocal size: Vector3 = band[3]\n\t\tlocal k = math.sqrt(math.max(0.05, 1 - ((band[2] :: number) / (size.Z / 2)) ^ 2))\n\t\tadd(`Stripe{i}`, \"ellipsoid\", v(size.X * k + 0.08, size.Y * k + 0.08, 1.2), (band[1] :: CFrame) * CFrame.new(0, 0, band[2]), C.stripe, true)\n\tend\n\t-- the neck, the collar round it and its bell\n\tlocal neckCF = along(sk.neckA, sk.neckB)\n\tadd(\"Neck\", \"ellipsoid\", v(7.6, 8.6, (sk.neckB - sk.neckA).Magnitude + 5), neckCF, C.fur, false)\n\tlocal collarAt = sk.neckA:Lerp(sk.neckB, 0.45)\n\tlocal collarCF = along(collarAt - (sk.neckB - sk.neckA).Unit * 0.6, collarAt + (sk.neckB - sk.neckA).Unit * 0.6) * CFrame.Angles(0, math.pi / 2, 0)\n\tadd(\"Collar\", \"cylinder\", v(1.2, 8.8, 8.8), collarCF, C.collar, false)\n\tadd(\"Bell\", \"ball\", v(1.4, 1.4, 1.4), CFrame.new(collarAt + (neckCF.UpVector * -4.6)), C.bell, false)\n\t-- the head and its face\n\tlocal headCF = CFrame.new(sk.head) * CFrame.Angles(0, math.rad(sk.headYaw), 0) * CFrame.Angles(math.rad(sk.headPitch), 0, 0) * CFrame.Angles(0, 0, math.rad(sk.headRoll))\n\tadd(\"Head\", \"ellipsoid\", v(9.5, 8.5, 8.5), headCF, C.fur, false)\n\tadd(\"CheekL\", \"ellipsoid\", v(4.2, 4.4, 4), headCF * CFrame.new(-3.2, -1.4, -2), C.fur, true)\n\tadd(\"CheekR\", \"ellipsoid\", v(4.2, 4.4, 4), headCF * CFrame.new(3.2, -1.4, -2), C.fur, true)\n\tadd(\"Muzzle\", \"ellipsoid\", v(4.6, 3.4, 3.2), headCF * CFrame.new(0, -2, -4.2), C.white, false)\n\tadd(\"Nose\", \"ellipsoid\", v(1.3, 0.8, 0.7), headCF * CFrame.new(0, -0.9, -5.75), C.nose, false)\n\tadd(\"Chin\", \"ellipsoid\", v(3, 1.6, 2.5), headCF * CFrame.new(0, -3.4, -3), C.white, true)\n\tfor i, side in { -1, 1 } do\n\t\tlocal tag = if side < 0 then \"L\" else \"R\"\n\t\tlocal ear = headCF * CFrame.new(side * 3, 4.3, 0.6) * CFrame.Angles(math.rad(-10), 0, math.rad(-side * 16))\n\t\tadd(\"Ear\" .. tag, \"ellipsoid\", v(3.6, 4.8, 0.9), ear, C.fur, false)\n\t\tadd(\"EarIn\" .. tag, \"ellipsoid\", v(2.4, 3.3, 0.3), ear * CFrame.new(0, -0.3, -0.45), C.inner, true)\n\t\tlocal _ = i\n\tend\n\tfor _, side in { -1, 1 } do\n\t\tlocal tag = if side < 0 then \"L\" else \"R\"\n\t\tlocal eye = headCF * CFrame.new(side * 2.2, 1, -3.35)\n\t\tadd(\"Eye\" .. tag, \"ball\", v(1.95, 1.95, 1.95), eye, C.iris, false)\n\t\tadd(\"Pupil\" .. tag, \"ellipsoid\", v(0.45, 1.5, 0.3), eye * CFrame.new(0, 0, -0.92), C.pupil, false)\n\t\tlocal shut = math.clamp(sk.shut, 0, 1)\n\t\tadd(\"Lid\" .. tag, \"ellipsoid\", v(2.15, 0.25 + shut * 1.9, 2.1), eye * CFrame.new(0, 0.98 * (1 - shut), 0.02), C.fur, false)\n\tend\n\tfor _, side in { -1, 1 } do\n\t\tfor k = 1, 3 do\n\t\t\tlocal a = (headCF * CFrame.new(side * 2.1, -2.1, -5)).Position\n\t\t\tlocal bb = (headCF * CFrame.new(side * 8.5, -2.6 + k * 0.8, -5.6 + k * 0.5)).Position\n\t\t\tadd(`Whisker{if side < 0 then \"L\" else \"R\"}{k}`, \"cylinder\", v((bb - a).Magnitude, 0.09, 0.09), along(a, bb) * CFrame.Angles(0, math.pi / 2, 0), C.whisker, true)\n\t\tend\n\tend\n\t-- the legs: bones as ellipsoids along them, and the paws\n\tlocal function bone(name: string, a: Vector3, bb: Vector3, d: number, color: string)\n\t\tadd(name, \"ellipsoid\", v(d, d, (bb - a).Magnitude + d * 0.7), along(a, bb), color, false)\n\tend\n\tfor _, item in { { \"FL\", sk.fl }, { \"FR\", sk.fr } } :: { { any } } do\n\t\tlocal leg: Leg = item[2]\n\t\tbone(item[1] .. \"Upper\", leg.a, leg.b, 3.4, C.fur)\n\t\tbone(item[1] .. \"Lower\", leg.b, leg.c, 2.5, C.fur)\n\t\tadd(item[1] .. \"Paw\", \"ellipsoid\", v(2.8, 1.8, 3.6), CFrame.new(leg.d :: Vector3), C.light, false)\n\tend\n\tfor _, item in { { \"HL\", sk.hl }, { \"HR\", sk.hr } } :: { { any } } do\n\t\tlocal leg: Leg = item[2]\n\t\tbone(item[1] .. \"Thigh\", leg.a, leg.b, 4.2, C.fur)\n\t\tbone(item[1] .. \"Shank\", leg.b, leg.c, 2.7, C.fur)\n\t\tbone(item[1] .. \"Foot\", leg.c, leg.d :: Vector3, 2.1, C.fur)\n\t\tadd(item[1] .. \"Paw\", \"ellipsoid\", v(2.8, 1.8, 3.4), CFrame.new(leg.d :: Vector3), C.light, false)\n\tend\n\t-- the tail, ringed dark and light, thinning to its tip\n\tfor i = 1, 10 do\n\t\tlocal d = 2.9 - 1.2 * (i - 1) / 9\n\t\tbone(`Tail{i}`, sk.tail[i], sk.tail[i + 1], d, if i % 2 == 0 then C.stripe else C.fur)\n\tend\n\t-- the forehead's dark marks (the tabby's \"M\")\n\tadd(\"Brow1\", \"ellipsoid\", v(0.8, 0.4, 3), headCF * CFrame.new(-1.1, 3.9, -1.2), C.stripe, true)\n\tadd(\"Brow2\", \"ellipsoid\", v(0.8, 0.4, 3), headCF * CFrame.new(1.1, 3.9, -1.2), C.stripe, true)\n\treturn out\nend\n\n-- The cat's frame in the world: on its surface at `pos`, facing `heading` (flat).\nfunction CatPose.frame(pos: Vector3, heading: Vector3): CFrame\n\tlocal f = v(heading.X, 0, heading.Z)\n\tif f.Magnitude < 1e-4 then f = v(0, 0, -1) end\n\treturn CFrame.lookAt(pos, pos + f.Unit, Vector3.yAxis)\nend\n\nreturn table.freeze(CatPose)\n",19168,2010322217},{"Shared/Rig/DogGait","--!strict\n-- Presentation only. Stance paws remain in world space; travel drives the\n-- diagonal step pairs. Two-bone joints connect those paws to the moving body.\nlocal DogGait={}\nDogGait.STRIDE=40\nDogGait.STANCE=.6\nDogGait.UPPER=22\nDogGait.LOWER=20\nlocal Y=Vector3.yAxis\nlocal function smooth(t: number): number return t*t*(3-2*t) end\nlocal function nominal(frame: CFrame,i: number,lead: number): Vector3\n return frame:PointToWorldSpace(Vector3.new(if i%2==1 then -8 else 8,0,if i<=2 then -20-lead else 19-lead))\nend\nfunction DogGait.new(): any\n return {cycle=0,previous=nil,heading=nil,feet={},resets=0}\nend\nfunction DogGait.joint(hip: Vector3,ankle: Vector3,pole: Vector3): (Vector3,Vector3)\n local delta=ankle-hip\n local distance=math.clamp(delta.Magnitude,math.abs(DogGait.UPPER-DogGait.LOWER)+.01,DogGait.UPPER+DogGait.LOWER-.01)\n local direction=if delta.Magnitude>.001 then delta.Unit else -Y\n local along=(DogGait.UPPER^2-DogGait.LOWER^2+distance^2)/(2*distance)\n local bend=pole-direction*pole:Dot(direction)\n if bend.Magnitude<.001 then\n  local axis=if math.abs(direction.X)<.9 then Vector3.xAxis else Vector3.zAxis\n  bend=axis-direction*axis:Dot(direction)\n end\n local knee=hip+direction*along+bend.Unit*math.sqrt(math.max(0,DogGait.UPPER^2-along^2))\n return knee,hip+direction*distance\nend\nfunction DogGait.step(self: any,frame: CFrame,dt: number,ground: (Vector3)->Vector3?,reduced: boolean): any\n local travelled=if self.previous then (frame.Position-self.previous).Magnitude else 0\n local turn=if self.heading then math.acos(math.clamp(self.heading:Dot(frame.LookVector),-1,1)) else 0\n local reset=self.previous==nil or travelled>DogGait.STRIDE*.75 or turn>1.3\n self.previous,self.heading=frame.Position,frame.LookVector\n if reset then self.feet={};self.cycle=0;self.resets+=1;travelled=0;turn=0 end\n local moving=travelled>.001 or turn>.001\n if not reduced then self.cycle+=(travelled+turn*12)/DogGait.STRIDE end\n local supported=true\n for i=1,4 do\n  local phase=self.cycle+(if i==1 or i==4 then 0 else .5)\n  local cycle=math.floor(phase);phase%=1\n  local f=self.feet[i]\n  if f==nil then\n   local lead=if reduced then 0 else 12-math.min(phase/DogGait.STANCE,1)*24\n   local at=ground(nominal(frame,i,lead))\n   f={anchor=at or nominal(frame,i,lead),supported=at~=nil,lastCycle=-1,u=0,heading=frame.LookVector}\n   self.feet[i]=f\n  end\n  if reduced then\n   -- A static pose follows the animal without procedural stepping or bobbing.\n   local at=ground(nominal(frame,i,0));f.anchor=at or f.anchor;f.supported=at~=nil;f.swing=nil\n  elseif phase>=DogGait.STANCE and f.lastCycle~=cycle then\n   f.lastCycle=cycle\n   local target=ground(nominal(frame,i,if travelled>.05 then 28 else 0))\n   if target then\n    f.swing={from=f.anchor,to=target,heading=frame.LookVector};f.u=0\n   else f.supported=false end\n  end\n  local hip=nominal(frame,i,0)+Y*33\n  -- During a sniff turn the hips move round planted paws without forward\n  -- travel. Reposition a reaching paw instead of letting the leg disconnect.\n  if not reduced and f.swing==nil and (hip-f.anchor-Y*3.5).Magnitude>36 then\n   local target=ground(nominal(frame,i,0))\n   if target then f.swing={from=f.anchor,to=target,heading=frame.LookVector,turn=true};f.u=0 end\n  end\n  if f.swing then\n   local u=if f.swing.turn then f.u+math.clamp(dt,0,.15)/.15\n    elseif cycle>f.lastCycle then 1 else math.clamp((phase-DogGait.STANCE)/(1-DogGait.STANCE),0,1)\n   if not moving then u=math.max(u,f.u+math.clamp(dt,0,.15)/.15) end\n   f.u=math.clamp(math.max(u,f.u),0,1)\n   f.anchor=f.swing.from:Lerp(f.swing.to,smooth(f.u))+Y*(math.sin(f.u*math.pi)*5)\n   if f.u>=1 then f.anchor=f.swing.to;f.heading=f.swing.heading;f.supported=true;f.swing=nil end\n  end\n  f.hip=hip\n  f.knee,f.ankle=DogGait.joint(hip,f.anchor+Y*3.5,frame.LookVector*(if i<=2 then -1 else 1))\n  supported=supported and f.supported\n end\n return {feet=self.feet,supported=supported,moving=moving}\nend\nreturn DogGait\n",3926,2646095645},{"Shared/Rig/Idle","--!strict\n-- Idle motion for the drawn spider (display only, never fed back into movement): a slow breathing bob, a small curious head\n-- tilt and the palps' drumming. Pure functions of time so tests/look.luau can check them. All knobs: Appearances.idle / .palp.\n-- `calm` is 0..1: SpiderRig eases it up after the spider has stood still for a moment and back to 0 as soon as it moves.\n\nlocal Idle = {}\n\nexport type Pose = {\n\tbodyLift: number, -- studs: the whole body rises with a breath\n\tabdomenLift: number, -- studs: the abdomen rises a little more\n\tabdomenPitch: number, -- radians, rear end up\n\theadRoll: number, headYaw: number, headPitch: number, -- radians\n}\n\nlocal TAU = math.pi * 2\n\n-- One breath, -1 to 1: a sine of the period with a slow wobble in its depth. The body's lift, the abdomen's pitch and its scale (ROBLOX-87) all follow it.\nfunction Idle.breath(t: number, period: number): number\n\treturn math.sin(TAU * t / period) * (0.85 + 0.15 * math.sin(TAU * t / (period * 2.7) + 0.6))\nend\n\n-- The abdomen's scale (ROBLOX-87): 1 plus `breathe.scale` of a breath, as much as `amount` (0..1: standing is 1, moving `breathe.movingShare`, Reduced Motion 0).\n-- Appearances without `breathe.scale` (the peacock spider's fan, the ant mimic) do not pulse.\nfunction Idle.abdomenScale(t: number, amount: number, cfg: any): number\n\tlocal b = cfg.breathe\n\treturn 1 + (b.scale or 0) * Idle.breath(t, b.period) * amount\nend\n\n-- The pose at time t. `out` (ROBLOX-93): a pose to fill and return instead of making a new one, so the rig, which asks every frame, makes no table of it.\nfunction Idle.pose(t: number, calm: number, cfg: any, out: Pose?): Pose\n\tlocal b, k = cfg.breathe, cfg.tilt\n\tlocal breath = Idle.breath(t, b.period)\n\tlocal p = k.periods\n\tlocal pose: Pose = out or { bodyLift = 0, abdomenLift = 0, abdomenPitch = 0, headRoll = 0, headYaw = 0, headPitch = 0 }\n\tpose.bodyLift = b.bodyLift * breath * calm\n\tpose.abdomenLift = b.lift * breath * calm\n\tpose.abdomenPitch = math.rad(b.pitchDeg) * breath * calm\n\tpose.headRoll = math.rad(k.rollDeg) * calm * (0.65 * math.sin(TAU * t / p[1]) + 0.35 * math.sin(TAU * t / p[2] + 1.1))\n\tpose.headYaw = math.rad(k.yawDeg) * calm * (0.7 * math.sin(TAU * t / p[3] + 0.4) + 0.3 * math.sin(TAU * t / p[4] + 2.0))\n\tpose.headPitch = math.rad(k.pitchDeg) * calm * math.sin(TAU * t / p[5] + 0.9)\n\treturn pose\nend\n\n-- The largest angle each part of the pose can reach (for tests and for the docs).\nfunction Idle.limits(cfg: any): Pose\n\tlocal b, k = cfg.breathe, cfg.tilt\n\treturn {\n\t\tbodyLift = b.bodyLift, abdomenLift = b.lift, abdomenPitch = math.rad(b.pitchDeg),\n\t\theadRoll = math.rad(k.rollDeg), headYaw = math.rad(k.yawDeg), headPitch = math.rad(k.pitchDeg),\n\t}\nend\n\n-- Palp drumming in bursts while the spider stands still: the angle (radians, about the palp's base) of palp k (1 or 2). The rig asks for each palp on its own,\n-- every frame (ROBLOX-93: no table made of the pair); `Idle.palps` is the pair, for the tests and the docs.\nfunction Idle.palp(t: number, drum: number, palp: any, k: number): number\n\tlocal burst = math.clamp((math.sin(t * 1.3 + 0.7 * k) - 0.55) / 0.3, 0, 1)\n\tlocal beat = math.max(0, math.sin(t * TAU * palp.drumHz + math.pi * k))\n\treturn math.rad(palp.drumDeg) * drum * burst * beat\nend\nfunction Idle.palps(t: number, drum: number, palp: any): { number }\n\treturn { Idle.palp(t, drum, palp, 1), Idle.palp(t, drum, palp, 2) }\nend\n\n-- Authored salticid-like stop/snap/settle accents, not a measured biological frequency.\n-- Short asymmetric pulses separated by stillness, instead of continuous vibration.\nlocal function pulse(t: number, period: number, offset: number): number\n\tlocal phase = (t + offset) % period\n\tif phase >= 0.19 then return 0 end\n\tif phase < 0.035 then return phase / 0.035 end\n\treturn (1 - (phase - 0.035) / 0.155) ^ 2\nend\nfunction Idle.snap(t: number, moving: boolean): (number, number)\n\tlocal a, b = pulse(t, 1.37, 0.31), pulse(t, 2.11, 0.83)\n\treturn math.rad(if moving then 3 else 5) * (a - b), 0.022 * a\nend\n\nreturn Idle\n",4016,3221819922},{"Shared/Rig/Living","--!strict\n-- Living motion for the drawn spider (ROBLOX-87): the small things an animal does when it is not being asked to do anything. Display only, full\n-- detail only (the rig makes one only when its detail tier has `idle`), never fed back into movement, the camera, the collider, the senses or the\n-- simulation's clock. Pure numbers, stepped by SpiderRig with the frame's time, so tests/idle.luau steps it on its own: no Roblox types.\n--\n-- What it keeps: (1) ATTENTION: a yaw offset of the whole drawn body toward what the player is watching, at most `attention.maxDeg`, eased over\n-- `attention.easeSeconds` and back to nothing while the spider walks, and a glance of the principal eyes toward the same point; (2) GROOMING: after\n-- `groom.after` seconds of standing, a bout every `groom.gap` seconds from a seeded stream (a palp drawn through the jaws, or a leg I pulled forward and\n-- wiped by the palps), and after a meal (the \"groom\" cue) a longer cleaning (both palps, then legs I and II); (3) ALARM: the \"alarm\" cue (the wasp's warning, the\n-- rival's windup) raises legs I and freezes the idle motion for `alarm.seconds`; (4) a tarantula's STRETCH: with `stretch`, every `stretch.gap` seconds one\n-- leg reaches out and settles again over `stretch.seconds`, and it never grooms. Breathing is in Rig/Idle (the abdomen's scale) and SpiderRig.\n-- Reduced Motion is none of it. Every number is in the appearance's `idle` table (`groom`, `attention`, `alarm`, `stretch`) and is ART, not measured.\n\nlocal Living = {}\nLiving.__index = Living\n\n-- One leg's override: `w` is how far it is drawn there (0..1). `rel` says (x, y, z) is an offset from where the foot is (a stretch), else a place in the\n-- body frame in studs (x mirrored for the left leg). `kneeOut` and `kneeUp` bend the knee out and up.\nexport type LegPose = { w: number, rel: boolean, x: number, y: number, z: number, kneeOut: number, kneeUp: number }\nexport type Pose = {\n\tyaw: number, -- radians, the drawn body's extra turn (positive turns toward -X: the body frame's +Y axis)\n\tglanceX: number, glanceY: number, -- -1..1: where the principal eyes look, across and up\n\tpalpYaw: { number }, palpPitch: { number }, -- the palps' extra turn (toward the jaws) and pitch, radians, palp 1 (left) and palp 2 (right)\n\tlegs: { LegPose }, -- by leg: 1..4 the left legs I to IV, 5..8 the right\n\tfreeze: number, -- 0..1: an alarm: the idle motion stands still\n\tsettle: number, -- 0..1: the mating scene's settle (ROBLOX-89): the body sinks and the breath deepens\n\tbreath: number, -- the breath's gain: 1, and `settle.breath` at full settle\n\tbout: string?, -- the bout now (\"palp\", \"leg\", \"meal\", \"stretch\"), or nil\n\tact: string?, -- the act of the bout now (tests)\n}\ntype Act = { kind: string, start: number, dur: number, index: number }\ntype Bout = { kind: string, t: number, total: number, acts: { Act }, abort: boolean }\nexport type State = {\n\tcfg: any,\n\tt: number, standS: number, wait: number, weight: number,\n\tyaw: number, glanceX: number, glanceY: number,\n\tbout: Bout?, pendingMeal: number?, alarmT: number?,\n\tmeetT: number?, meetLen: number, meetW: number, settleT: number?, settleLen: number, settleW: number, -- the scene's cues (ROBLOX-89): their clock, length and eased weight\n\trng: number,\n\tpose: Pose,\n\tlog: { { t: number, kind: string } }, -- the bouts begun (tests; kept to the last 64)\n}\n\nlocal TAU = math.pi * 2\n\nfunction Living.hash(text: string): number\n\tlocal h = 5381\n\tfor i = 1, #text do h = (h * 33 + string.byte(text, i)) % 4294967296 end\n\treturn h\nend\n\nlocal function unit(self: State): number -- a seeded stream: a linear congruential generator, not a measured anything\n\tself.rng = (self.rng * 1664525 + 1013904223) % 4294967296\n\treturn self.rng / 4294967296\nend\nlocal function range(self: State, r: { number }): number return r[1] + (r[2] - r[1]) * unit(self) end\n\nlocal function smooth(x: number): number\n\tlocal c = math.clamp(x, 0, 1)\n\treturn c * c * (3 - 2 * c)\nend\n\nfunction Living.new(cfg: any, seed: number): State\n\tlocal legs: { LegPose } = {}\n\tfor i = 1, 8 do legs[i] = { w = 0, rel = false, x = 0, y = 0, z = 0, kneeOut = 0, kneeUp = 0 } end\n\tlocal self: State = {\n\t\tcfg = cfg, t = 0, standS = 0, wait = 0, weight = 0, yaw = 0, glanceX = 0, glanceY = 0,\n\t\tbout = nil, pendingMeal = nil, alarmT = nil, rng = seed % 4294967296,\n\t\tmeetT = nil, meetLen = 0, meetW = 0, settleT = nil, settleLen = 0, settleW = 0,\n\t\tpose = { yaw = 0, glanceX = 0, glanceY = 0, palpYaw = { 0, 0 }, palpPitch = { 0, 0 }, legs = legs, freeze = 0, settle = 0, breath = 1, bout = nil, act = nil },\n\t\tlog = {},\n\t}\n\tunit(self) -- (the first draws of a small seed are close together)\n\tunit(self)\n\tlocal first = if cfg.groom then cfg.groom.firstWait elseif cfg.stretch then cfg.stretch.firstWait else { 1, 2 }\n\tself.wait = range(self, first)\n\treturn self\nend\n\n-- The cue from the host: \"groom\" (a meal has ended: a longer cleaning, once it stands still) or \"alarm\" (a warning: raise legs I and freeze); and, for the mating scene\n-- (ROBLOX-89), \"meet\" (reach out to the other spider) and \"settle\" (sink and breathe deeper), each for `seconds` (default the look's own) with its ease in and out,\n-- and \"release\", which lets both go at once.\nfunction Living.cue(self: State, name: string, seconds: number?)\n\tif name == \"groom\" and self.cfg.groom then\n\t\tself.pendingMeal = 30\n\telseif name == \"alarm\" and self.cfg.alarm then\n\t\tself.alarmT = 0\n\telseif name == \"meet\" and self.cfg.meet then\n\t\tself.meetT, self.meetLen = 0, seconds or self.cfg.meet.seconds\n\telseif name == \"settle\" and self.cfg.settle then\n\t\tself.settleT, self.settleLen = 0, seconds or self.cfg.settle.seconds\n\telseif name == \"release\" then\n\t\tself.meetT, self.settleT = nil, nil\n\tend\nend\n\n-- A cue's eased weight (a slew-limited share, so a release or a late cue never pops): up while `on`, down otherwise. Under Reduced Motion it is a held pose, all or nothing.\n-- (A function of the module, not made again every step: ROBLOX-93.)\nlocal function ease(w: number, on: boolean, spec: any, dt: number, reduced: boolean): number\n\tif spec == nil then return 0 end\n\tif reduced then return if on then 1 else 0 end\n\treturn math.clamp(w + (if on then dt / spec.riseSeconds else -dt / spec.fallSeconds), 0, 1)\nend\n\n-- The scene's cues for one step: their clocks, and their eased weights.\nlocal function stepScene(self: State, dt: number, reduced: boolean)\n\tlocal cfg = self.cfg\n\tlocal meet, settle = cfg.meet, cfg.settle\n\tif self.meetT ~= nil then\n\t\tself.meetT += dt\n\t\tif self.meetT >= self.meetLen then self.meetT = nil end\n\tend\n\tif self.settleT ~= nil then\n\t\tself.settleT += dt\n\t\tif self.settleT >= self.settleLen then self.settleT = nil end\n\tend\n\t-- (a cue's seconds are its whole length, the ease out included: it is let go `fallSeconds` before its end)\n\tself.meetW = ease(self.meetW, self.meetT ~= nil and meet ~= nil and self.meetT < self.meetLen - meet.fallSeconds, meet, dt, reduced)\n\tself.settleW = ease(self.settleW, self.settleT ~= nil and settle ~= nil and self.settleT < self.settleLen - settle.fallSeconds, settle, dt, reduced)\nend\n\nlocal function acts(self: State, kind: string): ({ Act }, number)\n\tlocal g, out, at = self.cfg.groom, {} :: { Act }, 0\n\tlocal function add(k: string, dur: number, index: number)\n\t\ttable.insert(out, { kind = k, start = at, dur = dur, index = index })\n\t\tat += dur\n\tend\n\tif kind == \"palp\" then\n\t\tadd(\"palp\", g.palpSeconds, 1 + math.floor(unit(self) * 2))\n\telseif kind == \"leg\" then\n\t\tadd(\"leg\", g.legSeconds, if unit(self) < 0.5 then 1 else 5)\n\telseif kind == \"meal\" then\n\t\tadd(\"palps\", g.mealPalpSeconds, 0)\n\t\tfor _, index in { 1, 5, 2, 6 } do add(\"leg\", g.legSeconds, index) end -- both legs I, then both legs II\n\telseif kind == \"stretch\" then\n\t\tadd(\"stretch\", self.cfg.stretch.seconds, 1 + math.floor(unit(self) * 8))\n\tend\n\treturn out, at\nend\n\nlocal function begin(self: State, kind: string)\n\tlocal list, total = acts(self, kind)\n\tself.bout = { kind = kind, t = 0, total = total, acts = list, abort = false }\n\ttable.insert(self.log, { t = self.t, kind = kind })\n\tif #self.log > 64 then table.remove(self.log, 1) end\nend\n\nlocal function clearPose(pose: Pose)\n\tpose.yaw, pose.glanceX, pose.glanceY, pose.freeze, pose.bout, pose.act = 0, 0, 0, 0, nil, nil\n\tpose.settle, pose.breath = 0, 1\n\tpose.palpYaw[1], pose.palpYaw[2], pose.palpPitch[1], pose.palpPitch[2] = 0, 0, 0, 0\n\tfor _, leg in pose.legs do leg.w = 0 end\nend\n\n-- (the numbers, not a table of them: a grooming leg and a stretch are set every step, ROBLOX-93)\nlocal function setLeg(pose: Pose, index: number, w: number, x: number, y: number, z: number, kneeOut: number, kneeUp: number, rel: boolean)\n\tlocal leg = pose.legs[index]\n\tleg.w, leg.rel, leg.x, leg.y, leg.z = w, rel, x, y, z\n\tleg.kneeOut, leg.kneeUp = kneeOut, kneeUp\nend\n-- A leg to a look's own place (`spec` = { x, y, z, kneeOut, kneeUp }, the last two optional).\nlocal function setLegAt(pose: Pose, index: number, w: number, spec: any, rel: boolean)\n\tsetLeg(pose, index, w, spec.x, spec.y, spec.z, spec.kneeOut or 0, spec.kneeUp or 0, rel)\nend\n\n-- The pose of the scene's cues now (their weights are in the state): legs I reach, the palps come up and in, the body sinks and the breath deepens.\nfunction Living._sceneLegs(self: State, pose: Pose, legsFree: boolean)\n\tlocal cfg = self.cfg\n\tlocal meet, settle = cfg.meet, cfg.settle\n\tlocal m = smooth(self.meetW)\n\tif meet ~= nil and m > 0 then\n\t\tif legsFree then\n\t\t\tsetLegAt(pose, 1, m, meet.reach, false)\n\t\t\tsetLegAt(pose, 5, m, meet.reach, false)\n\t\tend\n\t\tfor k = 1, 2 do\n\t\t\tlocal inward = if k == 1 then -1 else 1\n\t\t\tpose.palpYaw[k] = inward * math.rad(meet.palpYawDeg) * m\n\t\t\tpose.palpPitch[k] = -math.rad(meet.palpLiftDeg) * m\n\t\tend\n\tend\n\tlocal s = smooth(self.settleW)\n\tif settle ~= nil and s > 0 then\n\t\tpose.settle = s\n\t\tpose.breath = 1 + (settle.breath - 1) * s\n\tend\nend\n\n-- One step. standing: still on a surface with nothing else drawn on the body; reduced: Reduced Motion; focusYaw and focusPitch (radians) are where the\n-- watched point is from the drawn body's heading (nil when nothing is watched); alarmLegs: the legs may be drawn raised (nothing else has them).\nfunction Living.step(self: State, dt: number, standing: boolean, reduced: boolean, focusYaw: number?, focusPitch: number?, alarmLegs: boolean): Pose\n\tlocal cfg, pose = self.cfg, self.pose\n\tclearPose(pose)\n\tstepScene(self, dt, reduced)\n\tif reduced then -- no motion at all: whatever was under way is gone (the scene's reach and settle are held as poses, not moved)\n\t\tself.bout, self.weight, self.alarmT, self.yaw, self.glanceX, self.glanceY, self.pendingMeal, self.standS = nil, 0, nil, 0, 0, 0, nil, 0\n\t\tLiving._sceneLegs(self, pose, alarmLegs)\n\t\treturn pose\n\tend\n\tself.t += dt\n\tself.standS = if standing then self.standS + dt else 0\n\n\tLiving._sceneLegs(self, pose, alarmLegs)\n\n\t-- attention: the body's turn toward the watched point (only while it stands), the eyes' glance toward it (always)\n\tlocal att = cfg.attention\n\tif att then\n\t\tlocal ease = 1 - math.exp(-dt / (att.easeSeconds / 3))\n\t\tlocal want = if standing and focusYaw ~= nil then math.clamp(focusYaw, -math.rad(att.maxDeg), math.rad(att.maxDeg)) else 0\n\t\tself.yaw += (want - self.yaw) * ease\n\t\tlocal span = math.rad(att.glanceSpanDeg)\n\t\tlocal gx = if focusYaw ~= nil then math.clamp(-(focusYaw - self.yaw) / span, -1, 1) else 0\n\t\tlocal gy = if focusPitch ~= nil and focusYaw ~= nil then math.clamp(focusPitch / span, -1, 1) else 0\n\t\tself.glanceX += (gx - self.glanceX) * ease\n\t\tself.glanceY += (gy - self.glanceY) * ease\n\t\tpose.yaw, pose.glanceX, pose.glanceY = self.yaw, self.glanceX, self.glanceY\n\tend\n\n\t-- alarm: legs I up and everything else still\n\tlocal alarm = cfg.alarm\n\tlocal alarming = false\n\tif self.alarmT ~= nil and alarm then\n\t\tlocal t = self.alarmT + dt\n\t\tself.alarmT = if t >= alarm.seconds then nil else t\n\t\tlocal env = smooth(math.min(t / alarm.riseSeconds, (alarm.seconds - t) / alarm.fallSeconds, 1))\n\t\tif env > 0 then\n\t\t\talarming = true\n\t\t\tpose.freeze = env\n\t\t\tif alarmLegs then\n\t\t\t\tsetLegAt(pose, 1, env, alarm.raise, false)\n\t\t\t\tsetLegAt(pose, 5, env, alarm.raise, false)\n\t\t\tend\n\t\tend\n\tend\n\n\t-- the scene's reach and settle (ROBLOX-89): grooming and the accents give way, the breath goes on (an alarm still wins the legs)\n\tif self.meetW > 0 or self.settleW > 0 then alarming = true end\n\n\t-- bouts\n\tlocal groom = cfg.groom\n\tlocal bout = self.bout\n\tif bout ~= nil then\n\t\tif not standing or alarming then bout.abort = true end\n\t\tif bout.abort then\n\t\t\tself.weight -= dt / (if groom then groom.abortSeconds else 0.25)\n\t\t\tif self.weight <= 0 then\n\t\t\t\tself.bout, self.weight = nil, 0\n\t\t\t\tself.wait = range(self, if groom then groom.gap else cfg.stretch.gap) -- (a bout that was cut short is not begun again at once)\n\t\t\tend\n\t\telse\n\t\t\tself.weight = math.min(1, self.weight + dt / 0.2)\n\t\t\tbout.t += dt\n\t\t\tif bout.t >= bout.total then\n\t\t\t\tself.bout, self.weight = nil, 0\n\t\t\t\tself.wait = range(self, if groom then groom.gap else cfg.stretch.gap)\n\t\t\tend\n\t\tend\n\tend\n\tif self.bout == nil and standing and not alarming and (groom or cfg.stretch) then\n\t\tlocal pending = self.pendingMeal\n\t\tif pending ~= nil then\n\t\t\tself.pendingMeal = if pending - dt <= 0 then nil else pending - dt\n\t\tend\n\t\tlocal after = if groom then groom.after else cfg.stretch.after\n\t\tif pending ~= nil and groom and self.standS >= groom.mealDelay then\n\t\t\tself.pendingMeal = nil\n\t\t\tbegin(self, \"meal\")\n\t\telseif self.standS >= after and (groom or cfg.stretch) then\n\t\t\tself.wait -= dt\n\t\t\tif self.wait <= 0 then\n\t\t\t\tbegin(self, if groom then (if unit(self) < 0.5 then \"palp\" else \"leg\") else \"stretch\")\n\t\t\tend\n\t\tend\n\tend\n\n\t-- the pose of the act now\n\tlocal live = self.bout\n\tif live ~= nil and self.weight > 0 then\n\t\tlocal current: Act = live.acts[#live.acts]\n\t\tfor _, a in live.acts do\n\t\t\tif live.t >= a.start and live.t < a.start + a.dur then current = a end\n\t\tend\n\t\tlocal a = current\n\t\tlocal u = math.clamp((live.t - a.start) / a.dur, 0, 1)\n\t\tlocal w = smooth(math.min(u, 1 - u) / (if groom then groom.fade else 0.18)) * self.weight\n\t\tpose.bout, pose.act = live.kind, a.kind\n\t\tif a.kind == \"palp\" or a.kind == \"palps\" then\n\t\t\tfor k = 1, 2 do\n\t\t\t\tif a.kind == \"palp\" and a.index ~= k then continue end\n\t\t\t\tlocal phase = if a.kind == \"palps\" and k == 2 then math.pi else 0\n\t\t\t\tlocal stroke = 0.5 - 0.5 * math.cos(TAU * groom.strokes * u + phase) -- 0 at the start of a stroke, 1 at its end\n\t\t\t\tlocal inward = if k == 1 then -1 else 1 -- (the yaw that turns each palp toward the midline)\n\t\t\t\tpose.palpYaw[k] = inward * math.rad(groom.palpYawDeg) * w * (0.35 + 0.65 * stroke)\n\t\t\t\tpose.palpPitch[k] = math.rad(groom.palpPitchDeg) * w * stroke\n\t\t\tend\n\t\telseif a.kind == \"leg\" then\n\t\t\tlocal pair = (a.index - 1) % 4 + 1\n\t\t\tlocal spec = groom.legs[pair]\n\t\t\tlocal sweep = math.sin(TAU * groom.strokes * u) -- the leg is drawn through the palps to and fro\n\t\t\tsetLeg(pose, a.index, w, spec.x, spec.y, spec.z + spec.sweep * sweep, spec.kneeOut or 0, spec.kneeUp or 0, false)\n\t\t\tfor k = 1, 2 do -- both palps come in to hold it\n\t\t\t\tlocal inward = if k == 1 then -1 else 1\n\t\t\t\tpose.palpYaw[k] = inward * math.rad(groom.legPalpYawDeg) * w\n\t\t\t\tpose.palpPitch[k] = math.rad(groom.palpPitchDeg) * 0.5 * w * (0.5 + 0.5 * sweep)\n\t\t\tend\n\t\telseif a.kind == \"stretch\" then\n\t\t\tlocal st = cfg.stretch\n\t\t\tlocal pair = (a.index - 1) % 4 + 1\n\t\t\tlocal along = if pair <= 2 then -st.along else st.along * 0.6\n\t\t\tsetLeg(pose, a.index, smooth(math.min(u, 1 - u) / 0.35) * self.weight, st.out, st.lift, along, 0, st.kneeUp or 0, true)\n\t\tend\n\tend\n\treturn pose\nend\n\nreturn Living\n",15490,2338626620},{"Shared/Rig/PeacockDance","--!strict\n-- The peacock spider's courtship dance as a pose (ROBLOX-29): pure, Vector3-free, display only. Nothing here moves the body, the\n-- collider, the senses, the jump or the silk; SpiderRig reads the pose and bends the drawn abdomen, fan, palps and legs III.\n-- All numbers are in Data/Peacock (documented ones from Girard et al. 2011, the rest marked artistic).\n--\n-- A dance is a loop of phases (approach with bobbing and a rumble-rump, the fan raised with legs III up, the fan dance with the leg\n-- wave, a freeze with fan-flapping, a second dance, the fold) played from the time it is given: step(dt, standing, moving) adds\n-- the dt it is handed, so slow motion slows the dance as it slows everything else. Walking, a jump, leaving the surface or stop()\n-- end it at once; the pose then eases out over Peacock.fadeOutSeconds from where it was.\n\nlocal Peacock = require(script.Parent.Parent.Data.Peacock)\n\nlocal PeacockDance = {}\nPeacockDance.__index = PeacockDance\n\n-- Every angle is in radians. Sway and shiver are signed; fanOpen, legsRaise and legsWave run 0..1 (legsWave: 0 erect, 1 swept down).\nexport type Pose = {\n\tphase: string, -- the phase of the loop, \"none\" when no dance shows\n\tpresence: number, -- 0..1: how much of the pose shows (ramps in and out)\n\tabdomenPitch: number, -- rear end up\n\tabdomenSway: number, -- side to side with the fan up\n\tshiver: number, -- the 12.1 Hz tremble of a rumble-rump\n\tfanOpen: number,\n\tpalp: number, -- both pedipalps, in unison\n\tlegsRaise: number,\n\tlegsWave: number,\n\trumble: number, -- 0..1: a rumble-rump is on (for the felt caption, not for the picture)\n}\n\nlocal TAU = math.pi * 2\n\nlocal function smooth(x: number): number\n\tlocal c = math.clamp(x, 0, 1)\n\treturn c * c * (3 - 2 * c)\nend\n\nPeacockDance.NONE = {\n\tphase = \"none\", presence = 0, abdomenPitch = 0, abdomenSway = 0, shiver = 0, fanOpen = 0, palp = 0, legsRaise = 0, legsWave = 0, rumble = 0,\n} :: Pose\n\n-- Which phase a loop time falls in: its index, the seconds into it and the loop time it starts at.\nfunction PeacockDance.phaseAt(t: number): (number, number, number)\n\tlocal phases = Peacock.phases\n\tlocal u = t % Peacock.loopSeconds\n\tlocal start = 0\n\tfor i, p in phases do\n\t\tif u < start + p.seconds then return i, u - start, start end\n\t\tstart += p.seconds\n\tend\n\treturn #phases, phases[#phases].seconds, start - phases[#phases].seconds\nend\n\nlocal LEVELS = { \"pitch\", \"open\", \"legs\", \"sway\", \"wave\", \"flap\", \"bob\", \"palp\" }\n\n-- The levels (0..1) at a loop time: the previous phase's, eased toward this phase's over its `ease`.\nlocal function levelsAt(t: number): ({ [string]: number }, string)\n\tlocal phases = Peacock.phases\n\tlocal i, u = PeacockDance.phaseAt(t)\n\tlocal cur, prev = phases[i], phases[if i == 1 then #phases else i - 1]\n\tlocal k = smooth(u / math.max(math.min(cur.ease or Peacock.ease, cur.seconds), 1e-6))\n\tlocal out: { [string]: number } = {}\n\tfor _, name in LEVELS do\n\t\tlocal a, b = (prev :: any)[name] :: number, (cur :: any)[name] :: number\n\t\tout[name] = a + (b - a) * k\n\tend\n\treturn out, cur.id\nend\n\n-- 0..1: a rumble-rump is on at this loop time (it starts `rumble` seconds into its phase and lasts Peacock.rumble.seconds).\nlocal function rumbleAt(t: number): number\n\tlocal u = t % Peacock.loopSeconds\n\tlocal start = 0\n\tlocal r = Peacock.rumble\n\tfor _, p in Peacock.phases do\n\t\tlocal at = p.rumble\n\t\tif at then\n\t\t\tlocal from, to = start + at, start + at + r.seconds\n\t\t\tif u >= from and u <= to then\n\t\t\t\treturn math.min(smooth((u - from) / r.edgeSeconds), smooth((to - u) / r.edgeSeconds))\n\t\t\tend\n\t\tend\n\t\tstart += p.seconds\n\tend\n\treturn 0\nend\n\n-- 0..1: inside a bobbing bout (bouts and rests repeat through the loop; the phase's `bob` level says where they show).\nlocal function bobBoutAt(t: number): number\n\tlocal b = Peacock.rates.bob\n\tlocal u = t % (b.boutSeconds + b.restSeconds)\n\tif u >= b.boutSeconds then return 0 end\n\treturn math.min(smooth(u / 0.1), smooth((b.boutSeconds - u) / 0.1))\nend\n\n-- The whole pose at a loop time, before presence. reduced: ReducedMotion (half amplitudes, no tremble).\nfunction PeacockDance.rawPose(t: number, reduced: boolean): Pose\n\tlocal L, id = levelsAt(t)\n\tlocal a, r = Peacock.amplitude, Peacock.rates\n\tlocal amp = if reduced then Peacock.reducedMotion else 1\n\tlocal rumble = rumbleAt(t)\n\tlocal bob = L.bob * bobBoutAt(t) * math.sin(TAU * r.bob.hz * t) * math.rad(a.bobDeg) * amp\n\tlocal flap = L.flap * a.flapDepth * amp * (0.5 + 0.5 * math.sin(TAU * r.fanFlap.hz * t))\n\treturn {\n\t\tphase = id, presence = 1,\n\t\tabdomenPitch = L.pitch * math.rad(a.raiseDeg) + bob,\n\t\tabdomenSway = L.sway * math.rad(Peacock.fanArcDeg.used / 2) * math.sin(TAU * r.fanDance.hz * t) * amp,\n\t\tshiver = if reduced then 0 else rumble * math.rad(a.shiverDeg) * math.sin(TAU * Peacock.rumble.bumpsHz * t),\n\t\tfanOpen = L.open * (1 - flap),\n\t\tpalp = L.palp * math.rad(a.palpDeg) * amp * (0.5 + 0.5 * math.sin(TAU * r.palpFlicker.hz * t)),\n\t\tlegsRaise = L.legs,\n\t\tlegsWave = L.wave * amp * (0.5 + 0.5 * math.sin(TAU * r.legWave.hz * t + 1.2)),\n\t\trumble = rumble,\n\t}\nend\n\nlocal function scaled(p: Pose, k: number): Pose\n\treturn {\n\t\tphase = p.phase, presence = k,\n\t\tabdomenPitch = p.abdomenPitch * k, abdomenSway = p.abdomenSway * k, shiver = p.shiver * k, fanOpen = p.fanOpen * k,\n\t\tpalp = p.palp * k, legsRaise = p.legsRaise * k, legsWave = p.legsWave * k, rumble = p.rumble * k,\n\t}\nend\n\nexport type Dance = typeof(setmetatable(\n\t{} :: { t: number, active: boolean, presence: number, raw: Pose?, reduced: boolean },\n\tPeacockDance\n))\n\nfunction PeacockDance.new(): Dance\n\treturn setmetatable({ t = 0, active = false, presence = 0, raw = nil :: Pose?, reduced = false }, PeacockDance)\nend\n\n-- Begin the loop from its start. Refused (false) when the spider is not standing still on a surface.\nfunction PeacockDance.start(self: Dance, standing: boolean, moving: boolean): boolean\n\tif self.active or not standing or moving then return false end\n\tself.t, self.active = 0, true\n\treturn true\nend\n\n-- End the dance at once; the pose eases out over Peacock.fadeOutSeconds from where it was.\nfunction PeacockDance.stop(self: Dance)\n\tself.active = false\nend\n\n-- Showing at all (dancing, or still easing out).\nfunction PeacockDance.showing(self: Dance): boolean\n\treturn self.active or self.presence > 0\nend\n\n-- One step of dt seconds (the simulation's, so slow motion slows the dance). standing: on a surface and not in a jump; moving: walking.\nfunction PeacockDance.step(self: Dance, dt: number, standing: boolean, moving: boolean): Pose\n\tif self.active and (not standing or moving) then self.active = false end\n\tif self.active then\n\t\tself.t += dt\n\t\tself.presence = math.min(1, self.presence + dt / Peacock.rampInSeconds)\n\t\tself.raw = PeacockDance.rawPose(self.t, self.reduced)\n\telse\n\t\tself.presence = math.max(0, self.presence - dt / Peacock.fadeOutSeconds)\n\t\tif self.presence == 0 then self.raw = nil end\n\tend\n\tlocal raw = self.raw\n\tif raw == nil then return PeacockDance.NONE end\n\treturn scaled(raw, smooth(self.presence))\nend\n\nreturn PeacockDance\n",6993,748221362},{"Shared/Rig/Setae","--!strict\n-- Where the spider's hairs (setae) go: pure layout from the appearance table, Vector3 only, so tests/run.luau and\n-- tests/look.luau check it. Body frame as in SpiderRig: +Y up, -Z forward. Deterministic: the same appearance always gives\n-- the same fuzz. SpiderRig turns each entry into one thin anchored part.\n-- The coat is short and sleek and takes its colour from the daughter's pattern: black hairs on the black areas, white hairs\n-- only inside the white spots and the band (the pale cheeks stay clean). Nothing grey or frosted is in the body coat; only\n-- the face keeps a little silver (the tufts and the ruff) and the palps their fluff.\n--   lock: short thin hairs lying nearly flat, combed toward the rear      pale: the same, white, inside a white spot or the band\n--   fringe: short hairs along the sides, lifted a little, for a soft edge  guard: a few short hairs that stand up\n--   tuft: the plumes at the upper sides of the head       ruff: pale hair low on each cheek\n--   palp: the fluff on the pedipalps (rest pose; SpiderRig moves it with the palp)       leg: see Setae.leg\n-- The hairs that come in pairs (the tufts, the ruff, the palps' fluff, a leg and the leg that mirrors it) are mirror images of each other, hair for hair (ROBLOX-93), so that a tier\n-- that keeps one in so many keeps the same ones on both sides (Setae.thin), and a hair that must be left out for an eye is left out on both. No hair touches an eye (EYE_PAD).\n\nlocal Anatomy = require(script.Parent.Anatomy)\n\nlocal Setae = {}\n\nexport type Hair = {\n\tat: Vector3, dir: Vector3, normal: Vector3, length: number, width: number, thick: number, transparency: number,\n\tkind: string, group: string, side: number, tone: string, white: boolean, grey: boolean, frost: boolean,\n}\nexport type LegHair = { segment: number, t: number, theta: number, length: number, tone: string, white: boolean, grey: boolean, frost: boolean, lift: number?, width: number?, transparency: number? } -- (width, transparency: a fringe's own, ROBLOX-127)\nexport type Patch = { x: number, z: number, rx: number, rz: number, angle: number }\n\nlocal GOLDEN = 2.399963229728653\n-- How far (studs) any part of a hair stays off every eye's ellipsoid: a little more than half the widest hair's width.\nlocal EYE_PAD = 0.004\n\n-- A repeatable 0..1 value per index (no global RNG state).\nlocal function hash(i: number, salt: number): number\n\tlocal x = math.sin(i * 12.9898 + salt * 78.233) * 43758.5453\n\treturn x - math.floor(x)\nend\nSetae.hash = hash\n\nlocal function between(range: { number }, t: number): number\n\treturn range[1] + (range[2] - range[1]) * t\nend\n\n-- ---------------------------------------------------------------- the pattern: where the white is\n-- The white spots and the band as flat ellipses, in studs from the abdomen's centre (x across, z along): the same ones\n-- SpiderRig draws as AbdomenSpot and FrontBand. `angle` turns an ellipse about the vertical (CFrame.Angles(0, angle, 0)).\nfunction Setae.patches(look: any): { Patch }\n\tlocal ar = look.abdomenRadii\n\tlocal out: { Patch } = {}\n\tfor _, s in look.spots do\n\t\ttable.insert(out, { x = s.x * ar[1], z = s.z * ar[3], rx = s.rx, rz = s.rz, angle = s.angle })\n\tend\n\tlocal band = look.band\n\tfor i = 0, band.count - 1 do\n\t\ttable.insert(out, { x = (i - (band.count - 1) / 2) * band.step * ar[1], z = band.z * ar[3], rx = band.rx, rz = band.rz, angle = 0 })\n\tend\n\treturn out\nend\n\n-- Is the offset (dx, dz) from the abdomen's centre inside the patch grown by `grow` studs (negative: shrunk)?\nlocal function inside(p: Patch, dx: number, dz: number, grow: number): boolean\n\tlocal rx, rz = p.rx + grow, p.rz + grow\n\tif rx <= 0 or rz <= 0 then return false end\n\tlocal c, s = math.cos(p.angle), math.sin(p.angle)\n\tlocal ex, ez = dx - p.x, dz - p.z\n\tlocal u = ex * c - ez * s\n\tlocal v = ex * s + ez * c\n\treturn (u / rx) ^ 2 + (v / rz) ^ 2 < 1\nend\n\nlocal function insideAny(patches: { Patch }, dx: number, dz: number, grow: number): boolean\n\tfor _, p in patches do\n\t\tif inside(p, dx, dz, grow) then return true end\n\tend\n\treturn false\nend\nSetae.insideAny = insideAny\n\n-- ---------------------------------------------------------------- one hair\nlocal function hair(at: Vector3, dir: Vector3, normal: Vector3, length: number, width: number, flat: number, transparency: number, kind: string, group: string, side: number, tone: string): Hair\n\treturn {\n\t\tat = at, dir = dir, normal = normal, length = length, width = width, thick = width * flat, transparency = transparency,\n\t\tkind = kind, group = group, side = side, tone = tone, white = tone == \"white\", grey = tone == \"grey\", frost = tone == \"frost\",\n\t}\nend\n\n-- The way a hair lies: along the surface toward the rear (+Z), turned `yaw` radians to one side, raised `lift` radians off the\n-- surface (0 lies flat, pi/2 stands up).\nlocal function comb(normal: Vector3, lift: number, yaw: number, outward: number?): Vector3\n\tlocal back = Vector3.new(0, 0, 1)\n\tlocal along = back - normal * back:Dot(normal)\n\tif along.Magnitude < 1e-3 then along = Vector3.new(0, 1, 0) - normal * normal.Y end\n\tif along.Magnitude < 1e-3 then return normal end\n\talong = along.Unit\n\tlocal side = normal:Cross(along)\n\tlocal turn = yaw\n\tif outward and math.abs(normal.X) > 0.05 then\n\t\t-- fur that flows back and out: turned away from the back's midline, toward the flank on top and down the flank at the side (ROBLOX-85)\n\t\tlocal away = Vector3.new(normal.Y * (if normal.X >= 0 then 1 else -1), -math.abs(normal.X), 0)\n\t\tturn += (if side:Dot(away) >= 0 then 1 else -1) * outward\n\tend\n\treturn ((along * math.cos(turn) + side * math.sin(turn)) * math.cos(lift) + normal * math.sin(lift)).Unit\nend\n\n-- Where a hair of this class starts: a lying hair sits on the surface (half its thickness above it, so it neither sinks in\n-- nor floats), a standing one is rooted a little inside.\nlocal function rootOf(surface: Vector3, normal: Vector3, lift: number, thick: number): Vector3\n\tif lift < math.rad(25) then return surface + normal * (thick * 0.5 + 0.0012) end\n\treturn surface - normal * 0.003\nend\n\n-- The hair's three points (root, middle, tip) must all be acceptable.\nlocal function allClear(clear: (Vector3) -> boolean, root: Vector3, dir: Vector3, length: number): boolean\n\treturn clear(root) and clear(root + dir * (length * 0.5)) and clear(root + dir * length)\nend\n\n-- One class of coat hairs (kind \"lock\", \"guard\" or \"fringe\") over an ellipsoid; `spec` is the class's table in\n-- Appearances.fuzz. `keep(at, unit)` picks where hairs may grow, `clear(point)` rejects a hair that touches something it must\n-- leave alone (a white patch, an eye). The colour is black or dark: a hair here is on a black area.\n-- (`clearSeg`, if given, is asked of the whole hair, root to tip, as well: ROBLOX-93, so that a hair cannot pass through an eye between its three points.)\nlocal function coat(out: { Hair }, kind: string, spec: any, center: Vector3, radii: Vector3, samples: number, salt: number, group: string, keep: (Vector3, Vector3) -> boolean, clear: (Vector3) -> boolean, clearSeg: ((Vector3, Vector3) -> boolean)?)\n\tfor i = 0, samples - 1 do\n\t\tlocal y = 1 - 2 * (i + 0.5) / samples\n\t\tlocal r = math.sqrt(math.max(0, 1 - y * y))\n\t\tlocal a = i * GOLDEN\n\t\tlocal unit = Vector3.new(math.cos(a) * r, y, math.sin(a) * r)\n\t\tif unit.Y > -0.25 then\n\t\t\tlocal surface = center + Vector3.new(unit.X * radii.X, unit.Y * radii.Y, unit.Z * radii.Z)\n\t\t\tlocal normal = Vector3.new(unit.X / radii.X, unit.Y / radii.Y, unit.Z / radii.Z).Unit\n\t\t\tif keep(surface, unit) then\n\t\t\t\tlocal length = between(spec.length, hash(i, salt))\n\t\t\t\tlocal lift = math.rad(between(spec.lift, hash(i, salt + 5)))\n\t\t\t\tlocal yaw = math.rad(spec.yaw) * (2 * hash(i, salt + 3) - 1)\n\t\t\t\tlocal dir = comb(normal, lift, yaw, if spec.out then math.rad(spec.out) * (0.5 + 0.5 * hash(i, salt + 9)) else nil)\n\t\t\t\tlocal root = rootOf(surface, normal, lift, spec.width * spec.flat)\n\t\t\t\tif allClear(clear, root, dir, length) and (clearSeg == nil or clearSeg(root, root + dir * length)) then\n\t\t\t\t\t-- black or dark, and (`tip`) a few with a paler, greyer cast: the tips of a coat catching the light\n\t\t\t\t\tlocal tone = if hash(i, salt + 11) < spec.black then \"black\" else \"dark\"\n\t\t\t\t\tif spec.tip and hash(i, salt + 17) < spec.tip then tone = \"grey\" end\n\t\t\t\t\ttable.insert(out, hair(root, dir, normal, length, spec.width, spec.flat, spec.transparency, kind, group, 0, tone))\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- White hairs inside the white spots and the band, lying on top of them (the markings are flat, raised discs): a spiral of\n-- hair middles in each ellipse at `spec.density` hairs per square stud, every one kept only if the whole hair stays inside\n-- the patch (shrunk by `spec.margin`), so the white keeps its edge.\nlocal function pale(out: { Hair }, look: any, A: Anatomy.Layout, spec: any)\n\tlocal patches = Setae.patches(look)\n\tlocal ac, ar = A.abdomenCenter, A.abdomenRadii\n\tlocal n = 0\n\tfor pi, patch in patches do\n\t\tlocal count = math.floor(math.pi * patch.rx * patch.rz * spec.density + 0.5)\n\t\tlocal c, s = math.cos(patch.angle), math.sin(patch.angle)\n\t\tfor k = 1, count do\n\t\t\tn += 1\n\t\t\tlocal ring = if count == 1 then 0 else math.sqrt((k - 0.5) / count) * 0.75\n\t\t\tlocal ang = k * GOLDEN + pi\n\t\t\tlocal lu, lv = patch.rx * ring * math.cos(ang), patch.rz * ring * math.sin(ang)\n\t\t\tlocal mx, mz = patch.x + lu * c + lv * s, patch.z - lu * s + lv * c -- the hair's middle, offsets from the abdomen's centre\n\t\t\tlocal length = between(spec.length, hash(n, 41))\n\t\t\tlocal yaw = math.rad(spec.yaw) * (2 * hash(n, 43) - 1)\n\t\t\tlocal lift = math.rad(between(spec.lift, hash(n, 45)))\n\t\t\tlocal dir = comb(Vector3.yAxis, lift, yaw)\n\t\t\tlocal rx, rz = mx - dir.X * length * 0.5, mz - dir.Z * length * 0.5 -- its root\n\t\t\t-- the disc's top: SpiderRig lifts a marking 0.007 above the body and gives it a rounded 0.012 half-thickness\n\t\t\tlocal rho2 = (lu / patch.rx) ^ 2 + (lv / patch.rz) ^ 2\n\t\t\tlocal thick = spec.width * spec.flat\n\t\t\tlocal height = Anatomy.topY(ac, ar, rx, rz) + 0.007 + 0.012 * math.sqrt(math.max(0, 1 - rho2)) + thick * 0.5 + 0.0008\n\t\t\tlocal root = Vector3.new(ac.X + rx, height, ac.Z + rz)\n\t\t\tlocal ok = true\n\t\t\tfor _, along in { 0, 0.5, 1 } do\n\t\t\t\tok = ok and insideAny(patches, rx + dir.X * length * along, rz + dir.Z * length * along, -spec.margin)\n\t\t\tend\n\t\t\tif ok then\n\t\t\t\ttable.insert(out, hair(root, dir, Vector3.yAxis, length, spec.width, spec.flat, spec.transparency, \"pale\", \"abdomen\", 0, \"white\"))\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- A fan of hairs growing from a point of the head: `spec` = { at (unit-sphere direction, mirrored), lean, fan, spread, ... }.\n-- The two sides are mirror images: the left fan's angles are the right's turned the other way, and a hair's length and tone do not depend on the side. A hair whose\n-- length touches an eye (`clearSeg`) is left out (on both sides, being mirror images).\nlocal function plume(out: { Hair }, A: Anatomy.Layout, side: number, spec: any, count: number, length: number, kind: string, salt: number, pick: (number) -> string, clearSeg: (Vector3, Vector3) -> boolean)\n\tlocal p0, n0 = Anatomy.ellipsoidPoint(A.headCenter, A.headRadii, Vector3.new(side * spec.at[1], spec.at[2], spec.at[3]))\n\tlocal axis = Vector3.new(side * spec.lean[1], spec.lean[2], spec.lean[3]).Unit\n\tlocal u = axis:Cross(Vector3.zAxis)\n\tif u.Magnitude < 1e-3 then u = axis:Cross(Vector3.xAxis) end\n\tu = u.Unit\n\tlocal w = axis:Cross(u).Unit\n\tfor k = 1, count do\n\t\tlocal ring = math.sqrt((k - 0.5) / count)\n\t\tlocal ang = if side > 0 then k * GOLDEN + 1 else math.pi - (k * GOLDEN + 1)\n\t\tlocal off = u * math.cos(ang) + w * math.sin(ang)\n\t\tlocal dir = (axis + off * (spec.fan * ring)).Unit\n\t\tlocal at = p0 + off * (spec.spread * ring) - n0 * 0.012\n\t\tlocal l = length * (0.82 + 0.36 * hash(k, salt))\n\t\tif clearSeg(at, at + dir * l) then\n\t\t\ttable.insert(out, hair(at, dir, n0, l, spec.width, spec.flat, spec.transparency, kind, \"head\", side, pick(k * 3)))\n\t\tend\n\tend\nend\n\nfunction Setae.body(look: any): { Hair }\n\tlocal out: { Hair } = {}\n\tlocal f = look.fuzz\n\tif not f or not f.enabled or f.legsOnly then return out end -- (legsOnly: bristles on the legs and nowhere else, the Greenbottle blue)\n\tlocal A = Anatomy.layout(look)\n\tlocal cheek = look.cheek\n\tlocal cy = (cheek.y - A.headCenter.Y) / A.headRadii.Y\n\tlocal cz = (cheek.z - A.headCenter.Z) / A.headRadii.Z\n\tlocal patches = Setae.patches(look)\n\tlocal ac, ar = A.abdomenCenter, A.abdomenRadii\n\tlocal hc, hr = A.headCenter, A.headRadii\n\n\t-- Black hairs keep off the white: no point of a hair may come within `f.clear` studs of a spot or the band, and none\n\t-- may lie on the pale cheek. (The pattern is on the upper surface; the lower flanks have none.)\n\tlocal function offWhiteAbdomen(p: Vector3): boolean\n\t\tif p.Y < ac.Y + 0.02 then return true end\n\t\treturn not insideAny(patches, p.X - ac.X, p.Z - ac.Z, f.clear)\n\tend\n\tlocal function offCheek(p: Vector3): boolean\n\t\tlocal u = Vector3.new((p.X - hc.X) / hr.X, (p.Y - hc.Y) / hr.Y, (p.Z - hc.Z) / hr.Z)\n\t\tif math.abs(u.X) < 0.5 * u.Magnitude then return true end\n\t\tlocal dy = (u.Y / u.Magnitude - cy) / (cheek.radii[2] / hr.Y + f.clear / hr.Y)\n\t\tlocal dz = (u.Z / u.Magnitude - cz) / (cheek.radii[3] / hr.Z + f.clear / hr.Z)\n\t\treturn dy * dy + dz * dz > 1.4\n\tend\n\n\t-- No part of a hair touches an eye (the whole hair, root to tip, against every eye's ellipsoid).\n\tlocal function offEyes(a: Vector3, b: Vector3): boolean\n\t\tfor _, eye in A.eyes do\n\t\t\tif Anatomy.touchesEye(eye, a, b, EYE_PAD) then return false end\n\t\tend\n\t\treturn true\n\tend\n\n\tlocal coats: { { kind: string, spec: any } } = { { kind = \"lock\", spec = f.locks }, { kind = \"guard\", spec = f.guard } }\n\tif f.fringe then table.insert(coats, { kind = \"fringe\", spec = f.fringe }) end\n\tfor n, entry in coats do\n\t\tlocal kind, spec = entry.kind, entry.spec\n\t\tlocal sideOnly: number = spec.side or 0 -- the fringe grows only at the sides, where it makes the outline\n\t\tcoat(out, kind, spec, ac, ar, spec.abdomen, n, \"abdomen\", function(_at, unit)\n\t\t\treturn unit.Z > -0.93 and math.abs(unit.X) >= sideOnly -- not where the abdomen meets the pedicel\n\t\tend, offWhiteAbdomen)\n\t\tcoat(out, kind, spec, hc, hr, spec.head, n + 2, \"head\", function(at, unit)\n\t\t\tif math.abs(unit.X) < sideOnly then return false end\n\t\t\tif unit.Z < -0.55 and unit.Y < 0.75 then return false end -- the eye face stays clear\n\t\t\tfor _, zone in A.hairFree do\n\t\t\t\tif (at - zone.at).Magnitude < zone.radius then return false end\n\t\t\tend\n\t\t\treturn true\n\t\tend, offCheek, offEyes)\n\tend\n\tpale(out, look, A, f.pale)\n\n\t-- Tufts: dark and silvery plumes up and out at the upper sides of the head.\n\tfor _, side in { -1, 1 } do\n\t\tplume(out, A, side, f.tuft, f.tuftHairs, f.tuftLength, \"tuft\", 7, function(i)\n\t\t\tlocal r = hash(i, 21)\n\t\t\treturn if r < 0.15 then \"frost\" elseif r < 0.45 then \"grey\" else \"dark\"\n\t\tend, offEyes)\n\tend\n\t-- Cheek ruff: pale hair low at the sides of the face, beside the jaws.\n\tlocal rf = f.ruff\n\tfor _, side in { -1, 1 } do\n\t\tplume(out, A, side, { at = rf.at, lean = rf.lean, fan = 0.55, spread = 0.03, width = rf.width, flat = rf.flat, transparency = rf.transparency }, rf.hairs, rf.length, \"ruff\", 17, function(i)\n\t\t\tlocal r = hash(i, 23)\n\t\t\treturn if r < rf.whiteShare then \"white\" elseif r < 0.85 then \"frost\" else \"grey\"\n\t\tend, offEyes)\n\tend\n\treturn out\nend\n\n-- Fluff on the pedipalps, in the body frame at rest (SpiderRig moves it with the palp it belongs to; side -1 is palp 1).\nfunction Setae.palp(look: any): { Hair }\n\tlocal out: { Hair } = {}\n\tlocal f = look.fuzz\n\tif not f or not f.enabled or f.legsOnly then return out end\n\tlocal A = Anatomy.layout(look)\n\tlocal pl = look.palp\n\tlocal spec = pl.fluff\n\tfor _, p in A.palps do\n\t\tlocal axis = p.tip - p.base\n\t\tlocal ax = axis.Unit\n\t\tlocal u = ax:Cross(Vector3.xAxis)\n\t\tif u.Magnitude < 1e-3 then u = ax:Cross(Vector3.yAxis) end\n\t\tu = u.Unit\n\t\tlocal w = ax:Cross(u).Unit\n\t\tfor k = 1, spec.hairs do\n\t\t\tlocal t = 0.3 + 0.7 * (k - 0.5) / spec.hairs\n\t\t\tlocal theta = (k * GOLDEN + 1) * p.side -- (the left palp's angles are the right's turned the other way: its hairs are the mirror images of the right's)\n\t\t\tlocal radial = u * math.cos(theta) + w * math.sin(theta)\n\t\t\tlocal r = if t > 0.7 then pl.club[1] else pl.stalk * 0.5\n\t\t\tlocal dir = (radial + ax * 0.6).Unit\n\t\t\tlocal l = spec.length * (0.8 + 0.4 * hash(k, 31))\n\t\t\tlocal rr = hash(k, 33)\n\t\t\tlocal tone = if rr < 0.55 then \"white\" elseif rr < 0.75 then \"frost\" else \"grey\"\n\t\t\ttable.insert(out, hair(p.base + axis * t + radial * (r * 0.8), dir, radial, l, spec.width, spec.flat, spec.transparency, \"palp\", \"palp\", p.side, tone))\n\t\tend\n\tend\n\treturn out\nend\n\n-- The hairs a tier keeps (ROBLOX-93; it was in SpiderRig, and is here so that the tests read what it keeps): one in `every[kind]` of each kind (a kind not listed keeps all, 0 drops\n-- the kind), counted in the order the hairs were laid out and, for the hairs that come in a mirrored pair (`side` is -1 or 1: the tufts, the ruff, the palps' fluff), on each side\n-- by itself, so both sides keep the same indices and the same number: one count over both, with an odd number to a side, kept different hairs, and a different number, on the two.\nfunction Setae.thin(hairs: { Hair }, every: { [string]: number }): { Hair }\n\tlocal out: { Hair } = {}\n\tlocal seen: { [string]: number } = {}\n\tfor _, h in hairs do\n\t\tlocal each = every[h.kind] or 1\n\t\tif each <= 0 then continue end\n\t\tlocal key = h.kind .. h.side\n\t\tlocal n = (seen[key] or 0) + 1\n\t\tseen[key] = n\n\t\tif n % each == 0 then table.insert(out, h) end\n\tend\n\treturn out\nend\n\n-- Hairs on one leg: segment 1 femur, 2 tibia, 3 tarsus; t along it (0 base .. 1 tip); theta around it.\n-- White over the leg's pale band (the middle bandFraction of each segment, as SpiderRig draws it), black everywhere else.\n-- ROBLOX-93: legs 5 to 8 (the right) are the mirror images of legs 1 to 4: the same hairs, every angle round the leg turned the other way (the rod frames of the two sides face\n-- opposite ways, so a hair at the same angle would stand on the other side of the leg), and so a tier that keeps the same indices on both keeps the same hairs. `hipBare` (a share of\n-- the femur from the hip, for each pair): the femurs of the first two pairs start at the face, where the anterior lateral eyes are, and hairs there would stand in the eyes.\nfunction Setae.leg(look: any, legIndex: number): { LegHair }\n\tlocal out: { LegHair } = {}\n\tlocal f = look.fuzz\n\tif not f or not f.enabled then return out end\n\tlocal twin = (legIndex - 1) % 4 + 1 -- the pair, and the left leg of it\n\tlocal mirror = if legIndex > 4 then -1 else 1\n\tlocal front = twin == 1 -- the first legs carry a denser, longer fringe, as in Phidippus\n\tlocal byPair = if f.legPairs then f.legPairs[twin] else nil -- (legPairs: a count per segment for each pair of legs, the front pair's the most)\n\tlocal bare = if f.hipBare then f.hipBare[twin] else 0\n\tfor segment = 1, 3 do\n\t\tlocal n = if byPair then byPair[segment] elseif front and segment < 3 then math.floor(f.legHairs[segment] * 1.6) else f.legHairs[segment]\n\t\tfor k = 1, n do\n\t\t\tlocal i = twin * 100 + segment * 10 + k\n\t\t\tlocal t = (k - 0.5) / n\n\t\t\tif f.legSpan then t = f.legSpan[1] + (f.legSpan[2] - f.legSpan[1]) * t end -- (legSpan: only this stretch of the link carries hairs, clear of the patella and the ankle)\n\t\t\tif segment == 1 then t = bare + (1 - bare) * t end -- (hipBare: the femur's hairs are spread over the rest of it)\n\t\t\t-- legEdge: the hairs grow from the sides of the leg, between these two angles (degrees from the top), one side and the other in turn: a fringe\n\t\t\tlocal theta = mirror * (if f.legEdge then (if (k + twin) % 2 == 0 then 1 else -1) * math.rad(between(f.legEdge, hash(i, 9))) else k * GOLDEN + twin)\n\t\t\tlocal white = math.abs(t - 0.5) < look.bandFraction * 0.6\n\t\t\tlocal tone = if f.legTone then f.legTone elseif white then \"white\" elseif hash(i, 13) < f.legBlack then \"black\" else \"dark\" -- (legTone: every bristle one tone)\n\t\t\tif f.legTip and tone ~= \"white\" and hash(i, 17) < f.legTip then tone = \"grey\" end\n\t\t\ttable.insert(out, {\n\t\t\t\tsegment = segment, t = t, theta = theta,\n\t\t\t\tlength = f.legLength * (0.7 + 0.6 * hash(i, 5)) * (if segment == 3 then 0.6 elseif front then 1.4 else 1),\n\t\t\t\ttone = tone, white = tone == \"white\", grey = tone == \"grey\", frost = tone == \"frost\",\n\t\t\t\tlift = if f.legLift then math.rad(between(f.legLift, hash(i, 7))) else nil, -- (legLift: the hair lies at this angle off the leg, toward the foot)\n\t\t\t})\n\t\tend\n\tend\n\treturn out\nend\n\n-- The fringe on a leg (ROBLOX-127; look.fuzz.legFringe): longer hairs standing out from the sides and underside of a link, leaning toward the foot, the fringes a\n-- bold jumping spider has on its first legs (and a male's heavier and, in the rival, dark). `pairs[pair]` gives the count on the femur, tibia and tarsus; the hairs\n-- are spread over the middle of the link (0.15 to 0.9 of it), one side and then the other between `edge`'s two angles (degrees from the top of the leg). Legs 5 to 8\n-- mirror 1 to 4 as Setae.leg's do. The same LegHair shape: SpiderRig draws them with the leg's own hairs, and a tier keeps one in `every.legFringe`.\nfunction Setae.legFringe(look: any, legIndex: number): { LegHair }\n\tlocal out: { LegHair } = {}\n\tlocal f = look.fuzz\n\tlocal spec = if f and f.enabled then f.legFringe else nil\n\tif spec == nil then return out end\n\tlocal twin = (legIndex - 1) % 4 + 1\n\tlocal mirror = if legIndex > 4 then -1 else 1\n\tlocal counts = spec.pairs[twin]\n\tif counts == nil then return out end\n\tlocal bare = if f.hipBare then f.hipBare[twin] else 0\n\tfor segment = 1, 3 do\n\t\tlocal n = counts[segment] or 0\n\t\tfor k = 1, n do\n\t\t\tlocal i = twin * 1000 + segment * 100 + k\n\t\t\tlocal t = 0.15 + 0.75 * (k - 0.5) / n\n\t\t\tif segment == 1 then t = bare + (1 - bare) * t end -- (as the leg's own hairs: none on the femur's bare stretch by the face, where the anterior lateral eyes are)\n\t\t\tlocal theta = mirror * (if k % 2 == 0 then 1 else -1) * math.rad(between(spec.edge, hash(i, 51)))\n\t\t\ttable.insert(out, {\n\t\t\t\tsegment = segment, t = t, theta = theta,\n\t\t\t\tlength = between(spec.length, hash(i, 53)) * (if segment == 1 then 0.8 else 1),\n\t\t\t\ttone = spec.tone, white = spec.tone == \"white\", grey = spec.tone == \"grey\", frost = spec.tone == \"frost\",\n\t\t\t\tlift = math.rad(between(spec.lift, hash(i, 57))), width = spec.width, transparency = spec.transparency,\n\t\t\t})\n\t\tend\n\tend\n\treturn out\nend\n\n-- A tarantula's urticating patch (ROBLOX-85): a denser cluster of short, ginger-rust hairs standing out of the patch on the abdomen's back, combed\n-- toward the rear, in the body frame. `look.cluster` = { mark (the name of the patch in look.marks), hairs, length, lift, yaw, width, flat, color, paler }.\nfunction Setae.cluster(look: any): { Hair }\n\tlocal out: { Hair } = {}\n\tlocal c = look.cluster\n\tif not c then return out end\n\tlocal mark\n\tfor _, m in look.marks do\n\t\tif m.name == c.mark then mark = m end\n\tend\n\tif not mark then return out end\n\tlocal ac, ar = Anatomy.v3(look.abdomenCenter), Anatomy.v3(look.abdomenRadii)\n\tfor k = 1, c.hairs do\n\t\tlocal ring = math.sqrt((k - 0.5) / c.hairs) * 0.82\n\t\tlocal ang = k * GOLDEN\n\t\tlocal dx, dz = mark.rx * ring * math.cos(ang), mark.rz * ring * math.sin(ang)\n\t\tlocal x, z = mark.x * ar.X + dx, mark.z * ar.Z + dz\n\t\tlocal surface = Vector3.new(ac.X + x, Anatomy.topY(ac, ar, x, z), ac.Z + z)\n\t\tlocal normal = Anatomy.normalAt(ac, ar, surface)\n\t\tlocal lift = math.rad(between(c.lift, hash(k, 61)))\n\t\tlocal yaw = math.rad(c.yaw) * (2 * hash(k, 63) - 1)\n\t\tlocal dir = comb(normal, lift, yaw)\n\t\tlocal length = between(c.length, hash(k, 65))\n\t\tlocal h = hair(surface - normal * 0.003, dir, normal, length, c.width, c.flat, c.transparency, \"cluster\", \"abdomen\", 0, if hash(k, 67) < c.paler then \"frost\" else \"grey\")\n\t\ttable.insert(out, h)\n\tend\n\treturn out\nend\n\nreturn Setae\n",23670,2812842253},{"Shared/Rig/SpiderChoice","--!strict\n-- Which spider the player is (ROBLOX-31, ROBLOX-64, ROBLOX-81): the first spider, the peacock spider, the ant-mimicking spider or one of the two\n-- tarantulas of the tarantula pack. Pure, so tests/peacock.luau checks it.\n-- The choice is remembered for the session in the Player attribute `Appearance`; the Workspace attribute `Appearance` can preselect\n-- it for Studio and playtests. Anything that is not a known appearance is the default (the first spider).\nlocal Appearances = require(script.Parent.Parent.Data.Appearances)\n\nlocal SpiderChoice = {}\n\n-- The spiders to choose between, in the order the crack's key cycles through them.\nSpiderChoice.ORDER = { \"first_spider\", \"maratus_volans_male\", \"myrmarachne_formicaria_female\", \"brachypelma_hamorii\", \"chromatopelma_cyaneopubescens\" } :: { string }\n\n-- Only a spider in ORDER can be the player: the brown rival's look (Data/Appearances.rival_spider) is drawn for the other spider and is never\n-- offered by the cycle or accepted from an attribute or a save.\nlocal function known(id: any): boolean\n\tif type(id) ~= \"string\" or Appearances.profiles[id] == nil then return false end\n\tfor _, name in SpiderChoice.ORDER do\n\t\tif name == id then return true end\n\tend\n\treturn false\nend\n\n-- The appearance to start with: the Player attribute if it names one, else the Workspace attribute, else the default.\nfunction SpiderChoice.start(playerAttribute: any, workspaceAttribute: any): string\n\tif known(playerAttribute) then return playerAttribute :: string end\n\tif known(workspaceAttribute) then return workspaceAttribute :: string end\n\treturn Appearances.default\nend\n\n-- Is this spider not the player's to be yet (ROBLOX-71)? Nothing is locked while the add-ons are free for testing (ROBLOX-66), so this is\n-- always false. It is the one place to wire ownership when Nathan says the sales start: ROBLOX-48's Game Pass pattern (the server checks\n-- ownership, a replicated Player attribute holds the answer, a Studio override) fills `owned` ({ [appearance id] = true }), and this\n-- returns true for a pass-only spider (the peacock, the ant mimic, and the pair in the tarantula pack, `packOf` below) that is not in it. The\n-- first spider is never locked. Both ways of choosing, the crack's key and the Settings row, skip a locked spider through next() and step()\n-- below. Nathan's default for the tarantula pack (ROBLOX-81) is both tarantulas in one pass of about US$0.99, so the pack, and not the\n-- spider, is the thing `owned` would say (an owned pack opens both); selling each on its own is his open call. Nothing is sold now.\nfunction SpiderChoice.locked(id: string, owned: { [string]: boolean }?): boolean\n\treturn false\nend\n\n-- The pack a spider belongs to (Appearances `pack`), or nil for the first spider, the peacock and the ant mimic, which are not in one.\nfunction SpiderChoice.packOf(id: string): string?\n\tlocal look = Appearances.profiles[id]\n\treturn if look ~= nil then (look :: any).pack else nil\nend\n\n-- The appearance `dir` (+1 or -1) places from this one in ORDER, wrapping and skipping any that is locked. When nothing else is open it is\n-- this one again. An id that is not in ORDER steps to the default (the first spider).\nfunction SpiderChoice.step(id: string, dir: number, owned: { [string]: boolean }?): string\n\tlocal n = #SpiderChoice.ORDER\n\tlocal at = table.find(SpiderChoice.ORDER, id)\n\tif at == nil then return Appearances.default end\n\tlocal way = if dir < 0 then -1 else 1\n\tfor k = 1, n - 1 do\n\t\tlocal name = SpiderChoice.ORDER[(at - 1 + way * k) % n + 1]\n\t\tif not SpiderChoice.locked(name, owned) then return name end\n\tend\n\treturn id\nend\n\n-- The appearance after this one (the crack's key).\nfunction SpiderChoice.next(id: string, owned: { [string]: boolean }?): string\n\treturn SpiderChoice.step(id, 1, owned)\nend\n\n-- What the spider is doing, as the client reads it off the motor, the jump, the growth and the struggle (all booleans but `mode`).\nexport type Standing = { mode: string, seized: boolean, preparing: boolean, jumping: boolean, onLine: boolean, moulting: boolean, struggling: boolean }\n\n-- May the Settings row change the spider now (ROBLOX-71)? Anywhere on the sill, but only while standing safely: attached to a surface and\n-- not held by the wasp, not winding up a jump or in the air, not on a silk line, not moulting and not holding a struggling fly. The crack\n-- keeps its own rule (resting awake) and does not ask this.\nfunction SpiderChoice.safeToChange(s: Standing): boolean\n\treturn s.mode == \"attached\" and not s.seized and not s.preparing and not s.jumping and not s.onLine and not s.moulting and not s.struggling\nend\n\n-- May the close look (Inspect mode, ROBLOX-90) begin or go on? Standing safely, as for a change of spider, and also hanging on a locked dragline: a line is a good place to be\n-- looked at. Not while winding up a jump or in flight (a jump's safety line is a line too), held by the wasp, moulting or holding a struggling fly.\nfunction SpiderChoice.safeToInspect(s: Standing): boolean\n\treturn (s.mode == \"attached\" or s.onLine) and not s.seized and not s.preparing and not s.jumping and not s.moulting and not s.struggling\nend\n\n-- Does this appearance have a fan to display (and so a courtship dance)?\nfunction SpiderChoice.canDance(id: string): boolean\n\tlocal look = Appearances.profiles[id]\n\treturn look ~= nil and (look :: any).fan ~= nil\nend\n\n-- Does this appearance have antennae to show (legs I raised when it stands still) and so an antennae pose on the display key?\nfunction SpiderChoice.hasAntennae(id: string): boolean\n\tlocal look = Appearances.profiles[id]\n\treturn look ~= nil and (look :: any).antennae ~= nil\nend\n\n-- Does this appearance have a threat display and silk mat (the tarantulas', ROBLOX-82) on the display key?\nfunction SpiderChoice.hasThreat(id: string): boolean\n\tlocal look = Appearances.profiles[id]\n\treturn look ~= nil and (look :: any).threat ~= nil\nend\n\n-- What the display key (X / RB / the touch button) does for this appearance: \"dance\" (the peacock's courtship dance), \"antennae\" (the\n-- ant mimic's antennae pose), \"threat\" (the tarantulas' rear-up and silk mat) or nil (the first spider has none).\nfunction SpiderChoice.displayKind(id: string): string?\n\tif SpiderChoice.canDance(id) then return \"dance\" end\n\tif SpiderChoice.hasAntennae(id) then return \"antennae\" end\n\tif SpiderChoice.hasThreat(id) then return \"threat\" end\n\treturn nil\nend\n\nreturn SpiderChoice\n",6421,1918150489},{"Shared/Rig/SpiderRig","--!strict\n-- The drawn spider for Roblox: a port of scripts/presentation/spider_body.gd and surface_legs.gd (VISUAL-01 look), made cuter in\n-- ROBLOX-13. Every part is anchored, non-colliding and non-queryable, and is placed each frame with one Workspace:BulkMoveTo call.\n-- Display only: the controller owns the body's CFrame; nothing here feeds back into movement.\n-- Body frame: +Y support-up, -Z forward, about 1 stud long (1 Godot WU = 1 cm = 1 stud). Every look number is in\n-- Data/Appearances; where things sit comes from Rig/Anatomy, the hairs from Rig/Setae, the idle motion from Rig/Idle.\n-- The peacock spider (ROBLOX-30) is a second appearance drawn by the same code: a small body (look.scale) standing low (look.bodyDrop),\n-- legs III in their own colours, and a fan of flat discs that the courtship dance (Rig/PeacockDance, set as rig.dance) opens.\n-- The ant-mimicking spider (ROBLOX-64) is a third: extra body segments (look.extras), glossy cuticle (look.gloss), and a pose (Rig/AntMimicPose,\n-- set as rig.ant) that raises legs I as antennae when it stands and turns the drawn body a little as it walks.\n-- The two tarantulas (ROBLOX-81) are two more: a broad low carapace with a rim (look.extras), an ocular tubercle with eight tiny eyes\n-- (Anatomy's tubercle), markings on the abdomen (look.marks), legs coloured segment by segment (look.legColors, look.legBands) and, for the\n-- Greenbottle blue, leg bristles only (fuzz.legsOnly) and bars that soften at the last growth stage (look.barFade). A pose (Rig/TarantulaPose, set as\n-- rig.threat, ROBLOX-82) rears the prosoma, lifts legs I and the pedipalps, turns the drawn body about and swings the spinnerets.\n-- ROBLOX-84 draws the legs, feet, fangs and palps of the first spider and the two tarantulas as the segments they have (look.legForm,\n-- look.fang, look.palpForm): the same three-link chain and the same targets, each link now one or two rods, a patella at the knee, a break in\n-- the tarsus, a pad (and claws) at the foot. An appearance without those tables is drawn exactly as it was.\n\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Appearances = require(script.Parent.Parent.Data.Appearances)\nlocal Anatomy = require(script.Parent.Anatomy)\nlocal Setae = require(script.Parent.Setae)\nlocal Idle = require(script.Parent.Idle)\nlocal Living = require(script.Parent.Living)\nlocal Growth = require(script.Parent.Parent.Life.Growth)\nlocal v3 = Anatomy.v3\n\nlocal SpiderRig = {}\nSpiderRig.__index = SpiderRig\n\nexport type GaitMode = \"Tetrapod\" | \"Unilateral\"\n\nlocal STEP_ERROR = 0.24\nlocal SWING_SECONDS = 0.10\nlocal STEP_HEIGHT = 0.12\nlocal made = 0 -- rigs made so far: each one's living motion draws from its own seeded stream\nlocal ANKLE_SHARE = 0.62\n-- The groups a fixed part follows: the body, the head (tilts about the neck) or the abdomen (breathes).\nlocal G_BODY, G_HEAD, G_ABDOMEN = 0, 1, 2\n-- Drawing only what moved (ROBLOX-93). The hairs follow one frame each (the head's, the abdomen's, a palp's, a leg link's) and are sent to the engine in a second\n-- batch, after the body's: a kind of hair is placed again only when its frame has moved by more than MOVE_STUDS (a place, studs) or MOVE_RADIANS (a turn) since it\n-- was last placed, or when the abdomen's scale (its condition, its breath) has moved by more than SCALE_STEP. The tolerance is measured from where the hairs were last\n-- placed, not from the last frame, so a slow drift cannot hide: it is placed again once it has added up. (The body's batch is every frame as it was.)\nlocal MOVE_STUDS, MOVE_RADIANS, SCALE_STEP = 1e-4, 1e-3, 1e-4\n-- A leg's pale band is given a new length only when it is more than BAND_STEP off (the rods' own tolerance), so a leg that stands still writes none.\nlocal BAND_STEP = 1e-3\nlocal MOVE_TURN = MOVE_RADIANS * MOVE_RADIANS -- (3 minus the trace of the relative rotation is about the turn's square)\n-- A rival or a mate farther than FAR_STUDS from the camera is drawn once every FAR_SECONDS (SpiderRig.drawStep).\nlocal FAR_STUDS, FAR_SECONDS = 25, 0.1\n-- The lengths of a reach to a foothold, tried in turn (a narrow edge takes the shorter ones).\nlocal REACHES = { 1.0, 0.65, 0.35, 0.12 }\nlocal LEG_NAMES = { \"femur\", \"tibia\", \"tarsus\" }\n\n-- One leg hair: its part and where it grows (spec), with what the drawing needs of it worked out once (ROBLOX-93): the angle round the leg as a cosine and a sine,\n-- how far out of the leg it grows (k: 0.8 of the radius, or 1 for a coat that lies along the leg) and its direction in the link's frame.\ntype LegHair = { part: Part, spec: Setae.LegHair, c: number, s: number, k: number, dir: Vector3 }\n-- One link of a leg (femur, tibia, tarsus): its rod, the thinner tip rod and the pale band it may have, the length each is drawn at and the diameters of the rods (what\n-- the part's Size holds; kept here so a frame reads no property), the hairs on it, and where they were last placed (its frame and length).\ntype Seg = {\n\trod: Part, tip: Part?, band: Part?, hairs: { LegHair },\n\tx: number, tipX: number, bandX: number, dy: number, dz: number, tipDy: number, tipDz: number,\n\trc: CFrame, len: number,\n}\n\ntype Leg = {\n\tside: number,\n\tpair: number,\n\tplanted: Vector3?,\n\tswing: number, -- < 0 planted, 0..1 swinging\n\tfrom: Vector3,\n\tto: Vector3,\n\tup: Vector3,\n\tfoot: Vector3,\n\tfemur: Part,\n\ttibia: Part,\n\ttarsus: Part,\n\tknee: Part,\n\tankle: Part,\n\tpad: Part?,\n\tfemurTip: Part?, -- the thinner distal rod of a tapered femur or tibia, the thinner distal rod of the tarsus and the ball on its break (look.legForm;\n\ttibiaTip: Part?, -- all nil for an appearance without one), and the foot's claws\n\ttarsusTip: Part?,\n\tjoint: Part?,\n\ttoes: {Part},\n\tbands: {Part}, -- empty for a pair drawn without pale bands (the peacock spider's legs III)\n\thangKnee: Vector3?, -- where the hanging pose puts the knee and the ankle this frame (world space), or nil off the line (ROBLOX-86)\n\thangAnkle: Vector3?,\n\thairs: { LegHair },\n\tsegs: { Seg }, -- the femur, the tibia, the tarsus\n\trest: Vector3, hip: Vector3, -- where the foot rests and where the hip is, in the body frame at the rig's scale (worked out when the scale changes, not every frame)\n\tnoise: { number }?, -- the hanging pose's fixed scatter for this leg (six numbers), made the first time it hangs\n}\n\n-- (glance: a principal eye or its catchlight, which shifts toward what is watched; big: an abdomen mass that is resized as it breathes.) `pos` and `rot` are the offset's\n-- two halves, `scaled` the offset at the rig's scale, `size0` the part's size at scale 1 and `size` the size it has now (ROBLOX-93: kept here, so a frame reads no property).\ntype Fixed = {\n\tpart: Part, offset: CFrame, group: number, palp: number?, sweep: number?, glance: boolean?, big: boolean?,\n\tpos: Vector3, rot: CFrame, scaled: CFrame, size0: Vector3, size: Vector3,\n\tjaw: number?, pivot: Vector3?, -- (ROBLOX-127) a chelicera or a fang: its side, and the point at the chelicera's base it swings out about in the rival's display\n}\n\n-- The parts of one BulkMoveTo and where each goes: a rig makes two a frame, the body's and the hairs' (the hairs' only when they moved).\ntype Batch = { parts: { BasePart }, frames: { CFrame }, n: number }\n\n-- Where each group of hairs, and each size that follows the abdomen's condition, was last placed (see MOVE_STUDS): the frame it followed, the abdomen's breath then,\n-- the condition its sizes were made for and the scale epoch they were made at.\ntype Seen = {\n\tbody: CFrame, head: CFrame, abdomen: CFrame, palpHead: { CFrame }, pivot: { CFrame },\n\tbreath: number, sizeKey: Vector3, epoch: number,\n}\n\n-- The peacock spider's fan: flat ellipsoid discs on the abdomen's back face, stacked fringe first, their size set each frame by how far the fan is open.\n-- (`sizes`: what each part's Size holds, kept here so that a frame reads none and writes only what changed.)\ntype FanDisc = { part: Part, inset: number, y: number }\ntype FanFigure = { part: Part, x: number, z: number, rx: number, rz: number, angle: number, turn: CFrame } -- (turn: the angle as a CFrame, made once: ROBLOX-113)\ntype Fan = { front: { FanDisc }, back: { FanDisc }, figure: { FanFigure }, flaps: { { part: Part, side: number } }, cfg: any, parts: { Part }, sizes: { [BasePart]: Vector3 } }\n\nexport type Rig = typeof(setmetatable(\n\t{} :: {\n\t\tmodel: Model,\n\t\troot: Part,\n\t\tgaitMode: GaitMode,\n\t\treducedMotion: boolean,\n\t\t_fixed: { Fixed },\n\t\t_legs: { Leg },\n\t\t_group: number,\n\t\t_t: number,\n\t\t_drum: number,\n\t\t_calm: number,\n\t\t_spots: { Part },\n\t\t_appearance: any,\n\t\t_layout: Anatomy.Layout,\n\t\t_cfg: any,\n\t\t_detail: string,\n\t\t_palpBase: { Vector3 },\n\t\t_setae: { Part },\n\t\t_eyeView: boolean,\n\t\t_bodyHidden: boolean,\n\t\t_highlight: Highlight?,\n\t\t_params: RaycastParams,\n\t\t_bodyBatch: Batch, -- the body's parts and where they go this frame\n\t\t_hairBatch: Batch, -- the hairs that moved this frame (none when nothing did)\n\t\t_bodyFixed: { Fixed }, -- _fixed without the hairs; the hairs by the frame they follow (the head, the body, each palp, the abdomen)\n\t\t_headHairs: { Fixed },\n\t\t_bodyHairs: { Fixed },\n\t\t_palpHairs: { { Fixed } },\n\t\t_abdomenHairs: { Fixed },\n\t\t_seen: Seen,\n\t\t_pose: Idle.Pose, -- the idle pose, made again in place each frame\n\t\t_epoch: number, -- counts the scale changes: what was placed for an earlier scale is placed again\n\t\t_exact: boolean, -- tests: place every hair again every frame, with no tolerance (what the drawing is compared with)\n\t\t_stage: number, -- the growth stage last applied (-1 before the first)\n\t\t_owed: number, _drawn: boolean, -- drawStep: the time not yet drawn, and whether the rig has been drawn at all\n\t\tplaced: number?, -- the parts the last drawing placed (ROBLOX-113, for the self-test's profile)\n\t\t_k: number,\n  _growth: number,\n  _softness: number,\n  _condition: number,\n  _shownCondition: number,\n  hangDirection: Vector3?,\n  _hang: number,\n  focusPoint: Vector3?, -- the point the player watches (world space), or nil: the drawn body turns toward it a little and the eyes glance at it (ROBLOX-87)\n  _living: Living.State?, -- the living motion (attention, grooming, alarm, a tarantula's stretch), or nil below the full tier\n  _breath: number, -- how much the abdomen breathes now, 0..1\n  _mealsSeen: number?,\n  _lineDir: Vector3, -- the last direction up the line (it stays while the pose blends out)\n  _hangT: number, -- seconds since the drop: the sway's clock\n  _spin: number, _spinVel: number, -- the slow turn about the line (radians, radians a second)\n  _hangCount: number, -- drops so far (the turn alternates its direction)\n  _lastPos: Vector3?, _lineSpeed: number, _climbing: boolean, _climb: number, -- the climb: speed along the line, whether it counts, the head-up blend 0..1\n  _spinneret: Vector3?,\n  _mouth: CFrame?,\n  mealPulse: number?,\n  mealHeld: boolean?,\n  jumpLoad: number,\n  jumpPush: number,\n  _shownLoad: number,\n  _sizes: {[BasePart]: Vector3},\n  _colors: {[BasePart]: Color3},\n  _bars: { Part }, -- the Greenbottle blue's diagonal bars, which soften at the last growth stage\n\t\t_drop: number,\n\t\t_fan: Fan?,\n\t\tdance: any, -- a PeacockDance.Pose, or nil: the peacock spider's display (ignored by an appearance without a fan)\n\t\tant: any, -- an AntMimicPose.Pose, or nil: the ant-mimicking spider's antennae and walk (ignored by an appearance without look.antennae)\n\t\tthreat: any, -- a TarantulaPose.Pose, or nil: a tarantula's threat display and silk mat (ignored by an appearance without look.threat)\n\t},\n\tSpiderRig\n))\n\nlocal function newPart(model: Model, name: string, color: Color3, material: Enum.Material): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Name = name\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = true\n\tp.Color = color\n\tp.Material = material\n\tp.TopSurface = Enum.SurfaceType.Smooth\n\tp.BottomSurface = Enum.SurfaceType.Smooth\n\tp.Size = Vector3.new(0.1, 0.1, 0.1)\n\tp.Parent = model\n\treturn p\nend\n\nlocal function ellipsoid(model: Model, name: string, radii: Vector3, color: Color3, material: Enum.Material): Part\n\tlocal p = newPart(model, name, color, material)\n\tp.Size = radii * 2\n\tlocal mesh = Instance.new(\"SpecialMesh\")\n\tmesh.MeshType = Enum.MeshType.Sphere\n\tmesh.Parent = p\n\treturn p\nend\n\nlocal function rod(model: Model, name: string, d: number, color: Color3): Part\n\tlocal p = newPart(model, name, color, Enum.Material.SmoothPlastic)\n\tp.Shape = Enum.PartType.Cylinder\n\tp.Size = Vector3.new(1, d, d)\n\treturn p\nend\n\nlocal function disc(model: Model, name: string, color: Color3, reflectance: number): Part\n\tlocal p = ellipsoid(model, name, Vector3.new(0.05, 0.002, 0.05), color, Enum.Material.SmoothPlastic)\n\tp.CastShadow = false\n\tp.Reflectance = reflectance\n\treturn p\nend\n\nlocal function ball(model: Model, name: string, d: number, color: Color3): Part\n\tlocal p = newPart(model, name, color, Enum.Material.SmoothPlastic)\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.new(d, d, d)\n\tp.CastShadow = false\n\treturn p\nend\n\n-- A cylinder's axis is its local X: aim it from a to b. (ROBLOX-113: the quarter turn is made once, not with every rod of every frame; the frames are the same to the bit.)\nlocal QUARTER = CFrame.Angles(0, math.pi / 2, 0)\nlocal function rodCFrame(a: Vector3, b: Vector3): CFrame\n\treturn CFrame.lookAt((a + b) * 0.5, b) * QUARTER\nend\n\n-- A hair's \"up\" for lookAt: its surface normal, unless that is (nearly) along the hair.\nlocal function upFor(dir: Vector3, normal: Vector3): Vector3\n\tif math.abs(dir:Dot(normal)) < 0.97 then return normal end\n\treturn if math.abs(dir.Y) < 0.9 then Vector3.yAxis else Vector3.zAxis\nend\n\nlocal GROUP_OF: { [string]: number } = { head = G_HEAD, abdomen = G_ABDOMEN }\n\n-- ---------------------------------------------------------------- what a frame is made of: module functions, so that nothing is made again every frame (ROBLOX-93)\n\n-- Adds a part and its place to a batch.\nlocal function put(batch: Batch, p: BasePart, cf: CFrame)\n\tlocal n = batch.n + 1\n\tbatch.n = n\n\tbatch.parts[n] = p\n\tbatch.frames[n] = cf\nend\n\nlocal function emptyBatch(): Batch\n\treturn { parts = {}, frames = {}, n = 0 }\nend\n\nlocal function clearBatch(batch: Batch)\n\ttable.clear(batch.parts)\n\ttable.clear(batch.frames)\n\tbatch.n = 0\nend\n\n-- An offset at the rig's scale: its place is scaled about the body's origin, its turn is not.\n-- (ROBLOX-113: a rotation moved to a place is `rotation + place`, one CFrame where CFrame.new(place) * rotation made two; the same frame to the bit, since the\n-- product with the identity adds only zeros. A frame of the full rig made about 1,700 CFrames for 690 parts; this and the like below are most of the difference.)\nlocal function scaled(cf: CFrame, g: number): CFrame\n\treturn if g == 1 then cf else cf.Rotation + cf.Position * g\nend\n\n-- Has `now` moved from `was` by more than MOVE_STUDS in place or MOVE_RADIANS in turn? The turn comes from the trace of the relative rotation, the sum of the dot\n-- products of the two frames' three axes (no angle is worked out): it is 3 for no turn and 3 - 2 (1 - cos a) for a turn of a.\nlocal function moved(was: CFrame, now: CFrame): boolean\n\tif (now.Position - was.Position).Magnitude > MOVE_STUDS then return true end\n\tlocal trace = now.RightVector:Dot(was.RightVector) + now.UpVector:Dot(was.UpVector) + now.LookVector:Dot(was.LookVector)\n\treturn 3 - trace > MOVE_TURN\nend\n\n-- Gives an abdomen part the size it should have, if it differs from what it has (a part's size is kept in `f.size`; the property is written, never read).\nlocal function resize(f: Fixed, size: Vector3)\n\tif (f.size - size).Magnitude > 1e-5 then\n\t\tf.size = size\n\t\tf.part.Size = size\n\tend\nend\n\n-- A link of a leg that has not been drawn yet: refreshScale fills in its sizes, and bandX and len at -1 mean \"write the band's size, place the hairs\" at the first drawing.\nlocal function newSeg(rod: Part, tip: Part?, band: Part?): Seg\n\treturn {\n\t\trod = rod, tip = tip, band = band, hairs = {},\n\t\tx = 0, tipX = 0, bandX = -1, dy = 0, dz = 0, tipDy = 0, tipDz = 0,\n\t\trc = CFrame.identity, len = -1,\n\t}\nend\n\n-- Works out what the rig's scale fixes (ROBLOX-93), when the rig is made and whenever the scale changes: each fixed part's offset and size at that scale (the size\n-- setScale has just given every part), each leg's hip and rest in the body frame, the lengths and diameters its links hold, and the fan's sizes. A frame only reads these.\nlocal function refreshScale(self: Rig)\n\tlocal g, sizes = self._growth, self._sizes\n\tfor _, f in self._fixed do\n\t\tf.scaled = scaled(f.offset, g)\n\t\tf.size0 = sizes[f.part]\n\t\tf.size = f.size0 * g\n\tend\n\tlocal L = self._appearance.limbs\n\tlocal stance, longer = L.stance, L.pairReach\n\tfor _, leg in self._legs do\n\t\tlocal r = stance.reach * (if longer then longer[leg.pair] else 1) -- (the peacock spider's legs III are the longest)\n\t\tleg.rest = Vector3.new(leg.side * stance.x * r, stance.y, L.tipZ[leg.pair] * r) * g\n\t\tleg.hip = Vector3.new(leg.side * L.hipX, L.hipY, L.hipZ[leg.pair]) * g\n\t\tfor _, seg in leg.segs do\n\t\t\tlocal size = sizes[seg.rod]\n\t\t\tseg.x, seg.dy, seg.dz = size.X * g, size.Y * g, size.Z * g\n\t\t\tlocal tip = seg.tip\n\t\t\tif tip then\n\t\t\t\tlocal tipSize = sizes[tip]\n\t\t\t\tseg.tipX, seg.tipDy, seg.tipDz = tipSize.X * g, tipSize.Y * g, tipSize.Z * g\n\t\t\tend\n\t\t\tseg.bandX, seg.len = -1, -1 -- the band is given its size, and the hairs their places, at the next drawing\n\t\tend\n\tend\n\tlocal fan = self._fan\n\tif fan then\n\t\tfor _, part in fan.parts do fan.sizes[part] = sizes[part] * g end\n\tend\nend\n\n-- detail \"low\" is for phones and tablets: fewer hairs, one fur shell, no foot balls, half the speckles, no outline, no\n-- breathing or head tilt (Appearances.detail). Anything else is the full look. `living` (ROBLOX-89: the mate, which has to breathe and take the mating scene's cues\n-- at the low tier) turns the living motion on at a tier that has none, for the same parts.\nfunction SpiderRig.new(parent: Instance, worldFolder: Instance, appearanceId: string?, detail: string?, living: boolean?): Rig\n\tlocal look = Appearances.profiles[appearanceId or Appearances.default]\n\tassert(look, \"Unknown spider appearance\")\n\tlocal detailName = if detail == \"low\" then \"low\" else \"full\"\n\tlocal cfg = look.detail[detailName]\n\tif living == true and not cfg.idle then\n\t\tcfg = table.clone(cfg)\n\t\tcfg.idle = true\n\tend\n\tlocal A = Anatomy.layout(look)\n\tlocal function color(rgb): Color3 return Color3.new(rgb[1], rgb[2], rgb[3]) end\n\tlocal BODY, LEG = color(look.body), color(look.legs)\n\tlocal JOINT, EYE, FANG = color(look.joint or look.white), color(look.eyes), color(look.fangs)\n\tlocal ABDOMEN = if look.abdomenColor then color(look.abdomenColor) else BODY\n\tlocal WHITE = color(look.white)\n\tlocal model = Instance.new(\"Model\")\n\tmodel.Name = \"Spider\"\n\tmodel:SetAttribute(\"AppearanceId\", look.id)\n\tmodel:SetAttribute(\"Detail\", detailName)\n\tlocal root = newPart(model, \"Root\", BODY, Enum.Material.SmoothPlastic)\n\troot.Size = Vector3.new(1, 0.5, 1)\n\troot.Transparency = 1\n\troot.CastShadow = false\n\tmodel.PrimaryPart = root\n\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Include\n\tparams.FilterDescendantsInstances = { worldFolder }\n\n\tlocal self = setmetatable({\n\t\tmodel = model,\n\t\troot = root,\n\t\tgaitMode = \"Tetrapod\" :: GaitMode,\n\t\treducedMotion = false,\n\t\t_fixed = {} :: { Fixed },\n\t\t_legs = {} :: { Leg },\n\t\t_group = 0,\n\t\t_t = 0,\n\t\t_drum = 0,\n\t\t_calm = 0,\n\t\t_spots = {} :: { Part },\n\t\t_appearance = look,\n\t\t_layout = A,\n\t\t_cfg = cfg,\n\t\t_detail = detailName,\n\t\t_palpBase = { A.palps[1].base, A.palps[2].base },\n\t\t_setae = {} :: { Part },\n\t\t_eyeView = false,\n\t\t_bodyHidden = false,\n\t\t_highlight = nil :: Highlight?,\n\t\t_params = params,\n\t\t_bodyBatch = emptyBatch(),\n\t\t_hairBatch = emptyBatch(),\n\t\t_bodyFixed = {} :: { Fixed },\n\t\t_headHairs = {} :: { Fixed },\n\t\t_bodyHairs = {} :: { Fixed },\n\t\t_palpHairs = { {}, {} } :: { { Fixed } },\n\t\t_abdomenHairs = {} :: { Fixed },\n\t\t_seen = {\n\t\t\tbody = CFrame.identity, head = CFrame.identity, abdomen = CFrame.identity, palpHead = { CFrame.identity, CFrame.identity }, pivot = { CFrame.identity, CFrame.identity },\n\t\t\tbreath = 0, sizeKey = Vector3.zero, epoch = 0,\n\t\t} :: Seen,\n\t\t_pose = { bodyLift = 0, abdomenLift = 0, abdomenPitch = 0, headRoll = 0, headYaw = 0, headPitch = 0 } :: Idle.Pose,\n\t\t_epoch = 1,\n\t\t_exact = false,\n\t\t_stage = -1,\n\t\t_owed = 0,\n\t\t_drawn = false,\n\t\t_k = look.scale or 1,\n  _growth = 1, _softness = 0, _condition = 0.55, _shownCondition = 0.55, jumpLoad = 0, jumpPush = 0, _shownLoad = 0,\n  hangDirection=nil :: Vector3?, _hang=0, _spinneret=nil :: Vector3?,\n  focusPoint = nil :: Vector3?, _living = nil :: Living.State?, _breath = 0, _mealsSeen = nil :: number?,\n  _lineDir = Vector3.yAxis, _hangT = 0, _spin = 0, _spinVel = 0, _hangCount = 0, _lastPos = nil :: Vector3?, _lineSpeed = 0, _climbing = false, _climb = 0,\n  _sizes = {} :: {[BasePart]: Vector3}, _colors = {} :: {[BasePart]: Color3}, _bars = {} :: { Part },\n\t\t_drop = look.bodyDrop or 0,\n\t\t_fan = nil :: Fan?,\n\t\tdance = nil :: any,\n\t\tant = nil :: any,\n\t\tthreat = nil :: any,\n\t}, SpiderRig)\n\n\tmade += 1\n\tlocal idleLook = look.idle\n\tif cfg.idle and (idleLook.groom or idleLook.attention or idleLook.alarm or idleLook.stretch or idleLook.meet or idleLook.settle) then\n\t\tself._living = Living.new(idleLook, Living.hash(look.id) + 7919 * made)\n\tend\n\tlocal function fixed(part: Part, at: Vector3, rot: CFrame?, group: number, palp: number?): Fixed\n\t\tlocal offset = CFrame.new(at) * (rot or CFrame.identity)\n\t\tlocal entry: Fixed = {\n\t\t\tpart = part, offset = offset, group = group, palp = palp, sweep = nil, glance = nil, big = nil,\n\t\t\tpos = offset.Position, rot = offset.Rotation, scaled = offset, size0 = Vector3.zero, size = Vector3.zero, jaw = nil, pivot = nil,\n\t\t}\n\t\ttable.insert(self._fixed, entry)\n\t\treturn entry\n\tend\n\tlocal fabric = Enum.Material.SmoothPlastic -- clean high-contrast silhouette\n\tfixed(ellipsoid(model, \"Cephalothorax\", A.headRadii, BODY, fabric), A.headCenter, nil, G_HEAD)\n\tfixed(ellipsoid(model, \"EyeFace\", A.faceRadii, BODY, fabric), A.faceCenter, nil, G_HEAD)\n\tfixed(ellipsoid(model, \"Pedicel\", A.pedicelRadii, BODY, fabric), A.pedicelCenter, nil, G_BODY)\n\tfixed(ellipsoid(model, \"Abdomen\", A.abdomenRadii, ABDOMEN, fabric), A.abdomenCenter, nil, G_ABDOMEN).big = true\n\t-- More segments (the ant-mimicking spider's thorax and the node on its waist), and a glossy cuticle where the look asks for one.\n\t-- (`fullOnly` extras are left out at low detail; `sweep` marks a spinneret segment that the silk-mat pose swings.)\n\tfor _, ex in look.extras or {} do\n\t\tif ex.fullOnly and detailName == \"low\" then continue end\n\t\tlocal seg = ellipsoid(model, ex.name, v3(ex.radii), if ex.color then color(ex.color) else BODY, fabric)\n\t\tfixed(seg, v3(ex.center), nil, GROUP_OF[ex.group] or G_BODY).sweep = ex.sweep\n\tend\n\t-- A tarantula's ocular tubercle, the mound that carries its eyes (the eyes themselves are below).\n\tlocal tubercle = A.tubercle\n\tif tubercle then\n\t\tlocal mound = ellipsoid(model, \"OcularTubercle\", tubercle.radii, color(look.tubercle.color), fabric)\n\t\tmound.Reflectance = look.tubercle.reflectance\n\t\tfixed(mound, tubercle.center, nil, G_HEAD)\n\tend\n\t-- A tarantula's velvet (look.velvet, ROBLOX-85): a fur shell per body mass, a little larger than the carapace and the abdomen it covers, partly\n\t-- transparent, in Fabric and in the fur's colour. The head's stops short of the tubercle's eyes by being no taller than the carapace's dome.\n\tlocal velvet = look.velvet\n\tif velvet and cfg.velvet then\n\t\tlocal cover = ellipsoid(model, \"FuzzShell\", A.headRadii * velvet.head.scale, color(velvet.head.color), Enum.Material.Fabric)\n\t\tcover.Transparency, cover.CastShadow = velvet.head.transparency, false\n\t\tfixed(cover, A.headCenter, nil, G_HEAD)\n\t\tlocal coat = ellipsoid(model, \"FuzzShell\", A.abdomenRadii * velvet.abdomen.scale, color(velvet.abdomen.color), Enum.Material.Fabric)\n\t\tcoat.Transparency, coat.CastShadow = velvet.abdomen.transparency, false\n\t\tfixed(coat, A.abdomenCenter, nil, G_ABDOMEN).big = true\n\tend\n\tif look.gloss then\n\t\tfor _, f in self._fixed do\n\t\t\tlocal name = f.part.Name\n\t\t\tif name == \"Cephalothorax\" or name == \"EyeFace\" or name == \"Pedicel\" or name == \"Abdomen\" or name == \"Thorax\" or name == \"PetioleNode\" or name == \"CarapaceRim\" then\n\t\t\t\tf.part.Reflectance = look.gloss\n\t\t\tend\n\t\tend\n\tend\n\n\t-- The daughter's pattern: markings are fractions of the abdomen's radii.\n\tlocal ar, ac = A.abdomenRadii, A.abdomenCenter\n\tlocal function marking(name: string, x: number, z: number, rx: number, rz: number, angle: number)\n\t\tlocal y = ar.Y * math.sqrt(math.max(0, 1 - x*x - z*z))\n\t\tlocal spot = ellipsoid(model, name, Vector3.new(rx, 0.012, rz), WHITE, fabric)\n\t\tspot.CastShadow = false\n\t\tfixed(spot, Vector3.new(x * ar.X, ac.Y + 0.007 + y, ac.Z + z * ar.Z), CFrame.Angles(0, angle, 0), G_ABDOMEN)\n\t\ttable.insert(self._spots, spot)\n\tend\n\t-- A curved pale band across the front of the abdomen.\n\tlocal band = look.band\n\tfor i = 0, band.count - 1 do\n\t\tmarking(\"FrontBand\", (i - (band.count - 1) / 2) * band.step, band.z, band.rx, band.rz, 0)\n\tend\n\tfor _, spot in look.spots do\n\t\tmarking(\"AbdomenSpot\", spot.x, spot.z, spot.rx, spot.rz, spot.angle)\n\tend\n\t-- Fixed deterministic stippling: no per-frame RNG or extra updates.\n\tlocal sp = look.speckle\n\tfor i = 1, look.speckleCount do\n\t\tif i % cfg.speckleEvery ~= 0 then continue end\n\t\tlocal angle = i * 2.399963229728653\n\t\tlocal radius = sp.from + (i % 5) * sp.step\n\t\tmarking(\"Speckle\", math.cos(angle) * radius, math.sin(angle) * radius, sp.rx, sp.rz, angle)\n\tend\n\n\t-- A tarantula's markings on the abdomen (look.marks): flat dabs in their own colours lying on the back, each tilted to the slope under it.\n\t-- x and z are fractions of the abdomen's radii, rx and rz the dab's half sizes in studs. `mirror` also draws the other side, `fullOnly`\n\t-- leaves it out at low detail, `bar` lists it among the bars that soften with growth (look.barFade).\n\tfor _, m in look.marks or {} do\n\t\tif m.fullOnly and detailName == \"low\" then continue end\n\t\tlocal sides: { number } = if m.mirror then { 1, -1 } else { 1 }\n\t\tfor _, side in sides do\n\t\t\tlocal x, z = side * m.x, m.z\n\t\t\tlocal q = math.sqrt(math.max(1 - x * x - z * z, 0.05))\n\t\t\tlocal pitch = math.atan(ar.Y * z / (ar.Z * q))\n\t\t\tlocal roll = math.atan(-ar.Y * x / (ar.X * q))\n\t\t\t-- (`height`: a ridge, a thin rod-shaped ellipsoid that stands that many studs half-height out of the surface, centred `raise` above it,\n\t\t\t-- instead of a flat dab, ROBLOX-85; its pointed ends dive into the fur shell, so it follows the dome where a straight cylinder would float)\n\t\t\tlocal dab = ellipsoid(model, m.name, Vector3.new(m.rx, m.height or 0.010, m.rz), color(m.color), fabric)\n\t\t\tdab.CastShadow = false\n\t\t\tfixed(dab, Vector3.new(x * ar.X, ac.Y + ar.Y * q + (m.raise or 0.002), ac.Z + z * ar.Z), CFrame.Angles(pitch, 0, roll) * CFrame.Angles(0, side * m.angle, 0), G_ABDOMEN)\n\t\t\tif m.bar then table.insert(self._bars, dab) end\n\t\tend\n\tend\n\n\t-- Head: pale cheeks, big glossy eyes with their catchlights, jaws.\n\tfor _, c in A.cheeks do\n\t\tlocal cheek = ellipsoid(model, \"PaleCheek\", c.radii, WHITE, fabric)\n\t\tcheek.CastShadow = false\n\t\tfixed(cheek, c.at, nil, G_HEAD)\n\tend\n\t-- The peacock spider's red-orange carapace stripes: flat dabs lying on the head's dome, tilted to the slope under them.\n\tlocal stripes = look.stripes\n\tif stripes then\n\t\tlocal STRIPE = color(stripes.color)\n\t\tfor n = 1, #stripes do\n\t\t\tlocal st = stripes[n]\n\t\t\tlocal dx, dz = st.x, st.z - A.headCenter.Z\n\t\t\tlocal q = math.sqrt(math.max(1 - (dx / A.headRadii.X) ^ 2 - (dz / A.headRadii.Z) ^ 2, 0.05))\n\t\t\tlocal y = A.headCenter.Y + A.headRadii.Y * q\n\t\t\tlocal pitch = -math.atan(-A.headRadii.Y * (dz / A.headRadii.Z) / (A.headRadii.Z * q))\n\t\t\tlocal roll = math.atan(-A.headRadii.Y * (dx / A.headRadii.X) / (A.headRadii.X * q))\n\t\t\tlocal dab = ellipsoid(model, \"CarapaceStripe\", Vector3.new(st.rx, 0.006, st.rz), STRIPE, fabric)\n\t\t\tdab.CastShadow = false\n\t\t\tfixed(dab, Vector3.new(st.x, y + 0.002, st.z), CFrame.Angles(pitch, 0, roll) * CFrame.Angles(0, st.angle, 0), G_HEAD)\n\t\tend\n\tend\n\tlocal SOCKET = if look.eye.ame then color(look.eye.ame.socket.color) else EYE -- (a tarantula has no big front eyes to frame)\n\tfor _, e in A.eyes do\n\t\tlocal eye = ellipsoid(model, e.name, e.radii, EYE, Enum.Material.Glass)\n\t\teye.Reflectance = e.reflectance\n\t\teye.CastShadow = false\n\t\tfixed(eye, e.at, nil, G_HEAD).glance = e.principal\n\t\t-- (ROBLOX-127) depth: the lens lets a little light through onto a dark retina set back in the eye (look.eye.ame.lens; the full tier's `retina`)\n\t\tlocal lens = if e.principal and look.eye.ame then look.eye.ame.lens else nil\n\t\tif lens and cfg.retina then\n\t\t\teye.Transparency = lens.transparency\n\t\t\tlocal rt = lens.retina\n\t\t\tlocal retina = ellipsoid(model, \"Retina\", e.radii * rt.scale, color(rt.color), fabric)\n\t\t\tretina.CastShadow = false\n\t\t\tfixed(retina, e.at + Vector3.new(0, 0, e.radii.Z * rt.depth), nil, G_HEAD).glance = true\n\t\tend\n\t\tif e.principal and cfg.sockets then\n\t\t\tlocal socket = ellipsoid(model, \"EyeSocket\", e.radii * look.eye.ame.socket.scale, SOCKET, fabric)\n\t\t\tsocket.CastShadow = false\n\t\t\tfixed(socket, e.at + Vector3.new(0, 0, 0.03), nil, G_HEAD).glance = true\n\t\tend\n\tend\n\tlocal GLINT = color(look.eye.glintColor)\n\tfor _, g in A.glints do\n\t\tlocal glint = ellipsoid(model, \"Catchlight\", g.radii, GLINT, Enum.Material.Neon)\n\t\tglint.CastShadow = false\n\t\tfixed(glint, g.at, nil, G_HEAD).glance = tubercle == nil -- (the catchlights of the big front eyes; a tarantula's are on its tubercle's beads)\n\tend\n\tlocal cl = look.chelicerae\n\tlocal jawPivot: { [number]: Vector3 } = {}\n\tfor _, j in A.jaws do\n\t\tlocal fang = ellipsoid(model, \"Chelicera\", j.radii, if cl.color then color(cl.color) else FANG, Enum.Material.Foil) -- (ROBLOX-127: a colour of their own, the bold jumper's green)\n\t\tfang.Reflectance = cl.reflectance\n\t\tlocal entry = fixed(fang, j.at, CFrame.Angles(cl.pitch, 0, j.side * cl.splay), G_HEAD)\n\t\tjawPivot[j.side] = j.at + Vector3.new(0, j.radii.Y * 0.75, j.radii.Z * 0.3) -- the chelicera's base, high at the back, where it joins the face\n\t\tentry.jaw, entry.pivot = j.side, jawPivot[j.side]\n\tend\n\t-- Fangs (look.fang): chains of dark, glossy ellipsoids hanging from the chelicerae's lower front, each segment turned along its own direction.\n\tfor _, f in A.fangs do\n\t\tif f.index > (cfg.fangSegments or 0) then continue end\n\t\tlocal tooth = ellipsoid(model, \"Fang\", f.radii, if look.fang.color then color(look.fang.color) else FANG, Enum.Material.Foil)\n\t\ttooth.Reflectance = look.fang.reflectance\n\t\ttooth.CastShadow = false\n\t\tlocal entry = fixed(tooth, f.at, CFrame.lookAt(Vector3.zero, f.dir), G_HEAD)\n\t\tentry.jaw, entry.pivot = f.side, jawPivot[f.side] -- (a fang goes where its chelicera goes)\n\tend\n\t-- Pedipalps: stalk, pale band, club and pale tip, rotating about a pivot at the base (they drum when the spider stands).\n\tlocal pl = look.palp\n\tlocal pc = look.palpColors\n\tlocal PALP_STALK, PALP_CLUB, PALP_TIP = if pc then color(pc.stalk) else LEG, if pc then color(pc.club) else LEG, if pc then color(pc.tip) else JOINT\n\tfor index, palp in A.palps do\n\t\tlocal base, tip = palp.base, palp.tip\n\t\tlocal len = (tip - base).Magnitude\n\t\tlocal toBase = CFrame.new(base):Inverse()\n\t\tlocal stalk = rod(model, \"PalpStalk\", pl.stalk, PALP_STALK)\n\t\tlocal pf = look.palpForm -- a leg-like palp tapers like a femur: a thick rod, then a thinner one out to the club\n\t\tlocal reach = if pf then len * pf.split else len\n\t\tstalk.Size = Vector3.new(reach, pl.stalk, pl.stalk)\n\t\tfixed(stalk, Vector3.zero, toBase * rodCFrame(base, base:Lerp(tip, reach / len)), G_HEAD, index)\n\t\tif pf then\n\t\t\tlocal thin = rod(model, \"PalpStalkTip\", pl.stalk * pf.taper, PALP_STALK)\n\t\t\tthin.Size = Vector3.new(len - reach, pl.stalk * pf.taper, pl.stalk * pf.taper)\n\t\t\tfixed(thin, Vector3.zero, toBase * rodCFrame(base:Lerp(tip, reach / len), tip), G_HEAD, index)\n\t\tend\n\t\tlocal ring = rod(model, \"PalpBand\", pl.stalk * 1.05, WHITE)\n\t\tring.Size = Vector3.new(len * look.bandFraction, pl.stalk * 1.05, pl.stalk * 1.05)\n\t\tfixed(ring, Vector3.zero, toBase * rodCFrame(base, tip), G_HEAD, index)\n\t\tlocal os = pl.offsetScale or 1 -- the club and tip sit a little past the stalk's end; a very small spider scales that down\n\t\tfixed(ellipsoid(model, \"PalpClub\", v3(pl.club), PALP_CLUB, fabric), tip + Vector3.new(0, -0.005, -0.02) * os - base, nil, G_HEAD, index)\n\t\tfixed(ellipsoid(model, \"PalpTip\", v3(pl.tipRadii), PALP_TIP, fabric), tip + Vector3.new(0, 0.004, -0.05) * os - base, nil, G_HEAD, index)\n\tend\n\n\t-- Fuzz: flat locks over the head and abdomen, tufts, a cheek ruff and palp fluff (Rig/Setae), moved with the part they grow from.\n\tlocal fuzz = look.fuzz\n\tlocal BLACKEST = if fuzz then color(fuzz.black) else BODY\n\tlocal DARK = if fuzz then color(fuzz.dark) else BODY\n\tlocal GREY = if fuzz then color(fuzz.grey) else BODY\n\tlocal FROST = if fuzz then color(fuzz.frost) else BODY\n\tlocal function seta(tone: string, width: number, thick: number, length: number, transparency: number): Part\n\t\tlocal h = newPart(model, \"Seta\", if tone == \"white\" then WHITE elseif tone == \"frost\" then FROST elseif tone == \"grey\" then GREY elseif tone == \"black\" then BLACKEST else DARK, Enum.Material.SmoothPlastic)\n\t\th.Size = Vector3.new(width, thick, length)\n\t\th.CastShadow = false\n\t\th.Transparency = transparency\n\t\ttable.insert(self._setae, h)\n\t\treturn h\n\tend\n\tif fuzz and fuzz.enabled then\n\t\tlocal SHELL = color(fuzz.shellColor)\n\t\tlocal hr, hs = A.headRadii, fuzz.headShell\n\t\tfor k, shell in fuzz.shells do\n\t\t\tif k > cfg.shells then break end\n\t\t\tlocal a = ellipsoid(model, \"FuzzShell\", A.abdomenRadii * shell.scale, SHELL, fabric)\n\t\t\ta.Transparency, a.CastShadow = shell.transparency, false\n\t\t\tfixed(a, A.abdomenCenter, nil, G_ABDOMEN).big = true\n\t\t\tlocal h = ellipsoid(model, \"FuzzShell\", Vector3.new(hr.X * shell.scale, hr.Y * shell.scale, hr.Z * hs.zScale), SHELL, fabric)\n\t\t\th.Transparency, h.CastShadow = shell.transparency, false\n\t\t\tfixed(h, A.headCenter + Vector3.new(0, 0, hs.shift + 0.01 * k), nil, G_HEAD)\n\t\tend\n\t\t-- (A tier keeps one hair in `every` of each class: Setae.thin, which counts the two sides of a mirrored pair each by itself.)\n\t\tfor _, hair in Setae.thin(Setae.body(look), cfg.every) do\n\t\t\tlocal h = seta(hair.tone, hair.width, hair.thick, hair.length, hair.transparency)\n\t\t\tlocal mid = hair.at + hair.dir * (hair.length * 0.5)\n\t\t\tfixed(h, mid, CFrame.lookAt(Vector3.zero, hair.dir, upFor(hair.dir, hair.normal)), GROUP_OF[hair.group] or G_BODY)\n\t\tend\n\t\tfor _, hair in Setae.thin(Setae.palp(look), cfg.every) do\n\t\t\tlocal index = if hair.side < 0 then 1 else 2\n\t\t\tlocal h = seta(hair.tone, hair.width, hair.thick, hair.length, hair.transparency)\n\t\t\tlocal mid = hair.at + hair.dir * (hair.length * 0.5)\n\t\t\tlocal rest = CFrame.lookAt(mid, mid + hair.dir, upFor(hair.dir, hair.normal))\n\t\t\tfixed(h, Vector3.zero, CFrame.new(self._palpBase[index]):Inverse() * rest, G_HEAD, index)\n\t\tend\n\tend\n\n\t-- The redknee's urticating patch (look.cluster, ROBLOX-85): a tuft of ginger-rust hairs standing out of the patch, combed toward the rear.\n\tif look.cluster and cfg.cluster then\n\t\tlocal tuftLook = look.cluster\n\t\tfor _, hair in Setae.cluster(look) do\n\t\t\tlocal h = newPart(model, \"Seta\", color(if hair.tone == \"frost\" then tuftLook.light else tuftLook.color), fabric)\n\t\t\th.Size, h.CastShadow, h.Transparency = Vector3.new(hair.width, hair.thick, hair.length), false, hair.transparency\n\t\t\ttable.insert(self._setae, h)\n\t\t\tfixed(h, hair.at + hair.dir * (hair.length * 0.5), CFrame.lookAt(Vector3.zero, hair.dir, upFor(hair.dir, hair.normal)), G_ABDOMEN)\n\t\tend\n\tend\n\n\t-- A leg's pale bands: white on the femur, tibia and tarsus unless the look lists its own (look.legBands: a colour for each segment that has\n\t-- one, so the redknee's single band is { tibia = ... } and the greenbottle's none is {}).\n\tlocal function legBands(i: number, d: { number }): { Part }\n\t\tlocal lb = look.legBands\n\t\tif lb == nil then\n\t\t\treturn {rod(model, \"FemurBand\" .. i, d[1], WHITE), rod(model, \"TibiaBand\" .. i, d[2], WHITE), rod(model, \"TarsusBand\" .. i, d[2] * 0.6, WHITE)}\n\t\tend\n\t\tlocal out: { Part } = {}\n\t\tif lb.femur then out[1] = rod(model, \"FemurBand\" .. i, d[1], color(lb.femur)) end\n\t\tif lb.tibia then out[2] = rod(model, \"TibiaBand\" .. i, d[2], color(lb.tibia)) end\n\t\tif lb.tarsus then out[3] = rod(model, \"TarsusBand\" .. i, d[2] * 0.6, color(lb.tarsus)) end\n\t\treturn out\n\tend\n\t-- Legs: plump, with rounded joints and (at full detail) round feet.\n\tlocal L = look.limbs\n\tfor i = 1, 8 do\n\t\tlocal side = if i <= 4 then -1 else 1\n\t\tlocal pair = (i - 1) % 4 + 1\n\t\tlocal raw = L.diameters[pair]\n\t\tlocal factor = (if pair == 1 then look.frontLegScale else 1) * L.thickness\n\t\tlocal d = {raw[1] * factor, raw[2] * factor}\n\t\t-- A pair with its own look (the peacock spider's legs III): a colour and a thickness per segment, and no pale bands.\n\t\tlocal own = if look.pairs then look.pairs[pair] else nil\n\t\tlocal cFemur, cTibia, cTarsus = LEG, LEG, LEG\n\t\tlocal tF, tT, tTar = 1, 1, 1\n\t\tlocal kneeColor, ankleColor = JOINT, JOINT\n\t\tlocal lc = look.legColors -- a tarantula's legs are coloured segment by segment: the patella is the knee, the metatarsus and tarsus the foot\n\t\tif lc then\n\t\t\tcFemur, cTibia, cTarsus, kneeColor, ankleColor = color(lc.femur), color(lc.tibia), color(lc.tarsus), color(lc.knee), color(lc.ankle)\n\t\tend\n\t\tlocal withBands = true\n\t\tif own then\n\t\t\tcFemur, cTibia, cTarsus = color(own.colors[1]), color(own.colors[2]), color(own.colors[3])\n\t\t\ttF, tT, tTar = own.thick[1], own.thick[2], own.thick[3]\n\t\t\tkneeColor, ankleColor = cFemur, cTibia\n\t\t\twithBands = own.bands ~= false\n\t\tend\n\t\tif cfg.legBands == false then withBands = false end -- the low tier of the peacock spider draws no pale bands\n\t\t-- The shape of the leg (look.legForm, ROBLOX-84): a tapered femur and tibia, a patella for a knee, a break in the tarsus, a pad and its toes.\n\t\tlocal form = look.legForm\n\t\tlocal D1, D2, DT = d[1] * tF, d[2] * tT, d[2] * 0.6 * tTar -- the femur's, tibia's and tarsus' diameters\n\t\tlocal knee: Part\n\t\tlocal pad: Part? = nil\n\t\tlocal toes: {Part} = {}\n\t\tif form then\n\t\t\tlocal pt = form.patella\n\t\t\tknee = ellipsoid(model, \"Knee\" .. i, Vector3.new(D1 * pt.length, D1 * pt.width, D1 * pt.width) * 0.5, kneeColor, fabric)\n\t\t\tknee.CastShadow = false\n\t\t\tif cfg.pads then\n\t\t\t\tlocal ft = form.foot\n\t\t\t\tlocal sole = ellipsoid(model, \"Foot\" .. i, Vector3.new(ft.rx, ft.ry, ft.rz) * DT, cTarsus, fabric)\n\t\t\t\tsole.CastShadow = false\n\t\t\t\tpad = sole\n\t\t\t\tlocal cw = form.claws\n\t\t\t\tfor _ = 1, if cw then cfg.claws or 0 else 0 do\n\t\t\t\t\tlocal claw = rod(model, \"Claw\", cw.radius * 2, FANG)\n\t\t\t\t\tclaw.Size, claw.CastShadow = Vector3.new(cw.length, cw.radius * 2, cw.radius * 2), false\n\t\t\t\t\ttable.insert(toes, claw)\n\t\t\t\tend\n\t\t\tend\n\t\telse\n\t\t\tknee = ball(model, \"Knee\" .. i, D1 * 0.95, kneeColor)\n\t\t\tpad = if cfg.pads then ball(model, \"Foot\" .. i, DT * L.pad, cTarsus) else nil\n\t\tend\n\t\ttable.insert(self._legs, {\n\t\t\tside = side,\n\t\t\tpair = pair,\n\t\t\tplanted = nil :: Vector3?,\n\t\t\tswing = -1,\n\t\t\tfrom = Vector3.zero,\n\t\t\tto = Vector3.zero,\n\t\t\tup = Vector3.yAxis,\n\t\t\tfoot = Vector3.zero,\n\t\t\tfemur = rod(model, \"Femur\" .. i, d[1] * tF, cFemur),\n\t\t\ttibia = rod(model, \"Tibia\" .. i, d[2] * tT, cTibia),\n\t\t\ttarsus = rod(model, \"Tarsus\" .. i, d[2] * 0.6 * tTar, cTarsus),\n\t\t\tknee = knee,\n\t\t\tankle = ball(model, \"Ankle\" .. i, d[2] * tT * 0.95, ankleColor),\n\t\t\tpad = pad,\n\t\t\tfemurTip = if form and cfg.taper then rod(model, \"FemurTip\" .. i, D1 * form.femur.taper, cFemur) else nil,\n\t\t\ttibiaTip = if form and form.tibia and cfg.tibiaTaper then rod(model, \"TibiaTip\" .. i, D2 * form.tibia.taper, cTibia) else nil,\n\t\t\ttarsusTip = if form and form.tarsus.tip and cfg.jointBreak then rod(model, \"TarsusTip\" .. i, DT * form.tarsus.tip, cTarsus) else nil,\n\t\t\tjoint = if form and cfg.jointBreak then ball(model, \"TarsalJoint\" .. i, DT * form.tarsus.joint, ankleColor) else nil,\n\t\t\ttoes = toes,\n\t\t\tbands = if not withBands then {} else legBands(i, d),\n\t\t\thangKnee = nil :: Vector3?,\n\t\t\thangAnkle = nil :: Vector3?,\n\t\t\thairs = {},\n\t\t\tsegs = {},\n\t\t\trest = Vector3.zero, hip = Vector3.zero,\n\t\t\tnoise = nil :: { number }?,\n\t\t})\n\t\tlocal leg = self._legs[#self._legs]\n\t\tleg.segs = { newSeg(leg.femur, leg.femurTip, leg.bands[1]), newSeg(leg.tibia, leg.tibiaTip, leg.bands[2]), newSeg(leg.tarsus, leg.tarsusTip, leg.bands[3]) }\n\t\tif fuzz and fuzz.enabled then\n\t\t\tfor n, spec in Setae.leg(look, i) do\n\t\t\t\tif cfg.every.leg <= 0 or n % cfg.every.leg ~= 0 then continue end\n\t\t\t\t-- (what the drawing needs of a hair is worked out here, once: see LegHair)\n\t\t\t\tlocal c, sn, lie = math.cos(spec.theta), math.sin(spec.theta), spec.lift\n\t\t\t\tlocal entry: LegHair = {\n\t\t\t\t\tpart = seta(spec.tone, fuzz.legWidth, fuzz.legWidth, spec.length, fuzz.legTransparency), spec = spec, c = c, s = sn,\n\t\t\t\t\tk = if lie then 1.0 else 0.8,\n\t\t\t\t\tdir = if lie then Vector3.new(math.cos(lie), math.sin(lie) * c, math.sin(lie) * sn) else Vector3.new(1.3, c, sn).Unit,\n\t\t\t\t}\n\t\t\t\ttable.insert(leg.hairs, entry)\n\t\t\t\ttable.insert(leg.segs[spec.segment].hairs, entry)\n\t\t\tend\n\t\t\t-- (ROBLOX-127) the fringe: longer hairs of their own width standing out from the link's sides (look.fuzz.legFringe), one in `every.legFringe` kept\n\t\t\tlocal keepFringe = cfg.every.legFringe or 1\n\t\t\tfor n, spec in Setae.legFringe(look, i) do\n\t\t\t\tif keepFringe <= 0 or n % keepFringe ~= 0 then continue end\n\t\t\t\tlocal c, sn, lie = math.cos(spec.theta), math.sin(spec.theta), spec.lift or 1\n\t\t\t\tlocal width = spec.width or fuzz.legWidth\n\t\t\t\tlocal entry: LegHair = {\n\t\t\t\t\tpart = seta(spec.tone, width, width, spec.length, spec.transparency or fuzz.legTransparency), spec = spec, c = c, s = sn, k = 0.9,\n\t\t\t\t\tdir = Vector3.new(math.cos(lie), math.sin(lie) * c, math.sin(lie) * sn),\n\t\t\t\t}\n\t\t\t\ttable.insert(leg.hairs, entry)\n\t\t\t\ttable.insert(leg.segs[spec.segment].hairs, entry)\n\t\t\tend\n\t\tend\n\tend\n\tif look.legGloss then -- the Greenbottle blue's legs are a little glossy\n\t\tfor _, leg in self._legs do\n\t\t\tleg.femur.Reflectance, leg.tibia.Reflectance, leg.tarsus.Reflectance = look.legGloss, look.legGloss, look.legGloss\n\t\t\tif leg.femurTip then leg.femurTip.Reflectance = look.legGloss end\n\t\t\tif leg.tibiaTip then leg.tibiaTip.Reflectance = look.legGloss end\n\t\t\tif leg.tarsusTip then leg.tarsusTip.Reflectance = look.legGloss end\n\t\tend\n\tend\n\t-- The peacock spider's fan (look.fan): the discs of the front face, the figure on them, the repeat on the back and the folded flaps.\n\tlocal fc = look.fan\n\tif fc then\n\t\tlocal fan: Fan = { front = {}, back = {}, figure = {}, flaps = {}, cfg = fc, parts = {}, sizes = {} }\n\t\tlocal function add(list: { FanDisc }, spec: any, y: number)\n\t\t\tlocal part = disc(model, spec.name, color(spec.color), if spec.name == \"FanField\" then fc.sheen else 0)\n\t\t\ttable.insert(list, { part = part, inset = spec.inset, y = y })\n\t\t\ttable.insert(fan.parts, part)\n\t\tend\n\t\tfor k = 1, math.min(cfg.fanLayers or #fc.layers, #fc.layers) do\n\t\t\tadd(fan.front, fc.layers[k], (k - 1) * fc.layerStep)\n\t\tend\n\t\tif cfg.fanBack then\n\t\t\tfor j, k in fc.back.layers do add(fan.back, fc.layers[k], fc.back.plane - (j - 1) * fc.layerStep) end\n\t\tend\n\t\tfor _, f in fc.figure do\n\t\t\tif f.fullOnly and detailName == \"low\" then continue end\n\t\t\tlocal part = disc(model, if f.color then \"FanGlint\" else \"FanFigure\", color(f.color or fc.figureColor), 0)\n\t\t\ttable.insert(fan.figure, { part = part, x = f.x, z = f.z, rx = f.rx, rz = f.rz, angle = f.angle, turn = CFrame.Angles(0, f.angle, 0) })\n\t\t\ttable.insert(fan.parts, part)\n\t\tend\n\t\tfor _, side in { -1, 1 } do\n\t\t\tlocal flap = ellipsoid(model, \"FanFlap\", v3(fc.flaps.radii), color(fc.flaps.color), fabric)\n\t\t\tflap.CastShadow = false\n\t\t\ttable.insert(fan.flaps, { part = flap, side = side })\n\t\t\ttable.insert(fan.parts, flap)\n\t\tend\n\t\tself._fan = fan\n\tend\n\tif cfg.highlight then\n\t\tlocal hl = Instance.new(\"Highlight\")\n\t\thl.FillTransparency = 1\n\t\thl.OutlineColor = if look.outline then color(look.outline) else WHITE\n\t\thl.OutlineTransparency = 0.82\n\t\thl.DepthMode = Enum.HighlightDepthMode.Occluded\n\t\thl.Parent = model\n\t\tself._highlight = hl\n\tend\n for _,p in model:GetChildren() do\n  if p:IsA(\"BasePart\") and p~=root then self._sizes[p]=p.Size;self._colors[p]=p.Color end\n end\n\t-- The body's parts are placed every frame; the hairs, by the frame each follows (ROBLOX-93), only when that frame has moved.\n\tfor _, f in self._fixed do\n\t\tlocal palp = f.palp\n\t\tif f.part.Name ~= \"Seta\" then\n\t\t\ttable.insert(self._bodyFixed, f)\n\t\telseif palp ~= nil then\n\t\t\ttable.insert(self._palpHairs[palp], f)\n\t\telseif f.group == G_HEAD then\n\t\t\ttable.insert(self._headHairs, f)\n\t\telseif f.group == G_ABDOMEN then\n\t\t\ttable.insert(self._abdomenHairs, f)\n\t\telse\n\t\t\ttable.insert(self._bodyHairs, f)\n\t\tend\n\tend\n\trefreshScale(self)\n\tmodel.Parent = parent\n\tself:setGrowthStage(0)\n\treturn self\nend\n\n-- Scale about the support plane, not the collider centre. Planted contacts remain world-space points.\n-- (ROBLOX-93: a stage already applied writes nothing again, and setScale returns at once for the scale it has: the mate stage asks every frame.)\nfunction SpiderRig.setGrowthStage(self: Rig, stage: number)\n local index=math.clamp(math.floor(stage),0,3)\n if index~=self._stage then\n  self._stage=index\n  self.model:SetAttribute(\"GrowthStage\",index)\n  local fade=self._appearance.barFade -- the Greenbottle blue's juvenile bars soften at the last stage\n  if fade then for _,bar in self._bars do bar.Transparency=fade[index+1] end end\n end\n self:setScale(self:growthScale(index))\nend\n-- (ROBLOX-114) The scale a growth stage is drawn at: Growth.SCALES (golden), or the appearance's own `growth` where it has one (a costume whose species' adult is\n-- smaller than Growth's adult would draw it: the peacock spider and the ant mimic grow to their real adults' size, 5 and 6 mm). The collider is never touched.\nfunction SpiderRig.growthScale(self: Rig, stage: number): number\n local index=math.clamp(math.floor(stage),0,3)\n local scales=self._appearance.growth or Growth.SCALES\n return scales[index+1]\nend\n-- Any size, not only a growth stage's (ROBLOX-80: the mate is the played spider's look at the adult scale times its own factor). The same scaling as a stage.\nfunction SpiderRig.setScale(self: Rig, g: number)\n if self._growth==g then return end\n self._growth=g\n self._k=(self._appearance.scale or 1)*g\n self._drop=0.31-(0.31-(self._appearance.bodyDrop or 0))*g\n self._epoch+=1 -- what was placed for the old scale is placed again\n for p,size in self._sizes do p.Size=size*g end\n refreshScale(self)\nend\nfunction SpiderRig.setSoftness(self: Rig, value: number)\n local s=math.clamp(value,0,1)\n if math.abs(s-self._softness)<0.001 then return end\n self._softness=s\n for p,c in self._colors do\n  -- The eyes stay dark and readable; pigment returns as the skin hardens.\n  if p.Material~=Enum.Material.Glass and p.Name~=\"Catchlight\" and p.Name~=\"Retina\" then p.Color=c:Lerp(Color3.new(0.88,0.82,0.69),s*0.72) end\n end\nend\nfunction SpiderRig.setCondition(self: Rig, energy: number)\n self._condition=math.clamp(energy,0,1)\nend\n\n-- A cue from the host for the living motion (ROBLOX-87): \"groom\" (a meal has just ended: a longer cleaning once it stands still) or \"alarm\" (the wasp's\n-- warning or the rival's windup: legs I up and the idle motion frozen for a moment). Anything else, or a rig below the full tier, ignores it.\n-- ROBLOX-89: \"meet\" (reach out to the other spider) and \"settle\" (sink and breathe deeper) for the mating scene, each for `seconds` (default the look's own), and\n-- \"release\" to let both go; a rig without the living motion (the ant mimic, the low tier unless made `living`) ignores them.\nfunction SpiderRig.cue(self: Rig, name: string, seconds: number?)\n\tlocal living = self._living\n\tif living ~= nil then Living.cue(living, name, seconds) end\nend\n\n-- The host's count of meals finished so far: a rise cues the \"groom\". (The first count only sets the baseline: a spider loaded from a save does not clean itself.)\nfunction SpiderRig.noteMeals(self: Rig, count: number)\n\tlocal seen = self._mealsSeen\n\tself._mealsSeen = count\n\tif seen ~= nil and count > seen then self:cue(\"groom\") end\nend\n\n-- How many parts the drawn spider is made of (the model's direct parts), for budgets and the docs.\nfunction SpiderRig.count(self: Rig): { total: number, hairs: number, shells: number, body: number }\n\tlocal total, hairs, shells = 0, 0, 0\n\tfor _, part in self.model:GetChildren() do\n\t\tif part:IsA(\"BasePart\") then\n\t\t\ttotal += 1\n\t\t\tif part.Name == \"Seta\" then hairs += 1 elseif part.Name == \"FuzzShell\" then shells += 1 end\n\t\tend\n\tend\n\treturn { total = total, hairs = hairs, shells = shells, body = total - hairs - shells }\nend\n\nlocal function legGroup(self: Rig, i: number): number\n\tif self.gaitMode == \"Unilateral\" then\n\t\treturn if i <= 4 then 0 else 1\n\tend\n\t-- Godot's (i % 4 + i / 4) % 2 with 0-based i: L1 R2 L3 R4 against R1 L2 R3 L4.\n\tlocal j = i - 1\n\treturn (j % 4 + j // 4) % 2\nend\n\n\n-- Display-only foothold: retract toward the body at a narrow edge; never invents a platform.\nlocal function target(self: Rig, body: CFrame, leg: Leg): RaycastResult?\n\tlocal up = body.UpVector\n\tlocal rest = leg.rest\n\tlocal k = self._k\n\tfor _, reach in REACHES do\n\t\tlocal point = body:PointToWorldSpace(Vector3.new(rest.X * reach, 0, rest.Z * reach))\n\t\tlocal hit = Workspace:Raycast(point + up * (0.35 * k), -up * (1.0 * k), self._params)\n\t\tif hit and hit.Normal:Dot(up) > 0.35 then\n\t\t\treturn hit\n\t\tend\n\tend\n\treturn nil\nend\n\n-- The hanging pose of one leg (ROBLOX-86): the knee, the ankle and the foot in world space, from the directions in look.hang.legs. Each link keeps\n-- the length it has standing (hip to knee, knee to ankle, ankle to foot, as the walking pose draws them), so legs I and II curl forward and back up\n-- toward the line, III and IV fold back along the body, and nothing reaches for the ground. A fixed scatter per leg keeps the pair from mirroring\n-- exactly; the feet tremble a little (not with Reduced Motion); going up the line the legs' directions along the body turn over (`_climb`), so legs I\n-- reach up the line and legs IV trail.\nfunction SpiderRig._hangLeg(self: Rig, leg: Leg, body: CFrame): (Vector3, Vector3, Vector3)\n\tlocal look, L, g = self._appearance, self._appearance.limbs, self._growth\n\tlocal hang = look.hang\n\tlocal hip, rest = leg.hip, leg.rest\n\tlocal knee0 = hip:Lerp(rest, 0.48) + Vector3.yAxis * (L.kneeLift * g)\n\tlocal ankle0 = knee0:Lerp(rest, ANKLE_SHARE) + Vector3.yAxis * (L.ankleLift * g)\n\tlocal len1, len2, len3 = (knee0 - hip).Magnitude, (ankle0 - knee0).Magnitude, (rest - ankle0).Magnitude\n\tlocal spec = hang.legs[leg.pair]\n\t-- (ROBLOX-93: the scatter of each link is a fixed pair of numbers, worked out the first time the leg hangs and kept, and no table is made of the lengths or the joints)\n\tlocal scatter: { number } = leg.noise or {}\n\tif leg.noise == nil then\n\t\tlocal made = scatter\n\t\tfor n = 1, 3 do\n\t\t\tmade[2 * n - 1] = math.sin(leg.pair * 12.9898 + leg.side * 78.233 + n * 37.719)\n\t\t\tmade[2 * n] = math.sin(leg.pair * 39.346 + leg.side * 11.135 + n * 83.155)\n\t\tend\n\t\tleg.noise = made\n\tend\n\tlocal climb = self._climb\n\tlocal tremble = if self.reducedMotion then 0 else math.sin(self._t * 3.2 + leg.pair * 1.7 + leg.side) * hang.wiggle\n\tlocal j1, j2, j3 = hip, hip, hip\n\tlocal at = hip\n\tfor n = 1, 3 do\n\t\tlocal d = spec[LEG_NAMES[n]]\n\t\tlocal noise, noise2 = scatter[2 * n - 1], scatter[2 * n]\n\t\tlocal dz = d[3] * (1 - (if leg.pair <= 2 then 2.0 else 1.2) * climb) -- going up, legs I and II reach up the line and III and IV go out to grip it\n\t\tlocal dir = Vector3.new(leg.side * d[1] + noise * hang.asym, d[2] + noise2 * hang.asym + (if n == 3 then tremble else 0), dz + noise * noise2 * hang.asym).Unit\n\t\tat = at + dir * (if n == 1 then len1 elseif n == 2 then len2 else len3)\n\t\tif n == 1 then j1 = at elseif n == 2 then j2 = at else j3 = at end\n\tend\n\treturn body:PointToWorldSpace(j1), body:PointToWorldSpace(j2), body:PointToWorldSpace(j3)\nend\n\n-- One link of a leg (ROBLOX-93: a function of the module, so that a frame makes no closure of it): its rod runs from a to b; with a thinner `tip` rod the first runs a to m\n-- and the tip m to b (a tapered femur or tibia, the break in the tarsus). The pale band (one `bandFraction` of the whole link) and the hairs follow the link, not the\n-- pieces. A size is written only when it is more than its step from the one the part has (kept in `seg`, so nothing is read from the part), and the hairs, which\n-- go to the second batch, are placed again only when the link has moved.\nlocal function drawSegment(seg: Seg, bandFraction: number, g: number, a: Vector3, m: Vector3, b: Vector3, bodyBatch: Batch, hairBatch: Batch, exact: boolean)\n\tlocal rod, tip, band = seg.rod, seg.tip, seg.band\n\tlocal len = math.max((b - a).Magnitude, 0.01)\n\tlocal ends = if tip then m else b\n\tlocal plen = math.max((ends - a).Magnitude, 0.01)\n\tif math.abs(seg.x - plen) > 1e-3 then\n\t\tseg.x = plen\n\t\trod.Size = Vector3.new(plen, seg.dy, seg.dz)\n\tend\n\tlocal rc = rodCFrame(a, b) -- local +X runs from a toward b (toward the foot)\n\tput(bodyBatch, rod, if tip then rodCFrame(a, m) else rc)\n\tlocal share = plen / len\n\tif tip then\n\t\tlocal tlen = math.max((b - m).Magnitude, 0.01)\n\t\tif math.abs(seg.tipX - tlen) > 1e-3 then\n\t\t\tseg.tipX = tlen\n\t\t\ttip.Size = Vector3.new(tlen, seg.tipDy, seg.tipDz)\n\t\tend\n\t\tput(bodyBatch, tip, rodCFrame(m, b))\n\tend\n\tif band then\n\t\tlocal blen = len * bandFraction\n\t\tif math.abs(seg.bandX - blen) > BAND_STEP then\n\t\t\tseg.bandX = blen\n\t\t\tband.Size = Vector3.new(blen, seg.dy * 1.035, seg.dz * 1.035)\n\t\tend\n\t\tput(bodyBatch, band, rc)\n\tend\n\t-- Leg setae stand out from the segment and lean toward the foot (or, for a coat that lies along the leg, lie at their own angle).\n\tif exact or moved(seg.rc, rc) or math.abs(len - seg.len) > MOVE_STUDS then\n\t\tseg.rc, seg.len = rc, len\n\t\tlocal radius, tipRadius = seg.dy * 0.5, seg.tipDy * 0.5\n\t\tfor _, hair in seg.hairs do\n\t\t\tlocal spec = hair.spec\n\t\t\tlocal r = if tip and spec.t > share then tipRadius else radius\n\t\t\tlocal base = Vector3.new((spec.t - 0.5) * len, r * hair.k * hair.c, r * hair.k * hair.s)\n\t\t\tlocal dir = hair.dir\n\t\t\tput(hairBatch, hair.part, rc * CFrame.lookAt(base + dir * (spec.length * g * 0.5), base + dir * spec.length*g, Vector3.xAxis))\n\t\tend\n\tend\nend\n\n-- Writes the size a fan part should have, if it differs from what it has (the fan keeps what each part holds; nothing is read from the part).\nlocal function fanSize(fan: Fan, part: BasePart, size: Vector3)\n\tlocal was: Vector3? = fan.sizes[part]\n\tif was == nil or (was - size).Magnitude > 1e-5 then\n\t\tfan.sizes[part] = size\n\t\tpart.Size = size\n\tend\nend\n\n-- Sets the fan's discs for how far it is open (0: folded on the abdomen, 1: a near-round disc) in the abdomen's frame. The discs grow from\n-- Appearances.fan.folded to full size; the figure and the repeat on the back follow; the folded flaps swing out from the flanks and end\n-- under the discs. Flat ellipsoids: only their size and place change. Each part lies on the abdomen, so its place (about the abdomen's centre) and its size go with the\n-- abdomen's `condition`; ROBLOX-93: both are worked out once, from the part's own size, and a size is written once or not at all.\nlocal function drawFan(self: Rig, fan: Fan, abdomen: CFrame, open: number, condition: Vector3, batch: Batch)\n\tlocal fc, A, g = fan.cfg, self._layout, self._growth\n\tlocal center = A.abdomenCenter\n\tlocal sx = fc.folded[1] + (1 - fc.folded[1]) * open\n\tlocal sz = fc.folded[2] + (1 - fc.folded[2]) * open\n\tlocal fold = 1 - open\n\tlocal top = center.Y + A.abdomenRadii.Y + fc.plane - fc.foldedSink * fold\n\tlocal z = center.Z + fc.zShift * open\n\tlocal thick = fc.thickness + (fc.foldedThickness - fc.thickness) * fold\n\tlocal mid = center.Y - A.abdomenRadii.Y\n\tfor pass = 1, 2 do\n\t\tlocal discs: { FanDisc } = if pass == 1 then fan.front else fan.back\n\t\tlocal y0, t = if pass == 1 then top else mid, if pass == 1 then thick else fc.thickness\n\t\tfor _, d in discs do\n\t\t\tlocal rx, rz = math.max((fc.radii[1] - d.inset) * sx, 0.002), math.max((fc.radii[2] - d.inset) * sz, 0.002)\n\t\t\tfanSize(fan, d.part, Vector3.new(rx * 2, t, rz * 2) * g * condition)\n\t\t\tput(batch, d.part, abdomen * CFrame.new((center + (Vector3.new(0, y0 + d.y, z) - center) * condition) * g))\n\t\tend\n\tend\n\tlocal figureY = top + #fan.front * fc.layerStep + (thick - fc.thickness) * 0.5\n\tlocal show = open * open * (3 - 2 * open) -- the black figure shows as the fan opens, and is gone when it is folded\n\tfor _, f in fan.figure do\n\t\tfanSize(fan, f.part, Vector3.new(math.max(f.rx * fc.radii[1] * sx * 2 * show, 0.002), fc.thickness, math.max(f.rz * fc.radii[2] * sz * 2 * show, 0.002)) * g * condition)\n\t\tlocal at = Vector3.new(f.x * fc.radii[1] * sx, figureY, z + f.z * fc.radii[2] * sz)\n\t\tput(batch, f.part, abdomen * CFrame.new((center + (at - center) * condition) * g) * f.turn)\n\tend\n\tlocal fl = fc.flaps\n\tlocal angle = math.rad(fl.foldedDeg) * (1 - open)\n\tfor _, f in fan.flaps do\n\t\tfanSize(fan, f.part, self._sizes[f.part] * g * condition)\n\t\tlocal hinge = Vector3.new(f.side * fl.hingeX, center.Y + fl.hingeY, center.Z + fc.zShift * open)\n\t\tlocal cf = (CFrame.Angles(0, 0, f.side * angle) + hinge) * CFrame.new(f.side * fl.radii[1], 0, 0)\n\t\tput(batch, f.part, abdomen * CFrame.new((center + (cf.Position - center) * condition) * g) * cf.Rotation)\n\tend\nend\n\n-- body: the drawn body's CFrame. grounded: standing on a surface. moving: walking speed > 0 (for palp drumming and idle motion).\nfunction SpiderRig.update(self: Rig, collider: CFrame, dt: number, grounded: boolean, moving: boolean)\n\tself._t += dt\n\t-- The root part (what the camera and tests read) stays at the collider's frame; the drawn body of a small appearance sits lower.\n\tlocal body = if self._drop ~= 0 then collider * CFrame.new(0, -self._drop, 0) else collider\n\t-- The ant-mimicking spider's drawn walk: the body yaws and sways a little along a sine of the distance walked (the collider and the path\n\t-- are untouched; the root part stays at the collider's frame).\n\tlocal antPose = if self._appearance.antennae ~= nil then self.ant else nil\n\tif antPose ~= nil and (antPose.yaw ~= 0 or antPose.lateral ~= 0) then\n\t\tbody = body * CFrame.new(antPose.lateral * self._growth, 0, 0) * CFrame.Angles(0, antPose.yaw, 0)\n\tend\n\t-- A tarantula's threat display and silk mat (ROBLOX-82): the drawn body pivots about its up axis (the root and the collider do not); what else\n\t-- the pose does (rears the prosoma, raises legs I and the palps, swings the spinnerets) is further down.\n\t-- (ROBLOX-127) the rival's contest display (look.contest, a RivalDisplay pose) goes the same way, with a sideways step of the drawn body (`lateral`, studs at scale 1:\n\t-- the zigzag), legs I between three places (`reach`, `hook`), the chelicerae spread (`spread`) and a crouch (`lower`).\n\tlocal tc = self._appearance.threat or self._appearance.contest\n\tlocal threatPose = if tc ~= nil then self.threat else nil\n\tlocal threatening = threatPose ~= nil and threatPose.presence > 0\n\tif threatening and (threatPose.lateral or 0) ~= 0 then\n\t\tbody = body * CFrame.new(threatPose.lateral * self._growth, 0, 0)\n\tend\n\tif threatening and threatPose.yaw ~= 0 then\n\t\tbody = body * CFrame.Angles(0, threatPose.yaw, 0)\n\tend\n\tlocal up = body.UpVector\n\tlocal look, cfg, A = self._appearance, self._cfg, self._layout\n\tlocal k, g = self._k, self._growth\n self._shownCondition += math.clamp(self._condition-self._shownCondition,-0.12*dt,0.12*dt)\n local conditionValue=self._shownCondition\n local condition=Vector3.new(0.84+0.30*conditionValue,0.84+0.30*conditionValue,0.93+0.12*conditionValue)\n\t-- Suspension (ROBLOX-59; hung properly in ROBLOX-86). The drawn body turns about its middle until its long axis, from the face to the spinneret,\n\t-- runs along the line (the shortest turn: no angle limit), so the tail lands on the line and the silk leaves the spinneret tip; the root, the camera,\n\t-- the collider and the tether never move. Then a small lean, a damped pendulum sway (about the spinneret, started by the drop) and a slow damped turn\n\t-- about the line, none of it with Reduced Motion. Going up the line (the collider travelling toward the anchor) the body turns head-up (`_climb`).\n\tlocal hang = look.hang\n\tlocal hanging = not grounded and self.hangDirection ~= nil and hang ~= nil\n\tif hanging then\n\t\tlocal d = (self.hangDirection :: Vector3)\n\t\tif d.Magnitude > 1e-6 then self._lineDir = d.Unit end\n\tend\n\tlocal lineUp = self._lineDir\n\tlocal blend = if hang ~= nil then hang.rate * dt else 5 * dt\n\tlocal before = self._hang\n\tself._hang += math.clamp((if hanging then 1 else 0) - self._hang, -blend, blend)\n\tif grounded then self._hang = 0 end\n\tif hang ~= nil then\n\t\tif hanging and dt > 1e-6 and self._lastPos ~= nil then\n\t\t\tlocal speed = (collider.Position - (self._lastPos :: Vector3)):Dot(lineUp) / dt\n\t\t\tself._lineSpeed += (speed - self._lineSpeed) * math.min(1, dt / 0.25)\n\t\t\tif self._lineSpeed > hang.climb.speed then self._climbing = true elseif self._lineSpeed < hang.climb.speed * 0.4 then self._climbing = false end\n\t\telseif not hanging then\n\t\t\tself._lineSpeed, self._climbing = 0, false\n\t\tend\n\t\tself._lastPos = collider.Position\n\t\tlocal step = if self.reducedMotion then 1 else math.max(dt, 1e-6) / hang.climb.seconds\n\t\tself._climb += math.clamp((if self._climbing and hanging then 1 else 0) - self._climb, -step, step)\n\t\tif not hanging and self._hang <= 0 then self._climb = 0 end\n\tend\n\tif self._hang > 0 and hang ~= nil then\n\t\tlocal h = self._hang\n\t\tif before <= 0 then -- the drop: the swing and the turn start now (the turn goes one way, then the other, drop by drop)\n\t\t\tself._hangT, self._spin = 0, 0\n\t\t\tself._spinVel = math.rad(hang.spin.degPerS) * (if self._hangCount % 2 == 0 then 1 else -1)\n\t\t\tself._hangCount += 1\n\t\tend\n\t\tself._hangT += dt\n\t\tlocal calm = not self.reducedMotion\n\t\tif calm then\n\t\t\tself._spinVel *= math.exp(-dt / hang.spin.decay)\n\t\t\tself._spin += self._spinVel * dt\n\t\tend\n\t\tlocal c = self._climb\n\t\t-- the long axis: the face's centre to the spinneret tip, turned (about the middle) onto the line\n\t\tlocal nose = Vector3.new(0, A.faceCenter.Y, A.faceCenter.Z) * g\n\t\tlocal tail = (A.abdomenCenter + (A.spinneret - A.abdomenCenter) * condition) * g\n\t\tlocal middle = body:PointToWorldSpace((nose + tail) * 0.5)\n\t\tlocal axis = body:VectorToWorldSpace((tail - nose).Unit)\n\t\tlocal turn = axis:Cross(lineUp)\n\t\tlocal offLine = math.acos(math.clamp(axis:Dot(lineUp), -1, 1))\n\t\tlocal align = CFrame.identity\n\t\tif turn.Magnitude > 1e-5 then align = CFrame.fromAxisAngle(turn.Unit, offLine * h)\n\t\telseif axis:Dot(lineUp) < 0 then align = CFrame.fromAxisAngle(body.UpVector, math.pi * h) end\n\t\tbody = CFrame.new(middle) * align * CFrame.new(-middle) * body\n\t\tif c > 0 then -- head up: end over end about the middle, the body standing off the line toward its back so the silk runs along the belly\n\t\t\tbody = CFrame.new(middle) * CFrame.fromAxisAngle(body.RightVector, math.pi * c * h) * CFrame.new(-middle) * body\n\t\t\tbody = CFrame.new(body.UpVector * (A.headRadii.Y * hang.climb.shift * g * c * h)) * body\n\t\tend\n\t\tlocal pivot = body:PointToWorldSpace(tail)\n\t\tlocal side = body.RightVector\n\t\tlocal forward = lineUp:Cross(side)\n\t\tif forward.Magnitude > 1e-6 then forward = forward.Unit end\n\t\tlocal rest = (1 - c) * h\n\t\tlocal swing = if calm then math.exp(-self._hangT / hang.sway.decay) * math.sin(math.pi * 2 * self._hangT / hang.sway.period) else 0\n\t\tlocal swingAcross = if calm then math.exp(-self._hangT / hang.sway.decay) * math.cos(math.pi * 2 * self._hangT / hang.sway.period) * (1 - math.exp(-self._hangT / 0.3)) else 0\n\t\tlocal sway = math.rad(hang.sway.deg) * swing\n\t\tlocal sideways = math.rad(hang.sway.deg) * hang.sway.across * swingAcross\n\t\tlocal lean = CFrame.fromAxisAngle(side, (math.rad(hang.leanDeg) + sway) * rest) * CFrame.fromAxisAngle(forward, sideways * rest)\n\t\tbody = CFrame.new(pivot) * CFrame.fromAxisAngle(lineUp, self._spin * rest) * lean * CFrame.new(-pivot) * body\n\t\tup = body.UpVector\n\tend\n\t-- The drawing is two batches (ROBLOX-93): the body's parts every frame, then the hairs that moved (see MOVE_STUDS). Both are tables the rig keeps.\n\tlocal bodyBatch, hairBatch = self._bodyBatch, self._hairBatch\n\tclearBatch(bodyBatch)\n\tclearBatch(hairBatch)\n\tput(bodyBatch, self.root, collider)\n\t-- The courtship display (rig.dance, a PeacockDance pose), for an appearance that has a fan.\n\tlocal display = self.dance\n\tlocal fan = self._fan\n\tlocal dancing = fan ~= nil and display ~= nil and display.presence > 0\n\tlocal posed = dancing or threatening -- a display pose is on: no idle motion, twitch or jump brace on top of it\n\n\t-- Palps drum in bursts while the spider stands still; breathing and a curious head tilt ease in after a moment. All of\n\t-- it is full detail only (cfg.idle), and reducedMotion turns it off too.\n\tlocal loading = grounded and self.jumpLoad > 0\n local push = if self.reducedMotion then 0 else math.clamp(self.jumpPush,0,1)\n local desiredLoad = if loading and not self.reducedMotion then math.clamp(self.jumpLoad,0,1) else 0\n self._shownLoad += math.clamp(desiredLoad-self._shownLoad,-12*dt,6*dt)\n local load = if self.reducedMotion then 0 else self._shownLoad\n local standing = cfg.idle and grounded and not moving and not self.reducedMotion and not posed and not loading\n\t-- Living motion (ROBLOX-87), full detail only: the watched point as an angle from the drawn body's heading, then the pose of attention, grooming, alarm and\n\t-- a tarantula's stretch. It only ever turns and bends drawn parts: the planted feet, the root, the motor and the camera do not know it.\n\tlocal lp: Living.Pose? = nil\n\tlocal living = self._living\n\tif living ~= nil then\n\t\tlocal focusYaw: number?, focusPitch: number? = nil, nil\n\t\tlocal watched = self.focusPoint\n\t\tif watched ~= nil and grounded and not posed and self._hang <= 0 then\n\t\t\tlocal d = body:PointToObjectSpace(watched)\n\t\t\tlocal flat = math.sqrt(d.X * d.X + d.Z * d.Z)\n\t\t\tif flat > 0.25 * k then\n\t\t\t\tfocusYaw, focusPitch = math.atan2(-d.X, -d.Z), math.atan2(d.Y - A.faceCenter.Y * g, flat)\n\t\t\tend\n\t\tend\n\t\tlp = Living.step(living, dt, standing == true, self.reducedMotion, focusYaw, focusPitch, grounded and not posed and self._hang <= 0)\n\tend\n\tlocal freeze = if lp ~= nil then lp.freeze else 0\n\t-- The abdomen breathes: all of it at a stand, `movingShare` of it otherwise (and none with Reduced Motion or below the full tier).\n\tlocal breathing = 0\n\tif cfg.idle and not self.reducedMotion then breathing = if standing then 1 else (look.idle.breathe.movingShare or 0) end\n\tself._breath += math.clamp(breathing - self._breath, -dt / 0.6, dt / 0.6)\n\tlocal gain = if lp ~= nil then lp.breath else 1 -- (the mating scene's settle: a deeper breath, ROBLOX-89)\n\tlocal breathScale = if cfg.idle then Idle.abdomenScale(self._t, self._breath * (1 - 0.8 * freeze) * gain, look.idle) else 1\n\tself._drum = math.clamp(self._drum + (if standing then 3 else -3) * dt, 0, 1)\n\tlocal drum = self._drum * (1 - freeze)\n\tlocal palp1, palp2 = Idle.palp(self._t, drum, look.palp, 1), Idle.palp(self._t, drum, look.palp, 2) -- (the palps' angles)\n\tlocal bodyBase, headBase, abdomenBase = body, body, body\n\tif cfg.idle then\n\t\tlocal idle = look.idle\n\t\tself._calm = math.clamp(self._calm + (if standing then dt / idle.riseSeconds else -dt / idle.fallSeconds), 0, 1)\n\t\tif self._calm > 0 then\n\t\t\tlocal c = self._calm * self._calm * (3 - 2 * self._calm) * (1 - freeze)\n\t\t\tlocal pose = Idle.pose(self._t, c, idle, self._pose)\n\t\t\tbodyBase = body * CFrame.new(0, pose.bodyLift*g*gain, 0)\n\t\t\theadBase = bodyBase * CFrame.new(A.neck*g) * CFrame.Angles(pose.headPitch, pose.headYaw, pose.headRoll) * CFrame.new(-A.neck*g)\n\t\t\tabdomenBase = bodyBase * CFrame.new(0, pose.abdomenLift*g*gain, 0) * CFrame.new(A.pedicelCenter*g)\n\t\t\t\t* CFrame.Angles(-pose.abdomenPitch*gain, 0, 0) * CFrame.new(-A.pedicelCenter*g)\n\t\tend\n\tend\n\t-- Display-only snaps also run on low-detail devices. Camera/root, foot anchors and motor stay unchanged.\n\tif grounded and not self.reducedMotion and not posed and not loading then\n\t\tlocal yaw, lift = Idle.snap(self._t, moving)\n\t\tyaw, lift = yaw * (1 - freeze), lift * (1 - freeze)\n\t\tlocal accent = body * CFrame.new(0, lift * g, 0) * CFrame.Angles(0, yaw, 0) * body:Inverse()\n\t\tbodyBase, headBase, abdomenBase = accent * bodyBase, accent * headBase, accent * abdomenBase\n\tend\n\t-- Attention: the whole drawn body turns toward what is watched (the hips go with it; the planted feet stay where they are).\n\tif lp ~= nil and lp.yaw ~= 0 then\n\t\tlocal turn = body * CFrame.Angles(0, lp.yaw, 0) * body:Inverse()\n\t\tbodyBase, headBase, abdomenBase = turn * bodyBase, turn * headBase, turn * abdomenBase\n\tend\n\t-- The mating scene's settle (ROBLOX-89): the whole drawn body sinks a little toward the surface (the planted feet stay where they are).\n\tif lp ~= nil and lp.settle > 0 and look.idle.settle ~= nil then\n\t\tlocal sink = body * CFrame.new(0, -look.idle.settle.lower * g * lp.settle, 0) * body:Inverse()\n\t\tbodyBase, headBase, abdomenBase = sink * bodyBase, sink * headBase, sink * abdomenBase\n\tend\n -- A visible preparation and extension, not a pressure gauge or an inflated body. Hydraulic\n -- extension and muscle action both matter; their jump contribution varies among species\n -- (Nabawy et al. 2018, doi:10.1038/s41598-018-25227-9). Timings are display tuning.\n if not posed and (load > 0 or push > 0) then\n  local brace = body * CFrame.new(0,(-0.065*load+0.025*push)*k,0)\n   * CFrame.Angles(-0.07*load+0.05*push,0,0) * body:Inverse()\n  bodyBase,headBase,abdomenBase=brace*bodyBase,brace*headBase,brace*abdomenBase\n end\n\tif dancing then\n\t\t-- The abdomen pitches up about the pedicel and sways side to side (about the body's long axis), the palps flick in unison.\n\t\tabdomenBase = bodyBase * CFrame.new(A.pedicelCenter*g) * CFrame.Angles(0, 0, display.abdomenSway + display.shiver)\n\t\t\t* CFrame.Angles(-display.abdomenPitch, 0, 0) * CFrame.new(-A.pedicelCenter*g)\n\t\tpalp1, palp2 = palp1 + display.palp, palp2 + display.palp\n\tend\n\t-- The threat display: the prosoma (the head with the palps, and every leg's hip) pitches up about the waist; the palps lift at their bases.\n\tlocal prosoma = bodyBase\n\tif threatening and threatPose.rear ~= 0 then\n\t\tlocal waist = A.pedicelCenter * g\n\t\tprosoma = bodyBase * CFrame.new(waist) * CFrame.Angles(threatPose.rear, 0, 0) * CFrame.new(-waist)\n\t\theadBase = prosoma * (bodyBase:Inverse() * headBase) -- (keeps any head tilt the idle motion still has)\n\tend\n\tif threatening then\n\t\tpalp1, palp2 = palp1 + threatPose.palps, palp2 + threatPose.palps\n\t\tlocal sink = (threatPose.lower or 0) * (if tc.lower then tc.lower else 0)\n\t\tif sink ~= 0 then -- backing off: the whole drawn body low to the surface (the planted feet stay where they are)\n\t\t\tlocal down = body * CFrame.new(0, -sink * g, 0) * body:Inverse()\n\t\t\tbodyBase, headBase, abdomenBase, prosoma = down * bodyBase, down * headBase, down * abdomenBase, down * prosoma\n\t\tend\n\tend\n -- Feeding follows the drawn head, never the motor or camera. Both tiers use this pose.\n local bite=(self.mealPulse or 0)*(if self.reducedMotion then .2 else 1)\n if self.mealHeld then\n  headBase*=CFrame.new(0,-.012*bite*g,-.02*bite*g)*CFrame.Angles(-.035*bite,0,0)\n  palp1-=.16+.1*bite;palp2-=.16+.1*bite\n end\n self._mouth=headBase*CFrame.new(((A.jaws[1].at+A.jaws[2].at)*.5+Vector3.new(0,-.015,-.075))*g)\n\tlocal spreadAngle = if threatening and tc.spreadDeg then math.rad(tc.spreadDeg) * (threatPose.spread or 0) else (if self.mealHeld then .05+.08*bite else 0)\n if self._hang > 0 and hang ~= nil then -- hanging: the palps are drawn in toward the jaws\n  local tuck = -math.rad(hang.palpTuckDeg) * self._hang\n  palp1, palp2 = palp1 + tuck, palp2 + tuck\n end\n self._spinneret=abdomenBase:PointToWorldSpace((A.abdomenCenter+(A.spinneret-A.abdomenCenter)*condition)*g)\n\t-- Grooming: a palp is drawn in toward the jaws (turned toward the midline and tipped down) about its base.\n\tlocal palpYaw1, palpYaw2 = 0, 0\n\tif lp ~= nil then\n\t\tpalp1, palp2 = palp1 - lp.palpPitch[1], palp2 - lp.palpPitch[2]\n\t\tpalpYaw1, palpYaw2 = lp.palpYaw[1], lp.palpYaw[2]\n\tend\n\tlocal glanceAt = Vector3.zero -- the principal eyes' shift in the head's frame, studs, toward what is watched\n\tif lp ~= nil and look.idle.attention ~= nil then\n\t\tlocal reach = look.idle.attention.glance\n\t\tglanceAt = Vector3.new(lp.glanceX * reach, lp.glanceY * reach * 0.6, 0)\n\tend\n\tlocal pivot1 = CFrame.Angles(palp1, palpYaw1, 0) + self._palpBase[1]\n\tlocal pivot2 = CFrame.Angles(palp2, palpYaw2, 0) + self._palpBase[2]\n\t-- What has changed since the hairs were last placed: after a change of scale (a new epoch) everything, otherwise the abdomen's condition (its parts' sizes and places)\n\t-- and, below, the frame each kind of hair follows.\n\tlocal seen, epoch = self._seen, self._epoch\n\tlocal fresh = seen.epoch ~= epoch or self._exact\n\tlocal abdomenAt = A.abdomenCenter\n\tlocal sizesDue = fresh or (condition - seen.sizeKey).Magnitude > SCALE_STEP\n\tlocal glanced = glanceAt ~= Vector3.zero\n\tlocal sweeping = threatening and threatPose.sweep ~= 0\n\tfor _, f in self._bodyFixed do\n\t\tlocal group = f.group\n\t\tlocal base = if group == G_HEAD then headBase elseif group == G_ABDOMEN then abdomenBase else bodyBase\n\t\tlocal palp = f.palp\n\t\tif palp then\n\t\t\tput(bodyBatch, f.part, base * scaled((if palp == 1 then pivot1 else pivot2) * f.offset, g))\n\t\telse\n\t\t\tlocal offset, edited = f.offset, false\n\t\t\tif f.glance == true and glanced then offset, edited = CFrame.new(glanceAt) * offset, true end\n\t\t\tif spreadAngle ~= 0 and f.jaw ~= nil and f.pivot ~= nil then\n\t\t\t\t-- The rival's display: each chelicera (and its fang) swings out about its base, the tip outward and a little apart (ROBLOX-127).\n\t\t\t\tlocal side, at = f.jaw, f.pivot\n\t\t\t\toffset, edited = CFrame.new(at) * CFrame.Angles(0, -side * spreadAngle * 0.35, side * spreadAngle) * CFrame.new(-at) * offset, true\n\t\t\tend\n\t\t\tif sweeping and f.sweep ~= nil then\n\t\t\t\t-- A spinneret segment swings side to side about a point just inside the abdomen's rear tip (the second segment farther).\n\t\t\t\tlocal at = A.spinneret - Vector3.new(0, 0, tc.sweepBack)\n\t\t\t\toffset, edited = CFrame.new(at) * CFrame.Angles(0, threatPose.sweep * (if f.sweep > 1 then tc.tipSweep else 1), 0) * CFrame.new(-at) * offset, true\n\t\t\tend\n\t\t\tif group == G_ABDOMEN then\n\t\t\t\t-- (the whole abdomen, its hairs and its shells, breathes; only the big masses are resized every frame, the rest when the condition has changed)\n\t\t\t\tlocal pos, rot = f.pos, f.rot\n\t\t\t\tif edited then pos, rot = offset.Position, offset.Rotation end\n\t\t\t\tlocal p = abdomenAt + (pos - abdomenAt) * condition * breathScale\n\t\t\t\tput(bodyBatch, f.part, base * (rot + (if g == 1 then p else p * g)))\n\t\t\t\tif f.big == true then\n\t\t\t\t\tresize(f, f.size0 * g * condition * breathScale)\n\t\t\t\telseif sizesDue then\n\t\t\t\t\tresize(f, f.size0 * g * condition)\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tput(bodyBatch, f.part, base * (if edited then scaled(offset, g) else f.scaled))\n\t\t\tend\n\t\tend\n\tend\n\n\t-- The hairs, in the second batch: a kind is placed again only if the frame it follows has moved since it was last placed (fresh: after a change of scale, all).\n\tif fresh or moved(seen.head, headBase) then\n\t\tseen.head = headBase\n\t\tfor _, f in self._headHairs do put(hairBatch, f.part, headBase * f.scaled) end\n\tend\n\tif fresh or moved(seen.body, bodyBase) then\n\t\tseen.body = bodyBase\n\t\tfor _, f in self._bodyHairs do put(hairBatch, f.part, bodyBase * f.scaled) end\n\tend\n\tfor index = 1, 2 do\n\t\tlocal pivot = if index == 1 then pivot1 else pivot2\n\t\tif fresh or moved(seen.palpHead[index], headBase) or moved(seen.pivot[index], pivot) then\n\t\t\tseen.palpHead[index], seen.pivot[index] = headBase, pivot\n\t\t\tfor _, f in self._palpHairs[index] do put(hairBatch, f.part, headBase * scaled(pivot * f.offset, g)) end\n\t\tend\n\tend\n\tif sizesDue or math.abs(breathScale - seen.breath) > SCALE_STEP or moved(seen.abdomen, abdomenBase) then\n\t\tseen.abdomen, seen.breath = abdomenBase, breathScale\n\t\tfor _, f in self._abdomenHairs do\n\t\t\tlocal p = abdomenAt + (f.pos - abdomenAt) * condition * breathScale\n\t\t\tput(hairBatch, f.part, abdomenBase * (f.rot + (if g == 1 then p else p * g)))\n\t\t\tif sizesDue then resize(f, f.size0 * g * condition) end\n\t\tend\n\tend\n\tif sizesDue then seen.sizeKey = condition end\n\tseen.epoch = epoch\n\n\tif fan then\n\t\tdrawFan(self, fan, abdomenBase, if dancing then display.fanOpen else 0, condition, bodyBatch)\n\tend\n\n\t-- Legs: planted feet stay put in the world; a leg too far from its rest spot steps, in alternating groups.\n\tlocal swinging = false\n\tfor _, leg in self._legs do\n\t\tswinging = swinging or leg.swing >= 0\n\tend\n\tif grounded and not swinging then\n\t\tlocal worst = STEP_ERROR * k\n\t\tfor i, leg in self._legs do\n\t\t\tif leg.planted then\n\t\t\t\tlocal err = (body:PointToWorldSpace(leg.rest) - leg.planted :: Vector3).Magnitude\n\t\t\t\tif err > worst then\n\t\t\t\t\tworst = err\n\t\t\t\t\tself._group = legGroup(self, i)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tlocal L = look.limbs\n\tlocal bandFraction = look.bandFraction\n\tlocal exact = self._exact\n\tlocal started = false\n\tfor i, leg in self._legs do\n\t\tlocal rest = body:PointToWorldSpace(leg.rest)\n\t\tif not grounded then\n\t\t\tleg.planted = nil\n\t\t\tleg.swing = -1\n   local free=Vector3.new(leg.side*.47*k,-.12*k,L.tipZ[leg.pair]*.72*g)\n   leg.foot=body:PointToWorldSpace(free)\n   leg.hangKnee, leg.hangAnkle = nil, nil\n   if self._hang>0 then\n    local knee,ankle,foot=self:_hangLeg(leg,body)\n    leg.hangKnee,leg.hangAnkle=knee,ankle\n    leg.foot=leg.foot:Lerp(foot,self._hang)\n   end\n\t\telse\n\t\t\tleg.hangKnee, leg.hangAnkle = nil, nil\n\t\t\tif leg.planted == nil then\n\t\t\t\tlocal hit = target(self, body, leg)\n\t\t\t\tleg.planted = if hit then hit.Position else nil\n\t\t\t\tleg.foot = if hit then hit.Position else rest + up * 0.16\n\t\t\t\tleg.swing = -1\n\t\t\tend\n\t\t\tlocal anchor = leg.planted\n\t\t\tif anchor then\n\t\t\t\tif leg.swing >= 0 then\n\t\t\t\t\tleg.swing = math.min(1, leg.swing + dt / (SWING_SECONDS * math.sqrt(k)))\n\t\t\t\t\tlocal s = leg.swing\n\t\t\t\t\tlocal smooth = s * s * (3 - 2 * s)\n\t\t\t\t\tleg.foot = leg.from:Lerp(anchor, smooth) + leg.up * math.sin(math.pi * s) * (STEP_HEIGHT * k)\n\t\t\t\t\tif leg.swing >= 1 then\n\t\t\t\t\t\tleg.swing = -1\n\t\t\t\t\t\tleg.foot = anchor\n\t\t\t\t\tend\n\t\t\t\telse\n\t\t\t\t\tleg.foot = anchor\n\t\t\t\t\tlocal err = (rest - anchor).Magnitude\n\t\t\t\t\tif err > STEP_ERROR * k and ((not swinging and legGroup(self, i) == self._group) or err > 0.60 * k) then\n\t\t\t\t\t\tlocal hit = target(self, body, leg)\n\t\t\t\t\t\tif hit and (anchor - hit.Position).Magnitude > 0.12 * k then\n\t\t\t\t\t\t\tleg.from = anchor\n\t\t\t\t\t\t\tleg.planted = hit.Position\n\t\t\t\t\t\t\tleg.up = hit.Normal\n\t\t\t\t\t\t\tleg.swing = 0\n\t\t\t\t\t\t\tstarted = true\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\tif body:PointToObjectSpace(leg.foot).Magnitude > 1.4 * k then\n\t\t\t\t\t\tleg.planted = nil\n\t\t\t\t\t\tleg.foot = rest\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tif started then\n\t\tself._group = 1 - self._group\n\tend\n\tlocal kneeUp = (if grounded then L.kneeLift else L.kneeLiftAir)*g\n\tfor index, leg in self._legs do\n\t\tlocal hip = prosoma:PointToWorldSpace(leg.hip)\n\t\tlocal foot = leg.foot\n  local rear = leg.pair >= 3\n  if not grounded and rear and push > 0 then\n   foot += body:VectorToWorldSpace(Vector3.new(leg.side*.05,-.25,.18)*k*push)\n  end\n\t\tlocal knee = hip:Lerp(foot, 0.48) + up * (if rear then kneeUp*(1-.7*push)+.035*k*load else kneeUp)\n\t\t-- A leg of the living motion (ROBLOX-87): pulled forward to be groomed, raised in an alarm, or reaching out in a tarantula's stretch. The planted foot bel