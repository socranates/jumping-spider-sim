        </Properties>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Lit</string>
            <string name="Source"><![CDATA[--!strict
-- The lighting, sky and screen effects (Data/Graphics): a soft warm sun picked by SunPick so that it shines in through the
-- window, Atmosphere haze for the view, a gentle bloom, grade and sun rays, clouds. Depth of field is off unless asked for.
-- Technology (Future) cannot be set from a script; the Rojo projects author it. Idempotent: effects are reused by name.
local Graphics = require(script.Parent.Parent.Data.Graphics)
local SunPick = require(script.Parent.SunPick)

local Lit = {}

export type Options = {
	sample: ((number, number) -> Vector3)?, -- the sun at (clock, latitude); default: ask the Lighting service
	depthOfField: boolean?, -- true adds the macro depth-of-field the client keeps focused on the spider
}

local L = Graphics.lighting

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- The child of `parent` with this name and class, made if missing (a wrong class under that name is replaced).
local function child(parent: Instance, className: string, name: string): Instance
	local found = parent:FindFirstChild(name)
	if found and found.ClassName == className then return found end
	if found then found:Destroy() end
	local made = Instance.new(className)
	made.Name = name
	made.Parent = parent
	return made
end

function Lit.apply(lighting: Lighting, terrain: Instance?, options: Options?): SunPick.Result
	local opts: Options = options or {}
	lighting.Brightness = L.brightness
	lighting.Ambient = rgb(L.ambient)
	lighting.OutdoorAmbient = rgb(L.outdoorAmbient)
	lighting.ColorShift_Top = rgb(L.colorShiftTop)
	lighting.EnvironmentDiffuseScale = L.environmentDiffuse
	lighting.EnvironmentSpecularScale = L.environmentSpecular
	lighting.ShadowSoftness = L.shadowSoftness
	lighting.ExposureCompensation = L.exposureCompensation
	lighting.GlobalShadows = true

	-- A sun that comes in through the window; if none can be found the old morning light stays.
	local sample = opts.sample or function(clock: number, latitude: number): Vector3
		lighting.GeographicLatitude = latitude
		lighting.ClockTime = clock
		return lighting:GetSunDirection()
	end
	local picked: SunPick.Result? = nil
	local ok, outcome = pcall(function(): SunPick.Result
		return SunPick.choose(sample, L.clockTime, L.latitude, Graphics.sun)
	end)
	if ok then picked = outcome :: any end
	local sun: SunPick.Result = picked or {
		ok = false, clock = L.clockTime, latitude = L.latitude, direction = Vector3.new(0, 1, 0),
		elevationDeg = 90, azimuthDeg = 0, reason = "the sun could not be sampled",
	}
	lighting.ClockTime = sun.clock
	lighting.GeographicLatitude = sun.latitude
	lighting:SetAttribute("SunPick", (if sun.ok then "ok: " else "fallback: ") .. sun.reason)

	local A = Graphics.atmosphere
	local atmosphere = child(lighting, "Atmosphere", "Atmosphere") :: Atmosphere
	atmosphere.Density = A.density
	atmosphere.Offset = A.offset
	atmosphere.Color = rgb(A.color)
	atmosphere.Decay = rgb(A.decay)
	atmosphere.Glare = A.glare
	atmosphere.Haze = A.haze

	local S = Graphics.sky
	local sky = child(lighting, "Sky", "Sky") :: Sky
	sky.SunAngularSize = S.sunAngularSize
	sky.MoonAngularSize = S.moonAngularSize
	sky.StarCount = S.starCount
	sky.CelestialBodiesShown = true

	local G = Graphics.grade
	local grade = child(lighting, "ColorCorrectionEffect", "Grade") :: ColorCorrectionEffect
	grade.Contrast = G.contrast
	grade.Saturation = G.saturation
	grade.Brightness = G.brightness
	grade.TintColor = rgb(G.tint)

	local B = Graphics.bloom
	local bloom = child(lighting, "BloomEffect", "Bloom") :: BloomEffect
	bloom.Intensity = B.intensity
	bloom.Size = B.size
	bloom.Threshold = B.threshold
	bloom:SetAttribute("FullOnly", true)

	local R = Graphics.sunRays
	local rays = child(lighting, "SunRaysEffect", "SunRays") :: SunRaysEffect
	rays.Intensity = R.intensity
	rays.Spread = R.spread
	rays:SetAttribute("FullOnly", true)

	local stale = lighting:FindFirstChild("MacroDOF")
	if opts.depthOfField then
		local D = Graphics.depthOfField
		local dof = child(lighting, "DepthOfFieldEffect", "MacroDOF") :: DepthOfFieldEffect
		dof.FarIntensity = D.far
		dof.NearIntensity = D.near
		dof.FocusDistance = D.focus
		dof.InFocusRadius = D.radius
	elseif stale then
		stale:Destroy()
	end

	if terrain then
		local C = Graphics.clouds
		local clouds = child(terrain, "Clouds", "Clouds") :: Clouds
		clouds.Cover = C.cover
		clouds.Density = C.density
		clouds.Color = rgb(C.color)
		clouds:SetAttribute("FullOnly", true)
	end
	return sun
end

return Lit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Materials</string>
            <string name="Source"><![CDATA[--!strict
-- Material names (as Data/Graphics spells them) to Roblox's Enum.Material, so the data stays plain text and a typo is caught by
-- tests/world.luau instead of showing up as a grey part in Studio. These are Roblox's built-in materials; with
-- MaterialService.Use2022Materials on (both Rojo projects set it) they carry their own PBR textures.
local Materials = {}

local MAP: { [string]: Enum.Material } = {
	Plastic = Enum.Material.Plastic, SmoothPlastic = Enum.Material.SmoothPlastic, Neon = Enum.Material.Neon,
	Wood = Enum.Material.Wood, WoodPlanks = Enum.Material.WoodPlanks, Plaster = Enum.Material.Plaster,
	Concrete = Enum.Material.Concrete, Brick = Enum.Material.Brick, Glass = Enum.Material.Glass,
	Ground = Enum.Material.Ground, Grass = Enum.Material.Grass, LeafyGrass = Enum.Material.LeafyGrass,
	Fabric = Enum.Material.Fabric, Cardboard = Enum.Material.Cardboard, Sand = Enum.Material.Sand,
	Slate = Enum.Material.Slate, Pebble = Enum.Material.Pebble, Rock = Enum.Material.Rock, Mud = Enum.Material.Mud,
	Limestone = Enum.Material.Limestone, Marble = Enum.Material.Marble, Metal = Enum.Material.Metal,
}

function Materials.known(name: string): boolean
	return MAP[name] ~= nil
end

function Materials.get(name: string): Enum.Material
	return MAP[name] or Enum.Material.SmoothPlastic
end

function Materials.names(): { string }
	local out = {}
	for name in MAP do table.insert(out, name) end
	table.sort(out)
	return out
end

return Materials
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Scenery</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the drawn world from Data/Graphics: the sill's physical pieces (looks only), and a "Decor" folder with the window wall,
-- glass and trim, the view out of the window, the dust, the small details and the light shafts. Gameplay never reads any of
-- the decor: every decor part is CanQuery = false, CanCollide = false, CanTouch = false, so the spider's rays, the camera's
-- casts and the jump planner see only the physical pieces. Parts and emitters that only the full tier keeps carry the
-- attribute FullOnly, which Client/WorldDetail removes on phones and tablets.
local Graphics = require(script.Parent.Parent.Data.Graphics)
local Surfaces = require(script.Parent.Parent.Data.Surfaces)
local Layout = require(script.Parent.WindowsillLayout)
local Materials = require(script.Parent.Materials)

local Scenery = {}

local W = Graphics.window
local M = Graphics.materials

local function hex(s: string): Color3
	return Color3.fromHex(s)
end

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- A drawn-only part: anchored, nothing collides with it, no ray sees it.
local function drawn(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: string): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = Materials.get(material)
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function piece(id: string): Layout.Piece
	for _, p in Layout.PIECES do
		if p.id == id then return p end
	end
	error("no piece " .. id)
end

-- ---------------------------------------------------------------- the physical sill
-- `wallDrawn`: false when the drawn window wall could not be built, so the solid back wall stays visible instead of leaving a hole.
function Scenery.sill(wallDrawn: boolean?): Folder
	local sill = Instance.new("Folder")
	sill.Name = "Windowsill"
	sill:SetAttribute("ContentRevision", Layout.CONTENT_REVISION)
	for _, spec in Layout.PIECES do
		assert(Surfaces[spec.profile], "unknown surface profile " .. spec.profile)
		local p = Instance.new("Part")
		p.Name = spec.id
		p.Anchored = true
		p.Size = spec.hi - spec.lo
		p.Position = (spec.lo + spec.hi) * 0.5
		p.Color = spec.color
		p.Material = Materials.get(M.pieces[spec.id] or M.fallback)
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p:SetAttribute("SurfaceId", spec.id)
		p:SetAttribute("ProfileId", spec.profile)
		if spec.id == W.hidden and wallDrawn ~= false then
			-- still solid and climbable; Scenery.window draws the wall in its place, with a see-through opening
			p.Transparency = 1
			p.CastShadow = false
		end
		p.Parent = sill
	end
	return sill
end

-- ---------------------------------------------------------------- the window wall
function Scenery.window(parent: Instance): Folder
	local wall = folder(parent, "Wall")
	local back = piece(W.hidden)
	local plane = back.hi.Z -- the climbable face
	local slabFront = plane - W.slabGap
	local zMid = (slabFront + back.lo.Z) / 2
	local depth = slabFront - back.lo.Z
	local plaster, wood = hex(W.wallColor), hex(W.trimColor)
	local function slab(name: string, x0: number, x1: number, y0: number, y1: number)
		drawn(wall, name, Vector3.new(x1 - x0, y1 - y0, depth), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, zMid), plaster, M.wall)
	end
	slab("Apron", back.lo.X, back.hi.X, back.lo.Y, W.bottom)
	slab("Header", back.lo.X, back.hi.X, W.top, back.hi.Y)
	slab("StileWest", back.lo.X, W.left, W.bottom, W.top)
	slab("StileEast", W.right, back.hi.X, W.bottom, W.top)
	local function bar(name: string, x0: number, x1: number, y0: number, y1: number)
		drawn(wall, name, Vector3.new(x1 - x0, y1 - y0, W.trimDepth), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, plane - W.trimDepth / 2), wood, M.trim)
	end
	bar("TrimBottom", W.left, W.right, W.bottom, W.bottom + W.trimWidth)
	bar("TrimTop", W.left, W.right, W.top - W.trimWidth, W.top)
	bar("TrimWest", W.left, W.left + W.trimWidth, W.bottom, W.top)
	bar("TrimEast", W.right - W.trimWidth, W.right, W.bottom, W.top)
	for i, x in W.mullions do
		bar("Mullion" .. i, x - W.mullionWidth / 2, x + W.mullionWidth / 2, W.bottom, W.top)
	end
	local g = W.glass
	local glass = drawn(wall, "Glass", Vector3.new(W.right - W.left, W.top - W.bottom, g.thickness),
		CFrame.new(0, (W.bottom + W.top) / 2, plane - g.setback - g.thickness / 2), hex(g.color), M.glass)
	glass.Transparency = g.transparency
	glass.Reflectance = g.reflectance
	glass.CastShadow = false
	return wall
end

-- ---------------------------------------------------------------- dust motes in the window light
function Scenery.dust(parent: Instance): Part
	local D = Graphics.dust
	local volume = drawn(parent, "DustVolume", D.size, CFrame.new(D.at), Color3.new(1, 1, 1), "SmoothPlastic")
	volume.Transparency = 1
	volume.CastShadow = false
	local motes = Instance.new("ParticleEmitter")
	motes.Name = "Motes"
	motes.Texture = D.texture
	motes.Rate = D.rate
	motes.Lifetime = NumberRange.new(D.lifetime[1], D.lifetime[2])
	motes.Speed = NumberRange.new(D.speed[1], D.speed[2])
	motes.SpreadAngle = Vector2.new(180, 180)
	motes.Rotation = NumberRange.new(0, 360)
	motes.RotSpeed = NumberRange.new(-20, 20)
	motes.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, D.particle[1]),
		NumberSequenceKeypoint.new(0.5, D.particle[2]),
		NumberSequenceKeypoint.new(1, D.particle[1]),
	})
	motes.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, D.transparency),
		NumberSequenceKeypoint.new(0.8, D.transparency),
		NumberSequenceKeypoint.new(1, 1),
	})
	motes.LightEmission = D.lightEmission
	motes.LightInfluence = D.lightInfluence
	motes.Color = ColorSequence.new(hex(D.color))
	motes.Drag = 0.5
	motes.Acceleration = Vector3.new(0, 0.01, 0)
	motes.Shape = Enum.ParticleEmitterShape.Box
	motes.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	motes.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	motes:SetAttribute("Dust", true) -- WorldDetail thins it out in the low tier
	motes.Parent = volume
	return volume
end

-- ---------------------------------------------------------------- the view out of the window
-- Where an item that should appear at (u, v) on the glass, `depth` beyond it, really goes, and how much bigger it is than
-- it looks. The reference eye is the camera's usual spot (Graphics.view.eye).
function Scenery.viewPosition(u: number, v: number, depth: number): (Vector3, number)
	local eye = Graphics.view.eye
	local plane = piece(W.hidden).hi.Z
	local reach = eye.Z - plane
	local k = (reach + depth) / reach
	return Vector3.new(eye.X + (u - eye.X) * k, eye.Y + (v - eye.Y) * k, plane - depth), k
end

function Scenery.view(parent: Instance): Folder
	local V = Graphics.view
	local view = folder(parent, "View")
	local ground = drawn(view, "Ground", Vector3.new(V.ground.size, 2, V.ground.size),
		CFrame.new(0, V.ground.y - 1, -V.ground.size * 0.5 + 300), hex(V.ground.color), M.ground)
	ground.CastShadow = false
	for _, item in V.items do
		local at, k = Scenery.viewPosition(item.u, item.v, item.depth)
		local t = (item.t or item.w) * k
		local part: Part
		if item.kind == "ball" then
			part = drawn(view, item.id, Vector3.one * item.w * k, CFrame.new(at), hex(item.color), M.view)
			part.Shape = Enum.PartType.Ball
		elseif item.kind == "roof" then
			local side = item.w * k / math.sqrt(2)
			part = drawn(view, item.id, Vector3.new(side, side, t), CFrame.new(at) * CFrame.Angles(0, 0, math.rad(45)), hex(item.color), M.view)
		else
			part = drawn(view, item.id, Vector3.new(item.w * k, (item.h or item.w) * k, t), CFrame.new(at), hex(item.color), M.view)
		end
		part.CastShadow = false
		if item.full then part:SetAttribute("FullOnly", true) end
	end
	return view
end

-- ---------------------------------------------------------------- paint chips, cracks and a crumb (full tier)
function Scenery.details(parent: Instance): Folder
	local D = Graphics.details
	local details = folder(parent, "Details")
	details:SetAttribute("FullOnly", true)
	for i, c in D.chips do
		local chip = drawn(details, "PaintChip" .. i, Vector3.new(c.w, D.chipThickness, c.d),
			CFrame.new(c.x, D.chipThickness / 2 + 0.001, c.z) * CFrame.Angles(0, math.rad(c.turn), 0), hex(c.color), M.chip)
		chip.CastShadow = false
	end
	for n, line in D.cracks do
		for i = 1, #line - 1 do
			local a, b = line[i], line[i + 1]
			local dx, dz = b[1] - a[1], b[2] - a[2]
			local length = math.sqrt(dx * dx + dz * dz)
			local seg = drawn(details, `Crack{n}_{i}`, Vector3.new(D.crackWidth, D.crackHeight, length + D.crackWidth * 0.6),
				CFrame.new((a[1] + b[1]) / 2, D.crackHeight / 2 + 0.001, (a[2] + b[2]) / 2) * CFrame.Angles(0, math.atan2(dx, dz), 0), hex(D.crackColor), M.crack)
			seg.CastShadow = false
		end
	end
	for i, c in D.crumbs do
		drawn(details, "Crumb" .. i, Vector3.new(c.sx, c.sy, c.sz), CFrame.new(c.x, c.y, c.z) * CFrame.Angles(0, math.rad(c.turn), 0), hex(c.color), M.crumb)
	end
	return details
end

-- ---------------------------------------------------------------- soft shafts of light from the window (full tier)
-- `sun`: the unit vector toward the sun. Nothing is built if the sun is not behind the window and above the horizon.
function Scenery.shafts(parent: Instance, sun: Vector3): Folder?
	local S = Graphics.shafts
	if sun.Y < 0.15 or sun.Z > -0.05 then return nil end
	local shafts = folder(parent, "Shafts")
	shafts:SetAttribute("FullOnly", true)
	local plane = piece(W.hidden).hi.Z
	for i, x in S.x do
		local start = Vector3.new(x, S.startY, plane - 0.05)
		local stop = start - sun * ((start.Y - 0.05) / sun.Y) -- along the sun's rays down to just above the floor
		local anchor = drawn(shafts, "ShaftAnchor" .. i, Vector3.one * 0.1, CFrame.new(start), Color3.new(1, 1, 1), "SmoothPlastic")
		anchor.Transparency = 1
		anchor.CastShadow = false
		local a0 = Instance.new("Attachment")
		a0.Name = "Start"
		a0.Parent = anchor
		local a1 = Instance.new("Attachment")
		a1.Name = "End"
		a1.Position = anchor.CFrame:PointToObjectSpace(stop)
		a1.Parent = anchor
		for j, layer in S.layers do
			local beam = Instance.new("Beam")
			beam.Name = `Shaft{i}_{j}`
			beam.Attachment0 = a0
			beam.Attachment1 = a1
			beam.Width0 = layer[1]
			beam.Width1 = layer[1] * S.grow
			beam.Transparency = NumberSequence.new(layer[2])
			beam.Color = ColorSequence.new(hex(S.color))
			beam.LightEmission = S.lightEmission
			beam.LightInfluence = 0
			beam.FaceCamera = true
			beam.Segments = 1
			beam.Parent = anchor
		end
	end
	return shafts
end

-- ---------------------------------------------------------------- everything drawn that is not the sill
-- `sun`: the unit vector toward the sun (Lit.apply's result), for the shafts; nil builds none.
-- The looks are best effort: a piece that fails (nothing here has run in Roblox Studio yet) is warned about and left out, and
-- the rest is kept. The wall and the old decor entries are not optional: if they fail, Scenery.decor fails and the server
-- keeps the plain back wall (Server/Main).
local function attempt(what: string, build: () -> unknown)
	local ok, err = pcall(build)
	if not ok then warn(`[Windowsill] decor: {what} failed: {tostring(err)}`) end
end

function Scenery.decor(sun: Vector3?): Folder
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	for _, d in Layout.DECOR do
		if not W.replaces[d.id] then
			local p = drawn(decor, d.id, d.size, CFrame.new(d.at), d.color, if d.id == "soil" then M.soil else "SmoothPlastic")
			p.Transparency = d.transparency or 0
		end
	end
	Scenery.window(decor)
	attempt("dust", function() return Scenery.dust(decor) end)
	attempt("view", function() return Scenery.view(decor) end)
	attempt("details", function() return Scenery.details(decor) end)
	if sun then attempt("shafts", function() return Scenery.shafts(decor, sun) end) end
	return decor
end

return Scenery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">SunPick</string>
            <string name="Source"><![CDATA[--!strict
-- Finds a sun that shines in through the window: behind the back wall (-Z), standing between a low and a middling height,
-- turned a little to one side so the patch of light and the mullions' shadows fall across the sill diagonally.
-- Which way Roblox's sun travels for a given ClockTime and GeographicLatitude is not something this code assumes: it asks
-- (`sample`), scans the day for both signs of the latitude, and takes the best match. Pure apart from `sample`, so
-- tests/world.luau drives it with invented suns.

local SunPick = {}

export type Target = {
	elevationDeg: number, minElevationDeg: number, maxElevationDeg: number,
	azimuthDeg: number, maxAzimuthDeg: number,
	clockFrom: number, clockTo: number, clockStep: number,
}
export type Result = {
	ok: boolean,
	clock: number, latitude: number,
	direction: Vector3, -- unit vector from the world toward the sun
	elevationDeg: number, azimuthDeg: number,
	reason: string,
}

-- Height above the horizon and angle from -Z (0 = straight out of the window, 90 = along the wall), in degrees.
function SunPick.angles(direction: Vector3): (number, number)
	local d = direction.Unit
	local elevation = math.deg(math.asin(math.clamp(d.Y, -1, 1)))
	local azimuth = math.deg(math.atan2(math.abs(d.X), -d.Z))
	return elevation, azimuth
end

local function result(ok: boolean, clock: number, latitude: number, direction: Vector3, reason: string): Result
	local elevation, azimuth = SunPick.angles(direction)
	return { ok = ok, clock = clock, latitude = latitude, direction = direction.Unit, elevationDeg = elevation, azimuthDeg = azimuth, reason = reason }
end

-- sample(clock, latitude): the unit vector toward the sun at that time. baseClock and baseLatitude are what to fall back on.
function SunPick.choose(sample: (number, number) -> Vector3, baseClock: number, baseLatitude: number, target: Target): Result
	local fallback = sample(baseClock, baseLatitude)
	-- A sampler that ignores the clock would make every time look the same; do not pretend to have chosen.
	if (sample(6, baseLatitude) - sample(12, baseLatitude)).Magnitude < 1e-6 then
		return result(false, baseClock, baseLatitude, fallback, "the sun direction does not change with the clock")
	end
	local latitudes = { baseLatitude }
	if baseLatitude ~= 0 then table.insert(latitudes, -baseLatitude) end
	local best: Result? = nil
	local bestCost = math.huge
	for _, latitude in latitudes do
		local steps = math.floor((target.clockTo - target.clockFrom) / target.clockStep + 0.5)
		for i = 0, steps do
			local clock = target.clockFrom + i * target.clockStep
			local direction = sample(clock, latitude)
			if direction.Magnitude > 1e-6 and direction.Z < 0 then
				local elevation, azimuth = SunPick.angles(direction)
				if elevation >= target.minElevationDeg and elevation <= target.maxElevationDeg and azimuth <= target.maxAzimuthDeg then
					local cost = ((elevation - target.elevationDeg) / 10) ^ 2 + ((azimuth - target.azimuthDeg) / 20) ^ 2 + 0.001 * math.abs(clock - 10)
					if cost < bestCost then
						bestCost = cost
						best = result(true, clock, latitude, direction, `clock {clock}, latitude {latitude}`)
					end
				end
			end
		end
	end
	if best then return best end
	return result(false, baseClock, baseLatitude, fallback, "no time of day puts the sun behind the window")
end

return SunPick
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">TestTarget</string>
            <string name="Source"><![CDATA[--!strict
-- Godot test_target.gd: a labelled prop, never prey. Path stepping is independent of rendering.
local Target = {}
Target.__index = Target
function Target.new(path: {Vector3}): any
	assert(#path >= 2)
	return setmetatable({path=path, position=path[1], velocity=Vector3.zero, index=2, direction=1,
		pauseLeft=0, speed=0.8, pauseS=1.2, enabled=true, frozen=false, id="test_target", radius=0.45}, Target)
end
function Target.step(self: any, dt: number)
	self.velocity = Vector3.zero
	if not self.enabled or self.frozen then return end
	if self.pauseLeft > 0 then self.pauseLeft -= dt; return end
	local before = self.position
	local delta = self.path[self.index] - before
	if delta.Magnitude <= self.speed * dt then
		self.position = self.path[self.index]
		local nextIndex = self.index + self.direction
		if nextIndex < 1 or nextIndex > #self.path then
			self.direction = -self.direction
			nextIndex = self.index + self.direction
			self.pauseLeft = self.pauseS
		end
		self.index = nextIndex
	else self.position += delta.Unit * self.speed * dt end
	self.velocity = (self.position - before) / dt
end
function Target.percept(self: any): any
	if not self.enabled then return nil end
	return {id=self.id, position=self.position, radius=self.radius, velocity=self.velocity, maxCategory="fly_like_prey"}
end
return Target
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">WindowsillLayout</string>
            <string name="Source"><![CDATA[--!strict
-- The windowsill of scripts/habitat/windowsill.gd ("windowsill-v1"), box for box. Coordinates are studs = Godot WU = cm,
-- in the same right-handed, Y-up, -Z-forward frame, so every number is copied unchanged.

export type Piece = {
	id: string,
	lo: Vector3,
	hi: Vector3,
	profile: string,
	color: Color3,
}

export type Decor = {
	id: string,
	size: Vector3,
	at: Vector3,
	color: Color3,
	transparency: number?,
}

local function hex(s: string): Color3
	return Color3.fromHex(s)
end

local Layout = {}

Layout.CONTENT_REVISION = "windowsill-v1"
Layout.SPAWN = Vector3.new(-22.0, 0.0, 6.0)
Layout.SPAWN_HEADING = Vector3.new(1, 0, 0) -- Basis(UP, -90 deg) * forward
Layout.PLAY_BOUNDS_MIN = Vector3.new(-33, -5, -16)
Layout.PLAY_BOUNDS_MAX = Vector3.new(33, 35, 16)
Layout.RETREAT_MIN = Vector3.new(-27.8, 0.0, 3.0)
Layout.RETREAT_MAX = Vector3.new(-23.3, 1.5, 9.0)

local function v(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end

Layout.PIECES = {
	{ id = "sill_floor", lo = v(-30, -1, -12.5), hi = v(30, 0, 12.5), profile = "painted_wood_dry", color = hex("b6a082") },
	{ id = "back_frame", lo = v(-31, 0, -13.5), hi = v(31, 14, -12.5), profile = "bare_wood_rough", color = hex("ded7c3") },
	{ id = "left_frame", lo = v(-31, 0, -12.5), hi = v(-30, 14, 12.5), profile = "bare_wood_rough", color = hex("ded7c3") },
	{ id = "right_frame", lo = v(30, 0, -12.5), hi = v(31, 14, 12.5), profile = "bare_wood_rough", color = hex("ded7c3") },
	{ id = "front_lip", lo = v(-30, 0, 12.0), hi = v(30, 0.7, 12.5), profile = "bare_wood_rough", color = hex("8b7256") },
	{ id = "planter", lo = v(3, 0, -8), hi = v(17, 4, 0), profile = "brick_rough", color = hex("9f6650") },
	{ id = "planter_rim", lo = v(2.5, 4, -8.5), hi = v(17.5, 4.6, 0.5), profile = "brick_rough", color = hex("ba8264") },
	{ id = "leaf_west", lo = v(-18, 3.8, -4), hi = v(-12, 4.2, 1), profile = "leaf_dry_prototype", color = hex("607952") },
	{ id = "leaf_middle", lo = v(-4, 3.8, -4), hi = v(2, 4.2, 1), profile = "leaf_dry_prototype", color = hex("738a59") },
	{ id = "leaf_east", lo = v(18, 5.0, -6), hi = v(25, 5.4, 0), profile = "leaf_dry_prototype", color = hex("829960") },
	{ id = "stem_west", lo = v(-16.5, 0, -2), hi = v(-15.5, 3.8, -1), profile = "leaf_dry_prototype", color = hex("536b43") },
	{ id = "stem_middle", lo = v(-2.5, 0, -2), hi = v(-1.5, 3.8, -1), profile = "leaf_dry_prototype", color = hex("536b43") },
	{ id = "stem_east", lo = v(21, 0, -3.5), hi = v(22, 5, -2.5), profile = "leaf_dry_prototype", color = hex("536b43") },
	{ id = "leaf_tip", lo = v(25.6, 5.15, -4.2), hi = v(28.4, 5.35, -1.8), profile = "leaf_dry_prototype", color = hex("cdb27a") },
	{ id = "crevice_back", lo = v(-29, 0, 2), hi = v(-28, 3, 10), profile = "bare_wood_rough", color = hex("655640") },
	{ id = "crevice_roof", lo = v(-29, 2.6, 2), hi = v(-23, 3, 10), profile = "bare_wood_rough", color = hex("8b775a") },
	{ id = "crevice_north", lo = v(-29, 0, 2), hi = v(-23, 2.6, 2.6), profile = "bare_wood_rough", color = hex("786448") },
	{ id = "crevice_south", lo = v(-29, 0, 9.4), hi = v(-23, 2.6, 10), profile = "bare_wood_rough", color = hex("786448") },
} :: { Piece }

local decor: { Decor } = {
	{ id = "soil", size = v(12, 0.01, 6), at = v(10, 4.61, -4), color = hex("665644") },
	{ id = "window_glass", size = v(55, 10, 0.04), at = v(0, 8, -12.44), color = hex("a9c2c1"), transparency = 0.55 },
	{ id = "mullion_w", size = v(0.7, 12, 0.1), at = v(-10, 8, -12.35), color = hex("e2dbc7") },
	{ id = "mullion_e", size = v(0.7, 12, 0.1), at = v(10, 8, -12.35), color = hex("e2dbc7") },
}
for i = 0, 6 do
	table.insert(decor, { id = "silk_" .. i, size = v(4.6, 0.012, 0.045), at = v(-25.5, 0.025, 3.3 + i * 0.85), color = hex("ddd9bf") })
end
Layout.DECOR = decor

return table.freeze(Layout)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Movement</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">CameraMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pure camera and stick math, ported from the frozen Godot reference (c87ce00):
--   scripts/movement/boom_math.gd    (orbit basis, boom recovery, eased offsets, pitch pick, smooth damp)
--   scripts/movement/surface_input.gd (camera-relative walking on floors, walls and undersides)
--   scripts/movement/camera_rig.gd   (aim free-look clamp, spider-eye gaze clamp, recenter yaw)
-- Vector3 only, no Instances, so tests/run.luau checks it against values exported from Godot itself.
-- Conventions match Godot and Roblox alike: right-handed, -Z forward, yaw about world up,
-- elevation positive puts the camera above the pivot.

local CameraMath = {}

CameraMath.PIVOT_HEIGHT = 0.45
CameraMath.BOOM_RADIUS = 0.15
CameraMath.DEFAULT_ELEVATION_DEG = 18.0
CameraMath.MIN_ELEVATION_DEG = -20.0
CameraMath.MAX_ELEVATION_DEG = 80.0
CameraMath.MOUSE_DEG_PER_PIXEL = 0.1
CameraMath.STICK_DEG_PER_SECOND = 150.0
CameraMath.RECOVER_SPEED = 6.0
CameraMath.RECENTER_SECONDS = 0.25
CameraMath.BODY_HIDE_LENGTH = 0.8
CameraMath.COMFORT_BOOM = 2.5
CameraMath.AUTO_PITCH_STEP_DEG = 10.0
CameraMath.MIN_AUTO_ELEVATION_DEG = -45.0
CameraMath.AUTO_PITCH_IN_SECONDS = 0.08
CameraMath.AUTO_PITCH_OUT_SECONDS = 0.35
CameraMath.AIM_PITCH_MIN_DEG = -20.0
CameraMath.AIM_PITCH_MAX_DEG = 50.0
CameraMath.AIM_VIEW_LIMIT_DEG = 85.0
CameraMath.AIM_RETURN_SECONDS = 0.25
CameraMath.EYE_FOV_DEG = 80.0
CameraMath.EYE_AHEAD = 0.53
CameraMath.EYE_HEIGHT = 0.09
CameraMath.EYE_PITCH_LIMIT_DEG = 80.0
CameraMath.EYE_ROLL_DEG_S = 240.0
CameraMath.PRINCIPAL_SCAN_DEG = 30.0
CameraMath.EYE_SETTLE_DEG = 4.0
CameraMath.FOV_DEG = 65.0
CameraMath.CAMERA_DISTANCE = 5.0

local SETTLE = 2e-4
local TIE = 1e-3
local FLOOR_BLEND_START = 0.5
local FLOOR_BLEND_END = 0.8660254

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function smoothstep(a: number, b: number, x: number): number
	if a == b then
		return if x < a then 0 else 1
	end
	local t = math.clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end
CameraMath.smoothstep = smoothstep

local function dirOn(v: Vector3, n: Vector3): Vector3
	local t = v - n * v:Dot(n)
	local length = t.Magnitude
	return if length > 1e-6 then t / length else Vector3.new(0, 0, 0)
end

-- BoomMath.next_length: a shorter allowed length is taken at once; growth is rate limited.
function CameraMath.nextLength(current: number, allowed: number, desired: number, recoverSpeed: number, dt: number): number
	if not (finite(current) and finite(allowed) and finite(desired) and finite(recoverSpeed) and finite(dt)) then
		return 0
	end
	local target = math.max(0, math.min(allowed, desired))
	if target <= current then
		return target
	end
	return math.min(current + math.max(recoverSpeed, 0) * math.max(dt, 0), target)
end

-- BoomMath.ease_offset: exponential ease, faster away from zero than back toward it.
function CameraMath.easeOffset(current: number, target: number, dt: number, inSeconds: number, outSeconds: number): number
	if not (finite(current) and finite(target) and finite(dt) and finite(inSeconds) and finite(outSeconds)) then
		return 0
	end
	local seconds = math.max(if math.abs(target) >= math.abs(current) then inSeconds else outSeconds, 1e-4)
	local nextValue = current + (target - current) * (1 - math.exp(-math.max(dt, 0) / seconds))
	return if math.abs(target - nextValue) < SETTLE then target else nextValue
end

-- BoomMath.smooth_damp: a critically damped approach of current to target (arrives without overshoot, gentle at both
-- ends); smoothTime is about the time it takes. Returns the next value and velocity; it lands exactly on the target once
-- within SETTLE and nearly still. Non-finite input returns 0, 0.
function CameraMath.smoothDamp(current: number, target: number, velocity: number, smoothTime: number, dt: number): (number, number)
	if not (finite(current) and finite(target) and finite(velocity) and finite(smoothTime) and finite(dt)) then
		return 0, 0
	end
	local omega = 2 / math.max(smoothTime, 1e-4)
	local x = omega * math.max(dt, 0)
	local damp = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)
	local change = current - target
	local temp = (velocity + omega * change) * dt
	local nextVelocity = (velocity - omega * temp) * damp
	local nextValue = target + (change + temp) * damp
	if (target - current > 0) == (nextValue > target) then
		return target, 0
	end
	if math.abs(target - nextValue) < SETTLE and math.abs(nextVelocity) < 1e-3 then
		return target, 0
	end
	return nextValue, nextVelocity
end

-- BoomMath.pick_pitch_offset: the first comfortable boom, else the longest.
function CameraMath.pickPitchOffset(offsets: { number }, lengths: { number }, comfort: number): number
	if #offsets == 0 or #offsets ~= #lengths or not finite(comfort) then
		return 0
	end
	local best = 1
	for i = 1, #offsets do
		if lengths[i] >= comfort then
			return offsets[i]
		end
		if lengths[i] > lengths[best] + TIE then
			best = i
		end
	end
	return offsets[best]
end

-- BoomMath.back_direction: unit vector from the pivot toward the camera.
function CameraMath.backDirection(yaw: number, elevation: number): Vector3
	local ce = math.cos(elevation)
	return Vector3.new(math.sin(yaw) * ce, math.sin(elevation), math.cos(yaw) * ce)
end

-- The orbit camera's right and up vectors (SurfaceInput.camera_basis x and y columns).
function CameraMath.cameraRight(yaw: number, _elevation: number): Vector3
	return Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
end
function CameraMath.cameraUp(yaw: number, elevation: number): Vector3
	local se = math.sin(elevation)
	return Vector3.new(-se * math.sin(yaw), math.cos(elevation), -se * math.cos(yaw))
end

-- SurfaceInput.tangent_axes: camera-relative right and forward on the plane with normal n.
function CameraMath.tangentAxes(yaw: number, elevation: number, n: Vector3): (Vector3, Vector3)
	local normal = if n.Magnitude > 1e-5 then n.Unit else Vector3.new(0, 1, 0)
	local camRight = CameraMath.cameraRight(yaw, elevation)
	local camUp = CameraMath.cameraUp(yaw, elevation)
	local flatForward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local pf = dirOn(flatForward, normal)
	local pu = dirOn(camUp, normal)
	local w = smoothstep(FLOOR_BLEND_START, FLOOR_BLEND_END, math.abs(normal.Y))
	local forward = pf * w + pu * (1 - w)
	if forward:Dot(forward) < 1e-6 then
		local pr = dirOn(camRight, normal)
		if pr.Magnitude == 0 then
			pr = dirOn(Vector3.new(1, 0, 0), normal)
		end
		forward = normal:Cross(pr)
	end
	forward = dirOn(forward, normal)
	local right = forward:Cross(normal)
	right = if right.Magnitude > 1e-9 then right.Unit else right
	if right:Dot(camRight) < 0 then
		right = -right
	end
	return right, forward
end

-- SurfaceInput.map_stick: x right, y forward, length kept (at most 1).
function CameraMath.mapStick(x: number, y: number, yaw: number, elevation: number, n: Vector3): Vector3
	local length = math.sqrt(x * x + y * y)
	if not finite(length) or length < 1e-6 then
		return Vector3.new(0, 0, 0)
	end
	if length > 1 then
		x, y = x / length, y / length
	end
	local right, forward = CameraMath.tangentAxes(yaw, elevation, n)
	return right * x + forward * y
end

-- Spider-eye walking: forward is the gaze laid on the surface, right is its right on it.
function CameraMath.mapStickEye(x: number, y: number, gaze: Vector3, bodyForward: Vector3, n: Vector3): Vector3
	local length = math.sqrt(x * x + y * y)
	if not finite(length) or length < 1e-6 then
		return Vector3.new(0, 0, 0)
	end
	if length > 1 then
		x, y = x / length, y / length
	end
	local forward = gaze - n * gaze:Dot(n)
	if forward:Dot(forward) < 1e-6 then
		forward = bodyForward - n * bodyForward:Dot(n)
	end
	if forward:Dot(forward) < 1e-6 then
		return Vector3.new(0, 0, 0)
	end
	forward = forward.Unit
	local right = forward:Cross(n).Unit
	return right * x + forward * y
end

-- camera_rig._clamp_aim_pitch: the aim free-look range, and the whole view short of straight up or down.
function CameraMath.clampAimPitch(value: number, elevation: number): number
	local limit = math.rad(CameraMath.AIM_VIEW_LIMIT_DEG)
	local low = math.max(math.rad(CameraMath.AIM_PITCH_MIN_DEG), elevation - limit)
	local high = math.min(math.rad(CameraMath.AIM_PITCH_MAX_DEG), elevation + limit)
	return math.clamp(value, low, math.max(low, high))
end

-- camera_rig._effective_elevation: the player's pitch plus the auto-pitch, inside the automatic range.
function CameraMath.effectiveElevation(elevation: number, offset: number): number
	local low = math.min(elevation, math.rad(CameraMath.MIN_AUTO_ELEVATION_DEG))
	local high = math.max(elevation, math.rad(CameraMath.MAX_ELEVATION_DEG))
	return math.clamp(elevation + offset, low, high)
end

-- The yaw whose flat forward (-sin, 0, -cos) points along v.
function CameraMath.yawOf(v: Vector3): number
	return math.atan2(-v.X, -v.Z)
end

-- SpiderMotor.get_recenter_yaw: behind the heading on floors and undersides, toward the surface on walls.
function CameraMath.recenterYaw(heading: Vector3, visualUp: Vector3, fallback: number): number
	local w = visualUp.Y * visualUp.Y
	local v = Vector3.new(heading.X, 0, heading.Z) * w + Vector3.new(-visualUp.X, 0, -visualUp.Z) * (1 - w)
	if v.Magnitude < 1e-3 then
		return fallback
	end
	return math.atan2(-v.X, -v.Z)
end

local function anyPerpendicular(v: Vector3): Vector3
	local other = if math.abs(v.Y) < 0.9 then Vector3.new(0, 1, 0) else Vector3.new(1, 0, 0)
	return v:Cross(other).Unit
end

-- camera_rig._clamp_gaze: unit, and at least EYE_PITCH_LIMIT_DEG from the surface normal either way.
function CameraMath.clampGaze(g: Vector3, up: Vector3, bodyForward: Vector3): Vector3
	if not (finite(g.X) and finite(g.Y) and finite(g.Z)) or g:Dot(g) < 1e-10 then
		g = bodyForward
	end
	g = g.Unit
	local tangent = g - up * g:Dot(up)
	if tangent:Dot(tangent) < 1e-8 then
		tangent = bodyForward - up * bodyForward:Dot(up)
		if tangent:Dot(tangent) < 1e-8 then
			tangent = anyPerpendicular(up)
		end
	end
	tangent = tangent.Unit
	local limit = math.rad(CameraMath.EYE_PITCH_LIMIT_DEG)
	local elev = math.clamp(math.asin(math.clamp(g:Dot(up), -1, 1)), -limit, limit)
	return (tangent * math.cos(elev) + up * math.sin(elev)).Unit
end

-- Rodrigues rotation of v about unit axis k by angle a (right-handed).
function CameraMath.rotate(v: Vector3, k: Vector3, a: number): Vector3
	local c, s = math.cos(a), math.sin(a)
	return v * c + k:Cross(v) * s + k * (k:Dot(v) * (1 - c))
end

-- camera_rig._look_eye (no level-horizon switch): yaw about the view's up (positive looks right),
-- pitch about the view's right (positive looks down).
function CameraMath.lookEye(gaze: Vector3, up: Vector3, yawRad: number, pitchRad: number, bodyForward: Vector3): Vector3
	local g = CameraMath.rotate(gaze, up, -yawRad)
	local right = g:Cross(up)
	if right:Dot(right) > 1e-10 then
		g = CameraMath.rotate(g, right.Unit, -pitchRad)
	end
	return CameraMath.clampGaze(g, up, bodyForward)
end

return CameraMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">FocusState</string>
            <string name="Source"><![CDATA[--!strict
-- D-041: toggle is optional, grounded only, and Cancel belongs to other actions first.
local Focus = {}
Focus.__index = Focus
function Focus.new(): any return setmetatable({latched=false}, Focus) end
function Focus.press(self: any, toggle: boolean, grounded: boolean)
	if toggle and grounded then self.latched = not self.latched end
end
function Focus.active(self: any, held: boolean, toggle: boolean, grounded: boolean): boolean
	if not grounded or not toggle then self.latched = false end
	return grounded and (if toggle then self.latched else held)
end
function Focus.cancel(self: any, busy: boolean)
	if not busy then self.latched = false end
end
function Focus.clear(self: any) self.latched = false end
return Focus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">InputState</string>
            <string name="Source"><![CDATA[--!strict
-- Pure input state: test without Studio. +Y is forward on the control pad; look +X is right, +Y is down
-- (the Godot camera rig's convention: look(dx, dy) with dy > 0 looking down).
-- A button action can be held by several sources at once: a key, a controller button, a finger on a touch button. It is
-- held while any of them is down, so keyboard, controller and touch work together and releasing one never cancels another
-- (ROBLOX-08). set() returns the held state before and after, so callers act once per press and once per release.
local InputState = {}
InputState.__index = InputState

local MOVE_DEAD = 0.2
local LOOK_DEAD = 0.15

export type InputState = typeof(setmetatable({} :: {
	held: { [string]: boolean? },
	sources: { [string]: { [any]: boolean } },
	x: number,
	y: number,
	lx: number,
	ly: number,
}, InputState))

function InputState.new(): InputState
	return setmetatable({ held = {}, sources = {}, x = 0, y = 0, lx = 0, ly = 0 }, InputState)
end

-- One source's state of an action (source nil: a single default source). Returns (held before, held now).
function InputState.set(self: InputState, action: string, down: boolean, source: any?): (boolean, boolean)
	local key: any = if source == nil then "default" else source
	local was = self.held[action] == true
	local set = self.sources[action]
	if down then
		if not set then
			set = {}
			self.sources[action] = set
		end
		set[key] = true
	elseif set then
		set[key] = nil
	end
	local now = set ~= nil and next(set) ~= nil
	self.held[action] = if now then true else nil
	return was, now
end

-- How many sources hold the action now.
function InputState.count(self: InputState, action: string): number
	local n = 0
	local set: { [any]: boolean } = self.sources[action] or {}
	for _ in set do
		n += 1
	end
	return n
end

local function radial(x: number, y: number, dead: number): (number, number)
	local length = math.sqrt(x * x + y * y)
	local strength = math.clamp((length - dead) / (1 - dead), 0, 1)
	if length <= 0 then return 0, 0 end
	return x / length * strength, y / length * strength
end
function InputState.stick(self: InputState, x: number, y: number)
	self.x, self.y = radial(x, y, MOVE_DEAD)
end
-- Right stick: Roblox reports +Y up; store it as look-down positive.
function InputState.look(self: InputState, x: number, y: number)
	local rx, ry = radial(x, y, LOOK_DEAD)
	self.lx, self.ly = rx, -ry
end
function InputState.axes(self: InputState): (number, number)
	local x = self.x + (if self.held.Right then 1 else 0) - (if self.held.Left then 1 else 0)
	local y = self.y + (if self.held.Forward then 1 else 0) - (if self.held.Back then 1 else 0)
	local length = math.max(1, math.sqrt(x * x + y * y))
	return x / length, y / length
end
-- Look rate in -1..1 per axis: right stick plus arrow keys.
function InputState.lookAxes(self: InputState): (number, number)
	local x = self.lx + (if self.held.LookRight then 1 else 0) - (if self.held.LookLeft then 1 else 0)
	local y = self.ly + (if self.held.LookDown then 1 else 0) - (if self.held.LookUp then 1 else 0)
	return math.clamp(x, -1, 1), math.clamp(y, -1, 1)
end
-- Focus loss, the Roblox menu, a text box, a lost controller: nothing stays held.
function InputState.clear(self: InputState)
	table.clear(self.held)
	table.clear(self.sources)
	self.x, self.y, self.lx, self.ly = 0, 0, 0, 0
end
return InputState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">JumpInput</string>
            <string name="Source"><![CDATA[--!strict
-- Jump input: a port of the frozen Godot scripts/movement/jump_controller.gd (c87ce00, hold mode). Pure: the motor is passed
-- in, so tests/run.luau checks the same rules without Roblox.
--
-- A tap of the jump button (Space, A, touch Jump) is a short hop forward. Holding it for HOLD_TICKS (0.15 s) starts aiming:
-- the spider holds still and the landing patch shows the plan for whatever the screen centre is on. Releasing commits the
-- plan the patch shows when it is reachable; on anything else nothing is launched and the reason flashes for FLASH_TICKS.
-- Cancel (Q, B, touch Cancel) leaves a press or an aim with no penalty. drop() is focus loss or the Roblox menu: an aim in
-- progress ends quietly, so a button released while away can never leap later (Godot's _drop_input). Events are queued and
-- applied at the start of the next fixed tick, so timing is counted in ticks and does not depend on the frame rate.
-- `last` records the latest outcome for the HUD and tests: launched, cancelled, refused or hop_refused.
local JumpInput = {}
JumpInput.__index = JumpInput

JumpInput.HOLD_TICKS = 9 -- math.max(1, math.ceil(0.15 * 60 - 1e-6)), as jump_controller._hold_ticks()
JumpInput.FLASH_TICKS = 60

export type Phase = "idle" | "pressed" | "aiming"

function JumpInput.new()
	return setmetatable({
		phase = "idle" :: Phase,
		heldTicks = 0,
		events = {} :: { string },
		plan = nil :: any,
		flash = nil :: any,
		flashLeft = 0,
		last = nil :: any,
		tick = 0,
		onAim = nil :: ((boolean) -> ())?,
	}, JumpInput)
end

function JumpInput.press(self: any) table.insert(self.events, "press") end
function JumpInput.release(self: any) table.insert(self.events, "release") end
function JumpInput.cancel(self: any) table.insert(self.events, "cancel") end

-- Focus loss or the menu: forget queued presses and end an aim with no message (applied at once).
function JumpInput.drop(self: any, motor: any)
	table.clear(self.events)
	if self.phase == "aiming" then
		if motor then motor:cancelPrepare() end
		self:_endAim(motor)
	end
	self.phase = "idle"
	self.heldTicks = 0
end

function JumpInput.isAiming(self: any): boolean return self.phase == "aiming" end
-- True while a press or an aim is in progress: the cancel button belongs to it then.
function JumpInput.isBusy(self: any): boolean return self.phase ~= "idle" end

function JumpInput._record(self: any, kind: string, plan: any)
	self.last = { kind = kind, plan = plan, tick = self.tick }
end

function JumpInput._flash(self: any, plan: any)
	if plan ~= nil and plan.kind ~= "none" then
		self.flash = plan
		self.flashLeft = JumpInput.FLASH_TICKS
	end
end

function JumpInput._setAiming(self: any, on: boolean)
	local f = self.onAim
	if f then f(on) end
end

function JumpInput._endAim(self: any, motor: any)
	self.phase = "idle"
	self.heldTicks = 0
	self.plan = nil
	if motor then motor:clearAimTarget() end
	self:_setAiming(false)
end

function JumpInput._beginAim(self: any, motor: any)
	if not motor:beginPrepare() then
		self.phase = "idle"
		return
	end
	self.phase = "aiming"
	self.plan = nil
	self:_setAiming(true)
	self.plan = motor:aimPlan()
end

-- Commit the plan the patch is showing; anything not reachable is refused, with its reason, and launches nothing.
function JumpInput._confirm(self: any, motor: any)
	local shown = self.plan or motor:aimPlan() -- exactly what the patch showed at the last tick
	if shown ~= nil and shown.kind == "reachable" and motor:commit(shown) then
		self:_endAim(motor)
		self:_record("launched", shown)
		return
	end
	self:_flash(shown)
	motor:cancelPrepare()
	self:_endAim(motor)
	self:_record("refused", shown)
end

function JumpInput._hop(self: any, motor: any)
	local hop = motor:hopPlan()
	if hop ~= nil and hop.kind == "reachable" and motor:beginPrepare() then
		if motor:commit(hop) then
			self:_record("launched", hop)
			return
		end
		motor:cancelPrepare()
	end
	self:_flash(hop)
	self:_record("hop_refused", hop)
end

-- One fixed tick: apply the queued events, then count the hold and keep the aim's plan current.
function JumpInput.step(self: any, motor: any)
	self.tick += 1
	local queued = self.events
	self.events = {}
	for _, e in queued do
		if e == "press" then
			if self.phase == "idle" and motor:canPrepare() then
				self.phase = "pressed"
				self.heldTicks = 0
			end
		elseif e == "release" then
			if self.phase == "pressed" then
				self.phase = "idle"
				self:_hop(motor)
			elseif self.phase == "aiming" then
				self:_confirm(motor)
			end
		elseif e == "cancel" then
			if self.phase == "pressed" then
				self.phase = "idle"
				self:_record("cancelled", nil)
			elseif self.phase == "aiming" then
				motor:cancelPrepare()
				self:_endAim(motor)
				self:_record("cancelled", nil)
			end
		end
	end
	if self.flashLeft > 0 then
		self.flashLeft -= 1
		if self.flashLeft == 0 then self.flash = nil end
	end
	if self.phase == "pressed" then
		if not motor:canPrepare() then
			self.phase = "idle"
		else
			self.heldTicks += 1
			if self.heldTicks >= JumpInput.HOLD_TICKS then self:_beginAim(motor) end
		end
	end
	if self.phase == "aiming" then
		if motor:isPreparing() then
			self.plan = motor:aimPlan()
		else
			self:_endAim(motor) -- the spider lost its support, or was put somewhere else
		end
	end
end

return JumpInput
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">JumpMath</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/movement/jump_math.gd (spec 6.3, 27). Pure math, no Instances, so it runs in tests/run.luau too.
--
-- The motor flies a committed jump with semi-implicit Euler at a fixed 60 Hz tick:
--   v = v + g * dt, then p = p + v * dt.
-- After n ticks from launch velocity v0 at p0 that gives, exactly,
--   p_n = p0 + n * dt * v0 + g * dt^2 * n * (n + 1) / 2
-- so the launch velocity is solved in this discrete form, not with the continuous 0.5 * g * T^2.

local JumpMath = {}

-- Matches SurfaceProfile.STAND_MAX_DEG.
JumpMath.STAND_MAX_DEG = 45.0
JumpMath.MIN_LAUNCH_NORMAL_SPEED = 0.05
JumpMath.STAND_APPROACH_MIN = 0.05
JumpMath.LAND_APPROACH_MIN = 0.3

local UP = Vector3.new(0, 1, 0)

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function finiteVec(v: Vector3): boolean
	return finite(v.X) and finite(v.Y) and finite(v.Z)
end

export type Solution = {
	steps: number,
	duration: number,
	velocity: Vector3,
	speed: number,
	arrivalVelocity: Vector3,
	approach: number,
}

export type SolveResult = {
	valid: { Solution },
	reason: string, -- "ok", "no_durations", "too_far", "no_launch", "no_arrival"
	minSpeed: number,
}

-- Tick counts n whose duration n * dt lies inside [tMin, tMax]. nMax < nMin when none fits.
function JumpMath.stepRange(tMin: number, tMax: number, dt: number): (number, number)
	if not (finite(tMin) and finite(tMax) and finite(dt)) or dt <= 0 then
		return 1, 0
	end
	local nMin = math.ceil(tMin / dt - 1e-6)
	local nMax = math.floor(tMax / dt + 1e-6)
	return math.max(nMin, 1), nMax
end

function JumpMath.positionAfter(p0: Vector3, v0: Vector3, g: Vector3, dt: number, n: number): Vector3
	return p0 + v0 * (n * dt) + g * (dt * dt * n * (n + 1) * 0.5)
end

function JumpMath.velocityAfter(v0: Vector3, g: Vector3, dt: number, n: number): Vector3
	return v0 + g * (dt * n)
end

function JumpMath.launchVelocity(p0: Vector3, seat: Vector3, g: Vector3, dt: number, n: number): Vector3
	return (seat - p0 - g * (dt * dt * n * (n + 1) * 0.5)) / (n * dt)
end

-- Body-centre positions p_0 .. p_steps by repeated ticks, in the order the motor does them.
function JumpMath.path(p0: Vector3, v0: Vector3, g: Vector3, dt: number, steps: number): { Vector3 }
	local out = { p0 }
	local v, p = v0, p0
	for _ = 1, steps do
		v += g * dt
		p += v * dt
		table.insert(out, p)
	end
	return out
end

function JumpMath.isStanding(normal: Vector3): boolean
	if not finiteVec(normal) or normal:Dot(normal) < 1e-10 then
		return false
	end
	return normal.Unit:Dot(UP) >= math.cos(math.rad(JumpMath.STAND_MAX_DEG)) - 1e-6
end

function JumpMath.minApproach(targetNormal: Vector3): number
	return if JumpMath.isStanding(targetNormal) then JumpMath.STAND_APPROACH_MIN else JumpMath.LAND_APPROACH_MIN
end

-- Every launch solution for a landing seat, one per allowed whole-tick duration, filtered by the launch speed limit,
-- by leaving the launch surface and by arriving into the target fast enough. Sorted by speed, lowest first.
function JumpMath.solve(
	p0: Vector3,
	seat: Vector3,
	launchNormal: Vector3,
	targetNormal: Vector3,
	g: Vector3,
	dt: number,
	tMin: number,
	tMax: number,
	maxSpeed: number
): SolveResult
	local valid: { Solution } = {}
	local nMin, nMax = JumpMath.stepRange(tMin, tMax, dt)
	local minSpeed = math.huge
	local anySpeedOk, anyLaunchOk = false, false
	local need = JumpMath.minApproach(targetNormal)
	for n = nMin, nMax do
		local v0 = JumpMath.launchVelocity(p0, seat, g, dt, n)
		if finiteVec(v0) then
			local speed = v0.Magnitude
			minSpeed = math.min(minSpeed, speed)
			if speed <= maxSpeed then
				anySpeedOk = true
				if v0:Dot(launchNormal) >= JumpMath.MIN_LAUNCH_NORMAL_SPEED then
					anyLaunchOk = true
					local arrival = JumpMath.velocityAfter(v0, g, dt, n)
					local approach = -arrival:Dot(targetNormal)
					if approach >= need then
						table.insert(valid, {
							steps = n,
							duration = n * dt,
							velocity = v0,
							speed = speed,
							arrivalVelocity = arrival,
							approach = approach,
						})
					end
				end
			end
		end
	end
	table.sort(valid, function(a: Solution, b: Solution): boolean
		if math.abs(a.speed - b.speed) > 1e-9 then
			return a.speed < b.speed
		end
		return a.steps < b.steps
	end)
	local reason = "ok"
	if #valid == 0 then
		if nMax < nMin then
			reason = "no_durations"
		elseif not anySpeedOk then
			reason = "too_far"
		elseif not anyLaunchOk then
			reason = "no_launch"
		else
			reason = "no_arrival"
		end
	end
	return { valid = valid, reason = reason, minSpeed = minSpeed }
end

return JumpMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">LineFraming</string>
            <string name="Source"><![CDATA[--!strict
-- The camera's line framing at a catch: a port of the frozen Godot camera_rig.gd (c87ce00; A-017, chunk 6A, capped in 6B).
-- While the spider hangs on its line and the player's own view has no room where the spider will hang (the line's rest
-- point, so the view does not chase the swing), the view turns by the smallest turn, in 15-degree steps either way, that
-- gives a comfortable boom with a clear sight of the spider and of the lip the line leaves its support at. The turn is
-- added to the player's yaw (the view yaw); the player's own yaw is untouched. It never exceeds 45 degrees
-- (FRAMING_MAX_TURN_DEG), eases in over about 0.12 s, never rolls the view, and is cast like any other boom.
-- The player always wins: any look input, a recenter or aiming takes the turn over at once (it becomes the player's own
-- yaw, so nothing moves on screen) and the framing stays off until the line ends. When the line ends the view stays where
-- the framing left it. Pure: the world queries are behind `good(turn)`, so tests check the decisions against values
-- exported from Godot (tests/framing_reference.json) and Studio checks the geometry (tests/studio/CameraSpec.luau).
local CameraMath = require(script.Parent.CameraMath)

local LineFraming = {}
LineFraming.__index = LineFraming

LineFraming.ASSIST_STEP_DEG = 15.0
LineFraming.FRAMING_MAX_TURN_DEG = 45.0 -- Chet's cap (chunk 6B): was a half turn in 6A
LineFraming.ASSIST_SMOOTH_SECONDS = 0.12
LineFraming.SIGHT_TOLERANCE = 0.06 -- a ray that stops this short of its end still saw it

function LineFraming.new(): any
	return setmetatable({
		assist = 0, -- the turn added to the player's yaw now, radians
		prev = 0,
		target = 0, -- the turn wanted at the last tick
		velocity = 0,
		off = false, -- the player turned the view since the line caught: no framing until it ends
		enabled = true, -- Godot's setting "Frame the line after a catch" (default on)
		maxTurn = math.rad(LineFraming.FRAMING_MAX_TURN_DEG),
	}, LineFraming)
end

-- camera_rig._wanted_yaw_assist: the turn already held while it still works (so the view does not flip as the rest point
-- moves), else none when the player's own view works, else the smallest working step within the cap (+ before -),
-- else none (nowhere works: the view is left to the pitch search).
function LineFraming.wantedTurn(held: number, maxTurn: number, good: (number) -> boolean): number
	if held ~= 0 and good(held) then return held end
	if good(0) then return 0 end
	local step = math.rad(LineFraming.ASSIST_STEP_DEG)
	local k = 1
	while k * step <= maxTurn + 1e-6 do
		for _, side in { 1, -1 } do
			local turn = k * step * side
			if good(turn) then return turn end
		end
		k += 1
	end
	return 0
end

-- The player takes the view: returns the turn to add to the player's own yaw, so nothing moves on screen.
function LineFraming.takeOver(self: any): number
	if self.assist == 0 and self.prev == 0 and self.target == 0 then return 0 end
	local delta = self.assist
	self.assist, self.prev, self.target, self.velocity = 0, 0, 0, 0
	return delta
end

-- A look or a recenter: the turn is taken over and, on the line, the framing stays off until the line ends.
function LineFraming.playerTurns(self: any, onLine: boolean): number
	local delta = self:takeOver()
	if onLine then self.off = true end
	return delta
end

-- One fixed tick (camera_rig._update_assist). Returns a change for the player's yaw: the held turn when the line has just
-- ended (the view stays where it is), otherwise 0.
function LineFraming.tick(self: any, onLine: boolean, aiming: boolean, wanted: () -> number, dt: number): number
	self.prev = self.assist
	if not onLine then
		self.off = false
		return self:takeOver()
	end
	local w = 0
	if self.enabled and not self.off and not aiming then w = wanted() end
	self.target = w
	self.assist, self.velocity = CameraMath.smoothDamp(self.assist, w, self.velocity, LineFraming.ASSIST_SMOOTH_SECONDS, dt)
	return 0
end

-- The setting: switched off while a turn is held, the view stays where it is (the turn becomes the player's).
function LineFraming.setEnabled(self: any, on: boolean): number
	self.enabled = on
	return if on then 0 else self:takeOver()
end

-- A snap (spawn, reset, leaving the eye view): no turn at all.
function LineFraming.reset(self: any)
	self.assist, self.prev, self.target, self.velocity, self.off = 0, 0, 0, 0, false
end

return LineFraming
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">SilkController</string>
            <string name="Source"><![CDATA[--!strict
-- Engine adapter for the frozen safety line. One local-space anchor, at most one bend.
-- Fixed ticks only. The client owns ordinary walking/jumps; this owns locked-line movement.
local Math = require(script.Parent.TetherMath)
local Silk = {}
Silk.__index = Silk
local HEIGHT, RADIUS = 0.31, 0.30
local DOWN = Vector3.new(0,-1,0)

function Silk.new(world, surfaces, tuning, gravity: number)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = {world}
	return setmetatable({world=world, surfaces=surfaces, params=params, maximum=tuning.max_line_length_wu,
		speed=tuning.reel_speed_wu_s, gravity=gravity, mode="none", paid=0, rest=0, taut=false,
		anchor=Vector3.zero, normal=Vector3.yAxis, anchorPart=nil, bend=nil, bendPart=nil,
		lowering=false, snagged=false, block="", message="", release=Math.newRelease(), walk=nil,
		previous=Vector3.zero},Silk)
end
function Silk.profile(self: any, hit)
	return if hit then self.surfaces[hit.Instance:GetAttribute("ProfileId")] else nil
end
function Silk.clear(self: any)
	self.mode="none"; self.anchorPart=nil; self.bend=nil; self.bendPart=nil
	self.paid=0; self.rest=0; self.taut=false; self.lowering=false; self.snagged=false; self.block=""
	self.walk=nil; self.release=Math.newRelease()
	self.message=""
end
function Silk.anchorAt(self: any, hit, position: Vector3): boolean
	self:clear()
	local profile=self:profile(hit)
	if not profile or not profile.silk_anchor_allowed or not hit.Instance:IsA("BasePart") then
		self.message="This surface cannot hold silk"; return false
	end
	self.anchorPart=hit.Instance
	self.anchorLocal=hit.Instance.CFrame:PointToObjectSpace(hit.Position)
	self.normalLocal=hit.Instance.CFrame:VectorToObjectSpace(hit.Normal)
	self.anchor=hit.Position; self.normal=hit.Normal; self.previous=position
	self.mode="payout"; self.rest=self.maximum; self.paid=math.min((position-self.anchor).Magnitude,self.maximum)
	self.message="Silk attached"
	return true
end
function Silk.pivot(self: any): Vector3 return self.bend or self.anchor end
function Silk.prefix(self: any): number return if self.bend then (self.bend-self.anchor).Magnitude else 0 end
function Silk.path(self: any, position: Vector3): number return self:prefix()+(position-self:pivot()).Magnitude end
function Silk.refresh(self: any): boolean
	if not self.anchorPart or not self.anchorPart:IsDescendantOf(self.world) then
		self:clear(); self.message="Silk anchor lost"; return false
	end
	self.anchor=self.anchorPart.CFrame:PointToWorldSpace(self.anchorLocal)
	self.normal=self.anchorPart.CFrame:VectorToWorldSpace(self.normalLocal)
	if self.bendPart then
		if self.bendPart:IsDescendantOf(self.world) then self.bend=self.bendPart.CFrame:PointToWorldSpace(self.bendLocal)
		else self.bend=nil; self.bendPart=nil end
	end
	return true
end
function Silk.clearRay(self: any, a: Vector3, b: Vector3): boolean
	local d=b-a
	return d.Magnitude<=0.02 or workspace:Raycast(a,d.Unit*(d.Magnitude-0.02),self.params)==nil
end
function Silk.geometry(self: any, position: Vector3)
	local a=self.anchor+self.normal*0.02
	if self:clearRay(a,position) then self.bend=nil; self.bendPart=nil; self.snagged=false
	elseif self.bend then self.snagged=not self:clearRay(self.bend,position)
	elseif self:clearRay(a,self.previous) then
		local lo,hi=0,1
		for _=1,12 do
			local mid=(lo+hi)*0.5
			if self:clearRay(a,self.previous:Lerp(position,mid)) then lo=mid else hi=mid end
		end
		local hit=workspace:Raycast(a,self.previous:Lerp(position,hi)-a,self.params)
		self.snagged=true
		if hit and hit.Instance:IsA("BasePart") then
			local side=position-hit.Position
			side-=hit.Normal*side:Dot(hit.Normal)
			if side.Magnitude>1e-6 then side=side.Unit end
			for _,k in {1,2,4} do
				local point=hit.Position+(hit.Normal+side)*0.03*k
				if self:clearRay(a,point) and self:clearRay(point,position) then
					self.bend=point; self.bendPart=hit.Instance
					self.bendLocal=hit.Instance.CFrame:PointToObjectSpace(point)
					if self.mode=="locked" then self.rest=math.min(math.max(self.rest,self:path(position)),self.maximum) end
					self.snagged=false; break
				end
			end
		end
	else self.snagged=true end
	self.previous=position
end
function Silk.lock(self: any, position: Vector3, extension: number)
	if self.mode=="none" then return end
	self.paid,self.rest=Math.lock(self.paid,self:path(position),self.maximum,extension)
	self.mode="locked"; self.taut=false; self.block=""; self.release=Math.newRelease()
	self.message="Silk catching"
end
function Silk.payout(self: any, position: Vector3)
	if self.mode~="payout" or not self:refresh() then return end
	self:geometry(position)
	self.paid=math.max(self.paid,self:path(position))
	if self.paid>=self.maximum then self.paid=self.maximum; self:lock(position,0) end
end
function Silk.room(self: any, position: Vector3): number
	local hit=workspace:Spherecast(position,RADIUS,DOWN*self.maximum,self.params)
	return if hit then hit.Distance else 0
end
function Silk.planDrop(self: any, position: Vector3, up: Vector3, heading: Vector3): ({direction: Vector3, distance: number}?, string)
	local hit=workspace:Raycast(position,-up*(HEIGHT+0.12),self.params)
	local profile=self:profile(hit)
	if not profile then return nil,"No supporting surface" end
	if not profile.silk_anchor_allowed then return nil,"This surface cannot hold silk" end
	if up:Dot(Vector3.yAxis)<0.707 then
		if self:room(position+up*0.01)>=1 then return {direction=Vector3.zero,distance=0},"" end
		return nil,"Nothing below to lower into"
	end
	local best: {direction: Vector3, distance: number}? = nil
	local limit=6
	for i=0,15 do
		local dir=CFrame.fromAxisAngle(up,i*math.pi/8):VectorToWorldSpace(heading)
		local obstacle=workspace:Spherecast(position,RADIUS,dir*6,self.params)
		local free=if obstacle then obstacle.Distance else 6
		for step=1,math.floor(math.min(free,limit)*10) do
			local distance=step/10
			local q=position+dir*distance
			if not workspace:Raycast(q,-up*(HEIGHT+0.12),self.params) then
				if self:room(q+dir*HEIGHT)>=1 and (not best or distance<limit-1e-6) then best={direction=dir,distance=distance}; limit=distance end
				break
			end
		end
	end
	return best,if best then "" else "Nothing below to lower into"
end
function Silk.startDrop(self: any, position: Vector3, up: Vector3, push: Vector3)
	local hit=workspace:Raycast(position,-up*(HEIGHT+0.12),self.params)
	if not self:anchorAt(hit,position) then return false end
	self.lowering=true; self:lock(position,Math.DROP_SLACK)
	self.message="Lowering on silk"
	return true
end

-- Sweep the body, then slide once. Never satisfy a constraint by teleporting through a wall.
function Silk.move(self: any, position: Vector3, motion: Vector3, velocity: Vector3, intent: number)
	local p=position
	local remaining=motion
	for _=1,2 do
		if remaining.Magnitude<1e-7 then break end
		local hit=workspace:Spherecast(p,RADIUS,remaining,self.params)
		if not hit then p+=remaining; break end
		-- Maintain a skin along the contact normal at grazing angles.
		p=hit.Position+hit.Normal*(RADIUS+0.01)
		local profile=self:profile(hit)
		local allowed=not self.lowering or intent>0 or (hit.Normal.Y>=0.707 and hit.Position.Y<=self.anchor.Y-0.5)
		if profile and profile.attachable and allowed then return p,Vector3.zero,hit end
		local rest=remaining-remaining.Unit*math.min(hit.Distance,remaining.Magnitude)
		remaining=rest-hit.Normal*rest:Dot(hit.Normal)
		velocity-=hit.Normal*math.min(0,velocity:Dot(hit.Normal))
	end
	-- While lowering alongside the launch wall, a nearly tangent native sweep can
	-- miss a shallow contact. Maintain the wall's skin without grabbing it again.
	-- Other faces still use the swept landing rules above.
	if self.lowering and math.abs(self.normal.Y)<0.707 then
		local face=workspace:Raycast(p,-self.normal*(RADIUS+0.01),self.params)
		if face and face.Normal:Dot(self.normal)>0.99 then
			local clearance=(p-face.Position):Dot(face.Normal)
			if clearance<RADIUS+0.01 then
				p+=face.Normal*(RADIUS+0.01-clearance)
				velocity-=face.Normal*math.min(0,velocity:Dot(face.Normal))
			end
		end
	end
	return p,velocity,nil
end
function Silk.step(self: any, position: Vector3, velocity: Vector3, intent: number, releaseDown: boolean)
	if self.mode~="locked" or not self:refresh() then return position,velocity,nil end
	if Math.releaseTick(self.release,true,releaseDown) then
		self:clear(); self.message="Silk released"; return position,velocity,nil
	end
	if intent<=0 and self.block=="blocked" then self.block="" end
	local oldRest=self.rest
	if intent<0 or (self.block=="" and not self.snagged) then self.rest=Math.reel(self.rest,self:prefix(),self.maximum,intent,self.speed) end
	-- "Shortest" only when a reel actually ran and could not shorten (Godot sets it inside its not-snagged reel branch);
	-- a snag while swinging under a leaf must not leave reeling refused once the line is clear again (ROBLOX-10).
	if intent>0 and not self.snagged and self.rest>=oldRest-1e-6 and self.block=="" then self.block="shortest" end
	if intent<0 and self.rest>oldRest then self.block="" end
	local p=position
	-- A padded bend can leave the shortest line just below the lip. Acquire a nearby
	-- real face with the legs (0.6 stud reach), never through an intervening obstacle.
	if intent>0 and self.block=="shortest" and not self.snagged then
		for _,direction in {self:pivot()-p,Vector3.yAxis,-self.normal} do
			if direction.Magnitude>1e-6 then
				local face=workspace:Raycast(p,direction.Unit*0.6,self.params)
				local profile=self:profile(face)
				if face and profile and profile.attachable then
					local seat=face.Position+face.Normal*HEIGHT
					local motion=seat-p
					local obstacle=if motion.Magnitude>1e-7 then workspace:Spherecast(p,RADIUS,motion,self.params) else nil
					if not obstacle or obstacle.Instance==face.Instance then return seat,Vector3.zero,face end
				end
			end
		end
	end
	if self.rest<oldRest then
		local excess=self:path(p)-self.rest
		if excess>1e-6 then
			local hit
			p,velocity,hit=self:move(p,(self:pivot()-p).Unit*excess,velocity,intent)
			if hit then return p,velocity,hit end
			if self:path(p)>self.rest+1e-4 then self.rest=math.min(self:path(p),self.maximum); self.block="blocked" end
		end
	end
	local energy=Math.energy(p,velocity,self.gravity)
	velocity+=DOWN*self.gravity*Math.DT
	if self.taut and (p-self:pivot()).Magnitude>1e-6 then
		local r=(p-self:pivot()).Unit
		velocity-=(velocity-r*velocity:Dot(r))*(1-math.exp(-Math.DAMPING*Math.DT))
	end
	local c=Math.constrain(self:pivot(),math.max(self.rest-self:prefix(),0),p+velocity*Math.DT,velocity)
	local hit
	p,velocity,hit=self:move(p,c.position-p,c.velocity,intent)
	if hit then return p,velocity,hit end
	local over=self:path(p)-self.rest
	if over>1e-4 then
		p,velocity,hit=self:move(p,(self:pivot()-p).Unit*over,velocity,intent)
		if hit then return p,velocity,hit end
	end
	self:geometry(p)
	if Math.energy(p,velocity,self.gravity)>energy+1e-6 then
		local ke=0.5*velocity:Dot(velocity)
		velocity*=if ke>1e-12 then math.sqrt(math.clamp((energy-self.gravity*p.Y)/ke,0,1)) else 0
	end
	local path=self:path(p)
	self.paid=math.min(math.max(self.paid,path),self.rest)
	self.taut=path>=self.rest-0.003
	self.message=if self.snagged then "Silk snagged — lower or let go" elseif self.block=="blocked" then "Reel blocked — lower or let go"
		elseif self.block=="shortest" then "At the shortest line" elseif intent>0 then "Reeling in" elseif intent<0 then "Lowering" else "Hanging on silk"
	return p,velocity,nil
end
return Silk
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">SpiderMotor</string>
            <string name="Source"><![CDATA[--!strict
-- The spider's body on the windowsill: a kinematic port of the frozen Godot motor's core (scripts/movement/spider_motor.gd,
-- jump_planner.gd and the jump/line parts of player_controller.gd and tether_controller.gd, c87ce00). It walks on any
-- attachable surface (floor, walls, undersides, over edges), plans hops and aimed leaps with the shared JumpMath at a fixed
-- 60 Hz tick, flies them, pays out a safety line from silk-holding ground (SilkController: catch, hang, reel, lower,
-- edge-first lowering, deliberate let-go) and reports line events for the HUD.
--
-- No input devices, camera or drawing here: the client passes a TickInput each fixed tick and an aim ray, so Studio specs
-- (tests/studio/RecoverySpec.luau) run the same motor deterministically, tick by tick, against real geometry. Engine
-- queries only: Workspace raycasts, sphere casts and one overlap query (the room probe).
--
-- The eyes (D-036, spider_motor.gd get_eye_position, get_gaze_direction, get_body_gaze_direction, set_scan_direction, _update_gaze): the
-- senses read the observer() of the body, never the camera. The eyes sit EYE_FORWARD along the facing and EYE_UP along the body's up; the
-- gaze is the facing tilted by the gaze pitch, which follows Focus (at the focus rate, up to the species' gaze limit) and settles to the
-- support plane at half that rate; in the spider-eye view the principal eyes' retinas may point the inspection up to PRINCIPAL_SCAN_DEG
-- off the body's gaze. The camera alone never moves the cone: only Focus and moving do.
local JumpMath = require(script.Parent.JumpMath)
local SupportMath = require(script.Parent.SupportMath)
local SilkController = require(script.Parent.SilkController)

local Motor = {}
Motor.__index = Motor

local DT = 1 / 60
Motor.DT = DT
Motor.HEIGHT = 0.31 -- body centre above the support plane: radius 0.3 + skin 0.01 (Godot seat distance)
local HEIGHT = Motor.HEIGHT
local SWEEP_RADIUS = 0.303 -- body radius + JumpPlanner.SWEEP_MARGIN
local TURN_RATE = math.rad(540)
local FOCUS_RATE = math.rad(180) -- Godot FOCUS_TURN_FALLBACK_DEG_S
local PREPARE_TURN_RATE = math.rad(360) -- SpiderMotor.PREPARE_TURN_RATE_DEG_S: cosmetic turn toward the aim point
local AIM_RANGE = 60
Motor.AIM_RANGE = AIM_RANGE
local HOP_DISTANCE = 1.5
local HOP_PROBE_UP, HOP_PROBE_DOWN = 0.5, 1.2
local MAX_DRIFT = 0.15
local CONTACT_EXTRA_STEPS = 8
local EYE_TURN_START_DEG, EYE_TURN_STOP_DEG = 30, 4 -- CameraMath.PRINCIPAL_SCAN_DEG, EYE_SETTLE_DEG
-- T10a: how far either way of the body's gaze the principal eyes' retinas can point the sharp field (the scan direction).
Motor.PRINCIPAL_SCAN_DEG = 30
local PRINCIPAL_SCAN = math.rad(Motor.PRINCIPAL_SCAN_DEG)
-- Where the eyes are: from the body centre along the facing and along the body's up. Both inside the 0.3 WU body, so a ray from the eye
-- never starts in the world.
Motor.EYE_FORWARD = 0.18
Motor.EYE_UP = 0.08
local EYE_FORWARD, EYE_UP = Motor.EYE_FORWARD, Motor.EYE_UP
local GAZE_PITCH_FALLBACK_DEG = 35 -- used when the species profile has no perception section
local FREE_UP_RATE = math.rad(240) -- the drawn up turns to world up while falling or on the line (Godot VISUAL_TURN)

export type TickInput = {
	wish: Vector3, -- walking direction on the support plane (unit or zero), from the view
	creep: boolean,
	reel: number, -- on the line: +1 reels in, -1 lowers
	dropHeld: boolean, -- F / X / Silk held: lowers on the line
	releaseHeld: boolean, -- Q / B / Let go held: a deliberate let-go after the grace
	focusPoint: Vector3?, -- Focus held: the body turns toward this point
	focusDir: Vector3?, -- Focus held: the aim ray's direction, which the gaze tilts toward when the point is within 0.2 WU of the eyes
	gaze: Vector3?, -- spider-eye view: the body turns to face a gaze beyond 30 degrees
}

export type Config = {
	world: Instance,
	surfaces: any,
	profile: any,
	spawn: Vector3, -- the support point under the body
	heading: Vector3,
	boundsMin: Vector3,
	boundsMax: Vector3,
	probeParent: Instance?,
}

function Motor.idleInput(): TickInput
	return { wish = Vector3.zero, creep = false, reel = 0, dropHeld = false, releaseHeld = false }
end

function Motor.new(config: Config): any
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { config.world }
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = { config.world }
	local probe = Instance.new("Part")
	probe.Name = "RoomProbe"
	probe.Shape = Enum.PartType.Ball
	probe.Size = Vector3.one * (SWEEP_RADIUS * 2)
	probe.Anchored = true
	probe.CanCollide = false
	probe.CanQuery = false
	probe.CanTouch = false
	probe.Transparency = 1
	probe.Parent = config.probeParent or workspace
	local loco = config.profile.locomotion
	local perception = config.profile.perception
	local gazeLimitDeg = if perception ~= nil and typeof(perception.gaze_pitch_limit_deg) == "number" then perception.gaze_pitch_limit_deg else GAZE_PITCH_FALLBACK_DEG
	local self = setmetatable({
		config = config,
		surfaces = config.surfaces,
		loco = loco,
		gravity = Vector3.new(0, -loco.gravity_wu_s2, 0),
		params = params,
		overlap = overlap,
		probe = probe,
		silk = SilkController.new(config.world, config.surfaces, config.profile.silk, loco.gravity_wu_s2) :: any,
		mode = "attached",
		pos = config.spawn + Vector3.new(0, HEIGHT, 0),
		up = Vector3.yAxis,
		heading = config.heading,
		vel = Vector3.zero,
		moving = false,
		preparing = false,
		aimTarget = nil :: Vector3?,
		aimOrigin = Vector3.zero,
		aimDirection = -Vector3.zAxis,
		planKey = "",
		plan = nil :: any,
		flightTicks = 0,
		flightLimit = 0,
		eyeTurning = false,
		gazePitch = 0, -- how far the gaze is tilted off the support plane, radians, up positive (Godot _gaze_pitch)
		gazeLimit = math.rad(gazeLimitDeg),
		scanDir = nil :: Vector3?, -- T10a: where the spider-eye view points the principal eyes (a unit direction); nil: straight ahead
		focusOn = false, -- Focus is turning the gaze (held, or the spider-eye view turning the body); Godot is_focusing
		ticks = 0,
		lineSerial = 0, -- counts lines started, so the drawing knows a new one began
		afterMiss = false,
		dropped = false,
		caught = false,
		safe = { pos = config.spawn + Vector3.new(0, HEIGHT, 0), up = Vector3.yAxis, heading = config.heading },
		supportPart = nil :: Instance?, -- the part the spider last took hold of
		intent = Vector3.zero, -- the walking direction last used, turned with the support at an edge (StickCarry reads it)
		transitionSerial = 0, -- counts sharp support turns while walking (concave and convex edges)
		events = {} :: { { kind: string, detail: string } },
	}, Motor)
	return self
end

function Motor.destroy(self: any)
	self.probe:Destroy()
end

function Motor._event(self: any, kind: string, detail: string?)
	table.insert(self.events, { kind = kind, detail = detail or "" })
end

-- The line and jump events since the last call (for the HUD's toasts), oldest first.
function Motor.drainEvents(self: any): { { kind: string, detail: string } }
	local out = self.events
	self.events = {}
	return out
end

function Motor.profileOf(self: any, inst: Instance?): any
	if not inst then return nil end
	local id = inst:GetAttribute("ProfileId")
	return if typeof(id) == "string" then self.surfaces[id] else nil
end

function Motor.attachable(self: any, hit: RaycastResult?): boolean
	if not hit then return false end
	local p = self:profileOf(hit.Instance)
	return p ~= nil and p.attachable == true
end

-- SurfaceProfile.supports: an attachable surface, or any floor flat enough to stand on.
local STAND_COS = math.cos(math.rad(JumpMath.STAND_MAX_DEG)) - 1e-6
function Motor.supports(_self: any, p: any, normal: Vector3): boolean
	if p ~= nil and p.attachable then return true end
	return normal.Magnitude > 1e-5 and normal.Unit:Dot(Vector3.yAxis) >= STAND_COS
end

local function rotationBetween(a: Vector3, b: Vector3): CFrame
	local angle = SupportMath.angleTo(a, b)
	if angle < 1e-6 then return CFrame.identity end
	local axis = a:Cross(b)
	if axis:Dot(axis) < 1e-12 then axis = SupportMath.anyPerpendicular(a) end
	return CFrame.fromAxisAngle(axis.Unit, angle)
end

function Motor._setSupport(self: any, hit: RaycastResult)
	local turn = rotationBetween(self.up, hit.Normal)
	self.heading = SupportMath.tangentDir(turn * self.heading, hit.Normal)
	if self.heading == Vector3.zero then self.heading = SupportMath.anyPerpendicular(hit.Normal) end
	self.up = hit.Normal
	self.pos = hit.Position + hit.Normal * HEIGHT
	self.supportPart = hit.Instance
end

-- A sharp turn of the support while walking (a wall ahead, an edge to wrap): the walking direction turns with it, as the
-- heading does, and the transition is counted so the controls can carry the stick's direction over the edge.
function Motor._transition(self: any, hit: RaycastResult)
	local turn = rotationBetween(self.up, hit.Normal)
	self.intent = SupportMath.tangentDir(turn * self.intent, hit.Normal)
	self:_setSupport(hit)
	self.transitionSerial += 1
end

function Motor._ray(self: any, from: Vector3, motion: Vector3): RaycastResult?
	return workspace:Raycast(from, motion, self.params)
end

-- Puts the spider somewhere (a reset, a test fixture). Every line, aim and walk ends.
function Motor.place(self: any, position: Vector3, up: Vector3?, heading: Vector3?)
	self.mode = "attached"
	self.pos = position
	self.up = up or Vector3.yAxis
	self.heading = SupportMath.tangentDir(heading or self.config.heading, self.up)
	if self.heading == Vector3.zero then self.heading = SupportMath.anyPerpendicular(self.up) end
	self.vel = Vector3.zero
	self.moving = false
	self.intent = Vector3.zero
	self.preparing = false
	self.aimTarget = nil
	self.plan = nil
	self.planKey = ""
	self.gazePitch = 0
	self.silk:clear()
	self.afterMiss, self.dropped, self.caught = false, false, false
	self.safe = { pos = self.pos, up = self.up, heading = self.heading }
end

function Motor.respawn(self: any)
	self:place(self.config.spawn + Vector3.new(0, HEIGHT, 0), Vector3.yAxis, self.config.heading)
end

-- ---------------------------------------------------------------- the planner (port of jump_planner.gd)
function Motor._sweep(self: any, a: Vector3, b: Vector3): Vector3?
	local d = b - a
	if d.Magnitude < 1e-6 then return nil end
	local hit = workspace:Spherecast(a, SWEEP_RADIUS, d, self.params)
	return if hit then a + d.Unit * hit.Distance else nil
end

function Motor._fits(self: any, center: Vector3): boolean
	self.probe.CFrame = CFrame.new(center)
	return #workspace:GetPartsInPart(self.probe, self.overlap) == 0
end

function Motor._tryCandidate(self: any, origin: Vector3, seat: Vector3, c: any): (boolean, string, { Vector3 }, Vector3?)
	local G = self.gravity
	local pts = JumpMath.path(origin, c.velocity, G, DT, c.steps)
	for k = 2, #pts do
		local at = self:_sweep(pts[k - 1], pts[k])
		if at then
			local cut = table.move(pts, 1, k - 1, 1, {})
			table.insert(cut, at)
			return false, "path_blocked", cut, at
		end
	end
	local v = JumpMath.velocityAfter(c.velocity, G, DT, c.steps)
	local p = pts[#pts]
	for _ = 1, CONTACT_EXTRA_STEPS do
		v += G * DT
		local nextP = p + v * DT
		local at = self:_sweep(p, nextP)
		if at then
			if (at - seat).Magnitude <= MAX_DRIFT then return true, "ok", pts, nil end
			return false, "graze", pts, at
		end
		p = nextP
	end
	return false, "graze", pts, seat
end

-- A plan for a target surface point (JumpPlanner.plan): kind reachable / obstructed / unreachable / ineligible / none, with
-- the reason, the drawn path and, when reachable, the launch velocity and ticks. origin is where the body was.
function Motor.planJump(self: any, point: Vector3?, normal: Vector3?, inst: Instance?): any
	if not point or not normal then return { kind = "none", reason = "no_target" } end
	local loco = self.loco
	local plan: any = { point = point, normal = normal, seat = point + normal * HEIGHT, kind = "unreachable", reason = "", origin = self.pos }
	if not self:supports(self:profileOf(inst), normal) then
		plan.kind, plan.reason = "ineligible", "ineligible_surface"
		return plan
	end
	local solved = JumpMath.solve(self.pos, plan.seat, self.up, normal, self.gravity, DT, loco.flight_time_min_s, loco.flight_time_max_s, loco.max_launch_speed_wu_s)
	if #solved.valid == 0 then
		plan.reason = solved.reason
		return plan
	end
	if not self:_fits(plan.seat) then
		plan.kind, plan.reason = "obstructed", "no_room"
		plan.path = JumpMath.path(self.pos, solved.valid[1].velocity, self.gravity, DT, solved.valid[1].steps)
		plan.blockedAt = plan.seat
		return plan
	end
	local firstPath, firstAt, anyBlocked = nil, nil, false
	for _, c in solved.valid do
		local ok, why, path, at = self:_tryCandidate(self.pos, plan.seat, c)
		if ok then
			plan.kind, plan.reason, plan.path, plan.velocity, plan.steps = "reachable", "ok", path, c.velocity, c.steps
			return plan
		end
		if not firstPath then firstPath, firstAt = path, at end
		if why == "path_blocked" then anyBlocked = true end
	end
	plan.path, plan.blockedAt = firstPath, firstAt
	plan.kind, plan.reason = if anyBlocked then "obstructed" else "unreachable", if anyBlocked then "path_blocked" else "graze"
	return plan
end

-- The aim ray the client last gave (the camera's centre ray).
function Motor.setAimRay(self: any, origin: Vector3, direction: Vector3)
	self.aimOrigin, self.aimDirection = origin, direction
end

-- The aim: whatever the centre ray meets (no target magnet). Re-planned only when the aim or the spider moves.
function Motor.aimPlan(self: any): any
	local hit = self:_ray(self.aimOrigin, self.aimDirection * AIM_RANGE)
	local key = if hit
		then string.format("%.3f,%.3f,%.3f|%.3f,%.3f,%.3f|%.3f,%.3f,%.3f|%.3f,%.3f,%.3f", hit.Position.X, hit.Position.Y, hit.Position.Z, hit.Normal.X, hit.Normal.Y, hit.Normal.Z, self.pos.X, self.pos.Y, self.pos.Z, self.up.X, self.up.Y, self.up.Z)
		else "none"
	if key ~= self.planKey or not self.plan then
		self.planKey = key
		self.plan = if hit then self:planJump(hit.Position, hit.Normal, hit.Instance) else self:planJump(nil, nil, nil)
	end
	if self.preparing then
		self.aimTarget = if hit then hit.Position else nil
	end
	return self.plan
end

-- JumpMotor.plan_hop: the ground HOP_DISTANCE ahead, planned and checked exactly like an aimed jump.
function Motor.hopPlan(self: any): any
	local n = self.up
	local h = SupportMath.tangentDir(self.heading, n)
	if h == Vector3.zero then h = SupportMath.anyPerpendicular(n) end
	local ahead = self:_ray(self.pos, h * (HOP_DISTANCE + HEIGHT))
	if ahead then
		return { kind = "obstructed", reason = "hop_blocked", point = ahead.Position, normal = ahead.Normal, origin = self.pos }
	end
	local finish = self.pos + h * HOP_DISTANCE
	local ground = self:_ray(finish + n * HOP_PROBE_UP, -n * (HOP_PROBE_UP + HOP_PROBE_DOWN))
	if not ground then
		return { kind = "unreachable", reason = "no_ground", point = finish - n * HEIGHT, normal = n, origin = self.pos }
	end
	return self:planJump(ground.Position, ground.Normal, ground.Instance)
end

-- What a leap from here does with the line (SpiderMotor.get_anchor_preview): "ok", "no_silk", "too_long" or "no_support".
function Motor.anchorPreview(self: any, plan: any): string
	if self.mode ~= "attached" then return "no_support" end
	local hit = self:_ray(self.pos, -self.up * (HEIGHT + 0.1))
	local p = if hit then self:profileOf(hit.Instance) else nil
	if not p then return "no_support" end
	if not p.silk_anchor_allowed then return "no_silk" end
	if plan and plan.seat and (plan.seat - self.pos).Magnitude > self.silk.maximum then return "too_long" end
	return "ok"
end

-- ---------------------------------------------------------------- the jump controller's view of the motor (JumpInput)
-- Standing on a surface and not walking itself to an edge's drop: a press or an aim may start.
function Motor.canPrepare(self: any): boolean
	return self.mode == "attached"
end

-- ATTACHED to PREPARING: the spider holds still; a walk to the edge stops (the player took over).
function Motor.beginPrepare(self: any): boolean
	if not self:canPrepare() then return false end
	if self.silk.walk then self:cancelWalk() end
	self.preparing = true
	self.vel = Vector3.zero
	return true
end

function Motor.cancelPrepare(self: any)
	self.preparing = false
	self.aimTarget = nil
end

function Motor.isPreparing(self: any): boolean
	return self.preparing and self.mode == "attached"
end

function Motor.clearAimTarget(self: any)
	self.aimTarget = nil
end

-- Commits a reachable plan made from where the body is now. Anything else changes nothing.
function Motor.commit(self: any, plan: any): boolean
	if plan == nil or plan.kind ~= "reachable" or self.mode ~= "attached" then return false end
	if plan.origin and (plan.origin - self.pos).Magnitude > 1e-3 then return false end
	self:_launch(plan.velocity, plan.steps)
	return true
end

-- A committed leap anchors a safety line at takeoff where the ground holds silk (SilkController pays it out).
function Motor._launch(self: any, velocity: Vector3, steps: number)
	local floorHit = self:_ray(self.pos, -self.up * (HEIGHT + 0.1))
	self.afterMiss, self.dropped, self.caught = false, false, false
	if self.silk:anchorAt(floorHit, self.pos) then
		self.lineSerial += 1
		self:_event("anchored")
	end
	self.preparing = false
	self.aimTarget = nil
	self.flightTicks, self.flightLimit = 0, steps + 4
	self.vel = velocity
	self.mode = "air"
	self:_event("launched")
end

-- ---------------------------------------------------------------- letting down on a line (F / X / Silk)
function Motor._beginDrop(self: any, push: Vector3): boolean
	if not self.silk:startDrop(self.pos, self.up, push) then return false end
	self.lineSerial += 1
	self.afterMiss, self.dropped, self.caught = false, true, false
	self.vel = push * 0.6
	self.mode = "air"
	self.preparing = false
	self.aimTarget = nil
	self:_event("dropped")
	return true
end

-- Godot SpiderMotor.begin_drop: on a wall or underside let down at once; on top of a leaf, walk to the nearest usable
-- edge first. Returns whether something started; a refusal says why in an event.
function Motor.requestDrop(self: any): boolean
	if self.mode ~= "attached" or self.preparing or self.silk.walk then return false end
	local plan, message = self.silk:planDrop(self.pos, self.up, self.heading)
	if not plan then
		self.silk.message = message
		local reason = if message == "This surface cannot hold silk" then "no_silk" elseif message == "No supporting surface" then "no_support" else "no_edge"
		self:_event("drop_refused", reason)
		return false
	end
	if plan.direction.Magnitude < 1e-6 then
		if self:_beginDrop(self.up) then self.pos += self.up * 0.01 end
	else
		self.silk.walk = { direction = plan.direction, ticks = math.ceil((plan.distance / self.loco.walk_speed_wu_s + 1.5) * 60) }
		self.silk.message = "Walking to the edge — move or cancel to stop"
		self:_event("drop_walk")
	end
	return true
end

-- Stops a walk to the edge (the player moved, aimed or pressed cancel). False when there was none.
function Motor.cancelWalk(self: any): boolean
	if not self.silk.walk then return false end
	self.silk.walk = nil
	self.silk.message = "Edge walk cancelled"
	return true
end

-- True while hanging or reeling on a locked line (Godot is_on_line).
function Motor.onLine(self: any): boolean
	return self.mode == "air" and self.silk.mode == "locked"
end

-- Where the spider will hang (the line's rest point below its pivot) and the lip the line leaves its support at: the
-- camera frames the recovery from these (camera_rig._wanted_yaw_assist, A-017).
function Motor.lineRestPoint(self: any): Vector3
	if self.silk.mode ~= "locked" then return self.pos end
	local pivot = self.silk:pivot()
	return pivot - Vector3.yAxis * math.max(self.silk.rest - self.silk:prefix(), 0)
end

function Motor.lineLip(self: any): Vector3
	return self.silk.bend or (self.silk.anchor + self.silk.normal * 0.04)
end

-- ---------------------------------------------------------------- the eyes (D-036)
-- Where the eyes are (Godot get_eye_position): on the body, a little ahead and a little up.
function Motor.eyePosition(self: any): Vector3
	local frame = SupportMath.bodyCFrame(self.pos, self.up, self.heading)
	return self.pos + frame.LookVector * EYE_FORWARD + frame.UpVector * EYE_UP
end

-- The facing tilted by the gaze pitch about the body's right: where the eyes point with the retinas centred (Godot get_body_gaze_direction).
function Motor.bodyGazeDirection(self: any): Vector3
	local frame = SupportMath.bodyCFrame(self.pos, self.up, self.heading)
	return (frame.LookVector * math.cos(self.gazePitch) + frame.UpVector * math.sin(self.gazePitch)).Unit
end

-- The axis of the inspection cone (Godot get_gaze_direction). The body's own gaze, unless the spider-eye view has pointed the principal
-- eyes' retinas elsewhere (the scan direction): then that direction, held within PRINCIPAL_SCAN_DEG of the body's gaze.
function Motor.gazeDirection(self: any): Vector3
	local axis = self:bodyGazeDirection()
	local scan: Vector3? = self.scanDir
	if scan == nil then
		return axis
	end
	if SupportMath.angleTo(axis, scan) <= PRINCIPAL_SCAN then
		return scan
	end
	local turn = axis:Cross(scan)
	if turn:Dot(turn) < 1e-10 then
		return axis
	end
	return (CFrame.fromAxisAngle(turn.Unit, PRINCIPAL_SCAN) * axis).Unit
end

-- What the senses read of the body (Sensor.step's observer): the eyes, the axis of the cone, the body's up and its facing. Never the camera.
function Motor.observer(self: any): { eye: Vector3, gaze: Vector3, up: Vector3, heading: Vector3 }
	return { eye = self:eyePosition(), gaze = self:gazeDirection(), up = self.up, heading = self.heading }
end

function Motor.scanDirection(self: any): Vector3?
	return self.scanDir
end

-- True while Focus is turning the gaze: held, or the spider-eye view turning the body to face the gaze (Godot is_focusing).
function Motor.isFocusing(self: any): boolean
	return self.focusOn
end

local function moveToward(from: number, to: number, maxStep: number): number
	if math.abs(to - from) <= maxStep then
		return to
	end
	return from + math.sign(to - from) * maxStep
end

-- The direction Focus aims the gaze (Godot player_controller.focus_direction): from the eyes to the point the camera's centre ray meets,
-- or along that ray when the point is within 0.2 WU of them.
function Motor._focusDirection(self: any, input: TickInput): Vector3?
	local point = input.focusPoint
	if point == nil then
		return nil
	end
	local to = point - self:eyePosition()
	if to.Magnitude > 0.2 then
		return to.Unit
	end
	local ray = input.focusDir
	return if ray ~= nil and ray.Magnitude > 1e-4 then ray.Unit else nil
end

-- Godot _update_gaze: the gaze tilts toward the focus direction (within the gaze limit) while Focus is held on a support, and settles back to
-- the support plane, at half that rate, when it is not. T10a: in the spider-eye view it tilts, at that half rate, toward the scan direction;
-- while the body turns to face that gaze it has the full rate, as Focus does.
function Motor._updateGaze(self: any, input: TickInput)
	local wanted, rate = 0.0, FOCUS_RATE * 0.5
	local supported = self.mode == "attached"
	local focus = self:_focusDirection(input)
	local scan: Vector3? = self.scanDir
	self.focusOn = focus ~= nil
	if supported and focus == nil and scan ~= nil and self.eyeTurning and not self.preparing then
		focus = scan
		self.focusOn = true
	end
	if supported and focus ~= nil then
		wanted = math.clamp(math.asin(math.clamp(focus:Dot(self.up), -1, 1)), -self.gazeLimit, self.gazeLimit)
		rate = FOCUS_RATE
	elseif supported and scan ~= nil then
		wanted = math.clamp(math.asin(math.clamp(scan:Dot(self.up), -1, 1)), -self.gazeLimit, self.gazeLimit)
	end
	self.gazePitch = moveToward(self.gazePitch, wanted, rate * DT)
end

-- ---------------------------------------------------------------- the fixed tick
function Motor._turnToward(self: any, dir: Vector3, rate: number)
	local t = SupportMath.tangentDir(dir, self.up)
	if t ~= Vector3.zero then
		self.heading = SupportMath.tangentDir(SupportMath.rotateToward(self.heading, t, rate * DT), self.up)
	end
end

-- Focus (PlayerController.focus_direction) and the spider-eye turn: standing still, the body turns to look.
function Motor._lookTurns(self: any, input: TickInput, stickIdle: boolean)
	if input.focusPoint then
		local eye = self.pos + self.heading * 0.45
		local to = input.focusPoint - eye
		if to.Magnitude > 0.2 then self:_turnToward(to, FOCUS_RATE) end
		self.eyeTurning = false
		return
	end
	if not input.gaze or not stickIdle then
		self.eyeTurning = false
		return
	end
	local look = SupportMath.tangentDir(input.gaze, self.up)
	if look == Vector3.zero then return end
	local off = math.deg(SupportMath.angleTo(self.heading, look))
	if not self.eyeTurning and off > EYE_TURN_START_DEG then
		self.eyeTurning = true
	elseif self.eyeTurning and off < EYE_TURN_STOP_DEG then
		self.eyeTurning = false
	end
	if self.eyeTurning then self:_turnToward(look, FOCUS_RATE) end
end

function Motor._outOfBounds(self: any, p: Vector3): boolean
	local lo, hi = self.config.boundsMin, self.config.boundsMax
	return p.X < lo.X or p.Y < lo.Y or p.Z < lo.Z or p.X > hi.X or p.Y > hi.Y or p.Z > hi.Z
end

-- Leaving the play area puts the spider back at its last supported spot (Godot _reset_out_of_bounds).
function Motor._backToSafety(self: any)
	local safe = self.safe
	self:place(safe.pos, safe.up, safe.heading)
	self:_event("out_of_bounds")
end

function Motor._tickAttached(self: any, input: TickInput)
	local silk = self.silk
	local preparing = self.preparing
	local manual = if preparing then Vector3.zero else input.wish
	if silk.walk and manual.Magnitude > 0 then self:cancelWalk() end
	local dir = if preparing then Vector3.zero elseif silk.walk then silk.walk.direction else manual
	if silk.walk then
		silk.walk.ticks -= 1
		if silk.walk.ticks <= 0 then
			silk.walk = nil
			silk.message = "Edge walk stopped"
			self:_event("drop_refused", "stuck")
			return
		end
	end
	self.moving = dir ~= Vector3.zero
	self.intent = dir
	if preparing then
		local target = self.aimTarget
		if target then self:_turnToward(target - self.pos, PREPARE_TURN_RATE) end
	elseif not silk.walk then
		self:_lookTurns(input, not self.moving)
	end
	if not self.moving then
		-- Re-seat on the support so a vanished or moved surface is noticed.
		local below = self:_ray(self.pos + self.up * 0.1, -self.up * (HEIGHT + 0.35))
		if not self:attachable(below) and not (below and self:supports(self:profileOf(below.Instance), below.Normal)) then
			self.mode = "air"
			self.vel = Vector3.zero
			self.preparing = false
			self.flightTicks, self.flightLimit = 0, 0
		else
			self.safe = { pos = self.pos, up = self.up, heading = self.heading }
		end
		return
	end
	local stalk = input.creep and not silk.walk
	local speed = if stalk then self.loco.stalk_speed_wu_s else self.loco.walk_speed_wu_s
	self.heading = SupportMath.tangentDir(SupportMath.rotateToward(self.heading, dir, TURN_RATE * DT), self.up)
	local step = dir * speed * DT
	-- Concave corner: a wall (or a leaf's edge, a stem) ahead becomes the new support.
	local ahead = self:_ray(self.pos, dir * (HEIGHT + step.Magnitude + 0.02))
	if ahead and self:attachable(ahead) and SupportMath.angleTo(ahead.Normal, self.up) > math.rad(20) then
		self:_transition(ahead)
		return
	end
	local nextPos = self.pos + step
	local below = self:_ray(nextPos + self.up * 0.25, -self.up * (HEIGHT + 0.5))
	if below and self:attachable(below) and SupportMath.angleTo(below.Normal, self.up) < math.rad(60) then
		local n = SupportMath.filterNormal(self.up, below.Normal, 2.0)
		self.up = n
		self.pos = below.Position + n * HEIGHT
		self.heading = SupportMath.tangentDir(self.heading, n)
		self.safe = { pos = self.pos, up = self.up, heading = self.heading }
		return
	end
	if silk.walk then
		-- The walk reached the edge: let down from here (edge-first lowering).
		if self:_beginDrop(dir) then self.pos = nextPos + dir * (HEIGHT + 0.02) end
		return
	end
	-- Convex edge: wrap over it onto the face beyond (sill edge, leaf rim, the top of a wall).
	local around = self:_ray(nextPos - self.up * (HEIGHT + 0.15), -dir * 1.0)
	if around and self:attachable(around) then
		self:_transition(around)
		return
	end
	self.mode = "air"
	self.vel = dir * speed
	self.flightTicks, self.flightLimit = 0, 0
end

function Motor._tickLine(self: any, input: TickInput)
	local silk = self.silk
	-- On the line (spec 17's context override): forward reels in, back lowers, F held lowers, a held Q lets go.
	local intent = if input.dropHeld then math.min(input.reel, 0) - 1 else input.reel
	local p, v, hit = silk:step(self.pos, self.vel, math.clamp(intent, -1, 1), input.releaseHeld == true)
	self.pos, self.vel = p, v
	if hit then
		self:_setSupport(hit)
		self.vel = Vector3.zero
		self.mode = "attached"
		silk:clear()
		self:_event("completed")
		self.safe = { pos = self.pos, up = self.up, heading = self.heading }
		return
	end
	if silk.mode == "none" then
		self:_event(if silk.message == "Silk anchor lost" then "lost" else "released")
		self.flightTicks, self.flightLimit = 0, 0
		return
	end
	if silk.taut and not self.caught then
		self.caught = true
		self:_event("caught")
	end
	if silk.snagged and not self.snagSeen then self:_event("snagged") end
	self.snagSeen = silk.snagged
	self.up = SupportMath.rotateToward(self.up, Vector3.yAxis, FREE_UP_RATE * DT)
	if self:_outOfBounds(self.pos) then self:_backToSafety() end
end

function Motor._lock(self: any, at: Vector3)
	self.silk:lock(at, 0.25)
	self.afterMiss = true
	self.caught = false
	self:_event("locked")
end

function Motor._tickAir(self: any, input: TickInput)
	local silk = self.silk
	if silk.mode == "locked" then
		self:_tickLine(input)
		return
	end
	self.flightTicks += 1
	local from = self.pos
	self.vel += self.gravity * DT
	local to = from + self.vel * DT
	local travel = to - from
	local dir = if travel.Magnitude > 1e-6 then travel.Unit else -self.up
	local hit = self:_ray(from, dir * (travel.Magnitude + HEIGHT))
	if hit then
		local approach = -self.vel:Dot(hit.Normal)
		if self:supports(self:profileOf(hit.Instance), hit.Normal) and approach >= JumpMath.minApproach(hit.Normal) then
			local heading = SupportMath.tangentDir(self.vel, hit.Normal)
			self:_setSupport(hit)
			if heading ~= Vector3.zero then self.heading = heading end
			self.vel = Vector3.zero
			self.mode = "attached"
			if silk.mode ~= "none" then self:_event("landed") end
			silk:clear()
			self.safe = { pos = self.pos, up = self.up, heading = self.heading }
			return
		end
		-- Not landable here: the line locks (a miss), and the body slides along it.
		if silk.mode == "payout" then self:_lock(self.pos) end
		self.vel -= hit.Normal * math.min(0, self.vel:Dot(hit.Normal))
		to = hit.Position + hit.Normal * HEIGHT
	end
	self.pos = to
	silk:payout(to)
	if silk.mode == "payout" and self.flightTicks >= self.flightLimit then self:_lock(to) end
	-- The drawn body turns upright while falling.
	self.up = SupportMath.rotateToward(self.up, Vector3.yAxis, FREE_UP_RATE * DT)
	if self:_outOfBounds(to) then self:_backToSafety() end
end

-- One fixed 1/60 s tick of the body.
function Motor.tick(self: any, input: TickInput)
	self.ticks += 1
	local scan = input.gaze
	self.scanDir = if scan ~= nil and scan.Magnitude > 1e-4 then scan.Unit else nil
	if self.mode == "attached" then
		self:_tickAttached(input)
	else
		self.preparing = false
		self:_tickAir(input)
	end
	self:_updateGaze(input)
end

return Motor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">StickCarry</string>
            <string name="Source"><![CDATA[--!strict
-- The carry over an edge: a port of the frozen Godot scripts/movement/player_controller.gd _carry (c87ce00).
-- On a wall, forward is up; on a floor, away from the camera. So holding the stick forward over a sharp edge would flip
-- the camera mapping and walk the spider straight back (it would oscillate at the edge). When the support turns sharply
-- (the motor's transitionSerial changes) while the stick is held, the motor's own direction, which it turned with the
-- support, is kept instead of the fresh mapping. The carry ends when the stick is released or turned by more than
-- CARRY_STICK_DEG, or when the fresh mapping agrees with the carried direction again (within CARRY_AGREE_DEG). Pure.
local StickCarry = {}
StickCarry.__index = StickCarry

StickCarry.CARRY_STICK_DEG = 30.0
StickCarry.CARRY_AGREE_DEG = 25.0

function StickCarry.new(): any
	return setmetatable({ carrying = false, sx = 0, sy = 0, lastSerial = 0 }, StickCarry)
end

local function angleBetween(a: Vector3, b: Vector3): number
	return math.atan2(a:Cross(b).Magnitude, a:Dot(b))
end

-- stick x right, y forward; fresh: the camera mapping on the support now; serial: the motor's transition count;
-- carried: the motor's own walking direction (turned with the support); inTransition: rounding an edge.
function StickCarry.step(self: any, sx: number, sy: number, fresh: Vector3, serial: number, carried: Vector3, inTransition: boolean): Vector3
	local turned = serial ~= self.lastSerial
	self.lastSerial = serial
	local length = math.sqrt(sx * sx + sy * sy)
	if length * length < 1e-8 then
		self.carrying = false
		return Vector3.zero
	end
	local nx, ny = sx / length, sy / length
	if turned and not self.carrying then
		self.carrying = true
		self.sx, self.sy = nx, ny
	end
	if not self.carrying then return fresh end
	if math.acos(math.clamp(nx * self.sx + ny * self.sy, -1, 1)) > math.rad(StickCarry.CARRY_STICK_DEG) then
		self.carrying = false
		return fresh
	end
	if carried:Dot(carried) < 1e-8 then
		self.carrying = false
		return fresh
	end
	local dir = carried.Unit
	if not inTransition and fresh:Dot(fresh) > 1e-8 and angleBetween(fresh.Unit, dir) < math.rad(StickCarry.CARRY_AGREE_DEG) then
		self.carrying = false
		return fresh
	end
	return dir * math.min(length, 1)
end

return StickCarry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">SupportMath</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/movement/support_math.gd (spec 6.1, 6.2). Pure geometry for supported locomotion; unit vectors in world space.

local SupportMath = {}

local RIGHT = Vector3.new(1, 0, 0)
local BACK = Vector3.new(0, 0, 1)

local function angleTo(a: Vector3, b: Vector3): number
	return math.atan2(a:Cross(b).Magnitude, a:Dot(b))
end
SupportMath.angleTo = angleTo

-- The part of v that lies in the plane with unit normal n.
function SupportMath.tangent(v: Vector3, n: Vector3): Vector3
	return v - n * v:Dot(n)
end

-- Unit direction of v on the plane with normal n, or zero when v is (nearly) along n.
function SupportMath.tangentDir(v: Vector3, n: Vector3, eps: number?): Vector3
	local t = SupportMath.tangent(v, n)
	local length = t.Magnitude
	return if length > (eps or 1e-5) then t / length else Vector3.zero
end

-- Hysteresis for the support normal: a candidate within ignoreDeg of the current one is ignored.
function SupportMath.filterNormal(current: Vector3, candidate: Vector3, ignoreDeg: number): Vector3
	if candidate:Dot(candidate) < 1e-10 or candidate.Magnitude ~= candidate.Magnitude then
		return current
	end
	local c = candidate.Unit
	if current:Dot(current) < 1e-10 then
		return c
	end
	if angleTo(current.Unit, c) <= math.rad(ignoreDeg) then
		return current
	end
	return c
end

function SupportMath.anyPerpendicular(v: Vector3): Vector3
	local other = if math.abs(v.Unit.X) < 0.9 then RIGHT else BACK
	return v:Cross(other).Unit
end

-- Turns unit vector `from` toward `to` by at most maxAngle radians (shortest arc).
function SupportMath.rotateToward(from: Vector3, to: Vector3, maxAngle: number): Vector3
	local angle = angleTo(from, to)
	if angle <= maxAngle or angle < 1e-6 then
		return to
	end
	local axis = from:Cross(to)
	if axis:Dot(axis) < 1e-12 then
		axis = SupportMath.anyPerpendicular(from)
	end
	return (CFrame.fromAxisAngle(axis.Unit, maxAngle) * from).Unit
end

-- Signed angle from a to b about axis n.
function SupportMath.signedAngle(a: Vector3, b: Vector3, n: Vector3): number
	return math.atan2(n:Dot(a:Cross(b)), a:Dot(b))
end

-- Body frame for an up vector and a heading: Y is up, -Z (LookVector) is the heading made perpendicular to up.
function SupportMath.bodyCFrame(position: Vector3, up: Vector3, heading: Vector3): CFrame
	local u = up.Unit
	local f = SupportMath.tangentDir(heading, u)
	if f == Vector3.zero then
		f = SupportMath.anyPerpendicular(u)
	end
	local z = -f
	local x = u:Cross(z).Unit
	return CFrame.fromMatrix(position, x, u, z)
end

return SupportMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">TetherMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pure safety-line operations from frozen Godot tether.gd / spider_motor.gd.
-- No renderer, wall clock, Roblox services or collision decisions here.
local T = {}
T.BRAKE = 0.25
T.MIN_REST = 0.4
T.DROP_SLACK = 0.5
T.DAMPING = 1.6
T.DT = 1/60

function T.constrain(pivot: Vector3, length: number, target: Vector3, velocity: Vector3)
	local d = target-pivot
	local distance = d.Magnitude
	local out = {position=target, velocity=velocity, acted=false, radial_before=0, radial_after=0,
		tangential_change=0, distance_before=distance, distance_after=distance}
	if distance < 1e-9 then return out end
	local radial = d/distance
	local speed = velocity:Dot(radial)
	out.radial_before, out.radial_after = speed, speed
	if distance <= length then return out end
	local v = if speed > 0 then velocity-radial*speed else velocity
	out.position = pivot+radial*math.max(length,0)
	out.velocity, out.acted = v, true
	out.radial_after = v:Dot(radial)
	out.tangential_change = ((v-radial*v:Dot(radial))-(velocity-radial*speed)).Magnitude
	out.distance_after = math.max(length,0)
	return out
end
function T.energy(position: Vector3, velocity: Vector3, gravity: number): number
	return 0.5*velocity:Dot(velocity)+gravity*position.Y
end
function T.reelWorkBound(shortening: number, gravity: number, speed: number, length: number): number
	return math.max(shortening,0)*(gravity+speed*speed/math.max(length,0.05))
end
function T.sagDepth(span: number, length: number): number
	local extra = length-span
	if extra <= 1e-4 or span < 1e-4 then return 0 end
	return math.min(math.sqrt(3*span*extra/8),3)
end
function T.lock(paid: number, path: number, maximum: number, extension: number): (number,number)
	local p = math.min(math.max(paid,path),maximum)
	return p,math.min(p+math.max(extension,0),maximum)
end
function T.reel(rest: number, prefix: number, maximum: number, intent: number, speed: number): number
	return math.clamp(rest-math.clamp(intent,-1,1)*speed*T.DT,math.min(prefix+T.MIN_REST,maximum),maximum)
end

-- A press that started before the grace period can NEVER become a release later.
function T.newRelease()
	return {ticks=0, held=0, down=false, counts=false, progress=0}
end
function T.releaseTick(s: any, onLine: boolean, down: boolean): boolean
	s.ticks = if onLine then s.ticks+1 else 0
	if down and not s.down then s.counts = onLine and s.ticks>=24; s.held=0 end
	if not down or not onLine then s.counts=false; s.held=0 end
	s.down = down
	s.held = if s.counts then s.held+1 else 0
	s.progress = math.min(s.held/36,1)
	if s.progress>=1 then s.counts=false; s.held=0; s.progress=0; return true end
	return false
end
return T
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Perception</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Observation</string>
            <string name="Source"><![CDATA[--!strict
-- Observation (spec 21.3): one piece of sensed evidence, as the sensor makes it and the memory keeps it. A port of the frozen
-- Godot scripts/perception/observation.gd (c87ce00), field for field. Observer, target (only when resolved), estimated position,
-- modality, confidence in [0, 1], the tick it was observed at (an integer action tick) and a category. It is never refreshed from
-- hidden truth: an observation is only ever made from what the observer could see at `observedTick`, and a later one is a new record.
--
-- Two modalities (spec 7):
--   PERIPHERAL  broad coverage, a coarse direction only, no position and no category beyond "movement". The target is not resolved.
--   INSPECTION  the forward cone: a position (to within the target's own size), a category that refines with continuous exposure
--               (movement, possible prey, fly-like prey: A-004), and the target once it is resolved.
-- Words for the categories belong to the presentation, never here. Pure: no engine services, so the plain Luau CLI runs it.
--
-- Naming: Godot's snake_case fields are camelCase here (track_id -> trackId, speed_wu_s -> speedWuS); the values are unchanged.
local Observation = {}
Observation.__index = Observation

Observation.PERIPHERAL = "peripheral_motion"
Observation.INSPECTION = "forward_inspection"

Observation.MOVEMENT = "movement"
Observation.POSSIBLE_PREY = "possible_prey"
Observation.FLY_LIKE_PREY = "fly_like_prey"
-- Refinement order: each is a finer guess than the one before it. No species is ever named (A-004).
Observation.CATEGORIES = table.freeze({ "movement", "possible_prey", "fly_like_prey" })

export type Observation = {
	observerId: string,
	-- The target's persistent id once the observer has resolved it (inspected it long enough), else "".
	targetId: string,
	-- Opaque id the sensor gives one thing it keeps sensing, so the memory can follow it. It is not the target's id.
	trackId: string,
	-- The estimate; meaningful only when hasPosition. A peripheral observation has none: only `direction`.
	estimatedPosition: Vector3,
	hasPosition: boolean,
	-- Unit direction from the observer to the thing, as sensed: exact enough to aim at for an inspection, quantised to a sector
	-- for a peripheral cue.
	direction: Vector3,
	modality: string,
	confidence: number,
	observedTick: number,
	category: string,
	-- Estimated size of the thing, WU (an inspection only). The memory uses it to judge whether a place could hide it.
	sizeWu: number,
	-- How large it looked, degrees of angle across.
	apparentSizeDeg: number,
	-- How fast it was seen moving, WU/s (an inspection only). A lost contact's plausible region grows at least this fast (A-027).
	speedWuS: number,
}

local function isFinite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function vectorIsFinite(v: Vector3): boolean
	return isFinite(v.X) and isFinite(v.Y) and isFinite(v.Z)
end

-- A new record with Godot's defaults (a peripheral movement cue straight ahead with nothing in it); `fields` overrides any of them.
function Observation.new(fields: { [string]: any }?): Observation
	local o = {
		observerId = "",
		targetId = "",
		trackId = "",
		estimatedPosition = Vector3.zero,
		hasPosition = false,
		direction = Vector3.new(0, 0, -1), -- Godot's Vector3.FORWARD (both engines look down -Z)
		modality = Observation.PERIPHERAL,
		confidence = 0.0,
		observedTick = 0,
		category = Observation.MOVEMENT,
		sizeWu = 0.0,
		apparentSizeDeg = 0.0,
		speedWuS = 0.0,
	}
	if fields then
		for k, v in fields do
			(o :: any)[k] = v
		end
	end
	return setmetatable(o, Observation) :: any
end

-- The place of a category in the refinement order: 0 movement, 1 possible prey, 2 fly-like prey; -1 for anything else (Godot's Array.find).
function Observation.rank(c: string): number
	local i = table.find(Observation.CATEGORIES, c)
	return if i then i - 1 else -1
end

-- Problems with the record, empty when it is fine: the invariants of spec 21.3 (no NaN or infinity, confidence in [0, 1], a known
-- modality and category, a position only for an inspection).
function Observation.problems(o: Observation): { string }
	local out: { string } = {}
	if o.observerId == "" then
		table.insert(out, "no observer")
	end
	if o.trackId == "" then
		table.insert(out, "no track")
	end
	if not (o.modality == Observation.PERIPHERAL or o.modality == Observation.INSPECTION) then
		table.insert(out, `unknown modality '{o.modality}'`)
	end
	if not table.find(Observation.CATEGORIES, o.category) then
		table.insert(out, `unknown category '{o.category}'`)
	end
	if not isFinite(o.confidence) or o.confidence < 0.0 or o.confidence > 1.0 then
		table.insert(out, `confidence {o.confidence} is not in [0, 1]`)
	end
	if o.observedTick < 0 then
		table.insert(out, "negative tick")
	end
	if not vectorIsFinite(o.direction) or math.abs(o.direction.Magnitude - 1.0) > 1e-3 then
		table.insert(out, "direction is not a unit vector")
	end
	if o.hasPosition and not vectorIsFinite(o.estimatedPosition) then
		table.insert(out, "estimated position is not finite")
	end
	if o.modality == Observation.PERIPHERAL and o.hasPosition then
		table.insert(out, "a peripheral observation carries no position")
	end
	if o.modality == Observation.PERIPHERAL and (o.category ~= Observation.MOVEMENT or o.targetId ~= "") then
		table.insert(out, "a peripheral observation has no category beyond movement and no resolved target")
	end
	if o.modality == Observation.INSPECTION and not o.hasPosition then
		table.insert(out, "an inspection carries a position")
	end
	if not isFinite(o.speedWuS) or o.speedWuS < 0.0 then
		table.insert(out, "speed is not a finite, non-negative number")
	end
	return out
end

function Observation.isValid(o: Observation): boolean
	return #Observation.problems(o) == 0
end

-- The spec's fields as a plain table; the position is nil unless the record carries one (a cue's record has no position to read).
function Observation.toDict(o: Observation): { [string]: any }
	return {
		observerId = o.observerId,
		targetId = o.targetId,
		trackId = o.trackId,
		estimatedPosition = if o.hasPosition then o.estimatedPosition else nil,
		direction = o.direction,
		modality = o.modality,
		confidence = o.confidence,
		observedTick = o.observedTick,
		category = o.category,
	}
end

return Observation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ObservationMemory</string>
            <string name="Source"><![CDATA[--!strict
-- ObservationMemory (spec 7, 21.3): what the observer remembers of what it sensed. A port of the frozen Godot
-- scripts/perception/observation_memory.gd (c87ce00), method for method. The sensor hands it Observation records; it keeps one Contact
-- per thing the sensor keeps sensing (a "track"), ages them, and says what is still sensed, what has been lost and what has gone. It
-- never looks at the world: a contact changes only when an observation arrives, when time passes, or when the sensor reports that the
-- remembered spot was inspected and is empty.
--
-- A contact is LIVE while observations keep coming (a peripheral cue repeats every cue cooldown, an inspection every tick) and LOST once
-- none has arrived for the hold time of its modality. A lost contact's confidence falls in a straight line from what it was at the loss to
-- nothing over `decayS` (6 s), and the contact is forgotten at that point. A lost contact that was inspected has a mark (A-002): its last
-- observed position, which never moves, because the only thing that can move a position is a new inspection.
--
-- Which contact an observation belongs to is the sensor's decision, taken from evidence (A-027, D-040): a contact is the spider's
-- hypothesis that some observations are of one visible thing, not the thing's identity in the world. The memory only keeps what it is
-- told, and can fold a contact it knew only from cues into the lost contact it turned out to be (merge). The world id of a thing it is
-- looking at is kept on the contact for as long as sight lasts (targetId) and dropped the moment sight is lost.
--
-- What a peripheral cue may and may not do (spec 7: coarse directional evidence, no label): it starts a contact, and it keeps a contact
-- that is only cues alive. It never gives a position, never changes the category, the confidence or the position of a contact that has
-- been inspected, and never brings an inspected contact back from lost: that takes another inspection (a reacquisition). What the cue
-- did say, a bearing, is kept apart (cueTick, cueDirection) for the presentation's edge markers.
--
-- Differences from Godot that change no decision: the five signals are Signal objects (memory.contactAcquired:connect(fn)); contacts
-- are walked oldest first (creation order) wherever Godot walks a dictionary, so announcements come in a fixed order.
local Observation = require(script.Parent.Observation)
local PerceptionMath = require(script.Parent.PerceptionMath)
local Signal = require(script.Parent.Signal)

local PERIPHERAL, INSPECTION = Observation.PERIPHERAL, Observation.INSPECTION

-- =============================================================================================== Contact

local Contact = {}
Contact.__index = Contact
Contact.LIVE = "live"
Contact.LOST = "lost"

export type Contact = {
	trackId: string,
	observerId: string,
	-- The world id of the thing this contact is live-linked to (spec 21.3: target, only when resolved), for validated interaction and
	-- nothing else. Set while an inspection has resolved the thing, dropped the moment the contact is lost, and never used to decide
	-- which contact an observation belongs to (A-027).
	targetId: string,
	state: string,
	-- Modality of the latest evidence that updated the record (a cue on an inspected contact does not).
	modality: string,
	category: string,
	-- What the contact is believed to be worth now: the latest evidence's while live, falling after a loss.
	confidence: number,
	confidenceAtLoss: number,
	-- The last observed position: only an inspection gives one, and only another inspection changes it.
	hasPosition: boolean,
	position: Vector3,
	positionTick: number,
	sizeWu: number,
	apparentSizeDeg: number,
	-- How fast it was seen moving at the last inspection, WU/s.
	speedWuS: number,
	-- Latest direction from the observer of the evidence that updated the record (coarse for a cue).
	direction: Vector3,
	firstTick: number,
	-- Tick of the latest evidence that updated the record.
	observedTick: number,
	-- The latest peripheral cue, apart from the record: its tick, its coarse bearing and how many there have been.
	cueTick: number,
	cueDirection: Vector3,
	cueCount: number,
	lostTick: number,
	reacquisitions: number,
	-- False once the mark was found to be wrong (the spot was inspected and is empty).
	markValid: boolean,
	-- Creation order: "oldest first" breaks ties with it.
	seq: number,
}

function Contact.new(): Contact
	return setmetatable({
		trackId = "",
		observerId = "",
		targetId = "",
		state = Contact.LIVE,
		modality = PERIPHERAL,
		category = Observation.MOVEMENT,
		confidence = 0.0,
		confidenceAtLoss = 0.0,
		hasPosition = false,
		position = Vector3.zero,
		positionTick = 0,
		sizeWu = 0.0,
		apparentSizeDeg = 0.0,
		speedWuS = 0.0,
		direction = Vector3.new(0, 0, -1),
		firstTick = 0,
		observedTick = 0,
		cueTick = -1000000,
		cueDirection = Vector3.zero,
		cueCount = 0,
		lostTick = 0,
		reacquisitions = 0,
		markValid = true,
		seq = 0,
	}, Contact) :: any
end

function Contact.isLive(c: Contact): boolean
	return c.state == Contact.LIVE
end

-- Live and being inspected: the position is where it is being seen now.
function Contact.isInspectedNow(c: Contact): boolean
	return c.state == Contact.LIVE and c.modality == INSPECTION
end

function Contact.hasMark(c: Contact): boolean
	return c.state == Contact.LOST and c.hasPosition and c.markValid
end

function Contact.toDict(c: Contact): { [string]: any }
	return {
		trackId = c.trackId,
		targetId = c.targetId,
		state = c.state,
		modality = c.modality,
		category = c.category,
		confidence = c.confidence,
		hasPosition = c.hasPosition,
		position = if c.hasPosition then c.position else nil,
		observedTick = c.observedTick,
		positionTick = c.positionTick,
		lostTick = c.lostTick,
	}
end

-- =============================================================================================== Memory

local ObservationMemory = {}
ObservationMemory.__index = ObservationMemory
ObservationMemory.Contact = Contact

export type ObservationMemory = {
	-- Ticks a second lasts (the physics rate), the seconds a lost contact's confidence takes to fall to nothing, and how long a contact
	-- may go without new evidence before it counts as lost.
	hz: number,
	decayS: number,
	holdInspectionS: number,
	holdPeripheralS: number,
	-- The tick the memory was last advanced to.
	nowTick: number,
	-- How many observations were ever ingested, by modality; for tests and the debug view.
	ingested: number,
	ingestedInspection: number,
	ingestedPeripheral: number,
	-- A new contact, or a track picked up again after it had been forgotten.
	contactAcquired: Signal.Signal,
	-- (contact, oldCategory, newCategory): the category a contact is believed to be refined (up) or fell back (down).
	categoryChanged: Signal.Signal,
	-- Sight of a contact ended: its hold time ran out with no new observation.
	contactLost: Signal.Signal,
	-- A lost contact was observed again: the same track, its record updated.
	contactReacquired: Signal.Signal,
	-- (contact, reason): a contact left the memory: "expired" (its confidence reached nothing), "empty" (the sensor inspected the
	-- remembered spot and found nothing there), "merged" (a contact known only from cues turned out to be a lost one) or "captured".
	contactEnded: Signal.Signal,
	_contacts: { [string]: Contact },
	_seq: number,
}

function ObservationMemory.new(): any
	return setmetatable({
		hz = 60.0,
		decayS = 6.0,
		holdInspectionS = 0.15,
		holdPeripheralS = 1.0,
		nowTick = 0,
		ingested = 0,
		ingestedInspection = 0,
		ingestedPeripheral = 0,
		contactAcquired = Signal.new(),
		categoryChanged = Signal.new(),
		contactLost = Signal.new(),
		contactReacquired = Signal.new(),
		contactEnded = Signal.new(),
		_contacts = {},
		_seq = 0,
	}, ObservationMemory)
end

function ObservationMemory.configure(self: any, hz: number, decayS: number, holdInspectionS: number, holdPeripheralS: number)
	self.hz = math.max(hz, 1.0)
	self.decayS = math.max(decayS, 0.01)
	self.holdInspectionS = math.max(holdInspectionS, 0.0)
	self.holdPeripheralS = math.max(holdPeripheralS, 0.0)
end

function ObservationMemory.clear(self: any)
	self._contacts = {}
end

function ObservationMemory.getContact(self: any, trackId: string): Contact?
	return self._contacts[trackId]
end

function ObservationMemory.count(self: any): number
	local n = 0
	for _ in self._contacts do
		n += 1
	end
	return n
end

-- Every contact, oldest first.
function ObservationMemory.contacts(self: any): { Contact }
	local out: { Contact } = {}
	for _, c in self._contacts do
		table.insert(out, c)
	end
	table.sort(out, function(a: Contact, b: Contact): boolean
		if a.firstTick ~= b.firstTick then
			return a.firstTick < b.firstTick
		end
		return a.seq < b.seq
	end)
	return out
end

local function filtered(list: { Contact }, keep: (Contact) -> boolean): { Contact }
	local out: { Contact } = {}
	for _, c in list do
		if keep(c) then
			table.insert(out, c)
		end
	end
	return out
end

function ObservationMemory.liveContacts(self: any): { Contact }
	return filtered(self:contacts(), function(c) return c.state == Contact.LIVE end)
end

function ObservationMemory.lostContacts(self: any): { Contact }
	return filtered(self:contacts(), function(c) return c.state == Contact.LOST end)
end

-- Lost contacts that were inspected and whose spot has not been found empty: the last-seen marks.
function ObservationMemory.marks(self: any): { Contact }
	return filtered(self:contacts(), function(c) return Contact.hasMark(c) end)
end

-- Seconds since sight of a lost contact ended; 0 for a live one.
function ObservationMemory.ageS(self: any, c: Contact): number
	if c.state == Contact.LIVE then
		return 0.0
	end
	return (self.nowTick - c.lostTick) / self.hz
end

-- How much of a thing's earlier inspection still counts if it is seen again: 1 for a live contact, falling to 0 as the memory of a lost one
-- fades, 0 for a track that is gone.
function ObservationMemory.familiarity(self: any, trackId: string): number
	local c = self._contacts[trackId]
	if c == nil then
		return 0.0
	end
	if c.state == Contact.LIVE then
		return 1.0
	end
	return PerceptionMath.decayedConfidence(1.0, self:ageS(c), self.decayS)
end

-- Seconds since the evidence that last updated the record.
function ObservationMemory.observedAgeS(self: any, c: Contact): number
	return (self.nowTick - c.observedTick) / self.hz
end

-- Seconds since the latest peripheral cue (a very large number if there never was one).
function ObservationMemory.cueAgeS(self: any, c: Contact): number
	return (self.nowTick - c.cueTick) / self.hz
end

-- 0 for a live contact and for one just lost, 1 when its memory is gone (the mark is at its stalest).
function ObservationMemory.stalenessOf(self: any, c: Contact): number
	if c.state == Contact.LIVE then
		return 0.0
	end
	return PerceptionMath.staleness(self:ageS(c), self.decayS)
end

-- Ticks a contact may go without evidence of this modality before it counts as lost. The sensor reads the same number to tell unbroken
-- sight (the thing is still the same contact) from sight that was lost.
function ObservationMemory.holdTicks(self: any, modality: string): number
	return math.round((if modality == INSPECTION then self.holdInspectionS else self.holdPeripheralS) * self.hz)
end

-- Take in one observation. A record that is not valid (spec 21.3) is refused and returns nil.
function ObservationMemory.ingest(self: any, obs: Observation.Observation?): Contact?
	if obs == nil or not Observation.isValid(obs) then
		return nil
	end
	self.ingested += 1
	local existing: Contact? = self._contacts[obs.trackId]
	local fresh = existing == nil
	local wasLost = false
	local c: Contact
	if existing == nil then
		c = Contact.new()
		c.trackId = obs.trackId
		c.observerId = obs.observerId
		c.firstTick = obs.observedTick
		c.category = obs.category
		self._seq += 1
		c.seq = self._seq
		self._contacts[c.trackId] = c
	else
		c = existing
		wasLost = c.state == Contact.LOST
	end
	if obs.modality == PERIPHERAL then
		self.ingestedPeripheral += 1
		c.cueTick = obs.observedTick
		c.cueDirection = obs.direction
		c.cueCount += 1
		if not fresh and c.hasPosition then
			return c -- a bearing says nothing new about something that was inspected (see the header)
		end
	end
	local oldCategory = c.category
	c.state = Contact.LIVE
	c.modality = obs.modality
	c.confidence = obs.confidence
	c.observedTick = obs.observedTick
	c.direction = obs.direction
	if obs.targetId ~= "" then
		c.targetId = obs.targetId
	end
	if obs.modality == INSPECTION then
		self.ingestedInspection += 1
		c.hasPosition = true
		c.position = obs.estimatedPosition
		c.positionTick = obs.observedTick
		c.sizeWu = obs.sizeWu
		c.apparentSizeDeg = obs.apparentSizeDeg
		c.speedWuS = obs.speedWuS
		c.markValid = true
		c.category = obs.category
	end
	if fresh then
		self.contactAcquired:emit(c)
	elseif wasLost then
		c.reacquisitions += 1
		self.contactReacquired:emit(c)
	end
	if c.category ~= oldCategory then
		self.categoryChanged:emit(c, oldCategory, c.category)
	end
	return c
end

-- The ids of the contacts, oldest first (the order Godot's dictionary keeps them in).
local function orderedIds(self: any): { string }
	local list: { Contact } = {}
	for _, c in self._contacts do
		table.insert(list, c)
	end
	table.sort(list, function(a: Contact, b: Contact): boolean
		return a.seq < b.seq
	end)
	local ids: { string } = {}
	for _, c in list do
		table.insert(ids, c.trackId)
	end
	return ids
end

-- Moves time on to `tick`: live contacts that have had no evidence for their hold time become lost, lost contacts lose confidence, and
-- those with none left are forgotten.
function ObservationMemory.advance(self: any, tick: number)
	self.nowTick = tick
	for _, id in orderedIds(self) do
		local c: Contact? = self._contacts[id]
		if c == nil then
			continue
		end
		if c.state == Contact.LIVE then
			if tick - c.observedTick > self:holdTicks(c.modality) then
				c.state = Contact.LOST
				c.lostTick = tick
				c.confidenceAtLoss = c.confidence
				c.targetId = "" -- sight is over: the link to the world goes with it
				self.contactLost:emit(c)
			end
		end
		if c.state == Contact.LOST then
			local age = (tick - c.lostTick) / self.hz
			c.confidence = PerceptionMath.decayedConfidence(c.confidenceAtLoss, age, self.decayS)
			if age >= self.decayS - 1e-9 then
				self._contacts[id] = nil
				self.contactEnded:emit(c, "expired")
			end
		end
	end
end

-- The sensor found that a contact it knew only from cues (it has no position) is the lost contact `intoId`, seen again: the bearing of
-- the latest cue and the count of cues go to that record, and the cue-only contact is dropped (reason "merged"). Returns false when either
-- is missing or the one to fold has a position of its own (an inspected contact is never folded into another).
function ObservationMemory.merge(self: any, fromId: string, intoId: string): boolean
	local a: Contact? = self._contacts[fromId]
	local b: Contact? = self._contacts[intoId]
	if a == nil or b == nil or a == b or a.hasPosition then
		return false
	end
	if a.cueTick > b.cueTick then
		b.cueTick = a.cueTick
		b.cueDirection = a.cueDirection
	end
	b.cueCount += a.cueCount
	self._contacts[fromId] = nil
	self.contactEnded:emit(a, "merged")
	return true
end

-- The sensor looked at a lost contact's last observed position, clearly and for long enough, and nothing was there: the memory of the
-- spot is wrong, so it is dropped. Returns false for a contact that is not lost.
function ObservationMemory.invalidate(self: any, trackId: string, reason: string?): boolean
	local c: Contact? = self._contacts[trackId]
	if c == nil or c.state ~= Contact.LOST then
		return false
	end
	c.markValid = false
	c.confidence = 0.0
	self._contacts[trackId] = nil
	self.contactEnded:emit(c, reason or "empty")
	return true
end

-- The sensor resolved a capture by a live link or unique spatial bodily evidence.
function ObservationMemory.resolveCapture(self: any, trackId: string): boolean
	local c: Contact? = self._contacts[trackId]
	if c == nil then
		return false
	end
	self._contacts[trackId] = nil
	self.contactEnded:emit(c, "captured")
	return true
end

return ObservationMemory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">PerceptionMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pure helpers for the perception layer (spec 7): angles, apparent size, the exposure a classification needs, the evidence's
-- confidence, the coarse direction a peripheral cue is given, how a remembered contact fades. A port of the frozen Godot
-- scripts/perception/perception_math.gd (c87ce00), function for function, with the same numbers. Nothing here touches the scene.
-- Checked against values exported from Godot (tests/perception_reference.json) and against the hand-written expectations of Godot's
-- own unit tests (tests/unit/test_perception_math.gd), both in tests/perception.luau.
local Observation = require(script.Parent.Observation)

local PerceptionMath = {}

local EPS = 1e-6
PerceptionMath.EPS = EPS
-- A peripheral cue is given a direction in sectors of the observer's own bearing, and in coarse bands of elevation.
PerceptionMath.PITCH_BAND_DEG = 30.0
-- Visibility of a sample point (A-024, D-039). A ray the world stops short of its sample point has not seen it: the world is in front of
-- it. The only allowance is for a sample that lies in the skin of the surface the thing rests on or against and for the float error of a
-- long cast: SIGHT_SHARE of the thing's own radius plus SIGHT_FLOAT_PER_WU for each WU of ray, and never more than SIGHT_CEILING.
PerceptionMath.SIGHT_SHARE = 0.1
PerceptionMath.SIGHT_FLOAT_PER_WU = 1.0e-5
PerceptionMath.SIGHT_CEILING = 0.05

local function isFinite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

-- Godot's Vector3.normalized(): a vector with no length stays zero.
local function normalized(v: Vector3): Vector3
	local m = v.Magnitude
	if m == 0 then
		return Vector3.zero
	end
	return v / m
end

-- How far short of its sample point a ray may be stopped by the world and still count as having seen it (A-024). The sample points sit up
-- to 0.8 of the radius off the centre, so for a thing of radius r the allowance is a tenth of r: a speck's whole body is never inside it,
-- and a large thing resting on a wall still has the points that lie in the wall's face counted.
function PerceptionMath.sightTolerance(radius: number, rayLength: number): number
	return math.min(
		PerceptionMath.SIGHT_CEILING,
		PerceptionMath.SIGHT_SHARE * math.max(radius, 0.0) + PerceptionMath.SIGHT_FLOAT_PER_WU * math.max(rayLength, 0.0)
	)
end

-- The furthest a lost contact's thing can be from where it was last observed when something is seen `elapsedS` later (A-027, D-040).
-- Three parts, each an observation or an explicit assumption and none of them the truth about where the thing went: the sizes of the two
-- sightings (a position is only good to about the size of what it was taken from), and the distance the thing could have covered in the
-- time at the conservative speed bound, or at the speed it was last seen moving at if that was greater.
function PerceptionMath.plausibleRadius(oldSizeWu: number, newSizeWu: number, elapsedS: number, speedBound: number, observedSpeed: number): number
	return 0.5 * (math.max(oldSizeWu, 0.0) + math.max(newSizeWu, 0.0)) + math.max(speedBound, observedSpeed) * math.max(elapsedS, 0.0)
end

-- Whether two size estimates can belong to one thing: neither is more than `ratio` times the other. A size that is not known (zero) is
-- compatible with anything.
function PerceptionMath.sizesCompatible(a: number, b: number, ratio: number): boolean
	if a <= EPS or b <= EPS then
		return true
	end
	return math.max(a, b) <= math.min(a, b) * math.max(ratio, 1.0) + EPS
end

-- Whether a lost contact refined to `oldCategory` can be a thing whose appearance can be refined no further than `cap`: what was learned
-- about the one cannot be finer than the other can ever look.
function PerceptionMath.categoriesCompatible(oldCategory: string, cap: string): boolean
	return Observation.rank(oldCategory) <= Observation.rank(cap)
end

-- Angle between two vectors (Godot's Vector3.angle_to, which needs no unit length), radians.
function PerceptionMath.angleTo(a: Vector3, b: Vector3): number
	return math.atan2(a:Cross(b).Magnitude, a:Dot(b))
end

-- Angle between two directions, radians; 0 when either has no length.
function PerceptionMath.angleBetween(a: Vector3, b: Vector3): number
	if a:Dot(a) < EPS * EPS or b:Dot(b) < EPS * EPS then
		return 0.0
	end
	return PerceptionMath.angleTo(normalized(a), normalized(b))
end

-- True when `to` lies within `halfAngle` (radians) of `axis`.
function PerceptionMath.inCone(axis: Vector3, to: Vector3, halfAngle: number): boolean
	return to:Dot(to) > EPS * EPS and PerceptionMath.angleBetween(axis, to) <= halfAngle + 1e-9
end

-- How large a thing of `sizeWu` across looks from `distance`, degrees of angle.
function PerceptionMath.apparentSizeDeg(sizeWu: number, distance: number): number
	if distance <= EPS then
		return 180.0
	end
	return math.deg(2.0 * math.atan(sizeWu * 0.5 / distance))
end

-- Continuous exposure a refinement needs: `baseS` for an easy target (one that looks at least `easyDeg` across), and proportionally
-- longer the smaller it looks. Infinite for something with no apparent size.
function PerceptionMath.requiredExposure(baseS: number, apparentDeg: number, easyDeg: number): number
	if apparentDeg <= EPS then
		return math.huge
	end
	return baseS * math.max(1.0, easyDeg / apparentDeg)
end

-- The category continuous exposure supports. Nothing smaller than `minDeg` is refined at all.
function PerceptionMath.classify(exposureS: number, apparentDeg: number, easyS: number, flyS: number, easyDeg: number, minDeg: number): string
	if apparentDeg < minDeg then
		return Observation.MOVEMENT
	end
	if exposureS + EPS >= PerceptionMath.requiredExposure(flyS, apparentDeg, easyDeg) then
		return Observation.FLY_LIKE_PREY
	end
	if exposureS + EPS >= PerceptionMath.requiredExposure(easyS, apparentDeg, easyDeg) then
		return Observation.POSSIBLE_PREY
	end
	return Observation.MOVEMENT
end

-- Confidence of an inspection: it rises with exposure (to the fly-like refinement) and falls with how much of the thing is hidden. From
-- 0.4 x 0.68 = 0.27 (one of five sample points seen, no exposure yet) to 1.
function PerceptionMath.inspectionConfidence(exposureS: number, flyNeededS: number, visibleFraction: number): number
	local progress = 0.0
	if isFinite(flyNeededS) then
		progress = math.clamp(exposureS / math.max(flyNeededS, EPS), 0.0, 1.0)
	end
	return math.clamp((0.4 + 0.6 * progress) * (0.6 + 0.4 * math.clamp(visibleFraction, 0.0, 1.0)), 0.0, 1.0)
end

-- Confidence of a peripheral cue: low, and a little higher the nearer it is. In [0.1, 0.3].
function PerceptionMath.peripheralConfidence(distance: number, rangeWu: number): number
	return math.clamp(0.1 + 0.2 * (1.0 - distance / math.max(rangeWu, EPS)), 0.1, 0.3)
end

-- The direction of a peripheral cue, coarse: its bearing about `up` from `forward` rounded to a sector, its elevation to a band of
-- PITCH_BAND_DEG. Returns a unit vector. This is all a peripheral observation says about where.
function PerceptionMath.quantizeDirection(dir: Vector3, forward: Vector3, up: Vector3, sectorDeg: number): Vector3
	local d = normalized(dir)
	local u = normalized(up)
	local f = forward - u * forward:Dot(u)
	if f:Dot(f) < EPS then
		f = d - u * d:Dot(u)
	end
	if f:Dot(f) < EPS then
		return d -- straight up or down: there is no bearing to round
	end
	f = normalized(f)
	local right = normalized(f:Cross(u))
	local yaw = math.atan2(d:Dot(right), d:Dot(f))
	local pitch = math.asin(math.clamp(d:Dot(u), -1.0, 1.0))
	local sector = math.rad(math.max(sectorDeg, 0.5))
	local band = math.rad(PerceptionMath.PITCH_BAND_DEG)
	local yq = math.round(yaw / sector) * sector
	local pq = math.round(pitch / band) * band
	return normalized(f * (math.cos(pq) * math.cos(yq)) + right * (math.cos(pq) * math.sin(yq)) + u * math.sin(pq))
end

-- Confidence of a contact that is no longer sensed: it falls straight to nothing over `decayS`, from the confidence it had when it was lost.
function PerceptionMath.decayedConfidence(confidenceAtLoss: number, ageS: number, decayS: number): number
	if decayS <= EPS then
		return 0.0
	end
	return math.clamp(confidenceAtLoss * (1.0 - ageS / decayS), 0.0, 1.0)
end

-- 0 when a contact has only just been lost, 1 when its memory is gone.
function PerceptionMath.staleness(ageS: number, decayS: number): number
	if decayS <= EPS then
		return 1.0
	end
	return math.clamp(ageS / decayS, 0.0, 1.0)
end

return PerceptionMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Sensor</string>
            <string name="Source"><![CDATA[--!strict
-- Sensor: the world half of Godot's SensorSystem (scripts/perception/sensor_system.gd, c87ce00). SensorCore keeps what needs no world (which
-- contact a sighting is filed under, how long a thing has been in view, the cue and its cooldown, the empty-spot check); this is what looks.
-- Each tick it reads the observer's eye and gaze (never the camera's), takes the percept of every perceivable thing and decides what the
-- senses could pick up of it:
--   * a thing inside the broad peripheral field that moves and can be seen through at least one of its sample points gives a PERIPHERAL cue:
--     a coarse bearing and nothing else, at most once per cue cooldown for each thing;
--   * a thing inside the narrow inspection cone along the gaze that can be seen, and looks big enough, is INSPECTED: its position is
--     estimated from the points that could be seen, and the longer it is held in the cone without a break the finer the category.
-- Line of sight is five rays from the eye to sample points of the thing; a point the world stands in front of does not count. Nothing about a
-- thing that cannot be seen reaches the memory: a hidden thing makes no observation, and the memory is never refreshed from where it
-- really is. The sensor also looks at the spots where lost contacts were last seen (SensorCore.checkSpots, through _allVisible below).
--
-- Ported method for method from _physics_process (in its order), _sense, _visible_points, _sample_points, _clear, _all_visible, could_sense,
-- describe_tracks, _record_cost, cost_percentile and reset. Not here: on_capture (the feeding chunk), Focus, and any presentation.
--
-- How a caller drives it: once at the START of every fixed tick (Godot's sensor runs at priority -10, before the motor and the things that
-- move, so it reads the world as the previous tick committed it):
--
--   sensor:step(delta, observer, percepts, cast)
--     observer  {eye, gaze, up, heading}: where the eyes are, the axis of the cone, the body's up and facing (the motor's observer())
--     percepts  one SensorCore.Percept for every perceivable thing that is there to be sensed (a thing that is not simply is not listed)
--     cast      (from, to) -> the position of the first WORLD hit on that segment, nil when it is clear. Only world geometry may stop it:
--               not the observer, not the things sensed (Sensor.workspaceCast makes one from a RaycastParams).
--
-- Rates (spec 20): the broad scan of everything runs at broad_query_hz; things already tracked (a live contact), things whose last position
-- is remembered as a mark, and things within close_check_range_wu of the eye are checked every tick. Tick numbering is Godot's: the tick
-- counts up first (SensorCore.beginTick), so the first broad scan is tick 1 and the next is due 6 ticks later.
--
-- Where the counts live: the sensor's own are fields here (broadScans, rays, checks, cost); the ones SensorCore keeps for the bookkeeping it
-- does are read from sensor.core (tick, cuesMade, inspectionsMade, spotChecksTotal and the cueEmitted signal).
local PerceptionMath = require(script.Parent.PerceptionMath)
local SensorCore = require(script.Parent.SensorCore)
local ObservationMemory = require(script.Parent.ObservationMemory)

local Contact = ObservationMemory.Contact

local Sensor = {}
Sensor.__index = Sensor

Sensor.SAMPLE_COUNT = 5
-- The sample points sit this share of a thing's radius off its centre.
Sensor.SAMPLE_SPREAD = 0.8
-- CPU time of the sensor tick in microseconds: a ring of the latest, for percentiles.
Sensor.COST_RING = 1200
-- T13a, the lateral eyes' motion sense (the spider-eye picture's shimmer): an entry stays this long after the thing was last seen moving.
Sensor.MOTION_HOLD_TICKS = 15

-- The observer the sensor reads (Godot: get_eye_position, get_gaze_direction, get_visual_up, get_heading_vector).
export type Observer = { eye: Vector3, gaze: Vector3, up: Vector3, heading: Vector3 }
-- The position of the first world hit on the segment from, to; nil when nothing of the world is in the way.
export type Cast = (Vector3, Vector3) -> Vector3?
-- What the last check of a thing found, for the developer view (Godot's Track.last_check): the fields appear as the check passes them.
export type Check = {
	inRange: boolean,
	distance: number,
	offAxisDeg: number?,
	visiblePoints: number?,
	inCone: boolean?,
	apparentDeg: number?,
}
-- T13a: a thing the eyes could see moving on its last check: the sensed direction from the eye, the distance, how big it looked, the tick.
export type Moving = { direction: Vector3, distance: number, apparent: number, tick: number }
export type TrackRow = {
	perceptId: string,
	trackId: string,
	exposureS: number,
	inRange: boolean?,
	distance: number?,
	offAxisDeg: number?,
	visiblePoints: number?,
	inCone: boolean?,
	apparentDeg: number?,
}

local EPS = 1e-6

-- Godot's Vector3.normalized(): a vector with no length stays zero.
local function normalized(v: Vector3): Vector3
	local m = v.Magnitude
	if m == 0 then
		return Vector3.zero
	end
	return v / m
end

function Sensor.new(memory: any, observerId: string?): any
	return setmetatable({
		memory = memory,
		core = SensorCore.new(memory, observerId),
		enabled = true,
		-- Statistics, for tests and the developer view.
		broadScans = 0,
		raysThisTick = 0,
		maxRaysInATick = 0,
		raysTotal = 0,
		checksThisTick = 0,
		checksTotal = 0,
		-- The memory-spot checks' rays (also counted in raysTotal); their number of checks is core.spotChecksTotal.
		spotRaysTotal = 0,
		-- CPU time of the ticks that did the work, microseconds: the total, the largest and a ring of the latest for percentiles.
		cpuUsTotal = 0,
		cpuTicks = 0,
		cpuUsMax = 0,
		-- What the observer's eyes, gaze and up were on the last tick (the developer view draws the cones from them).
		lastEye = Vector3.zero,
		lastAxis = Vector3.new(0, 0, -1),
		lastUp = Vector3.new(0, 1, 0),
		-- T13a, for the spider-eye picture only: nothing reads it to decide anything and it holds only what the sightline checks found.
		motionSeen = {} :: { [string]: Moving },
		_checks = {} :: { [string]: Check },
		_nextBroadTick = 0,
		_ring = {} :: { number },
		_costBase = 0,
	}, Sensor)
end

-- Takes the perception section of a species profile (Species.<id>.perception) and sets the memory's timing to match.
function Sensor.configureFrom(self: any, perception: { [string]: number })
	self.core:configureFrom(perception)
end

function Sensor.getTrack(self: any, perceptId: string): SensorCore.Track?
	return self.core:getTrack(perceptId)
end

-- The track a percept id is filed under, "" if it was never sensed. Tests and the developer view only.
function Sensor.trackIdFor(self: any, perceptId: string): string
	return self.core:trackIdFor(perceptId)
end

-- What the last check of a thing found (Godot: get_track(id).last_check); nil for a thing that has no track.
function Sensor.lastCheck(self: any, perceptId: string): Check?
	return self._checks[perceptId]
end

-- Forget everything about what is being tracked (the memory is cleared separately). The tick and the statistics go on.
function Sensor.reset(self: any)
	self.core:reset()
	self.motionSeen = {}
	self._checks = {}
	self._nextBroadTick = 0
end

-- ================================================================================================ the tick

-- One physics tick of the senses (Godot _physics_process): see the header for what the caller passes.
function Sensor.step(self: any, delta: number, observer: Observer, percepts: { SensorCore.Percept }, cast: Cast)
	self.raysThisTick = 0
	self.checksThisTick = 0
	if not self.enabled then
		return
	end
	local t0 = os.clock()
	local core = self.core
	local tick: number = core:beginTick(delta) -- the tick counts up and every track's gap since it was last inspected grows
	local eye, axis, up, forward = observer.eye, observer.gaze, observer.up, observer.heading
	self.lastEye, self.lastAxis, self.lastUp = eye, axis, up
	local broadDue = tick >= self._nextBroadTick
	if broadDue then
		self._nextBroadTick = tick + math.max(1, math.round(SensorCore.HZ / math.max(core.broadHz, 0.1)))
		self.broadScans += 1
	end
	local inspected: { SensorCore.Inspected } = {}
	local sightings: { SensorCore.Sighting } = {}
	local present: { [string]: boolean } = {}
	for _, p in percepts do
		present[p.id] = true
		local t = core:trackOf(p.id)
		local c: ObservationMemory.Contact? = if t.trackId ~= "" then core.memory:getContact(t.trackId) else nil
		local watching = c ~= nil and (c.state == Contact.LIVE or Contact.hasMark(c))
		if broadDue or watching or (p.position - eye).Magnitude <= core.closeRangeWu then
			self.checksThisTick += 1
			self.checksTotal += 1
			self:_sense(t, p, eye, axis, up, forward, cast, delta, inspected, sightings)
		end
	end
	core:fileSightings(sightings, delta)
	core:checkSpots(eye, axis, up, delta, inspected, function(from: Vector3, center: Vector3, radius: number, u: Vector3): boolean
		return self:_allVisible(cast, from, center, radius, u)
	end)
	core:endTick(present) -- the memory moves on to this tick, then the tracks of things that are no longer there go
	for id in self._checks do
		if not present[id] then
			self._checks[id] = nil
		end
	end
	for id, m in self.motionSeen do
		if not present[id] or tick - m.tick > Sensor.MOTION_HOLD_TICKS then
			self.motionSeen[id] = nil
		end
	end
	self.maxRaysInATick = math.max(self.maxRaysInATick, self.raysThisTick)
	self:_recordCost(math.floor((os.clock() - t0) * 1.0e6 + 0.5))
end

-- What the eyes make of one thing (Godot _sense): in range, inside the peripheral field, the sample points that could be seen, and then
-- either an inspection (in the cone and big enough to look at) or, if it moves, a cue.
function Sensor._sense(self: any, t: SensorCore.Track, p: SensorCore.Percept, eye: Vector3, axis: Vector3, up: Vector3, forward: Vector3, cast: Cast, delta: number, inspected: { SensorCore.Inspected }, sightings: { SensorCore.Sighting })
	local core = self.core
	local center = p.position
	local radius = math.max(p.radius, 0.01)
	local to = center - eye
	local dist = to.Magnitude
	local reach: number = core:reachWu()
	local check: Check = { inRange = dist <= reach, distance = dist }
	self._checks[p.id] = check
	if dist > reach or dist < SensorCore.MIN_DISTANCE then
		return
	end
	local dir = to / dist
	local offAxis = PerceptionMath.angleTo(axis, dir)
	check.offAxisDeg = math.deg(offAxis)
	if offAxis > math.rad(core.peripheralConeDeg) * 0.5 then
		return
	end
	local seen = self:_visiblePoints(cast, eye, center, radius, up)
	check.visiblePoints = #seen
	if #seen == 0 then
		return
	end
	local estimate = Vector3.zero
	for _, s in seen do
		estimate += s
	end
	estimate /= #seen
	local estDir = normalized(estimate - eye)
	local apparent = PerceptionMath.apparentSizeDeg(2.0 * radius, dist)
	local inCone = offAxis <= math.rad(core.coneDeg) * 0.5
	check.inCone = inCone
	check.apparentDeg = apparent
	local visibleFraction = #seen / Sensor.SAMPLE_COUNT
	local speed = p.velocity.Magnitude
	if speed >= core.motionMinSpeed then
		self.motionSeen[p.id] = { direction = estDir, distance = dist, apparent = apparent, tick = core.tick }
	end
	if inCone and apparent >= core.minApparentDeg then
		table.insert(sightings, { t = t, p = p, estimate = estimate, estDir = estDir, apparent = apparent, visibleFraction = visibleFraction })
		table.insert(inspected, { position = estimate, radius = radius })
	elseif speed >= core.motionMinSpeed and core.tick >= t.nextCueTick then
		core:cue(t, estDir, forward, up, dist)
	end
end

-- The sample points of a sphere of `radius` at `center` that the eye can see: the centre and four points a little off it, across the line of
-- sight and along it. An empty list means none could be seen.
function Sensor._visiblePoints(self: any, cast: Cast, eye: Vector3, center: Vector3, radius: number, up: Vector3): { Vector3 }
	local out: { Vector3 } = {}
	for _, s in Sensor.samplePoints(eye, center, radius, up) do
		if self:_clear(cast, eye, s, radius) then
			table.insert(out, s)
		end
	end
	return out
end

-- Godot _sample_points: the centre, then +side, -side, +vert, -vert at SAMPLE_SPREAD of the radius, side across the line of sight and
-- horizontal to the body (d x up; d x right when the thing is straight above or below) and vert across both.
function Sensor.samplePoints(eye: Vector3, center: Vector3, radius: number, up: Vector3): { Vector3 }
	local d = normalized(center - eye)
	local side = d:Cross(up)
	if side:Dot(side) < 1e-6 then
		side = d:Cross(Vector3.new(1, 0, 0))
	end
	side = normalized(side)
	local vert = normalized(side:Cross(d))
	local r = radius * Sensor.SAMPLE_SPREAD
	return { center, center + side * r, center - side * r, center + vert * r, center - vert * r }
end

-- True when the eye can see the sample point `to` of a thing of `radius`: the world stops the ray no further than a small allowance short of
-- it (PerceptionMath.sightTolerance, A-024). A world hit before the point is occlusion; it is not forgiven because the point is near. Every
-- ray is counted.
function Sensor._clear(self: any, cast: Cast, from: Vector3, to: Vector3, radius: number): boolean
	self.raysThisTick += 1
	self.raysTotal += 1
	local hit = cast(from, to)
	if hit == nil then
		return true
	end
	local length = (to - from).Magnitude
	return (hit - from).Magnitude >= length - PerceptionMath.sightTolerance(radius, length)
end

-- A remembered spot is called empty only when every sample point of it is in plain view (the first one the world hides ends the check).
-- The number of spot checks is counted by SensorCore.checkSpots; the rays they used are counted here and also in raysTotal.
function Sensor._allVisible(self: any, cast: Cast, eye: Vector3, center: Vector3, radius: number, up: Vector3): boolean
	local before: number = self.raysTotal
	local all = true
	for _, s in Sensor.samplePoints(eye, center, radius, up) do
		if not self:_clear(cast, eye, s, radius) then
			all = false
			break
		end
	end
	self.spotRaysTotal += self.raysTotal - before
	return all
end

-- ================================================================================================ questions

-- Whether the eye could sense a thing of `radius` at `center` right now: in range, inside the field of the peripheral eyes and at least one of
-- its sample points in plain view, which is exactly what a sensed thing has to pass. Changes no state of the senses; the rays are counted.
-- The prey population asks it before a replacement is let in (it must come in where the spider could not sense it).
function Sensor.couldSense(self: any, observer: Observer, center: Vector3, radius: number, cast: Cast): boolean
	local core = self.core
	local eye = observer.eye
	local to = center - eye
	local dist = to.Magnitude
	if dist > core:reachWu() then
		return false
	end
	if dist < SensorCore.MIN_DISTANCE then
		return true
	end
	if PerceptionMath.angleTo(observer.gaze, to / dist) > math.rad(core.peripheralConeDeg) * 0.5 then
		return false
	end
	return #self:_visiblePoints(cast, eye, center, math.max(radius, 0.01), observer.up) > 0
end

-- Developer view: what the last check of each thing found (distance, off-axis angle, how many points were seen, whether it was in the cone),
-- with the exposure so far. Truth-derived numbers, for developers only: nothing in the player's presentation reads this. Sorted by the
-- world's id.
function Sensor.describeTracks(self: any): { TrackRow }
	local core = self.core
	local out: { TrackRow } = {}
	for pid, t in core._tracks do
		local check: Check? = self._checks[pid]
		local row: TrackRow = {
			perceptId = pid,
			trackId = t.trackId,
			exposureS = if t.gapS <= core.graceS + EPS then t.exposure else 0.0,
		}
		if check ~= nil then
			row.inRange, row.distance, row.offAxisDeg = check.inRange, check.distance, check.offAxisDeg
			row.visiblePoints, row.inCone, row.apparentDeg = check.visiblePoints, check.inCone, check.apparentDeg
		end
		table.insert(out, row)
	end
	table.sort(out, function(a: TrackRow, b: TrackRow): boolean
		return a.perceptId < b.perceptId
	end)
	return out
end

-- ================================================================================================ cost

function Sensor._recordCost(self: any, us: number)
	self.cpuUsTotal += us
	self.cpuUsMax = math.max(self.cpuUsMax, us)
	self._ring[self.cpuTicks % Sensor.COST_RING + 1] = us
	self.cpuTicks += 1
end

-- Ticks measured since the window began (the start of the run, or the last resetCost()).
function Sensor.costTicks(self: any): number
	return self.cpuTicks - self._costBase
end

-- Percentile of the latest measured sensor ticks (since the window began), in microseconds.
function Sensor.costPercentile(self: any, q: number): number
	local n = math.min(self:costTicks(), Sensor.COST_RING)
	if n <= 0 then
		return 0
	end
	local xs: { number } = {}
	for i = 0, n - 1 do
		table.insert(xs, self._ring[(self.cpuTicks - 1 - i) % Sensor.COST_RING + 1])
	end
	table.sort(xs)
	return xs[math.clamp(math.ceil(q * n), 1, n)]
end

-- Begins a new measuring window (the totals, the largest and the percentiles start again).
function Sensor.resetCost(self: any)
	self.cpuUsTotal = 0
	self.cpuUsMax = 0
	self._costBase = self.cpuTicks
end

-- ================================================================================================ the engine's rays

-- A cast made of the engine's raycast: the position of the first hit on the segment, nil when it is clear. The caller decides what the rays
-- may meet in `params` (the sill: not the spider, not the things sensed, not anything drawn only).
function Sensor.workspaceCast(params: RaycastParams): Cast
	return function(from: Vector3, to: Vector3): Vector3?
		local hit = workspace:Raycast(from, to - from, params)
		return if hit ~= nil then hit.Position else nil
	end
end

return Sensor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">SensorCore</string>
            <string name="Source"><![CDATA[--!strict
-- SensorCore: the half of Godot's SensorSystem (scripts/perception/sensor_system.gd, c87ce00) that needs no world. The sensor turns world
-- truth into evidence and nothing more; this is what it does with the evidence once the eye has found it: which contact a sighting is filed
-- under (continuous sight, a lost contact it can only be, or a fresh one), how long a thing has been in view and so how finely it can be
-- classified, the peripheral cue, and the looking at remembered spots that drops a mark when the place is seen empty. Ported method for
-- method from _is_linked, _cue_contact, _file_sightings, _placed_and_unbroken, _inspection_contact, _lost_candidates, _inspect, _cue,
-- _check_spots, _forget_gone and the head and tail of _physics_process. NOT here (the next part of the port): the rays that decide what
-- was in plain view (_sense, _visible_points, _clear, _sample_points), the eye and gaze, the broad scan and its rates, Focus, the
-- developer overlay and the motion shimmer. Capture (on_capture) belongs to the feeding chunk. A caller does what _physics_process does:
--
--   core:beginTick(delta)                      -- tick += 1, every track's gap grows by delta
--   core:trackOf(id)                           -- once per percept that exists, sighted or not (creates its track)
--   core:cue(...)                              -- for each thing that gave a peripheral cue this tick
--   core:fileSightings(sightings, delta)       -- all of the tick's inspections together (the association rule needs them together)
--   core:checkSpots(eye, axis, up, delta, inspected, allVisible)
--   core:endTick(present)                      -- memory:advance(tick), then forget the tracks of things that left the world
--
-- Who is who (A-027, D-040). Three things are kept apart. The world's id for a thing is how the sensor finds it again each tick (the key of
-- _tracks); it is never the spider's idea of who the thing is. A contact (the memory's track id) is the spider's hypothesis that some
-- observations are of one visible thing. Familiarity is what earlier exposure to a contact taught, kept per contact (_kept) and faded with
-- the memory of it. A thing's evidence stays under one contact while sight of it is unbroken: the contact is live and the thing itself was
-- filed under it within the memory's hold time for that kind of evidence. Once sight has been lost the world id decides nothing: a new
-- inspection is compared with the lost contacts by where each was last observed, how long ago, how big it looked, what it can look like and
-- how fast it was seen moving, and is taken for a lost contact only when exactly one of them could be it and no other thing sighted in the
-- same tick could be it either (two look-alikes that come into view together are two fresh contacts, and the order the world lists them in
-- decides nothing); otherwise it is a fresh contact that starts again at "movement" and inherits no exposure. A bare cue has no place to
-- compare, so it is always a weak new contact; the inspection that follows it makes the comparison, and a cue-only contact that turns out
-- to be a lost one is folded into it.
local Observation = require(script.Parent.Observation)
local PerceptionMath = require(script.Parent.PerceptionMath)
local Signal = require(script.Parent.Signal)
local ObservationMemory = require(script.Parent.ObservationMemory)

local Contact = ObservationMemory.Contact
local EPS = 1e-6

local SensorCore = {}
SensorCore.__index = SensorCore

-- One game clock: the senses count in its ticks (SimClock.HZ), never in the engine's rate.
SensorCore.HZ = 60
SensorCore.MIN_DISTANCE = 0.05

-- What the sensor keeps for each thing it can sense, under the world's id for it. It is the channel to a visible thing, not an identity.
export type Track = {
	perceptId: string,
	-- The contact this thing's evidence is filed under while sight of it is unbroken. "" until the first observation (only a thing that has
	-- been sensed has one); it is replaced, not trusted, once sight of the thing has been lost.
	trackId: string,
	-- The tick of the last evidence of this thing that was filed under that contact.
	linkTick: number,
	-- Continuous exposure in the cone, seconds.
	exposure: number,
	-- Seconds since the last inspected tick.
	gapS: number,
	nextCueTick: number,
}

-- What may be sensed: the world's truth about a thing, which only the eye reads (Godot's Perceivable percept).
export type Percept = {
	id: string,
	position: Vector3,
	radius: number,
	velocity: Vector3,
	-- The finest category its appearance can ever be refined to (fly-like prey for something that looks like easy prey up close, movement
	-- for something that never looks like more). nil is fly-like prey.
	maxCategory: string?,
}

-- One thing in the inspection cone this tick, as the eye made it: where it was seen (the mean of the sample points in plain view), the
-- direction to there, how big it looked and how much of it was in view.
export type Sighting = {
	t: Track,
	p: Percept,
	estimate: Vector3,
	estDir: Vector3,
	apparent: number,
	visibleFraction: number,
	match: string?,
	candidates: { string }?,
}

-- A thing inspected this tick (position and radius), which the spot checks must not call an empty place.
export type Inspected = { position: Vector3, radius: number }

function SensorCore.new(memory: any, observerId: string?): any
	return setmetatable({
		memory = memory,
		observerId = observerId or "spider",
		-- Parameters: the species profile's perception section (configureFrom). The defaults are Godot's.
		coneDeg = 30.0,
		peripheralConeDeg = 300.0,
		sectorDeg = 22.5,
		rangeWu = 40.0,
		-- How far the eyes reach now, as a share of rangeWu (1 in daylight; the life clock lowers it at night).
		rangeScale = 1.0,
		easyS = 0.4,
		flyS = 1.0,
		easyApparentDeg = 3.0,
		minApparentDeg = 0.6,
		motionMinSpeed = 0.3,
		cueCooldownS = 0.8,
		broadHz = 10.0,
		closeRangeWu = 4.0,
		graceS = 0.15,
		decayS = 6.0,
		-- The association rule (A-027): the assumed top speed of anything unseen, and the size ratio that still counts as one thing.
		contactSpeedBound = 2.0,
		contactSizeRatio = 1.5,
		-- Statistics, for tests and the developer overlay.
		tick = 0,
		inspectionsMade = 0,
		cuesMade = 0,
		spotChecksTotal = 0,
		-- Emitted for every peripheral cue made (after the cooldown), for tests and the developer view.
		cueEmitted = Signal.new(),
		_tracks = {} :: { [string]: Track },
		_serial = 0,
		_spots = {} :: { [string]: { exposure: number, gap: number } },
		_kept = {} :: { [string]: number }, -- track id -> continuous exposure the contact had when sight of it last ended
	}, SensorCore)
end

-- Takes the perception section of a species profile (spec 21.1: Species.<id>.perception, snake_case as in the data) and sets the memory's
-- timing to match.
function SensorCore.configureFrom(self: any, p: { [string]: number })
	self.coneDeg = p.inspect_cone_degrees
	self.peripheralConeDeg = p.peripheral_cone_degrees
	self.sectorDeg = p.peripheral_sector_degrees
	self.rangeWu = p.sensor_range_wu
	self.easyS = p.easy_target_inspection_s
	self.flyS = p.fly_like_inspection_s
	self.easyApparentDeg = p.easy_apparent_size_deg
	self.minApparentDeg = p.min_apparent_size_deg
	self.motionMinSpeed = p.motion_min_speed_wu_s
	self.cueCooldownS = p.cue_cooldown_s
	self.broadHz = p.broad_query_hz
	self.closeRangeWu = p.close_check_range_wu
	self.graceS = p.exposure_grace_s
	self.decayS = p.memory_decay_s
	self.contactSpeedBound = p.contact_speed_bound_wu_s
	self.contactSizeRatio = p.contact_size_ratio
	if self.memory ~= nil then
		self:applyToMemory()
	end
end

-- The memory's timing follows the sensor's: a cue repeats every cooldown, so a peripheral contact is held a little longer than that; an
-- inspection comes every tick, so it is held for the exposure grace.
function SensorCore.applyToMemory(self: any)
	self.memory:configure(SensorCore.HZ, self.decayS, self.graceS, self.cueCooldownS + 0.2)
end

-- The range every check uses.
function SensorCore.reachWu(self: any): number
	return self.rangeWu * math.clamp(self.rangeScale, 0.0, 1.0)
end

function SensorCore.getTrack(self: any, perceptId: string): Track?
	return self._tracks[perceptId]
end

-- The track a percept id is filed under, "" if it was never sensed. Tests and the developer overlay only.
function SensorCore.trackIdFor(self: any, perceptId: string): string
	local t: Track? = self._tracks[perceptId]
	return if t == nil then "" else t.trackId
end

-- Forget everything about what is being tracked (the memory is cleared separately).
function SensorCore.reset(self: any)
	self._tracks = {}
	self._spots = {}
	self._kept = {}
end

function SensorCore.trackOf(self: any, perceptId: string): Track
	local t: Track? = self._tracks[perceptId]
	if t == nil then
		t = {
			perceptId = perceptId,
			trackId = "",
			linkTick = -1000000,
			exposure = 0.0,
			gapS = 1.0e9,
			nextCueTick = 0,
		}
		self._tracks[perceptId] = t
	end
	return t :: Track
end

-- The head of a physics tick: the clock moves on and every track's gap since it was last inspected grows. Returns the tick.
function SensorCore.beginTick(self: any, delta: number): number
	self.tick += 1
	for _, t in self._tracks do
		t.gapS += delta
	end
	return self.tick
end

-- The tail of a physics tick: the memory moves on to this tick, then the tracks of things that are no longer there are dropped.
function SensorCore.endTick(self: any, present: { [string]: boolean })
	self.memory:advance(self.tick)
	self:forgetGone(present)
end

-- Lifecycle (A-029): a thing that is no longer there to be sensed (its node left the world, or it gives no percept) loses its entry; the
-- contacts it made are not touched, they fade and expire on their own clocks. Exposure kept for a contact that is gone goes too.
function SensorCore.forgetGone(self: any, present: { [string]: boolean })
	for pid in self._tracks do
		if not present[pid] then
			self._tracks[pid] = nil
		end
	end
	for id in self._kept do
		if self.memory:getContact(id) == nil then
			self._kept[id] = nil
		end
	end
end

-- A new contact for a thing, with an opaque id; the thing is filed under it from now on.
function SensorCore.newContactFor(self: any, t: Track): string
	self._serial += 1
	t.trackId = `trk_{self._serial}`
	return t.trackId
end

-- True while this thing's evidence is a continuation of the contact it was last filed under (A-027): that contact is live and the thing
-- itself was filed under it within the memory's hold time for that kind of evidence. Sight that was lost for longer is not unbroken,
-- whatever the world's id says, and neither is sight of a thing whose contact someone else kept alive.
function SensorCore.isLinked(self: any, t: Track): boolean
	if t.trackId == "" then
		return false
	end
	local c: ObservationMemory.Contact? = self.memory:getContact(t.trackId)
	return c ~= nil and c.state == Contact.LIVE and self.tick - t.linkTick <= self.memory:holdTicks(c.modality)
end

-- The contact a cue is filed under: the one the thing is unbrokenly filed under, else a new one (a bearing cannot say which remembered
-- place this is).
function SensorCore.cueContact(self: any, t: Track): string
	return if self:isLinked(t) then t.trackId else self:newContactFor(t)
end

-- The sightings of this tick that are first looks after a loss of sight (or at a thing known only from cues) are compared with the lost
-- contacts together, not one after the other (A-027): a lost contact is taken by a sighting only when it is that sighting's one candidate
-- and no other sighting of the tick could be it either. Two look-alikes that come into view at once, both inside the region one lost contact
-- could have reached, are two fresh contacts, whichever of them the sensor happens to handle first; and the order the world lists its
-- things in, like the world's ids, decides nothing. Then each sighting is filed.
function SensorCore.fileSightings(self: any, sightings: { Sighting }, delta: number)
	if #sightings == 0 then
		return
	end
	local claims: { [string]: number } = {} -- lost contact id -> how many sightings of this tick could be it
	for _, s in sightings do
		s.match = ""
		s.candidates = {}
		if self:placedAndUnbroken(s.t) then
			continue
		end
		local found = self:lostCandidates(s.estimate, 2.0 * s.p.radius, s.p.maxCategory or Observation.FLY_LIKE_PREY)
		s.candidates = found
		for _, id in found do
			claims[id] = (claims[id] or 0) + 1
		end
	end
	for _, s in sightings do
		local found = s.candidates :: { string }
		if #found == 1 and claims[found[1]] == 1 then
			s.match = found[1]
		end
	end
	for _, s in sightings do
		self:inspect(s.t, s.p, s.estimate, s.estDir, s.apparent, s.visibleFraction, delta, s.match :: string)
	end
end

-- True while the thing's evidence is a continuation of a contact that already has a place: nothing to compare.
function SensorCore.placedAndUnbroken(self: any, t: Track): boolean
	return self:isLinked(t) and self.memory:getContact(t.trackId).hasPosition
end

-- The contact an inspection is filed under (A-027). Unbroken sight of a thing already being inspected: the same contact. Otherwise this is
-- the first inspection after a loss of sight, or of a thing known only from cues: if the comparison made with the other sightings of the
-- tick (fileSightings) found exactly one lost contact it could be, it is that one (a contact known only from cues is folded into it); if it
-- found none, or more than one, it is the contact the cues made or a new one, with nothing carried over.
function SensorCore.inspectionContact(self: any, t: Track, matched: string): string
	local linked = self:isLinked(t)
	if linked and self.memory:getContact(t.trackId).hasPosition then
		return t.trackId
	end
	if matched ~= "" then
		if linked then
			self.memory:merge(t.trackId, matched)
		end
		t.trackId = matched
		return matched
	end
	return if linked then t.trackId else self:newContactFor(t)
end

-- The lost contacts a new sighting could be (their track ids; empty when none). A contact could be it when the sighting is inside the region
-- its thing could have reached since it was last observed (a function of the time and the speed bound, never of where the thing went),
-- looks about as big, and is not finer in appearance than what was learned. Only a focused sighting is ever asked: a bearing cue says
-- nothing about which remembered place this is.
function SensorCore.lostCandidates(self: any, estimate: Vector3, sizeWu: number, cap: string): { string }
	local found: { string } = {}
	for _, m in self.memory:marks() do
		local elapsed = (self.tick - m.positionTick) / SensorCore.HZ
		local reach = PerceptionMath.plausibleRadius(m.sizeWu, sizeWu, elapsed, self.contactSpeedBound, m.speedWuS)
		if (estimate - m.position).Magnitude > reach then
			continue
		end
		if not PerceptionMath.sizesCompatible(m.sizeWu, sizeWu, self.contactSizeRatio) then
			continue
		end
		if not PerceptionMath.categoriesCompatible(m.category, cap) then
			continue
		end
		table.insert(found, m.trackId)
	end
	return found
end

-- One inspection of a thing in the cone: its exposure (a new stretch after a break longer than the grace starts from what the contact it
-- belongs to was taught, as much as the memory of it lasts), the category that exposure supports (never finer than the thing can look),
-- and the Observation the memory takes in.
function SensorCore.inspect(self: any, t: Track, p: Percept, estimate: Vector3, estDir: Vector3, apparent: number, visibleFraction: number, delta: number, matched: string)
	local cap = p.maxCategory or Observation.FLY_LIKE_PREY
	local id: string = self:inspectionContact(t, matched)
	if t.gapS > self.graceS + EPS then
		-- A new stretch of exposure. What an earlier one taught the contact it belongs to still counts, as much as the memory of it does: a
		-- new contact has been taught nothing.
		t.exposure = (self._kept[id] or 0.0) * self.memory:familiarity(id)
	end
	t.exposure += delta
	self._kept[id] = t.exposure
	t.gapS = 0.0
	local category = PerceptionMath.classify(t.exposure, apparent, self.easyS, self.flyS, self.easyApparentDeg, self.minApparentDeg)
	if Observation.rank(category) > Observation.rank(cap) then
		category = cap
	end
	local obs = Observation.new()
	obs.observerId = self.observerId
	obs.trackId = id
	obs.targetId = if Observation.rank(category) >= Observation.rank(Observation.POSSIBLE_PREY) then p.id else ""
	obs.modality = Observation.INSPECTION
	obs.hasPosition = true
	obs.estimatedPosition = estimate
	obs.direction = estDir
	obs.confidence = PerceptionMath.inspectionConfidence(t.exposure, PerceptionMath.requiredExposure(self.flyS, apparent, self.easyApparentDeg), visibleFraction)
	obs.observedTick = self.tick
	obs.category = category
	obs.sizeWu = 2.0 * p.radius
	obs.apparentSizeDeg = apparent
	obs.speedWuS = p.velocity.Magnitude
	if self.memory:ingest(obs) ~= nil then
		self.inspectionsMade += 1
		t.linkTick = self.tick
	end
end

-- A peripheral cue: a coarse bearing, low confidence, and nothing else. The caller has already decided that the thing moves, is in the
-- field and in sight, and that `self.tick >= t.nextCueTick` (at most one cue per cooldown for each thing).
function SensorCore.cue(self: any, t: Track, estDir: Vector3, forward: Vector3, up: Vector3, dist: number)
	t.nextCueTick = self.tick + math.round(self.cueCooldownS * SensorCore.HZ)
	local obs = Observation.new()
	obs.observerId = self.observerId
	obs.trackId = self:cueContact(t)
	obs.modality = Observation.PERIPHERAL
	obs.hasPosition = false
	obs.direction = PerceptionMath.quantizeDirection(estDir, forward, up, self.sectorDeg)
	obs.confidence = PerceptionMath.peripheralConfidence(dist, self:reachWu())
	obs.observedTick = self.tick
	obs.category = Observation.MOVEMENT
	if self.memory:ingest(obs) ~= nil then
		self.cuesMade += 1
		t.linkTick = self.tick
		self.cueEmitted:emit(obs)
	end
end

-- The remembered spots of lost contacts: inspecting one that is in plain view and empty drops its mark. A spot is looked at when it is in
-- the cone, close enough that the thing would look big enough, and entirely in plain view (`allVisible(eye, position, radius, up)`: the
-- rays, which the world half supplies) with nothing inspected there this tick; it must be looked at for the time an easy target needs
-- (a break up to the grace does not start it again).
function SensorCore.checkSpots(self: any, eye: Vector3, axis: Vector3, up: Vector3, delta: number, inspected: { Inspected }, allVisible: (Vector3, Vector3, number, Vector3) -> boolean)
	local half = math.rad(self.coneDeg) * 0.5
	local marks: { ObservationMemory.Contact } = self.memory:marks()
	for id in self._spots do
		local still = false
		for _, m in marks do
			if m.trackId == id then
				still = true
			end
		end
		if not still then
			self._spots[id] = nil
		end
	end
	for _, m in marks do
		local st = self._spots[m.trackId] or { exposure = 0.0, gap = 1.0e9 }
		st.gap += delta
		local to = m.position - eye
		local dist = to.Magnitude
		local size = math.max(m.sizeWu, 0.2)
		local apparent = PerceptionMath.apparentSizeDeg(size, dist)
		local plain = false
		if dist >= SensorCore.MIN_DISTANCE and dist <= self:reachWu() and PerceptionMath.angleTo(axis, to / dist) <= half and apparent >= self.minApparentDeg then
			self.spotChecksTotal += 1
			plain = allVisible(eye, m.position, size * 0.5, up)
			if plain then
				for _, q in inspected do
					if (q.position - m.position).Magnitude < size + q.radius then
						plain = false -- something is there: not an empty spot
					end
				end
			end
		end
		if plain then
			if st.gap > self.graceS + EPS then
				st.exposure = 0.0
			end
			st.exposure += delta
			st.gap = 0.0
			if st.exposure + EPS >= PerceptionMath.requiredExposure(self.easyS, apparent, self.easyApparentDeg) then
				self.memory:invalidate(m.trackId, "empty")
				self._spots[m.trackId] = nil
				continue
			end
		end
		self._spots[m.trackId] = st
	end
end

return SensorCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- A minimal in-process signal, the stand-in for a Godot `signal`: handlers run synchronously, in the order they were connected, when
-- the signal is emitted. Pure Luau (no BindableEvent) so the plain CLI can run the perception logic that announces its changes with it.
local Signal = {}
Signal.__index = Signal

export type Signal = {
	connect: (self: Signal, handler: (...any) -> ()) -> () -> (),
	emit: (self: Signal, ...any) -> (),
}

function Signal.new(): Signal
	return setmetatable({ _handlers = {} }, Signal) :: any
end

-- Returns a function that disconnects this handler.
function Signal.connect(self: any, handler: (...any) -> ()): () -> ()
	table.insert(self._handlers, handler)
	return function()
		local i = table.find(self._handlers, handler)
		if i then
			table.remove(self._handlers, i)
		end
	end
end

function Signal.emit(self: any, ...: any)
	local handlers: { (...any) -> () } = table.clone(self._handlers)
	for _, handler in handlers do
		handler(...)
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="37">
        <Properties>
          <string name="Name">Rig</string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Anatomy</string>
            <string name="Source"><![CDATA[--!strict
-- Where the parts of the body sit, worked out from the appearance table alone: pure, Vector3 only, so tests/look.luau checks
-- it. Body frame as in SpiderRig: +Y up, -Z forward. SpiderRig turns the layout into parts; Setae uses it to keep hairs off
-- the eyes and to grow the palps' fluff. Nothing here is placed by eye: eyes, cheeks and palps are found on the head's surface.

local Anatomy = {}

export type Eye = { name: string, side: number, at: Vector3, radii: Vector3, reflectance: number, principal: boolean }
export type Glint = { side: number, at: Vector3, radii: Vector3 }
export type Palp = { side: number, base: Vector3, tip: Vector3 }
export type Zone = { at: Vector3, radius: number }
export type Layout = {
	headCenter: Vector3, headRadii: Vector3,
	abdomenCenter: Vector3, abdomenRadii: Vector3,
	faceCenter: Vector3, faceRadii: Vector3,
	pedicelCenter: Vector3, pedicelRadii: Vector3,
	neck: Vector3,
	eyes: { Eye },
	glints: { Glint },
	cheeks: { { side: number, at: Vector3, radii: Vector3 } },
	jaws: { { side: number, at: Vector3, radii: Vector3 } },
	palps: { Palp },
	spinneret: Vector3,
	hairFree: { Zone },
}

local function v3(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end
Anatomy.v3 = v3

-- z of an ellipsoid's front (-Z) surface at lateral offsets x, y from its centre.
function Anatomy.frontZ(c: Vector3, r: Vector3, x: number, y: number): number
	local q = 1 - (x / r.X) ^ 2 - (y / r.Y) ^ 2
	return c.Z - r.Z * math.sqrt(math.max(q, 0))
end

-- y of an ellipsoid's top surface at offsets x, z from its centre.
function Anatomy.topY(c: Vector3, r: Vector3, x: number, z: number): number
	local q = 1 - (x / r.X) ^ 2 - (z / r.Z) ^ 2
	return c.Y + r.Y * math.sqrt(math.max(q, 0))
end

-- x of an ellipsoid's +X side surface at offsets y, z from its centre.
function Anatomy.sideX(c: Vector3, r: Vector3, y: number, z: number): number
	local q = 1 - (y / r.Y) ^ 2 - (z / r.Z) ^ 2
	return c.X + r.X * math.sqrt(math.max(q, 0))
end

-- Outward unit normal of an ellipsoid at a point on its surface.
function Anatomy.normalAt(c: Vector3, r: Vector3, p: Vector3): Vector3
	local d = p - c
	return Vector3.new(d.X / (r.X * r.X), d.Y / (r.Y * r.Y), d.Z / (r.Z * r.Z)).Unit
end

-- The point of an ellipsoid in direction `dir` (unit-sphere coordinates) and its outward normal.
function Anatomy.ellipsoidPoint(c: Vector3, r: Vector3, dir: Vector3): (Vector3, Vector3)
	local u = dir.Unit
	local p = c + Vector3.new(u.X * r.X, u.Y * r.Y, u.Z * r.Z)
	return p, Anatomy.normalAt(c, r, p)
end

function Anatomy.layout(look: any): Layout
	local hc, hr = v3(look.headCenter), v3(look.headRadii)
	local ac, ar = v3(look.abdomenCenter), v3(look.abdomenRadii)
	local e = look.eye
	local eyes: { Eye } = {}
	local glints: { Glint } = {}
	local zones: { Zone } = {}
	local function addEye(name: string, side: number, anchor: Vector3, r: Vector3, out: number, reflectance: number, principal: boolean): Vector3
		local n = Anatomy.normalAt(hc, hr, anchor)
		local at = anchor + n * (out * math.min(r.X, r.Y, r.Z))
		table.insert(eyes, { name = name, side = side, at = at, radii = r, reflectance = reflectance, principal = principal })
		table.insert(zones, { at = at, radius = math.max(r.X, r.Y, r.Z) * 1.15 + 0.012 })
		return at
	end
	for _, side in { -1, 1 } do
		-- Principal eyes on the front of the face, two catchlights each.
		local a = e.ame
		local ar3 = v3(a.radii)
		local ax, ay = side * a.x, a.y
		local anchor = Vector3.new(hc.X + ax, ay, Anatomy.frontZ(hc, hr, ax, ay - hc.Y))
		local at = addEye("PrincipalEye", side, anchor, ar3, a.out, a.reflectance, true)
		for _, g in a.glints do
			local depth = math.sqrt(math.max(1 - (g.dx / ar3.X) ^ 2 - (g.dy / ar3.Y) ^ 2, 0))
			local gz = -ar3.Z * depth
			table.insert(glints, {
				side = side,
				at = at + Vector3.new(g.dx, g.dy, gz - g.r * 0.2),
				radii = Vector3.new(g.r, g.r, g.r * 0.45),
			})
		end
		-- Anterior lateral eyes at the sides of the face.
		local l = e.ale
		local lx, ly = side * l.x, l.y
		addEye("Eye", side, Vector3.new(hc.X + lx, ly, Anatomy.frontZ(hc, hr, lx, ly - hc.Y)), Vector3.one * l.r, l.out, l.reflectance, false)
		-- Posterior lateral and median eyes on the dome.
		for _, d in { e.ple, e.pme } do
			local dx, dz = side * d.x, d.z
			addEye("Eye", side, Vector3.new(hc.X + dx, Anatomy.topY(hc, hr, dx, dz - hc.Z), dz), Vector3.one * d.r, d.out, d.reflectance, false)
		end
	end
	local cheeks, jaws, palps = {}, {}, {}
	local ch, cl, pl = look.cheek, look.chelicerae, look.palp
	for _, side in { -1, 1 } do
		local cx = Anatomy.sideX(hc, hr, ch.y - hc.Y, ch.z - hc.Z) - ch.inset
		table.insert(cheeks, { side = side, at = Vector3.new(side * cx, ch.y, ch.z), radii = v3(ch.radii) })
		local jaw = Vector3.new(side * cl.x, cl.y, cl.z)
		table.insert(jaws, { side = side, at = jaw, radii = v3(cl.radii) })
		table.insert(zones, { at = jaw, radius = math.max(cl.radii[1], cl.radii[2], cl.radii[3]) * 1.1 + 0.01 })
		local px = side * pl.x
		local base = Vector3.new(px, pl.y, Anatomy.frontZ(hc, hr, px, pl.y - hc.Y))
		table.insert(palps, { side = side, base = base, tip = base + Vector3.new(side * pl.spread, -pl.drop, -pl.reach) })
	end
	return {
		headCenter = hc, headRadii = hr, abdomenCenter = ac, abdomenRadii = ar,
		faceCenter = v3(look.face.center), faceRadii = v3(look.face.radii),
		pedicelCenter = v3(look.pedicel.center), pedicelRadii = v3(look.pedicel.radii),
		neck = v3(look.neck),
		eyes = eyes, glints = glints, cheeks = cheeks, jaws = jaws, palps = palps,
		spinneret = Vector3.new(0, ac.Y + 0.02, ac.Z + ar.Z - 0.005),
		hairFree = zones,
	}
end

return Anatomy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Idle</string>
            <string name="Source"><![CDATA[--!strict
-- Idle motion for the drawn spider (display only, never fed back into movement): a slow breathing bob, a small curious head
-- tilt and the palps' drumming. Pure functions of time so tests/look.luau can check them. All knobs: Appearances.idle / .palp.
-- `calm` is 0..1: SpiderRig eases it up after the spider has stood still for a moment and back to 0 as soon as it moves.

local Idle = {}

export type Pose = {
	bodyLift: number, -- studs: the whole body rises with a breath
	abdomenLift: number, -- studs: the abdomen rises a little more
	abdomenPitch: number, -- radians, rear end up
	headRoll: number, headYaw: number, headPitch: number, -- radians
}

local TAU = math.pi * 2

function Idle.pose(t: number, calm: number, cfg: any): Pose
	local b, k = cfg.breathe, cfg.tilt
	local breath = math.sin(TAU * t / b.period) * (0.85 + 0.15 * math.sin(TAU * t / (b.period * 2.7) + 0.6))
	local p = k.periods
	return {
		bodyLift = b.bodyLift * breath * calm,
		abdomenLift = b.lift * breath * calm,
		abdomenPitch = math.rad(b.pitchDeg) * breath * calm,
		headRoll = math.rad(k.rollDeg) * calm * (0.65 * math.sin(TAU * t / p[1]) + 0.35 * math.sin(TAU * t / p[2] + 1.1)),
		headYaw = math.rad(k.yawDeg) * calm * (0.7 * math.sin(TAU * t / p[3] + 0.4) + 0.3 * math.sin(TAU * t / p[4] + 2.0)),
		headPitch = math.rad(k.pitchDeg) * calm * math.sin(TAU * t / p[5] + 0.9),
	}
end

-- The largest angle each part of the pose can reach (for tests and for the docs).
function Idle.limits(cfg: any): Pose
	local b, k = cfg.breathe, cfg.tilt
	return {
		bodyLift = b.bodyLift, abdomenLift = b.lift, abdomenPitch = math.rad(b.pitchDeg),
		headRoll = math.rad(k.rollDeg), headYaw = math.rad(k.yawDeg), headPitch = math.rad(k.pitchDeg),
	}
end

-- Palp drumming in bursts while the spider stands still: the angle (radians, about the palp's base) of palp 1 and palp 2.
function Idle.palps(t: number, drum: number, palp: any): { number }
	local out = {}
	for k = 1, 2 do
		local burst = math.clamp((math.sin(t * 1.3 + 0.7 * k) - 0.55) / 0.3, 0, 1)
		local beat = math.max(0, math.sin(t * TAU * palp.drumHz + math.pi * k))
		out[k] = math.rad(palp.drumDeg) * drum * burst * beat
	end
	return out
end

return Idle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Setae</string>
            <string name="Source"><![CDATA[--!strict
-- Where the spider's hairs (setae) go: pure layout from the appearance table, Vector3 only, so tests/run.luau and
-- tests/look.luau check it. Body frame as in SpiderRig: +Y up, -Z forward. Deterministic: the same appearance always gives
-- the same fuzz. SpiderRig turns each entry into one thin anchored part.
-- The coat is short and sleek and takes its colour from the daughter's pattern: black hairs on the black areas, white hairs
-- only inside the white spots and the band (the pale cheeks stay clean). Nothing grey or frosted is in the body coat; only
-- the face keeps a little silver (the tufts and the ruff) and the palps their fluff.
--   lock: short thin hairs lying nearly flat, combed toward the rear      pale: the same, white, inside a white spot or the band
--   fringe: short hairs along the sides, lifted a little, for a soft edge  guard: a few short hairs that stand up
--   tuft: the plumes at the upper sides of the head       ruff: pale hair low on each cheek
--   palp: the fluff on the pedipalps (rest pose; SpiderRig moves it with the palp)       leg: see Setae.leg

local Anatomy = require(script.Parent.Anatomy)

local Setae = {}

export type Hair = {
	at: Vector3, dir: Vector3, normal: Vector3, length: number, width: number, thick: number, transparency: number,
	kind: string, group: string, side: number, tone: string, white: boolean, grey: boolean, frost: boolean,
}
export type LegHair = { segment: number, t: number, theta: number, length: number, tone: string, white: boolean, grey: boolean, frost: boolean }
export type Patch = { x: number, z: number, rx: number, rz: number, angle: number }

local GOLDEN = 2.399963229728653

-- A repeatable 0..1 value per index (no global RNG state).
local function hash(i: number, salt: number): number
	local x = math.sin(i * 12.9898 + salt * 78.233) * 43758.5453
	return x - math.floor(x)
end
Setae.hash = hash

local function between(range: { number }, t: number): number
	return range[1] + (range[2] - range[1]) * t
end

-- ---------------------------------------------------------------- the pattern: where the white is
-- The white spots and the band as flat ellipses, in studs from the abdomen's centre (x across, z along): the same ones
-- SpiderRig draws as AbdomenSpot and FrontBand. `angle` turns an ellipse about the vertical (CFrame.Angles(0, angle, 0)).
function Setae.patches(look: any): { Patch }
	local ar = look.abdomenRadii
	local out: { Patch } = {}
	for _, s in look.spots do
		table.insert(out, { x = s.x * ar[1], z = s.z * ar[3], rx = s.rx, rz = s.rz, angle = s.angle })
	end
	local band = look.band
	for i = 0, band.count - 1 do
		table.insert(out, { x = (i - (band.count - 1) / 2) * band.step * ar[1], z = band.z * ar[3], rx = band.rx, rz = band.rz, angle = 0 })
	end
	return out
end

-- Is the offset (dx, dz) from the abdomen's centre inside the patch grown by `grow` studs (negative: shrunk)?
local function inside(p: Patch, dx: number, dz: number, grow: number): boolean
	local rx, rz = p.rx + grow, p.rz + grow
	if rx <= 0 or rz <= 0 then return false end
	local c, s = math.cos(p.angle), math.sin(p.angle)
	local ex, ez = dx - p.x, dz - p.z
	local u = ex * c - ez * s
	local v = ex * s + ez * c
	return (u / rx) ^ 2 + (v / rz) ^ 2 < 1
end

local function insideAny(patches: { Patch }, dx: number, dz: number, grow: number): boolean
	for _, p in patches do
		if inside(p, dx, dz, grow) then return true end
	end
	return false
end
Setae.insideAny = insideAny

-- ---------------------------------------------------------------- one hair
local function hair(at: Vector3, dir: Vector3, normal: Vector3, length: number, width: number, flat: number, transparency: number, kind: string, group: string, side: number, tone: string): Hair
	return {
		at = at, dir = dir, normal = normal, length = length, width = width, thick = width * flat, transparency = transparency,
		kind = kind, group = group, side = side, tone = tone, white = tone == "white", grey = tone == "grey", frost = tone == "frost",
	}
end

-- The way a hair lies: along the surface toward the rear (+Z), turned `yaw` radians to one side, raised `lift` radians off the
-- surface (0 lies flat, pi/2 stands up).
local function comb(normal: Vector3, lift: number, yaw: number): Vector3
	local back = Vector3.new(0, 0, 1)
	local along = back - normal * back:Dot(normal)
	if along.Magnitude < 1e-3 then along = Vector3.new(0, 1, 0) - normal * normal.Y end
	if along.Magnitude < 1e-3 then return normal end
	along = along.Unit
	local side = normal:Cross(along)
	return ((along * math.cos(yaw) + side * math.sin(yaw)) * math.cos(lift) + normal * math.sin(lift)).Unit
end

-- Where a hair of this class starts: a lying hair sits on the surface (half its thickness above it, so it neither sinks in
-- nor floats), a standing one is rooted a little inside.
local function rootOf(surface: Vector3, normal: Vector3, lift: number, thick: number): Vector3
	if lift < math.rad(25) then return surface + normal * (thick * 0.5 + 0.0012) end
	return surface - normal * 0.003
end

-- The hair's three points (root, middle, tip) must all be acceptable.
local function allClear(clear: (Vector3) -> boolean, root: Vector3, dir: Vector3, length: number): boolean
	return clear(root) and clear(root + dir * (length * 0.5)) and clear(root + dir * length)
end

-- One class of coat hairs (kind "lock", "guard" or "fringe") over an ellipsoid; `spec` is the class's table in
-- Appearances.fuzz. `keep(at, unit)` picks where hairs may grow, `clear(point)` rejects a hair that touches something it must
-- leave alone (a white patch, an eye). The colour is black or dark: a hair here is on a black area.
local function coat(out: { Hair }, kind: string, spec: any, center: Vector3, radii: Vector3, samples: number, salt: number, group: string, keep: (Vector3, Vector3) -> boolean, clear: (Vector3) -> boolean)
	for i = 0, samples - 1 do
		local y = 1 - 2 * (i + 0.5) / samples
		local r = math.sqrt(math.max(0, 1 - y * y))
		local a = i * GOLDEN
		local unit = Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
		if unit.Y > -0.25 then
			local surface = center + Vector3.new(unit.X * radii.X, unit.Y * radii.Y, unit.Z * radii.Z)
			local normal = Vector3.new(unit.X / radii.X, unit.Y / radii.Y, unit.Z / radii.Z).Unit
			if keep(surface, unit) then
				local length = between(spec.length, hash(i, salt))
				local lift = math.rad(between(spec.lift, hash(i, salt + 5)))
				local yaw = math.rad(spec.yaw) * (2 * hash(i, salt + 3) - 1)
				local dir = comb(normal, lift, yaw)
				local root = rootOf(surface, normal, lift, spec.width * spec.flat)
				if allClear(clear, root, dir, length) then
					local tone = if hash(i, salt + 11) < spec.black then "black" else "dark"
					table.insert(out, hair(root, dir, normal, length, spec.width, spec.flat, spec.transparency, kind, group, 0, tone))
				end
			end
		end
	end
end

-- White hairs inside the white spots and the band, lying on top of them (the markings are flat, raised discs): a spiral of
-- hair middles in each ellipse at `spec.density` hairs per square stud, every one kept only if the whole hair stays inside
-- the patch (shrunk by `spec.margin`), so the white keeps its edge.
local function pale(out: { Hair }, look: any, A: Anatomy.Layout, spec: any)
	local patches = Setae.patches(look)
	local ac, ar = A.abdomenCenter, A.abdomenRadii
	local n = 0
	for pi, patch in patches do
		local count = math.floor(math.pi * patch.rx * patch.rz * spec.density + 0.5)
		local c, s = math.cos(patch.angle), math.sin(patch.angle)
		for k = 1, count do
			n += 1
			local ring = if count == 1 then 0 else math.sqrt((k - 0.5) / count) * 0.75
			local ang = k * GOLDEN + pi
			local lu, lv = patch.rx * ring * math.cos(ang), patch.rz * ring * math.sin(ang)
			local mx, mz = patch.x + lu * c + lv * s, patch.z - lu * s + lv * c -- the hair's middle, offsets from the abdomen's centre
			local length = between(spec.length, hash(n, 41))
			local yaw = math.rad(spec.yaw) * (2 * hash(n, 43) - 1)
			local lift = math.rad(between(spec.lift, hash(n, 45)))
			local dir = comb(Vector3.yAxis, lift, yaw)
			local rx, rz = mx - dir.X * length * 0.5, mz - dir.Z * length * 0.5 -- its root
			-- the disc's top: SpiderRig lifts a marking 0.007 above the body and gives it a rounded 0.012 half-thickness
			local rho2 = (lu / patch.rx) ^ 2 + (lv / patch.rz) ^ 2
			local thick = spec.width * spec.flat
			local height = Anatomy.topY(ac, ar, rx, rz) + 0.007 + 0.012 * math.sqrt(math.max(0, 1 - rho2)) + thick * 0.5 + 0.0008
			local root = Vector3.new(ac.X + rx, height, ac.Z + rz)
			local ok = true
			for _, along in { 0, 0.5, 1 } do
				ok = ok and insideAny(patches, rx + dir.X * length * along, rz + dir.Z * length * along, -spec.margin)
			end
			if ok then
				table.insert(out, hair(root, dir, Vector3.yAxis, length, spec.width, spec.flat, spec.transparency, "pale", "abdomen", 0, "white"))
			end
		end
	end
end

-- A fan of hairs growing from a point of the head: `spec` = { at (unit-sphere direction, mirrored), lean, fan, spread, ... }.
local function plume(out: { Hair }, A: Anatomy.Layout, side: number, spec: any, count: number, length: number, kind: string, salt: number, pick: (number) -> string)
	local p0, n0 = Anatomy.ellipsoidPoint(A.headCenter, A.headRadii, Vector3.new(side * spec.at[1], spec.at[2], spec.at[3]))
	local axis = Vector3.new(side * spec.lean[1], spec.lean[2], spec.lean[3]).Unit
	local u = axis:Cross(Vector3.zAxis)
	if u.Magnitude < 1e-3 then u = axis:Cross(Vector3.xAxis) end
	u = u.Unit
	local w = axis:Cross(u).Unit
	for k = 1, count do
		local ring = math.sqrt((k - 0.5) / count)
		local ang = k * GOLDEN + side
		local off = u * math.cos(ang) + w * math.sin(ang)
		local dir = (axis + off * (spec.fan * ring)).Unit
		local at = p0 + off * (spec.spread * ring) - n0 * 0.012
		local l = length * (0.82 + 0.36 * hash(k, salt + side))
		table.insert(out, hair(at, dir, n0, l, spec.width, spec.flat, spec.transparency, kind, "head", side, pick(k * 3 + side)))
	end
end

function Setae.body(look: any): { Hair }
	local out: { Hair } = {}
	local f = look.fuzz
	if not f or not f.enabled then return out end
	local A = Anatomy.layout(look)
	local cheek = look.cheek
	local cy = (cheek.y - A.headCenter.Y) / A.headRadii.Y
	local cz = (cheek.z - A.headCenter.Z) / A.headRadii.Z
	local patches = Setae.patches(look)
	local ac, ar = A.abdomenCenter, A.abdomenRadii
	local hc, hr = A.headCenter, A.headRadii

	-- Black hairs keep off the white: no point of a hair may come within `f.clear` studs of a spot or the band, and none
	-- may lie on the pale cheek. (The pattern is on the upper surface; the lower flanks have none.)
	local function offWhiteAbdomen(p: Vector3): boolean
		if p.Y < ac.Y + 0.02 then return true end
		return not insideAny(patches, p.X - ac.X, p.Z - ac.Z, f.clear)
	end
	local function offCheek(p: Vector3): boolean
		local u = Vector3.new((p.X - hc.X) / hr.X, (p.Y - hc.Y) / hr.Y, (p.Z - hc.Z) / hr.Z)
		if math.abs(u.X) < 0.5 * u.Magnitude then return true end
		local dy = (u.Y / u.Magnitude - cy) / (cheek.radii[2] / hr.Y + f.clear / hr.Y)
		local dz = (u.Z / u.Magnitude - cz) / (cheek.radii[3] / hr.Z + f.clear / hr.Z)
		return dy * dy + dz * dz > 1.4
	end

	local coats: { { kind: string, spec: any } } = { { kind = "lock", spec = f.locks }, { kind = "guard", spec = f.guard } }
	if f.fringe then table.insert(coats, { kind = "fringe", spec = f.fringe }) end
	for n, entry in coats do
		local kind, spec = entry.kind, entry.spec
		local sideOnly: number = spec.side or 0 -- the fringe grows only at the sides, where it makes the outline
		coat(out, kind, spec, ac, ar, spec.abdomen, n, "abdomen", function(_at, unit)
			return unit.Z > -0.93 and math.abs(unit.X) >= sideOnly -- not where the abdomen meets the pedicel
		end, offWhiteAbdomen)
		coat(out, kind, spec, hc, hr, spec.head, n + 2, "head", function(at, unit)
			if math.abs(unit.X) < sideOnly then return false end
			if unit.Z < -0.55 and unit.Y < 0.75 then return false end -- the eye face stays clear
			for _, zone in A.hairFree do
				if (at - zone.at).Magnitude < zone.radius then return false end
			end
			return true
		end, offCheek)
	end
	pale(out, look, A, f.pale)

	-- Tufts: dark and silvery plumes up and out at the upper sides of the head.
	for _, side in { -1, 1 } do
		plume(out, A, side, f.tuft, f.tuftHairs, f.tuftLength, "tuft", 7, function(i)
			local r = hash(i, 21)
			return if r < 0.15 then "frost" elseif r < 0.45 then "grey" else "dark"
		end)
	end
	-- Cheek ruff: pale hair low at the sides of the face, beside the jaws.
	local rf = f.ruff
	for _, side in { -1, 1 } do
		plume(out, A, side, { at = rf.at, lean = rf.lean, fan = 0.55, spread = 0.03, width = rf.width, flat = rf.flat, transparency = rf.transparency }, rf.hairs, rf.length, "ruff", 17, function(i)
			local r = hash(i, 23)
			return if r < rf.whiteShare then "white" elseif r < 0.85 then "frost" else "grey"
		end)
	end
	return out
end

-- Fluff on the pedipalps, in the body frame at rest (SpiderRig moves it with the palp it belongs to; side -1 is palp 1).
function Setae.palp(look: any): { Hair }
	local out: { Hair } = {}
	local f = look.fuzz
	if not f or not f.enabled then return out end
	local A = Anatomy.layout(look)
	local pl = look.palp
	local spec = pl.fluff
	for _, p in A.palps do
		local axis = p.tip - p.base
		local ax = axis.Unit
		local u = ax:Cross(Vector3.xAxis)
		if u.Magnitude < 1e-3 then u = ax:Cross(Vector3.yAxis) end
		u = u.Unit
		local w = ax:Cross(u).Unit
		for k = 1, spec.hairs do
			local t = 0.3 + 0.7 * (k - 0.5) / spec.hairs
			local theta = k * GOLDEN + p.side
			local radial = u * math.cos(theta) + w * math.sin(theta)
			local r = if t > 0.7 then pl.club[1] else pl.stalk * 0.5
			local dir = (radial + ax * 0.6).Unit
			local l = spec.length * (0.8 + 0.4 * hash(k, 31 + p.side))
			local rr = hash(k, 33 + p.side)
			local tone = if rr < 0.55 then "white" elseif rr < 0.75 then "frost" else "grey"
			table.insert(out, hair(p.base + axis * t + radial * (r * 0.8), dir, radial, l, spec.width, spec.flat, spec.transparency, "palp", "palp", p.side, tone))
		end
	end
	return out
end

-- Hairs on one leg: segment 1 femur, 2 tibia, 3 tarsus; t along it (0 base .. 1 tip); theta around it.
-- White over the leg's pale band (the middle bandFraction of each segment, as SpiderRig draws it), black everywhere else.
function Setae.leg(look: any, legIndex: number): { LegHair }
	local out: { LegHair } = {}
	local f = look.fuzz
	if not f or not f.enabled then return out end
	local front = (legIndex - 1) % 4 == 0 -- the first legs carry a denser, longer fringe, as in Phidippus
	for segment = 1, 3 do
		local n = if front and segment < 3 then math.floor(f.legHairs[segment] * 1.6) else f.legHairs[segment]
		for k = 1, n do
			local i = legIndex * 100 + segment * 10 + k
			local t = (k - 0.5) / n
			local theta = k * GOLDEN + legIndex
			local white = math.abs(t - 0.5) < look.bandFraction * 0.6
			local tone = if white then "white" elseif hash(i, 13) < f.legBlack then "black" else "dark"
			table.insert(out, {
				segment = segment, t = t, theta = theta,
				length = f.legLength * (0.7 + 0.6 * hash(i, 5)) * (if segment == 3 then 0.6 elseif front then 1.4 else 1),
				tone = tone, white = tone == "white", grey = false, frost = false,
			})
		end
	end
	return out
end

return Setae
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">SpiderRig</string>
            <string name="Source"><![CDATA[--!strict
-- The drawn spider for Roblox: a port of scripts/presentation/spider_body.gd and surface_legs.gd (VISUAL-01 look), made cuter in
-- ROBLOX-13. Every part is anchored, non-colliding and non-queryable, and is placed each frame with one Workspace:BulkMoveTo call.
-- Display only: the controller owns the body's CFrame; nothing here feeds back into movement.
-- Body frame: +Y support-up, -Z forward, about 1 stud long (1 Godot WU = 1 cm = 1 stud). Every look number is in
-- Data/Appearances; where things sit comes from Rig/Anatomy, the hairs from Rig/Setae, the idle motion from Rig/Idle.

local Workspace = game:GetService("Workspace")
local Appearances = require(script.Parent.Parent.Data.Appearances)
local Anatomy = require(script.Parent.Anatomy)
local Setae = require(script.Parent.Setae)
local Idle = require(script.Parent.Idle)
local v3 = Anatomy.v3

local SpiderRig = {}
SpiderRig.__index = SpiderRig

export type GaitMode = "Tetrapod" | "Unilateral"

local STEP_ERROR = 0.24
local SWING_SECONDS = 0.10
local STEP_HEIGHT = 0.12
local ANKLE_SHARE = 0.62
-- The groups a fixed part follows: the body, the head (tilts about the neck) or the abdomen (breathes).
local G_BODY, G_HEAD, G_ABDOMEN = 0, 1, 2

type Leg = {
	side: number,
	pair: number,
	planted: Vector3?,
	swing: number, -- < 0 planted, 0..1 swinging
	from: Vector3,
	to: Vector3,
	up: Vector3,
	foot: Vector3,
	femur: Part,
	tibia: Part,
	tarsus: Part,
	knee: Part,
	ankle: Part,
	pad: Part?,
	bands: {Part},
	hairs: { { part: Part, spec: Setae.LegHair } },
}

type Fixed = { part: Part, offset: CFrame, group: number, palp: number? }

export type Rig = typeof(setmetatable(
	{} :: {
		model: Model,
		root: Part,
		gaitMode: GaitMode,
		reducedMotion: boolean,
		_fixed: { Fixed },
		_legs: { Leg },
		_group: number,
		_t: number,
		_drum: number,
		_calm: number,
		_spots: { Part },
		_appearance: any,
		_layout: Anatomy.Layout,
		_cfg: any,
		_detail: string,
		_palpBase: { Vector3 },
		_setae: { Part },
		_eyeView: boolean,
		_bodyHidden: boolean,
		_highlight: Highlight?,
		_params: RaycastParams,
		_parts: { BasePart },
		_cframes: { CFrame },
	},
	SpiderRig
))

local function newPart(model: Model, name: string, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = Vector3.new(0.1, 0.1, 0.1)
	p.Parent = model
	return p
end

local function ellipsoid(model: Model, name: string, radii: Vector3, color: Color3, material: Enum.Material): Part
	local p = newPart(model, name, color, material)
	p.Size = radii * 2
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function rod(model: Model, name: string, d: number, color: Color3): Part
	local p = newPart(model, name, color, Enum.Material.SmoothPlastic)
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(1, d, d)
	return p
end

local function ball(model: Model, name: string, d: number, color: Color3): Part
	local p = newPart(model, name, color, Enum.Material.SmoothPlastic)
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(d, d, d)
	p.CastShadow = false
	return p
end

-- A cylinder's axis is its local X: aim it from a to b.
local function rodCFrame(a: Vector3, b: Vector3): CFrame
	return CFrame.lookAt((a + b) * 0.5, b) * CFrame.Angles(0, math.pi / 2, 0)
end

-- A hair's "up" for lookAt: its surface normal, unless that is (nearly) along the hair.
local function upFor(dir: Vector3, normal: Vector3): Vector3
	if math.abs(dir:Dot(normal)) < 0.97 then return normal end
	return if math.abs(dir.Y) < 0.9 then Vector3.yAxis else Vector3.zAxis
end

local GROUP_OF: { [string]: number } = { head = G_HEAD, abdomen = G_ABDOMEN }

-- detail "low" is for phones and tablets: fewer hairs, one fur shell, no foot balls, half the speckles, no outline, no
-- breathing or head tilt (Appearances.detail). Anything else is the full look.
function SpiderRig.new(parent: Instance, worldFolder: Instance, appearanceId: string?, detail: string?): Rig
	local look = Appearances.profiles[appearanceId or Appearances.default]
	assert(look, "Unknown spider appearance")
	local detailName = if detail == "low" then "low" else "full"
	local cfg = look.detail[detailName]
	local A = Anatomy.layout(look)
	local function color(rgb): Color3 return Color3.new(rgb[1], rgb[2], rgb[3]) end
	local BODY, LEG = color(look.body), color(look.legs)
	local JOINT, EYE, FANG = color(look.white), color(look.eyes), color(look.fangs)
	local WHITE = color(look.white)
	local model = Instance.new("Model")
	model.Name = "Spider"
	model:SetAttribute("AppearanceId", look.id)
	model:SetAttribute("Detail", detailName)
	local root = newPart(model, "Root", BODY, Enum.Material.SmoothPlastic)
	root.Size = Vector3.new(1, 0.5, 1)
	root.Transparency = 1
	root.CastShadow = false
	model.PrimaryPart = root

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { worldFolder }

	local self = setmetatable({
		model = model,
		root = root,
		gaitMode = "Tetrapod" :: GaitMode,
		reducedMotion = false,
		_fixed = {} :: { Fixed },
		_legs = {} :: { Leg },
		_group = 0,
		_t = 0,
		_drum = 0,
		_calm = 0,
		_spots = {} :: { Part },
		_appearance = look,
		_layout = A,
		_cfg = cfg,
		_detail = detailName,
		_palpBase = { A.palps[1].base, A.palps[2].base },
		_setae = {} :: { Part },
		_eyeView = false,
		_bodyHidden = false,
		_highlight = nil :: Highlight?,
		_params = params,
		_parts = {} :: { BasePart },
		_cframes = {} :: { CFrame },
	}, SpiderRig)

	local function fixed(part: Part, at: Vector3, rot: CFrame?, group: number, palp: number?)
		table.insert(self._fixed, { part = part, offset = CFrame.new(at) * (rot or CFrame.identity), group = group, palp = palp })
	end
	local fabric = Enum.Material.SmoothPlastic -- clean high-contrast silhouette
	fixed(ellipsoid(model, "Cephalothorax", A.headRadii, BODY, fabric), A.headCenter, nil, G_HEAD)
	fixed(ellipsoid(model, "EyeFace", A.faceRadii, BODY, fabric), A.faceCenter, nil, G_HEAD)
	fixed(ellipsoid(model, "Pedicel", A.pedicelRadii, BODY, fabric), A.pedicelCenter, nil, G_BODY)
	fixed(ellipsoid(model, "Abdomen", A.abdomenRadii, BODY, fabric), A.abdomenCenter, nil, G_ABDOMEN)

	-- The daughter's pattern: markings are fractions of the abdomen's radii.
	local ar, ac = A.abdomenRadii, A.abdomenCenter
	local function marking(name: string, x: number, z: number, rx: number, rz: number, angle: number)
		local y = ar.Y * math.sqrt(math.max(0, 1 - x*x - z*z))
		local spot = ellipsoid(model, name, Vector3.new(rx, 0.012, rz), WHITE, fabric)
		spot.CastShadow = false
		fixed(spot, Vector3.new(x * ar.X, ac.Y + 0.007 + y, ac.Z + z * ar.Z), CFrame.Angles(0, angle, 0), G_ABDOMEN)
		table.insert(self._spots, spot)
	end
	-- A curved pale band across the front of the abdomen.
	local band = look.band
	for i = 0, band.count - 1 do
		marking("FrontBand", (i - (band.count - 1) / 2) * band.step, band.z, band.rx, band.rz, 0)
	end
	for _, spot in look.spots do
		marking("AbdomenSpot", spot.x, spot.z, spot.rx, spot.rz, spot.angle)
	end
	-- Fixed deterministic stippling: no per-frame RNG or extra updates.
	local sp = look.speckle
	for i = 1, look.speckleCount do
		if i % cfg.speckleEvery ~= 0 then continue end
		local angle = i * 2.399963229728653
		local radius = sp.from + (i % 5) * sp.step
		marking("Speckle", math.cos(angle) * radius, math.sin(angle) * radius, sp.rx, sp.rz, angle)
	end

	-- Head: pale cheeks, big glossy eyes with their catchlights, jaws.
	for _, c in A.cheeks do
		local cheek = ellipsoid(model, "PaleCheek", c.radii, WHITE, fabric)
		cheek.CastShadow = false
		fixed(cheek, c.at, nil, G_HEAD)
	end
	local SOCKET = color(look.eye.ame.socket.color)
	for _, e in A.eyes do
		local eye = ellipsoid(model, e.name, e.radii, EYE, Enum.Material.Glass)
		eye.Reflectance = e.reflectance
		eye.CastShadow = false
		fixed(eye, e.at, nil, G_HEAD)
		if e.principal and cfg.sockets then
			local socket = ellipsoid(model, "EyeSocket", e.radii * look.eye.ame.socket.scale, SOCKET, fabric)
			socket.CastShadow = false
			fixed(socket, e.at + Vector3.new(0, 0, 0.03), nil, G_HEAD)
		end
	end
	local GLINT = color(look.eye.glintColor)
	for _, g in A.glints do
		local glint = ellipsoid(model, "Catchlight", g.radii, GLINT, Enum.Material.Neon)
		glint.CastShadow = false
		fixed(glint, g.at, nil, G_HEAD)
	end
	local cl = look.chelicerae
	for _, j in A.jaws do
		local fang = ellipsoid(model, "Chelicera", j.radii, FANG, Enum.Material.Foil)
		fang.Reflectance = cl.reflectance
		fixed(fang, j.at, CFrame.Angles(cl.pitch, 0, j.side * cl.splay), G_HEAD)
	end
	-- Pedipalps: stalk, pale band, club and pale tip, rotating about a pivot at the base (they drum when the spider stands).
	local pl = look.palp
	for index, palp in A.palps do
		local base, tip = palp.base, palp.tip
		local len = (tip - base).Magnitude
		local toBase = CFrame.new(base):Inverse()
		local stalk = rod(model, "PalpStalk", pl.stalk, LEG)
		stalk.Size = Vector3.new(len, pl.stalk, pl.stalk)
		fixed(stalk, Vector3.zero, toBase * rodCFrame(base, tip), G_HEAD, index)
		local ring = rod(model, "PalpBand", pl.stalk * 1.05, WHITE)
		ring.Size = Vector3.new(len * look.bandFraction, pl.stalk * 1.05, pl.stalk * 1.05)
		fixed(ring, Vector3.zero, toBase * rodCFrame(base, tip), G_HEAD, index)
		fixed(ellipsoid(model, "PalpClub", v3(pl.club), LEG, fabric), tip + Vector3.new(0, -0.005, -0.02) - base, nil, G_HEAD, index)
		fixed(ellipsoid(model, "PalpTip", v3(pl.tipRadii), JOINT, fabric), tip + Vector3.new(0, 0.004, -0.05) - base, nil, G_HEAD, index)
	end

	-- Fuzz: flat locks over the head and abdomen, tufts, a cheek ruff and palp fluff (Rig/Setae), moved with the part they grow from.
	local fuzz = look.fuzz
	local BLACKEST = if fuzz then color(fuzz.black) else BODY
	local DARK = if fuzz then color(fuzz.dark) else BODY
	local GREY = if fuzz then color(fuzz.grey) else BODY
	local FROST = if fuzz then color(fuzz.frost) else BODY
	local function seta(tone: string, width: number, thick: number, length: number, transparency: number): Part
		local h = newPart(model, "Seta", if tone == "white" then WHITE elseif tone == "frost" then FROST elseif tone == "grey" then GREY elseif tone == "black" then BLACKEST else DARK, Enum.Material.SmoothPlastic)
		h.Size = Vector3.new(width, thick, length)
		h.CastShadow = false
		h.Transparency = transparency
		table.insert(self._setae, h)
		return h
	end
	if fuzz and fuzz.enabled then
		local SHELL = color(fuzz.shellColor)
		local hr, hs = A.headRadii, fuzz.headShell
		for k, shell in fuzz.shells do
			if k > cfg.shells then break end
			local a = ellipsoid(model, "FuzzShell", A.abdomenRadii * shell.scale, SHELL, fabric)
			a.Transparency, a.CastShadow = shell.transparency, false
			fixed(a, A.abdomenCenter, nil, G_ABDOMEN)
			local h = ellipsoid(model, "FuzzShell", Vector3.new(hr.X * shell.scale, hr.Y * shell.scale, hr.Z * hs.zScale), SHELL, fabric)
			h.Transparency, h.CastShadow = shell.transparency, false
			fixed(h, A.headCenter + Vector3.new(0, 0, hs.shift + 0.01 * k), nil, G_HEAD)
		end
		local seen: { [string]: number } = {}
		local function keep(kind: string): boolean
			local every = cfg.every[kind] or 1
			if every <= 0 then return false end -- 0 drops the whole class
			local n = (seen[kind] or 0) + 1
			seen[kind] = n
			return n % every == 0
		end
		for _, hair in Setae.body(look) do
			if not keep(hair.kind) then continue end
			local h = seta(hair.tone, hair.width, hair.thick, hair.length, hair.transparency)
			local mid = hair.at + hair.dir * (hair.length * 0.5)
			fixed(h, mid, CFrame.lookAt(Vector3.zero, hair.dir, upFor(hair.dir, hair.normal)), GROUP_OF[hair.group] or G_BODY)
		end
		for _, hair in Setae.palp(look) do
			if not keep("palp") then continue end
			local index = if hair.side < 0 then 1 else 2
			local h = seta(hair.tone, hair.width, hair.thick, hair.length, hair.transparency)
			local mid = hair.at + hair.dir * (hair.length * 0.5)
			local rest = CFrame.lookAt(mid, mid + hair.dir, upFor(hair.dir, hair.normal))
			fixed(h, Vector3.zero, CFrame.new(self._palpBase[index]):Inverse() * rest, G_HEAD, index)
		end
	end

	-- Legs: plump, with rounded joints and (at full detail) round feet.
	local L = look.limbs
	for i = 1, 8 do
		local side = if i <= 4 then -1 else 1
		local pair = (i - 1) % 4 + 1
		local raw = L.diameters[pair]
		local factor = (if pair == 1 then look.frontLegScale else 1) * L.thickness
		local d = {raw[1] * factor, raw[2] * factor}
		table.insert(self._legs, {
			side = side,
			pair = pair,
			planted = nil :: Vector3?,
			swing = -1,
			from = Vector3.zero,
			to = Vector3.zero,
			up = Vector3.yAxis,
			foot = Vector3.zero,
			femur = rod(model, "Femur" .. i, d[1], LEG),
			tibia = rod(model, "Tibia" .. i, d[2], LEG),
			tarsus = rod(model, "Tarsus" .. i, d[2] * 0.6, LEG),
			knee = ball(model, "Knee" .. i, d[1] * 0.95, JOINT),
			ankle = ball(model, "Ankle" .. i, d[2] * 0.95, JOINT),
			pad = if cfg.pads then ball(model, "Foot" .. i, d[2] * 0.6 * L.pad, LEG) else nil,
			bands = {rod(model, "FemurBand" .. i, d[1], WHITE), rod(model, "TibiaBand" .. i, d[2], WHITE), rod(model, "TarsusBand" .. i, d[2] * 0.6, WHITE)},
			hairs = {},
		})
		local leg = self._legs[#self._legs]
		if fuzz and fuzz.enabled then
			for n, spec in Setae.leg(look, i) do
				if n % cfg.every.leg ~= 0 then continue end
				table.insert(leg.hairs, { part = seta(spec.tone, fuzz.legWidth, fuzz.legWidth, spec.length, fuzz.legTransparency), spec = spec })
			end
		end
	end
	if cfg.highlight then
		local hl = Instance.new("Highlight")
		hl.FillTransparency = 1
		hl.OutlineColor = WHITE
		hl.OutlineTransparency = 0.82
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = model
		self._highlight = hl
	end
	model.Parent = parent
	self:setGrowthStage(0)
	return self
end

-- The selected appearance stays black and white at every life stage.
-- Growth is a separate display scale when LIFE is ported; it must not recolor this design.
function SpiderRig.setGrowthStage(self: Rig, stage: number)
	self.model:SetAttribute("GrowthStage", math.clamp(stage, 0, 3))
end

-- How many parts the drawn spider is made of (the model's direct parts), for budgets and the docs.
function SpiderRig.count(self: Rig): { total: number, hairs: number, shells: number, body: number }
	local total, hairs, shells = 0, 0, 0
	for _, part in self.model:GetChildren() do
		if part:IsA("BasePart") then
			total += 1
			if part.Name == "Seta" then hairs += 1 elseif part.Name == "FuzzShell" then shells += 1 end
		end
	end
	return { total = total, hairs = hairs, shells = shells, body = total - hairs - shells }
end

local function legGroup(self: Rig, i: number): number
	if self.gaitMode == "Unilateral" then
		return if i <= 4 then 0 else 1
	end
	-- Godot's (i % 4 + i / 4) % 2 with 0-based i: L1 R2 L3 R4 against R1 L2 R3 L4.
	local j = i - 1
	return (j % 4 + j // 4) % 2
end

local function restLocal(self: Rig, leg: Leg): Vector3
	local s = self._appearance.limbs.stance
	return Vector3.new(leg.side * s.x * s.reach, s.y, self._appearance.limbs.tipZ[leg.pair] * s.reach)
end

-- Display-only foothold: retract toward the body at a narrow edge; never invents a platform.
local function target(self: Rig, body: CFrame, leg: Leg): RaycastResult?
	local up = body.UpVector
	local rest = restLocal(self, leg)
	for _, reach in { 1.0, 0.65, 0.35, 0.12 } do
		local point = body:PointToWorldSpace(Vector3.new(rest.X * reach, 0, rest.Z * reach))
		local hit = Workspace:Raycast(point + up * 0.35, -up * 1.0, self._params)
		if hit and hit.Normal:Dot(up) > 0.35 then
			return hit
		end
	end
	return nil
end

-- body: the drawn body's CFrame. grounded: standing on a surface. moving: walking speed > 0 (for palp drumming and idle motion).
function SpiderRig.update(self: Rig, body: CFrame, dt: number, grounded: boolean, moving: boolean)
	self._t += dt
	local up = body.UpVector
	local look, cfg, A = self._appearance, self._cfg, self._layout
	local parts, cframes = self._parts, self._cframes
	table.clear(parts)
	table.clear(cframes)
	local function put(p: BasePart, cf: CFrame)
		table.insert(parts, p)
		table.insert(cframes, cf)
	end
	put(self.root, body)

	-- Palps drum in bursts while the spider stands still; breathing and a curious head tilt ease in after a moment. All of
	-- it is full detail only (cfg.idle), and reducedMotion turns it off too.
	local standing = cfg.idle and grounded and not moving and not self.reducedMotion
	self._drum = math.clamp(self._drum + (if standing then 3 else -3) * dt, 0, 1)
	local palpAngle = Idle.palps(self._t, self._drum, look.palp)
	local bodyBase, headBase, abdomenBase = body, body, body
	if cfg.idle then
		local idle = look.idle
		self._calm = math.clamp(self._calm + (if standing then dt / idle.riseSeconds else -dt / idle.fallSeconds), 0, 1)
		if self._calm > 0 then
			local c = self._calm * self._calm * (3 - 2 * self._calm)
			local pose = Idle.pose(self._t, c, idle)
			bodyBase = body * CFrame.new(0, pose.bodyLift, 0)
			headBase = bodyBase * CFrame.new(A.neck) * CFrame.Angles(pose.headPitch, pose.headYaw, pose.headRoll) * CFrame.new(-A.neck)
			abdomenBase = bodyBase * CFrame.new(0, pose.abdomenLift, 0) * CFrame.new(A.pedicelCenter)
				* CFrame.Angles(-pose.abdomenPitch, 0, 0) * CFrame.new(-A.pedicelCenter)
		end
	end
	local pivots = {
		CFrame.new(self._palpBase[1]) * CFrame.Angles(palpAngle[1], 0, 0),
		CFrame.new(self._palpBase[2]) * CFrame.Angles(palpAngle[2], 0, 0),
	}
	for _, f in self._fixed do
		local base = if f.group == G_HEAD then headBase elseif f.group == G_ABDOMEN then abdomenBase else bodyBase
		local palp = f.palp
		if palp then
			put(f.part, base * pivots[palp] * f.offset)
		else
			put(f.part, base * f.offset)
		end
	end

	-- Legs: planted feet stay put in the world; a leg too far from its rest spot steps, in alternating groups.
	local swinging = false
	for _, leg in self._legs do
		swinging = swinging or leg.swing >= 0
	end
	if grounded and not swinging then
		local worst = STEP_ERROR
		for i, leg in self._legs do
			if leg.planted then
				local err = (body:PointToWorldSpace(restLocal(self, leg)) - leg.planted :: Vector3).Magnitude
				if err > worst then
					worst = err
					self._group = legGroup(self, i)
				end
			end
		end
	end
	local L = look.limbs
	local started = false
	for i, leg in self._legs do
		local rest = body:PointToWorldSpace(restLocal(self, leg))
		if not grounded then
			leg.planted = nil
			leg.swing = -1
			leg.foot = body:PointToWorldSpace(Vector3.new(leg.side * 0.47, -0.12, L.tipZ[leg.pair] * 0.72))
		else
			if leg.planted == nil then
				local hit = target(self, body, leg)
				leg.planted = if hit then hit.Position else nil
				leg.foot = if hit then hit.Position else rest + up * 0.16
				leg.swing = -1
			end
			local anchor = leg.planted
			if anchor then
				if leg.swing >= 0 then
					leg.swing = math.min(1, leg.swing + dt / SWING_SECONDS)
					local s = leg.swing
					local smooth = s * s * (3 - 2 * s)
					leg.foot = leg.from:Lerp(anchor, smooth) + leg.up * math.sin(math.pi * s) * STEP_HEIGHT
					if leg.swing >= 1 then
						leg.swing = -1
						leg.foot = anchor
					end
				else
					leg.foot = anchor
					local err = (rest - anchor).Magnitude
					if err > STEP_ERROR and ((not swinging and legGroup(self, i) == self._group) or err > 0.60) then
						local hit = target(self, body, leg)
						if hit and (anchor - hit.Position).Magnitude > 0.12 then
							leg.from = anchor
							leg.planted = hit.Position
							leg.up = hit.Normal
							leg.swing = 0
							started = true
						end
					end
					if body:PointToObjectSpace(leg.foot).Magnitude > 1.4 then
						leg.planted = nil
						leg.foot = rest
					end
				end
			end
		end
	end
	if started then
		self._group = 1 - self._group
	end
	local kneeUp = if grounded then L.kneeLift else L.kneeLiftAir
	for _, leg in self._legs do
		local hip = bodyBase:PointToWorldSpace(Vector3.new(leg.side * L.hipX, L.hipY, L.hipZ[leg.pair]))
		local foot = leg.foot
		local knee = hip:Lerp(foot, 0.48) + up * kneeUp
		local ankle = knee:Lerp(foot, ANKLE_SHARE) + up * L.ankleLift
		local function segment(index: number, p: Part, band: Part, a: Vector3, b: Vector3)
			local len = math.max((b - a).Magnitude, 0.01)
			if math.abs(p.Size.X - len) > 1e-3 then
				p.Size = Vector3.new(len, p.Size.Y, p.Size.Z)
			end
			local rc = rodCFrame(a, b) -- local +X runs from a toward b (toward the foot)
			put(p, rc)
			band.Size = Vector3.new(len * look.bandFraction, p.Size.Y * 1.035, p.Size.Z * 1.035)
			put(band, rc)
			-- Leg setae stand out from the segment and lean toward the foot.
			local r = p.Size.Y * 0.5
			for _, hair in leg.hairs do
				local spec = hair.spec
				if spec.segment == index then
					local c, s = math.cos(spec.theta), math.sin(spec.theta)
					local base = Vector3.new((spec.t - 0.5) * len, r * 0.8 * c, r * 0.8 * s)
					local dir = Vector3.new(1.3, c, s).Unit
					put(hair.part, rc * CFrame.lookAt(base + dir * (spec.length * 0.5), base + dir * spec.length, Vector3.xAxis))
				end
			end
		end
		segment(1, leg.femur, leg.bands[1], hip, knee)
		segment(2, leg.tibia, leg.bands[2], knee, ankle)
		segment(3, leg.tarsus, leg.bands[3], ankle, foot)
		put(leg.knee, CFrame.new(knee))
		put(leg.ankle, CFrame.new(ankle))
		if leg.pad then put(leg.pad :: Part, CFrame.new(foot)) end
	end
	Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Spider-eye view (Godot SpiderBody.set_eye_view + SurfaceLegs.eye_view): the body, head and palps are hidden and only the
-- front legs' lower segments stay, reaching into the view. Client-only (LocalTransparencyModifier).
local function applyVisibility(self: Rig)
	local function show(p: BasePart, visible: boolean)
		p.LocalTransparencyModifier = if visible then 0 else 1
	end
	local hideBody = self._eyeView or self._bodyHidden
	if self._highlight then (self._highlight :: Highlight).Enabled = not hideBody end
	for _, f in self._fixed do
		show(f.part, not hideBody)
	end
	for _, leg in self._legs do
		local frontReach = self._eyeView and leg.pair == 1
		local all = not hideBody
		show(leg.femur, all); show(leg.bands[1], all); show(leg.knee, all)
		show(leg.tibia, all or frontReach); show(leg.bands[2], all or frontReach)
		show(leg.tarsus, all or frontReach); show(leg.bands[3], all or frontReach); show(leg.ankle, all or frontReach)
		if leg.pad then show(leg.pad :: Part, all or frontReach) end
		for _, hair in leg.hairs do
			show(hair.part, all or (frontReach and hair.spec.segment >= 2))
		end
	end
end

function SpiderRig.setEyeView(self: Rig, on: boolean)
	self._eyeView = on
	applyVisibility(self)
end

-- The orbit camera hides the spider when its boom is squeezed shorter than BODY_HIDE_LENGTH.
function SpiderRig.setBodyHidden(self: Rig, hidden: boolean)
	self._bodyHidden = hidden
	applyVisibility(self)
end

-- Where the dragline leaves the body.
function SpiderRig.spinneretPoint(self: Rig, body: CFrame): Vector3
	return body:PointToWorldSpace(self._layout.spinneret)
end

function SpiderRig.destroy(self: Rig)
	self.model:Destroy()
end

return SpiderRig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ControlText</string>
            <string name="Source"><![CDATA[--!strict
-- Words on the screen, written for the device the player is using now: keyboard and mouse, a controller, or touch.
-- The texts are the frozen Godot game's (scripts/presentation/jump_feedback.gd, key_names.gd and jump_hud.gd at c87ce00);
-- where Godot wrote both keys ("Q / B"), each device here names only its own key or button. Pure: tests/run.luau checks
-- every prompt without Roblox.
local ControlText = {}

export type Device = "keyboard" | "gamepad" | "touch"

ControlText.TITLES = {
	reachable = "Reachable",
	obstructed = "Blocked",
	unreachable = "Out of reach",
	ineligible = "Can't land there",
	none = "No surface in view",
}
ControlText.REASONS = {
	ok = "",
	no_target = "no surface in view",
	ineligible_surface = "the spider cannot hold on there",
	too_far = "too far or too high",
	no_launch = "no way to leave this surface toward there",
	no_arrival = "it can't land from that angle",
	no_durations = "out of range",
	no_room = "no room to land",
	path_blocked = "something is in the way",
	graze = "it would only graze the surface",
	hop_blocked = "something is in the way",
	no_ground = "nothing to land on ahead",
}
ControlText.ANCHOR_TEXT = {
	ok = "Safety line: anchored here",
	no_silk = "No safety line: this surface won't hold silk",
	too_long = "No safety line: this jump needs more line than you have",
	no_support = "",
}
ControlText.LINE_TITLE = "On your line"
ControlText.LINE_TITLE_REELING = "On your line: reeling in"
ControlText.LINE_BLOCKED = {
	blocked = "Can't reel in: something is in the way. Lower, or let go",
	shortest = "Reeled in as far as it goes",
	snagged = "The line is caught on a second edge and can't be reeled in. Lower, or let go",
}
ControlText.DROP_REFUSED = {
	no_edge = "Nothing below to let yourself down into from here",
	no_silk = "This surface won't hold your silk",
	no_support = "",
	stuck = "Couldn't get to the edge",
}
ControlText.DROP_WALK = "To the edge, to let yourself down"

-- What each device calls the controls. Godot's input_setup.gd bindings; the port keeps the D-pad for walking, so lowering on
-- silk is X on a controller (ROBLOX-05). Touch names are the on-screen buttons.
local NAMES: { [string]: { [string]: string } } = {
	keyboard = {
		jump = "Space", cancel = "Q", letGo = "Q", drop = "F", reel = "W", lower = "S", walk = "WASD", look = "Mouse",
		creep = "Shift", focus = "Right mouse", eye = "V", recenter = "R", slow = "T", reset = "Backspace", help = "H", zoom = "Wheel",
	},
	gamepad = {
		jump = "A", cancel = "B", letGo = "B", drop = "X", reel = "Stick up", lower = "Stick down", walk = "Left stick",
		look = "Right stick", creep = "LB", focus = "LT", eye = "Y", recenter = "Right-stick click", slow = "RT", reset = "View",
		help = "", zoom = "",
	},
	touch = {
		jump = "Jump", cancel = "Cancel", letGo = "Let go", drop = "Silk", reel = "↑", lower = "↓", walk = "Arrows",
		look = "Drag", creep = "Creep", focus = "", eye = "Eye", recenter = "Recenter", slow = "", reset = "", help = "", zoom = "",
	},
}

function ControlText.name(device: Device, action: string): string
	return (NAMES[device] or NAMES.keyboard)[action] or ""
end

-- The device whose names to show after an input of this UserInputType (its Enum name). Anything else keeps the previous one.
function ControlText.deviceFor(inputType: string, previous: Device): Device
	if inputType == "Touch" then return "touch" end
	if string.sub(inputType, 1, 7) == "Gamepad" then return "gamepad" end
	if inputType == "Keyboard" or inputType == "TextInput" or string.sub(inputType, 1, 5) == "Mouse" then return "keyboard" end
	return previous
end

-- Before any input: a touch-only device shows touch, a controller without a keyboard (a console) shows the controller.
function ControlText.initialDevice(touch: boolean, keyboard: boolean, gamepad: boolean): Device
	if touch and not keyboard then return "touch" end
	if gamepad and not keyboard then return "gamepad" end
	return "keyboard"
end

function ControlText.reason(plan: any): string
	if plan == nil then return "" end
	return ControlText.REASONS[plan.reason] or tostring(plan.reason or "")
end

-- The two lines at the reticle while aiming (JumpFeedback.describe, hold mode) and Godot's cancel hint beside the second.
function ControlText.describe(plan: any, device: Device): (string, string)
	local cancel = ControlText.name(device, "cancel") .. ": cancel the jump"
	if plan == nil then
		return ControlText.TITLES.none, "release to cancel    " .. cancel
	end
	local kind = plan.kind
	local valid = kind == "reachable"
	local title = ControlText.TITLES[kind] or kind
	if not valid and kind ~= "none" then
		local why = ControlText.reason(plan)
		if why ~= "" then title = title .. ": " .. why end
	end
	return title, (if valid then "release to leap" else "release to cancel") .. "    " .. cancel
end

function ControlText.anchorText(reason: string): string
	return ControlText.ANCHOR_TEXT[reason] or ""
end

-- The toast for a jump outcome (JumpFeedback.toast): "" for outcomes that need none.
function ControlText.toast(kind: string, plan: any): string
	local why = ControlText.reason(plan)
	if kind == "refused" then
		return "Jump cancelled: " .. (if why ~= "" then why else "nothing to land on")
	elseif kind == "hop_refused" then
		return "No hop: " .. (if why ~= "" then why else "nowhere to land")
	elseif kind == "cancelled" then
		return "Jump cancelled"
	elseif kind == "out_of_bounds" then
		return "Out of bounds: back to the last safe spot"
	end
	return ""
end

-- The toast for a line event (JumpFeedback.line_toast). afterMiss: the line had been locked by a miss; dropped: the spider
-- let itself down on this line (the line taking its weight is no surprise then).
function ControlText.lineToast(kind: string, detail: string, afterMiss: boolean, dropped: boolean, device: Device): string
	if kind == "caught" then
		return if dropped then "" else "Caught by your line"
	elseif kind == "drop_walk" then
		return ControlText.DROP_WALK
	elseif kind == "dropped" then
		return `Letting yourself down: hold {ControlText.name(device, "drop")} to lower, {ControlText.name(device, "reel")} to climb`
	elseif kind == "drop_refused" then
		return ControlText.DROP_REFUSED[detail] or ""
	elseif kind == "completed" then
		return if afterMiss then "Holding on again. The line stays behind for a moment" else ""
	elseif kind == "released" then
		return "You let go of the line"
	elseif kind == "lost" then
		return "Your line came loose: its anchor is gone"
	elseif kind == "blocked" then
		return ControlText.LINE_BLOCKED[detail] or ""
	elseif kind == "snagged" then
		return ControlText.LINE_BLOCKED.snagged
	end
	return ""
end

-- The panel at the bottom while on the line: its title, the line's own prompts (distinct from cancelling an aim) and a cue.
-- ctx: reeling, progress (0..1 of a deliberate let-go hold), snagged, block ("", "blocked", "shortest").
function ControlText.linePanel(ctx: any, device: Device): (string, string, string)
	local title = if ctx.reeling then ControlText.LINE_TITLE_REELING else ControlText.LINE_TITLE
	local hint = `{ControlText.name(device, "reel")}: reel in    {ControlText.name(device, "lower")}: lower    hold {ControlText.name(device, "letGo")}: let go`
	local cue = ""
	if (ctx.progress or 0) > 0 then
		cue = `Letting go... {math.floor(ctx.progress * 100 + 0.5)}%`
	elseif ctx.snagged then
		cue = ControlText.LINE_BLOCKED.snagged
	elseif ctx.block and ctx.block ~= "" then
		cue = ControlText.LINE_BLOCKED[ctx.block] or ""
	end
	return title, hint, cue
end

-- Walking (port-only reminder, shown small): how to jump and how to let down on silk.
function ControlText.walkHint(device: Device): string
	local j = ControlText.name(device, "jump")
	return `Tap {j}: hop    hold {j}: aim a leap    {ControlText.name(device, "drop")}: let yourself down on silk`
end

-- Walking to an edge to let down: what stops it.
function ControlText.edgeWalkHint(device: Device): string
	return `{ControlText.DROP_WALK}    {ControlText.name(device, "cancel")} or move: stop`
end

-- The touch Cancel button's words: on the line it is the let-go button (held), elsewhere it cancels.
function ControlText.touchCancelLabel(onLine: boolean): string
	return if onLine then "Let go\n(hold)" else "Cancel"
end

-- The controls card (H): the device's own bindings, one action per line pair.
function ControlText.helpCard(device: Device): string
	if device == "gamepad" then
		return table.concat({
			"Left stick walk   Right stick look   LB creep",
			"Tap A hop   Hold A aim, release to leap   B cancel",
			"X lower on silk   On the line: stick up reel, down lower, hold B let go",
			"Y spider-eye view   Right-stick click recenter   LT focus   RT slow motion",
			"View back to the start",
		}, "\n")
	elseif device == "touch" then
		return table.concat({
			"Arrows walk   Drag to look   Creep (hold)",
			"Tap Jump hop   Hold Jump aim, release to leap   Cancel",
			"Silk lowers on silk   On the line: ↑ reel, ↓ lower, hold Let go",
			"Eye spider-eye view   Recenter",
		}, "\n")
	end
	return table.concat({
		"WASD walk   Mouse look   Shift creep",
		"Tap Space hop   Hold Space aim, release to leap   Q cancel",
		"F lower on silk   On the line: W reel, S lower, hold Q let go",
		"V spider-eye view   R recenter   Right mouse focus   T slow motion",
		"Wheel zoom   Backspace back to start   G gait   H hide this",
	}, "\n")
end

return ControlText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">HudLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Where the on-screen controls and the prompt panel go, in the safe area (ScreenInsets.CoreUISafeInsets: clear of notches,
-- the home bar and Roblox's top bar). Pure, so tests/run.luau checks that prompts never sit under a touch button and stay
-- wide enough to read, at phone, tablet and desktop sizes. SpiderInput builds the touch buttons from TOUCH_BUTTONS.
local HudLayout = {}

export type Button = { action: string, label: string, x: number, y: number, size: number, right: boolean, textSize: number? }
export type Rect = { x0: number, y0: number, x1: number, y1: number }

-- x, y: the button's top-left corner as an offset from the safe area's bottom-left (right = false) or bottom-right corner.
HudLayout.TOUCH_BUTTONS = {
	{ action = "Forward", label = "↑", x = 78, y = -188, size = 52, right = false },
	{ action = "Left", label = "←", x = 22, y = -132, size = 52, right = false },
	{ action = "Back", label = "↓", x = 78, y = -76, size = 52, right = false },
	{ action = "Right", label = "→", x = 134, y = -132, size = 52, right = false },
	{ action = "Jump", label = "Jump\n(hold)", x = -92, y = -102, size = 72, right = true },
	{ action = "Cancel", label = "Cancel", x = -166, y = -92, size = 60, right = true, textSize = 16 },
	{ action = "Creep", label = "Creep", x = -86, y = -172, size = 60, right = true },
	{ action = "Drop", label = "Silk", x = -86, y = -242, size = 60, right = true },
	{ action = "Recenter", label = "Re-\ncenter", x = -160, y = -168, size = 52, right = true, textSize = 14 },
	{ action = "Focus", label = "Focus", x = -236, y = -242, size = 60, right = true, textSize = 14 },
	{ action = "Eye", label = "Eye", x = -156, y = -242, size = 60, right = true },
} :: { Button }

HudLayout.GAP = 12
HudLayout.MIN_PROMPT_WIDTH = 260
HudLayout.MAX_PROMPT_WIDTH = 760

function HudLayout.buttonRect(b: Button, width: number, height: number): Rect
	local x0 = if b.right then width + b.x else b.x
	local y0 = height + b.y
	return { x0 = x0, y0 = y0, x1 = x0 + b.size, y1 = y0 + b.size }
end

-- The touch buttons' combined top edge and the inner edges of the two thumb clusters.
local function clusters(width: number, height: number): (number, number, number)
	local leftEdge, rightEdge, top = 0, width, height
	for _, b in HudLayout.TOUCH_BUTTONS do
		local r = HudLayout.buttonRect(b, width, height)
		if b.right then rightEdge = math.min(rightEdge, r.x0) else leftEdge = math.max(leftEdge, r.x1) end
		top = math.min(top, r.y0)
	end
	return leftEdge, rightEdge, top
end

-- The prompt panel's horizontal span and its bottom edge (it grows upward as it wraps) for a safe area of this size.
-- Keyboard and controller: centred near the bottom. Touch: between the thumb clusters when that leaves room to read,
-- otherwise above them.
function HudLayout.promptSpan(width: number, height: number, device: string): (number, number, number)
	local gap = HudLayout.GAP
	local x0, x1, bottom
	if device == "touch" then
		local leftEdge, rightEdge, top = clusters(width, height)
		if rightEdge - leftEdge - 2 * gap >= HudLayout.MIN_PROMPT_WIDTH then
			x0, x1, bottom = leftEdge + gap, rightEdge - gap, height - gap
		else
			x0, x1, bottom = gap, width - gap, top - gap
		end
	else
		x0, x1, bottom = 24, width - 24, height - 16
	end
	local extra = (x1 - x0) - HudLayout.MAX_PROMPT_WIDTH
	if extra > 0 then
		x0 += extra / 2
		x1 -= extra / 2
	end
	return x0, x1, bottom
end

function HudLayout.overlaps(a: Rect, b: Rect): boolean
	return a.x0 < b.x1 and b.x0 < a.x1 and a.y0 < b.y1 and b.y0 < a.y1
end

return HudLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">PerceptionText</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen perception_text.gd: words belong to presentation, never the sensor.
local Text = {}
local names = {movement="movement", possible_prey="possible prey", fly_like_prey="fly-like prey"}
function Text.category(category: string): string
	return (names :: {[string]: string})[category] or "movement"
end
function Text.hasNumber(text: string): boolean return string.find(text, "[%d%%]") ~= nil end
Text.LOST = "lost sight"
return table.freeze(Text)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">PerceptionView</string>
            <string name="Source"><![CDATA[--!strict
-- Pure build_view from perception_hud.gd. Only memory and a camera adapter enter; never world actors.
local Text = require(script.Parent.PerceptionText)
local View = {}
function View.edgeFade(age: number): number
	if age < 0 or age >= 1.4 then return 0 end
	local t = math.clamp(age / 0.12, 0, 1)
	return t*t*(3-2*t) * (1-age/1.4)^1.5
end
function View.build(memory: any, camera: any, showMark: boolean?): any
	local out: any = {edges={}, rings={}, labels={}}
	local sectors: {[number]: any} = {}
	for _, c in memory:contacts() do
		if c.cueCount > 0 and c.cueDirection.Magnitude > 0.7 and not c:isInspectedNow() then
			local alpha = 0.6 * View.edgeFade(memory:cueAgeS(c))
			if alpha > 0 then
				local e = camera.edge(c.cueDirection)
				e.alpha, e.trackId = alpha, c.trackId
				local sector = math.floor(math.atan2(c.cueDirection.X, c.cueDirection.Z) / (math.pi/8) + 0.5)
				if not sectors[sector] or sectors[sector].alpha < alpha then sectors[sector] = e end
			end
		end
		if not c.hasPosition then continue end
		local point, visible, radius = camera.project(c.position, c.sizeWu)
		if not visible then continue end
		if c:isInspectedNow() then
			table.insert(out.rings, {pos=point, radius=radius, alpha=0.85, dash=1, kind="live", trackId=c.trackId})
			table.insert(out.labels, {pos=point, offset=radius+8, text=Text.category(c.category), alpha=1})
		elseif c:hasMark() then
			local stale = memory:stalenessOf(c)
			local covered = camera.covered(c.position, math.max(c.sizeWu, 0.2)*0.5+0.06)
			if showMark ~= false then
				table.insert(out.rings, {pos=point, radius=radius, alpha=(0.6-0.48*stale)*(if covered then 0.6 else 1),
					dash=1-0.7*stale, kind="mark", trackId=c.trackId})
			end
			local age = memory:ageS(c)
			if age < 2.5 then table.insert(out.labels, {pos=point, offset=radius+8, text=Text.LOST, alpha=math.clamp(1-age/2.5,0,1)}) end
		end
	end
	for _, e in sectors do table.insert(out.edges, e) end
	return out
end
return View
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
