_floor_i = table.freeze({id=\"ranger_can\",at=Vector3.new(124,-70,226),color=\"647b6d\"}),\n room_floor_b = table.freeze({id=\"volunteer_can\",at=Vector3.new(333,-70,36),color=\"a45c47\"}),\n}) :: {[string]: any}\nSites.ANTHILLS=table.freeze({garden_b1=table.freeze({id=\"garden_ant_nest\",at=Vector3.new(-182,-84.6,-205)})}) :: {[string]: any}\n-- Low overlapping soil caps avoid the old separated pancake silhouette.\nlocal caps={{10,.5,-.05},{7,.65,.075},{4,.7,.25}}\nfunction Sites.antHeight(offset: Vector3): number\n local height=0\n for _,cap in caps do\n  local radius=cap[1]/2;local q=(offset.X^2+offset.Z^2)/(radius*radius)\n  if q<=1 then height=math.max(height,cap[3]+cap[2]*.5*math.sqrt(1-q)) end\n end\n return height\nend\nfunction Sites.nearAnthill(pos: Vector3): any\n for _,hill in Sites.ANTHILLS do\n  if math.abs(pos.Y-hill.at.Y)<12 and (Vector3.new(pos.X,hill.at.Y,pos.Z)-hill.at).Magnitude<40 then return hill end\n end\n return nil\nend\nfunction Sites.pieces(region: any): {any}\n if region.id==Pocket.REGION then return Pocket.pieces() end\n local hill=Sites.ANTHILLS[region.id]\n if hill then\n  local out: {any}={}\n  for i,layer in {{10,.2},{4.8,.2},{2.6,.2}} do\n   local y=(i-1)*.2\n   table.insert(out,{id=hill.id..\"_tier\"..i,lo=hill.at+Vector3.new(-layer[1]/2,y,-layer[1]/2),\n    hi=hill.at+Vector3.new(layer[1]/2,y+layer[2],layer[1]/2),profile=\"bare_wood_rough\",color=Color3.fromHex(\"77604a\"),material=\"Ground\"})\n  end\n  return out\n end\n local site=Sites.CANS[region.id];if not site then return {} end\n local out: {any}={};local p=site.at\n local function box(name: string,lo: Vector3,hi: Vector3)\n  table.insert(out,{id=site.id..\"_\"..name,lo=p+lo,hi=p+hi,profile=\"painted_metal_smooth\",color=Color3.fromHex(site.color),material=\"Metal\"})\n end\n -- Stepped thin shell: exact AABBs for the engine's box-based movement, open interior.\n box(\"bottom\",Vector3.new(0,0,-2.1),Vector3.new(12.2,.3,2.1))\n box(\"top\",Vector3.new(0,6.3,-2.1),Vector3.new(12.2,6.6,2.1))\n for _,sign in {-1,1} do\n  local z0,z1=if sign<0 then -3.3 else 3,if sign<0 then -3 else 3.3\n  box(\"side\"..sign,Vector3.new(.25,1.7,z0),Vector3.new(11.95,4.9,z1))\n  local a,b=if sign<0 then -3.1 else 2.0,if sign<0 then -2.0 else 3.1\n  box(\"lower\"..sign,Vector3.new(.25,.3,a),Vector3.new(11.95,1.7,b))\n  box(\"upper\"..sign,Vector3.new(.25,4.9,a),Vector3.new(11.95,6.3,b))\n end\n box(\"base\",Vector3.new(0,.3,-3),Vector3.new(.25,6.3,3))\n -- A torn drinking aperture 1.8 x 1.8 cm: large enough for the game's spider, not a fake painted hole.\n box(\"lid_low\",Vector3.new(11.95,.3,-3),Vector3.new(12.2,3.2,3))\n box(\"lid_high\",Vector3.new(11.95,5,-2),Vector3.new(12.2,6.3,2))\n box(\"lid_left\",Vector3.new(11.95,3.2,-3),Vector3.new(12.2,5,-.9))\n box(\"lid_right\",Vector3.new(11.95,3.2,.9),Vector3.new(12.2,5,3))\n return out\nend\nfunction Sites.decor(region: any): {any}\n if region.id==Pocket.REGION then return Pocket.decor() end\n local hill=Sites.ANTHILLS[region.id]\n if hill then\n  local out: {any}={}\n  for i,p in Sites.pieces(region) do\n   local cap=caps[i]\n   table.insert(out,{id=p.id..\"_earth\",size=Vector3.new(cap[1],cap[2],cap[1]),at=hill.at+Vector3.new(0,cap[3],0),color=p.color,material=\"Sand\",shape=\"Ellipsoid\",shadow=true})\n  end\n  table.insert(out,{id=hill.id..\"_entrance\",size=Vector3.new(.8,.025,.7),at=hill.at+Vector3.new(0,.615,0),color=Color3.fromHex(\"241c15\"),shape=\"Ellipsoid\"})\n  for i=1,12 do\n   local angle=i*2.39996;local radius=2.1+(i%4)*.7\n   local offset=Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)\n   table.insert(out,{id=hill.id..\"_grain\"..i,size=Vector3.new(.22,.17,.27),at=hill.at+offset+Vector3.new(0,Sites.antHeight(offset)+.06,0),color=Color3.fromHex(\"8b7151\"),shape=\"Ball\",full=true})\n  end\n  for i=1,8 do\n   local route=AntForage.route(i)\n   table.insert(out,{id=hill.id..\"_forage_fragment\"..i,size=Vector3.new(.13,.08,.18),at=hill.at+route.direction*route.distance+Vector3.new(0,.04,0),color=Color3.fromHex(\"b5a57c\"),shape=\"Ellipsoid\",full=i>1})\n  end\n  return out\n end\n local site=Sites.CANS[region.id];if not site then return {} end\n local out: {any}={};local p=site.at\n local function part(name: string,size: Vector3,at: Vector3,color: string,shape: string?,turn: Vector3?,material: string?,full: boolean?)\n  table.insert(out,{id=site.id..\"_\"..name,size=size,at=p+at,color=Color3.fromHex(color),material=material or \"Metal\",shape=shape,turn=turn,shadow=true,full=full})\n end\n -- Keep the existing walkable shell and aperture; exposed ends are aluminium,\n -- with a rolled rim and a hollow pull tab rather than a painted solid face.\n for _,spec in Sites.pieces(region) do\n  if spec.id==site.id..\"_base\" then continue end -- the rolled aluminium base below already draws this closed end\n  local lid=string.find(spec.id,\"_lid_\",1,true)~=nil or spec.id==site.id..\"_base\"\n  part(spec.id,spec.hi-spec.lo,(spec.lo+spec.hi)*.5-p,if lid then \"aeb5b5\" else site.color)\n end\n part(\"rolled_base\",Vector3.new(.20,6.7,6.7),Vector3.new(.14,3.3,0),\"aeb5b5\",\"Cylinder\")\n local rim={{0,-2.1},{0,2.1},{1.7,3.3},{4.9,3.3},{6.6,2.1},{6.6,-2.1},{4.9,-3.3},{1.7,-3.3}}\n for i,a in rim do\n  local b=rim[i%#rim+1];local dy,dz=b[1]-a[1],b[2]-a[2]\n  part(\"rolled_lid_\"..i,Vector3.new(.20,math.sqrt(dy*dy+dz*dz)+.08,.20),\n   Vector3.new(12.24,(a[1]+b[1])*.5,(a[2]+b[2])*.5),\"c4cbcb\",nil,Vector3.new(math.deg(math.atan2(dz,dy)),0,0))\n end\n part(\"label\",Vector3.new(7,.025,3.2),Vector3.new(5.8,6.62,0),\"ded6bd\",nil,nil,\"SmoothPlastic\",true)\n part(\"label_band\",Vector3.new(1,.028,3.2),Vector3.new(4.3,6.63,0),site.color,nil,nil,\"SmoothPlastic\",true)\n part(\"tab_left\",Vector3.new(.12,.75,.12),Vector3.new(12.36,5.65,-.38),\"d4d9d9\")\n part(\"tab_right\",Vector3.new(.12,.75,.12),Vector3.new(12.36,5.65,.38),\"d4d9d9\")\n part(\"tab_top\",Vector3.new(.12,.12,.88),Vector3.new(12.36,6.025,0),\"d4d9d9\")\n part(\"tab_bottom\",Vector3.new(.12,.12,.88),Vector3.new(12.36,5.275,0),\"d4d9d9\")\n part(\"dry_syrup\",Vector3.new(2.2,.018,1.3),Vector3.new(13.3,.014,.3),\"75523b\",\"Ellipsoid\",nil,\"SmoothPlastic\",true)\n part(\"scuff1\",Vector3.new(.035,.04,1.4),Vector3.new(4,6.66,-.25),\"a4aca7\",nil,Vector3.new(0,17,0),nil,true)\n return out\nend\nfunction Sites.drawnPieces(region: any): {string}\n if region.id==Pocket.REGION then return Pocket.drawnPieces() end\n local out: {string}={};for _,p in Sites.pieces(region) do table.insert(out,p.id) end;return out\nend\nreturn table.freeze(Sites)\n",6661,4158548360},{"Shared/World/LookPlan","--!strict\n-- Which regions' drawn looks a client holds, and at what detail, from where the spider is (ROBLOX-108). Pure: a plan is a function of the place, the tier, the\n-- region the spider was last in and what the client already holds (for the hysteresis), so the CLI tests ask exactly what a client asks. Client/LookStream\n-- builds and destroys the looks to follow the plan; the looks themselves are the regions' own seeded generators (Region.decor), so a look built on a client\n-- is part for part the one the server used to build and replicate.\n--\n-- Until ROBLOX-107 every region's look was a persistent model, on every client wherever the spider was: 3,647 parts outside the window at the full tier, 1,215 at\n-- the low. Now a client holds at most BUDGET parts of looks at once (the sill's Decor, the home, is not counted: it is the server's and stays persistent):\n--   1. the region the spider is in and every region it meets (its seams) at the tier's detail, always: no look pops in where the spider can step or look closely;\n--   2. the house's shell (the brick walls, the roof and the eaves: FAR) at its far detail wherever the spider is, a handful of big parts, so the house never has a\n--      hole in it seen from the far end of the garden (a wall's drawn bricks stand in for its boxes, which are invisible);\n--   3. then the other regions, nearest first, within RADIUS of the spider, each at the tier's detail if it fits the budget, else (at the full tier) the low\n--      detail if that fits, else as it is (far, or nothing). A region already held is reckoned KEEP studs nearer and RADIUS + KEEP away still counts, so a\n--      spider walking along the edge of a radius does not build and destroy the same look over and over.\n-- Levels: \"full\" (every record), \"low\" (the records without `full`, the low tier's look) and \"far\" (FAR's records, the walls' mortar beds drawn as brick).\n-- A region with no look (the sill) is never in a plan. At the low tier there is no \"full\".\n-- ROBLOX-115 (the preserve, World/Preserve and World/PreserveLook): the active world's drawn zones (WorldMap.drawn: the backdrop, none in the test garden) are\n-- planned with the regions. Each is held far wherever the spider is (step 2, as the house's shell: its `far` records, the cheap masses, without the full tier's own\n-- at the low tier), and within RADIUS at the tier's detail (step 3) as the budget allows. So a client holds the far preserve as masses and what is near whole.\nlocal WorldMap = require(script.Parent.WorldMap)\nlocal Region = require(script.Parent.Region)\nlocal Garden = require(script.Parent.Garden)\n\nlocal LookPlan = {}\n\nexport type Level = string -- \"full\" | \"low\" | \"far\"\nexport type Plan = { [string]: Level }\n\n-- The most look parts outside the window a client holds at once, by tier (Data/Detail's \"full\" and \"low\").\nLookPlan.BUDGET = table.freeze({ full = 1500, low = 500 })\n-- How far (studs, from the spider to a region's bounds) an optional region is drawn, by tier.\nLookPlan.RADIUS = table.freeze({ full = 260, low = 160 })\n-- The hysteresis: a region already held is reckoned this many studs nearer, and is kept out to RADIUS + KEEP.\nLookPlan.KEEP = 30\n-- (ROBLOX-117) The patches (the preserve's near detail of the ground: World/Hut.patches, WorldMap.patches) are drawn only this near the spider (studs, from the\n-- spider to a patch's bounds), by tier, nearest first right after what must be drawn and the far looks (step 2b below), at the tier's detail as the budget allows;\n-- and at the full tier, out to PATCH_RING, at the low tier's detail (a few blades and stones); a patch already held is kept PATCH_KEEP further. So the blades,\n-- chips and stones stand thick where the eye is, thin a little further off, and nowhere else.\nLookPlan.PATCH_RADIUS = table.freeze({ full = 22, low = 20 })\nLookPlan.PATCH_RING = 42\nLookPlan.PATCH_KEEP = 8\n-- (ROBLOX-117) The most parts of patches a plan holds, by tier: the rest of the budget is the garden's cells and the backdrop's (step 3).\nLookPlan.PATCH_SHARE = table.freeze({ full = 700, low = 100 })\n\n-- The house's shell, drawn far wherever the spider is: per kind, the ids of the records its far look keeps (the big ones a distant eye reads), in order.\n-- The mortar beds behind the bricks (`Mortar`, the house_wall's `Above` beds round the window) are drawn in the first brick colour and the bricks' material,\n-- as the drawn house beyond the walkable walls always is (`HouseWest`, `HouseEast`): from far off, a wall of brick.\nLookPlan.FAR = table.freeze({\n\thouse_wall = table.freeze({ \"Mortar\", \"Above1\", \"Above2\" }),\n\t-- (ROBLOX-112: the window's jambs; the eaves carry what wall_upper's look did above the head, the house round it among them)\n\twall_upper = table.freeze({ \"Jamb1\", \"Jamb2\" }),\n\t-- (the room beyond the window, its ceiling and far wall, so the window does not show the sky through the house from afar; its floor is not seen from the garden)\n\teaves = table.freeze({ \"Mortar\", \"Soffit\", \"Fascia\", \"RoofSlope\", \"HouseWest\", \"HouseEast\", \"EavesWest\", \"EavesEast\", \"RoomCeiling\", \"RoomFar\" }),\n\twall_west = table.freeze({ \"Mortar\", \"Pipe\" }),\n\twall_west_upper = table.freeze({ \"Mortar\", \"Pipe\" }), -- (the drainpipe's boxes are hidden under its drawing: far off it is drawn too)\n\teaves_west = table.freeze({ \"Mortar\", \"Soffit\", \"Pipe\", \"Neck\" }),\n})\nlocal AS_BRICK: { [string]: boolean } = { Mortar = true, Above1 = true, Above2 = true, Jamb1 = true, Jamb2 = true }\n\nlocal recordsCache: { [string]: { Garden.Drawn } } = {}\n\n-- The drawn records of a region's look at a level (the same list for the same region and level; do not change it). `tier` (\"full\" or \"low\") matters only to a\n-- backdrop zone's far look (ROBLOX-115), whose full-tier records the low tier leaves out.\nfunction LookPlan.records(region: WorldMap.Region, level: Level, tier: string?): { Garden.Drawn }\n\tlocal backdrop = region.kind == \"backdrop\"\n\tlocal key = region.id .. \"/\" .. tostring(region.seed) .. \"/\" .. level .. (if backdrop and level == \"far\" and tier == \"low\" then \"/low\" else \"\")\n\tlocal cached = recordsCache[key]\n\tif cached ~= nil then return cached end\n\tlocal all = Region.decor(region)\n\tlocal out: { Garden.Drawn } = {}\n\tif level == \"full\" then\n\t\tout = all\n\telseif level == \"low\" then\n\t\tfor _, d in all do if not d.full then table.insert(out, d) end end\n\telseif level == \"far\" and backdrop then\n\t\tfor _, d in all do if d.far and not (tier == \"low\" and d.full) then table.insert(out, d) end end\n\telseif level == \"far\" then\n\t\tlocal keep = LookPlan.FAR[region.kind]\n\t\tif keep ~= nil then\n\t\t\tlocal brick = Color3.fromHex(Garden.WALL.bricks[1])\n\t\t\tfor _, id in keep do\n\t\t\t\tfor _, d in all do\n\t\t\t\t\tif d.id == id and not d.full then\n\t\t\t\t\t\tif AS_BRICK[id] then\n\t\t\t\t\t\t\tlocal c = table.clone(d)\n\t\t\t\t\t\t\tc.color, c.material = brick, Garden.WALL.brickMaterial\n\t\t\t\t\t\t\ttable.insert(out, c)\n\t\t\t\t\t\telse\n\t\t\t\t\t\t\ttable.insert(out, d)\n\t\t\t\t\t\tend\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\telse\n\t\terror(\"no look level \" .. level)\n\tend\n\trecordsCache[key] = out\n\treturn out\nend\n\n-- How many parts a region's look is at a level (0 for none).\nfunction LookPlan.count(region: WorldMap.Region, level: Level?, tier: string?): number\n\tif level == nil then return 0 end\n\treturn #LookPlan.records(region, level, tier)\nend\n\n-- Whether a region (or a drawn zone) has a look the plan streams.\nlocal function streamed(region: WorldMap.Region): boolean\n\treturn Region.streamed(region.kind)\nend\n\n-- The active world's drawn zones from a map (none from a map that has no `drawn`, as the tests' stand-ins).\nlocal function drawnOf(m: any): { WorldMap.Region }\n\tif m.drawn == nil then return {} end\n\treturn m.drawn()\nend\n\n-- The active world's patches from a map (none from a map that has no `patches`).\nlocal function patchesOf(m: any): { WorldMap.Region }\n\tif m.patches == nil then return {} end\n\treturn m.patches()\nend\n\n-- A region, a drawn zone or (ROBLOX-117) a patch by id, from a map.\nfunction LookPlan.lookup(m: any, id: string): WorldMap.Region?\n\tlocal r = m.region(id)\n\tif r == nil and m.drawnZone ~= nil then r = m.drawnZone(id) end\n\tif r == nil and m.patch ~= nil then r = m.patch(id) end\n\treturn r\nend\n\n-- The distance from a point to a region's bounds (0 inside them).\nfunction LookPlan.distance(region: WorldMap.Region, pos: Vector3): number\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal dx = math.max(lo.X - pos.X, 0, pos.X - hi.X)\n\tlocal dy = math.max(lo.Y - pos.Y, 0, pos.Y - hi.Y)\n\tlocal dz = math.max(lo.Z - pos.Z, 0, pos.Z - hi.Z)\n\treturn math.sqrt(dx * dx + dy * dy + dz * dz)\nend\n\n-- The plan at a place, for a tier (\"full\" or \"low\"): `here`, the region the spider was last in (where the place is in none); `held`, what the client holds now\n-- (for the hysteresis). Returns the plan and its parts. `map`: WorldMap unless a test hands in another with the same functions.\nfunction LookPlan.plan(pos: Vector3, tier: string, here: WorldMap.Region?, held: Plan?, map: any?): (Plan, number)\n\tlocal m: any = map or WorldMap\n\tlocal top: Level = if tier == \"low\" then \"low\" else \"full\"\n\tlocal budget = if tier == \"low\" then LookPlan.BUDGET.low else LookPlan.BUDGET.full\n\tlocal radius = if tier == \"low\" then LookPlan.RADIUS.low else LookPlan.RADIUS.full\n\tlocal regions: { WorldMap.Region } = m.regions()\n\tlocal zones = drawnOf(m)\n\tlocal own: WorldMap.Region = m.at(pos) or here or (m.region(m.HOME) :: WorldMap.Region)\n\tlocal plan: Plan = {}\n\tlocal total = 0\n\tlocal function has(region: WorldMap.Region): boolean\n\t\treturn streamed(region)\n\tend\n\tlocal function count(region: WorldMap.Region, level: Level?): number\n\t\treturn LookPlan.count(region, level, tier)\n\tend\n\tlocal function set(region: WorldMap.Region, level: Level?)\n\t\ttotal += count(region, level) - count(region, plan[region.id])\n\t\tplan[region.id] = level :: any\n\tend\n\t-- 1. the region the spider is in and the regions it meets, at the tier's detail\n\tlocal required: { [string]: boolean } = {}\n\tlocal near: { WorldMap.Region } = {}\n\tif has(own) then table.insert(near, own) end\n\tfor _, n in own.neighbors do\n\t\tlocal r = m.region(n.id)\n\t\tif r ~= nil and has(r) and not required[r.id] then table.insert(near, r) end\n\t\tif r ~= nil then required[r.id] = true end\n\tend\n\trequired[own.id] = true\n\tfor _, r in near do set(r, top) end\n\t-- (never expected: if the region and its neighbours at the full tier's detail overrun the budget, the neighbours farthest away are drawn low)\n\tif total > budget and top == \"full\" then\n\t\tlocal order = table.clone(near)\n\t\ttable.sort(order, function(a, b) return LookPlan.distance(a, pos) > LookPlan.distance(b, pos) end)\n\t\tfor _, r in order do\n\t\t\tif total <= budget then break end\n\t\t\tif r ~= own then set(r, \"low\") end\n\t\tend\n\tend\n\t-- 2. the house's shell, far, wherever it is not drawn already, and (ROBLOX-115) every zone of the backdrop as its masses\n\tfor _, r in regions do\n\t\tif plan[r.id] == nil and LookPlan.FAR[r.kind] ~= nil then set(r, \"far\") end\n\tend\n\tfor _, r in zones do\n\t\tif plan[r.id] == nil then set(r, \"far\") end\n\tend\n\t-- 2b. (ROBLOX-117) the patches near the spider, nearest first, at the tier's detail as the budget allows\n\tlocal patches = patchesOf(m)\n\tif #patches > 0 then\n\t\tlocal pr = if tier == \"low\" then LookPlan.PATCH_RADIUS.low else LookPlan.PATCH_RADIUS.full\n\t\tlocal ring = if tier == \"low\" then pr else LookPlan.PATCH_RING\n\t\tlocal close: { { region: WorldMap.Region, d: number, i: number, level: Level } } = {}\n\t\tfor i, r in patches do\n\t\t\tlocal d = LookPlan.distance(r, pos)\n\t\t\tlocal was = if held ~= nil then held[r.id] else nil\n\t\t\tlocal level: Level? = nil\n\t\t\tif d <= pr or (was == top and d <= pr + LookPlan.PATCH_KEEP) then level = top\n\t\t\telseif d <= ring or (was ~= nil and d <= ring + LookPlan.PATCH_KEEP) then level = \"low\" end\n\t\t\tif level ~= nil then table.insert(close, { region = r, d = if was ~= nil then d - LookPlan.PATCH_KEEP else d, i = i, level = level :: Level }) end\n\t\tend\n\t\ttable.sort(close, function(a, b)\n\t\t\tif a.d ~= b.d then return a.d < b.d end\n\t\t\treturn a.i < b.i\n\t\tend)\n\t\tlocal share = if tier == \"low\" then LookPlan.PATCH_SHARE.low else LookPlan.PATCH_SHARE.full\n\t\tlocal used = 0\n\t\tfor _, o in close do\n\t\t\tlocal c = count(o.region, o.level)\n\t\t\tif used + c <= share and total + c <= budget then\n\t\t\t\tset(o.region, o.level)\n\t\t\t\tused += c\n\t\t\tend\n\t\tend\n\tend\n\t-- 3. the others, nearest first, within the radius, as the budget allows\n\tlocal others: { { region: WorldMap.Region, d: number, i: number } } = {}\n\tlocal function consider(r: WorldMap.Region, i: number)\n\t\tif has(r) and not required[r.id] then\n\t\t\tlocal d = LookPlan.distance(r, pos)\n\t\t\tlocal kept = held ~= nil and held[r.id] ~= nil and held[r.id] ~= \"far\"\n\t\t\tif d <= radius or (kept and d <= radius + LookPlan.KEEP) then\n\t\t\t\ttable.insert(others, { region = r, d = if kept then d - LookPlan.KEEP else d, i = i })\n\t\t\tend\n\t\tend\n\tend\n\tfor i, r in regions do consider(r, i) end\n\tfor i, r in zones do consider(r, #regions + i) end\n\t-- (ROBLOX-117: the walkable regions before the backdrop's zones, each nearest first: in the preserve's garden its cells' plants come before the zone round it.\n\t-- A map with no zones, the test garden's, is ordered as it always was)\n\tlocal nRegions = #regions\n\ttable.sort(others, function(a, b)\n\t\tlocal ra = if a.region.kind == \"verge\" then 2 elseif a.i > nRegions then 1 else 0\n\t\tlocal rb = if b.region.kind == \"verge\" then 2 elseif b.i > nRegions then 1 else 0\n\t\tif ra ~= rb then return ra < rb end\n\t\tif a.d ~= b.d then return a.d < b.d end\n\t\treturn a.i < b.i\n\tend)\n\tfor _, o in others do\n\t\tlocal r = o.region\n\t\tlocal now = count(r, plan[r.id])\n\t\tif total - now + count(r, top) <= budget then\n\t\t\tset(r, top)\n\t\telseif top == \"full\" and total - now + count(r, \"low\") <= budget and now < count(r, \"low\") then\n\t\t\tset(r, \"low\")\n\t\tend\n\tend\n\treturn plan, total\nend\n\n-- The ids of the regions that must be drawn at a place (the one it is in and the ones it meets), for the tests and the client's order of work.\nfunction LookPlan.required(pos: Vector3, here: WorldMap.Region?, map: any?): { [string]: boolean }\n\tlocal m: any = map or WorldMap\n\tlocal own: WorldMap.Region = m.at(pos) or here or (m.region(m.HOME) :: WorldMap.Region)\n\tlocal out: { [string]: boolean } = { [own.id] = true }\n\tfor _, n in own.neighbors do out[n.id] = true end\n\treturn out\nend\n\nreturn table.freeze(LookPlan)\n",14254,453198522},{"Shared/World/Meadow","--!strict\n-- The meadow's edge and the bench, bin and lamppost, walkable (ROBLOX-119, docs/PARK_WORLD_DESIGN.md Phase C round 1): home ranges 3 and 8 at full spider detail, where\n-- the hut garden's gravel path (World/Hut's path_m1..m4) comes out at z 13 m. Pure data and pure generators, as World/Hut's are: the regions (`author`), their physical\n-- boxes (`pieces`), their drawn looks (`decor`), their near detail (`patches`), and the life they hold (`bestiary`, `ambient`) and the crab spiders' flowers (`CRABS`),\n-- all from the region and its seed, so the server, every client and the CLI tests get the same meadow. Nothing here requires World/WorldMap or World/Garden.\n--\n-- Studs, the sill's frame (World/Preserve: x east, -z north, a stud a centimetre; the ground GROUND as the hut garden's, World/Hut.GROUND). True scale.\n--\n-- The bench patch (home range 8, 3 by 3 m: x -210..90, z -816..-1116, that is x 43.65..46.65 m, z 13..16 m), where the path widens at the meadow's edge:\n--   pad_a1..c3 ...... nine cells of a metre of fine gravel (rows a to c north from the path's end, columns 1 to 3 west to east); along the north a concrete slab under\n--                     the furniture (SLAB, 2 cm proud of the gravel); in pad_b3 a cast-iron drain grate over its pit (GRATE: bars 2 cm with 2 cm slots, the pit\n--                     10 cm deep, a spider can go down through a slot).\n--   bench_w, bench_e .. a park bench facing south over the path (BENCH: 1.64 m long, its seat of four slats 45 cm over the slab, three back slats, cast-iron ends), in\n--                     two halves split at x -70 (each whole inside the streaming radius); the gap between its second and third seat slats is a home (bench_slats).\n--   bin ............. a steel litter bin (BIN: 40 by 40 cm, 90 cm to its lid) on a flared base raised on four feet over the slab: the gap under the base's lip is a\n--                     home (bin_lip); a drinks can and a crisp packet dropped on the gravel by it.\n--   lamp_1..4 ....... the lamppost (LAMP: a pole 10 cm square on a cast base, a lantern on top 3.4 m up), in four regions up the pole (each whole in the radius); its\n--                     lantern lights at dusk (Client/HutLife) and the moths come to it at night.\n-- The meadow's edge (home range 3, 5 by 5 m: x -310..190, z -1116..-1616, that is x 42.65..47.65 m, z 16..21 m), north of the bench patch, late summer:\n--   meadow_a1..e5 ... twenty-five cells of a metre (rows a to e north from the bench patch, columns 1 to 5 west to east) of an American tallgrass meadow at true size:\n--                     big bluestem (Andropogon gerardii: culms to 1.13 m here, the turkey-foot heads) and little bluestem (Schizachyrium scoparium: 50 to 70 cm, its\n--                     silvery tufts) in clumps, common milkweed, purple coneflower, black-eyed Susan, wild bergamot, Canada goldenrod and yarrow; the thatch, bare\n--                     soil and an ant hill between them; the south edge along the gravel mown short. Every culm, leaf and flower head a spider can climb is a box; the\n--                     blades, racemes, rays and florets are drawn over them (World/Hut.drawPlant for the hut garden's kinds). A curled dead leaf lying on two old\n--                     stems in meadow_b2 is a home (meadow_b2_leaf).\n-- The life (`bestiary`, `ambient`): leafhoppers on the bluestem's culms, house flies and hoverflies on the flower heads, small moths on the grass heads from dusk; ants\n-- at their hill (Prey/Ant: not food, and a strike at one is refused); house flies at the bin; moths at the lamp's lantern. The crab spiders (Predator/CrabSpider) sit on\n-- the goldenrod's plumes and the yarrow's heads (CRABS).\nlocal Hut = require(script.Parent.Hut)\n\nlocal Meadow = {}\n\nexport type Region = Hut.Region\nexport type Piece = Hut.Piece\nexport type Drawn = Hut.Drawn\nexport type Box = Hut.Box\n\nlocal function v(x: number, y: number, z: number): Vector3\n\treturn Vector3.new(x, y, z)\nend\nlocal function hex(s: string): Color3\n\treturn Color3.fromHex(s)\nend\nlocal MOD = 2147483647\nlocal TAU = 2 * math.pi\nlocal function rng(seed: number, salt: number): () -> number\n\tlocal state = (seed + salt * 7919) % MOD\n\tif state <= 0 then state += MOD - 1 end\n\treturn function(): number\n\t\tstate = (state * 16807) % MOD\n\t\treturn (state - 1) / (MOD - 1)\n\tend\nend\nlocal function between(rand: () -> number, a: number, b: number): number\n\treturn a + (b - a) * rand()\nend\nlocal function pick<T>(list: { T }, rand: () -> number): T\n\treturn list[1 + math.floor(rand() * #list)]\nend\n\n-- ---------------------------------------------------------------- the numbers\nlocal GT = Hut.GROUND\nMeadow.GROUND = GT\nMeadow.CELL = 100\n-- The bench patch's pad and the meadow's core (studs).\nMeadow.PAD = table.freeze({ x0 = -210, x1 = 90, z0 = -816, z1 = -516 })\nMeadow.CORE = table.freeze({ x0 = -310, x1 = 190, z0 = -1316, z1 = -816 })\n-- The concrete slab under the furniture, its top SL (2 cm over the gravel).\nMeadow.SLAB = table.freeze({ x0 = -200, x1 = 86, z0 = -806, z1 = -730, top = GT + 2 })\nlocal SL = Meadow.SLAB.top\n-- The bench, facing south: its ends' frames, its seat's four slats (front to back, `w` deep with `gap` between), its back's three slats, true size (a seat 45 cm over the\n-- slab and 42 deep, its back to 81 cm; 1.64 m long). Split at `mid` into two regions.\nMeadow.BENCH = table.freeze({ x0 = -152, x1 = 12, mid = -70, ends = table.freeze({ -144, 0 }), frame = 4, front = -748, w = 9, gap = 1.8, thick = 3, seat = 45,\n\tlegTop = 38, railZ = table.freeze({ -792, -748 }), post = table.freeze({ -796, -792 }), back = table.freeze({ { 50, 59 }, { 61, 70 }, { 72, 81 } }), backZ = table.freeze({ -792, -789 }),\n\tarmZ = table.freeze({ -792, -746 }), arm = table.freeze({ 62, 65 }), armPost = table.freeze({ -750, -747 }) })\n-- The litter bin: its body, its base plate (the lip) on four feet 1.4 cm tall, its rolled rim and its lid; the can and the crisp packet by it on the gravel.\nMeadow.BIN = table.freeze({ x0 = 40, x1 = 80, z0 = -794, z1 = -754, feet = 1.4, base = 4, lip = 3, top = 80, rim = 83, lid = 88 })\nMeadow.CAN = table.freeze({ x0 = 52, x1 = 64, z0 = -728, z1 = -721.4 }) -- a 12 oz can (12.2 cm by 6.6 cm) lying on its side\nMeadow.PACKET = table.freeze({ x0 = 18, x1 = 32, z0 = -726, z1 = -717, h = 2.2 }) -- a crisp packet, crumpled flat\n-- The lamppost: a cast base, the pole 10 cm square to `top`, the lantern on it (its plate, glass, cap and finial); the regions split up the pole at `splits`.\nMeadow.LAMP = table.freeze({ x = -180, z = -768, half = 5, base = table.freeze({ half = 10, h = 14 }), top = 340, splits = table.freeze({ 90, 180, 270 }),\n\tplate = table.freeze({ half = 12, h = 3 }), glass = table.freeze({ half = 10, h = 26 }), cap = table.freeze({ half = 15, h = 4 }), finial = table.freeze({ half = 2, h = 6 }) })\n-- The drain grate in pad_b3: its hole, its bars across it (x-long), the pit's floor `deep` under the gravel.\nMeadow.GRATE = table.freeze({ x0 = 20, x1 = 50, z0 = -660, z1 = -630, wall = 2, bars = 6, bar = 2, deep = 12 })\nlocal LAMP_TOP = SL + Meadow.LAMP.top\nMeadow.LANTERN = table.freeze({ at = v(Meadow.LAMP.x, LAMP_TOP + Meadow.LAMP.plate.h + Meadow.LAMP.glass.h * 0.5, Meadow.LAMP.z) }) -- the light (Client/HutLife)\n\n-- The palette.\nlocal C = {\n\tgravel = \"b3a68a\", gravelDark = \"938870\", concrete = \"9a958b\", concreteDark = \"817c72\", iron = \"26292b\", ironDark = \"1b1d1f\", slat = \"8a6440\", slatDark = \"6e4f33\",\n\tbin = \"3d4a3e\", binDark = \"2c372d\", can = \"b8242a\", canTop = \"c9cdd0\", packet = \"d9a227\", packetFoil = \"c7cbcf\", lamp = \"1f2224\", glass = \"e6e0c8\",\n\tsoil = \"6e5a3e\", meadow = \"76693f\", thatch = { \"b8a77a\", \"a89766\", \"c2b38a\", \"9c8b5e\", \"b09f70\" }, mown = { \"6f9a46\", \"7d9a4e\", \"5f8a3e\" },\n\tbig = { \"8a6a4a\", \"7d6a52\", \"6f7a52\", \"8f7650\", \"6a7a5a\", \"9a7a56\" }, bigLeaf = { \"6f8a5a\", \"7a8a62\", \"8a7a5a\", \"5f7a52\", \"9a7a5a\" }, raceme = { \"6a4a5a\", \"7a5a4a\", \"5e4a52\" },\n\tlittle = { \"9a8a62\", \"b08a5a\", \"8a8a5e\", \"a07a52\" }, littleLeaf = { \"8a9a6a\", \"9aa070\", \"a89a6a\", \"7a8a5a\" }, tuft = { \"e6e2d6\", \"dcd8cc\", \"efece2\" },\n\tsusan = \"e8a21e\", susanCone = \"3a2418\", susanLeaf = \"5a7a3a\", yarrow = \"ece8dc\", yarrowLeaf = \"6f8a52\", hill = \"8a7050\", hillDark = \"6e5a40\", leaf = \"8a6a3a\", leafDark = \"6a4a28\",\n\tstem = \"6a7a48\",\n}\n\n-- ---------------------------------------------------------------- the meadow's plants (true sizes; the hut garden's kinds keep World/Hut.PLANT_SPECS)\n-- black-eyed Susan (Rudbeckia hirta): 30 to 90 cm, a few rough leaves up the stem, a head 5 to 7 cm of yellow rays round a dark brown cone.\n-- yarrow (Achillea millefolium): 30 to 90 cm, feathery leaves, a flat-topped head 5 to 10 cm of tiny white florets.\ntype Leaf = { h: number, dir: string, l: number, w: number }\nlocal SPECS: { [string]: any } = {\n\tsusan = { stem = 0.5, height = 58, thick = 0.25, leaves = { { h = 10, dir = \"x+\", l = 9, w = 3 }, { h = 24, dir = \"z-\", l = 7, w = 2.4 }, { h = 38, dir = \"x-\", l = 6, w = 2 } },\n\t\thead = { w = 6, h = 0.5 }, cone = { w = 2.2, h = 2 }, color = C.stem, leaf = C.susanLeaf, flower = C.susan },\n\tyarrow = { stem = 0.4, height = 52, thick = 0.2, leaves = { { h = 12, dir = \"x-\", l = 8, w = 1.6 }, { h = 26, dir = \"z+\", l = 7, w = 1.4 }, { h = 40, dir = \"x+\", l = 6, w = 1.2 } },\n\t\thead = { w = 6.5, h = 1.6 }, color = C.stem, leaf = C.yarrowLeaf, flower = C.yarrow },\n}\nMeadow.SPECS = SPECS\n-- The grasses: a clump's culms (offsets from its crown, studs), their heights (studs; big bluestem's culms to 1.2 m here, little bluestem's 50 to 70 cm), how thick, the\n-- two tallest headed; one blade bent over flat at `bent` (a bridge between clumps), `blade` long.\nlocal GRASS = {\n\tbig = { at = { { 0, 0 }, { 3, 1 }, { -2, 2.5 }, { 1, -3 } }, h = { 113, 100, 92, 106 }, half = 0.25, head = { half = 0.8, h = 7 }, bent = 38, blade = 12 },\n\tlittle = { at = { { 0, 0 }, { 2.4, 0.8 }, { -1.6, 2 }, { 0.8, -2.4 } }, h = { 66, 58, 52, 62 }, half = 0.18, head = { half = 0.6, h = 5 }, bent = 22, blade = 9 },\n}\nMeadow.GRASS = GRASS\n-- Each cell's plants: its forb (in the first slot) and its clumps (the others), by row (a, south by the gravel, to e) and column (1, west, to 5). Slots: offsets (east of the\n-- cell's west edge, north of its south edge) of a forb or a clump's crown.\nlocal SLOTS = { { 32, 36 }, { 68, 64 }, { 68, 32 }, { 32, 68 } }\nlocal PLAN: { [string]: { forb: string?, clumps: { string }, hill: boolean?, leaf: boolean? } } = {\n\ta1 = { forb = \"susan\", clumps = { \"little\", \"big\", \"little\" } }, a2 = { forb = \"yarrow\", clumps = { \"little\", \"big\" } }, a3 = { forb = \"coneflower\", clumps = { \"big\", \"little\", \"big\" } },\n\ta4 = { forb = \"susan\", clumps = { \"little\", \"big\", \"little\" } }, a5 = { clumps = { \"big\", \"little\", \"big\" } },\n\tb1 = { clumps = { \"big\", \"big\", \"little\" } }, b2 = { forb = \"yarrow\", clumps = { \"little\", \"big\" }, leaf = true }, b3 = { forb = \"milkweed\", clumps = { \"big\", \"little\", \"big\" } },\n\tb4 = { clumps = { \"little\", \"big\", \"little\" }, hill = true }, b5 = { forb = \"goldenrod\", clumps = { \"big\", \"little\", \"big\" } },\n\tc1 = { forb = \"coneflower\", clumps = { \"little\", \"big\", \"little\" } }, c2 = { forb = \"beebalm\", clumps = { \"big\", \"little\", \"big\" } }, c3 = { forb = \"goldenrod\", clumps = { \"little\", \"big\", \"little\" } },\n\tc4 = { forb = \"susan\", clumps = { \"big\", \"little\", \"big\" } }, c5 = { forb = \"yarrow\", clumps = { \"little\", \"big\", \"little\" } },\n\td1 = { forb = \"goldenrod\", clumps = { \"big\", \"little\", \"big\" } }, d2 = { forb = \"milkweed\", clumps = { \"little\", \"big\", \"little\" } }, d3 = { clumps = { \"big\", \"big\", \"little\" } },\n\td4 = { forb = \"yarrow\", clumps = { \"little\", \"big\", \"little\" } }, d5 = { forb = \"coneflower\", clumps = { \"big\", \"little\", \"big\" } },\n\te1 = { forb = \"beebalm\", clumps = { \"little\", \"big\", \"little\" } }, e2 = { forb = \"susan\", clumps = { \"big\", \"little\", \"big\" } }, e3 = { forb = \"goldenrod\", clumps = { \"big\", \"little\", \"big\" } },\n\te4 = { clumps = { \"big\", \"little\", \"big\" } }, e5 = { forb = \"milkweed\", clumps = { \"little\", \"big\", \"little\" } },\n}\nMeadow.PLAN = PLAN\n-- The ant hill (in meadow_b4's first slot): a low mound of fine soil in steps, its top 7 cm over the meadow's floor.\nMeadow.HILL = table.freeze({ steps = table.freeze({ { 15, 2 }, { 11, 2 }, { 7, 2 }, { 3, 1 } }) })\n-- The curled dead leaf in meadow_b2 (a cottonwood leaf blown in, curled and dry), lying on two old stems: the gap under it is a home.\nMeadow.LEAF = table.freeze({ dx = 43, dz = 44, l = 14, w = 12, rest = 1.5, gap = 1.4, thick = 0.6 })\n\nlocal ROWS = { \"a\", \"b\", \"c\", \"d\", \"e\" }\nlocal PAD_ROWS = { \"a\", \"b\", \"c\" }\n-- A meadow cell's rectangle (x0, x1, z0, z1) from its row (1..5) and column (1..5).\nlocal function meadowBox(r: number, c: number): (number, number, number, number)\n\tlocal K = Meadow.CORE\n\treturn K.x0 + (c - 1) * 100, K.x0 + c * 100, K.z1 - r * 100, K.z1 - (r - 1) * 100\nend\nlocal function padBox(r: number, c: number): (number, number, number, number)\n\tlocal K = Meadow.PAD\n\treturn K.x0 + (c - 1) * 100, K.x0 + c * 100, K.z1 - r * 100, K.z1 - (r - 1) * 100\nend\nMeadow.meadowBox = meadowBox\nMeadow.padBox = padBox\n\n-- The place of a slot in a cell (x0, its south edge z1), with the cell's own jitter.\nlocal function slotAt(x0: number, z1: number, k: number, rand: () -> number): (number, number)\n\tlocal s = SLOTS[k]\n\treturn x0 + s[1] + between(rand, -3, 3), z1 - s[2] + between(rand, -3, 3)\nend\n\n-- A cell's plants placed: its forb { kind, x, z } and its clumps { kind, x, z, dir } (the bent blade's way: out from the cell's middle along x), from its seed.\ntype Placed = { forb: { kind: string, x: number, z: number, scale: number? }?, clumps: { { kind: string, x: number, z: number, dir: number } }, hill: { x: number, z: number }?,\n\tleaf: { x: number, z: number }? }\nlocal placedCache: { [string]: Placed } = {}\nlocal function placed(region: Region): Placed\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = placedCache[key]\n\tif cached ~= nil then return cached end\n\tlocal plan = PLAN[string.sub(region.id, 8)]\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal x0, z1 = lo.X, hi.Z\n\tlocal rand = rng(region.seed, 3)\n\tlocal out: Placed = { clumps = {} }\n\tlocal fx, fz = slotAt(x0, z1, 1, rand)\n\tif plan.forb ~= nil then out.forb = { kind = plan.forb, x = fx, z = fz } end\n\tif plan.hill then out.hill = { x = x0 + SLOTS[1][1], z = z1 - SLOTS[1][2] } end\n\tfor i, kind in plan.clumps do\n\t\tlocal x, z = slotAt(x0, z1, i + 1, rand)\n\t\ttable.insert(out.clumps, { kind = kind, x = x, z = z, dir = if x > x0 + 50 then 1 else -1 })\n\tend\n\tif plan.leaf then out.leaf = { x = x0 + Meadow.LEAF.dx, z = z1 - Meadow.LEAF.dz } end\n\tplacedCache[key] = out\n\treturn out\nend\nMeadow.placed = placed\n\n-- ---------------------------------------------------------------- the regions\nlocal function freeze(r: Region): Region\n\ttable.freeze(r.bounds)\n\tfor _, n in r.neighbors do table.freeze(n) end\n\ttable.freeze(r.neighbors)\n\tfor _, t in r.retreats do table.freeze(t) end\n\ttable.freeze(r.retreats)\n\ttable.freeze(r.spawn)\n\treturn table.freeze(r)\nend\n\ntype Seam = { a: string, b: string, p: Vector3, q: Vector3 }\nlocal SEAMS: { Seam } = {}\nlocal function seam(a: string, b: string, p: Vector3, q: Vector3)\n\ttable.insert(SEAMS, { a = a, b = b, p = p, q = q })\nend\n\nlocal B = Meadow.BENCH\n-- The seat's slats, front (1) to back (4): z0..z1 of each.\nlocal SLATS: { { number } } = {}\nfor k = 1, 4 do\n\tlocal z1 = B.front - (k - 1) * (B.w + B.gap)\n\ttable.insert(SLATS, { z1 - B.w, z1 })\nend\nMeadow.SLATS = SLATS\n\nlocal RETREATS: { [string]: { id: string, min: Vector3, max: Vector3, door: Vector3 } } = {\n\t-- the slot between the seat's second and third slats, in the west half: a spider tucks in against a slat's side, out of the wind\n\tbench_w = { id = \"bench_slats\", min = v(-132, SL + B.seat - B.thick, SLATS[3][2]), max = v(-88, SL + B.seat, SLATS[2][1]), door = v(-110, SL + B.seat + 0.5, (SLATS[3][2] + SLATS[2][1]) / 2) },\n\t-- under the bin's base, between its feet: the gap under the lip\n\tbin = { id = \"bin_lip\", min = v(Meadow.BIN.x0 + 5, SL, Meadow.BIN.z0 + 5), max = v(Meadow.BIN.x1 - 5, SL + Meadow.BIN.feet, Meadow.BIN.z1 - 5),\n\t\tdoor = v((Meadow.BIN.x0 + Meadow.BIN.x1) / 2, SL + 0.5, Meadow.BIN.z1 + 4.5) },\n}\ndo\n\t-- under the curled leaf in meadow_b2\n\tlocal x0, _, _, z1 = meadowBox(2, 2)\n\tlocal L = Meadow.LEAF\n\tlocal lx, lz = x0 + L.dx, z1 - L.dz\n\tRETREATS.meadow_b2 = { id = \"meadow_b2_leaf\", min = v(lx - L.l / 2 + L.rest, GT, lz - L.w / 2 + 1), max = v(lx + L.l / 2 - L.rest, GT + L.gap, lz + L.w / 2 - 1),\n\t\tdoor = v(lx, GT + 0.5, lz + L.w / 2 + 3) }\nend\nMeadow.RETREATS = RETREATS\n\n-- The authored regions, for a world seed (`seedOf`: World/WorldMap.seed), in priority order (after the hut's: World/WorldMap.authorPreserve).\nfunction Meadow.author(worldSeed: number, seedOf: (number, string) -> number): { Region }\n\tlocal list: { Region } = {}\n\tlocal byId: { [string]: Region } = {}\n\tlocal function region(id: string, kind: string, lo: Vector3, hi: Vector3, spawn: Vector3, heading: Vector3)\n\t\tlocal t = RETREATS[id]\n\t\tlocal r = {\n\t\t\tid = id, kind = kind, origin = v((lo.X + hi.X) / 2, if kind == \"meadow\" or kind == \"pad\" then GT else spawn.Y, (lo.Z + hi.Z) / 2), bounds = { lo, hi },\n\t\t\tseed = seedOf(worldSeed, id), neighbors = {}, retreats = if t ~= nil then { table.clone(t) } else {}, spawn = { pos = spawn, heading = heading }, clockScale = 0.33,\n\t\t}\n\t\ttable.insert(list, r :: any)\n\t\tbyId[id] = r :: any\n\tend\n\t-- the furniture first (its bounds reach down over the pad's cells: a spider at their feet is theirs)\n\tregion(\"bench_w\", \"park_bench\", v(B.x0, SL - 0.5, -798), v(B.mid, SL + 88, -744), v(-110, SL + B.seat, (SLATS[1][1] + SLATS[1][2]) / 2), v(0, 0, 1))\n\tregion(\"bench_e\", \"park_bench\", v(B.mid, SL - 0.5, -798), v(B.x1, SL + 88, -744), v(-30, SL + B.seat, (SLATS[1][1] + SLATS[1][2]) / 2), v(0, 0, 1))\n\tlocal N = Meadow.BIN\n\tregion(\"bin\", \"park_bin\", v(14, GT - 0.5, -800), v(88, SL + N.lid + 4, -716.5), v(60, SL + N.lid, -774), v(0, 0, 1))\n\tlocal L = Meadow.LAMP\n\tlocal cuts = { 0, L.splits[1], L.splits[2], L.splits[3], L.top + L.plate.h + L.glass.h + L.cap.h + L.finial.h + 3 }\n\tfor k = 1, 4 do\n\t\tlocal y0, y1 = SL + cuts[k] - (if k == 1 then 0.5 else 0), SL + cuts[k + 1]\n\t\tlocal spawn = if k == 1 then v(L.x - 8, SL + L.base.h, L.z) elseif k == 4 then v(L.x - 12, LAMP_TOP + L.plate.h + L.glass.h + L.cap.h, L.z)\n\t\t\telse v(L.x + L.half, SL + (cuts[k] + cuts[k + 1]) / 2, L.z)\n\t\tregion(`lamp_{k}`, \"lamppost\", v(L.x - 20, y0, L.z - 20), v(L.x + 20, y1, L.z + 20), spawn, if k == 2 or k == 3 then v(0, 1, 0) else v(0, 0, 1))\n\tend\n\t-- the pad's cells: rows a..c north from the path's end, columns 1..3\n\tfor r = 1, 3 do\n\t\tfor c = 1, 3 do\n\t\t\tlocal x0, x1, z0, z1 = padBox(r, c)\n\t\t\tlocal id = `pad_{PAD_ROWS[r]}{c}`\n\t\t\tlocal sx, sz = (x0 + x1) / 2, (z0 + z1) / 2\n\t\t\tif r == 3 then sz = -722; if c == 3 then sx = 0 end end -- (on the gravel south of the slab, clear of the furniture's bounds)\n\t\t\tif r == 2 and c == 3 then sx, sz = 75, -685 end -- (clear of the grate)\n\t\t\tregion(id, \"pad\", v(x0, GT - Meadow.GRATE.deep - 3, z0), v(x1, GT + 40, z1), v(sx, GT, sz), v(0, 0, -1))\n\t\tend\n\tend\n\t-- the meadow's cells\n\tfor r = 1, 5 do\n\t\tfor c = 1, 5 do\n\t\t\tlocal x0, x1, z0, z1 = meadowBox(r, c)\n\t\t\tregion(`meadow_{ROWS[r]}{c}`, \"meadow\", v(x0, -88, z0), v(x1, GT + 140, z1), v(x0 + 50, GT, z1 - 12), v(0, 0, -1))\n\t\tend\n\tend\n\t-- (a seam with World/Hut's path_m4 is listed on this side only: Hut lists it on its own)\n\tfor _, s in SEAMS do\n\t\tlocal a, b = byId[s.a], byId[s.b]\n\t\tif a ~= nil then table.insert(a.neighbors, { id = s.b, a = s.p, b = s.q }) end\n\t\tif b ~= nil then table.insert(b.neighbors, { id = s.a, a = s.p, b = s.q }) end\n\tend\n\tfor _, r in list do freeze(r) end\n\treturn list\nend\n\n-- The seams that meet World/Hut's regions (the path's end): World/WorldMap adds these to path_m4's neighbours.\nMeadow.HUT_SEAMS = table.freeze({\n\ttable.freeze({ hut = \"path_m4\", id = \"pad_a2\", a = v(-88, GT, -516), b = v(-32, GT, -516) }),\n})\nfor _, s in Meadow.HUT_SEAMS do seam(s.hut, s.id, s.a, s.b) end\n-- (ROBLOX-122) the mown path east to the pond leaves the bench patch's gravel at pad_b3's east edge (World/Pond's mown_e1, which lists this seam on its own side)\nseam(\"pad_b3\", \"mown_e1\", v(90, GT, -711), v(90, GT, -635))\n\ndo\n\t-- the pad's cells to one another, flat on the gravel (row c's lines between columns on the gravel south of the slab)\n\tfor r = 1, 3 do\n\t\tfor c = 1, 3 do\n\t\t\tlocal x0, x1, _, z1 = padBox(r, c)\n\t\t\tlocal here = `pad_{PAD_ROWS[r]}{c}`\n\t\t\tif c < 3 then\n\t\t\t\tlocal za, zb = z1 - 92, z1 - 8\n\t\t\t\tif r == 3 then za, zb = -727, -719 end\n\t\t\t\tseam(here, `pad_{PAD_ROWS[r]}{c + 1}`, v(x1, GT, za), v(x1, GT, zb))\n\t\t\tend\n\t\t\tif r < 3 then\n\t\t\t\tlocal xa, xb = x0 + 8, x1 - 8\n\t\t\t\tif r == 2 and c == 3 then xa, xb = x0 + 8, x0 + 24 end -- (clear of the packet by the bin)\n\t\t\t\tseam(here, `pad_{PAD_ROWS[r + 1]}{c}`, v(xa, GT, z1 - 100), v(xb, GT, z1 - 100))\n\t\t\tend\n\t\tend\n\tend\n\t-- the pad's north edge onto the meadow (columns 2..4 of row a): the gravel north of the slab meets the meadow's floor\n\tfor c = 1, 3 do\n\t\tlocal x0, x1 = padBox(3, c)\n\t\tseam(`pad_c{c}`, `meadow_a{c + 1}`, v(x0 + 8, GT, Meadow.PAD.z0), v(x1 - 8, GT, Meadow.PAD.z0))\n\tend\n\t-- the furniture on the slab: a foot's face at the slab\n\tseam(\"bench_w\", \"pad_c1\", v(B.ends[1], SL, B.front), v(B.ends[1] + B.frame, SL, B.front))\n\tseam(\"bench_e\", \"pad_c3\", v(B.ends[2], SL, B.front), v(B.ends[2] + B.frame, SL, B.front))\n\tseam(\"bench_w\", \"bench_e\", v(B.mid, SL + B.seat, SLATS[1][1] + 1), v(B.mid, SL + B.seat, SLATS[1][2] - 1)) -- (along the front slat's top)\n\tlocal N = Meadow.BIN\n\tseam(\"bin\", \"pad_c3\", v(N.x0 - 1, SL, N.z1 - 1), v(N.x0 + 4, SL, N.z1 - 1)) -- (the south-west foot's face at the slab)\n\tlocal L = Meadow.LAMP\n\tseam(\"lamp_1\", \"pad_c1\", v(L.x - L.base.half, SL, L.z + L.base.half), v(L.x + L.base.half, SL, L.z + L.base.half)) -- (the base's south face at the slab)\n\tfor k = 1, 3 do\n\t\tlocal y = SL + L.splits[k]\n\t\tseam(`lamp_{k}`, `lamp_{k + 1}`, v(L.x + L.half, y, L.z - L.half), v(L.x + L.half, y, L.z + L.half)) -- (across the pole's east face)\n\tend\n\t-- the meadow's cells to one another, flat on its floor (the plants stand well in from the edges)\n\tfor r = 1, 5 do\n\t\tfor c = 1, 5 do\n\t\t\tlocal x0, x1, z0, z1 = meadowBox(r, c)\n\t\t\tlocal here = `meadow_{ROWS[r]}{c}`\n\t\t\tif c < 5 then seam(here, `meadow_{ROWS[r]}{c + 1}`, v(x1, GT, z0 + 8), v(x1, GT, z1 - 8)) end\n\t\t\tif r < 5 then seam(here, `meadow_{ROWS[r + 1]}{c}`, v(x0 + 8, GT, z0), v(x1 - 8, GT, z0)) end\n\t\tend\n\tend\nend\n\n-- ---------------------------------------------------------------- the pieces\nlocal function P(out: { Piece }, id: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, profile: string, color: string, material: string?)\n\ttable.insert(out, { id = id, lo = v(x0, y0, z0), hi = v(x1, y1, z1), profile = profile, color = hex(color), material = material })\nend\nlocal function clip(x0: number, x1: number, z0: number, z1: number, cx0: number, cx1: number, cz0: number, cz1: number): (number?, number?, number?, number?)\n\tlocal a, b, c, d = math.max(x0, cx0), math.min(x1, cx1), math.max(z0, cz0), math.min(z1, cz1)\n\tif b - a <= 1e-6 or d - c <= 1e-6 then return nil, nil, nil, nil end\n\treturn a, b, c, d\nend\n\nlocal function padPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal id = region.id\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal cx0, cx1, cz0, cz1 = lo.X, hi.X, lo.Z, hi.Z\n\tlocal G = Meadow.GRATE\n\tif id == \"pad_b3\" then\n\t\t-- the gravel round the grate's hole, the pit's walls and floor, the bars across it\n\t\t-- (either side in two along z, so no box's middle is far from where the spider steps in from the next cell)\n\t\tP(out, id .. \"_gravel_wn\", cx0, G.x0, -87, GT, cz0, G.z0, \"brick_rough\", C.gravel, \"Pebble\")\n\t\tP(out, id .. \"_gravel_ws\", cx0, G.x0, -87, GT, G.z0, cz1, \"brick_rough\", C.gravel, \"Pebble\")\n\t\tP(out, id .. \"_gravel_en\", G.x1, cx1, -87, GT, cz0, G.z0, \"brick_rough\", C.gravel, \"Pebble\")\n\t\tP(out, id .. \"_gravel_es\", G.x1, cx1, -87, GT, G.z0, cz1, \"brick_rough\", C.gravel, \"Pebble\")\n\t\tP(out, id .. \"_gravel_n\", G.x0, G.x1, -87, GT, cz0, G.z0, \"brick_rough\", C.gravel, \"Pebble\")\n\t\tP(out, id .. \"_gravel_s\", G.x0, G.x1, -87, GT, G.z1, cz1, \"brick_rough\", C.gravel, \"Pebble\")\n\t\tlocal floor = GT - G.deep\n\t\tP(out, id .. \"_pit_floor\", G.x0 + G.wall, G.x1 - G.wall, floor - 2, floor, G.z0 + G.wall, G.z1 - G.wall, \"brick_rough\", \"3a3631\", \"Concrete\")\n\t\tP(out, id .. \"_pit_w\", G.x0, G.x0 + G.wall, floor - 2, -87, G.z0, G.z1, \"brick_rough\", C.concreteDark, \"Concrete\")\n\t\tP(out, id .. \"_pit_e\", G.x1 - G.wall, G.x1, floor - 2, -87, G.z0, G.z1, \"brick_rough\", C.concreteDark, \"Concrete\")\n\t\tP(out, id .. \"_pit_n\", G.x0 + G.wall, G.x1 - G.wall, floor - 2, -87, G.z0, G.z0 + G.wall, \"brick_rough\", C.concreteDark, \"Concrete\")\n\t\tP(out, id .. \"_pit_s\", G.x0 + G.wall, G.x1 - G.wall, floor - 2, -87, G.z1 - G.wall, G.z1, \"brick_rough\", C.concreteDark, \"Concrete\")\n\t\t-- the frame at the top (its lip on the walls, flush with the gravel) and the bars across the hole\n\t\tP(out, id .. \"_frame_w\", G.x0, G.x0 + G.wall, -87, GT, G.z0, G.z1, \"painted_metal_smooth\", C.iron, \"Metal\")\n\t\tP(out, id .. \"_frame_e\", G.x1 - G.wall, G.x1, -87, GT, G.z0, G.z1, \"painted_metal_smooth\", C.iron, \"Metal\")\n\t\tlocal span = (G.z1 - G.z0) - 2 * G.wall\n\t\tlocal slot = (span - G.bars * G.bar) / (G.bars + 1)\n\t\tfor k = 1, G.bars do\n\t\t\tlocal z0 = G.z0 + G.wall + slot * k + G.bar * (k - 1)\n\t\t\tP(out, `{id}_bar_{k}`, G.x0 + G.wall, G.x1 - G.wall, GT - 3, GT, z0, z0 + G.bar, \"painted_metal_smooth\", C.iron, \"Metal\")\n\t\tend\n\t\treturn out\n\tend\n\tP(out, id .. \"_gravel\", cx0, cx1, -87, GT, cz0, cz1, \"brick_rough\", C.gravel, \"Pebble\")\n\tlocal S = Meadow.SLAB\n\tlocal a, b, c, d = clip(S.x0, S.x1, S.z0, S.z1, cx0, cx1, cz0, cz1)\n\tif a ~= nil then P(out, id .. \"_slab\", a, b :: number, GT, SL, c :: number, d :: number, \"brick_rough\", C.concrete, \"Concrete\") end\n\treturn out\nend\n\n-- The bench's half (`s` -1 the west, 1 the east): its end frame, its share of the seat's and back's slats.\nlocal function benchPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal id = region.id\n\tlocal west = id == \"bench_w\"\n\tlocal x0, x1 = if west then B.x0 else B.mid, if west then B.mid else B.x1\n\tlocal fx = if west then B.ends[1] else B.ends[2]\n\tlocal f0, f1 = fx, fx + B.frame\n\t-- the cast-iron end: the front leg, the rail under the seat, the rear post up to the back's top, the arm and its post\n\tP(out, id .. \"_leg\", f0, f1, SL, SL + B.legTop, B.front - 4, B.front, \"painted_metal_smooth\", C.iron, \"Metal\")\n\tP(out, id .. \"_rail\", f0, f1, SL + B.legTop, SL + B.seat - B.thick, B.railZ[1], B.railZ[2], \"painted_metal_smooth\", C.iron, \"Metal\")\n\tP(out, id .. \"_post\", f0, f1, SL, SL + B.back[3][2] + 2, B.post[1], B.post[2], \"painted_metal_smooth\", C.iron, \"Metal\")\n\tP(out, id .. \"_arm_post\", f0, f1, SL + B.seat, SL + B.arm[1], B.armPost[1], B.armPost[2], \"painted_metal_smooth\", C.iron, \"Metal\")\n\tP(out, id .. \"_arm\", f0 - 0.5, f1 + 0.5, SL + B.arm[1], SL + B.arm[2], B.backZ[2], B.armPost[2] + 1, \"painted_metal_smooth\", C.ironDark, \"Metal\")\n\tfor k, s in SLATS do\n\t\tP(out, `{id}_slat_{k}`, x0, x1, SL + B.seat - B.thick, SL + B.seat, s[1], s[2], \"varnished_wood_smooth\", if k % 2 == 0 then C.slatDark else C.slat, \"Wood\")\n\tend\n\tfor k, h in B.back do\n\t\tP(out, `{id}_back_{k}`, x0, x1, SL + h[1], SL + h[2], B.backZ[1], B.backZ[2], \"varnished_wood_smooth\", if k == 2 then C.slatDark else C.slat, \"Wood\")\n\tend\n\treturn out\nend\n\nlocal function binPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal N = Meadow.BIN\n\tfor k, f in { { N.x0 - 1, N.z1 - 6 }, { N.x1 - 4, N.z1 - 6 }, { N.x0 - 1, N.z0 + 1 }, { N.x1 - 4, N.z0 + 1 } } do\n\t\tP(out, `bin_foot_{k}`, f[1], f[1] + 5, SL, SL + N.feet, f[2], f[2] + 5, \"painted_metal_smooth\", C.binDark, \"Metal\")\n\tend\n\tP(out, \"bin_base\", N.x0 - N.lip, N.x1 + N.lip, SL + N.feet, SL + N.base, N.z0 - N.lip, N.z1 + N.lip, \"painted_metal_smooth\", C.binDark, \"Metal\")\n\tP(out, \"bin_body\", N.x0, N.x1, SL + N.base, SL + N.top, N.z0, N.z1, \"painted_metal_smooth\", C.bin, \"Metal\")\n\tP(out, \"bin_rim\", N.x0 - 1, N.x1 + 1, SL + N.top, SL + N.rim, N.z0 - 1, N.z1 + 1, \"painted_metal_smooth\", C.binDark, \"Metal\")\n\tP(out, \"bin_lid\", N.x0 + 2, N.x1 - 2, SL + N.rim, SL + N.lid, N.z0 + 2, N.z1 - 2, \"painted_metal_smooth\", C.bin, \"Metal\")\n\tlocal K, Q = Meadow.CAN, Meadow.PACKET\n\tP(out, \"bin_can\", K.x0, K.x1, GT, GT + (K.z1 - K.z0), K.z0, K.z1, \"painted_metal_smooth\", C.can, \"Metal\")\n\tP(out, \"bin_packet\", Q.x0, Q.x1, GT, GT + Q.h, Q.z0, Q.z1, \"painted_metal_smooth\", C.packet, \"SmoothPlastic\")\n\treturn out\nend\n\nlocal function lampPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal L = Meadow.LAMP\n\tlocal k = tonumber(string.sub(region.id, 6)) :: number\n\tlocal cuts = { 0, L.splits[1], L.splits[2], L.splits[3], L.top }\n\tlocal y0 = SL + cuts[k]\n\tif k == 1 then\n\t\tP(out, \"lamp_base\", L.x - L.base.half, L.x + L.base.half, SL, SL + L.base.h, L.z - L.base.half, L.z + L.base.half, \"painted_metal_smooth\", C.iron, \"Metal\")\n\t\ty0 = SL + L.base.h\n\tend\n\tP(out, region.id .. \"_pole\", L.x - L.half, L.x + L.half, y0, SL + cuts[k + 1], L.z - L.half, L.z + L.half, \"painted_metal_smooth\", C.lamp, \"Metal\")\n\tif k == 4 then\n\t\tlocal y = LAMP_TOP\n\t\tP(out, \"lamp_plate\", L.x - L.plate.half, L.x + L.plate.half, y, y + L.plate.h, L.z - L.plate.half, L.z + L.plate.half, \"painted_metal_smooth\", C.iron, \"Metal\")\n\t\ty += L.plate.h\n\t\tP(out, \"lamp_glass\", L.x - L.glass.half, L.x + L.glass.half, y, y + L.glass.h, L.z - L.glass.half, L.z + L.glass.half, \"glass_clean\", C.glass, \"Glass\")\n\t\ty += L.glass.h\n\t\tP(out, \"lamp_cap\", L.x - L.cap.half, L.x + L.cap.half, y, y + L.cap.h, L.z - L.cap.half, L.z + L.cap.half, \"painted_metal_smooth\", C.iron, \"Metal\")\n\t\ty += L.cap.h\n\t\tP(out, \"lamp_finial\", L.x - L.finial.half, L.x + L.finial.half, y, y + L.finial.h, L.z - L.finial.half, L.z + L.finial.half, \"painted_metal_smooth\", C.iron, \"Metal\")\n\tend\n\treturn out\nend\n\n-- A forb of the meadow's own kinds (black-eyed Susan, yarrow): its stem, leaves out from the stem's faces, its head. Ids `<cell>_<kind>_...`.\nlocal function forbPieces(out: { Piece }, id: string, plant: { kind: string, x: number, z: number, scale: number? }, y0: number)\n\tlocal spec = SPECS[plant.kind]\n\tif spec == nil then\n\t\tHut.plantPieces(out :: any, id, plant, y0, nil) -- (the hut garden's kinds: milkweed, coneflower, bee balm, goldenrod)\n\t\treturn\n\tend\n\tlocal half = spec.stem / 2\n\tlocal sx0, sx1, sz0, sz1 = plant.x - half, plant.x + half, plant.z - half, plant.z + half\n\tlocal base = `{id}_{plant.kind}`\n\tP(out, base .. \"_stem\", sx0, sx1, y0, y0 + spec.height, sz0, sz1, \"leaf_dry_prototype\", spec.color)\n\tfor i, leaf in spec.leaves :: { Leaf } do\n\t\tlocal ya, yb = y0 + leaf.h, y0 + leaf.h + spec.thick\n\t\tlocal w = leaf.w / 2\n\t\tif leaf.dir == \"x+\" then P(out, `{base}_leaf_{i}`, sx1, sx1 + leaf.l, ya, yb, plant.z - w, plant.z + w, \"leaf_dry_prototype\", spec.leaf)\n\t\telseif leaf.dir == \"x-\" then P(out, `{base}_leaf_{i}`, sx0 - leaf.l, sx0, ya, yb, plant.z - w, plant.z + w, \"leaf_dry_prototype\", spec.leaf)\n\t\telseif leaf.dir == \"z+\" then P(out, `{base}_leaf_{i}`, plant.x - w, plant.x + w, ya, yb, sz1, sz1 + leaf.l, \"leaf_dry_prototype\", spec.leaf)\n\t\telse P(out, `{base}_leaf_{i}`, plant.x - w, plant.x + w, ya, yb, sz0 - leaf.l, sz0, \"leaf_dry_prototype\", spec.leaf) end\n\tend\n\tlocal top = y0 + spec.height\n\tlocal H = spec.head\n\tP(out, base .. \"_head\", plant.x - H.w / 2, plant.x + H.w / 2, top, top + H.h, plant.z - H.w / 2, plant.z + H.w / 2, \"leaf_dry_prototype\", spec.flower)\n\tif spec.cone ~= nil then\n\t\tlocal Q = spec.cone\n\t\tP(out, base .. \"_cone\", plant.x - Q.w / 2, plant.x + Q.w / 2, top + H.h, top + H.h + Q.h, plant.z - Q.w / 2, plant.z + Q.w / 2, \"leaf_dry_prototype\", C.susanCone)\n\tend\nend\n\n-- A grass clump's culms (each a thin box from the floor to its height), the heads on the two tallest, and one blade bent over flat from the first culm.\nlocal function clumpPieces(out: { Piece }, id: string, k: number, clump: { kind: string, x: number, z: number, dir: number }, rand: () -> number)\n\tlocal G = GRASS[clump.kind]\n\tlocal base = `{id}_{clump.kind}{k}`\n\tfor i, o in G.at do\n\t\tlocal x, z = clump.x + o[1], clump.z + o[2]\n\t\tlocal h = G.h[i] * between(rand, 0.92, 1)\n\t\tP(out, `{base}_culm_{i}`, x - G.half, x + G.half, GT, GT + h, z - G.half, z + G.half, \"leaf_dry_prototype\", pick(if clump.kind == \"big\" then C.big else C.little, rand))\n\t\tif i == 1 or i == 4 then\n\t\t\tP(out, `{base}_head_{i}`, x - G.head.half, x + G.head.half, GT + h, GT + h + G.head.h, z - G.head.half, z + G.head.half, \"leaf_dry_prototype\",\n\t\t\t\tif clump.kind == \"big\" then pick(C.raceme, rand) else pick(C.tuft, rand))\n\t\tend\n\tend\n\t-- the bent blade: a leaf arched over and lying flat, out from the first culm's face, away from the cell's middle\n\tlocal x, z = clump.x, clump.z\n\tlocal y = GT + G.bent\n\tif clump.dir > 0 then P(out, base .. \"_blade\", x + G.half, x + G.half + G.blade, y, y + 0.25, z - 0.45, z + 0.45, \"leaf_dry_prototype\", pick(if clump.kind == \"big\" then C.bigLeaf else C.littleLeaf, rand))\n\telse P(out, base .. \"_blade\", x - G.half - G.blade, x - G.half, y, y + 0.25, z - 0.45, z + 0.45, \"leaf_dry_prototype\", pick(if clump.kind == \"big\" then C.bigLeaf else C.littleLeaf, rand)) end\nend\n\nlocal function meadowPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal id = region.id\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tP(out, id .. \"_soil\", lo.X, hi.X, -87, GT, lo.Z, hi.Z, \"brick_rough\", C.meadow, \"Grass\") -- (the floor under the thatch)\n\tlocal at = placed(region)\n\tlocal rand = rng(region.seed, 5)\n\tif at.forb ~= nil then forbPieces(out, id, at.forb, GT) end\n\tfor k, clump in at.clumps do clumpPieces(out, id, k, clump, rand) end\n\tif at.hill ~= nil then\n\t\tlocal y = GT\n\t\tfor k, s in Meadow.HILL.steps do\n\t\t\tP(out, `{id}_hill_{k}`, at.hill.x - s[1], at.hill.x + s[1], y, y + s[2], at.hill.z - s[1], at.hill.z + s[1], \"brick_rough\", if k % 2 == 0 then C.hillDark else C.hill, \"Ground\")\n\t\t\ty += s[2]\n\t\tend\n\tend\n\tif at.leaf ~= nil then\n\t\tlocal L = Meadow.LEAF\n\t\tlocal x0, x1, z0, z1 = at.leaf.x - L.l / 2, at.leaf.x + L.l / 2, at.leaf.z - L.w / 2, at.leaf.z + L.w / 2\n\t\tP(out, id .. \"_stem_w\", x0, x0 + L.rest, GT, GT + L.gap, z0, z1, \"leaf_dry_prototype\", C.thatch[4])\n\t\tP(out, id .. \"_stem_e\", x1 - L.rest, x1, GT, GT + L.gap, z0, z1, \"leaf_dry_prototype\", C.thatch[2])\n\t\tP(out, id .. \"_leaf\", x0, x1, GT + L.gap, GT + L.gap + L.thick, z0, z1, \"leaf_dry_prototype\", C.leaf)\n\tend\n\treturn out\nend\n\nlocal KINDS: { [string]: boolean } = { pad = true, park_bench = true, park_bin = true, lamppost = true, meadow = true }\n-- Whether a kind is the meadow's or the bench patch's.\nfunction Meadow.knows(kind: string): boolean\n\treturn KINDS[kind] == true\nend\n\nlocal piecesCache: { [string]: { Piece } } = {}\nfunction Meadow.pieces(region: Region): { Piece }\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = piecesCache[key]\n\tif cached ~= nil then return cached end\n\tlocal k, out = region.kind, nil :: { Piece }?\n\tif k == \"pad\" then out = padPieces(region)\n\telseif k == \"park_bench\" then out = benchPieces(region)\n\telseif k == \"park_bin\" then out = binPieces()\n\telseif k == \"lamppost\" then out = lampPieces(region)\n\telseif k == \"meadow\" then out = meadowPieces(region)\n\telse error(\"no generator for the region kind \" .. k) end\n\tlocal list = out :: { Piece }\n\tfor _, p in list do table.freeze(p) end\n\tpiecesCache[key] = table.freeze(list)\n\treturn list\nend\nlocal function byIdOf(region: Region): { [string]: Piece }\n\tlocal out: { [string]: Piece } = {}\n\tfor _, p in Meadow.pieces(region) do out[p.id] = p end\n\treturn out\nend\n\n-- Nothing of the meadow's is drawn in place of its boxes: each is its own look (its material and colour), with the drawn detail over and beside it.\nfunction Meadow.drawnPieces(_region: Region): { string }\n\treturn {}\nend\n\n-- The boxes a region's creatures keep out of: each retreat grown by half a stud.\nfunction Meadow.keepOut(region: Region): { Box }\n\tlocal out: { Box } = {}\n\tfor _, t in region.retreats do table.insert(out, { min = t.min - v(0.5, 0.5, 0.5), max = t.max + v(0.5, 0.5, 0.5) }) end\n\treturn out\nend\n\n-- ---------------------------------------------------------------- the drawn looks\n-- The ceilings each kind keeps to at both tiers (tests/preserve.luau holds them). A meadow cell's look is what reads from a metre or two off: its clumps' masses and the\n-- forb's colour at the low tier; at the full tier the grasses whole (every clump's arching blades, the bluestem's turkey-foot racemes and the little bluestem's silver\n-- tufts), the forbs drawn whole over their boxes, the thatch and the mown edge. What the spider sees close (the thatch's blades, the new growth, the crumbs and the dew)\n-- is the patches'.\nMeadow.BUDGETS = table.freeze({\n\tmeadow = { full = 160, low = 8 }, pad = { full = 24, low = 3 }, park_bench = { full = 14, low = 2 }, park_bin = { full = 12, low = 4 }, lamppost = { full = 10, low = 2 },\n}) :: { [string]: { full: number, low: number } }\n\nlocal function sheet(budget: { full: number, low: number })\n\tlocal list: { Drawn } = {}\n\tlocal full, low = 0, 0\n\tlocal function add(d: Drawn): boolean\n\t\tif full + 1 > budget.full or (not d.full and low + 1 > budget.low) then return false end\n\t\tfull += 1\n\t\tif not d.full then low += 1 end\n\t\ttable.insert(list, d)\n\t\treturn true\n\tend\n\treturn list, add\nend\nlocal function rec(id: string, size: Vector3, at: Vector3, color: string, material: string, full: boolean, shape: string?, turn: Vector3?): Drawn\n\treturn { id = id, size = size, at = at, color = hex(color), material = material, full = full, shape = shape, turn = turn }\nend\nlocal function drop(id: string, at: Vector3, size: number, rand: () -> number): Drawn\n\tlocal d = rec(id, v(size, size * 0.62, size), at + v(0, size * 0.25, 0), \"dfeaee\", \"Glass\", true, \"Ellipsoid\")\n\td.group = \"Dew\"\n\td.dew = rand() * 0.6\n\td.transparency = between(rand, 0.3, 0.45)\n\td.reflectance = 0.3\n\treturn d\nend\n-- A blade from its foot at `at`: `h` tall, `w` wide, leaning `lean` degrees toward the yaw `yaw`; `bend`, if given, its upper part leans that much more.\nlocal function blade(add: (Drawn) -> boolean, id: string, at: Vector3, h: number, w: number, yaw: number, lean: number, bend: number?, color: string, full: boolean)\n\tlocal function seg(sid: string, from: Vector3, len: number, l: number): Vector3\n\t\tlocal r = math.rad(l)\n\t\tlocal dir = v(-math.sin(r) * math.cos(math.rad(yaw)), math.cos(r), math.sin(r) * math.sin(math.rad(yaw)))\n\t\tadd(rec(sid, v(w, len, 0.06), from + dir * (len / 2), color, \"SmoothPlastic\", full, nil, v(0, yaw, l)))\n\t\treturn from + dir * len\n\tend\n\tif bend == nil then seg(id, at, h, lean); return end\n\tlocal knee = seg(id .. \"a\", at, h * 0.55, lean)\n\tseg(id .. \"b\", knee, h * 0.45, lean + bend)\nend\nlocal function yawTo(dx: number, dz: number): number\n\treturn math.deg(math.atan2(-dz, dx))\nend\n-- A rod from a to b (a raceme, a culm's tip).\nlocal function rod(add: (Drawn) -> boolean, id: string, a: Vector3, b: Vector3, dia: number, color: string, full: boolean, material: string?)\n\tlocal d = b - a\n\tlocal len = d.Magnitude\n\tlocal u = d / len\n\tadd(rec(id, v(len, dia, dia), (a + b) * 0.5, color, material or \"SmoothPlastic\", full, \"Cylinder\", v(0, yawTo(u.X, u.Z), math.deg(math.asin(math.clamp(u.Y, -1, 1))))))\nend\n\n-- The meadow's own forbs drawn over their boxes.\nlocal function forbDecor(byId: { [string]: Piece }, id: string, plant: { kind: string, x: number, z: number, scale: number? }, add: (Drawn) -> boolean, rand: () -> number)\n\tlocal spec = SPECS[plant.kind]\n\tif spec == nil then\n\t\tHut.drawPlant(byId :: any, id, plant, \"\", add, rand, GT)\n\t\treturn\n\tend\n\tlocal base = `{id}_{plant.kind}`\n\tfor i = 1, #spec.leaves do\n\t\tlocal box = byId[`{base}_leaf_{i}`]\n\t\tif box ~= nil then\n\t\t\tlocal size = box.hi - box.lo\n\t\t\tlocal c = (box.lo + box.hi) * 0.5\n\t\t\tif plant.kind == \"yarrow\" then\n\t\t\t\t-- the feathery leaf: a midrib and its fine segments\n\t\t\t\tlocal alongX = size.X >= size.Z\n\t\t\t\tlocal l = if alongX then size.X else size.Z\n\t\t\t\tadd(rec(`Rachis{i}`, if alongX then v(l * 1.1, 0.12, 0.2) else v(0.2, 0.12, l * 1.1), c + v(0, 0.1, 0), spec.leaf, \"SmoothPlastic\", true))\n\t\t\t\tfor s = 1, 5 do\n\t\t\t\t\tlocal t = (s - 0.5) / 5 - 0.5\n\t\t\t\t\tlocal off = if alongX then v(t * l, 0.12, 0) else v(0, 0.12, t * l)\n\t\t\t\t\tadd(rec(`Pinna{i}_{s}`, if alongX then v(0.25, 0.06, 2.6) else v(2.6, 0.06, 0.25), c + off, spec.leaf, \"SmoothPlastic\", true))\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tadd(rec(`Leaf_{i}`, if size.X >= size.Z then v(size.X * 1.25, 0.4, size.Z * 1.4) else v(size.X * 1.4, 0.4, size.Z * 1.25), c + v(0, 0.05, 0), spec.leaf, \"SmoothPlastic\", true, \"Ellipsoid\"))\n\t\t\tend\n\t\tend\n\tend\n\tlocal head = byId[base .. \"_head\"]\n\tif head == nil then return end\n\tlocal hc = (head.lo + head.hi) * 0.5\n\tif plant.kind == \"susan\" then\n\t\t-- the rays: thirteen drooping a little round the cone\n\t\tfor i = 1, 13 do\n\t\t\tlocal a = i / 13 * TAU + between(rand, -0.08, 0.08)\n\t\t\tadd(rec(`Ray{i}`, v(2.9, 0.12, 0.95), v(plant.x + math.cos(a) * 2.6, head.hi.Y - 0.4, plant.z + math.sin(a) * 2.6), pick({ C.susan, \"f0b22a\", \"dc9618\" }, rand),\n\t\t\t\t\"SmoothPlastic\", true, nil, v(0, -math.deg(a), -16)))\n\t\tend\n\t\tlocal cone = byId[base .. \"_cone\"]\n\t\tif cone ~= nil then add(rec(\"Cone\", v(2.6, 2.2, 2.6), (cone.lo + cone.hi) * 0.5 + v(0, -0.1, 0), C.susanCone, \"Sand\", true, \"Ball\")) end -- (its top at the box's)\n\telse\n\t\t-- the flat head: florets packed over the box, white with a cream eye\n\t\tfor i = 1, 22 do\n\t\t\tlocal r = math.sqrt((i - 0.5) / 22) * 3.1\n\t\t\tlocal a = i * 2.39996\n\t\t\tadd(rec(`Floret{i}`, v(0.75, 0.55, 0.75), v(plant.x + math.cos(a) * r, head.hi.Y + 0.15 - r * 0.05, plant.z + math.sin(a) * r), pick({ C.yarrow, \"f2efe6\", \"e0dccd\" }, rand),\n\t\t\t\t\"SmoothPlastic\", true, \"Ball\"))\n\t\tend\n\tend\n\tif rand() < 0.5 then add(drop(\"HeadDew\", hc + v(between(rand, -1, 1), head.hi.Y - hc.Y + 0.1, between(rand, -1, 1)), 0.4, rand)) end\nend\n\n-- A grass clump drawn: its blades arching out from the crown, its culms' heads (the bluestem's three racemes, the little bluestem's silver tufts along the culm's top).\nlocal function clumpDecor(byId: { [string]: Piece }, id: string, k: number, clump: { kind: string, x: number, z: number, dir: number }, add: (Drawn) -> boolean, rand: () -> number)\n\tlocal G = GRASS[clump.kind]\n\tlocal big = clump.kind == \"big\"\n\tlocal base = `{id}_{clump.kind}{k}`\n\tlocal n = if big then 13 else 11\n\tlocal spin = between(rand, 0, 360)\n\tfor b = 1, n do\n\t\tlocal yaw = spin + b / n * 360 + between(rand, -20, 20)\n\t\tlocal r = between(rand, 0.4, 2.2)\n\t\tlocal foot = v(clump.x + math.cos(math.rad(yaw)) * r, GT, clump.z - math.sin(math.rad(yaw)) * r)\n\t\tlocal h = if big then between(rand, 32, 62) else between(rand, 22, 40)\n\t\tblade(add, `Blade{k}_{b}`, foot, h, if big then between(rand, 0.6, 0.9) else between(rand, 0.3, 0.45), yaw + 180, between(rand, 6, 22),\n\t\t\tif b % 2 == 0 then between(rand, 25, 55) else nil, pick(if big then C.bigLeaf else C.littleLeaf, rand), true)\n\tend\n\t-- the bent blade's drawing over its box\n\tlocal bentBox = byId[base .. \"_blade\"]\n\tif bentBox ~= nil then\n\t\tlocal c = (bentBox.lo + bentBox.hi) * 0.5\n\t\tadd(rec(`Bent{k}`, v((bentBox.hi.X - bentBox.lo.X) * 1.15, 0.2, 1.2), c + v(0, 0.05, 0), pick(if big then C.bigLeaf else C.littleLeaf, rand), \"SmoothPlastic\", true, \"Ellipsoid\"))\n\tend\n\tfor i = 1, #G.at do\n\t\tlocal head = byId[`{base}_head_{i}`]\n\t\tif head ~= nil then\n\t\t\tlocal top = v((head.lo.X + head.hi.X) / 2, head.lo.Y, (head.lo.Z + head.hi.Z) / 2)\n\t\t\tif big then\n\t\t\t\t-- the turkey foot: three racemes splayed from the culm's top\n\t\t\t\tfor q = 1, 3 do\n\t\t\t\t\tlocal a = math.rad(spin + q * 120 + i * 40)\n\t\t\t\t\tlocal tip = top + v(math.cos(a) * 1.6, between(rand, 6, 8), math.sin(a) * 1.6)\n\t\t\t\t\trod(add, `Raceme{k}_{i}_{q}`, top, tip, 0.35, pick(C.raceme, rand), true)\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tfor q = 1, 4 do\n\t\t\t\t\tadd(rec(`Tuft{k}_{i}_{q}`, v(0.9, 1.3, 0.9), top + v(between(rand, -0.5, 0.5), q * 1.1, between(rand, -0.5, 0.5)), pick(C.tuft, rand), \"Fabric\", true, \"Ellipsoid\"))\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function meadowDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal id = region.id\n\tlocal at = placed(region)\n\tlocal byId = byIdOf(region)\n\tlocal rand = rng(region.seed, 29)\n\tlocal south = string.sub(id, 8, 8) == \"a\"\n\t-- the low tier's few: the mown edge, each clump's crown (the dense foot of a bunchgrass, its leaves' bases; the full tier arches the blades out of it) and the ant\n\t-- hill's mound (the forbs' heads are their own boxes' colours)\n\tif south then add(rec(\"Mown\", v(hi.X - lo.X, 0.1, 20), v((lo.X + hi.X) / 2, GT + 0.05, hi.Z - 10), C.mown[1], \"Grass\", false)) end\n\tfor k, clump in at.clumps do\n\t\tlocal big = clump.kind == \"big\"\n\t\tadd(rec(`Crown{k}`, v(if big then 20 else 14, if big then 14 else 9, if big then 20 else 14), v(clump.x, GT + (if big then 3.5 else 2.2), clump.z),\n\t\t\tpick(if big then C.bigLeaf else C.littleLeaf, rand), \"LeafyGrass\", false, \"Ellipsoid\"))\n\tend\n\tif at.hill ~= nil then add(rec(\"Hill\", v(34, 9, 34), v(at.hill.x, GT + 2.5, at.hill.z), C.hill, \"Ground\", false, \"Ellipsoid\")) end\n\tif at.leaf ~= nil then\n\t\tlocal L = Meadow.LEAF\n\t\tadd(rec(\"CurledLeaf\", v(L.l + 1, 3.2, L.w + 1), v(at.leaf.x, GT + L.gap + 0.9, at.leaf.z), C.leaf, \"Fabric\", false, \"Ellipsoid\", v(0, 15, 0)))\n\t\tadd(rec(\"LeafCurl\", v(L.l, 1.2, 2.2), v(at.leaf.x, GT + L.gap + 2, at.leaf.z - L.w / 2 + 0.6), C.leafDark, \"Fabric\", true, \"Cylinder\", v(0, 15, 0)))\n\t\tadd(rec(\"LeafVein\", v(L.l * 0.9, 0.1, 0.25), v(at.leaf.x, GT + L.gap + L.thick + 0.1, at.leaf.z), \"a08454\", \"Fabric\", true, nil, v(0, 15, 0)))\n\tend\n\t-- the full tier: the forb and the grasses whole, then the thatch and the floor's mottle\n\tif at.forb ~= nil then forbDecor(byId, id, at.forb, add, rand) end\n\tfor k, clump in at.clumps do clumpDecor(byId, id, k, clump, add, rand) end\n\tif south then\n\t\tfor i = 1, 6 do\n\t\t\tadd(rec(`MownTuft{i}`, v(between(rand, 4, 8), between(rand, 1.5, 3), between(rand, 3, 6)), v(between(rand, lo.X + 4, hi.X - 4), GT + 1, between(rand, hi.Z - 18, hi.Z - 2)),\n\t\t\t\tpick(C.mown, rand), \"Grass\", true, \"Ellipsoid\"))\n\t\tend\n\tend\n\tfor i = 1, 12 do\n\t\tlocal x, z = between(rand, lo.X + 3, hi.X - 3), between(rand, lo.Z + 3, hi.Z - 3)\n\t\tlocal w = between(rand, 8, 18)\n\t\tadd(rec(`Thatch{i}`, v(w, 0.25, w * between(rand, 0.4, 0.8)), v(x, GT + 0.1, z), pick(C.thatch, rand), \"Grass\", true, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\tend\n\tfor i = 1, 6 do\n\t\tlocal x, z = between(rand, lo.X + 5, hi.X - 5), between(rand, lo.Z + 5, hi.Z - 5)\n\t\tadd(rec(`Bare{i}`, v(between(rand, 4, 9), 0.08, between(rand, 3, 7)), v(x, GT + 0.04, z), C.soil, \"Ground\", true, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\tend\n\t-- a few dead stems of last year leaning in the grass\n\tfor i = 1, 3 do\n\t\tlocal x, z = between(rand, lo.X + 15, hi.X - 15), between(rand, lo.Z + 15, hi.Z - 15)\n\t\tlocal h = between(rand, 40, 80)\n\t\tblade(add, `Dead{i}`, v(x, GT, z), h, 0.35, between(rand, 0, 360), between(rand, 15, 35), nil, pick(C.thatch, rand), true)\n\tend\nend\n\nlocal function padDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal rand = rng(region.seed, 7)\n\tlocal id = region.id\n\tif id == \"pad_b3\" then\n\t\tlocal G = Meadow.GRATE\n\t\tadd(rec(\"PitDark\", v(G.x1 - G.x0 - 4.2, 0.1, G.z1 - G.z0 - 4.2), v((G.x0 + G.x1) / 2, GT - G.deep + 0.05, (G.z0 + G.z1) / 2), \"1e1c19\", \"Mud\", false))\n\t\tadd(rec(\"PitLeaf\", v(5, 0.1, 3), v(G.x0 + 10, GT - G.deep + 0.2, G.z0 + 9), C.leafDark, \"Fabric\", true, \"Ellipsoid\", v(0, 30, 0)))\n\t\tadd(rec(\"PitWater\", v(14, 0.06, 10), v(G.x0 + 18, GT - G.deep + 0.1, G.z0 + 18), \"3e4a4a\", \"Glass\", true, \"Ellipsoid\"))\n\tend\n\t-- the slab's joints and a lichen spot or two\n\tlocal S = Meadow.SLAB\n\tlocal a, b, c, d = clip(S.x0, S.x1, S.z0, S.z1, lo.X, hi.X, lo.Z, hi.Z)\n\tif a ~= nil then\n\t\tlocal x = math.ceil((a :: number) / 60) * 60\n\t\tlocal k = 0\n\t\twhile x < (b :: number) - 1 do\n\t\t\tk += 1\n\t\t\tadd(rec(`Joint{k}`, v(0.4, 0.04, (d :: number) - (c :: number)), v(x, SL + 0.02, ((c :: number) + (d :: number)) / 2), C.concreteDark, \"Concrete\", false))\n\t\t\tx += 60\n\t\tend\n\t\tfor i = 1, 2 do\n\t\t\tadd(rec(`Lichen{i}`, v(between(rand, 1.5, 3), 0.05, between(rand, 1.2, 2.6)), v(between(rand, a :: number, b :: number), SL + 0.03, between(rand, c :: number, d :: number)),\n\t\t\t\tpick({ \"b8b88a\", \"9aa078\", \"c9c49a\" }, rand), \"SmoothPlastic\", true, \"Ellipsoid\"))\n\t\tend\n\tend\n\t-- the city in the gravel: a bottle cap, a ring-pull, a cigarette end, a few bigger stones and a fallen leaf\n\tlocal things: { { any } } = {\n\t\t{ \"Cap\", v(2.6, 0.6, 2.6), \"c9302a\", \"Metal\", \"Cylinder\" }, { \"RingPull\", v(2.2, 0.1, 1.2), \"c9cdd0\", \"Metal\", false }, { \"Butt\", v(2.8, 0.75, 0.75), \"e8dcc0\", \"Fabric\", \"Cylinder\" },\n\t}\n\tif rand() < 0.6 then\n\t\tlocal t = pick(things, rand)\n\t\tlocal s = t[2] :: Vector3\n\t\tlocal x, z = between(rand, lo.X + 8, hi.X - 8), between(rand, lo.Z + 8, hi.Z - 8)\n\t\tlocal top = if x > S.x0 and x < S.x1 and z > S.z0 and z < S.z1 then SL else GT\n\t\tadd(rec(t[1] :: string, s, v(x, top + s.Y / 2, z), t[3] :: string, t[4] :: string, true, if t[5] then t[5] :: string else nil,\n\t\t\tif t[5] == \"Cylinder\" then v(0, between(rand, 0, 180), 90) else v(0, between(rand, 0, 180), 0)))\n\tend\n\tfor i = 1, 6 do\n\t\tlocal s = between(rand, 0.8, 2.2)\n\t\tlocal x, z = between(rand, lo.X + 3, hi.X - 3), between(rand, lo.Z + 3, hi.Z - 3)\n\t\tlocal top = if x > S.x0 and x < S.x1 and z > S.z0 and z < S.z1 then SL else GT\n\t\tadd(rec(`Stone{i}`, v(s, s * 0.6, s * between(rand, 0.7, 1.2)), v(x, top + s * 0.2, z),\n\t\t\tpick({ C.gravel, C.gravelDark, \"c9bfa8\", \"8f8676\" }, rand), \"Pebble\", i > 1, \"Ellipsoid\"))\n\tend\n\tlocal lx, lz = between(rand, lo.X + 10, hi.X - 10), between(rand, lo.Z + 10, hi.Z - 10)\n\tadd(rec(\"FallenLeaf\", v(5, 0.08, 3.5), v(lx, (if lx > S.x0 and lx < S.x1 and lz > S.z0 and lz < S.z1 then SL else GT) + 0.05, lz), pick({ \"b0702a\", \"8a6a3a\", \"c09a3a\" }, rand), \"Fabric\", true, \"Ellipsoid\",\n\t\tv(0, between(rand, 0, 180), 0)))\nend\n\nlocal function benchDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal west = region.id == \"bench_w\"\n\tlocal x0, x1 = if west then B.x0 else B.mid, if west then B.mid else B.x1\n\t-- the arm's scroll and the leg's foot, cast iron (low: the arm), the slats' grain and their screws\n\tlocal fx = (if west then B.ends[1] else B.ends[2]) + B.frame / 2\n\tadd(rec(\"Scroll\", v(B.frame + 0.6, 8, 8), v(fx, SL + B.arm[1] - 2, B.armPost[2] + 2), C.ironDark, \"Metal\", false, \"Ellipsoid\"))\n\tadd(rec(\"Foot\", v(B.frame + 1, 1.5, 8), v(fx, SL + 0.75, B.front - 2), C.ironDark, \"Metal\", true, \"Ellipsoid\"))\n\tfor k, s in SLATS do\n\t\tadd(rec(`Grain{k}`, v(x1 - x0 - 2, 0.03, 0.25), v((x0 + x1) / 2, SL + B.seat + 0.015, (s[1] + s[2]) / 2 + 1.5), \"6a4a2a\", \"Wood\", true))\n\t\tadd(rec(`Screw{k}`, v(0.8, 0.12, 0.8), v(fx, SL + B.seat + 0.06, (s[1] + s[2]) / 2), \"4a4a48\", \"Metal\", true, \"Cylinder\", v(0, 0, 90)))\n\tend\n\tif not west then add(rec(\"Plaque\", v(12, 3.2, 0.2), v(-60, SL + (B.back[2][1] + B.back[2][2]) / 2, B.backZ[2] + 0.1), \"b08a3c\", \"Metal\", true)) end\nend\n\nlocal function binDecor(_region: Region, add: (Drawn) -> boolean)\n\tlocal N, K, Q = Meadow.BIN, Meadow.CAN, Meadow.PACKET\n\tadd(rec(\"Slot\", v(30, 0.1, 8), v((N.x0 + N.x1) / 2, SL + N.lid + 0.05, N.z1 - 8), \"101010\", \"SmoothPlastic\", false))\n\tadd(rec(\"Can\", v(K.x1 - K.x0, K.z1 - K.z0, K.z1 - K.z0), v((K.x0 + K.x1) / 2, GT + (K.z1 - K.z0) / 2, (K.z0 + K.z1) / 2), C.can, \"Metal\", false, \"Cylinder\"))\n\tadd(rec(\"CanEnd\", v(0.3, 6.2, 6.2), v(K.x1 + 0.1, GT + (K.z1 - K.z0) / 2, (K.z0 + K.z1) / 2), C.canTop, \"Metal\", true, \"Cylinder\"))\n\tadd(rec(\"Packet\", v(Q.x1 - Q.x0 + 1, Q.h * 1.3, Q.z1 - Q.z0 + 1), v((Q.x0 + Q.x1) / 2, GT + Q.h / 2, (Q.z0 + Q.z1) / 2), C.packet, \"SmoothPlastic\", false, \"Ellipsoid\", v(0, 12, 0)))\n\tadd(rec(\"PacketFoil\", v(5, 0.6, 4), v(Q.x0 + 4, GT + Q.h + 0.1, Q.z0 + 3), C.packetFoil, \"Metal\", true, \"Ellipsoid\", v(0, 30, 8)))\n\tadd(rec(\"PacketFold\", v(Q.x1 - Q.x0 - 2, 0.6, 1), v((Q.x0 + Q.x1) / 2, GT + Q.h + 0.2, Q.z1 - 2), \"b8861e\", \"SmoothPlastic\", true, nil, v(0, 12, 6)))\n\tadd(rec(\"Band\", v(N.x1 - N.x0 + 0.4, 3, N.z1 - N.z0 + 0.4), v((N.x0 + N.x1) / 2, SL + 60, (N.z0 + N.z1) / 2), \"c9a227\", \"Metal\", true))\nend\n\nlocal function lampDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal L = Meadow.LAMP\n\tif region.id == \"lamp_4\" then\n\t\t-- the bulb inside the glass (it glows; Client/HutLife lights the lantern at dusk) and the glass's corner bars\n\t\tadd(rec(\"Bulb\", v(5, 7, 5), Meadow.LANTERN.at, \"fff1c8\", \"Neon\", false, \"Ball\"))\n\t\tfor k, c in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do\n\t\t\tadd(rec(`Bar{k}`, v(0.8, L.glass.h, 0.8), v(L.x + c[1] * L.glass.half, LAMP_TOP + L.plate.h + L.glass.h / 2, L.z + c[2] * L.glass.half), C.iron, \"Metal\", true))\n\t\tend\n\t\tadd(rec(\"CapRoof\", v(L.cap.half * 2, 5, L.cap.half * 2), v(L.x, LAMP_TOP + L.plate.h + L.glass.h + L.cap.h + 1.5, L.z), C.iron, \"Metal\", true, \"Ellipsoid\"))\n\telseif region.id == \"lamp_1\" then\n\t\tadd(rec(\"Door\", v(0.2, 18, 6), v(L.x + L.half + 0.1, SL + 40, L.z), \"2a2d2f\", \"Metal\", true))\n\t\tadd(rec(\"Sticker\", v(0.15, 5, 4), v(L.x - L.half - 0.08, SL + 60, L.z + 1), \"e8e2d0\", \"SmoothPlastic\", false))\n\tend\nend\n\n-- ---------------------------------------------------------------- the patches: what the spider sees close\n-- Each meadow cell and each pad cell is cut into patches of World/Hut.PATCH studs (kind \"patch\", drawn only near the spider, World/LookPlan): in the meadow the thatch at\n-- true size (dead blades lying in layers, 2 to 8 cm), the new growth coming up through it (short green blades), crumbs of soil, seeds, fallen florets under the flowers and\n-- the morning's dew; on the mown edge, short cut tufts; on the gravel, its stones; on the slab, its grit.\nlocal PATCHED: { [string]: boolean } = { meadow = true, pad = true }\nlocal patchParent: { [string]: Region } = {}\nfunction Meadow.patches(regions: { Region }, worldSeed: number, seedOf: (number, string) -> number): { Region }\n\tlocal out: { Region } = {}\n\tlocal size = Hut.PATCH\n\tfor _, r in regions do\n\t\tif PATCHED[r.kind] then\n\t\t\tlocal lo, hi = r.bounds[1], r.bounds[2]\n\t\t\tlocal nx = math.max(1, math.ceil((hi.X - lo.X) / size - 1e-6))\n\t\t\tlocal nz = math.max(1, math.ceil((hi.Z - lo.Z) / size - 1e-6))\n\t\t\tlocal dx, dz = (hi.X - lo.X) / nx, (hi.Z - lo.Z) / nz\n\t\t\tfor i = 1, nx do\n\t\t\t\tfor j = 1, nz do\n\t\t\t\t\tlocal pid = `{r.id}~{i}_{j}`\n\t\t\t\t\tlocal plo, phi = v(lo.X + (i - 1) * dx, GT - 2, lo.Z + (j - 1) * dz), v(lo.X + i * dx, GT + 40, lo.Z + j * dz)\n\t\t\t\t\tlocal mid = (plo + phi) * 0.5\n\t\t\t\t\tlocal p = table.freeze({\n\t\t\t\t\t\tid = pid, kind = \"patch\", origin = mid, bounds = table.freeze({ plo, phi }), seed = seedOf(worldSeed, pid), neighbors = table.freeze({}),\n\t\t\t\t\t\tretreats = table.freeze({}), spawn = table.freeze({ pos = mid, heading = v(0, 0, -1) }), clockScale = r.clockScale,\n\t\t\t\t\t}) :: any\n\t\t\t\t\tpatchParent[pid] = r\n\t\t\t\t\ttable.insert(out, p)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn out\nend\n-- The region a patch of the meadow's belongs to (nil for one that is not the meadow's: World/Hut's).\nfunction Meadow.patchParent(patch: Region): Region?\n\treturn patchParent[patch.id]\nend\n\nlocal THATCH = { \"b8a77a\", \"a89766\", \"c2b38a\", \"9c8b5e\", \"b09f70\", \"8f7f56\", \"c9b98e\" }\nlocal GREEN = { \"6f9a46\", \"5f8a3e\", \"7d9a4e\", \"86a85a\", \"6a8a4a\" }\nlocal STONES = { \"b3a68a\", \"938870\", \"c9bfa8\", \"8f8676\", \"a69a80\", \"d1c7b0\", \"7d7466\", \"bfae92\" }\n\n-- The standing boxes on a cell's floor (what the near detail keeps clear of).\nlocal function standing(region: Region): { Box }\n\tlocal out: { Box } = {}\n\tfor _, p in Meadow.pieces(region) do\n\t\tif p.lo.Y <= GT + 0.6 and p.hi.Y > GT + 0.05 and not string.find(p.id, \"_soil\", 1, true) and not string.find(p.id, \"_gravel\", 1, true) then\n\t\t\ttable.insert(out, { min = p.lo, max = p.hi })\n\t\tend\n\tend\n\treturn out\nend\nlocal function clear(boxes: { Box }, x: number, z: number, m: number): boolean\n\tfor _, b in boxes do\n\t\tif x > b.min.X - m and x < b.max.X + m and z > b.min.Z - m and z < b.max.Z + m then return false end\n\tend\n\treturn true\nend\n\nlocal function patchDecor(patch: Region, add: (Drawn) -> boolean)\n\tlocal parent = patchParent[patch.id]\n\tif parent == nil then return end\n\tlocal lo, hi = patch.bounds[1], patch.bounds[2]\n\tlocal rand = rng(patch.seed, 43)\n\tlocal boxes = standing(parent)\n\tlocal pad = parent.kind == \"pad\"\n\tlocal mownTo = if string.sub(parent.id, 1, 8) == \"meadow_a\" then parent.bounds[2].Z - 20 else math.huge -- (the mown edge: z over this)\n\tlocal spots: { Vector3 } = {}\n\tfor i = 1, 5 do\n\t\tfor j = 1, 5 do\n\t\t\ttable.insert(spots, v(lo.X + (i - 1 + between(rand, 0.15, 0.85)) * (hi.X - lo.X) / 5, 0, lo.Z + (j - 1 + between(rand, 0.15, 0.85)) * (hi.Z - lo.Z) / 5))\n\t\tend\n\tend\n\tfor i = #spots, 2, -1 do\n\t\tlocal j = 1 + math.floor(rand() * i) % i\n\t\tspots[i], spots[j] = spots[j], spots[i]\n\tend\n\tlocal S = Meadow.SLAB\n\tlocal k = 0\n\tlocal function onSlab(x: number, z: number): boolean\n\t\treturn x > S.x0 and x < S.x1 and z > S.z0 and z < S.z1\n\tend\n\tlocal function stone(x: number, z: number, full: boolean)\n\t\tk += 1\n\t\tlocal s = between(rand, 0.2, 0.9)\n\t\tlocal top = if onSlab(x, z) then SL else GT\n\t\tadd(rec(`Stone{k}`, v(s, s * between(rand, 0.55, 0.85), s * between(rand, 0.75, 1.15)), v(x, top + s * 0.2, z), pick(STONES, rand), \"Pebble\", full, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\tend\n\tlocal function thatchBlade(x: number, z: number, full: boolean)\n\t\tk += 1\n\t\tlocal l = between(rand, 2, 8)\n\t\tadd(rec(`Thatch{k}`, v(l, 0.06, between(rand, 0.25, 0.55)), v(x, GT + between(rand, 0.05, 0.6), z), pick(THATCH, rand), \"SmoothPlastic\", full, nil,\n\t\t\tv(between(rand, -8, 8), between(rand, 0, 180), between(rand, -6, 6))))\n\tend\n\tlocal function sprout(x: number, z: number, full: boolean, short: boolean)\n\t\tk += 1\n\t\tlocal spin = between(rand, 0, 360)\n\t\tfor b = 1, 3 do\n\t\t\tblade(add, `Sprout{k}_{b}`, v(x + between(rand, -0.4, 0.4), GT, z + between(rand, -0.4, 0.4)), if short then between(rand, 2, 4) else between(rand, 4, 12),\n\t\t\t\tbetween(rand, 0.25, 0.45), spin + b * 120, between(rand, 4, 20), nil, pick(GREEN, rand), full or b > 1)\n\t\tend\n\tend\n\t-- the low tier's few\n\tfor s = 1, 3 do\n\t\tlocal p = spots[s]\n\t\tif clear(boxes, p.X, p.Z, 1.5) then\n\t\t\tif pad then stone(p.X, p.Z, false); stone(p.X + 1.5, p.Z - 1, false)\n\t\t\telseif p.Z > mownTo then sprout(p.X, p.Z, false, true)\n\t\t\telse thatchBlade(p.X, p.Z, false); if s == 1 then sprout(p.X + 1, p.Z, false, false) end end\n\t\tend\n\tend\n\t-- under the forb: what falls from it\n\tlocal at = if pad then nil else placed(parent)\n\tif at ~= nil and at.forb ~= nil then\n\t\tlocal f = at.forb\n\t\tfor i = 1, 5 do\n\t\t\tlocal a, r = between(rand, 0, TAU), between(rand, 3, 12)\n\t\t\tlocal x, z = f.x + math.cos(a) * r, f.z + math.sin(a) * r\n\t\t\tif x > lo.X and x < hi.X and z > lo.Z and z < hi.Z and clear(boxes, x, z, 0.5) then\n\t\t\t\tlocal colors = { susan = \"e0a020\", yarrow = \"e8e4d8\", coneflower = \"a85f84\", milkweed = \"b88a8e\", goldenrod = \"c9a22e\", beebalm = \"9a7aa6\" } :: { [string]: string }\n\t\t\t\tadd(rec(`Fallen{i}`, v(0.7, 0.3, 0.6), v(x, GT + 0.3, z), colors[f.kind] or \"c9a22e\", \"SmoothPlastic\", true, \"Ball\"))\n\t\t\tend\n\t\tend\n\tend\n\t-- the rest, spot by spot, to the budget\n\tlocal dews = 0\n\tfor pass = 1, 5 do\n\t\tfor s, p in spots do\n\t\t\tlocal x, z = p.X + between(rand, -2.2, 2.2) * (pass - 1), p.Z + between(rand, -2.2, 2.2) * (pass - 1)\n\t\t\tif clear(boxes, x, z, 1.2) then\n\t\t\t\tif pad then\n\t\t\t\t\tfor _ = 1, 3 do stone(x + between(rand, -2.4, 2.4), z + between(rand, -2.4, 2.4), true) end\n\t\t\t\telseif z > mownTo then\n\t\t\t\t\tif (s + pass) % 2 == 0 then sprout(x, z, true, true) else thatchBlade(x, z, true) end\n\t\t\t\telse\n\t\t\t\t\tlocal roll = rand()\n\t\t\t\t\tif roll < 0.45 then\n\t\t\t\t\t\tfor _ = 1, 2 do thatchBlade(x + between(rand, -1.5, 1.5), z + between(rand, -1.5, 1.5), true) end\n\t\t\t\t\telseif roll < 0.75 then sprout(x, z, true, false)\n\t\t\t\t\telseif roll < 0.85 then\n\t\t\t\t\t\tk += 1\n\t\t\t\t\t\tadd(rec(`Crumb{k}`, v(1, 0.4, 0.8), v(x, GT + 0.15, z), \"5a4a34\", \"Ground\", true, \"Ellipsoid\"))\n\t\t\t\t\telseif roll < 0.92 then\n\t\t\t\t\t\tk += 1\n\t\t\t\t\t\tadd(rec(`Seed{k}`, v(0.5, 0.25, 0.3), v(x, GT + 0.3, z), pick({ \"6a5a3a\", \"8a7a52\", \"3a3024\" }, rand), \"SmoothPlastic\", true, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\t\t\t\t\telseif dews < 3 then\n\t\t\t\t\t\tdews += 1\n\t\t\t\t\t\tadd(drop(`Dew{dews}`, v(x, GT + between(rand, 1, 5), z), between(rand, 0.3, 0.55), rand))\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal decorCache: { [string]: { Drawn } } = {}\n-- The region's drawn records (or a patch of the meadow's), within its kind's budget at both tiers; the same list for the same region.\nfunction Meadow.decor(region: Region): { Drawn }\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = decorCache[key]\n\tif cached ~= nil then return cached end\n\tlocal budget = if region.kind == \"patch\" then Hut.BUDGETS.patch else Meadow.BUDGETS[region.kind]\n\tassert(budget ~= nil, \"no budget for the region kind \" .. region.kind)\n\tlocal list, add = sheet(budget)\n\tlocal k = region.kind\n\tif k == \"meadow\" then meadowDecor(region, add)\n\telseif k == \"pad\" then padDecor(region, add)\n\telseif k == \"park_bench\" then benchDecor(region, add)\n\telseif k == \"park_bin\" then binDecor(region, add)\n\telseif k == \"lamppost\" then lampDecor(region, add)\n\telseif k == \"patch\" then patchDecor(region, add) end\n\tfor _, d in list do table.freeze(d) end\n\tdecorCache[key] = table.freeze(list)\n\treturn list\nend\n\n-- ---------------------------------------------------------------- the life\n-- The bestiary's kinds where they live here (the hut garden's profiles, Data/Species): leafhoppers on the bluestem's culms (Hut's pairs either side of a culm), house flies\n-- (the sill's own profile) and hoverflies on the flower heads, small moths resting on the grass heads by day and restless from dusk, house flies at the bin, and moths\n-- at the lamp's lantern. The ants at their hill (ambient, Prey/Ant). From each region's own seed by streams of their own.\nMeadow.LIFE = table.freeze({\n\tleafhoppers = { meadow_a3 = { full = 2, low = 1 }, meadow_c2 = { full = 2, low = 1 }, meadow_d3 = { full = 2, low = 1 }, meadow_e4 = { full = 1, low = 1 } },\n\thoverflies = { meadow_a3 = { full = 1, low = 1 }, meadow_b5 = { full = 1, low = 1 }, meadow_c4 = { full = 1, low = 1 }, meadow_d2 = { full = 1, low = 1 } },\n\thouseflies = { meadow_c1 = { full = 1, low = 1 }, meadow_e5 = { full = 1, low = 1 }, meadow_a1 = { full = 1, low = 1 }, bin = { full = 2, low = 1 } },\n\tmoths = { meadow_d1 = { full = 1, low = 1 }, meadow_e2 = { full = 1, low = 1 }, lamp_4 = { full = 2, low = 1 } },\n\tants = { meadow_b4 = { full = 6, low = 3, salt = 151 } },\n\t-- (ROBLOX-120) field crickets in the thatch, singing from dusk\n\tcrickets = { meadow_b2 = { full = 1, low = 1, perches = 6 }, meadow_d3 = { full = 1, low = 1, perches = 6 }, meadow_c5 = { full = 1, low = 1, perches = 6 } },\n})\n\nexport type Perch = Hut.Perch\nlocal function spot(p: Vector3, n: Vector3, sh: number, fo: number): { any }\n\treturn { p, n, sh, fo }\nend\nlocal function spots(region: Region, kind: string, list: { { any } }, starts: number): { Perch }\n\tlocal out: { Perch } = {}\n\tfor i, sp in list do\n\t\ttable.insert(out, { id = `{region.id}_{kind}_{i}`, position = sp[1], normal = sp[2], shelter = sp[3], food = sp[4], start = i <= starts, kind = \"leaf\" } :: any)\n\tend\n\treturn out\nend\n-- A head's top middle, of a piece.\nlocal function topOf(p: Piece): Vector3\n\treturn v((p.lo.X + p.hi.X) / 2, p.hi.Y, (p.lo.Z + p.hi.Z) / 2)\nend\n\nlocal bestiaryCache: { [string]: any } = {}\nfunction Meadow.bestiary(region: Region): { any }?\n\tlocal L = Meadow.LIFE\n\tlocal hopper, hover, house, moth = L.leafhoppers[region.id], L.hoverflies[region.id], L.houseflies[region.id], L.moths[region.id]\n\tlocal cricket = L.crickets[region.id]\n\tif hopper == nil and hover == nil and house == nil and moth == nil and cricket == nil then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tif bestiaryCache[key] ~= nil then return bestiaryCache[key] end\n\tlocal out = {}\n\tlocal byId = byIdOf(region)\n\tlocal at = if region.kind == \"meadow\" then placed(region) else nil\n\t-- the flowers' heads and the forb's upper leaves, the grasses' heads: where flies and moths sit\n\tlocal function flowerSpots(): { { any } }\n\t\tlocal list: { { any } } = {}\n\t\tif at ~= nil and at.forb ~= nil then\n\t\t\tlocal base = `{region.id}_{at.forb.kind}`\n\t\t\tlocal head = byId[base .. \"_cone\"] or byId[base .. \"_head\"]\n\t\t\tif head ~= nil then table.insert(list, spot(topOf(head), Vector3.yAxis, 0.2, 0.9)) end\n\t\t\tfor i = 8, 1, -1 do\n\t\t\t\tlocal leaf = byId[`{base}_leaf_{i}`]\n\t\t\t\tif leaf ~= nil and #list < 4 then table.insert(list, spot(topOf(leaf), Vector3.yAxis, 0.3, 0.5)) end\n\t\t\tend\n\t\tend\n\t\treturn list\n\tend\n\tlocal function grassHeads(): { { any } }\n\t\tlocal list: { { any } } = {}\n\t\tfor _, p in Meadow.pieces(region) do\n\t\t\tif string.find(p.id, \"_head_\", 1, true) ~= nil and #list < 5 then table.insert(list, spot(topOf(p), Vector3.yAxis, 0.3, 0.3)) end\n\t\tend\n\t\tfor _, p in Meadow.pieces(region) do\n\t\t\tif string.sub(p.id, -6) == \"_blade\" and #list < 7 then table.insert(list, spot(topOf(p) + v(0, 0, 0), Vector3.yAxis, 0.4, 0.2)) end\n\t\tend\n\t\treturn list\n\tend\n\tif hopper ~= nil and at ~= nil then\n\t\t-- in pairs either side of the first big clump's first culm, low and high (Hut's leafhoppers: a hop round the culm to its far side)\n\t\tlocal salt = 73\n\t\tlocal k = 0\n\t\tfor i, c in at.clumps do if c.kind == \"big\" and k == 0 then k = i end end\n\t\tlocal culm = byId[`{region.id}_big{k}_culm_1`]\n\t\tif culm ~= nil then\n\t\t\tlocal perches: { Perch } = {}\n\t\t\tlocal n = 0\n\t\t\tlocal function pair(a: Vector3, na: Vector3, b: Vector3, nb: Vector3, round: Vector3, start: boolean)\n\t\t\t\tn += 1\n\t\t\t\tlocal ia, ib = `{region.id}_leafhopper_{n}a`, `{region.id}_leafhopper_{n}b`\n\t\t\t\ttable.insert(perches, { id = ia, position = a, normal = na, shelter = 0.4, food = 0.6, start = start, kind = \"stem\", hop = true, behind = ib, round = round } :: any)\n\t\t\t\ttable.insert(perches, { id = ib, position = b, normal = nb, shelter = 0.4, food = 0.6, start = false, kind = \"stem\", hop = true, behind = ia, round = round } :: any)\n\t\t\tend\n\t\t\tlocal mx, mz = (culm.lo.X + culm.hi.X) / 2, (culm.lo.Z + culm.hi.Z) / 2\n\t\t\tfor q, h in { 14, 36, 62 } do\n\t\t\t\tlocal y = GT + h\n\t\t\t\tif q % 2 == 1 then pair(v(culm.hi.X, y, mz), Vector3.xAxis, v(culm.lo.X, y, mz), -Vector3.xAxis, v(mx, y, culm.hi.Z + 0.35), q == 1)\n\t\t\t\telse pair(v(mx, y, culm.hi.Z), Vector3.zAxis, v(mx, y, culm.lo.Z), -Vector3.zAxis, v(culm.hi.X + 0.35, y, mz), false) end\n\t\t\tend\n\t\t\tlocal vents = { { id = `{culm.id}_vent_leafhopper`, position = v(mx, GT, culm.lo.Z - 1.5), normal = Vector3.yAxis, appear = true, reach = 60 } }\n\t\t\ttable.insert(out, { kind = \"leafhopper\", profile = \"leafhopper_prototype\", perches = perches, vents = vents, target = hopper.full, low = hopper.low,\n\t\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_leafhopper_fly_` })\n\t\tend\n\tend\n\tif hover ~= nil then\n\t\tlocal list = flowerSpots()\n\t\tif #list > 0 then\n\t\t\tlocal salt = 113\n\t\t\tlocal first = list[1][1] :: Vector3\n\t\t\ttable.insert(out, { kind = \"hoverfly\", profile = \"hoverfly_prototype\", perches = spots(region, \"hoverfly\", list, hover.full),\n\t\t\t\tvents = { { id = `{region.id}_vent_hoverfly`, position = first + v(0, 16, 0), normal = Vector3.yAxis, appear = true, reach = 80 } }, target = hover.full, low = hover.low,\n\t\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_hoverfly_fly_` })\n\t\tend\n\tend\n\tif house ~= nil then\n\t\tlocal list: { { any } }\n\t\tlocal vent: Vector3\n\t\tif region.id == \"bin\" then\n\t\t\t-- at the bin: on its lid round the slot, its rim, the can and the packet\n\t\t\tlocal N, K, Q = Meadow.BIN, Meadow.CAN, Meadow.PACKET\n\t\t\tlist = {\n\t\t\t\tspot(v(N.x0 + 8, SL + N.lid, N.z0 + 8), Vector3.yAxis, 0.2, 0.6), spot(v(N.x1 - 8, SL + N.lid, N.z0 + 12), Vector3.yAxis, 0.2, 0.6),\n\t\t\t\tspot(v(N.x0 - 1, SL + N.top + 1.5, (N.z0 + N.z1) / 2), -Vector3.xAxis, 0.2, 0.5), spot(v(N.x1 + 1, SL + N.top + 1.5, N.z0 + 10), Vector3.xAxis, 0.2, 0.5),\n\t\t\t\tspot(v(58, GT + (K.z1 - K.z0), (K.z0 + K.z1) / 2), Vector3.yAxis, 0.1, 0.8), spot(v(K.x1, GT + 3.3, (K.z0 + K.z1) / 2), Vector3.xAxis, 0.1, 0.8),\n\t\t\t\tspot(v(25, GT + Q.h, -721), Vector3.yAxis, 0.1, 0.8),\n\t\t\t}\n\t\t\tvent = v(60, SL + N.lid + 12, -774)\n\t\telse\n\t\t\tlist = flowerSpots()\n\t\t\tvent = (if #list > 0 then list[1][1] :: Vector3 else region.origin) + v(0, 16, 0)\n\t\t\t-- (a house fly starts on a leaf and comes to the head later: some heads' perches have no clear flight to the leaves under them)\n\t\t\tif #list > 1 then table.insert(list, table.remove(list, 1) :: any) end\n\t\tend\n\t\tif #list > 0 then\n\t\t\tlocal salt = 137\n\t\t\ttable.insert(out, { kind = \"housefly\", profile = \"fly_like_prototype\", perches = spots(region, \"housefly\", list, house.full),\n\t\t\t\tvents = { { id = `{region.id}_vent_housefly`, position = vent, normal = Vector3.yAxis, appear = true, reach = 80 } }, target = house.full, low = house.low,\n\t\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_housefly_fly_` })\n\t\tend\n\tend\n\tif moth ~= nil then\n\t\tlocal list: { { any } }\n\t\tlocal vent: Vector3\n\t\tif region.id == \"lamp_4\" then\n\t\t\t-- at the lantern: on its glass, under its cap, on the pole under it\n\t\t\tlocal Lm = Meadow.LAMP\n\t\t\tlocal g0 = LAMP_TOP + Lm.plate.h\n\t\t\t-- (in pairs on a face of the glass: a flight round the lantern's corner or over its cap is not clear, one along a face is)\n\t\t\tlist = {\n\t\t\t\tspot(v(Lm.x + Lm.glass.half, g0 + 14, Lm.z - 3), Vector3.xAxis, 0.2, 0.2), spot(v(Lm.x + Lm.glass.half, g0 + 7, Lm.z + 5), Vector3.xAxis, 0.2, 0.2),\n\t\t\t\tspot(v(Lm.x + 2, g0 + 18, Lm.z + Lm.glass.half), Vector3.zAxis, 0.2, 0.2), spot(v(Lm.x - 5, g0 + 9, Lm.z + Lm.glass.half), Vector3.zAxis, 0.2, 0.2),\n\t\t\t\tspot(v(Lm.x - Lm.glass.half, g0 + 9, Lm.z + 4), -Vector3.xAxis, 0.2, 0.2), spot(v(Lm.x - Lm.glass.half, g0 + 17, Lm.z - 5), -Vector3.xAxis, 0.2, 0.2),\n\t\t\t}\n\t\t\tvent = Meadow.LANTERN.at + v(0, 4, 24)\n\t\telse\n\t\t\tlist = grassHeads()\n\t\t\tvent = region.origin + v(0, 90, 0)\n\t\tend\n\t\tif #list > 0 then\n\t\t\tlocal salt = 131\n\t\t\ttable.insert(out, { kind = \"moth\", profile = \"moth_prototype\", perches = spots(region, \"moth\", list, moth.full),\n\t\t\t\tvents = { { id = `{region.id}_vent_moth`, position = vent, normal = Vector3.yAxis, appear = true, reach = 60 } }, target = moth.full, low = moth.low,\n\t\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_moth_fly_`, dusk = { from = 18, to = 6 } })\n\t\tend\n\tend\n\tif cricket ~= nil then\n\t\t-- (ROBLOX-120) the field cricket: spots on the meadow's floor in the thatch between the clumps, a jump apart, clear of the culms, the stems and the leaf\n\t\tlocal salt = 157\n\t\tlocal rand = rng(region.seed, salt)\n\t\tlocal boxes = standing(region)\n\t\tfor _, t in region.retreats do table.insert(boxes, { min = t.min - v(1, 0, 1), max = t.max + v(1, 0, 1) }) end\n\t\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\t\tlocal perches: { Perch } = {}\n\t\tfor i = 1, cricket.perches do\n\t\t\tfor _ = 1, 60 do\n\t\t\t\tlocal x, z = between(rand, lo.X + 6, hi.X - 6), between(rand, lo.Z + 6, hi.Z - 6)\n\t\t\t\tlocal ok = clear(boxes, x, z, 2)\n\t\t\t\tif ok then for _, q in perches do if (v(x, 0, z) - v(q.position.X, 0, q.position.Z)).Magnitude < 9 then ok = false; break end end end\n\t\t\t\tif ok then\n\t\t\t\t\ttable.insert(perches, { id = `{region.id}_cricket_{i}`, position = v(x, GT, z), normal = Vector3.yAxis, shelter = 0.7, food = 0.3, start = #perches < cricket.full,\n\t\t\t\t\t\tkind = \"soil\", hop = true } :: any)\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tlocal vents = {}\n\t\tif #perches > 1 then table.insert(vents, { id = `{region.id}_vent_cricket`, position = perches[#perches].position, normal = Vector3.yAxis, appear = true, reach = 10 }) end\n\t\ttable.insert(out, { kind = \"cricket\", profile = \"cricket_prototype\", perches = perches, vents = vents, target = cricket.full, low = cricket.low,\n\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_cricket_fly_`, dusk = { from = 19, to = 6.5 } })\n\tend\n\t-- (the band each kind's flights climb in: from under its lowest perch to 11 cm over its highest, PerchGraph.plan; the sill's 0 to 11 would send them down to it)\n\tfor _, k in out do\n\t\tlocal lo, hi = math.huge, -math.huge\n\t\tfor _, p in k.perches do lo, hi = math.min(lo, p.position.Y), math.max(hi, p.position.Y) end\n\t\tk.floor, k.ceiling = lo - 2, hi + 11\n\tend\n\tbestiaryCache[key] = out\n\treturn out\nend\n\nlocal ambientCache: { [string]: any } = {}\n-- The ants of the hill (Prey/Ant): their starts round the hill on the meadow's floor, the hill's foot their way in (`home`), the boxes they walk round.\nfunction Meadow.ambient(region: Region): { any }?\n\tlocal row = Meadow.LIFE.ants[region.id]\n\tif row == nil then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tif ambientCache[key] ~= nil then return ambientCache[key] end\n\tlocal at = placed(region)\n\tlocal hill = at.hill :: { x: number, z: number }\n\tlocal foot = Meadow.HILL.steps[1][1]\n\tlocal rand = rng(region.seed, row.salt)\n\tlocal spec: any = { kind = \"ant\", seed = (region.seed + row.salt * 104729) % MOD, full = row.full, low = row.low, starts = {}, prefix = region.id .. \"_\", surface = \"soil\",\n\t\thome = v(hill.x, GT, hill.z + foot + 0.8), centre = v(hill.x, GT, hill.z), range = 45 }\n\tlocal boxes = standing(region)\n\tfor i = 1, row.full do\n\t\tfor _ = 1, 30 do\n\t\t\tlocal a, r = between(rand, 0, TAU), between(rand, foot + 3, foot + 30)\n\t\t\tlocal x, z = hill.x + math.cos(a) * r, hill.z + math.sin(a) * r\n\t\t\tif clear(boxes, x, z, 1) then\n\t\t\t\tlocal h = between(rand, 0, TAU)\n\t\t\t\ttable.insert(spec.starts, { pos = v(x, GT, z), heading = v(math.cos(h), 0, math.sin(h)) })\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\tlocal _ = i\n\tend\n\tlocal out = { spec }\n\tambientCache[key] = out\n\treturn out\nend\n\n-- The regions the rival roams here beyond the hut garden's (Predator/RivalSpider.roam): the garden's path north (World/Hut's path_m1..m4), the bench patch's gravel\n-- (not the drain's cell, nor the furniture) and the meadow's first row along the gravel. The mate keeps to the garden.\nlocal ROAM: { [string]: boolean } = { path_m1 = true, path_m2 = true, path_m3 = true, path_m4 = true }\nfor _, id in { \"pad_a1\", \"pad_a2\", \"pad_a3\", \"pad_b1\", \"pad_b2\", \"pad_c1\", \"pad_c2\", \"pad_c3\" } do ROAM[id] = true end\nfor c = 1, 5 do ROAM[`meadow_a{c}`] = true end\nMeadow.ROAM = table.freeze(ROAM)\n\n-- ---------------------------------------------------------------- the crab spiders' flowers (Predator/CrabSpider)\n-- Each crab spider has two flowers it may sit on, one a day (its own seeded draw): the goldenrod spider's two goldenrod plumes (it is yellow), the yarrow spider's two yarrow\n-- heads (it is white): `form` its colour.\nexport type CrabSite = { region: string, piece: string, form: string }\nlocal function crabSite(cell: string, kind: string, form: string): CrabSite\n\treturn table.freeze({ region = \"meadow_\" .. cell, piece = `meadow_{cell}_{kind}_head`, form = form })\nend\nMeadow.CRAB_SITES = table.freeze({\n\ttable.freeze({ crabSite(\"c3\", \"goldenrod\", \"yellow\"), crabSite(\"e3\", \"goldenrod\", \"yellow\") }),\n\ttable.freeze({ crabSite(\"d4\", \"yarrow\", \"white\"), crabSite(\"a2\", \"yarrow\", \"white\") }),\n})\n-- A site's place, from its region's boxes: the head's top middle.\nfunction Meadow.crabAt(site: CrabSite, regions: { Region }): (Vector3, Piece?)\n\tfor _, r in regions do\n\t\tif r.id == site.region then\n\t\t\tfor _, p in Meadow.pieces(r) do\n\t\t\t\tif p.id == site.piece then return topOf(p), p end\n\t\t\tend\n\t\tend\n\tend\n\treturn Vector3.zero, nil\nend\n\nreturn Meadow\n",74919,2708264933},{"Shared/World/Pond","--!strict\n-- The pond's edge and the boardwalk, walkable (ROBLOX-122, docs/PARK_WORLD_DESIGN.md Phase D round 1): home range 4 at full spider detail where the boardwalk runs\n-- along the pond's south side, and the corridor that joins it to the meadow: the mown path from the bench patch's gravel east and north to the boardwalk's west end,\n-- and the boardwalk on to the pond. Pure data and pure generators, as World/Hut's and World/Meadow's are: the regions (`author`), their physical boxes (`pieces`),\n-- their drawn looks (`decor`), their near detail (`patches`), the water (`WATER`, `waterline`, `inWater`), the life they hold (`bestiary`, `ambient`), the frog's\n-- seats (`FROG_SITES`) and the dragonfly's beat (`darner`), all from the region and its seed, so the server, every client and the CLI tests get the same pond.\n-- Nothing here requires World/WorldMap or World/Garden.\n--\n-- Studs, the sill's frame (World/Preserve: x east, -z north, a stud a centimetre; the ground GROUND as the meadow's and the hut garden's). True scale.\n--\n-- The corridor (walkable at a coarser detail, docs/PARK_WORLD_DESIGN.md section 3):\n--   mown_e1..e2 ...... two metres east from the bench patch's gravel (pad_b3), x 90..290, z -730..-630.\n--   mown_n1 .......... 86 cm north from there, x 190..290, to the boardwalk's south face at z -816.\n--   walk_s1..s4, ..... the boardwalk from its west end (x 190) to the core (x 525): a deck 1.5 m wide of boards 14 cm wide laid along it with gaps between, 40 cm\n--   walk_n1..n4        over the ground on its fascia, beams and posts, a low kerb rail along each edge on spacer blocks; in two rows (the south five boards and the north\n--                      five), each whole inside the streaming radius. A spider climbs its south fascia from the path.\n-- The pond's edge (home range 4, 4 by 4 m: x 525..925, z -816..-1216), the boardwalk on its south side and the margin north\n-- of it, where the pond's south shore (World/Preserve.POND's ellipse) runs from the north-west to the south-east, so the west is bank and the east is water:\n--   deck_s1..s4, ..... the boardwalk on over the bank and the water's edge (the same deck), its posts down to the mud or the pond's bed.\n--   deck_n1..n4\n--   pond_a1..c4 ...... twelve cells of the margin (rows a to c north from the boardwalk, 100, 100 and 50 deep; columns 1 to 4 west to east): the mud bank in strips\n--                      (STRIP wide) stepping down to the waterline (GROUND, then damp mud 3 cm lower, then the wet margin a centimetre over the water), the water\n--                      (WATER, 6 cm under the lawn: no box, a spider cannot stand on it; Life/Water), the pond's bed under it; wet stones at the margin, sedge and soft\n--                      rush, two stands of cattails, lily pads (they float: a pad is walkable) and a water lily's flower.\n--   cattail_1a..2b ... the cattails' upper parts, each stand's in two regions up its leaves (each whole in the radius), as the lamppost's are.\n-- Homes: the gap between two boards of the boardwalk (deck_s2: `deck_gap`), under a flat stone resting on two others on the bank (pond_a2: `pond_stone`), and\n-- under a dead cattail leaf lying curled on the bank (pond_a1: `cattail_leaf`).\n-- The life (`bestiary`, `ambient`): non-biting midges and mosquitoes on the rushes and the cattails, restless and swarming from dusk; eastern forktail damselflies\n-- perched on the cattails by day; water striders skating the open water (Prey/Skater, ambient); the green frog on a stone or a pad (Predator/Frog); a green darner\n-- over the pond by day (drawn only, Client/PondBodies).\nlocal Hut = require(script.Parent.Hut)\nlocal Preserve = require(script.Parent.Preserve)\n\nlocal Pond = {}\n\nexport type Region = Hut.Region\nexport type Piece = Hut.Piece\nexport type Drawn = Hut.Drawn\nexport type Box = Hut.Box\n\nlocal function v(x: number, y: number, z: number): Vector3\n\treturn Vector3.new(x, y, z)\nend\nlocal function hex(s: string): Color3\n\treturn Color3.fromHex(s)\nend\nlocal MOD = 2147483647\nlocal TAU = 2 * math.pi\nlocal function rng(seed: number, salt: number): () -> number\n\tlocal state = (seed + salt * 7919) % MOD\n\tif state <= 0 then state += MOD - 1 end\n\treturn function(): number\n\t\tstate = (state * 16807) % MOD\n\t\treturn (state - 1) / (MOD - 1)\n\tend\nend\nlocal function between(rand: () -> number, a: number, b: number): number\n\treturn a + (b - a) * rand()\nend\nlocal function pick<T>(list: { T }, rand: () -> number): T\n\treturn list[1 + math.floor(rand() * #list)]\nend\n\n-- ---------------------------------------------------------------- the numbers\nlocal GT = Hut.GROUND\nPond.GROUND = GT\nPond.WATER = GT - 6 -- the pond's surface: 6 cm under the lawn\nPond.BED = Pond.WATER - 20 -- the margin's bed, 20 cm under the surface\nPond.FLOOR = -126 -- the bottom of the bed's box\nPond.DECK = -45 -- the boardwalk's top, 40 cm over the lawn (the backdrop's)\nPond.BOARD = table.freeze({ w = 14, gap = 1.11, thick = 4, count = 10, wide = 1.6 })\nPond.CUT = table.freeze({ GT + 70, GT + 150 }) -- where a cattail stand's leaves pass into its upper regions\nPond.STRIP = 20 -- the bank's strips, along x\nlocal WATER, BED, FLOOR, DECK = Pond.WATER, Pond.BED, Pond.FLOOR, Pond.DECK\n-- the corridor and the core (studs)\nPond.PATH_E = table.freeze({ x0 = 90, x1 = 290, z0 = -730, z1 = -630, n = 2 })\nPond.PATH_N = table.freeze({ x0 = 190, x1 = 290, z0 = -816, z1 = -730, n = 1 })\nPond.WALK_X = table.freeze({ 190, 275, 360, 445, 525 })\nPond.CORE_X = table.freeze({ 525, 625, 725, 825, 925 })\nPond.DECK_Z = table.freeze({ s = table.freeze({ -891, -816 }), n = table.freeze({ -966, -891 }) })\nPond.ROW_Z = table.freeze({ a = table.freeze({ -1066, -966 }), b = table.freeze({ -1166, -1066 }), c = table.freeze({ -1216, -1166 }) })\nPond.CORE = table.freeze({ x0 = 525, x1 = 925, z0 = -1216, z1 = -816 })\nlocal CUT1, CUT2 = Pond.CUT[1], Pond.CUT[2]\n\n-- The palette.\nlocal C = {\n\tmown = { \"6f9a46\", \"7d9a4e\", \"5f8a3e\", \"6a8f42\" }, board = \"8a7458\", boardDark = \"6f5d47\", boardGrey = \"8f8676\", post = \"5e4f3c\", mud = \"4f4031\", mudDark = \"3e3226\",\n\tmudWet = \"38302a\", bed = \"2f2a22\", water = \"3c5650\", stone = { \"8a8478\", \"7a756b\", \"6f6a60\", \"938c7e\" }, stoneWet = \"5a564e\",\n\tcattailLeaf = { \"6f7f45\", \"7a8a4e\", \"667745\", \"84904f\" }, cattailDead = \"a08a5a\", spike = \"5a3d27\", spikeMale = \"8a7a52\", sedge = { \"6f8248\", \"7a8a50\", \"5f7442\" },\n\tsedgeHead = \"6a5a3a\", rush = { \"4f7a3e\", \"5a8445\", \"47703a\" }, rushHead = \"7a6240\", pad = { \"4f7a3a\", \"56833f\", \"4a7036\", \"5e8a44\" }, padUnder = \"8a4a4a\",\n\tlily = \"f2f0e8\", lilyEye = \"e8c23a\", duckweed = \"7fb04a\",\n}\n\n-- ---------------------------------------------------------------- the water\n-- The pond's south shore at a stud x: the waterline's z for the bank's strip that x is in (each STRIP wide, from the core's west edge), from the backdrop's ellipse\n-- (World/Preserve.POND) at the strip's middle; nil where the ellipse does not reach. The boxes and the water's own question use the same line, so a bank's strip ends\n-- exactly where the water begins.\nfunction Pond.waterline(x: number): number?\n\tlocal K = Pond.CORE\n\tlocal mid = K.x0 + Pond.STRIP * math.floor((x - K.x0) / Pond.STRIP) + Pond.STRIP / 2\n\tlocal P = Preserve.POND\n\tlocal xm = mid / 100 + Preserve.ORIGIN_X_M\n\tlocal dx = (xm - P.x) / P.rx\n\tif math.abs(dx) >= 1 then return nil end\n\tlocal zm = P.z - P.rz * math.sqrt(1 - dx * dx)\n\treturn Preserve.NORTH_FACE_Z - (zm - Preserve.NORTH_FACE_M) * 100\nend\n-- The shore as the backdrop draws it (World/PreserveLook's lens, the ellipse itself) at a stud x: its z, or nil.\nfunction Pond.shore(x: number): number?\n\tlocal P = Preserve.POND\n\tlocal dx = (x / 100 + Preserve.ORIGIN_X_M - P.x) / P.rx\n\tif math.abs(dx) >= 1 then return nil end\n\treturn Preserve.NORTH_FACE_Z - (P.z - P.rz * math.sqrt(1 - dx * dx) - Preserve.NORTH_FACE_M) * 100\nend\n-- Whether a spider's body (its middle) at `p` is in the water: over the water's plan (north of the waterline, inside the pond's ellipse) and under its surface (a\n-- spider stands on the surface of nothing; on a pad or a stone its middle is over it).\nPond.SURFACE_TOL = 0.2\nfunction Pond.inWater(p: Vector3): boolean\n\tif p.Y >= WATER + Pond.SURFACE_TOL or p.Y < FLOOR then return false end\n\tlocal zw = Pond.waterline(p.X)\n\tif zw == nil or p.Z >= zw then return false end\n\tlocal P = Preserve.POND\n\tlocal xm, zm = Preserve.metres(p)\n\treturn ((xm - P.x) / P.rx) ^ 2 + ((zm - P.z) / P.rz) ^ 2 < 1\nend\n\n-- ---------------------------------------------------------------- the regions\nlocal function freeze(r: Region): Region\n\ttable.freeze(r.bounds)\n\tfor _, n in r.neighbors do table.freeze(n) end\n\ttable.freeze(r.neighbors)\n\tfor _, t in r.retreats do table.freeze(t) end\n\ttable.freeze(r.retreats)\n\ttable.freeze(r.spawn)\n\treturn table.freeze(r)\nend\n\ntype Seam = { a: string, b: string, p: Vector3, q: Vector3 }\nlocal SEAMS: { Seam } = {}\nlocal function seam(a: string, b: string, p: Vector3, q: Vector3)\n\ttable.insert(SEAMS, { a = a, b = b, p = p, q = q })\nend\n\n-- The boards across the deck, south (1) to north (10): each { z0, z1 }, 14 cm wide with a gap of a centimetre and a bit; in deck_s2 the third is narrower, so the gap\n-- between it and the fourth is BOARD.wide (a home).\nlocal BOARDS: { { number } } = {}\ndo\n\tlocal B = Pond.BOARD\n\tfor k = 1, B.count do\n\t\tlocal z1 = -816 - (k - 1) * (B.w + B.gap)\n\t\ttable.insert(BOARDS, { z1 - B.w, z1 })\n\tend\nend\nPond.BOARDS = BOARDS\nlocal GAP_REGION = \"deck_s2\"\nlocal function boardsOf(id: string, k: number): (number, number)\n\tlocal b = BOARDS[k]\n\tif id == GAP_REGION and k == 3 then return b[1] + (Pond.BOARD.wide - Pond.BOARD.gap), b[2] end\n\treturn b[1], b[2]\nend\n\n-- The terrain of a rectangle (the bank in strips stepping down to the water, the bed under the water): its land's pieces `{ x0, x1, z0, z1, top, band }` and whether\n-- any of it is water. Bands: \"bank\" (GROUND), \"damp\" (3 cm lower) and \"wet\" (a centimetre over the water).\nPond.BANDS = table.freeze({ { from = 30, top = GT, name = \"bank\" }, { from = 10, top = GT - 3, name = \"damp\" }, { from = 0, top = WATER + 1, name = \"wet\" } })\ntype Land = { x0: number, x1: number, z0: number, z1: number, top: number, band: string }\nlocal function terrain(x0: number, x1: number, z0: number, z1: number): ({ Land }, boolean)\n\tlocal out: { Land } = {}\n\tlocal wet = false\n\tlocal x = x0\n\twhile x < x1 - 1e-6 do\n\t\tlocal K = Pond.CORE\n\t\tlocal nextEdge = K.x0 + Pond.STRIP * (math.floor((x - K.x0) / Pond.STRIP + 1e-9) + 1)\n\t\tlocal xb = math.min(x1, nextEdge)\n\t\tlocal zw = Pond.waterline(x + 1e-3)\n\t\tlocal prevZ = z1\n\t\tfor _, band in Pond.BANDS do\n\t\t\tlocal zFrom = if zw == nil then -math.huge else zw + band.from -- (north edge of this band)\n\t\t\tlocal a, b = math.max(z0, zFrom), prevZ\n\t\t\tif b - a > 1e-6 then table.insert(out, { x0 = x, x1 = xb, z0 = a, z1 = b, top = band.top, band = band.name }) end\n\t\t\tprevZ = math.min(prevZ, math.max(z0, zFrom))\n\t\tend\n\t\tif prevZ > z0 + 1e-6 then wet = true end\n\t\tx = xb\n\tend\n\t-- (strips of the same bands side by side become one box)\n\tlocal merged: { Land } = {}\n\tfor _, l in out do\n\t\tlocal m: Land? = nil\n\t\tfor _, o in merged do\n\t\t\tif math.abs(o.x1 - l.x0) < 1e-6 and o.z0 == l.z0 and o.z1 == l.z1 and o.top == l.top then m = o end\n\t\tend\n\t\tif m ~= nil then (m :: Land).x1 = l.x1 else table.insert(merged, table.clone(l)) end\n\tend\n\t-- (and none longer than 40 studs or deeper than 50, so a box's middle is never far from where a spider steps onto it: World/LookPlan's streaming)\n\tlocal chunks: { Land } = {}\n\tfor _, l in merged do\n\t\tlocal nx, nz = math.ceil((l.x1 - l.x0) / 40 - 1e-6), math.ceil((l.z1 - l.z0) / 50 - 1e-6)\n\t\tfor i = 1, nx do\n\t\t\tfor j = 1, nz do\n\t\t\t\ttable.insert(chunks, { x0 = l.x0 + (l.x1 - l.x0) * (i - 1) / nx, x1 = l.x0 + (l.x1 - l.x0) * i / nx, z0 = l.z0 + (l.z1 - l.z0) * (j - 1) / nz,\n\t\t\t\t\tz1 = l.z0 + (l.z1 - l.z0) * j / nz, top = l.top, band = l.band })\n\t\t\tend\n\t\tend\n\tend\n\treturn chunks, wet\nend\nPond.terrain = terrain\n-- The top of the ground (or the bed) at a point of the core.\nlocal function groundAt(x: number, z: number): number\n\tlocal lands = terrain(x - 0.01, x + 0.01, z - 0.01, z + 0.01)\n\treturn if #lands > 0 then lands[1].top else BED\nend\nPond.groundAt = groundAt\n\n-- ---------------------------------------------------------------- the margin's plan\n-- Each cell's things, from its plan and its seed: `stones` (in the water by the waterline, or on the bank), `sedge` and `rush` clumps, lily `pads` and a `flower`,\n-- a cattail `stand` (its number), and the homes. Offsets east of the cell's west edge (dx) and north of its south edge (dz).\ntype CellPlan = { sedge: { { number } }?, rush: { { number } }?, stones: { { number } }?, pads: { { number } }?, flower: { number }?, stand: number?, leaf: { number }?,\n\tshelter: { number }?, flat: { number }? }\nlocal PLAN: { [string]: CellPlan } = {\n\ta1 = { leaf = { 38, 34 }, sedge = { { 72, 64 } }, rush = { { 18, 78 } }, stones = { { 88, 0 } } },\n\ta2 = { shelter = { 30, 15 }, sedge = { { 70, 8 } }, rush = { { 58, 0 } }, flat = { 14, 0 }, stones = { { 88, 0 } } },\n\ta3 = { stand = 1, stones = { { 15, 0 } }, pads = { { 78, 62, 18 } } },\n\ta4 = { pads = { { 30, 40, 22 }, { 74, 74, 16 } }, rush = { { 82, 20 } } },\n\tb1 = { sedge = { { 12, 15 } }, rush = { { 62, 30 } }, stones = { { 82, 14 } } },\n\tb2 = { stand = 2, pads = { { 80, 80, 17 } } },\n\tb3 = { pads = { { 25, 30, 24 }, { 70, 62, 20 }, { 34, 82, 15 } }, flower = { 52, 46 } },\n\tb4 = { pads = { { 40, 46, 27 }, { 80, 16, 17 } } },\n\tc1 = { rush = { { 30, 22 } }, pads = { { 70, 26, 18 } } },\n\tc2 = { pads = { { 28, 24, 21 }, { 72, 30, 16 } } },\n\tc3 = { pads = { { 50, 25, 15 } } },\n\tc4 = { pads = { { 34, 22, 19 }, { 76, 30, 23 } } },\n}\nPond.PLAN = PLAN\n-- The cattail stands: each three shoots of leaves in a fan and one flowering stalk with its brown spike, in the shallow water (centres, studs).\nPond.STANDS = table.freeze({\n\ttable.freeze({ cell = \"a3\", x = 775, z = -1027 }),\n\ttable.freeze({ cell = \"b2\", x = 672, z = -1117 }),\n})\n-- True sizes (studs = cm). Common cattail (Typha latifolia): leaves flat, 1 to 2 cm wide (1.5 here), 1.5 to 2.5 m tall; the brown female spike 15 to 20 cm long on its\n-- stalk, the thin male spike above it. Sedge and soft rush: 45 to 75 cm.\nPond.CATTAIL = table.freeze({ leafW = 1.5, leafT = 0.35, leafGap = 1, leaves = table.freeze({ 150, 172, 196, 214, 186, 160, 205, 178, 220 }), stalk = 0.8, spike = table.freeze({ w = 2.6, from = 150, to = 168 }),\n\tmale = table.freeze({ w = 0.6, to = 182 }), shoots = table.freeze({ { 0, 0, \"x\" } :: { any }, { 6.5, 3.5, \"z\" }, { -4.5, 6, \"x\" } }) :: any }) :: any\nPond.SEDGE = table.freeze({ at = table.freeze({ { 0, 0 }, { 2.2, 1 }, { -1.6, 1.8 }, { 1, -2.2 }, { -2, -1.2 } }), h = table.freeze({ 62, 55, 48, 58, 44 }), half = 0.25 })\nPond.RUSH = table.freeze({ at = table.freeze({ { 0, 0 }, { 1.4, 0.6 }, { -1.1, 1.2 }, { 0.7, -1.5 }, { -1.4, -0.9 }, { 2, -1 }, { -0.4, 2.4 } }),\n\th = table.freeze({ 74, 66, 70, 61, 68, 58, 64 }), half = 0.13 })\nPond.LEAF = table.freeze({ l = 20, w = 2.6, rest = 1.4, gap = 1.4, thick = 0.5 }) -- the dead cattail leaf, broad at its base, lying curled on two old stems\nPond.SHELTER = table.freeze({ l = 11, w = 9, rest = 2, gap = 1.4, thick = 2.2 }) -- the flat stone on two others\nPond.FLAT = table.freeze({ l = 16, w = 11, top = 4.5 }) -- the flat stone at the water's edge (the frog's seat)\n\nlocal ROWS = { \"a\", \"b\", \"c\" }\nlocal function cellBox(r: number, c: number): (number, number, number, number)\n\tlocal X = Pond.CORE_X\n\tlocal Z = Pond.ROW_Z[ROWS[r]]\n\treturn X[c], X[c + 1], Z[1], Z[2]\nend\nPond.cellBox = cellBox\n\n-- The point of a cell's plan entry: (dx, dz), or with dz 0 the place just in the water off the waterline at dx (a stone's middle `half` north of it).\nlocal function planPoint(x0: number, z1: number, e: { number }, half: number): (number, number)\n\tlocal x = x0 + e[1]\n\tif e[2] == 0 then\n\t\tlocal zw = Pond.waterline(x) or z1\n\t\treturn x, math.min(zw - half - 1.5, z1 - half - 1)\n\tend\n\treturn x, z1 - e[2]\nend\n\nlocal RETREATS: { [string]: { id: string, min: Vector3, max: Vector3, door: Vector3 } } = {}\ndo\n\t-- between the boards in deck_s2: the wide gap between its third and fourth\n\tlocal x0, x1 = Pond.CORE_X[2], Pond.CORE_X[3]\n\tlocal za, zb = BOARDS[4][2], BOARDS[3][1] + (Pond.BOARD.wide - Pond.BOARD.gap)\n\tRETREATS.deck_s2 = { id = \"deck_gap\", min = v(x0 + 12, DECK - Pond.BOARD.thick, za), max = v(x1 - 12, DECK, zb), door = v((x0 + x1) / 2, DECK + 0.5, (za + zb) / 2) }\n\t-- under the curled leaf in pond_a1\n\tlocal cx0, _, _, cz1 = cellBox(1, 1)\n\tlocal L = Pond.LEAF\n\tlocal leafAt = PLAN.a1.leaf :: { number }\n\tlocal lx, lz = cx0 + leafAt[1], cz1 - leafAt[2]\n\tRETREATS.pond_a1 = { id = \"cattail_leaf\", min = v(lx - L.l / 2 + L.rest, GT, lz - L.w / 2 + 0.3), max = v(lx + L.l / 2 - L.rest, GT + L.gap, lz + L.w / 2 - 0.3),\n\t\tdoor = v(lx, GT + 0.5, lz + L.w / 2 + 3) }\n\t-- under the flat stone on the damp mud in pond_a2\n\tlocal sx0, _, _, sz1 = cellBox(1, 2)\n\tlocal S = Pond.SHELTER\n\tlocal shelterAt = PLAN.a2.shelter :: { number }\n\tlocal hx, hz = sx0 + shelterAt[1], sz1 - shelterAt[2]\n\tlocal top = groundAt(hx, hz)\n\tRETREATS.pond_a2 = { id = \"pond_stone\", min = v(hx - S.l / 2 + S.rest, top, hz - S.w / 2 + 1), max = v(hx + S.l / 2 - S.rest, top + S.gap, hz + S.w / 2 - 1),\n\t\tdoor = v(hx, top + 0.5, hz + S.w / 2 + 3) }\nend\nPond.RETREATS = RETREATS\n\n-- The authored regions, for a world seed (`seedOf`: World/WorldMap.seed), in priority order (after the meadow's: World/WorldMap.authorPreserve).\nfunction Pond.author(worldSeed: number, seedOf: (number, string) -> number): { Region }\n\tlocal list: { Region } = {}\n\tlocal byId: { [string]: Region } = {}\n\tlocal function region(id: string, kind: string, lo: Vector3, hi: Vector3, spawn: Vector3, heading: Vector3)\n\t\tlocal t = RETREATS[id]\n\t\tlocal r = {\n\t\t\tid = id, kind = kind, origin = v((lo.X + hi.X) / 2, GT, (lo.Z + hi.Z) / 2), bounds = { lo, hi }, seed = seedOf(worldSeed, id), neighbors = {},\n\t\t\tretreats = if t ~= nil then { table.clone(t) } else {}, spawn = { pos = spawn, heading = heading }, clockScale = 0.33,\n\t\t}\n\t\ttable.insert(list, r :: any)\n\t\tbyId[id] = r :: any\n\tend\n\t-- the cattails' upper regions first (their bounds stand over the cells')\n\tfor k, st in Pond.STANDS do\n\t\tlocal T = Pond.CATTAIL\n\t\tlocal face = v(st.x + T.leafW + T.leafGap, 0, st.z + T.leafT / 2)\n\t\tregion(`cattail_{k}a`, \"cattail\", v(st.x - 30, CUT1, st.z - 30), v(st.x + 30, CUT2, st.z + 30), v(face.X, (CUT1 + CUT2) / 2, face.Z), v(0, 1, 0))\n\t\tregion(`cattail_{k}b`, \"cattail\", v(st.x - 30, CUT2, st.z - 30), v(st.x + 30, WATER + 240, st.z + 30), v(face.X, CUT2 + 20, face.Z), v(0, 1, 0))\n\tend\n\t-- the boardwalk: the corridor's and the core's, the south row and the north\n\tlocal function deck(prefix: string, xs: { number })\n\t\tfor c = 1, #xs - 1 do\n\t\t\tfor _, row in { \"s\", \"n\" } do\n\t\t\t\tlocal Z = Pond.DECK_Z[row]\n\t\t\t\tlocal x0, x1 = xs[c], xs[c + 1]\n\t\t\t\tlocal k = if row == \"s\" then 2 else 9\n\t\t\t\tlocal b = BOARDS[k]\n\t\t\t\tregion(`{prefix}_{row}{c}`, \"boardwalk\", v(x0, FLOOR, Z[1]), v(x1, DECK + 20, Z[2]), v((x0 + x1) / 2, DECK, (b[1] + b[2]) / 2), v(1, 0, 0))\n\t\t\tend\n\t\tend\n\tend\n\tdeck(\"walk\", Pond.WALK_X)\n\tdeck(\"deck\", Pond.CORE_X)\n\t-- the margin's cells\n\tfor r = 1, 3 do\n\t\tfor c = 1, 4 do\n\t\t\tlocal x0, x1, z0, z1 = cellBox(r, c)\n\t\t\tlocal id = `pond_{ROWS[r]}{c}`\n\t\t\tregion(id, \"pond\", v(x0, FLOOR, z0), v(x1, CUT1, z1), Pond.spawnOf(id, x0, x1, z0, z1), v(0, 0, -1))\n\t\tend\n\tend\n\t-- the mown path\n\tlocal E, N = Pond.PATH_E, Pond.PATH_N\n\tfor k = 1, E.n do\n\t\tlocal x0 = E.x0 + (k - 1) * 100\n\t\tregion(`mown_e{k}`, \"mown_path\", v(x0, -88, E.z0), v(x0 + 100, GT + 40, E.z1), v(x0 + 50, GT, (E.z0 + E.z1) / 2), v(1, 0, 0))\n\tend\n\tfor k = 1, N.n do\n\t\tlocal z1 = N.z1 - (k - 1) * 100\n\t\tlocal z0 = if k == N.n then N.z0 else z1 - 100\n\t\tregion(`mown_n{k}`, \"mown_path\", v(N.x0, -88, z0), v(N.x1, GT + 40, z1), v((N.x0 + N.x1) / 2, GT, (z0 + z1) / 2), v(0, 0, -1))\n\tend\n\t-- (a seam with World/Meadow's pad_b3 is listed on this side only: Meadow lists it on its own)\n\tfor _, s in SEAMS do\n\t\tlocal a, b = byId[s.a], byId[s.b]\n\t\tif a ~= nil then table.insert(a.neighbors, { id = s.b, a = s.p, b = s.q }) end\n\t\tif b ~= nil then table.insert(b.neighbors, { id = s.a, a = s.p, b = s.q }) end\n\tend\n\tfor _, r in list do freeze(r) end\n\treturn list\nend\n\n-- The seam that meets World/Meadow's regions (the bench patch's east edge): World/Meadow lists it on pad_b3's side.\nPond.MEADOW_SEAMS = table.freeze({\n\ttable.freeze({ meadow = \"pad_b3\", id = \"mown_e1\", a = v(90, GT, -711), b = v(90, GT, -635) }),\n})\nfor _, s in Pond.MEADOW_SEAMS do seam(s.meadow, s.id, s.a, s.b) end\n\ndo\n\t-- the mown path, cell to cell, flat on the lawn\n\tlocal E, N = Pond.PATH_E, Pond.PATH_N\n\tfor k = 1, E.n - 1 do\n\t\tlocal x = E.x0 + k * 100\n\t\tseam(`mown_e{k}`, `mown_e{k + 1}`, v(x, GT, E.z0 + 8), v(x, GT, E.z1 - 8))\n\tend\n\t-- (the east leg's last cell is the corner: the north leg leaves its north edge)\n\tseam(`mown_e{E.n}`, \"mown_n1\", v(N.x0 + 8, GT, E.z0), v(N.x1 - 8, GT, E.z0))\n\tfor k = 1, N.n - 1 do\n\t\tlocal z = N.z1 - k * 100\n\t\tseam(`mown_n{k}`, `mown_n{k + 1}`, v(N.x0 + 8, GT, z), v(N.x1 - 8, GT, z))\n\tend\n\t-- up the boardwalk's south fascia: its foot on the lawn\n\tseam(`mown_n{N.n}`, \"walk_s1\", v(N.x0 + 8, GT, N.z0), v(Pond.WALK_X[2] - 8, GT, N.z0))\n\t-- the boardwalk, region to region along its boards (on the deck's top), and its two rows across the gap between the fifth and sixth boards (the boards' ends)\n\tlocal function deckSeams(prefix: string, xs: { number })\n\t\tfor c = 1, #xs - 1 do\n\t\t\tlocal x1 = xs[c + 1]\n\t\t\tif c < #xs - 1 then\n\t\t\t\tseam(`{prefix}_s{c}`, `{prefix}_s{c + 1}`, v(x1, DECK, BOARDS[2][1] + 1), v(x1, DECK, BOARDS[2][2] - 1))\n\t\t\t\tseam(`{prefix}_n{c}`, `{prefix}_n{c + 1}`, v(x1, DECK, BOARDS[9][1] + 1), v(x1, DECK, BOARDS[9][2] - 1))\n\t\t\tend\n\t\tend\n\tend\n\tdeckSeams(\"walk\", Pond.WALK_X)\n\tdeckSeams(\"deck\", Pond.CORE_X)\n\tseam(\"walk_s4\", \"deck_s1\", v(525, DECK, BOARDS[2][1] + 1), v(525, DECK, BOARDS[2][2] - 1))\n\tseam(\"walk_n4\", \"deck_n1\", v(525, DECK, BOARDS[9][1] + 1), v(525, DECK, BOARDS[9][2] - 1))\n\t-- under the boardwalk across its two rows, and off its north edge to the margin's ground, and the margin's cells to one another: flat across the ground (the\n\t-- bank's strips or the bed under the water) along the longest stretch of their shared edge where both sides' ground is at one height\n\tlocal function across(a: string, b: string, alongX: boolean, at: number, s0: number, s1: number)\n\t\tlocal bestY, bestA, bestB = 0, 0, -1\n\t\tlocal runY, runA = nil :: number?, 0\n\t\tlocal s = s0\n\t\twhile s <= s1 + 1e-6 do\n\t\t\tlocal ya = if alongX then groundAt(s, at + 0.5) else groundAt(at - 0.5, s)\n\t\t\tlocal yb = if alongX then groundAt(s, at - 0.5) else groundAt(at + 0.5, s)\n\t\t\tlocal y: number? = if math.abs(ya - yb) < 1e-6 then ya else nil\n\t\t\tif y ~= nil and runY ~= nil and math.abs(y - (runY :: number)) < 1e-6 then\n\t\t\t\tif s - runA > bestB - bestA then bestY, bestA, bestB = y, runA, s end\n\t\t\telseif y ~= nil then\n\t\t\t\trunY, runA = y, s\n\t\t\telse\n\t\t\t\trunY = nil\n\t\t\tend\n\t\t\ts += 1\n\t\tend\n\t\tassert(bestB - bestA >= 6, `no stretch of shared ground between {a} and {b}`)\n\t\t-- (at most 40 studs of it, its middle: what the spider steps onto is then within the radius always sent from anywhere along it)\n\t\tif bestB - bestA > 40 then\n\t\t\tlocal m = (bestA + bestB) / 2\n\t\t\tbestA, bestB = m - 20, m + 20\n\t\tend\n\t\tif alongX then seam(a, b, v(bestA + 1, bestY, at), v(bestB - 1, bestY, at))\n\t\telse seam(a, b, v(at, bestY, bestA + 1), v(at, bestY, bestB - 1)) end\n\tend\n\tPond.across = across\n\tfor _, prefix in { \"walk\", \"deck\" } do\n\t\tlocal xs: { number } = if prefix == \"walk\" then Pond.WALK_X else Pond.CORE_X\n\t\tfor c = 1, #xs - 1 do\n\t\t\tacross(`{prefix}_s{c}`, `{prefix}_n{c}`, true, -891, xs[c] + 4, xs[c + 1] - 4)\n\t\tend\n\tend\n\tfor c = 1, 4 do\n\t\tacross(`deck_n{c}`, `pond_a{c}`, true, -966, Pond.CORE_X[c] + 16, Pond.CORE_X[c + 1] - 4)\n\tend\n\tfor r = 1, 3 do\n\t\tfor c = 1, 4 do\n\t\t\tlocal x0, x1, z0, z1 = cellBox(r, c)\n\t\t\tlocal here = `pond_{ROWS[r]}{c}`\n\t\t\tif c < 4 then across(here, `pond_{ROWS[r]}{c + 1}`, false, x1, z0 + 4, z1 - 4) end\n\t\t\tif r < 3 then across(here, `pond_{ROWS[r + 1]}{c}`, true, z0, x0 + 4, x1 - 4) end\n\t\tend\n\tend\n\t-- the cattails' upper regions: up the first shoot's middle leaf, across its face\n\tfor k, st in Pond.STANDS do\n\t\tlocal cell = `pond_{st.cell}`\n\t\tlocal T = Pond.CATTAIL\n\t\tlocal mid = st.x + (T.leafW + T.leafGap)\n\t\tlocal fz = st.z + T.leafT / 2\n\t\tseam(cell, `cattail_{k}a`, v(mid - T.leafW / 2, CUT1, fz), v(mid + T.leafW / 2, CUT1, fz))\n\t\tseam(`cattail_{k}a`, `cattail_{k}b`, v(mid - T.leafW / 2, CUT2, fz), v(mid + T.leafW / 2, CUT2, fz))\n\tend\nend\n\n-- ---------------------------------------------------------------- the pieces\nlocal function P(out: { Piece }, id: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, profile: string, color: string, material: string?)\n\ttable.insert(out, { id = id, lo = v(x0, y0, z0), hi = v(x1, y1, z1), profile = profile, color = hex(color), material = material })\nend\n\n-- The terrain's boxes of a rectangle: the bed under any water and each land strip from the bed (or the corridor's floor) to its top.\nlocal function terrainPieces(out: { Piece }, id: string, x0: number, x1: number, z0: number, z1: number)\n\tlocal lands, wet = terrain(x0, x1, z0, z1)\n\tlocal base = if wet then BED else -100\n\tif wet then P(out, id .. \"_bed\", x0, x1, FLOOR, BED, z0, z1, \"brick_rough\", C.bed, \"Mud\") end\n\tfor i, l in lands do\n\t\tlocal color = if l.band == \"bank\" then C.mud elseif l.band == \"damp\" then C.mudDark else C.mudWet\n\t\tP(out, `{id}_{l.band}_{i}`, l.x0, l.x1, base, l.top, l.z0, l.z1, \"brick_rough\", color, if l.band == \"bank\" then \"Ground\" else \"Mud\")\n\tend\nend\n\n-- A cattail stand's boxes whole (before they are cut into its regions): three shoots of three leaves in a fan, the flowering stalk, its spike and the male spike.\nlocal function standPieces(k: number): { Piece }\n\tlocal st = Pond.STANDS[k]\n\tlocal T = Pond.CATTAIL\n\tlocal out: { Piece } = {}\n\tlocal n = 0\n\tfor s, sh in T.shoots do\n\t\tlocal cx, cz = st.x + sh[1], st.z + sh[2]\n\t\tfor i = -1, 1 do\n\t\t\tn += 1\n\t\t\tlocal h = T.leaves[n]\n\t\t\tlocal off = i * (T.leafW + T.leafGap)\n\t\t\tlocal name = `cattail_{k}_leaf_{s}_{i + 2}`\n\t\t\tif sh[3] == \"x\" then P(out, name, cx + off - T.leafW / 2, cx + off + T.leafW / 2, BED, WATER + h, cz - T.leafT / 2, cz + T.leafT / 2, \"leaf_dry_prototype\", C.cattailLeaf[1 + n % 4])\n\t\t\telse P(out, name, cx - T.leafT / 2, cx + T.leafT / 2, BED, WATER + h, cz + off - T.leafW / 2, cz + off + T.leafW / 2, \"leaf_dry_prototype\", C.cattailLeaf[1 + n % 4]) end\n\t\tend\n\tend\n\t-- the flowering stalk, a little apart, its spike and the male spike over it\n\tlocal sx, sz = st.x - 3, st.z - 4.5\n\tP(out, `cattail_{k}_stalk`, sx - T.stalk / 2, sx + T.stalk / 2, BED, WATER + T.spike.from, sz - T.stalk / 2, sz + T.stalk / 2, \"leaf_dry_prototype\", \"6a7a48\")\n\tP(out, `cattail_{k}_spike`, sx - T.spike.w / 2, sx + T.spike.w / 2, WATER + T.spike.from, WATER + T.spike.to, sz - T.spike.w / 2, sz + T.spike.w / 2, \"leaf_dry_prototype\", C.spike)\n\tP(out, `cattail_{k}_male`, sx - T.male.w / 2, sx + T.male.w / 2, WATER + T.spike.to, WATER + T.male.to, sz - T.male.w / 2, sz + T.male.w / 2, \"leaf_dry_prototype\", C.spikeMale)\n\treturn out\nend\n-- The part of a stand's boxes between two heights (its cell's below CUT1, its regions' above), each cut piece keeping its id with the part's suffix.\nlocal function cutStand(out: { Piece }, k: number, y0: number, y1: number, tag: string)\n\tfor _, p in standPieces(k) do\n\t\tlocal a, b = math.max(p.lo.Y, y0), math.min(p.hi.Y, y1)\n\t\tif b - a > 1e-6 then\n\t\t\ttable.insert(out, { id = p.id .. tag, lo = v(p.lo.X, a, p.lo.Z), hi = v(p.hi.X, b, p.hi.Z), profile = p.profile, color = p.color, material = p.material })\n\t\tend\n\tend\nend\nPond.standPieces = standPieces\n\n-- A clump of culms (sedge or rush) from its base at `y0`, ids `<base>_culm_<i>`, and its heads.\nlocal function clumpPieces(out: { Piece }, base: string, kind: string, x: number, z: number, y0: number, rand: () -> number)\n\tlocal S: any = if kind == \"sedge\" then Pond.SEDGE else Pond.RUSH\n\tfor i, o in S.at :: { { number } } do\n\t\tlocal cx, cz = x + o[1], z + o[2]\n\t\tlocal top = y0 + S.h[i] * between(rand, 0.93, 1)\n\t\tif kind == \"rush\" then top = math.min(top, CUT1 - 1) end\n\t\tP(out, `{base}_culm_{i}`, cx - S.half, cx + S.half, y0, top, cz - S.half, cz + S.half, \"leaf_dry_prototype\", pick(if kind == \"sedge\" then C.sedge else C.rush, rand))\n\t\tif kind == \"sedge\" and (i == 1 or i == 4) then\n\t\t\tP(out, `{base}_head_{i}`, cx - 0.6, cx + 0.6, top, top + 4, cz - 0.6, cz + 0.6, \"leaf_dry_prototype\", C.sedgeHead)\n\t\telseif kind == \"rush\" and (i == 2 or i == 5) then\n\t\t\t-- the soft rush's flower cluster, out from the stem's side a little under its tip\n\t\t\tP(out, `{base}_head_{i}`, cx + S.half, cx + S.half + 1.2, top - 14, top - 11, cz - 0.6, cz + 0.6, \"leaf_dry_prototype\", C.rushHead)\n\t\tend\n\tend\nend\n\n-- A lily pad: three boxes across its round (a middle band and its two caps), floating; the drawn pad covers them (Pond.drawnPieces).\nlocal function padPieces(out: { Piece }, base: string, x: number, z: number, d: number)\n\tlocal y0, y1 = WATER - 0.1, WATER + 0.3\n\tP(out, base .. \"_mid\", x - 0.47 * d, x + 0.47 * d, y0, y1, z - 0.27 * d, z + 0.27 * d, \"leaf_dry_prototype\", C.pad[1])\n\tP(out, base .. \"_n\", x - 0.36 * d, x + 0.36 * d, y0, y1, z - 0.44 * d, z - 0.27 * d, \"leaf_dry_prototype\", C.pad[1])\n\tP(out, base .. \"_s\", x - 0.36 * d, x + 0.36 * d, y0, y1, z + 0.27 * d, z + 0.44 * d, \"leaf_dry_prototype\", C.pad[1])\nend\n\n-- The base of a plant at a point: the bank's top, or the bed in the water.\nlocal function baseAt(x: number, z: number): number\n\treturn groundAt(x, z)\nend\n\nlocal function pondPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal id = region.id\n\tlocal key = string.sub(id, 6)\n\tlocal plan = PLAN[key]\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal x0, x1, z0, z1 = lo.X, hi.X, lo.Z, hi.Z\n\tlocal rand = rng(region.seed, 5)\n\tterrainPieces(out, id, x0, x1, z0, z1)\n\tfor i, s in (plan.stones or {}) :: { { number } } do\n\t\tlocal size = between(rand, 6, 10)\n\t\tlocal x, z = planPoint(x0, z1, s, size / 2)\n\t\tlocal top = WATER + between(rand, 2.5, 4.5)\n\t\tP(out, `{id}_stone_{i}`, x - size / 2, x + size / 2, BED, top, z - size * 0.35, z + size * 0.35, \"brick_rough\", pick(C.stone, rand), \"Slate\")\n\tend\n\tif plan.flat ~= nil then\n\t\tlocal F = Pond.FLAT\n\t\tlocal x, z = planPoint(x0, z1, plan.flat, F.w / 2)\n\t\tx = x + F.l / 2\n\t\tP(out, id .. \"_flat\", x - F.l / 2, x + F.l / 2, BED, WATER + F.top, z - F.w / 2, z + F.w / 2, \"brick_rough\", C.stone[2], \"Slate\")\n\tend\n\tif plan.shelter ~= nil then\n\t\tlocal S = Pond.SHELTER\n\t\tlocal hx, hz = x0 + plan.shelter[1], z1 - plan.shelter[2]\n\t\tlocal top = groundAt(hx, hz)\n\t\tP(out, id .. \"_rest_w\", hx - S.l / 2, hx - S.l / 2 + S.rest, top, top + S.gap, hz - S.w / 2, hz + S.w / 2, \"brick_rough\", C.stone[3], \"Slate\")\n\t\tP(out, id .. \"_rest_e\", hx + S.l / 2 - S.rest, hx + S.l / 2, top, top + S.gap, hz - S.w / 2, hz + S.w / 2, \"brick_rough\", C.stone[3], \"Slate\")\n\t\tP(out, id .. \"_slab\", hx - S.l / 2, hx + S.l / 2, top + S.gap, top + S.gap + S.thick, hz - S.w / 2, hz + S.w / 2, \"brick_rough\", C.stone[1], \"Slate\")\n\tend\n\tif plan.leaf ~= nil then\n\t\tlocal L = Pond.LEAF\n\t\tlocal lx, lz = x0 + plan.leaf[1], z1 - plan.leaf[2]\n\t\tP(out, id .. \"_old_w\", lx - L.l / 2, lx - L.l / 2 + L.rest, GT, GT + L.gap, lz - L.w / 2, lz + L.w / 2, \"leaf_dry_prototype\", C.cattailDead)\n\t\tP(out, id .. \"_old_e\", lx + L.l / 2 - L.rest, lx + L.l / 2, GT, GT + L.gap, lz - L.w / 2, lz + L.w / 2, \"leaf_dry_prototype\", \"8a7448\")\n\t\tP(out, id .. \"_leaf\", lx - L.l / 2, lx + L.l / 2, GT + L.gap, GT + L.gap + L.thick, lz - L.w / 2, lz + L.w / 2, \"leaf_dry_prototype\", C.cattailDead)\n\tend\n\tfor i, e in (plan.sedge or {}) :: { { number } } do\n\t\tlocal x, z = x0 + e[1], z1 - e[2]\n\t\tclumpPieces(out, `{id}_sedge{i}`, \"sedge\", x, z, baseAt(x, z), rand)\n\tend\n\tfor i, e in (plan.rush or {}) :: { { number } } do\n\t\tlocal x, z = planPoint(x0, z1, e, 3)\n\t\tclumpPieces(out, `{id}_rush{i}`, \"rush\", x, z, baseAt(x, z), rand)\n\tend\n\tfor i, e in (plan.pads or {}) :: { { number } } do padPieces(out, `{id}_pad_{i}`, x0 + e[1], z1 - e[2], e[3]) end\n\tif plan.flower ~= nil then\n\t\tlocal fx, fz = x0 + plan.flower[1], z1 - plan.flower[2]\n\t\tP(out, id .. \"_lily\", fx - 3, fx + 3, WATER - 0.2, WATER + 3.5, fz - 3, fz + 3, \"leaf_dry_prototype\", C.lily)\n\tend\n\tif plan.stand ~= nil then cutStand(out, plan.stand, -math.huge, CUT1, \"\") end\n\treturn out\nend\n\n-- Where a life (or a rest from another revision) is put back in a cell: on its bank if it has one, else on its first pad.\nfunction Pond.spawnOf(id: string, x0: number, x1: number, z0: number, z1: number): Vector3\n\tlocal lands = terrain(x0, x1, z0, z1)\n\tlocal best: Land? = nil\n\tfor _, l in lands do if l.band == \"bank\" and (best == nil or (l.x1 - l.x0) * (l.z1 - l.z0) > ((best :: Land).x1 - (best :: Land).x0) * ((best :: Land).z1 - (best :: Land).z0)) then best = l end end\n\tif best == nil then for _, l in lands do if (l.x1 - l.x0) >= 10 and (l.z1 - l.z0) >= 6 then best = l end end end\n\tif best ~= nil then\n\t\tlocal b = best :: Land\n\t\tlocal x, z = (b.x0 + b.x1) / 2, (b.z0 + b.z1) / 2\n\t\tlocal plan = PLAN[string.sub(id, 6)]\n\t\t-- (clear of what stands there: the curled leaf, the stone shelter, the clumps)\n\t\tfor _, e in { plan.leaf, plan.shelter } do\n\t\t\tif e ~= nil and math.abs(x - (x0 + e[1])) < 14 and math.abs(z - (z1 - e[2])) < 14 then x = if e[1] > 50 then x0 + 15 else x1 - 15 end\n\t\tend\n\t\tfor _, e in (plan.sedge or {}) :: { { number } } do\n\t\t\tif math.abs(x - (x0 + e[1])) < 6 and math.abs(z - (z1 - e[2])) < 6 then x += 10 end\n\t\tend\n\t\treturn v(x, b.top, z)\n\tend\n\tlocal pads = PLAN[string.sub(id, 6)].pads\n\tlocal p = (pads :: { { number } })[1]\n\treturn v(x0 + p[1], WATER + 0.3, z1 - p[2])\nend\n\n-- The boardwalk's boxes in a region: its boards (cut at the region's ends), the fascia or the north beam, the middle beam's half, a post, the kerb rail on its blocks,\n-- and the ground under it.\nlocal function deckPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal id = region.id\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal x0, x1, z0, z1 = lo.X, hi.X, lo.Z, hi.Z\n\tlocal south = string.sub(id, 6, 6) == \"s\"\n\tlocal B = Pond.BOARD\n\tlocal rand = rng(region.seed, 7)\n\tlocal first, last = if south then 1 else 6, if south then 5 else 10\n\tfor k = first, last do\n\t\tlocal a, b = boardsOf(id, k)\n\t\tP(out, `{id}_board_{k}`, x0, x1, DECK - B.thick, DECK, a, b, \"bare_wood_rough\", pick({ C.board, C.boardDark, C.boardGrey, \"7f6b52\" }, rand), \"WoodPlanks\")\n\tend\n\tlocal under = DECK - B.thick\n\tif south then\n\t\t-- the fascia board on the south face, from the lawn to under the boards\n\t\tP(out, id .. \"_fascia\", x0, x1, GT, under, z1 - 3, z1, \"bare_wood_rough\", C.boardDark, \"Wood\")\n\t\tP(out, id .. \"_beam\", x0, x1, under - 15, under, -891, -888, \"bare_wood_rough\", C.post, \"Wood\")\n\telse\n\t\tP(out, id .. \"_beam\", x0, x1, under - 15, under, z0, z0 + 5, \"bare_wood_rough\", C.post, \"Wood\")\n\t\tP(out, id .. \"_beam_mid\", x0, x1, under - 15, under, -894, -891, \"bare_wood_rough\", C.post, \"Wood\")\n\t\tlocal px = x0 + 8\n\t\tlocal foot = -math.huge\n\t\tfor _, l in (terrain(px - 5, px + 5, z0, z0 + 10)) do foot = math.max(foot, l.top) end\n\t\tif foot == -math.huge then foot = BED end\n\t\tP(out, id .. \"_post\", px - 5, px + 5, foot, under - 15, z0, z0 + 10, \"bare_wood_rough\", C.post, \"Wood\")\n\tend\n\t-- the kerb rail along the edge on its spacer blocks: a gap of 2 cm under it between the blocks\n\tlocal kz0, kz1 = if south then z1 - 8 else z0, if south then z1 else z0 + 8\n\tP(out, id .. \"_kerb\", x0, x1, DECK + 2, DECK + 10, kz0, kz1, \"bare_wood_rough\", C.boardDark, \"Wood\")\n\tlocal w = x1 - x0\n\tfor i, f in { 0.2, 0.7 } do\n\t\tlocal bx = x0 + f * w\n\t\tP(out, `{id}_block_{i}`, bx - 3, bx + 3, DECK, DECK + 2, kz0, kz1, \"bare_wood_rough\", C.post, \"Wood\")\n\tend\n\t-- the ground under it (fascia's foot to the north edge), clear of the post\n\tterrainPieces(out, id, x0, x1, z0, if south then z1 - 3 else z1)\n\tif not south then\n\t\t-- (the post stands on the ground: the terrain's boxes are cut round its footprint by lowering nothing; the post's foot is the ground's top there)\n\tend\n\treturn out\nend\n\n-- The mown path's cell: its lawn, cut short.\nlocal function pathPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tP(out, region.id .. \"_lawn\", lo.X, hi.X, -87, GT, lo.Z, hi.Z, \"brick_rough\", C.mown[1], \"Grass\")\n\treturn out\nend\n\nlocal function cattailPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal k = tonumber(string.sub(region.id, 9, 9)) :: number\n\tlocal upper = string.sub(region.id, 10, 10) == \"b\"\n\tif upper then cutStand(out, k, CUT2, math.huge, \"_b\") else cutStand(out, k, CUT1, CUT2, \"_a\") end\n\treturn out\nend\n\nlocal KINDS: { [string]: boolean } = { mown_path = true, boardwalk = true, pond = true, cattail = true }\n-- Whether a kind is the pond's or its corridor's.\nfunction Pond.knows(kind: string): boolean\n\treturn KINDS[kind] == true\nend\n\nlocal piecesCache: { [string]: { Piece } } = {}\nfunction Pond.pieces(region: Region): { Piece }\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = piecesCache[key]\n\tif cached ~= nil then return cached end\n\tlocal k, out = region.kind, nil :: { Piece }?\n\tif k == \"mown_path\" then out = pathPieces(region)\n\telseif k == \"boardwalk\" then out = deckPieces(region)\n\telseif k == \"pond\" then out = pondPieces(region)\n\telseif k == \"cattail\" then out = cattailPieces(region)\n\telse error(\"no generator for the region kind \" .. k) end\n\tlocal list = out :: { Piece }\n\tfor _, p in list do table.freeze(p) end\n\tpiecesCache[key] = table.freeze(list)\n\treturn list\nend\n\n-- The lily pads' boxes are drawn as round pads over them (the decor's), and the water lily's box as its flower, so those boxes are not drawn themselves.\nlocal drawnCache: { [string]: { string } } = {}\nfunction Pond.drawnPieces(region: Region): { string }\n\tlocal cached = drawnCache[region.id]\n\tif cached ~= nil then return cached end\n\tlocal out: { string } = {}\n\tif region.kind == \"pond\" then\n\t\tfor _, p in Pond.pieces(region) do\n\t\t\tif string.find(p.id, \"_pad_\", 1, true) ~= nil or string.sub(p.id, -5) == \"_lily\" or p.id == \"pond_a1_leaf\" then table.insert(out, p.id) end\n\t\tend\n\tend\n\tdrawnCache[region.id] = table.freeze(out)\n\treturn out\nend\n\n-- The boxes a region's creatures keep out of: each retreat grown by half a stud.\nfunction Pond.keepOut(region: Region): { Box }\n\tlocal out: { Box } = {}\n\tfor _, t in region.retreats do table.insert(out, { min = t.min - v(0.5, 0.5, 0.5), max = t.max + v(0.5, 0.5, 0.5) }) end\n\treturn out\nend\n\n-- ---------------------------------------------------------------- the drawn looks\n-- The ceilings each kind keeps to at both tiers (tests/preserve.luau holds them). A margin cell's look: the water's surface (translucent, at its true level; Roblox's\n-- own reflections), the pads drawn round, the cattails' and the rushes' drawn blades and heads, the mud's wet sheen and the waterline's scum; what reads from a metre or\n-- two off at the low tier (the water, the pads, the stands' masses). The corridor's mown path is coarse: its cut tufts at the full tier. The spider's close view (the\n-- duckweed, the mud's crumbs, the floating seeds, the dew) is the patches'.\nPond.BUDGETS = table.freeze({\n\tpond = { full = 170, low = 22 }, boardwalk = { full = 28, low = 3 }, mown_path = { full = 24, low = 2 }, cattail = { full = 40, low = 12 },\n}) :: { [string]: { full: number, low: number } }\n\nlocal function sheet(budget: { full: number, low: number })\n\tlocal list: { Drawn } = {}\n\tlocal full, low = 0, 0\n\tlocal function add(d: Drawn): boolean\n\t\tif full + 1 > budget.full or (not d.full and low + 1 > budget.low) then return false end\n\t\tfull += 1\n\t\tif not d.full then low += 1 end\n\t\ttable.insert(list, d)\n\t\treturn true\n\tend\n\treturn list, add\nend\nlocal function rec(id: string, size: Vector3, at: Vector3, color: string, material: string, full: boolean, shape: string?, turn: Vector3?): Drawn\n\treturn { id = id, size = size, at = at, color = hex(color), material = material, full = full, shape = shape, turn = turn }\nend\nlocal function drop(id: string, at: Vector3, size: number, rand: () -> number): Drawn\n\tlocal d = rec(id, v(size, size * 0.62, size), at + v(0, size * 0.25, 0), \"dfeaee\", \"Glass\", true, \"Ellipsoid\")\n\td.group = \"Dew\"\n\td.dew = rand() * 0.6\n\td.transparency = between(rand, 0.3, 0.45)\n\td.reflectance = 0.3\n\treturn d\nend\n-- A blade from its foot at `at`: `h` tall, `w` wide, leaning `lean` degrees toward the yaw `yaw`; `bend`, if given, its upper part leans that much more.\nlocal function blade(add: (Drawn) -> boolean, id: string, at: Vector3, h: number, w: number, yaw: number, lean: number, bend: number?, color: string, full: boolean, thick: number?)\n\tlocal function seg(sid: string, from: Vector3, len: number, l: number): Vector3\n\t\tlocal r = math.rad(l)\n\t\tlocal dir = v(-math.sin(r) * math.cos(math.rad(yaw)), math.cos(r), math.sin(r) * math.sin(math.rad(yaw)))\n\t\tadd(rec(sid, v(w, len, thick or 0.06), from + dir * (len / 2), color, \"SmoothPlastic\", full, nil, v(0, yaw, l)))\n\t\treturn from + dir * len\n\tend\n\tif bend == nil then seg(id, at, h, lean); return end\n\tlocal knee = seg(id .. \"a\", at, h * 0.55, lean)\n\tseg(id .. \"b\", knee, h * 0.45, lean + bend)\nend\n-- The water's surface over a rectangle: the backdrop's lens (World/PreserveLook) is the pond's water, a hair under the surface; where a bank's strip ends north of the\n-- lens's own shore (the strips are straight, the shore is not), the water between is drawn here the same way, translucent, its tint the pond's, shining.\nlocal function waterSheet(add: (Drawn) -> boolean, id: string, x0: number, x1: number, z0: number, z1: number)\n\tlocal x = x0\n\tlocal k = 0\n\twhile x < x1 - 1e-6 do\n\t\tlocal K = Pond.CORE\n\t\tlocal xb = math.min(x1, K.x0 + Pond.STRIP * (math.floor((x - K.x0) / Pond.STRIP + 1e-9) + 1))\n\t\tlocal zw = Pond.waterline(x + 1e-3)\n\t\tlocal za, zb = Pond.shore(x), Pond.shore(xb)\n\t\tif zw ~= nil then\n\t\t\tlocal north = math.min(za or zw, zb or zw)\n\t\t\tlocal s0, s1 = math.max(z0, north), math.min(z1, zw)\n\t\t\tif s1 - s0 > 0.2 then\n\t\t\t\tk += 1\n\t\t\t\tlocal d = rec(`{id}{k}`, v(xb - x, 0.2, s1 - s0), v((x + xb) / 2, WATER - 0.4, (s0 + s1) / 2), C.water, \"Glass\", false)\n\t\t\t\td.transparency = 0.35\n\t\t\t\td.reflectance = 0.25\n\t\t\t\tadd(d)\n\t\t\tend\n\t\tend\n\t\tx = xb\n\tend\nend\n\n-- A cattail stand drawn (the part between two heights): each leaf a blade over its box, the upper third arching over and away, the spike's velvet and the male spike.\nlocal function standDecor(add: (Drawn) -> boolean, k: number, y0: number, y1: number, rand: () -> number)\n\tlocal T = Pond.CATTAIL\n\tfor _, p in standPieces(k) do\n\t\tlocal a, b = math.max(p.lo.Y, y0), math.min(p.hi.Y, y1)\n\t\tif b - a <= 1e-6 then continue end\n\t\tlocal c = (p.lo + p.hi) * 0.5\n\t\tif string.find(p.id, \"_leaf_\", 1, true) ~= nil then\n\t\t\tlocal alongX = (p.hi.X - p.lo.X) > (p.hi.Z - p.lo.Z)\n\t\t\tlocal w = T.leafW * 1.1\n\t\t\tlocal top = p.hi.Y\n\t\t\tlocal bendAt = top - (top - WATER) * 0.3\n\t\t\t-- the straight part over the box (a little wider so its corners hardly show)\n\t\t\tlocal s0, s1 = a, math.min(b, bendAt)\n\t\t\tif s1 - s0 > 1e-3 then\n\t\t\t\tadd(rec(p.id .. \"_Blade\", if alongX then v(w, s1 - s0, T.leafT * 0.8) else v(T.leafT * 0.8, s1 - s0, w), v(c.X, (s0 + s1) / 2, c.Z), pick(C.cattailLeaf, rand), \"SmoothPlastic\", false))\n\t\t\tend\n\t\t\t-- the arch: drawn only (it would not hold a spider in a box), out from where the box ends\n\t\t\tif b >= top - 1e-3 then\n\t\t\t\tlocal yaw = (if alongX then 90 else 0) + between(rand, -30, 30) + (if rand() < 0.5 then 180 else 0)\n\t\t\t\tblade(add, p.id .. \"_Arch\", v(c.X, top - 1, c.Z), (top - WATER) * between(rand, 0.18, 0.28), w * 0.9, yaw, between(rand, 18, 30), between(rand, 25, 45),\n\t\t\t\t\tpick(C.cattailLeaf, rand), true, T.leafT * 0.6)\n\t\t\tend\n\t\telseif string.find(p.id, \"_spike\", 1, true) ~= nil then\n\t\t\tadd(rec(p.id .. \"_Velvet\", v(b - a + 0.6, T.spike.w * 1.25, T.spike.w * 1.25), v(c.X, (a + b) / 2, c.Z), C.spike, \"Fabric\", false, \"Cylinder\", v(0, 0, 90)))\n\t\telseif string.find(p.id, \"_male\", 1, true) ~= nil then\n\t\t\tadd(rec(p.id .. \"_Fluff\", v(b - a, T.male.w * 2.2, T.male.w * 2.2), v(c.X, (a + b) / 2, c.Z), C.spikeMale, \"Fabric\", true, \"Cylinder\", v(0, 0, 90)))\n\t\tend\n\tend\nend\n\nlocal function pondDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal id = region.id\n\tlocal plan = PLAN[string.sub(id, 6)]\n\tlocal rand = rng(region.seed, 29)\n\t-- the low tier: the water, the pads, the lily, the stands' masses\n\tlocal _, wet = terrain(lo.X, hi.X, lo.Z, hi.Z)\n\tif wet then waterSheet(add, \"Water\", lo.X, hi.X, lo.Z, hi.Z) end\n\tfor i, e in (plan.pads or {}) :: { { number } } do\n\t\tlocal x, z, d = lo.X + e[1], hi.Z - e[2], e[3]\n\t\tadd(rec(`Pad{i}`, v(0.5, d, d), v(x, WATER + 0.12, z), pick(C.pad, rand), \"SmoothPlastic\", false, \"Cylinder\", v(0, 0, 90)))\n\t\t-- the notch to its middle, its veins, its red underside's rim where it curls (the full tier)\n\t\tlocal notch = between(rand, 0, 360)\n\t\tadd(rec(`Notch{i}`, v(d * 0.5, 0.44, 0.3), v(x + math.cos(math.rad(notch)) * d * 0.25, WATER + 0.12, z - math.sin(math.rad(notch)) * d * 0.25), C.water, \"SmoothPlastic\", true, nil,\n\t\t\tv(0, notch, 0)))\n\t\tfor vk = 1, 5 do\n\t\t\tlocal a = notch + vk * 60\n\t\t\tadd(rec(`Vein{i}_{vk}`, v(d * 0.44, 0.04, 0.18), v(x + math.cos(math.rad(a)) * d * 0.22, WATER + 0.33, z - math.sin(math.rad(a)) * d * 0.22), \"6f9a52\", \"SmoothPlastic\", true, nil, v(0, a, 0)))\n\t\tend\n\t\tadd(rec(`Rim{i}`, v(0.3, d * 1.01, d * 1.01), v(x, WATER + 0.02, z), C.padUnder, \"SmoothPlastic\", true, \"Cylinder\", v(0, 0, 90)))\n\t\tif rand() < 0.6 then add(drop(`PadDrop{i}`, v(x + between(rand, -d * 0.2, d * 0.2), WATER + 0.3, z + between(rand, -d * 0.2, d * 0.2)), between(rand, 0.4, 0.9), rand)) end\n\tend\n\tif plan.flower ~= nil then\n\t\tlocal fx, fz = lo.X + plan.flower[1], hi.Z - plan.flower[2]\n\t\tadd(rec(\"LilyCup\", v(7, 3, 7), v(fx, WATER + 1.5, fz), C.lily, \"SmoothPlastic\", false, \"Ellipsoid\"))\n\t\tfor i = 1, 16 do\n\t\t\tlocal a = i / 16 * TAU + (if i % 2 == 0 then 0.2 else 0)\n\t\t\tlocal r = if i % 2 == 0 then 3.4 else 4.2\n\t\t\tadd(rec(`Petal{i}`, v(4.6, 0.4, 1.6), v(fx + math.cos(a) * r, WATER + 1.2 + (if i % 2 == 0 then 1.2 else 0.4), fz + math.sin(a) * r), C.lily, \"SmoothPlastic\", true, \"Ellipsoid\",\n\t\t\t\tv(0, -math.deg(a), if i % 2 == 0 then 28 else 12)))\n\t\tend\n\t\tfor i = 1, 10 do\n\t\t\tlocal a = i / 10 * TAU\n\t\t\tadd(rec(`Stamen{i}`, v(0.4, 1.4, 0.4), v(fx + math.cos(a) * 1.3, WATER + 3.4, fz + math.sin(a) * 1.3), C.lilyEye, \"SmoothPlastic\", true))\n\t\tend\n\tend\n\tif plan.stand ~= nil then standDecor(add, plan.stand, -math.huge, CUT1, rand) end\n\t-- the stones wet at the waterline, the flat stone's lichen and the shelter's slab\n\tfor _, p in Pond.pieces(region) do\n\t\tif string.find(p.id, \"_stone_\", 1, true) ~= nil or string.sub(p.id, -5) == \"_flat\" or string.sub(p.id, -5) == \"_slab\" then\n\t\t\tlocal c = (p.lo + p.hi) * 0.5\n\t\t\tlocal s = p.hi - p.lo\n\t\t\tadd(rec(p.id .. \"_Round\", v(s.X * 1.08, math.min(s.Y, 4) * 1.1, s.Z * 1.08), v(c.X, p.hi.Y - math.min(s.Y, 4) * 0.5, c.Z), pick(C.stone, rand), \"Slate\", true, \"Ellipsoid\"))\n\t\t\tif p.lo.Y < WATER then\n\t\t\t\tadd(rec(p.id .. \"_Wet\", v(s.X * 1.1, 1.2, s.Z * 1.1), v(c.X, WATER + 0.5, c.Z), C.stoneWet, \"Slate\", true, \"Ellipsoid\"))\n\t\t\tend\n\t\t\tif rand() < 0.5 then add(rec(p.id .. \"_Lichen\", v(2.2, 0.06, 1.6), v(c.X + between(rand, -1, 1), p.hi.Y + 0.03, c.Z + between(rand, -1, 1)), \"9aa078\", \"SmoothPlastic\", true, \"Ellipsoid\")) end\n\t\tend\n\tend\n\t-- the curled leaf drawn\n\tif plan.leaf ~= nil then\n\t\tlocal L = Pond.LEAF\n\t\tlocal lx, lz = lo.X + plan.leaf[1], hi.Z - plan.leaf[2]\n\t\t-- a long dead blade lying arched over the gap, its edges curled up\n\t\tadd(rec(\"CurledLeaf\", v(L.l + 0.6, L.thick, L.w * 0.6), v(lx, GT + L.gap + L.thick / 2, lz), C.cattailDead, \"Fabric\", false))\n\t\tadd(rec(\"LeafCurlN\", v(L.l + 0.6, L.thick * 0.8, L.w * 0.42), v(lx, GT + L.gap + 0.55, lz - L.w * 0.38), \"a8925e\", \"Fabric\", false, nil, v(-40, 0, 0)))\n\t\tadd(rec(\"LeafCurlS\", v(L.l + 0.6, L.thick * 0.8, L.w * 0.42), v(lx, GT + L.gap + 0.55, lz + L.w * 0.38), \"a8925e\", \"Fabric\", false, nil, v(40, 0, 0)))\n\t\tadd(rec(\"LeafVein\", v(L.l * 0.9, 0.05, 0.2), v(lx, GT + L.gap + L.thick + 0.03, lz), \"b8a070\", \"Fabric\", true))\n\tend\n\t-- the clumps drawn: each culm's blade over its box, the sedge's leaves arching from its crown, the heads\n\tfor _, p in Pond.pieces(region) do\n\t\tif string.find(p.id, \"_culm_\", 1, true) ~= nil then\n\t\t\tlocal c = (p.lo + p.hi) * 0.5\n\t\t\tlocal rush = string.find(p.id, \"_rush\", 1, true) ~= nil\n\t\t\tadd(rec(p.id .. \"_Draw\", if rush then v(p.hi.Y - p.lo.Y, 0.32, 0.32) else v(0.5, p.hi.Y - p.lo.Y, 0.5), c, pick(if rush then C.rush else C.sedge, rand), \"SmoothPlastic\", true,\n\t\t\t\tif rush then \"Cylinder\" else nil, if rush then v(0, 0, 90) else nil))\n\t\telseif string.find(p.id, \"_head_\", 1, true) ~= nil then\n\t\t\tlocal c = (p.lo + p.hi) * 0.5\n\t\t\tfor q = 1, 3 do\n\t\t\t\tadd(rec(`{p.id}_Spikelet{q}`, v(0.8, 1.6, 0.8), c + v(between(rand, -0.5, 0.5), (q - 2) * 1.1, between(rand, -0.5, 0.5)), C.sedgeHead, \"Fabric\", true, \"Ellipsoid\"))\n\t\t\tend\n\t\tend\n\tend\n\tfor i, e in (plan.sedge or {}) :: { { number } } do\n\t\tlocal x, z = lo.X + e[1], hi.Z - e[2]\n\t\tlocal base = groundAt(x, z)\n\t\tadd(rec(`SedgeCrown{i}`, v(7, 3.5, 7), v(x, base + 1.2, z), pick(C.sedge, rand), \"LeafyGrass\", false, \"Ellipsoid\"))\n\t\tfor b = 1, 10 do\n\t\t\tlocal yaw = b / 10 * 360 + between(rand, -15, 15)\n\t\t\tblade(add, `Sedge{i}_{b}`, v(x + math.cos(math.rad(yaw)) * 1.2, base, z - math.sin(math.rad(yaw)) * 1.2), between(rand, 25, 45), between(rand, 0.4, 0.6), yaw + 180,\n\t\t\t\tbetween(rand, 6, 16), if b % 2 == 0 then between(rand, 12, 30) else nil, pick(C.sedge, rand), true)\n\t\tend\n\tend\n\tfor i, e in (plan.rush or {}) :: { { number } } do\n\t\tlocal x, z = planPoint(lo.X, hi.Z, e, 3)\n\t\tlocal base = groundAt(x, z)\n\t\tadd(rec(`RushCrown{i}`, v(5, 4, 5), v(x, base + 1.5, z), pick(C.rush, rand), \"LeafyGrass\", false, \"Ellipsoid\"))\n\t\tfor b = 1, 6 do\n\t\t\tblade(add, `RushStem{i}_{b}`, v(x + between(rand, -2.4, 2.4), base, z + between(rand, -2.4, 2.4)), between(rand, 40, 60), 0.28, between(rand, 0, 360), between(rand, 4, 14), nil,\n\t\t\t\tpick(C.rush, rand), true, 0.28)\n\t\tend\n\tend\n\t-- the waterline: a dark wet band along the bank's edge and a scum of pollen and duckweed against it; the bank's mud mottled, a footprint of a bird\n\tlocal lands = terrain(lo.X, hi.X, lo.Z, hi.Z)\n\tfor i, l in lands do\n\t\tlocal xc, w = (l.x0 + l.x1) / 2, l.x1 - l.x0\n\t\t-- the step down toward the water rounded off: a lip of mud along each land box's north edge where the ground beyond it is lower (the next band, or the water)\n\t\tlocal beyond = groundAt(xc, l.z0 - 0.5)\n\t\tif l.z0 > lo.Z + 0.5 and beyond < l.top - 0.5 then\n\t\t\tlocal drop = l.top - beyond\n\t\t\tadd(rec(`Lip{i}`, v(w + 0.4, drop * 1.15, math.min(4, drop * 1.4)), v(xc, l.top - drop * 0.6, l.z0), if l.band == \"bank\" then C.mudDark else C.mudWet,\n\t\t\t\t\"Mud\", true, \"Ellipsoid\"))\n\t\tend\n\t\tif l.band == \"wet\" then\n\t\t\tadd(rec(`Sheen{i}`, v(w, 0.06, l.z1 - l.z0), v(xc, l.top + 0.03, (l.z0 + l.z1) / 2), \"2c2722\", \"Mud\", true))\n\t\t\tif beyond <= WATER then add(rec(`Scum{i}`, v(w, 0.06, 3), v(xc, WATER + 0.04, l.z0 - 1.5), C.duckweed, \"SmoothPlastic\", true)) end\n\t\telseif l.band == \"bank\" and (l.z1 - l.z0) > 10 then\n\t\t\t-- the bank's grass, short and patchy, and the mud between\n\t\t\tfor t = 1, 2 do\n\t\t\t\tadd(rec(`BankTuft{i}_{t}`, v(between(rand, 3, 7), between(rand, 1.5, 3.5), between(rand, 3, 6)), v(between(rand, l.x0 + 3, l.x1 - 3), l.top + 0.9, between(rand, l.z0 + 3, l.z1 - 3)),\n\t\t\t\t\tpick({ \"6f8a46\", \"7d8a4e\", \"5f7a3e\" }, rand), \"Grass\", true, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\t\t\tend\n\t\t\tif rand() < 0.5 then\n\t\t\t\tadd(rec(`Mottle{i}`, v(between(rand, 6, 14), 0.06, between(rand, 4, 10)), v(between(rand, l.x0 + 4, l.x1 - 4), l.top + 0.03, between(rand, l.z0 + 4, l.z1 - 4)), \"5a4a36\", \"Mud\", true,\n\t\t\t\t\t\"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\t\t\tend\n\t\tend\n\tend\n\t-- under the water: the bed's dark, a sunken leaf, a few stems of last year\n\tif wet then\n\t\tfor i = 1, 3 do\n\t\t\tadd(rec(`Sunk{i}`, v(between(rand, 4, 8), 0.1, between(rand, 2.5, 5)), v(between(rand, lo.X + 6, hi.X - 6), BED + 0.1, between(rand, lo.Z + 6, hi.Z - 6)), pick({ \"4a3a28\", \"3a2e20\", \"5a4630\" }, rand),\n\t\t\t\t\"Fabric\", true, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\t\tend\n\t\tfor i = 1, 2 do\n\t\t\tadd(rec(`Stem{i}`, v(0.4, between(rand, 8, 16), 0.4), v(between(rand, lo.X + 6, hi.X - 6), BED + 6, between(rand, lo.Z + 6, hi.Z - 6)), \"4a4630\", \"SmoothPlastic\", true, nil,\n\t\t\t\tv(between(rand, -20, 20), 0, between(rand, -30, 30))))\n\t\tend\n\tend\nend\n\nlocal function deckDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal rand = rng(region.seed, 11)\n\tlocal south = string.sub(region.id, 6, 6) == \"s\"\n\t-- the low tier: the dark between the boards (so the gaps read), the post's shadow\n\tadd(rec(\"Under\", v(hi.X - lo.X, 0.2, hi.Z - lo.Z), v((lo.X + hi.X) / 2, DECK - Pond.BOARD.thick - 0.4, (lo.Z + hi.Z) / 2), \"1e1a14\", \"SmoothPlastic\", false))\n\t-- the full tier: each board's grain, its nails at the ends over the beams, a knot or two, lichen and grit\n\tfor _, p in Pond.pieces(region) do\n\t\tif string.find(p.id, \"_board_\", 1, true) ~= nil then\n\t\t\tlocal zc = (p.lo.Z + p.hi.Z) / 2\n\t\t\tadd(rec(p.id .. \"_Grain\", v(p.hi.X - p.lo.X - 1, 0.03, 0.3), v((p.lo.X + p.hi.X) / 2, DECK + 0.015, zc + between(rand, -4, 4)), \"6a5640\", \"Wood\", true))\n\t\t\tfor _, nx in { p.lo.X + 4, p.hi.X - 4 } do\n\t\t\t\tfor _, dz in { -4, 4 } do add(rec(`{p.id}_Nail{nx}_{dz}`, v(0.06, 0.5, 0.5), v(nx, DECK + 0.03, zc + dz), \"4a4a48\", \"Metal\", true, \"Cylinder\", v(0, 0, 90))) end\n\t\t\tend\n\t\t\tif rand() < 0.35 then add(rec(p.id .. \"_Knot\", v(1.6, 0.04, 1.1), v(between(rand, p.lo.X + 8, p.hi.X - 8), DECK + 0.02, zc), \"4a3a28\", \"Wood\", true, \"Ellipsoid\")) end\n\t\tend\n\tend\n\tfor i = 1, 2 do\n\t\tadd(rec(`Lichen{i}`, v(between(rand, 1.5, 3), 0.05, between(rand, 1.2, 2.6)), v(between(rand, lo.X + 4, hi.X - 4), DECK + 0.03, between(rand, lo.Z + 10, hi.Z - 10)),\n\t\t\tpick({ \"b8b88a\", \"9aa078\", \"c9c49a\" }, rand), \"SmoothPlastic\", true, \"Ellipsoid\"))\n\tend\n\tif rand() < 0.5 then\n\t\tadd(rec(\"Leaf\", v(5, 0.08, 3.4), v(between(rand, lo.X + 10, hi.X - 10), DECK + 0.05, between(rand, lo.Z + 12, hi.Z - 12)), pick({ \"b0702a\", \"8a6a3a\", \"c09a3a\" }, rand), \"Fabric\", true,\n\t\t\t\"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\tend\n\t-- the water or the mud under its north edge (the core's)\n\tlocal _, wet = terrain(lo.X, hi.X, lo.Z, hi.Z)\n\tif wet then waterSheet(add, \"Water\", lo.X, hi.X, lo.Z, hi.Z) end\n\tif not south then add(rec(\"PostCap\", v(10.4, 0.4, 10.4), v(lo.X + 8, DECK - Pond.BOARD.thick - 15.2, lo.Z + 5), \"4a3e30\", \"Wood\", true)) end\nend\n\nlocal function pathDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal rand = rng(region.seed, 13)\n\tadd(rec(\"Stripe\", v(hi.X - lo.X, 0.06, hi.Z - lo.Z), v((lo.X + hi.X) / 2, GT + 0.03, (lo.Z + hi.Z) / 2), pick(C.mown, rand), \"Grass\", false))\n\t-- cut tufts, a clover, a plantain's rosette, a dandelion's, a fallen leaf\n\tfor i = 1, 14 do\n\t\tlocal x, z = between(rand, lo.X + 3, hi.X - 3), between(rand, lo.Z + 3, hi.Z - 3)\n\t\tadd(rec(`Tuft{i}`, v(between(rand, 3, 7), between(rand, 1.2, 2.6), between(rand, 2.5, 6)), v(x, GT + 0.8, z), pick(C.mown, rand), \"Grass\", true, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\tend\n\tfor i = 1, 3 do\n\t\tlocal x, z = between(rand, lo.X + 8, hi.X - 8), between(rand, lo.Z + 8, hi.Z - 8)\n\t\tlocal kind = rand()\n\t\tif kind < 0.4 then\n\t\t\tfor l = 1, 3 do add(rec(`Clover{i}_{l}`, v(1.1, 0.1, 1.1), v(x + math.cos(l * 2.1) * 0.7, GT + 0.3, z + math.sin(l * 2.1) * 0.7), \"5f8a3e\", \"SmoothPlastic\", true, \"Ellipsoid\")) end\n\t\telseif kind < 0.75 then\n\t\t\tfor l = 1, 5 do\n\t\t\t\tlocal a = l / 5 * 360\n\t\t\t\tadd(rec(`Plantain{i}_{l}`, v(7, 0.15, 2.6), v(x + math.cos(math.rad(a)) * 3.2, GT + 0.2, z - math.sin(math.rad(a)) * 3.2), \"4f7a3a\", \"SmoothPlastic\", true, \"Ellipsoid\", v(0, a, 0)))\n\t\t\tend\n\t\telse\n\t\t\tadd(rec(`Leaf{i}`, v(5, 0.08, 3.4), v(x, GT + 0.1, z), pick({ \"b0702a\", \"8a6a3a\", \"c09a3a\" }, rand), \"Fabric\", true, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\t\tend\n\tend\nend\n\nlocal function cattailDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal k = tonumber(string.sub(region.id, 9, 9)) :: number\n\tlocal upper = string.sub(region.id, 10, 10) == \"b\"\n\tlocal rand = rng(region.seed, 17)\n\tif upper then standDecor(add, k, CUT2, math.huge, rand) else standDecor(add, k, CUT1, CUT2, rand) end\nend\n\n-- ---------------------------------------------------------------- the patches: what the spider sees close\n-- Each margin cell is cut into patches of World/Hut.PATCH studs (kind \"patch\", drawn only near the spider, World/LookPlan): on the water duckweed (a frond of 2 to 4\n-- mm, in rafts against the bank and the stems), floating seeds and fluff from the cattails, a midge's shuck, bubbles; on the wet mud crumbs, a snail's shell, a\n-- bird's print, grit and the dew; on the bank short grass and a seedling.\nlocal patchParent: { [string]: Region } = {}\nfunction Pond.patches(regions: { Region }, worldSeed: number, seedOf: (number, string) -> number): { Region }\n\tlocal out: { Region } = {}\n\tlocal size = Hut.PATCH\n\tfor _, r in regions do\n\t\tif r.kind == \"pond\" then\n\t\t\tlocal lo, hi = r.bounds[1], r.bounds[2]\n\t\t\tlocal nx = math.max(1, math.ceil((hi.X - lo.X) / size - 1e-6))\n\t\t\tlocal nz = math.max(1, math.ceil((hi.Z - lo.Z) / size - 1e-6))\n\t\t\tlocal dx, dz = (hi.X - lo.X) / nx, (hi.Z - lo.Z) / nz\n\t\t\tfor i = 1, nx do\n\t\t\t\tfor j = 1, nz do\n\t\t\t\t\tlocal pid = `{r.id}~{i}_{j}`\n\t\t\t\t\tlocal plo, phi = v(lo.X + (i - 1) * dx, WATER - 2, lo.Z + (j - 1) * dz), v(lo.X + i * dx, GT + 40, lo.Z + j * dz)\n\t\t\t\t\tlocal mid = (plo + phi) * 0.5\n\t\t\t\t\tlocal p = table.freeze({\n\t\t\t\t\t\tid = pid, kind = \"patch\", origin = mid, bounds = table.freeze({ plo, phi }), seed = seedOf(worldSeed, pid), neighbors = table.freeze({}),\n\t\t\t\t\t\tretreats = table.freeze({}), spawn = table.freeze({ pos = mid, heading = v(0, 0, -1) }), clockScale = r.clockScale,\n\t\t\t\t\t}) :: any\n\t\t\t\t\tpatchParent[pid] = r\n\t\t\t\t\ttable.insert(out, p)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn out\nend\n-- The region a patch of the pond's belongs to (nil for one that is not the pond's).\nfunction Pond.patchParent(patch: Region): Region?\n\treturn patchParent[patch.id]\nend\n\n-- The standing boxes of a cell (what the near detail keeps clear of): everything but the terrain.\nlocal function standing(region: Region): { Box }\n\tlocal out: { Box } = {}\n\tfor _, p in Pond.pieces(region) do\n\t\tif not (string.find(p.id, \"_bank_\", 1, true) or string.find(p.id, \"_damp_\", 1, true) or string.find(p.id, \"_wet_\", 1, true) or string.sub(p.id, -4) == \"_bed\") then\n\t\t\ttable.insert(out, { min = p.lo, max = p.hi })\n\t\tend\n\tend\n\treturn out\nend\nlocal function clear(boxes: { Box }, x: number, z: number, m: number): boolean\n\tfor _, b in boxes do\n\t\tif x > b.min.X - m and x < b.max.X + m and z > b.min.Z - m and z < b.max.Z + m then return false end\n\tend\n\treturn true\nend\n\nlocal function patchDecor(patch: Region, add: (Drawn) -> boolean)\n\tlocal parent = patchParent[patch.id]\n\tif parent == nil then return end\n\tlocal lo, hi = patch.bounds[1], patch.bounds[2]\n\tlocal rand = rng(patch.seed, 43)\n\tlocal boxes = standing(parent)\n\tlocal k = 0\n\tlocal function surface(x: number, z: number): (string, number)\n\t\tlocal lands = terrain(x - 0.01, x + 0.01, z - 0.01, z + 0.01)\n\t\tif #lands == 0 then return \"water\", WATER end\n\t\treturn lands[1].band, lands[1].top\n\tend\n\tlocal function frond(x: number, z: number, full: boolean)\n\t\tk += 1\n\t\tlocal s = between(rand, 0.25, 0.45)\n\t\tadd(rec(`Frond{k}`, v(s, 0.05, s * 0.75), v(x, WATER + 0.03, z), pick({ C.duckweed, \"8cc050\", \"6fa040\" }, rand), \"SmoothPlastic\", full, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\tend\n\tlocal dews = 0\n\tfor pass = 1, 6 do\n\t\tfor _ = 1, 8 do\n\t\t\tlocal x, z = between(rand, lo.X + 1, hi.X - 1), between(rand, lo.Z + 1, hi.Z - 1)\n\t\t\tif not clear(boxes, x, z, 0.8) then continue end\n\t\t\tlocal kind, top = surface(x, z)\n\t\t\tlocal full = pass > 1\n\t\t\tif kind == \"water\" then\n\t\t\t\t-- duckweed in little rafts, thicker by the bank (a wet band's edge near) and round the stems\n\t\t\t\tlocal roll = rand()\n\t\t\t\tif roll < 0.6 then\n\t\t\t\t\tfor _ = 1, 3 do frond(x + between(rand, -1.2, 1.2), z + between(rand, -1.2, 1.2), full) end\n\t\t\t\telseif roll < 0.75 then\n\t\t\t\t\tk += 1\n\t\t\t\t\tadd(rec(`Fluff{k}`, v(0.6, 0.3, 0.6), v(x, WATER + 0.15, z), \"e8e2d0\", \"Fabric\", true, \"Ball\")) -- (a cattail's seed on its down)\n\t\t\t\telseif roll < 0.85 then\n\t\t\t\t\tk += 1\n\t\t\t\t\tadd(rec(`Shuck{k}`, v(0.5, 0.08, 0.12), v(x, WATER + 0.04, z), \"c8c0a8\", \"SmoothPlastic\", true, nil, v(0, between(rand, 0, 180), 0))) -- (a midge's pupal skin)\n\t\t\t\telseif roll < 0.92 then\n\t\t\t\t\tk += 1\n\t\t\t\t\tlocal b = rec(`Bubble{k}`, v(0.35, 0.2, 0.35), v(x, WATER + 0.08, z), \"e6eef0\", \"Glass\", true, \"Ball\")\n\t\t\t\t\tb.transparency = 0.5\n\t\t\t\t\tadd(b)\n\t\t\t\telse\n\t\t\t\t\tk += 1\n\t\t\t\t\tadd(rec(`Float{k}`, v(between(rand, 1.5, 3), 0.06, between(rand, 0.8, 1.6)), v(x, WATER + 0.04, z), pick({ \"8a6a3a\", \"a08a5a\", \"6a5a3a\" }, rand), \"Fabric\", true, \"Ellipsoid\",\n\t\t\t\t\t\tv(0, between(rand, 0, 180), 0)))\n\t\t\t\tend\n\t\t\telseif kind == \"wet\" or kind == \"damp\" then\n\t\t\t\tlocal roll = rand()\n\t\t\t\tif roll < 0.45 then\n\t\t\t\t\tk += 1\n\t\t\t\t\tadd(rec(`Crumb{k}`, v(between(rand, 0.6, 1.4), 0.35, between(rand, 0.5, 1.1)), v(x, top + 0.12, z), pick({ \"3a3024\", \"4a3c2c\", \"2e261e\" }, rand), \"Mud\", full, \"Ellipsoid\"))\n\t\t\t\telseif roll < 0.65 then\n\t\t\t\t\tk += 1\n\t\t\t\t\tadd(rec(`Grit{k}`, v(0.4, 0.25, 0.35), v(x, top + 0.1, z), pick(C.stone, rand), \"Pebble\", true, \"Ellipsoid\"))\n\t\t\t\telseif roll < 0.72 then\n\t\t\t\t\tk += 1\n\t\t\t\t\tadd(rec(`Shell{k}`, v(0.9, 0.7, 0.9), v(x, top + 0.35, z), \"c8b89a\", \"SmoothPlastic\", true, \"Ball\")) -- (a pond snail's empty shell)\n\t\t\t\telseif roll < 0.8 then\n\t\t\t\t\t-- a bird's print in the mud: three toes\n\t\t\t\t\tk += 1\n\t\t\t\t\tlocal a = between(rand, 0, 360)\n\t\t\t\t\tfor t = -1, 1 do\n\t\t\t\t\t\tadd(rec(`Toe{k}_{t}`, v(2.4, 0.05, 0.3), v(x + math.cos(math.rad(a + t * 35)) * 1.2, top + 0.02, z - math.sin(math.rad(a + t * 35)) * 1.2), \"2a221a\", \"Mud\", true, nil,\n\t\t\t\t\t\t\tv(0, a + t * 35, 0)))\n\t\t\t\t\tend\n\t\t\t\telseif dews < 3 then\n\t\t\t\t\tdews += 1\n\t\t\t\t\tadd(drop(`Dew{dews}`, v(x, top + 0.2, z), between(rand, 0.3, 0.5), rand))\n\t\t\t\tend\n\t\t\telse\n\t\t\t\t-- the bank: short grass and a seedling\n\t\t\t\tk += 1\n\t\t\t\tlocal spin = between(rand, 0, 360)\n\t\t\t\tfor b = 1, 3 do\n\t\t\t\t\tblade(add, `Grass{k}_{b}`, v(x + between(rand, -0.4, 0.4), top, z + between(rand, -0.4, 0.4)), between(rand, 2, 6), between(rand, 0.25, 0.4), spin + b * 120,\n\t\t\t\t\t\tbetween(rand, 4, 20), nil, pick(C.mown, rand), full or b > 1)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal decorCache: { [string]: { Drawn } } = {}\n-- The region's drawn records (or a patch of the pond's), within its kind's budget at both tiers; the same list for the same region.\nfunction Pond.decor(region: Region): { Drawn }\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = decorCache[key]\n\tif cached ~= nil then return cached end\n\tlocal budget = if region.kind == \"patch\" then Hut.BUDGETS.patch else Pond.BUDGETS[region.kind]\n\tassert(budget ~= nil, \"no budget for the region kind \" .. region.kind)\n\tlocal list, add = sheet(budget)\n\tlocal k = region.kind\n\tif k == \"pond\" then pondDecor(region, add)\n\telseif k == \"boardwalk\" then deckDecor(region, add)\n\telseif k == \"mown_path\" then pathDecor(region, add)\n\telseif k == \"cattail\" then cattailDecor(region, add)\n\telseif k == \"patch\" then patchDecor(region, add) end\n\tfor _, d in list do table.freeze(d) end\n\tdecorCache[key] = table.freeze(list)\n\treturn list\nend\n\n-- ---------------------------------------------------------------- the life\n-- Non-biting midges (Chironomidae) and mosquitoes (Culicidae) resting on the rushes' stems and the cattails' leaves by day and restless from dusk, holding in the\n-- air over the water as a swarm does as far as the flight model allows (their profiles' hover); eastern forktail damselflies perched on the cattails by day; water\n-- striders skating the open water (Prey/Skater, ambient). From each region's own seed by streams of their own.\nPond.LIFE = table.freeze({\n\tmidges = { pond_a3 = { full = 4, low = 2 }, pond_c1 = { full = 3, low = 1 } },\n\tmosquitoes = { pond_b1 = { full = 2, low = 1 }, pond_a2 = { full = 1, low = 1 } },\n\tdamselflies = { pond_b2 = { full = 2, low = 1 } },\n\tskaters = { pond_b3 = { full = 4, low = 2, salt = 163 }, pond_c2 = { full = 3, low = 1, salt = 167 } },\n})\n\nexport type Perch = Hut.Perch\nlocal function spot(p: Vector3, n: Vector3, sh: number, fo: number): { any }\n\treturn { p, n, sh, fo }\nend\nlocal function spots(region: Region, kind: string, list: { { any } }, starts: number): { Perch }\n\tlocal out: { Perch } = {}\n\tfor i, sp in list do\n\t\ttable.insert(out, { id = `{region.id}_{kind}_{i}`, position = sp[1], normal = sp[2], shelter = sp[3], food = sp[4], start = i <= starts, kind = \"stem\" } :: any)\n\tend\n\treturn out\nend\n\n-- Perches on the stems and leaves of a cell (its culms and the cattails' lower leaves), on their faces at heights from `y0` to `y1` over the water: spots a short flight\n-- apart, each on a face looking out east or west.\nlocal function stemSpots(region: Region, y0: number, y1: number, n: number, rand: () -> number): { { any } }\n\tlocal list: { { any } } = {}\n\tlocal stems: { Piece } = {}\n\tfor _, p in Pond.pieces(region) do\n\t\tif (string.find(p.id, \"_culm_\", 1, true) ~= nil or string.find(p.id, \"_leaf_\", 1, true) ~= nil) and p.hi.Y > WATER + y0 + 4 then table.insert(stems, p) end\n\tend\n\tif #stems == 0 then return list end\n\tfor i = 1, n do\n\t\tlocal p = stems[1 + (i * 3 + math.floor(rand() * 2)) % #stems]\n\t\tlocal y = math.min(p.hi.Y - 2, WATER + between(rand, y0, y1))\n\t\t-- (the east and west faces: a fly's resting heading is along -z, which a north or south face would leave pointing out of it)\n\t\tlocal faces = { { v(p.hi.X, y, (p.lo.Z + p.hi.Z) / 2), Vector3.xAxis }, { v(p.lo.X, y, (p.lo.Z + p.hi.Z) / 2), -Vector3.xAxis } }\n\t\tlocal f = faces[1 + (i - 1) % 2]\n\t\ttable.insert(list, spot(f[1] :: Vector3, f[2] :: Vector3, 0.3, 0.4))\n\tend\n\treturn list\nend\n\nlocal bestiaryCache: { [string]: any } = {}\nfunction Pond.bestiary(region: Region): { any }?\n\tlocal L = Pond.LIFE\n\tlocal midge, mosquito, damsel = L.midges[region.id], L.mosquitoes[region.id], L.damselflies[region.id]\n\tif midge == nil and mosquito == nil and damsel == nil then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tif bestiaryCache[key] ~= nil then return bestiaryCache[key] end\n\tlocal out = {}\n\tlocal function kind(name: string, profile: string, row: { full: number, low: number }, salt: number, y0: number, y1: number, n: number, dusk: boolean)\n\t\tlocal rand = rng(region.seed, salt)\n\t\tlocal list = stemSpots(region, y0, y1, n, rand)\n\t\tif #list == 0 then return end\n\t\tlocal first = list[1][1] :: Vector3\n\t\tlocal spec: any = { kind = name, profile = profile, perches = spots(region, name, list, row.full),\n\t\t\tvents = { { id = `{region.id}_vent_{name}`, position = first + v(0, 14, 0), normal = Vector3.yAxis, appear = true, reach = 60 } }, target = row.full, low = row.low,\n\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_{name}_fly_` }\n\t\tif dusk then spec.dusk = { from = 18.5, to = 6 } end\n\t\ttable.insert(out, spec)\n\tend\n\tif midge ~= nil then kind(\"midge\", \"midge_prototype\", midge, 173, 10, 45, 7, true) end\n\tif mosquito ~= nil then kind(\"mosquito\", \"mosquito_prototype\", mosquito, 179, 8, 40, 6, true) end\n\tif damsel ~= nil then kind(\"damselfly\", \"damselfly_prototype\", damsel, 181, 20, 60, 5, false) end\n\t-- (the band each kind's flights climb in: from under its lowest perch to 11 cm over its highest, PerchGraph.plan)\n\tfor _, k in out do\n\t\tlocal lo, hi = math.huge, -math.huge\n\t\tfor _, p in k.perches do lo, hi = math.min(lo, p.position.Y), math.max(hi, p.position.Y) end\n\t\tk.floor, k.ceiling = lo - 2, hi + 11\n\tend\n\tbestiaryCache[key] = out\n\treturn out\nend\n\nlocal ambientCache: { [string]: any } = {}\n-- The water striders (Prey/Skater): their starts on the open water of the cell, the water's rectangle they skate (`water`), the stems and pads they skate round.\nfunction Pond.ambient(region: Region): { any }?\n\tlocal row = Pond.LIFE.skaters[region.id]\n\tif row == nil then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tif ambientCache[key] ~= nil then return ambientCache[key] end\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal boxes = standing(region)\n\tlocal rand = rng(region.seed, row.salt)\n\tlocal spec: any = { kind = \"skater\", seed = (region.seed + row.salt * 104729) % MOD, full = row.full, low = row.low, starts = {}, prefix = region.id .. \"_\", surface = \"water\",\n\t\twater = { min = v(lo.X, WATER - 1, lo.Z), max = v(hi.X, WATER, hi.Z) }, boxes = boxes }\n\tfor _ = 1, row.full do\n\t\tfor _ = 1, 40 do\n\t\t\tlocal x, z = between(rand, lo.X + 6, hi.X - 6), between(rand, lo.Z + 6, hi.Z - 6)\n\t\t\tlocal zw = Pond.waterline(x)\n\t\t\tif zw ~= nil and z < zw - 4 and clear(boxes, x, z, 2) then\n\t\t\t\tlocal h = between(rand, 0, TAU)\n\t\t\t\ttable.insert(spec.starts, { pos = v(x, WATER, z), heading = v(math.cos(h), 0, math.sin(h)) })\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\tend\n\tlocal out = { spec }\n\tambientCache[key] = out\n\treturn out\nend\n\n-- The regions the rival roams here (Predator/RivalSpider.roam): none yet; the boardwalk and the pond are the spider's own this round.\nPond.ROAM = table.freeze({}) :: { [string]: boolean }\n\n-- ---------------------------------------------------------------- the frog's seats (Predator/Frog)\n-- The green frog sits on one of these a day (its seeded draw): the flat stone at the water's edge in pond_a2, or the big lily pad in pond_b4. `facing`: where it faces\n-- from it (toward the open margin).\nexport type FrogSite = { region: string, piece: string, facing: Vector3 }\nPond.FROG_SITES = table.freeze({\n\ttable.freeze({ region = \"pond_a2\", piece = \"pond_a2_flat\", facing = v(0.6, 0, 0.8).Unit }),\n\ttable.freeze({ region = \"pond_b4\", piece = \"pond_b4_pad_1_mid\", facing = v(-0.7, 0, 0.7).Unit }),\n}) :: { FrogSite }\n-- A site's seat, from its region's boxes: the top middle of its piece.\nfunction Pond.frogSeat(site: FrogSite, regions: { Region }): Vector3?\n\tfor _, r in regions do\n\t\tif r.id == site.region then\n\t\t\tfor _, p in Pond.pieces(r) do\n\t\t\t\tif p.id == site.piece then return v((p.lo.X + p.hi.X) / 2, p.hi.Y, (p.lo.Z + p.hi.Z) / 2) end\n\t\t\tend\n\t\tend\n\tend\n\treturn nil\nend\n\n-- ---------------------------------------------------------------- the dragonfly's beat (drawn only: Client/PondBodies)\n-- A green darner (Anax junius) patrols over the open pond by day: a loop over the water east and north of the core 0.8 to 1.6 m up, at about 2 m a second, with a\n-- seeded weave, darting now and then. A pure function of the seed and the time: where it is, which way it faces, and whether it is out (by day, 8:00 to 19:00).\nPond.DARNER = table.freeze({ x = 1125, z = -1516, rx = 420, rz = 300, speed = 200, from = 8, to = 19 })\nfunction Pond.darner(seed: number, t: number, hour: number): (Vector3?, Vector3)\n\tlocal D = Pond.DARNER\n\tif hour < D.from or hour >= D.to then return nil, Vector3.xAxis end\n\tlocal s = (seed % 997) / 997\n\tlocal perimeter = TAU * math.sqrt((D.rx * D.rx + D.rz * D.rz) / 2)\n\tlocal a = (t * D.speed / perimeter) * TAU + s * TAU\n\tlocal weave = math.sin(a * 3.1 + s * 9) * 40\n\tlocal x = D.x + math.cos(a) * (D.rx + weave)\n\tlocal z = D.z + math.sin(a) * (D.rz + weave * 0.6)\n\tlocal y = WATER + 110 + math.sin(a * 2.3 + s * 5) * 35\n\tlocal dx, dz = -math.sin(a) * D.rx, math.cos(a) * D.rz\n\tlocal h = v(dx, 0, dz)\n\treturn v(x, y, z), if h.Magnitude > 1e-6 then h.Unit else Vector3.xAxis\nend\n\nreturn Pond\n",71247,1701016864},{"Shared/World/Preserve","--!strict\n-- The preserve's map (ROBLOX-115, docs/PARK_WORLD_DESIGN.md sections 4 and 10): a nature preserve of 100 by 60 m in an American city, held between a railway\n-- embankment (north), the backs of apartment blocks (east), the street with its railings and gate (south) and a canal towpath beyond a hedge (west). Pure data\n-- in metres, as the design draws it (x east, z north, the gate at the south), and the one shift that turns it into the game's studs.\n--\n-- The shift. One stud is a centimetre. The ranger hut stands just inside the gate (x 44..47.5, z 2..5) with its window in its north wall, and the windowsill in\n-- that window is the world's origin, exactly where the sill has always been (Habitat/WindowsillLayout, byte for byte): the window's middle (x 45.75 m) is stud\n-- x 0, and the hut's north wall's outer face (z 5 m) is stud z -16 (the sill's back frame is at z -13.5..-12.5 and the hut's log wall runs from its cladding at\n-- -16 to its lining at 12.5, where the sill's front lip is). North is -z, so the window looks out north into the preserve as the sill's always looked out at -z;\n-- east is +x. The ground outside is GROUND_Y (85 cm under the sill), the hut's floor FLOOR_Y (70 cm under it, the hut on a 15 cm sleeper base), its eaves\n-- EAVES_Y (2.4 m over the ground).\n--\n-- Precision (design section 3 and 8): everything drawn stays within LIMIT studs of the origin on every axis, where a float's step is about 0.0005 studs.\n-- The preserve's far corners are 5,425 east, 4,575 west, 5,516 north and 484 south; the city beyond is drawn only as far as LIMIT, and its distant towers are\n-- impostors at the edge (World/PreserveLook says how).\n--\n-- What is here: ZONES, the drawn backdrop's pieces of the map, each streamed as one look (World/LookPlan: near at full, far as its cheap masses); HOME_RANGES,\n-- the ten home ranges of the design's table (only the hut's sill is walkable in Phase A); CORRIDORS, the ways between them; and the features every look places\n-- from (the oak, the pond, the paths, the wall, the hut).\nlocal Preserve = {}\n\n-- The shift: the window's middle and the hut's north face in metres, and the studs they become.\nPreserve.ORIGIN_X_M = 45.75\nPreserve.NORTH_FACE_M = 5.0\nPreserve.NORTH_FACE_Z = -16\nPreserve.GROUND_Y = -85\nPreserve.FLOOR_Y = -70\nPreserve.EAVES_Y = 155\nPreserve.LIMIT = 6000\n\n-- The preserve's own extent (metres): 100 by 60.\nPreserve.SIZE = table.freeze({ x = 100, z = 60 })\n\n-- Studs from metres: `xm` east, `zm` north, `ym` metres above the ground outside (0 by default).\nfunction Preserve.at(xm: number, zm: number, ym: number?): Vector3\n\treturn Vector3.new((xm - Preserve.ORIGIN_X_M) * 100, Preserve.GROUND_Y + (ym or 0) * 100, Preserve.NORTH_FACE_Z - (zm - Preserve.NORTH_FACE_M) * 100)\nend\n\n-- Metres from studs (the inverse of `at`): x east, z north, y over the ground.\nfunction Preserve.metres(p: Vector3): (number, number, number)\n\treturn p.X / 100 + Preserve.ORIGIN_X_M, Preserve.NORTH_FACE_M - (p.Z - Preserve.NORTH_FACE_Z) / 100, (p.Y - Preserve.GROUND_Y) / 100\nend\n\n-- A box in studs from a rectangle in metres (x0..x1 east, z0..z1 north) and heights in metres over the ground: `min, max`.\nfunction Preserve.box(x0: number, x1: number, z0: number, z1: number, y0: number, y1: number): (Vector3, Vector3)\n\tlocal a, b = Preserve.at(x0, z0, y0), Preserve.at(x1, z1, y1)\n\treturn Vector3.new(math.min(a.X, b.X), math.min(a.Y, b.Y), math.min(a.Z, b.Z)), Vector3.new(math.max(a.X, b.X), math.max(a.Y, b.Y), math.max(a.Z, b.Z))\nend\n\n-- ---------------------------------------------------------------- the zones of the backdrop\n-- Each zone is drawn only (Phase A: nothing in it can be walked) and streamed as one look. `x`, `z`: its rectangle in metres; `y`: how high its things stand\n-- over the ground, metres. Listed nearest the hut first (a tie in the plan's distance keeps this order).\nexport type Zone = { id: string, name: string, x: { number }, z: { number }, y: { number } }\nlocal function zone(id: string, name: string, x0: number, x1: number, z0: number, z1: number, y0: number, y1: number): Zone\n\treturn table.freeze({ id = id, name = name, x = table.freeze({ x0, x1 }), z = table.freeze({ z0, z1 }), y = table.freeze({ y0, y1 }) })\nend\nPreserve.ZONES = table.freeze({\n\tzone(\"hut\", \"The ranger hut\", 42, 52, -1, 7, -0.2, 3.6), -- (ROBLOX-118: and its back room east of it, to x 50.8 with the roof's overhang) -- the hut, the bench and water butt under its window, the info board and the bike rack by the gate\n\tzone(\"hut_garden\", \"The hut garden\", 38, 52, 6, 14, 0, 2.6), -- herb border, pallet planters, the bird feeder\n\tzone(\"bench\", \"The bench, bin and lamppost\", 43.5, 47, 10, 13.4, 0, 3.9), -- (ROBLOX-119: where the garden's path comes out at the meadow's edge, World/Meadow; it was x 37..43, z 14..18.5)\n\tzone(\"ground\", \"The ground and the paths\", 0, 100, 0, 60, -0.3, 1.9), -- the mown grass, the meadow's and the wood's floors, the paths, the boundary fences\n\tzone(\"meadow\", \"The wildflower meadow\", 24, 61, 17, 49, 0, 1.8),\n\tzone(\"pond\", \"The pond and the boardwalk\", 47, 67, 11.75, 28.75, -0.4, 2.6),\n\tzone(\"compost\", \"The compost bays and the tool shed\", 1, 9, 2, 10, 0, 2.9),\n\tzone(\"woodland\", \"The woodland and the veteran oak\", 0, 23, 5, 56, 0, 21),\n\tzone(\"wall\", \"The stone retaining wall\", 90, 100, 4, 56, 0, 1.7),\n\tzone(\"scrub\", \"The bramble and scrub\", 18, 92, 49, 60, 0, 3.4),\n\tzone(\"city_south\", \"The street, the railings and the gate\", -12, 105, -14.8, 0, 0, 12),\n\tzone(\"city_west\", \"The hedge and the canal towpath\", -14.2, 0, -14, 64, -1.5, 11),\n\tzone(\"city_east\", \"The backs of the apartment blocks\", 94, 105.7, -6, 62, 0, 19),\n\tzone(\"railway\", \"The railway embankment\", -14.2, 105.7, 60, 64.4, 0, 4.6),\n\tzone(\"towers\", \"The city's towers\", -14.2, 105.7, 64.4, 64.8, 0, 32),\n}) :: { Zone }\n\nlocal BY_ID: { [string]: Zone } = {}\nfor _, z in Preserve.ZONES do BY_ID[z.id] = z end\n\nfunction Preserve.zone(id: string): Zone?\n\treturn BY_ID[id]\nend\n\n-- A zone's box in studs: `min, max`.\nfunction Preserve.zoneBox(z: Zone): (Vector3, Vector3)\n\treturn Preserve.box(z.x[1], z.x[2], z.z[1], z.z[2], z.y[1], z.y[2])\nend\n\n-- ---------------------------------------------------------------- the home ranges (design section 4's table; only the first is walkable in Phase A)\n-- `n` the design's number, `zone` the backdrop zone it lies in, `at` its middle (metres x, z), `size` its core (metres across).\nexport type HomeRange = { n: number, id: string, name: string, zone: string, at: { number }, size: number }\nlocal function home(n: number, id: string, name: string, zoneId: string, x: number, z: number, size: number): HomeRange\n\treturn table.freeze({ n = n, id = id, name = name, zone = zoneId, at = table.freeze({ x, z }), size = size })\nend\nPreserve.HOME_RANGES = table.freeze({\n\thome(1, \"ranger_hut\", \"Ranger hut\", \"hut\", 45.75, 3.5, 3.5),\n\thome(2, \"hut_garden\", \"Hut garden\", \"hut_garden\", 45.75, 7, 4), -- (ROBLOX-116: in front of the north window, World/Hut's core: x 43.75..47.75, z 5..9)\n\thome(3, \"meadow\", \"Meadow\", \"meadow\", 45.15, 15.5, 5), -- (ROBLOX-119: the meadow's edge north of the bench patch, World/Meadow's core: x 42.65..47.65, z 16..21; it was 31, 40)\n\thome(4, \"pond_edge\", \"Pond edge\", \"pond\", 53, 15, 4), -- (ROBLOX-122: where the boardwalk runs along the pond's south shore, World/Pond's core: x 64..68, z 29.25..33.25; it was 77, 42)\n\thome(5, \"log_pile\", \"Log pile and woodland floor\", \"woodland\", 10, 29.5, 4),\n\thome(6, \"veteran_oak\", \"Veteran oak\", \"woodland\", 14, 42, 3),\n\thome(7, \"stone_wall\", \"Stone retaining wall\", \"wall\", 92, 50, 5),\n\thome(8, \"bench\", \"The bench, bin and lamppost\", \"bench\", 45.15, 11.5, 3), -- (ROBLOX-119: where the path comes out, World/Meadow's pad: x 43.65..46.65, z 13..16)\n\thome(9, \"bramble\", \"Bramble and railway bank\", \"scrub\", 80, 56, 4),\n\thome(10, \"compost\", \"Compost and tool shed\", \"compost\", 5, 6, 4),\n}) :: { HomeRange }\n\n-- ---------------------------------------------------------------- the corridors (design section 4: the ways between the home ranges)\n-- Polylines in metres (x, z); `kind` says what a spider walks there (Phase C onward). The mown paths are the preserve's plan's (docs/preserve_plan.html).\nexport type Corridor = { id: string, kind: string, points: { { number } }, width: number }\nlocal function corridor(id: string, kind: string, width: number, points: { { number } }): Corridor\n\tfor _, p in points do table.freeze(p) end\n\treturn table.freeze({ id = id, kind = kind, width = width, points = table.freeze(points) })\nend\nPreserve.CORRIDORS = table.freeze({\n\t-- the path from the gate past the hut, round the meadow and to the pond, and its cross path (mown grass and fine gravel, 1.4 m wide)\n\tcorridor(\"path_gate\", \"gravel\", 1.6, { { 45.5, 0 }, { 45.5, 1.4 } }), -- (from the gate to the hut's door, in its south wall)\n\t-- (ROBLOX-119: they leave the bench patch's gravel at its west and east edges, World/Meadow's pad, north of the garden's split-rail fence)\n\tcorridor(\"path_loop\", \"mown\", 0.4, { { 43.6, 12.3 }, { 42, 12.3 }, { 42, 18.2 }, { 46.9, 18.2 } }),\n\t-- (ROBLOX-122: walkable, World/Pond's mown_e1..e15 and mown_n1..n14: east from the bench patch's gravel along z 14.64 and north along x 61.15 to the boardwalk)\n\tcorridor(\"path_cross\", \"mown\", 1.4, { { 46.65, 11.64 }, { 48.15, 11.64 }, { 48.15, 13 } }),\n\t-- (round the hut's east end and in through the hut garden's core, World/Hut's gravel path: west along z 6.71 and north along x 45.15, 0.5 to 0.6 m wide; its points\n\t-- break at the core's edges, x 47.75 and z 9, ROBLOX-116. ROBLOX-117: walkable round the east end too, World/Hut.WALK: along the south wall's foot at z 1.67 from\n\t-- the door, north along x 48.4 and in at z 6.55)\n\t-- (ROBLOX-118: round the back room's east end instead, along x 51.35, World/Hut.WALK)\n\tcorridor(\"path_hut\", \"gravel\", 0.6, { { 45.5, 1.67 }, { 51.35, 1.67 }, { 51.35, 6.55 }, { 47.75, 6.55 }, { 45.15, 6.55 }, { 45.15, 9 }, { 45.15, 10 } }),\n\tcorridor(\"boardwalk\", \"boardwalk\", 1.5, { { 47.65, 13.75 }, { 55, 13.75 } }), -- (ROBLOX-122: walkable from its west end to x 68, World/Pond's walk_* and deck_*)\n\tcorridor(\"path_wall\", \"mown\", 1.2, { { 79, 30 }, { 90, 30 } }),\n\tcorridor(\"hedge_base\", \"hedge\", 0.8, { { 0.6, 1 }, { 0.6, 59 } }),\n\tcorridor(\"wall_top\", \"stone\", 0.5, { { 93, 5 }, { 93, 55 } }),\n\tcorridor(\"fence_rail\", \"fence\", 0.1, { { 0, 60 }, { 100, 60 } }),\n\tcorridor(\"hut_gutter\", \"gutter\", 0.12, { { 44, 5.2 }, { 47.5, 5.2 } }),\n}) :: { Corridor }\n\n-- ---------------------------------------------------------------- features the looks place from (metres)\nPreserve.HUT = table.freeze({ x = table.freeze({ 44, 47.5 }), z = table.freeze({ 2, 5 }), wall = 0.285 }) -- a log hut: walls 28.5 cm, the sill's reveal\n-- (ROBLOX-118) the volunteers' back room, built on against the hut's east end: its logs to x 50.485, the hut's roof carried on over it\nPreserve.BACK_ROOM = table.freeze({ x = table.freeze({ 47.5, 50.485 }), z = table.freeze({ 2, 5 }) })\nPreserve.GATE = table.freeze({ x = table.freeze({ 44.3, 46.9 }), z = 0 })\nPreserve.OAK = table.freeze({ x = 14, z = 42, trunk = 1.3, height = 19.5, crown = 22 }) -- a bur oak: trunk 1.3 m across, 19.5 m tall, its crown 22 m across\nPreserve.POND = table.freeze({ x = 57, z = 20.75, rx = 8, rz = 7 })\nPreserve.MEADOW = table.freeze({ x = table.freeze({ 25, 60 }), z = table.freeze({ 18, 48 }) })\nPreserve.WALL = table.freeze({ x = table.freeze({ 92, 94 }), z = table.freeze({ 5, 55 }), height = 1.2 })\nPreserve.BENCH = table.freeze({ x = 45.05, z = 12.55 }) -- (ROBLOX-119: the bench's middle, World/Meadow.BENCH; it was x 40, z 16)\nPreserve.LOG_PILE = table.freeze({ x = table.freeze({ 8, 12 }), z = table.freeze({ 28, 31 }) })\nPreserve.COMPOST = table.freeze({ x = table.freeze({ 2, 8 }), z = table.freeze({ 3, 9 }) })\nPreserve.HUT_GARDEN = table.freeze({ x = table.freeze({ 38, 52 }), z = table.freeze({ 6, 14 }) })\nPreserve.SCRUB = table.freeze({ x = table.freeze({ 18, 92 }), z = table.freeze({ 50, 60 }) })\n-- the railway: the embankment's foot at z 60 (the preserve's fence), its crest 3 m up at z 62.6, the track's middle at z 63.4\nPreserve.RAILWAY = table.freeze({ foot = 60, crest = 62.6, height = 3.0, track = 63.4, gauge = 1.435, x = table.freeze({ -14.2, 105.7 }) })\n\nreturn table.freeze(Preserve)\n",12259,4185112678},{"Shared/World/PreserveLook","--!strict\n-- The preserve's backdrop (ROBLOX-115, docs/PARK_WORLD_DESIGN.md sections 4, 7 and 10): every zone of World/Preserve drawn, and nothing of it walkable. Pure data\n-- (World/Garden's drawn records, one part each, built by Habitat/Scenery.look on each client by Client/LookStream), placed from the zone's own seed by\n-- Park-Miller streams, so a zone is the same forever on the server, on every client and in the CLI tests.\n--\n-- An American preserve in late summer (design section 10): a bur oak as the veteran, red and sugar maples and a black cherry at the woodland's edge, a meadow of\n-- big bluestem, switchgrass and goldenrod with coneflower, milkweed and black-eyed Susan, cattails at the pond, bramble and scrub on the railway bank, a stone\n-- retaining wall in the sun, a log ranger hut by the gate, chain-link along the railway, iron railings on the street, the backs of brick apartment blocks to the\n-- east and the canal's towpath beyond a hedge to the west. True scale: every size is the real thing's (metres in the data, studs drawn, World/Preserve.at).\n--\n-- Levels (World/LookPlan): a record with `far` is in the zone's far look, the cheap masses a client holds for every zone wherever its spider is; `full` records\n-- the low tier never draws (a far record that is also `full` is in the far look at the full tier only). Near the spider a zone is drawn whole at its tier: at the\n-- full tier every record, at the low tier every record without `full`. So the far preserve is its masses (the ground, the trees' crowns, the meadow's grass and\n-- drifts of flowers, the water, the hut, the city's blocks) and a zone close by gains its detail (the log courses, the slats, the posts, the heads of the\n-- cattails). BUDGETS are the ceilings each zone keeps to (tests/worldmap.luau holds them).\n--\n-- Precision: every record lies within World/Preserve.LIMIT of the origin (tests/worldmap.luau checks every corner), so the city stops at the edge; its towers\n-- are impostors there, each drawn the size a real tower about 600 m off would look from the hut (a 100 m tower drawn 12 m tall 60 m away): honest from the hut\n-- and the meadow, and said so here because from the railway bank they would read as nearer and smaller than they are.\nlocal Preserve = require(script.Parent.Preserve)\nlocal Meadow = require(script.Parent.Meadow) -- (ROBLOX-119: the bench patch's backdrop stands in for its walkable boxes)\nlocal Pond = require(script.Parent.Pond) -- (ROBLOX-122: the pond's water at its true level round the walkable edge)\n\nlocal PreserveLook = {}\n\nexport type Drawn = {\n\tid: string, size: Vector3, at: Vector3, color: Color3, transparency: number?,\n\tmaterial: string?, shape: string?, turn: Vector3?, full: boolean?, group: string?, shadow: boolean?,\n\tfar: boolean?, reflectance: number?, dew: number?,\n}\n\n-- The ceilings per zone: every record (`full`), the low tier's (`low`), the far look at the full tier (`far`) and at the low tier (`farLow`).\nPreserveLook.BUDGETS = table.freeze({\n\thut = { full = 170, low = 80, far = 50, farLow = 44 },\n\thut_garden = { full = 230, low = 50, far = 30, farLow = 24 },\n\tbench = { full = 24, low = 14, far = 8, farLow = 8 }, -- (ROBLOX-119: the walkable patch's stand-ins)\n\tground = { full = 90, low = 64, far = 64, farLow = 62 },\n\tmeadow = { full = 140, low = 70, far = 110, farLow = 64 },\n\tpond = { full = 140, low = 40, far = 30, farLow = 24 }, -- (ROBLOX-122: 140, the bank's strips round the walkable edge, the full tier's)\n\tcompost = { full = 40, low = 26, far = 16, farLow = 16 },\n\twoodland = { full = 90, low = 70, far = 64, farLow = 52 },\n\twall = { full = 70, low = 40, far = 30, farLow = 30 },\n\tscrub = { full = 46, low = 30, far = 34, farLow = 30 },\n\tcity_south = { full = 190, low = 96, far = 80, farLow = 80 },\n\tcity_west = { full = 40, low = 34, far = 26, farLow = 24 },\n\tcity_east = { full = 130, low = 30, far = 40, farLow = 30 },\n\trailway = { full = 60, low = 52, far = 40, farLow = 40 },\n\ttowers = { full = 24, low = 14, far = 16, farLow = 12 },\n}) :: { [string]: { full: number, low: number, far: number, farLow: number } }\n\n-- The palette: hex colours by what they are.\nlocal C = {\n\tmown = \"6c8a45\", mownStripe = \"7f9c52\", meadowFloor = \"8f8a55\", woodFloor = \"5d5438\", scrubFloor = \"566238\", gravel = \"b9ab8c\", mud = \"5a4a36\",\n\tgrass = { \"8d8a4f\", \"9a9156\", \"7c7a52\", \"8a6f4a\", \"a0955c\", \"77804a\", \"6f8248\", \"93864e\" }, -- big bluestem bronze, switchgrass straw, green\n\tflowers = { goldenrod = \"d4b23a\", coneflower = \"b36a8f\", milkweed = \"c48a96\", susan = \"e0a92a\", lace = \"e8e4d4\", bergamot = \"a88bb0\" },\n\toakBark = \"5a5046\", oakCrown = { \"4a6a34\", \"3f5d2f\", \"557a3c\", \"46663a\" },\n\tmapleBark = \"6b6258\", mapleCrown = { \"5f8a3e\", \"6a9446\", \"56803a\", \"6e8f40\" },\n\tcherryBark = \"3c302b\", cherryCrown = { \"41612f\", \"4b6b35\" },\n\tshrub = { \"4c6a35\", \"567a3c\", \"3f5a2e\" },\n\tbramble = { \"3d5a2c\", \"4a6533\", \"34482a\", \"44602f\", \"52693a\" }, ivy = \"2f4a2a\",\n\twater = \"3e5a5a\", reed = { \"6d7a43\", \"7c8650\", \"667242\" }, cattail = \"5a3d27\", lily = \"4f7a3a\",\n\tlimestone = { \"b8ae9c\", \"a69c8a\", \"c4baa7\", \"b0a592\", \"9e9482\" },\n\tlog = \"5c4531\", logDark = \"3f2e20\", lining = \"c8a77a\", floor = \"a07c55\", ceiling = \"cdb08a\", trim = \"3f5a43\", roof = \"3b4f40\", glass = \"26323a\",\n\tconcrete = \"8a867d\", board = \"8a7458\", boardDark = \"6f5d47\", soil = \"4a3b2c\",\n\therbs = { \"8a9a7a\", \"6d7f55\", \"5c8a45\", \"7a8f5e\", \"5f7d3a\" }, herbFlowers = { \"8a7fa8\", \"a88bb0\", \"b04a5c\", \"e6dfcf\" },\n\tballast = \"7c776e\", rail = \"5a5651\", sleeper = \"4a3d33\", bank = \"748a4b\",\n\tbrick = { \"8f5a46\", \"a06b52\", \"7d6a5c\", \"94604a\" }, window = \"2f3a44\", balcony = \"b9b4ab\",\n\tasphalt = \"4a4b4d\", pavement = \"a9a69e\", railing = \"1f2224\", shop = { \"b38e6a\", \"8c7f74\", \"9a5b48\", \"a99a86\", \"7f6a5a\", \"b5a48c\" },\n\ttower = { \"9aa6b4\", \"a8b2bd\", \"8e9aab\", \"b3b9c0\", \"97a3ae\", \"a2acb6\" }, hedge = \"3f5a31\", canal = \"455c5c\", coping = \"9c978c\",\n\tmetal = \"8d9196\", black = \"2a2c2e\", bin = \"3d4a3e\", lamp = \"f1e3b8\",\n}\n\nlocal MOD = 2147483647\nlocal function rng(seed: number, salt: number): () -> number\n\tlocal state = (seed + salt * 7919) % MOD\n\tif state <= 0 then state += MOD - 1 end\n\treturn function(): number\n\t\tstate = (state * 16807) % MOD\n\t\treturn (state - 1) / (MOD - 1)\n\tend\nend\nlocal function between(rand: () -> number, a: number, b: number): number\n\treturn a + (b - a) * rand()\nend\nlocal function pick<T>(list: { T }, rand: () -> number): T\n\treturn list[1 + math.floor(rand() * #list)]\nend\n\nlocal M = Preserve.at\nlocal GROUND = Preserve.GROUND_Y\n\n-- ---------------------------------------------------------------- the record makers\n-- Each appends to a zone's list. Flags: `far` (in the far look), `full` (the low tier drops it), and a few looks (transparency, reflectance, shadow).\ntype Flags = { far: boolean?, full: boolean?, transparency: number?, reflectance: number?, shadow: boolean?, group: string? }\ntype List = { Drawn }\n\nlocal function add(out: List, id: string, size: Vector3, at: Vector3, color: string, material: string, f: Flags?, shape: string?, turn: Vector3?)\n\tlocal flags: Flags = f or {}\n\ttable.insert(out, {\n\t\tid = id, size = size, at = at, color = Color3.fromHex(color), material = material, shape = shape, turn = turn,\n\t\tfar = flags.far, full = flags.full, transparency = flags.transparency, reflectance = flags.reflectance, shadow = flags.shadow, group = flags.group,\n\t})\nend\n\n-- An upright box from a rectangle in metres and heights in metres over the ground.\nlocal function block(out: List, id: string, x0: number, x1: number, z0: number, z1: number, y0: number, y1: number, color: string, material: string, f: Flags?)\n\tlocal lo, hi = Preserve.box(x0, x1, z0, z1, y0, y1)\n\tadd(out, id, hi - lo, (lo + hi) * 0.5, color, material, f)\nend\n\n-- An upright box in studs (the hut's own frame: the sill's studs).\nlocal function sblock(out: List, id: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: string, material: string, f: Flags?)\n\tadd(out, id, Vector3.new(x1 - x0, y1 - y0, z1 - z0), Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, f)\nend\n\n-- An ellipsoid at (x, z) metres, its middle `y` metres over the ground, `w` across (east-west), `h` tall and `d` deep (north-south), metres.\nlocal function blob(out: List, id: string, x: number, z: number, y: number, w: number, h: number, d: number, color: string, f: Flags?, yaw: number?)\n\tadd(out, id, Vector3.new(w * 100, h * 100, d * 100), M(x, z, y), color, \"LeafyGrass\", f, \"Ellipsoid\", if yaw then Vector3.new(0, yaw, 0) else nil)\nend\n\n-- An upright cylinder at (x, z) metres from `y0` to `y1` metres over the ground, `dia` metres across.\nlocal function post(out: List, id: string, x: number, z: number, y0: number, y1: number, dia: number, color: string, material: string, f: Flags?)\n\tlocal a = M(x, z, (y0 + y1) / 2)\n\tadd(out, id, Vector3.new((y1 - y0) * 100, dia * 100, dia * 100), a, color, material, f, \"Cylinder\", Vector3.new(0, 0, 90))\nend\n\n-- A rod (a cylinder) from a to b in studs, `dia` studs across: logs, limbs, rails.\nlocal function rod(out: List, id: string, a: Vector3, b: Vector3, dia: number, color: string, material: string, f: Flags?)\n\tlocal d = b - a\n\tlocal len = d.Magnitude\n\tlocal u = d / len\n\tlocal theta = math.deg(math.asin(math.clamp(u.Y, -1, 1)))\n\tlocal phi = math.deg(math.atan2(-u.Z, u.X))\n\tadd(out, id, Vector3.new(len, dia, dia), (a + b) * 0.5, color, material, f, \"Cylinder\", Vector3.new(0, phi, theta))\nend\n\n-- A flat strip along the ground from (x0, z0) to (x1, z1) metres, `w` metres wide, `t` studs thick, its top `top` studs over the ground.\nlocal function strip(out: List, id: string, x0: number, z0: number, x1: number, z1: number, w: number, top: number, t: number, color: string, material: string, f: Flags?)\n\tlocal a, b = M(x0, z0), M(x1, z1)\n\tlocal d = b - a\n\tlocal len = d.Magnitude\n\tlocal yaw = math.deg(math.atan2(-d.Z, d.X)) -- (about Y: the strip's length along X turned onto the segment)\n\tlocal mid = (a + b) * 0.5\n\tadd(out, id, Vector3.new(len + w * 100 * 0.5, t, w * 100), Vector3.new(mid.X, GROUND + top - t / 2, mid.Z), color, material, f, nil, Vector3.new(0, yaw, 0))\nend\n\n-- A tree: a trunk and a crown of overlapping masses. `crown` metres across, `height` metres to the crown's top, `bole` metres of clear trunk; `n` crown masses.\nlocal function tree(out: List, id: string, rand: () -> number, x: number, z: number, height: number, crown: number, bole: number, trunk: number, bark: string,\n\tleaves: { string }, n: number, nFar: number, lowKeeps: number)\n\tpost(out, id .. \"_trunk\", x, z, 0, bole + (height - bole) * 0.45, trunk, bark, \"Wood\", { far = true })\n\tlocal mid = bole + (height - bole) * 0.5\n\tfor k = 1, n do\n\t\tlocal ang = (k - 1) / n * 2 * math.pi + between(rand, -0.4, 0.4)\n\t\tlocal r = if k == 1 then 0 else crown * between(rand, 0.18, 0.34)\n\t\tlocal w = crown * (if k == 1 then 0.62 else between(rand, 0.42, 0.56))\n\t\tlocal h = (height - bole) * (if k == 1 then 0.78 else between(rand, 0.48, 0.66))\n\t\tlocal y = if k == 1 then mid + (height - bole) * 0.06 else mid + between(rand, -0.16, 0.24) * (height - bole)\n\t\ty = math.min(y, height - h / 2)\n\t\tblob(out, `{id}_crown{k}`, x + math.cos(ang) * r, z + math.sin(ang) * r, y, w, h, w * between(rand, 0.85, 1.1), pick(leaves, rand),\n\t\t\t{ far = k <= nFar, full = k > lowKeeps })\n\tend\nend\n\n-- ---------------------------------------------------------------- the ranger hut (studs: the hut is built round the sill, whose frame is the origin)\n-- A log hut 3.5 by 3 m (x -175..175, z -16..284), its walls 28.5 cm thick (the sill's reveal: the cladding's face at z -16, the lining's at 12.5), its floor\n-- 15 cm over the ground on a sleeper base, its eaves 2.4 m over the ground, a gable roof of green standing-seam metal at 35 degrees with its ridge east-west,\n-- 30 cm of overhang; the window with the sill in its north wall (drawn by the sill's Decor: its frame, glass and reveal to the frame's 14), a door in the south\n-- wall to the gate, a small window in each end wall. Under the north window, a bench and a water butt fed from the gutter (the design's steps up to the sill).\nlocal HX, HZ0, HZ1, HT = 175, -16, 284, 28.5 -- the hut's half width, its north and south faces, its walls' thickness\n-- (ROBLOX-118) the volunteers' back room built on against the hut's east end (World/Hut.BACK): the building runs from -HX to HE, the hut's old east logs between the\n-- two rooms with a doorway cut through them, the roof carried on over it; the back room's window in its east end over the radiator\nlocal HE = 473.5\nlocal BX0, BX1 = 175, 445 -- the back room between its linings\nlocal DWZ, DW_HEAD = { 180, 250 }, 135 -- the doorway between the rooms\nlocal RW = { z0 = 98, z1 = 170, y1 = 112.5, glass = 459 } -- the back room's window\nlocal FLOOR, EAVES, CEIL = Preserve.FLOOR_Y, Preserve.EAVES_Y, 150\nlocal PITCH = 35\nlocal OVER = 30\nlocal WIN = { x = 31, top = 112.5 } -- the sill's window: x -31..31, the sill (y 0) to its head\n-- (ROBLOX-116) the door in its doorway (World/Hut.DOOR: x -45..45, the leaf between z 258 and 262) and its head; and how far a drawn face stands behind the walkable\n-- box's face it stands in for\nlocal DOOR = { x = 45, leaf = { 258, 262 } }\nlocal DOOR_HEAD = 135\nlocal REC = 0.2\nlocal function hutDecor(out: List, rand: () -> number)\n\tlocal CL = 2.5 -- cladding and lining thickness\n\tlocal ix, iz0, iz1 = HX - HT, HZ0 + HT, HZ1 - HT -- the inside: x -146.5..146.5, z 12.5..255.5\n\t-- (ROBLOX-116: the hut's inside to WALL_TOP, the north wall outside to OUT_TOP, the outer sill, the door, the bench and the water butt are walkable boxes now,\n\t-- World/Hut, each its own look. What of the hut is drawn here where those boxes are stands a hair (REC studs) behind their faces: the boxes hide it when\n\t-- they are there, and it stands in for them where streaming has not sent them, from far across the preserve. ROBLOX-118: so do the ceiling, the walls to it, the\n\t-- back room, the north face to the eaves and the eaves themselves.)\n\tlocal R = REC\n\t-- the base and the floors\n\tsblock(out, \"Base\", -HX - 3 + R, HE + 3 - R, GROUND, FLOOR - R, HZ0 - 3 + R, HZ1 + 3 - R, C.concrete, \"Concrete\", { far = true })\n\tsblock(out, \"Floor\", -ix, ix, FLOOR - 2 - R, FLOOR - R, iz0, iz1, C.floor, \"WoodPlanks\")\n\tsblock(out, \"FloorBack\", BX0, BX1, FLOOR - 2 - R, FLOOR - R, iz0, iz1, C.floor, \"WoodPlanks\")\n\tsblock(out, \"Ceiling\", -ix, ix, CEIL + R, CEIL + 2 + R, iz0, iz1, C.ceiling, \"WoodPlanks\")\n\tsblock(out, \"CeilingBack\", BX0, BX1, CEIL + R, CEIL + 2 + R, iz0, iz1, C.ceiling, \"WoodPlanks\")\n\t-- the north wall: the cladding round the window and the linings inside it\n\tsblock(out, \"NorthWest\", -HX, -WIN.x, FLOOR, EAVES, HZ0 + R, HZ0 + CL, C.log, \"Wood\", { far = true, shadow = true })\n\tsblock(out, \"NorthEast\", WIN.x, HE, FLOOR, EAVES, HZ0 + R, HZ0 + CL, C.log, \"Wood\", { far = true, shadow = true })\n\tsblock(out, \"NorthBelow\", -WIN.x, WIN.x, FLOOR, -4, HZ0 + R, HZ0 + CL, C.log, \"Wood\", { far = true })\n\tsblock(out, \"NorthAbove\", -WIN.x, WIN.x, WIN.top, EAVES, HZ0 + R, HZ0 + CL, C.log, \"Wood\", { far = true })\n\tsblock(out, \"OuterSill\", -36 + R, 36 - R, -4 + R, -R, -22 + R, HZ0 + CL, C.board, \"Wood\", { far = true }) -- the window's outer sill, its top level with the sill's\n\tsblock(out, \"LiningWest\", -ix, -WIN.x, FLOOR, CEIL, iz0 - CL, iz0 - R, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningEast\", WIN.x, ix, FLOOR, CEIL, iz0 - CL, iz0 - R, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningBelow\", -WIN.x, WIN.x, FLOOR, -1, iz0 - CL, iz0 - R, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningAbove\", -WIN.x, WIN.x, WIN.top + 1, CEIL, iz0 - CL, iz0 - R, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningNorthBack\", BX0, BX1, FLOOR, CEIL, iz0 - CL, iz0 - R, C.lining, \"WoodPlanks\")\n\t-- (the window's reveal over the sill's side frames and its head are World/Hut's hut_window)\n\t-- the green casing round the window outside\n\t-- (ROBLOX-116: at both tiers now: the walkable casing's boxes go only to the hut's walls' height, and the window would have none above them on the low tier)\n\tsblock(out, \"CasingWest\", -37 + R, -31 - R, -4, WIN.top + 6 - R, HZ0 - 1.2 + R, HZ0, C.trim, \"WoodPlanks\", { far = true })\n\tsblock(out, \"CasingEast\", 31 + R, 37 - R, -4, WIN.top + 6 - R, HZ0 - 1.2 + R, HZ0, C.trim, \"WoodPlanks\", { far = true })\n\tsblock(out, \"CasingHead\", -37 + R, 37 - R, WIN.top + R, WIN.top + 6 - R, HZ0 - 1.2 + R, HZ0, C.trim, \"WoodPlanks\", { far = true, full = true })\n\t-- the other walls: cladding outside, lining inside; the south wall round the doorway (x -45..45, to DOOR_HEAD)\n\tsblock(out, \"South\", -HX, -DOOR.x - R, FLOOR, EAVES, HZ1 - CL, HZ1, C.log, \"Wood\", { far = true })\n\tsblock(out, \"SouthEast\", DOOR.x + R, HE, FLOOR, EAVES, HZ1 - CL, HZ1, C.log, \"Wood\", { far = true })\n\tsblock(out, \"SouthAbove\", -DOOR.x - R, DOOR.x + R, DOOR_HEAD, EAVES, HZ1 - CL, HZ1, C.log, \"Wood\", { far = true })\n\tsblock(out, \"West\", -HX, -HX + CL, FLOOR, EAVES, HZ0, HZ1, C.log, \"Wood\", { far = true })\n\t-- the back room's east end, round its window\n\tsblock(out, \"EastLow\", HE - CL, HE, FLOOR, 0, HZ0, HZ1, C.log, \"Wood\", { far = true })\n\tsblock(out, \"EastHigh\", HE - CL, HE, RW.y1, EAVES, HZ0, HZ1, C.log, \"Wood\", { far = true })\n\tsblock(out, \"EastNorth\", HE - CL, HE, 0, RW.y1, HZ0, RW.z0, C.log, \"Wood\", { far = true })\n\tsblock(out, \"EastSouth\", HE - CL, HE, 0, RW.y1, RW.z1, HZ1, C.log, \"Wood\", { far = true })\n\tsblock(out, \"LiningSouth\", -ix, -DOOR.x - R, FLOOR, CEIL, iz1 + R, iz1 + CL, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningSouthEast\", DOOR.x + R, ix, FLOOR, CEIL, iz1 + R, iz1 + CL, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningSouthAbove\", -DOOR.x - R, DOOR.x + R, DOOR_HEAD, CEIL, iz1, iz1 + CL, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningSouthBack\", BX0, BX1, FLOOR, CEIL, iz1 + R, iz1 + CL, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningWestWall\", -ix - CL, -ix - R, FLOOR, CEIL, iz0, iz1, C.lining, \"WoodPlanks\")\n\t-- the hut's old east logs between the rooms, lined on both faces, the doorway cut through them\n\tfor k, side in { { ix + R, ix + CL }, { BX0 - CL, BX0 - R } } do\n\t\tsblock(out, `Partition{k}a`, side[1], side[2], FLOOR, CEIL, iz0, DWZ[1], C.lining, \"WoodPlanks\")\n\t\tsblock(out, `Partition{k}b`, side[1], side[2], FLOOR, CEIL, DWZ[2], iz1, C.lining, \"WoodPlanks\")\n\t\tsblock(out, `Partition{k}c`, side[1], side[2], DW_HEAD + R, CEIL, DWZ[1], DWZ[2], C.lining, \"WoodPlanks\")\n\tend\n\t-- the back room's east lining round its window (the sill, the reveals and the head are World/Hut's room_window)\n\tsblock(out, \"LiningBackEastLow\", BX1 + R, BX1 + CL, FLOOR, -3, iz0, iz1, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningBackEastHigh\", BX1 + R, BX1 + CL, 115, CEIL, iz0, iz1, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningBackEastN\", BX1 + R, BX1 + CL, -3, 115, iz0, 93.5, C.lining, \"WoodPlanks\")\n\tsblock(out, \"LiningBackEastS\", BX1 + R, BX1 + CL, -3, 115, 174.5, iz1, C.lining, \"WoodPlanks\")\n\t-- the door, set in its doorway (World/Hut's hut_door: its leaf the walkable box to the regions' height, the gap under it a spider's way out), the doorway's\n\t-- reveal, and the end windows: the hut's west window, both faces, and the back room's in its east end\n\tsblock(out, \"Door\", -DOOR.x + R, DOOR.x - R, FLOOR + 1.5, DOOR_HEAD - R, DOOR.leaf[1] + R, DOOR.leaf[2] - R, C.trim, \"WoodPlanks\", { far = true })\n\tsblock(out, \"DoorHead\", -DOOR.x, DOOR.x, DOOR_HEAD + R, DOOR_HEAD + 2, iz1 + R, HZ1, C.lining, \"WoodPlanks\")\n\tsblock(out, \"RevealWestDoor\", -DOOR.x - 1, -DOOR.x - R, 30, DOOR_HEAD, iz1 + R, HZ1, C.lining, \"WoodPlanks\")\n\tsblock(out, \"RevealEastDoor\", DOOR.x + R, DOOR.x + 1, 30, DOOR_HEAD, iz1 + R, HZ1, C.lining, \"WoodPlanks\")\n\tsblock(out, \"DoorHandle\", 30, 36, 60, 64, DOOR.leaf[2], DOOR.leaf[2] + 2.5, C.black, \"Metal\", { full = true })\n\tsblock(out, \"DoorHandleIn\", 30, 36, 60, 64, DOOR.leaf[1] - 2.5, DOOR.leaf[1], C.black, \"Metal\", { full = true })\n\tsblock(out, \"EndWindow1\", -HX - 1, -HX, 30, 100, 105, 165, C.glass, \"SmoothPlastic\", { far = true, reflectance = 0.2 })\n\tsblock(out, \"EndWindowIn1\", -ix, -ix + 1, 30, 100, 105, 165, C.glass, \"SmoothPlastic\", { reflectance = 0.15 })\n\tsblock(out, \"EndCasing1\", -HX - 1.5, -HX, 24, 106, 99, 171, C.trim, \"WoodPlanks\", { full = true })\n\tsblock(out, \"EndWindow2\", RW.glass + R, RW.glass + 1 - R, 5, RW.y1, RW.z0, RW.z1, C.glass, \"Glass\", { far = true, reflectance = 0.08, transparency = .85 })\n\t-- A casing surrounds the opening; a single box here used to conceal the\n\t-- entire window. Keep all four rails outside the actual five-cm crack.\n\tsblock(out, \"EndCasing2Low\", HE, HE + 1.5, -6, 0, RW.z0 - 6, RW.z1 + 6, C.trim, \"WoodPlanks\", { far = true })\n\tsblock(out, \"EndCasing2High\", HE, HE + 1.5, RW.y1, RW.y1 + 6, RW.z0 - 6, RW.z1 + 6, C.trim, \"WoodPlanks\", { far = true })\n\tsblock(out, \"EndCasing2North\", HE, HE + 1.5, 0, RW.y1, RW.z0 - 6, RW.z0, C.trim, \"WoodPlanks\", { far = true })\n\tsblock(out, \"EndCasing2South\", HE, HE + 1.5, 0, RW.y1, RW.z1, RW.z1 + 6, C.trim, \"WoodPlanks\", { far = true })\n\t-- the gable ends: each half a box turned to the roof's pitch, its corner at the eave (it stays inside the wall's outline and under the roof)\n\tlocal p = math.rad(PITCH)\n\tlocal run = (HZ1 - HZ0) / 2\n\tlocal L, D = run / math.cos(p), run * math.sin(p) + 2\n\tfor i, x in { -HX + CL / 2, HE - CL / 2 } do\n\t\tfor j, side in { 1, -1 } do -- the north half (rising southward from the north eave) and the south half\n\t\t\tlocal ez = if side == 1 then HZ0 else HZ1\n\t\t\tlocal uy, uz = math.sin(p), side * math.cos(p)\n\t\t\tlocal vy, vz = -math.cos(p), side * math.sin(p)\n\t\t\tlocal cy = EAVES + uy * L / 2 + vy * D / 2\n\t\t\tlocal cz = ez + uz * L / 2 + vz * D / 2\n\t\t\tadd(out, `Gable{i}_{j}`, Vector3.new(CL - 0.4, D, L), Vector3.new(x, cy, cz), C.log, \"Wood\", { far = true }, nil, Vector3.new(-side * PITCH, 0, 0))\n\t\tend\n\tend\n\t-- the roof: two slopes of green standing-seam metal over both rooms, the ridge cap; under the north eave the soffit, the fascia and the gutter (World/Hut's\n\t-- walkable eaves, ROBLOX-118; drawn a hair inside them), and the downpipe into the water butt\n\tlocal ridgeY = EAVES + run * math.tan(p)\n\tlocal mx, len = (HE - HX) / 2, HE + HX + 2 * OVER\n\tfor j, side in { 1, -1 } do\n\t\tlocal ez = if side == 1 then HZ0 else HZ1\n\t\tlocal slope = (run + OVER) / math.cos(p)\n\t\tlocal nY, nZ = math.cos(p), -side * math.sin(p) -- the slope's outward normal\n\t\tlocal midRun = (run - OVER) / 2 -- from the eave line toward the ridge, flat\n\t\tlocal cy = EAVES + midRun * math.tan(p) + nY * 4\n\t\tlocal cz = ez + side * midRun + nZ * 4\n\t\tadd(out, \"Roof\" .. j, Vector3.new(len, 5, slope), Vector3.new(mx, cy, cz), C.roof, \"Metal\", { far = true, shadow = true }, nil, Vector3.new(-side * PITCH, 0, 0))\n\tend\n\tsblock(out, \"Ridge\", -HX - OVER, HE + OVER, ridgeY + 4, ridgeY + 10, (HZ0 + HZ1) / 2 - 7, (HZ0 + HZ1) / 2 + 7, C.roof, \"Metal\", { far = true })\n\tlocal ex0, ex1 = -HX - OVER, HE + OVER\n\tsblock(out, \"Soffit\", ex0, ex1, 133 + R, 135 - R, -46 + R, HZ0 - R, C.trim, \"WoodPlanks\", { far = true })\n\tsblock(out, \"Fascia\", ex0, ex1, 121 + R, 135 - R, -48 + R, -46 - R, C.trim, \"WoodPlanks\", { far = true })\n\tsblock(out, \"GutterFloor\", ex0, ex1, 121 + R, 122.5 - R, -60 + R, -48 - R, C.metal, \"Metal\", { far = true })\n\tsblock(out, \"GutterLip\", ex0, ex1, 121 + R, 131 - R, -61.5 + R, -60 - R, C.metal, \"Metal\", { far = true })\n\tadd(out, \"Downpipe\", Vector3.new(121 - 30, 7, 7), Vector3.new(130, (121 + 30) / 2, -54), C.metal, \"Metal\", { full = true }, \"Cylinder\", Vector3.new(0, 0, 90))\n\t-- the water butt on its stand of blocks, and the bench under the window (ROBLOX-116: World/Hut's hut_butt and hut_bench, walkable; drawn here a hair inside them)\n\tlocal G = GROUND + 0.4\n\tsblock(out, \"ButtStand\", 100 + R, 160 - R, G, -66 - R, -75 + R, -21 - R, C.concrete, \"Concrete\")\n\tsblock(out, \"WaterButt\", 101 + R, 159 - R, -66, 26 - R, -77 + R, -19 - R, \"3e5d44\", \"SmoothPlastic\", { far = true })\n\tsblock(out, \"ButtLid\", 99 + R, 161 - R, 26 + R, 28.5 - R, -79 + R, -19 - R, \"2f4734\", \"SmoothPlastic\", { far = true, full = true })\n\tsblock(out, \"BenchSeat\", -85 + R, 45 - R, -44 + R, -40 - R, -58 + R, -16 - R, C.board, \"WoodPlanks\", { far = true })\n\tsblock(out, \"BenchLegWest\", -80 + R, -74 - R, G, -44 - R, -55 + R, -22 - R, C.boardDark, \"Wood\")\n\tsblock(out, \"BenchLegEast\", 33 + R, 39 - R, G, -44 - R, -55 + R, -22 - R, C.boardDark, \"Wood\")\n\t-- the log courses: a shadow line every 20 cm on the four faces (the window and the door break theirs); the corners' log ends\n\tlocal y = FLOOR + 18\n\tlocal row = 0\n\twhile y < EAVES - 4 do\n\t\trow += 1\n\t\tlocal function line(id: string, x0: number, x1: number, z0: number, z1: number)\n\t\t\tsblock(out, id, x0, x1, y - 0.6, y + 0.6, z0, z1, C.logDark, \"Wood\", { full = true })\n\t\tend\n\t\tif y > -4 and y < WIN.top + 6 then\n\t\t\tline(`CourseN{row}a`, -HX, -37, HZ0 - 0.4, HZ0)\n\t\t\tline(`CourseN{row}b`, 37, HE, HZ0 - 0.4, HZ0)\n\t\telse\n\t\t\tline(`CourseN{row}`, -HX, HE, HZ0 - 0.4, HZ0)\n\t\tend\n\t\tif y < 135 then\n\t\t\tline(`CourseS{row}a`, -HX, -45, HZ1, HZ1 + 0.4)\n\t\t\tline(`CourseS{row}b`, 45, HE, HZ1, HZ1 + 0.4)\n\t\telse\n\t\t\tline(`CourseS{row}`, -HX, HE, HZ1, HZ1 + 0.4)\n\t\tend\n\t\tline(`CourseW{row}`, -HX - 0.4, -HX, HZ0, HZ1)\n\t\tif y > -6 and y < RW.y1 + 6 then\n\t\t\tline(`CourseE{row}a`, HE, HE + 0.4, HZ0, RW.z0 - 6)\n\t\t\tline(`CourseE{row}b`, HE, HE + 0.4, RW.z1 + 6, HZ1)\n\t\telse\n\t\t\tline(`CourseE{row}`, HE, HE + 0.4, HZ0, HZ1)\n\t\tend\n\t\ty += 20\n\tend\n\tfor i, c in { { -HX, HZ0 }, { HE, HZ0 }, { -HX, HZ1 }, { HE, HZ1 } } do\n\t\tlocal cx, cz = c[1], c[2]\n\t\tsblock(out, \"Corner\" .. i, cx - 9 + REC, cx + 9 - REC, FLOOR, EAVES, cz - 9 + REC, cz + 9 - REC, C.logDark, \"Wood\", { full = true })\n\tend\n\t-- by the gate: the information board on two posts under its own little roof, and the bike rack's hoops\n\tpost(out, \"BoardPostWest\", 49.0, 1.2, 0, 1.9, 0.1, C.boardDark, \"Wood\", { far = true })\n\tpost(out, \"BoardPostEast\", 50.4, 1.2, 0, 1.9, 0.1, C.boardDark, \"Wood\", { far = true })\n\tblock(out, \"Board\", 48.9, 50.5, 1.15, 1.25, 0.9, 1.8, \"e8e0cc\", \"SmoothPlastic\", { far = true })\n\tblock(out, \"BoardRoof\", 48.8, 50.6, 1.0, 1.45, 1.92, 1.98, C.roof, \"Metal\", { full = true })\n\tfor k = 1, 3 do\n\t\tlocal x = 41.6 + (k - 1) * 0.6\n\t\trod(out, \"RackHoop\" .. k .. \"a\", M(x, 1.0, 0), M(x, 1.0, 0.8), 5, C.metal, \"Metal\", { full = true })\n\t\trod(out, \"RackHoop\" .. k .. \"b\", M(x, 1.6, 0), M(x, 1.6, 0.8), 5, C.metal, \"Metal\", { full = true })\n\t\trod(out, \"RackHoop\" .. k .. \"c\", M(x, 1.0, 0.8), M(x, 1.6, 0.8), 5, C.metal, \"Metal\", { full = true })\n\tend\n\tlocal _ = rand\nend\n\n-- ---------------------------------------------------------------- the hut garden (x 38..52, z 6..14)\nlocal function gardenDecor(out: List, rand: () -> number)\n\t-- three beds edged in timber: two either side of the path, a long herb border along the north\n\t-- (ROBLOX-116: the east bed starts clear of the core, World/Hut's walkable garden x 43.75..47.75, z 5..9, which has its own beds and the feeder)\n\t-- (ROBLOX-118: the herb border along the north is in two, a gap for the path to the meadow, World/Hut's path_m4, x 44.85..45.45)\n\t-- (ROBLOX-119: the border's two halves end at the bench patch's gravel, World/Meadow's pad x 43.65..46.65 from z 13)\n\tlocal beds = { { 39, 43.6, 7, 8.4 }, { 47.9, 51.6, 7, 8.4 }, { 38.6, 43.5, 9.4, 10.6 }, { 46.8, 51.6, 9.4, 10.6 } }\n\tfor i, b in beds do\n\t\tblock(out, \"Edging\" .. i, b[1], b[2], b[3], b[4], 0, 0.22, C.board, \"WoodPlanks\", { far = true })\n\t\tblock(out, \"BedSoil\" .. i, b[1] + 0.05, b[2] - 0.05, b[3] + 0.05, b[4] - 0.05, 0.22, 0.24, C.soil, \"Ground\")\n\t\tlocal n = math.floor((b[2] - b[1]) / 0.55)\n\t\tfor k = 1, n do\n\t\t\tlocal x = b[1] + (k - 0.5) * (b[2] - b[1]) / n + between(rand, -0.12, 0.12)\n\t\t\tlocal z = between(rand, b[3] + 0.3, b[4] - 0.3)\n\t\t\tlocal w = between(rand, 0.4, 0.75)\n\t\t\tlocal h = w * between(rand, 0.45, 0.8) -- (low mounds: sage, thyme, mint and chives spread wider than they stand)\n\t\t\tlocal leaf = pick(C.herbs, rand)\n\t\t\tblob(out, `Herb{i}_{k}`, x, z, 0.22 + h * 0.25, w, h, w * between(rand, 0.8, 1.1), leaf, { far = k % 3 == 1, full = k % 2 == 0 })\n\t\t\t-- (near) two tufts off its shoulders, so a clump is a plant and not a stone, and a few flower heads over the ones in flower\n\t\t\tfor t = 1, 2 do\n\t\t\t\tlocal a = between(rand, 0, 2 * math.pi)\n\t\t\t\tblob(out, `Tuft{i}_{k}_{t}`, x + math.cos(a) * w * 0.3, z + math.sin(a) * w * 0.3, 0.22 + h * 0.45, w * 0.5, h * 0.75, w * 0.45, pick(C.herbs, rand), { full = true })\n\t\t\tend\n\t\t\tif rand() < 0.45 then\n\t\t\t\tlocal flower = pick(C.herbFlowers, rand)\n\t\t\t\tfor f = 1, 3 do\n\t\t\t\t\tlocal a = between(rand, 0, 2 * math.pi)\n\t\t\t\t\tlocal r = between(rand, 0, w * 0.35)\n\t\t\t\t\tblob(out, `HerbFlower{i}_{k}_{f}`, x + math.cos(a) * r, z + math.sin(a) * r, 0.22 + h * 0.7 + between(rand, 0, 0.08), 0.07, 0.09, 0.07, flower, { full = true })\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t-- the pallet planters either side of the garden, with their own plants\n\tfor i, x in { 40.4, 50.2 } do\n\t\tblock(out, \"Pallet\" .. i, x - 0.6, x + 0.6, 10.1, 10.9, 0, 0.45, \"b09a77\", \"WoodPlanks\", { far = true })\n\t\tfor k = 1, 3 do\n\t\t\tblock(out, `Slat{i}_{k}`, x - 0.62, x + 0.62, 10.08, 10.1, 0.06 + (k - 1) * 0.14, 0.12 + (k - 1) * 0.14, \"8f7a5a\", \"WoodPlanks\", { full = true })\n\t\tend\n\t\tblob(out, \"PalletPlants\" .. i, x, 10.5, 0.62, 1.1, 0.5, 0.7, pick(C.herbs, rand), { far = true })\n\t\tblob(out, \"PalletFlowers\" .. i, x + 0.2, 10.4, 0.82, 0.5, 0.14, 0.4, pick(C.herbFlowers, rand), { full = true })\n\tend\n\t-- (ROBLOX-116: the bird feeder is World/Hut's, walkable, in the core)\n\t-- the split-rail fence along the garden's north side, a gap for the path\n\tfor i, span in { { 38, 43.5 }, { 46.8, 52 } } do -- (ROBLOX-119: the gap is the bench patch's, x 43.65..46.65)\n\t\tpost(out, `RailPost{i}a`, span[1], 11.3, 0, 1.1, 0.14, \"7a6a55\", \"Wood\", { far = true })\n\t\tpost(out, `RailPost{i}b`, span[2], 11.3, 0, 1.1, 0.14, \"7a6a55\", \"Wood\", { far = true })\n\t\tpost(out, `RailPost{i}c`, (span[1] + span[2]) / 2, 11.3, 0, 1.1, 0.14, \"7a6a55\", \"Wood\", { full = true })\n\t\tfor k, h in { 0.45, 0.9 } do\n\t\t\trod(out, `Rail{i}_{k}`, M(span[1], 11.3, h), M(span[2], 11.3, h), 9, \"8a7a62\", \"Wood\", { far = k == 2 })\n\t\tend\n\tend\nend\n\n-- ---------------------------------------------------------------- the bench, the bin and the lamppost (ROBLOX-119: x 43.65..46.65, z 13..16, World/Meadow's walkable patch)\n-- Drawn a hair inside World/Meadow's walkable boxes (the bench patch's pad, the bench, the bin and the lamppost), standing in for them where streaming has not sent them\n-- and from afar; the gravel a hair under the walkable gravel.\nlocal function benchDecor(out: List, _rand: () -> number)\n\tlocal K, S, B, N, L = Meadow.PAD, Meadow.SLAB, Meadow.BENCH, Meadow.BIN, Meadow.LAMP\n\tlocal g = GROUND\n\tlocal sl = S.top\n\tlocal e = 0.15 -- (the hair)\n\tsblock(out, \"Pad\", K.x0 + e, K.x1 - e, g + 0.05, g + 0.25, K.z0 + e, K.z1 - e, C.gravel, \"Pebble\", { far = true })\n\tsblock(out, \"Slab\", S.x0 + e, S.x1 - e, g + 0.3, sl - e, S.z0 + e, S.z1 - e, C.concrete, \"Concrete\", { far = true })\n\tsblock(out, \"Seat\", B.x0 + e, B.x1 - e, sl + B.seat - B.thick + e, sl + B.seat - e, Meadow.SLATS[4][1] + e, B.front - e, C.board, \"WoodPlanks\", { far = true })\n\tsblock(out, \"Back\", B.x0 + e, B.x1 - e, sl + B.back[1][1] + e, sl + B.back[3][2] - e, B.backZ[1] + e, B.backZ[2] - e, C.board, \"WoodPlanks\", { far = true })\n\tfor i, fx in B.ends do\n\t\tsblock(out, \"End\" .. i, fx + e, fx + B.frame - e, sl + e, sl + B.legTop - e, B.front - 4 + e, B.front - e, C.black, \"Metal\", { full = true })\n\t\tsblock(out, \"Post\" .. i, fx + e, fx + B.frame - e, sl + e, sl + B.back[3][2] + 2 - e, B.post[1] + e, B.post[2] - e, C.black, \"Metal\", { full = true })\n\tend\n\tsblock(out, \"Bin\", N.x0 + e, N.x1 - e, sl + N.base + e, sl + N.lid - e, N.z0 + e, N.z1 - e, C.bin, \"Metal\", { far = true })\n\tsblock(out, \"Pole\", L.x - L.half + e, L.x + L.half - e, sl + e, sl + L.top - e, L.z - L.half + e, L.z + L.half - e, C.black, \"Metal\", { far = true })\n\tlocal y = sl + L.top + L.plate.h\n\tsblock(out, \"Lantern\", L.x - L.glass.half + e, L.x + L.glass.half - e, y + e, y + L.glass.h - e, L.z - L.glass.half + e, L.z + L.glass.half - e, C.lamp, \"SmoothPlastic\", { far = true })\n\tsblock(out, \"LampCap\", L.x - L.cap.half + e, L.x + L.cap.half - e, y + L.glass.h + e, y + L.glass.h + L.cap.h - e, L.z - L.cap.half + e, L.z + L.cap.half - e, C.black, \"Metal\", { full = true })\nend\n\n-- ---------------------------------------------------------------- the ground: the mown grass, the meadow's, the wood's and the scrub's floors, the paths, the fences\n-- (ROBLOX-122) The hole the lawn leaves round the pond (metres), the pond's water level and its walkable core and corridor deck (World/Pond: the backdrop draws none of\n-- its own ground or water over them).\nlocal PONDHOLE = { x0 = 48, x1 = 66, z0 = 13, z1 = 28.75 }\nlocal WATER_M = (Pond.WATER - Preserve.GROUND_Y) / 100\nlocal function walkable(x0: number, x1: number, z0: number, z1: number): boolean\n\tlocal cx0, cx1 = Pond.CORE.x0 / 100 + Preserve.ORIGIN_X_M, Pond.CORE.x1 / 100 + Preserve.ORIGIN_X_M\n\tlocal cz0, cz1 = Preserve.NORTH_FACE_M - (Pond.CORE.z1 - Preserve.NORTH_FACE_Z) / 100, Preserve.NORTH_FACE_M - (Pond.CORE.z0 - Preserve.NORTH_FACE_Z) / 100\n\tlocal inCore = x1 > cx0 + 1e-6 and x0 < cx1 - 1e-6 and z1 > cz0 + 1e-6 and z0 < cz1 - 1e-6\n\tlocal wx = Pond.WALK_X[1] / 100 + Preserve.ORIGIN_X_M\n local wz0 = Preserve.NORTH_FACE_M - (Pond.DECK_Z.s[2] - Preserve.NORTH_FACE_Z) / 100\n local wz1 = Preserve.NORTH_FACE_M - (Pond.DECK_Z.n[1] - Preserve.NORTH_FACE_Z) / 100\n local inWalk = x1 > wx + 1e-6 and x0 < cx0 - 1e-6 and z1 > wz0 + 1e-6 and z0 < wz1 - 1e-6\n\treturn inCore or inWalk\nend\n\n-- Clip every background floor against the pond after relocation, including\n-- meadow tiles. Special-casing the two old grass tiles left dry ground over water.\nlocal function cutFloor(out: List,id: string,x0: number,x1: number,z0: number,z1: number,y0: number,y1: number,color: string,material: string,flags: Flags?)\n local H=PONDHOLE\n local a,b,c,d=math.max(x0,H.x0),math.min(x1,H.x1),math.max(z0,H.z0),math.min(z1,H.z1)\n if a>=b or c>=d then block(out,id,x0,x1,z0,z1,y0,y1,color,material,flags);return end\n local pieces={{x0,a,z0,z1},{b,x1,z0,z1},{a,b,z0,c},{a,b,d,z1}}\n for i,rect in pieces do\n  if rect[2]-rect[1]>1e-6 and rect[4]-rect[3]>1e-6 then\n   block(out,id..\"_\"..i,rect[1],rect[2],rect[3],rect[4],y0,y1,color,material,flags)\n  end\n end\nend\n\nlocal function groundDecor(out: List, rand: () -> number)\n\t-- the mown grass under everything: 5 by 3 tiles of 20 m (a part is at most 2,048 studs), their tops at the ground\n\tfor i = 0, 4 do\n\t\tfor j = 0, 2 do\n\t\t\tlocal color = if (i + j) % 2 == 0 then C.mown else \"698743\"\n            cutFloor(out, `Grass{i}_{j}`, i*20, i*20+20, j*20, j*20+20, -0.02, 0, color, \"Grass\", {far=true})\n\t\tend\n\tend\n\t-- the floors laid over it (4 mm up): the meadow's tawny ground, the wood's leaf litter, the scrub's\n\tfor i = 0, 1 do\n\t\tfor j = 0, 1 do\n\t\t\t-- (ROBLOX-119: 2 mm up, under World/Meadow's walkable floor at the meadow's edge, 4 mm up)\n\t\t\tcutFloor(out, `MeadowFloor{i}_{j}`, 25 + i * 17.5, 25 + (i + 1) * 17.5, 18 + j * 15, 18 + (j + 1) * 15, 0, 0.002, C.meadowFloor, \"Grass\", { far = true })\n\t\tend\n\tend\n\tfor j = 0, 2 do\n\t\tblock(out, \"WoodFloor\" .. j, 0, 18, 5 + j * 50 / 3, 5 + (j + 1) * 50 / 3, 0, 0.004, C.woodFloor, \"Ground\", { far = true })\n\tend\n\tfor i = 0, 3 do\n\t\tblock(out, \"ScrubFloor\" .. i, 18 + i * 18.5, 18 + (i + 1) * 18.5, 50, 60, 0, 0.004, C.scrubFloor, \"Ground\", { far = true })\n\tend\n\t-- the paths (World/Preserve.CORRIDORS): mown strips and fine gravel, a segment longer than 20 m drawn in two\n\tlocal n = 0\n\tfor _, c in Preserve.CORRIDORS do\n\t\tif c.kind == \"mown\" or c.kind == \"gravel\" then\n\t\t\tfor k = 1, #c.points - 1 do\n\t\t\t\tlocal a, b = c.points[k], c.points[k + 1]\n\t\t\t\tlocal len = math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2)\n\t\t\t\tlocal parts = if len > 20 then 2 else 1\n\t\t\t\t-- (ROBLOX-116: a segment inside the hut garden's core, x 43.75..47.75 and z 5..9 m, is World/Hut's walkable gravel)\n\t\t\t\tlocal inCore = math.min(a[1], b[1]) >= 43.75 - 1e-6 and math.max(a[1], b[1]) <= 47.75 + 1e-6 and math.min(a[2], b[2]) >= 5 - 1e-6 and math.max(a[2], b[2]) <= 9 + 1e-6\n\t\t\t\t-- (ROBLOX-117: the gravel by the hut, path_gate and path_hut, lies a hair under the walkable gravel of the door's step and the path round the east end,\n\t\t\t\t-- World/Hut's, standing in for it where streaming has not sent it; the mown paths are the full tier's, a shade on the mown grass the low tier leaves out)\n\t\t\t\tlocal under = c.id == \"path_hut\" or c.id == \"path_gate\" or c.id == \"path_cross\" -- (ROBLOX-122: and the mown path to the pond, World/Pond's)\n\t\t\t\tfor s = 1, if inCore then 0 else parts do\n\t\t\t\t\tlocal t0, t1 = (s - 1) / parts, s / parts\n\t\t\t\t\tn += 1\n\t\t\t\t\tstrip(out, `Path{n}`, a[1] + (b[1] - a[1]) * t0, a[2] + (b[2] - a[2]) * t0, a[1] + (b[1] - a[1]) * t1, a[2] + (b[2] - a[2]) * t1, c.width,\n\t\t\t\t\t\tif under then 0.15 else 0.6, 1, if c.kind == \"gravel\" then C.gravel else C.mownStripe, if c.kind == \"gravel\" then \"Pebble\" else \"Grass\",\n\t\t\t\t\t\t{ far = true, full = c.kind == \"mown\" })\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t-- the chain-link along the railway (z 60), a mesh you can see through, its top rail and posts\n\tfor i = 0, 4 do\n\t\tblock(out, \"ChainLink\" .. i, i * 20, i * 20 + 20, 59.99, 60.01, 0, 1.8, C.metal, \"Metal\", { far = true, transparency = 0.72 })\n\t\trod(out, \"TopRail\" .. i, M(i * 20, 60, 1.8), M(i * 20 + 20, 60, 1.8), 4, C.metal, \"Metal\", { far = true, full = true })\n\tend\n\tfor k = 0, 20 do\n\t\tpost(out, \"FencePost\" .. k, k * 5, 60, 0, 1.85, 0.06, C.metal, \"Metal\", { full = true })\n\tend\n\tlocal _ = rand\nend\n\n-- ---------------------------------------------------------------- the meadow (x 25..60, z 18..48)\n-- (ROBLOX-119) Whether a mass at (x, z) metres, `r` across its half, would stand over World/Meadow's walkable core (x 42.65..47.65, z 16..21).\nlocal function nearCore(x: number, z: number, r: number): boolean\n\tlocal K = Meadow.CORE\n\tlocal x0, x1 = K.x0 / 100 + Preserve.ORIGIN_X_M, K.x1 / 100 + Preserve.ORIGIN_X_M\n\tlocal z0, z1 = Preserve.NORTH_FACE_M - (K.z1 - Preserve.NORTH_FACE_Z) / 100, Preserve.NORTH_FACE_M - (K.z0 - Preserve.NORTH_FACE_Z) / 100\n\treturn (x + r > x0 and x - r < x1 and z + r > z0 and z - r < z1)\n  or (x+r>PONDHOLE.x0 and x-r<PONDHOLE.x1 and z+r>PONDHOLE.z0 and z-r<PONDHOLE.z1)\nend\nlocal function meadowDecor(out: List, rand: () -> number)\n\tlocal mx, mz = Preserve.MEADOW.x, Preserve.MEADOW.z\n\tlocal cols, rows = 9, 8\n\tlocal k = 0\n\tfor i = 1, cols do\n\t\tfor j = 1, rows do\n\t\t\tk += 1\n\t\t\tlocal x = mx[1] + (i - 0.5) * (mx[2] - mx[1]) / cols + between(rand, -1.2, 1.2)\n\t\t\tlocal z = mz[1] + (j - 0.5) * (mz[2] - mz[1]) / rows + between(rand, -1.1, 1.1)\n\t\t\tlocal w, d = between(rand, 4.2, 5.6), between(rand, 3.6, 5.0)\n\t\t\tlocal h = between(rand, 1.2, 1.9) -- big bluestem and switchgrass stand 0.9 to 1.5 m in late summer; the masses' tops reach 0.8 to 1.2\n\t\t\t-- (ROBLOX-117: every second mass is the full tier's: 36 at the low tier, which were 48)\n\t\t\t-- (ROBLOX-119: none over the walkable meadow's edge and a margin round it: its own clumps are drawn there)\n\t\t\tlocal color, yaw = pick(C.grass, rand), between(rand, 0, 180)\n\t\t\tif not nearCore(x, z, w / 2 + 0.6) then\n\t\t\t\tblob(out, `Grass{k}`, x, z, h * 0.22, w, h, d, color, { far = true, full = k % 2 == 0 }, yaw)\n\t\t\tend\n\t\tend\n\tend\n\t-- (ROBLOX-119) the masses taken off round the walkable edge leave a gap the grid's would have filled: smaller masses round its west, north and east sides, each\n\t-- standing clear of the edge's own cells, in the meadow's ground (z 18 on)\n\tdo\n\t\tlocal K = Meadow.CORE\n\t\tlocal x0, x1 = K.x0 / 100 + Preserve.ORIGIN_X_M, K.x1 / 100 + Preserve.ORIGIN_X_M\n\t\tlocal z0, z1 = Preserve.NORTH_FACE_M - (K.z1 - Preserve.NORTH_FACE_Z) / 100, Preserve.NORTH_FACE_M - (K.z0 - Preserve.NORTH_FACE_Z) / 100\n\t\tlocal n = 0\n\t\tlocal gx = x0 - 3.1\n\t\twhile gx <= x1 + 3.1 do\n\t\t\tlocal gz = mz[1] + 0.5\n\t\t\twhile gz <= z1 + 3.1 do\n\t\t\t\tlocal x, z = gx + between(rand, -0.3, 0.3), gz + between(rand, -0.3, 0.3)\n\t\t\t\tlocal dx = math.max(x0 - x, 0, x - x1)\n\t\t\t\tlocal dz = math.max(z0 - z, 0, z - z1)\n\t\t\t\tlocal d = math.sqrt(dx * dx + dz * dz)\n\t\t\t\tlocal w = math.min(2.4, 2 * d - 0.2)\n\t\t\t\tlocal h, color, yaw = between(rand, 0.9, 1.4), pick(C.grass, rand), between(rand, 0, 180)\n\t\t\t\tif d > 0.5 and d <= 3.3 and w >= 0.8 then\n\t\t\t\t\tn += 1\n\t\t\t\t\tblob(out, `EdgeGrass{n}`, x, z, h * 0.22, w, h, w * between(rand, 0.75, 1.0), color, { full = n % 3 ~= 0 }, yaw)\n\t\t\t\tend\n\t\t\t\tgz += 1.7\n\t\t\tend\n\t\t\tgx += 1.7\n\t\tend\n\tend\n\t-- drifts of flowers over the grass: goldenrod, coneflower, milkweed, black-eyed Susan, Queen Anne's lace, bergamot\n\tlocal kinds = { \"goldenrod\", \"goldenrod\", \"coneflower\", \"milkweed\", \"susan\", \"lace\", \"bergamot\", \"goldenrod\" }\n\tfor d = 1, 40 do\n\t\tlocal x = between(rand, mx[1] + 1, mx[2] - 1)\n\t\tlocal z = between(rand, mz[1] + 1, mz[2] - 1)\n\t\tlocal w = between(rand, 1.0, 2.6)\n\t\tlocal kind = pick(kinds, rand)\n\t\tlocal y, deep = between(rand, 0.86, 1.08), w * between(rand, 0.5, 0.9)\n\t\tlocal yaw = between(rand, 0, 180)\n\t\tif not nearCore(x, z, w / 2 + 0.3) then\n\t\t\tblob(out, `Drift{d}`, x, z, y, w, 0.22, deep, (C.flowers :: any)[kind], { far = d <= 30, full = d % 2 == 0 }, yaw)\n\t\tend\n\tend\n\t-- a few milkweed clumps' broad leaves, the ant hills by the path and the bee hotel on its post (near detail)\n\tfor a = 1, 4 do\n\t\tlocal x, z = between(rand, mx[1] + 2, mx[1] + 8), between(rand, mz[1] + 1, mz[2] - 2)\n\t\tblob(out, \"AntHill\" .. a, x, z, 0, 0.5, 0.24, 0.5, \"7a6448\", { full = true })\n\tend\n\tpost(out, \"HotelPost\", 26.2, 33, 0, 1.3, 0.1, C.boardDark, \"Wood\", { full = true })\n\tblock(out, \"BeeHotel\", 25.95, 26.45, 32.85, 33.15, 1.3, 1.75, \"a5865d\", \"WoodPlanks\", { far = true, full = true })\nend\n\n-- ---------------------------------------------------------------- the pond (x 62..78, z 30..44) and the boardwalk along its south (z 30)\nlocal function pondDecor(out: List, rand: () -> number)\n\tlocal P = Preserve.POND\n\t-- (ROBLOX-122) the water at its true level, 6 cm under the lawn (World/Pond.WATER): the lawn leaves a hole round the pond (groundDecor's PONDHOLE), the pond's own\n\t-- mud floor lies in it under the water, the water a flat lens a hair under the walkable margin's own (its gaps filled by World/Pond's looks), and near at the full\n\t-- tier the bank in strips a metre wide from the hole's edge to the shore, a millimetre under the walkable bank; none of it over the walkable core and deck (World/Pond)\n\tlocal H = PONDHOLE\n\tblock(out, \"Basin\", H.x0, H.x1, H.z0, H.z1, WATER_M - 0.03, WATER_M - 0.006, C.mud, \"Mud\", { far = true })\n\tadd(out, \"Water\", Vector3.new(P.rx * 2 * 100, 0.6, P.rz * 2 * 100), M(P.x, P.z, WATER_M - 0.006), C.water, \"Glass\", { far = true, reflectance = 0.25, transparency = 0.35 }, \"Ellipsoid\")\n\tfor x = H.x0, H.x1 - 1 do\n\t\tlocal mid = x + 0.5\n\t\tlocal dx = (mid - P.x) / P.rx\n\t\tlocal zs, zn = H.z1, H.z1\n\t\tif math.abs(dx) < 1 then\n\t\t\tlocal half = P.rz * math.sqrt(1 - dx * dx)\n\t\t\tzs, zn = P.z - half, P.z + half\n\t\tend\n\t\tlocal function bank(id: string, z0: number, z1: number)\n\t\t\tif z1 - z0 < 0.05 then return end\n\t\t\t-- (cut round the walkable core and the corridor's deck)\n\t\t\tlocal cuts = { { z0, z1 } }\n\t\t\tif walkable(x, x + 1, z0, z1) then\n\t\t\t\tlocal cz1 = Preserve.NORTH_FACE_M - (Pond.CORE.z0 - Preserve.NORTH_FACE_Z) / 100\n\t\t\t\tlocal over = if x >= 50.999 then cz1 else 14.5\n\t\t\t\tcuts = { { math.max(z0, over), z1 } }\n\t\t\tend\n\t\t\tfor k, c in cuts do\n\t\t\t\tif c[2] - c[1] > 0.05 then block(out, `{id}{k}`, x, x + 1, c[1], c[2], WATER_M, (Pond.GROUND - Preserve.GROUND_Y) / 100 - 0.001, C.mud, \"Ground\", { full = true }) end\n\t\t\tend\n\t\tend\n\t\tbank(`BankS{x}`, H.z0, math.min(zs, H.z1))\n\t\tif zn < H.z1 then bank(`BankN{x}`, zn, H.z1) end\n\tend\n\tfor i = 1, 3 do\n\t\tlocal a = between(rand, 0, 2 * math.pi)\n\t\tlocal r = between(rand, 0.25, 0.6)\n\t\tlocal x, z = P.x + math.cos(a) * P.rx * r, P.z + math.sin(a) * P.rz * r\n\t\tif not walkable(x - 1.2, x + 1.2, z - 0.9, z + 0.9) then blob(out, \"LilyRaft\" .. i, x, z, WATER_M + 0.001, between(rand, 1.2, 2.4), 0.02, between(rand, 0.9, 1.8), C.lily, { far = true }) end\n\tend\n\tfor i = 1, 10 do\n\t\tlocal a = between(rand, 0, 2 * math.pi)\n\t\tlocal r = between(rand, 0.2, 0.75)\n\t\tlocal s = between(rand, 0.18, 0.3)\n\t\tlocal x, z = P.x + math.cos(a) * P.rx * r, P.z + math.sin(a) * P.rz * r\n\t\tif not walkable(x - s, x + s, z - s, z + s) then\n\t\t\tadd(out, \"Lily\" .. i, Vector3.new(0.4, s * 100, s * 100), M(x, z, WATER_M + 0.002), \"56833f\", \"SmoothPlastic\", { full = true }, \"Cylinder\", Vector3.new(0, 0, 90))\n\t\tend\n\tend\n\t-- the cattails and reeds round the north and east margins (none along the boardwalk), their brown heads near\n\tlocal m = 0\n\tfor i = 1, 18 do\n\t\tlocal a = math.rad(between(rand, -35, 215)) -- from the east round the north to the west\n\t\tlocal x = P.x + math.cos(a) * (P.rx - 0.4)\n\t\tlocal z = P.z + math.sin(a) * (P.rz - 0.4)\n\t\tif z > P.z - P.rz * 0.6 then\n\t\t\tm += 1\n\t\t\tlocal h = between(rand, 1.5, 2.3)\n\t\t\tblob(out, \"Reeds\" .. m, x, z, h * 0.42, between(rand, 1, 1.9), h, between(rand, 0.8, 1.4), pick(C.reed, rand), { far = m <= 12, full = m > 9 })\n\t\t\tfor c = 1, 2 do\n\t\t\t\tpost(out, `Cattail{m}_{c}`, x + between(rand, -0.4, 0.4), z + between(rand, -0.3, 0.3), h * 0.62, h * 0.62 + 0.22, 0.03, C.cattail, \"Fabric\", { full = true })\n\t\t\tend\n\t\tend\n\tend\n\t-- the boardwalk: a deck 1.5 m wide 40 cm over the ground on posts, its boards' seams near; the dipping platform out over the water with rails on three sides.\n\t-- (ROBLOX-122: from its west end to x 68 it is World/Pond's, walkable: the backdrop's deck lies under its boards there (a stand-in until they are streamed) and its\n\t-- posts and seams begin east of it)\n\tlocal deckTop = (Pond.DECK - Pond.BOARD.thick - Preserve.GROUND_Y) / 100 - 0.002\n\tblock(out, \"Boardwalk\", 47.65, 55, 13, 14.5, deckTop - 0.06, deckTop, C.board, \"WoodPlanks\", { far = true })\n\t-- Actual boards, posts and edges come from Pond. Do not draw an enticing\n\t-- continuation or dipping platform beyond the playable collision geometry.\nend\n\n-- ---------------------------------------------------------------- the woodland (x 0..18, z 5..55): the bur oak, the maples, the black cherry, the log pile\nlocal function woodlandDecor(out: List, rand: () -> number)\n\tlocal O = Preserve.OAK\n\t-- the veteran bur oak: a short massive bole, its root flare, five great limbs and a broad crown\n\tpost(out, \"OakBole\", O.x, O.z, 0, 5.2, O.trunk, C.oakBark, \"Wood\", { far = true, shadow = true })\n\tfor k = 1, 3 do\n\t\tlocal a = (k - 1) * 2.1 + 0.4\n\t\trod(out, \"OakFlare\" .. k, M(O.x + math.cos(a) * 1.1, O.z + math.sin(a) * 1.1, 0.05), M(O.x, O.z, 1.2), 70, C.oakBark, \"Wood\", { far = k == 1 })\n\tend\n\tfor k = 1, 5 do\n\t\tlocal a = (k - 1) / 5 * 2 * math.pi + between(rand, -0.3, 0.3)\n\t\tlocal reach = between(rand, 3.0, 4.8) -- (each ends inside the crown's masses: a bur oak's great limbs spread low and wide under its crown)\n\t\trod(out, \"OakLimb\" .. k, M(O.x, O.z, 4.4), M(O.x + math.cos(a) * reach, O.z + math.sin(a) * reach, between(rand, 8.6, 10.4)), between(rand, 38, 55), C.oakBark, \"Wood\",\n\t\t\t{ far = k <= 3, full = k > 4 })\n\tend\n\tfor k = 1, 10 do\n\t\tlocal a = (k - 1) / 9 * 2 * math.pi + between(rand, -0.3, 0.3)\n\t\tlocal r = if k == 1 then 0 else between(rand, 4.5, 7.8)\n\t\tlocal w = if k == 1 then 13 else between(rand, 7.0, 10.0)\n\t\tlocal h = if k == 1 then 8.5 else between(rand, 4.6, 6.8)\n\t\tlocal y = if k == 1 then 14.6 else between(rand, 11.5, 15.8)\n\t\tblob(out, \"OakCrown\" .. k, O.x + math.cos(a) * r, O.z + math.sin(a) * r, math.min(y, O.height - h / 2), w, h, w * between(rand, 0.85, 1.1), pick(C.oakCrown, rand),\n\t\t\t{ far = true, full = k > 7 })\n\tend\n\t-- the maples and the black cherry at the wood's edge\n\ttree(out, \"Maple1\", rand, 5.5, 18, 15, 10, 4.5, 0.48, C.mapleBark, C.mapleCrown, 5, 4, 4)\n\ttree(out, \"Maple2\", rand, 11, 10.5, 13, 9, 3.8, 0.42, C.mapleBark, C.mapleCrown, 4, 4, 3)\n\ttree(out, \"Maple3\", rand, 6, 49, 16, 11, 5, 0.52, C.mapleBark, C.mapleCrown, 5, 4, 4)\n\ttree(out, \"Maple4\", rand, 3.5, 33, 14, 9.5, 4.2, 0.45, C.mapleBark, C.mapleCrown, 4, 4, 3)\n\ttree(out, \"Cherry\", rand, 17.5, 27.5, 12, 7, 4.2, 0.36, C.cherryBark, C.cherryCrown, 4, 3, 3)\n\t-- the understorey: spicebush and dogwood masses along the edge\n\tfor k = 1, 10 do\n\t\tlocal x, z = between(rand, 1.5, 19.5), between(rand, 7, 54)\n\t\tlocal w = between(rand, 1.6, 3.2)\n\t\tlocal h = between(rand, 1.4, 2.6)\n\t\tblob(out, \"Shrub\" .. k, x, z, h * 0.4, w, h, w * between(rand, 0.8, 1.2), pick(C.shrub, rand), { far = k <= 6, full = k > 7 })\n\tend\n\t-- the log pile (x 8..12, z 28..31): cut lengths of oak and maple lying east-west, the lower course and two above it\n\tlocal L = Preserve.LOG_PILE\n\tlocal logs = 0\n\tfor course = 1, 3 do\n\t\tlocal count = 4 - course\n\t\tfor k = 1, count do\n\t\t\tlogs += 1\n\t\t\tlocal z = L.z[1] + 0.5 + (k - 0.5) * (L.z[2] - L.z[1] - 1) / count + (course - 1) * 0.15\n\t\t\tlocal dia = between(rand, 0.26, 0.42)\n\t\t\tlocal y = dia / 2 + (course - 1) * 0.3\n\t\t\trod(out, \"Log\" .. logs, M(L.x[1] + between(rand, 0, 0.4), z, y), M(L.x[2] - between(rand, 0, 0.4), z + between(rand, -0.2, 0.2), y), dia * 100,\n\t\t\t\tif logs % 2 == 0 then C.oakBark else C.mapleBark, \"Wood\", { far = course == 1, full = course == 3 })\n\t\tend\n\tend\nend\n\n-- ---------------------------------------------------------------- the stone retaining wall (x 92..94, z 5..55) and the bank it holds\nlocal function wallDecor(out: List, rand: () -> number)\n\tlocal W = Preserve.WALL\n\tlocal n = 20\n\tfor k = 1, n do\n\t\tlocal z0 = W.z[1] + (k - 1) * (W.z[2] - W.z[1]) / n\n\t\tlocal z1 = z0 + (W.z[2] - W.z[1]) / n\n\t\tlocal h = W.height + between(rand, -0.08, 0.1)\n\t\tblock(out, \"Wall\" .. k, W.x[1], W.x[2], z0, z1, 0, h, pick(C.limestone, rand), \"Limestone\", { far = true, shadow = true })\n\t\tif k % 2 == 1 then\n\t\t\tblock(out, \"Cap\" .. k, W.x[1] - 0.06, W.x[2] + 0.02, z0, z0 + (W.z[2] - W.z[1]) / n * 2, h, h + 0.1, pick(C.limestone, rand), \"Rock\")\n\t\tend\n\tend\n\t-- the stones of its sunny west face (near detail): proud, odd-sized, in rough courses\n\tfor k = 1, 30 do\n\t\tlocal z = between(rand, W.z[1] + 0.5, W.z[2] - 0.5)\n\t\tlocal y = between(rand, 0.12, W.height - 0.12)\n\t\tlocal w, h = between(rand, 0.3, 0.6), between(rand, 0.14, 0.26)\n\t\tblock(out, \"Stone\" .. k, W.x[1] - 0.03, W.x[1] + 0.02, z - w / 2, z + w / 2, y - h / 2, y + h / 2, pick(C.limestone, rand), \"Rock\", { full = true })\n\tend\n\t-- the bank it holds: the ground east of it stands 1.2 m up, to the apartments' fence\n\tfor j = 0, 2 do\n\t\tblock(out, \"Bank\" .. j, W.x[2], 100, W.z[1] + j * 50 / 3, W.z[1] + (j + 1) * 50 / 3, 0, W.height, C.bank, \"Grass\", { far = true })\n\tend\nend\n\n-- ---------------------------------------------------------------- the bramble and the scrub on the railway bank's foot (x 18..92, z 50..60)\nlocal function scrubDecor(out: List, rand: () -> number)\n\tlocal S = Preserve.SCRUB\n\tlocal k = 0\n\tfor row = 1, 2 do\n\t\tlocal count = if row == 1 then 16 else 14\n\t\tfor i = 1, count do\n\t\t\tk += 1\n\t\t\tlocal x = S.x[1] + (i - 0.5) * (S.x[2] - S.x[1]) / count + between(rand, -1.5, 1.5)\n\t\t\tlocal z = if row == 1 then between(rand, 52.5, 55.5) else between(rand, 56, 58.6)\n\t\t\tlocal w = between(rand, 3.2, 5.6)\n\t\t\tlocal h = between(rand, 1.5, 3.1)\n\t\t\tblob(out, \"Bramble\" .. k, x, z, h * 0.4, w, h, between(rand, 2.4, 3.6), pick(C.bramble, rand), { far = true, full = k % 4 == 0 }, between(rand, 0, 180))\n\t\tend\n\tend\n\tfor i = 1, 8 do\n\t\tlocal x = between(rand, S.x[1] + 2, S.x[2] - 2)\n\t\tblock(out, \"Ivy\" .. i, x - between(rand, 0.8, 1.6), x + between(rand, 0.8, 1.6), 59.9, 59.98, 0, between(rand, 1.0, 1.75), C.ivy, \"LeafyGrass\", { full = true })\n\tend\nend\n\n-- ---------------------------------------------------------------- the compost bays and the tool shed (x 2..8, z 3..9)\nlocal function compostDecor(out: List, rand: () -> number)\n\t-- the shed: 2.4 by 3 m, a pent roof falling to the west, its door facing east\n\tblock(out, \"Shed\", 2, 4.4, 5.6, 8.6, 0, 2.05, \"7a6046\", \"WoodPlanks\", { far = true, shadow = true })\n\tblock(out, \"ShedRoof\", 1.8, 4.6, 5.4, 8.8, 2.05, 2.15, \"3a3d3f\", \"Slate\", { far = true })\n\tblock(out, \"ShedDoor\", 4.4, 4.44, 6.5, 7.4, 0, 1.85, C.trim, \"WoodPlanks\", { far = true })\n\tblock(out, \"ShedWindow\", 2.6, 3.6, 8.6, 8.62, 1.1, 1.6, C.glass, \"SmoothPlastic\", { full = true, reflectance = 0.1 })\n\tblock(out, \"Cobweb\", 2.65, 3.3, 8.62, 8.625, 1.35, 1.58, \"d9d6cc\", \"SmoothPlastic\", { full = true, transparency = 0.55 }) -- Nathan's shed: its window cobwebbed\n\t-- three bays of pallets: the back, four sides, and three heaps of rot from fresh to crumbled\n\tblock(out, \"BayBack\", 4.8, 7.9, 3.4, 3.5, 0, 1.0, \"a08b69\", \"WoodPlanks\", { far = true })\n\tfor k = 0, 3 do\n\t\tlocal x = 4.8 + k * 1.03\n\t\tblock(out, \"BaySide\" .. k, x, x + 0.06, 3.5, 4.7, 0, 1.0, \"9a8564\", \"WoodPlanks\", { far = true })\n\tend\n\tfor k = 1, 3 do\n\t\tlocal x = 4.8 + (k - 0.5) * 1.03\n\t\tblob(out, \"Heap\" .. k, x, 4.05, 0.25, 0.9, 0.5 + k * 0.1, 1.0, ({ \"6b5a3a\", \"4f3f2c\", \"3b2f24\" })[k], { far = true })\n\t\tfor s = 1, 3 do\n\t\t\tblock(out, `BaySlat{k}_{s}`, x - 0.5, x + 0.5, 3.48, 3.5, 0.15 + s * 0.24, 0.2 + s * 0.24, \"7d6a50\", \"WoodPlanks\", { full = true })\n\t\tend\n\tend\n\t-- a wheelbarrow by the bays\n\tblock(out, \"Barrow\", 6.4, 7.4, 5.4, 6.0, 0.35, 0.65, \"4f6a7a\", \"Metal\", { full = true })\n\tpost(out, \"BarrowWheel\", 7.5, 5.7, 0, 0.36, 0.36, C.black, \"Fabric\", { full = true })\n\tlocal _ = rand\nend\n\n-- ---------------------------------------------------------------- the railway embankment (z 60..64.4)\nlocal function railwayDecor(out: List, rand: () -> number)\n\tlocal R = Preserve.RAILWAY\n\tlocal x0, x1 = R.x[1], R.x[2]\n\tlocal n = 6\n\tlocal p = math.atan2(R.height, R.crest - R.foot)\n\tlocal slopeLen = math.sqrt(R.height ^ 2 + (R.crest - R.foot) ^ 2)\n\tfor k = 1, n do\n\t\tlocal a = x0 + (k - 1) * (x1 - x0) / n\n\t\tlocal b = a + (x1 - x0) / n\n\t\t-- the bank's face, rising northward from the fence to the crest (a slab turned to its slope)\n\t\tlocal mid = M((a + b) / 2, (R.foot + R.crest) / 2, R.height / 2)\n\t\tadd(out, \"Bank\" .. k, Vector3.new((b - a) * 100, 30, slopeLen * 100), mid + Vector3.new(0, -15 * math.cos(p), -15 * math.sin(p)), if k % 2 == 0 then C.bank else \"6f8547\",\n\t\t\t\"Grass\", { far = true }, nil, Vector3.new(math.deg(p), 0, 0))\n\t\tblock(out, \"Crest\" .. k, a, b, R.crest, 64.4, 0, R.height, C.bank, \"Grass\", { far = true })\n\t\tblock(out, \"Ballast\" .. k, a, b, R.track - 1.6, 64.4, R.height, R.height + 0.3, C.ballast, \"Pebble\", { far = true }) -- (to the edge of the world, LIMIT, on its north)\n\t\tblock(out, \"Sleepers\" .. k, a, b, R.track - 1.3, R.track + 0.95, R.height + 0.3, R.height + 0.42, C.sleeper, \"Wood\", { far = true })\n\t\tfor r, side in { -1, 1 } do\n\t\t\tlocal z = R.track + side * R.gauge / 2\n\t\t\tblock(out, `Rail{k}_{r}`, a, b, z - 0.035, z + 0.035, R.height + 0.42, R.height + 0.57, C.rail, \"Metal\")\n\t\tend\n\tend\n\t-- the covered ways at each end of the line, where it runs under the streets beyond the preserve (16 m each: a train comes and goes inside them, never at\n\t-- the edge of the world, Client/TrainPass): the deck, the wall on the preserve's side and the portal's face round the opening\n\tfor i, span in { { x0, x0 + 16 }, { x1 - 16, x1 } } do\n\t\tlocal inner = if i == 1 then span[2] else span[1]\n\t\tblock(out, \"CoverDeck\" .. i, span[1], span[2], 61.8, 64.4, R.height + 5.0, R.height + 5.6, \"8b877e\", \"Concrete\", { far = true, shadow = true })\n\t\tblock(out, \"CoverWall\" .. i, span[1], span[2], 61.8, 62.2, R.height, R.height + 5.0, \"8f8a80\", \"Concrete\", { far = true })\n\t\tblock(out, \"PortalDark\" .. i, inner - 0.02, inner + 0.02, 62.2, 64.4, R.height, R.height + 5.0, \"1d1f20\", \"SmoothPlastic\", { far = true, transparency = 0.25 })\n\t\tblock(out, \"Parapet\" .. i, span[1], span[2], 61.8, 62.1, R.height + 5.6, R.height + 6.6, \"8b877e\", \"Concrete\", { full = true })\n\tend\n\t-- a signal by the line\n\tpost(out, \"SignalPost\", 88, 62.4, R.height, R.height + 4.0, 0.12, C.black, \"Metal\", { full = true })\n\tblock(out, \"SignalHead\", 87.8, 88.2, 62.3, 62.5, R.height + 3.2, R.height + 3.9, C.black, \"Metal\", { full = true })\n\tlocal _ = rand\nend\n\n-- ---------------------------------------------------------------- the city: the street to the south, the canal to the west, the apartments to the east\nlocal function southDecor(out: List, rand: () -> number)\n\tlocal G = Preserve.GATE\n\t-- the railings along the street (z 0), black iron you can see through, with the gate's two leaves and its piers\n\tlocal spans = { { 0, 14 }, { 14, 28 }, { 28, G.x[1] - 0.25 }, { G.x[2] + 0.25, 66 }, { 66, 86 }, { 86, 100 } } -- (each under 20.48 m: a part is at most 2,048 studs)\n\tfor i, s in spans do\n\t\tblock(out, \"Railing\" .. i, s[1], s[2], -0.01, 0.01, 0, 1.6, C.railing, \"Metal\", { far = true, transparency = 0.6 })\n\t\tblock(out, \"RailTop\" .. i, s[1], s[2], -0.025, 0.025, 1.55, 1.62, C.railing, \"Metal\")\n\tend\n\tblock(out, \"PierWest\", G.x[1] - 0.25, G.x[1], -0.15, 0.15, 0, 1.9, \"8d8478\", \"Brick\", { far = true })\n\tblock(out, \"PierEast\", G.x[2], G.x[2] + 0.25, -0.15, 0.15, 0, 1.9, \"8d8478\", \"Brick\", { far = true })\n\tblock(out, \"GateWest\", G.x[1], (G.x[1] + G.x[2]) / 2 - 0.02, -0.02, 0.02, 0.05, 1.6, C.railing, \"Metal\", { transparency = 0.45 })\n\tblock(out, \"GateEast\", (G.x[1] + G.x[2]) / 2 + 0.02, G.x[2], -0.02, 0.02, 0.05, 1.6, C.railing, \"Metal\", { transparency = 0.45 })\n\t-- the pavements and the road between them, in lengths of 20 m\n\tfor k = 0, 5 do\n\t\tlocal a, b = -12 + k * 19.5, -12 + (k + 1) * 19.5\n\t\tblock(out, \"Pavement\" .. k, a, b, -2.2, 0, -0.02, 0.12, C.pavement, \"Concrete\", { far = true })\n\t\tblock(out, \"Road\" .. k, a, b, -9.2, -2.2, -0.04, 0, C.asphalt, \"Concrete\", { far = true })\n\t\tblock(out, \"PavementFar\" .. k, a, b, -11, -9.2, -0.02, 0.12, C.pavement, \"Concrete\", { far = true })\n\t\tfor d = 0, 2 do\n\t\t\tlocal x = a + d * 6.5 + 1\n\t\t\tblock(out, `Dash{k}_{d}`, x, x + 3, -5.75, -5.65, 0, 0.004, \"d8d2b8\", \"SmoothPlastic\", { full = true })\n\t\tend\n\tend\n\t-- the terrace across the street: shops under two or three storeys, one row of windows a storey\n\tlocal x = -12\n\tlocal i = 0\n\twhile x < 104 do\n\t\ti += 1\n\t\tlocal w = between(rand, 8, 14)\n\t\tlocal x1 = math.min(x + w, 105)\n\t\tlocal h = between(rand, 7, 11.5)\n\t\tblock(out, \"Terrace\" .. i, x, x1, -14.8, -11.4, 0, h, pick(C.shop, rand), \"Brick\", { far = true })\n\t\t-- (ROBLOX-117: the cornices and the shopfronts are the full tier's, far and near: the low tier keeps the terrace's masses, room for the garden's near detail)\n\t\tblock(out, \"Cornice\" .. i, x, x1, -11.6, -11.4, h - 0.5, h - 0.3, \"d8d0c0\", \"Concrete\", { far = true, full = true })\n\t\tblock(out, \"Shopfront\" .. i, x + 0.4, x1 - 0.4, -11.42, -11.38, 0.4, 3.0, C.window, \"SmoothPlastic\", { far = true, full = true, reflectance = 0.15 })\n\t\tblock(out, \"Sign\" .. i, x + 0.4, x1 - 0.4, -11.46, -11.4, 3.05, 3.55, ({ \"2f4f6f\", \"7a2e2e\", \"2e5a3a\", \"c9a227\", \"3a3a3a\" })[1 + math.floor(rand() * 5)], \"SmoothPlastic\", { full = true })\n\t\tlocal storeys = math.floor((h - 3.4) / 3)\n\t\tfor s = 1, storeys do\n\t\t\tblock(out, `Windows{i}_{s}`, x + 0.8, x1 - 0.8, -11.42, -11.38, 3.6 + (s - 1) * 3, 3.6 + (s - 1) * 3 + 1.5, C.window, \"SmoothPlastic\", { full = s > 1, reflectance = 0.1 })\n\t\tend\n\t\t-- (near) the brick piers that divide each band into windows, up through every storey\n\t\tif storeys > 0 then\n\t\t\tlocal panes = math.max(2, math.floor((x1 - x) / 2.6))\n\t\t\tfor k = 1, panes - 1 do\n\t\t\t\tlocal px = x + 0.8 + k * (x1 - x - 1.6) / panes\n\t\t\t\tblock(out, `Pier{i}_{k}`, px - 0.3, px + 0.3, -11.44, -11.36, 3.5, 3.6 + storeys * 3, pick(C.shop, rand), \"Brick\", { full = true })\n\t\t\tend\n\t\tend\n\t\tx = x1\n\tend\n\t-- honey locusts along the near pavement, and its street lamps\n\tfor k, tx in { 8, 30, 62, 84 } do\n\t\tpost(out, \"StreetTreeTrunk\" .. k, tx, -1.4, 0, 3.4, 0.24, \"4a4038\", \"Wood\", { far = true, full = true })\n\t\tblob(out, \"StreetTree\" .. k, tx, -1.4, 5.2, 5.5, 4.2, 5.0, \"7b9a48\", { far = true })\n\tend\n\tfor k, lx in { 18, 52, 76 } do\n\t\tpost(out, \"StreetLamp\" .. k, lx, -1.9, 0, 5.5, 0.14, C.black, \"Metal\", { full = true })\n\tend\nend\n\nlocal function westDecor(out: List, rand: () -> number)\n\t-- the hedge on the preserve's west boundary, in six lengths, 2.2 m tall\n\tfor k = 0, 5 do\n\t\tblock(out, \"Hedge\" .. k, -0.2, 1.1, k * 10, k * 10 + 10, 0, between(rand, 2.0, 2.4), C.hedge, \"LeafyGrass\", { far = true })\n\tend\n\t-- beyond it the towpath, the canal (its water 1.2 m down between stone copings) and the warehouses on the far side\n\tfor k = 0, 3 do\n\t\tlocal z0, z1 = -14 + k * 19.5, -14 + (k + 1) * 19.5\n\t\tblock(out, \"Towpath\" .. k, -3.2, -0.2, z0, z1, -0.03, 0, C.gravel, \"Pebble\", { far = true })\n\t\tblock(out, \"Canal\" .. k, -10, -3.4, z0, z1, -1.25, -1.2, C.canal, \"SmoothPlastic\", { far = true, reflectance = 0.25 })\n\t\tblock(out, \"CopingNear\" .. k, -3.4, -3.2, z0, z1, -1.2, 0.02, C.coping, \"Concrete\")\n\t\tblock(out, \"CopingFar\" .. k, -10.2, -10, z0, z1, -1.2, 0.3, C.coping, \"Concrete\")\n\tend\n\tlocal z = -14\n\tlocal i = 0\n\twhile z < 64 do\n\t\ti += 1\n\t\tlocal d = between(rand, 12, 20)\n\t\tlocal z1 = math.min(z + d, 64)\n\t\tlocal h = between(rand, 7, 10.5)\n\t\tblock(out, \"Warehouse\" .. i, -14.2, -10.4, z, z1, 0, h, pick(C.brick, rand), \"Brick\", { far = true })\n\t\tblock(out, \"WarehouseWindows\" .. i, -10.42, -10.38, z + 1, z1 - 1, h * 0.55, h * 0.55 + 1.4, C.window, \"SmoothPlastic\", { full = true })\n\t\tz = z1\n\tend\nend\n\nlocal function eastDecor(out: List, rand: () -> number)\n\t-- the apartments' fence (x 100) on the bank's top, and the backs of four blocks behind it: brick, a storey every 3 m, a band of windows a storey, balconies\n\tfor k = 0, 2 do\n\t\tblock(out, \"AptFence\" .. k, 99.99, 100.01, 5 + k * 50 / 3, 5 + (k + 1) * 50 / 3, 1.2, 3.0, C.metal, \"Metal\", { far = true, transparency = 0.72 })\n\tend\n\tlocal blocks = { { -4, 14, 15 }, { 16, 33, 18 }, { 35, 50, 12 }, { 52, 59.6, 15 } } -- (the last stops short of the railway's embankment at z 60)\n\tfor b, B in blocks do\n\t\tlocal z0, z1, h = B[1], B[2], B[3]\n\t\tlocal base = if z0 >= 5 and z1 <= 55 then 1.2 else 0\n\t\tlocal brick = pick(C.brick, rand)\n\t\tblock(out, \"Apartment\" .. b, 101, 105.7, z0, z1, 0, base + h, brick, \"Brick\", { far = true, shadow = true })\n\t\tfor k = 1, math.floor((z1 - z0) / 3) - 1 do -- (near) the piers between the windows\n\t\t\tlocal zc = z0 + 0.8 + k * (z1 - z0 - 1.6) / math.floor((z1 - z0) / 3)\n\t\t\tblock(out, `AptPier{b}_{k}`, 100.95, 101.0, zc - 0.25, zc + 0.25, base + 0.8, base + h - 0.4, brick, \"Brick\", { full = true })\n\t\tend\n\t\tblock(out, \"Parapet\" .. b, 100.9, 105.7, z0, z1, base + h, base + h + 0.5, \"6f6a64\", \"Concrete\")\n\t\tlocal floors = math.floor(h / 3)\n\t\tfor f = 1, floors do\n\t\t\tlocal y = base + (f - 1) * 3 + 0.9\n\t\t\tblock(out, `AptWindows{b}_{f}`, 100.97, 101.0, z0 + 0.8, z1 - 0.8, y, y + 1.45, C.window, \"SmoothPlastic\", { far = true, full = f % 2 == 0, reflectance = 0.12 })\n\t\t\tif f > 1 then\n\t\t\t\tfor s = 1, 2 do\n\t\t\t\t\tlocal zc = z0 + (z1 - z0) * (if s == 1 then 0.3 else 0.72)\n\t\t\t\t\tblock(out, `Balcony{b}_{f}_{s}`, 99.9, 101, zc - 1.4, zc + 1.4, y - 0.95, y - 0.85, C.balcony, \"Concrete\", { full = true })\n\t\t\t\t\tblock(out, `BalconyRail{b}_{f}_{s}`, 99.88, 99.92, zc - 1.4, zc + 1.4, y - 0.85, y - 0.05, C.railing, \"Metal\", { full = true, transparency = 0.5 })\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function towersDecor(out: List, rand: () -> number)\n\t-- the city's towers beyond the railway: impostors at the edge (see the header), hazy, one with its own water tower on the roof's line\n\tlocal spots = { -9, 6, 21, 58, 77, 96 }\n\tfor i, x in spots do\n\t\tlocal w = between(rand, 2.4, 5.0)\n\t\tlocal h = between(rand, 12, 20) -- (a part is at most 2,048 studs)\n\t\tblock(out, \"Tower\" .. i, x - w / 2, x + w / 2, 64.4, 64.8, 0, h, pick(C.tower, rand), \"Concrete\", { far = true })\n\t\tblock(out, \"TowerBands\" .. i, x - w / 2 + 0.2, x + w / 2 - 0.2, 64.39, 64.4, h * 0.2, h * 0.92, \"7f8a98\", \"SmoothPlastic\", { full = true, transparency = 0.35, reflectance = 0.2 })\n\tend\n\t-- (an impostor too: a rooftop water tank on its building, drawn at the towers' scale)\n\tpost(out, \"WaterTowerTank\", 40, 64.42, 6.6, 7.5, 0.72, \"8a6e55\", \"WoodPlanks\", { far = true })\n\tblock(out, \"WaterTowerLegs\", 39.75, 40.25, 64.4, 64.6, 4.2, 6.6, \"4a4642\", \"Metal\", { far = true, transparency = 0.4 })\n\tblock(out, \"WaterTowerRoof\", 39.6, 40.4, 64.4, 64.8, 7.5, 7.75, \"4a4642\", \"Metal\")\n\tblock(out, \"WaterTowerBlock\", 38.4, 41.6, 64.4, 64.8, 0, 4.2, pick(C.tower, rand), \"Concrete\", { far = true })\nend\n\n-- ---------------------------------------------------------------- the zones' lists\nlocal MAKERS: { [string]: (List, () -> number) -> () } = {\n\thut = hutDecor, hut_garden = gardenDecor, bench = benchDecor, ground = groundDecor, meadow = meadowDecor, pond = pondDecor, compost = compostDecor,\n\twoodland = woodlandDecor, wall = wallDecor, scrub = scrubDecor, city_south = southDecor, city_west = westDecor, city_east = eastDecor, railway = railwayDecor,\n\ttowers = towersDecor,\n}\nlocal SALT: { [string]: number } = {\n\thut = 1, hut_garden = 2, bench = 3, ground = 4, meadow = 5, pond = 6, compost = 7, woodland = 8, wall = 9, scrub = 10, city_south = 11, city_west = 12,\n\tcity_east = 13, railway = 14, towers = 15,\n}\n\n-- Whether a zone has a look here.\nfunction PreserveLook.knows(zoneId: string): boolean\n\treturn MAKERS[zoneId] ~= nil\nend\n\nlocal cache: { [string]: { Drawn } } = {}\n\n-- The zone's drawn records for a seed (the zone's own: WorldMap.seed(world seed, zone id)): the same list for the same zone and seed; do not change it.\nfunction PreserveLook.records(zoneId: string, seed: number): { Drawn }\n\tlocal key = zoneId .. \"/\" .. tostring(seed)\n\tlocal cached = cache[key]\n\tif cached ~= nil then return cached end\n\tlocal make = MAKERS[zoneId]\n\tassert(make ~= nil, \"no look for the preserve's zone \" .. zoneId)\n\tlocal out: List = {}\n\tmake(out, rng(seed, SALT[zoneId]))\n\tfor _, d in out do table.freeze(d) end\n\tcache[key] = out\n\treturn out\nend\n\n-- How many records a zone has at each level: every record, the low tier's, the far look at the full tier and at the low tier.\nfunction PreserveLook.counts(zoneId: string, seed: number): (number, number, number, number)\n\tlocal full, low, far, farLow = 0, 0, 0, 0\n\tfor _, d in PreserveLook.records(zoneId, seed) do\n\t\tfull += 1\n\t\tif not d.full then low += 1 end\n\t\tif d.far then\n\t\t\tfar += 1\n\t\t\tif not d.full then farLow += 1 end\n\t\tend\n\tend\n\treturn full, low, far, farLow\nend\n\nreturn table.freeze(PreserveLook)\n",65587,2819455688},{"Shared/World/PreserveTrain","--!strict\n-- The trains on the railway beyond the preserve's north fence (ROBLOX-115, docs/PARK_WORLD_DESIGN.md: \"the railway's vibration\", \"trains every few minutes\").\n-- Pure: when each train passes, which way, how fast, how long it is and what it is, drawn from the world's seed (WorldMap.seed(world seed, \"train\"), a\n-- Park-Miller stream per pass), so the same world has the same timetable on every client and in the tests; nothing here draws from math.random. Client/TrainPass\n-- draws the silhouette where `at` puts it and plays its sound.\n--\n-- A pass runs the length of the line between the covered ways at its two ends (World/PreserveLook's railway: 16 m each, where the line goes under the streets),\n-- from one portal's far end to the other's, so a train is only ever seen coming out of one and going into the other, never at the edge of the world: every car\n-- is drawn only while it lies wholly within the line's extent (World/Preserve.LIMIT). Between passes there are GAP seconds (two and a half to five and a half\n-- minutes); the first comes FIRST seconds or so after the clock's zero, so a visit soon sees one.\nlocal Preserve = require(script.Parent.Preserve)\n\nlocal PreserveTrain = {}\n\nexport type Pass = { k: number, start: number, finish: number, dir: number, speed: number, cars: number, kind: string }\n\nPreserveTrain.GAP = table.freeze({ 150, 330 }) -- seconds between one train's last car leaving and the next's front appearing\nPreserveTrain.FIRST = table.freeze({ 40, 100 })\nPreserveTrain.SPEED = table.freeze({ 1100, 1700 }) -- studs a second (40 to 60 km/h: a line through the city, slowing for a station)\nPreserveTrain.CARS = table.freeze({ commuter = table.freeze({ 3, 5 }), freight = table.freeze({ 5, 9 }) })\n-- A car (studs): 15 m long (so a car fits inside a covered way, 16 m), 3 m wide, its body's floor 1.1 m over the rail and its roof 4 m; the gap between cars.\nPreserveTrain.CAR = table.freeze({ length = 1500, width = 300, floor = 110, height = 400, gap = 60 })\n\nlocal R = Preserve.RAILWAY\nlocal MOD = 2147483647\n\n-- The line: the track's middle in studs (z), the rails' top (y) and its two ends (x), the covered ways' inner ends.\nlocal lo = Preserve.at(R.x[1], R.track, R.height + 0.57)\nlocal hi = Preserve.at(R.x[2], R.track, R.height + 0.57)\nPreserveTrain.LINE = table.freeze({ z = lo.Z, y = lo.Y, x0 = lo.X, x1 = hi.X })\n\nlocal function rng(seed: number): () -> number\n\tlocal state = seed % MOD\n\tif state <= 0 then state += MOD - 1 end\n\treturn function(): number\n\t\tstate = (state * 16807) % MOD\n\t\treturn (state - 1) / (MOD - 1)\n\tend\nend\n\n-- The length of a train of `cars` cars, studs.\nfunction PreserveTrain.length(cars: number): number\n\tlocal C = PreserveTrain.CAR\n\treturn cars * C.length + (cars - 1) * C.gap\nend\n\n-- The timetable of a seed: `pass(k)` the k-th pass (1, 2, ...), `at(t)` the pass under way at time t (seconds on the client's clock) or nil.\nfunction PreserveTrain.schedule(seed: number): any\n\tlocal passes: { Pass } = {}\n\tlocal span = PreserveTrain.LINE.x1 - PreserveTrain.LINE.x0\n\tlocal function make(k: number): Pass\n\t\tlocal rand = rng((seed + k * 104729) % MOD)\n\t\tlocal prevFinish = if k == 1 then 0 else passes[k - 1].finish\n\t\tlocal gapRange = if k == 1 then PreserveTrain.FIRST else PreserveTrain.GAP\n\t\tlocal start = prevFinish + gapRange[1] + (gapRange[2] - gapRange[1]) * rand()\n\t\tlocal kind = if rand() < 0.65 then \"commuter\" else \"freight\"\n\t\tlocal range = PreserveTrain.CARS[kind]\n\t\tlocal cars = range[1] + math.floor(rand() * (range[2] - range[1] + 1))\n\t\tlocal speed = PreserveTrain.SPEED[1] + (PreserveTrain.SPEED[2] - PreserveTrain.SPEED[1]) * rand()\n\t\tif kind == \"freight\" then speed *= 0.8 end\n\t\tlocal dir = if rand() < 0.5 then 1 else -1\n\t\tlocal finish = start + (span + PreserveTrain.length(cars)) / speed\n\t\treturn table.freeze({ k = k, start = start, finish = finish, dir = dir, speed = speed, cars = cars, kind = kind })\n\tend\n\tlocal self = {}\n\tfunction self.pass(k: number): Pass\n\t\tfor i = #passes + 1, k do passes[i] = make(i) end\n\t\treturn passes[k]\n\tend\n\tlocal cursor = 1\n\tfunction self.at(t: number): Pass?\n\t\tif t < 0 then return nil end\n\t\tif cursor > 1 and self.pass(cursor - 1).start > t then cursor = 1 end -- (a clock that went back: from the start)\n\t\twhile self.pass(cursor).finish < t do cursor += 1 end\n\t\tlocal p = self.pass(cursor)\n\t\tif t >= p.start then return p end\n\t\treturn nil\n\tend\n\treturn self\nend\n\n-- Where the front of a pass's train is at time t (studs along x), and the middle of each car, in order from the front. A car lies wholly inside the line or is\n-- not listed.\nfunction PreserveTrain.cars(p: Pass, t: number): (number, { number })\n\tlocal L = PreserveTrain.LINE\n\tlocal C = PreserveTrain.CAR\n\tlocal travelled = (t - p.start) * p.speed\n\tlocal front = if p.dir == 1 then L.x0 + travelled else L.x1 - travelled\n\tlocal out: { number } = {}\n\tfor i = 1, p.cars do\n\t\tlocal back = (i - 1) * (C.length + C.gap) + C.length / 2\n\t\tlocal mid = front - p.dir * back\n\t\tif mid - C.length / 2 >= L.x0 and mid + C.length / 2 <= L.x1 then table.insert(out, mid) end\n\tend\n\treturn front, out\nend\n\nreturn table.freeze(PreserveTrain)\n",5117,3987110454},{"Shared/World/Region","--!strict\n-- What a region is made of (ROBLOX-94, docs/OPEN_WORLD_DESIGN.md): the generators. Each is pure and deterministic from the region (its kind and its\n-- seed), so the same region gives the same boxes forever, on the server and on any client; nothing here touches the engine.\n--   pieces ... the physical boxes: what the motor walks on, the rival's route is built from, and the prey perch on (Habitat/WindowsillLayout.Piece).\n--   decor .... the drawn-only boxes that stand beside them. The sill's are the layout's DECOR (its drawn world is Habitat/Scenery.decor, which still reads the layout);\n--              every other kind's are its whole drawn look, one record a part (World/Garden.Drawn, built by Habitat/Scenery.look).\n--   keepOut .. the boxes the region's creatures keep out of: the retreats and a margin around them, and the sill's open sash (ROBLOX-