	},
}

return table.freeze(data)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Tarantula</string>
            <string name="Source"><![CDATA[--!strict
-- The tarantulas' threat display and silk mat (ROBLOX-82): every number the pose needs. The pose is presentation only: it bends and
-- turns the drawn spider; it never changes the motor, the collider, the path, the speed, the jump, the senses, the dragline, the wasp or
-- the rival. Unlike the peacock's dance (Girard et al. 2011) and the ant mimic's walk (Shamble et al. 2017) there is no measured record
-- behind these numbers: nothing below is a rate or an angle from a paper, and every one is marked ART (artistic: chosen to read well on a
-- small screen, from what is generally known of the behaviour, which this round did not check against a source; see
-- docs/NOTEBOOK_SOURCES.md for what the notebook page rests on).
--
-- What the pose draws, as general knowledge of New World tarantulas (the pack's two species both are): a threatened tarantula rears up on
-- its hind legs, raising the front of the body, lifting the first pair of legs and the pedipalps and showing its fangs, and holds the
-- posture; and tarantulas lay silk by drawing their spinnerets over the ground, in sheets and mats. The game's loop puts the two side by
-- side: the rear-up, a settle, then a turn about on the spot with the spinnerets swinging side to side as if laying a mat, and back.
-- The tarantula is a costume on the jumping spider's body (ROBLOX-81), so the display is a drawn pose and nothing more.

local Tarantula = {}

Tarantula.pack = "tarantula_pack"
Tarantula.ids = { "brachypelma_hamorii", "chromatopelma_cyaneopubescens" } :: { string }

-- ---------------------------------------------------------------- the loop (ART)
-- One loop is 6 seconds, in order; it repeats until the player ends it. Every level starts and ends the loop at 0, so the repeat has no jump.
--   rear   the prosoma pitches up and legs I and the pedipalps lift (the rise);
--   threat the posture is held, with a faint tremble of the raised legs;
--   settle the prosoma comes back down and legs I and the pedipalps lower;
--   turn   the drawn body pivots about its up axis, 0 to 180 degrees, the spinnerets swinging side to side;
--   mat    the body holds at 180 degrees, spinnerets still swinging;
--   return the body pivots back to 0 as the swing dies away.
Tarantula.loopSeconds = 6.0
Tarantula.phases = {
	{ id = "rear", seconds = 0.5 },
	{ id = "threat", seconds = 2.2 },
	{ id = "settle", seconds = 0.5 },
	{ id = "turn", seconds = 1.2 },
	{ id = "mat", seconds = 0.4 },
	{ id = "return", seconds = 1.2 },
} :: { { id: string, seconds: number } }

-- ---------------------------------------------------------------- amplitudes and rates (ART)
Tarantula.rearDeg = 32 -- how far the prosoma pitches up about the waist
Tarantula.palpDeg = 55 -- how far each pedipalp lifts at its base (the palp is leg-like, so it comes up with legs I)
Tarantula.pivotDeg = 180 -- how far the body turns about its up axis
Tarantula.sweepDeg = 25 -- how far the spinnerets swing either side of straight back (the second segment swings `tipSweep` times as far: the profile's `threat`)
Tarantula.sweepHz = 1.4 -- the swing's rate (a slow stroke: never above 3 Hz, nothing that flashes)
Tarantula.sweepEaseSeconds = 0.3 -- the swing arrives and leaves over this long at the ends of the turn
Tarantula.tremorHz = 2.2 -- the raised legs' faint tremble in the hold (its size is the profile's `threat.tremor`)
Tarantula.rampInSeconds = 0.1 -- a pose given after a stop does not start with a jump
Tarantula.fadeOutSeconds = 0.25 -- an ended pose eases out over this long and the legs go back to the motor
Tarantula.reducedMotion = 0.5 -- ReducedMotion halves every angle and stops the tremble; the posture still shows

return Tarantula
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Wasp</string>
            <string name="Source"><![CDATA[--!strict
-- The mud dauber wasp's rules: every number of scripts/predator/wasp_director.gd (LIFE round 4, LIFE-14 to LIFE-17), unchanged, in
-- Godot's units (1 WU = 1 stud = 1 cm). They are design choices tuned for fairness, not measurements (LIFE-17): sight range, notice
-- rates, timings and the places it looks. The Godot names are in comments where this file renames them. Predator/WaspDirector reads
-- them; nothing else decides what the wasp does.
--
-- Roblox-only additions are marked "Roblox:". Everything about how it looks is in Data/WaspLook.

local Wasp = {}

export type Point = { id: string, hover: Vector3, land: Vector3? }

-- When it may come: the days and the warm middle of the day (hours of the life clock).
Wasp.firstDay = 2
Wasp.visitChance = 0.6
Wasp.windowFromH = 10.0
Wasp.windowToH = 15.5

-- The game's own rules, which the Godot replay above does not use (the goldens keep the values above; WaspDirector:useGameRules() applies these):
-- a visit on every day from firstDay (guaranteed, ROBLOX-67), two a day in two windows of the day (ROBLOX-75), and Chet's longer, slightly
-- sharper visits (ROBLOX-62). The first-day, first-meal and rest protections do not change.
Wasp.game = {
	visitChance = 1.0, -- 1 = every visit of every day from firstDay (Godot: visitChance above, some days only); a visit of the day is drawn against it each
	-- ROBLOX-75 (Nathan: "the wasp needs to be around more, maybe a couple times through the day"): two visits a day, one in each of these windows
	-- (from, to; hours of the life clock; Godot has the one window windowFromH to windowToH above). The hour of each is drawn from the world's seed,
	-- the day and the visit's place in the day, in the window's first part (up to an hour before its end, so a rest can still delay it inside the
	-- window), and the afternoon's is at least minGapH after the morning's. Every visit is a full one (the warning, the search, its own takesRival
	-- draw below) and has its own protections: a rest or moult at its hour only delays it to the window's end, and a rest through the whole window
	-- skips that visit and no other.
	windows = { { 9.5, 12.0 }, { 13.5, 16.5 } },
	minGapH = 2.0,
	searchScale = 1.6, noticeScale = 1.2, inspectScale = 0.8,
	-- ROBLOX-70 (Nathan: "The wasp should kill the rival male like 10 percent of the time"): the chance, per visit, that a visit is for the rival
	-- male instead of the spider, when there is a free rival on the sill that is not in the retreat. Drawn from a stream of its own (the visit's
	-- seed), so the places and times of the other draws do not change. 0 turns it off.
	takesRival = 0.10,
	-- ROBLOX-106 (W4, Nathan: "sometimes you worry about starving because a wasp or other thing won't go away"): the standard rules only (WaspDirector `nature`, which
	-- the client sets when the rules are not gentle). Each day's two windows slide by up to `shiftH` either way (a draw of their own from the seed, the day and the
	-- window), so the visits do not keep to the clock; each visit's search lasts its usual 72 s times a draw from `visit` (0.6 to 1.5: 43 to 108 s), and with
	-- `lingerChance` (about one visit in twelve, so one lingering visit every six days or so at two a day) it lingers, `linger` times as long (3 to 5: 3.6 to 6 minutes
	-- on the sill, five game hours at the most). The draws come from the seed, the day and the visit's number, which the wasp's record keeps, so a return to a rest meets
	-- the same visits; a visit going on is not kept, as before.
	nature = { shiftH = 1.0, visit = { 0.6, 1.5 }, lingerChance = 0.08, linger = { 3.0, 5.0 } },
}

-- How it takes the rival (the game only; Godot's wasp has no rival): it flies to a place just above it and a little aside (the first of these
-- offsets from which the way down is clear), hangs there, strikes and carries it up and away like a spider.
Wasp.rival = {
	aboveWu = 1.3, -- above the rival's surface, where it hovers
	offsets = { { 0.0, 0.0 }, { 1.5, 0.0 }, { -1.5, 0.0 }, { 0.0, 1.5 }, { 0.0, -1.5 }, { 3.0, 0.0 }, { -3.0, 0.0 }, { 0.0, 3.0 }, { 0.0, -3.0 }, { 2.2, 2.2 }, { -2.2, 2.2 }, { 2.2, -2.2 }, { -2.2, -2.2 } },
	flySpeed = 5.0, -- it goes straight for it (searching is 4)
	hoverS = 0.8, -- it hangs over it before it strikes
	strikeS = 0.35,
	catchWu = 0.8,
	clearRadius = 0.3, -- the way down to the rival is checked with this sphere
	earshotWu = 18.0, -- the player is told what happened (a caption, a notice) when the wasp is this near
	sightWu = 24.0, -- ... or in clear sight of it, this far
}

-- A visit (game seconds): heard while it arrives, searching, flying away, carrying the spider off.
Wasp.arriveS = 8.0
Wasp.searchS = 45.0
Wasp.leaveS = 5.0
Wasp.carryS = 3.5

-- How it flies: between places at cruising height, in over the window frame from outside.
Wasp.cruiseY = 9.0
Wasp.entry = Vector3.new(38.0, 19.0, 2.0)
Wasp.over = Vector3.new(27.0, 15.0, 2.0)
Wasp.flySpeed = 4.0
Wasp.radius = 0.55 -- WU kept clear of the world on its paths in the air
Wasp.hoverS = { 1.5, 2.5 } -- how long it hovers to look
Wasp.scanDegS = 70.0 -- how fast it turns while it hovers
Wasp.landChance = 0.5
Wasp.landS = 0.6
Wasp.walkS = 2.0
Wasp.walkSpeed = 0.7
Wasp.stepEveryS = 0.5
-- Roblox: the clearance for its steps on a surface. Godot's walk test uses the 0.55 sphere, which the physics engine lets start inside
-- the floor it stands 0.35 above; Roblox's shape casts are not promised to, so a walking wasp is checked with a sphere that fits.
Wasp.walkRadius = 0.3

-- What it sees.
Wasp.sightWu = 7.0
Wasp.noticeStill = 0.25 -- notice per second for a still spider at point-blank range
Wasp.noticeMoving = 1.6 -- added per second at walking speed
Wasp.noticeDecay = 0.2
Wasp.confuseS = 4.0
Wasp.afterLossNotice = 0.35
Wasp.loseUnseenS = 0.8
Wasp.farFromLossWu = 6.0

-- Inspecting and striking.
Wasp.standoffWu = 1.2
Wasp.inspectSpeed = 2.5
Wasp.inspectS = 1.5
Wasp.inspectGiveUpS = 6.0 -- it cannot get to arm's length: it gives up on that spider
Wasp.strikeS = 0.35
Wasp.catchWu = 0.8
Wasp.holdBelow = 0.5

-- The wasp as the spider's senses have it (wasp.gd): its eyes ahead of its centre, the size the senses give it. To the spider it is
-- movement, never prey.
Wasp.eyeAhead = 1.0
Wasp.sensedRadius = 0.9

-- The words and timing of the screen (Godot: caught_panel.gd QUIET_S, LINE_S). Roblox: captionTailS is how long the caption of the wasp
-- leaving stays up and captionFadeS how long it takes to fade.
Wasp.caughtQuietS = 1.5 -- dim and quiet before the line
Wasp.caughtLineS = 1.5 -- the line alone before the summary and the choices
Wasp.caughtDim = 0.82
Wasp.captionTailS = 3.0
Wasp.captionFadeS = 1.0

-- Where it looks for spiders: where it hovers to look and, on open surfaces, where it may land. Every hover point is open straight up
-- to cruising height (tests check them on Godot's boxes; WaspSpec checks them on the real sill).
local points: { Point } = {
	{ id = "floor_middle", hover = Vector3.new(0.0, 1.6, 6.0), land = Vector3.new(0.0, 0.35, 6.0) },
	{ id = "floor_east", hover = Vector3.new(14.0, 1.6, 7.0), land = Vector3.new(14.0, 0.35, 7.0) },
	{ id = "floor_west", hover = Vector3.new(-13.0, 1.6, 7.0), land = Vector3.new(-13.0, 0.35, 7.0) },
	{ id = "floor_back", hover = Vector3.new(-7.0, 1.6, -9.0), land = Vector3.new(-7.0, 0.35, -9.0) },
	{ id = "leaf_west", hover = Vector3.new(-15.0, 5.7, -1.5), land = Vector3.new(-15.0, 4.55, -1.5) },
	{ id = "leaf_middle", hover = Vector3.new(-1.0, 5.7, -1.5), land = Vector3.new(-1.0, 4.55, -1.5) },
	{ id = "leaf_east", hover = Vector3.new(21.5, 6.9, -3.0), land = Vector3.new(21.5, 5.75, -3.0) },
	{ id = "planter", hover = Vector3.new(10.0, 6.1, -4.0), land = Vector3.new(10.0, 4.95, -4.0) },
	{ id = "back_wall_west", hover = Vector3.new(-12.0, 5.0, -11.2) },
	{ id = "back_wall_east", hover = Vector3.new(12.0, 7.0, -11.2) },
	{ id = "right_wall", hover = Vector3.new(28.6, 4.0, 5.0) },
	{ id = "under_leaf_middle", hover = Vector3.new(-1.0, 2.4, 2.3) },
	{ id = "under_leaf_west", hover = Vector3.new(-15.0, 2.4, 2.3) },
	{ id = "planter_front", hover = Vector3.new(10.0, 2.0, 1.5) },
	{ id = "crack_mouth", hover = Vector3.new(-20.8, 1.6, 6.0) },
}
Wasp.points = table.freeze(points)

return Wasp
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">WaspLook</string>
            <string name="Source"><![CDATA[--!strict
-- How the mud dauber wasp looks: numbers and names only; Client/WaspBody builds the parts and poses them each frame. A black-and-yellow
-- mud dauber (Sceliphron caementarium) about 2.5 cm long, 1 stud = 1 cm: a black head with big dark eyes and yellow mandibles, a black
-- thorax with a yellow collar and a yellow scutellum, a very long thin yellow petiole (the thread waist) and a black gaster, six long legs
-- with black femurs, a yellow band at each knee, and yellow tibias and feet, two smoky dark wings each side, and two curled antennae.
-- The proportions, joints and walking and hanging poses are Godot's WaspBody (scripts/predator/wasp_body.gd, WASP-01), drawn here from
-- Roblox parts (the fly's pattern, ROBLOX-22): ellipsoids are Parts with a SpecialMesh sphere, rods are Cylinder parts. Where Godot drew
-- wings at 23 Hz (which a 60 Hz screen cannot show), the wing here is a soft translucent blur in flight, as the fly's.
-- Body frame: -Z forward, +Y up, the origin the petiole's base, which is where the wasp's position is. Lengths are studs, colours hex,
-- angles degrees. Ellipsoid `size` is the full diameters (Godot gave radii).

local WaspLook = {}

WaspLook.colors = {
	black = "191919", yellow = "d9af26", eye = "302b24", wing = "4a3b2b", vein = "5b4a31", blur = "3a2e22",
} :: { [string]: string }

-- Reflectance (a glossy black chitin; the eyes a little more).
WaspLook.gloss = { black = 0.05, yellow = 0.02, eye = 0.08 } :: { [string]: number }

-- The ellipsoids that never move relative to the torso. `color` names WaspLook.colors.
WaspLook.body = {
	{ name = "Head", color = "black", at = { 0, 0.04, -1.05 }, size = { 0.46, 0.40, 0.34 } },
	{ name = "Thorax", color = "black", at = { 0, 0.02, -0.63 }, size = { 0.48, 0.48, 0.70 } },
	{ name = "Scutellum", color = "yellow", at = { 0, 0.25, -0.52 }, size = { 0.26, 0.09, 0.17 } },
	{ name = "Collar", color = "yellow", at = { 0, 0.20, -0.85 }, size = { 0.40, 0.08, 0.11 } },
	{ name = "Gaster", color = "black", at = { 0, 0.025, 0.76 }, size = { 0.49, 0.44, 0.78 } },
	{ name = "AbdomenTip", color = "black", at = { 0, -0.01, 1.02 }, size = { 0.30, 0.30, 0.46 } },
	{ name = "AbdomenBase", color = "yellow", at = { 0, 0.04, 0.40 }, size = { 0.24, 0.23, 0.26 } },
	{ name = "EyeL", color = "eye", at = { -0.185, 0.075, -1.075 }, size = { 0.17, 0.30, 0.23 } },
	{ name = "EyeR", color = "eye", at = { 0.185, 0.075, -1.075 }, size = { 0.17, 0.30, 0.23 } },
	{ name = "MandibleL", color = "yellow", at = { -0.055, -0.10, -1.19 }, size = { 0.07, 0.14, 0.13 } },
	{ name = "MandibleR", color = "yellow", at = { 0.055, -0.10, -1.19 }, size = { 0.07, 0.14, 0.13 } },
} :: { { name: string, color: string, at: { number }, size: { number } } }

-- The thread waist: a thin yellow rod from the thorax to the gaster, a little narrower toward the gaster.
WaspLook.petiole = { from = { 0, 0, -0.32 }, to = { 0, 0.04, 0.39 }, diameter = 0.062, color = "yellow" }

-- The antennae: a base on the head, then a scape and a curled flagellum of three segments, in the antenna's own frame (right side; the
-- left mirrors it). `rest` is its turn about x and y at rest, `flick` how far a searching wasp swings it (Godot: 0.20 and 0.12 rad, 0.32 rad).
WaspLook.antenna = {
	base = { 0.075, 0.13, -1.15 },
	points = { { 0, 0, 0 }, { 0.055, 0.10, -0.17 }, { 0.19, 0.06, -0.53 }, { 0.27, 0.02, -0.71 }, { 0.30, -0.06, -0.80 } },
	diameters = { 0.04, 0.026, 0.020, 0.016 },
	colors = { "yellow", "black", "black", "black" },
	rest = { 0.20, 0.12 }, flick = 0.32, hertz = { 3.0, 0.7 },
} :: { base: { number }, points: { { number } }, diameters: { number }, colors: { string }, rest: { number }, flick: number, hertz: { number } }

-- A leg: where its hip sits on the torso (right side, front to hind), and the lengths of its parts. The joints come from WaspPose.
WaspLook.legs = {
	hips = { { 0.17, -0.12, -0.82 }, { 0.17, -0.12, -0.64 }, { 0.17, -0.12, -0.46 } },
	femur = 0.062, tibia = 0.046, tarsus = 0.026,
	band = { length = 0.09, grow = 0.016 }, -- the yellow band at the knee end of the femur
} :: { hips: { { number } }, femur: number, tibia: number, tarsus: number, band: { length: number, grow: number } }

-- Wings: a fore and a hind wing each side. The membrane is a flat ellipse from the root back and out; in flight it is a soft blur of the
-- whole stroke. root: where the wing's pivot sits (right side); sizes are the share of the forewing.
WaspLook.wing = {
	root = { 0.14, 0.20, -0.68 }, hindStep = 0.17, hindShare = 0.68,
	length = 1.15, width = 0.44, thick = 0.012, centre = { 0.20, 0, 0.56 }, sweep = 10,
	-- the angles (Godot): folded at rest on the ground, and the mean of the flap in the air
	folded = { yaw = 12, roll = 6 }, flight = { yaw = 58, roll = 25, shimmerRoll = 7, shimmerHertz = 5.5 },
	transparency = 0.45, flightTransparency = 0.62,
	blur = { widen = 1.55, transparency = 0.86 },
	vein = { diameter = 0.014, tipX = 0.30, to = 0.96 }, -- the dark edge from the root to near the tip
	reflectance = 0.04,
} :: any

-- The torso's gentle bob in the air and while it holds the spider (Godot: 0.025 at 1.3 Hz).
WaspLook.bob = { height = 0.025, hertz = 1.3 }

-- The walking pose is a stride at 3 Hz; the feet reach the surface 0.35 below the position (the wasp lands 0.35 above it).
WaspLook.walk = { hertz = 3.0, lift = 0.13, reach = 0.18 }

return WaspLook
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Wear</string>
            <string name="Source"><![CDATA[--!strict
-- What age and use have done to the sill, the glass and the retreat, and the few small things left lying about: numbers and names
-- only; Habitat/Patina builds them. Colours are hex, lengths studs (1 stud = 1 cm). All of it is flat, tiny or thin, away from the
-- spawn (-22, 0, 6), the silk practice lines and the landing patch, and nothing here is solid or queryable.

local Wear = {}

-- ---------------------------------------------------------------- the sill's paint
-- The sill is cream enamel over wood (Graphics.paint); where the paint has gone the wood shows.
Wear.bare = { color = "9b7650", material = "Wood" }

-- A worn strip along the front lip's top front edge: runs of bare wood between gaps, from x0 to x1 (z from `z0` to the edge).
Wear.lip = {
	y = 0.7, z0 = 12.24, z1 = 12.5, height = 0.012, x0 = -29, x1 = 29,
	runs = { 1.2, 5.5 }, gaps = { 0.6, 3.2 }, -- length ranges
	colors = { "9b7650", "8e6a46", "a58058" }, seed = 31,
}

-- Grime where the floor meets the walls: thin, translucent lines from (x0, z0) to (x1, z1), this wide.
Wear.grime = {
	color = "6e6252", transparency = 0.55, height = 0.003,
	lines = {
		{ -30.0, -12.36, -11.0, -12.36, 0.28 }, { -13.0, -12.40, 9.0, -12.40, 0.22 }, { 6.0, -12.34, 30.0, -12.34, 0.32 },
		{ -30.0, -12.20, 30.0, -12.20, 0.07 },
		{ -29.88, -12.5, -29.88, 11.9, 0.22 }, { -29.70, -9.0, -29.70, 6.0, 0.07 },
		{ 29.88, -12.5, 29.88, 11.9, 0.22 }, { 29.70, -5.0, 29.70, 10.0, 0.07 },
		{ -30.0, 11.93, 30.0, 11.93, 0.09 },
	},
}

-- Dust bunnies in the corners (the two at the back and one at the front right): a cluster of tiny, translucent grey spheres each.
Wear.bunnies = {
	items = {
		{ x = -29.1, z = -11.6, count = 9, spread = 0.55, seed = 11 },
		{ x = 29.0, z = -11.8, count = 7, spread = 0.5, seed = 12 },
		{ x = 29.0, z = 11.3, count = 6, spread = 0.42, seed = 13 }, -- the front right corner, where the lip meets the frame
	},
	color = "b4afa5", transparency = 0.6, radius = { 0.07, 0.17 }, lift = 0.7, -- lift: how flat the spheres are
}

-- ---------------------------------------------------------------- the window glass (full tier)
-- Condensation on the lower panes: tiny flattened Glass spheres. Panes: x ranges clear of the mullions (the glass runs from -27.5
-- to 27.5 with bars at -10 and 10).
Wear.drops = {
	count = 26, size = { 0.1, 0.4 }, seed = 7,
	y = { 3.75, 7.2 }, panes = { { -27.0, -10.5 }, { -9.5, 9.5 }, { 10.5, 27.0 } },
	color = "e8f3f5", transparency = 0.35, reflectance = 0.3, flat = 0.018,
}
Wear.smudges = {
	items = {
		{ x = -16.0, y = 5.0, w = 7.0, h = 3.5, turn = 18 },
		{ x = 15.5, y = 8.8, w = 6.0, h = 3.0, turn = -24 },
	},
	color = "f6f4ee", transparency = 0.93,
}

-- ---------------------------------------------------------------- the silk retreat in the crevice
-- Salticids rest in silk retreats: a few overlapping translucent shells at the back and threads across the opening.
Wear.silk = {
	color = "f4f4ee", shellTransparency = 0.82, threadTransparency = 0.62, thread = 0.022,
	-- shells: centre x, y, z and radii (flattened domes lying on the floor, inside the crevice)
	shells = {
		{ -27.0, 0.0, 4.4, 1.7, 0.95, 1.5 }, { -26.2, 0.0, 6.6, 1.9, 1.05, 1.7 }, { -26.9, 0.0, 8.1, 1.6, 0.85, 1.2 },
		{ -25.4, 0.0, 5.3, 1.4, 0.75, 1.1 }, { -27.3, 0.0, 6.0, 1.3, 0.7, 2.1 },
	},
	-- threads across the opening (x = -23): from x, y, z to x, y, z. The middle of the opening is left clear for the camera that
	-- looks out of the retreat when the game starts.
	threads = {
		{ -23.15, 2.55, 2.8, -23.05, 0.02, 3.4 }, { -23.15, 2.55, 3.7, -23.0, 0.3, 4.1 }, { -23.15, 2.55, 8.9, -23.05, 0.02, 8.4 },
		{ -23.15, 2.55, 8.1, -23.0, 0.3, 7.8 }, { -23.1, 2.45, 2.7, -23.1, 2.35, 9.3 }, { -23.1, 1.2, 2.7, -23.1, 1.3, 4.0 },
		{ -23.1, 1.3, 8.0, -23.1, 1.2, 9.3 },
	},
}

-- ---------------------------------------------------------------- small things on the floor
-- A copper coin lying flat, plain faces, and a few fallen brown Pilea leaves.
Wear.coin = { x = 25.5, z = 9.5, diameter = 1.9, thickness = 0.12, color = "b5764f", material = "Metal" }
Wear.fallen = {
	items = {
		{ x = -11.6, z = 3.2, diameter = 1.7, color = "a07a45" },
		{ x = 4.8, z = 4.1, diameter = 1.3, color = "c49a5b" },
		{ x = 19.6, z = 2.9, diameter = 2.0, color = "a07a45" },
	},
	thickness = 0.03, material = "Fabric",
}

return Wear
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Habitat</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Breakaway</string>
            <string name="Source"><![CDATA[--!strict
-- Godot windowsill.gd T09b: the pale east leaf tip falls on a committed jump.
-- Called on simulation ticks, never wall time. Its identity survives falling/restores.
local Breakaway={}
Breakaway.__index=Breakaway
Breakaway.RESET=8
Breakaway.FALL=0.7
function Breakaway.new(world: Instance, decor: Instance?): any
 local part=world:FindFirstChild("leaf_tip")
 local pieces={}
 local pilea=if decor then decor:FindFirstChild("Pilea") else nil
 local tip=if pilea then pilea:FindFirstChild("leaf_tip") else nil
 if tip then
  for _,p in tip:GetDescendants() do
   if p:IsA("BasePart") then table.insert(pieces,{part=p,frame=p.CFrame,transparency=p.Transparency}) end
  end
 end
 return setmetatable({pieces=pieces,transparency=if part and part:IsA("BasePart") then part.Transparency else 0,part=part,home=if part and part:IsA("BasePart") then part.CFrame else CFrame.identity,
  left=0,elapsed=0,last=nil},Breakaway)
end
function Breakaway.valid(record: any): boolean
 return record==nil or (type(record)=="table" and type(record.left)=="number" and record.left==record.left and record.left>=0 and record.left<=Breakaway.RESET)
end
function Breakaway.record(self: any): any return {left=self.left} end
function Breakaway.apply(self: any, record: any)
 self.left=if record then record.left else 0
 self.elapsed=if self.left>0 then Breakaway.FALL else 0
 self.last=nil
 self:draw(false)
end
function Breakaway.draw(self: any,reduced: boolean)
 local p=self.part
 if not p then return end
 local down=self.left>0
 p.CanCollide=not down;p.CanQuery=not down
 local u=if down then math.clamp(self.elapsed/Breakaway.FALL,0,1) else 0
 local moved=if reduced then self.home else self.home*CFrame.new(.4*u,-5*u*u,0)*CFrame.Angles(0,0,-1.2*u)
 p.CFrame=if #self.pieces>0 then self.home else moved
 p.Transparency=if down and (reduced or u>=1) then 1 else self.transparency
 for _,entry in self.pieces do
  if entry.part.Parent then
   entry.part.CFrame=moved*self.home:Inverse()*entry.frame
   entry.part.Transparency=if down and (reduced or u>=1) then 1 else entry.transparency
  end
 end
end
function Breakaway.step(self: any,dt: number,outcome: any,position: Vector3,reduced: boolean): boolean
 local fell=false
 local wasDown=self.left>0
 if outcome and outcome~=self.last then
  self.last=outcome
  local p=outcome.plan
  if self.left==0 and outcome.kind=="launched" and p and p.point and self.part then
   local localPoint=self.home:PointToObjectSpace(p.point)
   local half=self.part.Size*.5+Vector3.one*.02
   if math.abs(localPoint.X)<=half.X and math.abs(localPoint.Y)<=half.Y and math.abs(localPoint.Z)<=half.Z then
    self.left=Breakaway.RESET;self.elapsed=0;fell=true
   end
  end
 end
 if self.left>0 and not fell then
  self.elapsed+=dt;self.left=math.max(0,self.left-dt)
  if self.left==0 and self.part then
   local p=self.home:PointToObjectSpace(position);local half=self.part.Size*.5+Vector3.one*1.3
   if math.abs(p.X)<=half.X and math.abs(p.Y)<=half.Y and math.abs(p.Z)<=half.Z then self.left=.5 end
  end
 end
 if fell or wasDown then self:draw(reduced) end
 return fell
end
return Breakaway
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">DayLight</string>
            <string name="Source"><![CDATA[--!strict
-- The light of the hour on the sill (ROBLOX-24, after Godot's LIFE-06 set_daylight): the life clock's daylight, 0 (night) to 1
-- (day), blends the daytime lighting of Data/Graphics toward Graphics.dayNight. Pure apart from `apply`, so tests/life.luau
-- checks it without an engine.
--   * Full daylight is exactly the daytime look (Lit.apply's values, and SunPick's through-the-window clock).
--   * The sun: dusk runs the picked morning backwards toward dayNight.nightClock (before sunrise), so the sun sinks on the
--     window's side and the sky turns to night; dawn runs it forwards again.
--   * The room's light, the haze, the sun rays, the light shafts and the dust motes dim with it; a low sun is warmer
--     (Godot: the sun's colour whitens by daylight 0.6).
-- The light is only what the screen shows. How far the spider sees comes from the clock (LifeLoop.rangeScale), never from here.
-- It owns: Lighting's ClockTime, Brightness, Ambient, OutdoorAmbient, ColorShift_Top and ExposureCompensation; the Atmosphere's
-- Color and Decay; SunRays.Intensity; the Shafts beams' Brightness and Enabled; the Motes' Brightness; and (ROBLOX-74, applyDew) the
-- Transparency of the morning dew's drops. Never the eye view's effects (EyeGrade, EyeBlur, MacroDOF: SpiderEyes) or the world's Grade.
local Graphics = require(script.Parent.Parent.Data.Graphics)
local Flora = require(script.Parent.Parent.Data.Flora)

local DayLight = {}

export type Targets = {
	daylight: number, clock: number, brightness: number, exposure: number,
	ambient: { number }, outdoorAmbient: { number }, colorShiftTop: { number },
	atmosphereColor: { number }, atmosphereDecay: { number },
	sunRays: number, shafts: number, motes: number,
}

local function mix(night: number, day: number, t: number): number
	if t >= 1 then return day end
	if t <= 0 then return night end
	return night + (day - night) * t
end

local function mixRgb(night: { number }, day: { number }, t: number): { number }
	return { mix(night[1], day[1], t), mix(night[2], day[2], t), mix(night[3], day[3], t) }
end

local function smoothstep(from: number, to: number, x: number): number
	local s = math.clamp((x - from) / (to - from), 0, 1)
	return s * s * (3 - 2 * s)
end

-- What every light should be at `daylight` (clamped to [0, 1]). `dayClock` is the ClockTime of the day (SunPick's choice).
function DayLight.targets(daylight: number, dayClock: number): Targets
	local d = math.clamp(if daylight == daylight then daylight else 1, 0, 1)
	local L, N, A = Graphics.lighting, Graphics.dayNight, Graphics.atmosphere
	return {
		daylight = d,
		clock = mix(N.nightClock, dayClock, d),
		brightness = mix(N.brightness, L.brightness, d),
		exposure = mix(N.exposureCompensation, L.exposureCompensation, d),
		ambient = mixRgb(N.ambient, L.ambient, d),
		outdoorAmbient = mixRgb(N.outdoorAmbient, L.outdoorAmbient, d),
		colorShiftTop = mixRgb(N.lowSunColorShiftTop, L.colorShiftTop, smoothstep(0, N.warmFrom, d)),
		atmosphereColor = mixRgb(N.atmosphereColor, A.color, d),
		atmosphereDecay = mixRgb(N.atmosphereDecay, A.decay, d),
		sunRays = Graphics.sunRays.intensity * d,
		shafts = d,
		motes = mix(N.motesAtNight, 1, d),
	}
end

-- Whether the light needs setting again: it changed by applyStep, or it reached night or day.
function DayLight.due(last: number?, daylight: number): boolean
	if last == nil then return true end
	if daylight ~= last and (daylight <= 0 or daylight >= 1) then return true end
	return math.abs(daylight - last) >= Graphics.dayNight.applyStep
end

local function rgb(t: { number }): Color3
	return Color3.fromRGB(math.floor(t[1] + 0.5), math.floor(t[2] + 0.5), math.floor(t[3] + 0.5))
end

-- Sets the lights. `decor` is Workspace.Decor (for the shafts and the motes), when it exists. Anything missing (the low tier
-- has no sun rays or shafts) is skipped.
function DayLight.apply(lighting: any, t: Targets, decor: Instance?)
	lighting.ClockTime = t.clock
	lighting.Brightness = t.brightness
	lighting.ExposureCompensation = t.exposure
	lighting.Ambient = rgb(t.ambient)
	lighting.OutdoorAmbient = rgb(t.outdoorAmbient)
	lighting.ColorShift_Top = rgb(t.colorShiftTop)
	local atmosphere = lighting:FindFirstChild("Atmosphere")
	if atmosphere and atmosphere:IsA("Atmosphere") then
		atmosphere.Color = rgb(t.atmosphereColor)
		atmosphere.Decay = rgb(t.atmosphereDecay)
	end
	local rays = lighting:FindFirstChild("SunRays")
	if rays and rays:IsA("SunRaysEffect") then
		rays.Intensity = t.sunRays
	end
	if decor then
		local shafts = decor:FindFirstChild("Shafts")
		if shafts then
			for _, b in shafts:GetDescendants() do
				if b:IsA("Beam") then
					b.Brightness = t.shafts
					b.Enabled = t.shafts > 0.01
				end
			end
		end
		local motes = decor:FindFirstChild("Motes", true)
		if motes and motes:IsA("ParticleEmitter") then
			motes.Brightness = t.motes
		end
	end
end

-- ---------------------------------------------------------------- the morning dew (ROBLOX-74)
-- How much dew there is at an hour of the day (0 to 1): it gathers through the night from Flora.dew.formFrom (20:00) to fullBy (05:00),
-- holds until burnFrom (07:30) and is gone by goneBy (09:30), smoothly. It follows the hour, not the daylight, which is already full by 08:00.
function DayLight.dewAt(hour: number): number
	if hour ~= hour or hour == math.huge or hour == -math.huge then return 0 end
	local D = Flora.dew
	local h = hour % 24
	if h >= D.goneBy and h < D.formFrom then return 0 end
	if h >= D.burnFrom and h < D.goneBy then return 1 - smoothstep(D.burnFrom, D.goneBy, h) end
	return smoothstep(D.formFrom, D.fullBy + 24, if h >= D.formFrom then h else h + 24)
end

-- Sets the dew for `hour` on Workspace.Decor's folder "Dew" (Habitat/Dressing): each drop is shown from its Lag (the share of the dew at
-- which it appears) to full at a dew of 1, with the transparency Base it carries. Nothing is touched unless the dew changed by Flora.dew.step
-- (or reached 0 or 1); the last level is kept in the folder's attribute Level, so no one else holds state. Returns whether it set the drops.
function DayLight.applyDew(decor: Instance?, hour: number): boolean
	local dew = if decor then decor:FindFirstChild("Dew") else nil
	if not dew then return false end
	local level = DayLight.dewAt(hour)
	local last = dew:GetAttribute("Level")
	if type(last) == "number" then
		if last == level then return false end
		if level > 0 and level < 1 and math.abs(level - last) < Flora.dew.step then return false end
	end
	dew:SetAttribute("Level", level)
	for _, drop in dew:GetDescendants() do
		local lag, base = drop:GetAttribute("Lag"), drop:GetAttribute("Base")
		if drop:IsA("BasePart") and type(lag) == "number" and type(base) == "number" then
			local seen = math.clamp((level - lag) / (1 - lag), 0, 1)
			drop.Transparency = 1 - seen * (1 - base)
		end
	end
	return true
end

return DayLight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Dressing</string>
            <string name="Source"><![CDATA[--!strict
-- Dresses the sill (ROBLOX-74, "more grass and detail"), from Data/Flora, on top of what Plants and Patina already draw: moss on the shaded
-- faces, pebbles and bark chips on the floor, two fallen leaves, and the morning dew. Pure visual density: every part is a drawn-only part
-- (Habitat/Shapes: anchored, CanCollide, CanQuery and CanTouch all false), nothing here touches Layout.PIECES, and the places it uses are
-- chosen by Shapes.clearAt, which only reads them. The dew's drops carry the attributes Lag and Base; Habitat/DayLight.applyDew sets their
-- Transparency from the hour. Everything is placed from the world's seed with a salt of its own, so every player sees the same sill. Optional
-- parts are marked FullOnly, which Client/WorldDetail removes on phones and tablets.
local Flora = require(script.Parent.Parent.Data.Flora)
local Wear = require(script.Parent.Parent.Data.Wear)
local Graphics = require(script.Parent.Parent.Data.Graphics)
local Plants = require(script.Parent.Plants)
local Shapes = require(script.Parent.Shapes)

local Dressing = {}

local hex, folder, between = Shapes.hex, Shapes.folder, Shapes.between
local TAU = 2 * math.pi

local function pick<T>(list: { T }, rand: () -> number): T
	return list[1 + math.floor(rand() * #list)]
end

local function stream(salt: number): () -> number
	return Shapes.rng(Flora.worldSeed * 100 + salt)
end

-- ---------------------------------------------------------------- moss on the shaded faces
-- The sun is behind the window, so the trough's room-side face and the foot of the back wall's room-side face are in shade. Each patch is a
-- scatter of flattened mounds lying on the face (Flora.moss); the first `core` of a patch stay in the low tier, the rest are full-tier.
function Dressing.moss(parent: Instance): Folder
	local M = Flora.moss
	local group = folder(parent, "Moss")
	local rand = stream(M.salt)
	for i, patch in M.patches do
		local normal = Vector3.new(patch.normal[1], patch.normal[2], patch.normal[3])
		local centre = Vector3.new(patch.x, patch.y, patch.z)
		local across = normal:Cross(if math.abs(normal.Y) > 0.9 then Vector3.xAxis else Vector3.yAxis).Unit
		local up = normal:Cross(across)
		local cluster = folder(group, "Patch" .. i)
		local fine = folder(cluster, "Fine", true)
		for j = 1, patch.n do
			local angle, dist = rand() * TAU, patch.r * math.sqrt(rand())
			local size = between(rand, M.size[1], M.size[2])
			local thick = size * M.mound
			local at = centre + across * (math.cos(angle) * dist) + up * (math.sin(angle) * dist)
			at = Vector3.new(at.X, math.max(at.Y, size * 0.7), at.Z) + normal * (thick * 0.35 + 0.02) -- not below the floor; sunk a third into the face
			local turn = rand() * TAU
			local along = across * math.cos(turn) + up * math.sin(turn)
			Shapes.ellipsoid(if j <= patch.core then cluster else fine, `Moss{j}`, Vector3.new(size, thick, size * between(rand, 0.7, 1)),
				Shapes.frame(at, along, normal), hex(pick(M.colors, rand)), M.material)
		end
	end
	return group
end

-- ---------------------------------------------------------------- pebbles and bark chips on the floor
-- The feet already taken on the floor (grass, the details, the coin and the Pilea's fallen leaves, the added windfall), so nothing lies on them.
local function occupied(): { Vector3 }
	local out: { Vector3 } = {}
	for _, blade in Plants.grassBlades() do table.insert(out, blade.foot) end
	for _, c in Graphics.details.chips do table.insert(out, Vector3.new(c.x, 0, c.z)) end
	for _, c in Graphics.details.crumbs do table.insert(out, Vector3.new(c.x, 0, c.z)) end
	table.insert(out, Vector3.new(Wear.coin.x, 0, Wear.coin.z))
	for _, leaf in Wear.fallen.items do table.insert(out, Vector3.new(leaf.x, 0, leaf.z)) end
	for _, leaf in Flora.windfall.items do -- a leaf is long: its middle and a point toward each end (its X runs at `turn` about the vertical)
		local turn = math.rad(leaf.turn)
		for _, along in { -0.35, 0, 0.35 } do
			table.insert(out, Vector3.new(leaf.x + math.cos(turn) * leaf.length * along, 0, leaf.z - math.sin(turn) * leaf.length * along))
		end
	end
	return out
end

-- How high the middle of a box of `size` turned by `turned` must be for its lowest point to touch the floor.
local function restHeight(turned: CFrame, size: Vector3): number
	return math.abs(turned.RightVector.Y) * size.X / 2 + math.abs(turned.UpVector.Y) * size.Y / 2 + math.abs(turned.LookVector.Y) * size.Z / 2
end

-- Pebbles first, then bark chips, in the order of Flora.litter; the first `core` of each stay in the low tier.
function Dressing.litter(parent: Instance): Folder
	local L = Flora.litter
	local group = folder(parent, "Litter")
	local rand = stream(L.salt)
	local taken = occupied()
	local function spot(margin: number): Vector3?
		for _ = 1, 40 do
			local x, z = between(rand, L.area.x0, L.area.x1), between(rand, L.area.z0, L.area.z1)
			if Shapes.clearAt(x, 0.02, z, margin) then
				local free = true
				for _, other in taken do
					if (other.X - x) ^ 2 + (other.Z - z) ^ 2 < L.apart * L.apart then
						free = false
						break
					end
				end
				if free then return Vector3.new(x, 0, z) end
			end
		end
		return nil
	end
	local B = L.pebbles
	local pebbles, loose = folder(group, "Pebbles"), folder(group, "FinePebbles", true)
	for i = 1, B.count do
		local at = spot(0.5)
		if at then
			table.insert(taken, at)
			local length = between(rand, B.length[1], B.length[2])
			local height = length * B.flat
			local size = Vector3.new(length, height, length * between(rand, 0.6, 0.9))
			local turned = CFrame.Angles(0, rand() * TAU, 0) * CFrame.Angles((rand() - 0.5) * 0.25, 0, (rand() - 0.5) * 0.25)
			Shapes.ellipsoid(if i <= B.core then pebbles else loose, "Pebble" .. i, size, CFrame.new(at.X, restHeight(turned, size) * 0.8, at.Z) * turned,
				hex(pick(B.colors, rand)), B.material) -- a fifth of its height sunk into the floor
		end
	end
	local K = L.bark
	local chips, fineChips = folder(group, "Bark"), folder(group, "FineBark", true)
	for i = 1, K.count do
		local at = spot(0.5)
		if at then
			table.insert(taken, at)
			local length, width, thick = between(rand, K.length[1], K.length[2]), between(rand, K.width[1], K.width[2]), between(rand, K.thick[1], K.thick[2])
			local size = Vector3.new(length, thick, width)
			local turned = CFrame.Angles(0, rand() * TAU, 0) * CFrame.Angles((rand() - 0.5) * K.tilt, 0, (rand() - 0.5) * K.tilt)
			Shapes.block(if i <= K.core then chips else fineChips, "Chip" .. i, size, CFrame.new(at.X, restHeight(turned, size), at.Z) * turned, hex(pick(K.colors, rand)), K.material)
		end
	end
	return group
end

-- ---------------------------------------------------------------- two fallen leaves
type Leaf = { x: number, z: number, length: number, width: number, turn: number, curl: number, color: string, rib: string }

-- The frame of a fallen leaf's blade (an ellipsoid whose X runs along the leaf and Y is its thickness), turned about the vertical and with one
-- edge lifted; the lower edge touches the floor.
function Dressing.windfallFrame(leaf: Leaf): CFrame
	local W = Flora.windfall
	local curl = math.rad(leaf.curl)
	return CFrame.new(leaf.x, W.thick * 0.5 + math.sin(curl) * leaf.width * 0.5, leaf.z) * CFrame.Angles(0, math.rad(leaf.turn), 0) * CFrame.Angles(curl, 0, 0)
end

-- The blade and a stub of stalk (both tiers) and the lighter midrib (full tier).
function Dressing.windfall(parent: Instance): Folder
	local W = Flora.windfall
	local group = folder(parent, "Windfall")
	for i, leaf in W.items do
		local frame = Dressing.windfallFrame(leaf)
		local one = folder(group, "Leaf" .. i)
		Shapes.ellipsoid(one, "Blade", Vector3.new(leaf.length, W.thick, leaf.width), frame, hex(leaf.color), W.material)
		local half = leaf.length * 0.5
		local from, to = frame:PointToWorldSpace(Vector3.new(-half * 0.95, 0, 0)), frame:PointToWorldSpace(Vector3.new(-half - W.stalk, 0, 0))
		Shapes.strip(one, "Stalk", from, to, 0.08, W.thick, hex(W.stalkColor), W.material)
		local rib = folder(one, "Detail", true)
		Shapes.strip(rib, "Rib", frame:PointToWorldSpace(Vector3.new(-half * 0.9, W.thick * 0.5, 0)), frame:PointToWorldSpace(Vector3.new(half * 0.85, W.thick * 0.5, 0)),
			0.05, 0.01, hex(leaf.rib), W.material)
	end
	return group
end

-- ---------------------------------------------------------------- the morning dew
-- Small translucent Glass droplets. Each starts fully transparent (nothing shows until DayLight.applyDew is given an hour) and carries `Lag`, the
-- share of the dew at which it appears and is gone, and `Base`, the transparency it has when it is there. Where a drop stands on something
-- that the low tier removes, it is full-tier too.
local function bead(parent: Instance, name: string, centre: Vector3, rand: () -> number, keep: boolean)
	local D = Flora.dew
	local d = between(rand, D.size[1], D.size[2])
	local drop = Shapes.ellipsoid(parent, name, Vector3.new(d, d * D.flat, d), CFrame.new(centre + Vector3.new(0, d * D.flat * 0.4, 0)), hex(D.color), D.material)
	drop.Transparency = 1
	drop.Reflectance = D.reflectance
	drop:SetAttribute("Lag", rand() * D.lag)
	drop:SetAttribute("Base", between(rand, D.transparency[1], D.transparency[2]))
	if not keep then drop:SetAttribute("FullOnly", true) end
end

-- Drops on the tallest blade of most tufts (at the tip), around the rim of each green Pilea leaf and on the fallen leaves' edges, in a folder
-- "Dew". The Pilea and fallen-leaf drops stand on the top of the leaf. Returns the folder.
function Dressing.dew(parent: Instance): Folder
	local D = Flora.dew
	local group = folder(parent, "Dew")
	local rand = stream(D.salt)

	local grass = folder(group, "Grass")
	local tallest: { [number]: Plants.Blade } = {}
	local order: { number } = {}
	for _, blade in Plants.grassBlades() do
		local best = tallest[blade.tuft]
		if not best then table.insert(order, blade.tuft) end
		if not best or blade.size.Y > best.size.Y then tallest[blade.tuft] = blade end
	end
	local n = 0
	for _, tuft in order do
		if rand() < D.grass.chance then
			local blade = tallest[tuft]
			n += 1
			bead(grass, "Drop" .. n, blade.tip - blade.direction * 0.08, rand, not blade.fine and n % D.grass.keepEvery == 1)
		end
	end

	local leaves = folder(group, "Leaves")
	for i, plant in Flora.pilea.plants do
		local kept = 0
		for k = 1, D.pilea.perLeaf do
			local angle = TAU * (k - 1 + (rand() - 0.5) * 0.4) / D.pilea.perLeaf + i
			local keep = k % 2 == 1 and kept < D.pilea.keep
			if keep then kept += 1 end
			bead(leaves, `Drop{i}_{k}`, Plants.leafEdge(plant.leaf, angle, D.pilea.inset), rand, keep)
		end
	end

	local fallen = folder(group, "Windfall", true)
	for i, leaf in Flora.windfall.items do
		local frame = Dressing.windfallFrame(leaf)
		for k = 1, D.windfall.perLeaf do
			local angle = TAU * (k - 1 + (rand() - 0.5) * 0.4) / D.windfall.perLeaf + i
			local at = frame:PointToWorldSpace(Vector3.new(math.cos(angle) * leaf.length * 0.36, Flora.windfall.thick * 0.3, math.sin(angle) * leaf.width * 0.36))
			bead(fallen, `Drop{i}_{k}`, at, rand, true)
		end
	end
	return group
end

return Dressing
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Lit</string>
            <string name="Source"><![CDATA[--!strict
-- The lighting, sky and screen effects (Data/Graphics): a soft warm sun picked by SunPick so that it shines in through the
-- window, Atmosphere haze for the view, a gentle bloom, grade and sun rays, clouds, and (full tier) a macro depth of field that
-- keeps the sill sharp and melts the garden outside the window. Depth of field is only added when asked for (Server/Main asks
-- for it unless the Workspace attribute DepthOfField is false).
-- Technology (Future) cannot be set from a script; the Rojo projects author it. Idempotent: effects are reused by name.
local Graphics = require(script.Parent.Parent.Data.Graphics)
local SunPick = require(script.Parent.SunPick)

local Lit = {}

export type Options = {
	sample: ((number, number) -> Vector3)?, -- the sun at (clock, latitude); default: ask the Lighting service
	depthOfField: boolean?, -- true adds the macro depth of field (full tier) that the client keeps focused on the spider
}

local L = Graphics.lighting

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- The child of `parent` with this name and class, made if missing (a wrong class under that name is replaced).
local function child(parent: Instance, className: string, name: string): Instance
	local found = parent:FindFirstChild(name)
	if found and found.ClassName == className then return found end
	if found then found:Destroy() end
	local made = Instance.new(className)
	made.Name = name
	made.Parent = parent
	return made
end

function Lit.apply(lighting: Lighting, terrain: Instance?, options: Options?): SunPick.Result
	local opts: Options = options or {}
	lighting.Brightness = L.brightness
	lighting.Ambient = rgb(L.ambient)
	lighting.OutdoorAmbient = rgb(L.outdoorAmbient)
	lighting.ColorShift_Top = rgb(L.colorShiftTop)
	lighting.EnvironmentDiffuseScale = L.environmentDiffuse
	lighting.EnvironmentSpecularScale = L.environmentSpecular
	lighting.ShadowSoftness = L.shadowSoftness
	lighting.ExposureCompensation = L.exposureCompensation
	lighting.GlobalShadows = true

	-- A sun that comes in through the window; if none can be found the old morning light stays.
	local sample = opts.sample or function(clock: number, latitude: number): Vector3
		lighting.GeographicLatitude = latitude
		lighting.ClockTime = clock
		return lighting:GetSunDirection()
	end
	local picked: SunPick.Result? = nil
	local ok, outcome = pcall(function(): SunPick.Result
		return SunPick.choose(sample, L.clockTime, L.latitude, Graphics.sun)
	end)
	if ok then picked = outcome :: any end
	local sun: SunPick.Result = picked or {
		ok = false, clock = L.clockTime, latitude = L.latitude, direction = Vector3.new(0, 1, 0),
		elevationDeg = 90, azimuthDeg = 0, reason = "the sun could not be sampled",
	}
	lighting.ClockTime = sun.clock
	lighting.GeographicLatitude = sun.latitude
	lighting:SetAttribute("SunPick", (if sun.ok then "ok: " else "fallback: ") .. sun.reason)

	local A = Graphics.atmosphere
	local atmosphere = child(lighting, "Atmosphere", "Atmosphere") :: Atmosphere
	atmosphere.Density = A.density
	atmosphere.Offset = A.offset
	atmosphere.Color = rgb(A.color)
	atmosphere.Decay = rgb(A.decay)
	atmosphere.Glare = A.glare
	atmosphere.Haze = A.haze

	local S = Graphics.sky
	local sky = child(lighting, "Sky", "Sky") :: Sky
	sky.SunAngularSize = S.sunAngularSize
	sky.MoonAngularSize = S.moonAngularSize
	sky.StarCount = S.starCount
	sky.CelestialBodiesShown = true

	local G = Graphics.grade
	local grade = child(lighting, "ColorCorrectionEffect", "Grade") :: ColorCorrectionEffect
	grade.Contrast = G.contrast
	grade.Saturation = G.saturation
	grade.Brightness = G.brightness
	grade.TintColor = rgb(G.tint)

	local B = Graphics.bloom
	local bloom = child(lighting, "BloomEffect", "Bloom") :: BloomEffect
	bloom.Intensity = B.intensity
	bloom.Size = B.size
	bloom.Threshold = B.threshold
	bloom:SetAttribute("FullOnly", true)

	local R = Graphics.sunRays
	local rays = child(lighting, "SunRaysEffect", "SunRays") :: SunRaysEffect
	rays.Intensity = R.intensity
	rays.Spread = R.spread
	rays:SetAttribute("FullOnly", true)

	local stale = lighting:FindFirstChild("MacroDOF")
	if opts.depthOfField then
		local D = Graphics.depthOfField
		local dof = child(lighting, "DepthOfFieldEffect", "MacroDOF") :: DepthOfFieldEffect
		dof.FarIntensity = D.far
		dof.NearIntensity = D.near
		dof.FocusDistance = D.focus
		dof.InFocusRadius = D.radius
		dof:SetAttribute("FullOnly", true) -- phones and tablets go without it (Client/WorldDetail)
	elseif stale then
		stale:Destroy()
	end

	if terrain then
		local C = Graphics.clouds
		local clouds = child(terrain, "Clouds", "Clouds") :: Clouds
		clouds.Cover = C.cover
		clouds.Density = C.density
		clouds.Color = rgb(C.color)
		clouds:SetAttribute("FullOnly", true)
	end
	return sun
end

return Lit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Materials</string>
            <string name="Source"><![CDATA[--!strict
-- Material names (as Data/Graphics spells them) to Roblox's Enum.Material, so the data stays plain text and a typo is caught by
-- tests/world.luau instead of showing up as a grey part in Studio. These are Roblox's built-in materials; with
-- MaterialService.Use2022Materials on (both Rojo projects set it) they carry their own PBR textures.
local Materials = {}

local MAP: { [string]: Enum.Material } = {
	Plastic = Enum.Material.Plastic, SmoothPlastic = Enum.Material.SmoothPlastic, Neon = Enum.Material.Neon,
	Wood = Enum.Material.Wood, WoodPlanks = Enum.Material.WoodPlanks, Plaster = Enum.Material.Plaster,
	Concrete = Enum.Material.Concrete, Brick = Enum.Material.Brick, Glass = Enum.Material.Glass,
	Ground = Enum.Material.Ground, Grass = Enum.Material.Grass, LeafyGrass = Enum.Material.LeafyGrass,
	Fabric = Enum.Material.Fabric, Cardboard = Enum.Material.Cardboard, Sand = Enum.Material.Sand,
	Slate = Enum.Material.Slate, Pebble = Enum.Material.Pebble, Rock = Enum.Material.Rock, Mud = Enum.Material.Mud,
	Limestone = Enum.Material.Limestone, Marble = Enum.Material.Marble, Metal = Enum.Material.Metal,
}

function Materials.known(name: string): boolean
	return MAP[name] ~= nil
end

function Materials.get(name: string): Enum.Material
	return MAP[name] or Enum.Material.SmoothPlastic
end

function Materials.names(): { string }
	local out = {}
	for name in MAP do table.insert(out, name) end
	table.sort(out)
	return out
end

return Materials
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Patina</string>
            <string name="Source"><![CDATA[--!strict
-- Builds what age and use have done to the sill, the glass and the retreat, from Data/Wear: a worn strip along the front lip, grime
-- in the corners, dust bunnies, condensation and smudges on the glass, the silk retreat in the crevice, and a copper coin and some
-- fallen Pilea leaves on the floor. All flat, tiny or thin and drawn only (Habitat/Shapes: nothing collides with it and no ray
-- sees it); each builder returns a folder, and the optional ones are marked FullOnly for Client/WorldDetail.
local Graphics = require(script.Parent.Parent.Data.Graphics)
local Wear = require(script.Parent.Parent.Data.Wear)
local Shapes = require(script.Parent.Shapes)

local Patina = {}

local hex, folder, between = Shapes.hex, Shapes.folder, Shapes.between
local TAU = 2 * math.pi

-- ---------------------------------------------------------------- the sill (full tier)
-- Bare wood along the lip's top front edge, grime where the floor meets the walls, dust bunnies in the corners.
function Patina.sill(parent: Instance): Folder
	local wear = folder(parent, "Wear", true)
	local L = Wear.lip
	local rand = Shapes.rng(L.seed)
	local x, n = L.x0, 0
	while x < L.x1 do
		local length = math.min(between(rand, L.runs[1], L.runs[2]), L.x1 - x)
		local z0 = L.z0 + between(rand, 0, 0.04)
		n += 1
		Shapes.block(wear, "LipWear" .. n, Vector3.new(length, L.height, L.z1 - z0), CFrame.new(x + length / 2, L.y + L.height / 2, (z0 + L.z1) / 2),
			hex(L.colors[1 + math.floor(rand() * #L.colors)]), Wear.bare.material)
		x += length + between(rand, L.gaps[1], L.gaps[2])
	end
	local G = Wear.grime
	local grime = folder(wear, "Grime")
	local y = G.height / 2 + 0.001
	for i, line in G.lines do
		local p = Shapes.strip(grime, "Grime" .. i, Vector3.new(line[1], y, line[2]), Vector3.new(line[3], y, line[4]), line[5], G.height, hex(G.color), "SmoothPlastic")
		p.Transparency = G.transparency
	end
	local B = Wear.bunnies
	for i, bunny in B.items do
		local cluster = folder(wear, "DustBunny" .. i)
		local brand = Shapes.rng(bunny.seed)
		for j = 1, bunny.count do
			local a, d = brand() * TAU, bunny.spread * math.sqrt(brand())
			local r = between(brand, B.radius[1], B.radius[2])
			local fluff = Shapes.ellipsoid(cluster, `Fluff{j}`, Vector3.new(2 * r, 2 * r * B.lift, 2 * r),
				CFrame.new(bunny.x + math.cos(a) * d, r * B.lift, bunny.z + math.sin(a) * d) * CFrame.Angles(0, brand() * TAU, 0), hex(B.color), "Fabric")
			fluff.Transparency = B.transparency + brand() * 0.12
		end
	end
	return wear
end

-- ---------------------------------------------------------------- the glass (full tier)
-- Condensation on the lower panes (tiny flattened Glass spheres) and two faint smudges, on the room side of the glass.
function Patina.glass(parent: Instance): (Folder, Folder)
	local W = Graphics.window
	local face = Shapes.piece(W.hidden[1]).hi.Z - W.glass.setback -- the glass's room-side face
	local D = Wear.drops
	local drops = folder(parent, "Condensation", true)
	local rand = Shapes.rng(D.seed)
	-- ROBLOX-95: the middle lower sash is raised (Graphics.window.opening); a drop that would sit over the gap sits on the raised sash's pane instead, as high
	-- above its bottom rail as it would have been above the sill (the same draws, so every other drop is where it was).
	local O = W.opening
	local lift = O.top + W.sashRail + 0.25 - D.y[1]
	for i = 1, D.count do
		local pane = D.panes[1 + math.floor(rand() * #D.panes)]
		local d = D.size[1] + (D.size[2] - D.size[1]) * rand() ^ 2.2
		local run = 1.15 + (d - D.size[1]) / (D.size[2] - D.size[1]) * 0.9 -- bigger drops are longer: they have started to run
		local x = between(rand, pane[1], pane[2])
		local y = D.y[1] + (D.y[2] - D.y[1]) * rand() ^ 1.8
		if x > O.left - W.jambWidth - d and x < O.right + W.jambWidth + d then y += lift end
		local drop = Shapes.ellipsoid(drops, "Drop" .. i, Vector3.new(d, math.min(d * run, D.size[2]), 2 * D.flat),
			CFrame.new(x, y, face + D.flat), hex(D.color), "Glass")
		drop.Transparency = D.transparency
		drop.Reflectance = D.reflectance
	end
	local S = Wear.smudges
	local smudges = folder(parent, "Smudges", true)
	for i, m in S.items do
		local smudge = Shapes.ellipsoid(smudges, "Smudge" .. i, Vector3.new(m.w, m.h, 0.01),
			CFrame.new(m.x, m.y, face + 0.006) * CFrame.Angles(0, 0, math.rad(m.turn)), hex(S.color), "SmoothPlastic")
		smudge.Transparency = S.transparency
	end
	return drops, smudges
end

-- ---------------------------------------------------------------- the silk retreat in the crevice
-- A few overlapping, translucent shells at the back and threads across the opening: salticids rest in silk retreats.
function Patina.retreat(parent: Instance): Folder
	local S = Wear.silk
	local retreat = folder(parent, "Retreat")
	local silk = hex(S.color)
	for i, shell in S.shells do
		local piece = Shapes.ellipsoid(retreat, "Shell" .. i, Vector3.new(2 * shell[4], 2 * shell[5], 2 * shell[6]), CFrame.new(shell[1], shell[2], shell[3]), silk, "SmoothPlastic")
		piece.Transparency = S.shellTransparency
	end
	for i, thread in S.threads do
		local strand = Shapes.strip(retreat, "Thread" .. i, Vector3.new(thread[1], thread[2], thread[3]), Vector3.new(thread[4], thread[5], thread[6]), S.thread, S.thread, silk, "SmoothPlastic")
		strand.Transparency = S.threadTransparency
	end
	return retreat
end

-- ---------------------------------------------------------------- small things on the floor (full tier)
-- A copper coin lying flat, plain faces, and a few fallen brown Pilea leaves, each with a stub of stalk.
function Patina.floor(parent: Instance)
	local C = Wear.coin
	Shapes.disc(parent, "Coin", C.diameter, C.thickness, Vector3.new(C.x, C.thickness / 2, C.z), hex(C.color), C.material).CastShadow = true
	local F = Wear.fallen
	for i, leaf in F.items do
		Shapes.disc(parent, "FallenLeaf" .. i, leaf.diameter, F.thickness, Vector3.new(leaf.x, F.thickness / 2, leaf.z), hex(leaf.color), F.material)
		local a = i * 2.1
		local from = Vector3.new(leaf.x + math.cos(a) * leaf.diameter * 0.45, F.thickness / 2, leaf.z + math.sin(a) * leaf.diameter * 0.45)
		local to = from + Vector3.new(math.cos(a), 0, math.sin(a)) * 0.55
		Shapes.strip(parent, `FallenStalk{i}`, from, to, 0.08, F.thickness, hex("7d5c30"), F.material)
	end
end

return Patina
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Plants</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the plants of the drawn world from Data/Flora: the Pilea that replaces the leaf and stem pieces of the sill, the trough's
-- planting (water stain, soil, pebbles, moss, seedlings) and the garden outside the window (a window box, black-eyed Susans with
-- their ultraviolet layer, flowering shrubs). Everything is drawn only (Habitat/Shapes: anchored, non-colliding, unqueryable,
-- untouchable); optional detail is marked FullOnly, which Client/WorldDetail removes on phones and tablets. A drawn leaf's top is
-- its piece's top and a drawn stem stands inside its piece's box, so what the spider walks on is what the player sees.
local Flora = require(script.Parent.Parent.Data.Flora)
local Graphics = require(script.Parent.Parent.Data.Graphics)
local Layout = require(script.Parent.WindowsillLayout)
local Shapes = require(script.Parent.Shapes)

local Plants = {}

local hex, folder, between = Shapes.hex, Shapes.folder, Shapes.between
local TAU = 2 * math.pi

local piece = Shapes.piece

local function pick<T>(list: { T }, rand: () -> number): T
	return list[1 + math.floor(rand() * #list)]
end

-- ---------------------------------------------------------------- the Pilea
local P = Flora.pilea

-- The ids of the sill pieces the Pilea draws instead: Scenery hides exactly these, and only once they are drawn.
function Plants.pieceIds(): { string }
	local ids = { P.tip }
	for _, plant in P.plants do
		table.insert(ids, plant.leaf)
		table.insert(ids, plant.stem)
	end
	return ids
end

local function insideRounded(x: number, z: number, x0: number, x1: number, z0: number, z1: number, r: number): boolean
	local dx = math.max(math.abs(x - (x0 + x1) / 2) - ((x1 - x0) / 2 - r), 0)
	local dz = math.max(math.abs(z - (z0 + z1) / 2) - ((z1 - z0) / 2 - r), 0)
	return dx * dx + dz * dz <= r * r
end

-- How far one can go from (sx, sz) along the angle `a` and stay inside the rounded rectangle shrunk by `margin`.
local function reach(sx: number, sz: number, a: number, lo: Vector3, hi: Vector3, r: number, margin: number): number
	local near, far = 0, math.max(hi.X - lo.X, hi.Z - lo.Z) * 2
	local c, s = math.cos(a), math.sin(a)
	for _ = 1, 24 do
		local mid = (near + far) / 2
		if insideRounded(sx + c * mid, sz + s * mid, lo.X + margin, hi.X - margin, lo.Z + margin, hi.Z - margin, math.max(r - margin, 0.05)) then
			near = mid
		else
			far = mid
		end
	end
	return near
end

-- Dark cracks radiating from a stem's foot and a pinch of crumbled soil: the pups rooted in a crack of the old sill.
local function base(parent: Instance, cx: number, cz: number, rand: () -> number)
	local C, K = P.cracks, P.crumbs
	local color = hex(C.color)
	for i = 1, C.count do
		local a = TAU * (i - 1 + rand() * 0.6) / C.count
		local length = between(rand, C.length[1], C.length[2])
		local turn = a + (rand() - 0.5) * 0.9
		local y = C.height / 2 + 0.001
		local p0 = Vector3.new(cx + math.cos(a) * 0.45, y, cz + math.sin(a) * 0.45)
		local p1 = Vector3.new(cx + math.cos(a) * length * 0.6, y, cz + math.sin(a) * length * 0.6)
		local p2 = Vector3.new(p1.X + math.cos(turn) * length * 0.4, y, p1.Z + math.sin(turn) * length * 0.4)
		for j, seg in { { p0, p1 }, { p1, p2 } } do
			Shapes.strip(parent, `Crack{i}_{j}`, seg[1], seg[2], C.width, C.height, color, "SmoothPlastic").Transparency = C.transparency
		end
	end
	for i = 1, K.count do
		local a, d = rand() * TAU, 0.5 + rand() * K.spread
		local size = between(rand, K.size[1], K.size[2])
		Shapes.ellipsoid(parent, "Crumb" .. i, Vector3.new(size, size * 0.55, size * 0.8),
			CFrame.new(cx + math.cos(a) * d, size * 0.2, cz + math.sin(a) * d) * CFrame.Angles(0, rand() * TAU, 0), hex(pick(K.colors, rand)), "Plaster")
	end
end

-- One pancake leaf over its hidden piece, and the petiole over its stem piece.
local function drawPlant(parent: Instance, leaf: Layout.Piece, stem: Layout.Piece, rand: () -> number)
	local lo, hi, r = leaf.lo, leaf.hi, P.radius
	local plant = folder(parent, leaf.id)
	for _, part in Shapes.roundedSlab(plant, "Blade", lo, hi, r, hex(P.top), P.material) do part.CastShadow = true end
	-- the petiole: a round rod inscribed in the stem's box, joining the blade from below, at the stem's x and z
	local cx, cz = (stem.lo.X + stem.hi.X) / 2, (stem.lo.Z + stem.hi.Z) / 2
	local rod = Shapes.rod(plant, "Petiole", Vector3.new(cx, stem.lo.Y, cz), Vector3.new(cx, stem.hi.Y, cz),
		math.min(stem.hi.X - stem.lo.X, stem.hi.Z - stem.lo.Z), hex(P.petiole), P.material)
	rod.CastShadow = true
	local detail = folder(plant, "Detail", true)
	Shapes.roundedSlab(detail, "Under", Vector3.new(lo.X - P.underOut, lo.Y - P.underBelow, lo.Z - P.underOut),
		Vector3.new(hi.X + P.underOut, lo.Y + P.underThick, hi.Z + P.underOut), r + P.underOut, hex(P.under), P.material)
	Shapes.roundedSlab(detail, "Rim", Vector3.new(lo.X - P.rimOut, lo.Y + P.rimFoot, lo.Z - P.rimOut),
		Vector3.new(hi.X + P.rimOut, hi.Y - P.rimDrop, hi.Z + P.rimOut), r + P.rimOut, hex(P.rim), P.material)
	-- peltate: a pale dot where the stalk joins, and the veins fan out from it
	Shapes.disc(detail, "Dot", P.dotDiameter, P.dotHeight, Vector3.new(cx, hi.Y + P.dotHeight / 2, cz), hex(P.dot), P.material)
	local V = P.veins
	local y = hi.Y + V.height / 2
	for i = 1, V.count do
		local a = TAU * (i - 1 + (rand() * 2 - 1) * V.jitter) / V.count
		local far = reach(cx, cz, a, lo, hi, r, V.margin) * V.reach
		if far > V.start + 0.3 then
			local c, s = math.cos(a), math.sin(a)
			Shapes.strip(detail, "Vein" .. i, Vector3.new(cx + c * V.start, y, cz + s * V.start), Vector3.new(cx + c * far, y, cz + s * far),
				V.width, V.height, hex(P.vein), P.material)
		end
	end
	Shapes.disc(detail, "Foot", P.foot.diameter, P.foot.height, Vector3.new(cx, stem.lo.Y + P.foot.height / 2, cz), hex(P.foot.color), P.material)
	base(folder(plant, "Base", true), cx, cz, rand)
end

-- The dry leaf: a curled tan fragment with darker edges.
local function drawTip(parent: Instance, leaf: Layout.Piece)
	local D = P.dry
	local lo, hi = leaf.lo, leaf.hi
	local tip = folder(parent, leaf.id)
	for _, part in Shapes.roundedSlab(tip, "Blade", lo, hi, D.radius, hex(D.color), "Plaster") do part.CastShadow = true end
	local detail = folder(tip, "Detail", true)
	local edge, w, h = hex(D.edge), D.edgeWidth, D.edgeHeight
	local y = hi.Y + h / 2
	local x0, x1, z0, z1 = lo.X + D.edgeInset + w / 2, hi.X - D.edgeInset - w / 2, lo.Z + D.edgeInset + w / 2, hi.Z - D.edgeInset - w / 2
	local r = D.radius
	Shapes.strip(detail, "EdgeN", Vector3.new(x0 + r, y, z0), Vector3.new(x1 - r, y, z0), w, h, edge, "Plaster")
	Shapes.strip(detail, "EdgeS", Vector3.new(x0 + r, y, z1), Vector3.new(x1 - r, y, z1), w, h, edge, "Plaster")
	Shapes.strip(detail, "EdgeW", Vector3.new(x0, y, z0 + r), Vector3.new(x0, y, z1 - r), w, h, edge, "Plaster")
	Shapes.strip(detail, "EdgeE", Vector3.new(x1, y, z0 + r), Vector3.new(x1, y, z1 - r), w, h, edge, "Plaster")
	for i, c in D.curls do
		Shapes.block(detail, "Curl" .. i, Vector3.new(D.curlSize[1], D.curlSize[2], D.curlSize[3]),
			CFrame.new(c.x, hi.Y + 0.07, c.z) * CFrame.Angles(0, math.rad(c.turn), 0) * CFrame.Angles(math.rad(c.tip), 0, 0), hex(D.curl), "Plaster")
	end
end

-- Draws the Pilea: leaves, petioles and the dry leaf, into a folder "Pilea" under `parent`.
function Plants.pilea(parent: Instance): Folder
	local pilea = folder(parent, "Pilea")
	local rand = Shapes.rng(P.seed)
	for _, plant in P.plants do
		drawPlant(pilea, piece(plant.leaf), piece(plant.stem), rand)
	end
	drawTip(pilea, piece(P.tip))
	return pilea
end

-- ---------------------------------------------------------------- the trough's planting
local T = Flora.planter

type Face = { name: string, along: string, fixed: number, outward: number, from: number, to: number }

-- A flat sheet on the trough's face: from, to as fractions along the face, y0 to y1 up it; `layer` stacks sheets without z-fighting.
local function sheet(parent: Instance, face: Face, from: number, to: number, y0: number, y1: number, layer: number, color: Color3, transparency: number)
	local th = T.stain.thickness
	local a, b = face.from + (face.to - face.from) * from, face.from + (face.to - face.from) * to
	local off = face.fixed + face.outward * (0.002 + layer * 0.003 + th / 2)
	local size = if face.along == "x" then Vector3.new(b - a, y1 - y0, th) else Vector3.new(th, y1 - y0, b - a)
	local at = if face.along == "x" then Vector3.new((a + b) / 2, (y0 + y1) / 2, off) else Vector3.new(off, (y0 + y1) / 2, (a + b) / 2)
	Shapes.block(parent, "Sheet", size, CFrame.new(at), color, "SmoothPlastic").Transparency = transparency
end

-- A flattened ellipsoid lying on the soil with a random turn: used for pebbles, moss and the damp patches.
local function lump(parent: Instance, name: string, at: Vector3, size: Vector3, color: Color3, material: string, rand: () -> number, tilt: number)
	local frame = CFrame.new(at) * CFrame.Angles(0, rand() * TAU, 0) * CFrame.Angles((rand() - 0.5) * tilt, 0, (rand() - 0.5) * tilt)
	return Shapes.ellipsoid(parent, name, size, frame, color, material)
end

function Plants.planter(parent: Instance): Folder
	local trough = piece("planter")
	local planter = folder(parent, "Planter")
	local stain = folder(planter, "Stain", true)
	local S = T.stain
	local rand = Shapes.rng(T.pebbles.seed)
	local faces: { Face } = {
		{ name = "Front", along = "x", fixed = trough.hi.Z, outward = 1, from = trough.lo.X, to = trough.hi.X },
		{ name = "Back", along = "x", fixed = trough.lo.Z, outward = -1, from = trough.lo.X, to = trough.hi.X },
		{ name = "West", along = "z", fixed = trough.lo.X, outward = -1, from = trough.lo.Z, to = trough.hi.Z },
		{ name = "East", along = "z", fixed = trough.hi.X, outward = 1, from = trough.lo.Z, to = trough.hi.Z },
	}
	for _, face in faces do
		local group = folder(stain, face.name)
		local scale = between(rand, 0.85, 1.15)
		sheet(group, face, 0, 1, 0, S.height, 0, hex(S.color), S.transparency)
		for _, tide in S.tide do
			sheet(group, face, tide[1], tide[2], 0, tide[3] * scale, 1, hex(S.tideColor), S.tideTransparency)
		end
		for _, salt in S.salt do
			local middle = (salt[1] + salt[2]) / 2
			local top = S.height
			for _, tide in S.tide do
				if middle >= tide[1] and middle <= tide[2] then top = tide[3] * scale end
			end
			sheet(group, face, salt[1], salt[2], top + S.saltGap, top + S.saltGap + S.saltHeight, 2, hex(S.saltColor), S.saltTransparency)
		end
	end

	local area = T.area
	local mottle = folder(planter, "Damp", true)
	for i, m in T.mottle do
		local patch = Shapes.ellipsoid(mottle, "Damp" .. i, Vector3.new(m.w, 0.006, m.d), CFrame.new(m.x, area.y, m.z), hex(m.color), "Plaster")
		patch.Transparency = 0.3
	end

	local B = T.pebbles
	local pebbles = folder(planter, "Pebbles", true)
	local placed: { Vector3 } = {}
	for i = 1, B.count do
		local at = Vector3.zero
		for _ = 1, 12 do
			at = Vector3.new(between(rand, area.x0, area.x1), 0, between(rand, area.z0, area.z1))
			local clear = true
			for _, other in placed do
				if (other - at).Magnitude < 0.8 then clear = false end
			end
			if clear then break end
		end
		table.insert(placed, at)
		local length = between(rand, B.length[1], B.length[2])
		local height = length * B.flat
		lump(pebbles, "Pebble" .. i, Vector3.new(at.X, area.y + height * 0.3, at.Z), Vector3.new(length, height, length * between(rand, 0.6, 0.9)),
			hex(pick(B.colors, rand)), "Plaster", rand, 0.25)
	end

	local M = T.moss
	local moss = folder(planter, "Moss", true)
	local mrand = Shapes.rng(M.seed)
	for i, patch in M.patches do
		for j = 1, patch.n do
			local a, d = mrand() * TAU, patch.r * math.sqrt(mrand())
			local size = between(mrand, M.size[1], M.size[2])
			lump(moss, `Moss{i}_{j}`, Vector3.new(patch.x + math.cos(a) * d, area.y + size * M.tall * 0.25, patch.z + math.sin(a) * d),
				Vector3.new(size, size * M.tall, size * between(mrand, 0.7, 1.0)), hex(pick(M.colors, mrand)), "Plaster", mrand, 0.2)
		end
	end

	local seedlings = folder(planter, "Seedlings", true)
	local C = T.cotyledon
	for i, s in T.seedlings do
		local foot = Vector3.new(s.x, area.y, s.z)
		local top = foot + Vector3.new(0, T.stalk, 0)
		Shapes.rod(seedlings, `Seedling{i}Stalk`, foot, top, T.stalkWidth, hex(T.stalkColor), "SmoothPlastic")
		local heading = math.rad(s.turn)
		local dir = Vector3.new(math.cos(heading), 0, math.sin(heading))
		for side = 1, 2 do
			local sign = if side == 1 then 1 else -1
			local lift = math.rad(T.cotyledonTip)
			local along = dir * (sign * math.cos(lift)) + Vector3.yAxis * math.sin(lift)
			Shapes.ellipsoid(seedlings, `Seedling{i}Leaf{side}`, Vector3.new(C[1], C[2], C[3]),
				Shapes.frame(top + dir * (sign * C[1] * 0.42) + Vector3.new(0, T.cotyledonRise, 0), along, Vector3.yAxis), hex(T.cotyledonColor), "SmoothPlastic")
		end
	end
	return planter
end

-- ---------------------------------------------------------------- the garden outside the window
local G = Flora.garden

-- The ids of the outer sill's pieces the window box draws instead (World/Garden's window_box_west and window_box_east): Scenery hides exactly these, and
-- only once the garden is drawn (ROBLOX-95).
function Plants.windowBoxIds(): { string }
	local ids = {}
	for _, half in G.box.boxes do table.insert(ids, half.id) end
	return ids
end

-- ROBLOX-95: two halves either side of the raised sash, standing on the stone outer sill; each half is drawn as the one box was.
local function windowBox(parent: Instance)
	local B = G.box
	local box = folder(parent, "WindowBox")
	local d = B.z1 - B.z0
	local cz = (B.z0 + B.z1) / 2
	local rimBottom = B.soilTop - 0.1
	local rim = hex(B.rim)
	local rimHeight = B.top - rimBottom
	local ry = (B.top + rimBottom) / 2
	for _, span in B.boxes do
		local half = folder(box, if span.x1 <= 0 then "West" else "East")
		local w, cx = span.x1 - span.x0, (span.x0 + span.x1) / 2
		Shapes.block(half, "Body", Vector3.new(w, rimBottom - B.bottom, d), CFrame.new(cx, (rimBottom + B.bottom) / 2, cz), hex(B.color), "Wood")
		Shapes.block(half, "Soil", Vector3.new(w - 2 * B.rimWidth, 0.4, d - 2 * B.rimWidth), CFrame.new(cx, B.soilTop - 0.2, cz), hex(B.soil), "Ground")
		Shapes.block(half, "RimFar", Vector3.new(w, rimHeight, B.rimWidth), CFrame.new(cx, ry, B.z0 + B.rimWidth / 2), rim, "Wood")
		Shapes.block(half, "RimNear", Vector3.new(w, rimHeight, B.rimWidth), CFrame.new(cx, ry, B.z1 - B.rimWidth / 2), rim, "Wood")
		Shapes.block(half, "RimWest", Vector3.new(B.rimWidth, rimHeight, d - 2 * B.rimWidth), CFrame.new(span.x0 + B.rimWidth / 2, ry, cz), rim, "Wood")
		Shapes.block(half, "RimEast", Vector3.new(B.rimWidth, rimHeight, d - 2 * B.rimWidth), CFrame.new(span.x1 - B.rimWidth / 2, ry, cz), rim, "Wood")
		for i, peel in B.peel do
			if peel[1] > span.x0 and peel[1] < span.x1 then
				Shapes.block(half, "Peel" .. i, Vector3.new(peel[3], 0.01, peel[4]), CFrame.new(peel[1], B.top + 0.006, peel[2]), hex(B.paint), "SmoothPlastic")
			end
		end
	end
end

type FlowerSpec = { x: number, z: number, y: number, nod: number, turn: number, size: number }

-- One black-eyed Susan: golden petals round a dark dome, a bent stem and two leaves; its head nods and turns toward the room. The
-- ultraviolet pattern is a layer of Neon parts, invisible until the eye-view helper fades them in: the outer half of each petal
-- reflects ultraviolet, the base and the centre absorb it.
local function rudbeckia(parent: Instance, uv: Instance, index: number, spec: FlowerSpec, rand: () -> number)
	local F = G.rudbeckia
	local s = spec.size
	local flower = folder(parent, "Flower" .. index)
	local nod, turn = math.rad(spec.nod), math.rad(spec.turn)
	local facing = Vector3.new(math.sin(turn) * math.cos(nod), math.sin(nod), math.cos(turn) * math.cos(nod)).Unit
	local right = Vector3.yAxis:Cross(facing).Unit
	local up = facing:Cross(right)
	local head = Vector3.new(spec.x, spec.y, spec.z)
	local centre = F.centre * s
	-- the stem and the head's golden disc and dark dome (both tiers)
	local soil = Vector3.new(spec.x, G.box.soilTop, spec.z)
	local back = head - facing * 0.3
	local side = if rand() < 0.5 then right else -right
	local bend = back:Lerp(soil, 0.55) + side * (F.stemBend * s)
	Shapes.rod(flower, "StemLow", soil, bend, F.stemWidth * s, hex(F.stem), "SmoothPlastic")
	Shapes.rod(flower, "StemHigh", bend, back, F.stemWidth * s * 0.85, hex(F.stem), "SmoothPlastic")
	local discR = centre + F.discOut * s
	Shapes.ellipsoid(flower, "Disc", Vector3.new(2 * discR, 0.1, 2 * discR), CFrame.fromMatrix(head - facing * 0.04, right, facing), hex(F.disc), "SmoothPlastic")
	Shapes.ellipsoid(flower, "Dome", Vector3.new(2 * centre, 2 * F.centreHeight * s, 2 * centre), CFrame.fromMatrix(head, right, facing), hex(F.centreColor), "Plaster")
	-- the petals (full tier) and their ultraviolet halves
	local petals = folder(flower, "Petals", true)
	local count = math.floor(between(rand, F.petals[1], F.petals[2] + 0.999))
	for i = 1, count do
		local angle = TAU * (i - 1 + (rand() - 0.5) * 0.35) / count
		local dir = right * math.cos(angle) + up * math.sin(angle)
		local droop = math.rad(F.droop) * between(rand, 0.7, 1.3)
		local long = dir * math.cos(droop) - facing * math.sin(droop)
		local thin = facing * math.cos(droop) + dir * math.sin(droop)
		local length = F.petalLength * s * between(rand, 0.92, 1.08)
		local width, thick = F.petalWidth * s, F.petalThick
		local base = centre * 0.9
		Shapes.ellipsoid(petals, "Petal" .. i, Vector3.new(length, thick, width), CFrame.fromMatrix(head + long * (base + length / 2), long, thin),
			hex(F.petalColors[1 + (i - 1) % #F.petalColors]), "SmoothPlastic")
		local U = F.uv
		local patch = Shapes.ellipsoid(uv, `Flower{index}Petal{i}`, Vector3.new(length * 0.5 * 0.95, U.thick, width * 0.85),
			CFrame.fromMatrix(head + long * (base + length * 0.75) + thin * (thick / 2 + U.rise), long, thin), hex(U.color), "Neon")
		patch.Transparency = 1
		patch:SetAttribute("UVOpacity", U.opacity)
		patch:SetAttribute("FullOnly", true)
	end
	-- two leaves low on the stem (full tier)
	local leaves = folder(flower, "Leaves", true)
	for i = 1, 2 do
		local from = soil:Lerp(bend, 0.22 + 0.25 * i)
		local yaw = rand() * TAU
		local out = Vector3.new(math.cos(yaw), 0.5, math.sin(yaw)).Unit
		local size = Vector3.new(F.leafSize[1] * s, F.leafSize[2], F.leafSize[3] * s)
		Shapes.ellipsoid(leaves, "Leaf" .. i, size, Shapes.frame(from + out * (size.X / 2), out, Vector3.yAxis), hex(F.leaf), "SmoothPlastic")
	end
end

-- A flowering bush to the ground (ROBLOX-103: the shrubs were standards on stems): a rounded core of leaves whose underside is a little above the lawn, lumps of
-- leaves over its top and sides (the lowest touching the lawn), a woody frame of stems from the lawn up into the crown, and blossoms on the side facing the
-- house. Each where Flora.garden.shrubs puts it, in the garden's own studs; the low tier keeps the core, a few lumps, two stems and two blossoms. `place` (the
-- view's projection, Scenery.viewPosition) is no longer needed: the bushes are where they are.
local function shrubs(parent: Instance, _place: (number, number, number) -> (Vector3, number))
	local S = G.shrub
	local rand = Shapes.rng(S.seed)
	local group = folder(parent, "Shrubs")
	local function ball(name: string, at: Vector3, diameter: number, color: Color3, material: string, optional: boolean)
		local p = Shapes.block(group, name, Vector3.one * diameter, CFrame.new(at), color, material)
		p.Shape = Enum.PartType.Ball
		if optional then Shapes.fullOnly(p) end
	end
	local ground = Graphics.view.ground.y
	for i, spec in G.shrubs do
		local h, w = spec.h, spec.w
		local base = Vector3.new(spec.x, ground, spec.z)
		-- the core: a rounded mass of leaves from just above the lawn to the top
		local bottom = ground + h * S.skirt
		local core = Shapes.ellipsoid(group, `Shrub{i}`, Vector3.new(w * 0.94, (h - h * S.skirt) * 0.98, w * 0.88), CFrame.new(spec.x, (bottom + ground + h) / 2, spec.z)
			* CFrame.Angles(0, rand() * TAU, 0), hex(pick(S.foliage, rand)), S.material)
		core.CastShadow = false
		-- the frame: stems from the lawn splaying up into the crown (the low tier keeps the first two)
		local F = S.frame
		for k = 1, F.stems do
			local a = (k - 1) / F.stems * TAU + rand() * 0.8
			local foot = base + Vector3.new(math.cos(a) * w * 0.06, 0, math.sin(a) * w * 0.06)
			local top = Vector3.new(spec.x + math.cos(a) * w * F.reach * 0.5, ground + h * between(rand, 0.35, 0.5), spec.z + math.sin(a) * w * F.reach * 0.5)
			local stem = Shapes.rod(group, `Shrub{i}Stem{k}`, foot, top, w * F.width * (if k == 1 then 1.2 else 0.85), hex(F.color), F.material)
			stem.CastShadow = false
			if k > F.keepStems then Shapes.fullOnly(stem) end
		end
		-- the crown's lumps: the first `keep` on top (sunlit), the rest round the sides down to the lawn
		for k = 1, S.clusters do
			local top = k <= S.keep
			local a = rand() * TAU
			local tilt = if top then between(rand, 0, 0.55) else between(rand, 0.9, 1.75) -- from straight up
			local dir = Vector3.new(math.cos(a) * math.sin(tilt), math.cos(tilt), math.sin(a) * math.sin(tilt))
			local size = w * between(rand, S.clusterSize[1], S.clusterSize[2])
			local centre = Vector3.new(spec.x, ground + h * 0.5, spec.z) + Vector3.new(dir.X * w * 0.36, dir.Y * h * 0.36, dir.Z * w * 0.33)
			if centre.Y - size / 2 < ground then centre = Vector3.new(centre.X, ground + size / 2 - size * 0.08, centre.Z) end -- down to the lawn, not under it
			ball(`Shrub{i}Leaf{k}`, centre, size, hex(if top then pick(S.sunlit, rand) else pick(S.foliage, rand)), S.material, not top)
		end
		-- the blossoms, on the side facing the house (+z) and upward
		local colors = if spec.bloom == "pink" then S.pink else S.white
		for k = 1, S.blooms do
			local a = between(rand, 0.15, math.pi - 0.15)
			local tilt = between(rand, 0.35, 1.35)
			local dir = Vector3.new(math.cos(a) * math.sin(tilt), math.cos(tilt), math.sin(a) * math.sin(tilt))
			local at = Vector3.new(spec.x, ground + h * 0.5, spec.z) + Vector3.new(dir.X * w * 0.47, dir.Y * h * 0.47, dir.Z * w * 0.44)
			ball(`Shrub{i}Bloom{k}`, at, between(rand, S.bloomSize[1], S.bloomSize[2]) * w, hex(pick(colors, rand)), "SmoothPlastic", k > S.bloomKeep)
		end
	end
end

-- Builds the garden (window box, flowers, shrubs) into a folder "Garden" under `parent`; the UV pattern goes into `uv`.
function Plants.garden(parent: Instance, uv: Instance, place: (number, number, number) -> (Vector3, number)): Folder
	local garden = folder(parent, "Garden")
	windowBox(garden)
	local rand = Shapes.rng(G.rudbeckia.seed)
	for i, spec in G.flowers do
		rudbeckia(garden, uv, i, spec, rand)
	end
	shrubs(garden, place)
	return garden
end

-- ---------------------------------------------------------------- the grass
-- One blade of grass. `foot` is where it stands, `tip` its upper end, `direction` the way it points, `size` the ellipsoid's diameters.
export type Blade = { tuft: number, index: number, fine: boolean, size: Vector3, frame: CFrame, foot: Vector3, tip: Vector3, direction: Vector3, color: Color3 }

local GR = Flora.grass

local function shaded(c: Color3, shade: number): Color3
	return Color3.new(math.min(c.R * shade, 1), math.min(c.G * shade, 1), math.min(c.B * shade, 1))
end

-- A free place for a tuft in a region (Shapes.clearAt, and `apart` from every foot in `taken` on the same surface), or nil after forty tries.
local function tuftSpot(rand: () -> number, region: { x0: number, x1: number, z0: number, z1: number, y: number }, taken: { Vector3 }, apart: number): Vector3?
	for _ = 1, 40 do
		local x, z = between(rand, region.x0, region.x1), between(rand, region.z0, region.z1)
		if Shapes.clearAt(x, region.y, z, 0.35) then
			local clear = true
			for _, other in taken do
				if math.abs(other.Y - region.y) < 1 and (other.X - x) ^ 2 + (other.Z - z) ^ 2 < apart * apart then
					clear = false
					break
				end
			end
			if clear then return Vector3.new(x, region.y, z) end
		end
	end
	return nil
end

-- Every blade of grass on the sill, tuft by tuft: Chet's 14 patches first (five blades each, built exactly as before) and then the tufts of
-- ROBLOX-74, placed from the world's seed in Flora.grass.more.regions. Pure: the same blades every time, so the dew can stand on their tips.
function Plants.grassBlades(): { Blade }
	local out: { Blade } = {}
	local feet: { Vector3 } = {}
	for i, xyz in GR.patches do
		local origin = Vector3.new(xyz[1], xyz[2], xyz[3])
		table.insert(feet, origin)
		for j = 1, 5 do
			local turn = i * 2.399 + j * 1.257
			local height = 0.25 + ((i * 7 + j * 3) % 9) * 0.035
			local lean = Vector3.new(math.cos(turn) * 0.14, 0, math.sin(turn) * 0.14)
			local frame = CFrame.new(origin + Vector3.new(0, height * 0.5, 0) + lean * 0.5) * CFrame.Angles(0, turn, 0.22)
			table.insert(out, {
				tuft = i, index = j, fine = j > 3, size = Vector3.new(0.065, height, 0.025), frame = frame, foot = origin,
				tip = frame:PointToWorldSpace(Vector3.new(0, height * 0.5, 0)), direction = frame.UpVector, color = hex(GR.colors[1 + (i + j) % 3]),
			})
		end
	end
	local M = GR.more
	local rand = Shapes.rng(Flora.worldSeed * 100 + M.salt)
	local tuft = #GR.patches
	for _, region in M.regions do
		for _ = 1, region.n do
			local origin = tuftSpot(rand, region, feet, M.apart)
			if origin then
				tuft += 1
				table.insert(feet, origin)
				local growth = between(rand, 0.15, 1)
				local offset = rand() * TAU
				for j = 1, M.blades do
					local height = M.height[1] + (M.height[2] - M.height[1]) * math.min(growth * between(rand, 0.5, 1), 1)
					local width = between(rand, M.width[1], M.width[2])
					local turn = offset + (j - 1) * TAU / M.blades + (rand() - 0.5) * 0.9
					local tilt = between(rand, M.tilt[1], M.tilt[2])
					local frame = CFrame.new(origin) * CFrame.Angles(0, turn, tilt) * CFrame.new(0, height * 0.5, 0)
					local shade = between(rand, M.shade[1], M.shade[2])
					local a = 1 + math.floor(rand() * #GR.colors)
					local b = 1 + math.floor(rand() * #GR.colors)
					local color = shaded(hex(GR.colors[a]):Lerp(hex(GR.colors[b]), rand()), shade)
					if rand() < M.dryShare then color = shaded(hex(M.dry), shade) end
					table.insert(out, {
						tuft = tuft, index = j, fine = j > M.blades - M.fine, size = Vector3.new(width, height, width * 0.4), frame = frame, foot = origin,
						tip = frame:PointToWorldSpace(Vector3.new(0, height * 0.5, 0)), direction = frame.UpVector, color = color,
					})
				end
			end
		end
	end
	return out
end

-- Builds the grass: a folder "GrassTufts" with one folder per tuft; its fine blades sit in their own full-tier folders.
function Plants.grass(parent: Instance): Folder
	local group = folder(parent, "GrassTufts")
	local tufts: { [number]: Folder } = {}
	for _, blade in Plants.grassBlades() do
		local tuft = tufts[blade.tuft]
		if not tuft then
			tuft = folder(group, "Tuft" .. blade.tuft)
			tufts[blade.tuft] = tuft
		end
		local into: Instance = if blade.fine then folder(tuft, "Fine" .. blade.index, true) else tuft
		Shapes.ellipsoid(into, "GrassBlade", blade.size, blade.frame, blade.color, "SmoothPlastic").CastShadow = false
	end
	return group
end

-- A point on the top of the drawn leaf of the piece `id` (its blade is the piece's footprint with rounded corners): in the direction `angle`
-- (radians, in plan) from the leaf's middle, `inset` in from the edge. Used by the dew.
function Plants.leafEdge(id: string, angle: number, inset: number): Vector3
	local leaf = piece(id)
	local cx, cz = (leaf.lo.X + leaf.hi.X) / 2, (leaf.lo.Z + leaf.hi.Z) / 2
	local far = reach(cx, cz, angle, leaf.lo, leaf.hi, P.radius, inset)
	return Vector3.new(cx + math.cos(angle) * far, leaf.hi.Y, cz + math.sin(angle) * far)
end

return Plants
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Scenery</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the drawn world from Data/Graphics: the sill's physical pieces (looks only), and a "Decor" model (a persistent one, ROBLOX-94) with the window wall,
-- glass and trim, the view out of the window, the dust, the small details, the light shafts, and (Habitat/Plants, Habitat/Patina,
-- from Data/Flora and Data/Wear) the Pilea, the planting, the garden outside the window, the wear on the sill and the glass and
-- the silk retreat, and (Habitat/Dressing, ROBLOX-74) the shaded moss, the floor's pebbles and bark, the fallen leaves and the morning dew.
-- Gameplay never reads any of the decor: every decor part is CanQuery = false, CanCollide = false, CanTouch =
-- false, so the spider's rays, the camera's casts and the jump planner see only the physical pieces. Parts and emitters that
-- only the full tier keeps carry the attribute FullOnly, which Client/WorldDetail removes on phones and tablets. A piece whose
-- look is replaced by a drawing (the back wall, the Pilea's leaves and stems) turns invisible only once that drawing exists.
local Graphics = require(script.Parent.Parent.Data.Graphics)
local Flora = require(script.Parent.Parent.Data.Flora)
local Meshes = require(script.Parent.Parent.Data.Meshes)
local Surfaces = require(script.Parent.Parent.Data.Surfaces)
local Layout = require(script.Parent.WindowsillLayout)
local Materials = require(script.Parent.Materials)
local Dressing = require(script.Parent.Dressing)
local Patina = require(script.Parent.Patina)
local Plants = require(script.Parent.Plants)
local Shapes = require(script.Parent.Shapes)

local Scenery = {}

local W = Graphics.window
local M = Graphics.materials

local function hex(s: string): Color3
	return Color3.fromHex(s)
end

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- A drawn-only part: anchored, nothing collides with it, no ray sees it.
local function drawn(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: string): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = Materials.get(material)
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function piece(id: string): Layout.Piece
	for _, p in Layout.PIECES do
		if p.id == id then return p end
	end
	error("no piece " .. id)
end

-- ---------------------------------------------------------------- the physical sill
-- The set of piece ids that drawn decor stands in for: the back wall and the Pilea (Scenery.decor returns the ones it built).
local function replaceable(): { [string]: boolean }
	local all: { [string]: boolean } = {}
	for _, id in W.hidden do all[id] = true end
	for _, id in Plants.pieceIds() do all[id] = true end
	return all
end

-- The box the drawn window wall stands in for: the union of the back frame's pieces (one box until ROBLOX-95, four around the raised sash since). `min, max`.
function Scenery.wallBox(): (Vector3, Vector3)
	local first = piece(W.hidden[1])
	local x0, y0, z0, x1, y1, z1 = first.lo.X, first.lo.Y, first.lo.Z, first.hi.X, first.hi.Y, first.hi.Z
	for _, id in W.hidden do
		local p = piece(id)
		x0, y0, z0 = math.min(x0, p.lo.X), math.min(y0, p.lo.Y), math.min(z0, p.lo.Z)
		x1, y1, z1 = math.max(x1, p.hi.X), math.max(y1, p.hi.Y), math.max(z1, p.hi.Z)
	end
	return Vector3.new(x0, y0, z0), Vector3.new(x1, y1, z1)
end

-- The physical parts of some pieces, one anchored Part for each, into `parent` (ROBLOX-94: the part-making the sill always had, for any region's pieces; World/WorldBuild builds
-- each region with it). `hide`: the ids of the pieces whose look is replaced by a drawing; those turn invisible but stay solid and climbable.
function Scenery.parts(parent: Instance, pieces: { Layout.Piece }, hide: { [string]: boolean })
	for _, spec in pieces do
		assert(Surfaces[spec.profile], "unknown surface profile " .. spec.profile)
		local p = Instance.new("Part")
		p.Name = spec.id
		p.Anchored = true
		p.Size = spec.hi - spec.lo
		p.Position = (spec.lo + spec.hi) * 0.5
		local paint = Graphics.paint[spec.id]
		p.Color = if paint then hex(paint.color) else spec.color
		if paint and paint.reflectance then p.Reflectance = paint.reflectance end
		p.Material = Materials.get(M.pieces[spec.id] or (spec :: any).material or M.fallback) -- (a garden piece names its own, ROBLOX-95: World/Garden)
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p:SetAttribute("SurfaceId", spec.id)
		p:SetAttribute("ProfileId", spec.profile)
		if hide[spec.id] then
			-- still solid and climbable; the decor draws it in its place (the wall with a see-through opening, the leaves and stems)
			p.Transparency = 1
			p.CastShadow = false
		end
		p.Parent = parent
	end
end

-- `replaced`: the ids of the pieces whose drawn version exists (Scenery.decor's second result); those turn invisible but stay solid
-- and climbable. A piece whose drawing could not be built stays visible instead of leaving a hole. nil means all the pieces that
-- the decor can replace (the wall and the Pilea's leaves and stems). `pieces`: the sill's boxes (the layout's own unless World/WorldBuild hands in its region's, which are the same).
function Scenery.sill(replaced: { [string]: boolean }?, pieces: { Layout.Piece }?): Folder
	local hide = replaced or replaceable()
	local sill = Instance.new("Folder")
	sill.Name = "Windowsill"
	sill:SetAttribute("ContentRevision", Layout.CONTENT_REVISION)
	Scenery.parts(sill, pieces or Layout.PIECES, hide)
	return sill
end

-- ---------------------------------------------------------------- a drawn look from records (ROBLOX-95)
-- One drawn-only part for each record of a region's look (World/Garden.Drawn: Region.decor of every kind but the sill's): anchored, nothing collides with it, no
-- ray sees it, built into a folder per `group` under `parent`; `full` records carry FullOnly (Client/WorldDetail drops them on the low tier). Returns how many.
-- ROBLOX-108: `first` and `last` build only that slice of the list (a client spreads a look over a few frames, Client/LookStream), and `folders`, kept by the
-- caller between slices, holds the group folders already made under `parent`, so a look built in slices is the one built at once.
export type Drawn = {
	id: string, size: Vector3, at: Vector3, color: Color3, transparency: number?,
	material: string?, shape: string?, turn: Vector3?, full: boolean?, group: string?, shadow: boolean?,
	far: boolean?, reflectance: number?, -- (ROBLOX-115: the preserve's backdrop: in the zone's far look; a shine)
	dew: number?, -- (ROBLOX-117: a dew drop's lag)
}
function Scenery.look(parent: Instance, list: { Drawn }, first: number?, last: number?, folders: { [string]: Instance }?): number
	local groups: { [string]: Instance } = folders or {}
	local i0, i1 = first or 1, math.min(last or #list, #list)
	for i = i0, i1 do
		local d = list[i]
		local name = d.group or ""
		local into: Instance? = groups[name]
		if into == nil then
			local made = if name == "" then parent else folder(parent, name)
			groups[name] = made
			into = made
		end
		local cframe = CFrame.new(d.at)
		if d.turn ~= nil then cframe *= CFrame.Angles(math.rad(d.turn.X), math.rad(d.turn.Y), math.rad(d.turn.Z)) end
		-- (ROBLOX-126) a mesh record: the part turned a quarter when the mesh's long axis lies the other way, the box's size kept
		local fileMesh = Meshes.of(d.shape)
		local size, meshScale = d.size, Vector3.one
		if fileMesh ~= nil then
			local quarter, scale = Meshes.fit(fileMesh, d.size)
			meshScale = scale
			if quarter then cframe *= CFrame.Angles(0, math.rad(90), 0); size = Vector3.new(d.size.Z, d.size.Y, d.size.X) end
		end
		local p = drawn(into :: Instance, d.id, size, cframe, if fileMesh ~= nil then Color3.new(1, 1, 1) else d.color, d.material or "SmoothPlastic")
		p.Transparency = d.transparency or 0
		if d.reflectance ~= nil then p.Reflectance = d.reflectance end
		p.CastShadow = d.shadow == true
		if d.shape == "Ball" then
			p.Shape = Enum.PartType.Ball
		elseif d.shape == "Cylinder" then
			p.Shape = Enum.PartType.Cylinder
		elseif d.shape == "Ellipsoid" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		elseif fileMesh ~= nil then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.FileMesh
			mesh.MeshId = fileMesh.id
			mesh.TextureId = Meshes.TEXTURE
			mesh.Scale = meshScale
			mesh.Parent = p
		end
		if d.full then p:SetAttribute("FullOnly", true) end
		-- (ROBLOX-117) a dew drop: hidden until Habitat/DayLight.applyDew shows it by the hour, from its lag to its transparency at full dew
		if d.dew ~= nil then
			p:SetAttribute("Lag", d.dew)
			p:SetAttribute("Base", d.transparency or 0.35)
			p.Transparency = 1
		end
	end
	return math.max(0, i1 - i0 + 1)
end

-- ---------------------------------------------------------------- the window wall
-- ROBLOX-95: the middle lower sash is raised 6 cm (Graphics.window.opening, the layout's own gap between the back frame's four pieces). The wall below the
-- window is cut there down to the sill rail, the jambs line the cut, the glass over the gap is gone, and the raised sash's bottom rail runs across its top;
-- the upper part of the middle pane is the raised sash's glass and the side panes are as they were. Everything drawn stays behind the climbable faces
-- (`slabGap`) or flush with them, as the wall always has.
function Scenery.window(parent: Instance): Folder
	local wall = folder(parent, "Wall")
	local lo, hi = Scenery.wallBox()
	local plane = hi.Z -- the climbable face
	local slabFront = plane - W.slabGap
	local zMid = (slabFront + lo.Z) / 2
	local depth = slabFront - lo.Z
	local head = math.max(hi.Y, W.head) -- (ROBLOX-112: the frame goes on up over the back frame to the window's head, over World/Garden's window box)
	local plaster, wood = hex(W.wallColor), hex(W.trimColor)
	local O, jamb, gap = W.opening, W.jambWidth, W.slabGap
	local function slab(name: string, x0: number, x1: number, y0: number, y1: number)
		drawn(wall, name, Vector3.new(x1 - x0, y1 - y0, depth), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, zMid), plaster, M.wall)
	end
	slab("ApronWest", lo.X, O.left - jamb, lo.Y, W.bottom)
	slab("ApronEast", O.right + jamb, hi.X, lo.Y, W.bottom)
	slab("Header", lo.X, hi.X, W.top, head)
	slab("StileWest", lo.X, W.left, W.bottom, W.top)
	slab("StileEast", W.right, hi.X, W.bottom, W.top)
	local function bar(name: string, x0: number, x1: number, y0: number, y1: number)
		local trim = drawn(wall, name, Vector3.new(x1 - x0, y1 - y0, W.trimDepth), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, plane - W.trimDepth / 2), wood, M.trim)
		trim.Reflectance = W.trimReflectance
	end
	local t0, t1 = W.transom, W.transom + W.transomH
	bar("TrimBottomWest", W.left, O.left - jamb, W.bottom, W.bottom + W.trimWidth)
	bar("TrimBottomEast", O.right + jamb, W.right, W.bottom, W.bottom + W.trimWidth)
	bar("TrimTop", W.left, W.right, W.top - W.trimWidth, W.top)
	bar("TrimWest", W.left, W.left + W.trimWidth, W.bottom, W.top)
	bar("TrimEast", W.right - W.trimWidth, W.right, W.bottom, W.top)
	for i, x in W.mullions do
		bar("Mullion" .. i, x - W.mullionWidth / 2, x + W.mullionWidth / 2, W.bottom, W.top)
	end
	-- (ROBLOX-112) the transom across the side lights and the upper sash's bottom rail across the middle one, where the sashes meet
	bar("TransomWest", W.left, O.left - jamb, t0, t1)
	bar("TransomEast", O.right + jamb, W.right, t0, t1)
	bar("MeetingRail", O.left - jamb, O.right + jamb, t0, t1)
	-- the way out: the sill rail (trim, its top a hair under the rail's walkable top), the jambs through the wall's depth either side, and the raised
	-- sash's bottom rail across the top, set back in the frame
	local function block(name: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number): Part
		local p = drawn(wall, name, Vector3.new(x1 - x0, y1 - y0, z1 - z0), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), wood, M.trim)
		p.Reflectance = W.trimReflectance
		return p
	end
	block("SillRail", O.left - jamb, O.right + jamb, lo.Y, O.bottom - gap, lo.Z + gap, slabFront)
	block("JambWest", O.left - jamb, O.left - gap, O.bottom - gap, O.top + W.sashRail, lo.Z + gap, slabFront)
	block("JambEast", O.right + gap, O.right + jamb, O.bottom - gap, O.top + W.sashRail, lo.Z + gap, slabFront)
	block("SashRail", O.left - jamb, O.right + jamb, O.top + gap, O.top + W.sashRail, plane - W.sashSetback - W.sashDepth, plane - W.sashSetback)
	-- (ROBLOX-112) the raised lower sash's top rail, as far over the transom as the sash is raised, set back as its bottom rail is
	block("SashTop", O.left - jamb, O.right + jamb, t0 + W.sashLift, t1 + W.sashLift, plane - W.sashSetback - W.sashDepth, plane - W.sashSetback)
	local g = W.glass
	local gz = plane - g.setback - g.thickness / 2
	local function pane(name: string, x0: number, x1: number, y0: number, y1: number)
		local glass = drawn(wall, name, Vector3.new(x1 - x0, y1 - y0, g.thickness), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, gz), hex(g.color), M.glass)
		glass.Transparency = g.transparency
		glass.Reflectance = g.reflectance
		glass.CastShadow = false
	end
	pane("GlassWest", W.left, O.left - jamb, W.bottom, t0)
	pane("GlassEast", O.right + jamb, W.right, W.bottom, t0)
	pane("Glass", O.left - jamb, O.right + jamb, O.top + W.sashRail, t0 + W.sashLift) -- the raised sash's pane, up behind the upper sash's rail to its own
	-- (ROBLOX-112) the upper lights over the transom
	pane("GlassUpperWest", W.left, O.left - jamb, t1, W.top)
	pane("GlassUpperEast", O.right + jamb, W.right, t1, W.top)
	pane("GlassUpper", O.left - jamb, O.right + jamb, t1 + W.sashLift, W.top)
	return wall
end

-- ---------------------------------------------------------------- dust motes in the window light
function Scenery.dust(parent: Instance): Part
	local D = Graphics.dust
	local volume = drawn(parent, "DustVolume", D.size, CFrame.new(D.at), Color3.new(1, 1, 1), "SmoothPlastic")
	volume.Transparency = 1
	volume.CastShadow = false
	local motes = Instance.new("ParticleEmitter")
	motes.Name = "Motes"
	motes.Texture = D.texture
	motes.Rate = D.rate
	motes.Lifetime = NumberRange.new(D.lifetime[1], D.lifetime[2])
	motes.Speed = NumberRange.new(D.speed[1], D.speed[2])
	motes.SpreadAngle = Vector2.new(180, 180)
	motes.Rotation = NumberRange.new(0, 360)
	motes.RotSpeed = NumberRange.new(-20, 20)
	motes.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, D.particle[1]),
		NumberSequenceKeypoint.new(0.5, D.particle[2]),
		NumberSequenceKeypoint.new(1, D.particle[1]),
	})
	motes.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, D.transparency),
		NumberSequenceKeypoint.new(0.8, D.transparency),
		NumberSequenceKeypoint.new(1, 1),
	})
	motes.LightEmission = D.lightEmission
	motes.LightInfluence = D.lightInfluence
	motes.Color = ColorSequence.new(hex(D.color))
	motes.Drag = 0.5
	motes.Acceleration = Vector3.new(0, 0.01, 0)
	motes.Shape = Enum.ParticleEmitterShape.Box
	motes.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	motes.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	motes:SetAttribute("Dust", true) -- WorldDetail thins it out in the low tier
	motes.Parent = volume
	return volume
end

-- ---------------------------------------------------------------- the view out of the window
-- Where an item that should appear at (u, v) on the glass, `depth` beyond it, really goes, and how much bigger it is than
-- it looks. The reference eye is the camera's usual spot (Graphics.view.eye).
function Scenery.viewPosition(u: number, v: number, depth: number): (Vector3, number)
	local eye = Graphics.view.eye
	local _, wallHi = Scenery.wallBox()
	local plane = wallHi.Z
	local reach = eye.Z - plane
	local k = (reach + depth) / reach
	return Vector3.new(eye.X + (u - eye.X) * k, eye.Y + (v - eye.Y) * k, plane - depth), k
end

Scenery.MAX_PART = 2048 -- (ROBLOX-114) the largest a part may be along any axis in Roblox

function Scenery.view(parent: Instance): Folder
	local V = Graphics.view
	local view = folder(parent, "View")
	local ground = drawn(view, "Ground", Vector3.new(V.ground.size, 2, V.ground.size),
		CFrame.new(0, V.ground.y - 1, -V.ground.size * 0.5 + 300), hex(V.ground.color), M.ground)
	ground.CastShadow = false
	if V.ground.beyond then -- (ROBLOX-114: the same again past its far edge, under the gardens and the houses across the way)
		local far = drawn(view, "GroundBeyond", Vector3.new(V.ground.size, 2, V.ground.size),
			CFrame.new(0, V.ground.y - 1, -V.ground.size * 1.5 + 300), hex(V.ground.color), M.ground)
		far.CastShadow = false
	end
	for _, item in V.items do
		local at, k = Scenery.viewPosition(item.u, item.v, item.depth)
		local t = (item.t or item.w) * k
		local part: Part
		if item.kind == "ball" then
			part = drawn(view, item.id, Vector3.one * item.w * k, CFrame.new(at), hex(item.color), M.view)
			part.Shape = Enum.PartType.Ball
		elseif item.kind == "roof" then
			local side = item.w * k / math.sqrt(2)
			part = drawn(view, item.id, Vector3.new(side, side, t), CFrame.new(at) * CFrame.Angles(0, 0, math.rad(45)), hex(item.color), M.view)
		elseif item.kind == "trunk" then -- (ROBLOX-103: a round upright rod)
			part = drawn(view, item.id, Vector3.new((item.h or item.w) * k, item.w * k, item.w * k), CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90)), hex(item.color), "Wood")
			part.Shape = Enum.PartType.Cylinder
		elseif item.kind == "hill" then -- (ROBLOX-103)
			-- (ROBLOX-114: a part is at most 2,048 studs; a bigger hill is a part of at most that with its sphere mesh scaled up to the hill's size)
			local size = Vector3.new(item.w * k, (item.h or item.w) * k, t)
			local most = math.max(size.X, size.Y, size.Z)
			local shrink = if most > Scenery.MAX_PART then Scenery.MAX_PART / most else 1
			part = drawn(view, item.id, size * shrink, CFrame.new(at), hex(item.color), M.view)
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Scale = Vector3.one / shrink
			mesh.Parent = part
		else
			part = drawn(view, item.id, Vector3.new(item.w * k, (item.h or item.w) * k, t), CFrame.new(at), hex(item.color), M.view)
		end
		part.CastShadow = false
		if item.full then part:SetAttribute("FullOnly", true) end
	end
	Scenery.across(view)
	return view
end

-- ROBLOX-103: the bungalows across the way and the garden's fences (Graphics.view.across, Graphics.view.fence), in the garden's own studs, into the view's folder:
-- for each house its rendered wall, the front slope of its roof up to the ridge (both tiers), a ridge cap, a row of windows, a door and a chimney (full tier);
-- the back fence and the two side fences (both tiers) and the back fence's posts (full tier). Nothing casts a shadow (the view never has), so the light is the light.
function Scenery.across(view: Instance)
	local A, F = Graphics.view.across, Graphics.view.fence
	local ground = Graphics.view.ground.y
	local function part(name: string, size: Vector3, cframe: CFrame, color: string, material: string, full: boolean): Part
		local p = drawn(view, name, size, cframe, hex(color), material)
		p.CastShadow = false
		if full then p:SetAttribute("FullOnly", true) end
		return p
	end
	local pitch = math.rad(A.pitch)
	local run = A.depth / 2 + A.overhang -- from the eave out front to the ridge over the middle, flat
	local slope = run / math.cos(pitch)
	local eaveY = ground + A.wall -- (the eave stands `overhang` out from the front wall, toward the garden, +z)
	for _, h in A.houses do
		local backZ = A.front - A.depth
		part(h.id .. "_wall", Vector3.new(h.w, A.wall, A.depth), CFrame.new(h.x, ground + A.wall / 2, (A.front + backZ) / 2), h.wall, A.wallMaterial, false)
		-- the roof's front slope: from the eave (over the overhang, in front of the wall) up and back to the ridge over the middle
		local mid = Vector3.new(h.x, eaveY + run * math.tan(pitch) / 2, A.front + A.overhang - run / 2)
		part(h.id .. "_roof", Vector3.new(h.w + 2 * A.overhang, 6, slope), CFrame.new(mid) * CFrame.Angles(pitch, 0, 0), h.roof, A.roofMaterial, false)
		local ridgeY = eaveY + run * math.tan(pitch)
		local ridgeZ = A.front + A.overhang - run
		part(h.id .. "_ridge", Vector3.new(h.w + 2 * A.overhang, A.ridgeCap, A.ridgeCap * 1.6), CFrame.new(h.x, ridgeY + 2, ridgeZ), h.roof, A.roofMaterial, true)
		-- one row of windows (and a door), evenly along the front, a hair proud of the wall
		local W, D = A.window, A.door
		local slots = h.windows + (if h.door then 1 else 0)
		for k = 1, slots do
			local x = h.x - h.w / 2 + h.w * (k - 0.5) / slots
			if h.door and k == math.ceil(slots / 2) then
				part(`{h.id}_door`, Vector3.new(D.w, D.h, 3), CFrame.new(x, ground + D.h / 2, A.front + 1.4), D.color, A.wallMaterial, true)
			else
				part(`{h.id}_window{k}`, Vector3.new(W.w, W.h, 3), CFrame.new(x, ground + W.sill + W.h / 2, A.front + 1.4), W.color, "SmoothPlastic", true).Reflectance = 0.08
			end
		end
		if h.chimney ~= nil then
			local C = A.chimney
			local cx = h.x + h.chimney * h.w
			part(h.id .. "_chimney", Vector3.new(C.w, C.h + 60, C.t), CFrame.new(cx, ridgeY + C.h / 2 - 30, ridgeZ + 40), C.color, "Brick", true)
		end
	end
	-- the fences: the back one across the garden's end, the sides from the house to it
	local depthOf = F.near - F.back
	part("fence_back", Vector3.new(F.x1 - F.x0, F.height, F.thick), CFrame.new((F.x0 + F.x1) / 2, ground + F.height / 2, F.back), F.color, F.material, false)
	for i, x in { F.x0, F.x1 } do
		part("fence_side" .. i, Vector3.new(F.thick, F.height, depthOf), CFrame.new(x, ground + F.height / 2, (F.near + F.back) / 2), F.color, F.material, false)
	end
	for k = 1, F.posts do
		local x = F.x0 + (F.x1 - F.x0) * (k - 0.5) / F.posts
		part("fence_post" .. k, Vector3.new(F.post, F.height + 6, F.post), CFrame.new(x, ground + (F.height + 6) / 2, F.back + F.thick / 2 + F.post / 2), F.postColor, "Wood", true)
	end
end

-- ---------------------------------------------------------------- chips in the paint, cracks, a crumb, a coin and fallen leaves (full tier)
function Scenery.details(parent: Instance): Folder
	local D = Graphics.details
	local details = folder(parent, "Details")
	details:SetAttribute("FullOnly", true)
	for i, c in D.chips do
		local chip = drawn(details, "PaintChip" .. i, Vector3.new(c.w, D.chipThickness, c.d),
			CFrame.new(c.x, D.chipThickness / 2 + 0.001, c.z) * CFrame.Angles(0, math.rad(c.turn), 0), hex(c.color), M.chip)
		chip.CastShadow = false
	end
	for n, line in D.cracks do
		for i = 1, #line - 1 do
			local a, b = line[i], line[i + 1]
			local dx, dz = b[1] - a[1], b[2] - a[2]
			local length = math.sqrt(dx * dx + dz * dz)
			local seg = drawn(details, `Crack{n}_{i}`, Vector3.new(D.crackWidth, D.crackHeight, length + D.crackWidth * 0.6),
				CFrame.new((a[1] + b[1]) / 2, D.crackHeight / 2 + 0.001, (a[2] + b[2]) / 2) * CFrame.Angles(0, math.atan2(dx, dz), 0), hex(D.crackColor), M.crack)
			seg.CastShadow = false
		end
	end
	for i, c in D.crumbs do
		drawn(details, "Crumb" .. i, Vector3.new(c.sx, c.sy, c.sz), CFrame.new(c.x, c.y, c.z) * CFrame.Angles(0, math.rad(c.turn), 0), hex(c.color), M.crumb)
	end
	Patina.floor(details) -- a copper coin and some fallen Pilea leaves
	return details
end

-- ---------------------------------------------------------------- soft shafts of light from the window (full tier)
-- `sun`: the unit vector toward the sun. Nothing is built if the sun is not behind the window and above the horizon.
function Scenery.shafts(parent: Instance, sun: Vector3): Folder?
	local S = Graphics.shafts
	if sun.Y < 0.15 or sun.Z > -0.05 then return nil end
	local shafts = folder(parent, "Shafts")
	shafts:SetAttribute("FullOnly", true)
	local _, wallHi = Scenery.wallBox()
	local plane = wallHi.Z
	for i, x in S.x do
		local start = Vector3.new(x, S.startY, plane - 0.05)
		local stop = start - sun * ((start.Y - 0.05) / sun.Y) -- along the sun's rays down to just above the floor
		local anchor = drawn(shafts, "ShaftAnchor" .. i, Vector3.one * 0.1, CFrame.new(start), Color3.new(1, 1, 1), "SmoothPlastic")
		anchor.Transparency = 1
		anchor.CastShadow = false
		local a0 = Instance.new("Attachment")
		a0.Name = "Start"
		a0.Parent = anchor
		local a1 = Instance.new("Attachment")
		a1.Name = "End"
		a1.Position = anchor.CFrame:PointToObjectSpace(stop)
		a1.Parent = anchor
		for j, layer in S.layers do
			local beam = Instance.new("Beam")
			beam.Name = `Shaft{i}_{j}`
			beam.Attachment0 = a0
			beam.Attachment1 = a1
			beam.Width0 = layer[1]
			beam.Width1 = layer[1] * S.grow
			beam.Transparency = NumberSequence.new(layer[2])
			beam.Color = ColorSequence.new(hex(S.color))
			beam.LightEmission = S.lightEmission
			beam.LightInfluence = 0
			beam.FaceCamera = true
			beam.Segments = 1
			beam.Parent = anchor
		end
	end
	return shafts
end

-- ---------------------------------------------------------------- everything drawn that is not the sill
-- `sun`: the unit vector toward the sun (Lit.apply's result), for the shafts; nil builds none. Returns the Decor folder and the
-- ids of the sill pieces whose look it replaced (Scenery.sill hides exactly those).
-- The looks are best effort: a piece that fails (nothing here has run in Roblox Studio yet) is warned about, whatever it had
-- already built is removed, and the rest is kept. The wall and the old decor entries are not optional: if they fail,
-- Scenery.decor fails and the server keeps the plain back wall (Server/Main).
local function attempt(decor: Instance, what: string, build: () -> unknown): boolean
	local before: { [Instance]: boolean } = {}
	for _, d in decor:GetDescendants() do before[d] = true end
	local ok, err = pcall(build)
	if not ok then
		warn(`[Windowsill] decor: {what} failed: {tostring(err)}`)
		for _, d in decor:GetDescendants() do
			if not before[d] then d:Destroy() end
		end
	end
	return ok
end

-- ROBLOX-115: `world` (World/Worlds' id; the test garden when nil) is the world outside the window. The preserve's sill is the same sill in the ranger hut's window,
-- but what it looks out on is the preserve's backdrop (World/PreserveLook, streamed on each client by Client/LookStream), so its Decor draws neither the test
-- garden's view (the lawn, the trees, the bungalows, the fences, the hills) nor its window box on the outer sill.
function Scenery.decor(sun: Vector3?, world: string?): (Model, { [string]: boolean })
	local garden = world == nil or world == "test_garden"
	-- ROBLOX-94: a Model, and a persistent one, so that with instance streaming on (Workspace.StreamingEnabled) the whole drawn sill, and the far view out of the window above
	-- all, reaches every client at once and never streams out; a Folder would be streamed part by part around the replication focus, and the view is hundreds of studs away.
	-- (Without streaming it is exactly the container the Folder was.) The client's one-time reads of it (Breakaway, WorldDetail, DayLight) depend on it being whole.
	local decor = Instance.new("Model")
	decor.Name = "Decor"
	decor.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local replaced: { [string]: boolean } = {}
	for _, d in Layout.DECOR do
		if not W.replaces[d.id] then
			local p = drawn(decor, d.id, d.size, CFrame.new(d.at), if d.id == "soil" then hex(Flora.planter.soil) else d.color, if d.id == "soil" then M.soil else "SmoothPlastic")
			p.Transparency = d.transparency or 0
		end
	end
	Scenery.window(decor)
	for _, id in W.hidden do replaced[id] = true end
	replaced[W.upper] = true -- (ROBLOX-112: the window above the back frame, World/Garden's box in the region wall_upper, drawn with the rest of it here)
	local uv = Shapes.folder(decor, "UVLayer") -- the ultraviolet pattern of the flowers (the eye-view helper fades it in); always present
	attempt(decor, "dust", function() return Scenery.dust(decor) end)
	if garden then attempt(decor, "view", function() return Scenery.view(decor) end) end
	attempt(decor, "details", function() return Scenery.details(decor) end)
	if sun then attempt(decor, "shafts", function() return Scenery.shafts(decor, sun) end) end
	attempt(decor, "wear", function() return Patina.sill(decor) end)
	attempt(decor, "glass details", function() return Patina.glass(decor) end)
	attempt(decor, "retreat", function() return Patina.retreat(decor) end)
	if attempt(decor, "pilea", function() return Plants.pilea(decor) end) then
		for _, id in Plants.pieceIds() do replaced[id] = true end
	end
	attempt(decor, "grass", function() return Plants.grass(decor) end)
	attempt(decor, "planting", function() return Plants.planter(decor) end)
	attempt(decor, "moss", function() return Dressing.moss(decor) end) -- ROBLOX-74: moss, pebbles and bark, two fallen leaves and the dew
	attempt(decor, "litter", function() return Dressing.litter(decor) end)
	attempt(decor, "windfall", function() return Dressing.windfall(decor) end)
	attempt(decor, "dew", function() return Dressing.dew(decor) end)
	-- (the window box's halves stand on the outer sill, solid: World/Garden's pieces, hidden once drawn here, ROBLOX-95)
	if garden and attempt(decor, "garden", function() return Plants.garden(decor, uv, Scenery.viewPosition) end) then
		for _, id in Plants.windowBoxIds() do replaced[id] = true end
	end
	return decor, replaced
end

return Scenery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Shapes</string>
            <string name="Source"><![CDATA[--!strict
-- Drawn-only parts for the decor builders (Habitat/Scenery, Plants, Patina) and the fly (Client/FlyBodies): every part is anchored, nothing collides with it, no
-- ray sees it and nothing touches it, so the spider's rays, the camera's casts and the jump planner never meet it. Round things are
-- Cylinder parts (their axis is local X, as in Roblox) or SpecialMesh ellipsoids (Roblox forces a Ball part to be a sphere), as the
-- spider rig does. A flat leaf is a rounded slab: a cross of two boxes and four discs.
local Layout = require(script.Parent.WindowsillLayout)
local Materials = require(script.Parent.Materials)

local Shapes = {}

-- The sill piece with this id (WindowsillLayout.PIECES): the physical box that a drawn shape stands in for or sits on.
function Shapes.piece(id: string): Layout.Piece
	for _, p in Layout.PIECES do
		if p.id == id then return p end
	end
	error("no piece " .. id)
end

local function hex(s: string): Color3
	return Color3.fromHex(s)
end
Shapes.hex = hex

-- A drawn-only block: anchored; nothing collides with it, no ray sees it. Small things cast no shadow (callers switch it on).
function Shapes.block(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: string): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = Materials.get(material)
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- An ellipsoid with these full diameters (x, y, z of `cframe`).
function Shapes.ellipsoid(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: string): Part
	local p = Shapes.block(parent, name, size, cframe, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- A flat disc whose axis points up: diameter and thickness, centred at `at`.
function Shapes.disc(parent: Instance, name: string, diameter: number, thickness: number, at: Vector3, color: Color3, material: string): Part
	local p = Shapes.block(parent, name, Vector3.new(thickness, diameter, diameter), CFrame.new(at) * CFrame.Angles(0, 0, math.pi / 2), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- A round rod from a to b (a Cylinder part: its axis is X, so Size is length, diameter, diameter).
function Shapes.rod(parent: Instance, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, material: string): Part
	local up = if math.abs((b - a).Unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis -- a rod along the up vector has no turn to give
	local p = Shapes.block(parent, name, Vector3.new((b - a).Magnitude, diameter, diameter),
		CFrame.lookAt((a + b) * 0.5, b, up) * CFrame.Angles(0, math.pi / 2, 0), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- A thin square-edged strand or line from a to b: `width` across, `height` tall, as long as a to b.
function Shapes.strip(parent: Instance, name: string, a: Vector3, b: Vector3, width: number, height: number, color: Color3, material: string): Part
	local up = if math.abs((b - a).Unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	return Shapes.block(parent, name, Vector3.new(width, height, (b - a).Magnitude), CFrame.lookAt((a + b) * 0.5, b, up), color, material)
end

-- A slab with rounded corners in plan, between `lo` and `hi`: two boxes in a cross and a disc in each corner, all the same
-- colour. The boxes' tops are the slab's top; the discs and the second box sit a hair lower so no two faces share a plane.
function Shapes.roundedSlab(parent: Instance, name: string, lo: Vector3, hi: Vector3, radius: number, color: Color3, material: string): { Part }
	local width, depth, height = hi.X - lo.X, hi.Z - lo.Z, hi.Y - lo.Y
	local r = math.min(radius, width / 2, depth / 2)
	local centre = (lo + hi) * 0.5
	local out: { Part } = {}
	table.insert(out, Shapes.block(parent, name .. "A", Vector3.new(width, height, depth - 2 * r), CFrame.new(centre), color, material))
	local lower = 0.0008
	table.insert(out, Shapes.block(parent, name .. "B", Vector3.new(width - 2 * r, height - lower, depth), CFrame.new(centre - Vector3.new(0, lower / 2, 0)), color, material))
	local dh = height - 0.0016
	for i, corner in { { lo.X + r, lo.Z + r }, { hi.X - r, lo.Z + r }, { lo.X + r, hi.Z - r }, { hi.X - r, hi.Z - r } } do
		table.insert(out, Shapes.disc(parent, name .. "C" .. i, 2 * r, dh, Vector3.new(corner[1], lo.Y + dh / 2, corner[2]), color, material))
	end
	return out
end

-- Whether a drawn thing may stand at (x, z) on a surface at height `y` (ROBLOX-74): not inside the footprint of a piece that rises from that
-- height (grown by `margin`), not within SPAWN_CLEAR of the spawn and not in or by the silk retreat. Reads the layout and changes nothing in it.
Shapes.SPAWN_CLEAR = 4.5
Shapes.RETREAT_CLEAR = 1.5
function Shapes.clearAt(x: number, y: number, z: number, margin: number): boolean
	local spawn = Layout.SPAWN
	if (x - spawn.X) ^ 2 + (z - spawn.Z) ^ 2 < Shapes.SPAWN_CLEAR ^ 2 then return false end
	local lo, hi, k = Layout.RETREAT_MIN, Layout.RETREAT_MAX, Shapes.RETREAT_CLEAR
	if x > lo.X - k and x < hi.X + k and z > lo.Z - k and z < hi.Z + k then return false end
	for _, p in Layout.PIECES do
		if p.lo.Y < y + 0.5 and p.hi.Y > y + 0.05 and x > p.lo.X - margin and x < p.hi.X + margin and z > p.lo.Z - margin and z < p.hi.Z + margin then
			return false
		end
	end
	return true
end

-- A small deterministic random stream (Park-Miller): the same seed always scatters the same way, in Roblox and under the tests.
function Shapes.rng(seed: number): () -> number
	local state = seed % 2147483647
	if state <= 0 then state += 2147483646 end
	return function(): number
		state = (state * 16807) % 2147483647
		return (state - 1) / 2147483646
	end
end

-- Uniform random number in [a, b] from a stream.
function Shapes.between(rand: () -> number, a: number, b: number): number
	return a + (b - a) * rand()
end

-- Marks a part (or folder) as optional detail: Client/WorldDetail drops it on phones and tablets.
function Shapes.fullOnly(item: Instance)
	item:SetAttribute("FullOnly", true)
end

-- A folder under `parent`; `optional` marks all of it as full-tier detail.
function Shapes.folder(parent: Instance, name: string, optional: boolean?): Folder
	local f = Instance.new("Folder")
	f.Name = name
	if optional then f:SetAttribute("FullOnly", true) end
	f.Parent = parent
	return f
end

-- The frame at `at` whose X axis is `along` and whose Y axis is as close to `up` as it can be (the second axis of a leaf, a petal).
function Shapes.frame(at: Vector3, along: Vector3, up: Vector3): CFrame
	local x = along.Unit
	local y = up - x * up:Dot(x)
	if y.Magnitude < 1e-6 then y = if math.abs(x.Y) < 0.9 then Vector3.yAxis - x * x.Y else Vector3.xAxis - x * x.X end
	return CFrame.fromMatrix(at, x, y.Unit)
end

return Shapes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">SunPick</string>
            <string name="Source"><![CDATA[--!strict
-- Finds a sun that shines in through the window: behind the back wall (-Z), standing between a low and a middling height,
-- turned a little to one side so the patch of light and the mullions' shadows fall across the sill diagonally.
-- Which way Roblox's sun travels for a given ClockTime and GeographicLatitude is not something this code assumes: it asks
-- (`sample`), scans the day for both signs of the latitude, and takes the best match. Pure apart from `sample`, so
-- tests/world.luau drives it with invented suns.

local SunPick = {}

export type Target = {
	elevationDeg: number, minElevationDeg: number, maxElevationDeg: number,
	azimuthDeg: number, maxAzimuthDeg: number,
	clockFrom: number, clockTo: number, clockStep: number,
}
export type Result = {
	ok: boolean,
	clock: number, latitude: number,
	direction: Vector3, -- unit vector from the world toward the sun
	elevationDeg: number, azimuthDeg: number,
	reason: string,
}

-- Height above the horizon and angle from -Z (0 = straight out of the window, 90 = along the wall), in degrees.
function SunPick.angles(direction: Vector3): (number, number)
	local d = direction.Unit
	local elevation = math.deg(math.asin(math.clamp(d.Y, -1, 1)))
	local azimuth = math.deg(math.atan2(math.abs(d.X), -d.Z))
	return elevation, azimuth
end

local function result(ok: boolean, clock: number, latitude: number, direction: Vector3, reason: string): Result
	local elevation, azimuth = SunPick.angles(direction)
	return { ok = ok, clock = clock, latitude = latitude, direction = direction.Unit, elevationDeg = elevation, azimuthDeg = azimuth, reason = reason }
end

-- sample(clock, latitude): the unit vector toward the sun at that time. baseClock and baseLatitude are what to fall back on.
function SunPick.choose(sample: (number, number) -> Vector3, baseClock: number, baseLatitude: number, target: Target): Result
	local fallback = sample(baseClock, baseLatitude)
	-- A sampler that ignores the clock would make every time look the same; do not pretend to have chosen.
	if (sample(6, baseLatitude) - sample(12, baseLatitude)).Magnitude < 1e-6 then
		return result(false, baseClock, baseLatitude, fallback, "the sun direction does not change with the clock")
	end
	local latitudes = { baseLatitude }
	if baseLatitude ~= 0 then table.insert(latitudes, -baseLatitude) end
	local best: Result? = nil
	local bestCost = math.huge
	for _, latitude in latitudes do
		local steps = math.floor((target.clockTo - target.clockFrom) / target.clockStep + 0.5)
		for i = 0, steps do
			local clock = target.clockFrom + i * target.clockStep
			local direction = sample(clock, latitude)
			if direction.Magnitude > 1e-6 and direction.Z < 0 then
				local elevation, azimuth = SunPick.angles(direction)
				if elevation >= target.minElevationDeg and elevation <= target.maxElevationDeg and azimuth <= target.maxAzimuthDeg then
					local cost = ((elevation - target.elevationDeg) / 10) ^ 2 + ((azimuth - target.azimuthDeg) / 20) ^ 2 + 0.001 * math.abs(clock - 10)
					if cost < bestCost then
						bestCost = cost
						best = result(true, clock, latitude, direction, `clock {clock}, latitude {latitude}`)
					end
				end
			end
		end
	end
	if best then return best end
	return result(false, baseClock, baseLatitude, fallback, "no time of day puts the sun behind the window")
end

return SunPick
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">TestTarget</string>
            <string name="Source"><![CDATA[--!strict
-- Godot test_target.gd: a labelled prop, never prey. Path stepping is independent of rendering.
local Target = {}
Target.__index = Target
function Target.new(path: {Vector3}): any
	assert(#path >= 2)
	return setmetatable({path=path, position=path[1], velocity=Vector3.zero, index=2, direction=1,
		pauseLeft=0, speed=0.8, pauseS=1.2, enabled=true, frozen=false, id="test_target", radius=0.45}, Target)
end
function Target.step(self: any, dt: number)
	self.velocity = Vector3.zero
	if not self.enabled or self.frozen then return end
	if self.pauseLeft > 0 then self.pauseLeft -= dt; return end
	local before = self.position
	local delta = self.path[self.index] - before
	if delta.Magnitude <= self.speed * dt then
		self.position = self.path[self.index]
		local nextIndex = self.index + self.direction
		if nextIndex < 1 or nextIndex > #self.path then
			self.direction = -self.direction
			nextIndex = self.index + self.direction
			self.pauseLeft = self.pauseS
		end
		self.index = nextIndex
	else self.position += delta.Unit * self.speed * dt end
	self.velocity = (self.position - before) / dt
end
function Target.percept(self: any): any
	if not self.enabled then return nil end
	return {id=self.id, position=self.position, radius=self.radius, velocity=self.velocity, maxCategory="fly_like_prey"}
end
return Target
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">WindowsillLayout</string>
            <string name="Source"><![CDATA[--!strict
-- The windowsill of scripts/habitat/windowsill.gd ("windowsill-v1"), box for box. Coordinates are studs = Godot WU = cm,
-- in the same right-handed, Y-up, -Z-forward frame, so every number is copied unchanged.

export type Piece = {
	id: string,
	lo: Vector3,
	hi: Vector3,
	profile: string,
	color: Color3,
}

export type Decor = {
	id: string,
	size: Vector3,
	at: Vector3,
	color: Color3,
	transparency: number?,
}

local function hex(s: string): Color3
	return Color3.fromHex(s)
end

local Layout = {}

Layout.CONTENT_REVISION = "windowsill-v1"
Layout.SPAWN = Vector3.new(-22.0, 0.0, 6.0)
Layout.SPAWN_HEADING = Vector3.new(1, 0, 0) -- Basis(UP, -90 deg) * forward
Layout.PLAY_BOUNDS_MIN = Vector3.new(-33, -5, -16)
Layout.PLAY_BOUNDS_MAX = Vector3.new(33, 35, 16)
Layout.RETREAT_MIN = Vector3.new(-27.8, 0.0, 3.0)
Layout.RETREAT_MAX = Vector3.new(-23.3, 1.5, 9.0)
-- Whether a point is inside the silk-lined crack (Godot's windowsill.gd in_retreat: the box, edges included).
function Layout.inRetreat(p: Vector3): boolean
	local lo, hi = Layout.RETREAT_MIN, Layout.RETREAT_MAX
	return p.X >= lo.X and p.X <= hi.X and p.Y >= lo.Y and p.Y <= hi.Y and p.Z >= lo.Z and p.Z <= hi.Z
end

local function v(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end

-- Additive upper garden: old support boxes/IDs and retreat remain unchanged for existing rests.
Layout.PIECES = {
 -- Solid stalking cover: queryable, climbable, and identical on every detail tier.
 { id = "cover_bark_west", lo = v(-14.4, 0, 3.4), hi = v(-11.6, 1.3, 4.0), profile = "bare_wood_rough", color = hex("756047") },
 { id = "cover_bark_east", lo = v(19.5, 0, 5.8), hi = v(20.2, 1.4, 8.2), profile = "bare_wood_rough", color = hex("79624b") },
 { id = "cover_leaf_front", lo = v(-0.5, 0, 10.0), hi = v(2.5, 1.1, 10.5), profile = "leaf_dry_prototype", color = hex("657b48") },
 { id = "cover_rim", lo = v(7.0, 4.6, -4.3), hi = v(7.6, 5.7, -2.0), profile = "bare_wood_rough", color = hex("786148") },
	{ id = "upper_ledge", lo = v(-20, 13.8, -12.5), hi = v(18, 14.4, -8), profile = "bare_wood_rough", color = hex("a78861") },
	{ id = "garden_step", lo = v(-12, 0, 5), hi = v(-6, 1.2, 10), profile = "brick_rough", color = hex("b5744c") },
	{ id = "leaf_garden", lo = v(-11.5, 7.4, 3), hi = v(-6, 7.8, 9), profile = "leaf_dry_prototype", color = hex("66884a") },
	{ id = "stem_garden", lo = v(-10, 1.2, 5.5), hi = v(-9, 7.4, 6.5), profile = "leaf_dry_prototype", color = hex("536b43") },
	{ id = "leaf_high", lo = v(-14, 10.8, -9), hi = v(-7, 11.2, -3), profile = "leaf_dry_prototype", color = hex("78985c") },
	{ id = "stem_high", lo = v(-11, 0, -6.5), hi = v(-10, 10.8, -5.5), profile = "leaf_dry_prototype", color = hex("536b43") },
	{ id = "sill_floor", lo = v(-30, -1, -12.5), hi = v(30, 0, 12.5), profile = "painted_wood_dry", color = hex("b6a082") },
	-- ROBLOX-95: the back frame with the lower sash raised 6 cm, an opening x -8..8, y 0.7..6 through it (the way out onto the outer sill): the wall
	-- west and east of it, the frame above it, and the 0.7 cm sill rail below it. Same profile and colour as the one back_frame box they replace.
	{ id = "back_frame_west", lo = v(-31, 0, -13.5), hi = v(-8, 14, -12.5), profile = "bare_wood_rough", color = hex("ded7c3") },
	{ id = "back_frame_east", lo = v(8, 0, -13.5), hi = v(31, 14, -12.5), profile = "bare_wood_rough", color = hex("ded7c3") },
	{ id = "back_frame_head", lo = v(-8, 6, -13.5), hi = v(8, 14, -12.5), profile = "bare_wood_rough", color = hex("ded7c3") },
	{ id = "back_frame_rail", lo = v(-8, 0, -13.5), hi = v(8, 0.7, -12.5), profile = "bare_wood_rough", color = hex("ded7c3") },
	{ id = "left_frame", lo = v(-31, 0, -12.5), hi = v(-30, 14, 12.5), profile = "bare_wood_rough", color = hex("ded7c3") },
	{ id = "right_frame", lo = v(30, 0, -12.5), hi = v(31, 14, 12.5), profile = "bare_wood_rough", color = hex("ded7c3") },
	{ id = "front_lip", lo = v(-30, 0, 12.0), hi = v(30, 0.7, 12.5), profile = "bare_wood_rough", color = hex("8b7256") },
	{ id = "planter", lo = v(3, 0, -8), hi = v(17, 4, 0), profile = "brick_rough", color = hex("9f6650") },
	{ id = "planter_rim", lo = v(2.5, 4, -8.5), hi = v(17.5, 4.6, 0.5), profile = "brick_rough", color = hex("ba8264") },
	{ id = "leaf_west", lo = v(-18, 3.8, -4), hi = v(-12, 4.2, 1), profile = "leaf_dry_prototype", color = hex("607952") },
	{ id = "leaf_middle", lo = v(-4, 3.8, -4), hi = v(2, 4.2, 1), profile = "leaf_dry_prototype", color = hex("738a59") },
	{ id = "leaf_east", lo = v(18, 5.0, -6), hi = v(25, 5.4, 0), profile = "leaf_dry_prototype", color = hex("829960") },
	{ id = "stem_west", lo = v(-16.5, 0, -2), hi = v(-15.5, 3.8, -1), profile = "leaf_dry_prototype", color = hex("536b43") },
	{ id = "stem_middle", lo = v(-2.5, 0, -2), hi = v(-1.5, 3.8, -1), profile = "leaf_dry_prototype", color = hex("536b43") },
	{ id = "stem_east", lo = v(21, 0, -3.5), hi = v(22, 5, -2.5), profile = "leaf_dry_prototype", color = hex("536b43") },
	{ id = "leaf_tip", lo = v(25.6, 5.15, -4.2), hi = v(28.4, 5.35, -1.8), profile = "leaf_dry_prototype", color = hex("cdb27a") },
	{ id = "crevice_back", lo = v(-29, 0, 2), hi = v(-28, 3, 10), profile = "bare_wood_rough", color = hex("655640") },
	{ id = "crevice_roof", lo = v(-29, 2.6, 2), hi = v(-23, 3, 10), profile = "bare_wood_rough", color = hex("8b775a") },
	{ id = "crevice_north", lo = v(-29, 0, 2), hi = v(-23, 2.6, 2.6), profile = "bare_wood_rough", color = hex("786448") },
	{ id = "crevice_south", lo = v(-29, 0, 9.4), hi = v(-23, 2.6, 10), profile = "bare_wood_rough", color = hex("786448") },
} :: { Piece }

local decor: { Decor } = {
	{ id = "soil", size = v(12, 0.01, 6), at = v(10, 4.61, -4), color = hex("665644") },
	-- (the window's record: never drawn, Habitat/Scenery.window draws it from Data/Graphics.window. ROBLOX-112: the window in true proportion, its glass from y 3 to 110.5 and
	-- its mullions the frame's height; Godot's were 55 by 10 and 12 tall, centred at y 8)
	{ id = "window_glass", size = v(55, 107.5, 0.04), at = v(0, 56.75, -12.44), color = hex("a9c2c1"), transparency = 0.55 },
	{ id = "mullion_w", size = v(0.7, 107.5, 0.1), at = v(-10, 56.75, -12.35), color = hex("e2dbc7") },
	{ id = "mullion_e", size = v(0.7, 107.5, 0.1), at = v(10, 56.75, -12.35), color = hex("e2dbc7") },
}
for i = 0, 6 do
	table.insert(decor, { id = "silk_" .. i, size = v(4.6, 0.012, 0.045), at = v(-25.5, 0.025, 3.3 + i * 0.85), color = hex("ddd9bf") })
end
Layout.DECOR = decor

return table.freeze(Layout)
]]></string>
