        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">ObjectRecord</string>
            <string name="Source"><![CDATA[--!strict
-- ObjectRecord (ROBLOX-25): the state of a few live objects as one plain record that a DataStore could hold, and back.
-- The world's state is a graph of Luau tables (flies point at their perches, a flight at its fly and back, the feeding at the
-- needs it grants to). Writing a record by hand for each module would miss a field sooner or later, and a missed field is a
-- checkpoint that comes back different. So this walks the graph from named roots and records every table once, keeping who
-- points at what, cycles included. Nothing is guessed:
--   * a table with a metatable is recorded only if its metatable is one of the named `classes`; anything else is refused;
--   * functions, Instances and any other engine value are refused unless they are named `refs` (the running program's own
--     things: the world's raycast closures, a probe part, a Signal with its listeners, the species data). A ref is kept as its
--     name and comes back as whatever has that name when the record is restored;
--   * numbers that JSON cannot hold (infinities, NaN) and Vector3 values are written as small tagged tables.
-- The record: { format = FORMAT, roots = { name = { ["$o"] = i } }, objects = { { c = class?, e = { { key, value }, ... } } } },
-- where every key is a string or a finite number, and every value a string, boolean, finite number, or one of
-- { ["$o"] = i } (the i-th object), { ["$r"] = name }, { ["$v"] = { x, y, z } }, { ["$n"] = "inf" | "-inf" | "nan" }.
-- Entries are sorted, so the same state always gives the same record.
-- Restoring is in two steps. `decode` checks the whole record and builds every object fresh, touching nothing live; a record
-- with any problem is refused there, with the reasons. `commit` then moves the fresh roots' contents into the live root tables
-- (so everything else that holds a live root keeps holding the right table) and cannot fail part way.

local ObjectRecord = {}

ObjectRecord.FORMAT = "object-record-1"
-- Refuse graphs larger than this many tables (a runaway reference would otherwise record the whole program).
ObjectRecord.MAX_OBJECTS = 20000

export type Record = { format: string, roots: { [string]: any }, objects: { any } }
export type Decoded = { roots: { [string]: any }, objects: { any } }

local V3META: any = if type((Vector3 :: any).zero) == "table" then getmetatable((Vector3 :: any).zero) else nil

local function isVector3(v: any): boolean
	return typeof(v) == "Vector3" or (V3META ~= nil and type(v) == "table" and getmetatable(v) == V3META)
end

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function encodeNumber(x: number): any
	if finite(x) then return x end
	return { ["$n"] = if x ~= x then "nan" elseif x > 0 then "inf" else "-inf" }
end

local function keyLess(a: any, b: any): boolean
	local ka, kb = a[1], b[1]
	if type(ka) == type(kb) then return ka < kb end
	return type(ka) == "number" -- numbers before strings
end

-- Records the graph reachable from `roots`. `classes`: name -> metatable. `refs`: name -> value. Returns the record, or nil
-- and the reason (with the path to the first thing it could not record).
function ObjectRecord.capture(roots: { [string]: any }, classes: { [string]: any }, refs: { [string]: any }): (Record?, string?)
	local classOf: { [any]: string } = {}
	for name, mt in classes do classOf[mt] = name end
	local refOf: { [any]: string } = {}
	for name, v in refs do
		if refOf[v] == nil then refOf[v] = name end
	end
	local index: { [any]: number } = {}
	local objects: { any } = {}
	local queue: { any } = {}
	local paths: { [any]: string } = {}
	local problem: string? = nil

	local function value(v: any, path: string): any
		if problem then return nil end
		local t = type(v)
		if t == "string" or t == "boolean" then return v end
		if t == "number" then return encodeNumber(v) end
		local ref = refOf[v]
		if ref ~= nil then return { ["$r"] = ref } end
		if isVector3(v) then
			return { ["$v"] = { encodeNumber(v.X), encodeNumber(v.Y), encodeNumber(v.Z) } }
		end
		if t == "table" then
			local mt = getmetatable(v)
			if mt ~= nil and classOf[mt] == nil then
				problem = `{path}: a table of a class this record does not know`
				return nil
			end
			local i = index[v]
			if i == nil then
				if #objects >= ObjectRecord.MAX_OBJECTS then
					problem = `{path}: more than {ObjectRecord.MAX_OBJECTS} tables`
					return nil
				end
				i = #objects + 1
				index[v] = i
				objects[i] = false
				paths[v] = path
				table.insert(queue, v)
			end
			return { ["$o"] = i }
		end
		problem = `{path}: a {typeof(v)} with no name to keep it by`
		return nil
	end

	local out: Record = { format = ObjectRecord.FORMAT, roots = {}, objects = objects }
	local rootNames: { string } = {}
	for name in roots do table.insert(rootNames, name) end
	table.sort(rootNames)
	for _, name in rootNames do
		local v = roots[name]
		if type(v) ~= "table" or refOf[v] ~= nil or isVector3(v) then
			return nil, `root {name} is not an object`
		end
		out.roots[name] = value(v, name)
	end
	local q = 1
	while q <= #queue and not problem do
		local obj = queue[q]
		q += 1
		local entries: { any } = {}
		local path = paths[obj]
		-- Keys in sorted order, so tables are numbered in the same order whatever the hash order of the live tables.
		local keys: { any } = {}
		for k in obj do
			local kt = type(k)
			if not ((kt == "string") or (kt == "number" and finite(k))) then
				problem = `{path}: a key that is not a string or a finite number`
				break
			end
			table.insert(keys, { k })
		end
		table.sort(keys, keyLess)
		for _, key in keys do
			if problem then break end
			local k = key[1]
			local enc = value(obj[k], `{path}.{k}`)
			if problem then break end
			table.insert(entries, { k, enc })
		end
		local mt = getmetatable(obj)
		objects[index[obj]] = if mt ~= nil then { c = classOf[mt], e = entries } else { e = entries }
	end
	if problem then return nil, problem end
	return out, nil
end

local function decodeNumber(x: any): (number?, string?)
	if type(x) == "number" then
		if finite(x) then return x, nil end
		return nil, "a number JSON cannot hold, written bare"
	end
	if type(x) == "table" then
		local n = x["$n"]
		if n == "inf" then return math.huge, nil end
		if n == "-inf" then return -math.huge, nil end
		if n == "nan" then return 0 / 0, nil end
	end
	return nil, "not a number"
end

local function only(t: any, key: string): boolean
	local count = 0
	for _ in t do count += 1 end
	return count == 1 and t[key] ~= nil
end

-- Checks `record` and builds every object fresh (nothing live is touched). Returns the fresh objects and roots, or nil and
-- every problem found.
function ObjectRecord.decode(record: any, classes: { [string]: any }, refs: { [string]: any }): (Decoded?, { string })
	local problems: { string } = {}
	local function bad(text: string)
		if #problems < 20 then table.insert(problems, text) end
	end
	if type(record) ~= "table" or record.format ~= ObjectRecord.FORMAT then
		return nil, { "not an object record of this format" }
	end
	local objects, roots = record.objects, record.roots
	if type(objects) ~= "table" or type(roots) ~= "table" then
		return nil, { "the record has no objects or roots" }
	end
	local n = #objects
	if n > ObjectRecord.MAX_OBJECTS then
		return nil, { "too many objects" }
	end
	for k in objects do
		if type(k) ~= "number" or k < 1 or k > n or k ~= math.floor(k) then
			return nil, { "the objects are not a list" }
		end
	end
	local fresh: { any } = table.create(n)
	for i = 1, n do fresh[i] = {} end

	local function value(v: any, where: string): any
		local t = type(v)
		if t == "string" or t == "boolean" then return v end
		if t == "number" then
			if not finite(v) then bad(`{where}: a bare number JSON cannot hold`) end
			return v
		end
		if t ~= "table" then
			bad(`{where}: a {t}`)
			return nil
		end
		if only(v, "$o") then
			local i = v["$o"]
			if type(i) ~= "number" or i < 1 or i > n or i ~= math.floor(i) then
				bad(`{where}: points at no object`)
				return nil
			end
			return fresh[i]
		end
		if only(v, "$r") then
			local name = v["$r"]
			if type(name) ~= "string" or refs[name] == nil then
				bad(`{where}: names '{tostring(name)}', which this world does not have`)
				return nil
			end
			return refs[name]
		end
		if only(v, "$v") then
			local xyz = v["$v"]
			if type(xyz) ~= "table" or #xyz ~= 3 then
				bad(`{where}: a vector without three numbers`)
				return nil
			end
			local x, e1 = decodeNumber(xyz[1])
			local y, e2 = decodeNumber(xyz[2])
			local z, e3 = decodeNumber(xyz[3])
			if e1 or e2 or e3 then
				bad(`{where}: a vector with {e1 or e2 or e3}`)
				return nil
			end
			return Vector3.new(x :: number, y :: number, z :: number)
		end
		if only(v, "$n") then
			local x, e = decodeNumber(v)
			if e then bad(`{where}: {e}`) end
			return x
		end
		bad(`{where}: a table that is none of the record's kinds`)
		return nil
	end

	for i = 1, n do
		local o = objects[i]
		local where = `object {i}`
		if type(o) ~= "table" or type(o.e) ~= "table" then
			bad(`{where}: not an object`)
			continue
		end
		if o.c ~= nil then
			if type(o.c) ~= "string" or classes[o.c] == nil then
				bad(`{where}: of class '{tostring(o.c)}', which this build does not know`)
				continue
			end
		end
		local target = fresh[i]
		for j, entry in o.e do
			if type(entry) ~= "table" or #entry ~= 2 then
				bad(`{where}, entry {j}: not a key and a value`)
				continue
			end
			local k = entry[1]
			if not (type(k) == "string" or (type(k) == "number" and finite(k))) then
				bad(`{where}, entry {j}: a key that is not a string or a finite number`)
				continue
			end
			if target[k] ~= nil then
				bad(`{where}: the key {k} twice`)
				continue
			end
			target[k] = value(entry[2], `{where}.{k}`)
		end
		if o.c ~= nil and classes[o.c] then
			setmetatable(target, classes[o.c])
		end
	end
	local out: { [string]: any } = {}
	for name, v in roots do
		if type(name) ~= "string" then
			bad("a root without a name")
			continue
		end
		local r = value(v, `root {name}`)
		if type(r) ~= "table" then
			bad(`root {name} is not an object`)
		end
		out[name] = r
	end
	if #problems > 0 then return nil, problems end
	return { roots = out, objects = fresh }, problems
end

-- Moves a decoded world into the live one: every live root (by name) ends up with exactly the fresh root's contents and
-- metatable, and every fresh reference to a fresh root now points at the live root. `live` must name every decoded root.
-- Plain table work only: it cannot fail part way. Returns false (and changes nothing) if a root is missing from `live`.
function ObjectRecord.commit(decoded: Decoded, live: { [string]: any }): boolean
	local swap: { [any]: any } = {}
	for name, fresh in decoded.roots do
		local target = live[name]
		if type(target) ~= "table" then return false end
		swap[fresh] = target
	end
	for _, o in decoded.objects do
		for k, v in o do
			local to = swap[v]
			if to ~= nil then o[k] = to end
		end
	end
	for fresh, target in swap do
		table.clear(target)
		for k, v in fresh do target[k] = v end
		setmetatable(target, getmetatable(fresh))
	end
	return true
end

-- Every plain table reachable from `root` (not through a metatable), named by its path from `name`: the species data a
-- record should keep by name rather than copy.
function ObjectRecord.constants(name: string, root: any, into: { [string]: any }?): { [string]: any }
	local out = into or {}
	local seen: { [any]: boolean } = {}
	local function walk(v: any, path: string)
		if type(v) ~= "table" or seen[v] or isVector3(v) then return end
		seen[v] = true
		out[path] = v
		for k, x in v do
			if type(k) == "string" or type(k) == "number" then walk(x, `{path}.{k}`) end
		end
	end
	walk(root, name)
	return out
end

return ObjectRecord
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">SaveEnvelope</string>
            <string name="Source"><![CDATA[--!strict
-- The versioned envelope every stored save travels in (ROBLOX-39), and how it is opened without ever guessing.
--   { format, kind, schema, updatedAt, payload, checksum, backup?, lock?, session? }
-- `checksum` is taken over the canonical JSON of { kind, schema, updatedAt, payload } (Json.checksum, the checkpoint store's own), so a
-- value that was cut short, changed or written by something else is refused even if what is left still looks like a save. `backup`
-- is the previous good version of the same kind (schema, updatedAt, payload, checksum), kept inside the same value; `lock` and
-- `session` are outside the checksum on purpose (the lock is refreshed without touching the payload).
-- Opening gives a status and never raises:
--   missing ... nothing is stored
--   ok ......... a good save of the schema this build writes
--   migrated ... a good older save, carried forward in memory (the migration table of its kind); nothing is written by opening
--   newer ...... made by a newer build: left exactly as it is, never read past its header, never written
--   corrupt .... not a save, a wrong kind, a bad checksum, or a number that is not a schema
--   invalid .... the checksum is right but the contents are not (or no migration leads from its schema)
-- A spec describes one kind: { kind, current, migrations = { [from] = function(payload) -> payload of schema from + 1 }, validate }.
-- `validate(payload)` returns (problems, cleaned payload): an empty list is a good one.
local Json = require(script.Parent.Json)
local SaveRules = require(script.Parent.Parent.Data.SaveRules)

local SaveEnvelope = {}

export type Spec = {
	kind: string, current: number,
	migrations: { [number]: (any) -> any },
	validate: (any) -> ({ string }, any?),
}
export type Opened = {
	status: string, payload: any?, schema: number?, updatedAt: number?, reasons: { string },
	lock: any?, session: string?, backup: Opened?, migratedFrom: number?,
}

local function finite(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local function checksumOf(kind: string, schema: number, updatedAt: number, payload: any): string?
	local text = Json.canonical({ kind = kind, schema = schema, updatedAt = updatedAt, payload = payload })
	if not text then return nil end
	return Json.checksum(text)
end

-- The core of a save: what the checksum covers, plus the checksum.
function SaveEnvelope.core(spec: Spec, payload: any, updatedAt: number): { [string]: any }
	return { schema = spec.current, updatedAt = updatedAt, payload = payload, checksum = checksumOf(spec.kind, spec.current, updatedAt, payload) }
end

-- Whether a stored value is a save of this kind with an intact checksum, whatever its schema (used to keep a backup).
local function intact(spec: Spec, v: any): boolean
	if type(v) ~= "table" or v.format ~= SaveRules.FORMAT or v.kind ~= spec.kind then return false end
	if not finite(v.schema) or v.schema < 1 or v.schema ~= math.floor(v.schema) or not finite(v.updatedAt) then return false end
	return checksumOf(spec.kind, v.schema, v.updatedAt, v.payload) == v.checksum and v.checksum ~= nil
end

local function openCore(spec: Spec, v: any, withBackup: boolean): Opened
	local function out(status: string, reasons: { string }, extra: { [string]: any }?): Opened
		local o: any = { status = status, reasons = reasons }
		if extra then for k, x in extra do o[k] = x end end
		return o
	end
	if v == nil then return out("missing", { "nothing is stored" }) end
	if type(v) ~= "table" or v.format ~= SaveRules.FORMAT then return out("corrupt", { "not a save of this game" }) end
	if v.kind ~= spec.kind then return out("corrupt", { `a {tostring(v.kind)} where a {spec.kind} was expected` }) end
	local schema = v.schema
	if not finite(schema) or schema < 1 or schema ~= math.floor(schema) then return out("corrupt", { "the schema is not a whole number" }) end
	local lock = if type(v.lock) == "table" then v.lock else nil
	local session = if type(v.session) == "string" then v.session else nil
	if schema > spec.current then
		return out("newer", { `made by a newer version of the game (schema {schema}; this one reads up to {spec.current})` }, { schema = schema, updatedAt = if finite(v.updatedAt) then v.updatedAt else nil, lock = lock, session = session })
	end
	if not finite(v.updatedAt) or type(v.checksum) ~= "string" or checksumOf(spec.kind, schema, v.updatedAt, v.payload) ~= v.checksum then
		local extra: any = { schema = schema, lock = lock, session = session }
		if withBackup and v.backup ~= nil then
			local b = v.backup
			if type(b) == "table" then
				extra.backup = openCore(spec, { format = v.format, kind = v.kind, schema = b.schema, updatedAt = b.updatedAt, payload = b.payload, checksum = b.checksum }, false)
			end
		end
		return out("corrupt", { "the checksum does not match: the save was cut short or changed" }, extra)
	end
	-- the stored form is intact: carry it forward to the schema this build uses
	-- (a copy: a migration that edits its argument in place must not change the stored value it was given)
	local payload: any = if schema < spec.current then Json.copy(v.payload) else v.payload
	local from = schema
	while from < spec.current do
		local step = spec.migrations[from]
		if step == nil then return out("invalid", { `no migration from schema {from}` }, { schema = schema, updatedAt = v.updatedAt, lock = lock, session = session }) end
		local ok, moved = pcall(step, payload)
		if not ok or moved == nil then return out("invalid", { `the migration from schema {from} failed` }, { schema = schema, updatedAt = v.updatedAt, lock = lock, session = session }) end
		payload = moved
		from += 1
	end
	local okV, problems, cleaned = pcall(spec.validate, payload)
	local list: { string } = if okV then (problems :: any) else { "validation raised: " .. tostring(problems) }
	local extra: any = { schema = schema, updatedAt = v.updatedAt, lock = lock, session = session }
	if #list > 0 then return out("invalid", list, extra) end
	extra.payload = if cleaned ~= nil then cleaned else payload
	if schema < spec.current then extra.migratedFrom = schema end
	return out(if schema < spec.current then "migrated" else "ok", {}, extra)
end

-- Opens a stored value. Its backup (if any) is opened too, one level deep, so a caller can fall back without a second look.
-- `wantBackup` false skips opening the backup (a write path that only needs the current value).
function SaveEnvelope.open(spec: Spec, v: any, wantBackup: boolean?): Opened
	local want = wantBackup ~= false
	local o = openCore(spec, v, want)
	if want and type(v) == "table" and o.backup == nil and v.backup ~= nil and o.status ~= "newer" and o.status ~= "missing" then
		local b = v.backup
		if type(b) == "table" then
			o.backup = openCore(spec, { format = v.format, kind = v.kind, schema = b.schema, updatedAt = b.updatedAt, payload = b.payload, checksum = b.checksum }, false)
		end
	end
	return o
end

-- The raw backup core of a stored value, when it is itself intact (so it may be kept as the next backup).
local function backupCoreOf(spec: Spec, v: any): { [string]: any }?
	if not intact(spec, v) then return nil end
	return { schema = v.schema, updatedAt = v.updatedAt, payload = v.payload, checksum = v.checksum }
end

-- A new stored value: `payload` at the current schema, the previous good value of the same kind as its backup. `prior` is the raw
-- stored value (or nil). When the prior is not intact its own backup, if intact, stays the backup. Never raises.
function SaveEnvelope.make(spec: Spec, payload: any, updatedAt: number, prior: any, extras: { [string]: any }?): { [string]: any }
	local c = SaveEnvelope.core(spec, payload, updatedAt)
	local env: { [string]: any } = { format = SaveRules.FORMAT, kind = spec.kind, schema = c.schema, updatedAt = c.updatedAt, payload = c.payload, checksum = c.checksum }
	local backup = backupCoreOf(spec, prior)
	if backup == nil and type(prior) == "table" and type(prior.backup) == "table" then
		backup = backupCoreOf(spec, { format = SaveRules.FORMAT, kind = spec.kind, schema = prior.backup.schema, updatedAt = prior.backup.updatedAt, payload = prior.backup.payload, checksum = prior.backup.checksum })
	end
	env.backup = backup
	if extras then for k, x in extras do env[k] = x end end
	return env
end

-- The same stored value with only the lock (and who holds it) changed: payload, checksum and backup are carried over untouched.
-- `lock` nil releases it.
function SaveEnvelope.withLock(v: any, lock: { [string]: any }?): any
	local out: { [string]: any } = {}
	for k, x in v do out[k] = x end
	out.lock = lock
	return out
end

-- Is this lock held by a live session other than `me` at time `now`? A lock nobody refreshed for LOCK_STALE seconds is not.
function SaveEnvelope.heldByOther(lock: any, me: string, now: number, staleAfter: number): boolean
	if type(lock) ~= "table" then return false end
	if type(lock.session) ~= "string" or lock.session == me then return false end
	if not finite(lock.beat) then return false end -- a lock with no readable beat protects nothing
	return now - lock.beat <= staleAfter
end

SaveEnvelope.intact = intact
return SaveEnvelope
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">SaveProgress</string>
            <string name="Source"><![CDATA[--!strict
-- The player's progress record (ROBLOX-39): the small precious part of a save, kept apart from the world's rests.
--   { notebook = { opened = { page ids }, eye_seconds }, finished_main, appearance, prefs = { [name] = boolean } }
-- notebook: the pages found (FieldNotebook.toRecord) and the seconds in the eye view. finished_main: a main-life Standard spider became an
-- adult, which opens Easy (Session.finishedMain; there is no separate "adult reached", it is the same fact). appearance: the spider the
-- player chose (a free choice, the peacock included). prefs: the toggles the client reads from Player attributes (SaveRules.PREF_KEYS).
-- Everything is bounded. Merging is monotonic where it can be (pages found are a union, the longest eye time and a finished main life
-- stay), and the last change wins for the choices. Unknown page ids that are well formed are kept: a build that lost a page must not
-- erase what a newer build found. Pure; checked in tests/state.luau.
local SaveRules = require(script.Parent.Parent.Data.SaveRules)
local SaveEnvelope = require(script.Parent.SaveEnvelope)

local SaveProgress = {}

SaveProgress.SCHEMA = 1
export type Payload = { notebook: { opened: { string }, eye_seconds: number }, finished_main: boolean, appearance: string?, prefs: { [string]: boolean } }

local function finite(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local function goodId(id: any): boolean
	return type(id) == "string" and #id >= 1 and #id <= SaveRules.MAX_ID_CHARS and string.match(id, "^[%w_]+$") ~= nil
end

local PREF_SET: { [string]: boolean } = {}
for _, k in SaveRules.PREF_KEYS do PREF_SET[k] = true end

function SaveProgress.default(): Payload
	return { notebook = { opened = {}, eye_seconds = 0 }, finished_main = false, appearance = nil, prefs = {} }
end

-- Checks a payload and returns (problems, cleaned copy). A wrongly typed or out-of-range field is a problem; a repeat page id and a
-- preference this build does not know are dropped quietly. `cleaned` is always a fresh table of the right shape (or nil with problems).
function SaveProgress.sanitize(raw: any): ({ string }, Payload?)
	local problems: { string } = {}
	local function bad(t: string) if #problems < 12 then table.insert(problems, t) end end
	if type(raw) ~= "table" then return { "progress is not a table" }, nil end
	local out = SaveProgress.default()
	local nb = raw.notebook
	if type(nb) ~= "table" then
		bad("no notebook")
	else
		if type(nb.opened) ~= "table" then
			bad("the notebook's pages are not a list")
		else
			local n = 0
			for _ in nb.opened do n += 1 end
			if n > SaveRules.MAX_PAGES or #nb.opened ~= n then
				bad("too many pages, or not a list")
			else
				local seen: { [string]: boolean } = {}
				for _, id in nb.opened do
					if not goodId(id) then bad("a page id that is not a short plain name"); break end
					if not seen[id] then
						seen[id] = true
						table.insert(out.notebook.opened, id)
					end
				end
			end
		end
		local eye = nb.eye_seconds
		if not finite(eye) or eye < 0 or eye > SaveRules.MAX_EYE_SECONDS then bad("eye seconds out of range") else out.notebook.eye_seconds = eye end
	end
	if type(raw.finished_main) ~= "boolean" then bad("finished_main is not true or false") else out.finished_main = raw.finished_main end
	if raw.appearance ~= nil then
		if not goodId(raw.appearance) then bad("the appearance is not a short plain name") else out.appearance = raw.appearance end
	end
	if raw.prefs ~= nil then
		if type(raw.prefs) ~= "table" then
			bad("preferences are not a table")
		else
			for k, v in raw.prefs do
				if type(k) ~= "string" then
					bad("a preference without a name")
				elseif PREF_SET[k] then
					if type(v) ~= "boolean" then bad(`preference {k} is not true or false`) else out.prefs[k] = v end
				end
			end
		end
	end
	if #problems > 0 then return problems, nil end
	return problems, out
end

-- The envelope spec of this kind. Schema 1 is the first; add a migration here when the payload changes shape (see tests/state.luau
-- for the pattern under test).
SaveProgress.SPEC = {
	kind = "progress", current = SaveProgress.SCHEMA,
	migrations = {} :: { [number]: (any) -> any },
	validate = function(payload: any): ({ string }, any?) return SaveProgress.sanitize(payload) end,
} :: SaveEnvelope.Spec

-- Merges two payloads: `base` (stored) and `incoming` (this session's). Pages are a union (base order first), eye seconds the longest,
-- a finished main life stays finished; the appearance and the preferences come from `incoming` when it is at least as new
-- (`incomingTime` >= `baseTime`), else from `base`. Both must already be sanitized. Returns a fresh payload; trims to the page cap.
function SaveProgress.merge(base: Payload, incoming: Payload, baseTime: number, incomingTime: number): Payload
	local out = SaveProgress.default()
	local seen: { [string]: boolean } = {}
	for _, list in { base.notebook.opened, incoming.notebook.opened } do
		for _, id in list do
			if not seen[id] and #out.notebook.opened < SaveRules.MAX_PAGES then
				seen[id] = true
				table.insert(out.notebook.opened, id)
			end
		end
	end
	out.notebook.eye_seconds = math.max(base.notebook.eye_seconds, incoming.notebook.eye_seconds)
	out.finished_main = base.finished_main or incoming.finished_main
	local newer, older = incoming, base
	if incomingTime < baseTime then newer, older = base, incoming end
	out.appearance = if newer.appearance ~= nil then newer.appearance else older.appearance
	for k, v in older.prefs do out.prefs[k] = v end
	for k, v in newer.prefs do out.prefs[k] = v end
	return out
end

-- Whether two payloads say the same thing (for deciding whether a write would change anything).
function SaveProgress.same(a: Payload, b: Payload): boolean
	if a.finished_main ~= b.finished_main or a.appearance ~= b.appearance or a.notebook.eye_seconds ~= b.notebook.eye_seconds then return false end
	if #a.notebook.opened ~= #b.notebook.opened then return false end
	for i, id in a.notebook.opened do if b.notebook.opened[i] ~= id then return false end end
	for k, v in a.prefs do if b.prefs[k] ~= v then return false end end
	for k, v in b.prefs do if a.prefs[k] ~= v then return false end end
	return true
end

-- The payload the client sends, built from what it holds. `prefs` maps a preference name to its current boolean or nil (not set).
function SaveProgress.snapshot(notebookRecord: any, finishedMain: boolean, appearance: string?, prefs: { [string]: boolean? }): Payload
	local out = SaveProgress.default()
	if type(notebookRecord) == "table" then
		if type(notebookRecord.opened) == "table" then
			for _, id in notebookRecord.opened do
				if goodId(id) and #out.notebook.opened < SaveRules.MAX_PAGES and not table.find(out.notebook.opened, id) then table.insert(out.notebook.opened, id) end
			end
		end
		if finite(notebookRecord.eye_seconds) and notebookRecord.eye_seconds >= 0 then out.notebook.eye_seconds = math.min(notebookRecord.eye_seconds, SaveRules.MAX_EYE_SECONDS) end
	end
	out.finished_main = finishedMain
	if appearance ~= nil and goodId(appearance) then out.appearance = appearance end
	for _, k in SaveRules.PREF_KEYS do
		local v = prefs[k]
		if type(v) == "boolean" then out.prefs[k] = v end
	end
	return out
end

return SaveProgress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">SaveRest</string>
            <string name="Source"><![CDATA[--!strict
-- The last rest of a mode, as the server keeps it (ROBLOX-39): a retreat checkpoint (Checkpoint) in an envelope, one per mode.
-- The simulation runs on the client, so the server cannot know the rest is a true one. What it can do, and does, is refuse anything that
-- is not a whole, well-formed, sensible rest before it is stored: bounded size and depth, only plain values, the full checkpoint check
-- (Checkpoint.check: format, schema, windowsill, the spider's pose, every reference in the object graph, the books adding up) against a
-- stand-in world that names the same things the real one does, and the rules in the record agreeing with the mode it is filed under.
-- This is a boundary for corruption safety, not anti-cheat: this is a solo game with no economy, so a client that lies only affects its
-- own rest. A rest from a newer game build is refused here and, if it is already stored, left alone by SaveSession.
local SaveRules = require(script.Parent.Parent.Data.SaveRules)
local Species = require(script.Parent.Parent.Data.Species)
local Json = require(script.Parent.Json)
local Checkpoint = require(script.Parent.Checkpoint)
local SaveEnvelope = require(script.Parent.SaveEnvelope)

local SaveRest = {}

SaveRest.SCHEMA = 1

-- Counts the values in `v` and refuses anything that is not a plain string, boolean, finite number or table without a metatable, a
-- table met twice, or a structure deeper than `maxDepth` or larger than `maxNodes`. Cheap and bounded: a hostile payload is stopped
-- before anything encodes it. Returns the problem, or nil.
function SaveRest.bounded(v: any, maxNodes: number, maxDepth: number): string?
	local nodes = 0
	local seen: { [any]: boolean } = {}
	local problem: string? = nil
	local function walk(x: any, depth: number)
		if problem then return end
		nodes += 1
		if nodes > maxNodes then problem = "too many values"; return end
		local t = type(x)
		if t == "string" or t == "boolean" then return end
		if t == "number" then
			if x ~= x or x == math.huge or x == -math.huge then problem = "a number JSON cannot hold" end
			return
		end
		if t ~= "table" then problem = `a {typeof(x)}, which a save cannot hold`; return end
		if depth > maxDepth then problem = "nested too deeply"; return end
		if getmetatable(x) ~= nil then problem = "a table with a metatable"; return end
		if seen[x] then problem = "a table met twice"; return end
		seen[x] = true
		for k, y in x do
			if type(k) ~= "string" and type(k) ~= "number" then problem = "a key that is not a string or a number"; return end
			walk(y, depth + 1)
			if problem then return end
		end
	end
	walk(v, 1)
	return problem
end

-- The stand-in world: whatever a real client's world offers to Checkpoint.refs, in the same names. A record names these by string; the
-- server needs only that they exist. The species data is the real one (the record's profile references are paths into it).
local function noop() end
local function stubWorld(): Checkpoint.World
	return {
		motor = {}, 
		prey = { p = Species.fly_like_prototype, graph = { cast = noop, sweep = noop, overlap = noop }, probe = {} },
		sensor = { core = { cueEmitted = {} } },
		memory = { contactAcquired = {}, categoryChanged = {}, contactLost = {}, contactReacquired = {}, contactEnded = {} },
		needs = { onEnergyChanged = noop },
		life = { save = noop },
	} :: any
end
SaveRest.stubWorld = stubWorld

-- Every problem with a rest filed under `mode` ("main" or "free"); an empty list for a good one. Never raises.
function SaveRest.check(mode: any, record: any): { string }
	if mode ~= "main" and mode ~= "free" then return { "unknown mode" } end
	if type(record) ~= "table" then return { "the rest is not a table" } end
	local why = SaveRest.bounded(record, SaveRules.MAX_REST_NODES, SaveRules.MAX_DEPTH)
	if why then return { why } end
	local text, err = Json.canonical(record)
	if not text then return { "cannot be stored: " .. tostring(err) } end
	if #text > SaveRules.MAX_REST_CHARS then return { `the rest is {#text} characters; the limit is {SaveRules.MAX_REST_CHARS}` } end
	local rules = record.life_rules
	if type(rules) ~= "table" or rules.mode ~= mode then return { `the rules in this rest are not {mode}'s` } end
	local ok, result = pcall(function(): { string }
		local found = Checkpoint.check(record, stubWorld())
		return found
	end)
	if not ok then return { "the check raised: " .. tostring(result) } end
	return result :: { string }
end

-- The envelope spec of a rest of `mode`.
function SaveRest.spec(mode: string): SaveEnvelope.Spec
	return {
		kind = "rest_" .. mode, current = SaveRest.SCHEMA,
		migrations = {} :: { [number]: (any) -> any },
		validate = function(payload: any): ({ string }, any?) return SaveRest.check(mode, payload), payload end,
	}
end

SaveRest.SPECS = { main = SaveRest.spec("main"), free = SaveRest.spec("free") }

return SaveRest
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">SaveScheduler</string>
            <string name="Source"><![CDATA[--!strict
-- When a save is written (ROBLOX-39): only decisions, no store and no clock of its own (the caller passes `now`, in seconds). It keeps, for
-- each thing worth saving, whether it has changed since the last good write, the earliest time to try again, and how often it has failed;
-- plus the lock's heartbeat and the one-minute request budget.
--   * a change marks the thing dirty; progress is written at most once per PROGRESS_DEBOUNCE (changes in between are coalesced into the
--     one write), a rest at most once per REST_MIN_INTERVAL (a key takes a write about every 6 s)
--   * a failure keeps it dirty and waits BACKOFF_BASE * 2^(failures - 1) seconds, up to BACKOFF_CAP (a throttle waits twice as long; a
--     configuration error waits the cap)
--   * a success clears it, unless it changed again while the write was in flight (the version counter), when it stays dirty
--   * the budget: at most REQUESTS_PER_MINUTE requests started in any minute; leaving the game or shutting down may go past it
local SaveRules = require(script.Parent.Parent.Data.SaveRules)

local SaveScheduler = {}
SaveScheduler.__index = SaveScheduler

export type Item = { dirty: boolean, version: number, sentVersion: number, nextAt: number, lastWriteAt: number, failures: number, minInterval: number, lastClass: string }

function SaveScheduler.new(): any
	return setmetatable({ items = {} :: { [string]: Item }, started = {} :: { number }, lastBeat = -1e9 }, SaveScheduler)
end

function SaveScheduler.track(self: any, name: string, minInterval: number)
	self.items[name] = { dirty = false, version = 0, sentVersion = 0, nextAt = 0, lastWriteAt = -1e9, failures = 0, minInterval = minInterval, lastClass = "" }
end

-- Something changed. The first change of a clean item sets when it is due; later changes keep that time (they join the same write).
function SaveScheduler.markDirty(self: any, name: string, now: number)
	local it: Item = self.items[name]
	it.version += 1
	if not it.dirty then
		it.dirty = true
		it.nextAt = math.max(now, it.lastWriteAt + it.minInterval)
	end
end

function SaveScheduler.isDirty(self: any, name: string): boolean
	return self.items[name].dirty
end

function SaveScheduler.anyDirty(self: any): boolean
	for _, it in self.items do if it.dirty then return true end end
	return false
end

function SaveScheduler.failures(self: any, name: string): number
	return self.items[name].failures
end

-- How many requests were started in the last minute.
local function recent(self: any, now: number): number
	local keep: { number } = {}
	for _, t in self.started do if now - t < 60 then table.insert(keep, t) end end
	self.started = keep
	return #keep
end

function SaveScheduler.budgetOk(self: any, now: number): boolean
	return recent(self, now) < SaveRules.REQUESTS_PER_MINUTE
end

-- A request is starting (counts against the budget). Returns the version being written, to hand back to `succeeded`.
function SaveScheduler.begin(self: any, name: string?, now: number): number
	table.insert(self.started, now)
	if name == nil then return 0 end
	local it: Item = self.items[name]
	it.sentVersion = it.version
	return it.version
end

-- Is this item due: dirty, its time has come, and the budget allows a request?
function SaveScheduler.due(self: any, name: string, now: number): boolean
	local it: Item = self.items[name]
	return it.dirty and now >= it.nextAt and self:budgetOk(now)
end

function SaveScheduler.succeeded(self: any, name: string, now: number, version: number)
	local it: Item = self.items[name]
	it.failures = 0
	it.lastWriteAt = now
	it.lastClass = ""
	if it.version == version then
		it.dirty = false
	else -- changed while it was being written: still dirty, due once the interval has passed
		it.nextAt = math.max(now, now + it.minInterval)
	end
end

function SaveScheduler.backoff(failures: number, class: string): number
	local n = math.max(failures, 1)
	local base = SaveRules.BACKOFF_BASE * 2 ^ (n - 1)
	if class == "throttle" then base *= 2 end
	if class == "config" then base = SaveRules.BACKOFF_CAP end
	return math.min(base, SaveRules.BACKOFF_CAP)
end

function SaveScheduler.failed(self: any, name: string, now: number, class: string): number
	local it: Item = self.items[name]
	it.failures += 1
	it.lastClass = class
	local wait = SaveScheduler.backoff(it.failures, class)
	it.nextAt = now + wait
	return wait
end

-- Gives up on an item whose current content can never be stored (class "value"): clean again, nothing pending.
function SaveScheduler.abandon(self: any, name: string)
	local it: Item = self.items[name]
	it.dirty = false
	it.failures = 0
end

function SaveScheduler.heartbeatDue(self: any, now: number): boolean
	return now - self.lastBeat >= SaveRules.HEARTBEAT and self:budgetOk(now)
end

function SaveScheduler.beat(self: any, now: number)
	self.lastBeat = now
end

return SaveScheduler
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">SaveSession</string>
            <string name="Source"><![CDATA[--!strict
-- One player's save session (ROBLOX-39): loads their records through a store backend, keeps their progress and rests in memory, and writes
-- them back safely. All the decisions are here, with no engine in them: the backend (a real DataStore or the in-memory one), the clock and
-- the sleep are handed in, so the tests drive every failure.
--
-- What it promises
--   * Nothing stored is ever replaced by a default, a guess or a lesser copy. The first thing a session does is an UpdateAsync that reads the
--     progress record and takes its lock; a record that cannot be read, is corrupt (checksum), is invalid, is made by a NEWER build, or is
--     held by a live session makes the session session-only: it keeps the player's progress in memory, tells them, and writes nothing.
--   * Writes are UpdateAsync that merge (pages are a union, eye time the longest, a finished life stays) and refuse to touch a lock another
--     live session holds. A previous good version is kept inside the value as its backup.
--   * One lock, one heartbeat: the progress record carries { session, beat }. A newer session may take it over once the beat is LOCK_STALE
--     old; the older one finds out at its next write or heartbeat and goes read-only. A read-only or failed-to-load session tries again
--     every RETRY_LOAD seconds and, once it holds the lock, merges what it kept with what is stored.
--   * Rests are separate values (one per mode): replaceable, with their own backup. A rest is written only if nobody wrote a newer one
--     since this session read it.
-- States: "loading", "active", "session" (session-only: `reason` says why: offline, no_api, load_failed, other_session, corrupt, newer).
local SaveRules = require(script.Parent.Parent.Data.SaveRules)
local SaveEnvelope = require(script.Parent.SaveEnvelope)
local SaveProgress = require(script.Parent.SaveProgress)
local SaveRest = require(script.Parent.SaveRest)
local SaveScheduler = require(script.Parent.SaveScheduler)
local SaveStores = require(script.Parent.SaveStores)
local Json = require(script.Parent.Json)

local function canonical(v: any): string
	return (Json.canonical(v)) or ""
end

local SaveSession = {}
SaveSession.__index = SaveSession

export type Config = {
	backend: any, userId: number | string, sessionId: string, now: () -> number,
	sleep: ((number) -> ())?, log: ((string) -> ())?, progressSpec: SaveEnvelope.Spec?, -- (a test may hand in a later schema)
	onChange: ((string, string?) -> ())?, onLoaded: ((any) -> ())?, onRest: ((string, any) -> ())?,
}


function SaveSession.new(cfg: Config): any
	local sched = SaveScheduler.new()
	sched:track("progress", SaveRules.PROGRESS_DEBOUNCE)
	sched:track("rest_main", SaveRules.REST_MIN_INTERVAL)
	sched:track("rest_free", SaveRules.REST_MIN_INTERVAL)
	return setmetatable({
		cfg = cfg, backend = cfg.backend, id = cfg.sessionId, now = cfg.now, pspec = cfg.progressSpec or SaveProgress.SPEC,
		pkey = SaveRules.KEY_PROGRESS .. tostring(cfg.userId),
		rkey = { main = `{SaveRules.KEY_REST}{cfg.userId}_main`, free = `{SaveRules.KEY_REST}{cfg.userId}_free` },
		sched = sched,
		state = "loading", reason = nil :: string?, canRetry = false, retryAt = 0,
		progress = SaveProgress.default(), progressTime = 0, storedTime = 0,
		rests = { main = nil, free = nil } :: { [string]: any },
		restBase = {} :: { [string]: number }, -- updatedAt of the rest this session last read or wrote (nil: unknown)
		restPending = {} :: { [string]: any }, restPendingTime = {} :: { [string]: number },
		restLoaded = {} :: { [string]: boolean }, restRetryAt = 0,
		lockHeld = false, busy = false, closed = false,
		lastStatus = "", lastReason = "",
		counters = { requests = 0, writes = 0, rejected = 0 },
	}, SaveSession)
end

local function log(self: any, text: string)
	local l = self.cfg.log
	if l then l(`[save {self.cfg.userId}] {text}`) end
end

local function lockNow(self: any, now: number): { [string]: any }
	return { session = self.id, beat = now }
end

function SaveSession.isActive(self: any): boolean
	return self.state == "active"
end

function SaveSession.status(self: any): (string, string?)
	if self.state == "session" then return SaveRules.STATUS.session, self.reason end
	if self.state == "loading" then return SaveRules.STATUS.saving, nil end
	if self.busy or self.sched:anyDirty() then
		local trouble = false
		for _, name in { "progress", "rest_main", "rest_free" } do
			if self.sched.items[name].dirty and self.sched.items[name].failures >= 3 then trouble = true end
		end
		return SaveRules.STATUS.saving, if trouble then "write_failed" else nil
	end
	return SaveRules.STATUS.saved, nil
end

function SaveSession.notify(self: any)
	local status, reason = self:status()
	local r = reason or ""
	if status ~= self.lastStatus or r ~= self.lastReason then
		self.lastStatus, self.lastReason = status, r
		local f = self.cfg.onChange
		if f then f(status, reason) end
	end
end

-- Goes session-only. The progress in memory stays; nothing more is written until the lock is held again (when `retry` is true).
function SaveSession.demote(self: any, reason: string, retry: boolean)
	if self.state == "session" and self.reason == reason then return end
	log(self, "session-only: " .. reason)
	self.state, self.reason, self.lockHeld = "session", reason, false
	self.canRetry = retry
	self.retryAt = self.now() + SaveRules.RETRY_LOAD
	self:notify()
end

-- ---------------------------------------------------------------- loading
-- One try at reading the progress record and taking its lock. Returns a verdict:
--   "ok" (held), "locked", "newer", "corrupt", "failed" (the store failed: class in .errClass), "config".
local function attemptLock(self: any): (string, any)
	local now = self.now()
	local verdict = ""
	local info: any = nil
	self.sched:begin(nil, now)
	self.counters.requests += 1
	local ok, _, err = self.backend:update(self.pkey, function(old: any): any
		local op = SaveEnvelope.open(self.pspec, old)
		info = op
		verdict = op.status
		if op.status == "newer" or op.status == "corrupt" or op.status == "invalid" then return nil end
		if op.status == "missing" then
			verdict = "ok"
			return SaveEnvelope.make(self.pspec, SaveProgress.default(), now, nil, { lock = lockNow(self, now) })
		end
		if SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then
			verdict = "locked"
			return nil
		end
		verdict = "ok"
		return SaveEnvelope.withLock(old, lockNow(self, now))
	end)
	if not ok then
		local class = SaveStores.classify(err)
		return if class == "config" then "config" else "failed", { err = err, class = class }
	end
	if verdict == "invalid" then verdict = "corrupt" end
	return verdict, info
end

local function adoptStored(self: any, info: any)
	-- The progress in memory (kept while the session was session-only, or sent by the client before the load finished) is merged into what is stored.
	local stored: any = if info and info.payload then info.payload else SaveProgress.default()
	local storedTime = if info and info.updatedAt then info.updatedAt else 0
	local mem = self.progress
	self.progress = SaveProgress.merge(stored, mem, storedTime, self.progressTime)
	self.storedTime = storedTime
	if not SaveProgress.same(self.progress, stored) then
		self.sched:markDirty("progress", self.now())
	end
end

local function readRests(self: any)
	for _, mode in SaveRules.MODES do
		if not self.restLoaded[mode] then
			local ok, value, err = self.backend:read(self.rkey[mode])
			self.sched:begin(nil, self.now())
			self.counters.requests += 1
			if not ok then
				log(self, `could not read the {mode} rest: {tostring(err)}`)
				self.restRetryAt = self.now() + SaveScheduler.backoff(1, SaveStores.classify(err))
			else
				local spec = SaveRest.SPECS[mode]
				local op = SaveEnvelope.open(spec, value)
				self.restLoaded[mode] = true
				if op.status == "ok" or op.status == "migrated" then
					self.restBase[mode] = op.updatedAt
					self.rests[mode] = op.payload
				elseif op.status == "missing" then
					self.restBase[mode] = 0
				else
					-- unreadable or made by a newer build: the backup, if it is good, is what the player returns to; the damaged value is replaced
					-- by the next rest (a newer build's value is never written over: see writeRest)
					self.restBase[mode] = op.updatedAt or 0
					local b = op.backup
					if b and (b.status == "ok" or b.status == "migrated") then self.rests[mode] = b.payload end
					log(self, `the {mode} rest is {op.status}: {op.reasons[1] or ""}`)
					if op.status == "newer" then self.restNewer = true end
				end
				-- a rest we hold unsent that is newer than the one stored stays pending; an older one is dropped
				local pending = self.restPendingTime[mode]
				if pending ~= nil and (self.restBase[mode] or 0) > pending then
					self.restPending[mode], self.restPendingTime[mode] = nil, nil
					self.sched.items["rest_" .. mode].dirty = false
				end
			end
		end
	end
end

-- Loads the player's records. Yields (backend calls). Returns the state: "active" or "session".
function SaveSession.load(self: any): string
	if self.closed then return self.state end
	local verdict, info = attemptLock(self)
	local first = self.state == "loading"
	if verdict == "ok" then
		adoptStored(self, info)
		self.state, self.reason, self.lockHeld, self.canRetry = "active", nil, true, false
		self.sched:beat(self.now())
		self.restLoaded = {} -- read again: another session may have written a rest while this one could not
		readRests(self)
		if self.restNewer then
			self:demote("newer", false)
			self.restNewer = false
		end
	elseif verdict == "locked" then
		if info and info.payload then self.progress = SaveProgress.merge(info.payload, self.progress, info.updatedAt or 0, self.progressTime) end
		self.state = "session"
		self:demote("other_session", true)
	elseif verdict == "newer" then
		self.state = "session"
		self:demote("newer", false)
	elseif verdict == "corrupt" then
		-- the stored record is left exactly as it is. If its backup is good the player sees that much of their notebook meanwhile.
		local b = info and info.backup
		if b and (b.status == "ok" or b.status == "migrated") then self.progress = SaveProgress.merge(b.payload, self.progress, b.updatedAt or 0, self.progressTime) end
		log(self, "the progress record is not readable: " .. tostring(info and info.reasons and info.reasons[1]))
		self.state = "session"
		self:demote("corrupt", false)
	elseif verdict == "config" then
		self.state = "session"
		self:demote("no_api", false)
	else
		log(self, "could not load: " .. tostring(info and info.err))
		self.state = "session"
		self:demote("load_failed", true)
	end
	if first or self.state == "active" then self:notify() end
	return self.state
end

-- ---------------------------------------------------------------- what the client gives and what is known
function SaveSession.setProgress(self: any, payload: any): boolean
	if self.closed then return false end
	local big = SaveRest.bounded(payload, SaveRules.MAX_PROGRESS_NODES, SaveRules.MAX_PROGRESS_DEPTH)
	if big then
		self.counters.rejected += 1
		log(self, "progress refused: " .. big)
		return false
	end
	local problems, clean = SaveProgress.sanitize(payload)
	if clean == nil then
		self.counters.rejected += 1
		log(self, "progress refused: " .. tostring(problems[1]))
		return false
	end
	local now = self.now()
	local merged = SaveProgress.merge(self.progress, clean, self.progressTime, now)
	if not SaveProgress.same(merged, self.progress) then
		self.progress = merged
		self.progressTime = now
		self.sched:markDirty("progress", now)
		self:notify()
	end
	return true
end

function SaveSession.setRest(self: any, mode: string, record: any): boolean
	if self.closed or (mode ~= "main" and mode ~= "free") then return false end
	local problems = SaveRest.check(mode, record)
	if #problems > 0 then
		self.counters.rejected += 1
		log(self, `the {mode} rest was refused: {problems[1]}`)
		return false
	end
	local now = self.now()
	self.restPending[mode], self.restPendingTime[mode] = record, now
	self.sched:markDirty("rest_" .. mode, now)
	self:notify()
	return true
end

-- ---------------------------------------------------------------- writing
-- Writes the progress (merged with what is stored). `release`: also let go of the lock. Returns true when it is stored.
local function writeProgress(self: any, release: boolean): boolean
	local now = self.now()
	local version = self.sched:begin("progress", now)
	self.counters.requests += 1
	local outcome = ""
	local merged: any = nil
	local newTime = now
	local ok, _, err = self.backend:update(self.pkey, function(old: any): any
		outcome = ""
		local op = SaveEnvelope.open(self.pspec, old, false)
		if op.status == "newer" then outcome = "newer"; return nil end
		if op.status == "corrupt" or op.status == "invalid" then outcome = "corrupt"; return nil end
		if op.status ~= "missing" and SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then outcome = "locked"; return nil end
		local base: any = if op.payload then op.payload else SaveProgress.default()
		local baseTime = op.updatedAt or 0
		merged = SaveProgress.merge(base, self.progress, baseTime, self.progressTime)
		newTime = math.max(now, baseTime)
		outcome = "ok"
		local lock = if release then nil else lockNow(self, now)
		if op.status ~= "missing" and SaveProgress.same(merged, base) and op.status == "ok" then
			return SaveEnvelope.withLock(old, lock) -- nothing new to say: only the lock moves (payload, checksum and backup untouched)
		end
		return SaveEnvelope.make(self.pspec, merged, newTime, old, { lock = lock })
	end)
	if not ok then
		local class = SaveStores.classify(err)
		if class == "value" then
			log(self, "the progress record cannot be stored: " .. tostring(err))
			self.sched:abandon("progress")
			return false
		end
		local wait = self.sched:failed("progress", now, class)
		log(self, `progress write failed ({class}, retry in {wait} s): {tostring(err)}`)
		return false
	end
	if outcome == "ok" then
		self.progress = merged
		self.storedTime = newTime
		self.sched:succeeded("progress", now, version)
		self.sched:beat(now)
		self.counters.writes += 1
		if release then self.lockHeld = false end
		return true
	end
	if outcome == "locked" then
		self:demote("other_session", true)
	elseif outcome == "newer" then
		self:demote("newer", false)
	elseif outcome == "corrupt" then
		self:demote("corrupt", false)
	end
	return false
end

local function writeRest(self: any, mode: string): boolean
	local name = "rest_" .. mode
	local record = self.restPending[mode]
	if record == nil then
		self.sched.items[name].dirty = false
		return true
	end
	local now = self.now()
	local version = self.sched:begin(name, now)
	self.counters.requests += 1
	local spec = SaveRest.SPECS[mode]
	local outcome = ""
	local newTime = now
	local ok, _, err = self.backend:update(self.rkey[mode], function(old: any): any
		outcome = ""
		local op = SaveEnvelope.open(spec, old, false)
		if op.status == "newer" then outcome = "newer"; return nil end
		local base = self.restBase[mode]
		if (op.status == "ok" or op.status == "migrated") and base ~= nil and (op.updatedAt or 0) > base and op.session ~= self.id then
			outcome = "superseded"
			return nil
		end
		if (op.status == "ok") and canonical(op.payload) == canonical(record) then
			-- already stored (an earlier try whose answer was lost): nothing to write, and the backup must not become a copy of it
			newTime = op.updatedAt or now
			outcome = "ok"
			return nil
		end
		newTime = math.max(now, op.updatedAt or 0)
		outcome = "ok"
		return SaveEnvelope.make(spec, record, newTime, old, { session = self.id })
	end)
	if not ok then
		local class = SaveStores.classify(err)
		if class == "value" then
			log(self, `the {mode} rest cannot be stored: {tostring(err)}`)
			self.restPending[mode], self.restPendingTime[mode] = nil, nil
			self.sched:abandon(name)
			return false
		end
		local wait = self.sched:failed(name, now, class)
		log(self, `{mode} rest write failed ({class}, retry in {wait} s): {tostring(err)}`)
		return false
	end
	if outcome == "ok" then
		self.restBase[mode] = newTime
		self.rests[mode] = record
		if self.restPending[mode] == record then self.restPending[mode], self.restPendingTime[mode] = nil, nil end
		self.sched:succeeded(name, now, version)
		self.counters.writes += 1
		return true
	end
	if outcome == "superseded" then
		self:demote("other_session", true)
	elseif outcome == "newer" then
		self:demote("newer", false)
	end
	return false
end

-- Refreshes the lock when no write has done it lately.
local function heartbeat(self: any)
	local now = self.now()
	self.sched:begin(nil, now)
	self.counters.requests += 1
	local outcome = ""
	local ok, _, err = self.backend:update(self.pkey, function(old: any): any
		outcome = ""
		local op = SaveEnvelope.open(self.pspec, old, false)
		if op.status == "missing" then outcome = "missing"; return nil end
		if op.status == "newer" then outcome = "newer"; return nil end
		if op.status == "corrupt" or op.status == "invalid" then outcome = "corrupt"; return nil end
		if SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then outcome = "locked"; return nil end
		outcome = "ok"
		return SaveEnvelope.withLock(old, lockNow(self, now))
	end)
	if not ok then
		log(self, "heartbeat failed: " .. tostring(err))
		self.sched:beat(now - SaveRules.HEARTBEAT + 5) -- try again in a few seconds
		return
	end
	self.sched:beat(now)
	if outcome == "locked" then self:demote("other_session", true)
	elseif outcome == "newer" then self:demote("newer", false)
	elseif outcome == "corrupt" then self:demote("corrupt", false) end
end

-- One pass of the periodic work; the server calls it about once a second. Does at most one request per call. Returns whether it asked.
local function stepInner(self: any): boolean
	local now = self.now()
	local did = true
	if self.state == "session" then
		if self.canRetry and now >= self.retryAt and self.sched:budgetOk(now) then
			self.retryAt = now + SaveRules.RETRY_LOAD
			local wasReason = self.reason
			self:load()
			if SaveSession.isActive(self) then
				log(self, `holds the record again (was: {tostring(wasReason)})`)
				local f = self.cfg.onLoaded
				if f then f(self:snapshot()) end
			end
		else
			did = false
		end
	elseif self.state == "active" then
		if not self.restLoaded.main or not self.restLoaded.free then
			if now >= self.restRetryAt and self.sched:budgetOk(now) then
				local before = { main = self.rests.main, free = self.rests.free }
				readRests(self)
				for _, mode in SaveRules.MODES do
					if self.rests[mode] ~= nil and before[mode] == nil then
						local f = self.cfg.onRest
						if f then f(mode, self.rests[mode]) end
					end
				end
			else
				did = false
			end
		elseif self.sched:due("progress", now) then
			writeProgress(self, false)
		elseif self.sched:due("rest_main", now) then
			writeRest(self, "main")
		elseif self.sched:due("rest_free", now) then
			writeRest(self, "free")
		elseif self.sched:heartbeatDue(now) then
			heartbeat(self)
		else
			did = false
		end
	else
		did = false
	end
	return did
end

function SaveSession.step(self: any): boolean
	if self.closed or self.busy then return false end
	self.busy = true
	local ok, did = pcall(stepInner, self)
	self.busy = false
	if not ok then
		log(self, "step failed: " .. tostring(did))
		return false
	end
	self:notify()
	return did :: boolean
end

-- The state to hand the client: progress, the rests found, and the status.
function SaveSession.snapshot(self: any): any
	local status, reason = self:status()
	return { status = status, reason = reason, progress = self.progress, rests = { main = self.rests.main, free = self.rests.free } }
end

-- Leaving or shutting down: write whatever is waiting (progress first, then the rests), release the lock, retrying a few times with the
-- backoff, never beyond `deadline` (an absolute time). Yields. After this the session is closed.
function SaveSession.flush(self: any, deadline: number?)
	local sleep = self.cfg.sleep
	local limit = deadline or (self.now() + SaveRules.FLUSH_DEADLINE)
	-- let a write already in flight finish
	local waited = 0
	while self.busy and self.now() < limit and sleep do
		sleep(0.25)
		waited += 1
		if waited > 200 then break end
	end
	if self.state == "active" and not self.closed then
		self.busy = true
		local attempt = 0
		local progressDone, restsDone = false, { main = false, free = false }
		while attempt < SaveRules.FLUSH_ATTEMPTS and self.state == "active" do
			attempt += 1
			if not progressDone then progressDone = writeProgress(self, true) end
			if self.state ~= "active" then break end
			for _, mode in SaveRules.MODES do
				if not restsDone[mode] then
					restsDone[mode] = (self.restPending[mode] == nil) or writeRest(self, mode)
				end
			end
			if progressDone and restsDone.main and restsDone.free then break end
			if self.now() >= limit or sleep == nil then break end
			sleep(SaveRules.FLUSH_BACKOFF * 2 ^ (attempt - 1))
		end
		self.busy = false
	end
	self.closed = true
	self:notify()
end

return SaveSession
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">SaveStores</string>
            <string name="Source"><![CDATA[--!strict
-- Two small pure rules about the stores (ROBLOX-39): which store a build writes to, and what kind of failure a DataStore error is.
local SaveRules = require(script.Parent.Parent.Data.SaveRules)

local SaveStores = {}

-- Which DataStore name to use. Studio and the test place always use the test store, so a Studio run (even with API access on, even of the
-- production project) never touches a real save. A live server of the production place uses the production store. `attribute` is the
-- Workspace attribute SaveStore: it may only choose a test-looking name or the test default, never the production name for a test run.
function SaveStores.name(isStudio: boolean, isTestPlace: boolean, attribute: any): string
	if isStudio or isTestPlace then
		if type(attribute) == "string" and string.match(attribute, "^WindowsillTest[%w_]*$") and #attribute <= 40 then return attribute end
		return SaveRules.STORE_TEST
	end
	return SaveRules.STORE_PRODUCTION
end

-- What kind of failure a DataStore error is, from its message (Roblox puts a number and a sentence in it: "104: Cannot store ..." and the
-- like). Classes:
--   "throttle"  the request was over a budget or queued out: wait and try again, slower
--   "config"    saving cannot work here at all (Studio API access off, an unpublished place, DataStores disabled): do not keep hammering
--   "value"     this key or value can never be stored (a bad key, too large, not storable): retrying the same thing cannot work
--   "transient" anything else (a timeout, the service down, an unknown error): try again later
-- The mapping of messages to classes is from Roblox's documented error codes (101-106 key and value, 301-306 throttles, 4xx and 5xx
-- service); it has not been checked against a live DataStore, and an unknown message is treated as transient on purpose.
function SaveStores.classify(message: any): string
	local m = string.lower(tostring(message))
	local code = tonumber(string.match(m, "^%s*(%d%d%d)%s*:"))
	if code ~= nil then
		if code >= 301 and code <= 306 then return "throttle" end
		if code == 101 or code == 102 or code == 103 or code == 104 or code == 105 then return "value" end
		if code == 403 or code == 401 or code == 402 then return "config" end
	end
	if string.find(m, "studio access", 1, true) or string.find(m, "studioaccesstoapis", 1, true) or string.find(m, "not allowed", 1, true)
		or string.find(m, "publish", 1, true) or string.find(m, "disabled", 1, true) or string.find(m, "must be enabled", 1, true) then
		return "config"
	end
	if string.find(m, "throttl", 1, true) or string.find(m, "over limit", 1, true) or string.find(m, "request queue", 1, true) or string.find(m, "too many requests", 1, true) then
		return "throttle"
	end
	if string.find(m, "too large", 1, true) or string.find(m, "cannot store", 1, true) or string.find(m, "value size", 1, true) or string.find(m, "exceeds", 1, true) then
		return "value"
	end
	return "transient"
end

return SaveStores
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="71">
        <Properties>
          <string name="Name">Predator</string>
        </Properties>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">WaspDirector</string>
            <string name="Source"><![CDATA[--!strict
-- WaspDirector: the black-and-yellow mud dauber's visits to the sill, without the engine. A port of the frozen
-- scripts/predator/wasp_director.gd and its actor scripts/predator/wasp.gd (LIFE round 4; LIFE-03 the first predator; LIFE-01 death can
-- be real and jarring, not sensationalized; spec 2 no threat spawning behind the player and no unexplained death; spec 8.3 search,
-- inspect, approach, strike, disengage). Every number is in Data/Wasp.
--
-- When. At most one visit a day, in the warm middle of the day, never on the first day, never before the spider has finished its first
-- meal, and never while it rests or moults in the crack. Whether a day has a visit, and when, follows from the world's seed and the day
-- alone, so a return to a checkpoint meets the same wasp (the port's own hash: Godot's cannot be reproduced in Luau, so the same seed
-- does not give the same days as Godot).
--
-- Warned. The wasp is heard before it is near: it comes in over the window frame from outside for ARRIVE_S and does not search until it
-- is on the sill. When it lands the spider feels it. When it has seen the spider it turns toward it and comes to look (INSPECT_S at arm's
-- length) before it strikes.
--
-- Search by sight. It moves between authored places on the sill where a spider might be: it hovers and looks, and on open surfaces it may
-- land and walk, its antennae flicking. It knows nothing it has not seen. Each tick that it can see the spider (in range, a clear line,
-- not in the retreat) its notice grows, much faster when the spider moves than when it keeps still, and faster near than far. Out of
-- sight, notice fades. Full notice: it has found the spider.
--
-- Escapes. The silk-lined crack is safe. A jump, a drop on the line, or getting out of sight breaks its approach; then it is confused and
-- searches somewhere at least FAR_FROM_LOSS_WU away. Its strike is a short lunge at where the spider was: a spider that moves off quickly
-- is missed. After SEARCH_S of searching it gives up and flies away.
--
-- Caught. The wasp stings and the spider goes still; the wasp carries it up and away over the frame (`heldAt` is where the spider hangs).
-- The host presents that. The spider is paralysed by the sting, not killed (LIFE-03).
--
-- What is handed in. The director knows the world only through three functions (`ray`, `clear`, `inRetreat`), the spider only through the
-- Spider table of this tick and the life clock only through the Block table, so the plain Luau CLI replays it against Godot's goldens
-- (tests/wasp_reference.json, tools/export_wasp_reference.gd) on an analytic world, and the client gives it the real sill's casts.
-- Random draws come from `rng` (range, unit, int); the tests hand it a scripted one.
--
-- Not ported: Gentle rules (the wasp touches the spider and leaves; Godot's round 5 modes): the flag exists and the rule is here, but
-- Roblox has no mode choice yet, so it is never set. The sound is the host's (captions only; no audio assets).

local Data = require(script.Parent.Parent.Data.Wasp)
local PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)

local WaspDirector = {}
WaspDirector.__index = WaspDirector

WaspDirector.PHASES = table.freeze({ "away", "arriving", "searching", "inspecting", "striking", "carrying", "leaving" })

export type Rng = {
	range: (Rng, number, number) -> number, -- a number in [lo, hi)
	unit: (Rng) -> number, -- a number in [0, 1)
	int: (Rng, number, number) -> number, -- a whole number in [lo, hi]
}
-- What the director asks of the world. `ray`: something solid between two points. `clear`: a sphere of that radius goes from a to b
-- without touching the world. `inRetreat`: inside the silk-lined crack.
export type World = {
	ray: (Vector3, Vector3) -> boolean,
	clear: (Vector3, Vector3, number) -> boolean,
	inRetreat: (Vector3) -> boolean,
}
-- The spider this tick.
export type Spider = {
	position: Vector3,
	velocity: Vector3,
	walkSpeed: number,
	airborne: boolean, -- in a jump
	falling: boolean, -- let down on its line (or fallen)
}
-- The life this tick (Godot: the habitat loop and the feeding controller).
export type Block = { day: number, hour: number, resting: boolean, moulting: boolean, meals: number }
export type Signal = { kind: string, [string]: any }

local UP = Vector3.new(0, 1, 0)
local DOWN = Vector3.new(0, -1, 0)
local FORWARD = Vector3.new(0, 0, -1)
local TAU = math.pi * 2

local function rotateY(v: Vector3, angle: number): Vector3
	local c, s = math.cos(angle), math.sin(angle)
	return Vector3.new(v.X * c + v.Z * s, v.Y, -v.X * s + v.Z * c)
end

local function pathLength(path: { Vector3 }): number
	local total = 0.0
	for i = 2, #path do total += (path[i - 1] - path[i]).Magnitude end
	return math.max(total, 1e-3)
end

-- The default random stream for a visit: the port's Park-Miller, mixed from the seed, the day and the visit.
local function makeStream(seed: number, a: number, b: number): Rng
	local r = PreyRandom.new((seed * 73856093 + a * 19349663 + b * 83492791 + 12345) % 2147483647)
	r:next()
	r:next()
	return {
		range = function(_, lo: number, hi: number): number return lo + (hi - lo) * r:next() end,
		unit = function(): number return r:next() end,
		int = function(_, lo: number, hi: number): number return lo + math.min(math.floor(r:next() * (hi - lo + 1)), hi - lo) end,
	} :: any
end

-- `config.seed`: the world's seed. `config.world`: the three functions. `config.enabled`: false and it never comes by itself (test worlds;
-- force still brings it). `config.makeRng(day, visit)`: the random stream of a visit (tests).
function WaspDirector.new(config: { seed: number, world: World, enabled: boolean?, makeRng: ((number, number) -> Rng)? }): any
	local self = setmetatable({
		world = config.world, enabled = config.enabled ~= false, seed = config.seed, makeRng = config.makeRng,
		-- The wasp as the spider's senses have it (wasp.gd).
		wasp = {
			position = Vector3.new(0, 0, 0), heading = FORWARD, velocity = Vector3.new(0, 0, 0), normal = UP,
			mode = "flying", search = 0.0, visible = false, prev = Vector3.new(0, 0, 0),
		},
		phase = "away", visitS = 0.0, phaseS = 0.0, searchLeft = 0.0, notice = 0.0, confusedS = 0.0,
		noticedThisVisit = false, sparedThisVisit = false, gentle = false,
		lastVisitDay = 0, visits = 0, escapes = 0,
		events = {} :: { { kind: string, t: number } },
		signals = {} :: { Signal },
		-- Where the spider hangs while it is carried (nil otherwise); the host moves the spider there each tick.
		heldAt = nil :: Vector3?, holding = false,
		-- The visit in progress.
		rng = nil :: Rng?, path = {} :: { Vector3 }, pathI = 1, speed = Data.flySpeed, point = 1, recent = {} :: { number },
		sub = "", subS = 0.0, walkDir = Vector3.new(0, 0, 0), stepS = 0.0, openPos = Vector3.new(0, 0, 0), lastSeen = Vector3.new(0, 0, 0),
		unseenS = 0.0, holdS = 0.0, lossPos = nil :: Vector3?, strikeFrom = Vector3.new(0, 0, 0), strikeTo = Vector3.new(0, 0, 0),
		dt = 1 / 60, spider = nil :: Spider?,
	}, WaspDirector)
	return self
end

function WaspDirector.isVisiting(self: any): boolean
	return self.phase ~= "away"
end

-- ---------------------------------------------------------------------------------------------------------------- when it comes

-- Whether day `day` has a visit, and at what hour: -1 when it has none. From the seed and the day alone.
function WaspDirector.plannedHour(self: any, day: number): number
	if day < Data.firstDay then return -1.0 end
	local r = makeStream(self.seed, day, 7)
	if r:unit() >= Data.visitChance then return -1.0 end
	return r:range(Data.windowFromH, Data.windowToH - 1.0)
end

-- Why a visit could not begin now ("" when it could), apart from the hour.
function WaspDirector.blocked(_self: any, block: Block): string
	if block.day < Data.firstDay then return "the first day" end
	if block.meals < 1 then return "no meal yet" end
	if block.resting or block.moulting then return "resting" end
	return ""
end

function WaspDirector._maybeBegin(self: any, block: Block)
	local day = block.day
	if day == self.lastVisitDay then return end
	local hour = self:plannedHour(day)
	if hour < 0.0 or block.hour < hour or block.hour >= Data.windowToH then return end
	if self:blocked(block) ~= "" then return end
	self:beginVisit(day)
end

-- The index of the search place with this id, nil when there is none.
function WaspDirector.pointIndex(id: string): number?
	for i, p in Data.points do
		if p.id == id then return i end
	end
	return nil
end

-- Brings the wasp now (tests, the test place's attribute). `at`: the id of the place it searches first (nil lets the visit choose). False
-- when it is already here.
function WaspDirector.force(self: any, day: number, at: string?): boolean
	if self.phase ~= "away" then return false end
	self:beginVisit(day, if at then WaspDirector.pointIndex(at) else nil)
	return true
end

function WaspDirector.beginVisit(self: any, day: number, first: number?)
	self.lastVisitDay = day
	self.visits += 1
	self.rng = if self.makeRng then self.makeRng(day, self.visits) else makeStream(self.seed, day * 1009 + 13, self.visits)
	self.events = {}
	self.visitS = 0.0
	self.notice = 0.0
	self.confusedS = 0.0
	self.noticedThisVisit = false
	self.sparedThisVisit = false
	self.searchLeft = Data.searchS
	self.recent = {}
	self.lossPos = nil
	self.holding = false
	self.heldAt = nil
	self.point = first or self.rng:int(1, #Data.points)
	local to: Vector3 = Data.points[self.point].hover
	self.path = { Data.entry, Data.over, Vector3.new(to.X, Data.cruiseY, to.Z), to }
	self.pathI = 2
	self.speed = pathLength(self.path) / Data.arriveS
	self:_place(Data.entry)
	self.wasp.mode = "flying"
	self.wasp.search = 0.0
	self.wasp.visible = true
	self:_setPhase("arriving")
	self:_log("warning")
	self:_signal({ kind = "visit_started", first = self.visits == 1, point = Data.points[self.point].id })
end

-- ---------------------------------------------------------------------------------------------------------------- the tick

-- One fixed tick, after the spider has moved. `spider`: this tick's spider; `block`: this tick's life. Nothing is read from the spider
-- while the wasp is away.
function WaspDirector.step(self: any, dt: number, spider: Spider, block: Block)
	self.dt = dt
	self.spider = spider
	local phase: string = self.phase
	if phase == "away" then
		if self.enabled then self:_maybeBegin(block) end
		return
	end
	self.visitS += dt
	self.phaseS += dt
	if phase == "arriving" then
		if self:_advance(dt) then
			self.openPos = self.wasp.position
			self:_setPhase("searching")
			self:_log("searching")
			self.sub = "hover"
			self.subS = self.rng:range(Data.hoverS[1], Data.hoverS[2])
		end
	elseif phase == "searching" then
		self.searchLeft -= dt
		self:_search(dt)
		self:_look(dt)
		if self.notice >= 1.0 then
			self:_beginInspecting()
		elseif self.searchLeft <= 0.0 and (self.sub == "hover" or self.sub == "fly") then
			self:_beginLeaving()
		end
	elseif phase == "inspecting" then
		self:_inspect(dt)
	elseif phase == "striking" then
		self:_strike(dt)
	elseif phase == "carrying" then
		local done = self:_advance(dt)
		self:_holdSpider()
		if done then
			self:_setPhase("away")
			self.wasp.visible = false
			self:_signal({ kind = "carried_off" })
		end
	elseif phase == "leaving" then
		if self:_advance(dt) then
			self.wasp.visible = false
			self:_setPhase("away")
			if self.noticedThisVisit then self.escapes += 1 end
			self:_log("left")
			self:_signal({ kind = "left", escaped = self.noticedThisVisit })
		end
	end
end

-- ---------------------------------------------------------------------------------------------------------------- searching

function WaspDirector._search(self: any, dt: number)
	local wasp = self.wasp
	local sub: string = self.sub
	if sub == "fly" then
		wasp.search = 0.3
		if self:_advance(dt) then
			self.openPos = wasp.position
			self.sub = "hover"
			self.subS = self.rng:range(Data.hoverS[1], Data.hoverS[2])
		end
	elseif sub == "hover" then
		wasp.mode = "flying"
		wasp.search = 0.8
		self:_moveTo(wasp.position, rotateY(wasp.heading, math.rad(Data.scanDegS) * dt), dt)
		self.subS -= dt
		if self.subS <= 0.0 then
			local p = Data.points[self.point]
			if p.land ~= nil and self.rng:unit() < Data.landChance and self.searchLeft > Data.landS + Data.walkS then
				self.sub = "land"
				self.path = { wasp.position, p.land }
				self.pathI = 2
				self.speed = (wasp.position - p.land).Magnitude / Data.landS
			else
				self:_nextPoint()
			end
		end
	elseif sub == "land" then
		if self:_advance(dt) then
			wasp.mode = "walking"
			wasp.normal = UP
			self.openPos = wasp.position
			self:_shake("heavy landing")
			self:_log("landed")
			self:_signal({ kind = "landed", at = wasp.position })
			self.sub = "walk"
			self.subS = Data.walkS
			self.stepS = Data.stepEveryS
			self.walkDir = rotateY(FORWARD, self.rng:range(0.0, TAU))
		end
	elseif sub == "walk" then
		wasp.search = 1.0
		self:_walk(dt)
		self.subS -= dt
		if self.subS <= 0.0 then
			self.sub = "takeoff"
			local up = wasp.position + UP * 1.2
			self.path = { wasp.position, up }
			self.pathI = 2
			self.speed = Data.flySpeed * 0.5
			wasp.mode = "flying"
		end
	elseif sub == "takeoff" then
		if self:_advance(dt) then
			self.openPos = wasp.position
			self:_nextPoint()
		end
	end
end

-- A few steps along the surface it stands on, turning back where it would step off.
function WaspDirector._walk(self: any, dt: number)
	local wasp = self.wasp
	local p: Vector3 = wasp.position
	local nxt = p + self.walkDir * Data.walkSpeed * dt
	if not self.world.ray(nxt + UP * 0.3, nxt + DOWN * 0.8) or not self:_clear(p, nxt, Data.walkRadius) then
		self.walkDir = -self.walkDir
		nxt = p
	end
	self:_moveTo(nxt, self.walkDir, dt)
	self.stepS -= dt
	if self.stepS <= 0.0 then
		self.stepS = Data.stepEveryS
		self:_shake("heavy footsteps")
	end
end

function WaspDirector._nextPoint(self: any)
	table.insert(self.recent, self.point)
	while #self.recent > 3 do table.remove(self.recent, 1) end
	local here: Vector3 = self.wasp.position
	local choices: { number } = {}
	for i, pt in Data.points do
		if table.find(self.recent, i) then continue end
		local hover: Vector3 = pt.hover
		local loss: Vector3? = self.lossPos
		if loss ~= nil and (hover - loss).Magnitude < Data.farFromLossWu then continue end
		table.insert(choices, i)
	end
	if #choices == 0 then table.insert(choices, (self.point % #Data.points) + 1) end
	-- A local search: the nearer half of the places it has not just looked at.
	table.sort(choices, function(a: number, b: number): boolean
		return (here - Data.points[a].hover).Magnitude < (here - Data.points[b].hover).Magnitude
	end)
	local count = math.max(1, (#choices + 1) // 2)
	self.point = choices[self.rng:int(1, count)]
	self:_flyTo(Data.points[self.point].hover, Data.flySpeed)
	self.sub = "fly"
end

-- ---------------------------------------------------------------------------------------------------------------- seeing the spider

-- Whether it can see the spider now: in range, nothing in the way, and not in the retreat.
function WaspDirector.canSeeSpider(self: any): boolean
	local s: Spider? = self.spider
	if s == nil or self.holding or not self.wasp.visible then return false end
	if self.world.inRetreat(s.position) then return false end
	local eye = self:eyePosition()
	if (eye - s.position).Magnitude > Data.sightWu then return false end
	return not self.world.ray(eye, s.position)
end

function WaspDirector.eyePosition(self: any): Vector3
	return self.wasp.position + self.wasp.heading * Data.eyeAhead
end

-- How fast notice grows now (per second) if it can see the spider.
function WaspDirector.noticeRate(self: any): number
	local s: Spider = self.spider
	local d = (self:eyePosition() - s.position).Magnitude
	local walk = math.max(s.walkSpeed, 0.1)
	local motion = math.clamp(s.velocity.Magnitude / walk, 0.0, 1.5)
	if s.airborne then motion = 1.5 end
	return (Data.noticeStill + Data.noticeMoving * motion) * math.max(1.0 - d / Data.sightWu, 0.0)
end

function WaspDirector._look(self: any, dt: number)
	if self.confusedS > 0.0 then
		self.confusedS -= dt
		return
	end
	if self:canSeeSpider() then
		self.notice += self:noticeRate() * dt
		self.lastSeen = (self.spider :: Spider).position
	else
		self.notice = math.max(self.notice - Data.noticeDecay * dt, 0.0)
	end
end

function WaspDirector._beginInspecting(self: any)
	self.notice = 1.0
	self.noticedThisVisit = true
	self.unseenS = 0.0
	self.holdS = 0.0
	if self.wasp.mode == "walking" then self.wasp.mode = "flying" end
	self:_setPhase("inspecting")
	self:_log("noticed")
	self:_signal({ kind = "noticed", at = self.lastSeen })
end

-- Comes to look: to arm's length from where it last saw the spider, then holds there, antennae busy, for INSPECT_S, then strikes. A
-- jump, a drop, the retreat, or the spider out of sight for LOSE_UNSEEN_S, and it has lost it.
function WaspDirector._inspect(self: any, dt: number)
	local s: Spider = self.spider
	local wasp = self.wasp
	wasp.mode = "flying"
	wasp.search = 1.0
	if self.world.inRetreat(s.position) then
		self:_lose("hid")
		return
	end
	if s.airborne then
		self:_lose("jumped")
		return
	end
	if s.falling then
		self:_lose("dropped")
		return
	end
	if self:canSeeSpider() then
		self.unseenS = 0.0
		self.lastSeen = s.position
	else
		self.unseenS += dt
		if self.unseenS > Data.loseUnseenS then
			self:_lose("out of sight")
			return
		end
	end
	if self.phaseS > Data.inspectGiveUpS then
		self:_lose("out of reach")
		return
	end
	local away: Vector3 = wasp.position - self.lastSeen
	if away.Magnitude < 1e-3 then away = UP end
	local standoff = self.lastSeen + away.Unit * Data.standoffWu
	local to = standoff - wasp.position
	local step = Data.inspectSpeed * dt
	local face = self.lastSeen - wasp.position
	if to.Magnitude > 0.05 then
		local nxt = wasp.position + (if to.Magnitude > step then to.Unit * step else to)
		if self:_clear(wasp.position, nxt, Data.radius) then
			self:_moveTo(nxt, face, dt)
		else
			self:_moveTo(wasp.position, face, dt)
		end
		self.holdS = math.max(self.holdS - dt, 0.0)
	else
		self:_moveTo(wasp.position, face, dt)
		self.holdS += dt
		if self.holdS >= Data.inspectS then
			self.strikeFrom = wasp.position
			self.strikeTo = s.position
			self:_setPhase("striking")
			self:_log("strike")
		end
	end
end

function WaspDirector._strike(self: any, dt: number)
	local k = math.clamp(self.phaseS / Data.strikeS, 0.0, 1.0)
	self:_moveTo(self.strikeFrom:Lerp(self.strikeTo, k), self.strikeTo - self.strikeFrom, dt)
	if k < 1.0 then return end
	local s: Spider = self.spider
	if (self.wasp.position - s.position).Magnitude <= Data.catchWu and not self.world.inRetreat(s.position) and not s.airborne then
		if self.gentle then self:_spare() else self:_catch() end
	else
		self:_lose("missed")
	end
end

-- Gentle rules (Godot round 5: Easy and free play): the wasp touches the spider with its antennae and gives up on it, and leaves. Roblox
-- has no such mode yet, so `gentle` is never set outside the tests.
function WaspDirector._spare(self: any)
	self.sparedThisVisit = true
	self:_log("spared")
	self:_signal({ kind = "lost", why = "spared" })
	self:_beginLeaving()
end

function WaspDirector._catch(self: any)
	local wasp = self.wasp
	self.holding = true
	wasp.mode = "holding"
	wasp.search = 0.0
	local p: Vector3 = wasp.position
	self.path = { p, p + UP * 2.5, Data.over }
	self.pathI = 2
	self.speed = pathLength(self.path) / Data.carryS
	self:_setPhase("carrying")
	self:_log("caught")
	self:_holdSpider()
	self:_signal({ kind = "caught" })
end

function WaspDirector._holdSpider(self: any)
	if self.holding then self.heldAt = self.wasp.position + DOWN * Data.holdBelow end
end

function WaspDirector._lose(self: any, why: string)
	self.lossPos = self.lastSeen
	self.notice = Data.afterLossNotice
	self.confusedS = Data.confuseS
	self:_setPhase("searching")
	self:_log("lost:" .. why)
	self:_signal({ kind = "lost", why = why })
	self:_nextPoint()
end

function WaspDirector._beginLeaving(self: any)
	local p: Vector3 = self.wasp.position
	local path = self:_route(p, Data.over)
	table.insert(path, Data.entry)
	self.path = path
	self.pathI = 2
	self.speed = pathLength(path) / Data.leaveS
	self.wasp.mode = "flying"
	self.wasp.search = 0.0
	self:_setPhase("leaving")
	self:_log("leaving")
end

-- ---------------------------------------------------------------------------------------------------------------- paths and the world

function WaspDirector._flyTo(self: any, to: Vector3, speed: number)
	self.path = self:_route(self.wasp.position, to)
	self.pathI = 2
	self.speed = speed
end

-- Up to cruising height (from somewhere open above it), across, and down to `to`.
function WaspDirector._route(self: any, from: Vector3, to: Vector3): { Vector3 }
	local path: { Vector3 } = { from }
	local start = from
	if from.Y < Data.cruiseY and not self:_clear(from, Vector3.new(from.X, Data.cruiseY, from.Z), Data.radius) then
		table.insert(path, self.openPos)
		start = self.openPos
	end
	if start.Y < Data.cruiseY then table.insert(path, Vector3.new(start.X, Data.cruiseY, start.Z)) end
	if to.Y < Data.cruiseY then table.insert(path, Vector3.new(to.X, Data.cruiseY, to.Z)) end
	table.insert(path, to)
	return path
end

-- Moves along the path at the current speed; true at its end.
function WaspDirector._advance(self: any, dt: number): boolean
	local wasp = self.wasp
	local p: Vector3 = wasp.position
	local left = self.speed * dt
	local path: { Vector3 } = self.path
	while self.pathI <= #path and left > 0.0 do
		local target = path[self.pathI]
		local d = (target - p).Magnitude
		if d <= left then
			p = target
			left -= d
			self.pathI += 1
		else
			p += (target - p) / d * left
			left = 0.0
		end
	end
	local dir = p - wasp.position
	self:_moveTo(p, if dir.Magnitude > 1e-5 then dir else wasp.heading, self.dt)
	return self.pathI > #path
end

-- True when a sphere of `radius` moves from `a` to `b` without touching the world.
function WaspDirector._clear(self: any, a: Vector3, b: Vector3, radius: number): boolean
	if (a - b).Magnitude < 1e-5 then return true end
	return self.world.clear(a, b, radius)
end

-- ---------------------------------------------------------------------------------------------------------------- the actor (wasp.gd)

-- Places it and faces it along `dir` (flattened), and works out its velocity from where it was.
function WaspDirector._moveTo(self: any, p: Vector3, dir: Vector3, dt: number)
	local wasp = self.wasp
	wasp.position = p
	wasp.velocity = if dt > 0.0 then (p - wasp.prev) / dt else Vector3.new(0, 0, 0)
	wasp.prev = p
	local flat = Vector3.new(dir.X, 0.0, dir.Z)
	if flat.Magnitude > 1e-4 then wasp.heading = flat.Unit end
end

-- Puts it somewhere without a velocity (its first appearance).
function WaspDirector._place(self: any, p: Vector3)
	self.wasp.position = p
	self.wasp.prev = p
	self.wasp.velocity = Vector3.new(0, 0, 0)
end

-- What the spider's senses get of it: movement, never prey (its percept is capped at movement, so no aim, capture or inspection ever
-- treats it as something to catch). Nil while it is away.
function WaspDirector.percept(self: any): any
	local w = self.wasp
	if not w.visible then return nil end
	return { id = "wasp", position = w.position, radius = Data.sensedRadius, velocity = w.velocity, maxCategory = "movement" }
end

function WaspDirector._shake(self: any, kind: string)
	self:_signal({ kind = "shake", shake = kind, at = self.wasp.position + DOWN * 0.35 })
end

function WaspDirector._setPhase(self: any, p: string)
	self.phase = p
	self.phaseS = 0.0
end

function WaspDirector._log(self: any, kind: string)
	table.insert(self.events, { kind = kind, t = self.visitS })
end

function WaspDirector._signal(self: any, s: Signal)
	table.insert(self.signals, s)
end

-- The signals since the last call, oldest first: visit_started, shake (a landing or a footstep), landed, noticed, lost, caught,
-- carried_off, left.
function WaspDirector.drainSignals(self: any): { Signal }
	local out = self.signals
	self.signals = {}
	return out
end

-- ---------------------------------------------------------------------------------------------------------------- checkpoints

-- Kept in checkpoints: the day of the last visit, and how many visits and escapes this life has had. A visit going on is not kept,
-- because the spider rests in the crack where the wasp cannot find it.
function WaspDirector.toRecord(self: any): { [string]: number }
	return { last_visit_day = self.lastVisitDay, visits = self.visits, escapes = self.escapes }
end

-- The record of a life the wasp has not yet visited.
function WaspDirector.defaultRecord(): { [string]: number }
	return { last_visit_day = 0, visits = 0, escapes = 0 }
end

-- Puts a record back and ends any visit going on (the wasp is away and the spider is no longer held).
function WaspDirector.load(self: any, d: any)
	self.lastVisitDay = math.floor(tonumber(d.last_visit_day) or 0)
	self.visits = math.floor(tonumber(d.visits) or 0)
	self.escapes = math.floor(tonumber(d.escapes) or 0)
	self:clearVisit()
end

-- Ends the visit, if any: away, hidden, nothing held. (A return to a rest, a new life.)
function WaspDirector.clearVisit(self: any)
	self.phase = "away"
	self.phaseS = 0.0
	self.visitS = 0.0
	self.notice = 0.0
	self.confusedS = 0.0
	self.holding = false
	self.heldAt = nil
	self.wasp.visible = false
	self.signals = {}
	self.events = {}
end

function WaspDirector.problems(d: any): { string }
	local out: { string } = {}
	if type(d) ~= "table" then
		table.insert(out, "wasp: not a record")
		return out
	end
	for _, key in { "last_visit_day", "visits", "escapes" } do
		local v = d[key]
		if type(v) ~= "number" or v ~= v or v < 0 or v ~= math.floor(v) then
			table.insert(out, `wasp: {key} must be a whole number, not negative`)
		end
	end
	if #out == 0 and d.escapes > d.visits then table.insert(out, "wasp: more escapes than visits") end
	return out
end

return WaspDirector
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="73">
        <Properties>
          <string name="Name">Prey</string>
        </Properties>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Feeding</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen feeding_controller.gd: struggle after landing, then conserved nutrition grants. The energy itself belongs to the
-- NeedsModel (ROBLOX-24): each tick this advances it (active unless still on a surface, as Godot's controller does) and asks it
-- to grant what the fly gave up, under the meal's capture key. `needs` is the sandbox model unless the owner gives it another
-- (the client gives it the life one). taken/granted/ledger are this controller's own totals, kept as before.
local R=require(script.Parent.PreyRandom)
local NeedsModel=require(script.Parent.Parent.Life.NeedsModel)
local F={};F.__index=F
function F.new(needs: any?): any
 return setmetatable({held=nil,struggling=false,feeding=false,grip=0,elapsed=0,waiting=0,jerk=0,venom=6,
  swallow=0,needs=needs or NeedsModel.new(),taken=0,granted=0,ledger={},mealsFinished=0,auto=false,tap=false,note='',rng=R.new(513)},F)
end
function F.capture(self: any,fly: any)
 self.held=fly;self.struggling=true;self.feeding=false;self.grip=.4;self.elapsed=0;self.waiting=0
 self.venom=self.rng:draw({6,8});self.jerk=self.rng:draw({.35,.75});self.note='Caught!'
end
function F.press(self: any)
 if self.struggling then self.tap=true elseif self.held and self.swallow<=0 then self.feeding=not self.feeding end -- nothing to eat: E is the retreat's (LifeLoop)
end
function F.cancel(self: any) self.feeding=false end
function F.step(self: any,dt: number,attached: boolean,moving: boolean,escape: (any)->())
 self.needs:advance(dt,not attached or moving)
 local f=self.held;if not f then self.tap=false;return end
 if self.struggling then
  if not attached and self.waiting<1 then self.waiting+=dt;self.tap=false;return end
  self.elapsed+=dt
  local strength=1-.5*math.clamp(self.elapsed/self.venom,0,1)
  self.grip-=.32*strength*dt
  self.jerk-=dt
  if self.jerk<=0 then self.grip-=.12*strength;self.jerk+=self.rng:draw({.35,.75}) end
  if self.auto then self.grip+=.4*dt end
  if self.tap then self.grip+=.085 end
  self.tap=false
  if self.grip<=0 then self.held=nil;self.struggling=false;self.note='It tore free!';escape(f)
  elseif self.grip>=1 or self.elapsed>=12 then self.grip=1;self.struggling=false;self.feeding=true;self.swallow=1;self.note='Subdued.' end
  return
 end
 self.swallow=math.max(0,self.swallow-dt)
 if not attached or moving then self.feeding=false;return end
 if self.swallow>0 then self.feeding=true end
 if not self.feeding then return end
 local take=math.min(f.nutrition,f.profile.body.feed_rate_per_s*dt)
 f.nutrition-=take
 local granted=self.needs:grantEnergy(take,f.captureKey)
 self.taken+=take;self.granted+=granted
 self.ledger[f.captureKey]=(self.ledger[f.captureKey] or 0)+granted
 if f.nutrition<=1e-9 then f.nutrition=0;f.state='CONSUMED';self.held=nil;self.feeding=false;self.mealsFinished+=1;self.note='Meal finished.' end
end
return F
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Fly</string>
            <string name="Source"><![CDATA[--!strict
-- Fly's evidence-owned decisions, reactions, flights, glances and surface bursts.
-- Sources: frozen fly.gd and fly_mind.gd. Geometry and random stream are explicit dependencies.
local M=require(script.Parent.PreyMath)
local S=require(script.Parent.FlySenses)
local F=require(script.Parent.FlyFlight)
local R=require(script.Parent.PreyRandom)
local Fly={};Fly.__index=Fly
function Fly.new(id: string,serial: number,seed: number,perch: any,graph: any,profile: any,now: number): any
 local f:any=setmetatable({id=id,serial=serial,profile=profile,graph=graph,rng=R.new(seed),senses=S.new(profile.senses),
  position=graph:rest(perch),prevPosition=graph:rest(perch),normal=perch.normal,heading=Vector3.new(0,0,-1),velocity=Vector3.zero,
  state='PERCHED',stateSince=now,goal='rest',goalSince=now,perch=perch,fatigue=0,restlessBias=0,
  nextDecision=now+(serial*.0371)%(1/profile.behavior.decision_hz),nextGlance=now,nextWalk=now+2,nextGroom=now+6,groomUntil=0,
  walkLeft=0,burstUntil=0,pauseUntil=0,walkSpeed=0,walkDirection=Vector3.zero,pending=nil,blocked={},candidates=0,
  nutrition=profile.body.nutrition,captureSerial=0,trace={},enabled=true},Fly)
 f.flight=F.new(f,graph);perch.occupant=id;f:beginStay(now)
 return f
end
function Fly.beginStay(self: any,now: number)
 local p=self.profile.behavior
 self.perchedSince=now;self.restlessRate=p.restless_per_s*(1+p.restless_spread*(self.rng:next()*2-1))
 self.nextGroom=now+self.rng:draw(p.groom_interval_s);self.groomUntil=0
 self.nextGlance=now+self.rng:draw(p.glance_interval_s);self.glanceSign=if self.rng:next()<.5 then -1 else 1
 self.nextWalk=now+self.rng:draw(p.walk_interval_s);self.nextFidget=now+self.rng:draw(p.fidget_interval_s)
 self.homeHeading=self.heading;self.glanceTarget=nil;self.fidgetUntil=0;self.restSpot=self.position;self.walkLeft=0
end
function Fly.turn(self: any,target: Vector3,dt: number): boolean
 local tangent=target-self.normal*target:Dot(self.normal)
 if tangent.Magnitude<1e-6 then return true end
 local angle=math.atan2(self.normal:Dot(self.heading:Cross(tangent.Unit)),self.heading:Dot(tangent.Unit))
 local limit=math.rad(self.profile.flight.turn_rate_deg_s)*dt
 self.heading=CFrame.fromAxisAngle(self.normal,math.clamp(angle,-limit,limit)):VectorToWorldSpace(self.heading).Unit
 return math.abs(angle)<=limit+1e-4
end
function Fly.surface(self: any,point: Vector3): boolean
 local hit=self.graph.cast(point+self.normal*.3,point-self.normal*.3)
 return hit~=nil and hit.Normal:Dot(self.normal)>.98 and math.abs((hit.Position+self.normal*self.profile.body.hover_wu-point):Dot(self.normal))<=.06
end
function Fly.alive(self: any): boolean return self.state~='CAPTURED' and self.state~='CONSUMED' end
function Fly.airborne(self: any): boolean return self.state~='PERCHED' and self.state~='ALERT' and self:alive() end
function Fly.percept(self: any): any
 if not self:alive() then return nil end
 return {id=self.id,position=self.position,radius=self.profile.body.radius_wu,velocity=self.velocity,maxCategory='fly_like_prey'}
end
function Fly.relevance(self: any,now: number): number
 local s=self.senses;if not s.hasLastSeen then return 0 end
 local p=self.profile
 return math.clamp(1-(now-s.lastSeenTime-.4)/math.max(p.senses.threat_memory_s-.4,.1),0,1)
  *math.clamp((p.flight.safe_distance_wu*1.5-(self.position-s.lastSeenPosition).Magnitude)/p.flight.safe_distance_wu,0,1)
end
function Fly.ranked(self: any,kind: string,now: number,threat: number,relaxed: boolean?): {any}
 local p=self.profile;local origin=self.position;local list={}
 local restless=math.clamp((now-self.perchedSince)*self.restlessRate,0,1)
 for _,c in self.graph.perches do
  local d=(origin-c.position).Magnitude
  local minimum=if kind=='flee' and not relaxed then math.max(p.flight.min_hop_wu,p.flight.flee_speed_wu_s*p.flight.flee_min_s*.5) else p.flight.min_hop_wu
  local maximum=if kind=='move' then p.behavior.reposition_max_wu else p.flight.max_flight_wu
  local away=if self.senses.hasLastSeen then (c.position-self.senses.lastSeenPosition).Magnitude else p.flight.safe_distance_wu*.5
  if c.valid and c.occupant=='' and (c.reserved=='' or c.reserved==self.id) and d>=minimum and d<=maximum and (self.blocked[c.id] or 0)<=now
   and (kind~='flee' or relaxed or away>=p.flight.perch_avoid_wu) then
   self.candidates+=1
   local travel=math.clamp(d/p.flight.max_flight_wu,0,1)
   local score=if kind=='move' then M.scoreMove(p.utility,restless,math.clamp(c.food-self.perch.food,0,1),math.clamp(c.shelter-self.perch.shelter,0,1),travel,self.fatigue,threat)
    else M.scoreFlee(p.utility,threat,c.shelter,math.clamp(away/p.flight.safe_distance_wu,0,1),travel)
   table.insert(list,{perch=c,score=score})
  end
 end
 table.sort(list,function(a,b) return a.score>b.score or (a.score==b.score and a.perch.id<b.perch.id) end)
 return list
end
function Fly.choose(self: any,kind: string,now: number,threat: number,relaxed: boolean?): (any,{Vector3}?)
 local danger=if kind=='flee' and self.senses.hasLastSeen then self.senses.lastSeenPosition else nil
 for i,c in self:ranked(kind,now,threat,relaxed) do
  if i>self.profile.behavior.candidates_validated then break end
  local path=self.graph:plan(self.position,if self:airborne() then Vector3.zero else self.normal,c.perch,danger)
  if path then return c.perch,path end
  self.blocked[c.perch.id]=now+self.profile.behavior.block_retry_s
 end
 return nil,nil
end
function Fly.launch(self: any,kind: string,now: number): boolean
 local target,path=self:choose(kind,now,if kind=='flee' then 1 else 0)
 if not path and kind=='flee' then target,path=self:choose(kind,now,1,true) end
 if not path and kind=='flee' then
  local away=if self.senses.hasLastSeen then self.position-self.senses.lastSeenPosition else self.heading
  local angle=math.atan2(away.X,away.Z)
  for i=0,7 do
   local a=angle+i*math.pi/4;local dest=self.position+Vector3.new(math.sin(a),.35,math.cos(a)).Unit*self.profile.flight.open_escape_wu
   if self.graph:clear(self.position,dest) then path={self.position,dest};break end
  end
 end
 if not path then return false end
 if kind=='move' and target and not self:airborne() and self.rng:next()<self.profile.behavior.wander_flight_chance then
  local lifted=self.position+self.normal*self.profile.flight.lift_wu
  for _=1,4 do
   local a=self.rng:next()*math.pi*2;local d=self.rng:draw({2.5,6})
   local w=lifted+Vector3.new(math.cos(a)*d,0,math.sin(a)*d)
   w=Vector3.new(w.X,math.clamp(lifted.Y+self.rng:draw({.5,3.5}),.8,10),w.Z)
   if self.graph:clear(self.position,lifted) and self.graph:clear(lifted,w) then
    local tail=self.graph:plan(w,Vector3.zero,target,nil)
    if tail then local loop={self.position,lifted};for _,point in tail do table.insert(loop,point) end
     if M.pathLength(loop)<=self.profile.flight.max_flight_wu*1.6 then path=loop;break end
    end
   end
  end
 end
 self.flight:begin(path,target,kind,now);self.goal=kind;self.goalSince=now;self.walkLeft=0
 table.insert(self.trace,{t=now,goal=kind,target=if target then target.id else 'open'});if #self.trace>80 then table.remove(self.trace,1) end
 return true
end
function Fly.schedule(self: any,now: number,startle: boolean)
 local p=self.profile.reaction
 local pair=p.delay_deliberate_s
 if startle then pair=if self.state=='ALERT' then p.delay_startle_alert_s elseif now<self.groomUntil then p.delay_startle_grooming_s else p.delay_startle_relaxed_s end
 self.pending=now+self.rng:draw(pair);self.goal='flee'
end
function Fly.think(self: any,now: number)
 local p=self.profile;local s=self.senses;local ev=s.evidence
 if ev.t==now and ev.startle and not self.pending and (self.state=='PERCHED' or self.state=='ALERT' or self.state=='SEEK_PERCH' or self.state=='REPOSITION') then self:schedule(now,true) end
 if self.state=='PERCHED' and ((s.awareness>=p.senses.awareness_alert and self:relevance(now)>=.5) or self.pending) then self.state='ALERT';self.stateSince=now;self.walkLeft=0 end
 if self.pending and now>=self.pending then self.pending=nil;self:launch('flee',now) end
 if now<self.nextDecision then return end
 self.nextDecision=now+1/p.behavior.decision_hz
 local threat=M.threat(s.awareness,p.senses.awareness_calm,p.senses.awareness_flee)*self:relevance(now)
 if self:airborne() then
  if self.state=='SEEK_PERCH' and not self.flight.target then self:launch('move',now) end
  if (self.state=='REPOSITION' or self.state=='SEEK_PERCH') and not self.pending and threat>=p.behavior.interrupt_threat and ev.seen and now-ev.t<=.3 and ev.gain>0 and ev.distance<=p.flight.safe_distance_wu then self:schedule(now,false) end
  return
 end
 local scores={rest=M.scoreRest(p.utility,self.fatigue,self.perch.shelter,self.perch.food,threat)}
 local move=if self.state=='PERCHED' then self:ranked('move',now,threat) else {}
 local flee=if threat>.02 then self:ranked('flee',now,threat) else {}
 if move[1] then scores.move=move[1].score end;if flee[1] then scores.flee=flee[1].score end
 local chosen=M.pickGoal(scores,self.goal,p.behavior.hysteresis)
 if chosen~=self.goal and threat<p.behavior.interrupt_threat and now-self.goalSince<p.behavior.min_commit_s then chosen=self.goal end
 if chosen=='flee' and not self.pending then self:schedule(now,false)
 elseif chosen=='move' and not self.pending and self.state=='PERCHED' then self:launch('move',now)
 elseif chosen=='rest' and not self.pending then
  if self.goal~='rest' then self.goal='rest';self.goalSince=now end
  if self.state=='ALERT' and (s.awareness<p.senses.awareness_calm or self:relevance(now)<.25) and now-self.stateSince>=p.behavior.alert_min_s then self.state='PERCHED';self.stateSince=now end
 end
end
function Fly.rest(self: any,now: number,dt: number)
 local p=self.profile.behavior
 if self.state=='ALERT' then
  self.groomUntil=0;self.fidgetUntil=0;self.glanceTarget=nil
  if self.senses.hasLastSeen then local d=self.senses.lastSeenPosition-self.position;local flat=d-self.normal*d:Dot(self.normal);if flat.Magnitude>.001 then self:turn(flat.Unit,dt) end end
  return
 end
 if now<self.fidgetUntil then
  local t=math.clamp((now-self.fidgetStarted)/(self.fidgetUntil-self.fidgetStarted),0,1)
  self.position=self.fidgetFrom:Lerp(self.fidgetTo,t*t*(3-2*t));return
 end
 if self.glanceTarget then if self:turn(self.glanceTarget,dt) then self.glanceTarget=nil end;return end
 if now>=self.nextGroom then self.groomUntil=now+self.rng:draw(p.groom_duration_s);self.nextGroom=self.groomUntil+self.rng:draw(p.groom_interval_s) end
 if now<self.groomUntil then return end
 if now>=self.nextGlance and self.walkLeft<=0 then
  self.glanceTarget=CFrame.fromAxisAngle(self.normal,math.rad(self.rng:draw(p.glance_angle_deg))*self.glanceSign):VectorToWorldSpace(self.homeHeading)
  self.glanceSign=-self.glanceSign;self.nextGlance=now+self.rng:draw(p.glance_interval_s);return
 end
 if now>=self.nextWalk and self.walkLeft<=0 then
  local home=self.graph:rest(self.perch)-self.position
  local direction=if home.Magnitude>p.wander_radius_wu*.5 then home.Unit else self.heading
  local angle=if home.Magnitude>p.wander_radius_wu*.5 then 40 else 100
  self.walkDirection=CFrame.fromAxisAngle(self.normal,math.rad(self.rng:draw({-angle,angle}))):VectorToWorldSpace(direction)
  local wanted=self.rng:draw(p.walk_distance_wu);self.walkLeft=0
  for distance=.15,wanted,.15 do
   local nextPos=self.position+self.walkDirection*distance
   if not self:surface(nextPos) or (nextPos-self.graph:rest(self.perch)).Magnitude>p.wander_radius_wu or not self.graph:clear(self.position,nextPos) then break end
   self.walkLeft=distance
  end
  if self.walkLeft<.2 then self.walkLeft=0 end
  self.walkSpeed=self.rng:draw(p.walk_speed_wu_s)
  self.burstUntil=now+self.rng:draw(p.walk_burst_s);self.pauseUntil=0;self.nextWalk=now+self.rng:draw(p.walk_interval_s)
 end
 if self.walkLeft>0 then
  if math.deg(math.acos(math.clamp(self.heading:Dot(self.walkDirection),-1,1)))>20 then self:turn(self.walkDirection,dt);return end
  if now<self.pauseUntil then return end
  if now>=self.burstUntil then self.pauseUntil=now+self.rng:draw(p.walk_pause_s);self.burstUntil=self.pauseUntil+self.rng:draw(p.walk_burst_s);return end
  local step=math.min(self.walkLeft,self.walkSpeed*dt);local nextPos=self.position+self.walkDirection*step
  local hit=self.graph.cast(nextPos+self.normal*.3,nextPos-self.normal*.3)
  if hit and hit.Normal:Dot(self.normal)>.98 and math.abs((hit.Position+self.normal*self.profile.body.hover_wu-nextPos):Dot(self.normal))<=.06
   and (nextPos-self.graph:rest(self.perch)).Magnitude<=p.wander_radius_wu and self.graph:clear(self.position,nextPos) then
   self.position=nextPos;self.walkLeft-=step;self.heading=self.heading:Lerp(self.walkDirection,.3).Unit
   if self.walkLeft<=.001 then self.restSpot=self.position;self.homeHeading=self.heading end
  else self.walkLeft=0 end
 elseif now>=self.nextFidget then
  local dir=CFrame.fromAxisAngle(self.normal,self.rng:next()*math.pi*2):VectorToWorldSpace(self.heading)
  local distance=self.rng:draw(p.fidget_distance_wu);local duration=self.rng:draw(p.fidget_duration_s)
  if (self.position+dir*distance-self.restSpot).Magnitude>p.perch_radius_wu and (self.restSpot-self.position).Magnitude>.001 then dir=(self.restSpot-self.position).Unit end
  local target=self.position+dir*distance
  self.nextFidget=now+duration+self.rng:draw(p.fidget_interval_s)
  if self:surface(target) and self.graph:clear(self.position,target) then
   self.fidgetFrom=self.position;self.fidgetTo=target;self.fidgetStarted=now;self.fidgetUntil=now+duration
  end
 end
end
function Fly.step(self: any,dt: number,now: number,stimulus: Vector3,radius: number,cast: any)
 self.prevPosition=self.position
 if not self:alive() or not self.enabled then return end
 local p=self.profile
 if self.senses:shouldCheck(now) then
  local vigilant=if self.state=='ALERT' then p.senses.vigilance_alert elseif now<self.groomUntil then p.senses.vigilance_grooming else p.senses.vigilance_relaxed
  self.senses:update(cast,self.position+self.normal*.1,if self:airborne() and self.velocity.Magnitude>.1 then self.velocity.Unit else self.heading,if self:airborne() then Vector3.yAxis else self.normal,stimulus,radius,now,vigilant,if self.state=='ALERT' then p.senses.decay_alert_per_s else p.senses.decay_relaxed_per_s)
 end
 self:think(now)
 if self:airborne() then self.flight:step(now,dt);self.fatigue=math.min(1,self.fatigue+p.behavior.fatigue_up_per_s*dt)
 else self:rest(now,dt);self.fatigue=math.max(0,self.fatigue-p.behavior.fatigue_down_per_s*dt) end
 self.velocity=(self.position-self.prevPosition)/dt
end
return Fly
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">FlyFlight</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen FlyFlight: accelerate, sweep every step, brake for landing, reserve the destination.
local M=require(script.Parent.PreyMath)
local F={};F.__index=F
function F.new(fly: any,graph: any): any
 return setmetatable({fly=fly,graph=graph,path={},length=0,s=0,speed=0,target=nil,mode='',started=0,replans=0,blocked=0,landings=0,sweeps=0},F)
end
function F.release(self: any)
 if self.target and self.target.reserved==self.fly.id then self.target.reserved='' end
 self.target=nil
end
function F.begin(self: any,path: {Vector3},target: any,mode: string,now: number)
 local f=self.fly;local air=f.state~='PERCHED' and f.state~='ALERT'
 self:release();self.path=path;self.length=M.pathLength(path);self.s=0;self.speed=if air then f.velocity.Magnitude else 0
 self.mode=mode;self.target=target;self.started=now;self.replans=0
 if target then target.reserved=f.id end
 if f.perch and f.perch.occupant==f.id then f.perch.occupant='' end
 f.state=if mode=='flee' then (if air then 'FLEE' else 'TAKEOFF') else 'REPOSITION'
 f.stateSince=now
end
function F.step(self: any,now: number,dt: number): boolean
 local f=self.fly;local p=f.profile.flight
 if self.length<=1e-6 or #self.path<2 then self.speed=0;f.velocity=Vector3.zero;return false end
 local fast=f.state=='TAKEOFF' or f.state=='FLEE'
 local top=if fast then p.flee_speed_wu_s else p.cruise_speed_wu_s
 local targetSpeed=if self.target then M.targetSpeed(self.length-self.s,top,p.landing_speed_wu_s,p.landing_slow_wu) else top
 self.speed=M.stepSpeed(self.speed,targetSpeed,if fast then p.takeoff_accel_wu_s2 else p.cruise_accel_wu_s2,dt)
 local sn=math.min(self.length,self.s+self.speed*dt);local nextPos=M.pointAt(self.path,sn)
 self.sweeps+=1
 if not self.graph:clear(f.position,nextPos) then
  self.blocked+=1;f.velocity=Vector3.zero
  if self.target and self.replans<3 then
   self.replans+=1
   local path=self.graph:plan(f.position,Vector3.zero,self.target,if self.mode=='flee' and f.senses.hasLastSeen then f.senses.lastSeenPosition else nil)
   if path then self.path=path;self.length=M.pathLength(path);self.s=0;return false end
  end
  self:release();self.path={};self.length=0;f.state='SEEK_PERCH';return false
 end
 local delta=nextPos-f.position;f.velocity=delta/dt;f.position=nextPos;self.s=sn
 local flat=Vector3.new(delta.X,0,delta.Z)
 if flat.Magnitude>.004 then
  local desired=math.atan2(-flat.X,-flat.Z);local old=math.atan2(-f.heading.X,-f.heading.Z)
  local diff=math.atan2(math.sin(desired-old),math.cos(desired-old));local angle=old+math.clamp(diff,-math.rad(p.turn_rate_deg_s)*dt,math.rad(p.turn_rate_deg_s)*dt)
  f.heading=Vector3.new(-math.sin(angle),0,-math.cos(angle))
 end
 if f.state=='TAKEOFF' and now-f.stateSince>=p.takeoff_s then f.state='FLEE';f.stateSince=now
 elseif f.state=='FLEE' and self.target and self.length-self.s<=p.approach_wu+p.landing_slow_wu then f.state='SEEK_PERCH' end
 if self.s>=self.length-1e-4 then
  local target=self.target
  if target and (f.position-self.graph:rest(target)).Magnitude<=.06 then
   self:release();self.path={};self.length=0;self.speed=0;self.landings+=1
   f.perch=target;target.occupant=f.id;f.position=self.graph:rest(target);f.normal=target.normal;f.velocity=Vector3.zero
   f.state='PERCHED';f.stateSince=now;f.goal='rest';f.goalSince=now;f:beginStay(now);return true
  end
  self:release();self.path={};self.length=0;f.state='SEEK_PERCH'
 end
 return false
end
return F
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">FlySenses</string>
            <string name="Source"><![CDATA[--!strict
-- scripts/prey/fly_senses.gd, A-028. No controls, plans or velocity enter this interface.
local M=require(script.Parent.PreyMath)
local PM=require(script.Parent.Parent.Perception.PerceptionMath)
local S={};S.__index=S
function S.new(profile: any): any
 return setmetatable({p=profile,awareness=0,evidence={},hasLastSeen=false,lastSeenPosition=Vector3.zero,lastSeenTime=-1e9,
  started=false,hasLast=false,lastPoint=Vector3.zero,lastTime=-1e9,lastMask=0,lastCheck=-1e9,nextCheck=0,checks=0,rays=0},S)
end
function S.shouldCheck(self: any,now: number): boolean return now+1e-9>=self.nextCheck end
function S.finish(self: any,ev: any,now: number,dt: number,gain: number,decay: number,seen: boolean): any
 if not seen then self.hasLast=false end
 self.started=true
 self.awareness=M.integrateAwareness(self.awareness,gain,dt,decay*(if seen then 1 else self.p.unseen_decay_mult),self.p.awareness_max)
 ev.awareness=self.awareness;ev.seen=seen;self.evidence=ev
 self.nextCheck=if seen and ev.distance<=self.p.near_check_range_wu then now else now+1/math.max(self.p.far_check_hz,.1)
 return ev
end
function S.update(self: any,cast: (Vector3,Vector3)->Vector3?,eye: Vector3,facing: Vector3,up: Vector3,pos: Vector3,radius: number,now: number,vigilance: number,decay: number): any
 local p=self.p;local dt=if self.started then math.clamp(now-self.lastCheck,0,.25) else 0
 self.lastCheck=now;self.checks+=1
 local offset=pos-eye;local dist=offset.Magnitude
 local ev={t=now,dt=dt,seen=false,distance=dist,reason='',startle=false,appeared=false,bearing=0,loom=0,motion=0,gain=0,visible=0}
 if dist>p.sight_range_wu or dist<.05 then ev.reason='out of range';return self:finish(ev,now,dt,0,decay,false) end
 local dir=offset/dist
 local off=if facing.Magnitude>1e-9 then math.deg(math.acos(math.clamp(facing.Unit:Dot(dir),-1,1))) else 0
 local face=M.facingWeight(off,p.front_half_deg,p.rear_half_deg,p.rear_gain)
 local distance=M.distanceWeight(dist,p.full_sensitivity_wu,p.sight_range_wu)
 local side=dir:Cross(up);if side.Magnitude<.001 then side=dir:Cross(Vector3.xAxis) end
 side=if side.Magnitude>0 then side.Unit else Vector3.zero
 local centre=Vector3.zero;local count,mask=0,0
 for i,point in {pos,pos+side*radius*.8,pos-side*radius*.8} do
  self.rays+=1;local hit=cast(eye,point);local length=(point-eye).Magnitude
  if hit==nil or (hit-eye).Magnitude>=length-PM.sightTolerance(radius,length) then
   centre+=point;count+=1;mask+=2^(i-1)
  end
 end
 if count==0 then ev.reason='no line of sight';return self:finish(ev,now,dt,0,decay,false) end
 centre/=count;offset=centre-eye;local vd=offset.Magnitude;local angle=M.apparentAngle(radius,vd)
 ev.visible=count/3;ev.distance=vd
 if self.started then
  if self.hasLast and now-self.lastTime<=p.sample_gap_max_s+1e-9 then
   if mask==self.lastMask then
    local gap=math.max(now-self.lastTime,1e-9);local old=self.lastPoint-eye
    ev.bearing=M.bearingRate(old,offset,gap);ev.loom=M.loomRate(M.apparentAngle(radius,old.Magnitude),angle,gap,p.loom_scale_deg_s)
   end
  elseif vd<=p.appear_range_wu then ev.appeared=true;ev.bearing=p.appear_motion_deg_s end
 end
 ev.motion=math.max(ev.bearing,ev.loom)
 ev.gain=M.awarenessGain(ev.motion,p.motion_threshold_deg_s,p.motion_scale_deg_s,distance,face,ev.visible,vigilance)
 ev.startle=ev.motion*math.max(face,p.startle_rear_gain)*ev.visible>=p.startle_motion_deg_s and vd<=p.startle_range_wu
 self.hasLast=true;self.lastPoint=centre;self.lastTime=now;self.lastMask=mask
 self.hasLastSeen=true;self.lastSeenPosition=centre;self.lastSeenTime=now
 return self:finish(ev,now,dt,ev.gain,decay,true)
end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">PerchGraph</string>
            <string name="Source"><![CDATA[--!strict
-- Geometry adapter for the frozen PerchGraph. Every planned leg and every flight tick is swept.
local M=require(script.Parent.PreyMath)
local G={};G.__index=G
export type Perch={id:string,position:Vector3,normal:Vector3,shelter:number,food:number,start:boolean,valid:boolean,occupant:string,reserved:string}
function G.new(cast: any,sweep: any,overlap: any,profile: any): any
 return setmetatable({cast=cast,sweep=sweep,overlap=overlap,p=profile,perches={},plans=0,sweeps=0},G)
end
function G.rest(self: any,p: Perch): Vector3 return p.position+p.normal*self.p.body.hover_wu end
function G.clear(self: any,a: Vector3,b: Vector3): boolean
 self.sweeps+=1
 return not self.overlap(a,self.p.flight.clearance_radius_wu) and not self.sweep(a,b,self.p.flight.clearance_radius_wu)
end
function G.add(self: any,id: string,position: Vector3,normal: Vector3,shelter: number,food: number,start: boolean): Perch
 local p: Perch={id=id,position=position,normal=normal,shelter=shelter,food=food,start=start,valid=false,occupant='',reserved=''}
 local hit=self.cast(position+normal*.5,position-normal*.5)
 if hit and math.abs((hit.Position-position):Dot(normal))<=.06 and hit.Normal:Dot(normal)>=math.cos(math.rad(12)) then
  p.position=hit.Position;p.valid=self:clear(self:rest(p),self:rest(p)+normal*self.p.flight.lift_wu)
 end
 table.insert(self.perches,p);return p
end
function G.plan(self: any,start: Vector3,normal: Vector3,target: Perch,threat: Vector3?): {Vector3}?
 self.plans+=1;local p=self.p.flight
 local rest=self:rest(target);if (start-rest).Magnitude>p.max_flight_wu then return nil end
 local lifted=start+normal*p.lift_wu;local approach=rest+target.normal*p.approach_wu
 if not self:clear(start,lifted) or not self:clear(approach,rest) then return nil end
 local routes: {{Vector3}}={{lifted,approach}};local mid=(lifted+approach)*.5
 for _,h in {2.5,5,8,11} do local y=math.min(mid.Y+h,11)
  if y>mid.Y+.5 then table.insert(routes,{lifted,Vector3.new(mid.X,y,mid.Z),approach}) end
 end
 for _,h in {6,9,11} do local y=math.min(math.max(h,math.max(lifted.Y,approach.Y)+.5),11)
  if y>math.max(lifted.Y,approach.Y)+.3 then table.insert(routes,{lifted,Vector3.new(lifted.X,y,lifted.Z),Vector3.new(approach.X,y,approach.Z),approach}) end
 end
 for _,route in routes do
  local clear=true
  for i=2,#route do if not self:clear(route[i-1],route[i]) then clear=false;break end end
  if clear then
   local pts={start};for _,v in route do table.insert(pts,v) end;table.insert(pts,rest)
   if (not threat or M.distanceToPath(pts,threat)>=p.path_threat_clearance_wu) and M.pathLength(pts)<=p.max_flight_wu*1.6 then return pts end
  end
 end
 return nil
end
return G
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">PreyDirector</string>
            <string name="Source"><![CDATA[--!strict
-- Solo client world of perceivable flies. Godot order: sensor, prey, motor, capture/feeding.
local Fly=require(script.Parent.Fly)
local Graph=require(script.Parent.PerchGraph)
local Population=require(script.Parent.PreyPopulation)
local Feeding=require(script.Parent.Feeding)
local M=require(script.Parent.PreyMath)
local D={};D.__index=D
local POINTS: {{string | number}}={
 {'sill_first_hunt',-13,0,6},{'rim_hunt',10,4.6,-3},{'leaf_hunt',-1,4.2,-1},{'east_hunt',23,0,7},
 {'west_leaf',-15,4.2,-1},{'east_leaf',22,5.4,-2},{'under_leaf',-12.8,0,-2},{'front_path',1,0,8},
 {'east_corner',27,0,-7},{'back_path',-9,0,-9},{'rim_west',5,4.6,-5},{'rim_east',15,4.6,-5},
}
function D.new(graph: any,profile: any,seed: number,target: number): any
 local self:any=setmetatable({graph=graph,p=profile,seed=seed,target=target,flies={},serial=0,now=0,tick=0,
  population=Population.new(profile.population,seed+117,target),feeding=Feeding.new(),vents={},strikeEnd=-1,previousMode='attached',
  captures=0,enabled=true,cpu={},candidates=0,entryChecks=0},D)
 for i,row in POINTS do
  local id=row[1]::string
  graph:add(id,Vector3.new(row[2]::number,row[3]::number,row[4]::number),Vector3.yAxis,if id=='under_leaf' then .5 else .2,if string.find(id,'rim') then .5 else .1,i<=6)
 end
 -- Keep only perches with a valid outgoing flight.
 for _,p in graph.perches do
  if p.valid then
   local linked=false;local tries=0
   for _,other in graph.perches do if other~=p and other.valid and (other.position-p.position).Magnitude<=profile.flight.max_flight_wu then
    tries+=1;if graph:plan(graph:rest(p),p.normal,other,nil) then linked=true;break end
    if tries>=5 then break end
   end end
   p.valid=linked
  end
 end
 for _,p in graph.perches do if #self.flies<target and p.start and p.valid then self:spawn(p) end end
 for i,x in {-23,23} do
  -- Authored window vents face into the sill. Entry paths are still swept before a fly exists.
  table.insert(self.vents,{id='vent_'..i,position=Vector3.new(x,8,-12.5),normal=Vector3.zAxis,shelter=0,food=0,start=false,valid=true,occupant='',reserved=''})
 end
 return self
end
function D.spawn(self: any,perch: any): any
 self.serial+=1
 local f=Fly.new('fly_'..self.serial,self.serial,self.seed+self.serial*997,perch,self.graph,self.p,self.now)
 table.insert(self.flies,f);return f
end
function D.percepts(self: any): {any}
 local out={};for _,f in self.flies do local p=f:percept();if p then table.insert(out,p) end end;return out
end
function D.before(self: any,dt: number,position: Vector3,observer: any,sensor: any,cast: any,camera: any)
 if not self.enabled then return end
 local started=os.clock();self.now+=dt;self.tick+=1;self.previousPosition=position
 local alive=0;for _,f in self.flies do if f:alive() then alive+=1 end end
 self.population:step(self.now,alive,self.vents,function(v)
  self.entryChecks+=1
  local pos=self.graph:rest(v)
  if (position-pos).Magnitude<self.p.population.vent_min_distance_wu then return false end
  if M.inView(camera.CFrame,camera.FieldOfView,camera.ViewportSize.X/math.max(1,camera.ViewportSize.Y),pos,self.p.population.vent_view_margin_deg) then return false end
  return not sensor:couldSense(observer,pos,self.p.body.radius_wu,cast)
 end,function(v)
  for _,target in self.graph.perches do
   if target.valid and target.occupant=='' and target.reserved=='' then
    local path=self.graph:plan(self.graph:rest(v),v.normal,target,nil)
    if path and M.pathLength(path)>=self.p.population.entry_min_flight_wu then
     local f=self:spawn(v);f.flight:begin(path,target,'move',self.now);return true
    end
   end
  end
  return false
 end)
 for _,f in self.flies do f:step(dt,self.now,position,.3,cast) end
 self.beforeCost=(os.clock()-started)*1e6
end
function D.escape(self: any,f: any)
 f.state='SEEK_PERCH';f.stateSince=self.now;f.senses.awareness=self.p.senses.awareness_max
 f.senses.hasLastSeen=true;f.senses.lastSeenPosition=self.previousPosition;f.senses.lastSeenTime=self.now
 f:launch('flee',self.now)
end
function D.after(self: any,dt: number,motor: any,sensor: any,cast: any)
 if not self.enabled then return end
 local started=os.clock()
 if motor.mode=='air' and self.previousMode~='air' then
  for _,event in motor.events do if event.kind=='launched' then self.strikeEnd=self.tick+240;break end end
 end
 if self.previousMode=='air' and motor.mode~='air' then self.strikeEnd=math.min(self.strikeEnd,self.tick+3) end
 self.previousMode=motor.mode
 if self.tick<=self.strikeEnd and not self.feeding.held then
  for _,f in self.flies do if f:alive() then
   local t,d=M.sweepClosest(self.previousPosition,motor.pos,f.prevPosition,f.position)
   if d<=self.p.body.capture_radius_wu+.3 then
    local a=self.previousPosition:Lerp(motor.pos,t);local b=f.prevPosition:Lerp(f.position,t)
    if not cast(a,b) then
     f.flight:release();if f.perch and f.perch.occupant==f.id then f.perch.occupant='' end
     f.state='CAPTURED';f.captureSerial+=1;f.captureKey=f.id..':'..f.captureSerial;f.velocity=Vector3.zero
     sensor:onCapture(b,self.p.body.radius_wu);self.feeding:capture(f);self.captures+=1;break
    end
   end
  end end
 end
 self.feeding:step(dt,motor.mode=='attached' and not motor.preparing,motor.moving or motor.vel.Magnitude>.15,function(f) self:escape(f) end)
 local held=self.feeding.held
 if held then
  held.position=motor:eyePosition()+motor.heading*(if self.feeding.struggling then .42 else .2)+motor.up*(if self.feeding.struggling then .04 else -.13)
  held.normal=motor.up;held.heading=motor.heading;held.prevPosition=held.position
 end
 for i=#self.flies,1,-1 do if self.flies[i].state=='CONSUMED' then table.remove(self.flies,i) end end
 table.insert(self.cpu,(self.beforeCost or 0)+(os.clock()-started)*1e6);if #self.cpu>1200 then table.remove(self.cpu,1) end
end
function D.engine(world: Instance,profile: any,seed: number,target: number): any
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={world}
 local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Include;overlap.FilterDescendantsInstances={world}
 local probe=Instance.new('Part');probe.Name='FlyClearanceProbe';probe.Shape=Enum.PartType.Ball;probe.Anchored=true;probe.CanCollide=false;probe.CanQuery=false;probe.CanTouch=false;probe.Transparency=1;probe.Parent=workspace
 local graph=Graph.new(function(a: Vector3,b: Vector3) return workspace:Raycast(a,b-a,params) end,
  function(a: Vector3,b: Vector3,r: number) if (b-a).Magnitude<1e-7 then return false end;return workspace:Spherecast(a,r,b-a,params)~=nil end,
  function(a: Vector3,r: number) probe.Size=Vector3.one*r*2;probe.Position=a;return #workspace:GetPartsInPart(probe,overlap)>0 end,profile)
 local self=D.new(graph,profile,seed,target);self.probe=probe;return self
end
return D
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">PreyMath</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen scripts/prey/prey_math.gd: explicit evidence, utility and swept-contact math.
local M = {}
local EPS = 1e-6
function M.sweepClosest(a0: Vector3,a1: Vector3,b0: Vector3,b1: Vector3): (number,number)
 local d=a0-b0; local dv=a1-b1-d
 local t=if dv:Dot(dv)>EPS*EPS then math.clamp(-d:Dot(dv)/dv:Dot(dv),0,1) else 0
 return t,(d+dv*t).Magnitude
end
function M.apparentAngle(radius: number,distance: number): number return 2*math.atan(math.max(radius,0)/math.max(distance,EPS)) end
function M.bearingRate(a: Vector3,b: Vector3,dt: number): number
 if dt<=EPS or a:Dot(a)<EPS or b:Dot(b)<EPS then return 0 end
 return math.deg(math.acos(math.clamp(a.Unit:Dot(b.Unit),-1,1)))/dt
end
function M.loomRate(old: number,angle: number,dt: number,scale: number): number
 return if dt<=EPS or angle<=EPS then 0 else scale*math.max(0,((angle-old)/dt)/angle)
end
function M.distanceWeight(d: number,full: number,zero: number): number
 if zero<=full then return if d<=full then 1 else 0 end
 return math.clamp((zero-d)/(zero-full),0,1)
end
function M.facingWeight(angle: number,front: number,rear: number,gain: number): number
 if angle<=front then return 1 end
 if angle>=rear or rear<=front then return gain end
 local t=(angle-front)/(rear-front); return 1+(gain-1)*t*t*(3-2*t)
end
function M.awarenessGain(motion: number,threshold: number,scale: number,distance: number,facing: number,visible: number,vigilance: number): number
 return if motion<=threshold or scale<=EPS then 0 else (motion-threshold)/scale*distance*facing*math.clamp(visible,0,1)*math.max(vigilance,0)
end
function M.integrateAwareness(a: number,gain: number,dt: number,decay: number,maximum: number): number
 return math.clamp(a+(if gain>0 then gain else -decay)*math.max(dt,0),0,maximum)
end
function M.threat(a: number,calm: number,flee: number): number
 if flee<=calm then return if a>=flee then 1 else 0 end
 return math.clamp((a-calm)/(flee-calm),0,1)
end
function M.scoreRest(w: any,fatigue: number,shelter: number,food: number,threat: number): number
 return w.rest_base+w.rest_fatigue*fatigue+w.rest_shelter*shelter+w.rest_food*food-w.rest_threat*threat
end
function M.scoreMove(w: any,restless: number,food: number,shelter: number,travel: number,fatigue: number,threat: number): number
 return w.move_restless*restless+w.move_food*food+w.move_shelter*shelter-w.move_travel*travel-w.move_fatigue*fatigue-w.move_threat*threat
end
function M.scoreFlee(w: any,threat: number,shelter: number,away: number,travel: number): number
 return threat*(w.flee_threat+w.flee_shelter*shelter+w.flee_away*away-w.flee_travel*travel)
end
function M.pickGoal(scores: {[string]:number},current: string,hysteresis: number): string
 local best,value=current,-math.huge
 for _,g in {'rest','move','flee'} do
  if scores[g] then local v=scores[g]+(if g==current then hysteresis else 0); if v>value+1e-9 then best,value=g,v end end
 end
 return best
end
function M.pathLength(points: {Vector3}): number
 local total=0; for i=2,#points do total+=(points[i]-points[i-1]).Magnitude end; return total
end
function M.pointAt(points: {Vector3},s: number): Vector3
 if #points==0 then return Vector3.zero end
 if s<=0 or #points==1 then return points[1] end
 for i=2,#points do local n=(points[i]-points[i-1]).Magnitude
  if s<=n then return if n<EPS then points[i-1] else points[i-1]:Lerp(points[i],s/n) end; s-=n
 end
 return points[#points]
end
function M.distanceToPath(points: {Vector3},p: Vector3): number
 if #points==0 then return math.huge end
 local best=(points[1]-p).Magnitude
 for i=2,#points do local a=points[i-1];local ab=points[i]-a
  local t=if ab:Dot(ab)<EPS*EPS then 0 else math.clamp((p-a):Dot(ab)/ab:Dot(ab),0,1)
  best=math.min(best,(a+ab*t-p).Magnitude)
 end
 return best
end
function M.targetSpeed(remaining: number,top: number,landing: number,slow: number): number
 return if slow<=EPS or remaining>=slow then top else landing+(top-landing)*math.clamp(remaining/slow,0,1)
end
function M.stepSpeed(speed: number,target: number,accel: number,dt: number): number
 return if speed>=target then target else math.min(speed+accel*dt,target)
end
function M.inView(cf: CFrame,fov: number,aspect: number,p: Vector3,margin: number): boolean
 local v=cf:PointToObjectSpace(p);if v.Z>=-EPS then return false end
 return math.atan2(math.abs(v.X),-v.Z)<=math.atan(math.tan(math.rad(fov)*.5)*math.max(aspect,.1))+math.rad(margin)
  and math.atan2(math.abs(v.Y),-v.Z)<=math.rad(fov)*.5+math.rad(margin)
end
return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">PreyPopulation</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen prey_population.gd: delayed, twice-unseen vent entries; never teleport a replacement onto a perch.
local R=require(script.Parent.PreyRandom)
local P={};P.__index=P
function P.new(profile: any,seed: number,target: number): any
 return setmetatable({p=profile,rng=R.new(seed),target=target,owed={},eligible={},rest={},nextCheck=0,entries=0,deferred=0},P)
end
function P.step(self: any,now: number,living: number,vents: {any},safe: (any)->boolean,enter: (any)->boolean)
 local missing=math.max(0,self.target-living)
 while #self.owed>missing do table.remove(self.owed) end
 while #self.owed<missing do table.insert(self.owed,now+self.rng:draw(self.p.replenish_delay_s)) end
 table.sort(self.owed)
 if #self.owed==0 or now<self.owed[1] or now<self.nextCheck then return end
 self.nextCheck=now+self.p.replenish_retry_s
 for _,vent in vents do
  if now>=(self.rest[vent.id] or 0) and safe(vent) then
   local old=self.eligible[vent.id]
   self.eligible[vent.id]=now
   if old and now-old<=self.p.replenish_retry_s*1.6+1e-6 and enter(vent) then
    table.remove(self.owed,1);self.rest[vent.id]=now+6;self.eligible[vent.id]=nil;self.entries+=1;return
   end
  else self.eligible[vent.id]=nil end
 end
 self.deferred+=1
end
return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">PreyRandom</string>
            <string name="Source"><![CDATA[--!strict
-- A repeatable port stream (Park-Miller); Godot's random inputs are exported for parity fixtures.
local R={};R.__index=R
function R.new(seed: number): any return setmetatable({state=math.max(1,math.floor(seed)%2147483647)},R) end
function R.next(self: any): number self.state=(self.state*16807)%2147483647;return self.state/2147483647 end
function R.draw(self: any,pair: {number}): number return pair[1]+(pair[2]-pair[1])*self:next() end
return R
]]></string>
          </Properties>
        </Item>
