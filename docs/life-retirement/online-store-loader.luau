oWorldSpace(upAt:Lerp(sweptAt, antPose.wave) * g)\n\t\t\tfoot = foot:Lerp(raised, antPose.antennae)\n\t\t\tlocal raisedKnee = hip:Lerp(raised, 0.5) + bodyBase.RightVector * (leg.side * antCfg.kneeOut * g) + up * (antCfg.kneeUp * g)\n\t\t\tknee = knee:Lerp(raisedKnee, antPose.antennae)\n\t\tend\n\t\t-- The threat posture: legs I go up and out in front of the reared prosoma, trembling a little; the planted foot below is untouched.\n\t\tif threatening and tc ~= nil and leg.pair == tc.pair and threatPose.legs > 0 then\n\t\t\tlocal upAt = Vector3.new(leg.side * tc.up.x, tc.up.y + threatPose.tremor * tc.tremor, tc.up.z)\n\t\t\tlocal reach, hook = threatPose.reach or 0, threatPose.hook or 0\n\t\t\tif reach > 0 and tc.wide then upAt = upAt:Lerp(Vector3.new(leg.side * tc.wide.x, tc.wide.y + threatPose.tremor * tc.tremor, tc.wide.z), reach) end -- (ROBLOX-127: high and spread)\n\t\t\tif hook > 0 and tc.hook then upAt = upAt:Lerp(Vector3.new(leg.side * tc.hook.x, tc.hook.y, tc.hook.z), hook) end -- (forward and down, grappling)\n\t\t\tlocal raised = prosoma:PointToWorldSpace(upAt * g)\n\t\t\tfoot = foot:Lerp(raised, threatPose.legs)\n\t\t\tlocal raisedKnee = hip:Lerp(raised, 0.5) + prosoma.RightVector * (leg.side * tc.kneeOut * g) + up * (tc.kneeUp * g)\n\t\t\tknee = knee:Lerp(raisedKnee, threatPose.legs)\n\t\tend\n\t\tlocal hangKnee, hangAnkle = leg.hangKnee, leg.hangAnkle\n\t\tif hangKnee ~= nil and hangAnkle ~= nil then knee = knee:Lerp(hangKnee, self._hang) end\n\t\tlocal ankle = knee:Lerp(foot, ANKLE_SHARE) + up * (L.ankleLift*g)\n\t\tif hangKnee ~= nil and hangAnkle ~= nil then ankle = ankle:Lerp(hangAnkle, self._hang) end\n\t\tlocal form = look.legForm\n\t\tlocal femurMid = if form and leg.femurTip then hip:Lerp(knee, form.femur.split) else knee\n\t\tlocal tibiaMid = if form and form.tibia and leg.tibiaTip then knee:Lerp(ankle, form.tibia.split) else ankle\n\t\tlocal tarsusMid = if form and leg.joint then ankle:Lerp(foot, form.tarsus.split) + up * (if leg.tarsusTip then form.tarsus.bend * g else 0) else foot\n\t\tdrawSegment(leg.segs[1], bandFraction, g, hip, femurMid, knee, bodyBatch, hairBatch, exact)\n\t\tdrawSegment(leg.segs[2], bandFraction, g, knee, tibiaMid, ankle, bodyBatch, hairBatch, exact)\n\t\tdrawSegment(leg.segs[3], bandFraction, g, ankle, tarsusMid, foot, bodyBatch, hairBatch, exact)\n\t\tif form then\n\t\t\t-- The knee is a patella: a short stout ellipsoid lying along the bend of the leg there.\n\t\t\tlocal bend = (knee - hip).Unit + (ankle - knee).Unit\n\t\t\tlocal along = if bend.Magnitude > 1e-3 then bend.Unit else (knee - hip).Unit\n\t\t\tput(bodyBatch, leg.knee, rodCFrame(knee - along, knee + along))\n\t\telse\n\t\t\tput(bodyBatch, leg.knee, CFrame.new(knee))\n\t\tend\n\t\tput(bodyBatch, leg.ankle, CFrame.new(ankle))\n\t\tif leg.joint then put(bodyBatch, leg.joint, CFrame.new(tarsusMid)) end\n\t\tlocal pad = leg.pad\n\t\tif pad and form then\n\t\t\t-- The tarsal pad lies on the surface under the foot, flattened, its long side along the way the foot points; the first spider's claws leave\n\t\t\t-- its front. All of it is display: the planted foot is where it was.\n\t\t\tlocal into = foot - (if leg.joint then tarsusMid else ankle)\n\t\t\tlocal flat = into - up * into:Dot(up)\n\t\t\tlocal heading = if flat.Magnitude > 1e-4 then flat.Unit else body.LookVector\n\t\t\tlocal center = foot + up * (pad.Size.Y * 0.35)\n\t\t\tput(bodyBatch, pad, CFrame.lookAt(center, center + heading, up) * QUARTER)\n\t\t\tlocal right = heading:Cross(up)\n\t\t\tfor n, claw in leg.toes do\n\t\t\t\t-- two claws: from the pad's front, forward and down, splayed apart\n\t\t\t\tlocal from = center + heading * (pad.Size.X * 0.42)\n\t\t\t\tlocal aim = (heading * 0.85 - up * 0.45 + right * ((if n % 2 == 1 then -1 else 1) * form.claws.splay)).Unit\n\t\t\t\tput(bodyBatch, claw, rodCFrame(from, from + aim * claw.Size.X))\n\t\t\tend\n\t\telseif pad then\n\t\t\tput(bodyBatch, pad, CFrame.new(foot))\n\t\tend\n\tend\n\tself.placed = bodyBatch.n + hairBatch.n -- (ROBLOX-113: the parts this drawing placed, for the self-test's profile)\n\tWorkspace:BulkMoveTo(bodyBatch.parts, bodyBatch.frames, Enum.BulkMoveMode.FireCFrameChanged)\n\tif hairBatch.n > 0 then\n\t\tWorkspace:BulkMoveTo(hairBatch.parts, hairBatch.frames, Enum.BulkMoveMode.FireCFrameChanged)\n\tend\nend\n\n-- Draws the rig for a frame (ROBLOX-93): an update when the rig has not been drawn yet or is within FAR_STUDS of the camera (`distance`, studs), otherwise once every\n-- FAR_SECONDS with all the time since the last drawing. The sim goes on stepping every tick; a rival or a mate too far off to show its legs need not be redrawn sixty\n-- times a second. (A caller that must have the full rate, a lunge or a windup, gives a distance of 0.) Returns whether it drew.\n-- (Six frames of 1/60 add up to a hair under 0.1, so the interval is met a millionth of a second early: ten drawings a second at 60 Hz, not eight and a half.)\nfunction SpiderRig.drawStep(self: Rig, collider: CFrame, dt: number, grounded: boolean, moving: boolean, distance: number): boolean\n\tlocal owed = self._owed + dt\n\tif self._drawn and distance > FAR_STUDS and owed < FAR_SECONDS - 1e-6 then\n\t\tself._owed = owed\n\t\treturn false\n\tend\n\tself._owed, self._drawn = 0, true\n\tself:update(collider, owed, grounded, moving)\n\treturn true\nend\n\n-- Spider-eye view (Godot SpiderBody.set_eye_view + SurfaceLegs.eye_view): the body, head and palps are hidden and only the\n-- front legs' lower segments stay, reaching into the view. Client-only (LocalTransparencyModifier).\nlocal function applyVisibility(self: Rig)\n\tlocal function show(p: BasePart, visible: boolean)\n\t\tp.LocalTransparencyModifier = if visible then 0 else 1\n\tend\n\tlocal hideBody = self._eyeView or self._bodyHidden\n\tif self._highlight then (self._highlight :: Highlight).Enabled = not hideBody end\n\tfor _, f in self._fixed do\n\t\tshow(f.part, not hideBody)\n\tend\n\tlocal fan = self._fan\n\tif fan then\n\t\tfor _, part in fan.parts do show(part, not hideBody) end\n\tend\n\tfor _, leg in self._legs do\n\t\tlocal frontReach = self._eyeView and leg.pair == 1\n\t\tlocal all = not hideBody\n\t\tshow(leg.femur, all); show(leg.knee, all)\n\t\tif leg.femurTip then show(leg.femurTip, all) end\n\t\tshow(leg.tibia, all or frontReach)\n\t\tif leg.tibiaTip then show(leg.tibiaTip, all or frontReach) end\n\t\tshow(leg.tarsus, all or frontReach); show(leg.ankle, all or frontReach)\n\t\tif leg.tarsusTip then show(leg.tarsusTip, all or frontReach) end\n\t\tif leg.joint then show(leg.joint, all or frontReach) end\n\t\tfor _, toe in leg.toes do show(toe, all or frontReach) end\n\t\tfor n, band in leg.bands do show(band, all or (frontReach and n >= 2)) end\n\t\tif leg.pad then show(leg.pad :: Part, all or frontReach) end\n\t\tfor _, hair in leg.hairs do\n\t\t\tshow(hair.part, all or (frontReach and hair.spec.segment >= 2))\n\t\tend\n\tend\nend\n\nfunction SpiderRig.setEyeView(self: Rig, on: boolean)\n\tself._eyeView = on\n\tapplyVisibility(self)\nend\n\n-- The orbit camera hides the spider when its boom is squeezed shorter than BODY_HIDE_LENGTH.\nfunction SpiderRig.setBodyHidden(self: Rig, hidden: boolean)\n\tself._bodyHidden = hidden\n\tapplyVisibility(self)\nend\n\n-- The drawn body's length in studs now, head to abdomen: 0.97 for the first spider at its first stage and 1.455 as an adult (0.455 and 0.68 for the peacock spider,\n-- 0.485 and 0.73 for the ant mimic), times the growth stage. Inspect mode (ROBLOX-90) measures its distances in these.\nSpiderRig.BODY_STUDS = 0.97\nfunction SpiderRig.bodyLength(self: Rig): number\n return SpiderRig.BODY_STUDS * self._k\nend\n\n\n-- Where the dragline leaves the body.\nfunction SpiderRig.spinneretPoint(self: Rig, body: CFrame): Vector3\n\treturn self._spinneret or body:PointToWorldSpace(self._layout.spinneret*self._growth - Vector3.new(0, self._drop, 0))\nend\n\nfunction SpiderRig.destroy(self: Rig)\n\tself.model:Destroy()\nend\n\nfunction SpiderRig.mouthFrame(self: any): CFrame\n return self._mouth or self.root.CFrame\nend\n\nreturn SpiderRig\n",88502,1232311415},{"Shared/Rig/TarantulaPose","--!strict\n-- The tarantulas' threat display and silk mat as a pose (ROBLOX-82): pure and Vector3-free, display only. Nothing here moves the body, the\n-- collider, the senses, the jump or the silk; SpiderRig reads the pose, rears the drawn prosoma, lifts legs I and the pedipalps, turns the drawn\n-- body and swings the spinnerets. All numbers are in Data/Tarantula (all artistic: no paper measures this).\n--\n-- A loop of phases (rear up, hold the threat posture, settle, turn about while the spinnerets sweep, hold, turn back) played from the time\n-- it is given: step(dt, standing, moving) adds the dt it is handed, so slow motion slows the pose as it slows everything else. Walking,\n-- a jump, leaving the surface or stop() end it at once; the pose then eases out over Tarantula.fadeOutSeconds from where it was, which is\n-- how the legs go back to the motor. The same shape as PeacockDance.\n\nlocal Tarantula = require(script.Parent.Parent.Data.Tarantula)\n\nlocal TarantulaPose = {}\nTarantulaPose.__index = TarantulaPose\n\n-- Angles in radians. rear and palps are positive for up (the prosoma's front, the palps' tips); yaw is the body's turn about its up axis;\n-- sweep is signed (the spinnerets' swing); legs and presence run 0..1; tremor is -1..1 (times the profile's size).\nexport type Pose = {\n\tphase: string, -- the phase of the loop, \"none\" when no pose shows\n\tpresence: number, -- 0..1: how much of the pose shows (ramps in and out)\n\trear: number,\n\tlegs: number, -- legs I raised into the threat posture\n\tpalps: number,\n\tyaw: number,\n\tsweep: number,\n\ttremor: number,\n}\n\nlocal TAU = math.pi * 2\n\nlocal function smooth(x: number): number\n\tlocal c = math.clamp(x, 0, 1)\n\treturn c * c * (3 - 2 * c)\nend\n\nTarantulaPose.NONE = { phase = \"none\", presence = 0, rear = 0, legs = 0, palps = 0, yaw = 0, sweep = 0, tremor = 0 } :: Pose\n\n-- Which phase a loop time falls in: its index, the seconds into it and the loop time it starts at.\nfunction TarantulaPose.phaseAt(t: number): (number, number, number)\n\tlocal phases = Tarantula.phases\n\tlocal u = t % Tarantula.loopSeconds\n\tlocal start = 0\n\tfor i, p in phases do\n\t\tif u < start + p.seconds then return i, u - start, start end\n\t\tstart += p.seconds\n\tend\n\treturn #phases, phases[#phases].seconds, start - phases[#phases].seconds\nend\n\n-- The seconds each phase starts at, in order (so the levels below read by phase).\nlocal function starts(): { [string]: number }\n\tlocal out: { [string]: number } = {}\n\tlocal at = 0\n\tfor _, p in Tarantula.phases do\n\t\tout[p.id] = at\n\t\tat += p.seconds\n\tend\n\treturn out\nend\nlocal START = starts()\nlocal function seconds(id: string): number\n\tfor _, p in Tarantula.phases do\n\t\tif p.id == id then return p.seconds end\n\tend\n\treturn 0\nend\n\n-- The levels (0..1) at a loop time: `rise` (the prosoma, legs I and the palps up), `turn` (the body's pivot) and `swing` (the spinnerets' stroke).\nlocal function levelsAt(u: number): (number, number, number)\n\tlocal rear, settle, turn, back = seconds(\"rear\"), seconds(\"settle\"), seconds(\"turn\"), seconds(\"return\")\n\tlocal rise = 0\n\tif u < START.threat then\n\t\trise = smooth(u / rear)\n\telseif u < START.settle then\n\t\trise = 1\n\telseif u < START.turn then\n\t\trise = 1 - smooth((u - START.settle) / settle)\n\tend\n\tlocal pivot = 0\n\tif u >= START.turn and u < START.mat then\n\t\tpivot = smooth((u - START.turn) / turn)\n\telseif u >= START.mat and u < START[\"return\"] then\n\t\tpivot = 1\n\telseif u >= START[\"return\"] then\n\t\tpivot = 1 - smooth((u - START[\"return\"]) / back)\n\tend\n\tlocal swing = 0\n\tif u >= START.turn then\n\t\tlocal ease = Tarantula.sweepEaseSeconds\n\t\tswing = math.min(smooth((u - START.turn) / ease), smooth((Tarantula.loopSeconds - u) / ease))\n\tend\n\treturn rise, pivot, swing\nend\n\n-- The whole pose at a loop time, before presence. reduced: ReducedMotion (every angle halved, no tremble).\nfunction TarantulaPose.rawPose(t: number, reduced: boolean): Pose\n\tlocal i, _, _ = TarantulaPose.phaseAt(t)\n\tlocal u = t % Tarantula.loopSeconds\n\tlocal rise, pivot, swing = levelsAt(u)\n\tlocal amp = if reduced then Tarantula.reducedMotion else 1\n\tlocal holding = u >= START.threat and u < START.settle\n\tlocal strokeT = u - START.turn\n\treturn {\n\t\tphase = Tarantula.phases[i].id, presence = 1,\n\t\trear = rise * math.rad(Tarantula.rearDeg) * amp,\n\t\tlegs = rise,\n\t\tpalps = rise * math.rad(Tarantula.palpDeg) * amp,\n\t\tyaw = pivot * math.rad(Tarantula.pivotDeg) * amp,\n\t\tsweep = swing * math.rad(Tarantula.sweepDeg) * amp * math.sin(TAU * Tarantula.sweepHz * strokeT),\n\t\ttremor = if reduced or not holding then 0 else math.sin(TAU * Tarantula.tremorHz * t) * smooth((u - START.threat) / 0.3) * smooth((START.settle - u) / 0.3),\n\t}\nend\n\nlocal function scaled(p: Pose, k: number): Pose\n\treturn {\n\t\tphase = p.phase, presence = k, rear = p.rear * k, legs = p.legs * k, palps = p.palps * k, yaw = p.yaw * k, sweep = p.sweep * k, tremor = p.tremor * k,\n\t}\nend\n\nexport type State = typeof(setmetatable(\n\t{} :: { t: number, active: boolean, presence: number, raw: Pose?, reduced: boolean },\n\tTarantulaPose\n))\n\nfunction TarantulaPose.new(): State\n\treturn setmetatable({ t = 0, active = false, presence = 0, raw = nil :: Pose?, reduced = false }, TarantulaPose)\nend\n\n-- The display key: begin the loop from its start. Refused (false) when the spider is not standing still on a surface, or it is already on.\nfunction TarantulaPose.start(self: State, standing: boolean, moving: boolean): boolean\n\tif self.active or not standing or moving then return false end\n\tself.t, self.active = 0, true\n\treturn true\nend\n\n-- End the pose at once; it eases out over Tarantula.fadeOutSeconds from where it was.\nfunction TarantulaPose.stop(self: State)\n\tself.active = false\nend\n\n-- The pose is on (it has not been ended).\nfunction TarantulaPose.displaying(self: State): boolean\n\treturn self.active\nend\n\n-- Showing at all (on, or still easing out).\nfunction TarantulaPose.showing(self: State): boolean\n\treturn self.active or self.presence > 0\nend\n\n-- One step of dt seconds (the simulation's, so slow motion slows the pose). standing: on a surface and not in a jump, on the line or resting;\n-- moving: walking (or asked to).\nfunction TarantulaPose.step(self: State, dt: number, standing: boolean, moving: boolean): Pose\n\tif self.active and (not standing or moving) then self.active = false end\n\tif self.active then\n\t\tself.t += dt\n\t\tself.presence = math.min(1, self.presence + dt / Tarantula.rampInSeconds)\n\t\tself.raw = TarantulaPose.rawPose(self.t, self.reduced)\n\telse\n\t\tself.presence = math.max(0, self.presence - dt / Tarantula.fadeOutSeconds)\n\t\tif self.presence == 0 then self.raw = nil end\n\tend\n\tlocal raw = self.raw\n\tif raw == nil then return TarantulaPose.NONE end\n\treturn scaled(raw, smooth(self.presence))\nend\n\nreturn TarantulaPose\n",6700,3193813046},{"Shared/UI/AntMimicText","--!strict\n-- The words of the ant-mimicking spider's display key for the screen (ROBLOX-64): the prompt, the status line, the touch button and the\n-- controls card's line. The walking hint, the status line and the card carry them only for that spider. Button names come from\n-- ControlText for the device in use, except on touch, where the button says \"Wave\" (ControlText's \"Dance\" is the peacock's). Pure:\n-- checked in tests/antmimic.luau.\nlocal ControlText = require(script.Parent.ControlText)\n\nlocal AntMimicText = {}\n\nAntMimicText.STAND = \"Stand still on a surface to wave your antennae\"\n\nlocal function key(device: ControlText.Device): string\n\treturn if device == \"touch\" then \"Wave\" else ControlText.name(device, \"display\")\nend\n\n-- The walking hint's extra words.\nfunction AntMimicText.displayHint(device: ControlText.Device, showing: boolean): string\n\tif showing then return `{key(device)}: antennae down` end\n\treturn `{key(device)}: wave antennae`\nend\n\n-- The status line while the display pose is on.\nfunction AntMimicText.statusLine(device: ControlText.Device): string\n\treturn `ANTENNAE UP    {key(device)} or move: stop`\nend\n\n-- The touch button's words.\nfunction AntMimicText.touchDisplay(showing: boolean): string return if showing then \"Stop\" else \"Wave\" end\n\n-- The controls card's line (legs I rise by themselves when the spider keeps still; the key makes them higher and faster).\nfunction AntMimicText.helpLine(device: ControlText.Device): string\n\treturn `{key(device)}{if device == \"touch\" then \" button:\" else \"\"} wave antennae higher (any move, jump or Cancel stops it)`\nend\n\nreturn AntMimicText\n",1617,335820227},{"Shared/UI/BirdText","--!strict\n-- The robin in words (ROBLOX-120; the robin is Predator/Bird): its death card, the notice when its bill misses (the gentle rules), and the captions of what tells of it\n-- first (the Captions setting, as the cat's bell is captioned): its call as it comes in and goes, and its shadow sweeping over the ground. Pure: tests/preserve.luau\n-- checks the words, tests/quiet.luau their classes.\nlocal BirdText = {}\n\nBirdText.LINE = \"The robin's bill came down.\"\nBirdText.SUB = \"It stood still with its head cocked, watching what moved in the open. Under cover, or keeping still, the spider would have lived.\"\nBirdText.MISSED = \"The robin stabbed at you and missed.\"\nBirdText.CAUSE = \"bird\" -- (the end of a life's cause, LifeSession)\nBirdText.SHADOW = \"[a shadow sweeps over the ground]\"\n\n-- The caption of what is heard or seen of it now, or nil: its call (`call` 0..1, Predator/Bird.call; `direction` UI/WaspText.directionWord's) or its shadow passing\n-- (`shadow`: the seconds since one passed near, nil if none lately).\nfunction BirdText.caption(call: number, direction: string, shadow: number?): { text: string, alpha: number }?\n\tif shadow ~= nil and shadow < 2.0 then return { text = BirdText.SHADOW, alpha = 1 } end\n\tif call > 0.05 then\n\t\treturn { text = `[a robin calls, {direction}: pick, tut-tut-tut]`, alpha = math.clamp(0.4 + call, 0, 1) }\n\tend\n\treturn nil\nend\n\nreturn table.freeze(BirdText)\n",1407,36690985},{"Shared/UI/CatText","--!strict\n-- The ranger's cat in words (ROBLOX-118; the cat is Predator/Cat): its death card, the notice when its pat only knocks the spider aside (the gentle rules), and the\n-- captions of what the spider hears of it (the Captions setting, as the wasp's hum is captioned): the bell on its collar while it moves, its purr close by. A\n-- jumping spider hears airborne sound (the notebook's cat page says how it is known), so the bell is the first anyone knows of it. Pure: tests/preserve.luau\n-- checks the words, tests/quiet.luau their classes.\nlocal CatText = {}\n\nCatText.LINE = \"The cat's paw came down.\"\nCatText.SUB = \"A cat pats at small things that move. Up out of its reach, in a gap, or keeping still, the spider would have lived.\"\nCatText.NUDGED = \"The cat's paw knocked you aside. It has lost interest, for now.\"\nCatText.CAUSE = \"cat\" -- (the end of a life's cause, LifeSession)\n\n-- The caption of what is heard now (`bell` and `purr`, 0..1, Predator/Cat.sound; `direction` UI/WaspText.directionWord's), or nil. The bell wins: it is the warning.\nfunction CatText.caption(bell: number, purr: number, direction: string, nearer: boolean): { text: string, alpha: number }?\n\tif bell > 0.05 then\n\t\treturn { text = `[a small bell, {direction}{if nearer then \", coming closer\" else \"\"}]`, alpha = math.clamp(0.4 + bell, 0, 1) }\n\tend\n\tif purr > 0.05 then\n\t\treturn { text = `[a low purr, {direction}]`, alpha = math.clamp(0.4 + purr, 0, 1) }\n\tend\n\treturn nil\nend\n\nreturn table.freeze(CatText)\n",1492,1316222467},{"Shared/UI/ContextPrompts","--!strict\n-- Only the player-requested meal and dusk prompts enter the minimal play HUD.\nlocal ControlText=require(script.Parent.ControlText)\nlocal LifeClock=require(script.Parent.Parent.Life.LifeClock)\nlocal LifeText=require(script.Parent.LifeText)\nlocal P={};P.__index=P\nfunction P.new(): any return setmetatable({night=nil,dismissed=false,away=0,key=\"\",view=nil},P) end\nfunction P.reset(self: any) self.night=nil;self.dismissed=false;self.away=0;self.key=\"\";self.view=nil end\nfunction P.step(self: any,dt: number,s: any): any\n local night=if s.hour>=LifeClock.DUSK_H then s.day elseif s.hour<LifeClock.WAKE_H then s.day-1 else nil\n if night~=self.night then self.night=night;self.dismissed=false;self.away=0 end\n if night~=nil and s.resting then self.dismissed=true end\n local text: string?=nil\n if s.enabled and not s.blocked then\n  local key=ControlText.name(s.device,\"feed\")\n  if s.held then\n   if not s.canEat then text=\"Land and keep still to eat.\"\n   elseif s.struggling and not s.auto then text=`Tap {if s.device==\"touch\" then \"Grip\" else key}: hold your prey`\n   elseif s.struggling then text=\"Holding your prey\"\n   elseif s.auto then text=\"Eating - move to pause\"\n   else text=if s.device==\"touch\" then \"Tap Eat\" else `Tap {key}: eat` end\n  elseif night~=nil and not self.dismissed then\n   if s.weak then text=\"Too hungry to sleep; find food.\"\n   elseif s.canRest then text=`{if s.device==\"touch\" then \"Rest\" else key}: rest`\n   elseif self.away<8 then\n    local home=LifeText.HOMES[s.home or \"sill_crevice\"] or LifeText.HOMES.sill_crevice\n    text=\"It is dark. Rest \"..(if string.sub(home.name,1,6)==\"under \" then home.name else \"in \"..home.name)..\".\"\n    self.away+=dt\n   end\n  end\n end\n local cache=text or \"\"\n if cache~=self.key then self.key=cache;self.view=if text then {hint=text} else nil end\n return self.view\nend\nreturn P\n",1844,824933637},{"Shared/UI/ControlText","--!strict\n-- Words on the screen, written for the device the player is using now: keyboard and mouse, a controller, or touch.\n-- The texts are the frozen Godot game's (scripts/presentation/jump_feedback.gd, key_names.gd and jump_hud.gd at c87ce00);\n-- where Godot wrote both keys (\"Q / B\"), each device here names only its own key or button. Pure: tests/run.luau checks\n-- every prompt without Roblox.\nlocal ControlText = {}\n\nexport type Device = \"keyboard\" | \"gamepad\" | \"touch\"\n\nControlText.TITLES = {\n\treachable = \"Reachable\",\n\tobstructed = \"Blocked\",\n\tunreachable = \"Out of reach\",\n\tineligible = \"Can't land there\",\n\tnone = \"No surface in view\",\n}\nControlText.REASONS = {\n\tok = \"\",\n\tno_target = \"no surface in view\",\n\tineligible_surface = \"the spider cannot hold on there\",\n\ttoo_far = \"too far or too high\",\n\tno_launch = \"no way to leave this surface toward there\",\n\tno_arrival = \"it can't land from that angle\",\n\tno_durations = \"out of range\",\n\tno_room = \"no room to land\",\n\tpath_blocked = \"something is in the way\",\n\tgraze = \"it would only graze the surface\",\n\thop_blocked = \"something is in the way\",\n\tno_ground = \"nothing to land on ahead\",\n}\nControlText.ANCHOR_TEXT = {\n\tok = \"Safety line: anchored here\",\n\tno_silk = \"No safety line: this surface won't hold silk\",\n\ttoo_long = \"No safety line: this jump needs more line than you have\",\n\tno_support = \"\",\n}\nControlText.LINE_TITLE = \"On your line\"\nControlText.LINE_TITLE_REELING = \"On your line: reeling in\"\nControlText.LINE_BLOCKED = {\n\tblocked = \"Can't reel in: something is in the way. Lower, or let go\",\n\tshortest = \"Reeled in as far as it goes\",\n\tsnagged = \"The line is caught on a second edge and can't be reeled in. Lower, or let go\",\n}\nControlText.DROP_REFUSED = {\n\tno_edge = \"Nothing below to let yourself down into from here\",\n\tno_silk = \"This surface won't hold your silk\",\n\tno_support = \"\",\n\tstuck = \"Couldn't get to the edge\",\n}\nControlText.DROP_WALK = \"To the edge, to let yourself down\"\n\n-- What each device calls the controls. (L1 / LB locks, R2 / RT focuses, L2 / LT runs; the right-stick click recentres.) Godot's input_setup.gd bindings; the port keeps the D-pad for walking, so lowering on\n-- silk is X on a controller (ROBLOX-05). Touch names are the on-screen buttons.\nlocal NAMES: { [string]: { [string]: string } } = {\n\tkeyboard = {\n\t\tfeed = \"E\", jump = \"Space\", cancel = \"Q\", letGo = \"Q\", drop = \"F\", reel = \"W\", lower = \"S\", walk = \"WASD\", look = \"Mouse\",\n\t\tcreep = \"Ctrl\", run = \"Shift\", focus = \"Right mouse\", eye = \"V\", recenter = \"R\", lock = \"R\", slow = \"T\", reset = \"Backspace\", help = \"H\", zoom = \"Wheel\",\n\t\tchoose = \"C\", display = \"X\", menu = \"M\", notebook = \"N\", settings = \"O\",\n\t},\n\tgamepad = {\n\t\tfeed = \"Left-stick click\", jump = \"A\", cancel = \"B\", letGo = \"B\", drop = \"X\", reel = \"Stick up\", lower = \"Stick down\", walk = \"Left stick\",\n\t\tlook = \"Right stick\", creep = \"LB\", run = \"LT\", focus = \"RT\", eye = \"Y\", recenter = \"Right-stick click\", lock = \"LB\", slow = \"\", reset = \"View\",\n\t\thelp = \"\", zoom = \"\", choose = \"RB\", display = \"RB\", menu = \"View\", notebook = \"View\",\n\t},\n\ttouch = {\n\t\tfeed = \"Eat\", jump = \"Jump\", cancel = \"Cancel\", letGo = \"Let go\", drop = \"Silk\", reel = \"↑\", lower = \"↓\", walk = \"Arrows\",\n\t\tlook = \"Drag\", creep = \"Creep\", run = \"Run\", focus = \"Focus\", eye = \"Eye\", recenter = \"Recentre\", lock = \"Lock\", slow = \"\", reset = \"\", help = \"\", zoom = \"\", choose = \"Change\", display = \"Dance\", menu = \"Menu\", notebook = \"Notebook\",\n\t},\n}\n\n-- A PlayStation controller has the same buttons under other names (Roblox reports \"ButtonCross\" for ButtonA there). The client\n-- calls setPadStyle from UserInputService:GetStringForKeyCode(ButtonA) at start and after each controller input; names not listed\n-- here (sticks) are the same on both.\nlocal PLAYSTATION: { [string]: string } = {\n\tfeed = \"L3\", jump = \"Cross\", cancel = \"Circle\", letGo = \"Circle\", drop = \"Square\", creep = \"L1\", run = \"L2\", focus = \"R2\", eye = \"Triangle\",\n\trecenter = \"R3\", lock = \"L1\", slow = \"\", reset = \"Touchpad\", choose = \"R1\", display = \"R1\", menu = \"Touchpad\", notebook = \"Touchpad\",\n}\nlocal padStyle = \"xbox\"\n\n-- \"xbox\" or \"playstation\", from what Roblox calls ButtonA on this controller.\nfunction ControlText.padStyleFor(buttonAString: string?): string\n\treturn if buttonAString == \"ButtonCross\" then \"playstation\" else \"xbox\"\nend\n\nfunction ControlText.setPadStyle(style: string)\n\tpadStyle = if style == \"playstation\" then \"playstation\" else \"xbox\"\nend\n\nfunction ControlText.padStyle(): string\n\treturn padStyle\nend\n\nfunction ControlText.name(device: Device, action: string): string\n\tif device == \"gamepad\" and padStyle == \"playstation\" and PLAYSTATION[action] then\n\t\treturn PLAYSTATION[action]\n\tend\n\treturn (NAMES[device] or NAMES.keyboard)[action] or \"\"\nend\n\n-- The device whose names to show after an input of this UserInputType (its Enum name). Anything else keeps the previous one.\nfunction ControlText.deviceFor(inputType: string, previous: Device): Device\n\tif inputType == \"Touch\" then return \"touch\" end\n\tif string.sub(inputType, 1, 7) == \"Gamepad\" then return \"gamepad\" end\n\tif inputType == \"Keyboard\" or inputType == \"TextInput\" or string.sub(inputType, 1, 5) == \"Mouse\" then return \"keyboard\" end\n\treturn previous\nend\n\n-- Before any input: a touch-only device shows touch, a controller without a keyboard (a console) shows the controller.\nfunction ControlText.initialDevice(touch: boolean, keyboard: boolean, gamepad: boolean): Device\n\tif touch and not keyboard then return \"touch\" end\n\tif gamepad and not keyboard then return \"gamepad\" end\n\treturn \"keyboard\"\nend\n\nfunction ControlText.reason(plan: any): string\n\tif plan == nil then return \"\" end\n\treturn ControlText.REASONS[plan.reason] or tostring(plan.reason or \"\")\nend\n\n-- The two lines at the reticle while aiming (JumpFeedback.describe, hold mode) and Godot's cancel hint beside the second.\nfunction ControlText.describe(plan: any, device: Device): (string, string)\n\tlocal cancel = (if device == \"gamepad\" then \"Left stick: aim    \" else \"\") .. ControlText.name(device, \"cancel\") .. \": cancel the jump\"\n\tif plan == nil then\n\t\treturn ControlText.TITLES.none, \"release to cancel    \" .. cancel\n\tend\n\tlocal kind = plan.kind\n\tlocal valid = kind == \"reachable\"\n\tlocal title = ControlText.TITLES[kind] or kind\n\tif not valid and kind ~= \"none\" then\n\t\tlocal why = ControlText.reason(plan)\n\t\tif why ~= \"\" then title = title .. \": \" .. why end\n\tend\n\treturn title, (if valid then \"release to leap\" else \"release to cancel\") .. \"    \" .. cancel\nend\n\nfunction ControlText.anchorText(reason: string): string\n\treturn ControlText.ANCHOR_TEXT[reason] or \"\"\nend\n\n-- The toast for a jump outcome (JumpFeedback.toast): \"\" for outcomes that need none.\nfunction ControlText.toast(kind: string, plan: any): string\n\tlocal why = ControlText.reason(plan)\n\tif kind == \"refused\" then\n\t\treturn \"Jump cancelled: \" .. (if why ~= \"\" then why else \"nothing to land on\")\n\telseif kind == \"hop_refused\" then\n\t\treturn \"No hop: \" .. (if why ~= \"\" then why else \"nowhere to land\")\n\telseif kind == \"cancelled\" then\n\t\treturn \"Jump cancelled\"\n\telseif kind == \"out_of_bounds\" then\n\t\treturn \"Out of bounds: back to the last safe spot\"\n\tend\n\treturn \"\"\nend\n\n-- The toast for a line event (JumpFeedback.line_toast). afterMiss: the line had been locked by a miss; dropped: the spider\n-- let itself down on this line (the line taking its weight is no surprise then).\nfunction ControlText.lineToast(kind: string, detail: string, afterMiss: boolean, dropped: boolean, device: Device): string\n\tif kind == \"caught\" then\n\t\treturn if dropped then \"\" else \"Caught by your line\"\n\telseif kind == \"drop_walk\" then\n\t\treturn ControlText.DROP_WALK\n\telseif kind == \"dropped\" then\n\t\treturn `Letting yourself down: hold {ControlText.name(device, \"drop\")} to lower, {ControlText.name(device, \"reel\")} to climb`\n\telseif kind == \"drop_refused\" then\n\t\treturn ControlText.DROP_REFUSED[detail] or \"\"\n\telseif kind == \"completed\" then\n\t\treturn if afterMiss then \"Holding on again. The line stays behind for a moment\" else \"\"\n\telseif kind == \"released\" then\n\t\treturn \"You let go of the line\"\n\telseif kind == \"lost\" then\n\t\treturn \"Your line came loose: its anchor is gone\"\n\telseif kind == \"blocked\" then\n\t\treturn ControlText.LINE_BLOCKED[detail] or \"\"\n\telseif kind == \"snagged\" then\n\t\treturn ControlText.LINE_BLOCKED.snagged\n\tend\n\treturn \"\"\nend\n\n-- The panel at the bottom while on the line: its title, the line's own prompts (distinct from cancelling an aim) and a cue.\n-- ctx: reeling, progress (0..1 of a deliberate let-go hold), snagged, block (\"\", \"blocked\", \"shortest\").\nfunction ControlText.linePanel(ctx: any, device: Device): (string, string, string)\n\tlocal title = if ctx.reeling then ControlText.LINE_TITLE_REELING else ControlText.LINE_TITLE\n\tlocal hint = `{ControlText.name(device, \"reel\")}: reel in    {ControlText.name(device, \"lower\")}: lower    hold {ControlText.name(device, \"letGo\")}: let go`\n\tlocal cue = \"\"\n\tif (ctx.progress or 0) > 0 then\n\t\tcue = `Letting go... {math.floor(ctx.progress * 100 + 0.5)}%`\n\telseif ctx.snagged then\n\t\tcue = ControlText.LINE_BLOCKED.snagged\n\telseif ctx.block and ctx.block ~= \"\" then\n\t\tcue = ControlText.LINE_BLOCKED[ctx.block] or \"\"\n\tend\n\treturn title, hint, cue\nend\n\n-- Walking (port-only reminder, shown small): how to jump and how to let down on silk.\nfunction ControlText.walkHint(device: Device): string\n\tlocal j = ControlText.name(device, \"jump\")\n\treturn `Tap {j}: hop    hold {j}: aim a leap    {ControlText.name(device, \"drop\")}: let yourself down on silk`\nend\n\n-- Walking to an edge to let down: what stops it.\nfunction ControlText.edgeWalkHint(device: Device): string\n\treturn `{ControlText.DROP_WALK}    {ControlText.name(device, \"cancel\")} or move: stop`\nend\n\n-- Focus can be held or latched with the existing accessibility option.\nfunction ControlText.focusAgain(device: Device): string\n\treturn `{ControlText.name(device, \"focus\")} again to stop`\nend\n\n-- The touch Lock button's words (ROBLOX-110): Lock, or Unlock while a lock holds.\nControlText.LOCK_LABEL, ControlText.UNLOCK_LABEL = \"Lock\", \"Unlock\"\nfunction ControlText.touchLockLabel(locked: boolean): string\n\treturn if locked then ControlText.UNLOCK_LABEL else ControlText.LOCK_LABEL\nend\n\n-- The touch Cancel button's words: on the line it is the let-go button (held), elsewhere it cancels.\nfunction ControlText.touchCancelLabel(onLine: boolean): string\n\treturn if onLine then \"Let go\\n(hold)\" else \"Cancel\"\nend\n\n-- The controls card (H): the device's own bindings, one group of actions to a line. The whole card the player reads is PeacockText.card (this, then the crack's line,\n-- the pointer to the Settings row and the display key's line), and it is at most ten lines at the width the HUD gives it (tests/peacock.luau, the Studio PromptSpec);\n-- each line here is at most 61 characters (the card's width at its text size) so that, on a keyboard or a controller, none wraps. The touch card has the room to wrap.\nfunction ControlText.runUnlocked(device: Device): string\n\treturn `You can now run. Hold {ControlText.name(device, \"run\")} while moving.`\nend\n\nfunction ControlText.lockUnlocked(device: Device): string\n\treturn `You can now lock on. Press {ControlText.name(device, \"lock\")} near visible prey, then move to circle it.`\nend\n\nfunction ControlText.helpCard(device: Device, runAvailable: boolean?, lockAvailable: boolean?): string\n\tif device == \"gamepad\" then\n\t\tlocal function n(action: string): string return ControlText.name(\"gamepad\", action) end\n\t\t-- L1 locks, R2 focuses, and L2 runs; the right-stick click recentres.\n\t\treturn table.concat({\n\t\t\t\"Left stick: walk/creep   Right stick look, click: recentre\",\n\t\t\t`Tap {n(\"jump\")} hop   Hold {n(\"jump\")} aim, release to leap`,\n\t\t\t`{n(\"drop\")} lower on silk   {n(\"cancel\")} cancel   {n(\"eye\")} eye view`,\n\t\t\t`On the line: up reel, down lower, hold {n(\"letGo\")} let go`,\n\t\t\t(if lockAvailable == false then `{n(\"creep\")} creep   {n(\"focus\")} focus` else `{n(\"lock\")} creep/lock (circle)   {n(\"focus\")} focus`) .. (if runAvailable == false then \"\" else `   {n(\"run\")} run`),\n\t\t\t`In the crack: {n(\"feed\")} rest (sleep from evening)`,\n\t\t\t`{n(\"menu\")}: menu, then last rest, notebook, settings`,\n\t\t}, \"\\n\")\n\telseif device == \"touch\" then\n\t\treturn table.concat({\n\t\t\tif runAvailable == false then \"Arrows walk   Drag to look   Hold Creep\" else \"Arrows walk   Drag to look   Hold Run or Creep\",\n\t\t\t\"Tap Jump hop   Hold Jump aim, release to leap   Cancel\",\n\t\t\t\"Silk: lower on a line   On it: ↑ reel, ↓ lower, hold Let go\",\n\t\t\tif lockAvailable == false then \"Recentre   Focus   Eye\" else \"Lock (← → circle)   Recentre   Focus   Eye\",\n\t\t\t\"In the crack: Rest (Sleep from evening)\",\n\t\t\t\"Menu: last rest, notebook, settings, this card\",\n\t\t}, \"\\n\")\n\tend\n\treturn table.concat({\n\t\tif runAvailable == false then \"WASD walk   Mouse look   Ctrl creep   G gait\" else \"WASD walk   Mouse look   Shift run   Ctrl creep   G gait\",\n\t\t\"Tap Space hop   Hold Space aim, release to leap   Q cancel\",\n\t\t\"F lower on silk   On the line: W reel, S lower, hold Q let go\",\n\t\t\"V eye view   Right mouse focus   T slow motion   H: hide this\",\n\t\tif lockAvailable == false then \"R recentre\" else \"R lock on or recentre   Locked: A/D circle, W/S close in\",\n\t\t\"In the crack: E rest (sleep from evening)\",\n\t\t\"Backspace: last rest   M: menu   N: notebook   O: settings\",\n\t}, \"\\n\")\nend\n\nreturn ControlText\n",13322,3784976139},{"Shared/UI/CrabText","--!strict\n-- The crab spider in words (ROBLOX-119; the crab spider is Predator/CrabSpider): its death card and the notice when its lunge only knocks the spider off the flower (the\n-- gentle rules). Pure: tests/preserve.luau checks the words, tests/quiet.luau their classes.\nlocal CrabText = {}\n\nCrabText.LINE = \"The crab spider's legs closed.\"\nCrabText.SUB = \"It sat still on the flower in the flower's colour, its front legs held open. A careful look before landing would have shown it.\"\nCrabText.NUDGED = \"A crab spider lunged from the flower. You dropped clear.\"\nCrabText.CAUSE = \"crab_spider\" -- (the end of a life's cause, LifeSession; Predator/CrabSpider.CAUSE)\n\nreturn table.freeze(CrabText)\n",699,1305472838},{"Shared/UI/EyeOptics","--!strict\n-- EyeOptics: the pure half of the spider-eye picture (ROBLOX-20). From k (how much the principal eyes are in use, 0 to 1) and the\n-- time it works out the field of view, the colour grade, the blur and the depth of field, where the two retina strips are and how\n-- they swing, how big a movement ring is and where an edge arc goes, the vignette's strength, the caption's fade and the UV layer's\n-- transparency. Client/SpiderEyes draws what this says; nothing here touches the engine, so tests/eyes.luau checks every rule. The\n-- numbers, and what they rest on, are in Shared/Data/Eyes. Angles are degrees, sizes pixels, times seconds. Screen y runs down.\nlocal Eyes = require(script.Parent.Parent.Data.Eyes)\n\nlocal EyeOptics = {}\n\n-- What the picture looks like at one k (see EyeOptics.profile).\nexport type Profile = {\n\tk: number,\n\tfovDeg: number, -- vertical\n\tsaturation: number,\n\ttint: Color3,\n\tcontrast: number,\n\tbrightness: number,\n\tblur: number, -- BlurEffect.Size\n\tdofFar: number,\n\tdofNear: number,\n\tdofRadius: number, -- InFocusRadius, studs\n\tstrokeTransparency: number, -- of the retina strips\n\tfillTransparency: number,\n\tsweepDeg: number, -- how far each strip swings side to side\n\ttorsionDeg: number, -- and how far it turns about its middle\n\tvignette: number, -- opacity at the screen's edge\n}\n-- A retina strip as a rounded box on the screen: its middle, its size and its turn (clockwise, as GuiObject.Rotation).\nexport type Strip = { x: number, y: number, w: number, h: number, rotation: number }\n-- A thing the lateral eyes saw moving (a Sensor.motionSeen entry with the id it is filed under).\nexport type Moving = { direction: Vector3, distance: number, apparent: number, tick: number }\nexport type Mover = { id: string, direction: Vector3, distance: number, apparent: number, tick: number }\n-- One short bar of an edge arc.\nexport type Segment = { x: number, y: number, rotation: number }\n\n-- a(1 - t) + bt, not a + (b - a)t: exactly a at 0 and exactly b at 1 (the looks at k = 0 and k = 1 are the spec's numbers to the digit).\nlocal function lerp(a: number, b: number, t: number): number\n\treturn a * (1 - t) + b * t\nend\n\nlocal function clamp01(x: number): number\n\treturn math.clamp(x, 0, 1)\nend\n\n-- Smoothstep.\nfunction EyeOptics.smooth(x: number): number\n\tlocal t = clamp01(x)\n\treturn t * t * (3 - 2 * t)\nend\n\n-- ---------------------------------------------------------------- how much the principal eyes are in use\n-- One step of the engagement clock. `phase` runs 0 to 1 in Eyes.timing.engageSeconds while the principal eyes are wanted (Focus\n-- held, or toggled on) and back in releaseSeconds otherwise. It is linear in time, so every frame rate gives the same phase after\n-- the same time; a change of mind part-way simply turns it round.\nfunction EyeOptics.stepPhase(phase: number, wanted: boolean, dt: number): number\n\tlocal T = Eyes.timing\n\tlocal step = math.max(dt, 0)\n\treturn clamp01(phase + (if wanted then step / T.engageSeconds else -step / T.releaseSeconds))\nend\n\n-- k: the phase, eased, so the picture starts and settles gently.\nfunction EyeOptics.engagement(phase: number): number\n\treturn EyeOptics.smooth(phase)\nend\n\n-- ---------------------------------------------------------------- the field of view and the look\n-- The principal eyes' vertical field: 24 degrees, or no narrower than 45 with reduced motion.\nfunction EyeOptics.principalFovDeg(reduced: boolean): number\n\tif reduced then\n\t\treturn math.max(Eyes.principal.fovDeg, Eyes.reducedMotion.minFovDeg)\n\tend\n\treturn Eyes.principal.fovDeg\nend\n\n-- The vertical field at k, blended in tangent space (the half-angle's tangent is the screen's half-height at unit distance), so\n-- the zoom looks even instead of rushing at the end. Exactly the side eyes' at 0 and the principal eyes' at 1.\nfunction EyeOptics.fovDeg(k: number, reduced: boolean): number\n\tlocal far, near = Eyes.side.fovDeg, EyeOptics.principalFovDeg(reduced)\n\tif k <= 0 then\n\t\treturn far\n\telseif k >= 1 then\n\t\treturn near\n\tend\n\treturn math.deg(2 * math.atan(lerp(math.tan(math.rad(far) / 2), math.tan(math.rad(near) / 2), k)))\nend\n\n-- How much of the player's look a turn of the view gets at this field of view, so the picture moves as fast across the screen\n-- whatever the zoom: tan(fov / 2) against the side eyes' tan(90 / 2) = 1.\nfunction EyeOptics.lookScale(fovDeg: number): number\n\treturn math.tan(math.rad(fovDeg) / 2) / math.tan(math.rad(Eyes.side.fovDeg) / 2)\nend\n\nlocal function mix3(a: { number }, b: { number }, k: number): Color3\n\treturn Color3.new(lerp(a[1], b[1], k) / 255, lerp(a[2], b[2], k) / 255, lerp(a[3], b[3], k) / 255)\nend\n\n-- Everything that depends on k, blended: every number is the side eyes' at 0 and the principal eyes' at 1, the field of view in\n-- tangent space. focusDistance (studs, what is looked at) sets how deep the sharp zone of the depth of field is.\nfunction EyeOptics.profile(k: number, focusDistance: number, reduced: boolean): Profile\n\tlocal t = clamp01(k)\n\tlocal s, p = Eyes.side, Eyes.principal\n\tlocal distance = math.max(focusDistance, 0)\n\tlocal sideRadius = math.max(s.dofRadiusMin, s.dofRadiusPerStud * distance)\n\tlocal principalRadius = math.max(p.dofRadiusMin, p.dofRadiusPerStud * distance)\n\treturn {\n\t\tk = t,\n\t\tfovDeg = EyeOptics.fovDeg(t, reduced),\n\t\tsaturation = lerp(s.saturation, p.saturation, t),\n\t\ttint = mix3(s.tint, p.tint, t),\n\t\tcontrast = lerp(s.contrast, p.contrast, t),\n\t\tbrightness = lerp(s.brightness, p.brightness, t),\n\t\tblur = lerp(s.blur, p.blur, t),\n\t\tdofFar = lerp(s.dofFar, p.dofFar, t),\n\t\tdofNear = lerp(s.dofNear, p.dofNear, t),\n\t\tdofRadius = lerp(sideRadius, principalRadius, t),\n\t\tstrokeTransparency = lerp(s.strokeTransparency, p.strokeTransparency, t),\n\t\tfillTransparency = lerp(s.fillTransparency, p.fillTransparency, t),\n\t\tsweepDeg = if reduced then 0 else lerp(s.sweepDeg, p.sweepDeg, t),\n\t\ttorsionDeg = if reduced then 0 else lerp(s.torsionDeg, p.torsionDeg, t),\n\t\tvignette = lerp(s.vignette, p.vignette, t),\n\t}\nend\n\n-- ---------------------------------------------------------------- where the eyes are focused\n-- The distance to focus on: how far the looked-along ray ran before it hit the world (nil when it hit nothing), at most the\n-- limit.\nfunction EyeOptics.focusTarget(hitDistance: number?): number\n\tlocal limit = Eyes.focus.maxDistance\n\tif hitDistance == nil then\n\t\treturn limit\n\tend\n\treturn math.min(hitDistance, limit)\nend\n\n-- One step of the focus racking from one distance to the next: an exponential approach with Eyes.focus.tauSeconds as its time\n-- constant. Any frame rate gives the same distance after the same time.\nfunction EyeOptics.focusStep(current: number, target: number, dt: number): number\n\treturn current + (target - current) * (1 - math.exp(-math.max(dt, 0) / Eyes.focus.tauSeconds))\nend\n\n-- ---------------------------------------------------------------- sizes on the screen\n-- Pixels for one unit of tangent at this vertical field of view: the screen's half-height over tan(fov / 2).\nfunction EyeOptics.pixelsPerTan(fovDeg: number, viewportH: number): number\n\treturn viewportH * 0.5 / math.tan(math.rad(fovDeg) * 0.5)\nend\n\n-- How long, in pixels, something that spans `angleDeg` about the middle of the view looks: tangent-correct, so a 20 degree strip\n-- at a 24 degree field is tan(10) / tan(12) of the screen's height. Square pixels, so it serves for width and height alike.\nfunction EyeOptics.extentPx(angleDeg: number, fovDeg: number, viewportH: number): number\n\treturn 2 * math.tan(math.rad(math.min(angleDeg, 170)) * 0.5) * EyeOptics.pixelsPerTan(fovDeg, viewportH)\nend\n\n-- How far from the middle of the screen, in pixels, a direction `angleDeg` off the view's axis lands.\nfunction EyeOptics.offsetPx(angleDeg: number, fovDeg: number, viewportH: number): number\n\treturn math.tan(math.rad(angleDeg)) * EyeOptics.pixelsPerTan(fovDeg, viewportH)\nend\n\n-- ---------------------------------------------------------------- the retinae\n-- Strip `index` (1 the left one, 2 the right) at time t: how far it has swayed from its place and turned from its tilt, in\n-- degrees. The second strip runs lagSeconds behind the first in both (the retinae do not move as one). The amplitudes come from\n-- the profile (large with the side eyes, small tracking with the principal eyes, none with reduced motion).\nfunction EyeOptics.scanPose(index: number, t: number, sweepDeg: number, torsionDeg: number): (number, number)\n\tlocal R = Eyes.retina\n\tlocal at = t - (index - 1) * R.lagSeconds\n\treturn sweepDeg * math.sin(2 * math.pi * at / R.sweepSeconds), torsionDeg * math.sin(2 * math.pi * at / R.torsionSeconds)\nend\n\n-- The two strips as the player sees them, for a profile (its field of view and its swing), the time and the screen's size: each\n-- at its true angular size (widthDeg x heightDeg), offsetDeg either side of the middle plus its sway, tilted tiltDeg into a V (the\n-- left one leaning out to the left at the top) plus its turn.\nfunction EyeOptics.retinaStrips(t: number, p: Profile, viewportW: number, viewportH: number): { Strip }\n\tlocal R = Eyes.retina\n\tlocal w = EyeOptics.extentPx(R.widthDeg, p.fovDeg, viewportH)\n\tlocal h = EyeOptics.extentPx(R.heightDeg, p.fovDeg, viewportH)\n\tlocal out: { Strip } = {}\n\tfor i = 1, 2 do\n\t\tlocal side = if i == 1 then -1 else 1\n\t\tlocal sway, turn = EyeOptics.scanPose(i, t, p.sweepDeg, p.torsionDeg)\n\t\tout[i] = {\n\t\t\tx = viewportW * 0.5 + EyeOptics.offsetPx(side * R.offsetDeg + sway, p.fovDeg, viewportH),\n\t\t\ty = viewportH * 0.5,\n\t\t\tw = w,\n\t\t\th = h,\n\t\t\trotation = side * R.tiltDeg + turn,\n\t\t}\n\tend\n\treturn out\nend\n\n-- True when the screen point lies inside the strip: the rounded box (a stadium, the strip being taller than wide), turned as it\n-- is drawn.\nfunction EyeOptics.insideStrip(px: number, py: number, s: Strip): boolean\n\tlocal dx, dy = px - s.x, py - s.y\n\tlocal a = math.rad(s.rotation)\n\tlocal c, sn = math.cos(a), math.sin(a)\n\tlocal lx, ly = dx * c + dy * sn, -dx * sn + dy * c\n\tlocal r = s.w * 0.5\n\tlocal reach = math.max(s.h * 0.5 - r, 0)\n\tlocal oy = ly - math.clamp(ly, -reach, reach)\n\treturn lx * lx + oy * oy <= r * r\nend\n\nfunction EyeOptics.insideAnyStrip(px: number, py: number, strips: { Strip }): boolean\n\tfor _, s in strips do\n\t\tif EyeOptics.insideStrip(px, py, s) then\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\n-- ---------------------------------------------------------------- the lateral eyes' movement rings\n-- 0 to 1 and back, Eyes.shimmer.hz times a second, from time t; a steady half with reduced motion.\nfunction EyeOptics.pulse(t: number, reduced: boolean): number\n\tif reduced then\n\t\treturn 0.5\n\tend\n\treturn 0.5 - 0.5 * math.cos(2 * math.pi * Eyes.shimmer.hz * t)\nend\n\n-- A ring's diameter in pixels: the thing's apparent size (degrees across, as the sensor measured it) at this field of view, at\n-- least minPx, times scaleMin to scaleMax as the pulse goes 0 to 1.\nfunction EyeOptics.ringDiameter(apparentDeg: number, fovDeg: number, viewportH: number, pulse: number): number\n\tlocal S = Eyes.shimmer\n\tlocal base = math.max(S.minPx, EyeOptics.extentPx(apparentDeg, fovDeg, viewportH))\n\treturn base * lerp(S.scaleMin, S.scaleMax, clamp01(pulse))\nend\n\n-- 1 when the thing was just seen moving, 0 when the sensor's hold (holdTicks, Sensor.MOTION_HOLD_TICKS) has run out.\nfunction EyeOptics.freshness(nowTick: number, seenTick: number, holdTicks: number): number\n\treturn 1 - clamp01((nowTick - seenTick) / math.max(holdTicks, 1))\nend\n\n-- A ring's opacity: the base alpha, as fresh as the sighting, a third of that (insideStripFactor) inside a retina strip.\nfunction EyeOptics.ringAlpha(fresh: number, inside: boolean): number\n\tlocal S = Eyes.shimmer\n\treturn S.alpha * clamp01(fresh) * (if inside then S.insideStripFactor else 1)\nend\n\n-- An edge arc's opacity: as fresh as the sighting, breathing a little with the pulse.\nfunction EyeOptics.arcAlpha(fresh: number, pulse: number): number\n\tlocal A = Eyes.shimmer.arc\n\treturn A.alpha * clamp01(fresh) * lerp(1 - A.breath, 1, clamp01(pulse))\nend\n\n-- The things to draw: the freshest first, at most maxCount, ties broken by id so the same record always gives the same list.\nfunction EyeOptics.pickMovers(seen: { [string]: Moving }, maxCount: number): { Mover }\n\tlocal list: { Mover } = {}\n\tfor id, e in seen do\n\t\ttable.insert(list, { id = id, direction = e.direction, distance = e.distance, apparent = e.apparent, tick = e.tick })\n\tend\n\ttable.sort(list, function(a: Mover, b: Mover): boolean\n\t\tif a.tick ~= b.tick then\n\t\t\treturn a.tick > b.tick\n\t\tend\n\t\treturn a.id < b.id\n\tend)\n\twhile #list > maxCount do\n\t\ttable.remove(list)\n\tend\n\treturn list\nend\n\n-- True when a point (pixels) is inside the screen, give or take `margin`.\nfunction EyeOptics.onScreen(x: number, y: number, viewportW: number, viewportH: number, margin: number): boolean\n\treturn x >= -margin and x <= viewportW + margin and y >= -margin and y <= viewportH + margin\nend\n\n-- Where the screen's edge is in the direction of something off screen: (cx, cy) is its direction in the camera's own axes (x\n-- right, y up). The same rule as the perception HUD's edge marks: a direction straight behind goes to the top, and the point is\n-- `inset` pixels inside the edge. Returns the point's x and y and the unit direction (x, y; y down) from the screen's middle to it.\nfunction EyeOptics.edgeMark(cx: number, cy: number, viewportW: number, viewportH: number, inset: number): (number, number, number, number)\n\tlocal vx, vy = cx, -cy\n\tlocal m = math.sqrt(vx * vx + vy * vy)\n\tif m < 0.03 then\n\t\tvx, vy, m = 0, -1, 1\n\tend\n\tvx, vy = vx / m, vy / m\n\tlocal hx, hy = viewportW * 0.5 - inset, viewportH * 0.5 - inset\n\tlocal t = math.min(hx / math.max(math.abs(vx), 1e-6), hy / math.max(math.abs(vy), 1e-6))\n\treturn viewportW * 0.5 + vx * t, viewportH * 0.5 + vy * t, vx, vy\nend\n\n-- The short bars that make an edge arc: `segments` of them, stepDeg apart along a circle of `radius` pixels whose outermost point\n-- is (x, y), where `d` (dx, dy) points out of the screen. Each bar's rotation lays it along the circle there.\nfunction EyeOptics.arcSegments(x: number, y: number, dx: number, dy: number): { Segment }\n\tlocal A = Eyes.shimmer.arc\n\tlocal cx, cy = x - dx * A.radius, y - dy * A.radius\n\tlocal nx, ny = -dy, dx\n\tlocal out: { Segment } = {}\n\tlocal middle = (A.segments + 1) / 2\n\tfor i = 1, A.segments do\n\t\tlocal phi = math.rad((i - middle) * A.stepDeg)\n\t\tlocal c, s = math.cos(phi), math.sin(phi)\n\t\tout[i] = {\n\t\t\tx = cx + A.radius * (c * dx + s * nx),\n\t\t\ty = cy + A.radius * (c * dy + s * ny),\n\t\t\trotation = math.deg(math.atan2(-s * dy + c * ny, -s * dx + c * nx)),\n\t\t}\n\tend\n\treturn out\nend\n\n-- ---------------------------------------------------------------- the words, the UV layer\n-- The caption's opacity `age` seconds into the eye view: it fades in, holds and fades out, and is gone after Eyes.caption.seconds.\nfunction EyeOptics.captionAlpha(age: number): number\n\tlocal C = Eyes.caption\n\tif age < 0 or age >= C.seconds then\n\t\treturn 0\n\tend\n\treturn EyeOptics.smooth(age / C.fadeInSeconds) * EyeOptics.smooth((C.seconds - age) / C.fadeOutSeconds)\nend\n\n-- The caption: what the side eyes do, then how to use the principal eyes. `key` is the device's Focus control (ControlText);\n-- `toggled` when Focus is a toggle, which is pressed and not held.\n-- `held` (ROBLOX-115): the key is held even to latch a toggled Focus (a controller's L2, whose tap is the lock), so the words say Hold either way.\nfunction EyeOptics.captionText(key: string, toggled: boolean, held: boolean?): string\n\tlocal C = Eyes.caption\n\treturn C.side .. \"\\n\" .. string.format(C.principal, if toggled and not held then C.toggle else C.hold, if key ~= \"\" then key else \"Focus\")\nend\n\n-- A UV layer part's transparency: clear with the side eyes, as visible as its UVOpacity with the principal eyes.\nfunction EyeOptics.uvTransparency(k: number, opacity: number): number\n\treturn 1 - clamp01(k) * clamp01(opacity)\nend\n\nreturn EyeOptics\n",15843,2142335976},{"Shared/UI/FrogText","--!strict\n-- The green frog in words (ROBLOX-122; the frog is Predator/Frog): its death card and the notice when its tongue misses (the gentle rules). Pure: tests/preserve.luau\n-- checks the words, tests/quiet.luau their classes.\nlocal FrogText = {}\n\nFrogText.LINE = \"The frog's tongue was quicker.\"\nFrogText.SUB = \"It sat still at the water's edge and struck at what moved within its reach. Keeping still, or keeping clear of it, the spider would have lived.\"\nFrogText.MISSED = \"A frog's tongue slapped down beside you. You jumped clear.\"\nFrogText.CAUSE = \"frog\" -- (the end of a life's cause, LifeSession; Predator/Frog.CAUSE)\n\nreturn table.freeze(FrogText)\n",660,1846927608},{"Shared/UI/Heard","--!strict\n-- What the player can hear or see of something that is not at the spider (ROBLOX-92): a creature on the sill is told of (a notice, a caption, a status line) only to a spider\n-- that could perceive it, within earshot, or in clear sight of it and not too far. The rule is the one the wasp's taking of the rival has always used (Data/Wasp.rival,\n-- ROBLOX-70); the mate's arrival, notice and leaving (ROBLOX-80) use it too. Pure: checked in tests/wasp.luau and tests/client_mating.luau.\nlocal Data = require(script.Parent.Parent.Data.Wasp)\n\nlocal Heard = {}\n\n-- `distance` is the studs between the spider and the thing; `seen` whether the spider has a clear line of sight to it.\nfunction Heard.within(distance: number, seen: boolean): boolean\n\treturn distance <= Data.rival.earshotWu or (seen and distance <= Data.rival.sightWu)\nend\n\n-- The farthest distance at which anything can be perceived (the sight limit): beyond it a sight test is not needed.\nfunction Heard.farthest(): number\n\treturn math.max(Data.rival.earshotWu, Data.rival.sightWu)\nend\n\nreturn Heard\n",1070,2804642320},{"Shared/UI/HudLayout","--!strict\n-- Where the on-screen controls and the prompt panel go, in the safe area (ScreenInsets.CoreUISafeInsets: clear of notches,\n-- the home bar and Roblox's top bar). Pure, so tests/run.luau checks that prompts never sit under a touch button and stay\n-- wide enough to read, at phone, tablet and desktop sizes. SpiderInput builds the touch buttons from TOUCH_BUTTONS.\nlocal HudLayout = {}\n\nexport type Button = { action: string, label: string, x: number, y: number, size: number, right: boolean, textSize: number? }\nexport type Rect = { x0: number, y0: number, x1: number, y1: number }\n\n-- x, y: the button's top-left corner as an offset from the safe area's bottom-left (right = false) or bottom-right corner.\nHudLayout.TOUCH_BUTTONS = {\n\t{ action = \"Forward\", label = \"↑\", x = 78, y = -188, size = 52, right = false },\n\t{ action = \"Left\", label = \"←\", x = 22, y = -132, size = 52, right = false },\n\t{ action = \"Back\", label = \"↓\", x = 78, y = -76, size = 52, right = false },\n\t{ action = \"Right\", label = \"→\", x = 134, y = -132, size = 52, right = false },\n\t{ action = \"Jump\", label = \"Jump\\n(hold)\", x = -92, y = -102, size = 72, right = true },\n\t{ action = \"Cancel\", label = \"Cancel\", x = -166, y = -92, size = 60, right = true, textSize = 16 },\n\t{ action = \"Creep\", label = \"Creep\", x = -86, y = -172, size = 60, right = true },\n\t{ action = \"Drop\", label = \"Silk\", x = -86, y = -242, size = 60, right = true },\n\t{ action = \"Recenter\", label = \"Re-\\ncentre\", x = -160, y = -168, size = 52, right = true, textSize = 14 },\n\t{ action = \"Run\", label = \"Run\", x = 146, y = -242, size = 52, right = false, textSize = 14 },\n\t{ action = \"Feed\", label = \"Eat\", x = 22, y = -242, size = 52, right = false, textSize = 14 },\n\t{ action = \"Focus\", label = \"Focus\", x = -236, y = -242, size = 60, right = true, textSize = 14 },\n\t{ action = \"Eye\", label = \"Eye\", x = -156, y = -242, size = 60, right = true },\n\t-- The peacock spider (ROBLOX-31): Change (in the crack) beside Eat, Dance (the peacock spider, standing still) above Silk. Both start hidden.\n\t{ action = \"Choose\", label = \"Change\", x = 82, y = -252, size = 56, right = false, textSize = 13 },\n\t{ action = \"Display\", label = \"Dance\", x = -86, y = -306, size = 56, right = true, textSize = 14 },\n\t-- The lock (ROBLOX-110): a small button left of Cancel, by Jump; shown only while something can be locked or a lock holds.\n\t{ action = \"Lock\", label = \"Lock\", x = -226, y = -90, size = 50, right = true, textSize = 12 }, -- (12: \"Unlock\" fits its 44 px)\n} :: { Button }\n\nHudLayout.GAP = 12\nHudLayout.MIN_PROMPT_WIDTH = 260\nHudLayout.MAX_PROMPT_WIDTH = 760\n\n-- Short landscape safe areas need three rows rather than a tall stack: leave\n-- room for the prompt above them, including when Dance/Change are visible.\nlocal COMPACT = {\n\tFeed={16,-180}, Forward={76,-180}, Choose={136,-180},\n\tLeft={16,-120}, Right={136,-120}, Back={76,-60},\n\tFocus={-188,-180}, Display={-128,-180}, Drop={-68,-180},\n\tEye={-188,-120}, Recenter={-128,-120}, Creep={-68,-120},\n\tCancel={-128,-60}, Jump={-68,-60}, Lock={-188,-60}, Run={196,-60},\n}\n-- A short screen (under 450 px tall: a phone held sideways, whatever its width, ROBLOX-92: it was 568 px and wider only, so a 480 px phone had the tall stack) is laid out in three rows.\nfunction HudLayout.isShort(width: number, height: number): boolean\n\treturn width > 0 and height > 0 and height < 450\nend\nfunction HudLayout.layoutButton(b: Button, width: number, height: number): Button\n\tlocal short = HudLayout.isShort(width, height)\n\tif b.action == \"Run\" and width < 400 and not short then\n\t\tlocal copy = table.clone(b)\n\t\tcopy.x, copy.y = 22, -304\n\t\treturn copy\n\tend\n\t-- A narrow phone (under 400 px) has no room for Focus beside the left thumb's cluster: it goes one row up.\n\tif b.action == \"Focus\" and width < 400 and not short then\n\t\tlocal copy = table.clone(b)\n\t\tcopy.y = -320\n\t\treturn copy\n\tend\n\t-- ... nor for Lock left of Cancel: it goes up beside Focus.\n\tif b.action == \"Lock\" and width < 400 and not short then\n\t\tlocal copy = table.clone(b)\n\t\tcopy.x, copy.y = -158, -316\n\t\treturn copy\n\tend\n\tif short then\n\t\tlocal slot = COMPACT[b.action]\n\t\tif slot then\n\t\t\tlocal copy = table.clone(b)\n\t\t\tcopy.x, copy.y, copy.size = slot[1], slot[2], 52\n\t\t\tcopy.textSize = math.min(b.textSize or 18, 14)\n\t\t\treturn copy\n\t\tend\n\tend\n\treturn b\nend\n\nfunction HudLayout.buttonRect(b: Button, width: number, height: number): Rect\n\tb = HudLayout.layoutButton(b, width, height)\n\tlocal x0 = if b.right then width + b.x else b.x\n\tlocal y0 = height + b.y\n\treturn { x0 = x0, y0 = y0, x1 = x0 + b.size, y1 = y0 + b.size }\nend\n\n-- The touch buttons' combined top edge and the inner edges of the two thumb clusters.\nlocal function clusters(width: number, height: number): (number, number, number)\n\tlocal leftEdge, rightEdge, top = 0, width, height\n\tfor _, b in HudLayout.TOUCH_BUTTONS do\n\t\tlocal r = HudLayout.buttonRect(b, width, height)\n\t\tif b.right then rightEdge = math.min(rightEdge, r.x0) else leftEdge = math.max(leftEdge, r.x1) end\n\t\ttop = math.min(top, r.y0)\n\tend\n\treturn leftEdge, rightEdge, top\nend\n\n-- The prompt panel's horizontal span and its bottom edge (it grows upward as it wraps) for a safe area of this size.\n-- Keyboard and controller: centred near the bottom. Touch: between the thumb clusters when that leaves room to read,\n-- otherwise above them.\nfunction HudLayout.promptSpan(width: number, height: number, device: string): (number, number, number)\n\tlocal gap = HudLayout.GAP\n\tlocal x0, x1, bottom\n\tif device == \"touch\" then\n\t\tlocal leftEdge, rightEdge, top = clusters(width, height)\n\t\tif rightEdge - leftEdge - 2 * gap >= HudLayout.MIN_PROMPT_WIDTH then\n\t\t\tx0, x1, bottom = leftEdge + gap, rightEdge - gap, height - gap\n\t\telse\n\t\t\tx0, x1, bottom = gap, width - gap, top - gap\n\t\t\t-- (above the clusters on a short screen the panel reaches the top: keep it out of the Menu and Notebook stack)\n\t\t\tlocal strip = HudLayout.topLayout(width, height)\n\t\t\tif strip.stacked then x1 = math.min(x1, strip.notebook.x0 - gap) end\n\t\tend\n\telse\n\t\tx0, x1, bottom = 24, width - 24, height - 16\n\tend\n\tlocal extra = (x1 - x0) - HudLayout.MAX_PROMPT_WIDTH\n\tif extra > 0 then\n\t\tx0 += extra / 2\n\t\tx1 -= extra / 2\n\tend\n\treturn x0, x1, bottom\nend\n\n-- The Menu and Notebook buttons (ROBLOX-50) and the HUD's top column of status lines (day, notices, toasts, captions), laid out together so none\n-- covers another and every button is a touch target (at least MIN_TARGET px each way). Where the screen is wide enough the two buttons stack at\n-- the top right and the column gives up that strip on both sides (it stays centred); on a narrow phone they sit side by side in a row at the\n-- top and the column starts under them. Rects are offsets from the safe area's top-left corner.\nHudLayout.MIN_TARGET = 48\nHudLayout.TOP = { menuW = 80, notebookW = 104, h = 48, margin = 12, gap = 8, columnY = 8, columnInset = 16, minColumn = 300 }\nHudLayout.TOP_SHORT = { menuW = 64, notebookW = 92, h = 48, margin = 8, gap = 6, columnY = 8, columnInset = 16, minColumn = 260 }\nexport type Top = { menu: Rect, notebook: Rect, columnX0: number, columnX1: number, columnY: number, stacked: boolean }\nfunction HudLayout.topLayout(width: number, height: number): Top\n\tlocal t = HudLayout.TOP\n\t-- (ROBLOX-92) A short, narrow landscape phone (480 x 320) cannot spare a strip of 124 px on each side, and the column under a row of buttons would meet the prompts above the thumbs:\n\t-- there the buttons are a little narrower (still 48 px tall, wider than their words) and the stack fits.\n\tif HudLayout.isShort(width, height) and width - 2 * (t.margin + t.notebookW + t.gap) < t.minColumn then t = HudLayout.TOP_SHORT end\n\tlocal x1 = width - t.margin\n\tlocal side = t.margin + t.notebookW + t.gap -- the strip the buttons take on each side of a centred column\n\tif width - 2 * side >= t.minColumn then\n\t\tlocal menu = { x0 = x1 - t.menuW, y0 = t.columnY, x1 = x1, y1 = t.columnY + t.h }\n\t\tlocal notebook = { x0 = x1 - t.notebookW, y0 = menu.y1 + t.gap, x1 = x1, y1 = menu.y1 + t.gap + t.h }\n\t\treturn { menu = menu, notebook = notebook, columnX0 = side, columnX1 = width - side, columnY = t.columnY, stacked = true }\n\tend\n\tlocal menu = { x0 = x1 - t.menuW, y0 = t.columnY, x1 = x1, y1 = t.columnY + t.h }\n\tlocal notebook = { x0 = menu.x0 - t.gap - t.notebookW, y0 = t.columnY, x1 = menu.x0 - t.gap, y1 = t.columnY + t.h }\n\treturn { menu = menu, notebook = notebook, columnX0 = t.columnInset, columnX1 = width - t.columnInset, columnY = menu.y1 + t.gap, stacked = false }\nend\n\nfunction HudLayout.overlaps(a: Rect, b: Rect): boolean\n\treturn a.x0 < b.x1 and b.x0 < a.x1 and a.y0 < b.y1 and b.y0 < a.y1\nend\n\nreturn HudLayout\n",8647,2427696544},{"Shared/UI/InspectText","--!strict\n-- The words of Inspect mode (ROBLOX-90): the Settings row's button (its label and note are in Data/SettingsSpec), the refusal, the name line on entering it, the name line and the controls line on screen, the toast for a\n-- framing and what the touch buttons say. Button names come from ControlText for the device in use (PlayStation\n-- names on a PlayStation controller). Pure: checked in tests/inspect.luau.\nlocal ControlText = require(script.Parent.ControlText)\nlocal PeacockText = require(script.Parent.PeacockText)\n\nlocal InspectText = {}\n\nInspectText.BUTTON = \"Look closely\"\n-- The touch buttons while looking: Cancel becomes Back, Eye becomes View (the framings).\nInspectText.TOUCH_BACK = \"Back\"\nInspectText.TOUCH_VIEW = \"View\"\nInspectText.NOT_NOW = \"You cannot look closely now. Stand safely on a surface first\"\nInspectText.DANGER = \"The close look ends: something is coming\"\nInspectText.ENDED = \"The close look ends\"\nInspectText.FRAMINGS = { face = \"Face\", side = \"Side\", top = \"From above\" } :: { [string]: string }\n\n-- The name line on screen: the spider being looked at, with a capital.\nfunction InspectText.nameLine(appearance: string): string\n\treturn PeacockText.title(appearance)\nend\n\n-- The one line of controls on screen, for the device in use.\nfunction InspectText.hint(device: ControlText.Device): string\n\tlocal n = function(action: string): string return ControlText.name(device, action) end\n\tif device == \"gamepad\" then\n\t\treturn `{n(\"look\")}: orbit    {n(\"walk\")}: zoom    {n(\"eye\")}: face, side, top    {n(\"cancel\")} or {n(\"choose\")}: back`\n\telseif device == \"touch\" then\n\t\treturn `{n(\"look\")}: orbit    Pinch or {n(\"reel\")} {n(\"lower\")}: zoom    {InspectText.TOUCH_VIEW}: face, side, top    {InspectText.TOUCH_BACK}: leave`\n\tend\n\treturn `{n(\"look\")}: orbit    {n(\"zoom\")} or {n(\"reel\")} {n(\"lower\")}: zoom    {n(\"eye\")}: face, side, top    {n(\"cancel\")} or {n(\"choose\")}: back`\nend\n\n-- The toast when the framing changes.\nfunction InspectText.framing(id: string): string\n\treturn `Framing: {InspectText.FRAMINGS[id] or id}`\nend\n\n-- The crack's prompt, after the change-spider hint.\nfunction InspectText.holdHint(device: ControlText.Device): string\n\treturn `hold {ControlText.name(device, \"choose\")}: look closely`\nend\n\n-- (The controls card's mention of the close look is inside PeacockText.crackLine, ROBLOX-92: the same hold, in the crack's line.)\n\nreturn InspectText\n",2402,663564571},{"Shared/UI/LifeText","--!strict\n-- The words of the life clock and the retreat for the screen (ROBLOX-24), from Godot's habitat_loop.gd caption(): the day and\n-- the part of it, the one line for the time of day or hunger, and the retreat's prompt. Button names come from ControlText for\n-- the device in use (Godot's interact is the port's feed button, E; cancel is Q). Pure, checked in tests/life.luau.\nlocal ControlText = require(script.Parent.ControlText)\nlocal MateText = require(script.Parent.MateText)\n\nlocal LifeText = {}\n\nexport type Prompt = { title: string, hint: string }\n\n-- ROBLOX-106 (W4): the night in the garden (Life/Nature) and the end of a life in the standard rules. Nothing tells the dusk but the light.\nLifeText.NIGHT_LINE = \"The night found the spider.\"\nLifeText.NIGHT_SUB = \"Out on the ground after dark, something that hunts there found it.\"\nLifeText.NIGHT_COLD = \"A cold night in the open, and something passed close by. You are stiff and slow until the morning warms.\"\n-- The end screen's last line in the standard rules (Easy and Free play keep theirs): what \"Back to your last rest\" costs, and what another spider is.\nLifeText.DAY_LOST = \"In Normal a death loses the day: back at your last rest, the meals, the growth and what you saw since then are gone (the notebook keeps its pages). Another spider is a new life from the start.\"\nLifeText.NO_REST = \"There is no rest to go back to. Another spider is a new life from the start.\"\nfunction LifeText.dayLost(hasRest: boolean): string\n\treturn if hasRest then LifeText.DAY_LOST else LifeText.NO_REST\nend\n\n-- \"Day 2, evening\".\nfunction LifeText.day(day: number, part: string): string\n\treturn `Day {day}, {part}`\nend\n\n-- The line under the day (Godot's precedence, among the lines this port has): starving, hungry, night, evening; nil otherwise.\n-- `gentle` rules never say starving (Godot: is_starving() and not gentle).\nfunction LifeText.line(part: string, energy: number, starving: boolean, gentle: boolean, hungryAt: number, weak: boolean?): string?\n\tif weak and not gentle then return \"Starving: your spider will not last another day. Too hungry to sleep; find food.\" end\n\tif starving and not gentle then\n\t\treturn \"Starving: your spider's reserve is gone. It must eat soon.\"\n\tend\n\tif energy <= hungryAt then\n\t\treturn \"Hungry: time to hunt.\"\n\tend\n\tif part == \"night\" then\n\t\treturn \"It is dark, and your eyes reach only a little way. Home is the silk-lined crack at the west end.\"\n\tend\n\tif part == \"evening\" then\n\t\treturn \"Evening. Jumping spiders go into their silk retreat before dark.\"\n\tend\n\treturn nil\nend\n\n-- The HUD bar's label (ROBLOX-78), the Minecraft way: the bar is the spider's hunger, FULL when it is fed and emptying as it grows hungry, and\n-- eating fills it. `fed` is the reserve, 0 to 1; the word after it is the same one the line under the day uses.\nfunction LifeText.hunger(fed: number, gentle: boolean): string\n\tlocal v = math.clamp(fed, 0, 1)\n\treturn string.format(\"Hunger %d%%\", math.floor(v * 100 + 0.5)) .. (if gentle then \" · gentle\" elseif v <= 0 then \" · starving\" elseif v <= 0.25 then \" · hungry\" else \"\")\nend\n\n-- ROBLOX-96: the homes, by the retreat's id on the map (World/WorldMap): what each is called in the prompts, how a rest there is told, and where it is. The crack\n-- is the default and every word of it is as it was; the gap under the bed's stone is the first garden home. A retreat this table does not know reads as the crack.\nLifeText.HOMES = {\n\tsill_crevice = {\n\t\tname = \"the silk-lined crack\", -- \"Asleep in the silk-lined crack\", \"Resting in the silk-lined crack\"\n\t\ttitle = \"The silk-lined crack\", -- the prompt when the spider can rest\n\t\thome = \"Home: the silk-lined crack\", -- the line near home\n\t\tway = \"Walk through the silk-framed opening under the wooden roof, then stop to rest.\",\n\t\tkept = \"Last rest kept.\", -- (CheckpointStore's own words, kept as they were)\n\t},\n\tbed_a_stone = {\n\t\tname = \"under the stone\",\n\t\ttitle = \"Under the stone\",\n\t\thome = \"Home: under the stone\",\n\t\tway = \"Walk into the gap under the big stone in the bed, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the stone.\",\n\t},\n\t-- ROBLOX-112: the first home inside, the gap under the toaster on the kitchen's counter\n\tkitchen_toaster = {\n\t\tname = \"under the toaster\",\n\t\ttitle = \"Under the toaster\",\n\t\thome = \"Home: under the toaster\",\n\t\tway = \"Walk into the gap under the toaster on the counter, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the toaster.\",\n\t},\n\t-- ROBLOX-116: the ranger hut's homes, inside and in its garden\n\thut_desk_drawer = {\n\t\tname = \"under the drawer\",\n\t\ttitle = \"Under the drawer\",\n\t\thome = \"Home: under the desk's drawer\",\n\t\tway = \"Walk into the gap under the desk's drawer, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the drawer.\",\n\t},\n\thut_board_gap = {\n\t\tname = \"behind the notice board\",\n\t\ttitle = \"Behind the notice board\",\n\t\thome = \"Home: behind the notice board\",\n\t\tway = \"Walk into the gap behind the notice board, then stop to rest.\",\n\t\tkept = \"Last rest kept, behind the notice board.\",\n\t},\n\tgarden_a1_trough = {\n\t\tname = \"under the trough\",\n\t\ttitle = \"Under the trough\",\n\t\thome = \"Home: under the trough\",\n\t\tway = \"Walk into the gap under the trough by the hut, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the trough.\",\n\t},\n\tgarden_a3_stone = {\n\t\tname = \"under the stone\",\n\t\ttitle = \"Under the stone\",\n\t\thome = \"Home: under the stone\",\n\t\tway = \"Walk into the gap under the flat stone in the grass, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the stone.\",\n\t},\n\tgarden_d3_mulch = {\n\t\tname = \"under the bark chip\",\n\t\ttitle = \"Under the bark chip\",\n\t\thome = \"Home: under the bark chip\",\n\t\tway = \"Walk into the gap under the bark chip in the mulch, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the bark chip.\",\n\t},\n\t-- ROBLOX-118: the darkest place in the hut, the gap under the back room's sofa\n\troom_sofa_under = {\n\t\tname = \"under the sofa\",\n\t\ttitle = \"Under the sofa\",\n\t\thome = \"Home: under the sofa\",\n\t\tway = \"Walk in under the sofa in the back room, deep into the dark, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the sofa.\",\n\t},\n\t-- ROBLOX-119: the meadow's edge and the bench patch\n\tmeadow_b2_leaf = {\n\t\tname = \"under the curled leaf\",\n\t\ttitle = \"Under the curled leaf\",\n\t\thome = \"Home: under the curled leaf\",\n\t\tway = \"Walk in under the curled dead leaf in the meadow's grass, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the curled leaf.\",\n\t},\n\tbench_slats = {\n\t\tname = \"the gap in the bench's slats\",\n\t\ttitle = \"The gap in the bench's slats\",\n\t\thome = \"Home: the gap in the bench's slats\",\n\t\tway = \"Climb down into the gap between the bench's seat slats, then stop to rest.\",\n\t\tkept = \"Last rest kept, in the bench's slats.\",\n\t},\n\tbin_lip = {\n\t\tname = \"under the bin's lip\",\n\t\ttitle = \"Under the bin's lip\",\n\t\thome = \"Home: under the bin's lip\",\n\t\tway = \"Walk in under the litter bin's base, between its feet, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the bin's lip.\",\n\t},\n\t-- ROBLOX-122: the pond's edge and the boardwalk\n\tdeck_gap = {\n\t\tname = \"the gap in the boardwalk\",\n\t\ttitle = \"The gap in the boardwalk\",\n\t\thome = \"Home: the gap in the boardwalk\",\n\t\tway = \"Climb down into the wide gap between two of the boardwalk's boards, then stop to rest.\",\n\t\tkept = \"Last rest kept, in the boardwalk's gap.\",\n\t},\n\tpond_stone = {\n\t\tname = \"under the flat stone\",\n\t\ttitle = \"Under the flat stone\",\n\t\thome = \"Home: under the flat stone\",\n\t\tway = \"Walk in under the flat stone on the pond's bank, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the flat stone.\",\n\t},\n\tcattail_leaf = {\n\t\tname = \"under the dead cattail leaf\",\n\t\ttitle = \"Under the dead cattail leaf\",\n\t\thome = \"Home: under the dead cattail leaf\",\n\t\tway = \"Walk in under the curled dead cattail leaf on the pond's bank, then stop to rest.\",\n\t\tkept = \"Last rest kept, under the cattail leaf.\",\n\t},\n} :: { [string]: { name: string, title: string, home: string, way: string, kept: string } }\nLifeText.DEFAULT_HOME = \"sill_crevice\"\nlocal function homeOf(retreat: string?): { name: string, title: string, home: string, way: string, kept: string }\n\treturn LifeText.HOMES[retreat or LifeText.DEFAULT_HOME] or LifeText.HOMES[LifeText.DEFAULT_HOME]\nend\nlocal function inWords(name: string): string\n\treturn if string.sub(name, 1, 6) == \"under \" then name else \"in \" .. name\nend\n\n-- The retreat's prompt: asleep, resting, or able to rest (sleep in the evening and at night); nil when none of these. `extra` (the crack's\n-- way to change spider, ROBLOX-31) is added to the resting hint. `retreat` (ROBLOX-96): which home, by its id; the crack when nil.\nfunction LifeText.prompt(asleep: boolean, resting: boolean, canRest: boolean, sleepTime: boolean, device: ControlText.Device, extra: string?, retreat: string?): Prompt?\n\tlocal feed, cancel = ControlText.name(device, \"feed\"), ControlText.name(device, \"cancel\")\n\tlocal h = homeOf(retreat)\n\tif asleep then\n\t\treturn { title = `Asleep {inWords(h.name)}`, hint = `The night passes. Move, {feed} or {cancel} to wake.` }\n\tend\n\tif resting then\n\t\treturn { title = `Resting {inWords(h.name)}`, hint = `Move, {feed} or {cancel} to leave.` .. (if extra and extra ~= \"\" then \"    \" .. extra else \"\") }\n\tend\n\tif canRest then\n\t\treturn { title = h.title, hint = if sleepTime then `{feed}: sleep until morning` else `{feed}: rest` }\n\tend\n\treturn nil\nend\n\n-- The line near a home when there is no prompt (ROBLOX-96): \"Home: the silk-lined crack\" and how to get in, or, inside it, how to rest. `retreat` is the home's id.\nfunction LifeText.homeLine(retreat: string?, inside: boolean, device: ControlText.Device): Prompt\n\tlocal h = homeOf(retreat)\n\treturn { title = h.home, hint = if inside then `Keep still on a surface, then {ControlText.name(device, \"feed\")}: rest` else h.way }\nend\n\n-- What a kept rest says (ROBLOX-96): the store's own words for the crack, and the place for any other home. `message` is what the store said.\nfunction LifeText.restKept(retreat: string?, message: string): string\n\tif retreat == nil or retreat == LifeText.DEFAULT_HOME or LifeText.HOMES[retreat] == nil then return message end\n\treturn homeOf(retreat).kept\nend\n\n-- What the touch feed button says when it is the retreat's (nil: it is the meal's, or hidden).\nfunction LifeText.touchLabel(asleep: boolean, resting: boolean, canRest: boolean, sleepTime: boolean): string?\n\tif asleep then return \"Wake\" end\n\tif resting then return \"Leave\" end\n\tif canRest then return if sleepTime then \"Sleep\" else \"Rest\" end\n\treturn nil\nend\n\n-- Why a rest is not kept as the last rest (ROBLOX-92), in the game's own words. The keys are the reasons Persistence/Checkpoint.boundaryProblem gives (engineering words, never\n-- shown); a reason this table does not know says LifeText.REST_FALLBACK, and tests/checkpoint.luau checks that every reason the sim can give is known.\nLifeText.REST_FALLBACK = \"Not now\"\nLifeText.KEEP_FAILED = \"This rest could not be kept\"\nLifeText.REST_REFUSALS = {\n\t[\"the spider is not standing on a surface\"] = \"Not now — stand still on a surface first\",\n\t[\"the spider is moving\"] = \"Not now — keep still first\",\n\t[\"the rival in the jaws is still struggling\"] = \"Not while a fight is on\",\n\t[\"the spider is eating its rival\"] = \"Not while you are feeding\",\n\t[\"the two spiders are together\"] = MateText.REST_TOGETHER,\n\t[\"the brood is hatching\"] = MateText.REST_HATCHING,\n\t[\"the spider is feeding\"] = \"Not while you are feeding\",\n\t[\"the prey in the jaws is still struggling\"] = \"Not while a fight is on\",\n\t[\"a strike is still in progress\"] = \"Not now — wait for the strike to finish\",\n} :: { [string]: string }\nfunction LifeText.restRefusal(reason: string): string\n\treturn LifeText.REST_REFUSALS[reason] or LifeText.REST_FALLBACK\nend\n\n-- ROBLOX-96: what the meal line says of the prey in the jaws, by its kind (Species body.prey_kind): how many of it make a housefly meal, and how finely the count is\n-- shown (halves for the sill's prey, as always; tenths for the bed's smaller ones, so a gnat's third shows).\nLifeText.MEALS = {\n\tfruit_fly = { rule = \"2 small prey = 1 housefly\", step = 2 },\n\tfungus_gnat = { rule = \"3 gnats = 1 housefly\", step = 10 },\n\taphid = { rule = \"6 aphids = 1 housefly\", step = 10 },\n\t-- ROBLOX-101: the bestiary's\n\tspringtail = { rule = \"8 springtails = 1 housefly\", step = 10 },\n\tleafhopper = { rule = \"2 leafhoppers = 1 housefly\", step = 2 },\n\tmoth = { rule = \"1 moth = 1 housefly\", step = 2 },\n\tcrane_fly = { rule = \"1 crane fly = 2 houseflies\", step = 2 },\n\thoverfly = { rule = \"2 hoverflies = 3 houseflies\", step = 2 }, -- (ROBLOX-117)\n} :: { [string]: { rule: string, step: number } }\nlocal DEFAULT_MEAL = { rule = \"2 small prey = 1 housefly\", step = 2 }\n\n-- Housefly-equivalent meals: a small prey counts as half. Partial feeding is retained. `kind` (ROBLOX-96): the prey in the jaws, for the rule it says.\nfunction LifeText.growth(g: any, required: number, meal: number, kind: string?): string\n if g:isAdult() then return \"Adult: keep your hunger bar full.\" end\n if g:isMoulting() then return \"Moulting: stay in the crack.\" end\n if g.ready then return \"Ready to moult: rest in the crack.\" end\n -- (ROBLOX-88: the goal is the growth's own, 3 by Godot's rule and 5 in the game; `required` and `meal` serve a growth that cannot say.)\n local goal = if g.mealGoal ~= nil then g:mealGoal() else math.ceil(required / meal)\n required = if g.readyAt ~= nil then g:readyAt() else required\n local rule = LifeText.MEALS[kind or \"\"] or DEFAULT_MEAL\n local count = math.min(goal, math.floor(g.fedSinceMoult / required * goal * rule.step + 1e-8) / rule.step)\n return `Next moult: {count} of {goal} meals · {rule.rule}`\nend\n-- ROBLOX-113 (W5, Shared/UI/QuietHud): the growth line in Normal after the first day: the count without the prey's rule (\"Next moult: 2 of 5 meals\"), \"Ready to moult\",\n-- or nothing (moulting: the prompt's title says it; an adult: the day line's stage says it). The arguments are growth's.\nfunction LifeText.growthQuiet(g: any, required: number, meal: number, kind: string?): string?\n\tif g:isAdult() or g:isMoulting() then return nil end\n\tif g.ready then return \"Ready to moult\" end\n\tlocal full = LifeText.growth(g, required, meal, kind)\n\treturn string.match(full, \"^(.-) · \") or full\nend\nreturn LifeText\n",14217,1473211855},{"Shared/UI/MateText","--!strict\n-- The words of the mating cycle for the screen (ROBLOX-80): the notices for each beat Life/Mating reports, the status line while courting and while\n-- guarding the sac, the captions, the ending card of the hatching and the toast of the next generation. Button names come from ControlText for the device in\n-- use. The game is for children and about nature: nothing is shown or said about the mating but that the two spiders stay together a moment.\n-- Pure: checked in tests/client_mating.luau.\nlocal ControlText = require(script.Parent.ControlText)\n\nlocal MateText = {}\n\nMateText.TITLE = \"The sill continues\"\nMateText.BUTTON = \"Carry on\"\nMateText.METER = \"Courtship\"\n\n-- The words for the mate: \"male\" or \"female\".\nlocal function kind(sex: string): string\n\treturn if sex == \"male\" then \"a male spider\" else \"a female spider\"\nend\n\n-- A mate came onto the sill. The peacock spider is told that its dance is the way to court it.\nfunction MateText.arrived(sex: string, needsDance: boolean, device: ControlText.Device): string\n\tlocal line = `A visitor: {kind(sex)} has come onto the sill. Walk close, face it and keep still.`\n\tif needsDance then line ..= ` Dance for it ({ControlText.name(device, \"display\")}).` end\n\treturn line\nend\n\nMateText.NOTICED = \"It has seen you.\"\nMateText.DRIVEN = \"You frightened it. It leaves the sill for today.\"\nMateText.COURTED = \"The two spiders stay together for a moment.\"\nMateText.MATED = \"They have parted. The visitor walks away and will not come again.\"\nMateText.SAC = \"An egg sac, made in the night, hangs in the crack. Rest in the crack to pass the nights.\"\nMateText.GUARD_DAY = \"Second day with the eggs. They hatch tomorrow morning.\"\nMateText.HATCHING = \"The eggs are hatching!\"\n-- ROBLOX-91: the mating gate (a full-grown spider with energy of at least 0.6, at a rest) said nothing when it was the hunger that was missing.\nMateText.TOO_HUNGRY = \"Too hungry for a visitor to come. Eat well, then rest in the crack again.\"\n\n-- ROBLOX-92: the mating scene can be skipped after four seconds and said nothing of it. From then on the scene shows what ends it (its status line, not a sound\n-- caption: the Captions setting does not hide it), by the device in use; on touch the Jump button is relabelled Skip for the scene, as it is Grip for a struggle.\nMateText.TOUCH_SKIP = \"Skip\"\nfunction MateText.skipLine(device: ControlText.Device): string\n\tlocal jump = if device == \"touch\" then MateText.TOUCH_SKIP else ControlText.name(device, \"jump\")\n\treturn `{jump} or {ControlText.name(device, \"cancel\")}: part`\nend\n\n-- ROBLOX-92: why a rest is not kept as the last rest, in the game's own words (LifeText.restRefusal maps the rest of the reasons).\nMateText.REST_TOGETHER = \"Not now — the two of you are together\"\nMateText.REST_HATCHING = \"Not while the brood is hatching\"\n\n-- The end screen's choice to go on as a new spider (ROBLOX-91): a new life, not the family's: the sac and the generation are left behind. While there is an egg sac (or a\n-- hatched brood not yet carried on) it says so; \"Back to your last rest\" keeps them (the rest has them).\nMateText.ANOTHER = \"Continue as another spider\"\nMateText.ANOTHER_BROOD = \"Continue as another spider (a new life: the brood is lost)\"\nfunction MateText.another(hasSac: boolean): string\n\treturn if hasSac then MateText.ANOTHER_BROOD else MateText.ANOTHER\nend\n\n-- ROBLOX-106: a courtship that failed (the standard rules). The mate refuses on a full meter, by the spider's condition and the court's quality (Life/Mating.acceptChance):\n-- the words say which weighed most, \"thin\" (the reserve) or \"clumsy\" (breaks, distance, facing, length), or \"choosy\" when neither was at fault. Or the rival cut in. Each is the end of that day's visit; a\n-- visitor may come the next morning (Life/Mating: the cycle wants one until the pair have mated), and the words say no more than that.\nMateText.REJECTED_THIN = {\n\tfemale = \"She turns away and walks off. She will not take a male this thin. A visitor may come again tomorrow.\",\n\tmale = \"He turns away from a female this thin and walks off. A visitor may come again tomorrow.\",\n}\nMateText.REJECTED_CLUMSY = {\n\tfemale = \"She turns away and walks off: the courtship faltered. A visitor may come again tomorrow.\",\n\tmale = \"He turns away and walks off: the courtship faltered. A visitor may come again tomorrow.\",\n}\nMateText.REJECTED_CHOOSY = {\n\tfemale = \"She watches, then turns away and walks off. Not every female takes a male. A visitor may come again tomorrow.\",\n\tmale = \"He watches, then turns away and walks off. Not every male stays. A visitor may come again tomorrow.\",\n}\nMateText.CUT = \"The other spider pushed in, and the visitor fled the sill for today.\"\nfunction MateText.rejected(sex: string, why: string): string\n\tlocal t = if why == \"thin\" then MateText.REJECTED_THIN elseif why == \"choosy\" then MateText.REJECTED_CHOOSY else MateText.REJECTED_CLUMSY\n\treturn if sex == \"female\" then t.female else t.male\nend\n\n-- Why the mate left the sill, as a notice (the reasons Predator/Mate gives); \"mated\" is said by MATED already.\nfunction MateText.gone(reason: string): string?\n\tif reason == \"dusk\" then return \"The visitor has gone for the evening. It may come back in the morning.\" end\n\tif reason == \"rest\" then return \"The visitor wandered off while you rested.\" end\n\tif reason == \"sex\" then return \"The visitor is not interested and leaves.\" end\n\tif reason == \"driven\" or reason == \"rejected\" or reason == \"cut\" then return nil end -- (told when it happened)\n\treturn nil\nend\n\n-- The notice for an event of Mating.tick (and \"sac\" from Mating.woke), or nil when the event has no words. `ctx`: sex (the mate's), needsDance, device, reason.\nfunction MateText.notice(event: string, ctx: { sex: string?, needsDance: boolean?, device: ControlText.Device?, reason: string? }): string?\n\tif event == \"arrived\" then return MateText.arrived(ctx.sex or \"male\", ctx.needsDance == true, ctx.device or \"keyboard\") end\n\tif event == \"noticed\" then return MateText.NOTICED end\n\tif event == \"driven\" then return MateText.DRIVEN end\n\tif event == \"courted\" then return MateText.COURTED end\n\tif event == \"mated\" then return MateText.MATED end\n\tif event == \"gone\" then return MateText.gone(ctx.reason or \"\") end\n\tif event == \"sac\" then return MateText.SAC end\n\tif event == \"guard_day\" then return MateText.GUARD_DAY end\n\tif event == \"hatched\" then return MateText.HATCHING end\n\tif event == \"rejected_thin\" then return MateText.rejected(ctx.sex or \"male\", \"thin\") end\n\tif event == \"rejected_clumsy\" then return MateText.rejected(ctx.sex or \"male\", \"clumsy\") end\n\tif event == \"rejected_choosy\" then return MateText.rejected(ctx.sex or \"male\", \"choosy\") end\n\tif event == \"cut\" then return MateText.CUT end\n\treturn nil\nend\n\n-- The status line while a mate is on the sill and courtable: what the meter wants. `near`: within courting range; `dancing`: the peacock spider's dance is up.\nfunction MateText.courtLine(device: ControlText.Device, near: boolean, needsDance: boolean, dancing: boolean, percent: number): string\n\tif not near then return \"A visitor is on the sill. Walk close to it.\" end\n\tif needsDance and not dancing then\n\t\treturn `Courting: dance in front of it ({ControlText.name(device, \"display\")})`\n\tend\n\tlocal p = math.floor(math.clamp(percent, 0, 1) * 100 + 0.5)\n\treturn `Courting {p}%: face it and keep still`\nend\n\n-- The status line while the sac is guarded: guard day `day` of `days`.\nfunction MateText.guardLine(day: number, days: number): string\n\treturn `Guarding the eggs: day {day} of {days}. Rest in the crack to pass the nights.`\nend\n\n-- The captions of the mating scene (ROBLOX-89; Settings: Captions), by the scene's seconds. Device-neutral (nothing here names a button). `playerSex` is the played spider's:\n-- the first spider is the game's female (\"She turns to face him.\"), the peacock spider the male (\"She turns to face you.\"). The last beat is the mirror when the player is\n-- the male: the female turns away and stays, and the player goes on. The game is for children and about nature: they touch, they settle, one goes.\nMateText.SCENE_TURN_FEMALE = \"She turns to face him.\"\nMateText.SCENE_TURN_MALE = \"She turns to face you.\"\nMateText.SCENE_TOUCH = \"They touch, very lightly, with their front legs and palps.\"\nMateText.SCENE_SETTLE = \"They settle together, still.\"\nMateText.SCENE_GOES = \"He goes. The sill is yours again.\"\nMateText.SCENE_STAYS = \"She stays. You go on.\"\nfunction MateText.matingCaption(seconds: number, playerSex: string): { text: string, alpha: number }?\n\tif seconds < 0 then return nil end\n\tlocal text: string\n\tif seconds < 3 then text = if playerSex == \"male\" then MateText.SCENE_TURN_MALE else MateText.SCENE_TURN_FEMALE\n\telseif seconds < 7 then text = MateText.SCENE_TOUCH\n\telseif seconds < 11 then text = MateText.SCENE_SETTLE\n\telseif seconds < 15 then text = if playerSex == \"male\" then MateText.SCENE_STAYS else MateText.SCENE_GOES\n\telse return nil end\n\treturn { text = text, alpha = 1 }\nend\n\n-- The notebook's dated line for the page \"Eggs, silk and wind\" (a thing the player saw; ROBLOX-89): the day, and who came.\nfunction MateText.entry(day: number, mateSex: string): string\n\tif mateSex == \"female\" then\n\t\treturn `Day {day}: A female was on the sill. The two spiders stayed together a while, and then you went on.`\n\tend\n\treturn `Day {day}: A male came to the sill. The two spiders stayed together a while, and then he went.`\nend\n-- The captions of the hatching scene, by the seconds since it began.\nfunction MateText.sceneCaption(seconds: number): { text: string, alpha: number }?\n\tif seconds < 0 then return nil end\n\tif seconds < 9 then return { text = \"[tiny rustling from the egg sac]\", alpha = 1 } end\n\tif seconds < 24 then return { text = \"[silk threads lift the spiderlings away]\", alpha = 1 } end\n\treturn nil\nend\n\n-- The ending card: the title, the line about the generation and the body (the brood, the day). `brood` is the number of spiderlings that hatched.\n-- ROBLOX-120: in the preserve (`wind`) the body offers the two ways on: follow one on the wind, or stay at the hut as one of them.\nfunction MateText.card(brood: number, day: number, generation: number, wind: boolean?): (string, string, string)\n\tlocal sub = `{brood} spiderlings hatched on day {day}, climbed into the light and floated away on silk, one by one.`\n\tlocal body = if wind == true then `You were generation {generation + 1}. Follow one of them on the wind to wherever it comes down, or stay at the hut as one of them, small again in the same crack.`\n\t\telse `You were generation {generation + 1}. You carry on as one of them, small again, in the same crack on the same sill.`\n\treturn MateText.TITLE, sub, body\nend\n-- (ROBLOX-120) The card's two ways on in the preserve (Life/Ballooning), the ride's caption and the words where it lands.\nMateText.FOLLOW = \"Follow one\"\nMateText.STAY = \"Stay at the hut\"\nMateText.RIDE_CAPTION = \"[the wind takes the thread]\"\nfunction MateText.landed(place: string): string\n\treturn `The thread came down in {place}. A new life begins here, in the wild.`\nend\n-- The notebook's dated line for \"Eggs, silk and wind\" when one was followed.\nfunction MateText.rideEntry(day: number, place: string): string\n\treturn `Day {day}: One spiderling went up on its thread, and the wind set it down in {place}.`\nend\n\n-- The toast of the new generation. `generation` is the number carryOn returns (1 for the first carry on); the first spider is generation 1. ROBLOX-120: `place`, where\n-- it landed when it was followed on the wind (nil: it stayed at the hut).\nfunction MateText.generationToast(generation: number, day: number, place: string?): string\n\tif place ~= nil then return `Generation {generation + 1} — hatched on day {day}, landed in {place}` end\n\treturn `Generation {generation + 1} — hatched on day {day}`\nend\n\n-- The day line's tag (\"\" while the family is the first).\nfunction MateText.dayTag(generation: number): string\n\treturn if generation > 0 then ` | Generation {generation + 1}` else \"\"\nend\n\nreturn MateText\n",11986,2292052400},{"Shared/UI/NotebookText","--!strict\n-- The notebook's words and its layout rules for the screen (ROBLOX-37), from Godot's notebook_panel.gd: the heading, the empty\n-- page, \"In this game:\" and the sources, the note that a page opened, and how to open and use the book on the device in use. Pure,\n-- so tests/notebook.luau checks them (and the layout at phone, tablet and desktop sizes) without Roblox. Button names come from\n-- ControlText (PlayStation names on a PlayStation controller).\nlocal ControlText = require(script.Parent.ControlText)\nlocal TarantulaText = require(script.Parent.TarantulaText)\n\nlocal NotebookText = {}\n\nNotebookText.HEADING = \"Field notebook\"\nNotebookText.EMPTY = \"Pages appear here as you play.\"\nNotebookText.GAME = \"In this game: \"\nNotebookText.CLOSE = \"Close\"\nNotebookText.PAGES = \"Pages\"\nNotebookText.MENU_CHOICE = \"Notebook\"\nNotebookText.BUTTON = \"Notebook\"\n\n-- Fills {reel}, {letGo}, {drop}, {focus}, {display} (any ControlText action name) in a page's \"In this game\" line with the device's name for it. {display} is the\n-- display key (ROBLOX-92: the tarantula page's rear-up); on touch its button is the tarantulas' own, \"Rear up\", not the peacock's \"Dance\".\nfunction NotebookText.fill(text: string, device: ControlText.Device): string\n\tlocal out = string.gsub(text, \"{(%w+)}\", function(action: string): string\n\t\tlocal name = if action == \"display\" and device == \"touch\" then TarantulaText.touchDisplay(false) else ControlText.name(device, action)\n\t\treturn if name ~= \"\" then name else \"{\" .. action .. \"}\"\n\tend)\n\treturn out\nend\n\n-- The page's \"In this game: ...\" line, or nil when the page has none (Godot: an empty `game` shows nothing).\nfunction NotebookText.gameLine(game: string, device: ControlText.Device): string?\n\tif game == \"\" then\n\t\treturn nil\n\tend\n\t\n\treturn NotebookText.GAME .. NotebookText.fill(game, device)\nend\n\n-- ROBLOX-89: the lines the game has added to a page (\"Day 4: ...\"), under the page's \"In this game\" line, or nil when there are none.\nNotebookText.SEEN = \"Things you saw:\"\nfunction NotebookText.seenText(entries: { { day: number, text: string } }): string?\n\tif #entries == 0 then return nil end\n\tlocal lines = { NotebookText.SEEN }\n\tfor _, e in entries do table.insert(lines, e.text) end\n\treturn table.concat(lines, \"\\n\")\nend\n\n-- \"Source: x\" for one source, \"Sources:\\nx\\ny\" for several. The links stay in the text as they are.\nfunction NotebookText.sourcesText(sources: { string }): string\n\treturn (if #sources == 1 then \"Source: \" else \"Sources:\\n\") .. table.concat(sources, \"\\n\")\nend\n\n-- How to open the notebook, on the device in use: N on a keyboard; the Notebook button on touch; a controller has no spare button (the\n-- D-pad walks), so it is the life menu (View, or the Touchpad on a PlayStation controller) and then Notebook.\nfunction NotebookText.openHint(device: ControlText.Device): string\n\tif device == \"gamepad\" then\n\t\treturn `{ControlText.name(\"gamepad\", \"menu\")}, then {NotebookText.MENU_CHOICE},`\n\telseif device == \"touch\" then\n\t\treturn `the {NotebookText.BUTTON} button`\n\tend\n\treturn ControlText.name(\"keyboard\", \"notebook\")\nend\n\n-- The note when a page opens during play (Godot: \"New in your notebook: %s\\n(%s to read)\").\nfunction NotebookText.note(title: string, device: ControlText.Device): string\n\treturn `New in your notebook: {title}\\n({NotebookText.openHint(device)} to read)`\nend\n\n-- The line under the page: what the controls do, on the device in use. `stacked`: one pane at a time (small screens).\nfunction NotebookText.controls(device: ControlText.Device, stacked: boolean): string\n\tlocal back = ControlText.name(device, \"cancel\")\n\tif device == \"gamepad\" then\n\t\tlocal a = ControlText.name(\"gamepad\", \"jump\")\n\t\treturn `Stick or D-pad: pages    {a}: open    Right stick: scroll    {back}: {if stacked then \"back / close\" else \"close\"}`\n\telseif device == \"touch\" then\n\t\treturn `Tap a page. Drag to scroll.`\n\tend\n\treturn `Up and Down: pages    {if stacked then \"Enter: open    Left and Right: previous and next    \" else \"\"}Wheel, PageUp or PageDown: scroll    N or {back}: close`\nend\n\n-- ---------------------------------------------------------------- layout\n\n-- Text sizes by kind at normal text, and the large-text option's factor (the life menu's switch: the Player attribute LargeText).\nNotebookText.SIZES = { heading = 26, title = 24, body = 19, game = 17, sources = 14, button = 18, controls = 14 }\nNotebookText.LARGE = 1.5\n-- A touch target is at least this tall (before the text scale).\nNotebookText.MIN_TARGET = 44\n\nexport type Layout = { sideBySide: boolean, listFraction: number }\n\n-- Side by side (the pages on the left, the page on the right) needs room; a phone held sideways, a portrait phone or large text\n-- show one pane at a time instead. `width` and `height` are the safe area's, `scale` the text scale (1 to LARGE).\nfunction NotebookText.layout(width: number, height: number, scale: number): Layout\n\tlocal sideBySide = width >= 640 * scale and height >= 340\n\treturn { sideBySide = sideBySide, listFraction = if sideBySide then 0.34 else 1.0 }\nend\n\nexport type Metrics = { paperW: number, paperH: number, head: number, hint: number, foot: number, body: number }\n\n-- Pixel sizes of the panel for a safe area of this size: the paper (97% by 95%, at most 1040 by 820), the heading band, the controls\n-- line (two lines of text; 0 when the pages would be left with less than MIN_BODY px without it), the footer's buttons and the height\n-- left for the pages (what scrolls). Pure, so a short screen can be checked: a phone held sideways is 568 by 320.\nNotebookText.MIN_BODY = 120\nfunction NotebookText.metrics(width: number, height: number, scale: number): Metrics\n\tlocal paperW, paperH = math.min(width * 0.97, 1040), math.min(height * 0.95, 820)\n\tlocal head = math.floor((NotebookText.SIZES.heading + 10) * scale)\n\tlocal foot = math.floor((NotebookText.MIN_TARGET + 8) * scale)\n\tlocal hint = math.floor(5 * NotebookText.SIZES.controls * scale) + 4\n\tlocal body = paperH - 20 - head - foot - 12\n\tif body - hint >= NotebookText.MIN_BODY then\n\t\tbody -= hint\n\telse\n\t\thint = 0\n\tend\n\treturn { paperW = paperW, paperH = paperH, head = head, hint = hint, foot = foot, body = body }\nend\n\n\n-- Nathan requested an optional checklist on 2026-10-17 (ROBLOX-38).\n-- These are invitations, not all possible pages or a completion gate. No task asks a child to starve or get caught.\nNotebookText.TRY = {\n {id=\"bold_jumper\",text=\"Meet your spider and explore the sill.\"},\n {id=\"dragline\",text=\"Make a jump and see the safety silk.\"},\n {id=\"eight_eyes\",text=\"Switch to the spider-eye view.\"},\n {id=\"moving_retinas\",text=\"Spend a little time looking through its eyes.\"},\n {id=\"hunting_by_sight\",text=\"Focus on a fly until you recognise it.\"},\n {id=\"venom\",text=\"Catch a fly.\"},\n {id=\"drinking\",text=\"Finish a meal.\"},\n {id=\"retreat\",text=\"Rest inside the silk-lined crack.\"},\n {id=\"home_before_dark\",text=\"Sleep in the crack through a night.\"},\n {id=\"new_skin\",text=\"Eat, then rest when ready to moult.\"},\n {id=\"grown_up\",text=\"Grow through three moults.\"},\n {id=\"peacock_dance\",text=\"Change to the peacock (in Settings, or while resting), then dance outside.\"},\n {id=\"walking_like_an_ant\",text=\"Change to the ant mimic (in Settings, or while resting), then stand still.\"},\n {id=\"eggs_and_wind\",text=\"Raise a family: court a mate, guard the sac, watch the hatching.\"},\n {id=\"tarantula_cousins\",text=\"Change to a tarantula (in Settings, or while resting), then rear up outside.\"},\n}\nfunction NotebookText.checklist(book:any):string\n local lines={}\n for _,entry in NotebookText.TRY do\n  table.insert(lines,(if book:isOpen(entry.id) then \"[x] \" else \"[ ] \")..entry.text)\n end\n return table.concat(lines,\"\\n\\n\")\nend\n\nreturn NotebookText\n",7692,2877757824},{"Shared/UI/PeacockText","--!strict\n-- The words of the peacock spider for the screen (ROBLOX-31): choosing the spider in the crack, the dance's prompts and status\n-- line, the controls card's extra lines and the felt caption. Button names come from ControlText for the device in use. The dance's\n-- own words are never shown for the first spider; choosing is offered in the crack to both, or the peacock spider could not be found.\n-- Pure: checked in tests/peacock.luau.\nlocal ControlText = require(script.Parent.ControlText)\nlocal Peacock = require(script.Parent.Parent.Data.Peacock)\nlocal SpiderChoice = require(script.Parent.Parent.Rig.SpiderChoice)\nlocal AntMimicText = require(script.Parent.AntMimicText)\nlocal TarantulaText = require(script.Parent.TarantulaText)\n\nlocal PeacockText = {}\n\nPeacockText.NAMES = {\n\tfirst_spider = \"the first spider\", maratus_volans_male = \"the peacock spider\", myrmarachne_formicaria_female = \"the ant-mimicking spider\",\n\tbrachypelma_hamorii = \"the Mexican redknee\", chromatopelma_cyaneopubescens = \"the Greenbottle blue\",\n} :: { [string]: string }\nPeacockText.STAND = \"Stand still on a surface to dance\"\nPeacockText.NOT_RESTING = \"You can change spider while resting in the silk-lined crack\"\n-- The Settings row's refusal (ROBLOX-71): the spider stays as it was. Said as a toast and on the panel's own line.\nPeacockText.NOT_NOW = \"Your spider will not change now. Stand safely on a surface first\"\n\n-- A spider's name for a row or a button: the name, with its first letter capital.\nfunction PeacockText.title(id: string): string\n\tlocal name = PeacockText.NAMES[id] or id\n\treturn string.upper(string.sub(name, 1, 1)) .. string.sub(name, 2)\nend\n\n-- The controls card's pointer to the Settings row (ROBLOX-71): where to open it on the device in use.\nfunction PeacockText.settingsLine(device: ControlText.Device): string\n\tif device == \"gamepad\" then return `Spider: change it in Settings ({ControlText.name(\"gamepad\", \"menu\")}, then Settings)` end\n\tif device == \"touch\" then return \"Spider: change it in Menu, then Settings\" end\n\treturn `Spider: change it in Settings ({ControlText.name(device, \"settings\")}) when standing safe`\nend\n\n-- The crack's extra hint while resting: how to become the other spider.\nfunction PeacockText.change(device: ControlText.Device, current: string): string\n\tlocal other = SpiderChoice.next(current)\n\treturn `{ControlText.name(device, \"choose\")}: become {PeacockText.NAMES[other] or other}`\nend\n\nfunction PeacockText.changed(id: string): string\n\treturn `You are {PeacockText.NAMES[id] or id} now`\nend\n\n-- The walking hint's extra words for the peacock spider.\nfunction PeacockText.displayHint(device: ControlText.Device, dancing: boolean): string\n\tif dancing then return `{ControlText.name(device, \"display\")}: stop dancing` end\n\treturn `{ControlText.name(device, \"display\")}: courtship dance`\nend\n\n-- The status line while the dance runs.\nfunction PeacockText.dancingLine(device: ControlText.Device): string\n\treturn `COURTSHIP DANCE    {ControlText.name(device, \"display\")} or move: stop`\nend\n\n-- The touch buttons' words.\nfunction PeacockText.touchChange(): string return \"Change\" end\nfunction PeacockText.touchDisplay(dancing: boolean): string return if dancing then \"Stop\" else \"Dance\" end\n\n-- The card's line for the crack (ROBLOX-92): changing spider and, folded in, the close look (ROBLOX-90: the same key held 0.6 s). On touch the key is the Change button's own\n-- label, so it is \"tap Change\", not \"Change change spider\".\nfunction PeacockText.crackLine(device: ControlText.Device): string\n\tlocal choose = ControlText.name(device, \"choose\")\n\tif device == \"touch\" then return `In the crack: tap {choose} to change spider; hold: look closely` end -- (ROBLOX-110: one line at the card's width, so the lock's line fits in ten)\n\treturn `In the crack: {choose} change spider (hold {choose}: look closely)`\nend\n\n-- Lines added to the controls card (H): the crack's choice for every spider and the close look, the pointer to the Settings row (ROBLOX-71), then the display key's line for the spider that has one:\n-- `display` is \"dance\" (the peacock spider), \"antennae\" (the ant-mimicking spider), \"threat\" (the tarantulas), nil (the first spider). true means \"dance\" and false nil.\nfunction PeacockText.helpExtra(device: ControlText.Device, display: (string | boolean)?): string\n\tlocal kind: string? = if display == true then \"dance\" elseif type(display) == \"string\" then display else nil\n\tlocal lines = { PeacockText.crackLine(device), PeacockText.settingsLine(device) }\n\tif kind == \"dance\" then\n\t\tlocal key = ControlText.name(device, \"display\")\n\t\ttable.insert(lines, `{key}{if device == \"touch\" then \" button:\" else \"\"} courtship dance (any move, jump or Cancel stops it)`)\n\telseif kind == \"antennae\" then\n\t\ttable.insert(lines, AntMimicText.helpLine(device))\n\telseif kind == \"threat\" then\n\t\ttable.insert(lines, TarantulaText.helpLine(device))\n\tend\n\treturn \"\\n\" .. table.concat(lines, \"\\n\")\nend\n\n-- The whole controls card the HUD shows (and the Studio spec measures): the device's own bindings, then the crack's line, the Settings pointer and the display key's line.\n-- ROBLOX-92: this one string is what is on the screen; the close look's hint is inside the crack's line, not a line of its own.\nfunction PeacockText.card(device: ControlText.Device, display: (string | boolean)?, runAvailable: boolean?, lockAvailable: boolean?): string\n\treturn ControlText.helpCard(device, runAvailable, lockAvailable) .. PeacockText.helpExtra(device, display)\nend\n\n-- The felt caption while a rumble-rump is on: { text, alpha }, or nil when there is none. The vibration is felt through the feet, not seen.\nfunction PeacockText.caption(rumble: number): { text: string, alpha: number }?\n\tif rumble <= 0.02 then return nil end\n\treturn { text = Peacock.feltCaption, alpha = math.clamp(rumble, 0, 1) }\nend\n\nreturn PeacockText\n",5844,1507649644},{"Shared/UI/PerceptionShapes","--!strict\n-- PerceptionShapes: the geometry the perception HUD draws with (ROBLOX-20, the drawer's polish), pure. A last-seen ring is 12 short\n-- bars along a circle, an off-screen cue's chevron is two bars, the Focus ticks are four, and a label hangs under the ring it\n-- names. Client/PerceptionHud draws each bar as a thin rounded Frame; nothing here reads the engine, so tests/hud.luau checks every\n-- rule. What is drawn, its words, opacities and timings are PerceptionView's and are not touched here.\n-- Pixels, screen y down; a rotation is in degrees, clockwise, as GuiObject.Rotation.\nlocal Shapes = {}\n\n-- A thin bar: centred on (x, y), `length` long. `rotation` turns a horizontal bar clockwise to lie along it (a bar looks the same\n-- turned half a turn, so it is kept in -90 to 90).\nexport type Bar = { x: number, y: number, length: number, rotation: number }\n\nlocal function axis(deg: number): number\n\treturn (deg + 90) % 180 - 90\nend\n\n-- A last-seen ring (PerceptionView kind \"mark\") is DASHES dashes at equal steps, the first at the top. `dash` (PerceptionView: 1\n-- when the sighting is fresh, 0.3 when it is as stale as it gets) says how much of its step each dash covers, up to DASH_FILL, so\n-- the gaps grow as the sighting ages. A dash is straight with both ends on the circle, never shorter than MIN_DASH pixels.\nShapes.DASHES = 12\nShapes.DASH_FILL = 0.85\nShapes.MIN_DASH = 2\n\nfunction Shapes.dashRing(cx: number, cy: number, radius: number, dash: number): { Bar }\n\tlocal step = 2 * math.pi / Shapes.DASHES\n\tlocal half = step * Shapes.DASH_FILL * math.clamp(dash, 0, 1) * 0.5 -- half the angle a dash covers\n\tlocal length = math.max(2 * radius * math.sin(half), Shapes.MIN_DASH)\n\tlocal reach = radius * math.cos(half) -- the middle of a chord lies a little inside the circle\n\tlocal out: { Bar } = {}\n\tfor i = 0, Shapes.DASHES - 1 do\n\t\tlocal a = -math.pi / 2 + i * step\n\t\tout[i + 1] = { x = cx + math.cos(a) * reach, y = cy + math.sin(a) * reach, length = length, rotation = axis(math.deg(a) + 90) }\n\tend\n\treturn out\nend\n\n-- An off-screen cue's chevron, pointing along the unit direction (dx, dy) from the middle of the screen out to the edge: two arms of\n-- CHEVRON_ARM pixels meeting at the tip, each lying CHEVRON_SPREAD degrees back from that direction. It is centred on (x, y)\n-- along its direction, which is where the mark sits on the edge.\nShapes.CHEVRON_ARM = 15\nShapes.CHEVRON_SPREAD = 40\n\nfunction Shapes.chevron(x: number, y: number, dx: number, dy: number): { Bar }\n\tlocal arm, spread = Shapes.CHEVRON_ARM, math.rad(Shapes.CHEVRON_SPREAD)\n\tlocal heading = math.atan2(dy, dx)\n\tlocal depth = arm * math.cos(spread) -- how far the arms reach back from the tip\n\tlocal tx, ty = x + math.cos(heading) * depth * 0.5, y + math.sin(heading) * depth * 0.5\n\tlocal out: { Bar } = {}\n\tfor i, side in { -1, 1 } do\n\t\tlocal back = heading + math.pi + side * spread\n\t\tout[i] = { x = tx + math.cos(back) * arm * 0.5, y = ty + math.sin(back) * arm * 0.5, length = arm, rotation = axis(math.deg(back)) }\n\tend\n\treturn out\nend\n\n-- The Focus ticks around the middle (cx, cy): four short bars, each lying along the line out from the middle, FOCUS_RADIUS pixels\n-- out (their middles) and FOCUS_LENGTH long.\nShapes.FOCUS_RADIUS = 11\nShapes.FOCUS_LENGTH = 10\n\nfunction Shapes.focusTicks(cx: number, cy: number): { Bar }\n\tlocal out: { Bar } = {}\n\tfor i = 0, 3 do\n\t\tlocal a = i * math.pi / 2\n\t\tout[i + 1] = { x = cx + math.cos(a) * Shapes.FOCUS_RADIUS, y = cy + math.sin(a) * Shapes.FOCUS_RADIUS, length = Shapes.FOCUS_LENGTH, rotation = axis(math.deg(a)) }\n\tend\n\treturn out\nend\n\n-- The lock's cue (ROBLOX-110): four short ticks on the diagonals round the locked thing's place on screen, fainter and wider than Focus's, so\n-- the two never read as one. The only thing the lock draws.\nShapes.LOCK_RADIUS = 22\nShapes.LOCK_LENGTH = 7\nShapes.LOCK_ALPHA = 0.6 -- (0.45 all but vanished on the sunlit floor in the mock of ROBLOX-110; the dark edge at 0.6 reads on light and dark ground)\nfunction Shapes.lockTicks(cx: number, cy: number): { Bar }\n\tlocal out: { Bar } = {}\n\tfor i = 0, 3 do\n\t\tlocal a = math.pi / 4 + i * math.pi / 2\n\t\tout[i + 1] = { x = cx + math.cos(a) * Shapes.LOCK_RADIUS, y = cy + math.sin(a) * Shapes.LOCK_RADIUS, length = Shapes.LOCK_LENGTH, rotation = axis(math.deg(a)) }\n\tend\n\treturn out\nend\n\n-- Where a label's top middle goes. (px, py) is the middle of the ring it names and `offset` PerceptionView's gap from there to the\n-- label (the ring's radius and 8). Under the ring, unless the screen has no room for LABEL_HEIGHT pixels there, then above it. When\n-- the label's width is known (> 0) it is kept LABEL_MARGIN pixels inside the screen sideways. Returns x, y and whether it is below.\nShapes.LABEL_HEIGHT = 28\nShapes.LABEL_MARGIN = 8\n\nfunction Shapes.labelAt(px: number, py: number, offset: number, width: number, viewportW: number, viewportH: number): (number, number, boolean)\n\tlocal below = py + offset + Shapes.LABEL_HEIGHT <= viewportH - Shapes.LABEL_MARGIN\n\tlocal y = if below then py + offset else py - offset - Shapes.LABEL_HEIGHT\n\tlocal x = px\n\tif width > 0 then\n\t\tlocal half = width * 0.5 + Shapes.LABEL_MARGIN\n\t\tx = math.clamp(px, math.min(half, viewportW * 0.5), math.max(viewportW - half, viewportW * 0.5))\n\tend\n\treturn x, y, below\nend\n\nreturn Shapes\n",5291,601730319},{"Shared/UI/PerceptionText","--!strict\n-- Frozen perception_text.gd: words belong to presentation, never the sensor.\nlocal Text = {}\nlocal names = {movement=\"movement\", possible_prey=\"possible prey\", fly_like_prey=\"fly-like prey\"}\nfunction Text.category(category: string): string\n\treturn (names :: {[string]: string})[category] or \"movement\"\nend\nfunction Text.hasNumber(text: string): boolean return string.find(text, \"[%d%%]\") ~= nil end\nText.LOST = \"lost sight\"\nreturn table.freeze(Text)\n",461,3950945301},{"Shared/UI/PerceptionView","--!strict\n-- Pure build_view from perception_hud.gd. Only memory and a camera adapter enter; never world actors.\nlocal Text = require(script.Parent.PerceptionText)\nlocal View = {}\nfunction View.edgeFade(age: number): number\n\tif age < 0 or age >= 1.4 then return 0 end\n\tlocal t = math.clamp(age / 0.12, 0, 1)\n\treturn t*t*(3-2*t) * (1-age/1.4)^1.5\nend\nfunction View.build(memory: any, camera: any, showMark: boolean?): any\n\tlocal out: any = {edges={}, rings={}, labels={}}\n\tlocal sectors: {[number]: any} = {}\n\tfor _, c in memory:contacts() do\n\t\tif c.cueCount > 0 and c.cueDirection.Magnitude > 0.7 and not c:isInspectedNow() then\n\t\t\tlocal alpha = 0.6 * View.edgeFade(memory:cueAgeS(c))\n\t\t\tif alpha > 0 then\n\t\t\t\tlocal e = camera.edge(c.cueDirection)\n\t\t\t\te.alpha, e.trackId = alpha, c.trackId\n\t\t\t\tlocal sector = math.floor(math.atan2(c.cueDirection.X, c.cueDirection.Z) / (math.pi/8) + 0.5)\n\t\t\t\tif not sectors[sector] or sectors[sector].alpha < alpha then sectors[sector] = e end\n\t\t\tend\n\t\tend\n\t\tif not c.hasPosition then continue end\n\t\tlocal point, visible, radius = camera.project(c.position, c.sizeWu)\n\t\tif not visible then continue end\n\t\tif c:isInspectedNow() then\n\t\t\ttable.insert(out.rings, {pos=point, radius=radius, alpha=0.85, dash=1, kind=\"live\", trackId=c.trackId})\n\t\t\ttable.insert(out.labels, {pos=point, offset=radius+8, text=Text.category(c.category), alpha=1})\n\t\telseif c:hasMark() then\n\t\t\tlocal stale = memory:stalenessOf(c)\n\t\t\tlocal covered = camera.covered(c.position, math.max(c.sizeWu, 0.2)*0.5+0.06)\n\t\t\tif showMark ~= false then\n\t\t\t\ttable.insert(out.rings, {pos=point, radius=radius, alpha=(0.6-0.48*stale)*(if covered then 0.6 else 1),\n\t\t\t\t\tdash=1-0.7*stale, kind=\"mark\", trackId=c.trackId})\n\t\t\tend\n\t\t\tlocal age = memory:ageS(c)\n\t\t\tif age < 2.5 then table.insert(out.labels, {pos=point, offset=radius+8, text=Text.LOST, alpha=math.clamp(1-age/2.5,0,1)}) end\n\t\tend\n\tend\n\tfor _, e in sectors do table.insert(out.edges, e) end\n\treturn out\nend\nreturn View\n",1969,820937448},{"Shared/UI/PreyText","--!strict\n-- What the screen says when a prey gets out of the jaws by its own trick (ROBLOX-101, Prey/PreyKinds.grip, kept by Prey/PreyWorld as `event`): a moth whose\n-- scales came away in the fangs, a crane fly that left a leg. One short note each, shown as the notebook's notes are. Pure; checked in tests/garden_life.luau.\n-- ROBLOX-105: and when a strike comes within something that is not food (Prey/PreyWorld.strikeAmbient: { kind = \"refused\", prey = kind }): the spider lets it\n-- go, and the note says why in a few words, each reason from the kind's notebook page and its sources (docs/NOTEBOOK_SOURCES.md).\nlocal PreyText = {}\n\nPreyText.NOTES = {\n\tslip = \"The moth slipped free, leaving scales in your fangs.\",\n\tshed = \"The crane fly left a leg in your fangs and got away.\",\n} :: { [string]: string }\n\n-- (ROBLOX-105) Why a strike at each kind of thing that is not food came to nothing.\nPreyText.REFUSED = {\n\tladybird = \"A foul fluid wells from the ladybird's leg joints. You let it go.\",\n\tmillipede = \"The millipede coils tight, armour out, and smells foul. You let it go.\",\n\tsnail = \"The snail is far too big, and it has drawn into its shell.\",\n\tharvestman = \"The harvestman gives off a foul smell and stalks on. You let it go.\",\n\tant = \"The ant turns on you, jaws open. You let it go.\", -- (ROBLOX-119: the meadow's ants)\n\tskater = \"The water strider skates off over the water, out of reach.\", -- (ROBLOX-122: the pond's water striders)\n\twoodlouse = \"The woodlouse's glands give off a secretion spiders avoid. You let it go.\",\n} :: { [string]: string }\n\n-- (ROBLOX-120) The field cricket's song, captioned (the Captions setting) when the nearest singing cricket (Prey/PreyKinds.chirping) is within CHIRP_HEAR studs of the\n-- spider; `direction` UI/WaspText.directionWord's. How loud it is to the spider: 1 at the cricket, nothing at CHIRP_HEAR.\nPreyText.CHIRP_HEAR = 400\nfunction PreyText.chirp(direction: string, loud: number): { text: string, alpha: number }\n\treturn { text = `[a cricket chirping, {direction}]`, alpha = math.clamp(0.35 + loud, 0, 1) }\nend\n\n-- How long a note stays (seconds).\nPreyText.SECONDS = 4\n\n-- The note for an event ({ kind = \"slip\" | \"shed\" | \"refused\", prey = kind }), or nil for one this table does not know.\nfunction PreyText.note(event: any): string?\n\tif type(event) ~= \"table\" then return nil end\n\tif event.kind == \"refused\" then return PreyText.REFUSED[event.prey] end\n\treturn PreyText.NOTES[event.kind]\nend\n\nreturn PreyText\n",2472,1348943363},{"Shared/UI/QuietHud","--!strict\n-- The quiet HUD (ROBLOX-113, W5 of docs/OPEN_WORLD_DESIGN.md): what the screen may say in Normal. Nathan: \"minimal HUD\", \"no hand holding\", \"Normal mode should feel\n-- like it doesn't want you to survive\". Every string the game can put on the screen during play is one of the kinds below, and each kind has a class:\n--\n--   needed   always shown: the hunger bar, the day line, what the senses report (the sound captions), the answer to a press, a state the world cannot show\n--   day_one  in Normal only on the life's first day (the first day of a new life, or of a spiderling's generation); the gentle modes always\n--   gentle   never in Normal; Easy and Free play as before\n--   removed  never shown in any mode (none at present: the gentle modes keep every word they had)\n--\n-- Easy and Free play keep their helpfulness: in the gentle rules every kind shows, as it did. The player's own settings still apply on top (\"Show control hints\",\n-- Captions, \"Show what the spider notices\", the notebook's notes). Nothing is added for the garden: the day line does not name the region (the decision is\n-- ROBLOX-113's: the regions are seamless, their names are the map's, and a label on the world is what Nathan's minimal HUD leaves out).\n-- The perception HUD's labels are calmed here too (`calmLabels`): one at a time in an area of the screen, the newest winning, and \"lost sight\" gone in a breath.\n-- Pure: checked in tests/quiet.luau, which also drives the real client. docs/HUD_AUDIT.md lists every string with its kind.\nlocal QuietHud = {}\n\nexport type Class = \"needed\" | \"day_one\" | \"gentle\" | \"removed\"\nexport type Context = { normal: boolean, dayOne: boolean }\n\nQuietHud.game = {\n\tlabelAreaPx = 120, -- two perception labels whose rings are closer than this on the screen are one area: only one is drawn\n\tlostSeconds = 1.0, -- \"lost sight\" fades out over this (the view's own fade is 2.5 s, Godot's; the calm makes it a breath)\n}\n\n-- Every kind of thing the play screen can say, its class, and where it shows (for the audit, docs/HUD_AUDIT.md, and the tests).\nQuietHud.KINDS = {\n\t-- the top column: the hunger bar and the day box\n\thunger = { class = \"needed\", where = \"hunger bar\", what = \"Hunger 72% (· hungry, · starving, · gentle)\" },\n\tday = { class = \"needed\", where = \"day line\", what = \"Day 2, afternoon | Juvenile (| EASY, | FREE PLAY, | Generation 2)\" },\n\tgrowth_count = { class = \"needed\", where = \"day box\", what = \"Next moult: 2 of 5 meals; Ready to moult\" },\n\tgrowth_rule = { class = \"day_one\", where = \"day box\", what = \"· 3 gnats = 1 housefly; Ready to moult: rest in the crack.; Moulting: stay in the crack.; Adult: keep your hunger bar full.\" },\n\tstarving_weak = { class = \"needed\", where = \"day box\", what = \"Starving: your spider will not last another day. Too hungry to sleep; find food.\" },\n\thunger_words = { class = \"day_one\", where = \"day box\", what = \"Starving: your spider's reserve is gone. It must eat soon.; Hungry: time to hunt.\" },\n\tdusk_words = { class = \"day_one\", where = \"day box\", what = \"Evening. Jumping spiders go into their silk retreat before dark.; It is dark, and your eyes reach only a little way. Home is ...\" },\n\tsoft_skin = { class = \"gentle\", where = \"day box\", what = \"Soft new skin: slower steps and shorter jumps until it hardens.\" },\n\tnotebook_note = { class = \"needed\", where = \"day box\", what = \"New in your notebook: <page>\" },\n\tnotebook_open_hint = { class = \"day_one\", where = \"day box\", what = \"(N to read)\" },\n\tprey_note = { class = \"needed\", where = \"day box\", what = \"The moth slipped free, leaving scales in your fangs.; A foul fluid wells from the ladybird's leg joints. You let it go. ...\" },\n\t-- the top column: the status lines\n\twasp_line = { class = \"gentle\", where = \"status\", what = \"A deep hum outside: a wasp is coming ... Hide in the crack ...; The wasp has seen you! Get away ...; The wasp is leaving.\" },\n\tsave_broken = { class = \"needed\", where = \"status\", what = \"Saving is off\" },\n\tcourt_line = { class = \"gentle\", where = \"status\", what = \"A visitor is on the sill. Walk close to it.; Courting: dance in front of it (X); Courting 45%: face it and keep still\" },\n\tskip_line = { class = \"needed\", where = \"status\", what = \"Space or Q: part (the mating scene, once it can be skipped)\" },\n\tguard_line = { class = \"gentle\", where = \"status\", what = \"Guarding the eggs: day 1 of 2. Rest in the crack to pass the nights.\" },\n\tfeeding_lines = { class = \"day_one\", where = \"status\", what = \"Caught — tap Space to keep your grip; Feeding — move to stop; Meal paused — E to eat; Holding the rival — tap Space ...; Eating rival — stay still (2 meals)\" },\n\tdisplay_status = { class = \"day_one\", where = \"status\", what = \"COURTSHIP DANCE    X or move: stop; ANTENNAE UP ...; THREAT DISPLAY ...\" },\n\tfocus_status = { class = \"needed\", where = \"status\", what = \"FOCUS ON    Right mouse again to stop / Q (the Focus toggle setting)\" },\n\teye_status = { class = \"day_one\", where = \"status\", what = \"SPIDER-EYE VIEW    V: back\" },\n\tslow_status = { class = \"needed\", where = \"status\", what = \"SLOW MOTION 50%    T: normal speed\" },\n\t-- the top column: captions and notices\n\teye_caption = { class = \"day_one\", where = \"caption\", what = \"the spider-eye view's explanation, the first time it is opened\" },\n\tsound_captions = { class = \"needed\", where = \"caption\", what = \"[a deep, heavy hum outside, ahead-left, coming closer]; [a fine buzzing through your feet]; the mating and hatching scenes' captions (the Captions setting)\" },\n\tnotice = { class = \"needed\", where = \"notice\", what = \"the life's notices not listed in NOTICES: Last rest kept.; Moulted: now a ...; the mate's and the rival's events; A cold night in the open ...; Your spider is an adult! ...\" },\n\t-- toasts: what a jump or the line did (the kinds Motor and JumpInput report)\n\t[\"toast:refused\"] = { class = \"day_one\", where = \"toast\", what = \"Jump cancelled: too far or too high (the aim's words said it before the release)\" },\n\t[\"toast:hop_refused\"] = { class = \"day_one\", where = \"toast\", what = \"No hop: nothing to land on ahead\" },\n\t[\"toast:cancelled\"] = { class = \"day_one\", where = \"toast\", what = \"Jump cancelled\" },\n\t[\"toast:out_of_bounds\"] = { class = \"needed\", where = \"toast\", what = \"Out of bounds: back to the last safe spot\" },\n\t[\"toast:caught\"] = { class = \"day_one\", where = \"toast\", what = \"Caught by your line\" },\n\t[\"toast:drop_walk\"] = { class = \"day_one\", where = \"toast\", what = \"To the edge, to let yourself down\" },\n\t[\"toast:dropped\"] = { class = \"day_one\", where = \"toast\", what = \"Letting yourself down: hold F to lower, W to climb\" },\n\t[\"toast:drop_refused\"] = { class = \"needed\", where = \"toast\", what = \"Nothing below to let yourself down into from here; This surface won't hold your silk; Couldn't get to the edge\" },\n\t[\"toast:completed\"] = { class = \"day_one\", where = \"toast\", what = \"Holding on again. The line stays behind for a moment\" },\n\t[\"toast:released\"] = { class = \"day_one\", where = \"toast\", what = \"You let go of the line\" },\n\t[\"toast:lost\"] = { class = \"needed\", where = \"toast\", what = \"Your line came loose: its anchor is gone\" },\n\t[\"toast:blocked\"] = { class = \"needed\", where = \"toast\", what = \"Can't reel in: something is in the way. Lower, or let go; Reeled in as far as it goes\" },\n\t[\"toast:snagged\"] = { class = \"needed\", where = \"toast\", what = \"The line is caught on a second edge and can't be reeled in. Lower, or let go\" },\n\ttoast_answer = { class = \"needed\", where = \"toast\", what = \"the answer to a press or a choice: You are the peacock spider now; Stand still on a surface to dance; the close look's refusals and framings; the save's status; the returns to a rest; Generation 2 — hatched on day 5; The dry leaf tip gave way ...\" },\n\t-- the prompt panel at the bottom\n\tline_panel = { class = \"day_one\", where = \"prompt\", what = \"On your line / W: reel in    S: lower    hold Q: let go\" },\n\tline_cue = { class = \"needed\", where = \"prompt\", what = \"Letting go... 40%; the line's blocks and snags\" },\n\tedge_walk_hint = { class = \"day_one\", where = \"prompt\", what = \"To the edge, to let yourself down    Q or move: stop\" },\n\trest_state = { class = \"needed\", where = \"prompt\", what = \"Asleep in the silk-lined crack; Resting under the stone; Moulting in the silk-lined crack; Ready to moult (the titles)\" },\n\trest_prompt = { class = \"day_one\", where = \"prompt\", what = \"The silk-lined crack / E: rest; the hints under the titles (Move, E or Q to wake; C: become ...; the display key)\" },\n\thome_line = { class = \"day_one\", where = \"prompt\", what = \"Home: the silk-lined crack / Walk through the silk-framed opening under the wooden roof, then stop to rest.\" },\n\twalk_hint = { class = \"day_one\", where = \"prompt\", what = \"Tap Space: hop    hold Space: aim a leap    F: let yourself down on silk (and the setting Show control hints)\" },\n\tcontrols_card_start = { class = \"day_one\", where = \"card\", what = \"the controls card for 20 s at the start (and the setting Show control hints)\" },\n\tcontrols_card_asked = { class = \"needed\", where = \"card\", what = \"the controls card when asked for: H, or Menu then Controls\" },\n\tclose_look = { class = \"needed\", where = \"prompt\", what = \"the close look's name line and its one line of controls (the player opened it)\" },\n\t-- the words at the aim\n\taim_title = { class = \"needed\", where = \"aim\", what = \"Reachable; Out of reach: too far or too high; No surface in view\" },\n\taim_hint = { class = \"day_one\", where = \"aim\", what = \"release to leap    Q: cancel the jump\" },\n\tanchor_ok = { class = \"day_one\", where = \"aim\", what = \"Safety line: anchored here\" },\n\tanchor_warning = { class = \"needed\", where = \"aim\", what = \"No safety line: this surface won't hold silk; No safety line: this jump needs more line than you have\" },\n\t-- the perception HUD (its own setting, Show what the spider notices)\n\tperception = { class = \"needed\", where = \"perception\", what = \"the rings, last-seen marks and edge chevrons; possible prey; fly-like prey; lost sight (one label to an area of the screen)\" },\n} :: { [string]: { class: Class, where: string, what: string } }\n\n-- The life's notices (LifeLoop's, the mate's, the rival's, the client's own), line by line: a line matching `find` has the kind's class; `short` (a pattern with one\n-- capture) is what Normal shows of it after the first day instead of the whole line. A line no entry matches is the kind `notice` (needed): so a new notice shows\n-- until it is classified here. LifeLoop's words are Godot's and are not changed; only what is shown of them is.\nQuietHud.NOTICES = {\n\t{ find = \"^Ready to moult%. Rest in the silk%-lined crack%.\", short = \"^(Ready to moult%.)\", class = \"needed\" },\n\t{ find = \"^Moulting in the crack%.\", class = \"gentle\" }, -- (the prompt's title says it: Moulting in the silk-lined crack)\n\t{ find = \"^Morning, day %d+%. Rested through the night\", class = \"day_one\" }, -- (the day line says it; the rest's kept line after it stays)\n\t{ find = \"^Awake before morning\", class = \"day_one\" },\n\t{ find = \"^Returned to your last rest: the sill as it was when you rested\", class = \"gentle\" }, -- (Normal's end card said what a return is)\n\t{ find = \"^Another young spider, somewhere new on the sill\", class = \"day_one\" },\n\t{ find = \"^A visitor: \", short = \"^(A visitor: [^.]*%.)\", class = \"needed\" }, -- (not how to court: the notebook's page says that)\n\t{ find = \"^Caught the rival! It fights back%.\", short = \"^(Caught the rival! It fights back%.)\", class = \"needed\" },\n\t{ find = \"^The rival goes still%.\", short = \"^(The rival goes still%.)\", class = \"needed\" },\n\t{ find = \"^It bit back!\", short = \"^(It bit back!)\", class = \"needed\" },\n\t{ find = \"^The other spider crouches to jump\", class = \"gentle\" }, -- (its crouch and the spider's own alarm are the warning)\n} :: { { find: string, short: string?, class: Class } }\n\n-- The context for a frame: Normal (the standard rules: not Easy, not Free play) and whether it is the life's first day. `day` is the clock's day and `born` the\n-- day before the generation began (0 for the first; Life/Mating.grace), as the wasp and the rival count a first day.\nfunction QuietHud.context(rules: string, day: number, born: number?): Context\n\treturn { normal = rules == \"standard\", dayOne = day - (born or 0) <= 1 }\nend\n\n-- Whether a class shows in this context.\nfunction QuietHud.classShows(class: Class, ctx: Context): boolean\n\tif class == \"removed\" then return false end\n\tif not ctx.normal or class == \"needed\" then return true end\n\tif class == \"day_one\" then return ctx.dayOne end\n\treturn false -- gentle\nend\n\n-- Whether a kind shows. An unknown kind shows (a new string is never silently hidden: tests/quiet.luau lists every kind the client asks for).\nfunction QuietHud.shows(kind: string, ctx: Context): boolean\n\tlocal k = QuietHud.KINDS[kind]\n\treturn k == nil or QuietHud.classShows(k.class, ctx)\nend\n\n-- Whether Normal's quiet is on now: the standard rules after the first day (every day_one and gentle kind is hidden).\nfunction QuietHud.quiet(ctx: Context): boolean\n\treturn ctx.normal and not ctx.dayOne\nend\n\n-- What a notice shows: each line by its entry in NOTICES (or as the kind `notice`), the lines kept joined; nil when nothing is left.\nfunction QuietHud.notice(text: string?, ctx: Context): string?\n\tif text == nil or text == \"\" then return nil end\n\tlocal out: { string } = {}\n\tfor line in string.gmatch(text, \"[^\\n]+\") do\n\t\tlocal kept: string? = line\n\t\tfor _, n in QuietHud.NOTICES do\n\t\t\tif string.find(line, n.find) then\n\t\t\t\tif not QuietHud.classShows(n.class, ctx) then\n\t\t\t\t\tkept = nil\n\t\t\t\telseif n.short ~= nil and QuietHud.quiet(ctx) then\n\t\t\t\t\tkept = string.match(line, n.short) or line\n\t\t\t\tend\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\tif kept ~= nil then table.insert(out, kept) end\n\tend\n\treturn if #out > 0 then table.concat(out, \"\\n\") else nil\nend\n\n-- The kind of a notice line (\"notice\" when no entry matches), for the audit and the tests.\nfunction QuietHud.noticeKind(line: string): (Class, boolean)\n\tfor _, n in QuietHud.NOTICES do\n\t\tif string.find(line, n.find) then return n.class, n.short ~= nil end\n\tend\n\treturn \"needed\", false\nend\n\n-- The perception HUD's labels, calmed (Nathan saw three \"lost sight\" labels piled on the soil): \"lost sight\" fades over `lostSeconds` instead of the view's 2.5 s,\n-- and in any area of the screen (rings closer than `labelAreaPx`) one label is drawn: a live one (what the principal eyes hold now) before a lost one, the newest\n-- lost one before an older. `labels` is PerceptionView's list ({ pos, offset, text, alpha }); `lost` its \"lost sight\" words; `out` a list to fill (cleared first).\nfunction QuietHud.calmLabels(labels: { any }, lost: string, out: { any }): { any }\n\ttable.clear(out)\n\tlocal fade = 2.5 / QuietHud.game.lostSeconds -- (the view's alpha is 1 - age / 2.5: the age read back from it, run out over lostSeconds)\n\tlocal area = QuietHud.game.labelAreaPx\n\t-- the candidates, best first: the live ones in the view's order, then the lost ones, the newest first\n\tlocal order: { any } = {}\n\tlocal gone: { any } = {}\n\tfor _, l in labels do\n\t\tif l.text ~= lost then\n\t\t\ttable.insert(order, l)\n\t\telse\n\t\t\tlocal alpha = 1 - (1 - l.alpha) * fade\n\t\t\tif alpha > 0 then table.insert(gone, { pos = l.pos, offset = l.offset, text = l.text, alpha = alpha }) end\n\t\tend\n\tend\n\tif #gone > 1 then table.sort(gone, function(a: any, b: any): boolean return a.alpha > b.alpha end) end\n\tfor _, l in gone do table.insert(order, l) end\n\tfor _, l in order do\n\t\tlocal free = true\n\t\tfor _, k in out do\n\t\t\tif (k.pos - l.pos).Magnitude < area then free = false; break end\n\t\tend\n\t\tif free then table.insert(out, l) end\n\tend\n\treturn out\nend\n\nreturn QuietHud\n",15618,912207781},{"Shared/UI/RivalText","--!strict\n-- The words of the brown rival's contest for the screen (ROBLOX-73): what the spider's strike did to a rival that had seen it coming. The\n-- first line is the old line for a catch (a rival that had not noticed is caught outright, as before); the others are the new outcomes.\n-- Pure: checked in tests/rival.luau and tests/client_rival.luau.\nlocal RivalText = {}\n\nRivalText.CAPTURED = \"Caught the rival! It fights back. Tap to keep your grip.\"\n-- ROBLOX-77: the rival must be subdued with the tapping grip before it can be eaten, and it can tear free.\nRivalText.SUBDUED = \"The rival goes still. Stay still to eat; worth two housefly meals.\"\nRivalText.TORE = \"The rival tore free of your fangs.\"\nRivalText.TORE_GENTLE = \"The rival tore free of your fangs. You are safe in this mode.\"\nRivalText.SPRANG = \"It sprang clear of your strike.\"\nRivalText.COUNTER = \"It bit back! Jump away!\"\nRivalText.COUNTER_GENTLE = \"It bit back, but you are safe in this mode. Jump away!\"\n\n-- The line for a counter-bite: the gentle modes cost nothing and say so.\nfunction RivalText.counter(gentle: boolean): string\n\treturn if gentle then RivalText.COUNTER_GENTLE else RivalText.COUNTER\nend\n\n-- The status line while the caught rival is being eaten (ROBLOX-91): `meals` is what it is worth in housefly meals (Growth.mealsOf of its food), not a number written here.\nfunction RivalText.eating(meals: number): string\n\treturn `Eating rival — stay still ({meals} meals)`\nend\n\n-- The status line while the rival fights the grip: the fly's wording (Caught — tap Jump to keep your grip), in the rival's own words. `button` is\n-- the name of the jump button on this device.\nfunction RivalText.struggle(button: string): string\n\treturn \"Holding the rival — tap \" .. button .. \" to keep your grip\"\nend\n\n-- The notice for the rival tearing free: it never harms the player, and the gentle modes say so.\nfunction RivalText.tore(gentle: boolean): string\n\treturn if gentle then RivalText.TORE_GENTLE else RivalText.TORE\nend\n\n-- The notice for a strike's outcome event (\"captured\", \"sprang\", \"counter\"), or nil for any other event.\nfunction RivalText.strike(event: string, gentle: boolean): string?\n\tif event == \"captured\" then return RivalText.CAPTURED end\n\tif event == \"sprang\" then return RivalText.SPRANG end\n\tif event == \"counter\" then return RivalText.counter(gentle) end\n\treturn nil\nend\n\nreturn RivalText\n",2387,828650792},{"Shared/UI/SaveText","--!strict\n-- The words about saving (ROBLOX-39): what the menu and a short toast say. Plain and honest: saved, saving, or off for this visit and why.\n-- The reasons are SaveRules.REASONS. Pure; checked in tests/state_client.luau.\nlocal SaveText = {}\n\nSaveText.SAVED = \"Your notebook and last rests are saved.\"\nSaveText.SAVING = \"Saving...\"\nSaveText.TROUBLE = \"Having trouble saving. Your progress is kept for now and the game keeps trying.\"\nSaveText.REST_REFUSED = \"Your latest rest could not be saved online. It is kept for this visit; your earlier saved rest is unchanged.\"\nSaveText.OFF = \"Saving is off for this visit: your notebook and rests will last only until you leave.\"\nSaveText.LOOKING = \"Finding your saved game...\"\nSaveText.BACK = \"Saving is back on.\"\n-- ROBLOX-92: the client's saving broke (something in it raised): saving is off for the rest of the visit, and the game goes on. The one status line, and the menu's.\nSaveText.BROKEN = \"Saving is off\"\n\nSaveText.WHY = {\n\toffline = \"The game could not reach its saving service.\",\n\tno_api = \"Saving is not available here.\",\n\tload_failed = \"Your saved game could not be read just now. It has not been changed, and the game keeps trying.\",\n\tother_session = \"Your game is open somewhere else, and this copy cannot save over it.\",\n\tcorrupt = \"Your saved game could not be read, so it was left exactly as it is.\",\n\tnewer = \"Your saved game was made by a newer version of this game, so it was left exactly as it is.\",\n\twrite_failed = \"This visit could not be saved. Your earlier saved game is still kept.\",\n\trest_refused = SaveText.REST_REFUSED,\n} :: { [string]: string }\n\nlocal function because(reason: string?): string?\n\tif reason == nil then return nil end\n\treturn SaveText.WHY[reason]\nend\n\n-- The line for the menu: one or two sentences.\nfunction SaveText.menuLine(status: string?, reason: string?): string\n\tif status == \"session\" then\n\t\tlocal why = because(reason)\n\t\treturn SaveText.OFF .. (if why then \"\\n\" .. why else \"\")\n\telseif status == \"saving\" then\n\t\tif reason == \"rest_refused\" then return SaveText.REST_REFUSED end\n\t\treturn if reason == \"write_failed\" then SaveText.TROUBLE else SaveText.SAVING\n\telseif status == \"saved\" then\n\t\treturn SaveText.SAVED\n\tend\n\treturn SaveText.LOOKING\nend\n\n-- The line for the menu once the client's own saving has broken (the server's word no longer matters: nothing more is sent).\nfunction SaveText.brokenLine(): string\n\treturn SaveText.OFF .. \"\\nSomething in the saving broke, so this visit will not be saved.\"\nend\n\n-- A short toast when the status changes, or \"\" when nothing needs saying (a plain saving/saved flicker is not announced).\nfunction SaveText.toast(oldStatus: string?, oldReason: string?, status: string?, reason: string?): string\n\tlocal was: string = oldStatus or \"\"\n\tlocal now: string = status or \"\"\n\tlocal toSession = now == \"session\" and was ~= \"session\"\n\tlocal fromSession = was == \"session\" and (now == \"saved\" or now == \"saving\")\n\tlocal newTrouble = now == \"saving\" and reason == \"write_failed\" and was ~= \"\" and not (was == \"saving\" and oldReason == \"write_failed\")\n\tif now == \"saving\" and reason == \"rest_refused\" and not (was == \"saving\" and oldReason == \"rest_refused\") then return SaveText.REST_REFUSED end\n\tif toSession then\n\t\tlocal why = because(reason)\n\t\treturn SaveText.OFF .. (if why then \" \" .. why else \"\")\n\telseif fromSession then\n\t\treturn SaveText.BACK\n\telseif newTrouble then\n\t\treturn SaveText.TROUBLE\n\tend\n\treturn \"\"\nend\n\nreturn SaveText\n",3474,2602603202},{"Shared/UI/SettingsModel","--!strict\n-- The settings as logic (ROBLOX-49): looking one up, cleaning a value, stepping it, saying it in words, putting everything back to the\n-- defaults and carrying saved settings forward. Pure; the table itself is Shared/Data/SettingsSpec. Nothing here knows about Roblox, the\n-- panel or the save: the panel (Client/SettingsPanel) and the save (Shared/Persistence/SaveProgress) both call these.\n--\n-- A value is clean when it has the kind's type and sits in its range. clean() never raises:\n--   * an id this build does not know ................ dropped quietly (a newer build's setting must not break an older one)\n--   * the wrong type, or a number that is not finite .. a problem (corruption, not a choice)\n--   * a number outside the range ...................... clamped to it (a range may be tightened later; the value stays usable)\n--   * a choice that is not an option .................. dropped quietly (an option may be removed later)\nlocal SettingsSpec = require(script.Parent.Parent.Data.SettingsSpec)\nlocal SpiderChoice = require(script.Parent.Parent.Rig.SpiderChoice)\nlocal PeacockText = require(script.Parent.PeacockText)\nlocal InspectText = require(script.Parent.InspectText)\n\nlocal SettingsModel = {}\n\nexport type Value = boolean | number | string\n\nlocal BY_ID: { [string]: SettingsSpec.Setting } = {}\nlocal ORDER: { string } = {}\nfor _, s in SettingsSpec.LIST do\n\tBY_ID[s.id] = s\n\ttable.insert(ORDER, s.id)\nend\n\n-- The live rows (ROBLOX-71) are not settings in the saved sense: they are found by spec() and listed in sections(), but ids(), defaults(), clean()\n-- and get() know nothing of them, so nothing about them is ever saved, read from a save or put back by Reset. Each steps and speaks through\n-- the part that owns it.\nlocal LIVE_BY_ID: { [string]: SettingsSpec.Setting } = {}\nfor _, s in SettingsSpec.LIVE do LIVE_BY_ID[s.id] = s end\nlocal LIVE_STEP: { [string]: (any, number, any) -> any } = {\n\t-- `owned` (nil now) is where the Game Pass answer goes when the add-ons are sold: SpiderChoice.locked skips what is not owned.\n\tSpider = function(current: any, dir: number, owned: any): string\n\t\treturn SpiderChoice.step(SpiderChoice.start(current, nil), dir, owned)\n\tend,\n\t-- A button (ROBLOX-90): switching it is the whole act, so the value it steps to is only \"true, it was pressed\".\n\tInspect = function(): boolean return true end,\n}\nlocal LIVE_TEXT: { [string]: (any) -> string } = {\n\tSpider = function(value: any): string return PeacockText.title(SpiderChoice.start(value, nil)) end,\n\tInspect = function(): string return InspectText.BUTTON end,\n}\n\nSettingsModel.VERSION = SettingsSpec.VERSION\n\n-- Steps that carry saved settings from version N to N + 1: { [N] = function(values) -> values }. None yet (version 1 is the first).\nSettingsModel.MIGRATIONS = {} :: { [number]: ({ [string]: any }) -> { [string]: any } }\n\nlocal function finite(x: any): boolean\n\treturn type(x) == \"number\" and x == x and x ~= math.huge and x ~= -math.huge\nend\n\n-- ---------------------------------------------------------------- the table\nfunction SettingsModel.ids(): { string }\n\treturn table.clone(ORDER)\nend\n\nfunction SettingsModel.spec(id: string): SettingsSpec.Setting?\n\treturn BY_ID[id] or LIVE_BY_ID[id]\nend\n\n-- Is this a live row (a choice the game drives, not a saved setting)?\nfunction SettingsModel.live(id: any): boolean\n\treturn type(id) == \"string\" and LIVE_BY_ID[id] ~= nil\nend\n\nfunction SettingsModel.known(id: any): boolean\n\treturn type(id) == \"string\" and BY_ID[id] ~= nil\nend\n\n-- The rows of one section, in the table's order: the settings, then the live rows.\nfunction SettingsModel.items(sectionId: string): { SettingsSpec.Setting }\n\tlocal out: { SettingsSpec.Setting } = {}\n\tfor _, s in SettingsSpec.LIST do\n\t\tif s.section == sectionId then table.insert(out, s) end\n\tend\n\tfor _, s in SettingsSpec.LIVE do\n\t\tif s.section == sectionId then table.insert(out, s) end\n\tend\n\treturn out\nend\n\nfunction SettingsModel.sections(): { { id: string, title: string, items: { SettingsSpec.Setting } } }\n\tlocal out = {}\n\tfor _, sec in SettingsSpec.SECTIONS do\n\t\tlocal items = SettingsModel.items(sec.id)\n\t\tif #items > 0 then table.insert(out, { id = sec.id, title = sec.title, items = items }) end\n\tend\n\treturn out\nend\n\nfunction SettingsModel.default(id: string): Value?\n\tlocal s = BY_ID[id]\n\treturn if s then s.default else nil\nend\n\nfunction SettingsModel.defaults(): { [string]: Value }\n\tlocal out: { [string]: Value } = {}\n\tfor _, s in SettingsSpec.LIST do out[s.id] = s.default end\n\treturn out\nend\n\n-- ---------------------------------------------------------------- cleaning\n-- (clean value or nil, problem or nil). Both nil: the value is dropped quietly (see the header).\nfunction SettingsModel.clean(id: any, value: any): (Value?, string?)\n\tif type(id) ~= \"string\" then return nil, \"a setting without a name\" end\n\tlocal s = BY_ID[id]\n\tif s == nil then return nil, nil end\n\tif s.kind == \"toggle\" then\n\t\tif type(value) ~= \"boolean\" then return nil, `setting {id} is not true or false` end\n\t\treturn value, nil\n\telseif s.kind == \"slider\" then\n\t\tif not finite(value) then return nil, `setting {id} is not a number` end\n\t\treturn math.clamp(value :: number, s.min :: number, s.max :: number), nil\n\telse\n\t\tif type(value) ~= \"string\" then return nil, `setting {id} is not a choice` end\n\t\tfor _, o in (s.options :: { SettingsSpec.Option }) do\n\t\t\tif o.id == value then return value, nil end\n\t\tend\n\t\treturn nil, nil\n\tend\nend\n\n-- A value for a client's use: the clean one, else the default. `read(id)` gives whatever is held (a Player attribute) or nil.\nfunction SettingsModel.get(read: (string) -> any, id: string): Value\n\tlocal s = BY_ID[id]\n\tif s == nil then error(`unknown setting {id}`) end\n\tlocal raw = read(id)\n\tif raw == nil then return s.default end\n\tlocal v = SettingsModel.clean(id, raw)\n\tif v == nil then return s.default end\n\treturn v\nend\n\n-- Cleans a table of settings: (problems, clean copy). Unknown ids and values dropped quietly are left out of the copy.\nfunction SettingsModel.cleanAll(raw: any, maxProblems: number?): ({ string }, { [string]: Value })\n\tlocal problems: { string } = {}\n\tlocal out: { [string]: Value } = {}\n\tif raw == nil then return problems, out end\n\tif type(raw) ~= \"table\" then return { \"settings are not a table\" }, out end\n\tlocal cap = maxProblems or 12\n\tfor id, value in raw do\n\t\tlocal v, problem = SettingsModel.clean(id, value)\n\t\tif problem ~= nil then\n\t\t\tif #problems < cap then table.insert(problems, problem) end\n\t\telseif v ~= nil then\n\t\t\tout[id] = v\n\t\tend\n\tend\n\treturn problems, out\nend\n\n-- Carries settings written at `fromVersion` up to this build's VERSION. `steps` is for tests; the default is SettingsModel.MIGRATIONS.\nfunction SettingsModel.migrate(values: { [string]: any }, fromVersion: number, steps: { [number]: ({ [string]: any }) -> { [string]: any } }?, toVersion: number?): { [string]: any }\n\tlocal table_ = steps or SettingsModel.MIGRATIONS\n\tlocal to = toVersion or SettingsModel.VERSION\n\tlocal out = values\n\tlocal v = fromVersion\n\twhile v < to do\n\t\tlocal step = table_[v]\n\t\tif step ~= nil then out = step(table.clone(out)) end\n\t\tv += 1\n\tend\n\treturn out\nend\n\n-- ---------------------------------------------------------------- changing\nlocal function snap(s: SettingsSpec.Setting, x: number): number\n\tlocal step = s.step :: number\n\tlocal lo = s.min :: number\n\tlocal k = math.floor((x - lo) / step + 0.5)\n\t-- the grid's own value, rounded to the step's digits so 0.05 added three times is 0.15 and not 0.1500000001\n\tlocal digits = 0\n\twhile digits < 6 and math.abs(step * 10 ^ digits - math.floor(step * 10 ^ digits + 0.5)) > 1e-9 do digits += 1 end\n\tlocal scale = 10 ^ digits\n\treturn math.clamp(math.floor((lo + k * step) * scale + 0.5) / scale, lo, s.max :: number)\nend\n\n-- The value one step in `dir` (+1 or -1) from `current`: a live row steps as its owner says (the Spider row, skipping any spider that is locked); a toggle flips, a slider moves a step (and stays on its grid), a choice moves to the\n-- next option and wraps. A current value that is not clean counts as the default.\nfunction SettingsModel.step(id: string, current: any, dir: number, owned: { [string]: boolean }?): Value\n\tlocal stepLive = LIVE_STEP[id]\n\tif stepLive ~= nil then return stepLive(current, dir, owned) end\n\tlocal s = BY_ID[id]\n\tif s == nil then error(`unknown setting {id}`) end\n\tlocal v = SettingsModel.clean(id, current)\n\tif v == nil then v = s.default end\n\tif s.kind == \"toggle\" then\n\t\treturn not (v :: boolean)\n\telseif s.kind == \"slider\" then\n\t\tlocal on = snap(s, v :: number)\n\t\treturn snap(s, on + (if dir < 0 then -1 else 1) * (s.step :: number))\n\telse\n\t\tlocal options = s.options :: { SettingsSpec.Option }\n\t\tlocal at = 1\n\t\tfor i, o in options do if o.id == v then at = i end end\n\t\treturn options[(at - 1 + (if dir < 0 then -1 else 1)) % #options + 1].id\n\tend\nend\n\n-- Where a slider's value sits between its ends, 0 to 1 (for drawing the bar); 0 for the other kinds.\nfunction SettingsModel.fraction(id: string, value: any): number\n\tlocal s = BY_ID[id]\n\tif s == nil or s.kind ~= \"slider\" then return 0 end\n\tlocal v = SettingsModel.clean(id, value)\n\tif v == nil then v = s.default end\n\treturn ((v :: number) - (s.min :: number)) / ((s.max :: number) - (s.min :: number))\nend\n\n-- The value a slider takes when its bar is pressed at `fraction` (0 to 1) of the way along: on the grid.\nfunction SettingsModel.fromFraction(id: string, fraction: number): Value?\n\tlocal s = BY_ID[id]\n\tif s == nil or s.kind ~= \"slider\" then return nil end\n\tlocal f = math.clamp(fraction, 0, 1)\n\treturn snap(s, (s.min :: number) + f * ((s.max :: number) - (s.min :: number)))\nend\n\nfunction SettingsModel.isDefault(id: string, value: any): boolean\n\tlocal s = BY_ID[id]\n\tif s == nil then return false end\n\tlocal v = SettingsModel.clean(id, value)\n\tif v == nil then return true end\n\tif s.kind == \"slider\" then return math.abs((v :: number) - (s.default :: number)) < 1e-9 end\n\treturn v == s.default\nend\n\n-- ---------------------------------------------------------------- words\nlocal function trim(x: number, digits: number): string\n\tlocal text = string.format(\"%.\" .. digits .. \"f\", x)\n\treturn text\nend\n\n-- The value in words: \"On\", \"80%\", \"1.00x\", \"65 degrees\", \"5.0 studs\", or the option's label.\nfunction SettingsModel.valueText(id: string, value: any): string\n\tlocal sayLive = LIVE_TEXT[id]\n\tif sayLive ~= nil then return sayLive(value) end\n\tlocal s = BY_ID[id]\n\tif s == nil then return \"\" end\n\tlocal v = SettingsModel.clean(id, value)\n\tif v == nil then v = s.default end\n\tif s.kind == \"toggle\" then\n\t\treturn if v then SettingsSpec.WORDS.on else SettingsSpec.WORDS.off\n\telseif s.kind == \"slider\" then\n\t\tlocal x = v :: number\n\t\tif s.unit == \"percent\" then return `{math.floor(x * 100 + 0.5)}%`\n\t\telseif s.unit == \"times\" then return trim(x, 2) .. \"x\"\n\t\telseif s.unit == \"degrees\" then return `{math.floor(x + 0.5)} degrees`\n\t\telseif s.unit == \"studs\" then return trim(x, 1) .. \" studs\"\n\t\tend\n\t\treturn trim(x, 2)\n\telse\n\t\tfor _, o in (s.options :: { SettingsSpec.Option }) do\n\t\t\tif o.id == v then return o.label end\n\t\tend\n\t\treturn \"\"\n\tend\nend\n\n-- \"Label: value\" for a single line (a toggle shows On or Off).\nfunction SettingsModel.line(id: string, value: any): string\n\tlocal s = SettingsModel.spec(id)\n\tif s == nil then return \"\" end\n\treturn `{s.label}: {SettingsModel.valueText(id, value)}`\nend\n\nreturn SettingsModel\n",11353,2081982966},{"Shared/UI/SettingsNav","--!strict\n-- Moving about the settings panel without a mouse (ROBLOX-49): the rows in order (a header per section, the settings, then Reset and Back)\n-- and which one is chosen. Up and Down step through the choosable rows and wrap; the shoulder buttons (PageUp and PageDown) jump from section\n-- to section. Pure: tests/settings.luau checks it; Client/SettingsPanel draws it.\nlocal SettingsModel = require(script.Parent.SettingsModel)\n\nlocal SettingsNav = {}\nSettingsNav.__index = SettingsNav\n\nexport type Row = { kind: string, id: string?, title: string?, section: string? }\n-- kind: \"header\" (not choosable), \"setting\" (id), \"reset\", \"back\"\n\nfunction SettingsNav.rows(): { Row }\n\tlocal out: { Row } = {}\n\tfor _, sec in SettingsModel.sections() do\n\t\ttable.insert(out, { kind = \"header\", id = sec.id, title = sec.title, section = sec.id })\n\t\tfor _, item in sec.items do\n\t\t\ttable.insert(out, { kind = \"setting\", id = item.id, section = sec.id })\n\t\tend\n\tend\n\ttable.insert(out, { kind = \"reset\" })\n\ttable.insert(out, { kind = \"back\" })\n\treturn out\nend\n\nfunction SettingsNav.new(): any\n\tlocal rows = SettingsNav.rows()\n\tlocal self = setmetatable({ rows = rows, at = 1 }, SettingsNav)\n\tself:first()\n\treturn self\nend\n\nlocal function choosable(row: Row): boolean\n\treturn row.kind ~= \"header\"\nend\n\nfunction SettingsNav.first(self: any)\n\tfor i, r in self.rows do\n\t\tif choosable(r) then\n\t\t\tself.at = i\n\t\t\treturn\n\t\tend\n\tend\nend\n\nfunction SettingsNav.current(self: any): Row\n\treturn self.rows[self.at]\nend\n\nfunction SettingsNav.select(self: any, index: number): boolean\n\tlocal r = self.rows[index]\n\tif r == nil or not choosable(r) then return false end\n\tself.at = index\n\treturn true\nend\n\nfunction SettingsNav.selectId(self: any, id: string): boolean\n\tfor i, r in self.rows do\n\t\tif r.kind == \"setting\" and r.id == id then\n\t\t\tself.at = i\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\n-- One choosable row down (+1) or up (-1), wrapping.\nfunction SettingsNav.move(self: any, dir: number)\n\tlocal n = #self.rows\n\tlocal step = if dir < 0 then -1 else 1\n\tlocal i = self.at\n\tfor _ = 1, n do\n\t\ti = (i - 1 + step) % n + 1\n\t\tif choosable(self.rows[i]) then\n\t\t\tself.at = i\n\t\t\treturn\n\t\tend\n\tend\nend\n\n-- The first setting of the next (+1) or previous (-1) section, wrapping; from Reset or Back, the first or last section.\nfunction SettingsNav.section(self: any, dir: number)\n\tlocal starts: { number } = {}\n\tfor i, r in self.rows do\n\t\tif r.kind == \"header\" then table.insert(starts, i + 1) end\n\tend\n\tif #starts == 0 then return end\n\tlocal here = self.rows[self.at]\n\tlocal current = 0\n\tfor k, s in starts do\n\t\tif s <= self.at then current = k end\n\tend\n\tlocal target: number\n\tif dir < 0 then\n\t\t-- partway down a section, Previous goes to its start first\n\t\tif here.kind == \"setting\" and starts[current] ~= self.at then target = current else target = (current - 2) % #starts + 1 end\n\t\tif here.kind ~= \"setting\" then target = #starts end\n\telse\n\t\ttarget = current % #starts + 1\n\t\tif here.kind ~= \"setting\" then target = 1 end\n\tend\n\tself.at = starts[target]\nend\n\nreturn SettingsNav\n",3047,1824779189},{"Shared/UI/SettingsText","--!strict\n-- The settings panel's words for the device in use, and its layout rules for the screen (ROBLOX-49): sizes by kind, how a row is laid out\n-- (the label beside its control, or the control underneath on a narrow screen or with large text), and how much room the panel has.\n-- Pure, so tests/settings.luau checks the layout at phone, tablet and desktop sizes without Roblox; Client/SettingsPanel only places what\n-- this says. Button names come from ControlText (PlayStation names on a PlayStation controller).\nlocal ControlText = require(script.Parent.ControlText)\nlocal NotebookText = require(script.Parent.NotebookText)\n\nlocal SettingsText = {}\n\n-- Text sizes by kind at normal text; LARGE is the large-text option's factor (the same one the notebook and menus use).\nSettingsText.SIZES = { heading = 26, section = 20, label = 18, value = 16, note = 14, controls = 14, button = 18 }\nSettingsText.LARGE = NotebookText.LARGE\n-- A button, a row and a bar's hit area are at least this tall at normal text (touch targets; scaled with the text).\nSettingsText.MIN_TARGET = 44\n-- The widest control cluster of each kind at normal text: a toggle's button; a choice's two arrows and its word; a slider's minus, bar,\n-- number and plus.\n-- An action's (ROBLOX-90) is one wider button, for \"Look closely\".\nSettingsText.CONTROL = { toggle = 96, choice = 240, slider = 360, action = 160 } :: { [string]: number }\n-- A label needs at least this much width beside its control; otherwise the control goes underneath.\nSettingsText.MIN_LABEL = 170\nSettingsText.PAD = 10\nSettingsText.GAP = 6\nSettingsText.VALUE_WIDTH = 104 -- a slider's number (e.g. \"100%\", \"65 degrees\")\nSettingsText.SCROLLBAR = 8\nSettingsText.MIN_BODY = 120\nSettingsText.MAX_PANEL = { w = 900, h = 820 }\n-- Holding Left or Right on a slider: the pause before it repeats and the seconds between repeats; the right stick's scroll speed in pixels a\n-- second at full tilt; a key press that scrolls this many pixels.\nSettingsText.REPEAT_DELAY = 0.4\nSettingsText.REPEAT_RATE = 0.08\nSettingsText.SCROLL_PX_S = 520\nSettingsText.STEP_PX = 120\n\nfunction SettingsText.scale(large: boolean): number\n\treturn if large then SettingsText.LARGE else 1\nend\n\n-- The line under the list: what the controls do, on the device in use.\nfunction SettingsText.controls(device: ControlText.Device): string\n\tif device == \"gamepad\" then\n\t\tlocal n = function(action: string): string return ControlText.name(\"gamepad\", action) end\n\t\treturn `Stick or D-pad: choose and change    {n(\"jump\")}: switch    {n(\"lock\")} and {n(\"choose\")}: sections    {n(\"cancel\")}: back`\n\telseif device == \"touch\" then\n\t\treturn \"Tap a setting to switch it. Use - and + or drag a bar.\"\n\tend\n\treturn `Up/Down: choose    Left/Right: change    Enter: switch    PageUp/PageDown: sections    {ControlText.name(\"keyboard\", \"settings\")} or {ControlText.name(\"keyboard\", \"cancel\")}: back`\nend\n\n-- How to open the settings, on the device in use.\nfunction SettingsText.openHint(device: ControlText.Device): string\n\tif device == \"gamepad\" then\n\t\treturn `{ControlText.name(\"gamepad\", \"menu\")}, then Settings`\n\telseif device == \"touch\" then\n\t\treturn \"Menu, then Settings\"\n\tend\n\treturn `{ControlText.name(\"keyboard\", \"settings\")}, or {ControlText.name(\"keyboard\", \"menu\")} then Settings`\nend\n\nexport type Metrics = { paperW: number, paperH: number, head: number, hint: number, foot: number, body: number, bodyW: number }\n\n-- Pixel sizes for a safe area of this size: the paper (97% by 95%, at most MAX_PANEL), the heading band, the controls line (two lines, three on a narrow phone; 0 when\n-- the list would be left with less than MIN_BODY px), the footer's buttons and the height left for the list.\nfunction SettingsText.metrics(width: number, height: number, scale: number): Metrics\n\tlocal paperW, paperH = math.min(width * 0.97, SettingsText.MAX_PANEL.w), math.min(height * 0.95, SettingsText.MAX_PANEL.h)\n\tlocal head = math.floor((SettingsText.SIZES.heading + 10) * scale)\n\tlocal foot = math.floor((SettingsText.MIN_TARGET + 8) * scale)\n\tlocal lines = if paperW < 500 then (if scale > 1 then 4 else 3) else 2 -- (a narrow phone wraps the line to a third row, or a fourth in large text)\n\tlocal hint = math.ceil(lines * SettingsText.SIZES.controls * scale * 1.25) + 4\n\tlocal body = paperH - 20 - head - foot - 12\n\tif body - hint >= SettingsText.MIN_BODY then body -= hint else hint = 0 end\n\treturn { paperW = paperW, paperH = paperH, head = head, hint = hint, foot = foot, body = body, bodyW = paperW - 28 - SettingsText.SCROLLBAR }\nend\n\nexport type RowLayout = { stacked: boolean, labelW: number, controlW: number, valueTop: boolean }\n\n-- A row's layout for a list this wide: the label beside the control, or (a narrow screen, large text) the control underneath, full width.\n-- A stacked slider keeps its number on the label's line (top right) so the bar has room between its - and +.\nfunction SettingsText.controlWidth(kind: string, scale: number): number\n\treturn math.floor(SettingsText.CONTROL[kind] * scale)\nend\nfunction SettingsText.rowLayout(bodyW: number, kind: string, scale: number): RowLayout\n\tlocal pad = SettingsText.PAD * scale\n\tlocal cw = SettingsText.controlWidth(kind, scale)\n\tlocal labelW = bodyW - cw - 3 * pad\n\tif labelW >= SettingsText.MIN_LABEL * scale then\n\t\treturn { stacked = false, labelW = labelW, controlW = cw, valueTop = false }\n\tend\n\tlocal full = bodyW - 2 * pad\n\tif kind == \"slider\" then\n\t\treturn { stacked = true, labelW = full - math.floor(SettingsText.VALUE_WIDTH * scale) - SettingsText.GAP * scale, controlW = full, valueTop = true }\n\tend\n\treturn { stacked = true, labelW = full, controlW = math.min(full, math.max(cw, math.floor(bodyW * 0.7))), valueTop = false }\nend\n\n-- A row's height from its measured label and note heights (0 for no note).\nfunction SettingsText.rowHeight(layout: RowLayout, labelH: number, noteH: number, scale: number): number\n\tlocal pad = SettingsText.PAD * scale\n\tlocal target = math.floor(SettingsText.MIN_TARGET * scale)\n\tlocal text = labelH + (if noteH > 0 then noteH + 2 else 0)\n\tif layout.stacked then\n\t\treturn math.ceil(pad + math.max(text, if layout.valueTop then target * 0.6 else 0) + SettingsText.GAP * scale + target + pad)\n\tend\n\treturn math.ceil(math.max(target + pad, text + 2 * pad))\nend\n\n-- The largest text size (at most `wanted`, at least 10) at which `word` fits a button `width` px wide and `height` tall: the word wraps, so\n-- the lines it needs (an estimate a little wider than Gotham's real letters) must fit the height.\nfunction SettingsText.buttonTextSize(word: string, width: number, height: number, wanted: number): number\n\tlocal size = wanted\n\twhile size > 10 do\n\t\tlocal lines = math.ceil(#word * size * 0.58 / math.max(1, width - 10))\n\t\tif lines * size * 1.2 <= height then return size end\n\t\tsize -= 1\n\tend\n\treturn 10\nend\n\nreturn SettingsText\n",6827,539160024},{"Shared/UI/TarantulaText","--!strict\n-- The words of the tarantulas' display key for the screen (ROBLOX-82): the prompt, the status line, the touch button and the controls card's\n-- line. The walking hint, the status line and the card carry them only for the two tarantulas. Button names come from ControlText for the\n-- device in use, except on touch, where the button says \"Rear up\" (ControlText's \"Dance\" is the peacock's, AntMimicText's \"Wave\" the ant's).\n-- Pure: checked in tests/tarantula.luau.\nlocal ControlText = require(script.Parent.ControlText)\n\nlocal TarantulaText = {}\n\nTarantulaText.STAND = \"Stand still on a surface to rear up\"\n\nlocal function key(device: ControlText.Device): string\n\treturn if device == \"touch\" then \"Rear up\" else ControlText.name(device, \"display\")\nend\n\n-- The walking hint's extra words.\nfunction TarantulaText.displayHint(device: ControlText.Device, showing: boolean): string\n\tif showing then return `{key(device)}: stop` end\n\treturn `{key(device)}: rear up`\nend\n\n-- The status line while the pose is on.\nfunction TarantulaText.statusLine(device: ControlText.Device): string\n\treturn `THREAT DISPLAY    {key(device)} or move: stop`\nend\n\n-- The touch button's words.\nfunction TarantulaText.touchDisplay(showing: boolean): string return if showing then \"Stop\" else \"Rear up\" end\n\n-- The controls card's line (ROBLOX-92: \"rear up and turn\", as the notebook page says; the pose is a drawn loop and no silk mat is laid). On touch the key is the button's own\n-- label, so it says \"button\" rather than repeating the label (\"Rear up rear up\").\nfunction TarantulaText.helpLine(device: ControlText.Device): string\n\treturn `{key(device)}{if device == \"touch\" then \" button:\" else \"\"} rear up and turn (any move, jump or Cancel stops it)`\nend\n\nreturn TarantulaText\n",1763,3505087579},{"Shared/UI/TitleText","--!strict\n-- The words and the typeface of the first minute (ROBLOX-109): the splash while the world streams in (First/SplashScreen), the title card the start\n-- menu becomes (Client/CaughtPanel's \"title\" look), the intro of a new life (Client/TitleCard) and the death and ending cards' typeface. Every word a\n-- player reads in those is here; the death and ending cards keep their own words (WaspText, LifeText, MateText). Pure: tests/title.luau checks them.\n--\n-- The typeface: Merriweather, a serif Roblox ships as a font family, Light for the title, Regular for the choices, Italic for the subtitle and the\n-- captions (a naturalist's notebook in print). A family Roblox cannot find falls back to its default face on its own; Studio is the judge of the look.\nlocal ControlText = require(script.Parent.ControlText)\n\nlocal TitleText = {}\n\nTitleText.TITLE = \"The Windowsill\"\nTitleText.SUBTITLE = \"A small life in a city's nature preserve.\" -- (ROBLOX-118: the preserve is the game; it begins on the ranger hut's windowsill)\n\nTitleText.FAMILY = \"rbxasset://fonts/families/Merriweather.json\"\n-- The colours: warm paper white for the words, a deep brown-black for the veil and the choices' ground.\nTitleText.INK = Color3.fromRGB(244, 238, 226)\nTitleText.SOFT = Color3.fromRGB(214, 205, 188)\nTitleText.GROUND = Color3.fromRGB(16, 14, 12)\n\n-- The title's size in pixels for a screen this wide: large on a monitor, still one line at a phone's width (360 px portrait).\nfunction TitleText.titleSize(width: number): number\n\treturn math.clamp(math.floor(width * 0.1), 30, 58)\nend\n\n-- The start menu's choices. On the title card (no life begun this visit) Continue is one word; in the life menu, beside \"Resume this spider\", it says\n-- where it goes back to. The ids are CaughtPanel's choice ids and the buttons' names.\nlocal START: { [string]: string } = {\n\tContinue = \"Continue\",\n\tContinueEasy = \"Continue the Easy life\",\n\tNew = \"Begin a new life\",\n\tEasy = \"Begin a new life on Easy\",\n\tFree = \"Free play - gentle rules\",\n}\nlocal IN_LIFE: { [string]: string } = {\n\tResume = \"Resume this spider\",\n\tControls = \"Controls\",\n\tContinue = \"Continue from last rest\",\n\tContinueEasy = \"Continue the Easy life from its last rest\",\n\tNew = \"Begin a new life\",\n\tEasy = \"Begin a new life on Easy\",\n\tFree = \"Free play - gentle rules\",\n}\nfunction TitleText.choice(id: string, started: boolean): string\n\treturn (if started then IN_LIFE[id] else START[id]) or START[id] or id\nend\n\n-- The one line under the choices for a controller (the D-pad or the stick moves, the confirm button chooses, the back button goes back): in the\n-- controller's own names (Cross and Circle on a PlayStation, A and B otherwise). The mouse, the keys and touch need no line.\nfunction TitleText.navHint(device: ControlText.Device): string\n\tif device ~= \"gamepad\" then return \"\" end\n\treturn `D-pad: move    {ControlText.name(\"gamepad\", \"jump\")}: choose    {ControlText.name(\"gamepad\", \"cancel\")}: back`\nend\n\n-- The intro's skip, shown once it can be skipped (after TitleShots.INTRO.skipAfter seconds): the jump key, the confirm button, or a tap.\nfunction TitleText.skipHint(device: ControlText.Device): string\n\tif device == \"touch\" then return \"Tap to skip\" end\n\treturn `{ControlText.name(device, \"jump\")}: skip`\nend\n\n-- The intro's captions, in the notebook's voice: what this spider is, how it hunts, and the day's one need. Each is backed by a notebook page\n-- (bold_jumper, retreat, hunting_by_sight; the last by the game's own numbers: a new spider's reserve lasts under a day in the standard rules,\n-- NeedsModel.ENERGY_START 0.55 at 0.612 a day, ROBLOX-88; the gentle rules drain it at 0.177 a day, ROBLOX-91).\nfunction TitleText.captions(gentle: boolean): { string }\n\treturn {\n\t\t\"A young bold jumping spider. Home is a silk-lined crack in the sill.\",\n\t\t\"It spins no web to catch food. It hunts with its eyes.\",\n\t\tif gentle then \"Hunger is gentler in these rules. It is never gone.\" else \"It has not eaten. It must eat today.\",\n\t}\nend\n\nreturn TitleText\n",4007,2794866054},{"Shared/UI/WaspText","--!strict\n-- The words of the wasp's visit for the screen (ROBLOX-26): the sound captions, the status line while it visits and the plain screen\n-- after a catch. The texts are Godot's (scripts/habitat/habitat_loop.gd _wasp_line, scripts/audio/soundscape.gd WASP_CAPTIONS,\n-- scripts/presentation/caught_panel.gd); where they differ it is said here. Button names come from ControlText for the device in use.\n-- Pure: checked in tests/wasp.luau.\n--\n-- Differences from Godot: the captions say where the hum is, as the flies' \"[buzzing, ahead-left]\" does (Godot's wasp captions did\n-- not); the second line after a catch does not point to a notebook, which the port does not have yet; with no rest to go back to the\n-- one choice is \"Back to the start\"; with one, the screen also offers another spider as a new life (the client's presentEnd, ROBLOX-91: the sac and the generation are left behind).\nlocal ControlText = require(script.Parent.ControlText)\nlocal Data = require(script.Parent.Parent.Data.Wasp)\nlocal Heard = require(script.Parent.Heard)\n\nlocal WaspText = {}\n\nWaspText.LINE = \"A mud dauber wasp stung the spider and carried it away.\"\nWaspText.SUB = \"Its sting does not kill: it paralyses.\"\nWaspText.RIVAL_TAKEN = \"The wasp seized the other spider and carried it off. It is gone for today.\"\nWaspText.BACK = \"Back to your last rest\"\nWaspText.START = \"Back to the start\"\n\nlocal NAMES = { \"ahead\", \"ahead-left\", \"left\", \"behind-left\", \"behind\", \"behind-right\", \"right\", \"ahead-right\" }\n\nlocal function roundHalfAway(x: number): number\n\treturn if x >= 0 then math.floor(x + 0.5) else -math.floor(-x + 0.5)\nend\n\n-- Where `point` is from the spider (Godot VibrationSense.direction_word): the eighth of the compass round its heading, counted\n-- counter-clockwise seen from its up, then \"above\" or \"below\" when it is more than 35 degrees off the plane the spider stands on.\nfunction WaspText.directionWord(spider: Vector3, heading: Vector3, up: Vector3, point: Vector3): string\n\tlocal n = up\n\tlocal to = point - spider\n\tlocal rise = to:Dot(n)\n\tlocal flat = to - n * rise\n\tlocal word = \"\"\n\tif flat:Dot(flat) > 1.0e-6 then\n\t\tlocal f = flat.Unit\n\t\tlocal angle = math.deg(math.atan2(n:Dot(heading:Cross(f)), heading:Dot(f)))\n\t\tword = NAMES[(roundHalfAway(angle / 45.0) % 8) + 1]\n\tend\n\tlocal elevation = math.deg(math.atan2(rise, math.max(flat.Magnitude, 1.0e-6)))\n\tif elevation > 35.0 then\n\t\tword = if word == \"\" then \"above\" else \"above, \" .. word\n\telseif elevation < -35.0 then\n\t\tword = if word == \"\" then \"below\" else \"below, \" .. word\n\tend\n\treturn if word ~= \"\" then word else \"here\"\nend\n\n-- The caption of the visit now: { text, alpha }, or nil when there is none. While it arrives (the whole warning), when it has seen the\n-- spider (inspecting, striking), and for a few seconds as it leaves. None begins \"[buzzing\", which is the flies'.\nfunction WaspText.caption(phase: string, phaseS: number, direction: string): { text: string, alpha: number }?\n\tif phase == \"arriving\" then\n\t\treturn { text = `[a deep, heavy hum outside, {direction}, coming closer]`, alpha = 1.0 }\n\telseif phase == \"inspecting\" or phase == \"striking\" then\n\t\treturn { text = `[the deep hum turns toward you, {direction}]`, alpha = 1.0 }\n\telseif phase == \"taking\" or phase == \"seizing\" then\n\t\t-- (The wasp going for the rival male, ROBLOX-70; the host shows these only when it is near, WaspText.heardRival.)\n\t\treturn { text = `[the deep hum drops toward something on the sill, {direction}]`, alpha = 1.0 }\n\telseif phase == \"bearing\" then\n\t\treturn { text = `[a short scuffle, then the deep hum rising away with something, {direction}]`, alpha = 1.0 }\n\telseif phase == \"leaving\" and phaseS < Data.captionTailS then\n\t\tlocal left = Data.captionTailS - phaseS\n\t\treturn { text = `[the deep hum fades away, {direction}]`, alpha = math.clamp(left / Data.captionFadeS, 0.0, 1.0) }\n\tend\n\treturn nil\nend\n\n-- Whether the player hears or sees the wasp take the rival: it is within earshot of the spider, or in clear sight of it (`seen`) and not too far.\nfunction WaspText.heardRival(distance: number, seen: boolean): boolean\n\treturn Heard.within(distance, seen) -- (the rule is UI/Heard's, ROBLOX-92; the mate's notices use it too)\nend\n\n-- What the status says while the wasp visits (nil when it is away). The first visit says what wasps do and how to get away.\nfunction WaspText.line(phase: string, confused: boolean, visits: number, spared: boolean, device: ControlText.Device): string?\n\tif phase == \"arriving\" then\n\t\tif visits <= 1 then\n\t\t\treturn `A deep hum outside: a wasp is coming, and wasps hunt spiders. Hide in the crack, keep still, or let yourself down on your line ({ControlText.name(device, \"drop\")}).`\n\t\tend\n\t\treturn \"A deep hum outside: a wasp is coming. Hide in the crack, keep still, or drop on your line.\"\n\telseif phase == \"searching\" then\n\t\tif confused then return \"The wasp has lost you. Get out of sight.\" end\n\t\treturn \"A wasp is searching the sill. Keep still, keep out of sight, or get home to the crack.\"\n\telseif phase == \"inspecting\" or phase == \"striking\" then\n\t\treturn \"The wasp has seen you! Get away: jump, drop on your line, or reach the crack.\"\n\telseif phase == \"taking\" or phase == \"seizing\" then\n\t\treturn \"The wasp is after something else on the sill. Keep still or keep out of sight until it goes.\"\n\telseif phase == \"bearing\" then\n\t\treturn \"The wasp has taken something and is leaving with it.\"\n\telseif phase == \"carrying\" then\n\t\treturn \"Stung, the spider cannot move. The wasp carries it away.\"\n\telseif phase == \"leaving\" then\n\t\tif spared then return \"The wasp touched you with its antennae, gave up, and is leaving.\" end\n\t\treturn \"The wasp is leaving.\"\n\tend\n\treturn nil\nend\n\n-- The life in a few plain lines: how long it lived, its meals, the wasp. Never a score. `hours` of life, `meals` finished, and the\n-- wasp's visits and escapes.\nfunction WaspText.summary(hours: number, meals: number, visits: number, escapes: number): string\n\tlocal lived = \"less than a day\"\n\tif hours >= 24.0 then\n\t\tlocal days = math.floor(hours / 24.0)\n\t\tlived = `{days} day{if days == 1 then \"\" else \"s\"}`\n\tend\n\tlocal out = { `It lived {lived}.`, `It ate {meals} meal{if meals == 1 then \"\" else \"s\"}.` }\n\tif visits > 0 then\n\t\ttable.insert(out, `The wasp came {visits} time{if visits == 1 then \"\" else \"s\"}; it got away from it {escapes} time{if escapes == 1 then \"\" else \"s\"}.`)\n\tend\n\treturn table.concat(out, \"\\n\")\nend\n\n-- The catch screen `seconds` after it began: how dim the world is, and whether the line, then the summary and the choices, show.\nfunction WaspText.panel(seconds: number): { dim: number, line: boolean, choices: boolean }\n\treturn {\n\t\tdim = math.clamp(seconds / Data.caughtQuietS, 0.0, 1.0) * Data.caughtDim,\n\t\tline = seconds >= Data.caughtQuietS,\n\t\tchoices = seconds >= Data.caughtQuietS + Data.caughtLineS,\n\t}\nend\n\n-- The button's words: back to the last rest when there is one, else back to the start.\nfunction WaspText.choice(hasRest: boolean): string\n\treturn if hasRest then WaspText.BACK else WaspText.START\nend\n\nreturn WaspText\n",7025,878459514},{"Shared/UI/WaterText","--!strict\n-- The water in words (ROBLOX-122; the water is Life/Water): the caption while the spider struggles at the surface, its death card, and the notices when it gets out\n-- or is pulled out (the gentle rules). Pure: tests/preserve.luau checks the words, tests/quiet.luau their classes.\nlocal WaterText = {}\n\nWaterText.STRUGGLE = \"[splashing at the surface]\"\nWaterText.LINE = \"The water held on.\"\nWaterText.SUB = \"A jumping spider cannot walk on water. Nothing it could reach stood out of the pond, and the struggle wore it out.\"\nWaterText.OUT = \"You scrambled out of the water.\"\nWaterText.PULLED = \"The ripples carried you to something to climb. You hauled yourself out.\"\nWaterText.CAUSE = \"drowned\" -- (the end of a life's cause, LifeSession; Life/Water.CAUSE)\n\nreturn table.freeze(WaterText)\n",799,2924352060},{"Shared/World/AntForage","--!strict\n-- Clock-derived ambient workers. The carried fragments are presentation, not\n-- food removed from the saved prey ecology. No locomotion/capture rule changes.\nlocal Environment=require(script.Parent.Environment)\nlocal AntForage={}\nlocal TAU=math.pi*2\nlocal routes: {[number]:any}={}\nfunction AntForage.route(index: number): any\n if routes[index] then return routes[index] end\n local angle=Environment.hash(914,index,211)*TAU\n local direction=Vector3.new(math.cos(angle),0,math.sin(angle))\n local distance=9+Environment.hash(914,index,223)*6\n local speed=1.1+Environment.hash(914,index,227)*.8\n local route=table.freeze({direction=direction,across=Vector3.new(-direction.Z,0,direction.X),distance=distance,\n  bow=(Environment.hash(914,index,229)-.5)*2,travel=distance/speed,pause=2.5,inside=4})\n routes[index]=route;return route\nend\nfunction AntForage.sample(seconds: number,index: number): any\n local r=AntForage.route(index)\n local period=r.inside+r.travel*2+r.pause\n local phase=(seconds+index*7.3)%period\n local mode,u=\"inside\",0\n if phase>=r.inside+r.travel+r.pause then\n  mode=\"return\";u=1-(phase-r.inside-r.travel-r.pause)/r.travel\n elseif phase>=r.inside+r.travel then mode=\"forage\";u=1\n elseif phase>=r.inside then mode=\"outbound\";u=(phase-r.inside)/r.travel end\n local offset=r.direction*(r.distance*u)+r.across*(r.bow*math.sin(math.pi*u))\n local heading=(r.direction*r.distance+r.across*(r.bow*math.pi*math.cos(math.pi*u))).Unit\n if mode==\"return\" then heading=-heading end\n local distance=offset.Magnitude\n return {offset=offset,heading=heading,mode=mode,visible=mode~=\"inside\",moving=mode==\"outbound\" or mode==\"return\",\n  carrying=mode==\"return\" and distance>.4,burrow=math.clamp(1-distance/.4,0,1)*.45,\n  period=period}\nend\nreturn table.freeze(AntForage)\n",1778,858419350},{"Shared/World/DogGround","--!strict\n-- Cosmetic dog's ground LOD: an index of the same authored physical boxes the\n-- server builds. No new floor, queryable part, or player collision is created.\n-- The native ray wins when streamed; this covers distant unloaded ground.\nlocal Region=require(script.Parent.Region)\nlocal Environment=require(script.Parent.Environment)\nlocal Ground={}\nlocal CELL=64\nlocal function key(x: number,z: number): string return math.floor(x/CELL)..\":\"..math.floor(z/CELL) end\nfunction Ground.new(map: any): any\n local cells: {[string]: {any}}={}\n if type(map.regions)~=\"function\" then return {cells=cells} end\n local minX,maxX,minZ,maxZ=math.huge,-math.huge,math.huge,-math.huge\n for _,p in Environment.DOG_ROUTE do\n  minX,maxX=math.min(minX,p.X-50),math.max(maxX,p.X+50)\n  minZ,maxZ=math.min(minZ,p.Z-50),math.max(maxZ,p.Z+50)\n end\n for _,r in map.regions() do\n  local a,b=r.bounds[1],r.bounds[2]\n  if b.X<minX or a.X>maxX or b.Z<minZ or a.Z>maxZ or b.Y< -93 or a.Y> -76 then continue end\n  for _,p in Region.pieces(r) do\n  -- This dog lives on the outdoor circuit, near its ground level. Upper\n  -- leaves, roofs and indoor furniture are not distant proxy terrain.\n  if p.hi.Y>=-93 and p.hi.Y<=-76 then\n   for x=math.floor(p.lo.X/CELL),math.floor(p.hi.X/CELL) do\n    for z=math.floor(p.lo.Z/CELL),math.floor(p.hi.Z/CELL) do\n     local k=x..\":\"..z;cells[k]=cells[k] or {};table.insert(cells[k],p)\n    end\n   end\n  end\n end end\n return {cells=cells}\nend\nfunction Ground.at(self: any,at: Vector3,up: number,down: number): Vector3?\n local best=nil :: number?\n for _,p in self.cells[key(at.X,at.Z)] or {} do\n  if at.X>=p.lo.X and at.X<=p.hi.X and at.Z>=p.lo.Z and at.Z<=p.hi.Z\n   and p.hi.Y<=at.Y+up and p.hi.Y>=at.Y+up-down and (best==nil or p.hi.Y>best) then best=p.hi.Y end\n end\n return if best then Vector3.new(at.X,best,at.Z) else nil\nend\nreturn Ground\n",1852,951282743},{"Shared/World/Environment","--!strict\n-- Habitat weather is reconstructed from the saved life clock, not rerolled on load.\n-- Weather probabilities, temperatures and wind are authored temperate late-summer art direction.\n-- Solar elevation uses the standard latitude/declination/hour-angle relation (NOAA solar equations).\n-- Hours are local apparent solar time; no claim of matching the player's real location or civil timezone.\nlocal Environment = {}\nEnvironment.LATITUDE = 41.88\nEnvironment.START_DAY_OF_YEAR = 235\nEnvironment.FRONT_HOURS = 2\nEnvironment.INDOORS = table.freeze({sill=true,counter=true,kitchen_floor=true,hut_floor=true,hut_upper=true,hut_desk=true,\n hut_board=true,hut_shelf=true,hut_chair=true,hut_window=true,hut_doorway=true,hut_door_up=true,\n room_floor=true,room_sofa=true,room_tv=true,room_games=true,room_window=true})\n\nlocal TAU = math.pi*2\nlocal function good(x: number, fallback: number): number\n return if x==x and math.abs(x)<1e12 then x else fallback\nend\nlocal function smooth(x: number): number\n local t=math.clamp(x,0,1);return t*t*(3-2*t)\nend\nfunction Environment.hash(seed: number, n: number, salt: number): number\n local x=(math.floor(seed)+math.floor(n)*7919+salt*104729)%2147483647\n x=(x*16807+12345)%2147483647;x=(x*16807)%2147483647\n return x/2147483647\nend\nlocal function front(seed: number, n: number): any\n local h=Environment.hash(seed,n,13)\n local rain=if h>.84 then .85 elseif h>.65 then .32 else 0\n return {rain=rain,cloud=if rain>0 then .85 else .12+.5*Environment.hash(seed,n,17),\n  wind=.6+Environment.hash(seed,n,19)*3.2,angle=Environment.hash(seed,n,23)*TAU}\nend\nfunction Environment.solar(day: number, hour: number): any\n local doy=(Environment.START_DAY_OF_YEAR+math.floor(good(day,1))-2)%365+1\n local gamma=TAU*(doy-1+(hour-12)/24)/365\n local dec=.006918-.399912*math.cos(gamma)+.070257*math.sin(gamma)-.006758*math.cos(2*gamma)\n  +.000907*math.sin(2*gamma)-.002697*math.cos(3*gamma)+.00148*math.sin(3*gamma)\n local lat=math.rad(Environment.LATITUDE);local ha=math.rad((hour-12)*15)\n local east=-math.cos(dec)*math.sin(ha)\n local north=math.cos(lat)*math.sin(dec)-math.sin(lat)*math.cos(dec)*math.cos(ha)\n local up=math.sin(lat)*math.sin(dec)+math.cos(lat)*math.cos(dec)*math.cos(ha)\n local altitude=math.deg(math.asin(math.clamp(up,-1,1)))\n return {direction=Vector3.new(east,up,-north),altitude=altitude,declination=math.deg(dec),dayOfYear=doy,\n  daylight=smooth((altitude+6)/12)}\nend\n-- Roblox's native sky uses a tilted circular track: changing ClockTime alone\n-- gives a constant north/south component. Convert the astronomical direction to\n-- the two rendering controls instead. The life clock remains local solar time.\n-- The 23.5-degree engine tilt was checked against Lighting:GetSunDirection in Studio.\nfunction Environment.nativeSun(direction: Vector3): any\n local v=direction.Unit\n return {clock=(12+math.atan2(-v.X,v.Y)*12/math.pi)%24,\n  latitude=23.5+math.deg(math.asin(math.clamp(v.Z,-1,1)))}\nend\nfunction Environment.sample(day: number, hour: number, seed: number?): any\n local d=math.max(1,good(day,1));local h=good(hour,9)\n local total=(d-1)*24+h;local slot=math.floor(total/Environment.FRONT_HOURS)\n local t=smooth((total-slot*Environment.FRONT_HOURS)/.75)\n local s=seed or 914;local a,b=front(s,slot-1),front(s,slot)\n local rain=a.rain+(b.rain-a.rain)*t;local cloud=a.cloud+(b.cloud-a.cloud)*t\n -- Blend vectors, rather than angles, so a front never spins through the long way round north.\n local wx=math.cos(a.angle)*a.wind*(1-t)+math.cos(b.angle)*b.wind*t\n local wz=math.sin(a.angle)*a.wind*(1-t)+math.sin(b.angle)*b.wind*t\n local gust=.8+.16*math.sin(total*147)+.12*math.sin(total*53+.7)\n local solar=Environment.solar(d,h%24)\n local damp=rain\n for back=1,4 do damp=math.max(damp,front(s,slot-back).rain*(1-back*.19)) end\n local seasonal=math.cos(TAU*(solar.dayOfYear-200)/365)\n local temperature=13+9*seasonal+5*math.cos(TAU*((h%24)-15)/24)-3*rain\n return {day=d,hour=h%24,totalHours=total,solar=solar,cloud=cloud,rain=rain,\n  name=if rain>.62 then \"rain\" elseif rain>.08 then \"drizzle\" elseif cloud>.55 then \"overcast\" else \"fair\",\n  wind=Vector3.new(wx,0,wz)*gust,wetness=math.clamp(damp,0,1),temperature=temperature,\n  humidity=math.clamp(.42+cloud*.27+rain*.25+(1-solar.daylight)*.12,0,1),\n  mist=math.clamp(damp*(1-solar.daylight)*.45,0,.4)}\nend\nfunction Environment.grub(day: number, hour: number, index: number, wetness: number): (number, number)\n local t=((day-1)*24+hour)*3600/48 -- action seconds at the sill's normal clock rate\n local period=34+Environment.hash(914,index,47)*37\n local phase=(t+Environment.hash(914,index,53)*period)%period\n local show=if wetness>.18 and phase<7 then math.sin(math.pi*phase/7) else 0\n return show,phase\nend\nfunction Environment.flea(seconds: number, index: number): (Vector3, boolean, Vector3)\n local period=2.7+Environment.hash(914,index,59)*2.2\n local phase=(seconds+index*.83)%period;local hop=.22\n local u=math.clamp(phase/hop,0,1)\n local cycle=math.floor((seconds+index*.83)/period)\n local function landing(n: number): Vector3\n  local angle=Environment.hash(914,n,index+61)*TAU\n  local radius=.25+Environment.hash(914,n,index+67)*.95\n  return Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)\n end\n local from,to=landing(cycle-1),landing(cycle)\n local direction=to-from\n local heading=if direction.Magnitude>1e-6 then direction.Unit else Vector3.zAxis\n -- Endpoints depend only on the clock. The next hop begins at this landing;\n -- keeping the movement local never requires snapping back to the spawn.\n return from:Lerp(to,u)+Vector3.new(0,if phase<hop then 4*1.8*u*(1-u) else 0,0),phase<hop,heading\nend\n-- A leashed-sized park dog on a lawn circuit, with stops to sniff. No attack or save outcome is added.\n-- The dog needs room for its whole body, not merely four supported paw points.\n-- This lawn loop stays west of the raised beds and inside the authored ground.\nEnvironment.DOG_ROUTE=table.freeze({Vector3.new(-340,-84.6,-100),Vector3.new(-235,-84.6,-100),\n Vector3.new(-285,-84.6,-150)})\nfunction Environment.dog(seconds: number, rain: number): any\n local route=Environment.DOG_ROUTE;local durations={};local total=0\n for i,a in route do\n  local move=(route[i%#route+1]-a).Magnitude/140\n  durations[i]=move+5.5;total+=durations[i]\n end\n local cycle=seconds%total;local leg=1\n while cycle>durations[leg] and leg<#route do cycle-=durations[leg];leg+=1 end\n local a,b=route[leg],route[leg%#route+1]\n local moving=durations[leg]-5.5;local sniff=cycle>=moving\n local u=math.clamp(cycle/moving,0,1)\n local position=a:Lerp(b,u)\n local heading=(b-a).Unit\n if sniff then\n  local nextHeading=(route[(leg+1)%#route+1]-b).Unit\n  local turn=smooth(math.clamp((cycle-moving-4)/1.5,0,1))\n  local yaw=math.atan2(heading.Z,heading.X)\n  local nextYaw=math.atan2(nextHeading.Z,nextHeading.X)\n  local delta=math.atan2(math.sin(nextYaw-yaw),math.cos(nextYaw-yaw))\n  yaw+=delta*turn;heading=Vector3.new(math.cos(yaw),0,math.sin(yaw))\n end\n return {position=position,heading=heading,sniff=sniff,visible=true,\n  stride=if sniff then 0 else math.sin(seconds*TAU*2.4),tail=math.sin(seconds*TAU*2.2)*(.3-.2*math.clamp(rain,0,1))}\nend\n\n-- Local presentation state, separate from the saved ecology. In rain, finish\n-- the supported circuit to a sniff stop near the hut; never cut across beds.\n-- Keep the route clock there until rain eases, then resume without a jump.\nfunction Environment.stepDog(wander: any,seconds: number,rain: number): any\n local delta=if wander.raw then seconds-wander.raw else 0\n if wander.time==nil or delta<0 or delta>2 then wander.time=seconds;wander.rest=false;delta=0 end\n wander.raw=seconds\n if wander.rest and rain<.45 then wander.rest=false end\n if not wander.rest then wander.time+=delta end\n local pose=Environment.dog(wander.time,rain)\n if rain>.7 and pose.sniff and pose.position.Z>-130 then wander.rest=true end\n pose.rainRest=wander.rest==true\n return pose\nend\n\nreturn table.freeze(Environment)\n",7926,2546960820},{"Shared/World/Garden","--!strict\n-- The world outside the glass (ROBLOX-95, docs/OPEN_WORLD_DESIGN.md W2): the generators of the three regions under the window, as pure data. Region asks here for every\n-- kind that is not the sill; nothing here builds a part or knows the engine, so the server, the client and the CLI tests all get the same boxes from the same region.\n--   outer_sill .. the stone slab the raised sash opens onto (top y 0, x -30..30, z -24..-13.5) and the window box's two halves that stand on it (Data/Flora's\n--                 garden box, drawn by the sill's Decor and solid here); its look is worn paint over stone, moss in the corners, grit and rain streaks down its face.\n--   house_wall ... the brick wall under it, face at z -24 from y 0 to the lawn at y -90.4, x -40..40: one box below the slab and two shoulders beside it, all\n--                 drawn as brick courses over recessed mortar (the boxes turn invisible once the bricks exist), with the house going on above the outer sill\n--                 around the window (drawn only).\n--   bed .......... the soil under the window (top y -90, x -25..25, z -24..-74): soil mounds, three stones (one raised on two rests over a gap, the bed's\n--                 retreat, World/WorldMap's bed_a_stone), two plants whose stems and leaves are boxes as the Pilea's are, and drawn soil, leaf litter, grass,\n--                 twigs, pebbles, lichen and moss.\n-- Everything placed is placed from the region's own seed (WorldMap.seed), by a Park-Miller stream of its own for each kind of thing, so the same region is the\n-- same garden forever, and a drawn thing that the low tier drops (`full`) never moves what the low tier keeps. The physical pieces are the walkable world: the\n-- motor walks their faces, RivalRoute builds the region's graph from them. A drawn record is one part (Habitat/Scenery.look builds them); the region's budget\n-- (Region.budget) is a ceiling the placer keeps to at both tiers, and tests/world.luau holds the counts.\n-- ROBLOX-96 (W3, garden life): the bed's life is placed here too, from the same seed: `prey(region)` is the bed's perch and vent list for a Prey/PreyDirector\n-- (on the soil, the mounds' and stones' tops, under the dock's leaves for the gnats; on the plants' leaves and the dock's stem for the aphids, which only walk),\n-- and `bugs(region)` the woodlice's starting places and the spots they hide in (under the big stone, at the other stones' feet, under the litter). The wall's look\n-- gains the descent's dressing: lichen on the brick, a weathered course and cobweb strands in the corner under the outer sill.\n-- ROBLOX-101 (W3b part A, the garden's bestiary): `bestiary(region)` is the list of the region's other prey, one spec per kind, each for a director of its own\n-- (Prey/PreyWorld): springtails on the soil round the stones and the litter and leafhoppers on the dock's and the dandelion's stems and leaves in the bed; small\n-- moths and crane flies on the house wall and on the outer sill (the slab by the window, the window box's fronts, the slab's front edge). From the same seed\n-- by streams of their own, so W3's perches, vents and prey are what they were.\n-- ROBLOX-103 (W3c, the look): a fourth kind, `wall_upper` (docs/WORLD_MAP_PLAN.md region 4: the house is a single story): the brick above the window up to the\n-- eaves on the window's two jambs, the eaves' soffit, the fascia, the gutter hung on it (a walkable high perch) and the eave course of the roof; its look carries\n-- the rest of the house as a backdrop (the back wall on either side to 5 m out, the roof over it all, the eaves and gutter along it, a downpipe, a window and the\n-- back door), all drawn only until wall_west and wall_east are built. And more on the three built looks: drip stains and moss in the wall's joints, petals and\n-- seeds on the outer sill, veins on the bed's leaves, seed heads on its grass and more kinds of litter, each from a stream of its own after what was placed\n-- before, so nothing placed before moves.\n-- ROBLOX-112 (the house in true proportion, and the first of the inside): `wall_upper` is the window and the wall round it (the jambs, the window's box above the back\n-- frame, which the sill's Decor draws, the room's reveal and its wall beside the window), the brick above the window's head is the kind `eaves` (and `eaves_west` on\n-- the west wall, which now stops at the head), and the kitchen begins: `counter` (the worktop under the sill board, the sink, the tap, the toaster over its gap, the\n-- kettle) and `kitchen_floor` (the floor in front of it, the cupboards). The eaves' look draws the room beyond the window until the rooms are built.\nlocal Flora = require(script.Parent.Parent.Data.Flora)\nlocal WorldMap = require(script.Parent.WorldMap)\nlocal Hut = require(script.Parent.Hut) -- (ROBLOX-116: the preserve's hut garden lives by the same questions; its answers are World/Hut's)\nlocal Meadow = require(script.Parent.Meadow) -- (ROBLOX-119: and the meadow's edge and the bench patch, World/Meadow's)\nlocal Pond = require(script.Parent.Pond) -- (ROBLOX-122: and the pond's edge, World/Pond's)\n\nlocal Pocket = require(script.Parent.GardenPocket)\nlocal Verge = require(script.Parent.Verge)\nlocal Garden = {}\n\n-- A physical box (WindowsillLayout.Piece) with the material it is drawn in when nothing draws it instead.\nexport type Piece = { id: string, lo: Vector3, hi: Vector3, profile: string, color: Color3, material: string? }\n-- A drawn-only part: centred `at`, `size`, turned by `turn` (degrees about X, Y and Z, in that order, as CFrame.Angles), `shape` \"Block\" (the default),\n-- \"Ball\", \"Cylinder\" (its axis along X) or \"Ellipsoid\" (a sphere mesh); `full`: the low tier drops it (FullOnly); `group`: the folder it is built into.\nexport type Drawn = {\n\tid: string, size: Vector3, at: Vector3, color: Color3, transparency: number?,\n\tmaterial: string?, shape: string?, turn: Vector3?, full: boolean?, group: string?, shadow: boolean?,\n\tfar: boolean?, reflectance: number?, -- (ROBLOX-115: the preserve's backdrop: in the zone's far look; a shine)\n\tdew: number?, -- (ROBLOX-117: a dew drop's lag: Habitat/DayLight.applyDew shows it by the hour, Habitat/Scenery.look hides it until then)\n}\nexport type Box = { min: Vector3, max: Vector3 }\n\nlocal TAU = 2 * math.pi\nlocal MOD = 2147483647\n\nlocal function hex(s: string): Color3\n\treturn Color3.fromHex(s)\nend\nlocal function v(x: number, y: number, z: number): Vector3\n\treturn Vector3.new(x, y, z)\nend\n-- A Park-Miller stream from the region's seed and a salt for the kind of thing it places (the same stream as Habitat/Shapes.rng).\nlocal function rng(seed: number, salt: number): () -> number\n\tlocal state = (seed + salt * 7919) % MOD\n\tif state <= 0 then state += MOD - 1 end\n\treturn function(): number\n\t\tstate = (state * 16807) % MOD\n\t\treturn (state - 1) / (MOD - 1)\n\tend\nend\nlocal function between(rand: () -> number, a: number, b: number): number\n\treturn a + (b - a) * rand()\nend\nlocal function pick<T>(list: { T }, rand: () -> number): T\n\treturn list[1 + math.floor(rand() * #list)]\nend\nlocal function overlaps(a: Box, b: Box, margin: number): boolean\n\treturn a.min.X < b.max.X + margin and a.max.X > b.min.X - margin and a.min.Z < b.max.Z + margin and a.max.Z > b.min.Z - margin\nend\n\n-- ---------------------------------------------------------------- the outer sill\nGarden.OUTER = {\n\tslab = { lo = v(-30, -3, -24), hi = v(30, 0, -13.5), color = \"ddd5c3\", material = \"Concrete\" }, -- painted stone, the paint gone dull\n\tstone = { \"a29d92\", \"948f85\", \"aaa497\" }, -- where the paint has gone\n\tmoss = { \"5f7d3a\", \"6d8c45\", \"53703a\", \"7a9450\" },\n\tgrit = { \"7d7466\", \"6a6358\", \"9b9284\", \"57514a\", \"b0a898\" },\n\tstreak = \"8e8a80\",\n}\n\n-- ---------------------------------------------------------------- the house wall\nGarden.WALL = {\n\tface = -24, foot = -90.4, under = -3, top = 0, west = -40, east = 40, back = -13.5,\n\tbrick = { length = 21.5, height = 6.5, joint = 1.0, depth = 0.6, recess = 0.28, gap = 0.02 },\n\tbricks = { \"9c4a32\", \"a65538\", \"8f4430\", \"b0603e\", \"974d36\", \"a2573c\", \"7e3c2b\" },\n\tburnt = \"5e3428\", pale = \"c08a64\", mortar = \"b8b1a3\", plaster = \"efe8d8\", coping = \"c9c2b3\",\n\tabove = 30, window = { x0 = -31, x1 = 31, y1 = 112.5 }, -- the house above the outer sill goes up to y 30 beside the window's frame (ROBLOX-112: the window goes up to its head, y 112.5)\n\tbrickMaterial = \"Concrete\", mortarMaterial = \"Plaster\",\n}\n\n-- ---------------------------------------------------------------- the wall above the window (ROBLOX-103) and the window itself (ROBLOX-112)\n-- Studs, the sill's frame. ROBLOX-112 (the house in true proportion): the kitchen window is a real one, its frame and glass from the sill up to the head at `head`\n-- (1.125 m above the sill, on a course joint), so `wall_upper` is now the window and the wall round it: the two brick jambs outside (x 31..40 either side, from the shoulders to the head),\n-- the window above the sill's back frame (`window`: the glass and its frame, climbable on both faces), the room's reveal either side of it (`reveal`, the sill's side\n-- frames going on up) and the room's wall beside it (`inner`, to x 62 either side, over the kitchen's counter). The brick above the head goes on to the eaves at `top`\n-- (1.5 m above the sill, 2.4 m above the lawn), and the eaves box (the soffit underneath) runs out to the fascia 40 cm from the wall; the gutter hangs on the fascia,\n-- its floor at `gutter.floor`; the eave course of tiles over it: those are the region `eaves`. `house`: the rest of the house drawn round it.\nGarden.UPPER = {\n\tface = -24, back = -13.5, west = -40, east = 40, jamb = 31, head = 112.5, top = 150, -- the jambs stand x 31..40 either side of the window, on the shoulders (y 0)\n\twindow = { bottom = 14, inner = -12.5, color = \"ded7c3\", profile = \"glass_clean\" }, -- (on the back frame's top, its room face the frame's)\n\treveal = { x = 30, room = 12.5 }, -- the room's reveal, x 30..31 either side (the sill's left_frame and right_frame go on up), to the room's wall face at z 12.5\n\tinner = { x = 62, color = \"efe8d8\" }, -- the room's wall beside the window, x 31..62 either side, from the sill's level to the head\n\teaves = { out = -64, top = 160, edge = 42 }, -- the soffit's box: from the wall out to z -64 (40 cm), y 150..160, x -42..42\n\tfascia = { out = -65.5, bottom = 146 },\n\tgutter = { floor = 148, thick = 1, lip = 155, out = -76, wall = 1, cap = 1, span = 40 }, -- floor y 148..149; the lip's inner face at z -76\n\troof = { eave = -72, thick = 1.5, pitch = 35, ridge = 376, x = 500, color = \"7b4a3d\", tiles = { \"8d4a3a\", \"7b4a3d\", \"934f3e\", \"6f4236\" }, material = \"Slate\" },\n\tpaint = \"ece7dc\", gutterColor = \"3a3c3e\", gutterMaterial = \"Metal\", houseMortar = \"a8927e\", -- (the long walls' mortar lines, toned toward the brick so they read as courses, not siding)\n\t-- the lintel over the window (drawn, ROBLOX-112): a concrete beam across the head, `lintel` tall, bearing `bearing` into the brick either side\n\tlintel = { h = 7.5, bearing = 15, color = \"b9b2a4\" },\n\t-- (the kitchen's window is the sill's, 62 wide and 112.5 tall with its sill at y 0: the house's other window is drawn the same; the back door, 2 m, stands on a step)\n\t-- ROBLOX-114 (to scale): the back door's leaf is a British standard external door's, 81.3 by 198.1 cm (2 ft 8 in by 6 ft 6 in; it was 85 by 200), in a frame\n\t-- `frame` wide each side, a glazed upper panel (`glass`: its bottom over the step's top, its size), a panel below and a lever handle at `handle` over the step\n\thouse = { x = 500, foot = -90.4, door = { x = 230, w = 81.3, h = 198.1, step = 14, color = \"3f5b4a\", frame = 4.5, glass = { bottom = 105, w = 55, h = 72 },\n\t\tpanel = { bottom = 14, w = 55, h = 70 }, handle = 100 }, window = { x = -260, w = 62, h = 112.5, sill = 0, transom = 55.5 }, pipe = { x = -50, d = 7 } },\n\tdebris = { \"6e4d2e\", \"8a6239\", \"5b4129\", \"a07445\" },\n}\n-- (ROBLOX-112) The window's box above the back frame: the sill's Decor draws it (Habitat/Scenery.window), so it turns invisible once that drawing exists.\nGarden.WINDOW_PIECE = \"wall_upper_window\"\n\n-- ---------------------------------------------------------------- the bed\nGarden.BED = {\n\tx0 = -25, x1 = 25, z0 = -74, z1 = -24, top = -90, bottom = -92,\n\tsoil = \"4a3a2c\", soilMaterial = \"Ground\",\n\tlanding = 5.0, -- the strip along the wall's foot kept flat for whatever comes down the wall\n\tmounds = { count = 6, w = { 4, 9 }, d = { 3, 7 }, h = { 0.4, 1.3 }, colors = { \"4f3e2f\", \"574433\", \"45362a\", \"5c4a39\" } },\n\tstones = { count = 2, w = { 3.2, 6.0 }, d = { 2.6, 4.8 }, h = { 1.0, 2.2 }, colors = { \"8d8a83\", \"7e7b74\", \"9a968d\" }, material = \"Slate\" },\n\tretreatStone = { over = 1.6, thick = 1.6, rest = 1.4, color = \"85827a\", rests = \"77746d\", material = \"Slate\" }, -- round the map's retreat box\n\t-- the plants: a dock seedling (one stem, three leaves along it) and a dandelion (a rosette of four leaves on the soil and a flower stalk)\n\tdock = { stem = 0.8, height = 18, leaves = { { y = 6, dir = \"x+\", l = 6.5, w = 4.4 }, { y = 11, dir = \"z+\", l = 5.5, w = 3.8 }, { y = 15, dir = \"x-\", l = 4.5, w = 3.2 } }, thick = 0.3 },\n\tdandelion = { leaf = { l = 4.6, w = 2.0, h = 0.25, gap = 0.75 }, stalk = 0.6, height = 12 }, -- (gap: the leaves start clear of the stalk and of each other)\n\tleaf = { top = \"4d7a36\", rim = \"3c6630\", under = \"8fb36a\", rib = \"a7c98a\", stem = \"5d8a3e\", material = \"SmoothPlastic\", rimOut = 0.12, underOut = 0.03, underThick = 0.1 },\n\t-- the dandelion's flower head (ROBLOX-114: `head` across, 3.6 cm, a dandelion's 2 to 5; it was 2.6) over its green bracts (`sepals` across) and the darker centre\n\tflower = { head = \"f2c40c\", disc = \"d99a06\", sepals = \"4f7d35\", size = 3.6, bracts = 2.2, centre = 1.6 },\n\tlitter = { count = 70, size = { 0.9, 2.8 }, colors = { \"8a6239\", \"a07445\", \"6e4d2e\", \"b88c52\", \"5b4129\", \"c4a061\" }, lowEvery = 3 },\n\t-- ROBLOX-114 (to scale): the grass that creeps into a bed from a lawn is 5 to 15 cm long with blades 3 to 5 mm wide (a lawn is mown to 6 to 9 cm in summer, Iowa\n\t-- State University Extension, and its uncut edges grow longer); the tufts were 1.4 to 3.2 cm with blades 1.4 to 2.4 mm wide, a seedling's. `width`: the blades'.\n\tgrass = { tufts = 16, blades = 5, keep = 2, height = { 5, 12 }, width = { 0.3, 0.45 }, colors = { \"5c8a3a\", \"6f9a46\", \"4f7a33\", \"86a85a\" }, dry = \"b8a46a\" },\n\ttwigs = { count = 9, length = { 2, 6 }, width = 0.18, colors = { \"5a4632\", \"6b5640\", \"4a3a2a\" } },\n\tpebbles = { count = 24, size = { 0.25, 0.8 }, colors = { \"a9a59c\", \"938f87\", \"bdb8ad\", \"7f7b74\" } },\n\tmottle = { count = 12, size = { 3, 8 }, colors = { \"3f3126\", \"54412f\", \"463729\" } },\n\t-- ROBLOX-103: seed heads on the tufts (a stalk `over` the tuft's height, a head `length` long), grass clumps creeping in at the edges, and more kinds of litter\n\t-- (ROBLOX-114: a grass's flowering head is a few centimetres long, `length`, and `width` across; 0.7 and 0.16 before; the clumps 6 to 14 cm, 1.8 to 3.4 before)\n\tseedHeads = { over = { 1.15, 1.45 }, length = 2.2, width = 0.35, stalk = \"9aa86a\", colors = { \"c8b47a\", \"b6a067\", \"d4c494\", \"a89060\" } },\n\tclumps = { count = 6, blades = 5, height = { 6, 14 } },\n\tmoreLitter = { count = 14, kinds = {\n\t\t{ size = { 1.4, 2.6 }, shape = 0.6, colors = { \"d9c9a0\", \"cdbb8e\" }, transparency = 0.35 }, -- skeleton leaves, gone to lace\n\t\t{ size = { 1.0, 2.2 }, shape = 0.55, colors = { \"3d2c1e\", \"4a3524\", \"35271b\" } }, -- dark, rotting\n\t\t{ size = { 0.6, 1.0 }, shape = 0.9, colors = { \"c9a23d\", \"b58a2c\", \"a7792a\" } }, -- small and round, yellow\n\t\t{ size = { 0.4, 0.7 }, shape = 0.45, colors = { \"6b5232\", \"7d6240\" } }, -- husks\n\t} :: { any } },\n\t-- ROBLOX-96: the bed's life. Perches: shelter and food as the sill's (0..1); `soil` perches are seeded free spots on the soil; the gnats' vents are two more\n\t-- (they come up out of the soil); the aphids' vents sit at the plants (an aphid appears on a free plant perch within `reach`). `target`: how many prey the bed holds.\n\tprey = {\n\t\ttarget = 6, soil = 8, vents = 2, ventNear = { 4, 9 }, -- (a gnat's vent lies 4 to 9 studs from some soil perch, so an entry flight of at least 4 exists)\n\t\tshelter = { soil = 0.2, mound = 0.15, stone = 0.1, under = 0.6, leaf = 0.3, stem = 0.35 },\n\t\tfood = { soil = 0.1, mound = 0.1, stone = 0.05, under = 0.5, leaf = 0.5, stem = 0.5 }, -- (the plants are where the food is, as the sill's rim is: the gradient the fly model moves on)\n\t\treach = { dock = 8, dandelion = 6 },\n\t},\n\t-- the woodlice: how many, and the litter they hide under (the first few of the litter kept at the low tier, so a hiding place is always drawn)\n\twoodlice = { count = 4, litterSpots = 3 },\n}\n\n-- ---------------------------------------------------------------- the back wall west of the window (ROBLOX-107, docs/WORLD_MAP_PLAN.md region 5, west half)\n-- Studs, the sill's frame. The brick from x -120 to the house_wall's west end (x -40), face z -24, from the lawn to the eaves, in two regions split at y 0 (wall_west\n-- below, wall_west_upper above, as house_wall and wall_upper are). The drainpipe: a column `d` square standing on the litter `gap` off the brick at `x`, up to the\n-- swan neck under the eaves, out along the neck to under the gutter and up the outlet into the gutter's floor: the second way up to the gutter. Brackets every\n-- 100 studs tie it to the brick (a tie behind it and a collar round it, `band` proud), so the pipe can be climbed onto from the wall. The eaves, the fascia, the\n-- gutter (floor, lip, the west end cap) and the eave course go on from wall_upper's, which keeps its own end cap at x -41..-40 as the joint.\nGarden.WEST = {\n\twest = -120, east = -40, face = -24, back = -13.5, foot = -90.4, rise = 0, head = 112.5, top = 150, -- (ROBLOX-112: split again at the window's head, `head`)\n\tpipe = { x = -50, d = 7, gap = 1.2, foot = -90, neck = { y0 = 132, y1 = 139, out = -71 }, outlet = { w = 5, z0 = -71, z1 = -66 } },\n\tbracket = { at = { -40, 60 }, h = 1.5, band = 1, tie = 2 },\n\tcolor = \"3a3c3e\", material = \"Metal\", -- the pipe's paint, as the gutter's\n\tdamp = { \"2f2a22\", \"37301f\" }, -- the damp patch at the drain's foot, on the litter and the brick\n}\n\n-- The drainpipe's footprint on the litter (a box from its foot up), for the life on the litter of a chunk that holds it to walk round, and the damp patch in front of\n-- it where the woodlice gather (nil for a chunk that does not hold it).\nlocal function pipeBox(): Box\n\tlocal P = Garden.WEST.pipe\n\tlocal z1 = Garden.WEST.face - P.gap\n\treturn { min = v(P.x - P.d / 2, P.foot, z1 - P.d), max = v(P.x + P.d / 2, P.neck.y0, z1) }\nend\nlocal function holdsPipe(region: WorldMap.Region): boolean\n\tif region.kind ~= \"shrub\" then return false end\n\tlocal b, lo, hi = pipeBox(), region.bounds[1], region.bounds[2]\n\treturn b.min.X >= lo.X and b.max.X <= hi.X and b.min.Z >= lo.Z and b.max.Z <= hi.Z\nend\nfunction Garden.standingFrom(region: WorldMap.Region): { Box }\n\tif Hut.knows(region.kind) then return {} end\n\tif not holdsPipe(region) then return {} end\n\tlocal b = pipeBox()\n\treturn { { min = b.min, max = v(b.max.X, b.min.Y + 2, b.max.Z) } }\nend\nfunction Garden.drainFoot(region: WorldMap.Region): Vector3?\n\tif not holdsPipe(region) then return nil end\n\tlocal b = pipeBox()\n\treturn v((b.min.X + b.max.X) / 2, Garden.WEST.pipe.foot, b.min.Z - 0.9)\nend\n\n-- ---------------------------------------------------------------- the kitchen: the counter under the window and the floor in front of it (ROBLOX-112)\n-- Studs, the sill's frame, +z into the room (docs/WORLD_MAP_PLAN.md, the inside). The room's wall face is z 12.5, the sill board's front edge: the sill sits in the\n-- window's deep reveal, and the kitchen's counter runs along the wall under it. The worktop's top is `top` (y -4), 4 cm under the sill board, so the board stands\n-- proud of the worktop on a tiled upstand (`upstand`: under the board y -4..-1, and beside the reveal y -4..0 up to the room's wall); the worktop is `thick` deep\n-- and runs out to `front` (60 cm from the wall), x -62..62 with the cupboards' end panels; a sink under the window, its bowl `sink`, and the tap behind it on the\n-- worktop's back strip; a toaster west of the sink standing on its two feet over the region's retreat (WorldMap's kitchen_toaster: the gap under it, warm and full\n-- of crumbs), and a jug kettle on its base east of the sink. Below: the cupboard doors, the plinth recessed under them, the cupboards' base and the floor (`floor`,\n-- y -90: the sill is 90 cm above it) in a strip 80 cm deep in front of the counter.\nGarden.KITCHEN = {\n\tx0 = -62, x1 = 62, carcass = 60, wall = 12.5, back = -13.5, top = -4, thick = 3, front = 72.5,\n\tupstand = { under = -1, beside = 0, x = 30 }, -- (under the sill board x -30..30 its top is the board's underside; beside it, the reveal's foot)\n\tsink = { x0 = -20, x1 = 20, z0 = 20, z1 = 60, bottom = -24, wall = 1 }, -- the bowl's inside: 40 by 40, 20 deep\n\t-- the tap: a column on the worktop by the bowl's back corner, east of it (out of the middle of the sill's view into the room), its spout west over the bowl\n\ttap = { x0 = 22, x1 = 25, z0 = 18, z1 = 21, h = 14, spout = { w = 2, h = 2, to = 11 } },\n\ttoaster = { feet = 1.4, foot = 2, h = 18.6, over = 0.8, color = \"c9ccd0\", feetColor = \"2e2f31\" }, -- its body from the feet's tops; `over`: how far it overhangs the gap\n\tkettle = { x0 = 38, x1 = 56, z0 = 22, z1 = 40, base = 1.2, inset = 1.5, h = 20.8, color = \"f1f0ec\", baseColor = \"2f3133\" },\n\tdoors = { bottom = -80, thick = 2 }, plinth = { setback = 8, thick = 2 }, base = 1, floor = { top = -90, thick = 2, z1 = 92.5 },\n\tcolors = { worktop = \"d8d2c6\", edge = \"b9b2a6\", tile = \"eef0ec\", grout = \"c9cbc6\", steel = \"c3c7cb\", doors = \"8fa69a\", plinth = \"6f8279\", floor = \"c7b79c\", panel = \"8fa69a\" },\n\t-- the drawn things: crumbs on the worktop (the toaster's, most of them by and under it), a few grains of sugar by the kettle, water in the sink; tiles on the\n\t-- upstand, the worktop's rounded front edge, the doors' handles, the floor's tiles\n\tcrumbs = { count = 30, size = { 0.12, 0.55 }, colors = { \"c9a46a\", \"b88a4e\", \"d9bf8c\", \"8a5e33\", \"e3cfa3\" } },\n\tsocket = { x = 47, y = 16, w = 8, h = 8 },\n\t-- the room round it, drawn only (by the eaves' look, with the house's shell) until the rest of the inside is built: 3 m across, 3 m deep, the ceiling at the eaves\n\troom = { x0 = -150, x1 = 150, z1 = 312.5, wall = \"e9e1cf\", ceiling = \"f4f1ea\" }, -- the socket on the wall over the worktop, the kettle's (drawn by wall_upper's look: the wall is that region's)\n}\n\n-- ---------------------------------------------------------------- the bushes beside the bed (ROBLOX-107, docs/WORLD_MAP_PLAN.md region 6)\n-- A chunk (WorldMap.SHRUB_CHUNKS) is a mat of deep leaf litter (top y -90, the bed's soil's, 2 deep) with two bushes to the ground on it, box and privet, `h` tall and\n-- `w` across. A bush's frame is walkable boxes: `stems` stems from the litter, each with two `branch`es out from it at `at` of its height, a leaf `pad` (a cluster of\n-- leaves, its top walkable) on each branch's end and a larger one on each stem's top; the first bush stands over the chunk's retreat, its stems clear of the dead leaf\n-- and of its way in. The dead leaf over the retreat lies on two twigs (`leaf`: as the bed's stone, a gap the map's retreat box and a little more). A few heaps of litter\n-- (`heaps`). The look draws the stems and branches as twigs, each pad as a hanging cluster of leaves whose top is the pad's, a skirt of foliage on the litter round each\n-- bush and a crown over it (the clusters cast shadows: the shade under a bush is real), privet flowers, the dead leaf and its twigs, the heaps, damp patches, and the\n-- litter itself, to the budget at both tiers.\nGarden.SHRUB = {\n\ttop = -90, bottom = -92, landing = 2, litter = \"3b2e22\", material = \"Ground\",\n\tbush = {\n\t\th = { 44, 54 }, w = { 36, 48 },\n\t\tfirst = { r = 7, angles = { -90, 20, 160 } }, -- (the stems round the dead leaf, none in front of its way in: +z is toward the house)\n\t\tr = { 0.1, 0.16 }, stem = { 1.4, 1.8 }, stemH = { 0.62, 0.8 },\n\t\tbranch = { at = { 0.45, 0.78 }, len = { 0.2, 0.32 }, thick = 0.9 },\n\t\tpad = { size = { 5, 7.5 }, thick = 0.6, crown = { 7, 9.5 } },\n\t\t-- (drawn) the outer mass: rings of clusters, `n` round at `y` of the height, `r` of the width out, each `w` of the width across and `h` of the height tall\n\t\tshell = { { n = 5, y = 0.18, r = 0.3, w = 0.4, h = 0.38 }, { n = 5, y = 0.5, r = 0.32, w = 0.4, h = 0.36 }, { n = 4, y = 0.78, r = 0.22, w = 0.38, h = 0.3 } },\n\t},\n\tleaf = { over = 1.6, thick = 0.5, rest = 1.2 },\n\theaps = { count = 3, w = { 4, 8 }, d = { 3, 6 }, h = { 0.4, 1.0 } },\n\tbark = { \"5a4632\", \"4e3c2b\", \"66503a\" }, deadLeaf = { \"8a6239\", \"a07445\", \"6e4d2e\", \"7d5a35\" },\n\tfoliage = { \"3f6334\", \"4a6f3c\", \"35562c\", \"56804a\" }, sunlit = { \"6f9a52\", \"5f8a46\" }, privet = { \"f8f4ec\", \"efe9de\", \"fbfaf5\" },\n\tlitterColors = { \"8a6239\", \"a07445\", \"6e4d2e\", \"b88c52\", \"5b4129\", \"c4a061\", \"4a3524\", \"3d2c1e\" }, litterSize = { 0.9, 2.6 },\n\tmottle = { \"2c241b\", \"33291f\", \"3f3126\" },\n\twoodlice = { count = 4, litterSpots = 3 },\n}\n\n-- (ROBLOX-107) The ground a region's life walks on: the bed's soil, or the litter under the bushes (a chunk's own); its extent, its top, the strip along the\n-- house's wall kept clear (`landing`) and the id of its box. For the bed these are the numbers the bed's placers always used, so its draws are what they were.\ntype Ground = { x0: number, x1: number, z0: number, z1: number, top: number, landing: number, soil: string }\nlocal function groundOf(region: WorldMap.Region): Ground\n\tif region.kind == \"shrub\" then\n\t\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\t\treturn { x0 = lo.X, x1 = hi.X, z0 = lo.Z, z1 = hi.Z, top = Garden.SHRUB.top, landing = Garden.SHRUB.landing, soil = region.id .. \"_soil\" }\n\tend\n\tlocal B = Garden.BED\n\treturn { x0 = B.x0, x1 = B.x1, z0 = B.z0, z1 = B.z1, top = B.top, landing = B.landing, soil = region.id .. \"_soil\" }\nend\n\n-- ---------------------------------------------------------------- the pieces\nlocal function outerPieces(): { Piece }\n\tlocal O = Garden.OUTER\n\tlocal out: { Piece } = {\n\t\t{ id = \"outer_sill_slab\", lo = O.slab.lo, hi = O.slab.hi, profile = \"brick_rough\", color = hex(O.slab.color), material = O.slab.material },\n\t}\n\tlocal B = Flora.garden.box\n\tfor _, half in B.boxes do\n\t\ttable.insert(out, { id = half.id, lo = v(half.x0, B.bottom, B.z0), hi = v(half.x1, B.top, B.z1), profile = \"painted_wood_dry\", color = hex(B.color), material = \"Wood\" })\n\tend\n\treturn out\nend\n\nlocal function wallPieces(): { Piece }\n\tlocal W = Garden.WALL\n\tlocal brick = hex(W.bricks[1])\n\treturn {\n\t\t{ id = \"house_wall\", lo = v(W.west, W.foot, W.face), hi = v(W.east, W.under, W.back), profile = \"brick_rough\", color = brick, material = W.brickMaterial },\n\t\t{ id = \"house_wall_west\", lo = v(W.west, W.under, W.face), hi = v(Garden.OUTER.slab.lo.X, W.top, W.back), profile = \"brick_rough\", color = brick, material = W.brickMaterial },\n\t\t{ id = \"house_wall_east\", lo = v(Garden.OUTER.slab.hi.X, W.under, W.face), hi = v(W.east, W.top, W.back), profile = \"brick_rough\", color = brick, material = W.brickMaterial },\n\t}\nend\n\n-- (ROBLOX-103, ROBLOX-112) The window and the wall round it: the two brick jambs on the shoulders, up to the window's head; the window above the sill's back frame (its\n-- glass and frame, one box climbable on both faces: the sill's Decor draws it, Habitat/Scenery.window); the room's reveal either side of it, the sill's side frames\n-- going on up; and the room's wall beside the window over the kitchen's counter, its face the reveal's room edge (z 12.5).\nlocal function upperPieces(): { Piece }\n\tlocal U = Garden.UPPER\n\tlocal Wn, Rv, In = U.window, U.reveal, U.inner\n\tlocal brick = hex(Garden.WALL.bricks[1])\n\tlocal frame, plaster = hex(Wn.color), hex(In.color)\n\treturn {\n\t\t{ id = \"wall_upper_west\", lo = v(U.west, 0, U.face), hi = v(-U.jamb, U.head, U.back), profile = \"brick_rough\", color = brick, material = Garden.WALL.brickMaterial },\n\t\t{ id = \"wall_upper_east\", lo = v(U.jamb, 0, U.face), hi = v(U.east, U.head, U.back), profile = \"brick_rough\", color = brick, material = Garden.WALL.brickMaterial },\n\t\t{ id = \"wall_upper_window\", lo = v(-U.jamb, Wn.bottom, U.back), hi = v(U.jamb, U.head, Wn.inner), profile = Wn.profile, color = frame, material = \"Glass\" },\n\t\t{ id = \"wall_upper_reveal_west\", lo = v(-U.jamb, Wn.bottom, Wn.inner), hi = v(-Rv.x, U.head, Rv.room), profile = \"plaster_matte\", color = plaster, material = \"Plaster\" },\n\t\t{ id = \"wall_upper_reveal_east\", lo = v(Rv.x, Wn.bottom, Wn.inner), hi = v(U.jamb, U.head, Rv.room), profile = \"plaster_matte\", color = plaster, material = \"Plaster\" },\n\t\t{ id = \"wall_upper_inner_west\", lo = v(-In.x, 0, U.back), hi = v(-U.jamb, U.head, Rv.room), profile = \"plaster_matte\", color = plaster, material = \"Plaster\" },\n\t\t{ id = \"wall_upper_inner_east\", lo = v(U.jamb, 0, U.back), hi = v(In.x, U.head, Rv.room), profile = \"plaster_matte\", color = plaster, material = \"Plaster\" },\n\t}\nend\n\n-- (ROBLOX-112; ROBLOX-103's wall_upper above the head) The eaves: the brick from the window's head to the eaves, the room's wall above the window on the inside (to the\n-- ceiling's height), the eaves' box, the fascia, the gutter (floor, lip, two end caps) and the eave course of the roof over the eaves.\nlocal function eavesPieces(): { Piece }\n\tlocal U = Garden.UPPER\n\tlocal G, E, F, R = U.gutter, U.eaves, U.fascia, U.roof\n\tlocal brick = hex(Garden.WALL.bricks[1])\n\tlocal paint = hex(U.paint)\n\tlocal metal = hex(U.gutterColor)\n\treturn {\n\t\t{ id = \"eaves_brick\", lo = v(U.west, U.head, U.face), hi = v(U.east, U.top, U.back), profile = \"brick_rough\", color = brick, material = Garden.WALL.brickMaterial },\n\t\t{ id = \"eaves_inner\", lo = v(-U.inner.x, U.head, U.back), hi = v(U.inner.x, U.top, U.reveal.room), profile = \"plaster_matte\", color = hex(U.inner.color), material = \"Plaster\" },\n\t\t{ id = \"eaves_soffit\", lo = v(-E.edge, U.top, E.out), hi = v(E.edge, E.top, U.back), profile = \"painted_wood_dry\", color = paint, material = \"Wood\" },\n\t\t{ id = \"eaves_fascia\", lo = v(-E.edge, F.bottom, F.out), hi = v(E.edge, E.top, E.out), profile = \"painted_wood_dry\", color = paint, material = \"Wood\" },\n\t\t{ id = \"eaves_gutter\", lo = v(-G.span, G.floor, G.out), hi = v(G.span, G.floor + G.thick, F.out), profile = \"painted_wood_dry\", color = metal, material = U.gutterMaterial },\n\t\t{ id = \"eaves_gutter_lip\", lo = v(-G.span, G.floor, G.out - G.wall), hi = v(G.span, G.lip, G.out), profile = \"painted_wood_dry\", color = metal, material = U.gutterMaterial },\n\t\t{ id = \"eaves_gutter_west\", lo = v(-G.span - G.cap, G.floor, G.out - G.wall), hi = v(-G.span, G.lip, F.out), profile = \"painted_wood_dry\", color = metal, material = U.gutterMaterial },\n\t\t{ id = \"eaves_gutter_east\", lo = v(G.span, G.floor, G.out - G.wall), hi = v(G.span + G.cap, G.lip, F.out), profile = \"painted_wood_dry\", color = metal, material = U.gutterMaterial },\n\t\t{ id = \"eaves_roof\", lo = v(-E.edge, E.top, R.eave), hi = v(E.edge, E.top + R.thick, U.back), profile = \"brick_rough\", color = hex(R.color), material = R.material },\n\t}\nend\n\n-- The bed's stone over its retreat: a slab on two rests, the gap between them the map's retreat box (WorldMap bed_a_stone) and a little more.\nlocal function stoneOver(retreat: WorldMap.Retreat): { Piece }\n\tlocal S = Garden.BED.retreatStone\n\tlocal lo, hi = retreat.min, retreat.max\n\tlocal top = lo.Y + S.over\n\tlocal x0, x1 = lo.X - 0.2 - S.rest, hi.X + 0.2 + S.rest\n\tlocal z0, z1 = lo.Z - 0.8, hi.Z + 0.8\n\treturn {\n\t\t{ id = \"bed_a_stone_top\", lo = v(x0, top, z0), hi = v(x1, top + S.thick, z1), profile = \"brick_rough\", color = hex(S.color), material = S.material },\n\t\t{ id = \"bed_a_stone_west\", lo = v(x0, lo.Y, z0), hi = v(x0 + S.rest, top, z1), profile = \"brick_rough\", color = hex(S.rests), material = S.material },\n\t\t{ id = \"bed_a_stone_east\", lo = v(x1 - S.rest, lo.Y, z0), hi = v(x1, top, z1), profile = \"brick_rough\", color = hex(S.rests), material = S.material },\n\t}\nend\n\n-- The bed: the soil, the stone over the retreat, then from the region's seed the two plants, two more stones and the mounds, each where it overlaps nothing\n-- placed before it (a stride apart), off the landing strip under the wall and clear of the spawn.\nlocal function bedPieces(region: WorldMap.Region): { Piece }\n\tlocal B = Garden.BED\n\tlocal out: { Piece } = {\n\t\t{ id = \"bed_a_soil\", lo = v(B.x0, B.bottom, B.z0), hi = v(B.x1, B.top, B.z1), profile = \"brick_rough\", color = hex(B.soil), material = B.soilMaterial },\n\t}\n\tlocal taken: { Box } = {}\n\tfor _, t in region.retreats do\n\t\tfor _, p in stoneOver(t) do table.insert(out, p) end\n\t\ttable.insert(taken, { min = t.min - v(2.4, 0, 2.6), max = t.max + v(2.4, 0, 2.6) })\n\tend\n\tlocal spawn = region.spawn.pos\n\ttable.insert(taken, { min = spawn - v(2.5, 0, 2.5), max = spawn + v(2.5, 0, 2.5) })\n\t-- somewhere free for a footprint w x d, or nil after sixty tries\n\tlocal function spot(rand: () -> number, w: number, d: number, margin: number): (number?, number?)\n\t\tfor _ = 1, 60 do\n\t\t\tlocal x = between(rand, B.x0 + 1.5, B.x1 - 1.5 - w)\n\t\t\tlocal z = between(rand, B.z0 + 1.5, B.z1 - B.landing - d)\n\t\t\tlocal box = { min = v(x, 0, z), max = v(x + w, 0, z + d) }\n\t\t\tlocal free = true\n\t\t\tfor _, other in taken do\n\t\t\t\tif overlaps(box, other, margin) then free = false; break end\n\t\t\tend\n\t\t\tif free then\n\t\t\t\ttable.insert(taken, box)\n\t\t\t\treturn x, z\n\t\t\tend\n\t\tend\n\t\treturn nil, nil\n\tend\n\t-- the dock: a stem and three leaves along it, each leaf's underside on the stem's side (a spider climbing the stem meets it from below and walks out under it)\n\tlocal prand = rng(region.seed, 23)\n\tlocal D = B.dock\n\tlocal reachX, reachZ = 0.0, 0.0\n\tfor _, leaf in D.leaves do\n\t\tif leaf.dir == \"x+\" or leaf.dir == \"x-\" then reachX = math.max(reachX, leaf.l) else reachZ = math.max(reachZ, leaf.l) end\n\tend\n\tlocal dx, dz = spot(prand, D.stem + 2 * reachX, D.stem + 2 * reachZ, 1.5)\n\tif dx ~= nil and dz ~= nil then\n\t\tlocal sx, sz = dx + reachX, dz + reachZ\n\t\tlocal s0, s1 = v(sx, B.top, sz), v(sx + D.stem, B.top + D.height, sz + D.stem)\n\t\ttable.insert(out, { id = \"bed_a_dock_stem\", lo = s0, hi = s1, profile = \"leaf_dry_prototype\", color = hex(B.leaf.stem) })\n\t\tfor i, leaf in D.leaves do\n\t\t\tlocal y0, y1 = B.top + leaf.y, B.top + leaf.y + D.thick\n\t\t\tlocal half = leaf.w / 2\n\t\t\tlocal mz, mx = sz + D.stem / 2, sx + D.stem / 2\n\t\t\tlocal lo, hi\n\t\t\tif leaf.dir == \"x+\" then lo, hi = v(s1.X, y0, mz - half), v(s1.X + leaf.l, y1, mz + half)\n\t\t\telseif leaf.dir == \"x-\" then lo, hi = v(s0.X - leaf.l, y0, mz - half), v(s0.X, y1, mz + half)\n\t\t\telseif leaf.dir == \"z+\" then lo, hi = v(mx - half, y0, s1.Z), v(mx + half, y1, s1.Z + leaf.l)\n\t\t\telse lo, hi = v(mx - half, y0, s0.Z - leaf.l), v(mx + half, y1, s0.Z) end\n\t\t\ttable.insert(out, { id = `bed_a_dock_leaf_{i}`, lo = lo, hi = hi, profile = \"leaf_dry_prototype\", color = hex(B.leaf.top) })\n\t\tend\n\tend\n\t-- the dandelion: four leaves lying on the soil round a flower stalk\n\tlocal L = B.dandelion\n\tlocal span = 2 * (L.leaf.gap + L.leaf.l) + L.stalk\n\tlocal fx, fz = spot(prand, span, span, 1.2)\n\tif fx ~= nil and fz ~= nil then\n\t\tlocal cx, cz = fx + span / 2, fz + span / 2\n\t\tlocal h, r = L.stalk / 2, L.stalk / 2 + L.leaf.gap\n\t\tlocal w = L.leaf.w / 2\n\t\ttable.insert(out, { id = \"bed_a_dandelion_stalk\", lo = v(cx - h, B.top, cz - h), hi = v(cx + h, B.top + L.height, cz + h), profile = \"leaf_dry_prototype\", color = hex(B.leaf.stem) })\n\t\tlocal y1 = B.top + L.leaf.h\n\t\tlocal rosette = {\n\t\t\t{ v(cx + r, B.top, cz - w), v(cx + r + L.leaf.l, y1, cz + w) },\n\t\t\t{ v(cx - w, B.top, cz + r), v(cx + w, y1, cz + r + L.leaf.l) },\n\t\t\t{ v(cx - r - L.leaf.l, B.top, cz - w), v(cx - r, y1, cz + w) },\n\t\t\t{ v(cx - w, B.top, cz - r - L.leaf.l), v(cx + w, y1, cz - r) },\n\t\t}\n\t\tfor i, box in rosette do\n\t\t\ttable.insert(out, { id = `bed_a_dandelion_leaf_{i}`, lo = box[1], hi = box[2], profile = \"leaf_dry_prototype\", color = hex(B.leaf.top) })\n\t\tend\n\tend\n\t-- two more stones\n\tlocal S = B.stones\n\tlocal srand = rng(region.seed, 11)\n\tfor i = 1, S.count do\n\t\tlocal w, d, h = between(srand, S.w[1], S.w[2]), between(srand, S.d[1], S.d[2]), between(srand, S.h[1], S.h[2])\n\t\tlocal color = pick(S.colors, srand)\n\t\tlocal x, z = spot(srand, w, d, 1.2)\n\t\tif x ~= nil and z ~= nil then\n\t\t\ttable.insert(out, { id = `bed_a_stone_{string.char(97 + i)}`, lo = v(x, B.top, z), hi = v(x + w, B.top + h, z + d), profile = \"brick_rough\", color = hex(color), material = S.material })\n\t\tend\n\tend\n\t-- the mounds: low heaps of soil\n\tlocal M = B.mounds\n\tlocal mrand = rng(region.seed, 37)\n\tfor i = 1, M.count do\n\t\tlocal w, d, h = between(mrand, M.w[1], M.w[2]), between(mrand, M.d[1], M.d[2]), between(mrand, M.h[1], M.h[2])\n\t\tlocal color = pick(M.colors, mrand)\n\t\tlocal x, z = spot(mrand, w, d, 1.0)\n\t\tif x ~= nil and z ~= nil then\n\t\t\ttable.insert(out, { id = `bed_a_mound_{i}`, lo = v(x, B.top, z), hi = v(x + w, B.top + h, z + d), profile = \"brick_rough\", color = hex(color), material = B.soilMaterial })\n\t\tend\n\tend\n\treturn out\nend\n\n-- (ROBLOX-107) The drainpipe's brackets between two heights, `prefix` naming them: a tie from the pipe's back to the brick, and a collar round the pipe (a band in\n-- front and one either side), each touching what it holds and overlapping nothing.\nlocal function brackets(out: { Piece }, prefix: string, ylo: number, yhi: number)\n\tlocal W = Garden.WEST\n\tlocal P, K = W.pipe, W.bracket\n\tlocal metal = hex(W.color)\n\tlocal x0, x1 = P.x - P.d / 2, P.x + P.d / 2\n\tlocal z1 = W.face - P.gap\n\tlocal z0 = z1 - P.d\n\tfor k, y in K.at do\n\t\tif y >= ylo and y + K.h <= yhi then\n\t\t\tlocal y1 = y + K.h\n\t\t\tlocal parts: { { name: string, lo: Vector3, hi: Vector3 } } = {\n\t\t\t\t{ name = \"tie\", lo = v(P.x - K.tie / 2, y, z1), hi = v(P.x + K.tie / 2, y1, W.face) },\n\t\t\t\t{ name = \"front\", lo = v(x0 - K.band, y, z0 - K.band), hi = v(x1 + K.band, y1, z0) },\n\t\t\t\t{ name = \"west\", lo = v(x0 - K.band, y, z0), hi = v(x0, y1, z1) },\n\t\t\t\t{ name = \"east\", lo = v(x1, y, z0), hi = v(x1 + K.band, y1, z1) },\n\t\t\t}\n\t\t\tfor _, b in parts do\n\t\t\t\ttable.insert(out, { id = `{prefix}_bracket{k}_{b.name}`, lo = b.lo, hi = b.hi, profile = \"painted_metal_smooth\", color = metal, material = W.material })\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- (ROBLOX-107) The back wall west of the window, below y 0: the brick and the drainpipe's foot with its lower bracket.\nlocal function westPieces(): { Piece }\n\tlocal W = Garden.WEST\n\tlocal P = W.pipe\n\tlocal z1 = W.face - P.gap\n\tlocal out: { Piece } = {\n\t\t{ id = \"wall_west\", lo = v(W.west, W.foot, W.face), hi = v(W.east, W.rise, W.back), profile = \"brick_rough\", color = hex(Garden.WALL.bricks[1]), material = Garden.WALL.brickMaterial },\n\t\t{ id = \"wall_west_pipe\", lo = v(P.x - P.d / 2, P.foot, z1 - P.d), hi = v(P.x + P.d / 2, W.rise, z1), profile = \"painted_metal_smooth\", color = hex(W.color), material = W.material },\n\t}\n\tbrackets(out, \"wall_west\", P.foot, W.rise)\n\treturn out\nend\n\n-- (ROBLOX-107, ROBLOX-112) The same wall from y 0 to the window's head: the brick, the drainpipe on up and its upper bracket.\nlocal function westUpperPieces(): { Piece }\n\tlocal W = Garden.WEST\n\tlocal P = W.pipe\n\tlocal x0, x1 = P.x - P.d / 2, P.x + P.d / 2\n\tlocal z1 = W.face - P.gap\n\tlocal out: { Piece } = {\n\t\t{ id = \"wall_west_upper\", lo = v(W.west, W.rise, W.face), hi = v(W.east, W.head, W.back), profile = \"brick_rough\", color = hex(Garden.WALL.bricks[1]), material = Garden.WALL.brickMaterial },\n\t\t{ id = \"wall_west_upper_pipe\", lo = v(x0, W.rise, z1 - P.d), hi = v(x1, W.head, z1), profile = \"painted_metal_smooth\", color = hex(W.color), material = W.material },\n\t}\n\tbrackets(out, \"wall_west_upper\", W.rise, W.head)\n\treturn out\nend\n\n-- (ROBLOX-112; ROBLOX-107's wall_west_upper above the head) The same wall from the head to the eaves: the brick, the drainpipe's top, its swan neck out under the gutter\n-- and the outlet up into the gutter's floor, and the eaves, fascia, gutter (floor, lip, the west end cap) and eave course on west of the eaves' own.\nlocal function eavesWestPieces(): { Piece }\n\tlocal W, U = Garden.WEST, Garden.UPPER\n\tlocal P = W.pipe\n\tlocal G, E, F, R = U.gutter, U.eaves, U.fascia, U.roof\n\tlocal x0, x1 = P.x - P.d / 2, P.x + P.d / 2\n\tlocal z1 = W.face - P.gap\n\tlocal metal, paint = hex(W.color), hex(U.paint)\n\tlocal gutterMetal = hex(U.gutterColor)\n\tlocal joint = -G.span - G.cap -- the west face of the eaves' own end cap\n\tlocal out: { Piece } = {\n\t\t{ id = \"eaves_west_brick\", lo = v(W.west, W.head, W.face), hi = v(W.east, W.top, W.back), profile = \"brick_rough\", color = hex(Garden.WALL.bricks[1]), material = Garden.WALL.brickMaterial },\n\t\t{ id = \"eaves_west_pipe\", lo = v(x0, W.head, z1 - P.d), hi = v(x1, P.neck.y0, z1), profile = \"painted_metal_smooth\", color = metal, material = W.material },\n\t\t{ id = \"eaves_west_neck\", lo = v(x0, P.neck.y0, P.neck.out), hi = v(x1, P.neck.y1, z1), profile = \"painted_metal_smooth\", color = metal, material = W.material },\n\t\t{ id = \"eaves_west_outlet\", lo = v(P.x - P.outlet.w / 2, P.neck.y1, P.outlet.z0), hi = v(P.x + P.outlet.w / 2, G.floor, P.outlet.z1), profile = \"painted_metal_smooth\", color = metal, material = W.material },\n\t\t{ id = \"eaves_west_soffit\", lo = v(W.west, U.top, E.out), hi = v(-E.edge, E.top, U.back), profile = \"painted_wood_dry\", color = paint, material = \"Wood\" },\n\t\t{ id = \"eaves_west_fascia\", lo = v(W.west, F.bottom, F.out), hi = v(-E.edge, E.top, E.out), profile = \"painted_wood_dry\", color = paint, material = \"Wood\" },\n\t\t{ id = \"eaves_west_gutter\", lo = v(W.west, G.floor, G.out), hi = v(joint, G.floor + G.thick, F.out), profile = \"painted_wood_dry\", color = gutterMetal, material = U.gutterMaterial },\n\t\t{ id = \"eaves_west_gutter_lip\", lo = v(W.west, G.floor, G.out - G.wall), hi = v(joint, G.lip, G.out), profile = \"painted_wood_dry\", color = gutterMetal, material = U.gutterMaterial },\n\t\t{ id = \"eaves_west_gutter_west\", lo = v(W.west - G.cap, G.floor, G.out - G.wall), hi = v(W.west, G.lip, F.out), profile = \"painted_wood_dry\", color = gutterMetal, material = U.gutterMaterial },\n\t\t{ id = \"eaves_west_roof\", lo = v(W.west, E.top, R.eave), hi = v(-E.edge, E.top + R.thick, U.back), profile = \"brick_rough\", color = hex(R.color), material = R.material },\n\t}\n\tbrackets(out, \"eaves_west\", W.head, P.neck.y0)\n\treturn out\nend\n\n-- (ROBLOX-107) The dead leaf over a chunk's retreat, lying on two twigs either side of the gap (the bed's stone's shape).\nlocal function deadLeafOver(retreat: WorldMap.Retreat, prefix: string): { Piece }\n\tlocal S = Garden.SHRUB.leaf\n\tlocal lo, hi = retreat.min, retreat.max\n\tlocal top = lo.Y + S.over\n\tlocal x0, x1 = lo.X - 0.2 - S.rest, hi.X + 0.2 + S.rest\n\tlocal z0, z1 = lo.Z - 0.8, hi.Z + 0.8\n\tlocal leaf, twig = hex(Garden.SHRUB.deadLeaf[1]), hex(Garden.SHRUB.bark[1])\n\treturn {\n\t\t{ id = prefix .. \"_deadleaf\", lo = v(x0, top, z0), hi = v(x1, top + S.thick, z1), profile = \"leaf_dry_prototype\", color = leaf, material = \"Fabric\" },\n\t\t{ id = prefix .. \"_twig_west\", lo = v(x0, lo.Y, z0), hi = v(x0 + S.rest, top, z1), profile = \"bare_wood_rough\", color = twig, material = \"Wood\" },\n\t\t{ id = prefix .. \"_twig_east\", lo = v(x1 - S.rest, lo.Y, z0), hi = v(x1, top, z1), profile = \"bare_wood_rough\", color = twig, material = \"Wood\" },\n\t}\nend\n\n-- (ROBLOX-107) A chunk of the bushes: the litter, the dead leaf over the retreat, two bushes whose frames are walkable twigs and leaf pads, and heaps of litter. Every\n-- box inside the chunk, none overlapping another (each is tested against all placed before it and left out if it would), and nothing on the dead leaf's way in, the\n-- spawn in front of it or the drainpipe's foot.\nlocal function shrubPieces(region: WorldMap.Region): { Piece }\n\tlocal S = Garden.SHRUB\n\tlocal B = S.bush\n\tlocal G = groundOf(region)\n\tlocal top = G.top\n\tlocal id = region.id\n\tlocal out: { Piece } = {\n\t\t{ id = G.soil, lo = v(G.x0, S.bottom, G.z0), hi = v(G.x1, top, G.z1), profile = \"brick_rough\", color = hex(S.litter), material = S.material },\n\t}\n\tlocal solids: { Box } = {}\n\tlocal function clash(lo: Vector3, hi: Vector3, margin: number, skip: number?): boolean\n\t\tif lo.X < G.x0 + 0.5 or hi.X > G.x1 - 0.5 or lo.Z < G.z0 + 0.5 or hi.Z > G.z1 - G.landing then return true end\n\t\tfor i, b in solids do\n\t\t\tif i ~= skip and lo.X < b.max.X + margin and hi.X > b.min.X - margin and lo.Y < b.max.Y + margin and hi.Y > b.min.Y - margin\n\t\t\t\tand lo.Z < b.max.Z + margin and hi.Z > b.min.Z - margin then return true end\n\t\tend\n\t\treturn false\n\tend\n\tlocal function put(pid: string, lo: Vector3, hi: Vector3, profile: string, color: Color3, material: string?): number\n\t\ttable.insert(out, { id = pid, lo = lo, hi = hi, profile = profile, color = color, material = material })\n\t\ttable.insert(solids, { min = lo, max = hi })\n\t\treturn #solids\n\tend\n\t-- the dead leaf over the retreat, then what must stay clear: its way in and the spawn in front of it, and the drainpipe's foot\n\tfor _, t in region.retreats do\n\t\tfor _, p in deadLeafOver(t, id) do put(p.id, p.lo, p.hi, p.profile, p.color, p.material) end\n\t\ttable.insert(solids, { min = v(t.min.X - 2.5, top, t.max.Z), max = v(t.max.X + 2.5, top + 6, region.spawn.pos.Z + 2.5) })\n\tend\n\tfor _, b in Garden.standingFrom(region) do table.insert(solids, { min = b.min - v(2, 0, 2), max = v(b.max.X + 2, top + 60, b.max.Z + 2) }) end\n\t-- the bushes\n\tlocal rand = rng(region.seed, 131)\n\tlocal centres: { Vector3 } = {}\n\tfor i = 1, 2 do\n\t\tlocal h, w = between(rand, B.h[1], B.h[2]), between(rand, B.w[1], B.w[2])\n\t\tlocal c: Vector3? = nil\n\t\tlocal angles: { number }, r: number\n\t\tif i == 1 then\n\t\t\tlocal t = region.retreats[1]\n\t\t\tc = v((t.min.X + t.max.X) / 2, top, (t.min.Z + t.max.Z) / 2)\n\t\t\tangles, r = B.first.angles, B.first.r\n\t\telse\n\t\t\tlocal base = rand() * 360\n\t\t\tangles, r = { base, base + 120, base + 240 }, w * between(rand, B.r[1], B.r[2])\n\t\t\tfor _ = 1, 60 do\n\t\t\t\tlocal try = v(between(rand, G.x0 + w / 2 + 3, G.x1 - w / 2 - 3), top, between(rand, G.z0 + w / 2 + 3, G.z1 - G.landing - w / 2 - 3))\n\t\t\t\tlocal far = true\n\t\t\t\tfor _, o in centres do if (try - o).Magnitude < (w + 40) / 2 then far = false end end\n\t\t\t\tif far and not clash(try - v(r + 1, 0, r + 1), try + v(r + 1, h * 0.8, r + 1), 0.5) then c = try; break end\n\t\t\tend\n\t\tend\n\t\tif c ~= nil then\n\t\t\ttable.insert(centres, c)\n\t\t\tlocal bark = hex(pick(S.bark, rand))\n\t\t\tlocal leaf = hex(pick(S.foliage, rand))\n\t\t\tfor k, a in angles do\n\t\t\t\tlocal t, hs = between(rand, B.stem[1], B.stem[2]), h * between(rand, B.stemH[1], B.stemH[2])\n\t\t\t\tlocal sx, sz = c.X + math.cos(math.rad(a)) * r, c.Z + math.sin(math.rad(a)) * r\n\t\t\t\tlocal slo, shi = v(sx - t / 2, top, sz - t / 2), v(sx + t / 2, top + hs, sz + t / 2)\n\t\t\t\tlocal lens = { w * between(rand, B.branch.len[1], B.branch.len[2]), w * between(rand, B.branch.len[1], B.branch.len[2]) }\n\t\t\t\tlocal sizes = { between(rand, B.pad.size[1], B.pad.size[2]), between(rand, B.pad.size[1], B.pad.size[2]) }\n\t\t\t\tlocal crown = between(rand, B.pad.crown[1], B.pad.crown[2])\n\t\t\t\tif not clash(slo, shi, 0.3) then\n\t\t\t\t\tlocal stem = put(`{id}_bush{i}_stem{k}`, slo, shi, \"bare_wood_rough\", bark, \"Wood\")\n\t\t\t\t\t-- two branches, out along the axis nearest the stem's way out from the middle and along the other\n\t\t\t\t\tlocal ox, oz = math.cos(math.rad(a)), math.sin(math.rad(a))\n\t\t\t\t\tlocal dirs: { Vector3 } = if math.abs(ox) >= math.abs(oz)\n\t\t\t\t\t\tthen { v(if ox >= 0 then 1 else -1, 0, 0), v(0, 0, if oz >= 0 then 1 else -1) }\n\t\t\t\t\t\telse { v(0, 0, if oz >= 0 then 1 else -1), v(if ox >= 0 then 1 else -1, 0, 0) }\n\t\t\t\t\tfor j, d in dirs do\n\t\t\t\t\t\tlocal th = B.branch.thick\n\t\t\t\t\t\tlocal yb = top + hs * B.branch.at[j]\n\t\t\t\t\t\tlocal L = lens[j]\n\t\t\t\t\t\tlocal blo, bhi\n\t\t\t\t\t\tif d.X ~= 0 then\n\t\t\t\t\t\t\tlocal xa = if d.X > 0 then shi.X else slo.X - L\n\t\t\t\t\t\t\tblo, bhi = v(xa, yb, sz - th / 2), v(xa + L, yb + th, sz + th / 2)\n\t\t\t\t\t\telse\n\t\t\t\t\t\t\tlocal za = if d.Z > 0 then shi.Z else slo.Z - L\n\t\t\t\t\t\t\tblo, bhi = v(sx - th / 2, yb, za), v(sx + th / 2, yb + th, za + L)\n\t\t\t\t\t\tend\n\t\t\t\t\t\tif not clash(blo, bhi, 0.25, stem) then\n\t\t\t\t\t\t\tlocal branch = put(`{id}_bush{i}_branch{k}{j}`, blo, bhi, \"bare_wood_rough\", bark, \"Wood\")\n\t\t\t\t\t\t\tlocal P = sizes[j]\n\t\t\t\t\t\t\tlocal tip = (if d.X > 0 then v(bhi.X, 0, sz) elseif d.X < 0 then v(blo.X, 0, sz) elseif d.Z > 0 then v(sx, 0, bhi.Z) else v(sx, 0, blo.Z))\n\t\t\t\t\t\t\tlocal pc = tip - d * (P / 2 - 0.6)\n\t\t\t\t\t\t\tlocal plo, phi = v(pc.X - P / 2, bhi.Y, pc.Z - P / 2), v(pc.X + P / 2, bhi.Y + B.pad.thick, pc.Z + P / 2)\n\t\t\t\t\t\t\tif not clash(plo, phi, 0.2, branch) then put(`{id}_bush{i}_pad{k}{j}`, plo, phi, \"leaf_dry_prototype\", leaf) end\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\tlocal clo, chi = v(sx - crown / 2, shi.Y, sz - crown / 2), v(sx + crown / 2, shi.Y + B.pad.thick, sz + crown / 2)\n\t\t\t\t\tif not clash(clo, chi, 0.2, stem) then put(`{id}_bush{i}_crown{k}`, clo, chi, \"leaf_dry_prototype\", leaf) end\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t-- heaps of litter\n\tlocal H = S.heaps\n\tlocal hrand = rng(region.seed, 137)\n\tfor i = 1, H.count do\n\t\tlocal w, d, h = between(hrand, H.w[1], H.w[2]), between(hrand, H.d[1], H.d[2]), between(hrand, H.h[1], H.h[2])\n\t\tfor _ = 1, 40 do\n\t\t\tlocal x, z = between(hrand, G.x0 + 2, G.x1 - 2 - w), between(hrand, G.z0 + 2, G.z1 - G.landing - 1 - d)\n\t\t\tif not clash(v(x, top, z), v(x + w, top + h, z + d), 1.0) then\n\t\t\t\tput(`{id}_heap_{i}`, v(x, top, z), v(x + w, top + h, z + d), \"brick_rough\", hex(S.litter), S.material)\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\tend\n\treturn out\nend\n\n-- (ROBLOX-112) The toaster over its retreat: its body on two feet, the gap between them the map's retreat box (WorldMap kitchen_toaster) and a little more, as the bed's\n-- stone stands on its two rests.\nlocal function toasterOver(retreat: WorldMap.Retreat): { Piece }\n\tlocal T, K = Garden.KITCHEN.toaster, Garden.KITCHEN\n\tlocal lo, hi = retreat.min, retreat.max\n\tlocal x0, x1 = lo.X - 0.2 - T.foot, hi.X + 0.2 + T.foot\n\tlocal z0, z1 = lo.Z - T.over, hi.Z + T.over\n\tlocal feet, body = hex(T.feetColor), hex(T.color)\n\treturn {\n\t\t{ id = \"kitchen_toaster_foot_west\", lo = v(x0, K.top, z0), hi = v(x0 + T.foot, K.top + T.feet, z1), profile = \"painted_metal_smooth\", color = feet, material = \"SmoothPlastic\" },\n\t\t{ id = \"kitchen_toaster_foot_east\", lo = v(x1 - T.foot, K.top, z0), hi = v(x1, K.top + T.feet, z1), profile = \"painted_metal_smooth\", color = feet, material = \"SmoothPlastic\" },\n\t\t{ id = \"kitchen_toaster\", lo = v(x0, K.top + T.feet, z0), hi = v(x1, K.top + T.feet + T.h, z1), profile = \"painted_metal_smooth\", color = body, material = \"Metal\" },\n\t}\nend\n\n-- (ROBLOX-112) The counter under the window: the tiled upstand under the sill board and beside the reveal, the worktop round the sink, the sink's bowl, the tap, the toaster\n-- over the retreat and the kettle on its base.\nlocal function counterPieces(region: WorldMap.Region): { Piece }\n\tlocal K = Garden.KITCHEN\n\tlocal C = K.colors\n\tlocal S, T, J = K.sink, K.tap, K.kettle\n\tlocal w = S.wall\n\tlocal bottom = K.top - K.thick\n\tlocal tile, top, steel = hex(C.tile), hex(C.worktop), hex(C.steel)\n\tlocal out: { Piece } = {\n\t\t{ id = \"kitchen_upstand\", lo = v(-K.upstand.x, K.top, K.back), hi = v(K.upstand.x, K.upstand.under, K.wall), profile = \"glass_clean\", color = tile, material = \"SmoothPlastic\" },\n\t\t{ id = \"kitchen_upstand_west\", lo = v(K.x0, K.top, K.back), hi = v(-K.upstand.x, K.upstand.beside, K.wall), profile = \"glass_clean\", color = tile, material = \"SmoothPlastic\" },\n\t\t{ id = \"kitchen_upstand_east\", lo = v(K.upstand.x, K.top, K.back), hi = v(K.x1, K.upstand.beside, K.wall), profile = \"glass_clean\", color = tile, material = \"SmoothPlastic\" },\n\t\t{ id = \"kitchen_worktop_west\", lo = v(K.x0, bottom, K.wall), hi = v(S.x0 - w, K.top, K.front), profile = \"varnished_wood_smooth\", color = top, material = \"SmoothPlastic\" },\n\t\t{ id = \"kitchen_worktop_east\", lo = v(S.x1 + w, bottom, K.wall), hi = v(K.x1, K.top, K.front), profile = \"varnished_wood_smooth\", color = top, material = \"SmoothPlastic\" },\n\t\t{ id = \"kitchen_worktop_back\", lo = v(S.x0 - w, bottom, K.wall), hi = v(S.x1 + w, K.top, S.z0 - w), profile = \"varnished_wood_smooth\", color = top, material = \"SmoothPlastic\" },\n\t\t{ id = \"kitchen_worktop_front\", lo = v(S.x0 - w, bottom, S.z1 + w), hi = v(S.x1 + w, K.top, K.front), profile = \"varnished_wood_smooth\", color = top, material = \"SmoothPlastic\" },\n\t\t{ id = \"kitchen_sink_floor\", lo = v(S.x0 - w, S.bottom - w, S.z0 - w), hi = v(S.x1 + w, S.bottom, S.z1 + w), profile = \"painted_metal_smooth\", color = steel, material = \"Metal\" },\n\t\t{ id = \"kitchen_sink_west\", lo = v(S.x0 - w, S.bottom, S.z0 - w), hi = v(S.x0, K.top, S.z1 + w), profile = \"painted_metal_smooth\", color = steel, material = \"Metal\" },\n\t\t{ id = \"kitchen_sink_east\", lo = v(S.x1, S.bottom, S.z0 - w), hi = v(S.x1 + w, K.top, S.z1 + w), profile = \"painted_metal_smooth\", color = steel, material = \"Metal\" },\n\t\t{ id = \"kitchen_sink_back\", lo = v(S.x0, S.bottom, S.z0 - w), hi = v(S.x1, K.top, S.z0), profile = \"painted_metal_smooth\", color = steel, material = \"Metal\" },\n\t\t{ id = \"kitchen_sink_front\", lo = v(S.x0, S.bottom, S.z1), hi = v(S.x1, K.top, S.z1 + w), profile = \"painted_metal_smooth\", color = steel, material = \"Metal\" },\n\t\t{ id = \"kitchen_tap\", lo = v(T.x0, K.top, T.z0), hi = v(T.x1, K.top + T.h, T.z1), profile = \"painted_metal_smooth\", color = steel, material = \"Metal\" },\n\t\t{ id = \"kitchen_tap_spout\", lo = v(T.spout.to, K.top + T.h - T.spout.h, (T.z0 + T.z1 - T.spout.w) / 2), hi = v(T.x0, K.top + T.h, (T.z0 + T.z1 + T.spout.w) / 2), profile = \"painted_metal_smooth\",\n\t\t\tcolor = steel, material = \"Metal\" },\n\t}\n\tfor _, t in region.retreats do\n\t\tfor _, piece in toasterOver(t) do table.insert(out, piece) end\n\tend\n\ttable.insert(out, { id = \"kitchen_kettle_base\", lo = v(J.x0, K.top, J.z0), hi = v(J.x1, K.top + J.base, J.z1), profile = \"painted_metal_smooth\", color = hex(J.baseColor), material = \"SmoothPlastic\" })\n\ttable.insert(out, { id = \"kitchen_kettle\", lo = v(J.x0 + J.inset, K.top + J.base, J.z0 + J.inset), hi = v(J.x1 - J.inset, K.top + J.base + J.h, J.z1 - J.inset), profile = \"painted_metal_smooth\",\n\t\tcolor = hex(J.color), material = \"SmoothPlastic\" })\n\treturn out\nend\n\n-- (ROBLOX-112) Under the counter: the floor in front of it, the cupboard doors (one front, the worktop's front edge its top), the cupboards' base inside them, the plinth\n-- recessed under the doors, and the run's two end panels.\nlocal function kitchenFloorPieces(): { Piece }\n\tlocal K = Garden.KITCHEN\n\tlocal C, D, P, F = K.colors, K.doors, K.plinth, K.floor\n\tlocal bottom = K.top - K.thick\n\tlocal doors, panel = hex(C.doors), hex(C.panel)\n\treturn {\n\t\t{ id = \"kitchen_floor\", lo = v(K.x0, F.top - F.thick, K.wall), hi = v(K.x1, F.top, F.z1), profile = \"varnished_wood_smooth\", color = hex(C.floor), material = \"SmoothPlastic\" },\n\t\t{ id = \"kitchen_doors\", lo = v(-K.carcass, D.bottom, K.front - D.thick), hi = v(K.carcass, bottom, K.front), profile = \"painted_wood_dry\", color = doors, material = \"Wood\" },\n\t\t{ id = \"kitchen_base\", lo = v(-K.carcass, D.bottom - K.base, K.back), hi = v(K.carcass, D.bottom, K.front - D.thick), profile = \"painted_wood_dry\", color = doors, material = \"Wood\" },\n\t\t{ id = \"kitchen_plinth\", lo = v(-K.carcass, F.top, K.front - P.setback - P.thick), hi = v(K.carcass, D.bottom - K.base, K.front - P.setback), profile = \"painted_wood_dry\", color = hex(C.plinth), material = \"Wood\" },\n\t\t{ id = \"kitchen_end_west\", lo = v(K.x0, F.top, K.back), hi = v(-K.carcass, bottom, K.front), profile = \"painted_wood_dry\", color = panel, material = \"Wood\" },\n\t\t{ id = \"kitchen_end_east\", lo = v(K.carcass, F.top, K.back), hi = v(K.x1, bottom, K.front), profile = \"painted_wood_dry\", color = panel, material = \"Wood\" },\n\t}\nend\n\n-- ---------------------------------------------------------------- the drawn look\n-- A list of drawn records, and a ceiling for each tier: `add` keeps a record only while the tier it shows in has room (a full-only record counts against the\n-- full ceiling, any other against both), so what is placed first is what a tight budget keeps.\nlocal function sheet(budget: { full: number, low: number })\n\tlocal list: { Drawn } = {}\n\tlocal full, low = 0, 0\n\tlocal function add(d: Drawn): boolean\n\t\tif full + 1 > budget.full or (not d.full and low + 1 > budget.low) then return false end\n\t\tfull += 1\n\t\tif not d.full then low += 1 end\n\t\ttable.insert(list, d)\n\t\treturn true\n\tend\n\treturn list, add\nend\n\n-- A leaf over its box, the Pilea's way (Habitat/Plants): a blade with rounded ends whose top is the box's top, a darker rim band round it and a lighter\n-- underside (full tier), and a midrib along it (full tier).\nlocal function leafOver(add: (Drawn) -> boolean, name: string, lo: Vector3, hi: Vector3, group: string)\n\tlocal L = Garden.BED.leaf\n\tlocal function rounded(id: string, a: Vector3, b: Vector3, r: number, color: Color3, full: boolean)\n\t\tlocal width, depth, height = b.X - a.X, b.Z - a.Z, b.Y - a.Y\n\t\tlocal rr = math.min(r, width * 0.45, depth * 0.45)\n\t\tlocal c = (a + b) * 0.5\n\t\tadd({ id = id .. \"A\", size = v(width, height, depth - 2 * rr), at = c, color = color, material = L.material, full = full, group = group, shadow = not full })\n\t\tadd({ id = id .. \"B\", size = v(width - 2 * rr, height - 0.0008, depth), at = c - v(0, 0.0004, 0), color = color, material = L.material, full = full, group = group, shadow = not full })\n\t\tlocal dh = height - 0.0016\n\t\tfor i, corner in { { a.X + rr, a.Z + rr }, { b.X - rr, a.Z + rr }, { a.X + rr, b.Z - rr }, { b.X - rr, b.Z - rr } } do\n\t\t\tadd({ id = `{id}C{i}`, size = v(dh, 2 * rr, 2 * rr), at = v(corner[1], a.Y + dh / 2, corner[2]), color = color, material = L.material, shape = \"Cylinder\", turn = v(0, 0, 90), full = full, group = group })\n\t\tend\n\tend\n\tlocal r = math.min(hi.X - lo.X, hi.Z - lo.Z) * 0.45\n\trounded(name .. \"Blade\", lo, hi, r, hex(L.top), false)\n\trounded(name .. \"Under\", v(lo.X - L.underOut, lo.Y - 0.012, lo.Z - L.underOut), v(hi.X + L.underOut, lo.Y + L.underThick, hi.Z + L.underOut), r + L.underOut, hex(L.under), true)\n\trounded(name .. \"Rim\", v(lo.X - L.rimOut, lo.Y + 0.05, lo.Z - L.rimOut), v(hi.X + L.rimOut, hi.Y - 0.06, hi.Z + L.rimOut), r + L.rimOut, hex(L.rim), true)\n\tlocal along = if hi.X - lo.X >= hi.Z - lo.Z then \"x\" else \"z\"\n\tlocal c = (lo + hi) * 0.5\n\tlocal length = (if along == \"x\" then hi.X - lo.X else hi.Z - lo.Z) * 0.82\n\tadd({ id = name .. \"Rib\", size = if along == \"x\" then v(length, 0.008, 0.07) else v(0.07, 0.008, length), at = v(c.X, hi.Y + 0.004, c.Z), color = hex(L.rib), material = L.material, full = true, group = group })\n\t-- ROBLOX-103: side veins off the midrib, the Pilea's standard (full tier): four, alternating sides, angled toward the tip\n\tlocal half = (if along == \"x\" then hi.Z - lo.Z else hi.X - lo.X) * 0.5\n\tfor i, f in { 0.28, 0.44, 0.6, 0.74 } do\n\t\tlocal side = if i % 2 == 0 then 1 else -1\n\t\tlocal t = (f - 0.5) * length / 0.82\n\t\tlocal veinLength = half * 0.85 / math.sin(math.rad(48))\n\t\tlocal out = half * 0.85 * 0.5\n\t\tlocal fwd = out / math.tan(math.rad(48))\n\t\tlocal at = if along == \"x\" then v(c.X + t + fwd, hi.Y + 0.004, c.Z + side * out) else v(c.X + side * out, hi.Y + 0.004, c.Z + t + fwd)\n\t\tlocal yaw = if along == \"x\" then -side * 48 else 90 + side * 48\n\t\tadd({ id = `{name}Vein{i}`, size = v(veinLength, 0.008, 0.045), at = at, turn = v(0, yaw, 0), color = hex(L.rib), material = L.material, full = true, group = group })\n\tend\nend\n\nlocal function outerDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal O = Garden.OUTER\n\tlocal list, add = sheet(budget)\n\tlocal slab = O.slab\n\tlocal top, front = slab.hi.Y, slab.lo.Z\n\t-- where the paint has worn through to the stone: patches on the top, worst along the front edge (both tiers: it is the stone's look)\n\tlocal wrand = rng(region.seed, 3)\n\tfor i = 1, 12 do\n\t\tlocal w, d = between(wrand, 1.2, 4.6), between(wrand, 0.7, 2.6)\n\t\tlocal x = between(wrand, slab.lo.X + w / 2 + 0.2, slab.hi.X - w / 2 - 0.2)\n\t\tlocal edge = i <= 5 -- along the front edge, square to it; the others anywhere, turned a little\n\t\tlocal z = if edge then front + d / 2 + 0.02 else between(wrand, front + 1.6, slab.hi.Z - 1.6)\n\t\tlocal turn = between(wrand, -25, 25)\n\t\tadd({ id = \"Worn\" .. i, size = v(w, 0.008, d), at = v(x, top + 0.004, z), turn = v(0, if edge then 0 else turn, 0), color = hex(pick(O.stone, wrand)), material = \"Concrete\", group = \"Weather\" })\n\tend\n\t-- rain has run down the front face: dark streaks below the edge (a hair proud of the face, which is walkable)\n\tfor i = 1, 6 do\n\t\tlocal x, w, l = between(wrand, slab.lo.X + 2, slab.hi.X - 2), between(wrand, 0.25, 0.7), between(wrand, 1.4, 2.9)\n\t\tadd({ id = \"Streak\" .. i, size = v(w, l, 0.006), at = v(x, top - l / 2 - 0.05, front - 0.004), color = hex(O.streak), material = \"Concrete\", transparency = 0.35, group = \"Weather\" })\n\tend\n\t-- moss in the corners: where the slab meets the frame and the window box's ends, and at its front corners\n\tlocal mrand = rng(region.seed, 5)\n\tlocal corners = { { slab.lo.X + 0.9, slab.hi.Z - 0.8 }, { slab.hi.X - 0.9, slab.hi.Z - 0.8 }, { slab.lo.X + 0.9, front + 0.9 }, { slab.hi.X - 0.9, front + 0.9 },\n\t\t{ -9.1, -21.2 }, { 9.1, -21.2 } }\n\tfor i, c in corners do\n\t\tfor j = 1, 8 do\n\t\t\tlocal a, d = mrand() * TAU, 0.9 * math.sqrt(mrand())\n\t\t\tlocal size = between(mrand, 0.25, 0.7)\n\t\t\tadd({ id = `Moss{i}_{j}`, size = v(size, size * 0.45, size * between(mrand, 0.7, 1.0)), at = v(c[1] + math.cos(a) * d, top + size * 0.09, c[2] + math.sin(a) * d),\n\t\t\t\tturn = v(0, mrand() * 360, 0), shape = \"Ellipsoid\", color = hex(pick(O.moss, mrand)), material = \"Grass\", full = j > 3, group = \"Moss\" })\n\t\tend\n\tend\n\t-- grit blown onto the stone\n\tlocal grand = rng(region.seed, 7)\n\tfor i = 1, 28 do\n\t\tlocal s = between(grand, 0.07, 0.24)\n\t\tadd({ id = \"Grit\" .. i, size = v(s, s * 0.6, s * between(grand, 0.6, 1.0)), at = v(between(grand, slab.lo.X + 0.5, slab.hi.X - 0.5), top + s * 0.25, between(grand, front + 0.4, slab.hi.Z - 0.4)),\n\t\t\tturn = v(between(grand, -20, 20), grand() * 360, 0), color = hex(pick(O.grit, grand)), material = \"Pebble\", full = true, group = \"Grit\" })\n\tend\n\t-- ROBLOX-103: what the window box lets fall on the stone (petals of its black-eyed Susans, browning at the edges, their seeds, a dry leaf; three petals at\n\t-- both tiers) and hairline cracks in the paint (full tier); a stream of its own, after everything placed before\n\tlocal frand = rng(region.seed, 107)\n\tlocal boxes = Flora.garden.box\n\tfor i = 1, 10 do\n\t\tlocal half = boxes.boxes[1 + (i % 2)]\n\t\tlocal x = between(frand, half.x0 - 1.5, half.x1 + 1.5)\n\t\tlocal z = between(frand, front + 0.6, boxes.z0 - 0.4)\n\t\tlocal brown = frand() < 0.3\n\t\tadd({ id = \"Petal\" .. i, size = v(between(frand, 0.9, 1.3), 0.03, between(frand, 0.35, 0.5)), at = v(x, top + 0.02, z), turn = v(between(frand, 0, 8), frand() * 360, 0),\n\t\t\tshape = \"Ellipsoid\", color = hex(if brown then \"b5852a\" else pick(Flora.garden.rudbeckia.petalColors, frand)), material = \"SmoothPlastic\", full = i > 3, group = \"Fallen\" })\n\tend\n\tfor i = 1, 6 do\n\t\tadd({ id = \"Seed\" .. i, size = v(0.16, 0.08, 0.32), at = v(between(frand, -24, 24), top + 0.04, between(frand, front + 0.6, boxes.z0 - 0.3)), turn = v(0, frand() * 360, 0),\n\t\t\tshape = \"Ellipsoid\", color = hex(\"2e231a\"), material = \"SmoothPlastic\", full = true, group = \"Fallen\" })\n\tend\n\tfor i = 1, 2 do\n\t\tlocal s = between(frand, 2.2, 3.2)\n\t\tadd({ id = \"DryLeaf\" .. i, size = v(s, 0.04, s * 0.5), at = v(between(frand, slab.lo.X + 3, slab.hi.X - 3), top + 0.12, between(frand, front + 1.5, slab.hi.Z - 1.5)),\n\t\t\tturn = v(between(frand, 6, 16), frand() * 360, 0), shape = \"Ellipsoid\", color = hex(pick({ \"a07445\", \"8a6239\", \"b88c52\" }, frand)), material = \"Fabric\", full = true, group = \"Fallen\" })\n\tend\n\tfor i = 1, 4 do\n\t\tlocal l = between(frand, 2, 6)\n\t\tadd({ id = \"Hairline\" .. i, size = v(l, 0.006, 0.04), at = v(between(frand, slab.lo.X + 4, slab.hi.X - 4), top + 0.003, between(frand, front + 1, slab.hi.Z - 1)), turn = v(0, frand() * 360, 0),\n\t\t\tcolor = hex(\"6f6a60\"), material = \"Concrete\", transparency = 0.3, full = true, group = \"Weather\" })\n\tend\n\treturn list\nend\n\nlocal function wallDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal W = Garden.WALL\n\tlocal K = W.brick\n\tlocal list, add = sheet(budget)\n\tlocal face = W.face + K.gap -- the bricks' face, a hair behind the walkable face\n\tlocal mortarFace = W.face + K.recess\n\tlocal slab = Garden.OUTER.slab\n\t-- the mortar: the wall behind the bricks, recessed; under the slab only (the slab covers the top), up to the shoulders' tops beside it, and the house above\n\tadd({ id = \"Mortar\", size = v(W.east - W.west, W.under - W.foot, W.back - mortarFace), at = v(0, (W.under + W.foot) / 2, (W.back + mortarFace) / 2), color = hex(W.mortar), material = W.mortarMaterial, group = \"Mortar\" })\n\tfor i, x in { { W.west, slab.lo.X }, { slab.hi.X, W.east } } do\n\t\tadd({ id = \"MortarShoulder\" .. i, size = v(x[2] - x[1], W.top - 0.6 - W.under, W.back - mortarFace), at = v((x[1] + x[2]) / 2, (W.top - 0.6 + W.under) / 2, (W.back + mortarFace) / 2), color = hex(W.mortar), material = W.mortarMaterial, group = \"Mortar\" })\n\t\tadd({ id = \"Coping\" .. i, size = v(x[2] - x[1], 0.58, W.back - W.face - K.gap), at = v((x[1] + x[2]) / 2, W.top - 0.31, (W.back + W.face + K.gap) / 2), color = hex(W.coping), material = \"Concrete\", group = \"Mortar\" })\n\tend\n\tlocal win = W.window\n\tlocal skin = 1.0 -- the room's plaster on the inside of the house above the window\n\tfor i, b in { { W.west, win.x0, W.top, W.above }, { win.x1, W.east, W.top, W.above }, { win.x0, win.x1, win.y1, W.above } } do\n\t\tif b[4] <= b[3] then continue end -- (ROBLOX-112: the window goes on up past y 30 now, so nothing stands over it here)\n\t\tadd({ id = \"Above\" .. i, size = v(b[2] - b[1], b[4] - b[3], W.back - skin - mortarFace), at = v((b[1] + b[2]) / 2, (b[3] + b[4]) / 2, (W.back - skin + mortarFace) / 2), color = hex(W.mortar), material = W.mortarMaterial, group = \"Above\" })\n\t\tadd({ id = \"AboveSkin\" .. i, size = v(b[2] - b[1], b[4] - b[3], skin), at = v((b[1] + b[2]) / 2, (b[3] + b[4]) / 2, W.back - skin / 2), color = hex(W.plaster), material = \"Plaster\", group = \"Above\" })\n\tend\n\t-- the courses: stretcher bond, a half brick's offset every other course, from under the coping down to the lawn and up round the window\n\tlocal brand = rng(region.seed, 13)\n\tlocal pitch, course = K.length + K.joint, K.height + K.joint\n\tlocal n = 0\n\tlocal spalled: { { at: Vector3, size: Vector3 } } = {}\n\tlocal function lay(y0: number, y1: number, x0: number, x1: number, offset: number, group: string)\n\t\tlocal x = W.west - offset\n\t\twhile x < W.east do\n\t\t\tlocal a, b = math.max(x + K.joint / 2, x0), math.min(x + pitch - K.joint / 2, x1)\n\t\t\tif b - a >= 2.0 then\n\t\t\t\tn += 1\n\t\t\t\tlocal burnt, pale = brand() < 0.08, brand() < 0.06\n\t\t\t\tlocal color = if burnt then hex(W.burnt) elseif pale then hex(W.pale) else hex(pick(W.bricks, brand))\n\t\t\t\tlocal sink = brand() * 0.05\n\t\t\t\tlocal at = v((a + b) / 2, (y0 + y1) / 2, face + sink + K.depth / 2)\n\t\t\t\tlocal size = v(b - a, y1 - y0, K.depth)\n\t\t\t\tadd({ id = \"Brick\" .. n, size = size, at = at, color = color, material = W.brickMaterial, group = group })\n\t\t\t\tif brand() < 0.1 then table.insert(spalled, { at = at, size = size }) end\n\t\t\tend\n\t\t\tx += pitch\n\t\tend\n\tend\n\tlocal c = 0\n\tlocal y = W.under - K.joint / 2\n\twhile y - K.height > W.foot - K.height do -- below the slab\n\t\tlocal y0 = math.max(y - K.height, W.foot)\n\t\tlay(y0, y, W.west, W.east, (c % 2) * pitch / 2, \"Bricks\")\n\t\ty -= course\n\t\tc += 1\n\tend\n\t-- the shoulders beside the slab: a short course under the coping\n\tlay(W.under + K.joint / 2, W.top - 0.6 - K.joint / 2, W.west, slab.lo.X, pitch / 2, \"Bricks\")\n\tlay(W.under + K.joint / 2, W.top - 0.6 - K.joint / 2, slab.hi.X, W.east, pitch / 2, \"Bricks\")\n\t-- above the outer sill, round the window\n\tc = 1\n\ty = W.top + K.joint / 2\n\twhile y + K.height <= W.above do\n\t\tlocal y1 = y + K.height\n\t\tif y1 <= win.y1 + 0.5 then\n\t\t\tlay(y, y1, W.west, win.x0, (c % 2) * pitch / 2, \"Above\")\n\t\t\tlay(y, y1, win.x1, W.east, (c % 2) * pitch / 2, \"Above\")\n\t\telseif y >= win.y1 then\n\t\t\tlay(y, y1, W.west, W.east, (c % 2) * pitch / 2, \"Above\")\n\t\telse\n\t\t\tlay(y, y1, W.west, win.x0, (c % 2) * pitch / 2, \"Above\")\n\t\t\tlay(y, y1, win.x1, W.east, (c % 2) * pitch / 2, \"Above\")\n\t\tend\n\t\ty += course\n\t\tc += 1\n\tend\n\t-- weathering (full tier): salt bloom on a few bricks, green algae along the foot where the soil splashes, and the spalled faces\n\tlocal erand = rng(region.seed, 17)\n\tfor i, s in spalled do\n\t\tadd({ id = \"Spall\" .. i, size = v(s.size.X * between(erand, 0.3, 0.6), s.size.Y * between(erand, 0.3, 0.6), 0.006), at = v(s.at.X + between(erand, -3, 3), s.at.Y + between(erand, -1, 1), face - 0.002),\n\t\t\tcolor = hex(W.burnt), material = \"Concrete\", transparency = 0.25, full = true, group = \"Weather\" })\n\tend\n\tfor i = 1, 8 do\n\t\tadd({ id = \"Bloom\" .. i, size = v(between(erand, 2, 5), between(erand, 1, 2.5), 0.006), at = v(between(erand, W.west + 5, W.east - 5), between(erand, -60, -10), face - 0.002),\n\t\t\tcolor = hex(\"d9d2c4\"), material = \"Plaster\", transparency = 0.78, full = true, group = \"Weather\" })\n\tend\n\tfor i = 1, 10 do\n\t\tlocal w = between(erand, 4, 11)\n\t\tadd({ id = \"Algae\" .. i, size = v(w, between(erand, 1.5, 5), 0.006), at = v(W.west + (i - 0.5) * (W.east - W.west) / 10 + between(erand, -2, 2), W.foot + between(erand, 1, 3), face - 0.002),\n\t\t\tcolor = hex(\"4f6a36\"), material = \"Grass\", transparency = 0.4, full = true, group = \"Weather\" })\n\tend\n\t-- ROBLOX-96, the descent's dressing. Cobweb strands in the corner under the outer sill (both tiers for the two long ones: they are what the spider passes on\n\t-- its way down), lichen patches on the brick and one weathered course whose bricks have lost their faces (full tier).\n\tlocal drand = rng(region.seed, 19)\n\tlocal corner = if drand() < 0.5 then slab.lo.X else slab.hi.X\n\tlocal inward = if corner < 0 then 1 else -1\n\tlocal strands = {\n\t\t{ a = v(corner + inward * 0.2, W.under - 0.05, face - 0.35), b = v(corner + inward * between(drand, 2.4, 3.6), W.under - between(drand, 2.6, 3.8), face - 0.03), full = false },\n\t\t{ a = v(corner + inward * 0.1, W.under - 0.6, face - 0.03), b = v(corner + inward * between(drand, 1.6, 2.6), W.under - 0.05, face - between(drand, 0.5, 0.9)), full = false },\n\t\t{ a = v(corner + inward * between(drand, 0.8, 1.4), W.under - 0.05, face - 0.25), b = v(corner + inward * between(drand, 1.8, 2.4), W.under - between(drand, 1.2, 1.8), face - 0.04), full = true },\n\t}\n\tfor i, s in strands do\n\t\tlocal d = s.b - s.a\n\t\tlocal yaw = math.deg(math.atan2(-d.Z, d.X))\n\t\tlocal tilt = math.deg(math.asin(math.clamp(d.Y / d.Magnitude, -1, 1)))\n\t\tadd({ id = \"Cobweb\" .. i, size = v(d.Magnitude, 0.012, 0.012), at = (s.a + s.b) * 0.5, turn = v(0, yaw, tilt), shape = \"Cylinder\", color = hex(\"e8e4d8\"), material = \"Glass\",\n\t\t\ttransparency = 0.45, full = s.full, group = \"Weather\" })\n\tend\n\tfor i = 1, 8 do\n\t\tlocal w = between(drand, 0.6, 1.8)\n\t\tadd({ id = \"Lichen\" .. i, size = v(w, w * between(drand, 0.55, 0.9), 0.008), at = v(between(drand, W.west + 4, W.east - 4), between(drand, -72, -16), face - 0.003),\n\t\t\tturn = v(0, 0, drand() * 360), shape = \"Ellipsoid\", color = hex(pick({ \"b9b78f\", \"c7c4a2\", \"9fa97d\", \"d0cdb2\" }, drand)), material = \"Plaster\", full = true, group = \"Weather\" })\n\tend\n\tlocal weathered = W.under - K.joint / 2 - course * (6 + math.floor(drand() * 5)) -- the top of one course between the sixth and the tenth below the slab\n\tfor i = 1, 6 do\n\t\tlocal w = between(drand, 3, 9)\n\t\tadd({ id = \"Erode\" .. i, size = v(w, K.height * between(drand, 0.5, 0.9), 0.01), at = v(between(drand, W.west + 3, W.east - 3), weathered - K.height / 2, face - 0.004),\n\t\t\tcolor = hex(pick({ \"6e3a2a\", \"7b4433\", \"8a5540\" }, drand)), material = \"Concrete\", transparency = 0.15, full = true, group = \"Weather\" })\n\tend\n\t-- ROBLOX-103 (full tier, a stream of its own after the rest): rain off the outer sill's front edge leaves darker streaks down the brick under it; the mortar has\n\t-- weathered darker and deeper in places along the joints; moss grows in the joints near the foot, where the soil splashes\n\tlocal xrand = rng(region.seed, 109)\n\tfor i = 1, 6 do\n\t\tlocal w, l = between(xrand, 1.5, 4), between(xrand, 8, 22)\n\t\tadd({ id = \"Drip\" .. i, size = v(w, l, 0.006), at = v(between(xrand, slab.lo.X + 3, slab.hi.X - 3), W.under - l / 2 - 0.3, face - 0.0045), color = hex(\"5e3a2c\"), material = \"Concrete\",\n\t\t\ttransparency = 0.6, full = true, group = \"Weather\" })\n\tend\n\tfor i = 1, 8 do\n\t\tlocal row = W.under - K.joint / 2 - course * math.floor(between(xrand, 1, 11))\n\t\tadd({ id = \"Joint\" .. i, size = v(between(xrand, 6, 18), K.joint * 0.9, 0.01), at = v(between(xrand, W.west + 8, W.east - 8), row + K.joint / 2, mortarFace - 0.006),\n\t\t\tcolor = hex(pick({ \"8f877a\", \"a39b8d\", \"7a7366\" }, xrand)), material = W.mortarMaterial, full = true, group = \"Mortar\" })\n\tend\n\tfor i = 1, 10 do\n\t\tlocal row = W.under - course * (10 + math.floor(xrand() * 2)) -- the middle of a joint near the foot (the courses' joints are at y -3 - 7.5k)\n\t\tlocal s = between(xrand, 0.5, 1.2)\n\t\tadd({ id = \"JointMoss\" .. i, size = v(s * 1.6, s * 0.7, s * 0.6), at = v(between(xrand, W.west + 3, W.east - 3), row, face - 0.1), shape = \"Ellipsoid\",\n\t\t\tcolor = hex(pick(Garden.OUTER.moss, xrand)), material = \"Grass\", full = true, group = \"Weather\" })\n\tend\n\treturn list\nend\n\n-- (ROBLOX-112) The window and the wall round it, outside and in (the window itself, its frame, glass and sashes, is drawn by the sill's Decor, Habitat/Scenery.window,\n-- whose box this region holds). Both tiers: the jambs' mortar beds (their faces in the window's reveal are the render it is finished in) and their brick courses from\n-- y 30 (where the house_wall's look stops) to the head, on the house_wall's bond; the room's reveal either side of the window and its wall beside it, plaster. Full\n-- tier: rain streaks and lichen on the jambs, an old cobweb in the outer reveal's top corner, fly specks on the room's reveal, and the socket over the worktop.\nlocal function upperDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal U, W = Garden.UPPER, Garden.WALL\n\tlocal K = W.brick\n\tlocal Rv, In, Wn = U.reveal, U.inner, U.window\n\tlocal list, add = sheet(budget)\n\tlocal face = U.face + K.gap\n\tlocal mortarFace = U.face + K.recess\n\tlocal gap = 0.02 -- a drawn board sits this far inside the walkable box it stands in for\n\tlocal function inside(id: string, lo: Vector3, hi: Vector3, color: string, material: string, group: string)\n\t\tadd({ id = id, size = hi - lo - v(2 * gap, 2 * gap, 2 * gap), at = (lo + hi) * 0.5, color = hex(color), material = material, group = group })\n\tend\n\tfor i, side in { -1, 1 } do\n\t\tlocal x0, x1 = if side < 0 then U.west else U.jamb, if side < 0 then -U.jamb else U.east\n\t\tadd({ id = \"Jamb\" .. i, size = v(x1 - x0, U.head - W.above, U.back - mortarFace), at = v((x0 + x1) / 2, (U.head + W.above) / 2, (U.back + mortarFace) / 2), color = hex(W.mortar),\n\t\t\tmaterial = W.mortarMaterial, group = \"Mortar\" })\n\tend\n\tinside(\"RevealWest\", v(-U.jamb, Wn.bottom, Wn.inner), v(-Rv.x, U.head, Rv.room), In.color, \"Plaster\", \"Room\")\n\tinside(\"RevealEast\", v(Rv.x, Wn.bottom, Wn.inner), v(U.jamb, U.head, Rv.room), In.color, \"Plaster\", \"Room\")\n\tinside(\"InnerWest\", v(-In.x, 0, U.back), v(-U.jamb, U.head, Rv.room), In.color, \"Plaster\", \"Room\")\n\tinside(\"InnerEast\", v(U.jamb, 0, U.back), v(In.x, U.head, Rv.room), In.color, \"Plaster\", \"Room\")\n\t-- the courses on the jambs, from y 30 to the head (one course every brick and joint from y 0.5, offset every other course as the house_wall's)\n\tlocal brand = rng(region.seed, 13)\n\tlocal pitch, course = K.length + K.joint, K.height + K.joint\n\tlocal n, c = 0, 0\n\tlocal y = W.top + K.joint / 2\n\twhile y + K.height <= W.above do y += course; c += 1 end\n\twhile y + K.height <= U.head do\n\t\tlocal offset = ((c + 1) % 2) * pitch / 2\n\t\tfor _, range in { { U.west, -U.jamb }, { U.jamb, U.east } } do\n\t\t\tlocal x = U.west - offset\n\t\t\twhile x < U.east do\n\t\t\t\tlocal a, b = math.max(x + K.joint / 2, range[1]), math.min(x + pitch - K.joint / 2, range[2])\n\t\t\t\tif b - a >= 2.0 then\n\t\t\t\t\tn += 1\n\t\t\t\t\tlocal burnt, pale = brand() < 0.08, brand() < 0.06\n\t\t\t\t\tlocal color = if burnt then hex(W.burnt) elseif pale then hex(W.pale) else hex(pick(W.bricks, brand))\n\t\t\t\t\tadd({ id = \"Brick\" .. n, size = v(b - a, K.height, K.depth), at = v((a + b) / 2, y + K.height / 2, face + brand() * 0.05 + K.depth / 2), color = color, material = W.brickMaterial, group = \"Bricks\" })\n\t\t\t\tend\n\t\t\t\tx += pitch\n\t\t\tend\n\t\tend\n\t\ty += course\n\t\tc += 1\n\tend\n\t-- full tier: rain streaks down the jambs from the head, lichen, an old cobweb in the outer reveal's top corner\n\tlocal grand = rng(region.seed, 103)\n\tfor k = 1, 4 do\n\t\tlocal side = if k % 2 == 0 then 1 else -1\n\t\tlocal w, l = between(grand, 1.5, 3.5), between(grand, 12, 40)\n\t\tadd({ id = \"Streak\" .. k, size = v(w, l, 0.006), at = v(side * between(grand, U.jamb + 1 + w / 2, U.east - 1 - w / 2), U.head - l / 2 - 0.5, face - 0.003), color = hex(\"4e4a3c\"), material = \"Concrete\",\n\t\t\ttransparency = 0.6, full = true, group = \"Weather\" })\n\tend\n\tfor k = 1, 4 do\n\t\tlocal w = between(grand, 0.8, 2.0)\n\t\tlocal side = if k % 2 == 0 then 1 else -1\n\t\tadd({ id = \"Lichen\" .. k, size = v(w, w * between(grand, 0.55, 0.9), 0.008), at = v(side * between(grand, U.jamb + 1.5, U.east - 1.5), between(grand, 35, U.head - 8), face - 0.003),\n\t\t\tturn = v(0, 0, grand() * 360), shape = \"Ellipsoid\", color = hex(pick({ \"b9b78f\", \"c7c4a2\", \"9fa97d\", \"d0cdb2\" }, grand)), material = \"Plaster\", full = true, group = \"Weather\" })\n\tend\n\tlocal corner = if grand() < 0.5 then -U.jamb + 0.2 else U.jamb - 0.2\n\tlocal inward = if corner < 0 then 1 else -1\n\tfor k = 1, 3 do\n\t\tlocal a = v(corner, U.head - 0.05, U.back - between(grand, 0.6, 4))\n\t\tlocal b = v(corner + inward * between(grand, 2, 6), U.head - between(grand, 1.5, 5), U.back - between(grand, 4, 9.5))\n\t\tlocal d = b - a\n\t\tadd({ id = \"Cobweb\" .. k, size = v(d.Magnitude, 0.012, 0.012), at = (a + b) * 0.5, turn = v(0, math.deg(math.atan2(-d.Z, d.X)), math.deg(math.asin(math.clamp(d.Y / d.Magnitude, -1, 1)))),\n\t\t\tshape = \"Cylinder\", color = hex(\"e8e4d8\"), material = \"Glass\", transparency = 0.45, full = true, group = \"Weather\" })\n\tend\n\t-- full tier, the room's side: fly specks on the reveal's plaster, and the socket on the wall over the worktop (the kettle's)\n\tfor k = 1, 8 do\n\t\tlocal side = if k % 2 == 0 then 1 else -1\n\t\tlocal s = between(grand, 0.08, 0.2)\n\t\tadd({ id = \"Speck\" .. k, size = v(0.006, s, s), at = v(side * (Rv.x - gap + 0.003), between(grand, 20, U.head - 10), between(grand, Wn.inner + 2, Rv.room - 2)), shape = \"Ellipsoid\",\n\t\t\tcolor = hex(pick({ \"3a2f25\", \"4a3d30\", \"2c241b\" }, grand)), material = \"Plaster\", full = true, group = \"Room\" })\n\tend\n\tlocal So = Garden.KITCHEN.socket\n\tadd({ id = \"Socket\", size = v(So.w, So.h, 0.6), at = v(So.x, So.y, Rv.room + 0.3 - 0.6), color = hex(\"f4f2ec\"), material = \"SmoothPlastic\", full = true, group = \"Room\" })\n\tadd({ id = \"SocketPins\", size = v(3.2, 1.0, 0.02), at = v(So.x - 0.8, So.y - 0.6, Rv.room + 0.005), color = hex(\"3a3836\"), material = \"SmoothPlastic\", full = true, group = \"Room\" })\n\treturn list\nend\n\n-- (ROBLOX-103's wall above the window, ROBLOX-112's eaves) The brick over the window and the house round it. Both tiers: the lintel over the window's head, the brick\n-- courses from the head to the eaves over a recessed mortar bed and the room's wall inside, the soffit, the fascia, the gutter and the eave course of tiles over the\n-- pieces they stand in for, the roof's slope from the eaves over the whole house to the ridge, the house's back wall on either side out to 5 m (x 40..500) with its\n-- eaves and gutter. Full tier: the tile joints, the gutter's rolled lip, mortar lines along the long walls, the house's other window (the kitchen's size, its sashes\n-- drawn as the kitchen's are) and the back door, leaves, moss and a puddle in the gutter, dirt streaks under it where it overflows, lichen, and an old cobweb in the\n-- eaves' corner. Nothing here casts a shadow (no look does), so the light through the window is the light it was.\nlocal function eavesDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal U, W = Garden.UPPER, Garden.WALL\n\tlocal K, G, E, F, R, H = W.brick, U.gutter, U.eaves, U.fascia, U.roof, U.house\n\tlocal list, add = sheet(budget)\n\tlocal face = U.face + K.gap\n\tlocal mortarFace = U.face + K.recess\n\tlocal gap = 0.02 -- a drawn board sits this far inside the walkable box it stands in for\n\tlocal function box(id: string, lo: Vector3, hi: Vector3, color: string, material: string, group: string, full: boolean?, transparency: number?)\n\t\tadd({ id = id, size = hi - lo, at = (lo + hi) * 0.5, color = hex(color), material = material, group = group, full = full, transparency = transparency })\n\tend\n\tlocal function inside(id: string, lo: Vector3, hi: Vector3, color: string, material: string, group: string)\n\t\tbox(id, lo + v(gap, gap, gap), hi - v(gap, gap, gap), color, material, group)\n\tend\n\t-- the mortar bed from the head to the eaves, the room's wall over the window inside (to the ceiling's height), and the lintel across the head: a concrete beam one\n\t-- course tall bearing on the jambs, its underside the head of the window's reveal\n\tlocal L = U.lintel\n\tbox(\"Mortar\", v(U.west, U.head + gap, mortarFace), v(U.east, U.top, U.back), W.mortar, W.mortarMaterial, \"Mortar\") -- (behind the lintel too: from afar it is the wall)\n\tinside(\"Skin\", v(-U.inner.x, U.head, U.back), v(U.inner.x, U.top, U.reveal.room), U.inner.color, \"Plaster\", \"Mortar\")\n\tadd({ id = \"Lintel\", size = v(U.east - U.west, L.h, U.back - face), at = v(0, U.head + L.h / 2, (U.back + face) / 2), color = hex(L.color), material = \"Concrete\", group = \"Mortar\" })\n\t-- (ROBLOX-112) the kitchen beyond the window, drawn only until the inside is built (docs/WORLD_MAP_PLAN.md): its ceiling, its far wall and its sides, its back wall\n\t-- beyond the counter's run either side and its floor beyond the walkable strip, so the window shows a room and not the sky, and the sill's view into the room has\n\t-- walls. None of it casts a shadow, so the light through the window falls as it did.\n\tlocal Rm = Garden.KITCHEN.room\n\tlocal wallFace, floorTop = U.reveal.room, Garden.KITCHEN.floor.top\n\tbox(\"RoomCeiling\", v(Rm.x0, U.top, wallFace), v(Rm.x1, U.top + 2, Rm.z1), Rm.ceiling, \"Plaster\", \"Room\")\n\tbox(\"RoomFar\", v(Rm.x0, floorTop, Rm.z1), v(Rm.x1, U.top, Rm.z1 + 2), Rm.wall, \"Plaster\", \"Room\")\n\tbox(\"RoomFloor\", v(Rm.x0, floorTop - 2, wallFace), v(Rm.x1, floorTop - 0.05, Rm.z1), Garden.KITCHEN.colors.floor, \"SmoothPlastic\", \"Room\")\n\tbox(\"RoomSideWest\", v(Rm.x0 - 2, floorTop, wallFace), v(Rm.x0, U.top, Rm.z1), Rm.wall, \"Plaster\", \"Room\")\n\tbox(\"RoomSideEast\", v(Rm.x1, floorTop, wallFace), v(Rm.x1 + 2, U.top, Rm.z1), Rm.wall, \"Plaster\", \"Room\")\n\tbox(\"RoomBackWest\", v(Rm.x0, floorTop, U.back), v(-U.inner.x, U.top, wallFace), Rm.wall, \"Plaster\", \"Room\")\n\tbox(\"RoomBackEast\", v(U.inner.x, floorTop, U.back), v(Rm.x1, U.top, wallFace), Rm.wall, \"Plaster\", \"Room\")\n\t-- the courses, on from the jambs' (the courses start at y 0.5, one every brick and joint: the head and the eaves are both on a joint), over the lintel\n\tlocal brand = rng(region.seed, 13)\n\tlocal pitch, course = K.length + K.joint, K.height + K.joint\n\tlocal n, c = 0, 0\n\tlocal y = W.top + K.joint / 2\n\twhile y + K.height <= U.head + L.h do y += course; c += 1 end\n\twhile y + K.height <= U.top - K.joint / 2 do\n\t\tlocal offset = ((c + 1) % 2) * pitch / 2\n\t\tlocal x = U.west - offset\n\t\twhile x < U.east do\n\t\t\tlocal a, b = math.max(x + K.joint / 2, U.west), math.min(x + pitch - K.joint / 2, U.east)\n\t\t\tif b - a >= 2.0 then\n\t\t\t\tn += 1\n\t\t\t\tlocal burnt, pale = brand() < 0.08, brand() < 0.06\n\t\t\t\tlocal color = if burnt then hex(W.burnt) elseif pale then hex(W.pale) else hex(pick(W.bricks, brand))\n\t\t\t\tlocal sink = brand() * 0.05\n\t\t\t\tadd({ id = \"Brick\" .. n, size = v(b - a, K.height, K.depth), at = v((a + b) / 2, y + K.height / 2, face + sink + K.depth / 2), color = color, material = W.brickMaterial, group = \"Bricks\" })\n\t\t\tend\n\t\t\tx += pitch\n\t\tend\n\t\ty += course\n\t\tc += 1\n\tend\n\t-- the eaves: the soffit, the fascia, the gutter, the eave course of tiles (over the pieces they stand in for)\n\tinside(\"Soffit\", v(-E.edge, U.top, E.out), v(E.edge, E.top, U.back), U.paint, \"Wood\", \"Eaves\")\n\tinside(\"Fascia\", v(-E.edge, F.bottom, F.out), v(E.edge, E.top, E.out), U.paint, \"Wood\", \"Eaves\")\n\tinside(\"GutterFloor\", v(-G.span, G.floor, G.out), v(G.span, G.floor + G.thick, F.out), U.gutterColor, U.gutterMaterial, \"Gutter\")\n\tinside(\"GutterLip\", v(-G.span, G.floor, G.out - G.wall), v(G.span, G.lip, G.out), U.gutterColor, U.gutterMaterial, \"Gutter\")\n\tinside(\"GutterWest\", v(-G.span - G.cap, G.floor, G.out - G.wall), v(-G.span, G.lip, F.out), U.gutterColor, U.gutterMaterial, \"Gutter\")\n\tinside(\"GutterEast\", v(G.span, G.floor, G.out - G.wall), v(G.span + G.cap, G.lip, F.out), U.gutterColor, U.gutterMaterial, \"Gutter\")\n\tinside(\"EaveCourse\", v(-E.edge, E.top, R.eave), v(E.edge, E.top + R.thick, U.back), R.color, R.material, \"Roof\")\n\t-- the roof's slope from the eave over the whole house to the ridge\n\tlocal p = math.rad(R.pitch)\n\tlocal run = R.ridge - R.eave\n\tlocal length = run / math.cos(p)\n\tlocal eaveTop = E.top + R.thick\n\tadd({ id = \"RoofSlope\", size = v(2 * R.x, 3, length), at = v(0, eaveTop + run * math.tan(p) / 2 + 1.5 / math.cos(p) - 0.2, R.eave + run / 2), turn = v(-R.pitch, 0, 0),\n\t\tcolor = hex(R.color), material = R.material, group = \"Roof\" })\n\t-- the house's back wall either side, with its eaves and gutter, and the downpipe\n\t-- (ROBLOX-107: the west side is drawn only beyond wall_west, which is walkable from x -120 to -40 with its own eaves, gutter and the drainpipe that was drawn here)\n\tlocal westEnd = Garden.WEST.west\n\tfor _, side in { -1, 1 } do\n\t\tlocal x0, x1 = if side < 0 then -H.x else U.east, if side < 0 then westEnd else H.x\n\t\tlocal e0, e1 = if side < 0 then -H.x else E.edge, if side < 0 then westEnd else H.x\n\t\tlocal name = if side < 0 then \"West\" else \"East\"\n\t\tbox(\"House\" .. name, v(x0, H.foot, U.face + K.gap), v(x1, U.top, U.back), W.bricks[1], W.brickMaterial, \"House\")\n\t\tbox(\"Eaves\" .. name, v(e0, U.top, E.out), v(e1, E.top, U.back), U.paint, \"Wood\", \"House\")\n\t\tbox(\"Fascia\" .. name, v(e0, F.bottom, F.out), v(e1, E.top, E.out), U.paint, \"Wood\", \"House\")\n\t\tbox(\"Gutter\" .. name, v(if side < 0 then e0 else G.span + G.cap, G.floor, G.out - G.wall), v(if side < 0 then westEnd - G.cap else e1, G.lip, F.out), U.gutterColor, U.gutterMaterial, \"House\")\n\tend\n\t-- full tier: the tile joints, the gutter's rolled lip, the window and the back door, the downpipe's brackets and shoe\n\tlocal trand = rng(region.seed, 101)\n\tfor k = 1, 7 do\n\t\tlocal x = -E.edge + (k - 0.5) * 2 * E.edge / 7 + between(trand, -2, 2)\n\t\tadd({ id = \"TileJoint\" .. k, size = v(0.35, R.thick + 0.1, 0.4), at = v(x, E.top + R.thick / 2, R.eave - 0.1), color = hex(\"4a2a22\"), material = R.material, full = true, group = \"Roof\" })\n\tend\n\tadd({ id = \"GutterBead\", size = v(2 * G.span, 1.4, 1.4), at = v(0, G.lip, G.out - G.wall / 2), shape = \"Cylinder\", color = hex(U.gutterColor), material = U.gutterMaterial, full = true, group = \"Gutter\" })\n\tlocal D, Wn = H.door, H.window\n\tlocal stepTop = H.foot + D.step\n\tadd({ id = \"BackStep\", size = v(D.w + 30, D.step, 30), at = v(D.x, H.foot + D.step / 2, U.face - 15), color = hex(\"a29d92\"), material = \"Concrete\", full = true, group = \"House\" })\n\tadd({ id = \"BackDoorFrame\", size = v(D.w + 2 * D.frame, D.h + D.frame, 1.2), at = v(D.x, stepTop + (D.h + D.frame) / 2, U.face - 0.4), color = hex(U.paint), material = \"Wood\", full = true, group = \"House\" })\n\tadd({ id = \"BackDoor\", size = v(D.w, D.h, 1.6), at = v(D.x, stepTop + D.h / 2, U.face - 0.7), color = hex(D.color), material = \"Wood\", full = true, group = \"House\" })\n\t-- (ROBLOX-114) what makes it read as a door at its size: the glazed upper panel, the panel below (a raised field a shade lighter) and the lever handle\n\tadd({ id = \"BackDoorGlass\", size = v(D.glass.w, D.glass.h, 0.4), at = v(D.x, stepTop + D.glass.bottom + D.glass.h / 2, U.face - 1.4), color = hex(\"5d7480\"), material = \"Glass\",\n\t\ttransparency = 0.2, full = true, group = \"House\" })\n\tadd({ id = \"BackDoorPanel\", size = v(D.panel.w, D.panel.h, 0.4), at = v(D.x, stepTop + D.panel.bottom + D.panel.h / 2, U.face - 1.4), color = hex(\"4a6a58\"), material = \"Wood\",\n\t\tfull = true, group = \"House\" })\n\tadd({ id = \"BackDoorHandle\", size = v(12, 2, 2), at = v(D.x - D.w / 2 + 9, stepTop + D.handle, U.face - 2.4), color = hex(\"b9bcc0\"), material = \"Metal\", full = true, group = \"House\" })\n\t-- another window like the kitchen's (ROBLOX-112: the kitchen's own size, 62 wide and from y 0 to the head at 112.5, its sashes meeting at the same transom), along\n\t-- the west wall, its lintel over it and its stone sill under it\n\tadd({ id = \"WindowFrame\", size = v(Wn.w, Wn.h, 1.2), at = v(Wn.x, Wn.sill + Wn.h / 2, U.face - 0.4), color = hex(U.paint), material = \"Wood\", full = true, group = \"House\" })\n\tadd({ id = \"WindowGlass\", size = v(Wn.w - 7, Wn.h - 5, 1.4), at = v(Wn.x, Wn.sill + Wn.h / 2 + 0.5, U.face - 0.6), color = hex(\"5d7480\"), material = \"Glass\", transparency = 0.2, full = true, group = \"House\" })\n\tadd({ id = \"WindowTransom\", size = v(Wn.w - 7, 2.5, 1.6), at = v(Wn.x, Wn.transom + 1.25, U.face - 0.8), color = hex(U.paint), material = \"Wood\", full = true, group = \"House\" })\n\tadd({ id = \"WindowSill\", size = v(Wn.w + 6, 3, 10.5), at = v(Wn.x, Wn.sill - 1.5, U.face + 5.25 - 10.5), color = hex(\"ddd5c3\"), material = \"Concrete\", full = true, group = \"House\" })\n\tadd({ id = \"WindowLintel\", size = v(Wn.w + 2 * 9, L.h, 0.6), at = v(Wn.x, U.head + L.h / 2, U.face - 0.3), color = hex(L.color), material = \"Concrete\", full = true, group = \"House\" })\n\t-- full tier: what collects in a gutter, the dirt it leaves on the brick, lichen, an old cobweb in the eaves' corner\n\tlocal grand = rng(region.seed, 103)\n\tfor k = 1, 8 do\n\t\tlocal s = between(grand, 1.2, 3.2)\n\t\tadd({ id = \"GutterLeaf\" .. k, size = v(s, 0.08, s * between(grand, 0.45, 0.7)), at = v(between(grand, -G.span + 2, G.span - 2), G.floor + G.thick + 0.05, between(grand, G.out + 1.5, F.out - 1.5)),\n\t\t\tturn = v(between(grand, 0, 12), grand() * 360, 0), shape = \"Ellipsoid\", color = hex(pick(U.debris, grand)), material = \"Fabric\", full = true, group = \"Gutter\" })\n\tend\n\tfor k = 1, 3 do\n\t\tlocal s = between(grand, 1.5, 3.0)\n\t\tadd({ id = \"GutterMoss\" .. k, size = v(s, s * 0.45, s), at = v(between(grand, -G.span + 3, G.span - 3), G.floor + G.thick + s * 0.15, between(grand, G.out + 2, F.out - 2)),\n\t\t\tshape = \"Ellipsoid\", color = hex(pick(Garden.OUTER.moss, grand)), material = \"Grass\", full = true, group = \"Gutter\" })\n\tend\n\tadd({ id = \"GutterPuddle\", size = v(between(grand, 8, 14), 0.06, 7), at = v(between(grand, -20, 20), G.floor + G.thick + 0.03, (G.out + F.out) / 2), shape = \"Ellipsoid\",\n\t\tcolor = hex(\"6d7a80\"), material = \"Glass\", transparency = 0.45, full = true, group = \"Gutter\" })\n\tfor k = 1, 5 do\n\t\tlocal w = between(grand, 3, 8)\n\t\tlocal l = between(grand, 10, 30)\n\t\tadd({ id = \"Streak\" .. k, size = v(w, l, 0.006), at = v(between(grand, U.west + 4, U.east - 4), U.top - l / 2 - 0.5, face - 0.003), color = hex(\"4e4a3c\"), material = \"Concrete\",\n\t\t\ttransparency = 0.55, full = true, group = \"Weather\" })\n\tend\n\tfor k = 1, 4 do\n\t\tlocal w = between(grand, 0.8, 2.0)\n\t\tadd({ id = \"Lichen\" .. k, size = v(w, w * between(grand, 0.55, 0.9), 0.008), at = v(between(grand, U.west + 4, U.east - 4), between(grand, U.head + L.h + 2, U.top - 4), face - 0.003), turn = v(0, 0, grand() * 360),\n\t\t\tshape = \"Ellipsoid\", color = hex(pick({ \"b9b78f\", \"c7c4a2\", \"9fa97d\", \"d0cdb2\" }, grand)), material = \"Plaster\", full = true, group = \"Weather\" })\n\tend\n\tlocal corner = if grand() < 0.5 then -E.edge + 0.2 else E.edge - 0.2\n\tlocal inward = if corner < 0 then 1 else -1\n\tfor k = 1, 3 do\n\t\tlocal a = v(corner, U.top - 0.05, U.face - between(grand, 1, 8))\n\t\tlocal b = v(corner + inward * between(grand, 3, 9), U.top - between(grand, 2, 6), U.face - 0.05)\n\t\tlocal d = b - a\n\t\tadd({ id = \"Cobweb\" .. k, size = v(d.Magnitude, 0.012, 0.012), at = (a + b) * 0.5, turn = v(0, math.deg(math.atan2(-d.Z, d.X)), math.deg(math.asin(math.clamp(d.Y / d.Magnitude, -1, 1)))),\n\t\t\tshape = \"Cylinder\", color = hex(\"e8e4d8\"), material = \"Glass\", transparency = 0.45, full = true, group = \"Weather\" })\n\tend\n\t-- full tier: mortar lines along the long walls either side, one a course, so they read as brick from the garden\n\tfor i, side in { -1, 1 } do\n\t\tlocal x0, x1 = if side < 0 then -H.x else U.east, if side < 0 then westEnd else H.x\n\t\tlocal yy = W.under - K.joint / 2\n\t\twhile yy > H.foot do yy -= course end\n\t\tyy += course\n\t\tlocal k = 0\n\t\twhile yy < U.top do\n\t\t\tk += 1\n\t\t\tadd({ id = `Course{i}_{k}`, size = v(x1 - x0, K.joint * 0.6, 0.02), at = v((x0 + x1) / 2, yy, U.face + K.gap - 0.012), color = hex(U.houseMortar), material = W.mortarMaterial, full = true, group = \"House\" })\n\t\t\tyy += course\n\t\tend\n\tend\n\treturn list\nend\n\nlocal function bedDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal B = Garden.BED\n\tlocal list, add = sheet(budget)\n\tlocal pieces = Garden.pieces(region)\n\tlocal top = B.top\n\t-- what stands on the soil, so the litter, the grass and the pebbles go round it\n\tlocal standing: { Box } = {}\n\tfor _, p in pieces do\n\t\tif p.lo.Y <= top + 0.01 and p.id ~= \"bed_a_soil\" then table.insert(standing, { min = p.lo, max = p.hi }) end\n\tend\n\tlocal function free(x: number, z: number, margin: number): boolean\n\t\tfor _, b in standing do\n\t\t\tif x > b.min.X - margin and x < b.max.X + margin and z > b.min.Z - margin and z < b.max.Z + margin then return false end\n\t\tend\n\t\treturn true\n\tend\n\tlocal function onSoil(rand: () -> number, margin: number): (number, number)\n\t\tlocal x, z = 0.0, 0.0\n\t\tfor _ = 1, 30 do\n\t\t\tx, z = between(rand, B.x0 + 0.6, B.x1 - 0.6), between(rand, B.z0 + 0.6, B.z1 - 0.6)\n\t\t\tif free(x, z, margin) then break end\n\t\tend\n\t\treturn x, z\n\tend\n\t-- the plants first (their leaves are what the spider walks on: the blades are kept at both tiers)\n\tfor _, p in pieces do\n\t\tif string.find(p.id, \"_leaf_\", 1, true) ~= nil then\n\t\t\tleafOver(add, p.id, p.lo, p.hi, \"Plants\")\n\t\telseif string.find(p.id, \"_stem\", 1, true) ~= nil or string.find(p.id, \"_stalk\", 1, true) ~= nil then\n\t\t\tlocal c = (p.lo + p.hi) * 0.5\n\t\t\tlocal d = math.min(p.hi.X - p.lo.X, p.hi.Z - p.lo.Z)\n\t\t\tadd({ id = p.id .. \"Rod\", size = v(p.hi.Y - p.lo.Y, d, d), at = c, turn = v(0, 0, 90), shape = \"Cylinder\", color = hex(B.leaf.stem), material = B.leaf.material, group = \"Plants\", shadow = true })\n\t\t\tif string.find(p.id, \"_stalk\", 1, true) ~= nil then\n\t\t\t\tlocal F = B.flower\n\t\t\t\tlocal head = v(c.X, p.hi.Y + 0.35, c.Z)\n\t\t\t\tadd({ id = \"FlowerSepals\", size = v(F.bracts, 0.6, F.bracts), at = head - v(0, 0.35, 0), shape = \"Ellipsoid\", color = hex(F.sepals), material = \"SmoothPlastic\", group = \"Plants\" })\n\t\t\t\tadd({ id = \"FlowerHead\", size = v(F.size, 1.2, F.size), at = head + v(0, 0.1, 0), shape = \"Ellipsoid\", color = hex(F.head), material = \"SmoothPlastic\", group = \"Plants\" })\n\t\t\t\tadd({ id = \"FlowerDisc\", size = v(F.centre, 0.35, F.centre), at = head + v(0, 0.62, 0), shape = \"Ellipsoid\", color = hex(F.disc), material = \"SmoothPlastic\", full = true, group = \"Plants\" })\n\t\t\tend\n\t\tend\n\tend\n\t-- the mounds' slopes: a flattened heap of the same soil round each, rising to just under its top, so a mound reads as a heap (the walkable top is the box's)\n\tfor _, p in pieces do\n\t\tif string.find(p.id, \"mound\", 1, true) ~= nil then\n\t\t\tlocal h = p.hi.Y - p.lo.Y\n\t\t\tadd({ id = p.id .. \"Slope\", size = v((p.hi.X - p.lo.X) * 1.35, h * 1.9, (p.hi.Z - p.lo.Z) * 1.35), at = v((p.lo.X + p.hi.X) / 2, top, (p.lo.Z + p.hi.Z) / 2),\n\t\t\t\tshape = \"Ellipsoid\", color = p.color, material = B.soilMaterial, group = \"Soil\" })\n\t\tend\n\tend\n\t-- lichen on the stones and moss at their feet\n\tlocal lrand = rng(region.seed, 41)\n\tfor _, p in pieces do\n\t\tif string.find(p.id, \"stone\", 1, true) ~= nil then\n\t\t\tfor j = 1, 2 do\n\t\t\t\tlocal s = between(lrand, 0.5, 1.4)\n\t\t\t\tadd({ id = `{p.id}Lichen{j}`, size = v(0.01, s, s * between(lrand, 0.6, 1.0)), at = v(between(lrand, p.lo.X + s, p.hi.X - s), p.hi.Y + 0.005, between(lrand, p.lo.Z + s, p.hi.Z - s)),\n\t\t\t\t\tturn = v(0, lrand() * 360, 90), shape = \"Cylinder\", color = hex(pick({ \"b8b48a\", \"c9c3a0\", \"9aa77a\" }, lrand)), material = \"Plaster\", full = true, group = \"Stones\" })\n\t\t\tend\n\t\t\tfor j = 1, 3 do\n\t\t\t\tlocal side = lrand() < 0.5\n\t\t\t\tlocal x = if side then pick({ p.lo.X - 0.15, p.hi.X + 0.15 }, lrand) else between(lrand, p.lo.X, p.hi.X)\n\t\t\t\tlocal z = if side then between(lrand, p.lo.Z, p.hi.Z) else pick({ p.lo.Z - 0.15, p.hi.Z + 0.15 }, lrand)\n\t\t\t\tlocal s = between(lrand, 0.35, 0.8)\n\t\t\t\tadd({ id = `{p.id}Moss{j}`, size = v(s, s * 0.5, s), at = v(x, top + s * 0.12, z), shape = \"Ellipsoid\", turn = v(0, lrand() * 360, 0), color = hex(pick(Garden.OUTER.moss, lrand)), material = \"Grass\", full = true, group = \"Stones\" })\n\t\t\tend\n\t\tend\n\tend\n\t-- the soil: damper and drier patches (full tier)\n\tlocal srand = rng(region.seed, 43)\n\tfor i = 1, B.mottle.count do\n\t\tlocal x, z = onSoil(srand, 0.2)\n\t\tlocal w = between(srand, B.mottle.size[1], B.mottle.size[2])\n\t\tadd({ id = \"Mottle\" .. i, size = v(w, 0.006, w * between(srand, 0.5, 0.9)), at = v(x, top + 0.003, z), turn = v(0, srand() * 360, 0), shape = \"Ellipsoid\",\n\t\t\tcolor = hex(pick(B.mottle.colors, srand)), material = B.soilMaterial, full = true, group = \"Soil\" })\n\tend\n\t-- the grass: tufts along the bed's edges and by the stones, each blade a long thin leaf leaning out from the tuft's foot\n\tlocal grand = rng(region.seed, 47)\n\tlocal G = B.grass\n\tlocal tufts: { { x: number, z: number, height: number } } = {} -- (ROBLOX-103: where each tuft stands, for its seed heads below)\n\tfor i = 1, G.tufts do\n\t\tlocal x, z\n\t\tif i % 2 == 0 then\n\t\t\tlocal edge = math.floor(grand() * 3)\n\t\t\tx = if edge == 0 then B.x0 + between(grand, 0.4, 1.6) elseif edge == 1 then B.x1 - between(grand, 0.4, 1.6) else between(grand, B.x0 + 1, B.x1 - 1)\n\t\t\tz = if edge == 2 then B.z0 + between(grand, 0.4, 1.6) else between(grand, B.z0 + 1, B.z1 - B.landing)\n\t\telse\n\t\t\tx, z = onSoil(grand, 0.5)\n\t\tend\n\t\tlocal height = between(grand, G.height[1], G.height[2])\n\t\ttable.insert(tufts, { x = x, z = z, height = height })\n\t\tfor j = 1, G.blades do\n\t\t\tlocal a = grand() * TAU\n\t\t\tlocal lean = between(grand, 12, 34)\n\t\t\tlocal l = height * between(grand, 0.7, 1.0)\n\t\t\tlocal color = if grand() < 0.15 then hex(G.dry) else hex(pick(G.colors, grand))\n\t\t\tlocal foot = v(x + math.cos(a) * 0.12, top, z + math.sin(a) * 0.12)\n\t\t\tlocal out = math.sin(math.rad(lean)) * l / 2\n\t\t\tadd({ id = `Tuft{i}Blade{j}`, size = v(0.05, l, between(grand, G.width[1], G.width[2])), at = foot + v(math.cos(a) * out, math.cos(math.rad(lean)) * l / 2, math.sin(a) * out),\n\t\t\t\tturn = v(0, -math.deg(a), -lean), shape = \"Ellipsoid\", color = color, material = \"SmoothPlastic\", full = j > G.keep, group = \"Grass\" })\n\t\tend\n\tend\n\t-- the leaf litter: fallen leaves, flat or a little curled, one in `lowEvery` kept at the low tier\n\tlocal frand = rng(region.seed, 53)\n\tlocal F = B.litter\n\tfor i = 1, F.count do\n\t\tlocal x, z = onSoil(frand, 0.3)\n\t\tlocal s = between(frand, F.size[1], F.size[2])\n\t\tlocal curl = if frand() < 0.3 then between(frand, 8, 22) else between(frand, 0, 4)\n\t\tadd({ id = \"Litter\" .. i, size = v(s, 0.04, s * between(frand, 0.45, 0.7)), at = v(x, top + 0.03 + math.sin(math.rad(curl)) * s * 0.2, z), turn = v(curl, frand() * 360, 0),\n\t\t\tshape = \"Ellipsoid\", color = hex(pick(F.colors, frand)), material = \"SmoothPlastic\", full = i % F.lowEvery ~= 0, group = \"Litter\" })\n\tend\n\t-- twigs and pebbles (full tier)\n\tlocal trand = rng(region.seed, 59)\n\tlocal T = B.twigs\n\tfor i = 1, T.count do\n\t\tlocal x, z = onSoil(trand, 0.4)\n\t\tlocal l = between(trand, T.length[1], T.length[2])\n\t\tadd({ id = \"Twig\" .. i, size = v(l, T.width, T.width), at = v(x, top + T.width / 2, z), turn = v(0, trand() * 360, 0), shape = \"Cylinder\", color = hex(pick(T.colors, trand)), material = \"Wood\", full = true, group = \"Litter\" })\n\tend\n\tlocal P = B.pebbles\n\tfor i = 1, P.count do\n\t\tlocal x, z = onSoil(trand, 0.2)\n\t\tlocal s = between(trand, P.size[1], P.size[2])\n\t\tadd({ id = \"Pebble\" .. i, size = v(s, s * 0.55, s * between(trand, 0.6, 0.9)), at = v(x, top + s * 0.18, z), turn = v(between(trand, -15, 15), trand() * 360, 0), shape = \"Ellipsoid\",\n\t\t\tcolor = hex(pick(P.colors, trand)), material = \"Pebble\", full = true, group = \"Litter\" })\n\tend\n\t-- ROBLOX-103 (W3c), each from a stream of its own after everything placed before, so nothing above moves (the woodlice's litter included):\n\t-- seed heads on every other tuft (a stalk from the tuft's foot past its blades and a head of seeds on it, full tier);\n\tlocal hrand = rng(region.seed, 111)\n\tlocal SH = B.seedHeads\n\tfor i, t in tufts do\n\t\tif i % 2 == 0 then\n\t\t\tlocal a = hrand() * TAU\n\t\t\tlocal lean = between(hrand, 6, 18)\n\t\t\tlocal l = t.height * between(hrand, SH.over[1], SH.over[2])\n\t\t\tlocal tipOut = math.sin(math.rad(lean)) * l\n\t\t\tlocal foot = v(t.x, top, t.z)\n\t\t\tlocal tip = foot + v(math.cos(a) * tipOut, math.cos(math.rad(lean)) * l, math.sin(a) * tipOut)\n\t\t\tlocal d = tip - foot\n\t\t\tadd({ id = `Tuft{i}Stalk`, size = v(l, 0.04, 0.04), at = (foot + tip) * 0.5, turn = v(0, math.deg(math.atan2(-d.Z, d.X)), math.deg(math.asin(math.clamp(d.Y / d.Magnitude, -1, 1)))),\n\t\t\t\tshape = \"Cylinder\", color = hex(SH.stalk), material = \"SmoothPlastic\", full = true, group = \"Grass\" })\n\t\t\tadd({ id = `Tuft{i}Head`, size = v(SH.width, SH.length, SH.width), at = tip + d.Unit * (SH.length * 0.4), turn = v(0, -math.deg(a), -lean), shape = \"Ellipsoid\",\n\t\t\t\tcolor = hex(pick(SH.colors, hrand)), material = \"Fabric\", full = true, group = \"Grass\" })\n\t\tend\n\tend\n\t-- grass clumps along the bed's edges, where the lawn creeps in (one blade of each kept at the low tier), each with a seed head on a stalk;\n\tlocal crand = rng(region.seed, 113)\n\tlocal C = B.clumps\n\tfor i = 1, C.count do\n\t\tlocal edge = (i - 1) % 3\n\t\tlocal x = if edge == 0 then B.x0 + between(crand, 0.3, 1.0) elseif edge == 1 then B.x1 - between(crand, 0.3, 1.0) else between(crand, B.x0 + 2, B.x1 - 2)\n\t\tlocal z = if edge == 2 then B.z0 + between(crand, 0.3, 1.0) else between(crand, B.z0 + 2, B.z1 - B.landing - 1)\n\t\tlocal height = between(crand, C.height[1], C.height[2])\n\t\tfor j = 1, C.blades do\n\t\t\tlocal a = crand() * TAU\n\t\t\tlocal lean = between(crand, 10, 30)\n\t\t\tlocal l = height * between(crand, 0.7, 1.0)\n\t\t\tlocal foot = v(x + math.cos(a) * 0.15, top, z + math.sin(a) * 0.15)\n\t\t\tlocal out = math.sin(math.rad(lean)) * l / 2\n\t\t\tadd({ id = `Clump{i}Blade{j}`, size = v(0.05, l, between(crand, B.grass.width[1], B.grass.width[2])), at = foot + v(math.cos(a) * out, math.cos(math.rad(lean)) * l / 2, math.sin(a) * out),\n\t\t\t\tturn = v(0, -math.deg(a), -lean), shape = \"Ellipsoid\", color = hex(if crand() < 0.15 then B.grass.dry else pick(B.grass.colors, crand)), material = \"SmoothPlastic\", full = j > 1, group = \"Grass\" })\n\t\tend\n\t\tadd({ id = `Clump{i}Stalk`, size = v(height * 1.25, 0.04, 0.04), at = v(x, top + height * 0.625, z), turn = v(0, 0, 90), shape = \"Cylinder\", color = hex(SH.stalk), material = \"SmoothPlastic\", full = true, group = \"Grass\" })\n\t\tadd({ id = `Clump{i}Head`, size = v(SH.width, SH.length, SH.width), at = v(x, top + height * 1.25 + SH.length * 0.4, z), shape = \"Ellipsoid\", color = hex(pick(SH.colors, crand)), material = \"Fabric\", full = true, group = \"Grass\" })\n\tend\n\t-- and more kinds of litter (full tier): skeleton leaves gone to lace, dark rotting ones, small round ones, husks, and an empty snail shell\n\tlocal morerand = rng(region.seed, 127)\n\tlocal X = B.moreLitter\n\tfor i = 1, X.count do\n\t\tlocal x, z = onSoil(morerand, 0.3)\n\t\tlocal kind = X.kinds[1 + (i - 1) % #X.kinds]\n\t\tlocal s = between(morerand, kind.size[1], kind.size[2])\n\t\tadd({ id = \"MoreLitter\" .. i, size = v(s, 0.035, s * kind.shape), at = v(x, top + 0.025, z), turn = v(between(morerand, 0, 10), morerand() * 360, 0), shape = \"Ellipsoid\",\n\t\t\tcolor = hex(pick(kind.colors, morerand)), material = \"Fabric\", transparency = kind.transparency, full = true, group = \"Litter\" })\n\tend\n\tlocal sx, sz = onSoil(morerand, 0.6)\n\tadd({ id = \"SnailShell\", size = v(1.1, 0.95, 1.1), at = v(sx, top + 0.42, sz), turn = v(0, morerand() * 360, 70), shape = \"Ellipsoid\", color = hex(\"b59a6e\"), material = \"SmoothPlastic\", full = true, group = \"Litter\" })\n\tadd({ id = \"SnailShellBand\", size = v(1.12, 0.3, 1.12), at = v(sx, top + 0.42, sz), turn = v(0, 0, 70), shape = \"Ellipsoid\", color = hex(\"6b4e2e\"), material = \"SmoothPlastic\", full = true, group = \"Litter\" })\n\treturn list\nend\n\n-- (ROBLOX-107) The brick of the back wall west of the window, on the house_wall's and wall_upper's own grid (the same bond carries across x -40), between two heights:\n-- courses below y -3 as the house_wall's, the course beside its shoulders from y -2.5, and from y 0.5 up as the wall above's.\nlocal function westBricks(add: (Drawn) -> boolean, brand: () -> number, ylo: number, yhi: number, group: string): { { at: Vector3, size: Vector3 } }\n\tlocal W, K, H = Garden.WEST, Garden.WALL.brick, Garden.WALL\n\tlocal face = W.face + K.gap\n\tlocal pitch, course = K.length + K.joint, K.height + K.joint\n\tlocal laid: { { at: Vector3, size: Vector3 } } = {}\n\tlocal n = 0\n\tlocal function lay(y0: number, y1: number, offset: number)\n\t\tif y1 <= ylo or y0 >= yhi then return end\n\t\tlocal x = W.east - offset - 5 * pitch\n\t\twhile x < W.east do\n\t\t\tlocal a, b = math.max(x + K.joint / 2, W.west), math.min(x + pitch - K.joint / 2, W.east)\n\t\t\tif b - a >= 2.0 then\n\t\t\t\tn += 1\n\t\t\t\tlocal burnt, pale = brand() < 0.08, brand() < 0.06\n\t\t\t\tlocal color = if burnt then hex(H.burnt) elseif pale then hex(H.pale) else hex(pick(H.bricks, brand))\n\t\t\t\tlocal sink = brand() * 0.05\n\t\t\t\tlocal at, size = v((a + b) / 2, (y0 + y1) / 2, face + sink + K.depth / 2), v(b - a, y1 - y0, K.depth)\n\t\t\t\tadd({ id = \"Brick\" .. n, size = size, at = at, color = color, material = H.brickMaterial, group = group })\n\t\t\t\ttable.insert(laid, { at = at, size = size })\n\t\t\tend\n\t\t\tx += pitch\n\t\tend\n\tend\n\tlocal c = 0\n\tlocal y = H.under - K.joint / 2\n\twhile y - K.height > W.foot - K.height do\n\t\tlay(math.max(y - K.height, W.foot), y, (c % 2) * pitch / 2)\n\t\ty -= course\n\t\tc += 1\n\tend\n\tlay(H.under + K.joint / 2, W.rise - K.joint / 2, pitch / 2)\n\tc = 0\n\ty = W.rise + K.joint / 2\n\twhile y + K.height <= W.top - K.joint / 2 do\n\t\tlay(y, y + K.height, ((c + 1) % 2) * pitch / 2)\n\t\ty += course\n\t\tc += 1\n\tend\n\treturn laid\nend\n\n-- The drainpipe drawn over its boxes: a rod over each run, the neck out under the gutter and the outlet up into it, and the brackets' collars and ties (both tiers: they\n-- stand in for walkable boxes).\nlocal function pipeOver(add: (Drawn) -> boolean, pieces: { Piece })\n\tlocal W = Garden.WEST\n\tlocal metal = hex(W.color)\n\tfor _, p in pieces do\n\t\tlocal size = p.hi - p.lo\n\t\tlocal c = (p.lo + p.hi) * 0.5\n\t\tif string.sub(p.id, -5) == \"_pipe\" then\n\t\t\tadd({ id = \"Pipe\", size = v(size.Y, size.X, size.Z), at = c, turn = v(0, 0, 90), shape = \"Cylinder\", color = metal, material = W.material, group = \"Drainpipe\" })\n\t\telseif string.sub(p.id, -5) == \"_neck\" then\n\t\t\tadd({ id = \"Neck\", size = v(size.Z, size.X, size.Y), at = c, turn = v(0, 90, 0), shape = \"Cylinder\", color = metal, material = W.material, group = \"Drainpipe\" })\n\t\t\tadd({ id = \"NeckBend\", size = v(size.X, size.X * 1.1, size.X * 1.1), at = v(c.X, c.Y, p.hi.Z - size.X / 2), shape = \"Ball\", color = metal, material = W.material, group = \"Drainpipe\" })\n\t\telseif string.sub(p.id, -7) == \"_outlet\" then\n\t\t\tadd({ id = \"Outlet\", size = v(size.Y, size.X, size.Z), at = c, turn = v(0, 0, 90), shape = \"Cylinder\", color = metal, material = W.material, group = \"Drainpipe\" })\n\t\telseif string.find(p.id, \"_bracket\", 1, true) ~= nil then\n\t\t\tadd({ id = \"Bracket\" .. string.sub(p.id, string.find(p.id, \"_bracket\", 1, true) :: number + 8), size = size - v(0.02, 0.02, 0.02), at = c, color = hex(\"2e3032\"), material = W.material, group = \"Drainpipe\" })\n\t\tend\n\tend\nend\n\n-- (ROBLOX-107) The back wall west of the window, below y 0: the brick courses over a recessed mortar bed, the drainpipe and its lower bracket and the shoe at its foot\n-- (both tiers), then at the full tier the damp patch where the drain runs out (darker brick and darker litter, moss), algae along the foot, salt bloom, an old cobweb\n-- behind the pipe and lichen.\nlocal function westDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal W, H, K = Garden.WEST, Garden.WALL, Garden.WALL.brick\n\tlocal P = W.pipe\n\tlocal list, add = sheet(budget)\n\tlocal face = W.face + K.gap\n\tlocal mortarFace = W.face + K.recess\n\tadd({ id = \"Mortar\", size = v(W.east - W.west, W.rise - W.foot, W.back - mortarFace), at = v((W.west + W.east) / 2, (W.rise + W.foot) / 2, (W.back + mortarFace) / 2), color = hex(H.mortar), material = H.mortarMaterial, group = \"Mortar\" })\n\tlocal laid = westBricks(add, rng(region.seed, 13), W.foot, W.rise, \"Bricks\")\n\tpipeOver(add, Garden.pieces(region))\n\tlocal z1 = W.face - P.gap\n\tlocal metal = hex(W.color)\n\t-- the shoe: a socket round the pipe's foot, a little proud of the walkable column (the previews: a box 11 across stood out past the column, over the damp where\n\t-- the woodlice begin)\n\tadd({ id = \"PipeShoe\", size = v(3, P.d + 0.6, P.d + 0.6), at = v(P.x, P.foot + 1.5, z1 - P.d / 2), turn = v(0, 0, 90), shape = \"Cylinder\", color = metal, material = W.material, group = \"Drainpipe\" })\n\t-- full tier: the damp at the drain's foot, on the litter and up the brick behind it\n\tlocal erand = rng(region.seed, 17)\n\tadd({ id = \"DampLitter\", size = v(between(erand, 14, 18), 0.008, between(erand, 9, 12)), at = v(P.x, P.foot + 0.004, z1 - P.d - 3), shape = \"Ellipsoid\", color = hex(W.damp[1]),\n\t\tmaterial = \"Ground\", transparency = 0.2, full = true, group = \"Weather\" })\n\tadd({ id = \"DampBrick\", size = v(between(erand, 12, 16), between(erand, 10, 16), 0.006), at = v(P.x, P.foot + 5, face - 0.003), shape = \"Ellipsoid\", color = hex(W.damp[2]),\n\t\tmaterial = \"Concrete\", transparency = 0.35, full = true, group = \"Weather\" })\n\tfor i = 1, 5 do\n\t\tlocal s = between(erand, 0.6, 1.4)\n\t\tadd({ id = \"DampMoss\" .. i, size = v(s * 1.6, s * 0.6, s), at = v(P.x + between(erand, -7, 7), P.foot + s * 0.2, z1 - P.d - between(erand, 0.5, 4)), shape = \"Ellipsoid\",\n\t\t\tcolor = hex(pick(Garden.OUTER.moss, erand)), material = \"Grass\", full = true, group = \"Weather\" })\n\tend\n\tfor i = 1, 8 do\n\t\tlocal w = between(erand, 4, 11)\n\t\tadd({ id = \"Algae\" .. i, size = v(w, between(erand, 1.5, 5), 0.006), at = v(W.west + (i - 0.5) * (W.east - W.west) / 8 + between(erand, -2, 2), W.foot + between(erand, 1, 3), face - 0.002),\n\t\t\tcolor = hex(\"4f6a36\"), material = \"Grass\", transparency = 0.4, full = true, group = \"Weather\" })\n\tend\n\tfor i = 1, 6 do\n\t\tadd({ id = \"Bloom\" .. i, size = v(between(erand, 2, 5), between(erand, 1, 2.5), 0.006), at = v(between(erand, W.west + 5, W.east - 5), between(erand, -60, -10), face - 0.002),\n\t\t\tcolor = hex(\"d9d2c4\"), material = \"Plaster\", transparency = 0.78, full = true, group = \"Weather\" })\n\tend\n\tfor i = 1, 6 do\n\t\tlocal w = between(erand, 0.6, 1.8)\n\t\tadd({ id = \"Lichen\" .. i, size = v(w, w * between(erand, 0.55, 0.9), 0.008), at = v(between(erand, W.west + 4, W.east - 4), between(erand, -72, -16), face - 0.003),\n\t\t\tturn = v(0, 0, erand() * 360), shape = \"Ellipsoid\", color = hex(pick({ \"b9b78f\", \"c7c4a2\", \"9fa97d\", \"d0cdb2\" }, erand)), material = \"Plaster\", full = true, group = \"Weather\" })\n\tend\n\t-- an old cobweb in the gap behind the pipe\n\tfor k = 1, 3 do\n\t\tlocal a = v(P.x + between(erand, -3, 3), between(erand, -70, -20), W.face - 0.05)\n\t\tlocal b = a + v(between(erand, -2, 2), between(erand, -3, 3), -P.gap + 0.1)\n\t\tlocal d = b - a\n\t\tadd({ id = \"Cobweb\" .. k, size = v(d.Magnitude, 0.012, 0.012), at = (a + b) * 0.5, turn = v(0, math.deg(math.atan2(-d.Z, d.X)), math.deg(math.asin(math.clamp(d.Y / d.Magnitude, -1, 1)))),\n\t\t\tshape = \"Cylinder\", color = hex(\"e8e4d8\"), material = \"Glass\", transparency = 0.45, full = true, group = \"Weather\" })\n\tend\n\tlocal srand = rng(region.seed, 19)\n\tfor i, s in laid do\n\t\tif srand() < 0.08 then\n\t\t\tadd({ id = \"Spall\" .. i, size = v(s.size.X * between(srand, 0.3, 0.6), s.size.Y * between(srand, 0.3, 0.6), 0.006), at = v(s.at.X + between(srand, -3, 3), s.at.Y + between(srand, -1, 1), face - 0.002),\n\t\t\t\tcolor = hex(H.burnt), material = \"Concrete\", transparency = 0.25, full = true, group = \"Weather\" })\n\t\tend\n\tend\n\treturn list\nend\n\n-- (ROBLOX-107, ROBLOX-112) The same wall from y 0 to the window's head: the courses over the mortar and the drainpipe and its upper bracket (both tiers), then lichen and\n-- a little salt bloom at the full tier.\nlocal function westUpperDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal W, H, K = Garden.WEST, Garden.WALL, Garden.WALL.brick\n\tlocal list, add = sheet(budget)\n\tlocal face = W.face + K.gap\n\tlocal mortarFace = W.face + K.recess\n\tadd({ id = \"Mortar\", size = v(W.east - W.west, W.head - W.rise, W.back - mortarFace), at = v((W.west + W.east) / 2, (W.head + W.rise) / 2, (W.back + mortarFace) / 2), color = hex(H.mortar), material = H.mortarMaterial, group = \"Mortar\" })\n\twestBricks(add, rng(region.seed, 13), W.rise, W.head, \"Bricks\")\n\tpipeOver(add, Garden.pieces(region))\n\tlocal grand = rng(region.seed, 103)\n\tfor k = 1, 4 do\n\t\tlocal w = between(grand, 0.8, 2.0)\n\t\tadd({ id = \"Lichen\" .. k, size = v(w, w * between(grand, 0.55, 0.9), 0.008), at = v(between(grand, W.west + 4, W.east - 4), between(grand, 20, W.head - 6), face - 0.003), turn = v(0, 0, grand() * 360),\n\t\t\tshape = \"Ellipsoid\", color = hex(pick({ \"b9b78f\", \"c7c4a2\", \"9fa97d\", \"d0cdb2\" }, grand)), material = \"Plaster\", full = true, group = \"Weather\" })\n\tend\n\tfor k = 1, 3 do\n\t\tadd({ id = \"Bloom\" .. k, size = v(between(grand, 2, 5), between(grand, 1, 2.5), 0.006), at = v(between(grand, W.west + 5, W.east - 5), between(grand, 10, 60), face - 0.002),\n\t\t\tcolor = hex(\"d9d2c4\"), material = \"Plaster\", transparency = 0.78, full = true, group = \"Weather\" })\n\tend\n\treturn list\nend\n\n-- (ROBLOX-112; ROBLOX-107's wall_west_upper above the head) The same wall from the head to the eaves: the courses over the mortar, the eaves, fascia, gutter and eave\n-- course over their boxes, the drainpipe's top, neck and outlet (both tiers), then at the full tier the gutter's rolled lip, leaves and moss in it, dirt streaks down\n-- the brick under it, and lichen.\nlocal function eavesWestDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal W, U, H, K = Garden.WEST, Garden.UPPER, Garden.WALL, Garden.WALL.brick\n\tlocal G, E, F, R = U.gutter, U.eaves, U.fascia, U.roof\n\tlocal list, add = sheet(budget)\n\tlocal face = W.face + K.gap\n\tlocal mortarFace = W.face + K.recess\n\tlocal gap = 0.02\n\tlocal function inside(id: string, lo: Vector3, hi: Vector3, color: string, material: string, group: string)\n\t\tadd({ id = id, size = hi - lo - v(2 * gap, 2 * gap, 2 * gap), at = (lo + hi) * 0.5, color = hex(color), material = material, group = group })\n\tend\n\tadd({ id = \"Mortar\", size = v(W.east - W.west, W.top - W.head, W.back - mortarFace), at = v((W.west + W.east) / 2, (W.top + W.head) / 2, (W.back + mortarFace) / 2), color = hex(H.mortar), material = H.mortarMaterial, group = \"Mortar\" })\n\twestBricks(add, rng(region.seed, 13), W.head, W.top, \"Bricks\")\n\tlocal joint = -G.span - G.cap\n\tinside(\"Soffit\", v(W.west, U.top, E.out), v(-E.edge, E.top, U.back), U.paint, \"Wood\", \"Eaves\")\n\tinside(\"Fascia\", v(W.west, F.bottom, F.out), v(-E.edge, E.top, E.out), U.paint, \"Wood\", \"Eaves\")\n\tinside(\"GutterFloor\", v(W.west, G.floor, G.out), v(joint, G.floor + G.thick, F.out), U.gutterColor, U.gutterMaterial, \"Gutter\")\n\tinside(\"GutterLip\", v(W.west, G.floor, G.out - G.wall), v(joint, G.lip, G.out), U.gutterColor, U.gutterMaterial, \"Gutter\")\n\tinside(\"GutterWest\", v(W.west - G.cap, G.floor, G.out - G.wall), v(W.west, G.lip, F.out), U.gutterColor, U.gutterMaterial, \"Gutter\")\n\tinside(\"EaveCourse\", v(W.west, E.top, R.eave), v(-E.edge, E.top + R.thick, U.back), R.color, R.material, \"Roof\")\n\tpipeOver(add, Garden.pieces(region))\n\t-- full tier\n\tadd({ id = \"GutterBead\", size = v(joint - W.west, 1.4, 1.4), at = v((W.west + joint) / 2, G.lip, G.out - G.wall / 2), shape = \"Cylinder\", color = hex(U.gutterColor), material = U.gutterMaterial, full = true, group = \"Gutter\" })\n\tlocal grand = rng(region.seed, 103)\n\tfor k = 1, 6 do\n\t\tlocal s = between(grand, 1.2, 3.2)\n\t\tadd({ id = \"GutterLeaf\" .. k, size = v(s, 0.08, s * between(grand, 0.45, 0.7)), at = v(between(grand, W.west + 2, joint - 2), G.floor + G.thick + 0.05, between(grand, G.out + 1.5, F.out - 1.5)),\n\t\t\tturn = v(between(grand, 0, 12), grand() * 360, 0), shape = \"Ellipsoid\", color = hex(pick(U.debris, grand)), material = \"Fabric\", full = true, group = \"Gutter\" })\n\tend\n\tfor k = 1, 2 do\n\t\tlocal s = between(grand, 1.5, 3.0)\n\t\tadd({ id = \"GutterMoss\" .. k, size = v(s, s * 0.45, s), at = v(between(grand, W.west + 3, joint - 3), G.floor + G.thick + s * 0.15, between(grand, G.out + 2, F.out - 2)),\n\t\t\tshape = \"Ellipsoid\", color = hex(pick(Garden.OUTER.moss, grand)), material = \"Grass\", full = true, group = \"Gutter\" })\n\tend\n\tfor k = 1, 4 do\n\t\tlocal w, l = between(grand, 3, 8), between(grand, 10, 30)\n\t\tadd({ id = \"Streak\" .. k, size = v(w, l, 0.006), at = v(between(grand, W.west + 4, W.east - 4), U.top - l / 2 - 0.5, face - 0.003), color = hex(\"4e4a3c\"), material = \"Concrete\",\n\t\t\ttransparency = 0.55, full = true, group = \"Weather\" })\n\tend\n\tfor k = 1, 2 do\n\t\tlocal w = between(grand, 0.8, 2.0)\n\t\tadd({ id = \"Lichen\" .. k, size = v(w, w * between(grand, 0.55, 0.9), 0.008), at = v(between(grand, W.west + 4, W.east - 4), between(grand, W.head + 4, U.top - 4), face - 0.003), turn = v(0, 0, grand() * 360),\n\t\t\tshape = \"Ellipsoid\", color = hex(pick({ \"b9b78f\", \"c7c4a2\", \"9fa97d\", \"d0cdb2\" }, grand)), material = \"Plaster\", full = true, group = \"Weather\" })\n\tend\n\treturn list\nend\n\n-- (ROBLOX-112) The counter under the window. Both tiers: the tiled upstand, the worktop, the sink's bowl, the tap, the toaster on its feet and the kettle on its base, each\n-- over the boxes they stand in for. Full tier: the upstand's grout joints, the worktop's rounded front edge, the drain, water in the bowl and a drop at the spout, the\n-- tap's handle, the toaster's slots, lever and crumb tray, the kettle's lid, handle, spout and switch, its cord to the socket, crumbs (most of them by and under the\n-- toaster) and spilt sugar by the kettle.\nlocal function counterDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal K = Garden.KITCHEN\n\tlocal C, S, T, J = K.colors, K.sink, K.tap, K.kettle\n\tlocal list, add = sheet(budget)\n\tlocal gap = 0.02\n\tlocal pieces: { [string]: Piece } = {}\n\tfor _, piece in Garden.pieces(region) do pieces[piece.id] = piece end\n\tlocal function over(id: string, name: string, color: string, material: string, group: string)\n\t\tlocal piece = pieces[id]\n\t\tadd({ id = name, size = piece.hi - piece.lo - v(2 * gap, 2 * gap, 2 * gap), at = (piece.lo + piece.hi) * 0.5, color = hex(color), material = material, group = group })\n\tend\n\tlocal function rod(id: string, a: Vector3, b: Vector3, d: number, color: string, material: string, group: string, full: boolean?)\n\t\tlocal dd = b - a\n\t\tadd({ id = id, size = v(dd.Magnitude, d, d), at = (a + b) * 0.5, turn = v(0, math.deg(math.atan2(-dd.Z, dd.X)), math.deg(math.asin(math.clamp(dd.Y / dd.Magnitude, -1, 1)))),\n\t\t\tshape = \"Cylinder\", color = hex(color), material = material, full = full, group = group })\n\tend\n\tover(\"kitchen_upstand\", \"Upstand\", C.tile, \"SmoothPlastic\", \"Upstand\")\n\tover(\"kitchen_upstand_west\", \"UpstandWest\", C.tile, \"SmoothPlastic\", \"Upstand\")\n\tover(\"kitchen_upstand_east\", \"UpstandEast\", C.tile, \"SmoothPlastic\", \"Upstand\")\n\tfor _, name in { \"west\", \"east\", \"back\", \"front\" } do over(\"kitchen_worktop_\" .. name, \"Worktop\" .. name, C.worktop, \"SmoothPlastic\", \"Worktop\") end\n\tfor _, name in { \"floor\", \"west\", \"east\", \"back\", \"front\" } do over(\"kitchen_sink_\" .. name, \"Sink\" .. name, C.steel, \"Metal\", \"Sink\") end\n\t-- the tap: a round column and its spout out over the bowl\n\tlocal tap, spout = pieces.kitchen_tap, pieces.kitchen_tap_spout\n\tadd({ id = \"Tap\", size = v(tap.hi.Y - tap.lo.Y - gap, T.x1 - T.x0 - 2 * gap, T.z1 - T.z0 - 2 * gap), at = (tap.lo + tap.hi) * 0.5, turn = v(0, 0, 90), shape = \"Cylinder\", color = hex(C.steel),\n\t\tmaterial = \"Metal\", group = \"Sink\" })\n\tadd({ id = \"Spout\", size = v(spout.hi.X - spout.lo.X - gap, T.spout.w - 2 * gap, T.spout.w - 2 * gap), at = (spout.lo + spout.hi) * 0.5, shape = \"Cylinder\", color = hex(C.steel), material = \"Metal\", group = \"Sink\" })\n\t-- the toaster on its two feet over the gap, and the kettle on its base\n\tlocal To = K.toaster\n\tover(\"kitchen_toaster_foot_west\", \"ToasterFootWest\", To.feetColor, \"SmoothPlastic\", \"Toaster\")\n\tover(\"kitchen_toaster_foot_east\", \"ToasterFootEast\", To.feetColor, \"SmoothPlastic\", \"Toaster\")\n\tover(\"kitchen_toaster\", \"Toaster\", To.color, \"Metal\", \"Toaster\")\n\tlocal base, kettle = pieces.kitchen_kettle_base, pieces.kitchen_kettle\n\tlocal kc = (kettle.lo + kettle.hi) * 0.5\n\tlocal kd = kettle.hi.X - kettle.lo.X\n\tadd({ id = \"KettleBase\", size = v(base.hi.Y - base.lo.Y - gap, base.hi.X - base.lo.X - 2 * gap, base.hi.Z - base.lo.Z - 2 * gap), at = (base.lo + base.hi) * 0.5, turn = v(0, 0, 90), shape = \"Cylinder\",\n\t\tcolor = hex(J.baseColor), material = \"SmoothPlastic\", group = \"Kettle\" })\n\tadd({ id = \"Kettle\", size = v(kettle.hi.Y - kettle.lo.Y - gap, kd - 2 * gap, kd - 2 * gap), at = kc, turn = v(0, 0, 90), shape = \"Cylinder\", color = hex(J.color), material = \"SmoothPlastic\", group = \"Kettle\" })\n\t-- full tier: the upstand's grout joints, the worktop's rounded front edge\n\tlocal top = K.top\n\tfor x = K.x0 + 10, K.x1 - 5, 10 do\n\t\tadd({ id = \"Grout\" .. math.floor(x - K.x0), size = v(0.25, (if math.abs(x) < K.upstand.x then K.upstand.under else K.upstand.beside) - top, 0.02), at = v(x, (top + (if math.abs(x) < K.upstand.x then K.upstand.under else K.upstand.beside)) / 2, K.wall - gap + 0.005),\n\t\t\tcolor = hex(C.grout), material = \"SmoothPlastic\", full = true, group = \"Upstand\" })\n\tend\n\tadd({ id = \"Edge\", size = v(K.x1 - K.x0 - 2 * gap, K.thick - 2 * gap, K.thick - 2 * gap), at = v(0, top - K.thick / 2, K.front - K.thick / 2), shape = \"Cylinder\", color = hex(C.edge), material = \"SmoothPlastic\", full = true, group = \"Worktop\" })\n\t-- the drain and the water in the bowl, a drop hanging at the spout\n\tlocal floorTop = S.bottom\n\tadd({ id = \"Drain\", size = v(0.04, 4.5, 4.5), at = v((S.x0 + S.x1) / 2, floorTop + 0.01, (S.z0 + S.z1) / 2 + 6), turn = v(0, 0, 90), shape = \"Cylinder\", color = hex(\"6f7378\"), material = \"Metal\", full = true, group = \"Sink\" })\n\tadd({ id = \"Water\", size = v(9, 0.04, 6), at = v((S.x0 + S.x1) / 2 + 3, floorTop + 0.02, (S.z0 + S.z1) / 2 + 4), shape = \"Ellipsoid\", color = hex(\"b8c8cf\"), material = \"Glass\", transparency = 0.55, full = true, group = \"Sink\" })\n\tadd({ id = \"Drop\", size = v(0.7, 0.9, 0.7), at = v(T.spout.to + 0.8, spout.lo.Y - 0.45, (spout.lo.Z + spout.hi.Z) / 2), shape = \"Ellipsoid\", color = hex(\"cfe0e6\"), material = \"Glass\", transparency = 0.4, full = true, group = \"Sink\" })\n\tadd({ id = \"TapHandle\", size = v(4, 0.8, 0.8), at = v((T.x0 + T.x1) / 2, tap.hi.Y + 0.4, (tap.lo.Z + tap.hi.Z) / 2 + 1), turn = v(0, 90, 0), shape = \"Cylinder\", color = hex(C.steel), material = \"Metal\", full = true, group = \"Sink\" })\n\t-- the toaster's slots, its lever and its crumb tray\n\tlocal toaster = pieces.kitchen_toaster\n\tlocal tz = (toaster.lo.Z + toaster.hi.Z) / 2\n\tfor k, dz in { -2.6, 2.6 } do\n\t\tadd({ id = \"ToasterSlot\" .. k, size = v(toaster.hi.X - toaster.lo.X - 5, 0.04, 1.4), at = v((toaster.lo.X + toaster.hi.X) / 2, toaster.hi.Y + 0.0, tz + dz), color = hex(\"1e1f21\"), material = \"SmoothPlastic\", full = true, group = \"Toaster\" })\n\tend\n\tadd({ id = \"ToasterLever\", size = v(1.2, 1.6, 2.4), at = v(toaster.hi.X - 0.6, toaster.lo.Y + To.h * 0.7, tz), color = hex(\"2a2b2d\"), material = \"SmoothPlastic\", full = true, group = \"Toaster\" })\n\tadd({ id = \"CrumbTray\", size = v(toaster.hi.X - toaster.lo.X - 4, 0.5, 0.06), at = v((toaster.lo.X + toaster.hi.X) / 2, toaster.lo.Y + 0.6, toaster.hi.Z - gap), color = hex(\"8d9095\"), material = \"Metal\", full = true, group = \"Toaster\" })\n\t-- the kettle's lid, handle, spout and switch, and its cord back to the socket on the wall over the worktop\n\tadd({ id = \"KettleLid\", size = v(0.6, kd * 0.55, kd * 0.55), at = v(kc.X, kettle.hi.Y + 0.25, kc.Z), turn = v(0, 0, 90), shape = \"Cylinder\", color = hex(\"d9d7d0\"), material = \"SmoothPlastic\", full = true, group = \"Kettle\" })\n\tadd({ id = \"KettleHandle\", size = v(1.4, kettle.hi.Y - kettle.lo.Y - 6, 3), at = v(kettle.hi.X - 0.6, kc.Y + 1, kc.Z), color = hex(\"e4e2db\"), material = \"SmoothPlastic\", full = true, group = \"Kettle\" })\n\trod(\"KettleSpout\", v(kettle.lo.X + 1.2, kettle.hi.Y - 5, kc.Z), v(kettle.lo.X - 2.2, kettle.hi.Y - 1.6, kc.Z), 1.6, J.color, \"SmoothPlastic\", \"Kettle\", true)\n\tadd({ id = \"KettleSwitch\", size = v(1.2, 0.8, 1.6), at = v(kettle.hi.X - 0.6, kettle.lo.Y + 2.4, kc.Z), color = hex(\"4d6e8a\"), material = \"Neon\", full = true, group = \"Kettle\" })\n\tlocal So = K.socket\n\tlocal cordA = v(base.hi.X - 3, top + 0.35, base.lo.Z)\n\tlocal cordB = v(So.x + 1.5, top + 0.35, K.wall - 0.4)\n\trod(\"Cord1\", cordA, cordB, 0.5, \"2b2c2e\", \"SmoothPlastic\", \"Kettle\", true)\n\trod(\"Cord2\", cordB, v(So.x + 1.5, So.y - So.h / 2, K.wall - 0.4), 0.5, \"2b2c2e\", \"SmoothPlastic\", \"Kettle\", true)\n\t-- crumbs: most of them by the toaster and under it (the gap is where they gather), the rest along the worktop; spilt sugar by the kettle\n\tlocal crand = rng(region.seed, 31)\n\tlocal Cr = K.crumbs\n\tlocal retreat = region.retreats[1]\n\tfor k = 1, Cr.count do\n\t\tlocal d = between(crand, Cr.size[1], Cr.size[2])\n\t\tlocal x, z\n\t\tif k <= Cr.count * 0.4 then\n\t\t\tx, z = between(crand, retreat.min.X + 0.5, retreat.max.X - 0.5), between(crand, retreat.min.Z + 0.5, retreat.max.Z - 0.5)\n\t\telseif k <= Cr.count * 0.75 then\n\t\t\tx, z = between(crand, toaster.lo.X - 6, toaster.hi.X + 6), between(crand, toaster.hi.Z + 0.5, toaster.hi.Z + 7)\n\t\telse\n\t\t\tx = if crand() < 0.5 then between(crand, K.x0 + 2, S.x0 - 3) else between(crand, S.x1 + 3, J.x0 - 2)\n\t\t\tz = between(crand, K.wall + 2, K.front - 3)\n\t\tend\n\t\tadd({ id = \"Crumb\" .. k, size = v(d, d * between(crand, 0.4, 0.8), d * between(crand, 0.6, 1)), at = v(x, top + d * 0.2, z), turn = v(0, crand() * 360, 0), shape = \"Ellipsoid\",\n\t\t\tcolor = hex(pick(Cr.colors, crand)), material = \"Sand\", full = true, group = \"Crumbs\" })\n\tend\n\tfor k = 1, 8 do\n\t\tlocal d = between(crand, 0.08, 0.14)\n\t\tadd({ id = \"Sugar\" .. k, size = v(d, d, d), at = v(between(crand, J.x0 - 4, J.x0 + 2), top + d / 2, between(crand, J.z1 + 1, J.z1 + 6)), turn = v(crand() * 90, crand() * 90, 0),\n\t\t\tcolor = hex(\"f7f6f2\"), material = \"Glass\", transparency = 0.2, full = true, group = \"Crumbs\" })\n\tend\n\treturn list\nend\n\n-- (ROBLOX-112) Under the counter. Both tiers: the floor, the cupboard doors (four, with their gaps), the plinth, the end panels and the cupboards' base. Full tier: the\n-- floor's tile joints, the doors' handles, crumbs swept against the plinth, a dried pea and a dust ball in the dark under the doors.\nlocal function kitchenFloorDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal K = Garden.KITCHEN\n\tlocal C, D, F = K.colors, K.doors, K.floor\n\tlocal list, add = sheet(budget)\n\tlocal gap = 0.02\n\tlocal pieces: { [string]: Piece } = {}\n\tfor _, piece in Garden.pieces(region) do pieces[piece.id] = piece end\n\tlocal function over(id: string, name: string, color: string, material: string, group: string)\n\t\tlocal piece = pieces[id]\n\t\tadd({ id = name, size = piece.hi - piece.lo - v(2 * gap, 2 * gap, 2 * gap), at = (piece.lo + piece.hi) * 0.5, color = hex(color), material = material, group = group })\n\tend\n\tover(\"kitchen_floor\", \"Floor\", C.floor, \"SmoothPlastic\", \"Floor\")\n\tover(\"kitchen_plinth\", \"Plinth\", C.plinth, \"Wood\", \"Cupboards\")\n\tover(\"kitchen_end_west\", \"EndWest\", C.panel, \"Wood\", \"Cupboards\")\n\tover(\"kitchen_end_east\", \"EndEast\", C.panel, \"Wood\", \"Cupboards\")\n\tover(\"kitchen_base\", \"Base\", C.doors, \"Wood\", \"Cupboards\")\n\t-- the doors: a dark backing (the gaps between them) and four fronts over it, a hair inside the doors' box\n\tlocal doors = pieces.kitchen_doors\n\tadd({ id = \"DoorGaps\", size = v(doors.hi.X - doors.lo.X - 2 * gap, doors.hi.Y - doors.lo.Y - 2 * gap, D.thick * 0.5), at = v(0, (doors.lo.Y + doors.hi.Y) / 2, doors.lo.Z + D.thick * 0.25 + gap),\n\t\tcolor = hex(\"2b2a27\"), material = \"Wood\", group = \"Cupboards\" })\n\tlocal w = (doors.hi.X - doors.lo.X) / 4\n\tfor k = 1, 4 do\n\t\tlocal x0 = doors.lo.X + (k - 1) * w\n\t\tadd({ id = \"Door\" .. k, size = v(w - 0.4, doors.hi.Y - doors.lo.Y - 0.5, D.thick - 2 * gap), at = v(x0 + w / 2, (doors.lo.Y + doors.hi.Y) / 2 - 0.1, (doors.lo.Z + doors.hi.Z) / 2), color = hex(C.doors),\n\t\t\tmaterial = \"Wood\", group = \"Cupboards\" })\n\tend\n\t-- full tier: the floor's tile joints, the doors' handles\n\tlocal top = F.top\n\tfor z = K.wall + 30, F.z1 - 1, 30 do\n\t\tadd({ id = \"JointZ\" .. math.floor(z), size = v(K.x1 - K.x0 - 2 * gap, 0.02, 0.3), at = v(0, top - gap + 0.005, z), color = hex(\"a89a80\"), material = \"SmoothPlastic\", full = true, group = \"Floor\" })\n\tend\n\tfor x = K.x0 + 32, K.x1 - 1, 30 do\n\t\tadd({ id = \"JointX\" .. math.floor(x - K.x0), size = v(0.3, 0.02, F.z1 - K.wall - 2 * gap), at = v(x, top - gap + 0.005, (K.wall + F.z1) / 2), color = hex(\"a89a80\"), material = \"SmoothPlastic\", full = true, group = \"Floor\" })\n\tend\n\tfor k = 1, 4 do\n\t\tlocal x0 = doors.lo.X + (k - 1) * w\n\t\tlocal hx = if k % 2 == 1 then x0 + w - 4 else x0 + 4\n\t\tadd({ id = \"Handle\" .. k, size = v(1.0, 9, 1.0), at = v(hx, doors.hi.Y - 9, doors.hi.Z - 0.5), color = hex(\"b9bcc0\"), material = \"Metal\", full = true, group = \"Cupboards\" })\n\tend\n\t-- crumbs swept against the plinth's foot, a dried pea and a dust ball under the doors, where the light does not reach\n\tlocal crand = rng(region.seed, 31)\n\tlocal plinth = pieces.kitchen_plinth\n\tfor k = 1, 12 do\n\t\tlocal d = between(crand, 0.15, 0.5)\n\t\tadd({ id = \"Crumb\" .. k, size = v(d, d * 0.6, d * 0.8), at = v(between(crand, K.x0 + 4, K.x1 - 4), top + d * 0.2, between(crand, plinth.hi.Z + 0.6, plinth.hi.Z + 14)), turn = v(0, crand() * 360, 0),\n\t\t\tshape = \"Ellipsoid\", color = hex(pick(K.crumbs.colors, crand)), material = \"Sand\", full = true, group = \"Crumbs\" })\n\tend\n\tadd({ id = \"Pea\", size = v(0.8, 0.75, 0.8), at = v(between(crand, -40, 40), top + 0.38, plinth.hi.Z + 3), shape = \"Ball\", color = hex(\"7d8a3c\"), material = \"SmoothPlastic\", full = true, group = \"Crumbs\" })\n\tadd({ id = \"DustBall\", size = v(4, 1.6, 3), at = v(between(crand, -50, 50), top + 0.7, plinth.hi.Z + 3.5), shape = \"Ellipsoid\", color = hex(\"9e978c\"), material = \"Fabric\", transparency = 0.25, full = true, group = \"Crumbs\" })\n\treturn list\nend\n\n-- (ROBLOX-107) A chunk of the bushes. Both tiers: the twigs over the stems and branches, each leaf pad as a hanging cluster of leaves with its top at the pad's (the\n-- clusters cast shadows), a skirt of foliage on the litter round each bush, the dead leaf and its twigs, the heaps. Full tier: leaves lying on the pads, the crown\n-- over each bush, privet flowers, damp patches on the litter. Then the litter itself, fallen leaves of the bushes and of the garden, to the budget: kept at the low tier\n-- until its ceiling, then the full tier's (so both tiers are always at their budgets, and the first few the low tier keeps are where the woodlice hide).\nlocal function shrubDecor(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tlocal S = Garden.SHRUB\n\tlocal G = groundOf(region)\n\tlocal top = G.top\n\tlocal list, add = sheet(budget)\n\tlocal pieces = Garden.pieces(region)\n\tlocal rand = rng(region.seed, 139)\n\t-- what stands on the litter, for the litter to go round; and each bush's stems, for its skirt and crown\n\tlocal standing: { Box } = {}\n\tlocal bushes: { [number]: { stems: { Vector3 }, top: number } } = {}\n\tfor _, p in pieces do\n\t\tif p.lo.Y <= top + 0.01 and p.id ~= G.soil then table.insert(standing, { min = p.lo, max = p.hi }) end\n\t\tlocal i = tonumber(string.match(p.id, \"_bush(%d)_\"))\n\t\tif i ~= nil then\n\t\t\tlocal b: { stems: { Vector3 }, top: number } = bushes[i] or { stems = {} :: { Vector3 }, top = top }\n\t\t\tbushes[i] = b\n\t\t\tif string.find(p.id, \"_stem\", 1, true) ~= nil then table.insert(b.stems, (p.lo + p.hi) * 0.5) end\n\t\t\tb.top = math.max(b.top, p.hi.Y)\n\t\tend\n\tend\n\tfor _, b in Garden.standingFrom(region) do table.insert(standing, b) end\n\tlocal function free(x: number, z: number, margin: number): boolean\n\t\tfor _, b in standing do\n\t\t\tif x > b.min.X - margin and x < b.max.X + margin and z > b.min.Z - margin and z < b.max.Z + margin then return false end\n\t\tend\n\t\treturn true\n\tend\n\tfor _, p in pieces do\n\t\tlocal size, c = p.hi - p.lo, (p.lo + p.hi) * 0.5\n\t\tlocal bark = hex(pick(S.bark, rand))\n\t\tif string.find(p.id, \"_stem\", 1, true) ~= nil then\n\t\t\tadd({ id = p.id .. \"Twig\", size = v(size.Y, size.X, size.Z), at = c, turn = v(0, 0, 90), shape = \"Cylinder\", color = bark, material = \"Wood\", group = \"Twigs\" })\n\t\telseif string.find(p.id, \"_branch\", 1, true) ~= nil then\n\t\t\tlocal alongX = size.X >= size.Z\n\t\t\tadd({ id = p.id .. \"Twig\", size = if alongX then v(size.X, size.Y, size.Z) else v(size.Z, size.Y, size.X), at = c, turn = if alongX then nil else v(0, 90, 0), shape = \"Cylinder\",\n\t\t\t\tcolor = bark, material = \"Wood\", group = \"Twigs\" })\n\t\telseif string.find(p.id, \"_pad\", 1, true) ~= nil or string.find(p.id, \"_crown\", 1, true) ~= nil then\n\t\t\tlocal P = size.X\n\t\t\tadd({ id = p.id .. \"Cluster\", size = v(P * 1.5, P * 0.9, P * 1.5), at = v(c.X, p.lo.Y + 0.05 - P * 0.45, c.Z), shape = \"Ellipsoid\", color = hex(pick(S.foliage, rand)),\n\t\t\t\tmaterial = \"LeafyGrass\", shadow = true, group = \"Leaves\" })\n\t\t\tadd({ id = p.id .. \"Mat\", size = v(P * 1.2, size.Y, P * 1.2), at = v(c.X, p.hi.Y - size.Y / 2, c.Z), shape = \"Ellipsoid\", color = hex(pick(S.sunlit, rand)), material = \"LeafyGrass\", group = \"Leaves\" })\n\t\telseif string.find(p.id, \"_deadleaf\", 1, true) ~= nil then\n\t\t\tadd({ id = \"DeadLeaf\", size = v(size.X * 1.08, size.Y * 1.6, size.Z * 1.08), at = v(c.X, p.hi.Y - size.Y * 0.8, c.Z), turn = v(0, 0, 0), shape = \"Ellipsoid\",\n\t\t\t\tcolor = hex(pick(S.deadLeaf, rand)), material = \"Fabric\", group = \"Retreat\" })\n\t\telseif string.find(p.id, \"_twig_\", 1, true) ~= nil then\n\t\t\tlocal d = math.min(size.X, size.Y)\n\t\t\tadd({ id = p.id .. \"Rod\", size = v(size.Z, d, d), at = v(c.X, p.lo.Y + d / 2, c.Z), turn = v(0, 90, 0), shape = \"Cylinder\", color = bark, material = \"Wood\", group = \"Retreat\" })\n\t\t\tadd({ id = p.id .. \"Under\", size = v(size.Z * 0.9, size.Y - d / 2, size.X * 0.6), at = v(c.X, p.lo.Y + d / 2 + (size.Y - d / 2) / 2, c.Z), turn = v(0, 90, 0), shape = \"Ellipsoid\",\n\t\t\t\tcolor = hex(pick(S.deadLeaf, rand)), material = \"Fabric\", group = \"Retreat\" })\n\t\telseif string.find(p.id, \"_heap_\", 1, true) ~= nil then\n\t\t\tadd({ id = p.id .. \"Heap\", size = v(size.X * 1.35, size.Y * 1.9, size.Z * 1.35), at = v(c.X, top, c.Z), shape = \"Ellipsoid\", color = hex(pick(S.litterColors, rand)), material = \"Fabric\", group = \"Litter\" })\n\t\tend\n\tend\n\t-- each bush's skirt of foliage on the litter (two of four at the low tier), its crown over it and its privet flowers (full tier); the first bush's skirt leaves the dead\n\t-- leaf's way in open\n\tlocal brand = rng(region.seed, 149)\n\tfor i = 1, 2 do\n\t\tlocal b = bushes[i]\n\t\tif b ~= nil and #b.stems > 0 then\n\t\t\tlocal mid = Vector3.zero\n\t\t\tfor _, s in b.stems do mid += s end\n\t\t\tmid /= #b.stems\n\t\t\tlocal h = b.top - top\n\t\t\tlocal w = h * 0.9\n\t\t\tlocal angles: { number } = if i == 1 then { -150, -90, -30, 150 } else { brand() * 360, brand() * 360 + 90, brand() * 360 + 180, brand() * 360 + 270 }\n\t\t\tfor k, a in angles do\n\t\t\t\tlocal r = w * between(brand, 0.28, 0.4)\n\t\t\t\tadd({ id = `Bush{i}Skirt{k}`, size = v(w * 0.34, w * 0.2, w * 0.3), at = v(mid.X + math.cos(math.rad(a)) * r, top + w * 0.05, mid.Z + math.sin(math.rad(a)) * r), turn = v(0, -a, 0),\n\t\t\t\t\tshape = \"Ellipsoid\", color = hex(pick(S.foliage, brand)), material = \"LeafyGrass\", shadow = true, full = k > 2, group = \"Leaves\" })\n\t\t\tend\n\t\t\t-- (the previews: twigs and flat pads alone read as a stand of lollipops, not a bush, which is what ROBLOX-103 took away from the view) the bush's\n\t\t\t-- outer mass, three rings of leaf clusters from the litter up round the frame, so from outside it is a dense bush to the ground and from inside (the\n\t\t\t-- camera within a cluster sees out through it) the twigs and pads are the way through. Drawn only; at the low tier the first of the lowest two rings.\n\t\t\t-- None over the drainpipe's foot, past the chunk's edge or the house's wall, or (the first bush) in front of the dead leaf's way in.\n\t\t\tlocal srand = rng(region.seed, 167 + i)\n\t\t\tfor ring, R in S.bush.shell do\n\t\t\t\tfor k = 1, R.n do\n\t\t\t\t\tlocal a = (k - 1) * 360 / R.n + between(srand, -18, 18) + ring * 31\n\t\t\t\t\tlocal rr, size = w * R.r, v(w * R.w, h * R.h, w * R.w)\n\t\t\t\t\tlocal c = v(mid.X + math.cos(math.rad(a)) * rr, top + h * R.y, mid.Z + math.sin(math.rad(a)) * rr)\n\t\t\t\t\tlocal lo, hi = c - size * 0.5, c + size * 0.5\n\t\t\t\t\tlocal s = math.sin(math.rad(a))\n\t\t\t\t\tlocal ok = lo.X >= G.x0 and hi.X <= G.x1 and lo.Z >= G.z0 and hi.Z <= G.z1 - G.landing and not (i == 1 and ring == 1 and s > 0.5)\n\t\t\t\t\tfor _, sb in Garden.standingFrom(region) do\n\t\t\t\t\t\tif lo.X < sb.max.X + 1 and hi.X > sb.min.X - 1 and lo.Z < sb.max.Z + 1 and hi.Z > sb.min.Z - 1 then ok = false end\n\t\t\t\t\tend\n\t\t\t\t\tif ok then\n\t\t\t\t\t\tadd({ id = `Bush{i}Mass{ring}{k}`, size = size, at = c, turn = v(0, -a, 0), shape = \"Ellipsoid\", color = hex(pick(S.foliage, srand)), material = \"LeafyGrass\",\n\t\t\t\t\t\t\tshadow = true, full = not (ring <= 2 and k == 1), group = \"Leaves\" })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tfor k = 1, 3 do\n\t\t\t\tlocal a = k * 120 + brand() * 40\n\t\t\t\tlocal r = w * 0.16\n\t\t\t\tadd({ id = `Bush{i}Crown{k}`, size = v(w * 0.36, w * 0.24, w * 0.36), at = v(mid.X + math.cos(math.rad(a)) * r, b.top + w * 0.1, mid.Z + math.sin(math.rad(a)) * r),\n\t\t\t\t\tshape = \"Ellipsoid\", color = hex(pick(S.sunlit, brand)), material = \"LeafyGrass\", shadow = true, full = true, group = \"Leaves\" })\n\t\t\tend\n\t\t\tfor k = 1, 4 do\n\t\t\t\tlocal a = brand() * 360\n\t\t\t\tlocal r = w * between(brand, 0.25, 0.42)\n\t\t\t\tlocal s = between(brand, 1.6, 2.6)\n\t\t\t\tadd({ id = `Bush{i}Flower{k}`, size = v(s, s * 1.4, s), at = v(mid.X + math.cos(math.rad(a)) * r, top + h * between(brand, 0.65, 0.95), mid.Z + math.sin(math.rad(a)) * r),\n\t\t\t\t\tshape = \"Ellipsoid\", color = hex(pick(S.privet, brand)), material = \"SmoothPlastic\", full = true, group = \"Flowers\" })\n\t\t\tend\n\t\tend\n\tend\n\t-- leaves lying on the pads (full tier)\n\tlocal lrand = rng(region.seed, 151)\n\tfor _, p in pieces do\n\t\tif string.find(p.id, \"_pad\", 1, true) ~= nil or string.find(p.id, \"_crown\", 1, true) ~= nil then\n\t\t\tfor k = 1, 3 do\n\t\t\t\tlocal s = between(lrand, 0.9, 1.4)\n\t\t\t\tadd({ id = `{p.id}Leaf{k}`, size = v(s, 0.04, s * 0.5), at = v(between(lrand, p.lo.X + 0.6, p.hi.X - 0.6), p.hi.Y + 0.02, between(lrand, p.lo.Z + 0.6, p.hi.Z - 0.6)),\n\t\t\t\t\tturn = v(between(lrand, -6, 6), lrand() * 360, 0), shape = \"Ellipsoid\", color = hex(pick(S.foliage, lrand)), material = \"SmoothPlastic\", full = true, group = \"Leaves\" })\n\t\t\tend\n\t\tend\n\tend\n\t-- damp patches on the litter (full tier)\n\tlocal mrand = rng(region.seed, 157)\n\tfor i = 1, 6 do\n\t\tlocal x, z = between(mrand, G.x0 + 3, G.x1 - 3), between(mrand, G.z0 + 3, G.z1 - 3)\n\t\tlocal w = between(mrand, 4, 10)\n\t\tadd({ id = \"Mottle\" .. i, size = v(w, 0.006, w * between(mrand, 0.5, 0.9)), at = v(x, top + 0.003, z), turn = v(0, mrand() * 360, 0), shape = \"Ellipsoid\",\n\t\t\tcolor = hex(pick(S.mottle, mrand)), material = \"Ground\", full = true, group = \"Litter\" })\n\tend\n\t-- the litter, to the budget: the low tier's first, then the full tier's\n\tlocal frand = rng(region.seed, 163)\n\tlocal low = true\n\tlocal i = 0\n\tfor _ = 1, 4000 do\n\t\tlocal x, z = 0.0, 0.0\n\t\tfor _ = 1, 30 do\n\t\t\tx, z = between(frand, G.x0 + 0.6, G.x1 - 0.6), between(frand, G.z0 + 0.6, G.z1 - 0.6)\n\t\t\tif free(x, z, 0.3) then break end\n\t\tend\n\t\tlocal s = between(frand, S.litterSize[1], S.litterSize[2])\n\t\tlocal curl = if frand() < 0.3 then between(frand, 8, 22) else between(frand, 0, 4)\n\t\tlocal rec: Drawn = { id = \"Litter\" .. (i + 1), size = v(s, 0.04, s * between(frand, 0.45, 0.7)), at = v(x, top + 0.03 + math.sin(math.rad(curl)) * s * 0.2, z),\n\t\t\tturn = v(curl, frand() * 360, 0), shape = \"Ellipsoid\", color = hex(pick(S.litterColors, frand)), material = \"SmoothPlastic\", full = not low, group = \"Litter\" }\n\t\tif add(rec) then\n\t\t\ti += 1\n\t\telseif low then\n\t\t\tlow = false\n\t\telse\n\t\t\tbreak\n\t\tend\n\tend\n\treturn list\nend\n\n-- ---------------------------------------------------------------- the questions Region asks\n-- The budgets: the most drawn parts a region of the kind may carry at each tier. They are what the generators place now (tests/world.luau builds the looks and\n-- holds each tier to them exactly, so a look that grows says so here); the placers stop at them (`sheet`), keeping what they place first. ROBLOX-96: the wall's\n-- 93/73 became 110/75 with the descent's dressing. ROBLOX-103 (W3c, more detail): the outer sill 94/36 to 116/39 (fallen petals, seeds, dry leaves, hairline\n-- cracks), the wall 110/75 to 134/75 (drip streaks, weathered joints, moss in the joints), the bed 364/107 to 466/113 (side veins on its seven leaves, seed heads,\n-- six edge clumps, fourteen more pieces of litter and a snail shell), and the new wall_upper 154/59 (the brick to the eaves, the eaves and the gutter, the roof, the\n-- rest of the house drawn round them). All four together are 870 parts at full and 286 at low, beside the sill's Decor (Region's BUDGETS).\nGarden.BUDGETS = {\n\touter_sill = { full = 116, low = 39 },\n\thouse_wall = { full = 127, low = 69 },\n\tbed = { full = 466, low = 113 },\n\twall_upper = { full = 49, low = 28 },\n\teaves = { full = 149, low = 42 }, -- (ROBLOX-114: the back door's glass, panel and handle, 3 more at full)\n\twall_west = { full = 93, low = 59 },\n\twall_west_upper = { full = 73, low = 66 },\n\teaves_west = { full = 46, low = 31 },\n\tshrub = { full = 260, low = 80 },\n\tcounter = { full = 83, low = 19 },\n\tkitchen_floor = { full = 34, low = 10 },\n} :: { [string]: { full: number, low: number } }\n\nlocal piecesCache: { [string]: { Piece } } = {}\nlocal decorCache: { [string]: { Drawn } } = {}\n\n-- Whether a kind is one of the garden's.\nfunction Garden.knows(kind: string): boolean\n\treturn kind == \"outer_sill\" or kind == \"house_wall\" or kind == \"bed\" or kind == \"wall_upper\" or kind == \"eaves\" or kind == \"wall_west\" or kind == \"wall_west_upper\"\n\t\tor kind == \"eaves_west\" or kind == \"shrub\" or kind == \"counter\" or kind == \"kitchen_floor\"\nend\n\n-- The physical boxes of a region of one of the garden's kinds (the same list for the same region; do not change it).\nfunction Garden.pieces(region: WorldMap.Region): { Piece }\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = piecesCache[key]\n\tif cached ~= nil then return cached end\n\tlocal out: { Piece }\n\tif region.kind == \"outer_sill\" then out = outerPieces()\n\telseif region.kind == \"house_wall\" then out = wallPieces()\n\telseif region.kind == \"bed\" then out = bedPieces(region)\n\telseif region.kind == \"wall_upper\" then out = upperPieces()\n\telseif region.kind == \"eaves\" then out = eavesPieces()\n\telseif region.kind == \"wall_west\" then out = westPieces()\n\telseif region.kind == \"wall_west_upper\" then out = westUpperPieces()\n\telseif region.kind == \"eaves_west\" then out = eavesWestPieces()\n\telseif region.kind == \"shrub\" then out = shrubPieces(region)\n\telseif region.kind == \"counter\" then out = counterPieces(region)\n\telseif region.kind == \"kitchen_floor\" then out = kitchenFloorPieces()\n\telse error(\"no generator for the region kind \" .. region.kind) end\n\tpiecesCache[key] = out\n\treturn out\nend\n\n-- The drawn look of a region of one of the garden's kinds, at the full tier (the low tier is the records without `full`).\nfunction Garden.decor(region: WorldMap.Region): { Drawn }\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = decorCache[key]\n\tif cached ~= nil then return cached end\n\tlocal budget = Garden.BUDGETS[region.kind]\n\tlocal out: { Drawn }\n\tif region.kind == \"outer_sill\" then out = outerDecor(region, budget)\n\telseif region.kind == \"house_wall\" then out = wallDecor(region, budget)\n\telseif region.kind == \"bed\" then out = bedDecor(region, budget)\n\telseif region.kind == \"wall_upper\" then out = upperDecor(region, budget)\n\telseif region.kind == \"eaves\" then out = eavesDecor(region, budget)\n\telseif region.kind == \"wall_west\" then out = westDecor(region, budget)\n\telseif region.kind == \"wall_west_upper\" then out = westUpperDecor(region, budget)\n\telseif region.kind == \"eaves_west\" then out = eavesWestDecor(region, budget)\n\telseif region.kind == \"shrub\" then out = shrubDecor(region, budget)\n\telseif region.kind == \"counter\" then out = counterDecor(region, budget)\n\telseif region.kind == \"kitchen_floor\" then out = kitchenFloorDecor(region, budget)\n\telse error(\"no generator for the region kind \" .. region.kind) end\n\tdecorCache[key] = out\n\treturn out\nend\n\n-- The drawn look of a region placed under another budget than its kind's (not kept): what a tighter ceiling leaves out, for the tests.\nfunction Garden.decorWith(region: WorldMap.Region, budget: { full: number, low: number }): { Drawn }\n\tif region.kind == \"outer_sill\" then return outerDecor(region, budget) end\n\tif region.kind == \"house_wall\" then return wallDecor(region, budget) end\n\tif region.kind == \"bed\" then return bedDecor(region, budget) end\n\tif region.kind == \"wall_upper\" then return upperDecor(region, budget) end\n\tif region.kind == \"eaves\" then return eavesDecor(region, budget) end\n\tif region.kind == \"wall_west\" then return westDecor(region, budget) end\n\tif region.kind == \"wall_west_upper\" then return westUpperDecor(region, budget) end\n\tif region.kind == \"eaves_west\" then return eavesWestDecor(region, budget) end\n\tif region.kind == \"shrub\" then return shrubDecor(region, budget) end\n\tif region.kind == \"counter\" then return counterDecor(region, budget) end\n\tif region.kind == \"kitchen_floor\" then return kitchenFloorDecor(region, budget) end\n\terror(\"no generator for the region kind \" .. region.kind)\nend\n\n-- The pieces of a region that its drawn look stands in for: those turn invisible (still solid) once the look is built. The wall's boxes are drawn as bricks and\n-- the plants' as leaves and stems; the slab, the stones and the soil are their own look.\nfunction Garden.drawnPieces(region: WorldMap.Region): { string }\n\tlocal out: { string } = {}\n\tfor _, p in Garden.pieces(region) do\n\t\tlocal walls = region.kind == \"house_wall\" or (region.kind == \"wall_upper\" and p.id ~= Garden.WINDOW_PIECE) or region.kind == \"eaves\" or region.kind == \"wall_west\"\n\t\t\tor region.kind == \"wall_west_upper\" or region.kind == \"eaves_west\" or region.kind == \"counter\" or region.kind == \"kitchen_floor\" -- (ROBLOX-112: the window's box is the sill's to draw)\n\t\tif walls or (region.kind == \"shrub\" and p.id ~= region.id .. \"_soil\") or string.find(p.id, \"_leaf_\", 1, true) ~= nil or string.find(p.id, \"_stem\", 1, true) ~= nil or string.find(p.id, \"_stalk\", 1, true) ~= nil then\n\t\t\ttable.insert(out, p.id)\n\t\tend\n\tend\n\treturn out\nend\n\n-- The pieces of a region that the sill's drawn world stands in for: the window box's halves on the outer sill, drawn with the flowers in them by the sill's Decor\n-- (Habitat/Plants.garden), and solid here; and (ROBLOX-112) the window above the back frame, which the sill's Decor draws with the rest of the window.\nfunction Garden.drawnBySill(region: WorldMap.Region): { string }\n\tlocal out: { string } = {}\n\tif region.kind == \"outer_sill\" then\n\t\tfor _, half in Flora.garden.box.boxes do table.insert(out, half.id) end\n\telseif region.kind == \"wall_upper\" then\n\t\ttable.insert(out, Garden.WINDOW_PIECE) -- (ROBLOX-112: the window above the back frame, drawn with the rest of the window by Habitat/Scenery.window)\n\tend\n\treturn out\nend\n\n-- ---------------------------------------------------------------- the bed's life (ROBLOX-96)\nexport type Perch = { id: string, position: Vector3, normal: Vector3, shelter: number, food: number, start: boolean, walker: boolean?, kind: string,\n\thop: boolean?, behind: string?, round: Vector3? } -- (ROBLOX-101: a hopper's perch; the leafhopper's far side and the point it passes going round)\nexport type Vent = { id: string, position: Vector3, normal: Vector3, walker: boolean?, reach: number?, appear: boolean? }\nexport type PreySpec = { perches: { Perch }, vents: { Vent }, target: number, seed: number, prefix: string }\nexport type HideSpot = { pos: Vector3, kind: string }\n-- (ROBLOX-107) `prefix`, when set, goes before each woodlouse's id: the bushes' chunks are many and two may run at once beside the bed, so theirs carry the chunk\n-- (\"shrub_west_a_louse_1\"); the bed's have none and keep the ids they always had (\"louse_1\"), so a kept rest's woodlice are the same ones.\nexport type BugSpec = { woodlice: { { pos: Vector3, heading: Vector3 } }, hides: { HideSpot }, seed: number, prefix: string? }\n\nlocal preyCache: { [string]: PreySpec } = {}\nlocal bugsCache: { [string]: BugSpec } = {}\n\n-- The standing boxes of the bed (everything on the soil but the soil), and a seeded free spot on the soil clear of them by `margin` (nil after forty tries).\nlocal function standingOf(region: WorldMap.Region): { Box }\n\tlocal G = groundOf(region)\n\tlocal standing: { Box } = {}\n\tfor _, p in Garden.pieces(region) do\n\t\tif p.lo.Y <= G.top + 0.01 and p.id ~= G.soil then table.insert(standing, { min = p.lo, max = p.hi }) end\n\tend\n\tfor _, b in Garden.standingFrom(region) do table.insert(standing, b) end\n\treturn standing\nend\nlocal function freeSpot(rand: () -> number, standing: { Box }, taken: { Vector3 }, margin: number, apart: number, ground: Ground?): Vector3?\n\tlocal B = ground or (Garden.BED :: any)\n\tfor _ = 1, 40 do\n\t\tlocal x, z = between(rand, B.x0 + 2, B.x1 - 2), between(rand, B.z0 + 2, B.z1 - B.landing - 1)\n\t\tlocal ok = true\n\t\tfor _, b in standing do\n\t\t\tif x > b.min.X - margin and x < b.max.X + margin and z > b.min.Z - margin and z < b.max.Z + margin then ok = false; break end\n\t\tend\n\t\tif ok then\n\t\t\tfor _, t in taken do\n\t\t\t\tif (Vector3.new(x, 0, z) - Vector3.new(t.X, 0, t.Z)).Magnitude < apart then ok = false; break end\n\t\t\tend\n\t\tend\n\t\tif ok then\n\t\t\tlocal p = v(x, B.top, z)\n\t\t\ttable.insert(taken, p)\n\t\t\treturn p\n\t\tend\n\tend\n\treturn nil\nend\n\n-- The bed's perches and vents for its prey director, from the region's own boxes and seed: the gnats' on the soil (seeded free spots), on every mound's and\n-- stone's top and under the dock's leaves; the aphids' (walker perches) on the dock's leaves and stem and the dandelion's leaves; the gnats' vents two more spots\n-- on the soil, the aphids' at the plants. Perches sit exactly on a box's face (the director's graph casts for the face and keeps only what it finds).\nfunction Garden.prey(region: WorldMap.Region): PreySpec?\n\tif Hut.knows(region.kind) then return Hut.prey(region :: any) end -- (ROBLOX-116)\n\tif region.kind ~= \"bed\" then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = preyCache[key]\n\tif cached ~= nil then return cached end\n\tlocal B, P = Garden.BED, Garden.BED.prey\n\tlocal pieces = Garden.pieces(region)\n\tlocal byId: { [string]: Piece } = {}\n\tfor _, p in pieces do byId[p.id] = p end\n\tlocal perches: { Perch } = {}\n\tlocal vents: { Vent } = {}\n\tlocal function perch(id: string, pos: Vector3, normal: Vector3, kind: string, start: boolean, walker: boolean?)\n\t\ttable.insert(perches, { id = id, position = pos, normal = normal, shelter = P.shelter[kind], food = P.food[kind], start = start, walker = walker, kind = kind })\n\tend\n\tlocal standing = standingOf(region)\n\tlocal taken: { Vector3 } = {}\n\tlocal rand = rng(region.seed, 61)\n\t-- the soil: seeded free spots about three studs apart at least, the first two the gnats' starts\n\tlocal soilSpots: { Vector3 } = {}\n\tfor i = 1, P.soil do\n\t\tlocal spot = freeSpot(rand, standing, taken, 0.8, 3)\n\t\tif spot then perch(`{region.id}_soil_{i}`, spot, Vector3.yAxis, \"soil\", i <= 2); table.insert(soilSpots, spot) end\n\tend\n\t-- the mounds' and the stones' tops\n\tfor _, p in pieces do\n\t\tif string.find(p.id, \"_mound_\", 1, true) ~= nil then\n\t\t\tperch(p.id .. \"_top\", v((p.lo.X + p.hi.X) / 2, p.hi.Y, (p.lo.Z + p.hi.Z) / 2), Vector3.yAxis, \"mound\", false)\n\t\telseif p.id == \"bed_a_stone_top\" or string.find(p.id, \"_stone_%a$\") ~= nil then\n\t\t\tperch(p.id .. \"_top\", v((p.lo.X + p.hi.X) / 2, p.hi.Y, (p.lo.Z + p.hi.Z) / 2), Vector3.yAxis, \"stone\", false)\n\t\tend\n\tend\n\t-- the dock: under each leaf for the gnats (the first a start), on each leaf and on the stem's side for the aphids (the first leaf and the stem starts)\n\tlocal stem = byId[region.id .. \"_dock_stem\"]\n\tif stem ~= nil then\n\t\tfor i = 1, 3 do\n\t\t\tlocal leaf = byId[`{region.id}_dock_leaf_{i}`]\n\t\t\tif leaf ~= nil then\n\t\t\t\tlocal cx, cz = (leaf.lo.X + leaf.hi.X) / 2, (leaf.lo.Z + leaf.hi.Z) / 2\n\t\t\t\tperch(leaf.id .. \"_under\", v(cx, leaf.lo.Y, cz), -Vector3.yAxis, \"under\", i == 1)\n\t\t\t\tperch(leaf.id .. \"_top\", v(cx, leaf.hi.Y, cz), Vector3.yAxis, \"leaf\", i == 1, true)\n\t\t\tend\n\t\tend\n\t\tperch(stem.id .. \"_side\", v(stem.hi.X, B.top + 3.5, (stem.lo.Z + stem.hi.Z) / 2), Vector3.xAxis, \"stem\", true, true)\n\t\ttable.insert(vents, { id = region.id .. \"_vent_dock\", position = v(stem.hi.X + 1.2, B.top, (stem.lo.Z + stem.hi.Z) / 2), normal = Vector3.yAxis, walker = true, reach = P.reach.dock })\n\tend\n\t-- the dandelion's rosette: walker perches, the first a start\n\tlocal stalk = byId[region.id .. \"_dandelion_stalk\"]\n\tif stalk ~= nil then\n\t\tfor i = 1, 4 do\n\t\t\tlocal leaf = byId[`{region.id}_dandelion_leaf_{i}`]\n\t\t\tif leaf ~= nil then perch(leaf.id .. \"_top\", v((leaf.lo.X + leaf.hi.X) / 2, leaf.hi.Y, (leaf.lo.Z + leaf.hi.Z) / 2), Vector3.yAxis, \"leaf\", i == 1, true) end\n\t\tend\n\t\ttable.insert(vents, { id = region.id .. \"_vent_dandelion\", position = v(stalk.hi.X + 0.3, B.top + 0.25, stalk.hi.Z + 0.3), normal = Vector3.yAxis, walker = true, reach = P.reach.dandelion })\n\tend\n\t-- the gnats' vents: two more spots on the soil within an entry flight of a soil perch, listed first and third so neither kind of entry always comes first\n\tfor i = 1, P.vents do\n\t\tlocal spot: Vector3? = nil\n\t\tfor _ = 1, 12 do\n\t\t\tlocal try = freeSpot(rand, standing, taken, 0.8, 2)\n\t\t\tif try == nil then break end\n\t\t\tfor _, sp in soilSpots do\n\t\t\t\tlocal d = (sp - try).Magnitude\n\t\t\t\tif d >= P.ventNear[1] and d <= P.ventNear[2] then spot = try; break end\n\t\t\tend\n\t\t\tif spot ~= nil then break end\n\t\tend\n\t\tif spot then table.insert(vents, math.min(1 + (i - 1) * 2, #vents + 1), { id = `{region.id}_vent_soil_{i}`, position = spot, normal = Vector3.yAxis }) end\n\tend\n\tlocal out: PreySpec = { perches = perches, vents = vents, target = P.target, seed = region.seed, prefix = region.id .. \"_fly_\" }\n\tpreyCache[key] = out\n\treturn out\nend\n\n-- The bed's woodlice: their starting places on the soil (seeded free spots) and the spots they hide in: the mouth and the back of the gap under the big stone, the\n-- foot of each other stone, and a few of the fallen leaves the low tier keeps.\n-- (ROBLOX-107) Under the bushes: the mouth and the back of the gap under the dead leaf, the drainpipe's foot where its chunk holds it (a damp patch: the first\n-- two lice start there), and the litter the low tier keeps.\nlocal function shrubBugs(region: WorldMap.Region): BugSpec\n\tlocal S, L = Garden.SHRUB, Garden.SHRUB.woodlice\n\tlocal G = groundOf(region)\n\tlocal hides: { HideSpot } = {}\n\tlocal damp = Garden.drainFoot(region)\n\tif damp ~= nil then table.insert(hides, { pos = damp, kind = \"drain\" }) end\n\tfor _, t in region.retreats do\n\t\tlocal cx = (t.min.X + t.max.X) / 2\n\t\ttable.insert(hides, { pos = v(cx, S.top, t.max.Z + 0.6), kind = \"leaf\" })\n\t\ttable.insert(hides, { pos = v(cx, S.top, t.min.Z - 0.6), kind = \"leaf\" })\n\tend\n\tlocal litter = 0\n\tfor _, d in Garden.decor(region) do\n\t\tif litter < L.litterSpots and string.sub(d.id, 1, 6) == \"Litter\" and not d.full then\n\t\t\tlitter += 1\n\t\t\ttable.insert(hides, { pos = v(d.at.X, S.top, d.at.Z), kind = \"litter\" })\n\t\tend\n\tend\n\tlocal standing = standingOf(region)\n\tlocal taken: { Vector3 } = {}\n\tlocal rand = rng(region.seed, 67)\n\tlocal lice: { { pos: Vector3, heading: Vector3 } } = {}\n\tfor i = 1, L.count do\n\t\tlocal spot: Vector3? = nil\n\t\tif damp ~= nil and i <= 2 then\n\t\t\tlocal a, d = rand() * TAU, between(rand, 0.8, 2.5)\n\t\t\tspot = v(damp.X + math.cos(a) * d, S.top, damp.Z - math.abs(math.sin(a)) * d)\n\t\t\ttable.insert(taken, spot :: Vector3)\n\t\telse\n\t\t\tspot = freeSpot(rand, standing, taken, 1.0, 5, G)\n\t\tend\n\t\tif spot then\n\t\t\tlocal a = rand() * TAU\n\t\t\ttable.insert(lice, { pos = spot, heading = v(math.cos(a), 0, math.sin(a)) })\n\t\tend\n\tend\n\treturn { woodlice = lice, hides = hides, seed = region.seed, prefix = region.id .. \"_\" }\nend\n\nfunction Garden.bugs(region: WorldMap.Region): BugSpec?\n\tif Hut.knows(region.kind) then return Hut.bugs(region :: any) end -- (ROBLOX-116)\n\tif region.kind ~= \"bed\" and region.kind ~= \"shrub\" then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = bugsCache[key]\n\tif cached ~= nil then return cached end\n\tif region.kind == \"shrub\" then\n\t\tlocal spec = shrubBugs(region)\n\t\tbugsCache[key] = spec\n\t\treturn spec\n\tend\n\tlocal B, L = Garden.BED, Garden.BED.woodlice\n\tlocal hides: { HideSpot } = {}\n\tfor _, t in region.retreats do\n\t\tlocal cx = (t.min.X + t.max.X) / 2\n\t\ttable.insert(hides, { pos = v(cx, B.top, t.max.Z + 0.6), kind = \"stone\" })\n\t\ttable.insert(hides, { pos = v(cx, B.top, t.min.Z - 0.6), kind = \"stone\" })\n\tend\n\tfor _, p in Garden.pieces(region) do\n\t\tif string.find(p.id, \"_stone_%a$\") ~= nil then table.insert(hides, { pos = v((p.lo.X + p.hi.X) / 2, B.top, p.lo.Z - 0.4), kind = \"stone\" }) end\n\tend\n\tlocal litter = 0\n\tfor _, d in Garden.decor(region) do\n\t\tif litter < L.litterSpots and string.sub(d.id, 1, 6) == \"Litter\" and not d.full then\n\t\t\tlitter += 1\n\t\t\ttable.insert(hides, { pos = v(d.at.X, B.top, d.at.Z), kind = \"litter\" })\n\t\tend\n\tend\n\tlocal standing = standingOf(region)\n\tlocal taken: { Vector3 } = {}\n\tlocal rand = rng(region.seed, 67)\n\tlocal lice: { { pos: Vector3, heading: Vector3 } } = {}\n\tfor _ = 1, L.count do\n\t\tlocal spot = freeSpot(rand, standing, taken, 1.0, 5)\n\t\tif spot then\n\t\t\tlocal a = rand() * TAU\n\t\t\ttable.insert(lice, { pos = spot, heading = v(math.cos(a), 0, math.sin(a)) })\n\t\tend\n\tend\n\tlocal out: BugSpec = { woodlice = lice, hides = hides, seed = region.seed }\n\tbugsCache[key] = out\n\treturn out\nend\n\n-- ---------------------------------------------------------------- the bestiary's prey (ROBLOX-101)\n-- How many of each kind a region holds at the full tier and the low one (the phone is the limit: the bed's prey stays at 12 at full with W3's six, 9 at low), the\n-- streams' salts, and the perches' shelter and food (game values: the plants are the leafhoppers' food, the stones the springtails' cover, the wall a place to\n-- sit still). `dusk`: the hours of the life clock from which (dusk) and until which (dawn) the moths and the crane flies fly (World/LifeClock: dusk at 19, the\n-- evening from 18, dawn at 6).\nGarden.BESTIARY = {\n\tbed = {\n\t\t{ kind = \"springtail\", full = 4, low = 2, salt = 71, perches = 12, near = { 0.7, 2.2 }, apart = 1.0, reach = 6, shelter = 0.5, food = 0.4 },\n\t\t{ kind = \"leafhopper\", full = 2, low = 1, salt = 73, reach = 14, shelter = 0.4, food = 0.6 },\n\t} :: { any },\n\t-- (ROBLOX-107) springtails in the litter under the bushes, round the dead leaf, the drain's foot and the litter the woodlice hide in\n\tshrub = {\n\t\t{ kind = \"springtail\", full = 4, low = 2, salt = 71, perches = 12, near = { 0.7, 2.2 }, apart = 1.0, reach = 6, shelter = 0.5, food = 0.4 },\n\t} :: { any },\n\thouse_wall = {\n\t\t{ kind = \"moth\", full = 2, low = 1, salt = 79, perches = 8, x = { -30, 30 }, y = { -45, -6 }, apart = 5, reach = 30, shelter = 0.2, food = 0.1 },\n\t\t{ kind = \"crane_fly\", full = 1, low = 1, salt = 83, perches = 6, x = { -20, 20 }, y = { -86, -40 }, apart = 6, reach = 45, shelter = 0.2, food = 0.1 },\n\t} :: { any },\n\touter_sill = {\n\t\t{ kind = \"moth\", full = 1, low = 1, salt = 89, reach = 40, shelter = 0.3, food = 0.1 },\n\t\t{ kind = \"crane_fly\", full = 1, low = 0, salt = 97, reach = 40, shelter = 0.3, food = 0.1 },\n\t} :: { any },\n\tdusk = { from = 18.0, to = 6.0 },\n} :: any\n\nexport type KindSpec = PreySpec & { kind: string, profile: string, low: number, dusk: { from: number, to: number }? }\nlocal bestiaryCache: { [string]: { KindSpec } } = {}\n\n-- The springtails' spots: free soil within `near` of each hide spot the woodlice use (the big stone's mouth and back, the other stones' feet, the litter), clear\n-- of every standing box and of the retreat, `apart` from each other.\nlocal function springtailPerches(region: WorldMap.Region, row: any, rand: () -> number): { Perch }\n\tlocal B = groundOf(region)\n\tlocal standing = standingOf(region)\n\tfor _, t in region.retreats do table.insert(standing, { min = t.min - v(0.5, 0, 0.5), max = t.max + v(0.5, 0, 0.5) }) end\n\tlocal hides = (Garden.bugs(region) :: BugSpec).hides\n\tlocal out: { Perch } = {}\n\tlocal taken: { Vector3 } = {}\n\tlocal i = 0\n\tfor _ = 1, 3 do\n\t\tfor _, h in hides do\n\t\t\tif #out >= row.perches then break end\n\t\t\tfor _ = 1, 12 do\n\t\t\t\tlocal a, d = rand() * TAU, between(rand, row.near[1], row.near[2])\n\t\t\t\tlocal x, z = h.pos.X + math.cos(a) * d, h.pos.Z + math.sin(a) * d\n\t\t\t\tlocal ok = x > B.x0 + 1 and x < B.x1 - 1 and z > B.z0 + 1 and z < B.z1 - 1\n\t\t\t\tif ok then\n\t\t\t\t\tfor _, b in standing do\n\t\t\t\t\t\tif x > b.min.X - 0.3 and x < b.max.X + 0.3 and z > b.min.Z - 0.3 and z < b.max.Z + 0.3 then ok = false; break end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif ok then\n\t\t\t\t\tfor _, t in taken do\n\t\t\t\t\t\tif (Vector3.new(x, 0, z) - Vector3.new(t.X, 0, t.Z)).Magnitude < row.apart then ok = false; break end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif ok then\n\t\t\t\t\ti += 1\n\t\t\t\t\tlocal p = v(x, B.top, z)\n\t\t\t\t\ttable.insert(taken, p)\n\t\t\t\t\ttable.insert(out, { id = `{region.id}_springtail_{i}`, position = p, normal = Vector3.yAxis, shelter = row.shelter, food = row.food, start = i <= row.full, kind = \"soil\", hop = true })\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif #out >= row.perches then break end\n\tend\n\treturn out\nend\n\n-- The leafhoppers' perches, in pairs either side of a stem, a stalk or a leaf (each the other's `behind`, with the point to pass going round): the dock's stem low\n-- (east and west) and high (north and south), the dandelion's stalk (east and west), and each dock leaf's top and underside two thirds of the way to its tip.\nlocal function leafhopperPerches(region: WorldMap.Region, row: any): { Perch }\n\tlocal B = Garden.BED\n\tlocal byId: { [string]: Piece } = {}\n\tfor _, p in Garden.pieces(region) do byId[p.id] = p end\n\tlocal out: { Perch } = {}\n\tlocal n = 0\n\tlocal function pair(a: Vector3, na: Vector3, b: Vector3, nb: Vector3, round: Vector3, kind: string, start: boolean)\n\t\tn += 1\n\t\tlocal ia, ib = `{region.id}_leafhopper_{n}a`, `{region.id}_leafhopper_{n}b`\n\t\ttable.insert(out, { id = ia, position = a, normal = na, shelter = row.shelter, food = row.food, start = start, kind = kind, hop = true, behind = ib, round = round })\n\t\ttable.insert(out, { id = ib, position = b, normal = nb, shelter = row.shelter, food = row.food, start = false, kind = kind, hop = true, behind = ia, round = round })\n\tend\n\tlocal stem = byId[region.id .. \"_dock_stem\"]\n\tif stem ~= nil then\n\t\tlocal mx, mz = (stem.lo.X + stem.hi.X) / 2, (stem.lo.Z + stem.hi.Z) / 2\n\t\tlocal y1, y2 = B.top + 1.5, B.top + 9\n\t\tpair(v(stem.hi.X, y1, mz), Vector3.xAxis, v(stem.lo.X, y1, mz), -Vector3.xAxis, v(mx, y1, stem.hi.Z + 0.35), \"stem\", true)\n\t\tpair(v(mx, y2, stem.hi.Z), Vector3.zAxis, v(mx, y2, stem.lo.Z), -Vector3.zAxis, v(stem.hi.X + 0.35, y2, mz), \"stem\", false)\n\tend\n\tlocal stalk = byId[region.id .. \"_dandelion_stalk\"]\n\tif stalk ~= nil then\n\t\tlocal mx, mz = (stalk.lo.X + stalk.hi.X) / 2, (stalk.lo.Z + stalk.hi.Z) / 2\n\t\tlocal y = B.top + 5\n\t\tpair(v(stalk.hi.X, y, mz), Vector3.xAxis, v(stalk.lo.X, y, mz), -Vector3.xAxis, v(mx, y, stalk.hi.Z + 0.3), \"stem\", false)\n\tend\n\tfor i, leaf in B.dock.leaves do\n\t\tlocal box = byId[`{region.id}_dock_leaf_{i}`]\n\t\tif box ~= nil then\n\t\t\tlocal cx, cz = (box.lo.X + box.hi.X) / 2, (box.lo.Z + box.hi.Z) / 2\n\t\t\tlocal my = (box.lo.Y + box.hi.Y) / 2\n\t\t\tlocal x, z, rx, rz = cx, cz, cx, cz\n\t\t\tif leaf.dir == \"x+\" then x = box.lo.X + (box.hi.X - box.lo.X) * 2 / 3; rx = box.hi.X + 0.35\n\t\t\telseif leaf.dir == \"x-\" then x = box.hi.X - (box.hi.X - box.lo.X) * 2 / 3; rx = box.lo.X - 0.35\n\t\t\telseif leaf.dir == \"z+\" then z = box.lo.Z + (box.hi.Z - box.lo.Z) * 2 / 3; rz = box.hi.Z + 0.35\n\t\t\telse z = box.hi.Z - (box.hi.Z - box.lo.Z) * 2 / 3; rz = box.lo.Z - 0.35 end\n\t\t\tif leaf.dir == \"x+\" or leaf.dir == \"x-\" then rz = z else rx = x end\n\t\t\tpair(v(x, box.hi.Y, z), Vector3.yAxis, v(x, box.lo.Y, z), -Vector3.yAxis, v(rx, my, rz), \"leaf\", i == 2)\n\t\tend\n\tend\n\treturn out\nend\n\n-- Seeded spots on the house wall's face (z -24, facing the garden), `apart` from each other, inside `x` and between the heights `y`.\nlocal function wallPerches(region: WorldMap.Region, row: any, rand: () -> number): { Perch }\n\tlocal W = Garden.WALL\n\tlocal out: { Perch } = {}\n\tlocal taken: { Vector3 } = {}\n\tfor i = 1, row.perches do\n\t\tfor _ = 1, 40 do\n\t\t\tlocal p = v(between(rand, row.x[1], row.x[2]), between(rand, row.y[1], row.y[2]), W.face)\n\t\t\tlocal ok = true\n\t\t\tfor _, t in taken do if (t - p).Magnitude < row.apart then ok = false; break end end\n\t\t\tif ok then\n\t\t\t\ttable.insert(taken, p)\n\t\t\t\ttable.insert(out, { id = `{region.id}_{row.kind}_{i}`, position = p, normal = -Vector3.zAxis, shelter = row.shelter, food = row.food, start = i <= row.full, kind = \"wall\" })\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\tend\n\treturn out\nend\n\n-- The outer sill's: the moths by the window (the slab's ends against the frame, the window box's fronts, the slab's front edge either side of the way down), the\n-- crane flies out at the slab's front corners and on the box's fronts beside them.\nlocal function outerPerches(region: WorldMap.Region, row: any): { Perch }\n\tlocal O, Bx = Garden.OUTER, Flora.garden.box\n\tlocal top, front = O.slab.hi.Y, O.slab.lo.Z\n\tlocal boxFront, boxMid = Bx.z0, (Bx.top + Bx.bottom) / 2\n\tlocal spots: { { Vector3 | string } }\n\tif row.kind == \"moth\" then\n\t\tspots = {\n\t\t\t{ v(-27.5, top, -15.0), \"slab\" }, { v(27.5, top, -15.0), \"slab\" },\n\t\t\t{ v(-17.0, boxMid, boxFront), \"box\" }, { v(17.0, boxMid, boxFront), \"box\" },\n\t\t\t{ v(-4.0, -1.5, front), \"edge\" }, { v(4.0, -1.5, front), \"edge\" },\n\t\t}\n\telse\n\t\tspots = {\n\t\t\t{ v(-27.0, top, -22.0), \"slab\" }, { v(-20.0, boxMid, boxFront), \"box\" },\n\t\t\t{ v(27.0, top, -22.0), \"slab\" }, { v(20.0, boxMid, boxFront), \"box\" },\n\t\t}\n\tend\n\tlocal out: { Perch } = {}\n\tfor i, s in spots do\n\t\tlocal pos, kind = s[1] :: Vector3, s[2] :: string\n\t\ttable.insert(out, { id = `{region.id}_{row.kind}_{i}`, position = pos, normal = if kind == \"slab\" then Vector3.yAxis else -Vector3.zAxis, shelter = row.shelter,\n\t\t\tfood = row.food, start = i <= math.max(row.full, 1), kind = kind })\n\tend\n\treturn out\nend\n\n-- The region's bestiary prey: one spec per kind, in the order the directors run (nil for none). Each spec is a Prey/PreyDirector spec with its kind, the profile\n-- it is made with (Data/Species, by name), the targets at the full and the low tier, its own seed (the region's mixed with the kind's salt) and its flies' prefix\n-- (`bed_a_springtail_`...), and for the moths and the crane flies the hours they fly. Every vent is an `appear` vent: the prey comes on a free perch in reach,\n-- out of sight.\nfunction Garden.bestiary(region: WorldMap.Region): { KindSpec }?\n\tif region.id==Pocket.REGION then return Pocket.bestiary() end\n\tif region.kind == \"verge\" or region.kind == \"hut_path\" or region.kind == \"mown_path\" then return Verge.bestiary(region) end\n\tif Hut.knows(region.kind) then return Hut.bestiary(region :: any) :: any end -- (ROBLOX-116)\n\tif Meadow.knows(region.kind) then return Meadow.bestiary(region :: any) :: any end -- (ROBLOX-119)\n\tif Pond.knows(region.kind) then return Pond.bestiary(region :: any) :: any end -- (ROBLOX-122)\n\tlocal rows = (Garden.BESTIARY :: any)[region.kind]\n\tif rows == nil then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = bestiaryCache[key]\n\tif cached ~= nil then return cached end\n\tlocal out: { KindSpec } = {}\n\tfor _, row in rows do\n\t\tlocal rand = rng(region.seed, row.salt)\n\t\tlocal perches: { Perch }\n\t\tlocal vents: { Vent } = {}\n\t\tif row.kind == \"springtail\" then\n\t\t\tperches = springtailPerches(region, row, rand)\n\t\t\tlocal hides = (Garden.bugs(region) :: BugSpec).hides\n\t\t\tfor i = 1, math.min(2, #hides) do\n\t\t\t\ttable.insert(vents, { id = `{region.id}_vent_springtail_{i}`, position = hides[i * 2 - 1].pos, normal = Vector3.yAxis, appear = true, reach = row.reach })\n\t\t\tend\n\t\telseif row.kind == \"leafhopper\" then\n\t\t\tperches = leafhopperPerches(region, row)\n\t\t\tfor _, p in Garden.pieces(region) do\n\t\t\t\tif p.id == region.id .. \"_dock_stem\" or p.id == region.id .. \"_dandelion_stalk\" then\n\t\t\t\t\ttable.insert(vents, { id = `{p.id}_vent_leafhopper`, position = v((p.lo.X + p.hi.X) / 2, Garden.BED.top, p.lo.Z - 0.6), normal = Vector3.yAxis, appear = true, reach = row.reach })\n\t\t\t\tend\n\t\t\tend\n\t\telseif region.kind == \"house_wall\" then\n\t\t\tperches = wallPerches(region, row, rand)\n\t\t\tlocal y = (row.y[1] + row.y[2]) / 2\n\t\t\tfor i, x in { -20, 20 } do\n\t\t\t\ttable.insert(vents, { id = `{region.id}_vent_{row.kind}_{i}`, position = v(x, y, Garden.WALL.face - 2), normal = -Vector3.zAxis, appear = true, reach = row.reach })\n\t\t\tend\n\t\telse\n\t\t\tperches = outerPerches(region, row)\n\t\t\ttable.insert(vents, { id = `{region.id}_vent_{row.kind}`, position = v(0, 1, -20), normal = Vector3.yAxis, appear = true, reach = row.reach })\n\t\tend\n\t\tlocal seed = (region.seed + row.salt * 104729) % MOD\n\t\ttable.insert(out, {\n\t\t\tkind = row.kind, profile = row.kind .. \"_prototype\", perches = perches, vents = vents, target = row.full, low = row.low, seed = seed,\n\t\t\tprefix = `{region.id}_{row.kind}_fly_`, dusk = if row.kind == \"moth\" or row.kind == \"crane_fly\" then Garden.BESTIARY.dusk else nil,\n\t\t})\n\tend\n\tbestiaryCache[key] = out\n\treturn out\nend\n\n-- ---------------------------------------------------------------- the plants as paths (ROBLOX-105, W3b part B)\n-- Each of the bed's plants as a set of walks over its own faces, for the things that walk a plant: an aphid going from one of its perches to another (Prey/PreyKinds\n-- `creep`) and a ladybird (Prey/Ladybird). A plant has a `highway` (points on its faces, each { pos, normal }: the dock's stem's bare north face from its foot to\n-- its top, which no leaf meets; the dandelion's ring of soil round its stalk, a `loop`) and `nodes`, each a `hub` (the highway point it leaves from) and a `route`\n-- from there over the faces to the node, every point on a face or on the edge where two meet (its normal between theirs). A node named by a perch id stands\n-- exactly on that perch (the aphids' walker perches); the others are places only the ladybird goes (the dock's top and foot, the dandelion's stalk).\nexport type PlantPoint = { pos: Vector3, normal: Vector3 }\nexport type Plant = { id: string, loop: boolean, highway: { PlantPoint }, nodes: { [string]: { hub: number, route: { PlantPoint } } }, order: { string } }\nlocal plantsCache: { [string]: { [string]: Plant } } = {}\nlocal plantOfPerch: { [string]: string } = {} -- perch id -> plant id, filled as plants are made\n\nlocal function unit(a: Vector3, b: Vector3): Vector3\n\treturn (a + b).Unit\nend\n\nfunction Garden.plants(region: WorldMap.Region): { [string]: Plant }?\n\tif Hut.knows(region.kind) then return Hut.plants(region :: any) :: any end -- (ROBLOX-116)\n\tif region.kind ~= \"bed\" then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = plantsCache[key]\n\tif cached ~= nil then return cached end\n\tlocal B = Garden.BED\n\tlocal byId: { [string]: Piece } = {}\n\tfor _, p in Garden.pieces(region) do byId[p.id] = p end\n\tlocal out: { [string]: Plant } = {}\n\tlocal X, Y, Z = Vector3.xAxis, Vector3.yAxis, Vector3.zAxis\n\tlocal function pt(pos: Vector3, normal: Vector3): PlantPoint return { pos = pos, normal = normal } end\n\t-- the dock: the stem's north face (z lo) is the highway, its points at the heights the nodes leave it\n\tlocal stem = byId[region.id .. \"_dock_stem\"]\n\tif stem ~= nil then\n\t\tlocal s0, s1 = stem.lo, stem.hi\n\t\tlocal mx, mz = (s0.X + s1.X) / 2, (s0.Z + s1.Z) / 2\n\t\tlocal heights: { number } = {}\n\t\tlocal nodes: { [string]: { hub: number, route: { PlantPoint } } } = {}\n\t\tlocal order: { string } = {}\n\t\tlocal pending: { { id: string, y: number, route: { PlantPoint } } } = {}\n\t\tlocal function add(id: string, y: number, route: { PlantPoint })\n\t\t\ttable.insert(pending, { id = id, y = y, route = route })\n\t\t\tif table.find(heights, y) == nil then table.insert(heights, y) end\n\t\tend\n\t\tadd(region.id .. \"_dock_foot\", B.top + 0.5, {})\n\t\tadd(region.id .. \"_dock_stem_side\", B.top + 3.5, { pt(v(s1.X, B.top + 3.5, s0.Z), unit(X, -Z)), pt(v(s1.X, B.top + 3.5, mz), X) })\n\t\tfor i, leaf in B.dock.leaves do\n\t\t\tlocal box = byId[`{region.id}_dock_leaf_{i}`]\n\t\t\tif box ~= nil then\n\t\t\t\tlocal y1 = box.hi.Y\n\t\t\t\tlocal centre = pt(v((box.lo.X + box.hi.X) / 2, y1, (box.lo.Z + box.hi.Z) / 2), Y)\n\t\t\t\tlocal route: { PlantPoint }\n\t\t\t\tif leaf.dir == \"x+\" then\n\t\t\t\t\troute = { pt(v(s1.X, y1, s0.Z), unit(X, -Z)), pt(v(s1.X, y1, mz), unit(X, Y)), centre }\n\t\t\t\telseif leaf.dir == \"x-\" then\n\t\t\t\t\troute = { pt(v(s0.X, y1, s0.Z), unit(-X, -Z)), pt(v(s0.X, y1, mz), unit(-X, Y)), centre }\n\t\t\t\telseif leaf.dir == \"z+\" then\n\t\t\t\t\troute = { pt(v(s0.X, y1, s0.Z), unit(-X, -Z)), pt(v(s0.X, y1, s1.Z), unit(-X, Z)), pt(v(mx, y1, s1.Z), unit(Z, Y)), centre }\n\t\t\t\telse\n\t\t\t\t\troute = { pt(v(mx, y1, s0.Z), unit(-Z, Y)), centre }\n\t\t\t\tend\n\t\t\t\tadd(box.id .. \"_top\", y1, route)\n\t\t\tend\n\t\tend\n\t\tadd(region.id .. \"_dock_top\", s1.Y - 0.6, {})\n\t\ttable.sort(heights)\n\t\tlocal highway: { PlantPoint } = {}\n\t\tfor _, y in heights do table.insert(highway, pt(v(mx, y, s0.Z), -Z)) end\n\t\tfor _, n in pending do\n\t\t\tnodes[n.id] = { hub = table.find(heights, n.y) :: number, route = n.route }\n\t\t\ttable.insert(order, n.id)\n\t\t\tplantOfPerch[n.id] = \"dock\"\n\t\tend\n\t\tout.dock = { id = \"dock\", loop = false, highway = highway, nodes = nodes, order = order }\n\tend\n\t-- the dandelion: a ring of eight points on the soil round the stalk; each rosette leaf leaves from the ring point toward it, up its inner end and out to its\n\t-- middle; the stalk is climbed from the east point\n\tlocal stalk = byId[region.id .. \"_dandelion_stalk\"]\n\tif stalk ~= nil then\n\t\tlocal cx, cz = (stalk.lo.X + stalk.hi.X) / 2, (stalk.lo.Z + stalk.hi.Z) / 2\n\t\tlocal half = (stalk.hi.X - stalk.lo.X) / 2\n\t\tlocal L = B.dandelion\n\t\tlocal ring = half + 0.35\n\t\tlocal inner = half + L.leaf.gap\n\t\tlocal highway: { PlantPoint } = {}\n\t\tfor k = 0, 7 do\n\t\t\tlocal a = k * math.pi / 4\n\t\t\ttable.insert(highway, pt(v(cx + math.cos(a) * ring, B.top, cz + math.sin(a) * ring), Y))\n\t\tend\n\t\tlocal nodes: { [string]: { hub: number, route: { PlantPoint } } } = {}\n\t\tlocal order: { string } = {}\n\t\tlocal dirs = { X, Z, -X, -Z } -- the rosette's leaves 1..4 (Garden's bedPieces), on the ring's points 1, 3, 5, 7\n\t\tfor i, d in dirs do\n\t\t\tlocal box = byId[`{region.id}_dandelion_leaf_{i}`]\n\t\t\tif box ~= nil then\n\t\t\t\tlocal y1 = box.hi.Y\n\t\t\t\tlocal foot = v(cx, B.top, cz) + d * inner\n\t\t\t\tlocal id = box.id .. \"_top\"\n\t\t\t\tnodes[id] = { hub = 2 * i - 1, route = {\n\t\t\t\t\tpt(foot, unit(Y, -d)), pt(foot + Y * (y1 - B.top), unit(Y, -d)),\n\t\t\t\t\tpt(v((box.lo.X + box.hi.X) / 2, y1, (box.lo.Z + box.hi.Z) / 2), Y),\n\t\t\t\t} }\n\t\t\t\ttable.insert(order, id)\n\t\t\t\tplantOfPerch[id] = \"dandelion\"\n\t\t\tend\n\t\tend\n\t\tlocal up = region.id .. \"_dandelion_stalk_up\"\n\t\tnodes[up] = { hub = 1, route = { pt(v(stalk.hi.X, B.top, cz), unit(X, Y)), pt(v(stalk.hi.X, B.top + L.height * 0.75, cz), X) } }\n\t\ttable.insert(order, up)\n\t\tout.dandelion = { id = \"dandelion\", loop = true, highway = highway, nodes = nodes, order = order }\n\tend\n\tplantsCache[key] = out\n\treturn out\nend\n\n-- The plant a perch is on (\"dock\", \"dandelion\") and the bed's plants, or nil for a perch on no plant. Every bed of the map is made the first time it is asked.\nfunction Garden.plantOf(perchId: string): (string?, { [string]: Plant }?)\n\tif WorldMap.world() ~= \"test_garden\" then -- (ROBLOX-116: the preserve's plants are World/Hut's)\n\t\tlocal name, plants = Hut.plantOf(perchId, WorldMap.regions() :: any)\n\t\treturn name, plants :: any\n\tend\n\tlocal name = plantOfPerch[perchId]\n\tif name == nil then\n\t\tfor _, r in WorldMap.regions() do if r.kind == \"bed\" then Garden.plants(r) end end\n\t\tname = plantOfPerch[perchId]\n\tend\n\tif name == nil then return nil, nil end\n\tfor _, r in WorldMap.regions() do\n\t\tif r.kind == \"bed\" then\n\t\t\tlocal plants = Garden.plants(r) :: { [string]: Plant }\n\t\t\tlocal plant = plants[name]\n\t\t\tif plant ~= nil and plant.nodes[perchId] ~= nil then return name, plants end\n\t\tend\n\tend\n\treturn nil, nil\nend\n\n-- The walk over a plant from one node to another: a list of points, the first on the node left, the last on the node reached (nil when either is not the\n-- plant's). Down the first node's route to the highway, along it (the shorter way round a loop), out along the second's route.\nfunction Garden.plantPath(plant: Plant, from: string, to: string): { PlantPoint }?\n\tlocal a, b = plant.nodes[from], plant.nodes[to]\n\tif a == nil or b == nil then return nil end\n\tlocal out: { PlantPoint } = {}\n\tfor i = #a.route, 1, -1 do table.insert(out, a.route[i]) end\n\tlocal n = #plant.highway\n\ttable.insert(out, plant.highway[a.hub])\n\tif a.hub ~= b.hub then\n\t\tlocal step = if b.hub > a.hub then 1 else -1\n\t\tlocal count = math.abs(b.hub - a.hub)\n\t\tif plant.loop and count > n / 2 then step, count = -step, n - count end\n\t\tlocal k = a.hub\n\t\tfor _ = 1, count do\n\t\t\tk = ((k - 1 + step) % n) + 1\n\t\t\ttable.insert(out, plant.highway[k])\n\t\tend\n\tend\n\tfor _, p in b.route do table.insert(out, p) end\n\t-- the node's own point first and last (a node whose route is empty is its hub)\n\tlocal first = if #a.route > 0 then a.route[#a.route] else plant.highway[a.hub]\n\tif out[1] ~= first then table.insert(out, 1, first) end\n\treturn out\nend\n\n-- ---------------------------------------------------------------- the ambient bugs (ROBLOX-105, W3b part B)\n-- The garden's other life that is not food (docs/GARDEN_BESTIARY.md's ambient table): how many of each kind a region holds at the full tier and the low one,\n-- the streams' salts, and the parts the region's ambient bodies may cost at each tier (Client/BugBodies.partsOf; tests/garden_life.luau holds the sum under it).\n-- The ladybirds walk the bed's plants among the aphids (one on the dock, one on the dandelion), the millipedes the soil and under the stones, the snail the\n-- soil and the wall's foot, a harvestman the bed's litter and one the house wall, from dusk.\nGarden.AMBIENT = {\n\torder = { \"ladybird\", \"millipede\", \"snail\", \"harvestman\" },\n\tbed = {\n\t\tladybird = { full = 2, low = 1, salt = 101 },\n\t\tmillipede = { full = 2, low = 1, salt = 103 },\n\t\tsnail = { full = 1, low = 1, salt = 107 },\n\t\tharvestman = { full = 1, low = 1, salt = 109 },\n\t},\n\thouse_wall = {\n\t\tharvestman = { full = 1, low = 1, salt = 113 },\n\t},\n\tbudget = { bed = { full = 240, low = 110 }, house_wall = { full = 24, low = 24 } },\n\t-- the snail's piece of wall: the brick's foot over the bed (x, and y above the soil); the wall harvestman's walk on the brick and its corner by day\n\twallFoot = { x = { -20, 20 }, y = { 1.5, 14 } },\n\twall = { x = { -36, 36 }, y = { -84, -8 }, home = { -34, -82 } },\n} :: any\n\nexport type AmbientSpec = { kind: string, seed: number, full: number, low: number, starts: { any }, prefix: string, hides: { HideSpot }?, home: Vector3?, surface: string?,\n\trect: { x: { number }, y: { number } }? }\nlocal ambientCache: { [string]: { AmbientSpec } } = {}\n\n-- The region's ambient bugs: one spec per kind, in AMBIENT.order (nil for a region with none). Each has its own seed (the region's mixed with the kind's salt) and\n-- its starting places for the full tier's count (the low tier takes the first `low`).\nfunction Garden.ambient(region: WorldMap.Region): { AmbientSpec }?\n\tif Hut.knows(region.kind) then return Hut.ambient(region :: any) :: any end -- (ROBLOX-116)\n\tif Meadow.knows(region.kind) then return Meadow.ambient(region :: any) :: any end -- (ROBLOX-119: the ants at their hill)\n\tif Pond.knows(region.kind) then return Pond.ambient(region :: any) :: any end -- (ROBLOX-122: the water striders)\n\tlocal rows = (Garden.AMBIENT :: any)[region.kind]\n\tif rows == nil or region.kind == \"order\" or region.kind == \"budget\" then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = ambientCache[key]\n\tif cached ~= nil then return cached end\n\tlocal A = Garden.AMBIENT\n\tlocal out: { AmbientSpec } = {}\n\tfor _, kind in A.order do\n\t\tlocal row = rows[kind]\n\t\tif row ~= nil then\n\t\t\tlocal rand = rng(region.seed, row.salt)\n\t\t\tlocal seed = (region.seed + row.salt * 104729) % MOD\n\t\t\tlocal spec: AmbientSpec = { kind = kind, seed = seed, full = row.full, low = row.low, starts = {}, prefix = region.id .. \"_\" } -- (ids: bed_a_ladybird_1 ...)\n\t\t\tif region.kind == \"bed\" then\n\t\t\t\tlocal standing = standingOf(region)\n\t\t\t\tfor _, t in region.retreats do table.insert(standing, { min = t.min - v(0.5, 0, 0.5), max = t.max + v(0.5, 0, 0.5) }) end\n\t\t\t\tlocal hides = (Garden.bugs(region) :: BugSpec).hides\n\t\t\t\tlocal taken: { Vector3 } = {}\n\t\t\t\tif kind == \"ladybird\" then\n\t\t\t\t\tlocal plants = Garden.plants(region) :: { [string]: Plant }\n\t\t\t\t\tlocal names = { \"dock\", \"dandelion\" }\n\t\t\t\t\tfor i = 1, row.full do\n\t\t\t\t\t\tlocal plant = plants[names[(i - 1) % #names + 1]]\n\t\t\t\t\t\tif plant ~= nil then\n\t\t\t\t\t\t\tlocal node = plant.order[1 + math.floor(rand() * #plant.order)]\n\t\t\t\t\t\t\ttable.insert(spec.starts, { plant = plant.id, node = node })\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\telse\n\t\t\t\t\tfor _ = 1, row.full do\n\t\t\t\t\t\tlocal spot = freeSpot(rand, standing, taken, if kind == \"snail\" then 2.0 else 1.2, 6)\n\t\t\t\t\t\tif spot then\n\t\t\t\t\t\t\tlocal a = rand() * TAU\n\t\t\t\t\t\t\ttable.insert(spec.starts, { pos = spot, heading = v(math.cos(a), 0, math.sin(a)) })\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\tlocal stones, litter = {}, {}\n\t\t\t\t\tfor _, h in hides do if h.kind == \"stone\" then table.insert(stones, h) else table.insert(litter, h) end end\n\t\t\t\t\tif kind == \"millipede\" then spec.hides = stones end\n\t\t\t\t\tif kind == \"harvestman\" then spec.home = if #litter > 0 then litter[1].pos else hides[1].pos end\n\t\t\t\t\tif kind == \"snail\" then spec.rect = A.wallFoot end\n\t\t\t\tend\n\t\t\t\tspec.surface = \"soil\"\n\t\t\telse\n\t\t\t\t-- the house wall: a harvestman on the brick, its corner at the wall's foot by day\n\t\t\t\tlocal W = A.wall\n\t\t\t\tfor _ = 1, row.full do\n\t\t\t\t\tlocal p = v(between(rand, W.x[1] + 6, W.x[2] - 6), between(rand, W.y[1] + 10, W.y[2] - 10), Garden.WALL.face)\n\t\t\t\t\tlocal a = rand() * TAU\n\t\t\t\t\ttable.insert(spec.starts, { pos = p, heading = v(math.cos(a), math.sin(a), 0) })\n\t\t\t\tend\n\t\t\t\tspec.home = v(W.home[1], W.home[2], Garden.WALL.face)\n\t\t\t\tspec.rect = W\n\t\t\t\tspec.surface = \"wall\"\n\t\t\tend\n\t\t\ttable.insert(out, spec)\n\t\tend\n\tend\n\tambientCache[key] = out\n\treturn out\nend\n\n-- The boxes a region's creatures keep out of: each retreat grown by half a stud (the sill's are its own, Region.keepOut).\nfunction Garden.keepOut(region: WorldMap.Region): { Box }\n\tif not Garden.knows(region.kind) then error(\"no generator for the region kind \" .. region.kind) end\n\tlocal out: { Box } = {}\n\tfor _, t in region.retreats do\n\t\ttable.insert(out, { min = t.min - v(0.5, 0.5, 0.5), max = t.max + v(0.5, 0.5, 0.5) })\n\tend\n\treturn out\nend\n\nreturn table.freeze(Garden)\n",182601,129976241},{"Shared/World/GardenPocket","--!strict\n-- A one-metre habitat directly below the window. Juvenile plants retain adult\n-- leaf widths, with shorter internodes: small ground footprint, several climbable layers.\nlocal Hut = require(script.Parent.Hut)\nlocal Pocket = {}\nPocket.REGION = \"garden_a3\"\nPocket.PLANTS = table.freeze({\n table.freeze({kind=\"milkweed\",x=27,z=-80,scale=.52}),\n table.freeze({kind=\"coneflower\",x=57,z=-52,scale=.70}),\n table.freeze({kind=\"beebalm\",x=81,z=-79,scale=.60}),\n})\nPocket.CLOVER = table.freeze({Vector3.new(45,Hut.GROUND,-82),Vector3.new(54,Hut.GROUND,-74)})\nlocal pieces: {any}?=nil\nlocal decor: {any}?=nil\nfunction Pocket.pieces(): {any}\n if pieces then return pieces end\n local out: {any}={}\n for i,plant in Pocket.PLANTS do Hut.plantPieces(out,Pocket.REGION,plant,Hut.GROUND,\"p\"..i) end\n -- Old stems under the plants: low stepping routes and cover at a spider's own scale.\n local function box(id: string,a: Vector3,b: Vector3)\n  table.insert(out,{id=Pocket.REGION..\"_\"..id,lo=a,hi=b,profile=\"bare_wood_rough\",color=Color3.fromHex(\"756346\"),material=\"Wood\"})\n end\n local y=Hut.GROUND\n box(\"fallen_stem_a\",Vector3.new(29,y,-73),Vector3.new(45,y+.7,-72.2))\n box(\"fallen_stem_b\",Vector3.new(46,y,-70),Vector3.new(46.9,y+.8,-57))\n box(\"curled_leaf_foot_a\",Vector3.new(37,y,-94),Vector3.new(38,y+1.2,-91))\n box(\"curled_leaf_foot_b\",Vector3.new(48,y,-94),Vector3.new(49,y+1.2,-91))\n box(\"curled_leaf_roof\",Vector3.new(36,y+1.2,-95),Vector3.new(50,y+1.45,-90))\n for i,at in Pocket.CLOVER do\n  box(`clover_{i}_stem`,at+Vector3.new(-.08,0,-.08),at+Vector3.new(.08,3,.08))\n  box(`clover_{i}_head`,at+Vector3.new(-.4,3,-.4),at+Vector3.new(.4,3.6,.4))\n end\n local result=table.freeze(out) :: {any}\n pieces=result\n return result\nend\nfunction Pocket.decor(): {any}\n if decor then return decor end\n local out: {any}={};local byId: {[string]:any}={}\n for _,p in Pocket.pieces() do byId[p.id]=p end\n local function add(d: any): boolean\n  if string.sub(d.id,1,4)==\"Leaf\" then d.full=false end\n  d.id=\"Pocket_\"..d.id\n  table.insert(out,d);return true\n end\n local seed=914\n local function rand(): number seed=(seed*16807)%2147483647;return seed/2147483647 end\n for i,plant in Pocket.PLANTS do Hut.drawPlant(byId,Pocket.REGION,plant,\"p\"..i,add,rand,Hut.GROUND) end\n for _,p in Pocket.pieces() do\n  if string.find(p.id,\"fallen_stem\",1,true) or string.find(p.id,\"curled_leaf\",1,true) then\n   add({id=p.id,size=p.hi-p.lo,at=(p.lo+p.hi)/2,color=p.color,material=\"Wood\",shape=\"Ellipsoid\",full=false})\n  end\n end\n for i,at in Pocket.CLOVER do\n  add({id=`CloverHead{i}`,size=Vector3.new(.95,.75,.95),at=at+Vector3.new(0,3.35,0),\n   color=Color3.fromHex(\"e5dfca\"),material=\"SmoothPlastic\",shape=\"Ellipsoid\",full=false})\n  for leaf=1,3 do\n   local angle=leaf*math.pi*2/3\n   add({id=`CloverLeaf{i}_{leaf}`,size=Vector3.new(.95,.09,.7),at=at+Vector3.new(math.cos(angle)*.5,.5,math.sin(angle)*.5),\n    color=Color3.fromHex(\"6c8948\"),material=\"SmoothPlastic\",shape=\"Ellipsoid\",full=false})\n  end\n end\n local result=table.freeze(out) :: {any}\n decor=result\n return result\nend\nfunction Pocket.drawnPieces(): {string}\n local out: {string}={}\n -- Keep stems visible: drawPlant draws leaf blades and flower heads, not their support stems.\n for _,p in Pocket.pieces() do\n  if string.find(p.id,\"_leaf_\",1,true) or string.sub(p.id,-5)==\"_head\" or string.sub(p.id,-5)==\"_cone\" then table.insert(out,p.id) end\n end\n return out\nend\nlocal bestiary: {any}?=nil\nfunction Pocket.bestiary(): {any}\n if bestiary then return bestiary end\n local perches: {any}={}\n for i,at in Pocket.CLOVER do\n  table.insert(perches,{id=`pocket_clover_{i}_hoverfly`,position=at+Vector3.new(0,3.6,0),\n   normal=Vector3.yAxis,shelter=.4,food=.9,start=true,kind=\"leaf\"})\n end\n for _,p in Pocket.pieces() do\n  if string.find(p.id,\"_leaf_\",1,true) then\n   table.insert(perches,{id=p.id..\"_hoverfly\",position=Vector3.new((p.lo.X+p.hi.X)/2,p.hi.Y,(p.lo.Z+p.hi.Z)/2),\n    normal=Vector3.yAxis,shelter=.4,food=.7,start=#perches<3,kind=\"leaf\"})\n  end\n end\n local result: {any}={{kind=\"hoverfly\",profile=\"hoverfly_prototype\",perches=perches,\n  vents={{id=\"pocket_flower_arrival\",position=Vector3.new(82,Hut.GROUND+20,-100),normal=Vector3.yAxis,appear=true,reach=45}},\n  target=3,low=2,seed=37519,prefix=\"pocket_hoverfly_\",floor=Hut.GROUND-2,ceiling=Hut.GROUND+65}}\n bestiary=result\n return result\nend\nreturn table.freeze(Pocket)\n",4353,427665401},{"Shared/World/Hut","--!strict\n-- The ranger hut and its garden, walkable (ROBLOX-116, docs/PARK_WORLD_DESIGN.md Phase B round 1): the preserve's first home ranges at full spider detail. Pure\n-- data and pure generators, as World/Garden's are for the test garden: the regions (`author`), their physical boxes (`pieces`), their drawn looks (`decor`), and\n-- the life the garden's cells hold (`prey`, `bugs`, `bestiary`, `ambient`, `plants`), all from the region and its seed, so the server, every client and the CLI\n-- tests get the same hut. Nothing here requires World/WorldMap or World/Garden (they require this, through World/Region and World/WorldMap): its types are its own,\n-- shaped as theirs.\n--\n-- Studs, the sill's frame (World/Preserve: x east, -z north out of the window, +z into the hut; the sill's floor at y 0, the hut's floor FLOOR, the garden's\n-- ground GROUND). True scale: a stud is a centimetre.\n--\n-- The hut inside (3.5 by 3 m outside, 2.93 by 2.43 m between its linings, x -146.5..146.5, z 12.5..255.5, its floor 70 cm under the sill):\n--   hut_floor_a..i .. the floorboards in nine cells of about a metre (a region whole inside the streaming radius from anywhere on it), the skirting, and the walls'\n--                     linings to WALL_TOP (a metre and a third over the floor; ROBLOX-118: the upper walls and the ceiling are the hut_up_* cells over them). The apron\n--                     under the sill in hut_floor_b: the sill's front face goes on down to the floor.\n--   hut_desk ........ a desk east of the window against the north wall (90 by 60 cm, its top 74 cm over the floor), its drawer and the runner under it (the gap between\n--                     them is a retreat, hut_desk_drawer), a lamp, a notebook, a mug, three specimen jars and a hand lens; and the north wall's lining east of the window.\n--   hut_board ....... the notice board on two battens west of the window (the gap behind it is a retreat, hut_board_gap), and the lining west of the window.\n--   hut_shelf ....... a low bookcase of field guides against the west wall.\n--   hut_chair ....... the chair at the desk.\n--   hut_door ........ the door in the south wall, shut, with a gap of DOOR_GAP under its leaf (a way out for a spider), the threshold, the step outside and the gravel\n--                     at its foot (the path on round the hut is the next round's corridor).\n--   hut_window ...... the window over the sill (its glass, drawn by the sill's Decor, and its reveal and head).\n-- The way out (the window, propped open after the nursery, Client/HutLife):\n--   hut_outer_sill .. the window's outer sill board, level with the sill, and the green casing on it.\n--   hut_wall_w, hut_wall_mid, hut_wall_e .. the hut's log wall outside under and beside the window (walkable to OUT_TOP) and the corners' log ends; the base's lip\n--                     at its foot is the garden's (row a's cells).\n--   hut_bench ....... the bench under the window (its seat 44 cm over the ground, 40 under the sill: a short line drop from the outer sill's edge, or a walk down the logs).\n--   hut_butt ........ the water butt on its stand east of the window.\n-- The hut garden's core (home range 2, 4 by 4 m in front of the north window, x -200..200, z -16..-416), an American garden in late summer:\n--   garden_a1..d4 ... sixteen cells of a metre (rows a to d out from the wall, columns 1 to 4 west to east): the lawn, the gravel drip strip along the hut's foot,\n--                     the gravel path in from the east and on north, its brick edging, a raised pollinator bed (common milkweed, purple coneflower, wild bergamot\n--                     (bee balm) and Canada goldenrod at true size, under shredded-bark mulch), a raised herb bed (chives, sage, thyme), a planter trough under the\n--                     window raised on two bricks (the gap under it, garden_a1_trough), a flat stone on two rests in the lawn (garden_a3_stone) and a bark chip lying\n--                     on two others in the mulch (garden_d3_mulch).\n--   garden_pole, garden_feeder .. the bird feeder's pole, climbable, in two regions split at 90 cm, and its tray, hopper and roof at 1.6 m; its seed spilled\n--                     on the lawn round its foot (garden_b1's look).\n-- ROBLOX-117 (Phase B round 2: the garden rich at the spider's eye, its life, the path round the east end):\n--   path_s1..path_e6 .. the gravel path round the hut's east end, from the door's gravel to the garden's path (Hut.WALK), 60 cm wide.\n--   the plants ......... a second milkweed, coneflower, bee balm and goldenrod (MORE_PLANTS), every plant drawn whole over its walkable boxes (the leaves as blades\n--                        with midribs, the umbels, rays and cone, whorled heads and arching plumes); the bed's mulch mottled and chipped in the cells' looks.\n--   the patches ........ each garden cell and length of path cut into patches of PATCH studs, drawn-only looks (kind \"patch\") of what the spider sees close: grass\n--                        blades at true size in tufts, seed heads and clover, layered shredded bark, leaf bits, twigs, seeds and soil, gravel stones, the husks and a\n--                        cardinal's feather under the feeder, petals under the flowers, and the morning's dew; World/LookPlan draws them only near the spider.\n--   the life ............ the hoverflies on the bed's flowers, the fruit flies at a compost caddy by the door, a moth at the desk lamp from dusk; and where the rival\n--                        and the mate come into the garden and the cells they roam (CREATURES, ROAM: never the hut).\n-- ROBLOX-118 (Phase B round 3: the ceiling, the back room, the eaves, the meadow path):\n--   hut_up_a..i, room_up_a..i .. over each floor cell of both rooms, the walls' linings from WALL_TOP to the ceiling and the ceiling's boards on their joists (CEIL, JOISTS);\n--                        the house spider's web drawn in hut_up_a's corner.\n--   hut_door_up ........ the front door's leaf and jambs above DOOR.top to its head, and the wall over it to the ceiling.\n--   hut_doorway(_up) ... the doorway cut through the hut's old east logs into the back room (DOORWAY), in two at WALL_TOP.\n--   room_floor_a..i .... the volunteers' back room's floor (BACK), its linings, skirting, rug, the radiator under the window, the cables and sockets.\n--   room_sofa_w/e, room_tv, room_games, room_window .. its sofa (the gap under it, room_sofa_under, is room_floor_h's home), the television's unit, the board games' shelf,\n--                        the east window and its deep sill.\n--   hut_wall_x1..x3, hut_eave_w2..x4 .. the back room's north logs outside, and the whole north face from OUT_TOP to the soffit, the fascia and the gutter (EAVE, EAVES).\n--   path_s3..s5, path_e1..e5 (moved), path_n1..n3, path_m1..m4 .. the path round the back room's east end, and on north toward the meadow (WALK).\nlocal Preserve = require(script.Parent.Preserve)\n\nlocal Hut = {}\n\n-- (Shapes as World/WorldMap's and World/Garden's: the modules that require this one check them against their own.)\nexport type Region = {\n\tid: string, kind: string, origin: Vector3, bounds: { Vector3 }, seed: number,\n\tneighbors: { { id: string, a: Vector3, b: Vector3 } }, retreats: { { id: string, min: Vector3, max: Vector3, door: Vector3? } },\n\tspawn: { pos: Vector3, heading: Vector3 }, clockScale: number,\n}\nexport type Piece = { id: string, lo: Vector3, hi: Vector3, profile: string, color: Color3, material: string? }\nexport type Drawn = {\n\tid: string, size: Vector3, at: Vector3, color: Color3, transparency: number?,\n\tmaterial: string?, shape: string?, turn: Vector3?, full: boolean?, group: string?, shadow: boolean?, far: boolean?, reflectance: number?,\n\tdew: number?, -- (ROBLOX-117: a dew drop's lag, Habitat/DayLight.applyDew; its `transparency` is the one it has at full dew)\n}\nexport type Box = { min: Vector3, max: Vector3 }\n\nlocal function v(x: number, y: number, z: number): Vector3\n\treturn Vector3.new(x, y, z)\nend\nlocal function hex(s: string): Color3\n\treturn Color3.fromHex(s)\nend\nlocal MOD = 2147483647\nlocal TAU = 2 * math.pi\n-- A Park-Miller stream from a seed and a salt (World/Garden's, Habitat/Shapes.rng's).\nlocal function rng(seed: number, salt: number): () -> number\n\tlocal state = (seed + salt * 7919) % MOD\n\tif state <= 0 then state += MOD - 1 end\n\treturn function(): number\n\t\tstate = (state * 16807) % MOD\n\t\treturn (state - 1) / (MOD - 1)\n\tend\nend\nlocal function between(rand: () -> number, a: number, b: number): number\n\treturn a + (b - a) * rand()\nend\nlocal function pick<T>(list: { T }, rand: () -> number): T\n\treturn list[1 + math.floor(rand() * #list)]\nend\n\n-- ---------------------------------------------------------------- the numbers\nHut.FLOOR = Preserve.FLOOR_Y -- the hut's floor, 70 cm under the sill\nHut.GROUND = Preserve.GROUND_Y + 0.4 -- the garden's ground, 84.6 cm under the sill: 4 mm over the backdrop's mown grass, so the two never fight\nHut.ROOM = table.freeze({ x0 = -146.5, x1 = 146.5, z0 = 12.5, z1 = 255.5 }) -- between the linings (World/PreserveLook's hut: walls 28.5 cm)\nHut.WALL_TOP = 60 -- the walls inside are walkable this high (1.3 m over the floor): the regions' ceiling; above it the linings are drawn only\nHut.OUT_TOP = 30 -- and outside, beside the window, this high\nHut.WALL_SPLIT = -1.75 -- the north wall's depth is split here: the outside's logs to the south of it are the outside regions', the lining the inside's\nHut.COLS = table.freeze({ -146.5, -48.5, 48.5, 146.5 }) -- the floor's cells\nHut.ROWS = table.freeze({ 12.5, 93.5, 174.5, 255.5 })\nHut.DOOR = table.freeze({ x = 45, jamb = 60, outer = 284, base = 287, leaf = { 258, 262 }, gap = 1.5, step = { top = -77.5, to = 317 }, gravel = 340, top = 30 })\nHut.DOOR_GAP = Hut.DOOR.gap -- 1.5 cm under the leaf: a spider passes, a hand does not\nHut.CORE = table.freeze({ x0 = -200, x1 = 200, z0 = -416, z1 = -16 }) -- the garden's core (x 43.75..47.75 m, z 5..9 m)\nHut.CELL = 100\nHut.BED_TOP = 10 -- the raised beds' soil, over the ground\nHut.EDGING = table.freeze({ top = 12, thick = 2.5 })\nHut.POLLINATOR = table.freeze({ x0 = -20, x1 = 190, z0 = -406, z1 = -220 })\nHut.HERBS = table.freeze({ x0 = -190, x1 = -100, z0 = -406, z1 = -220 })\nHut.PATH = table.freeze({ ew = { x0 = -90, x1 = 200, z0 = -196, z1 = -146 }, ns = { x0 = -90, x1 = -30, z0 = -416, z1 = -146 }, brick = 4, brickH = 4 })\n-- The bird feeder: its pole, 4 cm square, from the lawn to `top` (1.6 m), in two regions split at `split` (a region whole inside the streaming radius from anywhere\n-- on it); the hopper on its tray at the top under a little roof (the feeder's region).\nHut.POLE = table.freeze({ x = -150, z = -150, half = 2, split = 90, top = 160, tray = { half = 8, thick = 2 }, hopper = { half = 5, h = 16 }, roof = { half = 9, thick = 2 } })\nHut.SASH = table.freeze({ min = v(-8, 0.7, -13.5), max = v(8, 6, -12.5) }) -- the lower sash's gap (the sill's own opening, WindowsillLayout back_frame_*)\n-- (ROBLOX-117) The gravel path round the hut's east end: from the door's gravel (hut_door, x -60..60) east along the south wall's foot (z 287..347, the hut's base\n-- lip at 284..287 is the backdrop's), north past the east end 57 cm out from the logs (x 235..295), and west into the garden's own path at the core's edge (x 200,\n-- z -196..-146). 60 cm wide, fine gravel at true size (2 to 10 mm stones: the patches' look). Each region whole inside the streaming radius from anywhere on it.\n-- (ROBLOX-118) The volunteers' back room stands against the hut's east end, so the path goes round the back room's east end instead: along the south wall's foot to\n-- x 590, north 57 cm out from the back room's east logs (x 530..590), and west along z -196..-146 to the garden's path (path_e6, where it always met it). The lengths\n-- path_e1..e5 keep their ids at their new place (WorldMap's preserve revision moved: preserve-2). And the meadow path, path_m1..m4: the garden's own north-south\n-- gravel path goes on north out of the core (x -90..-30) to the herb border's gap and the mown loop at z 13 m, so the world visibly goes on toward the meadow.\nHut.WALK = table.freeze({\n\ttable.freeze({ id = \"path_s1\", x0 = 60, x1 = 178, z0 = 287, z1 = 347 }),\n\ttable.freeze({ id = \"path_s2\", x0 = 178, x1 = 295, z0 = 287, z1 = 347 }),\n\ttable.freeze({ id = \"path_s3\", x0 = 295, x1 = 412, z0 = 287, z1 = 347 }),\n\ttable.freeze({ id = \"path_s4\", x0 = 412, x1 = 530, z0 = 287, z1 = 347 }),\n\ttable.freeze({ id = \"path_s5\", x0 = 530, x1 = 590, z0 = 287, z1 = 347 }),\n\ttable.freeze({ id = \"path_e1\", x0 = 530, x1 = 590, z0 = 200, z1 = 287 }),\n\ttable.freeze({ id = \"path_e2\", x0 = 530, x1 = 590, z0 = 113, z1 = 200 }),\n\ttable.freeze({ id = \"path_e3\", x0 = 530, x1 = 590, z0 = 26, z1 = 113 }),\n\ttable.freeze({ id = \"path_e4\", x0 = 530, x1 = 590, z0 = -60, z1 = 26 }),\n\ttable.freeze({ id = \"path_e5\", x0 = 530, x1 = 590, z0 = -146, z1 = -60 }),\n\ttable.freeze({ id = \"path_n3\", x0 = 530, x1 = 590, z0 = -196, z1 = -146 }),\n\ttable.freeze({ id = \"path_n2\", x0 = 412, x1 = 530, z0 = -196, z1 = -146 }),\n\ttable.freeze({ id = \"path_n1\", x0 = 295, x1 = 412, z0 = -196, z1 = -146 }),\n\ttable.freeze({ id = \"path_e6\", x0 = 200, x1 = 295, z0 = -196, z1 = -146 }),\n\ttable.freeze({ id = \"path_m1\", x0 = -90, x1 = -30, z0 = -441, z1 = -416 }),\n\ttable.freeze({ id = \"path_m2\", x0 = -90, x1 = -30, z0 = -466, z1 = -441 }),\n\ttable.freeze({ id = \"path_m3\", x0 = -90, x1 = -30, z0 = -491, z1 = -466 }),\n\ttable.freeze({ id = \"path_m4\", x0 = -90, x1 = -30, z0 = -516, z1 = -491 }),\n})\n\n-- (ROBLOX-118) The ceiling, the back room and the hut's outside to its eaves.\n-- The ceiling: boards whose underside is CEIL (2.2 m over the floor), on joists 4.5 by 14 cm every 60 cm across the short span (north to south), in both rooms.\nHut.CEIL = 150\nHut.JOISTS = table.freeze({ hut = table.freeze({ -90, -30, 30, 90 }), back = table.freeze({ 220, 280, 340, 400 }), w = 4.5, d = 14 })\n-- The volunteers' back room: a log room built on against the hut's east end, 2.7 by 2.43 m between its linings (its east logs' outer face at x 473.5), the same floor\n-- and ceiling as the hut's; the doorway cut through the hut's old east logs (x 146.5..175) at z 180..250, its head 2.05 m over the floor.\nHut.BACK = table.freeze({ x0 = 175, x1 = 445, z0 = 12.5, z1 = 255.5, east = 473.5 })\nHut.BACK_COLS = table.freeze({ 175, 265, 355, 445 })\nHut.DOORWAY = table.freeze({ x0 = 146.5, x1 = 175, z0 = 180, z1 = 250, head = 135, core = table.freeze({ 156.5, 165 }) })\n-- What is in it, true sizes: a two-seat sofa 2 m long against the south wall (its seat 45 cm over the floor, its back 85, its arms 70, on legs 8 cm tall: the gap under it\n-- is the darkest place in the hut, and a home); a low unit against the north wall with a 32-inch television on it and a games console on its shelf (the controller lies\n-- on the sofa's cushion); a shelf of board games in the north-east corner, 1.2 m tall; a rug; the window in the east wall over an oil-filled radiator (a space heater\n-- on its feet, its fins 7 cm apart); the cables along the skirting to their sockets.\nHut.SOFA = table.freeze({ x0 = 225, x1 = 425, z0 = 165.5, z1 = 254, arm = 20, leg = -62, frame = -38, seat = -25, back = 15, armTop = 0, split = 325,\n\tunder = table.freeze({ min = v(275, -70, 195), max = v(315, -68.6, 235), door = v(295, -69.5, 163.5) }) })\nHut.TV = table.freeze({ x0 = 185, x1 = 275, z0 = 14, z1 = 52.5, top = -20, screen = table.freeze({ x0 = 193.5, x1 = 266.5, y0 = -14, y1 = 29, z0 = 25, z1 = 29 }) })\nHut.GAMES = table.freeze({ x0 = 360, x1 = 440, z0 = 14, z1 = 44, top = 50 })\nHut.HEATER = table.freeze({ x0 = 425, x1 = 441, z0 = 100, z1 = 158, top = -7, fins = 7 })\nHut.RUG = table.freeze({ x0 = 230, x1 = 400, z0 = 96, z1 = 164, top = 1 })\nHut.ROOM_WINDOW = table.freeze({ z0 = 98, z1 = 170, glass = 459, sill = 429, head = 112.5, top = 115, gap = 5 })\n-- The north face outside, to the eaves: the logs to the soffit's underside (EAVE.soffit, 2.18 m over the ground), the boxed soffit under the roof's overhang, the\n-- fascia board and the gutter hung on it (its floor 2.06 m over the ground): the roof's walkable edge. The roof's slope (35 degrees) is drawn only.\nHut.BUILDING = table.freeze({ x0 = -175, x1 = 473.5 })\nHut.EAVE = table.freeze({ x0 = -205, x1 = 503.5, soffit = 133, soffitTop = 135, out = -46, fascia = table.freeze({ out = -48, bottom = 124 }),\n\tgutter = table.freeze({ floor = 121, thick = 1.5, out = -60, wall = 1.5, lip = 131, cap = 2 }) })\n\nlocal GT = Hut.GROUND\nlocal FL = Hut.FLOOR\nlocal S = GT + Hut.BED_TOP -- the beds' soil\n\n-- The palette (hex by what it is).\nlocal C = {\n\tfloor = \"9c7650\", floorDark = \"7d5c3e\", lining = \"c8a77a\", skirting = \"8a6a48\", log = \"5c4531\", logDark = \"3f2e20\", trim = \"3f5a43\",\n\tboard = \"8a7458\", boardDark = \"6f5d47\", desk = \"8e6a45\", deskTop = \"a67f55\", drawer = \"86643f\", metal = \"5a5d60\", brass = \"b08a3c\",\n\tcork = \"b48a5a\", batten = \"8a6a48\", paper = { \"f1ece0\", \"e8e2cf\", \"f6f1e4\", \"dfe6e8\", \"f3e3a8\", \"cfe3c8\" },\n\tbooks = { \"3e5b46\", \"7b3b2e\", \"2f4a6a\", \"8a6b3a\", \"5d3f5c\", \"a0522d\", \"355e5e\", \"6b6b3a\", \"40466e\", \"8c2f39\" },\n\tlamp = \"2f4f3a\", mug = \"e9e4d8\", jar = \"cfe0dc\", lid = \"c9b48a\", notebook = \"3b4f6b\", lens = \"dfe8ea\", handle = \"2a2724\",\n\tchair = \"7a5a3c\", concrete = \"8a867d\", gravel = \"b3a68a\", gravelDark = \"938870\", soil = \"4a3b2c\", soilDark = \"3d3024\", mulch = \"4e3524\",\n\tmulchColors = { \"5a3c26\", \"6b4a30\", \"4a3220\", \"7a5536\", \"3f2a1b\" }, lawn = \"5f7f3f\", lawnColors = { \"5c8a3a\", \"6f9a46\", \"4f7a33\", \"86a85a\", \"7d8f48\" },\n\tbrick = { \"9c4a32\", \"a65538\", \"8f4430\", \"b0603e\" }, stone = { \"a9a294\", \"b8ae9c\", \"9e9482\" }, edging = \"8a6f4e\",\n\tstem = \"5d8a3e\", leaf = \"4d7a36\", leafPale = \"6f9a52\", milkweedLeaf = \"6d8f5a\", milkweedUnder = \"a8b89a\", umbel = \"c48a96\", pod = \"7a9a5a\",\n\tgoldenrod = \"d4b23a\", goldenLeaf = \"5a7a3a\", petal = \"b36a8f\", cone = \"a5531f\", monarda = \"a88bb0\", sage = \"8a9a7a\", thyme = \"6d7f55\", chive = \"4f7d35\",\n\tchiveFlower = \"b48ac0\", butt = \"3e5d44\", buttLid = \"2f4734\", seed = { \"2a2420\", \"d8c8a0\", \"3a3028\", \"c9b48a\" },\n\t-- (ROBLOX-118) the ceiling and the back room\n\tceiling = \"cdb08a\", joist = \"a88a62\", rug = \"7a3b32\", cable = \"1e1e1e\", heater = \"e6e2d8\", heaterDark = \"8f8b84\", sofa = \"4f6170\", sofaDark = \"3f4e5a\",\n\tcontroller = \"26282b\", unit = \"8e6a45\", unitDark = \"6f5235\", console = \"f0f0ee\", screen = \"16181b\", gutter = \"6f7377\",\n\tgames = { \"b8322a\", \"2f5f8a\", \"e0b23a\", \"3e7a4a\", \"e8e2d0\", \"6a3d7a\", \"d97a2b\", \"2b2b2b\", \"9fb8c8\", \"c7a27c\" },\n}\n\n-- (ROBLOX-117) The rival and the mate in the preserve: they come into the hut garden, the rival along the gravel path from the north (it arrives at the path's end in\n-- garden_d2) and the mate along the path round the east end (at the garden's path where it comes in, garden_b4), and roam its sixteen cells (ROAM: Predator/RivalDrive's\n-- `roam`), never the hut: while the nursery is shut the spider is in it, and it is the spider's alone. The mate leaves the way it came.\nHut.CREATURES = table.freeze({\n\trival = table.freeze({ region = \"garden_d2\", at = v(-60, GT + 0.31, -380) }),\n\tmate = table.freeze({ region = \"garden_b4\", at = v(185, GT + 0.31, -171), exit = v(192, GT + 0.31, -171) }),\n})\nlocal ROAM: { [string]: boolean } = {}\nfor _, row in { \"a\", \"b\", \"c\", \"d\" } do for c = 1, 4 do ROAM[`garden_{row}{c}`] = true end end\nHut.ROAM = table.freeze(ROAM)\n\n-- ---------------------------------------------------------------- the regions\nlocal function freeze(r: Region): Region\n\ttable.freeze(r.bounds)\n\tfor _, n in r.neighbors do table.freeze(n) end\n\ttable.freeze(r.neighbors)\n\tfor _, t in r.retreats do table.freeze(t) end\n\ttable.freeze(r.retreats)\n\ttable.freeze(r.spawn)\n\treturn table.freeze(r)\nend\n\n-- The seams, by pair: the line where the two regions' walkable surfaces meet (both list it).\ntype Seam = { a: string, b: string, p: Vector3, q: Vector3 }\nlocal SEAMS: { Seam } = {}\n-- (ROBLOX-119) the regions beyond the hut's that its seams may name: World/Meadow's, authored after these (World/WorldMap.authorPreserve); only this side is listed here\nlocal OUTSIDE: { [string]: boolean } = { pad_a2 = true }\nlocal function seam(a: string, b: string, p: Vector3, q: Vector3)\n\ttable.insert(SEAMS, { a = a, b = b, p = p, q = q })\nend\n\n-- The floor's cells: a..i row by row from the north-west.\nlocal FLOOR_IDS = { \"a\", \"b\", \"c\", \"d\", \"e\", \"f\", \"g\", \"h\", \"i\" }\nlocal function floorCell(c: number, r: number): string\n\treturn \"hut_floor_\" .. FLOOR_IDS[(r - 1) * 3 + c]\nend\n-- The garden's cells: rows a..d out from the wall, columns 1..4 west to east.\nlocal GARDEN_ROWS = { \"a\", \"b\", \"c\", \"d\" }\nlocal function gardenCell(r: number, c: number): string\n\treturn `garden_{GARDEN_ROWS[r]}{c}`\nend\nlocal function gardenBox(r: number, c: number): (number, number, number, number) -- x0, x1, z0, z1\n\tlocal K = Hut.CORE\n\treturn K.x0 + (c - 1) * Hut.CELL, K.x0 + c * Hut.CELL, K.z1 - r * Hut.CELL, K.z1 - (r - 1) * Hut.CELL\nend\nHut.gardenBox = gardenBox\n\n-- Whether a garden cell has a tall plant (its region goes higher), and its plant.\nlocal PLANTS: { [string]: { kind: string, x: number, z: number, scale: number? } } = {\n\tgarden_c3 = { kind = \"milkweed\", x = 50, z = -266 },\n\tgarden_c4 = { kind = \"coneflower\", x = 150, z = -266 },\n\tgarden_d3 = { kind = \"beebalm\", x = 70, z = -380 },\n\tgarden_d4 = { kind = \"goldenrod\", x = 150, z = -362 },\n}\nHut.PLANTS = PLANTS\n-- (ROBLOX-117) A second plant of the same kind in each of the bed's cells, younger and a little shorter, so the bed is a stand and not four stems: a milkweed\n-- sucker beside the first (milkweed spreads by its roots into colonies), a second coneflower, bee balm and goldenrod. Walkable as the first; the life keeps to\n-- the first (its perches, its highway).\nlocal MORE_PLANTS: { [string]: { kind: string, x: number, z: number, scale: number? } } = {\n\tgarden_c3 = { kind = \"milkweed\", x = 22, z = -290, scale = 0.8 },\n\tgarden_c4 = { kind = \"coneflower\", x = 128, z = -296, scale = 0.9 },\n\tgarden_d3 = { kind = \"beebalm\", x = 40, z = -340, scale = 0.9 },\n\tgarden_d4 = { kind = \"goldenrod\", x = 122, z = -392, scale = 0.85 },\n}\nHut.MORE_PLANTS = MORE_PLANTS\n\n-- Whether a point (x, z) is in a bed (the soil's top is then S), and which.\nlocal function bedAt(x: number, z: number): string?\n\tfor name, b in { pollinator = Hut.POLLINATOR, herbs = Hut.HERBS } :: { [string]: any } do\n\t\tif x > b.x0 and x < b.x1 and z > b.z0 and z < b.z1 then return name end\n\tend\n\treturn nil\nend\n\n-- The surface a spider stands on in a garden cell at (x, z): the bed's soil or the ground.\nlocal function groundAt(x: number, z: number): number\n\treturn if bedAt(x, z) ~= nil then S else GT\nend\n\nlocal SPAWNS: { [string]: { number } } = {\n\tgarden_a1 = { -150, -90 }, garden_a2 = { -50, -75 }, garden_a3 = { 20, -90 }, garden_a4 = { 150, -100 },\n\tgarden_b1 = { -130, -185 }, garden_b2 = { -60, -170 }, garden_b3 = { 50, -170 }, garden_b4 = { 150, -170 },\n\tgarden_c1 = { -170, -240 }, garden_c2 = { -60, -260 }, garden_c3 = { 20, -240 }, garden_c4 = { 120, -240 },\n\tgarden_d1 = { -170, -392 }, garden_d2 = { -60, -360 }, garden_d3 = { 10, -340 }, garden_d4 = { 120, -340 },\n}\n\n-- The retreats outside: under the trough, under the stone, under the bark chip.\nHut.TROUGH = table.freeze({ x0 = -164, x1 = -100, z0 = -62, z1 = -22, feet = 1.4, foot = 10, top = 30, rim = 2 })\nHut.STONE = table.freeze({ x0 = 57, x1 = 73, z0 = -96, z1 = -80, rest = 2, gap = 1.4, thick = 1.6 })\nHut.CHIP = table.freeze({ x0 = 26, x1 = 40, z0 = -376, z1 = -362, rest = 1.5, gap = 1.4, thick = 0.6 })\n\nlocal RETREATS: { [string]: { id: string, min: Vector3, max: Vector3, door: Vector3 } } = {\n\thut_desk = { id = \"hut_desk_drawer\", min = v(52, -11.4, 30), max = v(64, -10, 42), door = v(58, -11.1, 72.5) },\n\thut_board = { id = \"hut_board_gap\", min = v(-128, 4, 12.5), max = v(-112, 20, 14.5), door = v(-135.5, 12, 13.5) },\n\tgarden_a1 = { id = \"garden_a1_trough\", min = v(-140, GT, -48), max = v(-128, GT + 1.4, -36), door = v(-134, GT + 0.5, -63.5) },\n\tgarden_a3 = { id = \"garden_a3_stone\", min = v(61, GT, -92), max = v(69, GT + 1.4, -84), door = v(65, GT + 0.5, -78) },\n\tgarden_d3 = { id = \"garden_d3_mulch\", min = v(29, S, -372), max = v(37, S + 1.4, -366), door = v(33, S + 0.5, -360.5) },\n\t-- (ROBLOX-118) the gap under the back room's sofa, deep in from its front edge: the darkest place in the hut (the floor's: the sofa's own region starts at its frame)\n\troom_floor_h = { id = \"room_sofa_under\", min = Hut.SOFA.under.min, max = Hut.SOFA.under.max, door = Hut.SOFA.under.door },\n}\n\n-- (ROBLOX-118) The upper cells (the walls from WALL_TOP to the ceiling, the ceiling and its joists over each floor cell of both rooms): their room and rectangle.\nlocal UPPER: { [string]: { room: string, x0: number, x1: number, z0: number, z1: number } } = {}\nlocal UPPER_IDS: { string } = {}\nfor r = 1, 3 do\n\tfor c = 1, 3 do\n\t\tlocal letter = FLOOR_IDS[(r - 1) * 3 + c]\n\t\tfor _, room in { \"hut\", \"back\" } do\n\t\t\tlocal cols = if room == \"hut\" then Hut.COLS else Hut.BACK_COLS\n\t\t\tlocal id = (if room == \"hut\" then \"hut_up_\" else \"room_up_\") .. letter\n\t\t\tUPPER[id] = { room = room, x0 = cols[c], x1 = cols[c + 1], z0 = Hut.ROWS[r], z1 = Hut.ROWS[r + 1] }\n\t\tend\n\tend\nend\nfor _, room in { \"hut\", \"back\" } do\n\tfor _, letter in FLOOR_IDS do table.insert(UPPER_IDS, (if room == \"hut\" then \"hut_up_\" else \"room_up_\") .. letter) end\nend\nHut.UPPER = UPPER\n-- The outside regions of the north face from WALL_TOP's outside height (OUT_TOP) to the eaves, west to east: x0..x1 of their logs and of their share of the eaves.\n-- (each about 72 to 100 studs along the wall, so a region is whole inside the streaming radius from anywhere on it: the logs are a metre high)\nlocal EAVES: { { id: string, x0: number, x1: number, ex0: number, ex1: number } } = {\n\t{ id = \"hut_eave_w2\", x0 = -175, x1 = -103, ex0 = -205, ex1 = -103 },\n\t{ id = \"hut_eave_w1\", x0 = -103, x1 = -31, ex0 = -103, ex1 = -31 },\n\t{ id = \"hut_eave_mid\", x0 = -31, x1 = 31, ex0 = -31, ex1 = 31 },\n\t{ id = \"hut_eave_e1\", x0 = 31, x1 = 103, ex0 = 31, ex1 = 103 },\n\t{ id = \"hut_eave_e2\", x0 = 103, x1 = 175, ex0 = 103, ex1 = 175 },\n\t{ id = \"hut_eave_x1\", x0 = 175, x1 = 250, ex0 = 175, ex1 = 250 },\n\t{ id = \"hut_eave_x2\", x0 = 250, x1 = 325, ex0 = 250, ex1 = 325 },\n\t{ id = \"hut_eave_x3\", x0 = 325, x1 = 400, ex0 = 325, ex1 = 400 },\n\t{ id = \"hut_eave_x4\", x0 = 400, x1 = 473.5, ex0 = 400, ex1 = 503.5 },\n}\nHut.EAVES = EAVES\n\n-- The authored regions of the hut and its garden, for a world seed (`seedOf`: World/WorldMap.seed), in priority order (after the sill, which World/WorldMap\n-- authors as it always has: the sill's neighbours are `Hut.SILL_SEAMS`).\nfunction Hut.author(worldSeed: number, seedOf: (number, string) -> number): { Region }\n\tlocal list: { Region } = {}\n\tlocal byId: { [string]: Region } = {}\n\tlocal function region(id: string, kind: string, lo: Vector3, hi: Vector3, spawn: Vector3, heading: Vector3, clock: number)\n\t\tlocal t = RETREATS[id]\n\t\tlocal r = {\n\t\t\t-- (a garden cell's origin is on its ground: its woodlice's)\n\t\t\tid = id, kind = kind, origin = v((lo.X + hi.X) / 2, if kind == \"garden_bed\" then GT else spawn.Y, (lo.Z + hi.Z) / 2), bounds = { lo, hi }, seed = seedOf(worldSeed, id),\n\t\t\tneighbors = {}, retreats = if t ~= nil then { table.clone(t) } else {}, spawn = { pos = spawn, heading = heading }, clockScale = clock,\n\t\t}\n\t\ttable.insert(list, r :: any)\n\t\tbyId[id] = r :: any\n\tend\n\tlocal R = Hut.ROOM\n\tregion(\"hut_window\", \"hut_window\", v(-31, 14, -13.6), v(31, 113.5, 13), v(0, 60, -12.5), v(0, 1, 0), 1.0)\n\tregion(\"hut_outer_sill\", \"hut_outer_sill\", v(-40, -5, -25.5), v(40, 35, -13.5), v(0, 0, -18), v(0, 0, -1), 1.0)\n\tregion(\"hut_desk\", \"hut_desk\", v(31, -69, 12.5), v(R.x1, Hut.WALL_TOP, 80), v(80, 4, 45), v(0, 0, -1), 1.0)\n\tregion(\"hut_board\", \"hut_board\", v(R.x0, -69, 12.5), v(-31, Hut.WALL_TOP, 30), v(-90, 20, 16.5), v(0, 1, 0), 1.0)\n\t-- The top books occupy the old shelf-plane spawn. A fallback starts on the upper book.\n\tregion(\"hut_shelf\", \"hut_shelf\", v(R.x0, -69, 114), v(-116, 30, 206), v(-132, 14.2, 160), v(0, 0, -1), 1.0)\n\tregion(\"hut_chair\", \"hut_chair\", v(64, -69, 86), v(108, 20, 130), v(86, -24, 108), v(0, 0, -1), 1.0)\n\tregion(\"hut_door\", \"hut_door\", v(-Hut.DOOR.jamb, -88, R.z1), v(Hut.DOOR.jamb, Hut.DOOR.top, Hut.DOOR.gravel), v(0, FL, 272), v(0, 0, 1), 1.0)\n\t-- (ROBLOX-118) the door's leaf and jambs above WALL_TOP's door height to its head, and the wall over it to the ceiling; the doorway to the back room; the back room's\n\t-- window over the radiator, the television's unit, the shelf of board games and the sofa (in two halves, each whole inside the streaming radius)\n\tlocal D, DW, B, SO = Hut.DOOR, Hut.DOORWAY, Hut.BACK, Hut.SOFA\n\tregion(\"hut_door_up\", \"hut_door_up\", v(-D.jamb, D.top, R.z1), v(D.jamb, Hut.CEIL, D.outer), v(0, 80, D.leaf[1]), v(0, 1, 0), 1.0)\n\tregion(\"hut_doorway\", \"hut_doorway\", v(DW.x0, FL - 3, 174.5), v(DW.x1, Hut.WALL_TOP, B.z1), v((DW.x0 + DW.x1) / 2, FL, (DW.z0 + DW.z1) / 2), v(1, 0, 0), 1.0)\n\tregion(\"hut_doorway_up\", \"hut_doorway\", v(DW.x0, Hut.WALL_TOP, 174.5), v(DW.x1, Hut.CEIL, B.z1), v((DW.core[1] + DW.core[2]) / 2, 100, DW.z0), v(0, 1, 0), 1.0)\n\tregion(\"room_window\", \"room_window\", v(B.x1 - 20, -5, 93.5), v(Hut.ROOM_WINDOW.glass + 1, Hut.ROOM_WINDOW.top + 3, 174.5), v(437, 0, 134), v(1, 0, 0), 1.0)\n\tregion(\"room_exit\", \"room_exit\", v(459, GT - 3, 98), v(531, 6, 170), v(480, GT, 134), v(1, 0, 0), 0.33)\n\tregion(\"room_tv\", \"room_tv\", v(Hut.TV.x0, FL + 1, Hut.TV.z0), v(Hut.TV.x1, Hut.TV.screen.y1 + 3, Hut.TV.z1 + 3), v(230, Hut.TV.top, 45), v(0, 0, 1), 1.0)\n\tregion(\"room_games\", \"room_games\", v(Hut.GAMES.x0, FL + 1, Hut.GAMES.z0), v(Hut.GAMES.x1, Hut.GAMES.top + 5, Hut.GAMES.z1 + 4), v(400, Hut.GAMES.top, 30), v(0, 0, 1), 1.0)\n\tregion(\"room_sofa_w\", \"room_sofa\", v(SO.x0 - 5, FL + 0.9, SO.z0 - 5), v(SO.split, SO.back + 3, SO.z1), v(262, SO.seat, 215), v(0, 0, -1), 1.0)\n\tregion(\"room_sofa_e\", \"room_sofa\", v(SO.split, FL + 0.9, SO.z0 - 5), v(SO.x1 + 5, SO.back + 3, SO.z1), v(365, SO.seat, 200), v(0, 0, -1), 1.0)\n\tfor r = 1, 3 do\n\t\tfor c = 1, 3 do\n\t\t\tlocal x0, x1, z0, z1 = Hut.COLS[c], Hut.COLS[c + 1], Hut.ROWS[r], Hut.ROWS[r + 1]\n\t\t\t-- The station's boots cover the first cell's centre; keep its fallback beside them.\n   local spawn=v((x0+x1)/2,FL,if c==1 and r==1 then 75 else (z0+z1)/2)\n\t\t\tregion(floorCell(c, r), \"hut_floor\", v(x0, FL - 3, z0), v(x1, Hut.WALL_TOP, z1), spawn, v(0, 0, -1), 1.0)\n\t\tend\n\tend\n\t-- (ROBLOX-118) the back room's floor in nine cells, as the hut's\n\tfor r = 1, 3 do\n\t\tfor c = 1, 3 do\n\t\t\tlocal x0, x1, z0, z1 = Hut.BACK_COLS[c], Hut.BACK_COLS[c + 1], Hut.ROWS[r], Hut.ROWS[r + 1]\n\t\t\tlocal spawn = v((x0 + x1) / 2, FL + (if (x0 + x1) / 2 > Hut.RUG.x0 and (x0 + x1) / 2 < Hut.RUG.x1 and (z0 + z1) / 2 > Hut.RUG.z0 and (z0 + z1) / 2 < Hut.RUG.z1 then Hut.RUG.top else 0), (z0 + z1) / 2)\n\t\t\tif r == 3 and c == 2 then spawn = v(340, FL, 215) end -- (under the sofa, beside its gap)\n\t\t\tif r == 2 and c == 3 then spawn = v(415, FL, 134) end -- (off the rug's edge, short of the radiator)\n\t\t\tregion(\"room_floor_\" .. FLOOR_IDS[(r - 1) * 3 + c], \"room_floor\", v(x0, FL - 3, z0), v(x1, Hut.WALL_TOP, z1), spawn, v(0, 0, -1), 1.0)\n\t\tend\n\tend\n\t-- (ROBLOX-118) the upper walls and the ceiling over every floor cell of both rooms: the spider walks them all, head down on the ceiling\n\tfor _, id in UPPER_IDS do\n\t\tlocal U = UPPER[id]\n\t\t-- (the cells by the doorway reach into the old logs to the doorway's cut, where their lining meets it)\n\t\tlocal bx0 = if id == \"room_up_g\" then Hut.DOORWAY.core[2] - 0.5 else U.x0\n\t\tlocal bx1 = if id == \"hut_up_i\" then Hut.DOORWAY.core[1] + 0.5 else U.x1\n\t\t-- (its spawn on the east face of its joist, part way up: a place a body can be put, where the ceiling's underside cannot)\n\t\tlocal J = Hut.JOISTS\n\t\tlocal jx = U.x0\n\t\tfor _, x in (if U.room == \"hut\" then J.hut else J.back) :: { number } do if x > U.x0 and x < U.x1 then jx = x; break end end\n\t\tregion(id, \"hut_upper\", v(bx0, Hut.WALL_TOP, U.z0), v(bx1, Hut.CEIL + 2, U.z1), v(jx + J.w / 2, Hut.CEIL - J.d / 2, (U.z0 + U.z1) / 2), v(0, 0, -1), 1.0)\n\tend\n\tregion(\"hut_wall_mid\", \"hut_wall\", v(-31, -71, -24), v(31, -4, -16), v(0, -20, -16), v(0, 1, 0), 1.0)\n\tregion(\"hut_wall_w\", \"hut_wall\", v(-185, -71, -26), v(-31, Hut.OUT_TOP, -16), v(-120, -20, -16), v(0, 1, 0), 1.0)\n\tregion(\"hut_wall_e\", \"hut_wall\", v(31, -71, -26), v(175, Hut.OUT_TOP, -16), v(120, -20, -16), v(0, 1, 0), 1.0)\n\t-- (ROBLOX-118) the back room's north logs outside, and the north face from OUT_TOP to the eaves, its soffit, fascia and gutter\n\tregion(\"hut_wall_x1\", \"hut_wall\", v(175, GT - 0.5, -26), v(275, Hut.OUT_TOP, -16), v(225, -20, -16), v(0, 1, 0), 1.0)\n\tregion(\"hut_wall_x2\", \"hut_wall\", v(275, GT - 0.5, -26), v(375, Hut.OUT_TOP, -16), v(325, -20, -16), v(0, 1, 0), 1.0)\n\tregion(\"hut_wall_x3\", \"hut_wall\", v(375, GT - 0.5, -26), v(483.5, Hut.OUT_TOP, -16), v(425, -20, -16), v(0, 1, 0), 1.0)\n\tlocal EV = Hut.EAVE\n\tfor _, e in EAVES do\n\t\tregion(e.id, \"hut_eave\", v(e.ex0 - (if e.id == \"hut_eave_mid\" then 6 else 0), Hut.OUT_TOP, EV.gutter.out - 3), v(e.ex1 + (if e.id == \"hut_eave_mid\" then 6 else 0), EV.soffitTop + 4, Hut.WALL_SPLIT),\n\t\t\tv((e.x0 + e.x1) / 2, EV.gutter.floor + EV.gutter.thick, (EV.gutter.out + EV.fascia.out) / 2), v(1, 0, 0), 1.0)\n\tend\n\t-- (the bench's and the butt's reach down to the ground: a spider at their feet is theirs)\n\tregion(\"hut_bench\", \"hut_bench\", v(-88, GT - 0.5, -61), v(48, -30, -16), v(-20, -40, -37), v(0, 0, -1), 0.33)\n\tregion(\"hut_butt\", \"hut_butt\", v(95, GT - 0.5, -82), v(165, 32, -17), v(130, 28.5, -49), v(0, 0, -1), 0.33)\n\tlocal P = Hut.POLE\n\tregion(\"garden_feeder\", \"garden_pole\", v(P.x - 10, GT + P.split, P.z - 10), v(P.x + 10, GT + P.top + P.tray.thick + P.hopper.h + P.roof.thick + 4, P.z + 10),\n\t\tv(P.x + P.half, GT + 120, P.z), v(0, 1, 0), 0.33)\n\tregion(\"garden_pole\", \"garden_pole\", v(P.x - 8, GT + 0.5, P.z - 8), v(P.x + 8, GT + P.split, P.z + 8), v(P.x + P.half, GT + 40, P.z), v(0, 1, 0), 0.33)\n\tfor r = 1, 4 do\n\t\tfor c = 1, 4 do\n\t\t\tlocal id = gardenCell(r, c)\n\t\t\tlocal x0, x1, z0, z1 = gardenBox(r, c)\n\t\t\tlocal top = if PLANTS[id] ~= nil then GT + 140 else GT + 60\n\t\t\tlocal s = SPAWNS[id]\n\t\t\tregion(id, \"garden_bed\", v(x0, -87, z0), v(x1, top, z1), v(s[1], groundAt(s[1], s[2]), s[2]), v(0, 0, -1), 0.33)\n\t\tend\n\tend\n\t-- (ROBLOX-117) the gravel path round the hut's east end, from the door's gravel to the garden's path\n\tfor _, w in Hut.WALK do\n\t\tregion(w.id, \"hut_path\", v(w.x0, -87, w.z0), v(w.x1, GT + 40, w.z1), v((w.x0 + w.x1) / 2, GT, (w.z0 + w.z1) / 2), v(0, 0, -1), 0.33)\n\tend\n\t-- the seams, both ways\n\t-- the sill's seams (World/WorldMap lists them on the sill), listed on this side too\n\tfor _, n in Hut.SILL_SEAMS do table.insert(byId[n.id].neighbors, { id = \"sill\", a = n.a, b = n.b }) end\n\tfor _, s in SEAMS do\n\t\tlocal a, b = byId[s.a], byId[s.b]\n\t\tassert(a ~= nil and (b ~= nil or OUTSIDE[s.b]), `a seam of {s.a} and {s.b}`)\n\t\ttable.insert(a.neighbors, { id = s.b, a = s.p, b = s.q })\n\t\tif b ~= nil then table.insert(b.neighbors, { id = s.a, a = s.p, b = s.q }) end\n\tend\n\tfor _, r in list do freeze(r) end\n\treturn list\nend\n\n-- The sill's seams in the preserve (World/WorldMap's sill lists these): out through the sash's gap onto the outer sill, up the window's glass, down its front face\n-- to the floor (the apron under it), and along the north wall's lining east to the desk and west to the notice board.\nHut.SILL_SEAMS = table.freeze({\n\ttable.freeze({ id = \"hut_outer_sill\", a = v(-8, 0, -13.5), b = v(8, 0, -13.5) }),\n\ttable.freeze({ id = \"hut_window\", a = v(-30, 14, -12.5), b = v(30, 14, -12.5) }),\n\ttable.freeze({ id = \"hut_floor_b\", a = v(-30, -1, 12.5), b = v(30, -1, 12.5) }),\n\ttable.freeze({ id = \"hut_desk\", a = v(31, 0, 12.5), b = v(31, 14, 12.5) }),\n\ttable.freeze({ id = \"hut_board\", a = v(-31, 0, 12.5), b = v(-31, 14, 12.5) }),\n})\n\ndo\n\tlocal R = Hut.ROOM\n\t-- inside: the floor's cells to one another (flat on the boards, clear of the skirting)\n\tfor r = 1, 3 do\n\t\tfor c = 1, 3 do\n\t\t\tlocal x0, x1, z0, z1 = Hut.COLS[c], Hut.COLS[c + 1], Hut.ROWS[r], Hut.ROWS[r + 1]\n\t\t\tif c < 3 then seam(floorCell(c, r), floorCell(c + 1, r), v(x1, FL, z0 + 4), v(x1, FL, z1 - 4)) end\n\t\t\tif r < 3 then seam(floorCell(c, r), floorCell(c, r + 1), v(x0 + 4, FL, z1), v(x1 - 4, FL, z1)) end\n\t\tend\n\tend\n\t-- the furniture on the floor, and the north wall's linings over the skirting\n\tseam(\"hut_desk\", \"hut_floor_c\", v(55, -60, 12.5), v(140, -60, 12.5))\n\tseam(\"hut_desk\", \"hut_floor_b\", v(37, FL, 67), v(37, FL, 71)) -- (the front west leg's foot on the floor)\n\tseam(\"hut_board\", \"hut_floor_a\", v(-140, -60, 12.5), v(-55, -60, 12.5))\n\tseam(\"hut_board\", \"hut_floor_b\", v(-46, -60, 12.5), v(-33, -60, 12.5))\n\tseam(\"hut_shelf\", \"hut_floor_d\", v(-145, FL, 116), v(-120, FL, 116))\n\tseam(\"hut_shelf\", \"hut_floor_g\", v(-145, FL, 204), v(-120, FL, 204))\n\tseam(\"hut_chair\", \"hut_floor_c\", v(67, FL, 89), v(70, FL, 89))\n\tseam(\"hut_chair\", \"hut_floor_f\", v(67, FL, 127), v(70, FL, 127))\n\tseam(\"hut_door\", \"hut_floor_h\", v(-44, FL, R.z1), v(44, FL, R.z1))\n\tseam(\"hut_window\", \"hut_desk\", v(31, 20, 12.5), v(31, Hut.WALL_TOP, 12.5))\n\tseam(\"hut_window\", \"hut_board\", v(-31, 20, 12.5), v(-31, Hut.WALL_TOP, 12.5))\n\t-- outside: the outer sill to the logs under and beside it, the logs to one another, the bench and the butt\n\tseam(\"hut_outer_sill\", \"hut_wall_mid\", v(-30, -4, -16), v(30, -4, -16))\n\tseam(\"hut_outer_sill\", \"hut_wall_w\", v(-37, -3, -16), v(-37, Hut.OUT_TOP, -16)) -- (the board's end and the casing's side meet the logs beside them)\n\tseam(\"hut_outer_sill\", \"hut_wall_e\", v(37, -3, -16), v(37, Hut.OUT_TOP, -16))\n\tseam(\"hut_wall_w\", \"hut_wall_mid\", v(-31, -70, -16), v(-31, -4, -16))\n\tseam(\"hut_wall_mid\", \"hut_wall_e\", v(31, -70, -16), v(31, -4, -16))\n\tseam(\"hut_bench\", \"hut_wall_mid\", v(-30, -40, -16), v(30, -40, -16))\n\tseam(\"hut_bench\", \"garden_a2\", v(-80, GT, -55), v(-74, GT, -55))\n\tseam(\"hut_bench\", \"garden_a3\", v(33, GT, -55), v(39, GT, -55))\n\tseam(\"hut_butt\", \"garden_a4\", v(105, GT, -75), v(155, GT, -75))\n\t-- the logs' foot onto the base's lip (the garden's)\n\tseam(\"hut_wall_w\", \"garden_a1\", v(-160, FL, -16), v(-104, FL, -16))\n\tseam(\"hut_wall_w\", \"garden_a2\", v(-95, FL, -16), v(-35, FL, -16))\n\tseam(\"hut_wall_mid\", \"garden_a2\", v(-28, FL, -16), v(-2, FL, -16))\n\tseam(\"hut_wall_mid\", \"garden_a3\", v(2, FL, -16), v(28, FL, -16))\n\tseam(\"hut_wall_e\", \"garden_a3\", v(35, FL, -16), v(95, FL, -16))\n\tseam(\"hut_wall_e\", \"garden_a4\", v(104, FL, -16), v(160, FL, -16))\n\t-- (ROBLOX-117) the path round the east end: out of the door's gravel, along the south wall, round the corner, north and into the garden's path\n\tseam(\"hut_door\", \"path_s1\", v(60, GT, 290), v(60, GT, 338))\n\tseam(\"path_s1\", \"path_s2\", v(178, GT, 290), v(178, GT, 344))\n\t-- (ROBLOX-118) on round the back room's east end\n\tseam(\"path_s2\", \"path_s3\", v(295, GT, 290), v(295, GT, 344))\n\tseam(\"path_s3\", \"path_s4\", v(412, GT, 290), v(412, GT, 344))\n\tseam(\"path_s4\", \"path_s5\", v(530, GT, 290), v(530, GT, 344))\n\tseam(\"path_s5\", \"path_e1\", v(533, GT, 287), v(587, GT, 287))\n\tseam(\"path_e1\", \"path_e2\", v(533, GT, 200), v(587, GT, 200))\n\tseam(\"path_e2\", \"path_e3\", v(533, GT, 113), v(587, GT, 113))\n\tseam(\"path_e3\", \"path_e4\", v(533, GT, 26), v(587, GT, 26))\n\tseam(\"path_e4\", \"path_e5\", v(533, GT, -60), v(587, GT, -60))\n\tseam(\"path_e5\", \"path_n3\", v(533, GT, -146), v(587, GT, -146))\n\tseam(\"path_n3\", \"path_n2\", v(530, GT, -193), v(530, GT, -149))\n\tseam(\"path_n2\", \"path_n1\", v(412, GT, -193), v(412, GT, -149))\n\tseam(\"path_n1\", \"path_e6\", v(295, GT, -193), v(295, GT, -149))\n\tseam(\"path_e6\", \"garden_b4\", v(200, GT, -193), v(200, GT, -149))\n\t-- (ROBLOX-118) the meadow path out of the garden's north edge\n\tseam(\"garden_d2\", \"path_m1\", v(-88, GT, -416), v(-32, GT, -416))\n\tseam(\"path_m1\", \"path_m2\", v(-88, GT, -441), v(-32, GT, -441))\n\tseam(\"path_m2\", \"path_m3\", v(-88, GT, -466), v(-32, GT, -466))\n\tseam(\"path_m3\", \"path_m4\", v(-88, GT, -491), v(-32, GT, -491))\n\t-- (ROBLOX-119) on into the bench patch at the meadow's edge (World/Meadow's pad_a2, which lists this seam on its side)\n\tseam(\"path_m4\", \"pad_a2\", v(-88, GT, -516), v(-32, GT, -516))\n\tlocal P = Hut.POLE\n\tseam(\"garden_pole\", \"garden_b1\", v(P.x - P.half, GT, P.z - P.half), v(P.x + P.half, GT, P.z - P.half))\n\tseam(\"garden_pole\", \"garden_feeder\", v(P.x + P.half, GT + P.split, P.z - P.half), v(P.x + P.half, GT + P.split, P.z + P.half))\n\t-- the garden's cells to one another: flat on the ground, or on a bed's soil where a bed lies across the line\n\tfor r = 1, 4 do\n\t\tfor c = 1, 4 do\n\t\t\tlocal x0, x1, z0, z1 = gardenBox(r, c)\n\t\t\tif c < 4 then\n\t\t\t\tlocal zm = (z0 + z1) / 2\n\t\t\t\tlocal y = groundAt(x1, zm)\n\t\t\t\t-- (row a's line between columns 1 and 2 runs where the trough does not stand; the lines keep 8 studs from the corners, clear of the beds' edging)\n\t\t\t\tlocal za, zb = z0 + 8, z1 - 8\n\t\t\t\tif r == 1 and c == 1 then za, zb = z0 + 8, -70 end\n\t\t\t\tif r == 1 and c == 3 then za, zb = z0 + 8, -80 end -- (and between columns 3 and 4 where the water butt's stand does not)\n\t\t\t\tseam(gardenCell(r, c), gardenCell(r, c + 1), v(x1, y, za), v(x1, y, zb))\n\t\t\tend\n\t\t\tif r < 4 then\n\t\t\t\tlocal xm = (x0 + x1) / 2\n\t\t\t\tlocal y = groundAt(xm, z0)\n\t\t\t\tlocal xa, xb = x0 + 8, x1 - 8\n\t\t\t\tif c == 2 and r >= 2 then xb = Hut.POLLINATOR.x0 - 5 end -- (column 2's line runs on the path and the lawn, short of the pollinator bed's edge)\n\t\t\t\tseam(gardenCell(r, c), gardenCell(r + 1, c), v(xa, y, z0), v(xb, y, z0))\n\t\t\tend\n\t\tend\n\tend\n\t-- (ROBLOX-118) the ceiling, the back room and the outside to the eaves\n\tlocal CE, DW, D = Hut.CEIL, Hut.DOORWAY, Hut.DOOR\n\tseam(\"hut_door\", \"hut_door_up\", v(-44, D.top, D.leaf[1]), v(44, D.top, D.leaf[1]))\n\tseam(\"hut_floor_i\", \"hut_doorway\", v(DW.x0, FL, DW.z0 + 2), v(DW.x0, FL, DW.z1 - 2))\n\tseam(\"hut_doorway\", \"room_floor_g\", v(DW.x1, FL, DW.z0 + 2), v(DW.x1, FL, DW.z1 - 2))\n\t-- the upper cells: to one another flat on the ceiling's underside, and each to what is under it along a wall at WALL_TOP\n\tfor _, room in { \"hut\", \"back\" } do\n\t\tlocal cols = if room == \"hut\" then Hut.COLS else Hut.BACK_COLS\n\t\tlocal pre = if room == \"hut\" then \"hut_up_\" else \"room_up_\"\n\t\tfor r = 1, 3 do\n\t\t\tfor c = 1, 3 do\n\t\t\t\tlocal x0, x1, z0, z1 = cols[c], cols[c + 1], Hut.ROWS[r], Hut.ROWS[r + 1]\n\t\t\t\tlocal here = pre .. FLOOR_IDS[(r - 1) * 3 + c]\n\t\t\t\tif c < 3 then seam(here, pre .. FLOOR_IDS[(r - 1) * 3 + c + 1], v(x1, CE, z0 + 4), v(x1, CE, z1 - 4)) end\n\t\t\t\tif r < 3 then seam(here, pre .. FLOOR_IDS[r * 3 + c], v(x0 + 4, CE, z1), v(x1 - 4, CE, z1)) end\n\t\t\tend\n\t\tend\n\tend\n\tlocal T = Hut.WALL_TOP\n\tseam(\"hut_up_a\", \"hut_floor_a\", v(R.x0, T, 16.5), v(R.x0, T, 89.5))\n\tseam(\"hut_up_a\", \"hut_board\", v(-142, T, R.z0), v(-53, T, R.z0))\n\tseam(\"hut_up_b\", \"hut_board\", v(-46, T, R.z0), v(-33, T, R.z0))\n\tseam(\"hut_up_b\", \"hut_desk\", v(33, T, R.z0), v(46, T, R.z0))\n\tseam(\"hut_up_b\", \"hut_window\", v(-29, 113.5, R.z0), v(29, 113.5, R.z0))\n\tseam(\"hut_up_c\", \"hut_desk\", v(53, T, R.z0), v(142, T, R.z0))\n\tseam(\"hut_up_c\", \"hut_floor_c\", v(R.x1, T, 16.5), v(R.x1, T, 89.5))\n\tseam(\"hut_up_d\", \"hut_floor_d\", v(R.x0, T, 97.5), v(R.x0, T, 170.5))\n\tseam(\"hut_up_f\", \"hut_floor_f\", v(R.x1, T, 97.5), v(R.x1, T, 170.5))\n\tseam(\"hut_up_g\", \"hut_floor_g\", v(R.x0, T, 178.5), v(R.x0, T, 251.5))\n\tseam(\"hut_up_i\", \"hut_floor_i\", v(64, T, R.z1), v(142, T, R.z1))\n\tseam(\"hut_up_h\", \"hut_door_up\", v(-44, CE, R.z1), v(44, CE, R.z1))\n\tseam(\"hut_up_g\", \"hut_door_up\", v(-D.jamb, T + 4, R.z1), v(-D.jamb, DW.head - 4, R.z1))\n\tseam(\"hut_up_i\", \"hut_door_up\", v(D.jamb, T + 4, R.z1), v(D.jamb, DW.head - 4, R.z1))\n\tseam(\"hut_up_i\", \"hut_doorway_up\", v(DW.core[1], T + 4, DW.z0), v(DW.core[1], DW.head - 4, DW.z0))\n\tseam(\"room_up_g\", \"hut_doorway_up\", v(DW.core[2], T + 4, DW.z0), v(DW.core[2], DW.head - 4, DW.z0))\n\tseam(\"hut_doorway\", \"hut_doorway_up\", v(DW.core[1] + 0.5, T, DW.z0), v(DW.core[2] - 0.5, T, DW.z0))\n\tlocal B = Hut.BACK\n\tseam(\"room_up_a\", \"room_floor_a\", v(B.x0, T, 16.5), v(B.x0, T, 89.5))\n\tseam(\"room_up_b\", \"room_floor_b\", v(269, T, B.z0), v(351, T, B.z0))\n\tseam(\"room_up_c\", \"room_floor_c\", v(B.x1, T, 16.5), v(B.x1, T, 89.5))\n\tseam(\"room_up_d\", \"room_floor_d\", v(B.x0, T, 97.5), v(B.x0, T, 170.5))\n\tseam(\"room_up_f\", \"room_window\", v(B.x1, Hut.ROOM_WINDOW.top, 120), v(B.x1, Hut.ROOM_WINDOW.top, 148))\n\tseam(\"room_up_g\", \"room_floor_g\", v(179, T, B.z1), v(261, T, B.z1))\n\tseam(\"room_up_h\", \"room_floor_h\", v(269, T, B.z1), v(351, T, B.z1))\n\tseam(\"room_up_i\", \"room_floor_i\", v(B.x1, T, 178.5), v(B.x1, T, 251.5))\n\t-- the back room's floor cells to one another: on the boards, or on the rug where it lies across the line, clear of the television's unit\n\tlocal G = Hut.RUG\n\tlocal function floorLine(a: string, b: string, p: Vector3, q: Vector3)\n\t\t-- (a line along x or z on the floor: the part of it on the rug, if the rug covers some of it, else the boards short of the rug)\n\t\tlocal alongX = math.abs(q.X - p.X) > math.abs(q.Z - p.Z)\n\t\tlocal fixed = if alongX then p.Z else p.X\n\t\tlocal across = if alongX then fixed > G.z0 and fixed < G.z1 else fixed > G.x0 and fixed < G.x1\n\t\tlocal lo, hi = if alongX then p.X else p.Z, if alongX then q.X else q.Z\n\t\tlocal r0, r1 = if alongX then G.x0 else G.z0, if alongX then G.x1 else G.z1\n\t\tif across and math.min(hi, r1) > math.max(lo, r0) then\n\t\t\tlocal a0, a1 = math.max(lo, r0 + 4), math.min(hi, r1 - 4)\n\t\t\tif a1 - a0 >= 10 then\n\t\t\t\tseam(a, b, if alongX then v(a0, FL + G.top, fixed) else v(fixed, FL + G.top, a0), if alongX then v(a1, FL + G.top, fixed) else v(fixed, FL + G.top, a1))\n\t\t\t\treturn\n\t\t\tend\n\t\t\t-- (the boards' longer part off the rug)\n\t\t\tif r0 - lo >= hi - r1 then hi = math.min(hi, r0 - 3) else lo = math.max(lo, r1 + 3) end\n\t\tend\n\t\tseam(a, b, if alongX then v(lo, FL, fixed) else v(fixed, FL, lo), if alongX then v(hi, FL, fixed) else v(fixed, FL, hi))\n\tend\n\tfor r = 1, 3 do\n\t\tfor c = 1, 3 do\n\t\t\tlocal x0, x1, z0, z1 = Hut.BACK_COLS[c], Hut.BACK_COLS[c + 1], Hut.ROWS[r], Hut.ROWS[r + 1]\n\t\t\tlocal here = \"room_floor_\" .. FLOOR_IDS[(r - 1) * 3 + c]\n\t\t\tif c < 3 then\n\t\t\t\tlocal za, zb = z0 + 4, z1 - 4\n\t\t\t\tif r == 1 then za = Hut.TV.z1 + 3 end -- (clear of the television's unit)\n\t\t\t\tfloorLine(here, \"room_floor_\" .. FLOOR_IDS[(r - 1) * 3 + c + 1], v(x1, FL, za), v(x1, FL, zb))\n\t\t\tend\n\t\t\tif r < 3 then floorLine(here, \"room_floor_\" .. FLOOR_IDS[r * 3 + c], v(x0 + 4, FL, z1), v(x1 - 4, FL, z1)) end\n\t\tend\n\tend\n\tlocal TV, GA, SO = Hut.TV, Hut.GAMES, Hut.SOFA\n\tseam(\"room_tv\", \"room_floor_a\", v(TV.x0 + 4, FL, TV.z1), v(261, FL, TV.z1))\n\tseam(\"room_tv\", \"room_floor_b\", v(267, FL, TV.z1), v(TV.x1 - 2, FL, TV.z1))\n\tseam(\"room_games\", \"room_floor_c\", v(GA.x0 + 4, FL, GA.z1), v(GA.x1 - 4, FL, GA.z1))\n\tseam(\"room_window\", \"room_floor_f\", v(B.x1, -3, Hut.ROOM_WINDOW.z0 + 1), v(B.x1, -3, Hut.ROOM_WINDOW.z1 - 1))\n\tseam(\"room_window\", \"room_exit\", v(459, 0, 102), v(459, 0, 166))\n\tseam(\"room_exit\", \"path_e2\", v(530, GT, 117), v(530, GT, 166))\n\tseam(\"room_exit\", \"path_e3\", v(530, GT, 102), v(530, GT, 109))\n\tseam(\"room_sofa_w\", \"room_floor_d\", v(SO.x0 + 3.5, FL, SO.z0 + 2.5), v(SO.x0 + 8.5, FL, SO.z0 + 2.5))\n\tseam(\"room_sofa_w\", \"room_floor_g\", v(SO.x0 + 3.5, FL, SO.z1 - 8), v(SO.x0 + 8.5, FL, SO.z1 - 8))\n\tseam(\"room_sofa_e\", \"room_floor_f\", v(SO.x1 - 8.5, FL, SO.z0 + 2.5), v(SO.x1 - 3.5, FL, SO.z0 + 2.5))\n\tseam(\"room_sofa_e\", \"room_floor_i\", v(SO.x1 - 8.5, FL, SO.z1 - 8), v(SO.x1 - 3.5, FL, SO.z1 - 8))\n\tseam(\"room_sofa_w\", \"room_sofa_e\", v(SO.split, SO.leg + 1, SO.z0), v(SO.split, SO.frame - 1, SO.z0))\n\t-- outside: the logs at OUT_TOP to the eaves' logs, the back room's north logs to the hut's, and the eaves to one another along the soffit's underside\n\tlocal OT, EV = Hut.OUT_TOP, Hut.EAVE\n\tseam(\"hut_wall_w\", \"hut_eave_w2\", v(-160, OT, -16), v(-108, OT, -16))\n\tseam(\"hut_wall_w\", \"hut_eave_w1\", v(-98, OT, -16), v(-40, OT, -16))\n\tseam(\"hut_wall_e\", \"hut_eave_e1\", v(40, OT, -16), v(98, OT, -16))\n\tseam(\"hut_wall_e\", \"hut_eave_e2\", v(108, OT, -16), v(170, OT, -16))\n\tseam(\"hut_wall_x1\", \"hut_eave_x1\", v(180, OT, -16), v(245, OT, -16))\n\tseam(\"hut_wall_x2\", \"hut_eave_x2\", v(280, OT, -16), v(320, OT, -16))\n\tseam(\"hut_wall_x2\", \"hut_eave_x3\", v(330, OT, -16), v(370, OT, -16))\n\tseam(\"hut_wall_x3\", \"hut_eave_x4\", v(405, OT, -16), v(460, OT, -16))\n\tseam(\"hut_wall_e\", \"hut_wall_x1\", v(175, -50, -16), v(175, OT - 10, -16))\n\tseam(\"hut_wall_x1\", \"hut_wall_x2\", v(275, -50, -16), v(275, OT - 10, -16))\n\tseam(\"hut_wall_x2\", \"hut_wall_x3\", v(375, -50, -16), v(375, OT - 10, -16))\n\tfor k = 1, #EAVES - 1 do\n\t\tlocal x = EAVES[k].ex1\n\t\tseam(EAVES[k].id, EAVES[k + 1].id, v(x, EV.soffit, EV.out + 2), v(x, EV.soffit, -18))\n\tend\nend\n\n-- ---------------------------------------------------------------- the pieces\nlocal function P(out: { Piece }, id: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, profile: string, color: string, material: string?)\n\ttable.insert(out, { id = id, lo = v(x0, y0, z0), hi = v(x1, y1, z1), profile = profile, color = hex(color), material = material })\nend\n\n-- The parts of an axis-aligned box inside a cell's rectangle (x0..x1, z0..z1), or nil when none.\nlocal function clip(x0: number, x1: number, z0: number, z1: number, cx0: number, cx1: number, cz0: number, cz1: number): (number?, number?, number?, number?)\n\tlocal a, b, c, d = math.max(x0, cx0), math.min(x1, cx1), math.max(z0, cz0), math.min(z1, cz1)\n\tif b - a <= 1e-6 or d - c <= 1e-6 then return nil, nil, nil, nil end\n\treturn a, b, c, d\nend\n\nlocal function floorPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal id = region.id\n\tlocal R = Hut.ROOM\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal x0, x1, z0, z1 = lo.X, hi.X, lo.Z, hi.Z\n\tlocal W, top, sk, st = 10, Hut.WALL_TOP, 1.5, FL + 10\n\tP(out, id .. \"_boards\", x0, x1, FL - 2, FL, z0, z1, \"varnished_wood_smooth\", C.floor, \"WoodPlanks\")\n\tlocal west, east, north, south = x0 == R.x0, x1 == R.x1, z0 == R.z0, z1 == R.z1\n\t-- the linings (the walls' room faces) and the skirting along them\n\tif west then\n\t\tP(out, id .. \"_wall_w\", R.x0 - W, R.x0, FL, top, z0, z1, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\t\t-- (the skirting stops at the bookcase, x -146.5..-118.5 from z 116 to 204, and at the corners' other skirting)\n\t\tlocal s0, s1 = if north then z0 + sk else z0, if south then z1 - sk else z1\n\t\tlocal runs = { { s0, s1 } }\n\t\tif s0 < 204 and s1 > 116 then\n\t\t\truns = {}\n\t\t\tif s0 < 116 then table.insert(runs, { s0, 116 }) end\n\t\t\tif s1 > 204 then table.insert(runs, { 204, s1 }) end\n\t\tend\n\t\tfor k, run in runs do P(out, `{id}_skirting_w{k}`, R.x0, R.x0 + sk, FL, st, run[1], run[2], \"painted_wood_dry\", C.skirting, \"Wood\") end\n\tend\n\tif east then\n\t\t-- (ROBLOX-118: the doorway to the back room is cut through the east wall at z 180..250)\n\t\tlocal DW = Hut.DOORWAY\n\t\tlocal runs: { { number } } = if z0 < DW.z0 and z1 > DW.z1 then { { z0, DW.z0 }, { DW.z1, z1 } } else { { z0, z1 } }\n\t\tlocal s0, s1 = if north then z0 + sk else z0, if south then z1 - sk else z1\n\t\tfor k, run in runs do\n\t\t\tlocal tag = if #runs > 1 then tostring(k) else \"\"\n\t\t\tP(out, id .. \"_wall_e\" .. tag, R.x1, R.x1 + W, FL, top, run[1], run[2], \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\t\t\tlocal a, b = math.max(run[1], s0), math.min(run[2], s1)\n\t\t\tif b - a >= 10 then P(out, id .. \"_skirting_e\" .. tag, R.x1 - sk, R.x1, FL, st, a, b, \"painted_wood_dry\", C.skirting, \"Wood\") end\n\t\tend\n\tend\n\tif north then\n\t\tP(out, id .. \"_skirting_n\", x0, x1, FL, st, R.z0, R.z0 + sk, \"painted_wood_dry\", C.skirting, \"Wood\")\n\t\tif x0 < 0 and x1 > 0 then\n\t\t\t-- the apron: the sill's front face goes on down to the floor\n\t\t\tP(out, id .. \"_apron\", -31, 31, FL, -1, Hut.WALL_SPLIT, R.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\t\tend\n\tend\n\tif id == \"hut_floor_i\" then\n\t\tlocal K = Hut.CADDY\n\t\tP(out, id .. \"_caddy\", K.x0, K.x1, FL, FL + K.h, K.z0, K.z1, \"painted_metal_smooth\", \"4f7d4a\", \"SmoothPlastic\")\n\t\tP(out, id .. \"_caddy_lid\", K.x0 - 0.5, K.x1 + 0.5, FL + K.h, FL + K.h + K.lid, K.z0 - 0.5, K.z1 + 0.5, \"painted_metal_smooth\", \"3f6a3c\", \"SmoothPlastic\")\n\tend\n\tif south then\n\t\tlocal D = Hut.DOOR\n\t\tlocal a, b = math.max(x0, R.x0 + sk), math.min(x1, R.x1 - sk)\n\t\t-- the south wall beside the door (the doorway's jambs are hut_door's)\n\t\tlocal walls: { { number } } = {}\n\t\tif x1 <= -D.jamb then walls = { { x0, x1 } } elseif x0 >= D.jamb then walls = { { x0, x1 } }\n\t\telseif x0 < -D.jamb then walls = { { x0, -D.jamb } } elseif x1 > D.jamb then walls = { { D.jamb, x1 } } end\n\t\tfor k, w in walls do\n\t\t\tP(out, `{id}_wall_s{k}`, w[1], w[2], FL, top, R.z1, R.z1 + W, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\t\t\tlocal s0, s1 = math.max(w[1], a), math.min(w[2], b)\n\t\t\tif s1 > s0 then P(out, `{id}_skirting_s{k}`, s0, s1, FL, st, R.z1 - sk, R.z1, \"painted_wood_dry\", C.skirting, \"Wood\") end\n\t\tend\n\tend\n\treturn out\nend\n\nlocal function deskPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal R, top = Hut.ROOM, Hut.WALL_TOP\n\tP(out, \"hut_desk_wall_low\", 31, R.x1, FL, 14, Hut.WALL_SPLIT, R.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"hut_desk_wall_high\", 31, R.x1, 14, top, Hut.WALL_SPLIT, R.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"hut_desk_top\", 36, 126, 1, 4, R.z0, 72.5, \"varnished_wood_smooth\", C.deskTop, \"Wood\")\n\tfor i, leg in { { 37, 14 }, { 121, 14 }, { 37, 67 }, { 121, 67 } } do\n\t\tP(out, `hut_desk_leg_{i}`, leg[1], leg[1] + 4, FL, 1, leg[2], leg[2] + 4, \"varnished_wood_smooth\", C.desk, \"Wood\")\n\tend\n\tP(out, \"hut_desk_drawer\", 46, 96, -10, 1, 13, 68, \"varnished_wood_smooth\", C.drawer, \"Wood\")\n\tP(out, \"hut_desk_knob\", 69, 73, -6.5, -3.5, 68, 69.5, \"painted_metal_smooth\", C.brass, \"Metal\")\n\tP(out, \"hut_desk_runner\", 41, 96, -12.4, -11.4, 14, 71, \"varnished_wood_smooth\", C.desk, \"Wood\")\n\t-- on the desk: the lamp, the notebook, the mug, the specimen jars and the hand lens\n\tP(out, \"hut_desk_lamp_base\", 104, 116, 4, 5.5, 18, 30, \"painted_metal_smooth\", C.lamp, \"Metal\")\n\tP(out, \"hut_desk_lamp_stem\", 109.2, 110.8, 5.5, 34, 23.2, 24.8, \"painted_metal_smooth\", C.lamp, \"Metal\")\n\tP(out, \"hut_desk_lamp_shade\", 102, 118, 34, 44, 16, 32, \"painted_metal_smooth\", C.lamp, \"Metal\")\n\tP(out, \"hut_desk_notebook\", 52, 73, 4, 5.2, 34, 63.7, \"painted_wood_dry\", C.notebook, \"Fabric\")\n\tP(out, \"hut_desk_mug\", 84, 92, 4, 13.5, 50, 58, \"glass_clean\", C.mug, \"SmoothPlastic\")\n\tfor i, j in { { 44, 9 }, { 52, 11 }, { 60, 7 } } do\n\t\tP(out, `hut_desk_jar_{i}`, j[1], j[1] + 6, 4, 4 + j[2], 14.5, 20.5, \"glass_clean\", C.jar, \"Glass\")\n\tend\n\tP(out, \"hut_desk_lens\", 78, 83, 4, 4.6, 26, 31, \"glass_clean\", C.lens, \"Glass\")\n\tP(out, \"hut_desk_lens_handle\", 83, 91, 4, 4.8, 27.8, 29.2, \"varnished_wood_smooth\", C.handle, \"Wood\")\n\treturn out\nend\n\nlocal function boardPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal R, top = Hut.ROOM, Hut.WALL_TOP\n\tP(out, \"hut_board_wall_low\", R.x0, -31, FL, 14, Hut.WALL_SPLIT, R.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"hut_board_wall_high\", R.x0, -31, 14, top, Hut.WALL_SPLIT, R.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"hut_board_batten_top\", -132, -48, 44, 48, R.z0, R.z0 + 2, \"bare_wood_rough\", C.batten, \"Wood\")\n\tP(out, \"hut_board_batten_bottom\", -132, -48, -6, -2, R.z0, R.z0 + 2, \"bare_wood_rough\", C.batten, \"Wood\")\n\tP(out, \"hut_board_cork\", -134, -46, -8, 50, R.z0 + 2, R.z0 + 4, \"bare_wood_rough\", C.cork, \"Fabric\")\n\treturn out\nend\n\n-- The bookcase's field guides: each a box standing on its shelf, its spine to the room, from the shelf's own stream (the same books forever).\nlocal function shelfPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal x0, x1, z0, z1 = Hut.ROOM.x0, -118.5, 116, 204\n\tP(out, \"hut_shelf_side_n\", x0, x1, FL, 10, z0, z0 + 2, \"varnished_wood_smooth\", C.desk, \"Wood\")\n\tP(out, \"hut_shelf_side_s\", x0, x1, FL, 10, z1 - 2, z1, \"varnished_wood_smooth\", C.desk, \"Wood\")\n\tP(out, \"hut_shelf_top\", x0, x1, 8, 10, z0 + 2, z1 - 2, \"varnished_wood_smooth\", C.deskTop, \"Wood\")\n\tP(out, \"hut_shelf_back\", x0, x0 + 1, -66, 8, z0 + 2, z1 - 2, \"varnished_wood_smooth\", C.drawer, \"Wood\")\n\tP(out, \"hut_shelf_middle\", x0 + 1, x1, -32, -30, z0 + 2, z1 - 2, \"varnished_wood_smooth\", C.deskTop, \"Wood\")\n\tP(out, \"hut_shelf_bottom\", x0 + 1, x1, -66, -64, z0 + 2, z1 - 2, \"varnished_wood_smooth\", C.deskTop, \"Wood\")\n\tP(out, \"hut_shelf_plinth\", x1 - 2, x1, FL, -66, z0 + 2, z1 - 2, \"varnished_wood_smooth\", C.desk, \"Wood\")\n\tlocal rand = rng(region.seed, 3)\n\tfor s, shelf in { { y = -30, top = 8, n = 0 }, { y = -64, top = -32, n = 0 } } do\n\t\tlocal z = z0 + 2.5\n\t\tlocal k = 0\n\t\twhile true do\n\t\t\tlocal thick = between(rand, 1.6, 3.8)\n\t\t\tlocal tall = math.min(between(rand, 18, 26), shelf.top - shelf.y - 2)\n\t\t\tlocal deep = between(rand, 13, 21)\n\t\t\tif z + thick > z1 - 2.5 or k >= 14 then break end\n\t\t\tk += 1\n\t\t\tP(out, `hut_shelf_book_{s}_{k}`, x0 + 1, x0 + 1 + deep, shelf.y, shelf.y + tall, z, z + thick, \"painted_wood_dry\", pick(C.books, rand), \"Fabric\")\n\t\t\tz += thick + (if rand() < 0.15 then between(rand, 2, 6) else 0.05)\n\t\tend\n\tend\n\t-- two lying on the top\n\tP(out, \"hut_shelf_book_top_1\", x0 + 4, x0 + 23, 10, 12.5, 150, 166, \"painted_wood_dry\", C.books[3], \"Fabric\")\n\tP(out, \"hut_shelf_book_top_2\", x0 + 6, x0 + 20, 12.5, 14.2, 152, 163, \"painted_wood_dry\", C.books[6], \"Fabric\")\n\treturn out\nend\n\nlocal function chairPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tP(out, \"hut_chair_seat\", 66, 106, -27, -24, 88, 128, \"varnished_wood_smooth\", C.chair, \"Wood\")\n\tfor i, leg in { { 67, 89 }, { 102, 89 }, { 67, 124 }, { 102, 124 } } do\n\t\tP(out, `hut_chair_leg_{i}`, leg[1], leg[1] + 3, FL, -27, leg[2], leg[2] + 3, \"varnished_wood_smooth\", C.chair, \"Wood\")\n\tend\n\tP(out, \"hut_chair_post_w\", 67, 70, -24, 18, 124, 127, \"varnished_wood_smooth\", C.chair, \"Wood\")\n\tP(out, \"hut_chair_post_e\", 102, 105, -24, 18, 124, 127, \"varnished_wood_smooth\", C.chair, \"Wood\")\n\tP(out, \"hut_chair_rail_top\", 70, 102, 6, 16, 124.5, 126.5, \"varnished_wood_smooth\", C.chair, \"Wood\")\n\tP(out, \"hut_chair_rail_low\", 70, 102, -12, -6, 124.5, 126.5, \"varnished_wood_smooth\", C.chair, \"Wood\")\n\treturn out\nend\n\nlocal function doorPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal D, R = Hut.DOOR, Hut.ROOM\n\tP(out, \"hut_door_jamb_w\", -D.jamb, -D.x, FL, D.top, R.z1, D.outer, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"hut_door_jamb_e\", D.x, D.jamb, FL, D.top, R.z1, D.outer, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"hut_door_threshold\", -D.jamb, D.jamb, FL - 2, FL, R.z1, D.base, \"varnished_wood_smooth\", C.boardDark, \"Wood\")\n\tP(out, \"hut_door_leaf\", -D.x, D.x, FL + D.gap, D.top, D.leaf[1], D.leaf[2], \"painted_wood_dry\", C.trim, \"WoodPlanks\")\n\tP(out, \"hut_door_base\", -D.jamb, D.jamb, GT, FL - 2, D.outer, D.base, \"brick_rough\", C.concrete, \"Concrete\")\n\tP(out, \"hut_door_step\", -D.jamb, D.jamb, GT, D.step.top, D.base, D.step.to, \"brick_rough\", C.concrete, \"Concrete\")\n\tP(out, \"hut_door_soil\", -D.jamb, D.jamb, -87, GT, D.outer, D.gravel, \"brick_rough\", C.gravel, \"Pebble\")\n\treturn out\nend\n\nlocal function windowPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tP(out, \"hut_window_glass\", -31, 31, 14, 112.5, -13.5, -12.5, \"glass_clean\", \"ded7c3\", \"SmoothPlastic\")\n\tP(out, \"hut_window_reveal_w\", -31, -30, 14, 112.5, -12.5, Hut.ROOM.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"hut_window_reveal_e\", 30, 31, 14, 112.5, -12.5, Hut.ROOM.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"hut_window_head\", -31, 31, 112.5, 113.5, -13.5, Hut.ROOM.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\treturn out\nend\n\nlocal function outerPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tP(out, \"hut_outer_sill_board\", -37, 37, -4, 0, -22, -13.5, \"painted_wood_dry\", C.board, \"Wood\")\n\tP(out, \"hut_outer_sill_casing_w\", -37, -31, 0, Hut.OUT_TOP, -17.2, -16, \"painted_wood_dry\", C.trim, \"WoodPlanks\")\n\tP(out, \"hut_outer_sill_casing_e\", 31, 37, 0, Hut.OUT_TOP, -17.2, -16, \"painted_wood_dry\", C.trim, \"WoodPlanks\")\n\treturn out\nend\n\n-- The logs outside: under the outer sill (mid), and west and east of the window to OUT_TOP, standing on the base's lip (the garden's: its row a's cells).\nlocal function wallPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal z0, z1, top = -16, Hut.WALL_SPLIT, Hut.OUT_TOP\n\tif region.id == \"hut_wall_mid\" then\n\t\tP(out, \"hut_wall_mid_logs\", -31, 31, FL, -4, z0, z1, \"bare_wood_rough\", C.log, \"Wood\")\n\t\treturn out\n\tend\n\tlocal s = if region.id == \"hut_wall_w\" then -1 else 1\n\tlocal function box(id: string, a: number, b: number, y0: number, y1: number, za: number, zb: number, profile: string, color: string, material: string)\n\t\tP(out, id, math.min(s * a, s * b), math.max(s * a, s * b), y0, y1, za, zb, profile, color, material)\n\tend\n\tif region.id == \"hut_wall_e\" then\n\t\t-- (ROBLOX-118: in two along the wall, so what meets the back room's logs at x 175 is near the seam)\n\t\tfor k, span in { { 31, 103 }, { 103, 175 } } do\n\t\t\tlocal a = if k == 1 then 37 else 103\n\t\t\tbox(`{region.id}_logs_low{k}`, span[1], span[2], FL, -4, z0, z1, \"bare_wood_rough\", C.log, \"Wood\")\n\t\t\tbox(`{region.id}_logs_side{k}`, a, span[2], -4, 0, z0, z1, \"bare_wood_rough\", C.log, \"Wood\")\n\t\t\tbox(`{region.id}_logs_high{k}`, span[1], span[2], 0, top, z0, z1, \"bare_wood_rough\", C.log, \"Wood\")\n\t\tend\n\t\treturn out\n\tend\n\tbox(region.id .. \"_logs_low\", 31, 175, FL, -4, z0, z1, \"bare_wood_rough\", C.log, \"Wood\")\n\tbox(region.id .. \"_logs_side\", 37, 175, -4, 0, z0, z1, \"bare_wood_rough\", C.log, \"Wood\")\n\tbox(region.id .. \"_logs_high\", 31, 175, 0, top, z0, z1, \"bare_wood_rough\", C.log, \"Wood\")\n\t-- (the corner's log ends, proud of the face; ROBLOX-118: the east end's are the back room's now, Hut.BUILDING.x1)\n\tif region.id == \"hut_wall_w\" then box(region.id .. \"_corner\", 166, 184, FL, top, -25, -16, \"bare_wood_rough\", C.logDark, \"Wood\") end\n\treturn out\nend\n\nlocal function benchPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tP(out, \"hut_bench_seat\", -85, 45, -44, -40, -58, -16, \"painted_wood_dry\", C.board, \"WoodPlanks\")\n\tP(out, \"hut_bench_leg_w\", -80, -74, GT, -44, -55, -22, \"painted_wood_dry\", C.boardDark, \"Wood\")\n\tP(out, \"hut_bench_leg_e\", 33, 39, GT, -44, -55, -22, \"painted_wood_dry\", C.boardDark, \"Wood\")\n\treturn out\nend\n\nlocal function buttPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tP(out, \"hut_butt_stand\", 100, 160, GT, -66, -75, -21, \"brick_rough\", C.concrete, \"Concrete\")\n\tP(out, \"hut_butt_drum\", 101, 159, -66, 26, -77, -19, \"painted_metal_smooth\", C.butt, \"SmoothPlastic\")\n\tP(out, \"hut_butt_lid\", 99, 161, 26, 28.5, -79, -19, \"painted_metal_smooth\", C.buttLid, \"SmoothPlastic\")\n\treturn out\nend\n\nlocal function polePieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal Q = Hut.POLE\n\tif region.id == \"garden_pole\" then\n\t\tP(out, \"garden_pole\", Q.x - Q.half, Q.x + Q.half, GT, GT + Q.split, Q.z - Q.half, Q.z + Q.half, \"painted_metal_smooth\", \"2a2c2e\", \"Metal\")\n\t\treturn out\n\tend\n\tlocal y = GT + Q.top\n\tP(out, \"garden_feeder_pole\", Q.x - Q.half, Q.x + Q.half, GT + Q.split, y, Q.z - Q.half, Q.z + Q.half, \"painted_metal_smooth\", \"2a2c2e\", \"Metal\")\n\tP(out, \"garden_feeder_tray\", Q.x - Q.tray.half, Q.x + Q.tray.half, y, y + Q.tray.thick, Q.z - Q.tray.half, Q.z + Q.tray.half, \"painted_wood_dry\", \"8a6f4e\", \"Wood\")\n\ty += Q.tray.thick\n\tP(out, \"garden_feeder_hopper\", Q.x - Q.hopper.half, Q.x + Q.hopper.half, y, y + Q.hopper.h, Q.z - Q.hopper.half, Q.z + Q.hopper.half, \"glass_clean\", \"c9b48a\", \"Glass\")\n\ty += Q.hopper.h\n\tP(out, \"garden_feeder_roof\", Q.x - Q.roof.half, Q.x + Q.roof.half, y, y + Q.roof.thick, Q.z - Q.roof.half, Q.z + Q.roof.half, \"painted_wood_dry\", \"3f5a43\", \"WoodPlanks\")\n\treturn out\nend\n\n-- A plant's walkable boxes, standing on the soil at `y0`: its stem, its leaves (each a box out from the stem's face, as the dock's), its flowers. Ids `<cell>_<kind>_...`.\ntype Leaf = { h: number, dir: string, l: number, w: number }\nlocal PLANT_SPECS: { [string]: any } = {\n\t-- common milkweed (Asclepias syriaca): 0.6 to 1.5 m, broad opposite leaves 10 to 20 by 5 to 9 cm, pink umbels; a pod by late summer\n\tmilkweed = { stem = 1.2, height = 95, thick = 0.4, leaves = { { h = 22, dir = \"x+\", l = 16, w = 7 }, { h = 22, dir = \"x-\", l = 16, w = 7 }, { h = 40, dir = \"z+\", l = 17, w = 7.5 },\n\t\t{ h = 40, dir = \"z-\", l = 17, w = 7.5 }, { h = 56, dir = \"x+\", l = 15, w = 6.5 }, { h = 56, dir = \"x-\", l = 15, w = 6.5 }, { h = 72, dir = \"z+\", l = 13, w = 6 }, { h = 72, dir = \"z-\", l = 13, w = 6 } },\n\t\thead = { w = 7, h = 5 }, pod = { h = 38, l = 10, w = 2.4 }, color = C.stem, leaf = C.milkweedLeaf, flower = C.umbel },\n\t-- purple coneflower (Echinacea purpurea): 0.6 to 1.2 m, basal leaves to 15 cm, a head 7 to 12 cm across round an orange-brown cone\n\tconeflower = { stem = 0.8, height = 70, thick = 0.3, leaves = { { h = 24, dir = \"x+\", l = 10, w = 3 }, { h = 44, dir = \"z-\", l = 9, w = 2.8 } }, basal = { l = 14, w = 5 },\n\t\thead = { w = 9, h = 0.6 }, cone = { w = 3.5, h = 3 }, color = C.stem, leaf = C.leaf, flower = C.petal },\n\t-- wild bergamot, bee balm (Monarda fistulosa): 0.6 to 1.2 m, square stems, opposite leaves 5 to 10 cm, a lavender head 3 to 5 cm\n\tbeebalm = { stem = 0.7, height = 80, thick = 0.3, leaves = { { h = 20, dir = \"x+\", l = 8, w = 3 }, { h = 20, dir = \"x-\", l = 8, w = 3 }, { h = 36, dir = \"z+\", l = 8, w = 3 },\n\t\t{ h = 36, dir = \"z-\", l = 8, w = 3 }, { h = 52, dir = \"x+\", l = 7, w = 2.6 }, { h = 52, dir = \"x-\", l = 7, w = 2.6 }, { h = 66, dir = \"z+\", l = 6, w = 2.4 }, { h = 66, dir = \"z-\", l = 6, w = 2.4 } },\n\t\thead = { w = 4.5, h = 4 }, color = \"6a7a4a\", leaf = C.leaf, flower = C.monarda },\n\t-- Canada goldenrod (Solidago canadensis): 0.6 to 1.5 m, narrow alternate leaves 8 to 12 cm, a yellow plume\n\tgoldenrod = { stem = 0.8, height = 85, thick = 0.25, leaves = { { h = 18, dir = \"x+\", l = 11, w = 1.6 }, { h = 27, dir = \"z-\", l = 11, w = 1.6 }, { h = 36, dir = \"x-\", l = 11, w = 1.6 },\n\t\t{ h = 45, dir = \"z+\", l = 10, w = 1.5 }, { h = 54, dir = \"x+\", l = 10, w = 1.5 }, { h = 63, dir = \"z-\", l = 9, w = 1.4 }, { h = 72, dir = \"x-\", l = 9, w = 1.4 } },\n\t\thead = { w = 3, h = 16, d = 3 }, color = \"6f7f45\", leaf = C.goldenLeaf, flower = C.goldenrod },\n}\nHut.PLANT_SPECS = PLANT_SPECS\n\n-- (ROBLOX-117: a second plant of a kind in a cell is `tag` \"2\" and may stand `scale` of the first's height; its ids `<cell>_<kind>2_...`)\nlocal function plantPieces(out: { Piece }, id: string, plant: { kind: string, x: number, z: number, scale: number? }, y0: number, tag: string?)\n\tlocal spec = PLANT_SPECS[plant.kind]\n\tlocal half = spec.stem / 2\n\tlocal k = plant.scale or 1\n\tlocal sx0, sx1, sz0, sz1 = plant.x - half, plant.x + half, plant.z - half, plant.z + half\n\tlocal base = `{id}_{plant.kind}{tag or \"\"}`\n\tP(out, base .. \"_stem\", sx0, sx1, y0, y0 + spec.height * k, sz0, sz1, \"leaf_dry_prototype\", spec.color)\n\tfor i, leaf in spec.leaves :: { Leaf } do\n\t\tlocal ya, yb = y0 + leaf.h * k, y0 + leaf.h * k + spec.thick\n\t\tlocal w = leaf.w / 2\n\t\tif leaf.dir == \"x+\" then P(out, `{base}_leaf_{i}`, sx1, sx1 + leaf.l, ya, yb, plant.z - w, plant.z + w, \"leaf_dry_prototype\", spec.leaf)\n\t\telseif leaf.dir == \"x-\" then P(out, `{base}_leaf_{i}`, sx0 - leaf.l, sx0, ya, yb, plant.z - w, plant.z + w, \"leaf_dry_prototype\", spec.leaf)\n\t\telseif leaf.dir == \"z+\" then P(out, `{base}_leaf_{i}`, plant.x - w, plant.x + w, ya, yb, sz1, sz1 + leaf.l, \"leaf_dry_prototype\", spec.leaf)\n\t\telse P(out, `{base}_leaf_{i}`, plant.x - w, plant.x + w, ya, yb, sz0 - leaf.l, sz0, \"leaf_dry_prototype\", spec.leaf) end\n\tend\n\tlocal top = y0 + spec.height * k\n\tlocal H = spec.head\n\tif plant.kind == \"coneflower\" then\n\t\t-- the basal rosette on the soil (clear of the stem, as the dandelion's), the ray of petals and the cone over it\n\t\tlocal B = spec.basal\n\t\tlocal gap = B.w / 2 + 0.3 -- (each clear of the others' ends)\n\t\tlocal w = B.w / 2\n\t\tP(out, base .. \"_basal_1\", sx1 + gap, sx1 + gap + B.l, y0, y0 + 0.3, plant.z - w, plant.z + w, \"leaf_dry_prototype\", spec.leaf)\n\t\tP(out, base .. \"_basal_2\", sx0 - gap - B.l, sx0 - gap, y0, y0 + 0.3, plant.z - w, plant.z + w, \"leaf_dry_prototype\", spec.leaf)\n\t\tP(out, base .. \"_basal_3\", plant.x - w, plant.x + w, y0, y0 + 0.3, sz1 + gap, sz1 + gap + B.l, \"leaf_dry_prototype\", spec.leaf)\n\t\tP(out, base .. \"_head\", plant.x - H.w / 2, plant.x + H.w / 2, top, top + H.h, plant.z - H.w / 2, plant.z + H.w / 2, \"leaf_dry_prototype\", spec.flower)\n\t\tP(out, base .. \"_cone\", plant.x - spec.cone.w / 2, plant.x + spec.cone.w / 2, top + H.h, top + H.h + spec.cone.h, plant.z - spec.cone.w / 2, plant.z + spec.cone.w / 2, \"leaf_dry_prototype\", C.cone)\n\telseif plant.kind == \"goldenrod\" then\n\t\tP(out, base .. \"_head\", plant.x - H.w / 2, plant.x + H.w / 2, top, top + H.h, plant.z - H.d / 2, plant.z + H.d / 2, \"leaf_dry_prototype\", spec.flower)\n\telse\n\t\tP(out, base .. \"_head\", plant.x - H.w / 2, plant.x + H.w / 2, top, top + H.h, plant.z - H.w / 2, plant.z + H.w / 2, \"leaf_dry_prototype\", spec.flower)\n\tend\n\tif spec.pod ~= nil and tag == nil then\n\t\t-- the milkweed's pod, against the stem's east face between the first and second pairs of leaves\n\t\tlocal Q = spec.pod\n\t\tP(out, base .. \"_pod\", sx1, sx1 + Q.w, y0 + Q.h - Q.l, y0 + Q.h, sz0, sz0 + Q.w, \"leaf_dry_prototype\", C.pod)\n\tend\nend\n\nHut.plantPieces = plantPieces -- (ROBLOX-119: World/Meadow's plants of the same kinds)\n\n-- A low herb of the herb bed: chives (a clump of stalks and two flower heads), sage (a mound), thyme (a mat).\nlocal function herbPieces(out: { Piece }, id: string, kind: string, x: number, z: number, y0: number)\n\tlocal base = `{id}_{kind}`\n\tif kind == \"chives\" then\n\t\tfor i, o in { { 0, 0 }, { 3, 1.2 }, { -2.6, 2 }, { 1, -3 }, { -2, -2.4 } } do\n\t\t\tlocal h = 22 + i * 1.5\n\t\t\tP(out, `{base}_stalk_{i}`, x + o[1] - 0.25, x + o[1] + 0.25, y0, y0 + h, z + o[2] - 0.25, z + o[2] + 0.25, \"leaf_dry_prototype\", C.chive)\n\t\t\tif i <= 2 then P(out, `{base}_flower_{i}`, x + o[1] - 1.1, x + o[1] + 1.1, y0 + h, y0 + h + 2.2, z + o[2] - 1.1, z + o[2] + 1.1, \"leaf_dry_prototype\", C.chiveFlower) end\n\t\tend\n\telseif kind == \"sage\" then\n\t\tP(out, base, x - 12, x + 12, y0, y0 + 16, z - 10, z + 10, \"leaf_dry_prototype\", C.sage)\n\telse\n\t\tP(out, base, x - 15, x + 15, y0, y0 + 4, z - 14, z + 14, \"leaf_dry_prototype\", C.thyme)\n\tend\nend\nlocal HERBS: { [string]: { { kind: string, x: number, z: number } } } = {\n\tgarden_c1 = { { kind = \"chives\", x = -150, z = -262 }, { kind = \"sage\", x = -128, z = -292 } },\n\tgarden_d1 = { { kind = \"thyme\", x = -165, z = -345 }, { kind = \"sage\", x = -125, z = -372 } },\n}\n\nlocal EDGING_RUN = 25 -- the path's brick edging, laid in lengths of this many studs at most\nlocal function gardenPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal id = region.id\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal cx0, cx1, cz0, cz1 = lo.X, hi.X, lo.Z, hi.Z\n\tP(out, id .. \"_soil\", cx0, cx1, -87, GT, cz0, cz1, \"brick_rough\", C.lawn, \"Grass\") -- (the lawn: the path and the drip strip are drawn on it)\n\t-- the hut's concrete base where it shows under the logs (x -178..178, the north face's lip 3 cm proud)\n\tdo\n\t\tlocal a, b = clip(-178, 178, -19, -16, cx0, cx1, cz0, cz1)\n\t\tif a ~= nil then P(out, id .. \"_hut_base\", a, b :: number, GT, FL, -19, -16, \"brick_rough\", C.concrete, \"Concrete\") end\n\tend\n\t-- the raised beds: their timber edging and their soil, the part of each inside this cell\n\tlocal E = Hut.EDGING\n\tfor name, b in { pollinator = Hut.POLLINATOR, herbs = Hut.HERBS } :: { [string]: any } do\n\t\tlocal sides = {\n\t\t\t{ b.x0, b.x1, b.z0, b.z0 + E.thick }, { b.x0, b.x1, b.z1 - E.thick, b.z1 },\n\t\t\t{ b.x0, b.x0 + E.thick, b.z0 + E.thick, b.z1 - E.thick }, { b.x1 - E.thick, b.x1, b.z0 + E.thick, b.z1 - E.thick },\n\t\t}\n\t\tfor k, s in sides do\n\t\t\tlocal a, bb, c, d = clip(s[1], s[2], s[3], s[4], cx0, cx1, cz0, cz1)\n\t\t\tif a ~= nil then P(out, `{id}_{name}_edge_{k}`, a, bb :: number, GT, GT + E.top, c :: number, d :: number, \"bare_wood_rough\", C.edging, \"Wood\") end\n\t\tend\n\t\tlocal a, bb, c, d = clip(b.x0 + E.thick, b.x1 - E.thick, b.z0 + E.thick, b.z1 - E.thick, cx0, cx1, cz0, cz1)\n\t\tif a ~= nil then P(out, `{id}_{name}_bed`, a, bb :: number, GT, S, c :: number, d :: number, \"brick_rough\", if name == \"pollinator\" then C.mulch else C.soil, \"Ground\") end\n\tend\n\t-- the path's brick edging: along the east-west path's north side and its south side east of the north-south path, and the north-south path's sides\n\tlocal Pa = Hut.PATH\n\tlocal runs = {\n\t\t{ Pa.ew.x0 + Pa.brick, Pa.ew.x1, Pa.ew.z1, Pa.ew.z1 + Pa.brick }, -- the north side (toward the hut), from the corner east\n\t\t{ Pa.ns.x1, Pa.ew.x1, Pa.ew.z0 - Pa.brick, Pa.ew.z0 }, -- the south side, east of the north-south path\n\t\t{ Pa.ns.x0 - Pa.brick, Pa.ns.x0, Pa.ns.z0, Pa.ew.z1 + Pa.brick }, -- the north-south path's west side, from the north edge to the corner\n\t\t{ Pa.ns.x1, Pa.ns.x1 + Pa.brick, Pa.ns.z0, Pa.ew.z0 - Pa.brick }, -- and its east side, to the east-west path's south side\n\t}\n\t-- (laid in lengths of at most EDGING_RUN, each a box of its own: a region whole in the streaming radius has no long box reaching across its neighbour's)\n\tfor k, s in runs do\n\t\tlocal a, bb, c, d = clip(s[1], s[2], s[3], s[4], cx0, cx1, cz0, cz1)\n\t\tif a ~= nil then\n\t\t\tlocal x1, z1 = bb :: number, d :: number\n\t\t\tlocal alongX = x1 - a >= z1 - (c :: number)\n\t\t\tlocal from, to = if alongX then a else c :: number, if alongX then x1 else z1\n\t\t\tlocal n = math.ceil((to - from) / EDGING_RUN - 1e-9)\n\t\t\tfor j = 1, n do\n\t\t\t\tlocal t0, t1 = from + (to - from) * (j - 1) / n, from + (to - from) * j / n\n\t\t\t\tif alongX then P(out, `{id}_edging_{k}_{j}`, t0, t1, GT, GT + Pa.brickH, c :: number, z1, \"brick_rough\", C.brick[1 + (j % #C.brick)], \"Brick\")\n\t\t\t\telse P(out, `{id}_edging_{k}_{j}`, a, x1, GT, GT + Pa.brickH, t0, t1, \"brick_rough\", C.brick[1 + (j % #C.brick)], \"Brick\") end\n\t\t\tend\n\t\tend\n\tend\n\t-- what stands in this cell\n\tif id == \"garden_a1\" then\n\t\tlocal T = Hut.TROUGH\n\t\tP(out, id .. \"_trough_foot_w\", T.x0, T.x0 + T.foot, GT, GT + T.feet, T.z0, T.z1, \"brick_rough\", C.brick[2], \"Brick\")\n\t\tP(out, id .. \"_trough_foot_e\", T.x1 - T.foot, T.x1, GT, GT + T.feet, T.z0, T.z1, \"brick_rough\", C.brick[3], \"Brick\")\n\t\tP(out, id .. \"_trough\", T.x0, T.x1, GT + T.feet, GT + T.top, T.z0, T.z1, \"bare_wood_rough\", C.board, \"Wood\")\n\t\tlocal r = T.rim\n\t\tP(out, id .. \"_trough_rim_n\", T.x0, T.x1, GT + T.top, GT + T.top + r, T.z0, T.z0 + r, \"bare_wood_rough\", C.boardDark, \"Wood\")\n\t\tP(out, id .. \"_trough_rim_s\", T.x0, T.x1, GT + T.top, GT + T.top + r, T.z1 - r, T.z1, \"bare_wood_rough\", C.boardDark, \"Wood\")\n\t\tP(out, id .. \"_trough_rim_w\", T.x0, T.x0 + r, GT + T.top, GT + T.top + r, T.z0 + r, T.z1 - r, \"bare_wood_rough\", C.boardDark, \"Wood\")\n\t\tP(out, id .. \"_trough_rim_e\", T.x1 - r, T.x1, GT + T.top, GT + T.top + r, T.z0 + r, T.z1 - r, \"bare_wood_rough\", C.boardDark, \"Wood\")\n\t\t-- a parsley and a basil in it\n\t\tP(out, id .. \"_trough_herb_1\", -156, -142, GT + T.top, GT + T.top + 12, -50, -36, \"leaf_dry_prototype\", C.leafPale)\n\t\tP(out, id .. \"_trough_herb_2\", -126, -110, GT + T.top, GT + T.top + 9, -48, -32, \"leaf_dry_prototype\", C.leaf)\n\telseif id == \"garden_a3\" then\n\t\tlocal St = Hut.STONE\n\t\tP(out, id .. \"_stone_rest_w\", St.x0, St.x0 + St.rest, GT, GT + St.gap, St.z0, St.z1, \"brick_rough\", \"8f887b\", \"Slate\")\n\t\tP(out, id .. \"_stone_rest_e\", St.x1 - St.rest, St.x1, GT, GT + St.gap, St.z0, St.z1, \"brick_rough\", \"8f887b\", \"Slate\")\n\t\tP(out, id .. \"_stone_top\", St.x0, St.x1, GT + St.gap, GT + St.gap + St.thick, St.z0, St.z1, \"brick_rough\", C.stone[2], \"Slate\")\n\telseif id == \"garden_d3\" then\n\t\tlocal Ch = Hut.CHIP\n\t\tP(out, id .. \"_chip_rest_w\", Ch.x0, Ch.x0 + Ch.rest, S, S + Ch.gap, Ch.z0, Ch.z1, \"bare_wood_rough\", C.mulchColors[3], \"Wood\")\n\t\tP(out, id .. \"_chip_rest_e\", Ch.x1 - Ch.rest, Ch.x1, S, S + Ch.gap, Ch.z0, Ch.z1, \"bare_wood_rough\", C.mulchColors[5], \"Wood\")\n\t\tP(out, id .. \"_chip\", Ch.x0, Ch.x1, S + Ch.gap, S + Ch.gap + Ch.thick, Ch.z0, Ch.z1, \"bare_wood_rough\", C.mulchColors[2], \"Wood\")\n\t\tP(out, id .. \"_stone_a\", 20, 32, S, S + 2.4, -330, -320, \"brick_rough\", C.stone[1], \"Slate\") -- (a stone half sunk in the mulch)\n\telseif id == \"garden_c3\" then\n\t\tP(out, id .. \"_stone_a\", 5, 17, S, S + 1.8, -300, -290, \"brick_rough\", C.stone[3], \"Slate\")\n\tend\n\tlocal plant = PLANTS[id]\n\tif plant ~= nil then plantPieces(out, id, plant, S) end\n\tlocal more = MORE_PLANTS[id]\n\tif more ~= nil then plantPieces(out, id, more, S, \"2\") end\n\tlocal herbs = HERBS[id]\n\tif herbs ~= nil then for _, h in herbs do herbPieces(out, id, h.kind, h.x, h.z, S) end end\n\treturn out\nend\n\n-- (ROBLOX-117) A length of the path round the east end: its gravel, one box (the stones are the patches' look).\nlocal function pathPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tP(out, region.id .. \"_gravel\", lo.X, hi.X, -87, GT, lo.Z, hi.Z, \"brick_rough\", C.gravel, \"Pebble\")\n\treturn out\nend\n\n-- ---------------------------------------------------------------- (ROBLOX-118) the ceiling, the back room and the outside to the eaves\nlocal LINING_W = 10 -- a lining's box depth into its wall (the hut's floor cells' W)\n-- An upper cell: the ceiling's boards over it, the joists under them, and the walls' linings from WALL_TOP to the ceiling on its sides (cut round the window's head,\n-- the door's head and the doorway).\nlocal function upperPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal U = UPPER[region.id]\n\tlocal id = region.id\n\tlocal hut = U.room == \"hut\"\n\tlocal Rm = if hut then Hut.ROOM else Hut.BACK\n\tlocal T, CE, W = Hut.WALL_TOP, Hut.CEIL, LINING_W\n\tlocal DW = Hut.DOORWAY\n\tP(out, id .. \"_ceiling\", U.x0, U.x1, CE, CE + 2, U.z0, U.z1, \"painted_wood_dry\", C.ceiling, \"WoodPlanks\")\n\tlocal J = Hut.JOISTS\n\tfor k, x in (if hut then J.hut else J.back) :: { number } do\n\t\tif x - J.w / 2 > U.x0 and x + J.w / 2 < U.x1 then P(out, `{id}_joist_{k}`, x - J.w / 2, x + J.w / 2, CE - J.d, CE, U.z0, U.z1, \"bare_wood_rough\", C.joist, \"Wood\") end\n\tend\n\t-- a wall's lining from T to the ceiling along z (x a..b) with the doorway's opening cut out of it where it is\n\tlocal function alongZ(tag: string, a: number, b: number, cut: boolean, y0: number?)\n\t\tif cut then\n\t\t\tif DW.z0 > U.z0 then P(out, `{id}_{tag}1`, a, b, T, CE, U.z0, DW.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\") end\n\t\t\tif DW.z1 < U.z1 then P(out, `{id}_{tag}2`, a, b, T, CE, DW.z1, U.z1, \"painted_wood_dry\", C.lining, \"WoodPlanks\") end\n\t\telse\n\t\t\tP(out, `{id}_{tag}`, a, b, y0 or T, CE, U.z0, U.z1, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\t\tend\n\tend\n\tif U.x0 == Rm.x0 then alongZ(\"wall_w\", Rm.x0 - W, Rm.x0, not hut and U.z0 < DW.z0 and U.z1 > DW.z1) end\n\tif U.x1 == Rm.x1 then\n\t\tlocal window = not hut and U.z0 <= Hut.ROOM_WINDOW.z0 and U.z1 >= Hut.ROOM_WINDOW.z1\n\t\talongZ(\"wall_e\", Rm.x1, Rm.x1 + W, hut and U.z0 < DW.z0 and U.z1 > DW.z1, if window then Hut.ROOM_WINDOW.top else nil)\n\tend\n\tif U.z0 == Rm.z0 then\n\t\tlocal z0 = if hut then Hut.WALL_SPLIT else Rm.z0 - W\n\t\tif hut then\n\t\t\t-- (beside the window to the ceiling, and over its head)\n\t\t\tif U.x0 < -31 then P(out, id .. \"_wall_n\", U.x0, math.min(U.x1, -31), T, CE, z0, Rm.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\") end\n\t\t\tif U.x1 > 31 then P(out, id .. \"_wall_n2\", math.max(U.x0, 31), U.x1, T, CE, z0, Rm.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\") end\n\t\t\tlocal a, b = math.max(U.x0, -31), math.min(U.x1, 31)\n\t\t\tif b > a then P(out, id .. \"_over_window\", a, b, 113.5, CE, z0, Rm.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\") end\n\t\telse\n\t\t\tP(out, id .. \"_wall_n\", U.x0, U.x1, T, CE, z0, Rm.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\t\tend\n\tend\n\tif U.z1 == Rm.z1 then\n\t\tlocal D = Hut.DOOR\n\t\tlocal runs = { { U.x0, U.x1 } }\n\t\tif hut then\n\t\t\truns = {}\n\t\t\tif U.x0 < -D.jamb then table.insert(runs, { U.x0, math.min(U.x1, -D.jamb) }) end\n\t\t\tif U.x1 > D.jamb then table.insert(runs, { math.max(U.x0, D.jamb), U.x1 }) end\n\t\tend\n\t\tfor k, run in runs do P(out, `{id}_wall_s{k}`, run[1], run[2], T, CE, Rm.z1, Rm.z1 + W, \"painted_wood_dry\", C.lining, \"WoodPlanks\") end\n\tend\n\treturn out\nend\n\n-- The back room's floor in a cell: the boards, the linings to WALL_TOP and the skirting (the doorway cut out of the west wall's, the window's sill and reveals over\n-- the east wall's in its row), the rug, the radiator under the window, the cables along the skirting and their sockets.\nlocal function roomFloorPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal id = region.id\n\tlocal B, DW, T, W, sk = Hut.BACK, Hut.DOORWAY, Hut.WALL_TOP, LINING_W, 1.5\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal x0, x1, z0, z1 = lo.X, hi.X, lo.Z, hi.Z\n\tlocal st = FL + 10\n\tP(out, id .. \"_boards\", x0, x1, FL - 2, FL, z0, z1, \"varnished_wood_smooth\", C.floor, \"WoodPlanks\")\n\tlocal west, east, north, south = x0 == B.x0, x1 == B.x1, z0 == B.z0, z1 == B.z1\n\tlocal s0, s1 = if north then z0 + sk else z0, if south then z1 - sk else z1\n\tif west then\n\t\tlocal door = z0 < DW.z0 and z1 > DW.z1\n\t\tlocal runs: { { number } } = if door then { { z0, DW.z0 }, { DW.z1, z1 } } else { { z0, z1 } }\n\t\tfor k, run in runs do\n\t\t\tP(out, `{id}_wall_w{k}`, B.x0 - W, B.x0, FL, T, run[1], run[2], \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\t\t\tlocal a, b = math.max(run[1], s0), math.min(run[2], s1)\n\t\t\tif b - a >= 10 then P(out, `{id}_skirting_w{k}`, B.x0, B.x0 + sk, FL, st, a, b, \"painted_wood_dry\", C.skirting, \"Wood\") end\n\t\tend\n\tend\n\tif east then\n\t\tlocal window = z0 <= Hut.ROOM_WINDOW.z0 and z1 >= Hut.ROOM_WINDOW.z1\n\t\tP(out, id .. \"_wall_e\", B.x1, B.x1 + W, FL, if window then -3 else T, z0, z1, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\t\tP(out, id .. \"_skirting_e\", B.x1 - sk, B.x1, FL, st, s0, s1, \"painted_wood_dry\", C.skirting, \"Wood\")\n\tend\n\tif north then\n\t\tP(out, id .. \"_wall_n\", x0, x1, FL, T, B.z0 - W, B.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\t\tP(out, id .. \"_skirting_n\", x0, x1, FL, st, B.z0, B.z0 + sk, \"painted_wood_dry\", C.skirting, \"Wood\")\n\tend\n\tif south then\n\t\tP(out, id .. \"_wall_s\", x0, x1, FL, T, B.z1, B.z1 + W, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\t\tlocal a, b = math.max(x0, B.x0 + sk), math.min(x1, B.x1 - sk)\n\t\tP(out, id .. \"_skirting_s\", a, b, FL, st, B.z1 - sk, B.z1, \"painted_wood_dry\", C.skirting, \"Wood\")\n\tend\n\t-- the rug, where it lies in this cell\n\tlocal G = Hut.RUG\n\tlocal a, b, c, d = clip(G.x0, G.x1, G.z0, G.z1, x0, x1, z0, z1)\n\tif a ~= nil then P(out, id .. \"_rug\", a, b :: number, FL, FL + G.top, c :: number, d :: number, \"painted_wood_dry\", C.rug, \"Fabric\") end\n\tif id == \"room_floor_a\" then\n\t\t-- the television's cable: from its unit along the floor to the skirting, along it, up to the socket on the west wall\n\t\tP(out, id .. \"_socket\", B.x0, B.x0 + 0.8, -55, -47, 56, 64, \"painted_metal_smooth\", \"e8e4da\", \"SmoothPlastic\")\n\t\tP(out, id .. \"_plug\", B.x0 + 0.8, B.x0 + 1.5, -53, -49, 58, 62, \"painted_metal_smooth\", \"2a2724\", \"SmoothPlastic\")\n\t\tP(out, id .. \"_cable_up\", B.x0 + 1.5, B.x0 + 2.1, FL, -53, 59.7, 60.3, \"painted_metal_smooth\", C.cable, \"SmoothPlastic\")\n\t\tP(out, id .. \"_cable_run\", B.x0 + 1.5, B.x0 + 2.1, FL, FL + 0.6, 30, 59.7, \"painted_metal_smooth\", C.cable, \"SmoothPlastic\")\n\t\tP(out, id .. \"_cable_in\", B.x0 + 2.1, Hut.TV.x0, FL, FL + 0.6, 30, 30.6, \"painted_metal_smooth\", C.cable, \"SmoothPlastic\")\n\telseif id == \"room_floor_f\" then\n\t\t-- the oil-filled radiator under the window: its fins on a spine on two feet, its control box at the south end; its cord to the skirting\n\t\tlocal H = Hut.HEATER\n\t\tfor k, z in { 106, 148 } do P(out, `{id}_heater_foot{k}`, H.x0 - 2, H.x1 + 2, FL, FL + 4, z, z + 2, \"painted_metal_smooth\", C.heaterDark, \"Metal\") end\n\t\tP(out, id .. \"_heater_spine\", 431, 435, FL + 4, FL + 8, 102, 155.4, \"painted_metal_smooth\", C.heater, \"Metal\")\n\t\tfor k = 0, H.fins - 1 do\n\t\t\tlocal z = 102 + k * 8.5\n\t\t\tP(out, `{id}_heater_fin{k + 1}`, H.x0, H.x1, FL + 8, H.top, z, z + 2.4, \"painted_metal_smooth\", C.heater, \"Metal\")\n\t\tend\n\t\tP(out, id .. \"_heater_box\", 427, 439, -60, -12, 157, 163, \"painted_metal_smooth\", C.heater, \"Metal\")\n\t\tP(out, id .. \"_heater_cord\", 439, B.x1 - sk - 0.6, FL, FL + 0.6, 159.7, 160.3, \"painted_metal_smooth\", C.cable, \"SmoothPlastic\")\n\t\tP(out, id .. \"_heater_cord2\", B.x1 - sk - 0.6, B.x1 - sk, FL, FL + 0.6, 160.3, 169.7, \"painted_metal_smooth\", C.cable, \"SmoothPlastic\")\n\t\tP(out, id .. \"_heater_cord_up\", B.x1 - sk - 0.6, B.x1 - sk, FL, -53, 169.7, 170.3, \"painted_metal_smooth\", C.cable, \"SmoothPlastic\")\n\t\tP(out, id .. \"_plug\", B.x1 - sk, B.x1 - 0.8, -53, -49, 168, 172, \"painted_metal_smooth\", \"2a2724\", \"SmoothPlastic\")\n\t\tP(out, id .. \"_socket\", B.x1 - 0.8, B.x1, -55, -47, 166, 174, \"painted_metal_smooth\", \"e8e4da\", \"SmoothPlastic\")\n\tend\n\treturn out\nend\n\n-- The doorway through the hut's old east logs: its threshold, the logs' cut ends either side (between the two rooms' linings) and its head to the ceiling.\nlocal function doorwayPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal DW, B, T = Hut.DOORWAY, Hut.BACK, Hut.WALL_TOP\n\tlocal id = region.id\n\tif id == \"hut_doorway\" then\n\t\tP(out, id .. \"_threshold\", DW.x0, DW.x1, FL - 2, FL, DW.z0, DW.z1, \"varnished_wood_smooth\", C.boardDark, \"Wood\")\n\t\tP(out, id .. \"_log_n\", DW.core[1], DW.core[2], FL, T, Hut.ROWS[3], DW.z0, \"bare_wood_rough\", C.log, \"Wood\")\n\t\tP(out, id .. \"_log_s\", DW.core[1], DW.core[2], FL, T, DW.z1, B.z1, \"bare_wood_rough\", C.log, \"Wood\")\n\telse\n\t\tP(out, id .. \"_log_n\", DW.core[1], DW.core[2], T, Hut.CEIL, Hut.ROWS[3], DW.z0, \"bare_wood_rough\", C.log, \"Wood\")\n\t\tP(out, id .. \"_log_s\", DW.core[1], DW.core[2], T, Hut.CEIL, DW.z1, B.z1, \"bare_wood_rough\", C.log, \"Wood\")\n\t\tP(out, id .. \"_head\", DW.x0, DW.x1, DW.head, Hut.CEIL, DW.z0, DW.z1, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tend\n\treturn out\nend\n\n-- The front door above the height its region below keeps (Hut.DOOR.top): its leaf, its jambs to its head, and the wall over it to the ceiling.\nlocal function doorUpPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal D, R = Hut.DOOR, Hut.ROOM\n\tlocal head = Hut.DOORWAY.head\n\tP(out, \"hut_door_up_leaf\", -D.x, D.x, D.top, head, D.leaf[1], D.leaf[2], \"painted_wood_dry\", C.trim, \"WoodPlanks\")\n\tP(out, \"hut_door_up_jamb_w\", -D.jamb, -D.x, D.top, head, R.z1, D.outer, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"hut_door_up_jamb_e\", D.x, D.jamb, D.top, head, R.z1, D.outer, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"hut_door_up_head\", -D.jamb, D.jamb, head, Hut.CEIL, R.z1, D.outer, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\treturn out\nend\n\n-- The sofa, a half of it (`west`): its legs, its frame, its arm, its seat cushion, its back and the back's cushion; on the west half's cushion, the controller.\nlocal function sofaPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal S0 = Hut.SOFA\n\tlocal west = region.id == \"room_sofa_w\"\n\tlocal id = region.id\n\tlocal xa, xb = if west then S0.x0 else S0.split, if west then S0.split else S0.x1\n\tlocal lx = if west then S0.x0 + 3 else S0.x1 - 9\n\tfor k, z in { S0.z0 + 2.5, S0.z1 - 8 } do P(out, `{id}_leg{k}`, lx, lx + 6, FL, S0.leg, z, z + 6, \"varnished_wood_smooth\", C.chair, \"Wood\") end\n\tP(out, id .. \"_frame\", xa, xb, S0.leg, S0.frame, S0.z0, S0.z1, \"painted_wood_dry\", C.sofaDark, \"Fabric\")\n\tlocal ax0, ax1 = if west then S0.x0 else S0.x1 - S0.arm, if west then S0.x0 + S0.arm else S0.x1\n\tP(out, id .. \"_arm\", ax0, ax1, S0.frame, S0.armTop, S0.z0, S0.z1, \"painted_wood_dry\", C.sofa, \"Fabric\")\n\tlocal ia, ib = if west then S0.x0 + S0.arm else S0.split, if west then S0.split else S0.x1 - S0.arm\n\tP(out, id .. \"_cushion\", if west then ia else ia + 0.5, if west then ib - 0.5 else ib, S0.frame, S0.seat, S0.z0 + 2.5, 236, \"painted_wood_dry\", C.sofa, \"Fabric\")\n\tP(out, id .. \"_back\", ia, ib, S0.frame, S0.back, 236, S0.z1, \"painted_wood_dry\", C.sofaDark, \"Fabric\")\n\tP(out, id .. \"_back_cushion\", if west then ia + 2 else ia + 0.5, if west then ib - 0.5 else ib - 2, S0.seat, S0.back - 5, 228, 236, \"painted_wood_dry\", C.sofa, \"Fabric\")\n\tif west then P(out, id .. \"_controller\", 280, 295, S0.seat, S0.seat + 4, 196, 206, \"painted_metal_smooth\", C.controller, \"SmoothPlastic\") end\n\treturn out\nend\n\n-- The low unit against the north wall with the television on its stand on it, and the games console on the unit's lower shelf.\nlocal function tvPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal V = Hut.TV\n\tlocal Sc = V.screen\n\tP(out, \"room_tv_base\", V.x0, V.x1, FL, -66, V.z0, V.z1, \"varnished_wood_smooth\", C.unitDark, \"Wood\")\n\tP(out, \"room_tv_side_w\", V.x0, V.x0 + 2, -66, V.top - 2, V.z0, V.z1, \"varnished_wood_smooth\", C.unit, \"Wood\")\n\tP(out, \"room_tv_side_e\", V.x1 - 2, V.x1, -66, V.top - 2, V.z0, V.z1, \"varnished_wood_smooth\", C.unit, \"Wood\")\n\tP(out, \"room_tv_back\", V.x0 + 2, V.x1 - 2, -66, V.top - 2, V.z0, V.z0 + 1.5, \"varnished_wood_smooth\", C.unitDark, \"Wood\")\n\tP(out, \"room_tv_shelf\", V.x0 + 2, V.x1 - 2, -46, -44, V.z0 + 1.5, V.z1, \"varnished_wood_smooth\", C.unit, \"Wood\")\n\tP(out, \"room_tv_top\", V.x0, V.x1, V.top - 2, V.top, V.z0, V.z1, \"varnished_wood_smooth\", C.unit, \"Wood\")\n\tP(out, \"room_tv_console\", 195, 225, -66, -60, 22, 47, \"painted_metal_smooth\", C.console, \"SmoothPlastic\")\n\tP(out, \"room_tv_foot\", 215, 245, V.top, V.top + 1, 22, 36, \"painted_metal_smooth\", C.screen, \"Metal\")\n\tP(out, \"room_tv_neck\", 228, 232, V.top + 1, Sc.y0, 26, 29, \"painted_metal_smooth\", C.screen, \"Metal\")\n\tP(out, \"room_tv_screen\", Sc.x0, Sc.x1, Sc.y0, Sc.y1, Sc.z0, Sc.z1, \"painted_metal_smooth\", C.screen, \"SmoothPlastic\")\n\treturn out\nend\n\n-- The shelf of board games in the north-east corner: its carcass and two shelves, and the games lying in piles on each, from the shelf's own stream.\nlocal function gamesPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal G = Hut.GAMES\n\tP(out, \"room_games_side_w\", G.x0, G.x0 + 2, FL, G.top - 2, G.z0, G.z1, \"varnished_wood_smooth\", C.unit, \"Wood\")\n\tP(out, \"room_games_side_e\", G.x1 - 2, G.x1, FL, G.top - 2, G.z0, G.z1, \"varnished_wood_smooth\", C.unit, \"Wood\")\n\tP(out, \"room_games_back\", G.x0 + 2, G.x1 - 2, FL, G.top - 2, G.z0, G.z0 + 1, \"varnished_wood_smooth\", C.unitDark, \"Wood\")\n\tP(out, \"room_games_top\", G.x0, G.x1, G.top - 2, G.top, G.z0, G.z1, \"varnished_wood_smooth\", C.unit, \"Wood\")\n\tP(out, \"room_games_bottom\", G.x0 + 2, G.x1 - 2, FL, -66, G.z0 + 1, G.z1, \"varnished_wood_smooth\", C.unitDark, \"Wood\")\n\tlocal shelves = { { y = -66, top = -30 }, { y = -28, top = 8 }, { y = 10, top = G.top - 2 } }\n\tP(out, \"room_games_shelf_1\", G.x0 + 2, G.x1 - 2, -30, -28, G.z0 + 1, G.z1, \"varnished_wood_smooth\", C.unit, \"Wood\")\n\tP(out, \"room_games_shelf_2\", G.x0 + 2, G.x1 - 2, 8, 10, G.z0 + 1, G.z1, \"varnished_wood_smooth\", C.unit, \"Wood\")\n\tlocal rand = rng(region.seed, 7)\n\tfor s, shelf in shelves do\n\t\tfor pile, px in { G.x0 + 4, G.x0 + 42 } do\n\t\t\tlocal y = shelf.y\n\t\t\tlocal w, dz = between(rand, 26, 30), between(rand, 25, 28)\n\t\t\tfor k = 1, 4 do\n\t\t\t\tlocal h = between(rand, 4, 8)\n\t\t\t\tif y + h > shelf.top - 3 then break end\n\t\t\t\tlocal ww, dd = w - between(rand, 0, 4), dz - between(rand, 0, 3)\n\t\t\t\tP(out, `room_games_box_{s}_{pile}_{k}`, px, px + ww, y, y + h, G.z1 - 1 - dd, G.z1 - 1, \"painted_wood_dry\", pick(C.games, rand), \"SmoothPlastic\")\n\t\t\t\ty += h\n\t\t\t\tw, dz = ww, dd\n\t\t\tend\n\t\tend\n\tend\n\tP(out, \"room_games_cards\", G.x0 + 30, G.x0 + 39, G.top, G.top + 2.2, G.z0 + 12, G.z0 + 18.5, \"painted_wood_dry\", \"b8322a\", \"SmoothPlastic\")\n\treturn out\nend\n\n-- The back room's window in its east wall: its sill board (30 cm deep, wide enough for a cat), the reveals either side, the glass and the head.\nlocal function roomWindowPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal Wn, B = Hut.ROOM_WINDOW, Hut.BACK\n\tP(out, \"room_window_sill\", Wn.sill, Wn.glass, -3, 0, Wn.z0, Wn.z1, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"room_window_reveal_s\", B.x1, Wn.glass, -3, Wn.top, 93.5, Wn.z0, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"room_window_reveal_n\", B.x1, Wn.glass, -3, Wn.top, Wn.z1, 174.5, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\tP(out, \"room_window_glass\", Wn.glass, Wn.glass + 1, Wn.gap, Wn.head, Wn.z0, Wn.z1, \"glass_clean\", \"c9d6d8\", \"Glass\")\n\tP(out, \"room_window_head\", B.x1, Wn.glass, Wn.head, Wn.top, Wn.z0, Wn.z1, \"painted_wood_dry\", C.lining, \"WoodPlanks\")\n\treturn out\nend\n\n-- The cracked sash leads onto the exterior sill, down the rough logs and onto\n-- real ground beside the existing path. The outside is not resident territory.\nlocal function roomExitPieces(): { Piece }\n\tlocal out: { Piece } = {}\n\tP(out, \"room_exit_board\", 459, 478, -3, 0, 98, 170, \"painted_wood_dry\", C.trim, \"WoodPlanks\")\n\tP(out, \"room_exit_logs\", 471.5, 473.5, GT, -3, 98, 170, \"bare_wood_rough\", C.log, \"Wood\")\n\tP(out, \"room_exit_ground\", 473.5, 530, GT - 2, GT, 98, 170, \"bare_wood_rough\", \"71804e\", \"Ground\")\n\treturn out\nend\n\n-- The north face outside from OUT_TOP (or the window's head) to the soffit, its corners' log ends, the window's casing, and the eaves: the boxed soffit, the fascia,\n-- the gutter's floor and lip, an end cap at each end of the run.\nlocal function eavePieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal e: { id: string, x0: number, x1: number, ex0: number, ex1: number }? = nil\n\tfor _, x in EAVES do if x.id == region.id then e = x end end\n\tlocal E = e :: any\n\tlocal id = region.id\n\tlocal EV, OT, z1 = Hut.EAVE, Hut.OUT_TOP, Hut.WALL_SPLIT\n\tlocal Gu = EV.gutter\n\tif id == \"hut_eave_mid\" then\n\t\tP(out, id .. \"_logs\", E.x0, E.x1, 113.5, EV.soffit, -16, z1, \"bare_wood_rough\", C.log, \"Wood\")\n\t\tP(out, id .. \"_casing\", -37, 37, 112.5, 118.5, -17.2, -16, \"painted_wood_dry\", C.trim, \"WoodPlanks\")\n\telse\n\t\tP(out, id .. \"_logs\", E.x0, E.x1, OT, EV.soffit, -16, z1, \"bare_wood_rough\", C.log, \"Wood\")\n\tend\n\tif id == \"hut_eave_w1\" then\n\t\tP(out, id .. \"_casing\", -37, -31, OT, 112.5, -17.2, -16, \"painted_wood_dry\", C.trim, \"WoodPlanks\")\n\telseif id == \"hut_eave_w2\" then\n\t\tP(out, id .. \"_corner\", -184, -166, OT, EV.soffit, -25, -16, \"bare_wood_rough\", C.logDark, \"Wood\")\n\telseif id == \"hut_eave_e1\" then\n\t\tP(out, id .. \"_casing\", 31, 37, OT, 112.5, -17.2, -16, \"painted_wood_dry\", C.trim, \"WoodPlanks\")\n\telseif id == \"hut_eave_x4\" then\n\t\tP(out, id .. \"_corner\", Hut.BUILDING.x1 - 9, Hut.BUILDING.x1 + 9, OT, EV.soffit, -25, -16, \"bare_wood_rough\", C.logDark, \"Wood\")\n\tend\n\tP(out, id .. \"_soffit\", E.ex0, E.ex1, EV.soffit, EV.soffitTop, EV.out, -16, \"painted_wood_dry\", C.trim, \"WoodPlanks\")\n\tP(out, id .. \"_fascia\", E.ex0, E.ex1, Gu.floor, EV.soffitTop, EV.fascia.out, EV.out, \"painted_wood_dry\", C.trim, \"WoodPlanks\")\n\tP(out, id .. \"_gutter\", E.ex0, E.ex1, Gu.floor, Gu.floor + Gu.thick, Gu.out, EV.fascia.out, \"painted_metal_smooth\", C.gutter, \"Metal\")\n\tP(out, id .. \"_gutter_lip\", E.ex0, E.ex1, Gu.floor, Gu.lip, Gu.out - Gu.wall, Gu.out, \"painted_metal_smooth\", C.gutter, \"Metal\")\n\tif E.ex0 == EV.x0 then P(out, id .. \"_gutter_cap\", EV.x0 - Gu.cap, EV.x0, Gu.floor, Gu.lip, Gu.out - Gu.wall, EV.fascia.out, \"painted_metal_smooth\", C.gutter, \"Metal\") end\n\tif E.ex1 == EV.x1 then P(out, id .. \"_gutter_cap\", EV.x1, EV.x1 + Gu.cap, Gu.floor, Gu.lip, Gu.out - Gu.wall, EV.fascia.out, \"painted_metal_smooth\", C.gutter, \"Metal\") end\n\treturn out\nend\n\n-- The back room's north logs outside (west and east of x 325) to OUT_TOP, the base's lip at their foot, and the room's north-east corner's log ends.\nlocal function wallXPieces(region: Region): { Piece }\n\tlocal out: { Piece } = {}\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal x0 = lo.X\n\tlocal x1 = math.min(hi.X, Hut.BUILDING.x1)\n\tP(out, region.id .. \"_logs\", x0, x1, FL, Hut.OUT_TOP, -16, Hut.WALL_SPLIT, \"bare_wood_rough\", C.log, \"Wood\")\n\tP(out, region.id .. \"_base\", math.max(x0, 178), if region.id == \"hut_wall_x3\" then x1 + 3 else x1, GT, FL, -19, -16, \"brick_rough\", C.concrete, \"Concrete\")\n\tif region.id == \"hut_wall_x3\" then\n\t\tP(out, region.id .. \"_corner\", Hut.BUILDING.x1 - 9, Hut.BUILDING.x1 + 9, FL, Hut.OUT_TOP, -25, -16, \"bare_wood_rough\", C.logDark, \"Wood\")\n\tend\n\treturn out\nend\n\nlocal KINDS: { [string]: boolean } = {\n\thut_window = true, hut_outer_sill = true, hut_floor = true, hut_desk = true, hut_board = true, hut_shelf = true, hut_chair = true, hut_door = true,\n\thut_wall = true, hut_bench = true, hut_butt = true, garden_pole = true, garden_bed = true, hut_path = true,\n\t-- (ROBLOX-118)\n\thut_upper = true, hut_doorway = true, hut_door_up = true, hut_eave = true, room_floor = true, room_sofa = true, room_tv = true, room_games = true, room_window = true, room_exit = true,\n}\n-- Whether a kind is the hut's (or its garden's).\nfunction Hut.knows(kind: string): boolean\n\treturn KINDS[kind] == true\nend\n-- The kinds inside the hut (Life/Nature: the night's ground hunters never come in; the hut keeps the sill's day).\nHut.INDOORS = table.freeze({ hut_window = true, hut_floor = true, hut_desk = true, hut_board = true, hut_shelf = true, hut_chair = true,\n\t-- (ROBLOX-118) the ceiling and the upper walls, the doorway, the front door's head, and the volunteers' back room\n\thut_upper = true, hut_doorway = true, hut_door_up = true, room_floor = true, room_sofa = true, room_tv = true, room_games = true, room_window = true })\n\nlocal piecesCache: { [string]: { Piece } } = {}\n-- Working field gear offers small-scale routes and cover without filling the\n-- cat's walking lanes. These are physical at both detail tiers.\nlocal function rangerGear(region: Region, out: { Piece })\n\tif region.id == \"hut_desk\" then\n\t\tP(out, \"station_radio\", 97, 104, 4, 18, 45, 55, \"painted_metal_smooth\", \"303835\", \"SmoothPlastic\")\n\t\tP(out, \"station_radio_aerial\", 102, 102.6, 18, 33, 46, 46.6, \"painted_metal_smooth\", \"252b29\", \"Metal\")\n\t\tP(out, \"station_radio_screen\", 98, 102, 12, 16, 55, 55.2, \"glass_clean\", \"819b80\", \"Glass\")\n\t\tP(out, \"station_radio_dial\", 98, 100, 18, 19, 50, 52, \"painted_metal_smooth\", \"1d2421\", \"SmoothPlastic\")\n\t\tP(out, \"station_thermos\", 114, 122, 4, 23, 48, 56, \"painted_metal_smooth\", \"456b59\", \"Metal\")\n\t\tP(out, \"station_thermos_cap\", 114, 122, 23, 26, 48, 56, \"painted_metal_smooth\", \"b5b8ad\", \"Metal\")\n\telseif region.id == \"hut_floor_a\" then\n\t\tfor i, x in { -101, -85 } do\n\t\t\tlocal z = if i == 1 then 38 else 40\n\t\t\tP(out, `station_boot_{i}_sole`, x, x + 12, FL, FL + 2, z, z + 26, \"painted_wood_dry\", \"282d27\", \"SmoothPlastic\")\n\t\t\tP(out, `station_boot_{i}_foot`, x + 0.5, x + 11.5, FL + 2, FL + 7, z + 0.5, z + 25.5, \"painted_wood_dry\", \"566347\", \"SmoothPlastic\")\n\t\t\tP(out, `station_boot_{i}_shaft`, x + 0.5, x + 11.5, FL + 7, FL + 30, z + 14, z + 25.5, \"painted_wood_dry\", \"566347\", \"SmoothPlastic\")\n\t\t\tP(out, `station_boot_{i}_rim`, x + 0.5, x + 11.5, FL + 30, FL + 31, z + 14, z + 25.5, \"painted_wood_dry\", \"343e2e\", \"SmoothPlastic\")\n\t\tend\n\t\tP(out, \"station_pack\", -140, -124, FL, -35, 59, 81, \"painted_wood_dry\", \"846846\", \"Fabric\")\n\t\tP(out, \"station_pack_pocket\", -124, -120, -62, -44, 62, 78, \"painted_wood_dry\", \"9b7c53\", \"Fabric\")\n\t\tfor i, z in { 61, 77 } do\n\t\t\tP(out, `station_pack_strap_{i}`, -140.4, -140, -64, -38, z, z + 1.5, \"painted_wood_dry\", \"3c4438\", \"Fabric\")\n\t\tend\n\telseif region.id == \"hut_shelf\" then\n\t\tP(out, \"station_aid_case\", -142, -121, 10, 23, 176, 197, \"painted_wood_dry\", \"a33d31\", \"SmoothPlastic\")\n\t\tP(out, \"station_aid_lid\", -142, -121, 23, 24.5, 176, 197, \"painted_wood_dry\", \"bd4b3e\", \"SmoothPlastic\")\n\t\t-- Cross on the case's outward face, split so no physical boxes overlap.\n\t\tP(out, \"station_aid_cross_v\", -121, -120.8, 13, 21, 185, 188, \"painted_wood_dry\", \"eee6d5\", \"SmoothPlastic\")\n\t\tP(out, \"station_aid_cross_n\", -121, -120.8, 15.5, 18.5, 182, 185, \"painted_wood_dry\", \"eee6d5\", \"SmoothPlastic\")\n\t\tP(out, \"station_aid_cross_s\", -121, -120.8, 15.5, 18.5, 188, 191, \"painted_wood_dry\", \"eee6d5\", \"SmoothPlastic\")\n\tend\nend\nfunction Hut.pieces(region: Region): { Piece }\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = piecesCache[key]\n\tif cached ~= nil then return cached end\n\tlocal k, out = region.kind, nil :: { Piece }?\n\tif k == \"hut_floor\" then out = floorPieces(region)\n\telseif k == \"hut_desk\" then out = deskPieces()\n\telseif k == \"hut_board\" then out = boardPieces()\n\telseif k == \"hut_shelf\" then out = shelfPieces(region)\n\telseif k == \"hut_chair\" then out = chairPieces()\n\telseif k == \"hut_door\" then out = doorPieces()\n\telseif k == \"hut_window\" then out = windowPieces()\n\telseif k == \"hut_outer_sill\" then out = outerPieces()\n\telseif k == \"hut_wall\" then out = if string.sub(region.id, 1, 10) == \"hut_wall_x\" then wallXPieces(region) else wallPieces(region)\n\telseif k == \"hut_bench\" then out = benchPieces()\n\telseif k == \"hut_butt\" then out = buttPieces()\n\telseif k == \"garden_pole\" then out = polePieces(region)\n\telseif k == \"garden_bed\" then out = gardenPieces(region)\n\telseif k == \"hut_path\" then out = pathPieces(region)\n\telseif k == \"hut_upper\" then out = upperPieces(region)\n\telseif k == \"room_floor\" then out = roomFloorPieces(region)\n\telseif k == \"hut_doorway\" then out = doorwayPieces(region)\n\telseif k == \"hut_door_up\" then out = doorUpPieces()\n\telseif k == \"room_sofa\" then out = sofaPieces(region)\n\telseif k == \"room_tv\" then out = tvPieces()\n\telseif k == \"room_games\" then out = gamesPieces(region)\n\telseif k == \"room_window\" then out = roomWindowPieces()\n\telseif k == \"room_exit\" then out = roomExitPieces()\n\telseif k == \"hut_eave\" then out = eavePieces(region)\n\telse error(\"no generator for the region kind \" .. k) end\n\tlocal list = out :: { Piece }\n\trangerGear(region, list)\n\tfor _, p in list do table.freeze(p) end\n\tpiecesCache[key] = table.freeze(list)\n\treturn list\nend\n\n-- The pieces a region's drawing stands in for (they turn invisible, still solid): the window's glass, which the sill's Decor draws with the rest of the window.\n-- Everything else of the hut is its own look (its material and colour), with the drawn detail beside it.\nfunction Hut.drawnPieces(region: Region): { string }\n\tif region.kind == \"hut_window\" then return { \"hut_window_glass\" } end\n\tif region.kind == \"room_window\" then return { \"room_window_glass\" } end\n\tif region.id == \"hut_desk\" then return { \"station_thermos\", \"station_thermos_cap\" } end\n\t-- (and the herbs' mounds, drawn as leafy masses over their boxes: Hut.decor)\n\tlocal out: { string } = {}\n\tfor _, p in Hut.pieces(region) do\n\t\tif string.find(p.id, \"_trough_herb_\", 1, true) ~= nil or string.sub(p.id, -5) == \"_sage\" or string.sub(p.id, -6) == \"_thyme\" then table.insert(out, p.id) end\n\tend\n\treturn out\nend\n\n-- The boxes a region's creatures keep out of: each retreat grown by half a stud (World/Garden's rule).\nfunction Hut.keepOut(region: Region): { Box }\n\tlocal out: { Box } = {}\n\tfor _, t in region.retreats do table.insert(out, { min = t.min - v(0.5, 0.5, 0.5), max = t.max + v(0.5, 0.5, 0.5) }) end\n\treturn out\nend\n\n-- ---------------------------------------------------------------- the drawn looks\n-- The hut's boxes are their own look (their materials and colours, visible: World/WorldBuild builds them), so a look here is only the detail beside them, and\n-- nearly all of it is the full tier's: the floorboards' joints, the leaflets on the board, the pencil and the jars' lids, the grass, the gravel's stones, the\n-- mulch's chips, the flowers' florets. What the low tier keeps is what tells a surface from another (the gravel path on the lawn, the drip strip, the seed under\n-- the feeder) and the lamp's bulb. (The hut's shell seen from afar, and its walls above what the regions hold, are World/PreserveLook's hut, drawn behind these\n-- boxes by a hair so that the two never fight where both are drawn: it stands in for them where streaming has not sent them yet.)\n-- The ceilings each kind keeps to at both tiers (a placer stops at them, keeping what it placed first; tests/preserve.luau holds the counts).\nHut.BUDGETS = table.freeze({\n\thut_floor = { full = 15, low = 2 }, hut_desk = { full = 24, low = 3 }, hut_board = { full = 16, low = 4 }, hut_shelf = { full = 10, low = 0 }, hut_chair = { full = 2, low = 0 },\n\thut_door = { full = 14, low = 1 }, hut_window = { full = 0, low = 0 }, hut_outer_sill = { full = 6, low = 0 }, hut_wall = { full = 0, low = 0 },\n\thut_bench = { full = 4, low = 0 }, hut_butt = { full = 3, low = 0 }, garden_pole = { full = 4, low = 2 }, garden_bed = { full = 124, low = 8 },\n\t-- (ROBLOX-117: the path round the east end, and the patches: the near detail of the garden's cells and the path's lengths, World/LookPlan.PATCH_RADIUS)\n\thut_path = { full = 8, low = 2 }, patch = { full = 90, low = 10 },\n\t-- (ROBLOX-118: the ceiling and the upper walls, the doorway, the front door's head, the eaves, and the back room)\n\thut_upper = { full = 26, low = 0 }, hut_doorway = { full = 0, low = 0 }, hut_door_up = { full = 0, low = 0 }, hut_eave = { full = 4, low = 0 },\n\troom_floor = { full = 12, low = 1 }, room_sofa = { full = 8, low = 0 }, room_tv = { full = 4, low = 1 }, room_games = { full = 20, low = 0 }, room_window = { full = 5, low = 1 }, room_exit = { full = 0, low = 0 },\n}) :: { [string]: { full: number, low: number } }\n\nlocal function sheet(budget: { full: number, low: number })\n\tlocal list: { Drawn } = {}\n\tlocal full, low = 0, 0\n\tlocal function add(d: Drawn): boolean\n\t\tif full + 1 > budget.full or (not d.full and low + 1 > budget.low) then return false end\n\t\tfull += 1\n\t\tif not d.full then low += 1 end\n\t\ttable.insert(list, d)\n\t\treturn true\n\tend\n\treturn list, add\nend\n-- A record: `at` its middle, `size`, colour by hex, material; `full` the low tier drops it.\nlocal function rec(id: string, size: Vector3, at: Vector3, color: string, material: string, full: boolean, shape: string?, turn: Vector3?): Drawn\n\treturn { id = id, size = size, at = at, color = hex(color), material = material, full = full, shape = shape, turn = turn }\nend\n\nlocal function floorDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\t-- the boards run north and south, 14 cm wide: the joints between them\n\tlocal x = math.ceil(lo.X / 14) * 14\n\tlocal k = 0\n\twhile x < hi.X - 1 do\n\t\tk += 1\n\t\tadd(rec(`Joint{k}`, v(0.18, 0.02, hi.Z - lo.Z), v(x, FL + 0.01, (lo.Z + hi.Z) / 2), C.floorDark, \"WoodPlanks\", true))\n\t\tx += 14\n\tend\n\tlocal rand = rng(region.seed, 5)\n\tfor i = 1, 3 do\n\t\tadd(rec(`Knot{i}`, v(1.2, 0.02, 2.2), v(between(rand, lo.X + 4, hi.X - 4), FL + 0.012, between(rand, lo.Z + 4, hi.Z - 4)), \"5e4430\", \"Wood\", true, \"Ellipsoid\"))\n\tend\n\tif region.id == \"hut_floor_g\" then\n\t\t-- (ROBLOX-118) the cat's bowls by the door: its biscuits and its water\n\t\tadd(rec(\"FoodBowl\", v(4, 13, 13), v(-98, FL + 2, 232), \"b8bcc0\", \"Metal\", true, \"Cylinder\", v(0, 0, 90)))\n\t\tadd(rec(\"Biscuits\", v(0.6, 10, 10), v(-98, FL + 3.8, 232), \"8a5a2e\", \"Sand\", true, \"Cylinder\", v(0, 0, 90)))\n\t\tadd(rec(\"WaterBowl\", v(4, 14, 14), v(-76, FL + 2, 238), \"b8bcc0\", \"Metal\", true, \"Cylinder\", v(0, 0, 90)))\n\t\tadd(rec(\"Water\", v(0.3, 11.5, 11.5), v(-76, FL + 3.7, 238), \"9fb6bd\", \"Glass\", true, \"Cylinder\", v(0, 0, 90)))\n\tend\n\tif region.id == \"hut_floor_i\" then\n\t\t-- (ROBLOX-117) the caddy's handle and the banana peel over its rim\n\t\tlocal K = Hut.CADDY\n\t\tlocal top = FL + K.h + K.lid\n\t\tadd(rec(\"CaddyHandle\", v(16, 0.8, 0.8), v((K.x0 + K.x1) / 2, top + 0.4, (K.z0 + K.z1) / 2), \"2f4f2c\", \"SmoothPlastic\", false))\n\t\tadd(rec(\"Peel\", v(9, 0.8, 3.2), v(K.x0 + 4, top + 0.3, K.z0 + 2), \"c9a83a\", \"SmoothPlastic\", false, \"Ellipsoid\", v(0, 30, -8)))\n\t\tadd(rec(\"PeelEnd\", v(4, 0.8, 2.6), v(K.x0 + 0.4, top - 1.3, K.z0 + 0.6), \"a07a2a\", \"SmoothPlastic\", true, \"Ellipsoid\", v(0, 30, -70)))\n\tend\nend\n\nlocal function deskDecor(_region: Region, add: (Drawn) -> boolean)\n\t-- the lamp's bulb under its shade (it glows at night: Client/HutLife lights it)\n\tadd(rec(\"Bulb\", v(4, 4, 4), v(110, 32, 24), \"fff1c8\", \"Neon\", false, \"Ball\"))\n\tadd(rec(\"ShadeRim\", v(1, 17, 17), v(110, 34.5, 24), \"24392b\", \"Metal\", true, \"Cylinder\", v(0, 0, 90)))\n\tadd(rec(\"Pencil\", v(17, 0.7, 0.7), v(66, 5.55, 66.5), \"e0b23a\", \"Wood\", true, \"Cylinder\", v(0, 8, 0)))\n\tadd(rec(\"PencilTip\", v(1.4, 0.5, 0.5), v(75, 5.55, 65.3), \"2a2724\", \"SmoothPlastic\", true, \"Cylinder\", v(0, 8, 0)))\n\tadd(rec(\"Pages\", v(0.6, 1.0, 29.3), v(73.25, 4.55, 48.85), \"efe9d8\", \"SmoothPlastic\", true))\n\tadd(rec(\"Band\", v(21.2, 1.25, 0.5), v(62.5, 4.62, 58), \"1f1f1f\", \"Fabric\", true))\n\tadd(rec(\"MugHandle\", v(1, 6, 4.5), v(92.4, 8.5, 54), C.mug, \"SmoothPlastic\", true))\n\tadd(rec(\"Coffee\", v(7.4, 0.1, 7.4), v(88, 12.8, 54), \"3a2416\", \"SmoothPlastic\", true))\n\tfor i, j in { { 44, 9 }, { 52, 11 }, { 60, 7 } } do\n\t\tadd(rec(`Lid{i}`, v(6.4, 1.2, 6.4), v(j[1] + 3, 4 + j[2] + 0.6, 17.5), C.lid, \"Metal\", true))\n\t\tadd(rec(`Specimen{i}`, v(2.2, 1.4, 1.6), v(j[1] + 3, 4.8, 17.5), if i == 2 then \"5a3a22\" else \"2e2a24\", \"SmoothPlastic\", true, \"Ellipsoid\"))\n\tend\n\tadd(rec(\"LensRim\", v(0.8, 5.4, 5.4), v(80.5, 4.3, 28.5), C.brass, \"Metal\", true, \"Cylinder\", v(0, 0, 90)))\n\tadd(rec(\"Grain1\", v(88, 0.02, 0.25), v(81, 4.01, 40), \"8a6440\", \"Wood\", true))\n\tadd(rec(\"Grain2\", v(70, 0.02, 0.2), v(90, 4.01, 26), \"8a6440\", \"Wood\", true))\n\tadd(rec(\"Grain3\", v(60, 0.02, 0.2), v(70, 4.01, 68), \"8a6440\", \"Wood\", true))\nend\n\nlocal function boardDecor(region: Region, add: (Drawn) -> boolean)\n\t-- the leaflets: the preserve's map, the volunteers' rota, the birds of the feeder, a lost cat, the bioblitz's date, a pressed leaf (low: the largest four)\n\tlocal face = Hut.ROOM.z0 + 4\n\tlocal sheets: { { id: string, w: number, h: number, x: number, y: number, color: string } } = {\n\t\t{ id = \"Map\", w = 34, h = 24, x = -112, y = 34, color = \"dfe9d0\" }, { id = \"Rota\", w = 21, h = 29.7, x = -72, y = 30, color = C.paper[1] },\n\t\t{ id = \"Birds\", w = 21, h = 14.8, x = -118, y = 6, color = C.paper[4] }, { id = \"Cat\", w = 14.8, h = 21, x = -90, y = 4, color = C.paper[5] },\n\t\t{ id = \"Bioblitz\", w = 14.8, h = 10.5, x = -62, y = 2, color = C.paper[6] }, { id = \"Leaf\", w = 10, h = 12, x = -60, y = 14, color = C.paper[3] },\n\t}\n\tlocal rand = rng(region.seed, 9)\n\tfor i, sh in sheets do\n\t\tadd(rec(sh.id, v(sh.w, sh.h, 0.05), v(sh.x, sh.y, face + 0.03), sh.color, \"SmoothPlastic\", i > 4, nil, v(0, 0, between(rand, -3, 3))))\n\tend\n\tfor i, sh in sheets do\n\t\tadd(rec(`Pin{i}`, v(0.9, 0.9, 0.9), v(sh.x, sh.y + sh.h / 2 - 1.5, face + 0.5), pick({ \"c0392b\", \"2e86c1\", \"f1c40f\", \"27ae60\" }, rand), \"SmoothPlastic\", true, \"Ball\"))\n\tend\nend\n\nlocal function shelfDecor(region: Region, add: (Drawn) -> boolean)\n\t-- gold bands on some of the field guides' spines\n\tlocal k = 0\n\tfor _, p in Hut.pieces(region) do\n\t\tif string.find(p.id, \"_book_\", 1, true) ~= nil and k < 10 and (#p.id % 2 == 0) then\n\t\t\tk += 1\n\t\t\tadd(rec(`Band{k}`, v(0.05, 0.6, p.hi.Z - p.lo.Z), v(p.hi.X + 0.03, p.hi.Y - 3, (p.lo.Z + p.hi.Z) / 2), \"c9a23d\", \"Metal\", true))\n\t\tend\n\tend\nend\n\nlocal function doorDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal D = Hut.DOOR\n\t-- the light under the door: a bright strip on the threshold's far side, and the gravel's stones\n\tadd(rec(\"Gap\", v(90, 0.02, 4), v(0, FL + 0.01, D.leaf[2] + 2), \"d8c7a0\", \"SmoothPlastic\", false))\n\tlocal rand = rng(region.seed, 13)\n\tfor i = 1, 12 do\n\t\tlocal s = between(rand, 0.4, 1.2)\n\t\tadd(rec(`Pebble{i}`, v(s, s * 0.6, s * between(rand, 0.7, 1.2)), v(between(rand, -55, 55), GT + s * 0.2, between(rand, D.step.to + 2, D.gravel - 2)), pick({ C.gravel, C.gravelDark, \"c9bfa8\", \"8f8676\" }, rand), \"Pebble\", true, \"Ellipsoid\"))\n\tend\nend\n\nlocal function outerDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal rand = rng(region.seed, 17)\n\tfor i = 1, 6 do\n\t\tlocal s = between(rand, 0.3, 0.9)\n\t\tadd(rec(`Grit{i}`, v(s, 0.05, s), v(between(rand, -33, 33), 0.02, between(rand, -21, -17)), pick({ \"7d7466\", \"9b9284\", \"c9b48a\" }, rand), \"SmoothPlastic\", true))\n\tend\nend\n\nlocal function benchDecor(_region: Region, add: (Drawn) -> boolean)\n\tfor k = 1, 3 do add(rec(`Slat{k}`, v(130, 0.05, 0.4), v(-20, -39.97, -58 + k * 10.5), C.boardDark, \"WoodPlanks\", true)) end\nend\n\nlocal function buttDecor(_region: Region, add: (Drawn) -> boolean)\n\tadd(rec(\"Tap\", v(3, 3, 4), v(130, -55, -78.5), C.brass, \"Metal\", true))\n\tadd(rec(\"Overflow\", v(30, 2, 2), v(160, 18, -48), \"2f3133\", \"SmoothPlastic\", true, \"Cylinder\"))\nend\n\nlocal function poleDecor(region: Region, add: (Drawn) -> boolean)\n\tif region.id ~= \"garden_feeder\" then return end\n\tlocal Q = Hut.POLE\n\tlocal y = GT + Q.top + Q.tray.thick\n\tadd(rec(\"Seed\", v(9.6, Q.hopper.h * 0.6, 9.6), v(Q.x, y + Q.hopper.h * 0.3, Q.z), \"c9b48a\", \"Sand\", false))\n\tadd(rec(\"TraySeed\", v(14, 0.3, 14), v(Q.x, y + 0.15, Q.z), \"a8875a\", \"Sand\", false))\nend\n\n-- A region's pieces by id.\nlocal function piecesById(region: Region): { [string]: Piece }\n\tlocal out: { [string]: Piece } = {}\n\tfor _, p in Hut.pieces(region) do out[p.id] = p end\n\treturn out\nend\n\n-- ---------------------------------------------------------------- the garden's look (ROBLOX-117: rich at the spider's eye)\n-- A cell's own look is what reads from a metre or two off and what stands in for the plants' boxes' shapes: the surfaces (the path's gravel, the drip strip, the\n-- seed under the feeder), the herbs' mounds, the plants drawn whole over their walkable boxes (World/Hut.PLANTS and MORE_PLANTS: the milkweed's broad leaves with\n-- their pale midribs, its umbels of florets and a second umbel on a peduncle, its pod; the coneflower's drooping rays and spiky cone; the bee balm's whorled head\n-- of tubes over its bracts; the goldenrod's arching plume of one-sided sprays; every leaf a blade over its box), the lawn's clumps and the dew on the leaves. What\n-- the spider sees close (the blades, the chips, the stones) is the patches' (below), drawn only near it.\n\n-- A dew drop on a surface at `at` (its top): a flat glass bead in the \"Dew\" group, shown by the hour (Habitat/DayLight.applyDew: it appears from `dew`, its lag,\n-- to its `transparency` at full dew). Full tier only.\nlocal function drop(id: string, at: Vector3, size: number, rand: () -> number): Drawn\n\tlocal d = rec(id, v(size, size * 0.62, size), at + v(0, size * 0.25, 0), \"dfeaee\", \"Glass\", true, \"Ellipsoid\")\n\td.group = \"Dew\"\n\td.dew = rand() * 0.6\n\td.transparency = between(rand, 0.3, 0.45)\n\td.reflectance = 0.3\n\treturn d\nend\n\n-- A leaf box's middle, its length along its long axis, its width, and which axis is long.\nlocal function leafShape(box: Piece): (Vector3, number, number, string)\n\tlocal size = box.hi - box.lo\n\tlocal c = (box.lo + box.hi) * 0.5\n\tif size.X >= size.Z then return c, size.X, size.Z, \"x\" end\n\treturn c, size.Z, size.X, \"z\"\nend\n-- A size along a leaf's long axis `ax`: `l` along it, `w` across, `t` thick.\nlocal function along(ax: string, l: number, t: number, w: number): Vector3\n\treturn if ax == \"x\" then v(l, t, w) else v(w, t, l)\nend\n-- The yaw (degrees) that turns a record's +X onto (dx, dz) in plan.\nlocal function yawTo(dx: number, dz: number): number\n\treturn math.deg(math.atan2(-dz, dx))\nend\n\n-- A plant's drawn form over its walkable boxes (`tag` \"\" for a cell's first plant, \"2\" for its second).\n-- (ROBLOX-119: World/Meadow draws its milkweed, coneflower, bee balm and goldenrod the same way, from its own boxes and soil: Hut.drawPlant)\nlocal function drawPlant(byId: { [string]: Piece }, regionId: string, plant: { kind: string, x: number, z: number, scale: number? }, tag: string, add: (Drawn) -> boolean,\n\trand: () -> number, S: number)\n\tlocal spec = PLANT_SPECS[plant.kind]\n\tlocal k = plant.scale or 1\n\tlocal base = `{regionId}_{plant.kind}{tag}`\n\tlocal top = S + spec.height * k\n\tlocal kind = plant.kind\n\t-- the leaves: each a blade over its box (a little longer and wider, so the box's corners hardly show), the milkweed's with its pale midrib\n\tlocal leafColor = if kind == \"milkweed\" then C.milkweedLeaf elseif kind == \"goldenrod\" then C.goldenLeaf else C.leaf\n\tlocal tones = { leafColor, C.leafPale, leafColor }\n\tfor i = 1, #spec.leaves do\n\t\tlocal box = byId[`{base}_leaf_{i}`]\n\t\tif box ~= nil then\n\t\t\tlocal c, l, w, ax = leafShape(box)\n\t\t\tlocal wide = if kind == \"goldenrod\" then 1.7 elseif kind == \"beebalm\" then 1.5 else 1.3\n\t\t\tif kind == \"milkweed\" then\n\t\t\t\t-- (ROBLOX-126) the milkweed's leaf is Chet's mesh (Data/Meshes: its raised midrib and veins are in it), over its box as the blade was\n\t\t\t\tadd(rec(`Leaf{tag}_{i}`, along(ax, l * 1.22, 0.9, w * wide), c + v(0, 0.2, 0), leafColor, \"SmoothPlastic\", true, \"Mesh:milkweed_leaf\"))\n\t\t\telse\n\t\t\t\tadd(rec(`Leaf{tag}_{i}`, along(ax, l * 1.22, 0.5, w * wide), c + v(0, 0.05, 0), if i % 3 == 0 then tones[2] else leafColor, \"SmoothPlastic\", true, \"Ellipsoid\"))\n\t\t\tend\n\t\t\tif tag == \"\" and i <= 3 then add(drop(`LeafDew{i}`, c + v(between(rand, -1.5, 1.5), box.hi.Y - c.Y, between(rand, -1.5, 1.5)), between(rand, 0.35, 0.6), rand)) end\n\t\tend\n\tend\n\tlocal head = byId[base .. \"_head\"]\n\tif head == nil then return end\n\tlocal hc = (head.lo + head.hi) * 0.5\n\tif kind == \"milkweed\" then\n\t\t-- the umbel: florets over a dome (the golden angle spreads them), pink to mauve; and a second umbel on a peduncle from the third node\n\t\tlocal n = if tag == \"\" then 26 else 18\n\t\tfor i = 1, n do\n\t\t\tlocal t = (i - 0.5) / n\n\t\t\tlocal el = math.asin(t) * 1.15 - 0.2 -- (from just under the dome's rim up to its crown: the umbel droops a little)\n\t\t\tlocal a = i * 2.39996\n\t\t\tlocal r = 4.2\n\t\t\tadd(rec(`Floret{tag}_{i}`, v(1.6, 1.4, 1.6), hc + v(math.cos(a) * r * math.cos(el), 0.3 + r * 0.75 * math.sin(el) - 0.6, math.sin(a) * r * math.cos(el)),\n\t\t\t\tpick({ C.umbel, \"d9a1ab\", \"b47a86\", \"c995a0\" }, rand), \"SmoothPlastic\", true, \"Ball\"))\n\t\tend\n\t\tif tag == \"\" then\n\t\t\tlocal node = S + spec.leaves[5].h * k\n\t\t\tlocal from = v(plant.x + 0.6, node, plant.z)\n\t\t\tlocal to = from + v(7, 5, 2)\n\t\t\tlocal mid = (from + to) * 0.5\n\t\t\tlocal d = to - from\n\t\t\tadd(rec(\"Peduncle\", v(d.Magnitude, 0.35, 0.35), mid, spec.color, \"SmoothPlastic\", true, \"Cylinder\", v(0, yawTo(d.X, d.Z), math.deg(math.asin(d.Y / d.Magnitude)))))\n\t\t\tfor i = 1, 8 do\n\t\t\t\tlocal a = i * 2.39996\n\t\t\t\tadd(rec(`Floret2_{i}`, v(1.2, 1.1, 1.2), to + v(math.cos(a) * 2.6, between(rand, -0.6, 0.9), math.sin(a) * 2.6), pick({ C.umbel, \"d9a1ab\", \"b47a86\" }, rand), \"SmoothPlastic\", true, \"Ball\"))\n\t\t\tend\n\t\t\tlocal pod = byId[base .. \"_pod\"]\n\t\t\tif pod ~= nil then\n\t\t\t\tlocal pc = (pod.lo + pod.hi) * 0.5\n\t\t\t\tlocal ps = pod.hi - pod.lo\n\t\t\t\tadd(rec(\"Pod\", v(ps.X * 1.5, ps.Y * 1.08, ps.Z * 1.5), pc, C.pod, \"SmoothPlastic\", true, \"Ellipsoid\"))\n\t\t\t\tadd(rec(\"PodTip\", v(0.9, 1.6, 0.9), pc + v(0.4, ps.Y * 0.55, 0), \"8aa86a\", \"SmoothPlastic\", true, \"Ellipsoid\"))\n\t\t\tend\n\t\tend\n\telseif kind == \"coneflower\" then\n\t\t-- the rays droop from the cone's foot; the cone is a dome of spiny orange-brown florets\n\t\tfor i = 1, 13 do\n\t\t\tlocal a = i / 13 * TAU + between(rand, -0.08, 0.08)\n\t\t\tadd(rec(`Ray{tag}_{i}`, v(4.6, 0.12, 1.15), v(plant.x + math.cos(a) * 5.4, top + 0.1 - 1.1, plant.z + math.sin(a) * 5.4), pick({ C.petal, \"c27a9c\", \"a85f84\" }, rand),\n\t\t\t\t\"SmoothPlastic\", true, nil, v(0, -math.deg(a), -28)))\n\t\tend\n\t\tlocal cone = byId[base .. \"_cone\"]\n\t\tif cone ~= nil then\n\t\t\tlocal cc = (cone.lo + cone.hi) * 0.5\n\t\t\t-- (ROBLOX-119: the dome's top at the box's, so a spider standing on the cone stands on it, not inside it; it was 0.8 over)\n\t\t\tadd(rec(`Cone{tag}`, v(4.2, 3.4, 4.2), cc + v(0, -0.25, 0), \"9a4b1c\", \"Sand\", true, \"Ball\"))\n\t\t\tfor i = 1, 6 do\n\t\t\t\tlocal a = i / 6 * TAU\n\t\t\t\tadd(rec(`Spine{tag}_{i}`, v(0.7, 0.7, 0.7), cc + v(math.cos(a) * 1.7, 0.4 + (i % 2) * 0.4, math.sin(a) * 1.7), \"c0702a\", \"SmoothPlastic\", true, \"Ball\"))\n\t\t\tend\n\t\tend\n\t\tfor i = 1, 3 do\n\t\t\tlocal box = byId[`{base}_basal_{i}`]\n\t\t\tif box ~= nil then\n\t\t\t\tlocal c, l, w, ax = leafShape(box)\n\t\t\t\tadd(rec(`Basal{tag}_{i}`, along(ax, l * 1.2, 0.35, w * 1.25), c + v(0, 0.05, 0), C.leaf, \"SmoothPlastic\", true, \"Ellipsoid\"))\n\t\t\tend\n\t\tend\n\telseif kind == \"beebalm\" then\n\t\t-- the head: a whorl of lavender tubes curving out and up from a green button, over a ring of pale bracts\n\t\tadd(rec(`Button{tag}`, v(5.2, 4.4, 5.2), hc, \"7a7a52\", \"SmoothPlastic\", true, \"Ellipsoid\"))\n\t\tfor i = 1, 16 do\n\t\t\tlocal a = i / 16 * TAU + between(rand, -0.1, 0.1)\n\t\t\tlocal up = between(rand, 15, 60)\n\t\t\tlocal len = between(rand, 2.6, 3.4)\n\t\t\tlocal out = v(math.cos(a), 0, math.sin(a))\n\t\t\tlocal dir = (out * math.cos(math.rad(up)) + v(0, math.sin(math.rad(up)), 0))\n\t\t\tadd(rec(`Tube{tag}_{i}`, v(len, 0.45, 0.45), hc + out * 2.3 + dir * (len / 2) + v(0, 0.6 + (i % 3) * 0.5, 0), pick({ C.monarda, \"b79cc0\", \"9a7aa6\" }, rand), \"SmoothPlastic\", true, nil,\n\t\t\t\tv(0, yawTo(out.X, out.Z), up)))\n\t\tend\n\t\tfor i = 1, 5 do\n\t\t\tlocal a = i / 5 * TAU + 0.3\n\t\t\tadd(rec(`Bract{tag}_{i}`, v(3.0, 0.15, 1.4), hc + v(math.cos(a) * 2.6, -1.6, math.sin(a) * 2.6), \"c9b8a6\", \"SmoothPlastic\", true, \"Ellipsoid\", v(0, -math.deg(a), -18)))\n\t\tend\n\telseif kind == \"goldenrod\" then\n\t\t-- the many narrow leaves up the stem between the walkable ones (drawn only: 6 to 8 cm, too narrow to stand on)\n\t\tfor i = 1, 10 do\n\t\t\tlocal y = S + (14 + i * 6.3) * k\n\t\t\tlocal a = i * 2.39996\n\t\t\tlocal l = between(rand, 6, 8)\n\t\t\tlocal out = v(math.cos(a), 0, math.sin(a))\n\t\t\tadd(rec(`Narrow{tag}_{i}`, v(l, 0.2, 1.1), v(plant.x, y, plant.z) + out * (l / 2 + 0.4) + v(0, l * 0.15, 0), C.goldenLeaf, \"SmoothPlastic\", true, \"Ellipsoid\",\n\t\t\t\tv(0, yawTo(out.X, out.Z), 16)))\n\t\tend\n\t\t-- the plume: the axis on up through the head, branches arching out to one side and the other, each with its sprays of florets along its upper side\n\t\t-- (ROBLOX-119: the axis and the crown end at the plume's top box, so what sits on it (a spider, a crab spider) is on it, not inside: they stood 4 cm over)\n\t\tadd(rec(`Axis{tag}`, v(0.5, (head.hi.Y - head.lo.Y) + 0.4, 0.5), hc + v(0, 0.2, 0), spec.color, \"SmoothPlastic\", true))\n\t\tfor i = 1, 11 do\n\t\t\tlocal t = (i - 0.5) / 11\n\t\t\tlocal y = head.lo.Y + t * (head.hi.Y - head.lo.Y)\n\t\t\tlocal a = i * 2.39996\n\t\t\tlocal reach = 8 * (1 - t * 0.6)\n\t\t\tlocal out = v(math.cos(a), 0, math.sin(a))\n\t\t\tlocal tip = v(plant.x, y + 2.2, plant.z) + out * reach\n\t\t\tlocal root = v(plant.x, y, plant.z)\n\t\t\tlocal d = tip - root\n\t\t\tadd(rec(`Branch{tag}_{i}`, v(d.Magnitude, 0.25, 0.25), (root + tip) * 0.5, spec.color, \"SmoothPlastic\", true, \"Cylinder\",\n\t\t\t\tv(0, yawTo(d.X, d.Z), math.deg(math.asin(d.Y / d.Magnitude)))))\n\t\t\tadd(rec(`Spray{tag}_{i}`, v(reach * 0.95, 1.8, 2.0), (root + tip) * 0.5 + v(0, 1.0, 0) + out * 0.8, pick({ C.goldenrod, \"e2c24a\", \"c9a22e\" }, rand), \"SmoothPlastic\", true,\n\t\t\t\t\"Ellipsoid\", v(0, yawTo(d.X, d.Z), 14)))\n\t\tend\n\t\tadd(rec(`Crown{tag}`, v(3.6, 4, 3.6), v(plant.x, head.hi.Y - 1.8, plant.z), C.goldenrod, \"SmoothPlastic\", true, \"Ellipsoid\"))\n\t\tadd(rec(`Core{tag}`, v(4.2, (head.hi.Y - head.lo.Y) * 0.9, 4.2), hc, \"c9a830\", \"SmoothPlastic\", true, \"Ellipsoid\"))\n\tend\nend\n\nlocal function plantDecor(region: Region, plant: { kind: string, x: number, z: number, scale: number? }, tag: string, add: (Drawn) -> boolean, rand: () -> number)\n\tdrawPlant(piecesById(region), region.id, plant, tag, add, rand, S)\nend\nHut.drawPlant = drawPlant\n\n-- Whether (x, z) lies on the garden's gravel path (with a margin `m`).\nlocal function onPath(x: number, z: number, m: number): boolean\n\tlocal Pa = Hut.PATH\n\treturn (x > Pa.ew.x0 - m and x < Pa.ew.x1 + m and z > Pa.ew.z0 - m and z < Pa.ew.z1 + m) or (x > Pa.ns.x0 - m and x < Pa.ns.x1 + m and z > Pa.ns.z0 - m and z < Pa.ns.z1 + m)\nend\n\n-- Whether (x, z) is clear of every box standing on the surface at `top` (by `m`).\nlocal function clear(standing: { Box }, x: number, z: number, m: number): boolean\n\tfor _, b in standing do\n\t\tif x > b.min.X - m and x < b.max.X + m and z > b.min.Z - m and z < b.max.Z + m then return false end\n\tend\n\treturn true\nend\n\n-- The standing boxes of a region at or near a surface (`top`: the ground or the beds' soil): what a drawn thing on that surface keeps clear of.\nlocal function standingNear(region: Region, top: number): { Box }\n\tlocal out: { Box } = {}\n\tif region.kind == \"garden_bed\" and top == GT then\n\t\t-- (and what stands on the lawn from the regions beside it: the bench's legs, the water butt's stand, the feeder's pole)\n\t\tfor _, p in benchPieces() do if p.lo.Y <= GT + 0.6 then table.insert(out, { min = p.lo, max = p.hi }) end end\n\t\tfor _, p in buttPieces() do if p.lo.Y <= GT + 0.6 then table.insert(out, { min = p.lo, max = p.hi }) end end\n\t\tlocal Q = Hut.POLE\n\t\ttable.insert(out, { min = v(Q.x - Q.half, GT, Q.z - Q.half), max = v(Q.x + Q.half, GT + Q.split, Q.z + Q.half) })\n\tend\n\tfor _, p in Hut.pieces(region) do\n\t\tif p.lo.Y <= top + 0.6 and p.hi.Y > top + 0.05 and not string.find(p.id, \"_soil\", 1, true) and not string.find(p.id, \"_bed\", 1, true)\n\t\t\tand not string.find(p.id, \"_gravel\", 1, true) then\n\t\t\ttable.insert(out, { min = p.lo, max = p.hi })\n\t\tend\n\tend\n\treturn out\nend\n\n-- A blade of grass from its foot at `at`: `h` tall, `w` wide, leaning `lean` degrees toward the yaw `yaw` (degrees); `bend`, if given, the upper half leans that much\n-- more (a second segment). Returns how many records it took.\nlocal function blade(add: (Drawn) -> boolean, id: string, at: Vector3, h: number, w: number, yaw: number, lean: number, bend: number?, color: string, full: boolean): number\n\tlocal function seg(sid: string, from: Vector3, len: number, l: number): Vector3\n\t\tlocal r = math.rad(l)\n\t\tlocal dir = v(-math.sin(r) * math.cos(math.rad(yaw)), math.cos(r), math.sin(r) * math.sin(math.rad(yaw)))\n\t\tadd(rec(sid, v(w, len, 0.06), from + dir * (len / 2), color, \"SmoothPlastic\", full, nil, v(0, yaw, l)))\n\t\treturn from + dir * len\n\tend\n\tif bend == nil then\n\t\tseg(id, at, h, lean)\n\t\treturn 1\n\tend\n\tlocal knee = seg(id .. \"a\", at, h * 0.55, lean)\n\tseg(id .. \"b\", knee, h * 0.45, lean + bend)\n\treturn 2\nend\n\n-- The part of the pollinator bed's soil inside a cell, { x0, x1, z0, z1 }.\nlocal function bedArea(region: Region): { number }?\n\tlocal b, E = Hut.POLLINATOR, Hut.EDGING.thick\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal a, bb, c, d = clip(b.x0 + E, b.x1 - E, b.z0 + E, b.z1 - E, lo.X, hi.X, lo.Z, hi.Z)\n\tif a == nil then return nil end\n\treturn { a, bb :: number, c :: number, d :: number }\nend\nlocal function gardenDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal cx0, cx1, cz0, cz1 = lo.X, hi.X, lo.Z, hi.Z\n\tlocal id = region.id\n\t-- the surfaces (low): the gravel path and the drip strip along the hut's foot\n\tlocal Pa = Hut.PATH\n\tfor k, r in { Pa.ew, Pa.ns } :: { any } do\n\t\tlocal a, b, c, d = clip(r.x0, r.x1, r.z0, r.z1, cx0, cx1, cz0, cz1)\n\t\tif a ~= nil then add(rec(`Path{k}`, v((b :: number) - a, 0.04, (d :: number) - (c :: number)), v((a + (b :: number)) / 2, GT + 0.02, ((c :: number) + (d :: number)) / 2), C.gravel, \"Pebble\", false)) end\n\tend\n\tdo\n\t\tlocal a, b, c, d = clip(cx0, cx1, -46, -19, cx0, cx1, cz0, cz1)\n\t\tif a ~= nil then add(rec(\"Drip\", v((b :: number) - a, 0.04, (d :: number) - (c :: number)), v((a + (b :: number)) / 2, GT + 0.02, ((c :: number) + (d :: number)) / 2), C.gravelDark, \"Pebble\", false)) end\n\tend\n\t-- the herbs' mounds over their boxes (low: they stand in for the boxes): sage grey-green, thyme low and fine, the trough's parsley and basil\n\tfor _, p in Hut.pieces(region) do\n\t\tlocal herb = string.find(p.id, \"_trough_herb_\", 1, true) ~= nil or string.sub(p.id, -5) == \"_sage\" or string.sub(p.id, -6) == \"_thyme\"\n\t\tif herb then\n\t\t\tlocal size = p.hi - p.lo\n\t\t\tlocal color = if string.sub(p.id, -5) == \"_sage\" then C.sage elseif string.sub(p.id, -6) == \"_thyme\" then C.thyme elseif string.sub(p.id, -1) == \"1\" then C.leafPale else C.leaf\n\t\t\tadd(rec(p.id .. \"_mass\", v(size.X, size.Y * 2, size.Z), v((p.lo.X + p.hi.X) / 2, p.lo.Y, (p.lo.Z + p.hi.Z) / 2), color, \"LeafyGrass\", false, \"Ellipsoid\"))\n\t\tend\n\tend\n\tif id == \"garden_b1\" then\n\t\tlocal Q = Hut.POLE\n\t\tadd(rec(\"Spill\", v(34, 0.05, 26), v(Q.x + 3, GT + 0.025, Q.z - 4), \"8f7d5a\", \"Sand\", false, \"Ellipsoid\"))\n\tend\n\t-- the lawn's clumps (two at the low tier): what the lawn is from further off, the patches' blades standing among them close up\n\tlocal rand = rng(region.seed, 29)\n\tlocal standing = standingNear(region, GT)\n\tlocal placed = 0\n\tfor _ = 1, 60 do\n\t\tif placed >= 8 then break end\n\t\tlocal x, z = between(rand, cx0 + 4, cx1 - 4), between(rand, cz0 + 4, cz1 - 4)\n\t\tif bedAt(x, z) == nil and not onPath(x, z, 5) and z < -50 and clear(standing, x, z, 6) and not (bedAt(x - 6, z) or bedAt(x + 6, z) or bedAt(x, z - 6) or bedAt(x, z + 6)) then\n\t\t\tplaced += 1\n\t\t\tlocal spin = between(rand, 0, 360)\n\t\t\tfor b = 1, 3 do\n\t\t\t\tlocal yaw = spin + b * 120 + between(rand, -20, 20)\n\t\t\t\tblade(add, `Clump{placed}_{b}`, v(x, GT, z), between(rand, 6, 13), between(rand, 0.35, 0.5), yaw, between(rand, 4, 16), nil, pick(C.lawnColors, rand), placed > 2 or b > 1)\n\t\t\tend\n\t\tend\n\tend\n\t-- the mulch from further off: its layers of shredded bark in their tones and the bigger pieces over them (the patches' chips stand among them close up)\n\tlocal bed = bedArea(region)\n\tif bed ~= nil then\n\t\tlocal onBed = standingNear(region, S)\n\t\tlocal n = 0\n\t\tfor _ = 1, 60 do\n\t\t\tif n >= 22 then break end\n\t\t\tlocal x, z = between(rand, bed[1] + 3, bed[2] - 3), between(rand, bed[3] + 3, bed[4] - 3)\n\t\t\tif clear(onBed, x, z, 2) then\n\t\t\t\tn += 1\n\t\t\t\tif n % 2 == 1 then\n\t\t\t\t\tlocal w = between(rand, 6, 14)\n\t\t\t\t\tadd(rec(`Mottle{n}`, v(w, 0.1, w * between(rand, 0.4, 0.8)), v(x, S + between(rand, 0.03, 0.1), z), pick({ \"3f2a1b\", \"4a3220\", \"5a3c26\", \"553826\", \"61442e\", \"6b5040\" }, rand),\n\t\t\t\t\t\t\"Ground\", true, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\t\t\t\telse\n\t\t\t\t\tlocal l = between(rand, 1.5, 3.5)\n\t\t\t\t\tadd(rec(`Bark{n}`, v(l, between(rand, 0.15, 0.3), l * between(rand, 0.3, 0.6)), v(x, S + 0.2, z), pick({ \"5a3c26\", \"6b4a30\", \"4a3220\", \"3f2a1b\", \"6e5a48\" }, rand), \"Wood\", true, nil,\n\t\t\t\t\t\tv(between(rand, -10, 10), between(rand, 0, 180), between(rand, -8, 8))))\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t-- the plants, drawn whole over their boxes\n\tlocal plant = PLANTS[id]\n\tif plant ~= nil then plantDecor(region, plant, \"\", add, rand) end\n\tlocal more = MORE_PLANTS[id]\n\tif more ~= nil then plantDecor(region, more, \"2\", add, rand) end\nend\n\n-- The path round the east end: the lawn's edge leaning over the gravel either side (its own stones are the patches').\nlocal function pathDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal rand = rng(region.seed, 37)\n\tlocal alongX = hi.X - lo.X > hi.Z - lo.Z\n\tfor i = 1, 3 do\n\t\tlocal side = if i % 2 == 0 then 1 else -1\n\t\tlocal x, z\n\t\tif alongX then x, z = between(rand, lo.X + 5, hi.X - 5), if side > 0 then hi.Z + 1 else lo.Z - 1\n\t\telse x, z = if side > 0 then hi.X + 1 else lo.X - 1, between(rand, lo.Z + 5, hi.Z - 5) end\n\t\t-- (a tuft of the lawn's edge, its blades leaning out over the gravel)\n\t\tlocal out = if alongX then (if side > 0 then 90 else 270) else (if side > 0 then 180 else 0)\n\t\tfor b = 1, 3 do\n\t\t\tblade(add, `Edge{i}_{b}`, v(x + between(rand, -0.6, 0.6), GT, z + between(rand, -0.6, 0.6)), between(rand, 6, 13), between(rand, 0.35, 0.5), out + between(rand, -35, 35),\n\t\t\t\tbetween(rand, 8, 25), nil, pick(C.lawnColors, rand), i > 1 or b > 1)\n\t\tend\n\tend\nend\n\n-- ---------------------------------------------------------------- the patches (ROBLOX-117): what the spider sees close\n-- Each garden cell and each length of the path is cut into patches of about PATCH studs square, drawn-only looks of their own (kind \"patch\", World/WorldMap.patches)\n-- that World/LookPlan draws only near the spider (LookPlan.PATCH_RADIUS): the dense detail of the ground at true size where the eye is, and nothing beyond it.\n--   the lawn ........ tufts of grass blades 3 to 5 mm wide and 5 to 15 cm tall, leaning and bending, each round a clump; seed heads on taller stalks; white clover;\n--   the mulch ....... shredded bark in layers (chips of 1 to 6 cm in reds, browns and weathered greys, tilted over one another), shredded leaf, twigs, seeds, the\n--                     soil showing between, and now and then a seedling;\n--   the gravel ...... stones of 2 to 12 mm in the path's tones;\n-- and where they fall, the petals and florets under the flowers, the husks and millet under the feeder and a cardinal's feather, and the morning's dew on blades\n-- and chips (the \"Dew\" group, shown by the hour).\nHut.PATCH = 25\nlocal PATCHED: { [string]: boolean } = { garden_bed = true, hut_path = true }\nlocal patchParent: { [string]: Region } = {}\n\n-- The patches of the hut's regions, for a world seed: region-shaped records of kind \"patch\", their bounds the patch's footprint from the ground to 30 studs over the beds.\nfunction Hut.patches(regions: { Region }, worldSeed: number, seedOf: (number, string) -> number): { Region }\n\tlocal out: { Region } = {}\n\tfor _, r in regions do\n\t\tif PATCHED[r.kind] then\n\t\t\tlocal lo, hi = r.bounds[1], r.bounds[2]\n\t\t\tlocal nx = math.max(1, math.ceil((hi.X - lo.X) / Hut.PATCH - 1e-6))\n\t\t\tlocal nz = math.max(1, math.ceil((hi.Z - lo.Z) / Hut.PATCH - 1e-6))\n\t\t\tlocal dx, dz = (hi.X - lo.X) / nx, (hi.Z - lo.Z) / nz\n\t\t\tfor i = 1, nx do\n\t\t\t\tfor j = 1, nz do\n\t\t\t\t\tlocal pid = `{r.id}~{i}_{j}`\n\t\t\t\t\tlocal plo, phi = v(lo.X + (i - 1) * dx, GT - 2, lo.Z + (j - 1) * dz), v(lo.X + i * dx, S + 30, lo.Z + j * dz)\n\t\t\t\t\tlocal mid = (plo + phi) * 0.5\n\t\t\t\t\tlocal p = table.freeze({\n\t\t\t\t\t\tid = pid, kind = \"patch\", origin = mid, bounds = table.freeze({ plo, phi }), seed = seedOf(worldSeed, pid), neighbors = table.freeze({}),\n\t\t\t\t\t\tretreats = table.freeze({}), spawn = table.freeze({ pos = mid, heading = v(0, 0, -1) }), clockScale = r.clockScale,\n\t\t\t\t\t}) :: any\n\t\t\t\t\tpatchParent[pid] = r\n\t\t\t\t\ttable.insert(out, p)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn out\nend\n\n-- The region a patch belongs to.\nfunction Hut.patchParent(patch: Region): Region?\n\treturn patchParent[patch.id]\nend\n\n-- What the ground is at (x, z) of a region: \"lawn\", \"mulch\", \"soil\" (the herb bed), \"gravel\" (a path), \"drip\" (the strip along the hut's foot), and its top.\nlocal function surfaceAt(region: Region, x: number, z: number): (string, number)\n\tif region.kind == \"hut_path\" then return \"gravel\", GT end\n\tlocal bed = bedAt(x, z)\n\tif bed == \"pollinator\" then return \"mulch\", S end\n\tif bed == \"herbs\" then return \"soil\", S end\n\tif onPath(x, z, 0) then return \"gravel\", GT end\n\tif z > -46 then return \"drip\", GT end\n\treturn \"lawn\", GT\nend\n-- The base slab also runs beneath drawn paths/beds. Close cover must use the\n-- same authored classification as the existing garden patches.\nHut.surfaceAt = surfaceAt\n\nlocal GRASS = { \"5c8a3a\", \"6f9a46\", \"4f7a33\", \"86a85a\", \"7d8f48\", \"668f3e\", \"93a860\", \"a8a066\" }\nlocal CHIPS = { \"5a3c26\", \"6b4a30\", \"4a3220\", \"7a5536\", \"3f2a1b\", \"6e5a48\", \"5e4434\", \"4d3a2c\", \"7e6650\" }\nlocal LAYERS = { \"3f2a1b\", \"4a3220\", \"5a3c26\", \"553826\", \"3a2a20\", \"61442e\" }\nlocal STONES = { \"b3a68a\", \"938870\", \"c9bfa8\", \"8f8676\", \"a69a80\", \"d1c7b0\", \"7d7466\", \"bfae92\" }\n\n-- The patch's look: low records first (the few the low tier keeps), then the full tier's, to its budget.\nlocal function patchDecor(patch: Region, add: (Drawn) -> boolean)\n\tlocal parent = patchParent[patch.id]\n\tif parent == nil then return end\n\tlocal lo, hi = patch.bounds[1], patch.bounds[2]\n\tlocal rand = rng(patch.seed, 41)\n\tlocal onGround = standingNear(parent, GT)\n\tlocal onBed = standingNear(parent, S)\n\tlocal Q = Hut.POLE\n\tlocal feeder = parent.id == \"garden_b1\" or parent.id == \"garden_a1\" or parent.id == \"garden_b2\" or parent.id == \"garden_a2\"\n\t-- the spots: a jittered grid of 5 by 5, in a seeded order\n\tlocal spots: { Vector3 } = {}\n\tlocal n = 5\n\tfor i = 1, n do\n\t\tfor j = 1, n do\n\t\t\tlocal x = lo.X + (i - 1 + between(rand, 0.15, 0.85)) * (hi.X - lo.X) / n\n\t\t\tlocal z = lo.Z + (j - 1 + between(rand, 0.15, 0.85)) * (hi.Z - lo.Z) / n\n\t\t\ttable.insert(spots, v(x, 0, z))\n\t\tend\n\tend\n\tfor i = #spots, 2, -1 do\n\t\tlocal j = 1 + math.floor(rand() * i) % i\n\t\tspots[i], spots[j] = spots[j], spots[i]\n\tend\n\tlocal function free(kind: string, x: number, z: number, m: number): boolean\n\t\tif kind == \"mulch\" or kind == \"soil\" then return clear(onBed, x, z, m) end\n\t\treturn clear(onGround, x, z, m)\n\tend\n\tlocal k = 0\n\t-- a tuft of grass: blades from one crown, each leaning out from it (its yaw away from the crown), a few bent over at the knee; `low` of them the low tier keeps\n\tlocal function tuft(x: number, z: number, low: number, bladesN: number)\n\t\tk += 1\n\t\tlocal tone = pick(GRASS, rand)\n\t\tlocal spin = between(rand, 0, 360)\n\t\tfor b = 1, bladesN do\n\t\t\tlocal yaw = spin + b / bladesN * 360 + between(rand, -25, 25)\n\t\t\tlocal r = between(rand, 0.15, 0.7)\n\t\t\tlocal foot = v(x + math.cos(math.rad(yaw)) * r, GT, z - math.sin(math.rad(yaw)) * r)\n\t\t\tblade(add, `Blade{k}_{b}`, foot, between(rand, 5, 15), between(rand, 0.3, 0.5), yaw + 180, between(rand, 3, 18),\n\t\t\t\tif rand() < 0.3 then between(rand, 15, 45) else nil, if rand() < 0.5 then tone else pick(GRASS, rand), b > low)\n\t\tend\n\tend\n\t-- shredded bark: mostly strips (2 to 5 cm long, 4 to 10 mm wide, thin), some chunks; each tilted over the ones under it, in layers\n\tlocal function chip(x: number, z: number, y: number, full: boolean, big: boolean)\n\t\tk += 1\n\t\tlocal strip = not big and rand() < 0.65\n\t\tlocal l = if big then between(rand, 2.0, 3.5) elseif strip then between(rand, 1.5, 4) else between(rand, 0.8, 2.0)\n\t\tlocal w = if strip then between(rand, 0.3, 0.8) else l * between(rand, 0.45, 0.75)\n\t\tlocal t = if strip then between(rand, 0.1, 0.18) else between(rand, 0.18, 0.35)\n\t\tadd(rec(`Chip{k}`, v(l, t, w), v(x, y + t / 2 + between(rand, 0, 0.25), z), pick(CHIPS, rand), \"Wood\", full, nil,\n\t\t\tv(between(rand, -14, 14), between(rand, 0, 180), between(rand, -12, 12))))\n\tend\n\t-- a layer of the mulch: a broad, flat, irregular patch of one tone over the bed's own, so the mulch reads mottled and layered\n\tlocal function layer(x: number, z: number, y: number, full: boolean)\n\t\tk += 1\n\t\tlocal w = between(rand, 4, 8)\n\t\tadd(rec(`Layer{k}`, v(w, 0.12, w * between(rand, 0.5, 0.85)), v(x, y + between(rand, 0.04, 0.14), z), pick(LAYERS, rand), \"Ground\", full, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\tend\n\tlocal function stone(x: number, z: number, y: number, full: boolean, dark: boolean)\n\t\tk += 1\n\t\tlocal s = between(rand, 0.2, 0.9)\n\t\tadd(rec(`Stone{k}`, v(s, s * between(rand, 0.55, 0.85), s * between(rand, 0.75, 1.15)), v(x, y + s * 0.2, z), if dark then pick({ \"7d7466\", \"938870\", \"6e665a\" }, rand) else pick(STONES, rand),\n\t\t\t\"Pebble\", full, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\tend\n\t-- the low tier's few: a clump on the lawn, the bigger chips on the mulch, the bigger stones on the gravel\n\tfor s = 1, 4 do\n\t\tlocal p = spots[s]\n\t\tlocal kind, top = surfaceAt(parent, p.X, p.Z)\n\t\tif free(kind, p.X, p.Z, 2) then\n\t\t\tif kind == \"lawn\" then\n\t\t\t\tif s <= 2 then tuft(p.X, p.Z, 5, 5) end\n\t\t\telseif kind == \"mulch\" then\n\t\t\t\tlayer(p.X, p.Z, top, false)\n\t\t\t\tchip(p.X + between(rand, -2, 2), p.Z + between(rand, -2, 2), top, false, s == 1)\n\t\t\telseif kind == \"gravel\" or kind == \"drip\" then\n\t\t\t\tfor _ = 1, 2 do stone(p.X + between(rand, -2, 2), p.Z + between(rand, -2, 2), top, false, kind == \"drip\") end\n\t\t\tend\n\t\tend\n\tend\n\t-- what falls where: the husks and millet under the feeder and a cardinal's feather; petals and florets under the flowers\n\tlocal function near(x: number, z: number, r: number): boolean\n\t\tlocal cx, cz = math.clamp(x, lo.X, hi.X), math.clamp(z, lo.Z, hi.Z)\n\t\treturn (cx - x) ^ 2 + (cz - z) ^ 2 <= r * r\n\tend\n\tif feeder and near(Q.x, Q.z, 30) then\n\t\tfor i = 1, 9 do\n\t\t\tlocal x, z = between(rand, lo.X + 1, hi.X - 1), between(rand, lo.Z + 1, hi.Z - 1)\n\t\t\tif (v(x, 0, z) - v(Q.x, 0, Q.z)).Magnitude < 32 and free(\"lawn\", x, z, 0.8) then\n\t\t\t\tif i % 3 == 0 then\n\t\t\t\t\tadd(rec(`Millet{i}`, v(0.25, 0.2, 0.25), v(x, GT + 0.1, z), \"d8c08a\", \"SmoothPlastic\", true, \"Ball\"))\n\t\t\t\telse\n\t\t\t\t\tadd(rec(`Husk{i}`, v(1.0, 0.16, 0.5), v(x, GT + 0.12, z), pick({ \"2a2420\", \"3a3430\", \"4a4440\" }, rand), \"SmoothPlastic\", true, \"Ellipsoid\",\n\t\t\t\t\t\tv(between(rand, -20, 20), between(rand, 0, 180), 0)))\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif near(Q.x + 14, Q.z - 12, 0.1) then\n\t\t\t-- a cardinal's contour feather, 5 cm, lying where it fell under the feeder\n\t\t\tlocal at = v(Q.x + 14, GT + 0.15, Q.z - 12)\n\t\t\tadd(rec(\"FeatherShaft\", v(5.2, 0.12, 0.12), at, \"e6dcd2\", \"SmoothPlastic\", true, \"Cylinder\", v(0, 35, 2)))\n\t\t\tadd(rec(\"FeatherVane1\", v(4.2, 0.03, 0.9), at + v(-0.2, 0.05, -0.45), \"b2242a\", \"Fabric\", true, \"Ellipsoid\", v(0, 35, 4)))\n\t\t\tadd(rec(\"FeatherVane2\", v(3.8, 0.03, 0.8), at + v(0.1, 0.05, 0.45), \"9c1f26\", \"Fabric\", true, \"Ellipsoid\", v(0, 35, -3)))\n\t\tend\n\tend\n\tfor _, list in { { PLANTS[parent.id] }, { MORE_PLANTS[parent.id] } } :: { { any } } do\n\t\tlocal plant = list[1]\n\t\tif plant ~= nil and near(plant.x, plant.z, 16) then\n\t\t\tfor i = 1, 4 do\n\t\t\t\tlocal a, r = between(rand, 0, TAU), between(rand, 3, 14)\n\t\t\t\tlocal x, z = plant.x + math.cos(a) * r, plant.z + math.sin(a) * r\n\t\t\t\tif x > lo.X and x < hi.X and z > lo.Z and z < hi.Z and free(\"mulch\", x, z, 0.5) then\n\t\t\t\t\tif plant.kind == \"coneflower\" then\n\t\t\t\t\t\tadd(rec(`Petal{i}`, v(4.2, 0.06, 1.0), v(x, S + 0.45, z), pick({ C.petal, \"9c6a84\", \"c79bb2\" }, rand), \"SmoothPlastic\", true, nil, v(between(rand, -8, 8), between(rand, 0, 180), 0)))\n\t\t\t\t\telseif plant.kind == \"milkweed\" then\n\t\t\t\t\t\tadd(rec(`Fallen{i}`, v(1.0, 0.7, 1.0), v(x, S + 0.6, z), pick({ \"b88a8e\", \"a07a7e\", C.umbel }, rand), \"SmoothPlastic\", true, \"Ball\"))\n\t\t\t\t\telseif plant.kind == \"goldenrod\" then\n\t\t\t\t\t\tadd(rec(`Fleck{i}`, v(0.5, 0.3, 0.5), v(x, S + 0.5, z), \"c9a22e\", \"SmoothPlastic\", true, \"Ball\"))\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t-- the rest of the full tier's detail, spot by spot, to the patch's budget\n\tlocal dews = 0\n\tfor pass = 1, 5 do\n\t\tfor s, p in spots do\n\t\t\tlocal x, z = p.X + between(rand, -2.2, 2.2) * (pass - 1), p.Z + between(rand, -2.2, 2.2) * (pass - 1)\n\t\t\tlocal kind, top = surfaceAt(parent, x, z)\n\t\t\tif free(kind, x, z, 1.5) then\n\t\t\t\tif kind == \"lawn\" then\n\t\t\t\t\tif (s + pass) % 3 ~= 0 then tuft(x, z, 0, 8)\n\t\t\t\t\telseif pass == 1 and s % 5 == 0 then\n\t\t\t\t\t\t-- a seed head on a taller stalk\n\t\t\t\t\t\tk += 1\n\t\t\t\t\t\tlocal h = between(rand, 14, 20)\n\t\t\t\t\t\tlocal lean = between(rand, 3, 12)\n\t\t\t\t\t\tlocal yaw = between(rand, 0, 360)\n\t\t\t\t\t\tlocal r = math.rad(lean)\n\t\t\t\t\t\tlocal dir = v(-math.sin(r) * math.cos(math.rad(yaw)), math.cos(r), math.sin(r) * math.sin(math.rad(yaw)))\n\t\t\t\t\t\tadd(rec(`Stalk{k}`, v(0.18, h, 0.18), v(x, GT, z) + dir * (h / 2), \"a8a066\", \"SmoothPlastic\", true, nil, v(0, yaw, lean)))\n\t\t\t\t\t\tadd(rec(`Seedhead{k}`, v(0.7, 2.6, 0.7), v(x, GT, z) + dir * (h + 1.0), pick({ \"b5a36a\", \"9a8a5a\", \"c2b27a\" }, rand), \"SmoothPlastic\", true, \"Ellipsoid\", v(0, yaw, lean)))\n\t\t\t\t\telseif pass == 1 and s % 7 == 1 then\n\t\t\t\t\t\t-- white clover: three round leaflets on a stalk\n\t\t\t\t\t\tk += 1\n\t\t\t\t\t\tlocal hh = between(rand, 2, 4)\n\t\t\t\t\t\tadd(rec(`CloverStalk{k}`, v(0.12, hh, 0.12), v(x, GT + hh / 2, z), \"7a9a52\", \"SmoothPlastic\", true))\n\t\t\t\t\t\tfor q = 1, 3 do\n\t\t\t\t\t\t\tlocal a = q / 3 * TAU + between(rand, 0, 0.5)\n\t\t\t\t\t\t\tadd(rec(`Clover{k}_{q}`, v(1.3, 0.1, 1.1), v(x + math.cos(a) * 0.65, GT + hh, z + math.sin(a) * 0.65), \"4f7d3a\", \"SmoothPlastic\", true, \"Ellipsoid\", v(0, -math.deg(a), 0)))\n\t\t\t\t\t\tend\n\t\t\t\t\telseif dews < 3 then\n\t\t\t\t\t\tdews += 1\n\t\t\t\t\t\tadd(drop(`Dew{dews}`, v(x, GT + between(rand, 3, 8), z), between(rand, 0.3, 0.55), rand))\n\t\t\t\t\tend\n\t\t\t\telseif kind == \"mulch\" then\n\t\t\t\t\tlocal roll = rand()\n\t\t\t\t\tif pass == 1 and s % 4 == 0 then layer(x, z, top, true)\n\t\t\t\t\telseif roll < 0.7 then\n\t\t\t\t\t\tchip(x, z, top, true, rand() < 0.15)\n\t\t\t\t\t\tfor _ = 1, 2 do chip(x + between(rand, -2, 2), z + between(rand, -2, 2), top, true, false) end\n\t\t\t\t\telseif roll < 0.74 then\n\t\t\t\t\t\tk += 1\n\t\t\t\t\t\tadd(rec(`LeafBit{k}`, v(between(rand, 1, 2.5), 0.05, between(rand, 0.5, 1.2)), v(x, top + 0.45, z), pick({ \"6b5a32\", \"7a6a3a\", \"5a5a2e\", \"8a6a3a\" }, rand), \"Fabric\", true, nil,\n\t\t\t\t\t\t\tv(between(rand, -10, 10), between(rand, 0, 180), 0)))\n\t\t\t\t\telseif roll < 0.8 then\n\t\t\t\t\t\tk += 1\n\t\t\t\t\t\tadd(rec(`Twig{k}`, v(between(rand, 3, 8), between(rand, 0.18, 0.32), between(rand, 0.18, 0.32)), v(x, top + 0.4, z), pick({ \"6e5e4e\", \"5a4a3a\", \"7e6e5a\" }, rand), \"Wood\", true,\n\t\t\t\t\t\t\t\"Cylinder\", v(0, between(rand, 0, 180), between(rand, -4, 4))))\n\t\t\t\t\telseif roll < 0.86 then\n\t\t\t\t\t\tk += 1\n\t\t\t\t\t\tadd(rec(`Seed{k}`, v(0.55, 0.3, 0.35), v(x, top + 0.35, z), pick({ \"2e2620\", \"c9b48a\", \"6a4a2a\" }, rand), \"SmoothPlastic\", true, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\t\t\t\t\telseif roll < 0.93 then\n\t\t\t\t\t\tk += 1\n\t\t\t\t\t\tlocal w = between(rand, 3, 6)\n\t\t\t\t\t\tadd(rec(`Earth{k}`, v(w, 0.08, w * between(rand, 0.5, 0.9)), v(x, top + 0.03, z), C.soilDark, \"Ground\", true, \"Ellipsoid\", v(0, between(rand, 0, 180), 0)))\n\t\t\t\t\telseif pass == 1 then\n\t\t\t\t\t\t-- a seedling coming up through the mulch: a stem and its first two leaves\n\t\t\t\t\t\tk += 1\n\t\t\t\t\t\tlocal h = between(rand, 2, 4)\n\t\t\t\t\t\tadd(rec(`Seedling{k}`, v(0.15, h, 0.15), v(x, top + h / 2, z), \"7a9a52\", \"SmoothPlastic\", true))\n\t\t\t\t\t\tadd(rec(`SeedLeaf{k}a`, v(1.4, 0.08, 0.7), v(x + 0.7, top + h, z), \"6f9a46\", \"SmoothPlastic\", true, \"Ellipsoid\", v(0, 0, 12)))\n\t\t\t\t\t\tadd(rec(`SeedLeaf{k}b`, v(1.4, 0.08, 0.7), v(x - 0.7, top + h, z), \"6f9a46\", \"SmoothPlastic\", true, \"Ellipsoid\", v(0, 0, -12)))\n\t\t\t\t\telseif dews < 2 then\n\t\t\t\t\t\tdews += 1\n\t\t\t\t\t\tadd(drop(`Dew{dews}`, v(x, top + 0.6, z), between(rand, 0.25, 0.45), rand))\n\t\t\t\t\tend\n\t\t\t\telseif kind == \"soil\" then\n\t\t\t\t\tif rand() < 0.5 then chip(x, z, top, true, false) else\n\t\t\t\t\t\tk += 1\n\t\t\t\t\t\tadd(rec(`Crumb{k}`, v(1.2, 0.4, 0.9), v(x, top + 0.15, z), C.soilDark, \"Ground\", true, \"Ellipsoid\"))\n\t\t\t\t\tend\n\t\t\t\telse\n\t\t\t\t\tfor _ = 1, 4 do stone(x + between(rand, -2.4, 2.4), z + between(rand, -2.4, 2.4), top, true, kind == \"drip\") end\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- ---------------------------------------------------------------- (ROBLOX-118) the looks of the ceiling, the back room and the eaves\n-- A thread from a to b, `dia` across (a web's silk, a cable): a Cylinder turned onto the line (World/PreserveLook's rod).\nlocal function thread(add: (Drawn) -> boolean, id: string, a: Vector3, b: Vector3, dia: number, color: string, full: boolean, transparency: number?)\n\tlocal d = b - a\n\tlocal len = d.Magnitude\n\tlocal u = d / len\n\tlocal d0 = rec(id, v(len, dia, dia), (a + b) * 0.5, color, \"SmoothPlastic\", full, \"Cylinder\", v(0, math.deg(math.atan2(-u.Z, u.X)), math.deg(math.asin(math.clamp(u.Y, -1, 1)))))\n\td0.transparency = transparency\n\treturn add(d0)\nend\n\n-- The ceiling over a cell: the boards' joints (they run east and west across the joists); in the hut's north-west corner over the notice board, a house spider's web:\n-- the American house spider (Parasteatoda tepidariorum) hangs a tangle of threads in a ceiling's corner, sits in it head down, and wraps what it catches.\nlocal function upperDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal U = UPPER[region.id]\n\tlocal CE = Hut.CEIL\n\tlocal z = math.ceil(U.z0 / 12) * 12\n\tlocal k = 0\n\twhile z < U.z1 - 1 do\n\t\tk += 1\n\t\tadd(rec(`Joint{k}`, v(U.x1 - U.x0, 0.02, 0.2), v((U.x0 + U.x1) / 2, CE - 0.01, z), \"a88a62\", \"WoodPlanks\", true))\n\t\tz += 12\n\tend\n\tif region.id == \"hut_up_a\" then\n\t\tlocal R = Hut.ROOM\n\t\tlocal corner = v(R.x0, CE, R.z0)\n\t\tlocal rand = rng(region.seed, 11)\n\t\tlocal hub = corner + v(9, -10, 8) -- (where the spider waits, in the tangle's heart)\n\t\tfor i = 1, 14 do\n\t\t\t-- (from the ceiling, the west wall or the north wall near the corner to a point in the tangle)\n\t\t\tlocal face = i % 3\n\t\t\tlocal a = if face == 0 then corner + v(between(rand, 2, 24), 0, between(rand, 2, 22))\n\t\t\t\telseif face == 1 then corner + v(0, between(rand, -22, -2), between(rand, 2, 24)) else corner + v(between(rand, 2, 24), between(rand, -22, -2), 0)\n\t\t\tlocal b = hub + v(between(rand, -6, 6), between(rand, -6, 5), between(rand, -6, 6))\n\t\t\tthread(add, `Silk{i}`, a, b, 0.08, \"e9e6de\", true, 0.2)\n\t\tend\n\t\t-- two gumfooted lines down toward the wall's lining, and the spider: its round abdomen and small cephalothorax, head down; a wrapped fly hanging by it\n\t\tthread(add, \"SilkFoot1\", hub, corner + v(3, -46, 26), 0.08, \"e9e6de\", true, 0.2)\n\t\tthread(add, \"SilkFoot2\", hub, corner + v(24, -50, 2), 0.08, \"e9e6de\", true, 0.2)\n\t\tadd(rec(\"HouseSpider\", v(0.55, 0.6, 0.55), hub + v(0, -0.2, 0), \"6b5a44\", \"SmoothPlastic\", true, \"Ball\"))\n\t\tadd(rec(\"HouseSpiderHead\", v(0.25, 0.3, 0.25), hub + v(0, -0.65, 0), \"8a6a46\", \"SmoothPlastic\", true, \"Ball\"))\n\t\tadd(rec(\"Wrapped\", v(0.4, 0.7, 0.4), hub + v(3, -2, 2), \"d9d3c6\", \"SmoothPlastic\", true, \"Ellipsoid\"))\n\tend\nend\n\n-- The back room's floor: the boards' joints (north and south, as the hut's), a knot or two, the rug's border and its pattern's bands where it lies.\nlocal function roomFloorDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal x = math.ceil(lo.X / 14) * 14\n\tlocal k = 0\n\twhile x < hi.X - 1 do\n\t\tk += 1\n\t\tadd(rec(`Joint{k}`, v(0.18, 0.02, hi.Z - lo.Z), v(x, FL + 0.01, (lo.Z + hi.Z) / 2), C.floorDark, \"WoodPlanks\", true))\n\t\tx += 14\n\tend\n\tlocal rand = rng(region.seed, 5)\n\tfor i = 1, 2 do\n\t\tadd(rec(`Knot{i}`, v(1.2, 0.02, 2.2), v(between(rand, lo.X + 4, hi.X - 4), FL + 0.012, between(rand, lo.Z + 4, hi.Z - 4)), \"5e4430\", \"Wood\", true, \"Ellipsoid\"))\n\tend\n\tlocal G = Hut.RUG\n\tlocal a, b, c, d = clip(G.x0 + 6, G.x1 - 6, G.z0 + 6, G.z1 - 6, lo.X, hi.X, lo.Z, hi.Z)\n\tif a ~= nil then\n\t\t-- The darker inset spans three cells. Full detail keeps it; low keeps\n\t\t-- the continuous physical rug, reserving those three draws for the\n\t\t-- rounded thermos and transparent window within the 150-record cap.\n\t\tadd(rec(\"RugField\", v((b :: number) - a, 0.03, (d :: number) - (c :: number)), v((a + (b :: number)) / 2, FL + G.top + 0.015, ((c :: number) + (d :: number)) / 2), \"6a3029\", \"Fabric\", true))\n\tend\n\tfor side, zz in { G.z0 + 3, G.z1 - 3 } do\n\t\tlocal a2, b2 = math.max(G.x0 + 2, lo.X), math.min(G.x1 - 2, hi.X)\n\t\tif b2 > a2 and zz > lo.Z and zz < hi.Z then add(rec(`RugBand{side}`, v(b2 - a2, 0.03, 1.4), v((a2 + b2) / 2, FL + G.top + 0.015, zz), \"c9a45a\", \"Fabric\", true)) end\n\tend\nend\n\n-- The sofa: the piping along the cushions' fronts and the back's top, a throw folded over the east arm; the controller's sticks and buttons.\nlocal function sofaDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal S0 = Hut.SOFA\n\tlocal west = region.id == \"room_sofa_w\"\n\tlocal ia, ib = if west then S0.x0 + S0.arm else S0.split, if west then S0.split else S0.x1 - S0.arm\n\tadd(rec(\"Piping\", v(ib - ia - 1, 0.5, 0.5), v((ia + ib) / 2, S0.seat - 0.2, S0.z0 + 2.4), C.sofaDark, \"Fabric\", true))\n\tadd(rec(\"BackPiping\", v(ib - ia, 0.5, 0.5), v((ia + ib) / 2, S0.back + 0.2, 245), C.sofaDark, \"Fabric\", true))\n\tlocal ax = if west then S0.x0 + S0.arm / 2 else S0.x1 - S0.arm / 2\n\tadd(rec(\"ArmTop\", v(S0.arm + 1, 2.5, S0.z1 - S0.z0 + 1), v(ax, S0.armTop - 0.5, (S0.z0 + S0.z1) / 2), C.sofa, \"Fabric\", true, \"Cylinder\", v(90, 90, 0)))\n\tif west then\n\t\tadd(rec(\"StickL\", v(1.4, 0.8, 1.4), v(284, S0.seat + 4.3, 200), \"3a3c40\", \"SmoothPlastic\", true, \"Cylinder\", v(0, 0, 90)))\n\t\tadd(rec(\"StickR\", v(1.4, 0.8, 1.4), v(291, S0.seat + 4.3, 203), \"3a3c40\", \"SmoothPlastic\", true, \"Cylinder\", v(0, 0, 90)))\n\t\tfor i, c in { \"3f8f5a\", \"c0392b\", \"2e86c1\", \"e0b23a\" } do\n\t\t\tadd(rec(`Button{i}`, v(0.7, 0.3, 0.7), v(292 + (i % 2) * 1.2, S0.seat + 4.1, 199 + math.floor((i - 1) / 2) * 1.2), c, \"SmoothPlastic\", true, \"Ball\"))\n\t\tend\n\telse\n\t\tadd(rec(\"Throw\", v(S0.arm + 3, 12, 40), v(S0.x1 - S0.arm / 2, S0.armTop - 4, 200), \"b9a27a\", \"Fabric\", true))\n\tend\nend\n\n-- The television: its screen's glass (low: the dark face that tells it is a screen), its maker's light; the console's light and its cable to the television.\nlocal function tvDecor(_region: Region, add: (Drawn) -> boolean)\n\tlocal Sc = Hut.TV.screen\n\tlocal glass = rec(\"Screen\", v(Sc.x1 - Sc.x0 - 2, Sc.y1 - Sc.y0 - 2, 0.05), v((Sc.x0 + Sc.x1) / 2, (Sc.y0 + Sc.y1) / 2, Sc.z1 + 0.03), \"0b0c0e\", \"Glass\", false)\n\tglass.reflectance = 0.25\n\tadd(glass)\n\tadd(rec(\"TvLight\", v(0.4, 0.4, 0.1), v(230, Sc.y0 + 0.6, Sc.z1 + 0.06), \"d23a2a\", \"Neon\", true))\n\tadd(rec(\"ConsoleLight\", v(4, 0.3, 0.1), v(210, -62, 47.06), \"6fb7ff\", \"Neon\", true))\n\tadd(rec(\"Hdmi\", v(0.6, 18, 0.6), v(224, -54, 24), \"1e1e1e\", \"SmoothPlastic\", true))\nend\n\n-- The board games: a label band on the front edge of each box, its own colour lighter or darker.\nlocal function gamesDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal k = 0\n\tfor _, p in Hut.pieces(region) do\n\t\tif string.find(p.id, \"_box_\", 1, true) ~= nil and k < 20 then\n\t\t\tk += 1\n\t\t\tlocal h = p.hi.Y - p.lo.Y\n\t\t\tadd(rec(`Label{k}`, v((p.hi.X - p.lo.X) * 0.6, h * 0.45, 0.05), v((p.lo.X + p.hi.X) / 2, (p.lo.Y + p.hi.Y) / 2, p.hi.Z + 0.03), if k % 2 == 0 then \"f2eee2\" else \"1f1f1f\", \"SmoothPlastic\", true))\n\t\tend\n\tend\nend\n\n-- The back room's window: the sash's frame round its glass inside, and its catch.\nlocal function roomWindowDecor(_region: Region, add: (Drawn) -> boolean)\n\tlocal Wn = Hut.ROOM_WINDOW\n\tlocal gx = Wn.glass - 0.4\n\tlocal pane=rec(\"CrackedGlass\", v(.1,Wn.head-Wn.gap,Wn.z1-Wn.z0), v(Wn.glass+.05,(Wn.head+Wn.gap)/2,(Wn.z0+Wn.z1)/2), \"c9d6d8\", \"Glass\", false)\n\tpane.transparency=.65;pane.reflectance=.08\n\tadd(pane)\n\tadd(rec(\"FrameLow\", v(0.8, 4, Wn.z1 - Wn.z0), v(gx, Wn.gap + 2, (Wn.z0 + Wn.z1) / 2), \"efe9da\", \"Wood\", true))\n\tadd(rec(\"FrameHigh\", v(0.8, 4, Wn.z1 - Wn.z0), v(gx, Wn.head - 2, (Wn.z0 + Wn.z1) / 2), \"efe9da\", \"Wood\", true))\n\tadd(rec(\"FrameRail\", v(0.8, 3, Wn.z1 - Wn.z0), v(gx, Wn.head / 2, (Wn.z0 + Wn.z1) / 2), \"efe9da\", \"Wood\", true))\n\tadd(rec(\"Catch\", v(1.2, 1.2, 3), v(gx - 0.8, Wn.head / 2 + 2, (Wn.z0 + Wn.z1) / 2), C.brass, \"Metal\", true))\nend\n\n-- The eaves: the gutter's hangers over it every 60 cm.\nlocal function eaveDecor(region: Region, add: (Drawn) -> boolean)\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal Gu = Hut.EAVE.gutter\n\tlocal k = 0\n\tlocal x = math.ceil((lo.X + 10) / 60) * 60\n\twhile x < hi.X - 5 and k < 4 do\n\t\tk += 1\n\t\tadd(rec(`Hanger{k}`, v(1.2, 0.3, Hut.EAVE.fascia.out - Gu.out + Gu.wall), v(x, Gu.lip - 0.4, (Gu.out - Gu.wall + Hut.EAVE.fascia.out) / 2), C.gutter, \"Metal\", true))\n\t\tx += 60\n\tend\nend\n\nlocal decorCache: { [string]: { Drawn } } = {}\n-- The drawn look of a region of the hut or its garden, at the full tier (the low tier is the records without `full`). (ROBLOX-117: and of a patch.)\nfunction Hut.decor(region: Region): { Drawn }\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tlocal cached = decorCache[key]\n\tif cached ~= nil then return cached end\n\tlocal budget = Hut.BUDGETS[region.kind]\n\tassert(budget ~= nil, \"no budget for the region kind \" .. region.kind)\n\tlocal list, add = sheet(budget)\n\tlocal k = region.kind\n\tif k == \"hut_floor\" then floorDecor(region, add)\n\telseif k == \"hut_desk\" then\n\t\tadd(rec(\"Thermos\", v(19,8,8), v(118,13.5,52), \"456b59\", \"Metal\", false, \"Cylinder\", v(0,0,90)))\n\t\tadd(rec(\"ThermosCup\", v(3,8,8), v(118,24.5,52), \"b5b8ad\", \"Metal\", false, \"Cylinder\", v(0,0,90)))\n\t\tdeskDecor(region, add)\n\telseif k == \"hut_board\" then boardDecor(region, add)\n\telseif k == \"hut_shelf\" then shelfDecor(region, add)\n\telseif k == \"hut_door\" then doorDecor(region, add)\n\telseif k == \"hut_outer_sill\" then outerDecor(region, add)\n\telseif k == \"hut_bench\" then benchDecor(region, add)\n\telseif k == \"hut_butt\" then buttDecor(region, add)\n\telseif k == \"garden_pole\" then poleDecor(region, add)\n\telseif k == \"garden_bed\" then gardenDecor(region, add)\n\telseif k == \"hut_path\" then pathDecor(region, add)\n\telseif k == \"patch\" then patchDecor(region, add)\n\telseif k == \"hut_upper\" then upperDecor(region, add)\n\telseif k == \"room_floor\" then roomFloorDecor(region, add)\n\telseif k == \"room_sofa\" then sofaDecor(region, add)\n\telseif k == \"room_tv\" then tvDecor(region, add)\n\telseif k == \"room_games\" then gamesDecor(region, add)\n\telseif k == \"room_window\" then roomWindowDecor(region, add)\n\telseif k == \"hut_eave\" then eaveDecor(region, add) end\n\tfor _, d in list do table.freeze(d) end\n\tdecorCache[key] = table.freeze(list)\n\treturn list\nend\n\n-- ---------------------------------------------------------------- the garden's life\n-- Species of the bestiary in the hut garden (docs/GARDEN_BESTIARY.md, the rows already sourced): fungus gnats over the beds' soil and oleander aphids on the\n-- milkweed (World/Garden's W3 pair: one director), springtails in the mulch, leafhoppers on the goldenrod and the coneflower; woodlice under the trough and the\n-- stone; a harvestman by the trough, a millipede under the stone and a ladybird on the milkweed among the aphids. From each cell's own seed by streams of their\n-- own, so the same garden lives the same way.\nexport type Perch = { id: string, position: Vector3, normal: Vector3, shelter: number, food: number, start: boolean, walker: boolean?, kind: string,\n\thop: boolean?, behind: string?, round: Vector3? }\nexport type Vent = { id: string, position: Vector3, normal: Vector3, walker: boolean?, reach: number?, appear: boolean? }\nlocal SHELTER = { soil = 0.2, stone = 0.1, under = 0.6, leaf = 0.3, stem = 0.35 }\nlocal FOOD = { soil = 0.1, stone = 0.05, under = 0.5, leaf = 0.5, stem = 0.5 }\nHut.LIFE = table.freeze({\n\tprey = { garden_c3 = { target = 6, soil = 8, plant = \"milkweed\" }, garden_c4 = { target = 4, soil = 6 } },\n\tspringtails = { garden_d3 = { full = 4, low = 2, perches = 12 } },\n\tleafhoppers = { garden_d4 = { full = 2, low = 1 }, garden_c4 = { full = 1, low = 1 } },\n\twoodlice = { garden_a1 = 3, garden_a3 = 3 },\n\tambient = { garden_a1 = { harvestman = { full = 1, low = 1, salt = 109 } }, garden_a3 = { millipede = { full = 1, low = 1, salt = 103 } },\n\t\tgarden_c3 = { ladybird = { full = 1, low = 1, salt = 101 } } },\n\t-- (ROBLOX-117) the hoverflies on the bed's flowers; the hut's own prey: fruit flies at the compost caddy by the door, a moth at the desk lamp from dusk\n\thoverflies = { garden_c4 = { full = 1, low = 1 }, garden_d4 = { full = 1, low = 1 }, garden_c3 = { full = 1, low = 1 } },\n\tfruitflies = { hut_floor_i = { full = 4, low = 2 }, room_floor_g = { full = 2, low = 1 } },\n\tfloorflies = { hut_floor_e = { full = 1, low = 1 }, room_floor_b = { full = 1, low = 1 }, room_floor_d = { full = 1, low = 1 } },\n\tmoths = { hut_desk = { full = 1, low = 1 }, room_window = { full = 1, low = 1 } },\n\t-- (ROBLOX-120) a field cricket in the pollinator bed's mulch, singing from dusk\n\tcrickets = { garden_d3 = { full = 1, low = 1, perches = 6 } },\n})\n-- (ROBLOX-117) The compost caddy by the door, on the floor east of the doorway against the south wall: a kitchen caddy of green plastic, its lid down, a banana peel over\n-- its rim; the fruit flies' home in the hut.\nHut.CADDY = table.freeze({ x0 = 68, x1 = 90, z0 = 228, z1 = 246, h = 19, lid = 1.5 })\n\n-- The standing boxes of a cell on a surface at `top` (their footprints), and a free spot on that surface inside `area` clear of them.\nlocal function standingOn(region: Region, top: number): { Box }\n\tlocal out: { Box } = {}\n\tfor _, p in Hut.pieces(region) do\n\t\tif math.abs(p.lo.Y - top) < 0.01 then table.insert(out, { min = p.lo, max = p.hi }) end\n\tend\n\treturn out\nend\nlocal function freeSpot(rand: () -> number, area: { number }, top: number, standing: { Box }, taken: { Vector3 }, margin: number, apart: number): Vector3?\n\tfor _ = 1, 50 do\n\t\tlocal x, z = between(rand, area[1] + 2, area[2] - 2), between(rand, area[3] + 2, area[4] - 2)\n\t\tlocal ok = true\n\t\tfor _, b in standing do\n\t\t\tif x > b.min.X - margin and x < b.max.X + margin and z > b.min.Z - margin and z < b.max.Z + margin then ok = false; break end\n\t\tend\n\t\tif ok then for _, t in taken do if (Vector3.new(x, 0, z) - Vector3.new(t.X, 0, t.Z)).Magnitude < apart then ok = false; break end end end\n\t\tif ok then\n\t\t\tlocal p = v(x, top, z)\n\t\t\ttable.insert(taken, p)\n\t\t\treturn p\n\t\tend\n\tend\n\treturn nil\nend\nlocal function byIdOf(region: Region): { [string]: Piece }\n\tlocal out: { [string]: Piece } = {}\n\tfor _, p in Hut.pieces(region) do out[p.id] = p end\n\treturn out\nend\n\nlocal preyCache: { [string]: any } = {}\n-- The cell's gnats and aphids (one director, as the test garden's bed's): the gnats' perches on the bed's soil and under the plant's leaves, the aphids' on its\n-- leaves and stem (walkers), the gnats' vents on the soil and the aphids' at the stem's foot. Nil for a cell without.\nfunction Hut.prey(region: Region): any?\n\tlocal L = Hut.LIFE.prey[region.id]\n\tif L == nil then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tif preyCache[key] ~= nil then return preyCache[key] end\n\t-- (the gnats' soil perches lie round the plant, within a gnat's flight of one another: Data/Species, ten studs)\n\tlocal whole = bedArea(region) :: { number }\n\tlocal plant0 = PLANTS[region.id] :: any\n\tlocal area = { math.max(whole[1], plant0.x - 18), math.min(whole[2], plant0.x + 18), math.max(whole[3], plant0.z - 18), math.min(whole[4], plant0.z + 18) }\n\tlocal perches: { Perch } = {}\n\tlocal vents: { Vent } = {}\n\tlocal function perch(id: string, pos: Vector3, normal: Vector3, kind: string, start: boolean, walker: boolean?)\n\t\ttable.insert(perches, { id = id, position = pos, normal = normal, shelter = (SHELTER :: any)[kind], food = (FOOD :: any)[kind], start = start, walker = walker, kind = kind })\n\tend\n\tlocal standing = standingOn(region, S)\n\tlocal taken: { Vector3 } = {}\n\tlocal rand = rng(region.seed, 61)\n\tlocal soilSpots: { Vector3 } = {}\n\tfor i = 1, L.soil do\n\t\tlocal spot = freeSpot(rand, area, S, standing, taken, 1.0, 3)\n\t\tif spot then perch(`{region.id}_soil_{i}`, spot, Vector3.yAxis, \"soil\", i <= 2); table.insert(soilSpots, spot) end\n\tend\n\tlocal plant = PLANTS[region.id]\n\tlocal byId = byIdOf(region)\n\tif plant ~= nil then\n\t\tlocal base = `{region.id}_{plant.kind}`\n\t\tlocal spec = PLANT_SPECS[plant.kind]\n\t\tfor i = 1, #spec.leaves do\n\t\t\tlocal leaf = byId[`{base}_leaf_{i}`]\n\t\t\tif leaf ~= nil then\n\t\t\t\tlocal cx, cz = (leaf.lo.X + leaf.hi.X) / 2, (leaf.lo.Z + leaf.hi.Z) / 2\n\t\t\t\tperch(leaf.id .. \"_under\", v(cx, leaf.lo.Y, cz), -Vector3.yAxis, \"under\", i == 1)\n\t\t\t\tif L.plant == plant.kind then perch(leaf.id .. \"_top\", v(cx, leaf.hi.Y, cz), Vector3.yAxis, \"leaf\", i <= 2, true) end\n\t\t\tend\n\t\tend\n\t\tlocal stem = byId[base .. \"_stem\"]\n\t\tif L.plant == plant.kind and stem ~= nil then\n\t\t\tperch(stem.id .. \"_side\", v(stem.hi.X, S + 12, (stem.lo.Z + stem.hi.Z) / 2), Vector3.xAxis, \"stem\", true, true)\n\t\t\ttable.insert(vents, { id = region.id .. \"_vent_\" .. plant.kind, position = v(stem.hi.X + 1.2, S, (stem.lo.Z + stem.hi.Z) / 2), normal = Vector3.yAxis, walker = true, reach = 60 })\n\t\tend\n\tend\n\tfor i = 1, 2 do\n\t\tlocal spot: Vector3? = nil\n\t\tfor _ = 1, 12 do\n\t\t\tlocal try = freeSpot(rand, area, S, standing, taken, 1.0, 3)\n\t\t\tif try == nil then break end\n\t\t\tfor _, sp in soilSpots do\n\t\t\t\tlocal d = (sp - try).Magnitude\n\t\t\t\tif d >= 4 and d <= 12 then spot = try; break end\n\t\t\tend\n\t\t\tif spot ~= nil then break end\n\t\tend\n\t\tif spot then table.insert(vents, math.min(1 + (i - 1) * 2, #vents + 1), { id = `{region.id}_vent_soil_{i}`, position = spot, normal = Vector3.yAxis }) end\n\tend\n\tlocal out = { perches = perches, vents = vents, target = L.target, seed = region.seed, prefix = region.id .. \"_fly_\" }\n\tpreyCache[key] = out\n\treturn out\nend\n\nlocal bugsCache: { [string]: any } = {}\n-- The cell's woodlice: their starting places on the lawn and the spots they hide in (the mouths of the gap under the trough or the stone, the feet beside them).\nfunction Hut.bugs(region: Region): any?\n\tlocal count = Hut.LIFE.woodlice[region.id]\n\tif count == nil then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tif bugsCache[key] ~= nil then return bugsCache[key] end\n\tlocal hides = {}\n\tfor _, t in region.retreats do\n\t\tlocal cx = (t.min.X + t.max.X) / 2\n\t\ttable.insert(hides, { pos = v(cx, GT, t.max.Z + 0.6), kind = \"stone\" })\n\t\ttable.insert(hides, { pos = v(cx, GT, t.min.Z - 0.6), kind = \"stone\" })\n\tend\n\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\tlocal standing = standingOn(region, GT)\n\tlocal taken: { Vector3 } = {}\n\tlocal rand = rng(region.seed, 67)\n\tlocal lice = {}\n\tfor _ = 1, count do\n\t\tlocal spot = freeSpot(rand, { lo.X, hi.X, lo.Z, -50 }, GT, standing, taken, 1.0, 6)\n\t\tif spot then\n\t\t\tlocal a = rand() * TAU\n\t\t\ttable.insert(lice, { pos = spot, heading = v(math.cos(a), 0, math.sin(a)) })\n\t\tend\n\tend\n\tlocal out = { woodlice = lice, hides = hides, seed = region.seed, prefix = region.id .. \"_\" }\n\tbugsCache[key] = out\n\treturn out\nend\n\nlocal bestiaryCache: { [string]: any } = {}\n-- The cell's bestiary prey, a spec per kind (World/Garden.bestiary's shape): springtails in the mulch round the bark chip and the stone; leafhoppers in pairs\n-- either side of the plant's stem, low and high, and its leaves.\nfunction Hut.bestiary(region: Region): { any }?\n\tlocal spring, hopper = Hut.LIFE.springtails[region.id], Hut.LIFE.leafhoppers[region.id]\n\tlocal hover, fruit, moth = Hut.LIFE.hoverflies[region.id], Hut.LIFE.fruitflies[region.id], Hut.LIFE.moths[region.id]\n\tlocal cricket = Hut.LIFE.crickets[region.id]\n\tlocal floorfly = Hut.LIFE.floorflies[region.id]\n\tif spring == nil and hopper == nil and hover == nil and fruit == nil and moth == nil and cricket == nil and floorfly == nil then return nil end\n\tlocal key = region.id .. \"/\" .. tostring(region.seed)\n\tif bestiaryCache[key] ~= nil then return bestiaryCache[key] end\n\tlocal out: { any } = {}\n\tif floorfly ~= nil then\n\t\tlocal rand = rng(region.seed, 137)\n\t\tlocal lo, hi = region.bounds[1], region.bounds[2]\n\t\tlocal standing = standingOn(region, FL)\n\t\tlocal taken: { Vector3 } = {}\n\t\tlocal centre = freeSpot(rand, {lo.X + 10, hi.X - 10, lo.Z + 10, hi.Z - 10}, FL, standing, taken, 2, 2)\n\t\tif centre ~= nil then\n\t\t\tlocal perches: { Perch } = {}\n\t\t\tlocal function add(p: Vector3)\n\t\t\t\ttable.insert(perches, {id = `{region.id}_floor_fly_{#perches + 1}`, position = p, normal = Vector3.yAxis,\n\t\t\t\t\tshelter = .1, food = .1, start = #perches < floorfly.full, kind = \"floor\"})\n\t\t\tend\n\t\t\tadd(centre)\n\t\t\tfor _ = 1, 7 do\n\t\t\t\tlocal p = freeSpot(rand, {centre.X - 9, centre.X + 9, centre.Z - 9, centre.Z + 9}, FL, standing, taken, 2, 2)\n\t\t\t\tif p ~= nil then add(p) end\n\t\t\tend\n\t\t\ttable.insert(out, {kind = \"housefly\", profile = \"fly_like_prototype\", perches = perches,\n\t\t\t\tvents = {{id = region.id .. \"_floor_fly_vent\", position = centre + v(0, 8, 0), normal = Vector3.yAxis, appear = true, reach = 40}},\n\t\t\t\ttarget = floorfly.full, low = floorfly.low, seed = (region.seed + 137 * 104729) % MOD,\n\t\t\t\tprefix = region.id .. \"_floor_fly_\", floor = FL - 2, ceiling = FL + 18})\n\t\tend\n\tend\n\tif spring ~= nil then\n\t\tlocal salt = 71\n\t\tlocal rand = rng(region.seed, salt)\n\t\tlocal area = bedArea(region) :: { number }\n\t\tlocal standing = standingOn(region, S)\n\t\tfor _, t in region.retreats do table.insert(standing, { min = t.min - v(0.5, 0, 0.5), max = t.max + v(0.5, 0, 0.5) }) end\n\t\tlocal centres: { Vector3 } = {}\n\t\tfor _, t in region.retreats do table.insert(centres, v((t.min.X + t.max.X) / 2, S, t.max.Z + 1.2)) end\n\t\tfor _, p in Hut.pieces(region) do if string.find(p.id, \"_stone_\", 1, true) ~= nil then table.insert(centres, v((p.lo.X + p.hi.X) / 2, S, p.hi.Z + 1.2)) end end\n\t\tlocal perches: { Perch } = {}\n\t\tlocal taken: { Vector3 } = {}\n\t\tfor i = 1, spring.perches do\n\t\t\tlocal c = centres[(i - 1) % #centres + 1]\n\t\t\tlocal spot = freeSpot(rand, { math.max(area[1], c.X - 8), math.min(area[2], c.X + 8), math.max(area[3], c.Z - 6), math.min(area[4], c.Z + 6) }, S, standing, taken, 0.3, 1.0)\n\t\t\tif spot then table.insert(perches, { id = `{region.id}_springtail_{#perches + 1}`, position = spot, normal = Vector3.yAxis, shelter = 0.5, food = 0.4, start = #perches < spring.full, kind = \"soil\", hop = true }) end\n\t\tend\n\t\tlocal vents: { Vent } = {}\n\t\tfor i, c in centres do if i <= 2 then table.insert(vents, { id = `{region.id}_vent_springtail_{i}`, position = c, normal = Vector3.yAxis, appear = true, reach = 6 }) end end\n\t\ttable.insert(out, { kind = \"springtail\", profile = \"springtail_prototype\", perches = perches, vents = vents, target = spring.full, low = spring.low,\n\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_springtail_fly_` })\n\tend\n\tif cricket ~= nil then\n\t\t-- (ROBLOX-120) the field cricket: spots on the mulch a jump apart (8 to 24 studs), clear of the plants' stems and the stones; it comes up out of the mulch\n\t\tlocal salt = 79\n\t\tlocal rand = rng(region.seed, salt)\n\t\tlocal area = bedArea(region) :: { number }\n\t\tlocal standing = standingOn(region, S)\n\t\tfor _, t in region.retreats do table.insert(standing, { min = t.min - v(1, 0, 1), max = t.max + v(1, 0, 1) }) end\n\t\tlocal perches: { Perch } = {}\n\t\tlocal taken: { Vector3 } = {}\n\t\tfor i = 1, cricket.perches do\n\t\t\tlocal spot = freeSpot(rand, area, S, standing, taken, 1.5, 9)\n\t\t\tif spot then table.insert(perches, { id = `{region.id}_cricket_{i}`, position = spot, normal = Vector3.yAxis, shelter = 0.6, food = 0.3, start = #perches < cricket.full, kind = \"soil\", hop = true }) end\n\t\tend\n\t\tlocal vents: { Vent } = {}\n\t\tif #perches > 1 then table.insert(vents, { id = `{region.id}_vent_cricket`, position = perches[#perches].position, normal = Vector3.yAxis, appear = true, reach = 10 }) end\n\t\ttable.insert(out, { kind = \"cricket\", profile = \"cricket_prototype\", perches = perches, vents = vents, target = cricket.full, low = cricket.low,\n\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_cricket_fly_`, dusk = { from = 19.0, to = 6.5 } })\n\tend\n\tif hopper ~= nil then\n\t\tlocal salt = 73\n\t\tlocal plant = PLANTS[region.id] :: any\n\t\tlocal byId = byIdOf(region)\n\t\tlocal stem = byId[`{region.id}_{plant.kind}_stem`] :: Piece\n\t\tlocal perches: { Perch } = {}\n\t\tlocal n = 0\n\t\tlocal function pair(a: Vector3, na: Vector3, b: Vector3, nb: Vector3, round: Vector3, kind: string, start: boolean)\n\t\t\tn += 1\n\t\t\tlocal ia, ib = `{region.id}_leafhopper_{n}a`, `{region.id}_leafhopper_{n}b`\n\t\t\ttable.insert(perches, { id = ia, position = a, normal = na, shelter = 0.4, food = 0.6, start = start, kind = kind, hop = true, behind = ib, round = round })\n\t\t\ttable.insert(perches, { id = ib, position = b, normal = nb, shelter = 0.4, food = 0.6, start = false, kind = kind, hop = true, behind = ia, round = round })\n\t\tend\n\t\tlocal mx, mz = (stem.lo.X + stem.hi.X) / 2, (stem.lo.Z + stem.hi.Z) / 2\n\t\tfor k, h in { 9, 31, 49 } do\n\t\t\tlocal y = S + h\n\t\t\tif k % 2 == 1 then pair(v(stem.hi.X, y, mz), Vector3.xAxis, v(stem.lo.X, y, mz), -Vector3.xAxis, v(mx, y, stem.hi.Z + 0.35), \"stem\", k == 1)\n\t\t\telse pair(v(mx, y, stem.hi.Z), Vector3.zAxis, v(mx, y, stem.lo.Z), -Vector3.zAxis, v(stem.hi.X + 0.35, y, mz), \"stem\", false) end\n\t\tend\n\t\tlocal vents: { Vent } = { { id = `{stem.id}_vent_leafhopper`, position = v(mx, S, stem.lo.Z - 0.8), normal = Vector3.yAxis, appear = true, reach = 60 } }\n\t\ttable.insert(out, { kind = \"leafhopper\", profile = \"leafhopper_prototype\", perches = perches, vents = vents, target = hopper.full, low = hopper.low,\n\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_leafhopper_fly_` })\n\tend\n\t-- (ROBLOX-117) a perch list of `kind` with these spots ({ position, normal, shelter, food }), the first `starts` of them starting perches\n\tlocal function spot(p: Vector3, n: Vector3, sh: number, fo: number): { any }\n\t\treturn { p, n, sh, fo }\n\tend\n\tlocal function spots(kind: string, list: { { any } }, starts: number): { Perch }\n\t\tlocal perches: { Perch } = {}\n\t\tfor i, sp in list do\n\t\t\ttable.insert(perches, { id = `{region.id}_{kind}_{i}`, position = sp[1], normal = sp[2], shelter = sp[3], food = sp[4], start = i <= starts, kind = \"leaf\" })\n\t\tend\n\t\treturn perches\n\tend\n\tif hover ~= nil then\n\t\t-- the hoverflies: on the flowers' heads and the plants' upper leaves (the cell's two plants), coming in out of sight over the bed\n\t\tlocal byId = piecesById(region)\n\t\tlocal list: { { any } } = {}\n\t\tfor _, pl in { { PLANTS[region.id], \"\" }, { MORE_PLANTS[region.id], \"2\" } } :: { { any } } do\n\t\t\tlocal plant = pl[1]\n\t\t\tif plant ~= nil then\n\t\t\t\tlocal base = `{region.id}_{plant.kind}{pl[2]}`\n\t\t\t\tlocal head = byId[base .. \"_cone\"] or byId[base .. \"_head\"]\n\t\t\t\tif head ~= nil then table.insert(list, spot(v((head.lo.X + head.hi.X) / 2, head.hi.Y, (head.lo.Z + head.hi.Z) / 2), Vector3.yAxis, 0.2, 0.9)) end\n\t\t\t\tlocal spec = PLANT_SPECS[plant.kind]\n\t\t\t\tfor i = #spec.leaves, math.max(1, #spec.leaves - 2), -1 do\n\t\t\t\t\tlocal leaf = byId[`{base}_leaf_{i}`]\n\t\t\t\t\tif leaf ~= nil then table.insert(list, spot(v((leaf.lo.X + leaf.hi.X) / 2 + (leaf.hi.X - leaf.lo.X) * 0.25, leaf.hi.Y, (leaf.lo.Z + leaf.hi.Z) / 2), Vector3.yAxis, 0.3, 0.5)) end\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tlocal plant = PLANTS[region.id] :: any\n\t\tlocal vents: { Vent } = { { id = `{region.id}_vent_hoverfly`, position = v(plant.x, S + PLANT_SPECS[plant.kind].height + 14, plant.z), normal = Vector3.yAxis, appear = true, reach = 80 } }\n\t\tlocal salt = 113\n\t\ttable.insert(out, { kind = \"hoverfly\", profile = \"hoverfly_prototype\", perches = spots(\"hoverfly\", list, hover.full), vents = vents, target = hover.full, low = hover.low,\n\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_hoverfly_fly_` })\n\tend\n\tif fruit ~= nil then\n\t\tlocal list: { { any } }\n\t\tlocal vents: { Vent }\n\t\tif region.id == \"room_floor_g\" then\n\t\t\t-- (ROBLOX-118) the caddy's fruit flies drifting through the doorway into the back room: on the boards inside it, the skirting, the wall's lining by it\n\t\t\tlocal B = Hut.BACK\n\t\t\tlist = {\n\t\t\t\tspot(v(B.x0 + 8, FL, 195), Vector3.yAxis, 0.1, 0.3), spot(v(B.x0 + 16, FL, 232), Vector3.yAxis, 0.1, 0.3), spot(v(B.x0 + 30, FL, 212), Vector3.yAxis, 0.1, 0.3),\n\t\t\t\tspot(v(B.x0 + 4, FL, 186), Vector3.yAxis, 0.1, 0.3), spot(v(B.x0, -40, 177), Vector3.xAxis, 0.3, 0.1), spot(v(B.x0, -30, 252), Vector3.xAxis, 0.3, 0.1),\n\t\t\t}\n\t\t\tvents = { { id = `{region.id}_vent_fruit_fly`, position = v(B.x0 + 6, FL + 14, 215), normal = Vector3.yAxis, appear = true, reach = 40 } }\n\t\telse\n\t\t\t-- the fruit flies: on the caddy's lid and its sides, the peel, and the floor in front of it\n\t\t\tlocal K = Hut.CADDY\n\t\t\tlocal top = FL + K.h + K.lid\n\t\t\tlist = {\n\t\t\t\tspot(v(K.x0 + 5, top, K.z0 + 6), Vector3.yAxis, 0.3, 0.9), spot(v(K.x1 - 5, top, K.z0 + 10), Vector3.yAxis, 0.3, 0.9), spot(v(K.x0 + 11, top, K.z1 - 5), Vector3.yAxis, 0.3, 0.8),\n\t\t\t\tspot(v(K.x1 - 4, top, K.z1 - 4), Vector3.yAxis, 0.3, 0.8), spot(v(K.x0 + 6, FL + 12, K.z0), -Vector3.zAxis, 0.2, 0.6), spot(v(K.x1 - 7, FL + 8, K.z0), -Vector3.zAxis, 0.2, 0.6),\n\t\t\t\tspot(v(K.x1, FL + 10, K.z0 + 8), Vector3.xAxis, 0.2, 0.6), spot(v(K.x0 - 6, FL, K.z0 - 5), Vector3.yAxis, 0.1, 0.4), spot(v(K.x0 + 14, FL, K.z0 - 8), Vector3.yAxis, 0.1, 0.4),\n\t\t\t}\n\t\t\tvents = { { id = `{region.id}_vent_fruit_fly`, position = v((K.x0 + K.x1) / 2, top + 6, (K.z0 + K.z1) / 2), normal = Vector3.yAxis, appear = true, reach = 40 } }\n\t\tend\n\t\tlocal salt = 127\n\t\ttable.insert(out, { kind = \"fruit_fly\", profile = \"fruit_fly_prototype\", perches = spots(\"fruit_fly\", list, fruit.full), vents = vents, target = fruit.full, low = fruit.low,\n\t\t\tseed = (region.seed + salt * 104729) % MOD, prefix = `{region.id}_fruit_fly_fly_` })\n\tend\n\tif moth ~= nil then\n\t\tlocal list: { { any } }\n\t\tlocal vents: { Vent }\n\t\tif region.id == \"room_window\" then\n\t\t\t-- (ROBLOX-118) a moth at the back room's window at night: on the glass, the sill, the reveals and under the head\n\t\t\tlocal Wn = Hut.ROOM_WINDOW\n\t\t\t-- (ROBLOX-119: in pairs a short flight apart, the moth's flights being 14 cm at most: no two of them were nearer, so none was ever good)\n\t\t\tlist = {\n\t\t\t\tspot(v(Wn.glass, 60, 120), -Vector3.xAxis, 0.2, 0.2), spot(v(Wn.glass, 68, 129), -Vector3.xAxis, 0.2, 0.2), spot(v(440, 0, 108), Vector3.yAxis, 0.2, 0.1),\n\t\t\t\tspot(v(446, 0, 117), Vector3.yAxis, 0.2, 0.1), spot(v(452, Wn.head, 140), -Vector3.yAxis, 0.3, 0.1), spot(v(452, Wn.head, 129), -Vector3.yAxis, 0.3, 0.1),\n\t\t\t}\n\t\t\tvents = { { id = `{region.id}_vent_moth`, position = v(445, 70, 134), normal = -Vector3.xAxis, appear = true, reach = 40 } }\n\t\telse\n\t\t\t-- the moth: on the lamp's shade, the wall's lining behind the lamp and the desk by its base; restless from dusk, when the lam