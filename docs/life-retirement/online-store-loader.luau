ves and what is known\nfunction SaveSession.setProgress(self: any, payload: any): boolean\n\tif self.closed then return false end\n\tlocal big = SaveRest.bounded(payload, SaveRules.MAX_PROGRESS_NODES, SaveRules.MAX_PROGRESS_DEPTH)\n\tif big then\n\t\tself.counters.rejected += 1\n\t\tlog(self, \"progress refused: \" .. big)\n\t\treturn false\n\tend\n\tlocal problems, clean = SaveProgress.sanitize(payload)\n\tif clean == nil then\n\t\tself.counters.rejected += 1\n\t\tlog(self, \"progress refused: \" .. tostring(problems[1]))\n\t\treturn false\n\tend\n\tlocal now = self.now()\n\tlocal merged = SaveProgress.merge(self.progress, clean, self.progressTime, now)\n\tif not SaveProgress.same(merged, self.progress) then\n\t\tself.progress = merged\n\t\tself.progressTime = now\n\t\tself.sched:markDirty(\"progress\", now)\n\t\tself:notify()\n\tend\n\treturn true\nend\n\n-- A session-local increasing intent makes retries idempotent and later New Life choices supersede earlier ones.\n-- The marker goes through the same guarded UpdateAsync and backup path as a rest; never DeleteAsync.\nfunction SaveSession.beginLife(self: any,mode: string,serial: any): boolean\n if self.closed or SaveRest.SPECS[mode]==nil or type(serial)~=\"number\" or serial~=serial or serial<1 or serial>SaveRules.MAX_LIFE_SERIAL or serial~=math.floor(serial) then return false end\n local prior=self.lifeRequests[mode]\n if prior and serial<prior.serial then return false end\n if prior and serial==prior.serial then\n  if prior.done and self.cfg.onLife then pcall(self.cfg.onLife,mode,serial,prior.token) end\n  return true\n end\n local token=`{self.id}:{mode}:{serial}`\n if not SaveRest.validLife(token) then return false end\n self.lifeRequests[mode]={serial=serial,token=token,done=false}\n self.rests[mode],self.restRejected[mode]=nil,nil\n self.restPending[mode]={save_retired=true,save_life=token}\n self.restPendingTime[mode]=self.now()\n self.sched:markDirty(\"rest_\"..mode,self.now());self:notify()\n return true\nend\n\n-- Legacy callers intentionally have no life credential; extra Lua return values are ignored here.\nfunction SaveSession.setRest(self: any,mode: string,record: any): boolean\n return self:setRestForLife(mode,record,nil)\nend\nfunction SaveSession.setRestForLife(self: any, mode: string, record: any,lifeToken: string?): boolean\n\tif self.closed or SaveRest.SPECS[mode] == nil then return false end\n local request=self.lifeRequests[mode]\n if (request and not request.done) or lifeToken~=self.lifeTokens[mode] then\n  self.counters.rejected+=1\n  return false -- never let a late prior-life rest cross a retirement boundary\n end\n-- Validate the exact stored candidate, including our identity metadata, against both size and node caps.\n local stamped=record\n local copyProblem: string?=nil\n if type(record)==\"table\" and getmetatable(record)==nil then\n  stamped={}\n  local count=0\n  for key,value in record do\n   count+=1\n   if count>SaveRules.MAX_REST_NODES then copyProblem=\"too many root values\";break end\n   stamped[key]=value\n  end\n  stamped.save_life=self.lifeTokens[mode]\n end\n local problems = if copyProblem then {copyProblem} else SaveRest.check(mode, stamped)\n\tif #problems > 0 then\n\t\tself.counters.rejected += 1\n\t\tlog(self, `the {mode} rest was refused: {problems[1]}`)\n\t\tself.restRejected[mode] = true\n\t\tself:notify()\n\t\treturn false\n\tend\n\tlocal now = self.now()\n\tself.restRejected[mode] = nil\n self.restPending[mode], self.restPendingTime[mode] = stamped, now\n\tself.sched:markDirty(\"rest_\" .. mode, now)\n\tself:notify()\n\treturn true\nend\n\n-- ---------------------------------------------------------------- writing\n-- Writes the progress (merged with what is stored). `release`: also let go of the lock. Returns true when it is stored.\nlocal function writeProgress(self: any, release: boolean): boolean\n\tlocal now = self.now()\n\tlocal version = self.sched:begin(\"progress\", now)\n\tself.counters.requests += 1\n\tlocal outcome = \"\"\n\tlocal merged: any = nil\n\tlocal newTime = now\n\tlocal ok, _, err = self.backend:update(self.pkey, function(old: any): any\n\t\toutcome = \"\"\n\t\tlocal op = SaveEnvelope.open(self.pspec, old, false)\n\t\tif op.status == \"newer\" then outcome = \"newer\"; return nil end\n\t\tif op.status == \"corrupt\" or op.status == \"invalid\" then outcome = \"corrupt\"; return nil end\n\t\tif op.status ~= \"missing\" and SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then outcome = \"locked\"; return nil end\n\t\tlocal base: any = if op.payload then op.payload else SaveProgress.default()\n\t\tlocal baseTime = op.updatedAt or 0\n\t\tmerged = SaveProgress.merge(base, self.progress, baseTime, self.progressTime)\n\t\tnewTime = math.max(now, baseTime)\n\t\toutcome = \"ok\"\n\t\tlocal lock = if release then nil else lockNow(self, now)\n\t\tif op.status ~= \"missing\" and SaveProgress.same(merged, base) and op.status == \"ok\" then\n\t\t\treturn SaveEnvelope.withLock(old, lock) -- nothing new to say: only the lock moves (payload, checksum and backup untouched)\n\t\tend\n\t\treturn SaveEnvelope.make(self.pspec, merged, newTime, old, { lock = lock })\n\tend)\n\tif not ok then\n\t\tlocal class = SaveStores.classify(err)\n\t\tif class == \"value\" then\n\t\t\tlog(self, \"the progress record cannot be stored: \" .. tostring(err))\n\t\t\tself.sched:abandon(\"progress\")\n\t\t\tself:demote(\"write_failed\", false)\n\t\t\treturn false\n\t\tend\n\t\tlocal wait = self.sched:failed(\"progress\", now, class)\n\t\tlog(self, `progress write failed ({class}, retry in {wait} s): {tostring(err)}`)\n\t\treturn false\n\tend\n\tif outcome == \"ok\" then\n\t\t-- UpdateAsync yields after its callback. Keep progress that arrived while the request was in flight.\n\t\tself.progress = SaveProgress.merge(merged, self.progress, newTime, self.progressTime)\n\t\tself.storedTime = newTime\n\t\tself.sched:succeeded(\"progress\", now, version)\n\t\tself.sched:beat(now)\n\t\tself.counters.writes += 1\n\t\tif release then self.lockHeld = false end\n\t\treturn true\n\tend\n\tif outcome == \"locked\" then\n\t\tself:demote(\"other_session\", true)\n\telseif outcome == \"newer\" then\n\t\tself:demote(\"newer\", false)\n\telseif outcome == \"corrupt\" then\n\t\tself:demote(\"corrupt\", false)\n\tend\n\treturn false\nend\n\nlocal function writeRest(self: any, mode: string): boolean\n\t-- Never overwrite a record whose load failed, including during shutdown.\n\tif not self.restLoaded[mode] or self.restBase[mode] == nil then return false end\n\tlocal name = \"rest_\" .. mode\n\tlocal record = self.restPending[mode]\n\tif record == nil then\n\t\tself.sched.items[name].dirty = false\n\t\treturn true\n\tend\n\tif not SaveRest.isRetired(record) and record.save_life~=self.lifeTokens[mode] then\n  self.restPending[mode],self.restPendingTime[mode]=nil,nil\n  self.sched:abandon(name);self:demote(\"other_session\",false)\n  return false\n end\n local now = self.now()\n local version = self.sched:begin(name, now)\n\tself.counters.requests += 1\n\tlocal spec = SaveRest.SPECS[mode]\n\tlocal outcome = \"\"\n\tlocal newTime = now\n local expectedLife=self.lifeTokens[mode]\n\tlocal ok, _, err = self.backend:update(self.rkey[mode], function(old: any): any\n\t\toutcome = \"\"\n\t\tlocal op = SaveEnvelope.open(spec, old, false)\n\t\tif op.status == \"newer\" then outcome = \"newer\"; return nil end\n\t\tif op.status == \"corrupt\" or op.status == \"invalid\" then outcome = \"corrupt\"; return nil end\n\t\tif (op.status==\"ok\" or op.status==\"migrated\") and op.payload.save_life~=expectedLife and op.session~=self.id then\n   outcome=\"superseded\";return nil -- life identities protect even simultaneous writes with equal timestamps\n  end\n  local base = self.restBase[mode]\n\t\tif (op.status == \"ok\" or op.status == \"migrated\") and base ~= nil and (op.updatedAt or 0) > base and op.session ~= self.id then\n\t\t\toutcome = \"superseded\"\n\t\t\treturn nil\n\t\tend\n\t\tif (op.status == \"ok\") and canonical(op.payload) == canonical(record) then\n\t\t\t-- already stored (an earlier try whose answer was lost): nothing to write, and the backup must not become a copy of it\n\t\t\tnewTime = op.updatedAt or now\n\t\t\toutcome = \"ok\"\n\t\t\treturn nil\n\t\tend\n\t\tnewTime = math.max(now, op.updatedAt or 0)\n\t\toutcome = \"ok\"\n\t\treturn SaveEnvelope.make(spec, record, newTime, old, { session = self.id })\n\tend)\n\tif not ok then\n\t\tlocal class = SaveStores.classify(err)\n\t\tif class == \"value\" then\n\t\t\tlog(self, `the {mode} rest cannot be stored: {tostring(err)}`)\n\t\t\tself.restPending[mode], self.restPendingTime[mode] = nil, nil\n\t\t\tself.sched:abandon(name)\n\t\t\tself:demote(\"write_failed\", false)\n\t\t\treturn false\n\t\tend\n\t\tlocal wait = self.sched:failed(name, now, class)\n\t\tlog(self, `{mode} rest write failed ({class}, retry in {wait} s): {tostring(err)}`)\n\t\treturn false\n\tend\n\tif outcome == \"ok\" then\n\t\tself.restBase[mode] = newTime\n\t\tself.lifeTokens[mode]=record.save_life\n  self.rests[mode] = if SaveRest.isRetired(record) then nil else record\n  local request=self.lifeRequests[mode]\n  if SaveRest.isRetired(record) and request and request.token==record.save_life then\n   request.done=true\n   if self.cfg.onLife then pcall(self.cfg.onLife,mode,request.serial,request.token) end\n  end\n  if self.restPending[mode] == record then self.restPending[mode], self.restPendingTime[mode] = nil, nil end\n\t\tself.sched:succeeded(name, now, version)\n\t\tself.counters.writes += 1\n\t\treturn true\n\tend\n\tif outcome == \"superseded\" then\n\t\tself:demote(\"other_session\", true)\n\telseif outcome == \"newer\" then\n\t\tself:demote(\"newer\", false)\n\telseif outcome == \"corrupt\" then\n\t\tself:demote(\"corrupt\", false)\n\tend\n\treturn false\nend\n\n-- Refreshes the lock when no write has done it lately.\nlocal function heartbeat(self: any)\n\tlocal now = self.now()\n\tself.sched:begin(nil, now)\n\tself.counters.requests += 1\n\tlocal outcome = \"\"\n\tlocal ok, _, err = self.backend:update(self.pkey, function(old: any): any\n\t\toutcome = \"\"\n\t\tlocal op = SaveEnvelope.open(self.pspec, old, false)\n\t\tif op.status == \"missing\" then outcome = \"missing\"; return nil end\n\t\tif op.status == \"newer\" then outcome = \"newer\"; return nil end\n\t\tif op.status == \"corrupt\" or op.status == \"invalid\" then outcome = \"corrupt\"; return nil end\n\t\tif SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then outcome = \"locked\"; return nil end\n\t\toutcome = \"ok\"\n\t\treturn SaveEnvelope.withLock(old, lockNow(self, now))\n\tend)\n\tif not ok then\n\t\tlog(self, \"heartbeat failed: \" .. tostring(err))\n\t\tself.sched:beat(now - SaveRules.HEARTBEAT + 5) -- try again in a few seconds\n\t\treturn\n\tend\n\tself.sched:beat(now)\n\tif outcome == \"locked\" then self:demote(\"other_session\", true)\n\telseif outcome == \"newer\" then self:demote(\"newer\", false)\n\telseif outcome == \"corrupt\" then self:demote(\"corrupt\", false) end\nend\n\n-- One pass of the periodic work; the server calls it about once a second. Does at most one request per call. Returns whether it asked.\nlocal function stepInner(self: any): boolean\n\tlocal now = self.now()\n\tlocal did = true\n\tif self.state == \"session\" then\n\t\tif self.canRetry and now >= self.retryAt and self.sched:budgetOk(now) then\n\t\t\tself.retryAt = now + SaveRules.RETRY_LOAD\n\t\t\tlocal wasReason = self.reason\n\t\t\tself:load()\n\t\t\tif SaveSession.isActive(self) then\n\t\t\t\tlog(self, `holds the record again (was: {tostring(wasReason)})`)\n\t\t\t\tlocal f = self.cfg.onLoaded\n\t\t\t\tif f then f(self:snapshot()) end\n\t\t\tend\n\t\telse\n\t\t\tdid = false\n\t\tend\n\telseif self.state == \"active\" then\n\t\t-- A failed rest read must not starve lock renewal for a live player.\n\t\tif self.sched:due(\"progress\", now) then\n\t\t\twriteProgress(self, false) -- also renews the lock\n\t\telseif self.sched:heartbeatDue(now) then\n\t\t\theartbeat(self)\n\t\telseif not SaveSession.restsLoaded(self) then\n\t\t\tif now >= self.restRetryAt and self.sched:budgetOk(now) then\n\t\t\t\tlocal before: { [string]: any } = {}\n\t\t\t\tfor _, mode in SaveRules.MODES do before[mode] = self.rests[mode] end\n\t\t\t\treadRests(self)\n\t\t\t\tfor _, mode in SaveRules.MODES do\n\t\t\t\t\tif self.rests[mode] ~= nil and before[mode] == nil then\n\t\t\t\t\t\tlocal f = self.cfg.onRest\n\t\t\t\t\t\tif f then f(mode, self.rests[mode]) end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tdid = false\n\t\t\tend\n\t\telse\n\t\t\tdid = false\n\t\t\tfor _, mode in SaveRules.MODES do\n\t\t\t\tif self.sched:due(\"rest_\" .. mode, now) then\n\t\t\t\t\twriteRest(self, mode)\n\t\t\t\t\tdid = true\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\telse\n\t\tdid = false\n\tend\n\treturn did\nend\n\nfunction SaveSession.step(self: any): boolean\n\tif self.closed or self.busy then return false end\n\tself.busy = true\n\tlocal ok, did = pcall(stepInner, self)\n\tself.busy = false\n\tif not ok then\n\t\tlog(self, \"step failed: \" .. tostring(did))\n\t\treturn false\n\tend\n\tself:notify()\n\treturn did :: boolean\nend\n\n-- The state to hand the client: progress, the rests found, and the status.\nfunction SaveSession.snapshot(self: any): any\n\tlocal status, reason = self:status()\n\tlocal rests: { [string]: any } = {}\n\tfor _, mode in SaveRules.MODES do\n  local request=self.lifeRequests[mode]\n  if not request or request.done then rests[mode]=self.rests[mode] end\n end\n return { status = status, reason = reason, progress = self.progress, rests = rests, lives = Json.copy(self.lifeTokens) }\nend\n\n-- Leaving/shutdown keeps ownership until the pending records finish; a new visit must not load half a flush.\nfunction SaveSession.flush(self: any, deadline: number?)\n\tif self.closed or self.flushing then return end\n\tself.flushing = true\n\tlocal sleep = self.cfg.sleep\n\tlocal limit = deadline or (self.now() + SaveRules.FLUSH_DEADLINE)\n\twhile self.busy and self.now() < limit and sleep do sleep(0.25) end\n\tif self.busy or self.now() >= limit then\n\t\tself.closed, self.flushing = true, false\n\t\treturn -- never overlap an in-flight request; its lock will expire if it cannot finish\n\tend\n\tif self.state == \"active\" then\n\t\tself.busy = true\n\t\tlocal attempt = 0\n\t\twhile attempt < SaveRules.FLUSH_ATTEMPTS and self.state == \"active\" and self.now() < limit do\n\t\t\tattempt += 1\n\t\t\t-- Also checks ownership before touching a rest, even when progress itself is unchanged.\n\t\t\tlocal progressDone = writeProgress(self, false)\n\t\t\tlocal restsDone = true\n\t\t\tif progressDone and self.state == \"active\" then\n\t\t\t\tfor _, mode in SaveRules.MODES do\n\t\t\t\t\tif self.restPending[mode] ~= nil then\n\t\t\t\t\t\tif self.now() >= limit or self.state ~= \"active\" or not writeRest(self, mode) then restsDone = false end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif restsDone and self.state == \"active\" and self.now() < limit then\n\t\t\t\t\tif writeProgress(self, true) then break end -- release only after every rest has completed\n\t\t\t\tend\n\t\t\tend\n\t\t\tif self.now() >= limit or sleep == nil then break end\n\t\t\tsleep(math.min(SaveRules.FLUSH_BACKOFF * 2 ^ (attempt - 1), math.max(0, limit - self.now())))\n\t\tend\n\t\tself.busy = false\n\tend\n\tself.closed, self.flushing = true, false\n\tself:notify()\nend\n\nreturn SaveSession\n",26216,3535366589},{"Shared/Persistence/SaveStores","--!strict\n-- Two small pure rules about the stores (ROBLOX-39): which store a build writes to, and what kind of failure a DataStore error is.\nlocal SaveRules = require(script.Parent.Parent.Data.SaveRules)\n\nlocal SaveStores = {}\n\n-- Which DataStore name to use. Studio and the test place always use the test store, so a Studio run (even with API access on, even of the\n-- production project) never touches a real save. A live server of the production place uses the production store. `attribute` is the\n-- Workspace attribute SaveStore: it may only choose a test-looking name or the test default, never the production name for a test run.\nfunction SaveStores.name(isStudio: boolean, isTestPlace: boolean, attribute: any): string\n\tif isStudio or isTestPlace then\n\t\tif type(attribute) == \"string\" and string.match(attribute, \"^WindowsillTest[%w_]*$\") and #attribute <= 40 then return attribute end\n\t\treturn SaveRules.STORE_TEST\n\tend\n\treturn SaveRules.STORE_PRODUCTION\nend\n\n-- What kind of failure a DataStore error is, from its message (Roblox puts a number and a sentence in it: \"104: Cannot store ...\" and the\n-- like). Classes:\n--   \"throttle\"  the request was over a budget or queued out: wait and try again, slower\n--   \"config\"    saving cannot work here at all (Studio API access off, an unpublished place, DataStores disabled): do not keep hammering\n--   \"value\"     this key or value can never be stored (a bad key, too large, not storable): retrying the same thing cannot work\n--   \"transient\" anything else (a timeout, the service down, an unknown error): try again later\n-- The mapping of messages to classes is from Roblox's documented error codes (101-106 key and value, 301-306 throttles, 4xx and 5xx\n-- service); it has not been checked against a live DataStore, and an unknown message is treated as transient on purpose.\nfunction SaveStores.classify(message: any): string\n\tlocal m = string.lower(tostring(message))\n\tlocal code = tonumber(string.match(m, \"^%s*(%d%d%d)%s*:\"))\n\tif code ~= nil then\n\t\tif code >= 301 and code <= 306 then return \"throttle\" end\n\t\tif code == 101 or code == 102 or code == 103 or code == 104 or code == 105 then return \"value\" end\n\t\tif code == 403 or code == 401 or code == 402 then return \"config\" end\n\tend\n\tif string.find(m, \"studio access\", 1, true) or string.find(m, \"studioaccesstoapis\", 1, true) or string.find(m, \"not allowed\", 1, true)\n\t\tor string.find(m, \"publish\", 1, true) or string.find(m, \"disabled\", 1, true) or string.find(m, \"must be enabled\", 1, true) then\n\t\treturn \"config\"\n\tend\n\tif string.find(m, \"throttl\", 1, true) or string.find(m, \"over limit\", 1, true) or string.find(m, \"request queue\", 1, true) or string.find(m, \"too many requests\", 1, true) then\n\t\treturn \"throttle\"\n\tend\n\tif string.find(m, \"too large\", 1, true) or string.find(m, \"cannot store\", 1, true) or string.find(m, \"value size\", 1, true) or string.find(m, \"exceeds\", 1, true) then\n\t\treturn \"value\"\n\tend\n\treturn \"transient\"\nend\n\nreturn SaveStores\n",2972,1570038780},{"Shared/Predator/Bird","--!strict\n-- The robin of the open ground (ROBLOX-120, docs/PARK_WORLD_DESIGN.md sections 4 and 5: the bird is the danger of the hut garden, the meadow and the open ground\n-- between; section 10 names the American robin at the feeder). An American robin (Turdus migratorius), at true size: 25 cm from bill to tail (the sources give 20 to\n-- 28 cm), foraging on the ground as the sources describe it: it runs or hops a few steps, stops abruptly, stands still with its head cocked to one side looking at the\n-- ground, and takes what it sees (earthworms most of all, and insects, snails and spiders). Pure: no engine, no drawing (Client/BirdBody draws it), so the client,\n-- the self-test, the previewer and the CLI suites ask exactly the same bird.\n--\n-- Its day is a seeded schedule (`Bird.plan(seed, day)`: the world's seed through WorldMap.seed(914, \"bird\"), a Park-Miller stream per day): four to six visits between\n-- 06:00 and 19:30, each to one of SITES (the hut garden's lawn west and east of the path, the bench patch's gravel by the path's end, the meadow's mown edge; ROBLOX-122:\n-- the mown path east toward the pond), so where\n-- the robin is at an hour of a day is a pure function of the seed, the day and the hour, and a return to a rest finds it where the schedule says (restores never reroll;\n-- nothing of it is saved). A visit, in seconds at the outdoors' pace (HOUR_PER_S: the garden's clock, 0.33 of the hut's):\n--   approach ..... it flies in low over the ground from FLY_FROM studs off, gliding down onto the site's first point: its SHADOW sweeps over the ground ahead of it,\n--                  and it calls (\"pick, tut-tut-tut\") as it comes in. This is how it is told first: a shadow and a call.\n--   ground ....... it forages along the site's line, a stop (STOP seconds, its head cocked, now and then a peck at the ground) and a hop (HOP_LEN studs in HOP_S), over\n--                  and back, for FORAGE seconds.\n--   leave ........ it flies off up and away (its shadow again), calling.\n--\n-- What it does to a jumping spider (`step`): on the ground, a spider that MOVES in the open within NOTICE of its head catches its eye (`noticed`). It hops toward it\n-- (never more than STALK_MAX off its line), and in REACH it stops dead with its head cocked at the spider for TELL seconds: the honest tell, a pause anyone watching\n-- can see. If the spider is still moving in the open at the end of it, the robin strikes: in the standard rules a death with its own card (UI/BirdText, `struck`), in\n-- the gentle rules (Easy, Free play) the bill misses (`missed`). The way out is cover or stillness: a spider in a retreat or resting (`hidden`), under something\n-- (`Bird.covered`: a box over it within COVER_UP), low in the meadow's grass (`Bird.inGrass`), or keeping still for STILL_LOSE seconds, is lost (`lost`), and the\n-- robin goes back to its foraging for COOLDOWN seconds before anything catches its eye again. It never reacts while it flies, and a spider high up (more than HIGH over\n-- the ground it stands on) is not on its ground. Live state that is not saved: the reaction, how far it hopped off its line (eased back after).\n-- Studs (a stud is a centimetre), the sill's frame (World/Preserve: +x east, -z north; the garden's ground World/Hut.GROUND).\nlocal Bird = {}\nBird.__index = Bird\n\nlocal GT = -84.6 -- the ground of the hut garden and the meadow (World/Hut.GROUND, World/Meadow.GROUND)\nlocal v = Vector3.new\n\n-- ---------------------------------------------------------------- the numbers (the game's, but the bird's size and its run-and-stop are the sources')\nBird.LENGTH = 25 -- studs, bill to tail\nBird.HEAD_Y = 13 -- its head over the ground, standing\nBird.HOUR_PER_S = 12.0 / (15.0 * 60.0) * 0.33 -- game hours a second at the outdoors' pace (Life/LifeClock.ACTIVE_HOURS_PER_S x the garden's clockScale)\nBird.APPROACH_S = 3.0 -- the flight in\nBird.LEAVE_S = 2.5 -- and off\nBird.FLY_FROM = 900 -- how far off (studs, in plan) the flight in starts\nBird.FLY_UP = 320 -- and how high over the ground\nBird.FORAGE = table.freeze({ 70.0, 150.0 }) -- seconds on the ground a visit\nBird.STOP = table.freeze({ 1.2, 3.6 }) -- a stop, head cocked\nBird.HOP_S = 0.3 -- a hop (a few quick steps: the \"run\")\nBird.HOP_LEN = table.freeze({ 10.0, 26.0 })\nBird.PECK = 0.35 -- a share of the stops end in a peck at the ground\nBird.VISITS = table.freeze({ 4, 6 })\nBird.DAY = table.freeze({ 6.0, 19.5 })\nBird.NOTICE = 70 -- how near (studs, in plan, from its head) a moving spider catches its eye\nBird.HIGH = 30 -- a spider more than this over the ground it stands on is not on its ground\nBird.REACH = 16 -- in plan from its bill's base: the dash and the stab\nBird.STALK_MAX = 90 -- how far it hops off its line toward what it saw\nBird.STALK_SPEED = 45 -- studs a second, hopping toward it\nBird.TELL = 0.85 -- the pause, head cocked at the spider, before the strike\nBird.STRIKE_S = 0.2 -- the stab\nBird.MOVING = 0.5 -- studs a second: slower than this, a spider is keeping still\nBird.STILL_LOSE = 1.2 -- seconds still and it loses the spider\nBird.COOLDOWN = 6.0 -- seconds after it lost one before anything catches its eye again\nBird.COVER_UP = 60 -- a box over the spider within this is cover from a bird's eye\nBird.GRASS_LOW = 25 -- in the meadow, lower than this over the ground is down in the grass\nBird.SHADOW_NEAR = 80 -- a shadow passing within this (in plan) of the spider is told\nBird.HEAR = 2500 -- studs: how far its call carries for the caption (25 m)\nBird.CALL_S = 2.5 -- it calls this long as it lands and as it leaves\n\n-- The sites it forages, each a line on the ground it hops along (over and back): the hut garden's lawn either side of the path (clear of the trough, the stone and the\n-- feeder's pole), the bench patch's gravel by the path's end (clear of the slab and the grate) and the meadow's mown edge along the gravel. `from`: the way it flies in\n-- from (in plan), `zone` World/Preserve's.\nexport type Site = { id: string, zone: string, line: { Vector3 }, from: Vector3 }\nlocal function site(id: string, zone: string, from: Vector3, pts: { { number } }): Site\n\tlocal line = {}\n\tfor _, p in pts do table.insert(line, v(p[1], GT, p[2])) end\n\treturn table.freeze({ id = id, zone = zone, line = table.freeze(line), from = from.Unit })\nend\nBird.SITES = table.freeze({\n\tsite(\"lawn_w\", \"hut_garden\", v(-1, 0, -0.4), { { -185, -80 }, { -130, -115 }, { -70, -90 }, { -15, -125 } }),\n\tsite(\"lawn_e\", \"hut_garden\", v(1, 0, -0.3), { { 20, -130 }, { 80, -125 }, { 130, -100 }, { 185, -112 } }),\n\tsite(\"gravel\", \"bench\", v(0.4, 0, 1), { { -190, -550 }, { -100, -580 }, { -20, -545 }, { 70, -590 } }),\n\tsite(\"edge\", \"meadow\", v(-1, 0, 0.5), { { -290, -826 }, { -180, -822 }, { -60, -827 }, { 60, -823 }, { 170, -826 } }),\n\t-- (ROBLOX-122) the mown path east from the bench patch toward the pond (World/Pond's mown_e*): the long open way between the meadow and the boardwalk\n\tsite(\"path\", \"ground\", v(0.3, 0, 1), { { 110, -682 }, { 150, -675 }, { 190, -685 }, { 230, -678 }, { 270, -683 } }),\n}) :: { Site }\nBird.GROUND = GT\n\n-- ---------------------------------------------------------------- the schedule\nlocal MOD = 2147483647\nlocal function rng(seed: number, salt: number): () -> number\n\tlocal state = (seed + salt * 7919) % MOD\n\tif state <= 0 then state += MOD - 1 end\n\treturn function(): number\n\t\tstate = (state * 16807) % MOD\n\t\treturn (state - 1) / (MOD - 1)\n\tend\nend\nlocal function between(rand: () -> number, a: number, b: number): number\n\treturn a + (b - a) * rand()\nend\n\n-- A move on the ground: a stop from t0 (head cocked; a peck from `peck` if it pecks) and a hop from t1 to t2 from `a` to `b`.\nexport type Move = { t0: number, t1: number, t2: number, a: Vector3, b: Vector3, heading: Vector3, peck: number? }\n-- A visit: its start (hours), its site, its seconds (approach, ground, leave) and its moves on the ground.\nexport type Visit = { h0: number, h1: number, site: Site, forage: number, moves: { Move }, leaveFrom: Vector3, leaveTo: Vector3, cock: number }\n\n-- The point `d` studs along a line walked over and back (a ping-pong), and the way it faces there.\nlocal function along(line: { Vector3 }, d: number): (Vector3, Vector3)\n\tlocal total = 0\n\tfor i = 2, #line do total += (line[i] - line[i - 1]).Magnitude end\n\tlocal s = d % (2 * total)\n\tlocal back = s > total\n\tif back then s = 2 * total - s end\n\tfor i = 2, #line do\n\t\tlocal a, b = line[i - 1], line[i]\n\t\tlocal l = (b - a).Magnitude\n\t\tif s <= l or i == #line then\n\t\t\tlocal k = math.clamp(s / l, 0, 1)\n\t\t\tlocal dir = (b - a).Unit\n\t\t\treturn a:Lerp(b, k), if back then -dir else dir\n\t\tend\n\t\ts -= l\n\tend\n\treturn line[1], Vector3.xAxis\nend\n\nlocal planCache: { [string]: { Visit } } = {}\n-- The robin's day: its visits, in order (none overlap).\nfunction Bird.plan(seed: number, day: number): { Visit }\n\tlocal key = tostring(seed) .. \"/\" .. tostring(day)\n\tif planCache[key] then return planCache[key] end\n\tlocal rand = rng(seed, 2000 + day)\n\tlocal n = Bird.VISITS[1] + math.floor(rand() * (Bird.VISITS[2] - Bird.VISITS[1] + 1))\n\tlocal span = (Bird.DAY[2] - Bird.DAY[1]) / n\n\tlocal out: { Visit } = {}\n\tfor i = 1, n do\n\t\tlocal s = Bird.SITES[1 + math.floor(rand() * #Bird.SITES) % #Bird.SITES]\n\t\tlocal forage = between(rand, Bird.FORAGE[1], Bird.FORAGE[2])\n\t\tlocal whole = (Bird.APPROACH_S + forage + Bird.LEAVE_S) * Bird.HOUR_PER_S\n\t\tlocal h0 = Bird.DAY[1] + (i - 1) * span + rand() * math.max(0, span - whole)\n\t\t-- the moves: from the line's first point, a stop and a hop, over and back\n\t\tlocal moves: { Move } = {}\n\t\tlocal t = 0.0\n\t\tlocal d = 0.0\n\t\tlocal here, heading = along(s.line, 0)\n\t\twhile t < forage do\n\t\t\tlocal stop = between(rand, Bird.STOP[1], Bird.STOP[2])\n\t\t\tlocal peck = if rand() < Bird.PECK then t + stop * between(rand, 0.4, 0.75) else nil\n\t\t\td += between(rand, Bird.HOP_LEN[1], Bird.HOP_LEN[2])\n\t\t\tlocal nextAt, nextHeading = along(s.line, d)\n\t\t\tlocal t1 = math.min(t + stop, forage)\n\t\t\tlocal t2 = math.min(t1 + Bird.HOP_S, forage)\n\t\t\ttable.insert(moves, table.freeze({ t0 = t, t1 = t1, t2 = t2, a = here, b = if t2 > t1 then nextAt else here, heading = heading, peck = peck }))\n\t\t\there, heading = (if t2 > t1 then nextAt else here), nextHeading\n\t\t\tt = t2\n\t\tend\n\t\tlocal up = Vector3.new(-s.from.X, 0, -s.from.Z)\n\t\ttable.insert(out, table.freeze({\n\t\t\th0 = h0, h1 = h0 + whole, site = s, forage = forage, moves = table.freeze(moves), leaveFrom = here,\n\t\t\tleaveTo = here + up * Bird.FLY_FROM + Vector3.yAxis * Bird.FLY_UP, cock = if rand() < 0.5 then -1 else 1,\n\t\t}))\n\tend\n\tplanCache[key] = table.freeze(out)\n\treturn out\nend\n\n-- Where the schedule has it at `hour` of `day`: nil when it is not here; else its place (pos: its feet, or its body in flight), heading, pose (\"fly\", \"land\",\n-- \"hop\", \"stand\", \"peck\", \"leave\"), the shadow's place on the ground (nil while it stands: then the shadow is under it, drawn by the body), and whether it calls.\nexport type Place = { pos: Vector3, heading: Vector3, pose: string, shadow: Vector3?, calling: boolean, visit: Visit, secs: number, flying: boolean }\nfunction Bird.at(seed: number, day: number, hour: number): Place?\n\tfor _, visit in Bird.plan(seed, day) do\n\t\tif hour >= visit.h0 and hour < visit.h1 then\n\t\t\tlocal secs = (hour - visit.h0) / Bird.HOUR_PER_S\n\t\t\tlocal s = visit.site\n\t\t\tif secs < Bird.APPROACH_S then\n\t\t\t\t-- the glide in: from FLY_FROM off and FLY_UP up, down onto the line's first point, flattening out at the end\n\t\t\t\tlocal k = secs / Bird.APPROACH_S\n\t\t\t\tlocal land = s.line[1]\n\t\t\t\tlocal start = land + s.from * Bird.FLY_FROM + Vector3.yAxis * Bird.FLY_UP\n\t\t\t\tlocal e = 1 - (1 - k) * (1 - k)\n\t\t\t\tlocal flat = land:Lerp(start, 1 - k)\n\t\t\t\tlocal p = v(flat.X, land.Y + Bird.FLY_UP * (1 - e), flat.Z)\n\t\t\t\tlocal h = -s.from\n\t\t\t\treturn { pos = p, heading = h, pose = if k > 0.85 then \"land\" else \"fly\", shadow = v(p.X, GT, p.Z), calling = true, visit = visit, secs = secs, flying = k <= 0.85 }\n\t\t\tend\n\t\t\tlocal g = secs - Bird.APPROACH_S\n\t\t\tif g < visit.forage then\n\t\t\t\tfor _, m in visit.moves do\n\t\t\t\t\tif g < m.t2 or m == visit.moves[#visit.moves] then\n\t\t\t\t\t\tlocal calling = g < Bird.CALL_S\n\t\t\t\t\t\tif g < m.t1 then\n\t\t\t\t\t\t\tlocal pose = if m.peck ~= nil and g >= m.peck and g < m.peck + 0.4 then \"peck\" else \"stand\"\n\t\t\t\t\t\t\treturn { pos = m.a, heading = m.heading, pose = pose, shadow = nil, calling = calling, visit = visit, secs = secs, flying = false }\n\t\t\t\t\t\tend\n\t\t\t\t\t\tlocal k = math.clamp((g - m.t1) / math.max(m.t2 - m.t1, 1e-6), 0, 1)\n\t\t\t\t\t\tlocal flat = m.b - m.a\n\t\t\t\t\t\tlocal hd = if flat.Magnitude > 1e-3 then v(flat.X, 0, flat.Z).Unit else m.heading\n\t\t\t\t\t\treturn { pos = m.a:Lerp(m.b, k) + Vector3.yAxis * (math.sin(k * math.pi) * 3), heading = hd, pose = \"hop\", shadow = nil, calling = calling, visit = visit,\n\t\t\t\t\t\t\tsecs = secs, flying = false }\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\t-- off: up and away along the way it came, the other way\n\t\t\tlocal k = math.clamp((g - visit.forage) / Bird.LEAVE_S, 0, 1)\n\t\t\tlocal e = k * k\n\t\t\tlocal flat = visit.leaveFrom:Lerp(visit.leaveTo, e)\n\t\t\tlocal p = v(flat.X, GT + (visit.leaveTo.Y - GT) * e, flat.Z)\n\t\t\tlocal hd = v(visit.leaveTo.X - visit.leaveFrom.X, 0, visit.leaveTo.Z - visit.leaveFrom.Z).Unit\n\t\t\treturn { pos = p, heading = hd, pose = \"leave\", shadow = v(p.X, GT, p.Z), calling = k < 0.6, visit = visit, secs = secs, flying = k > 0.08 }\n\t\tend\n\tend\n\treturn nil\nend\n\n-- ---------------------------------------------------------------- cover (pure: the client hands in the region's boxes)\n-- Whether a box of `pieces` is over a spider at `p`: its footprint over the point and its underside above it, within COVER_UP.\nfunction Bird.covered(pieces: { any }, p: Vector3): boolean\n\tfor _, b in pieces do\n\t\tlocal lo, hi = b.lo or b.min, b.hi or b.max\n\t\tif lo.Y > p.Y + 0.3 and lo.Y < p.Y + Bird.COVER_UP and p.X > lo.X - 0.2 and p.X < hi.X + 0.2 and p.Z > lo.Z - 0.2 and p.Z < hi.Z + 0.2 then return true end\n\tend\n\treturn false\nend\n-- Whether a spider at `p` in a region of `kind` is down in the meadow's grass.\nfunction Bird.inGrass(kind: string?, p: Vector3): boolean\n\treturn kind == \"meadow\" and p.Y - GT < Bird.GRASS_LOW\nend\n\n-- ---------------------------------------------------------------- the live robin\nexport type Spider = { pos: Vector3, speed: number, hidden: boolean, covered: boolean }\nexport type Signal = { kind: string, at: Vector3? }\n\nfunction Bird.new(seed: number): any\n\treturn setmetatable({\n\t\tseed = seed, day = 1, hour = 0, here = false,\n\t\tpos = Vector3.zero, heading = Vector3.xAxis, pose = \"away\", shadow = nil :: Vector3?, calling = false, flying = false, site = nil :: string?,\n\t\tlook = nil :: Vector3?, cock = 1, -- the point its cocked head looks at, and which side the head tips\n\t\treact = \"none\", reactS = 0, stillS = 0, cooldown = 0, offset = Vector3.zero, strikeAt = nil :: Vector3?, strikeS = -1,\n\t\tnotices = 0, strikes = 0, misses = 0, losses = 0, shadows = 0, landings = 0, -- (this session's: the self-test reads them)\n\t\tgentle = false, enabled = true, signals = {} :: { Signal }, shadowNear = false, wasHere = false,\n\t}, Bird)\nend\n\n-- Its head (where it looks from) and its bill's base (where it strikes from).\nfunction Bird.head(self: any): Vector3\n\treturn self.pos + self.heading * 6 + Vector3.yAxis * Bird.HEAD_Y\nend\nfunction Bird.bill(self: any): Vector3\n\treturn v(self.pos.X, GT, self.pos.Z) + self.heading * 9\nend\nlocal function flat(a: Vector3, b: Vector3): number\n\treturn v(a.X - b.X, 0, a.Z - b.Z).Magnitude\nend\nlocal function emit(self: any, kind: string, at: Vector3?)\n\ttable.insert(self.signals, { kind = kind, at = at })\nend\n\n-- One step of `dt` seconds at the life clock's (day, hour), with the spider as it is now (nil while there is no life to touch). Signals: \"landed\" (it is on the\n-- ground: told by its call), \"shadow\" (its shadow passed near the spider), \"noticed\", \"lost\", \"struck\" (standard rules), \"missed\" (gentle rules).\nfunction Bird.step(self: any, dt: number, day: number, hour: number, spider: Spider?)\n\tself.day, self.hour = day, hour\n\tself.cooldown = math.max(0, self.cooldown - dt)\n\tif self.strikeS >= 0 then self.strikeS += dt; if self.strikeS > Bird.STRIKE_S + 0.3 then self.strikeS = -1 end end\n\tlocal place = Bird.at(self.seed, day, hour)\n\tif place == nil then\n\t\tself.here, self.pose, self.shadow, self.calling, self.flying, self.site = false, \"away\", nil, false, false, nil\n\t\tself.react, self.look, self.offset, self.wasHere = \"none\", nil, Vector3.zero, false\n\t\treturn\n\tend\n\tself.here = true\n\tself.site = place.visit.site.id\n\tself.cock = place.visit.cock\n\tif not self.wasHere then self.wasHere = true end\n\tlocal onGround = not place.flying and place.pose ~= \"fly\" and place.pose ~= \"leave\" and place.pose ~= \"land\"\n\tif onGround and self.pose ~= \"stand\" and self.pose ~= \"hop\" and self.pose ~= \"peck\" and self.pose ~= \"watch\" and self.pose ~= \"strike\" then\n\t\tself.landings += 1\n\t\temit(self, \"landed\", place.pos)\n\tend\n\t-- the stalk's offset eases back when it is not reacting, and is gone once it flies\n\tif not onGround then self.offset, self.react, self.look = Vector3.zero, \"none\", nil end\n\tif self.react == \"none\" and self.offset.Magnitude > 0 then\n\t\tlocal back = math.min(self.offset.Magnitude, Bird.STALK_SPEED * 0.5 * dt)\n\t\tself.offset -= self.offset.Unit * back\n\tend\n\tself.pos = place.pos + self.offset\n\tself.shadow, self.calling, self.flying = place.shadow, place.calling, place.flying\n\tif self.react == \"none\" then self.heading, self.pose, self.look = place.heading, place.pose, nil end\n\t-- the shadow passing over the spider (told once a pass)\n\tif spider ~= nil and place.shadow ~= nil then\n\t\tlocal near = flat(place.shadow, spider.pos) <= Bird.SHADOW_NEAR\n\t\tif near and not self.shadowNear then self.shadows += 1; emit(self, \"shadow\", place.shadow) end\n\t\tself.shadowNear = near\n\telse\n\t\tself.shadowNear = false\n\tend\n\tif not self.enabled or spider == nil or not onGround then return end\n\tlocal moving = spider.speed >= Bird.MOVING\n\tlocal open = not spider.hidden and not spider.covered and spider.pos.Y - GT <= Bird.HIGH\n\tif self.react == \"none\" then\n\t\tif self.cooldown <= 0 and moving and open and flat(Bird.head(self), spider.pos) <= Bird.NOTICE then\n\t\t\tself.react, self.reactS, self.stillS = \"stalk\", 0, 0\n\t\t\tself.notices += 1\n\t\t\temit(self, \"noticed\", spider.pos)\n\t\tend\n\t\treturn\n\tend\n\t-- a reaction under way: it faces the spider\n\tself.reactS += dt\n\tself.look = spider.pos\n\tlocal toward = v(spider.pos.X - self.pos.X, 0, spider.pos.Z - self.pos.Z)\n\tif toward.Magnitude > 0.5 then self.heading = toward.Unit end\n\tself.stillS = if moving then 0 else self.stillS + dt\n\tlocal function lose()\n\t\tself.react, self.cooldown, self.look = \"none\", Bird.COOLDOWN, nil\n\t\tself.losses += 1\n\t\temit(self, \"lost\", spider.pos)\n\tend\n\tif not open or self.stillS >= Bird.STILL_LOSE or flat(Bird.head(self), spider.pos) > Bird.NOTICE * 1.4 then lose(); return end\n\tif self.react == \"stalk\" then\n\t\tif flat(Bird.bill(self), spider.pos) <= Bird.REACH then\n\t\t\tself.react, self.reactS, self.pose = \"tell\", 0, \"watch\"\n\t\t\treturn\n\t\tend\n\t\t-- hop toward it, never far off its line\n\t\tself.pose = \"hop\"\n\t\tlocal step = toward.Unit * math.min(Bird.STALK_SPEED * dt, math.max(0, toward.Magnitude - Bird.REACH * 0.5))\n\t\tlocal nextOffset = self.offset + step\n\t\tif nextOffset.Magnitude <= Bird.STALK_MAX then self.offset = nextOffset; self.pos = place.pos + nextOffset else self.pose = \"watch\" end\n\t\treturn\n\tend\n\tif self.react == \"tell\" then\n\t\tself.pose = \"watch\" -- (the head cocked at the spider, still: the tell)\n\t\tif self.reactS >= Bird.TELL then\n\t\t\tself.react, self.reactS, self.pose = \"none\", 0, \"strike\"\n\t\t\tself.strikeS, self.strikeAt = 0, spider.pos\n\t\t\tself.cooldown = Bird.COOLDOWN\n\t\t\tif flat(Bird.bill(self), spider.pos) <= Bird.REACH * 1.25 and moving then\n\t\t\t\tif self.gentle then\n\t\t\t\t\tself.misses += 1\n\t\t\t\t\temit(self, \"missed\", spider.pos)\n\t\t\t\telse\n\t\t\t\t\tself.strikes += 1\n\t\t\t\t\temit(self, \"struck\", spider.pos)\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tself.losses += 1\n\t\t\t\temit(self, \"lost\", spider.pos)\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- Takes the signals since the last call.\nfunction Bird.drainSignals(self: any): { Signal }\n\tlocal out = self.signals\n\tself.signals = {}\n\treturn out\nend\n\n-- How loud its call is to a spider at `at` (0..1): while it calls, by distance.\nfunction Bird.call(self: any, at: Vector3): number\n\tif not self.here or not self.calling then return 0 end\n\treturn math.clamp(1 - (self.pos - at).Magnitude / Bird.HEAR, 0, 1)\nend\n\n-- Whether it is in the middle of something with the spider.\nfunction Bird.reacting(self: any): boolean\n\treturn self.react ~= \"none\"\nend\n\n-- The first visit of a day to a site (for the self-test and the previewer: a place and an hour where it is on the ground there), or nil.\nfunction Bird.visitTo(seed: number, day: number, siteId: string): Visit?\n\tfor _, visit in Bird.plan(seed, day) do\n\t\tif visit.site.id == siteId then return visit end\n\tend\n\treturn nil\nend\n-- The hour `secs` seconds into a visit.\nfunction Bird.hourOf(visit: Visit, secs: number): number\n\treturn visit.h0 + secs * Bird.HOUR_PER_S\nend\n\nreturn Bird\n",20897,2590227864},{"Shared/Predator/Cat","--!strict\n-- The ranger's cat (ROBLOX-118, docs/PARK_WORLD_DESIGN.md section 10: \"the cat and the game room live in the hut\"): a house cat that lives in the ranger hut's\n-- two rooms and never leaves them. Pure: no engine, no drawing (Rig/CatPose draws it, Client/CatBody puts the parts in the world), so the client, the self-test\n-- and the CLI suites ask exactly the same cat.\n--\n-- Its day is a seeded schedule (`Cat.plan(seed, day)`: the world's seed through WorldMap.seed(914, \"cat\"), a Park-Miller stream per day), so where the cat is at\n-- an hour of a day is a pure function of the seed, the day and the hour, and a return to a rest finds it where the schedule says (restores never reroll): it\n-- sleeps on the back room's sofa or on the chair at the desk by the sill through much of the day, as cats do (they sleep twelve hours or more, most of it in\n-- naps); it is up at dawn and dusk and for a while in the night, and then it walks the two rooms through the doorway, eats at its bowls by the door, grooms\n-- on the rug, waits by the door for the ranger, and sits on the back room's deep window sill looking out. Every day begins and ends asleep on the sofa.\n--\n-- It is heard before it is seen: the bell on its collar rings with every step (a small bell carries a few metres), and it purrs as it settles to rest\n-- (`sound`). It notices a small thing that moves near it (`step`): it stops, its head follows the thing, and if the thing keeps moving and is in reach it\n-- crouches and pats at it with a forepaw, fast. What saves a spider is what saves any small thing from a cat: being out of its reach (up high: the desk, the\n-- lamp, the bookcase's top, a wall), in a gap it cannot get a paw into (a home, the gap under the sofa), or keeping still until it loses interest. In Normal a\n-- pat that lands kills the spider (`struck`); in the gentle rules (Easy, Free play) it only knocks it aside (`nudged`).\n--\n-- Live state that is not saved: the reaction under way, how far the cat has stepped off its schedule to stalk, and how far behind its schedule watching left it\n-- (`lag`: it then runs its schedule a little faster until it has caught up). A return to a rest ends a reaction and puts the cat where its schedule says. Saved\n-- (`toRecord`, Persistence/Checkpoint's optional `cat`): the day it last swatted and this life's notices, pats that missed and pats that landed.\n--\n-- Studs (a stud is a centimetre), the sill's frame (World/Hut: +x east, -z north, the hut's floor at y -70). True size: a domestic cat about 46 cm long without\n-- its tail, 23 to 25 cm at the shoulder (Rig/CatPose has the body).\nlocal Cat = {}\nCat.__index = Cat\n\nlocal FL = -70 -- the floor (World/Hut.FLOOR)\nlocal v = Vector3.new\n\n-- ---------------------------------------------------------------- the numbers\nCat.WALK_SPEED = 60 -- studs a second: a cat's unhurried walk, 0.6 m/s\nCat.JUMP_S = 0.55 -- seconds a jump up or down takes\nCat.NOTICE = 125 -- how near (studs, in plan, from its head) a moving thing catches its eye\nCat.NOTICE_UP = 130 -- and how high over the surface it stands on (it watches what moves on a wall)\nCat.REACH = 24 -- how far its pat reaches in plan from its chest\nCat.REACH_UP = 50 -- and how high over its surface (up on its hind legs)\nCat.MOVING = 0.5 -- studs a second: slower than this, a spider is keeping still\nCat.WAKE_SPEED = 1.1 -- creeping can pass a sleeping cat; sustained walking wakes it\nCat.WAKE_S = 2 -- seconds of nearby roaming before it gets up\nCat.STILL_LOSE = 2.5 -- seconds of stillness and it loses interest\nCat.HIGH_LOSE = 5.0 -- seconds staring at what it cannot reach and it gives up\nCat.WATCH = table.freeze({ 1.2, 3.0 }) -- seconds it watches before it moves on what it watches (a draw per notice)\nCat.CROUCH_S = 0.6 -- the crouch and the wiggle before the pat\nCat.SWAT_S = 0.25 -- the pat itself (the paw is at the far end of its reach halfway through)\nCat.STALK_SPEED = 20 -- studs a second, low and slow toward the thing\nCat.STALK_MAX = 80 -- the farthest it steps off its schedule's place to stalk\nCat.COOLDOWN = 12 -- seconds after it gives up before anything catches its eye again\nCat.MISSES = 2 -- pats that miss before it gives up\nCat.CATCH_UP = 0.5 -- after a reaction its schedule runs this much faster until it has caught up\nCat.HEAR_BELL = 350 -- studs: how far the bell is heard (about 3.5 m)\nCat.HEAR_PURR = 70 -- and the purr (under a metre)\nCat.PURR_H = 0.4 -- hours of purring as it settles to a rest\nlocal HOUR_PER_S = 12.0 / (15.0 * 60.0) -- Life/LifeClock.ACTIVE_HOURS_PER_S: game hours a second at the hut's pace (1.0)\nCat.HOUR_PER_S = HOUR_PER_S\n\n-- Where it rests and sits, the surface it is on, which way it faces, and the floor point it jumps up from (or walks to).\nexport type Spot = { pos: Vector3, heading: Vector3, kind: string, node: string, up: boolean }\nCat.SPOTS = table.freeze({\n\tsofa = table.freeze({ pos = v(300, -25, 205), heading = v(1, 0, 0), kind = \"rest\", node = \"sofa_front\", up = true }), -- on the sofa's seat (World/Hut.SOFA)\n\tchair = table.freeze({ pos = v(86, -24, 108), heading = v(0, 0, -1), kind = \"rest\", node = \"chair_side\", up = true }), -- on the chair at the desk by the sill\n\twindow = table.freeze({ pos = v(437, 0, 134), heading = v(1, 0, 0), kind = \"sit\", node = \"window_floor\", up = true }), -- on the back room's window sill\n\tbowls = table.freeze({ pos = v(-87, FL, 220), heading = v(0, 0, 1), kind = \"eat\", node = \"bowls\", up = false }), -- at its bowls by the door\n\tdoor = table.freeze({ pos = v(0, FL, 228), heading = v(0, 0, 1), kind = \"sit\", node = \"door\", up = false }), -- waiting by the door\n\trug = table.freeze({ pos = v(315, FL + 1, 130), heading = v(1, 0, 0.3).Unit, kind = \"groom\", node = \"rug\", up = false }), -- grooming on the rug\n}) :: { [string]: Spot }\nCat.SPOT_ORDER = table.freeze({ \"sofa\", \"chair\", \"window\", \"bowls\", \"door\", \"rug\" })\n-- The floor's ways through the two rooms (clear of the furniture: the sofa, the television's unit, the shelves, the caddy, the radiator), and the doorway.\nCat.NODES = table.freeze({\n\thut_mid = v(0, FL, 160), chair_side = v(45, FL, 108), bowls = v(-87, FL, 220), door = v(0, FL, 228),\n\tdoorway_w = v(125, FL, 215), doorway_e = v(195, FL, 215), room_w = v(205, FL, 140), rug = v(315, FL + 1, 130),\n\tsofa_front = v(300, FL, 152), window_floor = v(405, FL, 134),\n}) :: { [string]: Vector3 }\nlocal EDGES = {\n\t{ \"hut_mid\", \"chair_side\" }, { \"hut_mid\", \"bowls\" }, { \"hut_mid\", \"door\" }, { \"bowls\", \"door\" }, { \"hut_mid\", \"doorway_w\" }, { \"doorway_w\", \"doorway_e\" },\n\t{ \"doorway_e\", \"room_w\" }, { \"room_w\", \"rug\" }, { \"room_w\", \"sofa_front\" }, { \"rug\", \"sofa_front\" }, { \"rug\", \"window_floor\" }, { \"sofa_front\", \"window_floor\" },\n}\nCat.EDGES = EDGES\n-- The two rooms in plan (it notices only what is in the room it is in; the doorway is both), and what its body cannot go into when it stalks.\nCat.ROOMS = table.freeze({ hut = table.freeze({ -146.5, 146.5 }), back = table.freeze({ 175, 445 }) }) :: { [string]: { number } }\nlocal BLOCKS = {\n\t{ 225, 425, 165.5, 254 }, { 185, 275, 14, 52.5 }, { 360, 440, 14, 44 }, { 425, 441, 100, 163 }, -- the sofa, the television's unit, the games, the radiator\n\t{ -146.5, -118.5, 116, 204 }, { 68, 90, 228, 246 }, -- the bookcase, the caddy\n\t{ -101, -73, 38, 66 }, { -140.4, -120, 59, 81 }, -- station boots and field pack\n}\nCat.BLOCKS = BLOCKS\n\n-- ---------------------------------------------------------------- the schedule\nlocal MOD = 2147483647\nlocal function rng(seed: number, salt: number): () -> number\n\tlocal state = (seed + salt * 7919) % MOD\n\tif state <= 0 then state += MOD - 1 end\n\treturn function(): number\n\t\tstate = (state * 16807) % MOD\n\t\treturn (state - 1) / (MOD - 1)\n\tend\nend\nlocal function between(rand: () -> number, a: number, b: number): number\n\treturn a + (b - a) * rand()\nend\n\n-- The shortest way over the floor between two nodes (Dijkstra over the few edges), as points.\nlocal routeCache: { [string]: { Vector3 } } = {}\nlocal function route(a: string, b: string): { Vector3 }\n\tlocal key = a .. \">\" .. b\n\tif routeCache[key] then return routeCache[key] end\n\tlocal N = Cat.NODES\n\tlocal dist: { [string]: number } = { [a] = 0 }\n\tlocal prev: { [string]: string } = {}\n\tlocal done: { [string]: boolean } = {}\n\twhile true do\n\t\tlocal best, bd = nil :: string?, math.huge\n\t\tfor n, d in dist do if not done[n] and d < bd then best, bd = n, d end end\n\t\tif best == nil or best == b then break end\n\t\tdone[best] = true\n\t\tfor _, e in EDGES do\n\t\t\tlocal other = if e[1] == best then e[2] elseif e[2] == best then e[1] else nil\n\t\t\tif other ~= nil and not done[other] then\n\t\t\t\tlocal d = bd + (N[best] - N[other]).Magnitude\n\t\t\t\tif dist[other] == nil or d < dist[other] then dist[other] = d; prev[other] = best end\n\t\t\tend\n\t\tend\n\tend\n\tlocal out = {}\n\tlocal n: string? = b\n\twhile n ~= nil do\n\t\ttable.insert(out, 1, N[n])\n\t\tn = if n == a then nil else prev[n]\n\tend\n\trouteCache[key] = out\n\treturn out\nend\nCat.route = route\n\nexport type Segment = { t0: number, t1: number, kind: string, spot: string, from: string?, path: { Vector3 }?, length: number?, up: number?, down: number? }\n\n-- The way from one spot to another: down from the first (when it is up on something), over the floor, up onto the second; its points, its length on the\n-- floor, and the seconds of its jumps.\nlocal function walkBetween(a: string, b: string): ({ Vector3 }, number, number, number)\n\tlocal A, B = Cat.SPOTS[a], Cat.SPOTS[b]\n\tlocal pts: { Vector3 } = {}\n\tif A.up then table.insert(pts, A.pos) end\n\tlocal floor = route(A.node, B.node)\n\tfor _, p in floor do table.insert(pts, p) end\n\tif B.up then table.insert(pts, B.pos) end\n\tlocal length = 0 -- (on the floor only: the jumps take their own time)\n\tfor i = 2, #floor do length += (floor[i] - floor[i - 1]).Magnitude end\n\treturn pts, length, if B.up then Cat.JUMP_S else 0, if A.up then Cat.JUMP_S else 0\nend\n\n-- How long each kind of stop lasts (hours), by the part of the day.\nlocal function partOf(h: number): string\n\tif (h >= 5 and h < 8.5) or (h >= 17 and h < 21) then return \"crepuscular\" end\n\tif h >= 8.5 and h < 17 then return \"day\" end\n\treturn \"night\"\nend\nlocal WEIGHTS: { [string]: { [string]: number } } = {\n\tcrepuscular = { bowls = 0.22, window = 0.28, rug = 0.2, door = 0.12, chair = 0.06, sofa = 0.12 },\n\tday = { sofa = 0.36, chair = 0.3, window = 0.14, rug = 0.1, bowls = 0.05, door = 0.05 },\n\tnight = { sofa = 0.55, rug = 0.15, bowls = 0.12, window = 0.18 },\n}\nlocal function stay(spot: string, part: string, rand: () -> number): number\n\tlocal kind = Cat.SPOTS[spot].kind\n\tif kind == \"rest\" then return if part == \"day\" then between(rand, 1.4, 3.2) else between(rand, 0.5, 1.4) end\n\tif spot == \"window\" then return between(rand, 0.3, 1.0) end\n\tif kind == \"eat\" then return between(rand, 0.08, 0.16) end\n\tif kind == \"groom\" then return between(rand, 0.15, 0.4) end\n\treturn between(rand, 0.1, 0.3) -- (by the door)\nend\n\nlocal planCache: { [string]: { Segment } } = {}\n-- The cat's day: its segments from 0 to 24 hours, each a stop at a spot or a walk between two (the walk's points, its floor length and its jumps).\nfunction Cat.plan(seed: number, day: number): { Segment }\n\tlocal key = tostring(seed) .. \"/\" .. tostring(day)\n\tif planCache[key] then return planCache[key] end\n\tlocal rand = rng(seed, 1000 + day)\n\tlocal out: { Segment } = {}\n\tlocal spot = \"sofa\"\n\tlocal t = between(rand, 4.5, 5.5)\n\ttable.insert(out, { t0 = 0, t1 = t, kind = \"rest\", spot = \"sofa\" })\n\tlocal function go(to: string)\n\t\tlocal pts, length, up, down = walkBetween(spot, to)\n\t\tlocal dur = (length / Cat.WALK_SPEED + up + down) * HOUR_PER_S\n\t\ttable.insert(out, { t0 = t, t1 = t + dur, kind = \"walk\", spot = to, from = spot, path = pts, length = length, up = up, down = down })\n\t\tt += dur\n\t\tspot = to\n\tend\n\twhile t < 22.5 do\n\t\tlocal part = partOf(t)\n\t\tlocal w = WEIGHTS[part]\n\t\tlocal total = 0\n\t\tfor _, name in Cat.SPOT_ORDER do if name ~= spot then total += w[name] or 0 end end\n\t\tlocal x = rand() * total\n\t\tlocal pick = \"sofa\"\n\t\tfor _, name in Cat.SPOT_ORDER do\n\t\t\tif name ~= spot and (w[name] or 0) > 0 then\n\t\t\t\tx -= w[name]\n\t\t\t\tif x <= 0 then pick = name; break end\n\t\t\tend\n\t\tend\n\t\tgo(pick)\n\t\tlocal d = stay(pick, part, rand)\n\t\tlocal t1 = math.min(t + d, 23.2)\n\t\ttable.insert(out, { t0 = t, t1 = t1, kind = Cat.SPOTS[pick].kind, spot = pick })\n\t\tt = t1\n\tend\n\tif spot ~= \"sofa\" then go(\"sofa\") end\n\ttable.insert(out, { t0 = t, t1 = 24, kind = \"rest\", spot = \"sofa\" })\n\tfor _, s in out do table.freeze(s) end\n\tplanCache[key] = table.freeze(out)\n\treturn out\nend\n\n-- Where the schedule has the cat at `hour` of `day`: its position (on the surface it stands on), heading, pose (\"walk\", \"jump\", \"sit\", \"rest\", \"sleep\", \"eat\",\n-- \"groom\"), the surface's height, and whether it is purring.\nexport type Place = { pos: Vector3, heading: Vector3, pose: string, surface: number, purring: boolean, spot: string, segment: Segment }\nfunction Cat.at(seed: number, day: number, hour: number): Place\n\tlocal plan = Cat.plan(seed, day)\n\tlocal h = math.clamp(hour, 0, 24 - 1e-9)\n\tlocal seg = plan[#plan]\n\tfor _, s in plan do\n\t\tif h < s.t1 then seg = s; break end\n\tend\n\tif seg.kind ~= \"walk\" then\n\t\tlocal S = Cat.SPOTS[seg.spot]\n\t\tlocal pose = seg.kind\n\t\tlocal purring = false\n\t\tif seg.kind == \"rest\" then\n\t\t\tpurring = h - seg.t0 < Cat.PURR_H and seg.t0 > 0\n\t\t\tpose = if purring then \"rest\" else \"sleep\"\n\t\tend\n\t\treturn { pos = S.pos, heading = S.heading, pose = pose, surface = S.pos.Y, purring = purring, spot = seg.spot, segment = seg }\n\tend\n\t-- a walk: down from where it was (a jump), along the floor, up onto where it is going (a jump), each at its own pace\n\tlocal secs = (h - seg.t0) / HOUR_PER_S\n\tlocal pts = seg.path :: { Vector3 }\n\tlocal down, up, length = seg.down or 0, seg.up or 0, seg.length or 0\n\tlocal first, last = 1, #pts\n\tlocal function jump(a: Vector3, b: Vector3, k: number): Place\n\t\tlocal p = a:Lerp(b, k) + v(0, math.sin(k * math.pi) * 18, 0)\n\t\tlocal flat = v(b.X - a.X, 0, b.Z - a.Z)\n\t\tlocal hd = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.zAxis\n\t\treturn { pos = p, heading = hd, pose = \"jump\", surface = p.Y, purring = false, spot = seg.spot, segment = seg }\n\tend\n\tif down > 0 then\n\t\tif secs < down then return jump(pts[1], pts[2], secs / down) end\n\t\tsecs -= down\n\t\tfirst = 2\n\tend\n\tlocal floorEnd = if up > 0 then last - 1 else last\n\tlocal walkS = length / Cat.WALK_SPEED\n\tif secs >= walkS and up > 0 then return jump(pts[floorEnd], pts[last], math.clamp((secs - walkS) / up, 0, 1)) end\n\t-- along the floor's points from `first` to `floorEnd`\n\tlocal d = math.clamp(secs, 0, walkS) * Cat.WALK_SPEED\n\tfor i = first, floorEnd - 1 do\n\t\tlocal a, b = pts[i], pts[i + 1]\n\t\tlocal l = (b - a).Magnitude\n\t\tif d <= l or i == floorEnd - 1 then\n\t\t\tlocal k = if l > 1e-6 then math.clamp(d / l, 0, 1) else 1\n\t\t\tlocal flat = v(b.X - a.X, 0, b.Z - a.Z)\n\t\t\treturn { pos = a:Lerp(b, k), heading = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.zAxis, pose = \"walk\", surface = a.Y + (b.Y - a.Y) * k,\n\t\t\t\tpurring = false, spot = seg.spot, segment = seg }\n\t\tend\n\t\td -= l\n\tend\n\tlocal p = pts[floorEnd]\n\treturn { pos = p, heading = Vector3.zAxis, pose = \"walk\", surface = p.Y, purring = false, spot = seg.spot, segment = seg }\nend\n\n-- ---------------------------------------------------------------- the live cat\nexport type Spider = { pos: Vector3, speed: number, hidden: boolean, visible: boolean? }\nexport type Signal = { kind: string, at: Vector3?, away: Vector3? }\n\n-- A new cat for a world seed (WorldMap.seed(914, \"cat\")).\nfunction Cat.new(seed: number): any\n\tlocal self = setmetatable({\n\t\tseed = seed, day = 1, hour = 0,\n\t\t-- where it is and what it is doing, as drawn\n\t\tpos = Cat.SPOTS.sofa.pos, heading = Cat.SPOTS.sofa.heading, pose = \"sleep\", surface = Cat.SPOTS.sofa.pos.Y, purring = false, spot = \"sofa\",\n\t\tlook = nil :: Vector3?, -- the point its head follows, while it watches something\n\t\t-- the live reaction (never saved)\n\t\treact = \"none\", reactS = 0, watchS = 0, stillS = 0, highS = 0, misses = 0, cooldown = 0, lag = 0, offset = Vector3.zero, pawAt = nil :: Vector3?, swatHit = false,\n\t\t-- this life's record (saved)\n\t\tnotices = 0, pats = 0, swats = 0, lastSwatDay = 0,\n\t\tgentle = false, enabled = true, wakeS = 0, advance = 0,\n\t\tsignals = {} :: { Signal },\n\t}, Cat)\n\treturn self\nend\n\n-- The room a point is in, in plan (\"hut\", \"back\", or \"doorway\" for the doorway between, which is both).\nfunction Cat.roomOf(p: Vector3): string?\n\tif p.X >= 146.5 and p.X <= 175 and p.Z >= 180 and p.Z <= 250 then return \"doorway\" end\n\t-- The window recess belongs to the room up to the pane. Otherwise both\n\t-- a spider on the sill and the seated cat's eyes were classified outside.\n\tif p.X > 445 and p.X < 459 and p.Z >= 98 and p.Z <= 170 then return \"back\" end\n\tfor name, r in Cat.ROOMS do if p.X >= r[1] - 1 and p.X <= r[2] + 1 and p.Z >= 12.5 - 30 and p.Z <= 255.5 + 1 then return name end end\n\treturn nil\nend\nlocal function sameRoom(a: Vector3, b: Vector3): boolean\n\tlocal ra, rb = Cat.roomOf(a), Cat.roomOf(b)\n\tif ra == nil or rb == nil then return false end\n\treturn ra == rb or ra == \"doorway\" or rb == \"doorway\"\nend\n-- Whether its body can step to (x, z) on the floor when it stalks.\nfunction Cat.free(x: number, z: number): boolean\n\tif x > 120 and x < 200 and z > 188 and z < 242 then return true end -- (through the doorway, x 146.5..175, z 180..250, and either side of it)\n\tfor _, b in BLOCKS do if x > b[1] - 10 and x < b[2] + 10 and z > b[3] - 10 and z < b[4] + 10 then return false end end\n\tlocal r = Cat.roomOf(v(x, FL, z))\n\tif r == \"hut\" then return x > -146.5 + 12 and x < 146.5 - 12 and z > 12.5 + 12 and z < 255.5 - 12 end\n\tif r == \"back\" then return x > 175 + 12 and x < 445 - 12 and z > 12.5 + 12 and z < 255.5 - 12 end\n\treturn r == \"doorway\"\nend\n\n-- Whether a spider at `p` is under the sofa (in the dark under its frame, where no paw reaches: World/Hut.SOFA's footprint, under its frame's 8 cm).\nfunction Cat.under(p: Vector3): boolean\n\tlocal b = BLOCKS[1]\n\treturn p.X > b[1] + 4 and p.X < b[2] - 4 and p.Z > b[3] + 4 and p.Z < b[4] - 4 and p.Y < -62\nend\n\n-- Its head and its chest, where it looks from and pats from.\nfunction Cat.head(self: any): Vector3\n\tlocal seated = self.pose == \"sit\" or self.pose == \"groom\"\n\t\tor (self.pose == \"watch\" and (self.spot == \"window\" or self.surface > -60))\n\t-- Match CatPose's seated head, not its standing head outside the glass.\n\tif seated then return self.pos + self.heading * 12.5 + v(0,29,0) end\n\treturn self.pos + self.heading * 24 + v(0, if self.pose == \"sleep\" or self.pose == \"rest\" then 8 else 22, 0)\nend\nfunction Cat.chest(self: any): Vector3\n\treturn self.pos + self.heading * 14\nend\n\nlocal function flat(a: Vector3, b: Vector3): number\n\treturn v(a.X - b.X, 0, a.Z - b.Z).Magnitude\nend\n\n-- Whether a spider at `p` is in its paw's reach: near its chest in plan, and no higher over its surface than it can rise to.\nfunction Cat.inReach(self: any, p: Vector3): boolean\n\treturn flat(Cat.chest(self), p) <= Cat.REACH and p.Y - self.surface <= Cat.REACH_UP and p.Y >= self.surface - 3\nend\n\nlocal function emit(self: any, kind: string, at: Vector3?, away: Vector3?)\n\ttable.insert(self.signals, { kind = kind, at = at, away = away })\nend\n\n-- A draw for this notice (its watch's length), from the seed and how many it has made: the same for the same notice after a return to a rest.\nlocal function draw(self: any, salt: number): number\n\treturn rng(self.seed, 5000 + self.notices * 13 + salt)()\nend\n\n-- One step of `dt` seconds at the life clock's (day, hour), with the spider as it is now (`spider`: its body's position, its speed, whether it is hidden: in a\n-- home, under the sofa). Puts the cat where its schedule (and any reaction) has it, and reacts. Signals: \"noticed\", \"pat\" (a pat that missed), \"struck\" (a pat\n-- that landed in the standard rules), \"nudged\" (in the gentle rules: knocked aside, `away` the push's direction), \"gave_up\".\nfunction Cat.step(self: any, dt: number, day: number, hour: number, spider: Spider?)\n\tself.day, self.hour = day, hour\n\t-- the schedule's place at its own time (behind by its lag while it caught up after a reaction)\n\tif self.react == \"none\" and self.lag > 0 then self.lag = math.max(0, self.lag - dt * Cat.CATCH_UP * HOUR_PER_S) end\n\tif self.react ~= \"none\" then self.lag += dt * HOUR_PER_S end\n\tlocal h = hour - self.lag + self.advance\n\tlocal dd = day\n\twhile h < 0 do h += 24; dd -= 1 end\n\twhile h >= 24 do h -= 24; dd += 1 end\n\tlocal place = Cat.at(self.seed, math.max(dd, 1), h)\n\t-- Movement can disturb a nap. Skip the remaining rest, not the trip off the\n\t-- furniture: the next authored walk begins at precisely the same perch.\n\tlocal resting = place.pose == \"sleep\" or place.pose == \"rest\"\n\tlocal disturbing = self.enabled and spider ~= nil and not spider.hidden\n\t\tand spider.speed >= Cat.WAKE_SPEED and sameRoom(place.pos, spider.pos)\n\t\tand flat(place.pos, spider.pos) <= Cat.NOTICE and math.abs(spider.pos.Y - place.surface) <= Cat.NOTICE_UP\n\tself.wakeS = if resting and disturbing then self.wakeS + dt else math.max(0, self.wakeS - dt * 2)\n\tif self.react == \"none\" and resting and self.cooldown <= 0 and self.wakeS >= Cat.WAKE_S then\n\t\tlocal departure: Segment? = nil\n\t\tlocal departureDay = math.max(dd, 1)\n\t\tfor _, seg in Cat.plan(self.seed, departureDay) do\n\t\t\tif seg.kind == \"walk\" and seg.from == place.spot and seg.t0 >= h then departure = seg; break end\n\t\tend\n\t\t-- The final rest is on the sofa; its next departure is tomorrow morning.\n\t\tif departure == nil and place.spot == \"sofa\" then\n\t\t\tdepartureDay += 1\n\t\t\tdeparture = Cat.plan(self.seed, departureDay)[2]\n\t\tend\n\t\tif departure ~= nil then\n\t\t\tself.advance += (departureDay - math.max(dd, 1)) * 24 + departure.t0 - h\n\t\t\tplace = Cat.at(self.seed, departureDay, departure.t0)\n\t\t\tself.wakeS = 0\n\t\t\temit(self, \"woke\", place.pos)\n\t\tend\n\tend\n\t-- the stalk's offset comes back to nothing when it is not stalking\n\tif self.react == \"none\" and self.offset.Magnitude > 0 then\n\t\tlocal back = math.min(self.offset.Magnitude, Cat.WALK_SPEED * dt)\n\t\tself.offset -= self.offset.Unit * back\n\tend\n\tself.pos = place.pos + self.offset\n\tself.surface = place.surface\n\tself.spot = place.spot\n\tif self.react == \"none\" then\n\t\tself.heading, self.pose, self.purring = place.heading, (if self.offset.Magnitude > 0.5 then \"walk\" else place.pose), place.purring\n\t\tself.look = nil\n\tend\n\tself.cooldown = math.max(0, self.cooldown - dt)\n\tif not self.enabled or spider == nil then return end\n\tlocal awake = place.pose ~= \"sleep\" and place.pose ~= \"jump\"\n\tlocal moving = spider.speed >= Cat.MOVING\n\tif self.react == \"none\" then\n\t\tif awake and self.cooldown <= 0 and moving and not spider.hidden and spider.visible ~= false and sameRoom(Cat.head(self), spider.pos)\n\t\t\tand flat(Cat.head(self), spider.pos) <= Cat.NOTICE and spider.pos.Y - self.surface <= Cat.NOTICE_UP and spider.pos.Y >= self.surface - 5 then\n\t\t\tself.react, self.reactS, self.stillS, self.highS, self.misses = \"watch\", 0, 0, 0, 0\n\t\t\tself.watchS = Cat.WATCH[1] + (Cat.WATCH[2] - Cat.WATCH[1]) * draw(self, 1)\n\t\t\tself.notices += 1\n\t\t\tself.pose, self.purring = \"watch\", false\n\t\t\temit(self, \"noticed\", spider.pos)\n\t\tend\n\t\treturn\n\tend\n\t-- a reaction under way: it faces the thing and follows it with its head\n\tself.reactS += dt\n\tself.look = spider.pos\n\tlocal toward = v(spider.pos.X - self.pos.X, 0, spider.pos.Z - self.pos.Z)\n\tif toward.Magnitude > 1 and self.react ~= \"swat\" then\n\t\tlocal want = toward.Unit\n\t\tlocal turned = self.heading:Lerp(want, math.clamp(dt * 6, 0, 1))\n\t\tself.heading = if turned.Magnitude > 1e-3 then turned.Unit else want\n\tend\n\tlocal function giveUp()\n\t\tself.react, self.cooldown, self.look = \"none\", Cat.COOLDOWN, nil\n\t\temit(self, \"gave_up\", spider.pos)\n\tend\n\t-- Losing sight behind a prop stops tracking immediately, including a pat.\n\t-- Hearing may wake the cat, but never supplies a target through a wall.\n\tif spider.hidden or spider.visible == false then giveUp(); return end\n\tself.stillS = if moving then 0 else self.stillS + dt\n\tlocal high = spider.pos.Y - self.surface > Cat.REACH_UP\n\tself.highS = if high then self.highS + dt else 0\n\tif self.react == \"watch\" or self.react == \"stalk\" then\n\t\tif self.stillS >= Cat.STILL_LOSE or self.highS >= Cat.HIGH_LOSE or not sameRoom(Cat.head(self), spider.pos) or flat(Cat.head(self), spider.pos) > Cat.NOTICE * 1.5 then\n\t\t\tgiveUp()\n\t\t\treturn\n\t\tend\n\t\tif Cat.inReach(self, spider.pos) and self.reactS >= self.watchS and self.stillS < 0.5 then -- (it pounces on what moves)\n\t\t\tself.react, self.reactS, self.pose = \"crouch\", 0, \"crouch\"\n\t\t\treturn\n\t\tend\n\t\t-- not in reach: on the floor it creeps nearer (never off its own floor, never into the furniture, never far from its schedule's place)\n\t\tself.pose = \"watch\"\n\t\tif not high and self.surface <= FL + 2 and flat(Cat.chest(self), spider.pos) > Cat.REACH - 4 and self.reactS >= self.watchS * 0.5 then\n\t\t\tlocal step = toward.Unit * math.min(Cat.STALK_SPEED * dt, math.max(0, flat(Cat.chest(self), spider.pos) - (Cat.REACH - 6)))\n\t\t\tlocal next = self.offset + step\n\t\t\tlocal at = place.pos + next\n\t\t\tif next.Magnitude <= Cat.STALK_MAX and Cat.free(at.X, at.Z) then\n\t\t\t\tself.offset = next\n\t\t\t\tself.pos = at\n\t\t\t\tself.react, self.pose = \"stalk\", \"stalk\"\n\t\t\tend\n\t\tend\n\t\treturn\n\tend\n\tif self.react == \"crouch\" then\n\t\tself.pose = \"crouch\"\n\t\tif self.reactS >= Cat.CROUCH_S then\n\t\t\tself.react, self.reactS, self.pose, self.swatHit = \"swat\", 0, \"swat\", false\n\t\t\tself.pawAt = spider.pos\n\t\tend\n\t\treturn\n\tend\n\tif self.react == \"swat\" then\n\t\tself.pose = \"swat\"\n\t\tif not self.swatHit and self.reactS >= Cat.SWAT_S * 0.5 then\n\t\t\tself.swatHit = true\n\t\t\tif Cat.inReach(self, spider.pos) then\n\t\t\t\tself.swats += 1\n\t\t\t\tself.lastSwatDay = day\n\t\t\t\tlocal away = v(spider.pos.X - self.pos.X, 0, spider.pos.Z - self.pos.Z)\n\t\t\t\taway = if away.Magnitude > 1e-3 then away.Unit else self.heading\n\t\t\t\tif self.gentle then\n\t\t\t\t\temit(self, \"nudged\", spider.pos, away)\n\t\t\t\t\tself.react, self.cooldown, self.look = \"none\", Cat.COOLDOWN, nil\n\t\t\t\telse\n\t\t\t\t\temit(self, \"struck\", spider.pos, away)\n\t\t\t\t\tself.react, self.cooldown, self.look = \"none\", Cat.COOLDOWN, nil\n\t\t\t\tend\n\t\t\t\treturn\n\t\t\tend\n\t\t\tself.pats += 1\n\t\t\tself.misses += 1\n\t\t\temit(self, \"pat\", spider.pos)\n\t\tend\n\t\tif self.reactS >= Cat.SWAT_S then\n\t\t\tif self.misses >= Cat.MISSES then giveUp(); return end\n\t\t\tself.react, self.reactS, self.pose = \"watch\", 0, \"watch\"\n\t\t\tself.watchS = 0.6\n\t\tend\n\tend\nend\n\n-- Takes the signals since the last call.\nfunction Cat.drainSignals(self: any): { Signal }\n\tlocal out = self.signals\n\tself.signals = {}\n\treturn out\nend\n\n-- What a spider at `at` hears of it: the bell (0..1, while it walks, jumps, stalks or pats, by distance) and the purr (0..1, while it settles, close).\nfunction Cat.sound(self: any, at: Vector3): (number, number)\n\tlocal d = (Cat.head(self) - at).Magnitude\n\tlocal moving = self.pose == \"walk\" or self.pose == \"jump\" or self.pose == \"stalk\" or self.pose == \"swat\" or self.pose == \"crouch\"\n\tlocal bell = if moving then math.clamp(1 - d / Cat.HEAR_BELL, 0, 1) else 0\n\tif self.pose == \"stalk\" or self.pose == \"crouch\" then bell *= 0.35 end -- (stalking, it moves so slowly the bell barely rings)\n\tlocal purr = if self.purring then math.clamp(1 - d / Cat.HEAR_PURR, 0, 1) else 0\n\treturn bell, purr\nend\n\n-- Whether it is in the middle of something with the spider (a watch, a stalk, a crouch or a pat).\nfunction Cat.reacting(self: any): boolean\n\treturn self.react ~= \"none\"\nend\n\n-- ---------------------------------------------------------------- its record (Persistence/Checkpoint's optional `cat`)\nexport type Record = { notices: number, pats: number, swats: number, last_swat_day: number }\nfunction Cat.defaultRecord(): Record\n\treturn { notices = 0, pats = 0, swats = 0, last_swat_day = 0 }\nend\nfunction Cat.toRecord(self: any): Record\n\treturn { notices = self.notices, pats = self.pats, swats = self.swats, last_swat_day = self.lastSwatDay }\nend\nlocal function count(x: any): boolean\n\treturn type(x) == \"number\" and x == x and x >= 0 and x <= 1e6 and math.floor(x) == x\nend\n-- What is wrong with a record (none for a good one).\nfunction Cat.problems(d: any): { string }\n\tlocal out: { string } = {}\n\tif type(d) ~= \"table\" then return { \"cat: not a record\" } end\n\tfor _, k in { \"notices\", \"pats\", \"swats\", \"last_swat_day\" } do\n\t\tif not count(d[k]) then table.insert(out, `cat: {k} is not a count`) end\n\tend\n\treturn out\nend\n-- Puts the record back (a good one; the caller checked it) and ends whatever it was doing: the next step puts it where its schedule says.\nfunction Cat.load(self: any, d: Record)\n\tself.notices, self.pats, self.swats, self.lastSwatDay = d.notices, d.pats, d.swats, d.last_swat_day\n\tself.react, self.reactS, self.lag, self.offset, self.cooldown, self.look, self.misses = \"none\", 0, 0, Vector3.zero, 0, nil, 0\n\tself.wakeS, self.advance = 0, 0\n\tself.spiderPrevious = nil\n\ttable.clear(self.signals)\nend\n\nreturn Cat\n",28731,3098902801},{"Shared/Predator/CrabSpider","--!strict\n-- The crab spiders of the meadow's edge (ROBLOX-119, docs/PARK_WORLD_DESIGN.md zone 3; the notebook's page \"The crab spider on the flower\" says what is known of them):\n-- the goldenrod crab spider, Misumena vatia, sits still on a flower in the flower's colour with its first two pairs of legs held open, and grabs what comes in reach.\n-- Here two of them live on the meadow's flowers (World/Meadow.CRAB_SITES): a yellow one on a goldenrod's plume and a white one on a yarrow's head, each on one of its two\n-- flowers a day (a seeded draw per day: where it is at a day is a pure function of the seed and the day, so a return to a rest finds it where it was).\n--\n-- What it does to a jumping spider is what it does to anything that comes to its flower: one that walks or lands within its reach (REACH, from its body's middle) and\n-- stays there LATENCY seconds is grabbed. In the standard rules that is a death with its own card (UI/CrabText); in the gentle rules (Easy, Free play) it lunges and the\n-- spider drops clear (a \"nudged\" signal: Client/SpiderClient knocks it off the flower) and it waits COOLDOWN seconds. The honest tell, for a careful player, is how it is\n-- drawn (Client/CrabBody): its front legs held wide, its colour a shade off the flower's, and a crab spider's shape. A spider in a retreat is never in reach. Its first\n-- close look (within SEEN) opens its page (\"seen\"). Nothing of it is saved: its day is the seed's, and a grab under way is not kept, as a wasp's visit is not.\n-- Simplifications, said here: it never leaves its flower in a day, and it does not hunt the flies of the meadow (it is drawn with a caught one some days).\nlocal WorldMap = require(script.Parent.Parent.World.WorldMap)\nlocal Meadow = require(script.Parent.Parent.World.Meadow)\n\nlocal CrabSpider = {}\nCrabSpider.__index = CrabSpider\n\nCrabSpider.REACH = 2.2 -- studs from its body's middle to the jumping spider's: its open front legs (a female's are about as long as her body) and the spider's own body\nCrabSpider.LATENCY = 0.3 -- seconds in reach before the legs close\nCrabSpider.SEEN = 9 -- studs: the first close look opens its page\nCrabSpider.COOLDOWN = 8 -- seconds after a lunge in the gentle rules before it can lunge again\nCrabSpider.LIFT = 0.25 -- its body's middle over the flower's top (its legs on the florets)\nCrabSpider.HOLDING = 0.3 -- the share of days it is drawn holding a caught fly\nCrabSpider.CAUSE = \"crab_spider\"\n\nexport type Crab = { site: number, form: string, region: string, pos: Vector3, top: Vector3, heading: Vector3, touch: number, cooldown: number, strike: number, holding: boolean }\nexport type Signal = { kind: string, at: Vector3?, away: Vector3? }\nexport type Spider = { pos: Vector3, hidden: boolean }\n\nlocal MOD = 2147483647\n-- The day's draw for crab spider `k` (in [0, 1)): a Park-Miller step from the seed, the crab and the day.\nlocal function draw(seed: number, k: number, day: number, salt: number): number\n\tlocal s = (seed + k * 7919 + day * 104729 + salt * 15485863) % MOD\n\tif s <= 0 then s += MOD - 1 end\n\tfor _ = 1, 3 do s = (s * 48271) % MOD end\n\treturn (s - 1) / (MOD - 1)\nend\n\n-- Which of its two flowers crab spider `k` sits on, on `day` (1 or 2), and whether it holds a caught fly.\nfunction CrabSpider.siteOf(seed: number, k: number, day: number): (number, boolean)\n\treturn 1 + math.floor(draw(seed, k, day, 1) * 2), draw(seed, k, day, 2) < CrabSpider.HOLDING\nend\n\n-- The top of a site's flower head (the active world's map: the preserve's; nil where there is none).\nlocal tops: { [string]: Vector3 } = {}\nfunction CrabSpider.topOf(site: Meadow.CrabSite): Vector3?\n\tlocal key = site.piece\n\tlocal known = tops[key]\n\tif known then return known end\n\tlocal region = WorldMap.region(site.region)\n\tif region == nil then return nil end\n\tfor _, p in Meadow.pieces(region :: any) do\n\t\tif p.id == site.piece then\n\t\t\tlocal top = Vector3.new((p.lo.X + p.hi.X) / 2, p.hi.Y, (p.lo.Z + p.hi.Z) / 2)\n\t\t\ttops[key] = top\n\t\t\treturn top\n\t\tend\n\tend\n\treturn nil\nend\n\nfunction CrabSpider.new(seed: number): any\n\treturn setmetatable({\n\t\tseed = seed, gentle = false, enabled = true, day = -1, crabs = {} :: { Crab }, signals = {} :: { Signal }, met = false,\n\t\tgrabs = 0, lunges = 0, now = 0, -- (this session's: the self-test reads them)\n\t}, CrabSpider)\nend\n\n-- Puts each crab spider on its flower for `day`.\nfunction CrabSpider.place(self: any, day: number)\n\tself.day = day\n\ttable.clear(self.crabs)\n\tfor k, sites in Meadow.CRAB_SITES do\n\t\tlocal i, holding = CrabSpider.siteOf(self.seed, k, day)\n\t\tlocal site = sites[i]\n\t\tlocal top = CrabSpider.topOf(site)\n\t\tif top ~= nil then\n\t\t\tlocal a = draw(self.seed, k, day, 3) * 2 * math.pi\n\t\t\ttable.insert(self.crabs, {\n\t\t\t\tsite = i, form = site.form, region = site.region, top = top, pos = top + Vector3.yAxis * CrabSpider.LIFT, heading = Vector3.new(math.cos(a), 0, math.sin(a)),\n\t\t\t\ttouch = 0, cooldown = 0, strike = -1, holding = holding,\n\t\t\t})\n\t\tend\n\tend\nend\n\nlocal function signal(self: any, kind: string, at: Vector3?, away: Vector3?)\n\ttable.insert(self.signals, { kind = kind, at = at, away = away })\nend\n\n-- One tick: `spider` nil while there is no life to touch (the end screen, a menu).\nfunction CrabSpider.step(self: any, dt: number, day: number, _hour: number, spider: Spider?)\n\tself.now += dt\n\tif day ~= self.day then self:place(day) end\n\tfor _, c in self.crabs do\n\t\tif c.strike >= 0 then c.strike += dt; if c.strike > 0.6 then c.strike = -1 end end\n\t\tif c.cooldown > 0 then c.cooldown = math.max(0, c.cooldown - dt) end\n\t\tif spider == nil or not self.enabled or spider.hidden then c.touch = 0; continue end\n\t\tlocal d = (spider.pos - c.pos).Magnitude\n\t\tif d <= CrabSpider.SEEN and not self.met then\n\t\t\tself.met = true\n\t\t\tsignal(self, \"seen\", c.pos)\n\t\tend\n\t\tif d <= CrabSpider.REACH and c.cooldown <= 0 then\n\t\t\tc.touch += dt\n\t\t\tif c.touch >= CrabSpider.LATENCY then\n\t\t\t\tc.touch = 0\n\t\t\t\tc.strike = 0\n\t\t\t\tif self.gentle then\n\t\t\t\t\tlocal away = Vector3.new(spider.pos.X - c.pos.X, 0, spider.pos.Z - c.pos.Z)\n\t\t\t\t\taway = if away.Magnitude > 1e-3 then away.Unit else -c.heading\n\t\t\t\t\tc.cooldown = CrabSpider.COOLDOWN\n\t\t\t\t\tself.lunges += 1\n\t\t\t\t\tsignal(self, \"nudged\", c.pos, away)\n\t\t\t\telse\n\t\t\t\t\tself.grabs += 1\n\t\t\t\t\tc.cooldown = CrabSpider.COOLDOWN\n\t\t\t\t\tsignal(self, \"struck\", c.pos)\n\t\t\t\tend\n\t\t\tend\n\t\telse\n\t\t\tc.touch = 0\n\t\tend\n\tend\nend\n\n-- Takes the signals since the last call.\nfunction CrabSpider.drainSignals(self: any): { Signal }\n\tlocal out = self.signals\n\tself.signals = {}\n\treturn out\nend\n\n-- The nearest crab spider to a point, and how far (nil when none is placed).\nfunction CrabSpider.nearest(self: any, at: Vector3): (Crab?, number)\n\tlocal best, bd = nil, math.huge\n\tfor _, c in self.crabs do\n\t\tlocal d = (c.pos - at).Magnitude\n\t\tif d < bd then best, bd = c, d end\n\tend\n\treturn best, bd\nend\n\nreturn CrabSpider\n",6801,202350145},{"Shared/Predator/Frog","--!strict\n-- The green frog of the pond's edge (ROBLOX-122, docs/PARK_WORLD_DESIGN.md zone 4: \"a frog's tongue\"; the notebook's page \"The green frog\" says what is known of it).\n-- A green frog (Lithobates clamitans), at true size: 7.8 cm from snout to vent (the sources: 5 to 10 cm), a sit-and-wait hunter at the water's edge that takes\n-- whatever moving thing of a mouthful comes within reach, a spider among it. A frog's eye reacts to small things that move; one that keeps still is not food to it\n-- (the sources: a frog surrounded by still food can starve). Its tongue is out and back in under 0.07 s.\n--\n-- Its day: it sits on one of two seats (World/Pond.FROG_SITES: the flat stone at the water's edge, the big lily pad), one a day by a seeded draw (a pure function\n-- of the seed and the day, so a return to a rest finds it where it was; nothing of it is saved), facing the open margin. It sits still. That is the tell: a still\n-- green shape at the edge, its eyes up, where a frog would be.\n-- What it does (`step`): a spider that MOVES (faster than MOVING) within NOTICE of its head catches its eye: it turns to face it, a pivot of TURN_S seconds (it shifts\n-- on its seat: the only movement it makes), and if the spider is still moving and within REACH of its mouth when it faces it, the tongue strikes: in the standard\n-- rules a death with its own card (UI/FrogText, `struck`), in the gentle rules (Easy, Free play) it misses (`missed`) and the client knocks the spider aside. A spider\n-- that keeps still for STILL_LOSE seconds, or is out of NOTICE, or hidden (a home, a rest) is lost to it, and it settles for COOLDOWN seconds. Its first close look\n-- (SEEN) opens its page (`seen`). Live state that is not saved: its turn, its strike.\nlocal Pond = require(script.Parent.Parent.World.Pond)\nlocal WorldMap = require(script.Parent.Parent.World.WorldMap)\n\nlocal Frog = {}\nFrog.__index = Frog\n\nFrog.LENGTH = 7.8 -- studs, snout to vent\nFrog.NOTICE = 30 -- studs from its head: a moving spider within this catches its eye\nFrog.REACH = 11 -- studs from its mouth: a lunge and the tongue\nFrog.MOVING = 0.5 -- studs a second: slower than this, a spider is keeping still\nFrog.TURN_S = 0.6 -- the pivot to face what moved\nFrog.FACE = 0.85 -- the cosine within which it faces it\nFrog.STILL_LOSE = 2.0 -- seconds still and it loses the spider\nFrog.COOLDOWN = 5.0\nFrog.SEEN = 40 -- the first close look\nFrog.STRIKE_S = 0.07 -- the tongue, out and back\nFrog.EYE_Y = 2.2 -- its eyes over its seat\nFrog.MOUTH = 4.4 -- its mouth ahead of its middle\nFrog.CAUSE = \"frog\"\n\nlocal MOD = 2147483647\nlocal function draw(seed: number, day: number, salt: number): number\n\tlocal s = (seed + day * 104729 + salt * 15485863) % MOD\n\tif s <= 0 then s += MOD - 1 end\n\tfor _ = 1, 3 do s = (s * 48271) % MOD end\n\treturn (s - 1) / (MOD - 1)\nend\n\n-- Which seat it sits on (1 or 2) on `day`, and the slight turn it sits at (degrees off the seat's facing).\nfunction Frog.seatOf(seed: number, day: number): (number, number)\n\treturn 1 + math.floor(draw(seed, day, 1) * #Pond.FROG_SITES), (draw(seed, day, 2) - 0.5) * 50\nend\n\nlocal seats: { [number]: any } = {}\nfunction Frog.seatAt(i: number): Vector3?\n\tif seats[i] ~= nil then return seats[i] end\n\tlocal site = Pond.FROG_SITES[i]\n\tlocal r = WorldMap.region(site.region)\n\tif r == nil then return nil end\n\tlocal at = Pond.frogSeat(site, { r :: any })\n\tif at ~= nil then seats[i] = at end\n\treturn at\nend\n\nfunction Frog.new(seed: number): any\n\treturn setmetatable({\n\t\tseed = seed, gentle = false, enabled = true, day = -1, seat = 0, pos = Vector3.zero, heading = Vector3.xAxis, rest = Vector3.xAxis, state = \"sit\",\n\t\tt = 0, still = 0, cooldown = 0, strike = -1, met = false, signals = {}, strikes = 0, misses = 0, notices = 0, now = 0,\n\t}, Frog)\nend\n\n-- Puts it on its seat for `day`.\nfunction Frog.place(self: any, day: number)\n\tself.day = day\n\tlocal i, turn = Frog.seatOf(self.seed, day)\n\tlocal at = Frog.seatAt(i)\n\tself.seat = i\n\tif at == nil then self.pos = Vector3.zero; self.here = false; return end\n\tself.here = true\n\tself.pos = at\n\tlocal f = Pond.FROG_SITES[i].facing\n\tlocal a = math.rad(turn)\n\tself.rest = Vector3.new(f.X * math.cos(a) - f.Z * math.sin(a), 0, f.X * math.sin(a) + f.Z * math.cos(a)).Unit\n\tself.heading = self.rest\n\tself.state, self.t, self.still, self.cooldown, self.strike = \"sit\", 0, 0, 0, -1\nend\n\nlocal function signal(self: any, kind: string, at: Vector3?)\n\ttable.insert(self.signals, { kind = kind, at = at })\nend\n\nfunction Frog.head(self: any): Vector3\n\treturn self.pos + Vector3.new(0, Frog.EYE_Y, 0) + self.heading * (Frog.MOUTH * 0.6)\nend\nfunction Frog.mouth(self: any): Vector3\n\treturn self.pos + Vector3.new(0, 0.9, 0) + self.heading * Frog.MOUTH\nend\n\n-- One tick. `spider`: { pos, speed, hidden } or nil (no life to touch).\nfunction Frog.step(self: any, dt: number, day: number, spider: any)\n\tself.now += dt\n\tif day ~= self.day then self:place(day) end\n\tif self.strike >= 0 then self.strike += dt; if self.strike > 0.4 then self.strike = -1 end end\n\tif self.cooldown > 0 then self.cooldown = math.max(0, self.cooldown - dt) end\n\tif not self.here then return end\n\tif spider == nil or not self.enabled then self.state = \"sit\"; return end\n\tlocal head = self:head()\n\tlocal toSpider = spider.pos - head\n\tlocal d = toSpider.Magnitude\n\tif d <= Frog.SEEN and not self.met then\n\t\tself.met = true\n\t\tsignal(self, \"seen\", self.pos)\n\tend\n\tlocal flat = Vector3.new(spider.pos.X - self.pos.X, 0, spider.pos.Z - self.pos.Z)\n\tlocal moving = spider.speed > Frog.MOVING\n\tif self.state == \"sit\" then\n\t\tif self.cooldown <= 0 and not spider.hidden and moving and d <= Frog.NOTICE and flat.Magnitude > 1e-3 then\n\t\t\tself.state, self.t, self.still = \"turn\", 0, 0\n\t\t\tself.from = self.heading\n\t\t\tself.notices += 1\n\t\t\tsignal(self, \"noticed\", spider.pos)\n\t\telse\n\t\t\t-- (back to how it sat, slowly)\n\t\t\tself.heading = self.heading:Lerp(self.rest, math.min(1, dt * 0.5)).Unit\n\t\tend\n\t\treturn\n\tend\n\t-- turning or facing it: lost when hidden, out of notice, or still long enough\n\tif spider.hidden or d > Frog.NOTICE then self.state = \"sit\"; self.cooldown = Frog.COOLDOWN; signal(self, \"lost\", spider.pos); return end\n\tif moving then self.still = 0 else self.still += dt end\n\tif self.still >= Frog.STILL_LOSE then self.state = \"sit\"; self.cooldown = Frog.COOLDOWN; signal(self, \"lost\", spider.pos); return end\n\tlocal want = flat.Unit\n\tif self.state == \"turn\" then\n\t\tself.t += dt\n\t\tlocal k = math.clamp(self.t / Frog.TURN_S, 0, 1)\n\t\tself.heading = (self.from :: Vector3):Lerp(want, k)\n\t\tif self.heading.Magnitude < 1e-3 then self.heading = want end\n\t\tself.heading = self.heading.Unit\n\t\tif k >= 1 then self.state = \"watch\" end\n\t\treturn\n\tend\n\t-- watching: it follows it with small shifts; a moving spider within reach in front of it is struck\n\tself.heading = self.heading:Lerp(want, math.min(1, dt * 4)).Unit\n\tlocal mouthTo = (spider.pos - self:mouth()).Magnitude\n\tif moving and mouthTo <= Frog.REACH and self.heading:Dot(want) >= Frog.FACE then\n\t\tself.strike = 0\n\t\tself.state = \"sit\"\n\t\tself.cooldown = Frog.COOLDOWN\n\t\tif self.gentle then\n\t\t\tself.misses += 1\n\t\t\tsignal(self, \"missed\", spider.pos)\n\t\telse\n\t\t\tself.strikes += 1\n\t\t\tsignal(self, \"struck\", spider.pos)\n\t\tend\n\tend\nend\n\nfunction Frog.drainSignals(self: any): { any }\n\tlocal out = self.signals\n\tself.signals = {}\n\treturn out\nend\n\n-- Where the tongue's tip is, while it strikes (nil otherwise): out to the struck place and back in STRIKE_S.\nfunction Frog.tongue(self: any, target: Vector3?): Vector3?\n\tif self.strike < 0 or self.strike > Frog.STRIKE_S then return nil end\n\tlocal m = self:mouth()\n\tlocal t = self.strike / Frog.STRIKE_S\n\tlocal out = if t < 0.5 then t * 2 else (1 - t) * 2\n\treturn m:Lerp(target or (m + self.heading * Frog.REACH), out)\nend\n\nreturn Frog\n",7743,4275226896},{"Shared/Predator/Mate","--!strict\n-- The mate (ROBLOX-79): a spider of the opposite sex that comes onto the sill when the played spider is full-grown and well fed, is courted by the\n-- player, mates and walks off. It is not prey (the player's strike drives it off, it is never caught or eaten), it is not a rival (it never attacks),\n-- and the wasp ignores it. It is the shape of the rival: a plain record in LifeLoop's checkpoint graph (life.mate), a step that decides what it is doing\n-- from a snapshot of the player (no clock, no engine, no hidden tracking), arrival rules like the rival's (Data/MatingRules), and legs that are the\n-- rival's own (Predator/MateDrive, which gives RivalDrive a record in the rival's vocabulary). It keeps out of the retreat for the same reason.\n--\n-- ROBLOX-89: the pair's pause is the mating scene (Life/MatingScene, drawn by the client). `scene` is true from the moment the meter fills until the scene is over:\n-- the whole pause, and for a male mate the walk off the sill that is its last beat. Nothing else reads it but the checkpoint (no rest is kept inside the scene) and\n-- the client (the camera, the locked controls, the captions: `Mate.sceneTime` is the scene's clock, which a wasp visit holds like every other timer of the mate).\n--\n-- States: away (not on the sill: not arrived yet, driven off, gone for the day or for good), wander (walking the sill, in no hurry), approach (it has\n-- seen the spider and walks up to it), attend (it stands facing the spider, close), pair (the pause together once the courtship meter is full), leaving\n-- (walking to the edge: driven off, the evening, or after mating). The courtship meter lives here (m.meter, 0 to 1) and is the player's to fill.\n--\n-- The snapshot `s` (the player's place and what it is doing, and the day) is built by the caller each tick; Life/Mating.tick does it for the game and\n-- adds `mayArrive`, which says whether the cycle wants a mate on the sill now.\nlocal Rules = require(script.Parent.Parent.Data.MatingRules)\nlocal PreyMath = require(script.Parent.Parent.Prey.PreyMath)\nlocal PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)\nlocal WorldMap = require(script.Parent.Parent.World.WorldMap)\nlocal Hut = require(script.Parent.Parent.World.Hut)\n\nlocal Mate = {}\n\n-- ROBLOX-117: where the mate arrives (and its region) and where it leaves by: the sill's east end in the test garden (Data/MatingRules; no region, as before), the hut\n-- garden's path where it comes in from round the hut's east end in the preserve (World/Hut.CREATURES); and the regions it roams there (Hut.ROAM).\nfunction Mate.arriveAt(): (Vector3, string?)\n\tif WorldMap.world() == \"preserve\" then return Hut.CREATURES.mate.at, Hut.CREATURES.mate.region end\n\treturn Rules.arriveAt, nil\nend\nfunction Mate.exitAt(): Vector3\n\tif WorldMap.world() == \"preserve\" then return Hut.CREATURES.mate.exit end\n\treturn Rules.exitAt\nend\nfunction Mate.roam(): { [string]: boolean }?\n\tif WorldMap.world() == \"preserve\" then return Hut.ROAM end\n\treturn nil\nend\n-- A record of another world's mate (a rest put back in the other world): it is not here.\nfunction Mate.misplaced(m: any): boolean\n\tlocal _, region = Mate.arriveAt()\n\tif region == nil then return m.region ~= nil end\n\treturn type(m.region) ~= \"string\" or WorldMap.region(m.region) == nil\nend\n\nlocal STATES: { [string]: boolean } = { away = true, wander = true, approach = true, attend = true, pair = true, leaving = true }\nlocal REASONS: { [string]: boolean } = { [\"\"] = true, driven = true, dusk = true, rest = true, mated = true, sex = true, rejected = true, cut = true }\n-- ROBLOX-106: the courtship's record while it goes on, in the standard rules (Mate.track): seconds of the court, seconds courting well, the distance summed over those,\n-- seconds near it but not facing it, the breaks, and whether it was courting well last tick. All optional (a record from before has none).\nlocal COURT = { \"court_t\", \"court_ok\", \"court_near\", \"court_away\", \"court_breaks\" }\nMate.STATES = STATES\n\nlocal function finite(x: any): boolean\n\treturn type(x) == \"number\" and x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal function vec3(v: any): boolean\n\treturn (typeof(v) == \"Vector3\" or type(v) == \"table\") and finite(v.X) and finite(v.Y) and finite(v.Z) and v.Magnitude <= 1000\nend\n\nfunction Mate.new(): any\n\tlocal at, region = Mate.arriveAt()\n\tlocal m = {\n\t\tstate = \"away\", position = at, previous = at, up = Vector3.yAxis, heading = -Vector3.xAxis,\n\t\tleg = 0, elapsed = 0, meter = 0, lost = 0, sex = \"male\", scale = 1, reason = \"\", scene = false,\n\t}\n\tif region ~= nil then (m :: any).region = region end\n\treturn m\nend\n\n-- How long the pair are together before the mate leaves: a male mate for the first three beats of the scene, a female mate through all four.\nfunction Mate.pairLength(m: any): number\n\treturn if m.sex == \"female\" then Rules.stayPairSeconds else Rules.pairSeconds\nend\n\n-- The scene's clock in seconds (0 to Rules.sceneSeconds) while the mating scene plays, or nil when it does not.\nfunction Mate.sceneTime(m: any): number?\n\tif m == nil or m.scene ~= true then return nil end\n\tif m.state == \"pair\" then return m.elapsed end\n\tif m.state == \"leaving\" then return Mate.pairLength(m) + m.elapsed end\n\treturn nil\nend\n\nfunction Mate.opposite(sex: string): string\n\treturn if sex == \"male\" then \"female\" else \"male\"\nend\n\n-- The size of this mate relative to the played spider's look: a male slimmer and smaller, a female larger, each varying a little by a seeded draw from its\n-- number (the same world, the same mate: the same size, on any return to a rest).\nfunction Mate.scaleFor(seed: number, n: number, sex: string): number\n\tlocal g = PreyRandom.new((seed * 73856093 + n * 19349663 + 5821) % 2147483647)\n\tg:next()\n\tlocal u = g:next()\n\treturn (Rules.scale[sex] or 1) * (1 + (u - 0.5) * 2 * Rules.scaleSpread)\nend\n\n-- On the sill (anything but away).\nfunction Mate.present(m: any): boolean\n\treturn m ~= nil and m.state ~= \"away\"\nend\n\n-- Walking, at the rival's pace; or standing (the courtship states, a wasp visit).\nfunction Mate.walking(m: any): boolean\n\treturn m.state == \"wander\" or m.state == \"approach\" or m.state == \"leaving\"\nend\n\n-- Can the player court it now? It is on the sill and not on its way out or together already.\nfunction Mate.courtable(m: any): boolean\n\treturn m ~= nil and (m.state == \"wander\" or m.state == \"approach\" or m.state == \"attend\")\nend\n\n-- The mating scene is playing, or the pair are together (ROBLOX-91: the rival is paused for it, and so is the arrival of a new one).\nfunction Mate.sceneActive(m: any): boolean\n\treturn m ~= nil and (m.scene == true or m.state == \"pair\")\nend\n\n-- Is the player courting it now (ROBLOX-91)? It can be courted and the courtship meter is rising or falling (it is not empty), or the spider is within courting range of it\n-- (Rules.nearWu). The rival keeps away from a courting pair: Predator/RivalSpider pauses it, like the wasp's visit, so a lunge cannot land on a spider standing still for the meter.\nfunction Mate.courting(m: any, position: Vector3): boolean\n\tif m == nil or not Mate.courtable(m) then return false end\n\treturn m.meter > 0 or (m.position - position).Magnitude <= Rules.nearWu\nend\n\nlocal function clearCourt(m: any)\n\tfor _, k in COURT do m[k] = nil end\n\tm.court_on = nil\nend\n\nlocal function leave(m: any, reason: string)\n\tm.state, m.elapsed, m.meter, m.reason, m.lost, m.scene = \"leaving\", 0, 0, reason, 0, false\n\tclearCourt(m)\n\tm.cut = nil\nend\n\n-- ROBLOX-106: the mate refuses the spider (`reason` \"rejected\") or flees a rival cutting in (\"cut\"): out of the pair, off the sill for the day, as a driven-off mate.\nfunction Mate.refuse(m: any, reason: string)\n\tleave(m, reason)\nend\n\n-- ROBLOX-106: one tick of the courtship's record (the standard rules; Mate.step calls it when the snapshot says `nature`). `ok`: courting well this tick (close, in sight,\n-- facing, still); `facing`; `dist` to the spider. The record starts with the court and is cleared when the meter is empty and the spider is not courting.\nfunction Mate.track(m: any, ok: boolean, facing: boolean, dist: number, dt: number)\n\tif not ok and m.meter <= 0 then\n\t\tif m.court_t ~= nil then clearCourt(m) end\n\t\treturn\n\tend\n\tif m.court_t == nil then\n\t\tfor _, k in COURT do m[k] = 0 end\n\t\tm.court_on = false\n\tend\n\tm.court_t += dt\n\tif ok then\n\t\tm.court_ok += dt\n\t\tm.court_near += dist * dt\n\telse\n\t\tif m.court_on == true then m.court_breaks += 1 end\n\t\tif dist <= Rules.nearWu and not facing then m.court_away += dt end\n\tend\n\tm.court_on = ok\nend\n\n-- ROBLOX-106: the courtship's quality, 0 to 1 (MatingRules.game), from its record: breaks, distance, facing and length. 1 for a mate with no record.\nfunction Mate.quality(m: any): number\n\tlocal g = Rules.game\n\tif m.court_t == nil or m.court_t <= 0 then return 1.0 end\n\tlocal still = 1 / (1 + g.breakCost * (m.court_breaks or 0))\n\tlocal mean = if (m.court_ok or 0) > 1e-6 then m.court_near / m.court_ok else Rules.attendWu\n\tlocal near = 1 - g.farCost * math.clamp((mean - Rules.attendWu) / (Rules.nearWu - Rules.attendWu), 0, 1)\n\tlocal face = 1 - g.awayCost * math.clamp((m.court_away or 0) / m.court_t, 0, 1)\n\tlocal long = math.clamp(Rules.courtSeconds * 1.5 / m.court_t, g.longFloor, 1)\n\treturn still * near * face * long\nend\n\nlocal function gone(m: any)\n\tm.state, m.elapsed, m.meter, m.lost, m.scene = \"away\", 0, 0, 0, false\n\tclearCourt(m)\n\tm.cut = nil\nend\n\n-- The pause is over (its time, or a rest during it): it leaves, mated. A male mate's walk off the sill is still the scene's last beat.\nlocal function parted(m: any)\n\tleave(m, \"mated\")\n\tm.scene = m.sex ~= \"female\" and Rules.sceneSeconds > Rules.pairSeconds\nend\n\n-- The player skips the scene (a jump or cancel after Rules.skipAfter seconds of it; `force` for a wasp visit, which cannot wait): the pair part at once and the mate\n-- walks off. Returns \"mated\" for a pause cut short, and \"\" when there is nothing to part (a male mate already walking just ends the scene's last beat).\nfunction Mate.skip(m: any, force: boolean?): string\n\tif m == nil or m.scene ~= true then return \"\" end\n\tif m.state == \"pair\" then\n\t\tif force ~= true and m.elapsed < Rules.skipAfter - 1e-9 then return \"\" end\n\t\tleave(m, \"mated\")\n\t\treturn \"mated\"\n\tend\n\tif m.state == \"leaving\" and (force == true or Mate.sceneTime(m) :: number >= Rules.skipAfter - 1e-9) then m.scene = false end\n\treturn \"\"\nend\n\n-- Whether the player is facing it: the mate within Rules.faceDeg of where the player looks, in the plane the player stands on.\nfunction Mate.facing(m: any, s: any): boolean\n\tlocal delta = m.position - s.position\n\tlocal up = s.up or Vector3.yAxis\n\tlocal flat = delta - up * delta:Dot(up)\n\tif flat.Magnitude < 0.05 then return true end\n\treturn s.heading:Dot(flat.Unit) >= math.cos(math.rad(Rules.faceDeg))\nend\n\n-- The conditions of courting this tick: close, in sight, facing it, standing still; `dance` is whether the display the peacock spider owes is being given\n-- (always true for a spider that owes none).\nfunction Mate.conditions(m: any, s: any, sees: boolean): (boolean, boolean)\n\tlocal dist = (m.position - s.position).Magnitude\n\tlocal still = s.grounded ~= false and not s.moving and not s.airborne and not s.onLine\n\tlocal ok = dist <= Rules.nearWu and sees and Mate.facing(m, s) and still\n\tlocal dance = (not s.needsDance) or s.dancing == true\n\treturn ok, dance\nend\n\n-- One fixed tick. Returns the event of this tick: \"\" (nothing), \"arrived\", \"noticed\" (it has seen the spider), \"driven\" (struck at or jumped at: it\n-- leaves for the day), \"courted\" (the meter is full: they are together), \"mated\" (the pause is over: it leaves) or \"gone\" (it is off the sill; m.reason\n-- says why: driven, dusk, rest, mated or sex). The mate does not move itself: the drive does (MateDrive); a mate with no drive stands where it is put.\nfunction Mate.step(m: any, dt: number, s: any): string\n\tif dt <= 0 or dt ~= dt then return \"\" end\n\tdt = math.min(dt, 0.05)\n\tm.previous = m.position\n\t-- (ROBLOX-117) another world's mate is not here: away, and it comes again where this world's does\n\tif m.state ~= \"away\" and m.scene ~= true and Mate.misplaced(m) then gone(m) end\n\tlocal st = m.state\n\tif st == \"away\" then\n\t\tif not s.mayArrive or s.day < Rules.firstDay or s.hour < Rules.arriveHour or s.hour >= Rules.arriveUntil then return \"\" end\n\t\tif s.resting or s.wasp then return \"\" end\n\t\tlocal at, region = Mate.arriveAt()\n\t\tif (s.position - at).Magnitude < Rules.arriveDistance then return \"\" end\n\t\tm.state, m.elapsed, m.meter, m.lost, m.reason = \"wander\", 0, 0, 0, \"\"\n\t\tm.position, m.previous, m.up, m.heading, m.leg = at, at, Vector3.yAxis, -Vector3.xAxis, (s.day or 0) * 7\n\t\tif region ~= nil then m.region = region elseif m.region ~= nil then m.region = nil end\n\t\treturn \"arrived\"\n\tend\n\t-- The player rests: it is gone without being seen to go. (A pair that is together finishes first: the mating is not cut short.)\n\tif s.resting then\n\t\tif st == \"pair\" then\n\t\t\tparted(m)\n\t\t\treturn \"mated\"\n\t\tend\n\t\tgone(m)\n\t\tm.reason = if st == \"leaving\" and m.reason == \"mated\" then \"mated\" else \"rest\"\n\t\treturn \"gone\"\n\tend\n\t-- A wasp visit holds everything still (like the rival): no time passes for it and the meter is not touched.\n\tif s.wasp then return \"\" end\n\tm.elapsed += dt\n\tlocal delta = s.position - m.position\n\tlocal dist = delta.Magnitude\n\tif st == \"leaving\" then\n\t\tif m.scene == true and Mate.pairLength(m) + m.elapsed >= Rules.sceneSeconds then m.scene = false end -- (the scene's last beat is over)\n\t\tlocal out = (m.position - Mate.exitAt())\n\t\tif m.elapsed >= Rules.leaveSeconds or Vector3.new(out.X, 0, out.Z).Magnitude <= Rules.exitRadius then\n\t\t\tgone(m)\n\t\t\treturn \"gone\"\n\t\tend\n\t\treturn \"\"\n\tend\n\tif st == \"pair\" then\n\t\tif m.elapsed >= Mate.pairLength(m) then\n\t\t\tparted(m)\n\t\t\treturn \"mated\"\n\t\tend\n\t\treturn \"\"\n\tend\n\t-- The player became the same sex as the mate (the spider was changed in the Settings): it has no business here.\n\tif s.sex ~= nil and s.sex == m.sex then\n\t\tleave(m, \"sex\")\n\t\treturn \"\"\n\tend\n\t-- The evening, or the hours before the morning (only a restored record can have it here at night).\n\tif s.hour >= Rules.leaveHour or s.hour < Rules.arriveHour then\n\t\tleave(m, \"dusk\")\n\t\treturn \"\"\n\tend\n\t-- A jump at it, or a strike at it: driven off for the day. It is never caught.\n\tlocal struck = false\n\tif s.striking and not s.holding and s.previous ~= nil then\n\t\tlocal _, d = PreyMath.sweepClosest(s.previous, s.position, m.previous, m.position)\n\t\tstruck = d < Rules.strikeWu\n\tend\n\tif struck or (s.airborne and dist < Rules.jumpAtWu) then\n\t\tleave(m, \"driven\")\n\t\treturn \"driven\"\n\tend\n\t-- What it sees: the drive's decision (ten times a second, at any height) or, with no drive, distance and the sight query.\n\tlocal D = s.drive\n\tlocal sees: boolean\n\tif D then sees = D.sees == true else sees = dist < 8 and not (s.blocked ~= nil and s.blocked(m.position, s.position)) end\n\tif s.safe then sees = false end -- the retreat is private: it neither notices nor courts a spider in the crack\n\tlocal event = \"\"\n\tif st == \"wander\" then\n\t\tif sees then\n\t\t\tm.state, m.lost = \"approach\", 0\n\t\t\tevent = \"noticed\"\n\t\tend\n\telse\n\t\tif sees then m.lost = 0 else m.lost += dt end\n\t\tif m.lost >= Rules.loseSeconds or dist > Rules.loseWu * 3 then\n\t\t\tm.state, m.lost = \"wander\", 0\n\t\telseif st == \"approach\" and dist <= Rules.attendWu then\n\t\t\tm.state = \"attend\"\n\t\telseif st == \"attend\" and dist > Rules.loseWu then\n\t\t\tm.state = \"approach\"\n\t\tend\n\tend\n\t-- The meter.\n\tlocal ok, dance = Mate.conditions(m, s, sees)\n\tif s.nature == true then Mate.track(m, ok, Mate.facing(m, s), dist, dt) end -- (ROBLOX-106)\n\tif ok and dance then\n\t\tm.meter = math.min(1, m.meter + dt / Rules.courtSeconds)\n\telseif not ok then\n\t\tm.meter = math.max(0, m.meter - dt * Rules.decayPerSecond)\n\tend\n\tif m.meter >= 1 - 1e-9 then\n\t\tm.meter, m.state, m.elapsed, m.scene = 1, \"pair\", 0, true\n\t\treturn \"courted\"\n\tend\n\treturn event\nend\n\n-- What the spider's senses make of it: a moving thing on the sill, like the rival and unlike prey (never a target).\nfunction Mate.percept(m: any): any\n\tif m == nil or m.state == \"away\" then return nil end\n\treturn { id = \"mate_spider\", position = m.position, radius = 0.4, velocity = (m.position - m.previous) * 60, maxCategory = \"movement\" }\nend\n\n-- Whether a record is good (nil is: a life that has had no mate). It is on the sill, never in the crack, when it is on the sill. ROBLOX-94: `region` is the region it\n-- belongs to (the sill's unless given): where it may stand is that region's bounds, outside that region's retreats.\nfunction Mate.valid(m: any, region: string?): boolean\n\tif m == nil then return true end\n\tif type(m) ~= \"table\" or not STATES[m.state] then return false end\n\tfor _, k in { \"elapsed\", \"lost\" } do\n\t\tlocal n = m[k]\n\t\tif n ~= nil and (not finite(n) or n < 0) then return false end\n\tend\n\tif m.meter ~= nil and (not finite(m.meter) or m.meter < 0 or m.meter > 1) then return false end\n\tif m.leg ~= nil and (not finite(m.leg) or m.leg < 0 or m.leg > 1e9 or m.leg % 1 ~= 0) then return false end\n\tif m.sex ~= nil and m.sex ~= \"male\" and m.sex ~= \"female\" then return false end\n\tif m.scale ~= nil and (not finite(m.scale) or m.scale < 0.5 or m.scale > 2) then return false end\n\tif m.reason ~= nil and (type(m.reason) ~= \"string\" or not REASONS[m.reason]) then return false end\n\tif m.scene ~= nil and type(m.scene) ~= \"boolean\" then return false end\n\t-- (ROBLOX-106: the courtship's record and the rival's level, optional)\n\tfor _, k in COURT do\n\t\tlocal n = m[k]\n\t\tif n ~= nil and (not finite(n) or n < 0 or n > 1e6) then return false end\n\tend\n\tif m.court_breaks ~= nil and m.court_breaks % 1 ~= 0 then return false end\n\tif m.court_on ~= nil and type(m.court_on) ~= \"boolean\" then return false end\n\tif m.cut ~= nil and (not finite(m.cut) or m.cut < 0 or m.cut > 1) then return false end\n\tlocal atRest = m.state == \"away\" -- (the scene is the pause, or the walk off after it: never away)\n\tif m.scene == true and (atRest or not (m.state == \"pair\" or (m.state == \"leaving\" and m.reason == \"mated\"))) then return false end -- (the scene is the pause, or the walk off after it)\n\tfor _, k in { \"position\", \"previous\", \"heading\", \"up\" } do\n\t\tif m[k] ~= nil and not vec3(m[k]) then return false end\n\tend\n\tif m.up ~= nil and math.abs(m.up.Magnitude - 1) > 0.05 then return false end\n\t-- (ROBLOX-117: `region`, optional, names a region; one this world has not is another world's mate, Mate.misplaced, and its place is not looked at here)\n\tif m.region ~= nil and (type(m.region) ~= \"string\" or #m.region < 1 or #m.region > 64) then return false end\n\tif not atRest then\n\t\tlocal p, id = m.position, region or m.region or WorldMap.HOME\n\t\tif p == nil or (WorldMap.region(id) ~= nil and (not WorldMap.inBounds(p, id) or WorldMap.inRetreat(Vector3.new(p.X, p.Y, p.Z), id) ~= nil)) then return false end\n\tend\n\treturn true\nend\n\nreturn Mate\n",18742,2058698073},{"Shared/Predator/MateDrive","--!strict\n-- The mate's legs (ROBLOX-79): the rival's own drive (Predator/RivalDrive: a SpiderMotor over the whole sill, the route graph, the keep-out around the\n-- retreat) given a record in the rival's vocabulary. RivalDrive and RivalRoute are used as they are and are not changed; this module only translates:\n--   the mate wanders       -> the rival patrols (about 100 places over every face, in a fixed order by the leg number)\n--   the mate approaches    -> the rival stalks (toward where it sees the spider; it is Mate.step that stops it at attendWu)\n--   the mate attends, pairs-> the rival winds up (it stands, facing the spider)\n--   the mate leaves        -> a patrol whose one place is the exit (Data/MatingRules.exitAt)\n--   a wasp visit, or away  -> recover (it stands) / dormant (it is not on the sill)\n-- Nothing is kept here that cannot be made again from life.mate: the motor stands where the record says (the drive puts it there when the two differ,\n-- which is also how a returned rest works). `sees` is the drive's last decision about the spider, which Mate.step reads as s.drive.sees.\n-- ROBLOX-117: in the preserve the mate roams the hut garden's regions as the rival does (`roam`, RivalDrive): its record's `region` goes to and from the proxy, and\n-- the exit it leaves by is the waypoint of the region it is in nearest the world's exit (Predator/Mate.exitAt).\nlocal RivalDrive = require(script.Parent.RivalDrive)\nlocal Mate = require(script.Parent.Mate)\n\nlocal MateDrive = {}\nMateDrive.__index = MateDrive\n\nlocal MAP: { [string]: string } = {\n\taway = \"dormant\", wander = \"patrol\", approach = \"stalk\", attend = \"windup\", pair = \"windup\", leaving = \"patrol\",\n}\n\n-- `motor`: a SpiderMotor made for the mate; `blocked(a, b)`: something opaque between the points (the sight query). ROBLOX-94: `region` (the sill's unless given) is the\n-- region it walks in (RivalDrive.new).\n-- The waypoint of the drive's region nearest the exit, on a floor.\nlocal function exitOf(drive: any): any\n\tlocal exit: any = nil\n\tlocal best = math.huge\n\tlocal at = Mate.exitAt()\n\tfor _, w in drive.waypoints do\n\t\tlocal d = (w.pos - at).Magnitude\n\t\tif w.up.Y > 0.5 and d < best then exit, best = w, d end\n\tend\n\treturn exit\nend\n\nfunction MateDrive.new(motor: any, blocked: (Vector3, Vector3) -> any, region: string?, roam: { [string]: boolean }?): any\n\tlocal drive = RivalDrive.new(motor, blocked, region, roam)\n\treturn setmetatable({\n\t\tdrive = drive, exit = exitOf(drive), exitRegion = drive.region, leaving = false, sees = false, player = {},\n\t\tproxy = { state = \"dormant\", position = motor.pos, previous = motor.pos, up = motor.up, heading = motor.heading, origin = motor.pos, leg = 0, elapsed = 0, notice = 0 },\n\t}, MateDrive)\nend\n\nfunction MateDrive.destroy(self: any)\n\tself.drive:destroy()\nend\n\n-- One fixed tick, after Mate.step. `s` is the same snapshot Mate.step was given (it has the player's `up` and `grounded` as RivalDrive needs).\nfunction MateDrive.update(self: any, mate: any, dt: number, s: any)\n\tlocal proxy = self.proxy\n\tlocal state = mate.state\n\tlocal mapped = MAP[state] or \"dormant\"\n\tif s.wasp and state ~= \"away\" then mapped = \"recover\" end\n\tproxy.state = mapped\n\tproxy.position, proxy.up, proxy.heading, proxy.leg = mate.position, mate.up or Vector3.yAxis, mate.heading, mate.leg or 0\n\tproxy.region = mate.region\n\tif self.exitRegion ~= (mate.region or self.drive.region) then\n\t\t-- (ROBLOX-117: the region changed under it: the exit is this region's)\n\t\tif mate.region ~= nil then self.drive:useRegion(mate.region) end\n\t\tself.exit, self.exitRegion, self.leaving = exitOf(self.drive), self.drive.region, false\n\tend\n\t-- Leaving: the one place it goes to is the exit; entering the state sets it once.\n\tif state == \"leaving\" then\n\t\tif not self.leaving and self.exit ~= nil and mapped == \"patrol\" then\n\t\t\tself.drive:_setGoal(self.exit, \"patrol\")\n\t\t\tself.leaving = true\n\t\tend\n\telse\n\t\tself.leaving = false\n\tend\n\t-- Courtship/scene flags keep the rival away from this pair. They must not\n\t-- blind the mate to its own partner. Preserve retreat, rest, wasp and sight\n\t-- restrictions in a reused private snapshot; never mutate the caller's table.\n\tlocal player = self.player\n\ttable.clear(player)\n\tfor k,v in s do player[k]=v end\n\tplayer.courting, player.scene = nil, nil\n\tself.drive:update(proxy, dt, player)\n\tmate.position, mate.up, mate.heading, mate.leg = proxy.position, proxy.up, proxy.heading, proxy.leg\n\tif proxy.region ~= nil then mate.region = proxy.region end\n\tif self.drive.region ~= self.exitRegion then self.exit, self.exitRegion = exitOf(self.drive), self.drive.region end\n\tself.sees = self.drive.sees == true and state ~= \"away\"\nend\n\nreturn MateDrive\n",4673,600585636},{"Shared/Predator/RivalDisplay","--!strict\n-- The male rival's contest display (ROBLOX-127): how a male jumping spider meets another spider, drawn on top of the rival's rules. Pure, Vector3-free and\n-- display only: nothing here moves the rival, its collider, its senses, its timing or any outcome (Predator/RivalSpider and RivalDrive decide all of that as\n-- before); SpiderRig reads the pose (look.contest) and the client hands it the rival's state each frame.\n--\n-- What the sources describe (DOC): male contests open at a distance with the males facing each other, the body raised and legs I held up and forward (Phidippus\n-- clarus, Elias et al. 2008, PMC2598435: a hunched posture, the front legs curled in front, then approaches or retreats with legs I stretched out); in Cosmophasis\n-- umbratica (Lim & Li 2004) the males close by short skittering with legs I raised in two positions and the chelicerae held open, the basal segments 30 to 90 degrees\n-- apart, lunge, and grapple (hooking and pushing down each other's legs, locked chelicerae) only in the contests that go that far; the one pushed back, and in a\n-- mismatched pair the smaller, decamps (both papers; in P. clarus the bigger male mostly won because its rival retreated). Phidippus males also zigzag in display\n-- (Edwards 1981, Psyche 88:199, of courting P. mystaceus). The game's ritual, mapped onto the rival's states (ART: which state shows which act, every number):\n--   \"faceoff\"  stalking within FACE_WU of the spider: body raised, legs I up and forward, palps up, the chelicerae a little open, and stop-and-go sideways skitters\n--              (the zigzag: the drawn body steps a little to one side or the other in seeded bursts and pauses; the simulation's path is the drive's, untouched)\n--   \"spread\"   stalking within SPREAD_WU, and the windup: legs I high and spread wide, the chelicerae open, a tremor in the raised legs, the skitters\n--   \"grapple\"  the lunge (the escalation, when neither has backed down): legs I forward and down to hook, the chelicerae wide\n--   \"retreat\"  recovering after the spider got clear of its lunge, sprang clear of the spider's strike, bit back, or tore free: legs I lowered, the body low and turned a\n--              little away, when it is the smaller of the two; the bigger holds its ground, legs I half up (`hold`)\n--   \"none\"     anything else (patrol, far off, held, carried, gone): the pose eases out and the motor's legs are the rig's again\n-- The skitters' rhythm and the side the retreat turns to are drawn from the rival's own seeded stream (the world's seed, the day, its contests and its patrol\n-- leg, all kept in its record, and the display's own count of bouts): the same rival in the same moment shows the same display, and a return to a rest rerolls nothing\n-- of the simulation (the display keeps no record; it starts again from rest).\nlocal PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)\n\nlocal RivalDisplay = {}\n\nexport type Pose = {\n\tphase: string, presence: number,\n\trear: number, legs: number, palps: number, yaw: number, sweep: number, tremor: number, -- (the tarantula's pose's fields, as SpiderRig reads them)\n\treach: number, hook: number, spread: number, lateral: number, lower: number,\n}\n\nRivalDisplay.FACE_WU = 6.0 -- studs: within this, a stalking rival faces off (its sight is 8)\nRivalDisplay.SPREAD_WU = 4.4 -- within this, the full display (the windup begins at 3.2, RivalRules.reachWu)\nRivalDisplay.RETREAT_SECONDS = 3.0 -- as long as the rival's recover lasts\nRivalDisplay.RISE = 1 / 0.35 -- how fast a level goes up (per second) and comes down\nRivalDisplay.FALL = 1 / 0.5\nRivalDisplay.SKITTER = { step = { 0.18, 0.42 }, pause = { 0.25, 0.70 }, amplitude = 0.11, yawDeg = 12 } -- a burst's seconds, a pause's, how far the drawn body steps (studs at scale 1), the turn with it\nRivalDisplay.REAR_DEG = 9 -- the prosoma raised in the face-off and the display\nRivalDisplay.PALPS_DEG = 16\nRivalDisplay.TURN_AWAY_DEG = 28 -- the retreat's turn\nRivalDisplay.TREMOR_HZ = 7\n\n-- The levels each phase asks for: legs I raised (legs), how high and spread (reach), hooked (hook), the chelicerae (spread), the body raised (rear, a share of REAR_DEG),\n-- the palps (palps, a share of PALPS_DEG), the crouch (lower) and whether the skitters run (skitter).\nRivalDisplay.TARGETS = {\n\tnone = { legs = 0, reach = 0, hook = 0, spread = 0, rear = 0, palps = 0, lower = 0, skitter = 0 },\n\tfaceoff = { legs = 0.85, reach = 0, hook = 0, spread = 0.35, rear = 0.8, palps = 0.6, lower = 0, skitter = 1 },\n\tspread = { legs = 1, reach = 1, hook = 0, spread = 1, rear = 1, palps = 1, lower = 0, skitter = 1 },\n\tgrapple = { legs = 1, reach = 0, hook = 1, spread = 1, rear = 0.3, palps = 0.4, lower = 0, skitter = 0 },\n\tretreat = { legs = 0, reach = 0, hook = 0, spread = 0, rear = 0, palps = 0, lower = 1, skitter = 0 },\n\thold = { legs = 0.55, reach = 0, hook = 0, spread = 0.3, rear = 0.5, palps = 0.4, lower = 0, skitter = 0 },\n} :: { [string]: { [string]: number } }\n\n-- The rival's events after which it backs off (RivalSpider.step's and RivalGrip.step's): its lunge missed, the spider sprang clear or bit back, or it tore free.\nRivalDisplay.BACKS_OFF = { missed = true, sprang = true, counter = true, tore = true, touch = true } :: { [string]: boolean }\n\nexport type State = {\n\tphase: string, t: number, bout: number, rng: any?, key: string,\n\tskitterSide: number, skitterFrom: number, skitterTo: number, skitterT: number, skitterLeft: number, moving: boolean,\n\tretreatLeft: number, awaySide: number,\n\tlevels: { [string]: number }, lateral: number, yaw: number, presence: number,\n\tpose: Pose,\n}\n\nfunction RivalDisplay.new(): State\n\treturn {\n\t\tphase = \"none\", t = 0, bout = 0, rng = nil, key = \"\",\n\t\tskitterSide = 1, skitterFrom = 0, skitterTo = 0, skitterT = 0, skitterLeft = 0, moving = false,\n\t\tretreatLeft = 0, awaySide = 1,\n\t\tlevels = { legs = 0, reach = 0, hook = 0, spread = 0, rear = 0, palps = 0, lower = 0, skitter = 0 },\n\t\tlateral = 0, yaw = 0, presence = 0,\n\t\tpose = { phase = \"none\", presence = 0, rear = 0, legs = 0, palps = 0, yaw = 0, sweep = 0, tremor = 0, reach = 0, hook = 0, spread = 0, lateral = 0, lower = 0 },\n\t}\nend\n\n-- The phase the rival's state asks for. `i`: state (the rival's), distance (studs, to the spider), event (this tick's, \"\" for none), smaller (the rival is the smaller\n-- of the two, by drawn body length).\nfunction RivalDisplay.phaseFor(d: State, i: any): string\n\tlocal s = i.state\n\tif s == \"lunge\" then return \"grapple\" end\n\tif d.retreatLeft > 0 and (s == \"recover\" or s == \"patrol\") then return if i.smaller then \"retreat\" else \"hold\" end\n\tif s == \"windup\" then return \"spread\" end\n\tif s == \"stalk\" and type(i.distance) == \"number\" then\n\t\tif i.distance <= RivalDisplay.SPREAD_WU then return \"spread\" end\n\t\tif i.distance <= RivalDisplay.FACE_WU then return \"faceoff\" end\n\tend\n\treturn \"none\"\nend\n\n-- The seeded stream of one bout of display (a face-off that begins after none): the world's seed, the day, the rival's contests and patrol leg, the bout.\nfunction RivalDisplay.stream(seed: number, day: number, contests: number, leg: number, bout: number): any\n\treturn PreyRandom.mixed(seed, day, contests, leg, bout, 127)\nend\n\nlocal function smooth(x: number): number\n\tlocal c = math.clamp(x, 0, 1)\n\treturn c * c * (3 - 2 * c)\nend\n\n-- One frame. `dt` is the frame's simulated time (0 when paused: nothing moves). `i` = { state, distance, event, smaller, seed, day, contests, leg, reduced }.\n-- Returns the pose (the same table each time) for rig.threat.\nfunction RivalDisplay.step(d: State, dt: number, i: any): Pose\n\tdt = math.max(0, dt)\n\tif RivalDisplay.BACKS_OFF[i.event or \"\"] then\n\t\td.retreatLeft = RivalDisplay.RETREAT_SECONDS\n\t\tlocal g = RivalDisplay.stream(i.seed or 0, i.day or 0, i.contests or 0, i.leg or 0, d.bout + 1000)\n\t\td.awaySide = if g:next() < 0.5 then -1 else 1\n\tend\n\td.retreatLeft = math.max(0, d.retreatLeft - dt)\n\tlocal phase = RivalDisplay.phaseFor(d, i)\n\tif phase ~= d.phase then\n\t\tif (phase == \"faceoff\" or phase == \"spread\") and (d.phase == \"none\" or d.phase == \"retreat\" or d.phase == \"hold\") then\n\t\t\t-- a new bout of display: its own stream, from where the rival is in its record\n\t\t\td.bout += 1\n\t\t\td.rng = RivalDisplay.stream(i.seed or 0, i.day or 0, i.contests or 0, i.leg or 0, d.bout)\n\t\t\td.skitterLeft, d.moving = 0, false\n\t\tend\n\t\td.phase = phase\n\tend\n\td.t += dt\n\tlocal target = RivalDisplay.TARGETS[phase]\n\tfor k, v in target do\n\t\tlocal now = d.levels[k] or 0\n\t\tlocal rate = if v > now then RivalDisplay.RISE else RivalDisplay.FALL\n\t\td.levels[k] = now + math.clamp(v - now, -rate * dt, rate * dt)\n\tend\n\t-- The skitters: a burst to a new side, then a pause; the drawn body steps there and back on the seeded rhythm.\n\tlocal sk = RivalDisplay.SKITTER\n\tif d.levels.skitter > 0 and d.rng ~= nil and not i.reduced then\n\t\td.skitterLeft -= dt\n\t\tif d.skitterLeft <= 0 then\n\t\t\tlocal g = d.rng\n\t\t\tif d.moving then\n\t\t\t\td.moving = false\n\t\t\t\td.skitterFrom = d.skitterTo\n\t\t\t\td.skitterLeft = sk.pause[1] + (sk.pause[2] - sk.pause[1]) * g:next()\n\t\t\telse\n\t\t\t\td.moving = true\n\t\t\t\td.skitterSide = -d.skitterSide\n\t\t\t\td.skitterFrom = d.lateral / sk.amplitude\n\t\t\t\td.skitterTo = d.skitterSide * (0.45 + 0.55 * g:next())\n\t\t\t\td.skitterT = sk.step[1] + (sk.step[2] - sk.step[1]) * g:next()\n\t\t\t\td.skitterLeft = d.skitterT\n\t\t\tend\n\t\tend\n\t\tlocal u = if d.moving and d.skitterT > 0 then smooth(1 - d.skitterLeft / d.skitterT) else 1\n\t\tlocal at = d.skitterFrom + (d.skitterTo - d.skitterFrom) * u\n\t\td.lateral = at * sk.amplitude * d.levels.skitter\n\t\td.yaw = (if d.moving then -d.skitterSide else 0) * math.rad(sk.yawDeg) * d.levels.skitter * math.sin(math.pi * u)\n\telse\n\t\t-- (no skitter: the step eases back to the middle; Reduced Motion has none at all)\n\t\td.lateral = if i.reduced then 0 else d.lateral * math.max(0, 1 - 4 * dt)\n\t\td.yaw = 0\n\tend\n\tlocal away = d.awaySide * math.rad(RivalDisplay.TURN_AWAY_DEG) * d.levels.lower\n\tlocal L = d.levels\n\tlocal presence = math.max(L.legs, L.reach, L.hook, L.spread, L.rear, L.palps, L.lower, math.abs(d.lateral) / RivalDisplay.SKITTER.amplitude)\n\tlocal p = d.pose\n\tp.phase = if presence > 0 then phase else \"none\"\n\tp.presence = presence\n\tp.legs, p.reach, p.hook, p.spread, p.lower = L.legs, L.reach, L.hook, L.spread, L.lower\n\tp.rear = math.rad(RivalDisplay.REAR_DEG) * L.rear\n\tp.palps = math.rad(RivalDisplay.PALPS_DEG) * L.palps\n\tp.yaw = d.yaw + away\n\tp.lateral = d.lateral\n\tp.sweep = 0\n\tp.tremor = if i.reduced then 0 else math.sin(math.pi * 2 * RivalDisplay.TREMOR_HZ * d.t) * L.reach\n\treturn p\nend\n\nreturn RivalDisplay\n",10511,2513657217},{"Shared/Predator/RivalDrive","--!strict\n-- The rival spider's legs (ROBLOX-69): its own SpiderMotor, the player's proven surface-walking motor with the same collider, drives it over\n-- every face of the windowsill. This module is the brain between RivalSpider's state (patrol, stalk, windup, ...) and that motor: it picks the\n-- places to patrol to, plans the seams to cross (RivalRoute), and hands the motor an ordinary TickInput each tick. Decisions (sight, faces,\n-- routes) run every Rules.thinkSeconds, not every tick; the motor itself steps every tick while it walks and every tenth while it stands.\n-- The rival's plain state (RivalSpider) stays the one thing a checkpoint holds: the drive keeps only what can be made again from it. It does\n-- not know the engine: the motor and a sight query are handed in, so the CLI runs it on the box world and Studio on the real sill.\n-- ROBLOX-117 (the preserve's hut garden): a drive told its `roam` (a set of region ids: World/Hut.ROAM) walks from region to region across their flat seams. It walks one\n-- region's graph at a time (RivalRoute.graph of `region`); now and then a patrol leg is a crossing (a seeded draw for the leg, `Drive.crossLeg`) to a seam's point\n-- on the way to a neighbour of the roam, and when it stands there the region becomes the neighbour's (`r.region`, kept in the record) and it walks on in a couple of\n-- studs before it plans again; a stalk follows the spider across a seam the same way. A record's `region` that differs from the drive's (a rest put back, a new\n-- rival) makes the drive the record's. Without `roam` nothing of this happens: the sill's rival and mate are as they were.\nlocal Route = require(script.Parent.RivalRoute)\nlocal Rules = require(script.Parent.Parent.Data.RivalRules)\nlocal WorldMap = require(script.Parent.Parent.World.WorldMap)\nlocal SupportMath = require(script.Parent.Parent.Movement.SupportMath)\nlocal Motor = require(script.Parent.Parent.Movement.SpiderMotor)\nlocal PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)\nlocal Station = require(script.Parent.Parent.World.StationTerritory)\n\nlocal Drive = {}\nDrive.__index = Drive\n\nlocal SEAT = Route.SEAT\nlocal IDLE_EVERY = 10 -- a standing rival re-checks its support every tenth tick\n\nlocal function gcd(a: number, b: number): number\n\twhile b ~= 0 do a, b = b, a % b end\n\treturn a\nend\n\n-- `motor`: a SpiderMotor made for the rival (its own world query and probe). `blocked(a, b)`: something opaque between the points. ROBLOX-94: `region` (the sill's unless\n-- given) is the region it walks in, whose retreats it never enters.\nlocal function graphAndPoints(id: string, incremental: boolean?): (any, { any })\n\tif incremental then\n\t\tRoute.request(id)\n\t\tlocal g = Route.prepared(id)\n\t\treturn g, if g ~= nil then Route.preparedWaypoints(g) else {}\n\tend\n\tlocal g = Route.graph(id)\n\treturn g, g:waypoints()\nend\nfunction Drive.prepare(roam: { [string]: boolean }?, first: string)\n\tlocal ids = {}\n\tif roam ~= nil then for id in roam do table.insert(ids, id) end end\n\ttable.sort(ids)\n\tfor _, id in ids do Route.request(id, false) end\n\tRoute.request(first)\nend\n-- Time limits the cost on slower devices; the secondary work quota also\n-- prevents an unusually fast clock/read from making this an unbounded loop.\nfunction Drive.advance(): (boolean, string?) return Route.advance(2048, .002) end\nfunction Drive.new(motor: any, blocked: (Vector3, Vector3) -> any, region: string?, roam: { [string]: boolean }?, incremental: boolean?): any\n\tlocal id = region or WorldMap.HOME\n\tlocal g, waypoints = graphAndPoints(id, incremental)\n\tlocal stride = 7\n\twhile gcd(stride, math.max(#waypoints, 1)) ~= 1 do stride += 1 end\n\treturn setmetatable({\n\t\tmotor = motor, blocked = blocked, region = id, g = g, waypoints = waypoints, stride = stride, roam = roam, crossing = nil :: any,\n\t\tincremental = incremental == true, preparingCross = false,\n\t\tticks = 0, think = 0.0, face = nil :: number?, route = nil :: { any }?, hop = 1,\n\t\tgoal = nil :: any, goalKey = \"\", prevState = \"dormant\",\n\t\tlastUp = Vector3.yAxis, sees = false, reach = false, remember = false, seen = nil :: Vector3?, seenUp = Vector3.yAxis, lost = 0.0,\n\t\tlegT = 0.0, stuckT = 0.0, stuckAt = nil :: Vector3?, noFaceT = 0.0, safe = nil :: any,\n\t\tspeed = 0.0, wish = Vector3.zero, stats = { thinks = 0, plans = 0, replans = 0, resets = 0, arrivals = 0 },\n\t}, Drive)\nend\n\nfunction Drive.destroy(self: any)\n\tself.motor:destroy()\nend\n\n-- (ROBLOX-117) The drive walks this region's graph from now on: its waypoints, its stride.\nfunction Drive.useRegion(self: any, id: string)\n\tif id == self.region and self.g ~= nil then return end\n\tself.region = id\n\tself.g, self.waypoints = graphAndPoints(id, self.incremental)\n\tlocal stride = 7\n\twhile gcd(stride, math.max(#self.waypoints, 1)) ~= 1 do stride += 1 end\n\tself.stride = stride\n\tself.campList = nil\n\tself.route, self.goal, self.face = nil, nil, nil\nend\n\n-- (ROBLOX-117) A crossing to a neighbour of the roam: the seam point of this region's graph nearest `toward` (or any) on a flat seam to a region of the roam (only\n-- `only`, if given), as a goal { pos, up, face, cross = { to, aim } }; nil when there is none.\nfunction Drive.crossTo(self: any, toward: Vector3?, only: string?): any\n\tself.preparingCross = false\n\tif self.roam == nil then return nil end\n\tlocal best, bestD = nil, math.huge\n\tfor _, pair in self.g:allSeams() do\n\t\tlocal e = pair.edge\n\t\tif (e.flat or Station.contains(self.region)) and self.roam[e.region] and (only == nil or e.region == only) and #e.samples > 0 then\n\t\t\tlocal face = self.g.faces[pair.face]\n\t\t\tfor _, sp in e.samples do\n\t\t\t\tlocal d = if toward ~= nil then (sp - toward).Magnitude else 0\n\t\t\t\tif face ~= nil and (face.normal.Y > 0.9 or Station.contains(self.region)) and not self.g:inKeepOut(sp + face.normal * SEAT) and d < bestD then\n\t\t\t\t\tlocal nextFace=Route.graph(e.region).faces[e.to]\n\t\t\t\t\tlocal across=if e.flat then e.ahead elseif e.convex then -face.normal else face.normal\n\t\t\t\t\tbest, bestD = { pos = sp, up = face.normal, face = pair.face, cross = {\n\t\t\t\t\t\tto = e.region, aim = sp + across * 2.5 + nextFace.normal * SEAT,\n\t\t\t\t\t\tahead=if e.flat then nil else e.ahead, up=face.normal,\n\t\t\t\t\t} }, d\n\t\t\t\tend\n\t\t\tend\n\t\t\tif toward == nil and best ~= nil then break end\n\t\tend\n\tend\n\tif best ~= nil and self.incremental and Route.prepared(best.cross.to) == nil then\n\t\tRoute.request(best.cross.to)\n\t\tself.preparingCross = true\n\t\treturn nil\n\tend\n\treturn best\nend\n\n-- (ROBLOX-117) Whether patrol leg `leg` is a crossing to a neighbour (a stream of its own from the world's seed and the leg's number), and to which: the first of\n-- the neighbours of the roam in a drawn order that has a flat seam.\nDrive.CROSS_CHANCE = 0.4\nfunction Drive.crossLeg(self: any, seed: number, leg: number): any\n\tself.preparingCross = false\n\tif self.roam == nil then return nil end\n\tlocal g = PreyRandom.mixed(seed, leg, 89)\n\tif g:next() >= Drive.CROSS_CHANCE then return nil end\n\tlocal reg = WorldMap.region(self.region)\n\tif reg == nil then return nil end\n\tlocal options: { string } = {}\n\tfor _, n in reg.neighbors do if self.roam[n.id] and table.find(options, n.id) == nil then table.insert(options, n.id) end end\n\tif #options == 0 then return nil end\n\tlocal start = 1 + math.floor(g:next() * #options)\n\tfor k = 0, #options - 1 do\n\t\tlocal w = self:crossTo(nil, options[((start - 1 + k) % #options) + 1])\n\t\tif w ~= nil then return w end\n\t\tif self.preparingCross then return nil end -- retain the same seeded choice until it is ready\n\tend\n\treturn nil\nend\n\nlocal function surfacePointOf(center: Vector3, up: Vector3): Vector3\n\treturn center - up * SEAT\nend\n\nlocal function goalFaceOf(self: any): number\n\treturn if self.goal ~= nil then self.goal.face else -1\nend\n\n-- ROBLOX-106: the places to watch from (Rules.camp.spots on the floor round the crack's mouth), as goals on the sill's faces, outside the keep-out. Made once; none in a\n-- region without a retreat.\nfunction Drive.campPlaces(self: any): { any }\n\tif self.campList ~= nil then return self.campList end\n\tlocal list: { any } = {}\n\tlocal reg = WorldMap.region(self.region)\n\tif reg ~= nil and #reg.retreats > 0 and self.region == WorldMap.HOME then\n\t\tfor _, p in Rules.camp.spots do\n\t\t\tlocal up = Vector3.yAxis\n\t\t\tlocal face = self.g:faceAt(p + up * SEAT, up)\n\t\t\tif face ~= nil and not self.g:inKeepOut(p + up * SEAT) and WorldMap.inRetreat(p + up * SEAT, self.region) == nil then\n\t\t\t\ttable.insert(list, { pos = p, up = up, face = face })\n\t\t\tend\n\t\tend\n\tend\n\tself.campList = list\n\treturn list\nend\n\n-- ROBLOX-106: whether patrol leg `leg` is a watch by the crack, and which place and for how long: a stream of its own from the world's seed and the leg's number.\nfunction Drive.campLeg(self: any, seed: number, leg: number): (any, number)\n\tlocal places = self:campPlaces()\n\tif #places == 0 then return nil, 0 end\n\tlocal g = PreyRandom.mixed(seed, leg, 83)\n\tif g:next() >= Rules.camp.chance then return nil, 0 end\n\tlocal w = places[math.min(#places, 1 + math.floor(g:next() * #places))]\n\tlocal secs = Rules.camp.seconds\n\treturn w, secs[1] + (secs[2] - secs[1]) * g:next()\nend\n\n-- The patrol place for this leg: deterministic from the leg number, spread over every face by a stride that visits all. ROBLOX-106: in the standard rules (`s.nature`, a\n-- drive told it `camps`) a leg may be a watch by the crack instead (Drive.campLeg).\nfunction Drive._pickWaypoint(self: any, r: any, s: any?): any\n\tlocal n = #self.waypoints\n\tif n == 0 then return nil end\n\tif self.camps == true and s ~= nil and s.nature == true then\n\t\tlocal w = self:campLeg(s.seed or 0, r.leg or 0)\n\t\tif w ~= nil then\n\t\t\tself.campHere = true\n\t\t\treturn w\n\t\tend\n\tend\n\tself.campHere = false\n\t-- (ROBLOX-117: in a roam, a leg may be a crossing to a neighbour)\n\tif s ~= nil and self.roam ~= nil then\n\t\tlocal w = self:crossLeg(s.seed or 0, r.leg or 0)\n\t\tif w ~= nil then return w end\n\t\tif self.preparingCross then return nil end\n\tend\n\tfor attempt = 0, 6 do\n\t\tlocal leg = (r.leg or 0) + attempt\n\t\tlocal w = self.waypoints[((leg * self.stride) % n) + 1]\n\t\tif (w.pos + w.up * SEAT - self.motor.pos).Magnitude > 3.0 then\n\t\t\tif attempt > 0 then r.leg = leg end\n\t\t\treturn w\n\t\tend\n\tend\n\treturn nil\nend\n\nfunction Drive._setGoal(self: any, goal: any, key: string)\n\tself.goal, self.goalKey = goal, key\n\tself.route = nil\n\tself.hop = 1\n\tself.legT = 0.0\n\tself.stuckT = 0.0\n\tself.stuckAt = self.motor.pos\nend\n\n-- Plans the seams from here to the goal; false when there is no way (the caller drops that goal).\nfunction Drive._plan(self: any): boolean\n\tlocal goal, motor = self.goal, self.motor\n\tif goal == nil or self.face == nil then return false end\n\tself.stats.plans += 1\n\tlocal hops = self.g:plan(self.face, surfacePointOf(motor.pos, motor.up), goal.face, goal.pos)\n\tself.route, self.hop = hops, 1\n\treturn hops ~= nil\nend\n\n-- The corners rounded: a `via` hop is done once the body is at it.\nfunction Drive._rounded(self: any)\n\tlocal route = self.route :: { any }?\n\tif route == nil then return end\n\twhile self.hop <= #route do\n\t\tlocal h = route[self.hop]\n\t\tif h.via and self.face == h.from and (h.aim - self.motor.pos).Magnitude < 0.4 then self.hop += 1 else break end\n\tend\nend\n\n-- The seams crossed: the face it stands on is the one a seam leads to (or a later one), or it has gone astray and the way is planned again.\n-- Made at each think and at once when the support turns (a wall taken, an edge wrapped), so the next aim is always for the face it is on.\nfunction Drive._hops(self: any)\n\tlocal route = self.route :: { any }?\n\tif route == nil or self.face == nil or self.goal == nil then return end\n\tself:_rounded()\n\tlocal here = route[self.hop]\n\t-- Still on the face the next hop leaves (a corner to round, or a seam to reach): nothing to change.\n\tif here ~= nil and self.face == here.from then return end\n\tfor i = self.hop, #route do\n\t\tif not route[i].via and route[i].face == self.face then\n\t\t\tself.hop = i + 1\n\t\t\tself:_rounded()\n\t\t\treturn\n\t\tend\n\tend\n\tlocal from = if self.hop <= #route then route[self.hop].from else goalFaceOf(self)\n\tif self.face ~= from then\n\t\tself.stats.replans += 1\n\t\tif self.log then self.log(\"replan\", self.face, from, route, self.hop, self.goal) end\n\t\tself.route = nil\n\t\tif not self:_plan() then self.goal = nil end\n\tend\nend\n\n-- One decision: what it sees, where it is, where it is going. Cheap, and made ten times a second, not every tick.\nfunction Drive._think(self: any, r: any, s: any)\n\tlocal motor = self.motor\n\tself.stats.thinks += 1\n\tlocal delta = s.position - r.position\n\tself.sees = not (s.safe or s.resting or s.scene or s.courting or s.wasp) and delta.Magnitude < Rules.sightWu and not self.blocked(r.position, s.position)\n\tif self.sees then\n\t\tself.seen, self.seenUp, self.lost = s.position, s.up or Vector3.yAxis, 0.0\n\telse\n\t\tself.lost += Rules.thinkSeconds\n\tend\n\tself.remember = not self.sees and self.seen ~= nil and self.lost < Rules.rememberSeconds\n\tself.face = if motor.mode == \"attached\" then self.g:faceAt(motor.pos, motor.up) else nil\n\tself.lastUp = motor.up\n\tlocal playerFace = if s.grounded ~= false and s.up ~= nil then self.g:faceAt(s.position, s.up) else nil\n\tself.reach = self.g:adjacent(self.face, playerFace)\n\tself.noFaceT = if self.face == nil and motor.mode == \"attached\" then self.noFaceT + Rules.thinkSeconds else 0.0\n\n\tlocal state = r.state\n\tif state ~= \"patrol\" and state ~= \"stalk\" then\n\t\tself.goal, self.route, self.crossing = nil, nil, nil\n\t\treturn\n\tend\n\t-- (ROBLOX-117) walking in over a seam just crossed: no plan until it stands on the new region's ground, a couple of studs in\n\tif self.crossing ~= nil then\n\t\tself.crossing.t += Rules.thinkSeconds\n\t\tif (self.face ~= nil and (motor.pos - self.crossing.aim).Magnitude < 0.8) or self.crossing.t > 4 then self.crossing = nil else return end\n\tend\n\tif self.face == nil then return end\n\t-- The goal: where it last saw the spider (stalk) or the patrol place of this leg.\n\tif state == \"stalk\" then\n\t\tlocal at = if self.sees then s.position else self.seen\n\t\tlocal up = if self.sees then (s.up or Vector3.yAxis) else self.seenUp\n\t\tif at == nil then return end\n\t\tlocal face = self.g:faceAt(at, up)\n\t\tlocal key = \"stalk\"\n\t\tif face == nil and self.roam ~= nil then\n\t\t\t-- (ROBLOX-117) the spider is over a seam in a neighbour of the roam: the crossing toward it is the goal\n\t\t\tlocal there = WorldMap.at(at)\n\t\t\tif there ~= nil and self.roam[there.id] then\n\t\t\t\tlocal w = self:crossTo(at, there.id)\n\t\t\t\tif w ~= nil and (self.goal == nil or self.goal.cross == nil or self.goal.cross.to ~= there.id) then self:_setGoal(w, \"stalk\") end\n\t\t\tend\n\t\t\tif self.goal == nil or self.goal.cross == nil then return end\n\t\telseif face == nil then return end\n\t\tif self.goal ~= nil and self.goal.cross ~= nil and face == nil then\n\t\t\t-- (keep the crossing)\n\t\telseif self.goal == nil or self.goalKey ~= key or self.goal.face ~= face or (self.goal.pos - surfacePointOf(at, up)).Magnitude > 1.0 then\n\t\t\tself:_setGoal({ pos = surfacePointOf(at, up), up = up, face = face }, key)\n\t\tend\n\telse\n\t\tif self.goal == nil or self.goalKey ~= \"patrol\" then\n\t\t\tlocal w = self:_pickWaypoint(r, s)\n\t\t\tif w == nil then return end\n\t\t\tself:_setGoal(w, \"patrol\")\n\t\tend\n\tend\n\tif self.route == nil then\n\t\tif not self:_plan() then\n\t\t\t-- No way there: drop it (the next leg, or the next think of the stalk).\n\t\t\tif self.goalKey == \"patrol\" then r.leg = (r.leg or 0) + 1 end\n\t\t\tself.goal = nil\n\t\t\treturn\n\t\tend\n\tend\n\tself:_hops()\n\t-- ROBLOX-106: standing its watch is not being stuck, and the leg's time does not run out under it.\n\tif r.camp ~= nil and self.campHere == true and self.goal ~= nil and (self.goal.pos + self.goal.up * SEAT - motor.pos).Magnitude < 0.6 then\n\t\tself.stuckT, self.stuckAt, self.legT = 0.0, motor.pos, 0.0\n\tend\n\t-- Progress: a leg that has taken too long, or no movement for a while, is dropped or planned again.\n\tself.legT += Rules.thinkSeconds\n\tself.stuckT += Rules.thinkSeconds\n\tif self.stuckT >= Rules.stuckSeconds then\n\t\tif self.stuckAt ~= nil and (motor.pos - self.stuckAt).Magnitude < 0.3 and self.goal ~= nil then\n\t\t\tself.stats.resets += 1\n\t\t\tself.route = nil\n\t\t\tif self.goalKey == \"patrol\" then r.leg = (r.leg or 0) + 1; self.goal = nil end\n\t\tend\n\t\tself.stuckT, self.stuckAt = 0.0, motor.pos\n\tend\n\tif self.goalKey == \"patrol\" and self.legT >= Rules.legSeconds and r.camp == nil then\n\t\tr.leg = (r.leg or 0) + 1\n\t\tself.goal = nil\n\tend\nend\n\n-- The motor's input for this tick: where to head. Nil wish: stand.\nfunction Drive._wish(self: any, r: any, s: any): (Vector3, Vector3?)\n\tlocal motor = self.motor\n\tlocal state = r.state\n\tif state == \"windup\" then return Vector3.zero, s.position end\n\t-- (ROBLOX-117) walking in over the seam it has crossed\n\tif (state == \"patrol\" or state == \"stalk\") and self.crossing ~= nil then\n\t\tif self.crossing.ahead and motor.up:Dot(self.crossing.up)>.9 then return SupportMath.tangentDir(self.crossing.ahead,motor.up),nil end\n\t\treturn SupportMath.tangentDir(self.crossing.aim - motor.pos, motor.up), nil\n\tend\n\tif (state ~= \"patrol\" and state ~= \"stalk\") or self.goal == nil or self.route == nil then return Vector3.zero, nil end\n\tlocal route = self.route :: { any }\n\tlocal target: Vector3\n\tself:_rounded()\n\tif self.hop <= #route then\n\t\ttarget = route[self.hop].aim\n\telse\n\t\ttarget = self.goal.pos + self.goal.up * SEAT\n\t\tif (target - motor.pos).Magnitude < 0.6 and self.goal.cross ~= nil then\n\t\t\t-- (ROBLOX-117) at the seam: the neighbour's region is its own from here, and it walks in a little before it plans again\n\t\t\tlocal cross = self.goal.cross\n\t\t\tif self.goalKey == \"patrol\" then r.leg = (r.leg or 0) + 1 end\n\t\t\tself.stats.arrivals += 1\n\t\t\tself:useRegion(cross.to)\n\t\t\tr.region = cross.to\n\t\t\tself.crossing = { aim = cross.aim, t = 0, ahead=cross.ahead, up=cross.up }\n\t\t\tself.stats.crossings = (self.stats.crossings or 0) + 1\n\t\t\treturn SupportMath.tangentDir(cross.aim - motor.pos, motor.up), nil\n\t\tend\n\t\tif (target - motor.pos).Magnitude < 0.6 then\n\t\t\t-- ROBLOX-106: at a watch by the crack it stands its time (Drive.update counts it down) before it takes the next place.\n\t\t\tif self.goalKey == \"patrol\" and self.campHere == true then\n\t\t\t\tif r.camp == nil then\n\t\t\t\t\tself.stats.arrivals += 1\n\t\t\t\t\tlocal _, secs = self:campLeg(s.seed or 0, r.leg or 0)\n\t\t\t\t\tr.camp = secs\n\t\t\t\tend\n\t\t\t\tif r.camp > 0 then return Vector3.zero, nil end\n\t\t\t\tr.camp = nil\n\t\t\t\tr.leg = (r.leg or 0) + 1; self.goal = nil; self.route = nil; self.campHere = false\n\t\t\t\treturn Vector3.zero, nil\n\t\t\tend\n\t\t\t-- Arrived. A patrol takes the next place; a stalk stands where the spider was.\n\t\t\tself.stats.arrivals += 1\n\t\t\tif self.goalKey == \"patrol\" then r.leg = (r.leg or 0) + 1; self.goal = nil; self.route = nil end\n\t\t\treturn Vector3.zero, nil\n\t\tend\n\tend\n\ttarget = self.g:aroundKeepOut(motor.pos, target)\n\treturn SupportMath.tangentDir(target - motor.pos, motor.up), if state == \"stalk\" and self.sees then s.position else nil\nend\n\n-- A rival that has just arrived or been restored: the motor stands where the state says.\nfunction Drive._place(self: any, r: any)\n\tlocal motor = self.motor\n\tmotor:place(r.position, r.up or Vector3.yAxis, r.heading)\n\tself.route, self.goal, self.face = nil, nil, nil\n\tself.stuckAt = motor.pos\n\tself.safe = { pos = motor.pos, up = motor.up, heading = motor.heading }\nend\n\n-- After a lunge it is somewhere in the air or inside the spider: back onto the face it lunged over, or back to where it started.\nfunction Drive._reseat(self: any, r: any)\n\tlocal motor = self.motor\n\tlocal up = r.up or Vector3.yAxis\n\tlocal hit = workspace:Raycast(r.position + up * 0.3, -up * 1.2, motor.params)\n\tif hit ~= nil and motor:attachable(hit) and WorldMap.inRetreat(hit.Position + hit.Normal * SEAT, self.region) == nil then\n\t\tmotor:place(hit.Position + hit.Normal * SEAT, hit.Normal, r.heading)\n\telse\n\t\tlocal at = r.origin\n\t\tmotor:place(at, up, r.heading)\n\tend\n\tself.route, self.goal = nil, nil\n\tr.position, r.up, r.heading = motor.pos, motor.up, motor.heading\n\tself.safe = { pos = motor.pos, up = motor.up, heading = motor.heading }\nend\n\n-- One fixed tick, after RivalSpider.step. `s` is the same player snapshot step was given plus `up` (the player's support normal).\nfunction Drive.update(self: any, r: any, dt: number, s: any)\n\tlocal motor = self.motor\n\tlocal state = r.state\n\tself.ticks += 1\n\tif r.up == nil then r.up = Vector3.yAxis end\n\t-- (ROBLOX-117) the record's region is the drive's (a rest put back, a new rival arrived somewhere else)\n\tif r.region ~= nil and r.region ~= self.region and WorldMap.region(r.region) ~= nil then\n\t\tself:useRegion(r.region)\n\t\tself.crossing = nil\n\tend\n\tif self.incremental and self.g == nil then\n\t\tRoute.request(self.region)\n\t\tif Route.prepared(self.region) == nil then self.wish = Vector3.zero; return end\n\t\tself:useRegion(self.region)\n\tend\n\tlocal prev = self.prevState\n\tself.prevState = state\n\tif state == \"dormant\" or state == \"consumed\" then\n\t\tself.route, self.goal = nil, nil\n\t\treturn\n\tend\n\tif prev == \"dormant\" or prev == \"consumed\" then\n\t\tself:_place(r)\n\tend\n\tif state == \"captured\" then\n\t\t-- Held and eaten where the spider is: the state moves it.\n\t\tmotor:place(r.position, r.up, r.heading)\n\t\treturn\n\tend\n\tif state == \"lunge\" or state == \"taken\" then return end\n\tif prev == \"lunge\" then\n\t\tself:_reseat(r)\n\telseif (motor.pos - r.position).Magnitude > 0.05 or (r.up :: Vector3):Dot(motor.up) < 0.99 then\n\t\t-- A restored checkpoint, or anything else that moved it: stand where the state says.\n\t\tself.stats.resets += 1\n\t\tself:_place(r)\n\tend\n\t-- ROBLOX-106: a watch by the crack counts down while it patrols (stands there) or waits (the spider in the crack, a wasp's visit); a stalk does not use it up.\n\tif r.camp ~= nil and (state == \"patrol\" or state == \"recover\") then r.camp = math.max(0, r.camp - dt) end\n\tself.think -= dt\n\tif self.think <= 0 then\n\t\tself.think += Rules.thinkSeconds\n\t\tif self.think < 0 then self.think = 0 end\n\t\tself:_think(r, s)\n\tend\n\tlocal wish, focus = self:_wish(r, s)\n\tself.wish = wish\n\tlocal stalking = state == \"stalk\"\n\tlocal speed = if wish.Magnitude > 0 then (if stalking then Rules.stalkSpeed else Rules.patrolSpeed) else 0.0\n\tif speed > 0 then motor:setSpeedFactor(speed / motor.loco.walk_speed_wu_s) end\n\tif wish.Magnitude > 0 or focus ~= nil or motor.mode ~= \"attached\" or self.ticks % IDLE_EVERY == 0 then\n\t\tlocal input = Motor.idleInput()\n\t\tinput.wish = wish\n\t\tinput.focusPoint = focus\n\t\tmotor:tick(input)\n\tend\n\tif motor.up:Dot(self.lastUp) < 0.99 then\n\t\tself.lastUp = motor.up\n\t\tself.face = if motor.mode == \"attached\" then self.g:faceAt(motor.pos, motor.up) else nil\n\t\tself:_hops()\n\tend\n\t-- The crack is never entered: whatever happened, back to the last place outside it.\n\tif WorldMap.inRetreat(motor.pos, self.region) ~= nil then\n\t\tlocal safe = self.safe\n\t\tmotor:place(safe.pos, safe.up, safe.heading)\n\t\tself.route, self.goal = nil, nil\n\telseif not self.g:inKeepOut(motor.pos) and motor.mode == \"attached\" then\n\t\tself.safe = { pos = motor.pos, up = motor.up, heading = motor.heading }\n\tend\n\tr.position, r.up, r.heading = motor.pos, motor.up, motor.heading\nend\n\nreturn Drive\n",22874,2149549633},{"Shared/Predator/RivalGrip","--!strict\n-- The grip on a caught rival (ROBLOX-77): the same tapping struggle as the fly's (Prey/Feeding's grip math, so the HUD's grip bar and the Grip button\n-- work as they do for a fly) with the rival's own numbers (Data/Catch.rival; the gentle modes get the house fly's, and nothing here ever harms the\n-- player). A second Feeding controller is kept for it: only its `struggle` runs, never `step`, so it does not advance the reserves a second time.\n-- RivalSpider holds the rival (`subdued` false) and this decides how it ends: subdued (RivalSpider.subdue, then it is eaten as before) or it tears\n-- free (RivalSpider.tearFree: back to recover, nothing lost). The grip itself is scratch, never recorded: a rival found held and not subdued begins a\n-- fresh grip, and a checkpoint is never taken while it is held (Checkpoint.boundaryProblem), so a return can only land at a rest.\nlocal Feeding = require(script.Parent.Parent.Prey.Feeding)\nlocal PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)\nlocal Rival = require(script.Parent.RivalSpider)\n\nlocal Grip = {}\n\n-- A new grip. `needs` is only given to the controller (its struggle never touches it).\nfunction Grip.new(needs: any?): any\n\treturn { feeding = Feeding.new(needs), began = 0 }\nend\n\n-- Is the player's grip on a rival being fought for now (so the jump button is a tap and the HUD shows the grip)?\nfunction Grip.active(g: any): boolean\n\treturn g.feeding.struggling == true\nend\n\n-- The grip's strength 0..1 for the HUD, or nil when there is no struggle.\nfunction Grip.level(g: any): number?\n\tif g.feeding.struggling then return g.feeding.grip end\n\treturn nil\nend\n\n-- A tap of the Grip button.\nfunction Grip.tap(g: any)\n\tg.feeding:press()\nend\n\n-- The seeded stream of this rival's struggle: the world's seed, the day, which contest it was (the rival's own count) and, ROBLOX-91, which grip on it this was\n-- (`grips`, kept in its record: a rival that tore free and is caught again, without a contest in between, does not jerk at the same moments as the first time).\n-- The first grip (grips 0) is the seed it always was. Nothing else in the game draws from it.\nlocal function seedOf(seed: number, day: number, n: number, grips: number): number\n\treturn (seed * 19349663 + (day * 1013 + 7) * 83492791 + n * 73856093 + grips * 40503793 + 54321) % 2147483647\nend\n\n-- One tick. `r` is the rival's record, `s` the same table RivalSpider.step gets (grounded, gentle, day, seed) plus `auto` (Automatic grip).\n-- Returns \"\" (nothing happened), \"begin\" (a fresh grip on a rival just held), \"subdued\" (it is yours: eat it) or \"tore\" (it tore free).\nfunction Grip.step(g: any, r: any, dt: number, s: any): string\n\tlocal f = g.feeding\n\tif not Rival.struggling(r) then\n\t\tif f.struggling then f.struggling = false; f.held = nil; f.tap = false end -- the rival is gone from the fangs by some other way\n\t\treturn \"\"\n\tend\n\tlocal event = \"\"\n\tif not f.struggling then\n\t\tf.rng = PreyRandom.new(seedOf(s.seed or 0, s.day or 0, r.contests or 0, r.grips or 0))\n\t\tr.grips = (r.grips or 0) + 1\n\t\tf:useRivalRules(s.gentle == true)\n\t\tf.tap = false\n\t\tf:capture(r)\n\t\tg.began += 1\n\t\tevent = \"begin\"\n\tend\n\tf.auto = s.auto == true\n\tlocal tore = false\n\tf:struggle(dt, s.grounded ~= false, function() tore = true end)\n\tif tore then\n\t\tRival.tearFree(r)\n\t\treturn \"tore\"\n\tend\n\tif not f.struggling and f.held ~= nil then\n\t\tf.held = nil\n\t\tf.feeding = false\n\t\tf.swallow = 0\n\t\tRival.subdue(r)\n\t\treturn \"subdued\"\n\tend\n\treturn event\nend\n\nreturn Grip\n",3477,255493887},{"Shared/Predator/RivalRoute","--!strict\n-- Where the rival spider can walk, and the ways between (ROBLOX-69). A graph of a region's box faces (the sill's, ROBLOX-94; any region's, ROBLOX-95, below):\n-- every face of every box is a node; two faces that meet along a line (a box's own edge, convex, or a wall rising from a floor, concave) are\n-- joined by that seam. The rival's own SpiderMotor walks any seam the way the player's does (a wall ahead becomes the support, an edge is wrapped), so a\n-- route is only a list of seams to cross and where to head to cross them. Pure and Vector3-light: the CLI checks it on the boxes, and the\n-- same module runs in the game. Nothing here knows about time, state or the engine.\n--\n-- Faces are looked up by their box, the axis and the side. A face is \"stand-able\" at the sample points where a body of the motor's radius fits\n-- without touching another box. The crack (the crevice boxes) is forbidden: no route enters it, and the keep-out box around the retreat turns\n-- every straight walk aside; the open sash (ROBLOX-95) is a second keep-out box of the sill.\nlocal Rules = require(script.Parent.Parent.Data.RivalRules)\nlocal WorldMap = require(script.Parent.Parent.World.WorldMap)\nlocal Region = require(script.Parent.Parent.World.Region)\n\nlocal Route = {}\n\n-- ROBLOX-94: the graph was the sill's, region 0 of the world. ROBLOX-95: it is region-scoped. `Route.graph(id)` is the graph of one region, built from that region's pieces\n-- (Region.pieces) and keep-outs (Region.keepOut), with its neighbours' boxes as obstacles (a body that fits on a face fits there in the whole world), and with seam edges to\n-- its neighbours' graphs along the seams the map declares (WorldMap neighbors): the faces of two regions that meet along a seam's line, across a corner or flat across the\n-- same plane, are joined by an edge of the seam (`Graph:seamsOf(face)`). The functions of this module (faces, faceAt, adjacent, plan, aroundKeepOut, inKeepOut, waypoints,\n-- walkBlocked) are the sill's graph's, as the rival and the mate have always called them: they are bound to the sill this round, never plan across a seam, and keep out of\n-- its open sash (the sill's second keep-out box). The bed's graph is built and checked (tests/rivalnav.luau) and nothing walks it yet.\nlocal AXIS = { \"X\", \"Y\", \"Z\" }\nlocal SEAT = 0.31 -- the motor's body centre above its support (SpiderMotor.HEIGHT)\nlocal BODY = 0.2 -- a stand-able point keeps this much clear (the motor itself only casts rays, so less than its radius of 0.3 will do)\nlocal EPS = 1e-4\nlocal MIN_SEAM = 0.3 -- shorter seams are not used\n\nexport type Edge = {\n\tto: number,\n\tsamples: { Vector3 }, -- surface points on the seam where a body can cross\n\tahead: Vector3, -- on the face this edge leaves: the direction toward the seam\n\tconvex: boolean,\n}\nexport type Face = {\n\tid: number,\n\tpiece: string,\n\taxis: number,\n\tsign: number,\n\tnormal: Vector3,\n\tplane: number,\n\tlo: { number },\n\thi: { number },\n\tarea: number,\n\tforbidden: boolean,\n\tstand: { Vector3 }, -- surface points where a body fits\n\tedges: { Edge },\n\tcorners: { Vector3 }?, -- surface points just outside the corners of boxes standing on this face (made when first asked)\n}\n-- A hop is a seam crossed (from one face to the next), or a `via`: a corner of a box standing on the face, rounded so the walk does not run into it.\nexport type Hop = { from: number, face: number, seam: Vector3, aim: Vector3, via: boolean? }\n-- An edge of a seam between regions: from a face of one region's graph to a face of a neighbour's (`region`; `to` is the face's id in that region's graph), across a\n-- corner (`convex` or not) or `flat` across one plane.\nexport type SeamEdge = { region: string, to: number, samples: { Vector3 }, ahead: Vector3, convex: boolean, flat: boolean }\n\ntype BoxSpec = { id: string, lo: { number }, hi: { number } }\n\nlocal Graph = {}\nGraph.__index = Graph\nlocal graphs: { [string]: any } = {}\n\nlocal function comp(v: Vector3, axis: number): number\n\treturn (v :: any)[AXIS[axis]]\nend\n\nlocal function vec(x: number, y: number, z: number): Vector3\n\treturn Vector3.new(x, y, z)\nend\n\nlocal function axisVec(axis: number, s: number): Vector3\n\treturn if axis == 1 then vec(s, 0, 0) elseif axis == 2 then vec(0, s, 0) else vec(0, 0, s)\nend\n\n-- Whether a point is strictly inside any box (a hair of tolerance). `real`: only the pieces (the keep-out boxes left out).\nlocal function solid(g: any, p: Vector3, real: boolean?): boolean\n\tfor i, b in g.boxes do\n\t\tif real and i > g.real then break end\n\t\tif p.X > b.lo[1] + EPS and p.X < b.hi[1] - EPS and p.Y > b.lo[2] + EPS and p.Y < b.hi[2] - EPS and p.Z > b.lo[3] + EPS and p.Z < b.hi[3] - EPS then\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\n-- Whether a body of the motor's radius centred here touches no box. `real`: only the pieces (the keep-out boxes left out).\nlocal function bodyFits(g: any, c: Vector3, radius: number?, real: boolean?): boolean\n\tlocal r = radius or BODY\n\tfor i, b in g.boxes do\n\t\tif real and i > g.real then break end\n\t\tlocal dx = math.max(b.lo[1] - c.X, 0, c.X - b.hi[1])\n\t\tlocal dy = math.max(b.lo[2] - c.Y, 0, c.Y - b.hi[2])\n\t\tlocal dz = math.max(b.lo[3] - c.Z, 0, c.Z - b.hi[3])\n\t\tif dx * dx + dy * dy + dz * dz < r * r then return false end\n\tend\n\treturn true\nend\n\n-- The keep-out boxes: the retreats, grown by a margin, and on the sill its open sash. Nothing the region's creatures do goes in.\nfunction Graph.inKeepOut(self: any, p: Vector3): boolean\n\tfor _, k in self.keep do\n\t\tlocal lo, hi = k.min, k.max\n\t\tif p.X >= lo.X and p.X <= hi.X and p.Y >= lo.Y and p.Y <= hi.Y and p.Z >= lo.Z and p.Z <= hi.Z then return true end\n\tend\n\treturn false\nend\n\nlocal function forbiddenPiece(g: any, id: string): boolean\n\treturn g.region.kind == \"sill\" and (string.sub(id, 1, 8) == \"crevice_\" or id == \"leaf_tip\")\nend\n\nlocal function boxOf(piece: { id: string, lo: Vector3, hi: Vector3 }): BoxSpec\n\treturn { id = piece.id, lo = { piece.lo.X, piece.lo.Y, piece.lo.Z }, hi = { piece.hi.X, piece.hi.Y, piece.hi.Z } }\nend\n\nlocal function build(g: any)\n\tif g.built then return end\n\tg.built = true\n\tlocal boxes, faces = g.boxes, g.faces\n\tfor _, piece in Region.pieces(g.region) do\n\t\ttable.insert(boxes, boxOf(piece))\n\t\tif g.work then g.work() end\n\tend\n\tg.own = #boxes\n\t-- The neighbours' boxes are obstacles here (a body beside the seam fits only where it fits in the whole world), and have no faces in this graph.\n\tfor _, n in g.region.neighbors do\n\t\tlocal other = WorldMap.region(n.id)\n\t\tif other ~= nil then\n\t\t\tfor _, piece in Region.pieces(other) do table.insert(boxes, boxOf(piece)) end\n\t\tend\n\tend\n\t-- Where the region's creatures may be: the sill's walkable sill (the frames' outer faces and the floor's underside are outside it), any other region's bounds.\n\tlocal slo, shi = Rules.sillMin, Rules.sillMax\n\tif g.region.kind ~= \"sill\" then slo, shi = g.region.bounds[1], g.region.bounds[2] end\n\t-- Faces: six to a box.\n\tfor bi = 1, g.own do\n\t\tlocal b = boxes[bi]\n\t\tfor axis = 1, 3 do\n\t\t\tfor _, sign in { -1, 1 } do\n\t\t\t\tlocal o1, o2 = (axis % 3) + 1, ((axis + 1) % 3) + 1\n\t\t\t\tlocal face: Face = {\n\t\t\t\t\tid = #faces + 1, piece = b.id, axis = axis, sign = sign, normal = axisVec(axis, sign),\n\t\t\t\t\tplane = if sign > 0 then b.hi[axis] else b.lo[axis], lo = { 0, 0, 0 }, hi = { 0, 0, 0 },\n\t\t\t\t\tarea = (b.hi[o1] - b.lo[o1]) * (b.hi[o2] - b.lo[o2]), forbidden = forbiddenPiece(g, b.id), stand = {}, edges = {},\n\t\t\t\t}\n\t\t\t\tfor k = 1, 3 do\n\t\t\t\t\tface.lo[k], face.hi[k] = b.lo[k], b.hi[k]\n\t\t\t\tend\n\t\t\t\tface.lo[axis], face.hi[axis] = face.plane, face.plane\n\t\t\t\t-- Where a body fits on this face: a grid over its rectangle, inset a little from the rim.\n\t\t\t\tlocal n = if face.area > 60 then 9 else 5\n\t\t\t\tfor i = 0, n - 1 do\n\t\t\t\t\tfor j = 0, n - 1 do\n\t\t\t\t\t\tif g.work then g.work() end\n\t\t\t\t\t\tlocal pt = { 0, 0, 0 }\n\t\t\t\t\t\tpt[axis] = face.plane\n\t\t\t\t\t\tlocal function at(k: number, t: number): number\n\t\t\t\t\t\t\tlocal inset = math.min(0.3, (b.hi[k] - b.lo[k]) / 2)\n\t\t\t\t\t\t\treturn b.lo[k] + inset + (b.hi[k] - b.lo[k] - 2 * inset) * t\n\t\t\t\t\t\tend\n\t\t\t\t\t\tpt[o1] = at(o1, (i + 0.5) / n)\n\t\t\t\t\t\tpt[o2] = at(o2, (j + 0.5) / n)\n\t\t\t\t\t\tlocal surface = vec(pt[1], pt[2], pt[3])\n\t\t\t\t\t\tif bodyFits(g, surface + face.normal * SEAT) then table.insert(face.stand, surface) end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\t-- Outer faces (the frames' backs, the floor's underside) are outside where the creatures may be: no route enters them.\n\t\t\t\tlocal mid = vec((face.lo[1] + face.hi[1]) / 2, (face.lo[2] + face.hi[2]) / 2, (face.lo[3] + face.hi[3]) / 2) + face.normal * SEAT\n\t\t\t\tif mid.X < slo.X or mid.X > shi.X or mid.Y < slo.Y or mid.Y > shi.Y or mid.Z < slo.Z or mid.Z > shi.Z then face.forbidden = true end\n\t\t\t\ttable.insert(faces, face)\n\t\t\tend\n\t\tend\n\tend\n\t-- Seams between faces on different axes.\n\tfor _, f in faces do\n\t\tlocal A = boxes[1]\n\t\tfor bi = 1, g.own do\n\t\t\tif boxes[bi].id == f.piece then A = boxes[bi]; break end\n\t\tend\n\t\tfor _, h in faces do\n\t\t\tif h.axis ~= f.axis then\n\t\t\t\tif g.work then g.work() end\n\t\t\t\tlocal B = boxes[1]\n\t\t\t\tfor bi = 1, g.own do\n\t\t\t\t\tif boxes[bi].id == h.piece then B = boxes[bi]; break end\n\t\t\t\tend\n\t\t\t\tlocal a, b = f.axis, h.axis\n\t\t\t\tlocal c = 6 - a - b\n\t\t\t\tlocal cA, cB = f.plane, h.plane\n\t\t\t\tif cB >= A.lo[b] - EPS and cB <= A.hi[b] + EPS and cA >= B.lo[a] - EPS and cA <= B.hi[a] + EPS then\n\t\t\t\t\tlocal lo, hi = math.max(A.lo[c], B.lo[c]), math.min(A.hi[c], B.hi[c])\n\t\t\t\t\tif hi - lo >= MIN_SEAM then\n\t\t\t\t\t\tlocal convex = f.piece == h.piece\n\t\t\t\t\t\tlocal mid = { 0, 0, 0 }\n\t\t\t\t\t\tmid[a], mid[b], mid[c] = cA, cB, (lo + hi) / 2\n\t\t\t\t\t\tlocal corner = vec(mid[1], mid[2], mid[3]) + f.normal * 0.15 + h.normal * 0.15\n\t\t\t\t\t\tif not solid(g, corner) then\n\t\t\t\t\t\t\t-- From the seam into each face: a face meets a wall of another box on the wall's free side, and meets the rest of its own box\n\t\t\t\t\t\t\t-- away from the edge it turns over.\n\t\t\t\t\t\t\tlocal intoF = if convex then -h.normal else h.normal\n\t\t\t\t\t\t\tlocal intoG = if convex then -f.normal else f.normal\n\t\t\t\t\t\t\tlocal samples: { Vector3 } = {}\n\t\t\t\t\t\t\tfor _, t in { 0.12, 0.3, 0.5, 0.7, 0.88 } do\n\t\t\t\t\t\t\t\tlocal pc = lo + (hi - lo) * t\n\t\t\t\t\t\t\t\tif pc - lo >= 0.2 and hi - pc >= 0.2 or t == 0.5 then\n\t\t\t\t\t\t\t\t\tlocal s = { 0, 0, 0 }\n\t\t\t\t\t\t\t\t\ts[a], s[b], s[c] = cA, cB, pc\n\t\t\t\t\t\t\t\t\tlocal seam = vec(s[1], s[2], s[3])\n\t\t\t\t\t\t\t\t\t-- (A crossing may be a narrow strip, such as the underside of the planter's rim: only the places right at the seam are tested.)\n\t\t\t\t\t\t\t\t\tif bodyFits(g, seam + intoF * 0.12 + f.normal * SEAT, 0.1) and bodyFits(g, seam + intoG * 0.12 + h.normal * SEAT, 0.1)\n\t\t\t\t\t\t\t\t\t\tand not g:inKeepOut(seam) then\n\t\t\t\t\t\t\t\t\t\ttable.insert(samples, seam)\n\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tif #samples > 0 then\n\t\t\t\t\t\t\t\ttable.insert(f.edges, { to = h.id, samples = samples, ahead = -intoF, convex = convex })\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t-- The keep-out boxes are obstacles like any box (the walk tests and the corners to round count them) but have no faces: nothing walks on them.\n\tg.real = #boxes\n\tfor _, k in g.keep do\n\t\ttable.insert(boxes, { id = \"keepout\", lo = { k.min.X, k.min.Y, k.min.Z }, hi = { k.max.X, k.max.Y, k.max.Z } })\n\tend\nend\n\n-- The graph of a region (the sill's when no id is given), built when first asked. Errors for a region that is not on the map.\nfunction Route.graph(regionId: string?): any\n\tlocal id = regionId or WorldMap.HOME\n\tlocal key = WorldMap.world() .. \"/\" .. id -- (ROBLOX-115: a region's graph is its world's: the preserve's sill has no neighbours' boxes in it)\n\tlocal g = graphs[key]\n\tif g ~= nil then return g end\n\tlocal region = WorldMap.region(id)\n\tassert(region ~= nil, \"no region \" .. id)\n\tlocal made = setmetatable({ region = region, own = 0, real = 0, boxes = {}, faces = {}, keep = Region.keepOut(region), built = false, seamsBuilt = false, seams = {} }, Graph)\n\tgraphs[key] = made :: any\n\treturn made\nend\n\nfunction Graph.allFaces(self: any): { Face }\n\tbuild(self)\n\treturn self.faces\nend\n\n-- The face a body stands on: its centre, the support's normal. Nil when it is on no known face (in the air, or on a face this graph lacks).\nfunction Graph.faceAt(self: any, center: Vector3, up: Vector3): number?\n\tbuild(self)\n\tlocal surface = center - up * SEAT\n\tlocal best, bestD = nil :: number?, 0.12\n\tfor _, f in self.faces do\n\t\tif f.normal:Dot(up) > 0.98 then\n\t\t\tlocal d = math.abs(comp(surface, f.axis) - f.plane)\n\t\t\tif d < bestD then\n\t\t\t\tlocal inside = true\n\t\t\t\tfor k = 1, 3 do\n\t\t\t\t\tif k ~= f.axis and (comp(surface, k) < f.lo[k] - 0.12 or comp(surface, k) > f.hi[k] + 0.12) then inside = false; break end\n\t\t\t\tend\n\t\t\t\tif inside then best, bestD = f.id, d end\n\t\t\tend\n\t\tend\n\tend\n\treturn best\nend\n\n-- Whether two faces are the same or meet along a seam: the rival may strike from one onto the other.\nfunction Graph.adjacent(self: any, a: number?, b: number?): boolean\n\tif a == nil or b == nil then return false end\n\tif a == b then return true end\n\tbuild(self)\n\tfor _, e in self.faces[a].edges do\n\t\tif e.to == b then return true end\n\tend\n\treturn false\nend\n\n-- Whether a straight walk across a face of the box `own` from one surface point to another would run into a box standing on it (the body is a ball of\n-- 0.3, kept 0.2 off; the stretch next to the end points is not tested, they are at seams and walls by design).\nfunction Graph.walkBlocked(self: any, a: Vector3, b: Vector3, normal: Vector3, own: string): boolean\n\tbuild(self)\n\tlocal d = b - a\n\tlocal len = d.Magnitude\n\tif len < 0.35 then return false end\n\tlocal dir = d / len\n\tlocal cut = math.min(0.4, len * 0.5)\n\tlocal pa = a + dir * cut + normal * SEAT\n\tlocal pb = b - dir * cut + normal * SEAT\n\tlocal seg = pb - pa\n\tfor _, box in self.boxes do\n\t\tlocal tmin, tmax = 0.0, 1.0\n\t\tlocal hit = box.id ~= own\n\t\tfor k = 1, 3 do\n\t\t\tlocal o, dk = comp(pa, k), comp(seg, k)\n\t\t\tlocal l, h = box.lo[k] - 0.35, box.hi[k] + 0.35\n\t\t\tif math.abs(dk) < 1e-9 then\n\t\t\t\tif o < l or o > h then hit = false; break end\n\t\t\telse\n\t\t\t\tlocal t1, t2 = (l - o) / dk, (h - o) / dk\n\t\t\t\tif t1 > t2 then t1, t2 = t2, t1 end\n\t\t\t\ttmin, tmax = math.max(tmin, t1), math.min(tmax, t2)\n\t\t\t\tif tmin > tmax then hit = false; break end\n\t\t\tend\n\t\tend\n\t\t-- Starting beside a box and not walking toward it is not blocked: the start is inside its margin for a stride only.\n\t\tif hit then\n\t\t\tlocal away = false\n\t\t\tif tmin <= 1e-6 then\n\t\t\t\tlocal n = { 0.0, 0.0, 0.0 }\n\t\t\t\tfor k = 1, 3 do\n\t\t\t\t\tlocal o = comp(pa, k)\n\t\t\t\t\tif o < box.lo[k] then n[k] = o - box.lo[k] elseif o > box.hi[k] then n[k] = o - box.hi[k] end\n\t\t\t\tend\n\t\t\t\taway = (n[1] ~= 0 or n[2] ~= 0 or n[3] ~= 0) and seg.X * n[1] + seg.Y * n[2] + seg.Z * n[3] >= -1e-9\n\t\t\tend\n\t\t\tif not away then return true end\n\t\tend\n\tend\n\treturn false\nend\n\n-- The places to round a box that stands on a face: just outside each of its corners (0.42 off, the walk test keeps 0.35), where a body fits.\nlocal function cornersOf(g: any, f: Face): { Vector3 }\n\tif f.corners ~= nil then return f.corners :: { Vector3 } end\n\tlocal out: { Vector3 } = {}\n\tf.corners = out\n\tlocal o1, o2 = (f.axis % 3) + 1, ((f.axis + 1) % 3) + 1\n\tlocal level = f.plane + f.sign * SEAT\n\tlocal M = 0.42\n\tfor _, b in g.boxes do\n\t\tif b.id ~= f.piece and level >= b.lo[f.axis] - 0.35 and level <= b.hi[f.axis] + 0.35\n\t\t\tand b.hi[o1] + M > f.lo[o1] and b.lo[o1] - M < f.hi[o1] and b.hi[o2] + M > f.lo[o2] and b.lo[o2] - M < f.hi[o2] then\n\t\t\tfor _, c1 in { b.lo[o1] - M, b.hi[o1] + M } do\n\t\t\t\tfor _, c2 in { b.lo[o2] - M, b.hi[o2] + M } do\n\t\t\t\t\tif c1 >= f.lo[o1] + 0.2 and c1 <= f.hi[o1] - 0.2 and c2 >= f.lo[o2] + 0.2 and c2 <= f.hi[o2] - 0.2 then\n\t\t\t\t\t\tlocal pt = { 0, 0, 0 }\n\t\t\t\t\t\tpt[f.axis], pt[o1], pt[o2] = f.plane, c1, c2\n\t\t\t\t\t\tlocal surface = vec(pt[1], pt[2], pt[3])\n\t\t\t\t\t\tlocal centre = surface + f.normal * SEAT\n\t\t\t\t\t\tif bodyFits(g, centre, 0.3) and not g:inKeepOut(surface) and not g:inKeepOut(centre) then\n\t\t\t\t\t\t\ttable.insert(out, surface)\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn out\nend\n\n-- A binary min-heap of {priority, id}.\nlocal function heapPush(h: { any }, pri: number, id: number)\n\ttable.insert(h, { pri, id })\n\tlocal i = #h\n\twhile i > 1 do\n\t\tlocal p = i // 2\n\t\tif h[p][1] <= h[i][1] then break end\n\t\th[p], h[i] = h[i], h[p]\n\t\ti = p\n\tend\nend\nlocal function heapPop(h: { any }): (number, number)\n\tlocal top = h[1]\n\tlocal last = table.remove(h) :: any\n\tif #h > 0 then\n\t\th[1] = last\n\t\tlocal i = 1\n\t\twhile true do\n\t\t\tlocal l, r, m = i * 2, i * 2 + 1, i\n\t\t\tif l <= #h and h[l][1] < h[m][1] then m = l end\n\t\t\tif r <= #h and h[r][1] < h[m][1] then m = r end\n\t\t\tif m == i then break end\n\t\t\th[m], h[i] = h[i], h[m]\n\t\t\ti = m\n\t\tend\n\tend\n\treturn top[1], top[2]\nend\n\n-- The shortest way from a surface point on one face to a surface point on another, as the seams to cross and the corners to round. Nil when there\n-- is none. `from` and `goal` are surface points (not body centres). The search is over crossings and corners, not faces: a face is walked\n-- differently from where it is entered (a floor entered beside a box is not the floor entered on the far side of it), and a straight walk across\n-- a face that a box stands on is not a walk at all. Within the region: seams to its neighbours are not crossed.\nfunction Graph.plan(self: any, fromFace: number, from: Vector3, goalFace: number, goal: Vector3): { Hop }?\n\tbuild(self)\n\tlocal faces = self.faces\n\tlocal TURN = 0.6\n\tlocal BLOCKED = 25.0\n\t-- States: 1 is the start; the others are crossings (1), corners (2) and the goal (3), numbered as they are found.\n\tlocal stFace: { number } = { fromFace }\n\tlocal stPos: { Vector3 } = { from }\n\tlocal stPrev: { number } = { 0 }\n\tlocal stKind: { number } = { 0 }\n\tlocal stSeam: { Vector3 } = { from }\n\tlocal stAim: { Vector3 } = { from }\n\tlocal stDist: { number } = { 0 }\n\tlocal stCame: { number } = { 0 } -- the face a crossing chain started from (no turning straight back over the seam just crossed)\n\tlocal settled: { [number]: boolean } = {}\n\tlocal heap: { any } = {}\n\theapPush(heap, 0, 1)\n\tlocal bestVia: { [number]: number } = {} -- the cheapest cost found for each crossing (a face and which of its seams) and corner\n\tlocal goalCost = math.huge\n\tlocal goalState = 0\n\tlocal function add(face: number, pos: Vector3, prev: number, kind: number, aim: Vector3, dist: number, came: number)\n\t\ttable.insert(stFace, face)\n\t\ttable.insert(stPos, pos)\n\t\ttable.insert(stPrev, prev)\n\t\ttable.insert(stKind, kind)\n\t\ttable.insert(stSeam, pos)\n\t\ttable.insert(stAim, aim)\n\t\ttable.insert(stDist, dist)\n\t\ttable.insert(stCame, came)\n\t\theapPush(heap, dist, #stFace)\n\tend\n\twhile #heap > 0 do\n\t\tlocal _, id = heapPop(heap)\n\t\tif not settled[id] then\n\t\t\tsettled[id] = true\n\t\t\tif stKind[id] == 3 then goalState = id; break end\n\t\t\tlocal fid = stFace[id]\n\t\t\tlocal face = faces[fid]\n\t\t\tlocal here = stPos[id]\n\t\t\tlocal cost = stDist[id]\n\t\t\tif fid == goalFace then\n\t\t\t\tlocal nd = cost + (goal - here).Magnitude + (if self:walkBlocked(here, goal, face.normal, face.piece) then BLOCKED else 0)\n\t\t\t\tif nd < goalCost then\n\t\t\t\t\tgoalCost = nd\n\t\t\t\t\tadd(goalFace, goal, id, 3, goal, nd, stCame[id])\n\t\t\t\tend\n\t\t\tend\n\t\t\t-- Round the corner of a box standing on this face.\n\t\t\tfor ci, c in cornersOf(self, face) do\n\t\t\t\tlocal key = -(fid * 256 + ci)\n\t\t\t\tlocal nd = cost + (c - here).Magnitude + 0.1\n\t\t\t\tlocal known = bestVia[key]\n\t\t\t\tif (known == nil or nd < known - 1e-9) and (c - here).Magnitude > 0.05 and not self:walkBlocked(here, c, face.normal, face.piece) then\n\t\t\t\t\tbestVia[key] = nd\n\t\t\t\t\tadd(fid, c, id, 2, c + face.normal * SEAT, nd, stCame[id])\n\t\t\t\tend\n\t\t\tend\n\t\t\t-- Cross a seam.\n\t\t\tfor ei, e in face.edges do\n\t\t\t\tlocal g = faces[e.to]\n\t\t\t\tif not g.forbidden and e.to ~= stCame[id] then\n\t\t\t\t\tlocal ordered = table.clone(e.samples)\n\t\t\t\t\ttable.sort(ordered, function(p: Vector3, q: Vector3): boolean return (p - here).Magnitude < (q - here).Magnitude end)\n\t\t\t\t\tlocal best, bestD = ordered[1], (ordered[1] - here).Magnitude + BLOCKED\n\t\t\t\t\tfor i = 1, math.min(#ordered, 3) do\n\t\t\t\t\t\tif not self:walkBlocked(here, ordered[i], face.normal, face.piece) then\n\t\t\t\t\t\t\tbest, bestD = ordered[i], (ordered[i] - here).Magnitude\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\tlocal nd = cost + bestD + TURN\n\t\t\t\t\tlocal key = fid * 64 + ei\n\t\t\t\t\tlocal known = bestVia[key]\n\t\t\t\t\tif known == nil or nd < known - 1e-9 then\n\t\t\t\t\t\tbestVia[key] = nd\n\t\t\t\t\t\tadd(e.to, best, id, 1, best + e.ahead * 0.5, nd, fid)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tif goalState == 0 then return nil end\n\tlocal hops: { Hop } = {}\n\tlocal at = stPrev[goalState]\n\twhile stPrev[at] ~= 0 do\n\t\tlocal p = stPrev[at]\n\t\tif stKind[at] == 2 then\n\t\t\ttable.insert(hops, 1, { from = stFace[at], face = stFace[at], seam = stSeam[at], aim = stAim[at], via = true })\n\t\telse\n\t\t\ttable.insert(hops, 1, { from = stFace[p], face = stFace[at], seam = stSeam[at], aim = stAim[at] })\n\t\tend\n\t\tat = p\n\tend\n\treturn hops\nend\n\n-- Where to head so a straight walk does not cross the first keep-out box (the retreat's): the goal itself, or a corner of the box to round first.\nfunction Graph.aroundKeepOut(self: any, from: Vector3, goal: Vector3): Vector3\n\tlocal keep = self.keep[1]\n\tif keep == nil then return goal end\n\tlocal lo, hi = keep.min, keep.max\n\t-- The segment against the box, on the plane of the floor (the box is only a little taller than the spider).\n\tlocal function crosses(a: Vector3, b: Vector3): boolean\n\t\tlocal tmin, tmax = 0, 1\n\t\tfor _, axis in { \"X\", \"Z\" } do\n\t\t\tlocal da = (b :: any)[axis] - (a :: any)[axis]\n\t\t\tlocal oa = (a :: any)[axis]\n\t\t\tlocal l, h = (lo :: any)[axis], (hi :: any)[axis]\n\t\t\tif math.abs(da) < 1e-9 then\n\t\t\t\tif oa < l or oa > h then return false end\n\t\t\telse\n\t\t\t\tlocal t1, t2 = (l - oa) / da, (h - oa) / da\n\t\t\t\tif t1 > t2 then t1, t2 = t2, t1 end\n\t\t\t\ttmin, tmax = math.max(tmin, t1), math.min(tmax, t2)\n\t\t\t\tif tmin > tmax then return false end\n\t\t\tend\n\t\tend\n\t\treturn true\n\tend\n\tlocal inFirst = from.X >= lo.X and from.X <= hi.X and from.Y >= lo.Y and from.Y <= hi.Y and from.Z >= lo.Z and from.Z <= hi.Z\n\tif inFirst or from.Y > hi.Y + 0.4 or goal.Y > hi.Y + 0.4 then return goal end\n\tif not crosses(from, goal) then return goal end\n\tlocal y = from.Y\n\tlocal best, bestLen = goal, math.huge\n\tfor _, x in { lo.X - 0.05, hi.X + 0.05 } do\n\t\tfor _, z in { lo.Z - 0.05, hi.Z + 0.05 } do\n\t\t\tlocal corner = vec(x, y, z)\n\t\t\tif not crosses(from, corner) and not crosses(corner, goal) then\n\t\t\t\tlocal len = (corner - from).Magnitude + (goal - corner).Magnitude\n\t\t\t\tif len < bestLen then best, bestLen = corner, len end\n\t\t\tend\n\t\tend\n\tend\n\treturn best\nend\n\nexport type Waypoint = { pos: Vector3, up: Vector3, face: number }\n\n-- Places to patrol to, spread over every face the region's creatures may walk: the tops of the boxes and their climbable sides (not undersides, not\n-- the crack), a few on a big face, always a spot where a body fits.\nfunction Graph.waypoints(self: any): { Waypoint }\n\tbuild(self)\n\tlocal out: { Waypoint } = {}\n\tfor _, f in self.faces do\n\t\tif self.work then self.work() end\n\t\tif not f.forbidden and f.normal.Y > -0.5 and f.area >= 1.5 and #f.stand > 0 then\n\t\t\tlocal k = math.clamp(math.floor(f.area / 70) + 1, 1, 5)\n\t\t\tlocal picked: { Vector3 } = {}\n\t\t\tlocal pool: { Vector3 } = {}\n\t\t\tfor _, s in f.stand do\n\t\t\t\tif self.work then self.work() end\n\t\t\t\tif not self:inKeepOut(s + f.normal * SEAT) and not self:inKeepOut(s) then table.insert(pool, s) end\n\t\t\tend\n\t\t\tif #pool > 0 then\n\t\t\t\ttable.insert(picked, pool[math.ceil(#pool / 2)])\n\t\t\t\twhile #picked < math.min(k, #pool) do\n\t\t\t\t\tlocal far, farD = pool[1], -1.0\n\t\t\t\t\tfor _, s in pool do\n\t\t\t\t\t\tif self.work then self.work() end\n\t\t\t\t\t\tlocal nearest = math.huge\n\t\t\t\t\t\tfor _, q in picked do nearest = math.min(nearest, (s - q).Magnitude) end\n\t\t\t\t\t\tif nearest > farD then far, farD = s, nearest end\n\t\t\t\t\tend\n\t\t\t\t\ttable.insert(picked, far)\n\t\t\t\tend\n\t\t\t\tfor _, s in picked do table.insert(out, { pos = s, up = f.normal, face = f.id }) end\n\t\t\tend\n\t\tend\n\tend\n\treturn out\nend\n\n-- Whether a point lies on the segment a-b (within a hair), and the part of the segment [lo, hi] along `axis` it shares with a line at the other two coordinates.\nlocal function onLine(a: Vector3, b: Vector3, axis: number, fixed: { number }, lo: number, hi: number): (number, number)\n\tfor k = 1, 3 do\n\t\tif k ~= axis and (math.abs(comp(a, k) - fixed[k]) > 0.05 or math.abs(comp(b, k) - fixed[k]) > 0.05) then return 0, -1 end\n\tend\n\tlocal s0, s1 = math.min(comp(a, axis), comp(b, axis)), math.max(comp(a, axis), comp(b, axis))\n\treturn math.max(lo, s0), math.min(hi, s1)\nend\n\n-- The seams to this region's neighbours, built when first asked: for every seam the map declares, the pairs of faces (one here, one in the neighbour's graph) that meet\n-- along its line, across a corner or flat across one plane, with the places on the line where a body can cross (both sides tested against the whole world's boxes).\n-- The keep-outs do not prune these: a seam edge is the map's topology, and whether a creature may cross it is its own rule (this round none does).\nlocal function buildSeams(g: any)\n\tif g.seamsBuilt then return end\n\tg.seamsBuilt = true\n\tbuild(g)\n\tfor _, n in g.region.neighbors do\n\t\tlocal other = if g.resolve then g.resolve(n.id) else Route.graph(n.id)\n\t\tbuild(other)\n\t\tfor _, f in g.faces do\n\t\t\tfor _, h in other.faces do\n\t\t\t\tif g.work then g.work() end\n\t\t\t\tlocal samplesLine: { number }? = nil\n\t\t\t\tlocal axis, fixed, ahead, convex, flat = 0, { 0, 0, 0 }, Vector3.zero, false, false\n\t\t\t\tlocal nf, nh = f.normal, h.normal\n\t\t\t\tif h.axis ~= f.axis then\n\t\t\t\t\t-- across a corner: the line where the two planes meet, along the third axis, inside both faces\n\t\t\t\t\tlocal a, b = f.axis, h.axis\n\t\t\t\t\tlocal c = 6 - a - b\n\t\t\t\t\tif h.plane >= f.lo[b] - EPS and h.plane <= f.hi[b] + EPS and f.plane >= h.lo[a] - EPS and f.plane <= h.hi[a] + EPS then\n\t\t\t\t\t\tfixed[a], fixed[b] = f.plane, h.plane\n\t\t\t\t\t\tlocal lo, hi = onLine(n.a, n.b, c, fixed, math.max(f.lo[c], h.lo[c]), math.min(f.hi[c], h.hi[c]))\n\t\t\t\t\t\tif hi - lo >= MIN_SEAM then\n\t\t\t\t\t\t\tlocal mid = { 0, 0, 0 }\n\t\t\t\t\t\t\tmid[a], mid[b], mid[c] = f.plane, h.plane, (lo + hi) / 2\n\t\t\t\t\t\t\tlocal m = vec(mid[1], mid[2], mid[3])\n\t\t\t\t\t\t\tif not solid(g, m + nf * 0.15 + nh * 0.15, true) then\n\t\t\t\t\t\t\t\tlocal isConvex = not solid(g, m + nf * 0.15 - nh * 0.15, true)\n\t\t\t\t\t\t\t\t-- each face must go on from the line the way the corner says (a wall's foot onto the floor in front of it, an edge onto the box's\n\t\t\t\t\t\t\t\t-- own side): a face that lies against the other box (a slab's underside on the wall it sits on) is no way across\n\t\t\t\t\t\t\t\tlocal intoF = if isConvex then -nh else nh\n\t\t\t\t\t\t\t\tlocal intoH = if isConvex then -nf else nf\n\t\t\t\t\t\t\t\tlocal pf, ph = m + intoF * 0.12, m + intoH * 0.12\n\t\t\t\t\t\t\t\tif comp(pf, b) >= f.lo[b] - EPS and comp(pf, b) <= f.hi[b] + EPS and comp(ph, a) >= h.lo[a] - EPS and comp(ph, a) <= h.hi[a] + EPS then\n\t\t\t\t\t\t\t\t\tconvex = isConvex\n\t\t\t\t\t\t\t\t\taxis = c\n\t\t\t\t\t\t\t\t\tsamplesLine = { lo, hi }\n\t\t\t\t\t\t\t\t\tahead = -intoF\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\telseif h.sign == f.sign and math.abs(h.plane - f.plane) < EPS then\n\t\t\t\t\t-- flat across one plane: the two rectangles touch along an edge\n\t\t\t\t\tlocal a = f.axis\n\t\t\t\t\tfor _, o in { (a % 3) + 1, ((a + 1) % 3) + 1 } do\n\t\t\t\t\t\tlocal along = 6 - a - o\n\t\t\t\t\t\tfor _, touch in { { f.hi[o], h.lo[o], 1 }, { f.lo[o], h.hi[o], -1 } } do\n\t\t\t\t\t\t\tif samplesLine == nil and math.abs(touch[1] - touch[2]) < EPS then\n\t\t\t\t\t\t\t\tfixed[a], fixed[o] = f.plane, touch[1]\n\t\t\t\t\t\t\t\tlocal lo, hi = onLine(n.a, n.b, along, fixed, math.max(f.lo[along], h.lo[along]), math.min(f.hi[along], h.hi[along]))\n\t\t\t\t\t\t\t\tif hi - lo >= MIN_SEAM then\n\t\t\t\t\t\t\t\t\taxis, samplesLine, flat = along, { lo, hi }, true\n\t\t\t\t\t\t\t\t\tahead = axisVec(o, touch[3])\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif samplesLine ~= nil then\n\t\t\t\t\tlocal line = samplesLine :: { number }\n\t\t\t\t\tlocal samples: { Vector3 } = {}\n\t\t\t\t\tfor _, t in { 0.12, 0.3, 0.5, 0.7, 0.88 } do\n\t\t\t\t\t\tlocal pc = line[1] + (line[2] - line[1]) * t\n\t\t\t\t\t\tlocal s = table.clone(fixed)\n\t\t\t\t\t\ts[axis] = pc\n\t\t\t\t\t\tlocal seam = vec(s[1], s[2], s[3])\n\t\t\t\t\t\tlocal intoF = -ahead\n\t\t\t\t\t\tlocal intoH = if flat then ahead elseif convex then -nf else nf\n\t\t\t\t\t\tif bodyFits(g, seam + intoF * 0.12 + nf * SEAT, 0.1, true) and bodyFits(g, seam + intoH * 0.12 + nh * SEAT, 0.1, true) then\n\t\t\t\t\t\t\ttable.insert(samples, seam)\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\tif #samples > 0 then\n\t\t\t\t\t\tlocal list = g.seams[f.id]\n\t\t\t\t\t\tif list == nil then list = {}; g.seams[f.id] = list end\n\t\t\t\t\t\ttable.insert(list, { region = n.id, to = h.id, samples = samples, ahead = ahead, convex = convex, flat = flat })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- The seam edges leaving a face of this region's graph for its neighbours' (none for most faces).\nfunction Graph.seamsOf(self: any, face: number): { SeamEdge }\n\tbuildSeams(self)\n\treturn self.seams[face] or {}\nend\n\n-- Every seam edge of this region's graph, as { face, edge } pairs.\nfunction Graph.allSeams(self: any): { { face: number, edge: SeamEdge } }\n\tbuildSeams(self)\n\tlocal out = {}\n\tfor fid = 1, #self.faces do\n\t\tfor _, e in self.seams[fid] or {} do table.insert(out, { face = fid, edge = e }) end\n\tend\n\treturn out\nend\n\n-- Opt-in frame-budgeted preparation. Legacy graph queries stay synchronous.\n-- Jobs own their construction tables; the public cache receives only completed\n-- face graphs, and prepared() requires complete seams and patrol waypoints too.\nlocal pending: { [string]: any } = {}\nlocal queue: { any } = {}\nlocal active: any = nil\nlocal budget = { left = 0, deadline = 0.0 }\nlocal preparation = { completed = 0, cancelled = 0, failed = 0, lastUnits = 0, lastSeconds = 0.0, largestSlice = 0.0, error = \"\" }\n\nlocal function keyOf(id: string): string return WorldMap.world() .. \"/\" .. id end\nlocal function ready(g: any): boolean\n\treturn g ~= nil and g.built == true and g.seamsBuilt == true and g.preparedWaypoints ~= nil\nend\nfunction Route.prepared(id: string): any\n\tlocal g = graphs[keyOf(id)]\n\treturn if ready(g) then g else nil\nend\nfunction Route.preparedWaypoints(g: any): { Waypoint }\n\tassert(ready(g), \"route is not prepared\")\n\tlocal out = {}\n\tfor _, p in g.preparedWaypoints do table.insert(out, table.clone(p)) end\n\treturn out\nend\nlocal function checkpoint()\n\tbudget.left -= 1\n\tif budget.left <= 0 or os.clock() >= budget.deadline then coroutine.yield() end\nend\nlocal function privateGraph(id: string): any\n\tlocal old = graphs[keyOf(id)]\n\tif old ~= nil and old.built then\n\t\t-- Built faces/obstacles are stable. Seams are written only on this clone.\n\t\treturn setmetatable(table.clone(old), Graph)\n\tend\n\tlocal region = WorldMap.region(id)\n\tassert(region ~= nil, \"no region \" .. id)\n\treturn setmetatable({ region = region, own = 0, real = 0, boxes = {}, faces = {}, keep = Region.keepOut(region), built = false, seamsBuilt = false, seams = {} }, Graph)\nend\nfunction Route.request(id: string, priority: boolean?): boolean\n\tif Route.prepared(id) ~= nil then return true end\n\tassert(WorldMap.region(id) ~= nil, \"no region \" .. id)\n\tlocal key = keyOf(id)\n\tlocal job = pending[key]\n\tif job ~= nil then\n\t\tif priority ~= false and job ~= active then\n\t\t\tlocal at = table.find(queue, job)\n\t\t\tif at ~= nil and at > 1 then table.remove(queue, at); table.insert(queue, 1, job) end\n\t\tend\n\t\treturn false\n\tend\n\tjob = { id = id, key = key, world = WorldMap.world() }\n\tjob.thread = coroutine.create(function()\n\t\tlocal shadows: { [string]: any } = {}\n\t\tlocal function resolve(otherId: string): any\n\t\t\tif shadows[otherId] ~= nil then return shadows[otherId] end\n\t\t\tlocal old = graphs[keyOf(otherId)]\n\t\t\tif old ~= nil and old.built then return old end\n\t\t\tlocal made = privateGraph(otherId)\n\t\t\tmade.work = checkpoint\n\t\t\tshadows[otherId] = made\n\t\t\treturn made\n\t\tend\n\t\tlocal root = privateGraph(id)\n\t\t-- A pending clone must never append to a public partial seam table.\n\t\tif not root.seamsBuilt then root.seams = {} end\n\t\troot.work, root.resolve = checkpoint, resolve\n\t\tshadows[id] = root\n\t\tbuildSeams(root)\n\t\troot.preparedWaypoints = root:waypoints()\n\t\t-- No yields during publication. A world change cancels the job before\n\t\t-- its next resume, so these keys always name the world being prepared.\n\t\tfor otherId, made in shadows do\n\t\t\tmade.work, made.resolve = nil, nil\n\t\t\tlocal old = graphs[keyOf(otherId)]\n\t\t\tif otherId == id then\n\t\t\t\tif not ready(old) then graphs[keyOf(otherId)] = made end\n\t\t\telseif old == nil or not old.built then graphs[keyOf(otherId)] = made end\n\t\tend\n\tend)\n\tpending[key] = job\n\tif priority == false then table.insert(queue, job) else table.insert(queue, 1, job) end\n\treturn false\nend\nfunction Route.cancelPreparation()\n\tfor _ in pending do preparation.cancelled += 1 end\n\tpending, queue, active = {}, {}, nil\nend\nfunction Route.advance(maxUnits: number?, seconds: number?): (boolean, string?)\n\tlocal started = os.clock()\n\tlocal units = math.max(1, math.floor(maxUnits or 512))\n\tbudget.left, budget.deadline = units, started + math.max(0, seconds or .002)\n\tlocal ok, problem = true, nil :: string?\n\twhile budget.left > 0 and os.clock() < budget.deadline do\n\t\tif active == nil then active = table.remove(queue, 1) end\n\t\tif active == nil then break end\n\t\tlocal job = active\n\t\tif job.world ~= WorldMap.world() then\n\t\t\tpending[job.key], active = nil, nil\n\t\t\tpreparation.cancelled += 1\n\t\t\tcontinue\n\t\tend\n\t\tlocal resumed, why = coroutine.resume(job.thread)\n\t\tif not resumed then\n\t\t\tpreparation.failed += 1; preparation.error = tostring(why)\n\t\t\tpending[job.key], active = nil, nil\n\t\t\tok, problem = false, tostring(why)\n\t\t\tbreak\n\t\telseif coroutine.status(job.thread) == \"dead\" then\n\t\t\tpending[job.key], active = nil, nil\n\t\t\tpreparation.completed += 1\n\t\telse break end\n\tend\n\tpreparation.lastUnits = units - budget.left\n\tpreparation.lastSeconds = os.clock() - started\n\tpreparation.largestSlice = math.max(preparation.largestSlice, preparation.lastSeconds)\n\treturn ok, problem\nend\nfunction Route.preparationStats(): any\n\tlocal out: any = table.clone(preparation)\n\tlocal count = 0; for _ in pending do count += 1 end\n\tout.pending, out.active = count, if active then active.id else nil\n\treturn out\nend\n\n-- ---------------------------------------------------------------- the sill's graph, as the rival and the mate call it\nlocal function sill(): any\n\treturn Route.graph(WorldMap.HOME)\nend\n\nfunction Route.faces(): { Face }\n\treturn sill():allFaces()\nend\n\nfunction Route.inKeepOut(p: Vector3): boolean\n\treturn sill():inKeepOut(p)\nend\n\nfunction Route.faceAt(center: Vector3, up: Vector3): number?\n\treturn sill():faceAt(center, up)\nend\n\nfunction Route.adjacent(a: number?, b: number?): boolean\n\treturn sill():adjacent(a, b)\nend\n\nfunction Route.plan(fromFace: number, from: Vector3, goalFace: number, goal: Vector3): { Hop }?\n\treturn sill():plan(fromFace, from, goalFace, goal)\nend\n\nfunction Route.aroundKeepOut(from: Vector3, goal: Vector3): Vector3\n\treturn sill():aroundKeepOut(from, goal)\nend\n\nfunction Route.waypoints(): { Waypoint }\n\treturn sill():waypoints()\nend\n\nRoute.SEAT = SEAT\nRoute.walkBlocked = function(a: Vector3, b: Vector3, normal: Vector3, own: string): boolean\n\treturn sill():walkBlocked(a, b, normal, own)\nend\n\nreturn Route\n",34725,856778608},{"Shared/Predator/RivalSpider","--!strict\n-- Intraguild predator: the preserve's resident ranger-station patrol, present\n-- from the first day. The frozen test garden retains its daily visiting rival.\n-- Timings/reward are game tuning, not species measurements.\n-- Plain state lives in LifeLoop's checkpoint graph; no clock, engine instance or hidden player tracking.\n-- ROBLOX-73: the spider's strike catches a rival that has not seen it coming outright, but a rival that has (stalking, winding up, or patrolling\n-- with a notice of Rules.awareNotice) is a contest: caught, sprang clear, or a counter-bite that costs energy. The draw is the rival's own stream.\n-- ROBLOX-77: a rival that was caught is held but not yet eaten: it struggles (`subdued` false) until the player has subdued it with the tapping\n-- grip (Predator/RivalGrip runs that; Rival.subdue marks it) or it tears free (Rival.tearFree: back to recover, its day kept). Only a subdued rival\n-- is eaten. A held rival with no `subdued` at all (a record from before) is eaten as it always was.\n-- ROBLOX-91: a rival that tore free is `shaken` while it recovers: it is aware (a strike is the contest again, with its counter-bite, and not a free re-catch);\n-- the mark goes at its next change of phase. The rival keeps away from a courting pair and from the mating scene (`s.courting`, `s.scene`: it recovers, like\n-- the wasp's visit). The day it was eaten is a morning, not the raw day counter: a new one comes at the next 07:00 after the 07:00 it was eaten in.\nlocal M=require(script.Parent.Parent.Prey.PreyMath)\nlocal PreyRandom=require(script.Parent.Parent.Prey.PreyRandom)\nlocal Rules=require(script.Parent.Parent.Data.RivalRules)\nlocal WorldMap=require(script.Parent.Parent.World.WorldMap)\nlocal Station=require(script.Parent.Parent.World.StationTerritory)\nlocal Rival={}\nlocal function phase(r: any,s: string) if r.state~=s then r.shaken=nil end;r.state=s;r.elapsed=0 end\nRival.FOOD=.7 -- two housefly-equivalent meals\nRival.FAR=6000 -- (ROBLOX-119) how far from the sill a record's places may be: World/Preserve.LIMIT\nlocal states={dormant=true,patrol=true,stalk=true,windup=true,lunge=true,recover=true,captured=true,consumed=true,taken=true}\n-- \"dormant\" is \"has not arrived yet\". `day` (nil in a record from before the daily rival) is the day it was eaten, so the next one comes after it.\n-- ROBLOX-117: where a rival arrives, and its region: the sill's east end in the test garden (Data/RivalRules; no region, as every record there has always been), the\n-- station floor in the preserve (StationTerritory), with its region kept in the record.\nfunction Rival.arriveAt(): (Vector3,string?)\n if WorldMap.world()==\"preserve\" then return Station.ARRIVE,Station.REGION end\n return Rules.arriveAt,nil\nend\n-- The regions a rival roams (nil: the legacy sill). The preserve's mate keeps its garden territory.\nfunction Rival.roam(): {[string]:boolean}?\n if WorldMap.world()==\"preserve\" then return Station.roam() end\n return nil\nend\nfunction Rival.new(): any\n local at,region=Rival.arriveAt()\n local r={state=\"dormant\",position=at,previous=at,heading=-Vector3.xAxis,\n  elapsed=0,notice=0,food=Rival.FOOD,target=at,origin=at,patrol=0,up=Vector3.yAxis,leg=0,contests=0,grips=0}\n if region~=nil then r.region=region end\n return r\nend\n-- ROBLOX-117: a record of another world's rival (a rest kept in one world and put back in the other): a preserve rival in the test garden, or a sill rival (or one of a\n-- region this world has not) in the preserve. That rival is not here: this world's is a new one, yet to arrive.\nfunction Rival.misplaced(r: any): boolean\n local _,region=Rival.arriveAt()\n if region==nil then return r.region~=nil end\n return not Station.contains(r.region)\nend\n-- The morning an hour of the clock belongs to: the hours before 07:00 are the night of the day before.\nfunction Rival.morning(day: number,hour: number?): number\n return if (hour or Rules.arriveHour)>=Rules.arriveHour then day else day-1\nend\n-- Has it seen the spider coming (so that a strike is a contest and not a sure catch)?\nfunction Rival.aware(r: any): boolean\n return r.state==\"stalk\" or r.state==\"windup\" or (r.state==\"patrol\" and r.notice>=Rules.awareNotice) or (r.state==\"recover\" and r.shaken==true)\nend\n-- The outcome of a contest, from a stream of its own so no other draw moves: \"captured\", \"sprang\" or \"counter\". It depends only on the world's seed,\n-- the day and `n` (how many contests this rival has had, kept in its record), so a return to a rest brings back the same outcome for the same strike.\n-- ROBLOX-91: `gentle` (Easy, Free play) keeps ROBLOX-73's odds (Rules.contestGentle), the standard rules ROBLOX-88's harder ones.\nfunction Rival.contest(seed: number,day: number,n: number,gentle: boolean?): string\n local g=PreyRandom.new((seed*73856093+(day*1009+41)*19349663+n*83492791+12345)%2147483647)\n g:next();g:next()\n local u=g:next()\n local captured,sprang=Rules.contestCaptured,Rules.contestSprang\n if gentle==true then captured,sprang=Rules.contestGentle.captured,Rules.contestGentle.sprang end\n if u<captured then return \"captured\" end\n if u<captured+sprang then return \"sprang\" end\n return \"counter\"\nend\n-- The player has the caught rival subdued: it can now be eaten (stay still).\nfunction Rival.subdue(r: any): boolean\n if r==nil or r.state~=\"captured\" then return false end\n r.subdued=true;return true\nend\n-- The caught rival tore free of the fangs (ROBLOX-77): it is simply gone from them and recovers where it stands, with its day, its food and its\n-- contest count as they were; not a contest and no new rival. ROBLOX-91: it is `shaken` while it recovers (see Rival.aware): the next strike at it is the contest\n-- again, with the counter-bite, not a free re-catch that skips both.\nfunction Rival.tearFree(r: any): boolean\n if r==nil or r.state~=\"captured\" then return false end\n phase(r,\"recover\");r.notice=0;r.subdued=nil;r.shaken=true;return true\nend\n-- Held and still fighting the player's grip (a held rival with no `subdued`, as in an older record, is not).\nfunction Rival.struggling(r: any): boolean\n return r~=nil and r.state==\"captured\" and r.subdued==false\nend\n-- The next rival, in the same table (the world holds this table): a fresh one that has not yet arrived.\nfunction Rival.renew(r: any)\n r.region=nil -- (ROBLOX-117: Rival.new gives it again where this world has one)\n for k,v in Rival.new() do r[k]=v end\n r.day=nil\n r.hour=nil\n r.fate=nil\n r.subdued=nil\n r.shaken=nil\n r.camp=nil\nend\n-- Where the wasp may take it from (ROBLOX-70): nil unless it is on the sill, awake and free; never in the retreat. ROBLOX-94: `region` (the sill's unless given) is the\n-- region it belongs to, whose retreats it keeps out of.\nfunction Rival.target(r: any,region: string?): any\n if r==nil or not (r.state==\"patrol\" or r.state==\"stalk\" or r.state==\"windup\" or r.state==\"recover\") or WorldMap.inRetreat(r.position,region or r.region or WorldMap.HOME)~=nil then return nil end\n return {position=r.position,up=r.up or Vector3.yAxis,present=true}\nend\n-- The wasp has it: it hangs under the wasp and nothing else touches it.\nfunction Rival.seize(r: any): boolean\n if r==nil or Rival.target(r)==nil then return false end\n phase(r,\"taken\");return true\nend\n-- The wasp has carried it off the sill: gone for today (food for no one), and a new one comes on a later morning like after an eaten one. `hour` (the clock's,\n-- ROBLOX-91) says which morning it belongs to; without it the day's own.\nfunction Rival.carried(r: any,day: number,hour: number?)\n r.state=\"consumed\";r.elapsed=0;r.food=0;r.day=day;r.hour=hour;r.fate=\"taken by the wasp\";r.shaken=nil\nend\n-- ROBLOX-94: `region` is the region the rival belongs to (the sill's unless given): where it may stand is that region's bounds, outside that region's retreats.\nfunction Rival.valid(r: any,region: string?): boolean\n if r==nil then return true end\n if type(r)~=\"table\" or not states[r.state] then return false end\n for _,k in {\"elapsed\",\"notice\",\"food\",\"patrol\"} do\n  local n=r[k];if type(n)~=\"number\" or n~=n or n<0 or n==math.huge then return false end\n end\n if r.food>Rival.FOOD+1e-8 then return false end\n -- ROBLOX-69: where it stands. `up` (the face under it) and `leg` (patrol places visited) are missing in older records: they mean the floor and\n -- none. It is on the sill, never in the crack.\n if r.up~=nil then\n  local u=r.up\n  if (typeof(u)~=\"Vector3\" and type(u)~=\"table\") or type(u.X)~=\"number\" or type(u.Y)~=\"number\" or type(u.Z)~=\"number\"\n   or u.X~=u.X or u.Y~=u.Y or u.Z~=u.Z or math.abs(u.Magnitude-1)>.05 then return false end\n end\n if r.leg~=nil and (type(r.leg)~=\"number\" or r.leg~=r.leg or r.leg<0 or r.leg>1e9 or r.leg%1~=0) then return false end\n if r.contests~=nil and (type(r.contests)~=\"number\" or r.contests~=r.contests or r.contests<0 or r.contests>1e9 or r.contests%1~=0) then return false end\n if r.spared~=nil and type(r.spared)~=\"boolean\" then return false end\n if r.subdued~=nil and type(r.subdued)~=\"boolean\" then return false end\n if r.shaken~=nil and type(r.shaken)~=\"boolean\" then return false end\n if r.camp~=nil and (type(r.camp)~=\"number\" or r.camp~=r.camp or r.camp<0 or r.camp>1e4) then return false end -- (ROBLOX-106: the watch by the crack)\n if r.grips~=nil and (type(r.grips)~=\"number\" or r.grips~=r.grips or r.grips<0 or r.grips>1e9 or r.grips%1~=0) then return false end\n if r.hour~=nil and (type(r.hour)~=\"number\" or r.hour~=r.hour or r.hour<0 or r.hour>=24) then return false end\n if r.fate~=nil and r.fate~=\"eaten\" and r.fate~=\"taken by the wasp\" then return false end\n -- ROBLOX-117: `region` (optional: the preserve's rival roams the hut garden) names a region of 1 to 64 characters. One this world has not is another world's rival\n -- (Rival.misplaced: a new one comes); its place is not looked at here.\n if r.region~=nil and (type(r.region)~=\"string\" or #r.region<1 or #r.region>64) then return false end\n if r.state==\"patrol\" or r.state==\"stalk\" or r.state==\"windup\" or r.state==\"lunge\" or r.state==\"recover\" then\n  local p,id=r.position,region or r.region or WorldMap.HOME\n  if WorldMap.region(id)~=nil and (not WorldMap.inBounds(p,id) or WorldMap.inRetreat(Vector3.new(p.X,p.Y,p.Z),id)~=nil) then return false end\n end\n if r.day~=nil and (type(r.day)~=\"number\" or r.day~=r.day or r.day<0 or r.day==math.huge) then return false end\n -- (ROBLOX-119: within the preserve's precision limit, World/Preserve.LIMIT: its roam reaches the meadow's edge, 16 m from the sill; it was 1000 studs)\n for _,k in {\"position\",\"previous\",\"heading\",\"target\",\"origin\"} do\n  local v=r[k];if typeof(v)~=\"Vector3\" and type(v)~=\"table\" then return false end\n  if type(v.X)~=\"number\" or type(v.Y)~=\"number\" or type(v.Z)~=\"number\" or type(v.Magnitude)~=\"number\" or v.X~=v.X or v.Y~=v.Y or v.Z~=v.Z or v.Magnitude>Rival.FAR then return false end\n end\n return true\nend\n-- blocked(a,b) is the same opaque-world sight query as flies use. Player input is a snapshot of this fixed tick.\n-- Returns an event and the amount swallowed; the caller owns food grants and end-of-life presentation. The strike's contest (ROBLOX-73) returns\n-- \"captured\", \"sprang\" (it got clear) or \"counter\" (it bit back) with, for \"counter\", the energy that costs (0 in the gentle modes) in place of the amount\n-- swallowed. `s.seed` is the world's seed (nil: 0).\nfunction Rival.step(r: any,dt: number,s: any,blocked: (Vector3,Vector3)->any): (string,number)\n if dt<=0 or dt~=dt then return \"\",0 end\n if r.state~=\"captured\" and r.state~=\"taken\" and Rival.misplaced(r) then Rival.renew(r) end -- (ROBLOX-117: another world's rival is not here)\n dt=math.min(dt,.05);r.previous=r.position\n if r.state==\"taken\" then\n  -- In the wasp's grip. If the wasp no longer holds it (a record returned to), it is gone: carried off.\n  if s.taken then return \"\",0 end\n  Rival.carried(r,s.day or 0,s.hour);return \"taken\",0\n end\n if r.state==\"consumed\" then\n  if WorldMap.world()==\"preserve\" then\n   r.elapsed+=dt\n   local at=Station.ARRIVE\n   -- A defeated rival stays defeated. A later replacement enters below the window,\n   -- only after a quiet minute and out of sight, never on top of the player.\n   if r.elapsed>=Station.REPLACE_SECONDS and (s.position-at).Magnitude>Rules.arriveDistance and blocked(s.position,at) then\n    Rival.renew(r)\n   else return \"\",0 end\n  else\n  -- An old record has no day: the day it is first seen eaten is the day it was eaten. A new rival comes on a later morning.\n  if r.day==nil then r.day=s.day end\n  -- (ROBLOX-91: by morning, not by the day counter: one eaten in the small hours belongs to the night before, and one eaten just before midnight still\n  -- gives way at the next 07:00.)\n  if Rival.morning(s.day,s.hour)>Rival.morning(r.day,r.hour or Rules.arriveHour) then Rival.renew(r) else return \"\",0 end\n  end\n end\n if r.state==\"captured\" then\n  r.position=s.position+s.heading*.4;r.heading=s.heading\n  if r.subdued==false then return \"struggling\",0 end -- fighting the grip: nothing is eaten and no time passes toward it\n  if not s.grounded or s.moving then return \"paused\",0 end\n  local food=math.min(r.food,.14*dt);r.food=math.max(0,r.food-food)\n  if r.food<=1e-8 then r.food=0;r.day=s.day;r.hour=s.hour;r.fate=\"eaten\";phase(r,\"consumed\");return \"eaten\",food end\n  return \"feeding\",food\n end\n if r.state==\"dormant\" then\n  -- (`s.born` ROBLOX-91: the day before this generation began, and `s.meals` this generation's: the first day and first meal of a spiderling are protected too.)\n  if WorldMap.world()~=\"preserve\" and (s.day-(s.born or 0)<Rules.firstDay or s.meals<Rules.firstMeals or (s.hour or Rules.arriveHour)<Rules.arriveHour\n   or (s.position-r.position).Magnitude<Rules.arriveDistance or s.resting or s.wasp or s.scene or s.courting) then return \"\",0 end\n  phase(r,\"patrol\")\n  if s.drive then r.leg=(s.day or 0)*5 end -- a different first place to patrol to each day\n end\n -- Never stack two attackers or pursue into the retreat. No hidden-target chase.\n -- (ROBLOX-91: and while the spider is courting or mating, so a lunge cannot land on a pair: the rival keeps away from them.)\n if s.safe or s.resting or s.wasp or s.scene or s.courting then\n  if WorldMap.world()==\"preserve\" then\n   if r.state~=\"patrol\" then phase(r,\"patrol\") end\n   r.elapsed+=dt;r.notice=0\n  else phase(r,\"recover\");r.notice=0 end\n  return \"\",0\n end\n r.elapsed+=dt\n local delta=s.position-r.position\n -- Driven by a RivalDrive (its own motor over the whole sill): what it sees is decided ten times a second, at any height; otherwise\n -- (the CLI's floor-only checks, Godot's rule) every tick and on the floor's level.\n local D=s.drive\n local visible\n if D then visible=D.sees else visible=delta.Magnitude<8 and math.abs(delta.Y)<1.5 and not blocked(r.position,s.position) end\n if not s.striking then r.spared=nil end\n if s.striking and not s.holding and r.state~=\"lunge\" and not r.spared then\n  local _,d=M.sweepClosest(s.previous,s.position,r.previous,r.position)\n  if d<.65 and not blocked(s.position,r.position) then\n   local outcome=\"captured\"\n   if Rival.aware(r) then\n    outcome=Rival.contest(s.seed or 0,s.day or 0,r.contests or 0,s.gentle)\n    r.contests=(r.contests or 0)+1\n   end\n   if outcome==\"captured\" then phase(r,\"captured\");r.subdued=false;return \"captured\",0 end\n   -- It got away from this strike: it recovers, and the rest of the same strike cannot catch it (the next one, a recovering rival, can).\n   phase(r,\"recover\");r.spared=true\n   if outcome==\"counter\" then return \"counter\",if s.gentle then 0 else Rules.counterCost end\n   return \"sprang\",0\n  end\n end\n if r.state==\"lunge\" then\n  local k=math.clamp(r.elapsed/.4,0,1)\n  local next=r.origin:Lerp(r.target,k)+(if D then r.up or Vector3.yAxis else Vector3.yAxis)*(.35*4*k*(1-k))\n  if blocked(r.position,next) then phase(r,\"recover\");return \"missed\",0 end\n  r.position=next\n  local _,d=M.sweepClosest(s.previous,s.position,r.previous,r.position)\n  if d<.6 and not blocked(r.position,s.position) then\n   phase(r,\"recover\");return if s.gentle then \"touch\" else \"caught\",0\n  end\n  if k>=1 then if not D then r.position=Vector3.new(r.position.X,.31,r.position.Z) end;phase(r,\"recover\") end\n elseif r.state==\"windup\" then\n  if not visible or s.airborne or s.onLine then phase(r,\"recover\");return \"missed\",0 end\n  if r.elapsed>=1 then\n   r.origin=r.position\n   if D then\n    -- At the spider's own place, wherever that is; never at the crack.\n    if WorldMap.inRetreat(s.position)~=nil then phase(r,\"recover\");return \"missed\",0 end\n    r.target=s.position\n   else r.target=Vector3.new(math.clamp(s.position.X,18,28),.31,math.clamp(s.position.Z,3,10.8)) end\n   phase(r,\"lunge\")\n  end\n elseif r.state==\"recover\" then\n  if not D then r.position=Vector3.new(r.position.X,.31,r.position.Z) end\n  if r.elapsed>=3 then phase(r,\"patrol\") end\n else\n  -- (ROBLOX-106: `s.noticeScale`, the standard rules' cover factor, Life/Nature.cover: halved under a leaf and when still, doubled moving in the open; absent, 1)\n  local rate=if type(s.noticeScale)==\"number\" then s.noticeScale else 1\n  r.notice=if visible then math.min(1,r.notice+dt*rate) else math.max(0,r.notice-dt*2)\n  if visible and r.notice>=Rules.stalkNotice then\n   phase(r,\"stalk\")\n   local flat=if D then delta else Vector3.new(delta.X,0,delta.Z)\n   if not D and flat.Magnitude>.01 then r.heading=flat.Unit end\n   if flat.Magnitude<(if D then Rules.reachWu else 2.5) and (not D or D.reach) then phase(r,\"windup\");return \"warning\",0 end\n  elseif not visible and not (D and r.state==\"stalk\" and D.remember) then r.state=\"patrol\" end\n  if D then return \"\",0 end -- its legs are the drive's\n  local next=r.position\n  if r.state==\"stalk\" then next+=r.heading*dt*1.1\n  elseif r.state==\"patrol\" then\n   r.patrol+=dt\n   r.heading=if math.floor(r.patrol/4)%2==0 then -Vector3.xAxis else Vector3.xAxis\n   next+=r.heading*dt*.45\n  end\n  next=Vector3.new(math.clamp(next.X,18,28),.31,math.clamp(next.Z,3,10.8))\n  if not blocked(r.position,next) then r.position=next end\n end\n return \"\",0\nend\nfunction Rival.percept(r: any): any\n if r.state==\"dormant\" or r.state==\"captured\" or r.state==\"consumed\" or r.state==\"taken\" then return nil end\n return {id=\"rival_spider\",position=r.position,radius=.45,velocity=(r.position-r.previous)*60,maxCategory=\"movement\"}\nend\nreturn Rival\n",18184,2357938015},{"Shared/Predator/WaspDirector","--!strict\n-- WaspDirector: the black-and-yellow mud dauber's visits to the sill, without the engine. A port of the frozen\n-- scripts/predator/wasp_director.gd and its actor scripts/predator/wasp.gd (LIFE round 4; LIFE-03 the first predator; LIFE-01 death can\n-- be real and jarring, not sensationalized; spec 2 no threat spawning behind the player and no unexplained death; spec 8.3 search,\n-- inspect, approach, strike, disengage). Every number is in Data/Wasp.\n--\n-- When. At most one visit a day in the Godot replay (some days only) and two in the game (every day from the second, one in the morning and\n-- one in the afternoon; useGameRules, ROBLOX-75), in the warm part of the day, never on the first day, never before the spider has finished its\n-- first meal, and never while it rests or moults in the crack. Whether a day has a visit, and when, follows from the world's seed and the day\n-- alone, so a return to a checkpoint meets the same wasp (the port's own hash: Godot's cannot be reproduced in Luau, so the same seed\n-- does not give the same days as Godot). What a day has had is kept as the day of the last visit and which of the day's visits it was.\n--\n-- Warned. The wasp is heard before it is near: it comes in over the window frame from outside for ARRIVE_S and does not search until it\n-- is on the sill. When it lands the spider feels it. When it has seen the spider it turns toward it and comes to look (INSPECT_S at arm's\n-- length) before it strikes.\n--\n-- Search by sight. It moves between authored places on the sill where a spider might be: it hovers and looks, and on open surfaces it may\n-- land and walk, its antennae flicking. It knows nothing it has not seen. Each tick that it can see the spider (in range, a clear line,\n-- not in the retreat) its notice grows, much faster when the spider moves than when it keeps still, and faster near than far. Out of\n-- sight, notice fades. Full notice: it has found the spider.\n--\n-- Escapes. The silk-lined crack is safe. A jump, a drop on the line, or getting out of sight breaks its approach; then it is confused and\n-- searches somewhere at least FAR_FROM_LOSS_WU away. Its strike is a short lunge at where the spider was: a spider that moves off quickly\n-- is missed. After SEARCH_S of searching it gives up and flies away.\n--\n-- Caught. The wasp stings and the spider goes still; the wasp carries it up and away over the frame (`heldAt` is where the spider hangs).\n-- The host presents that. The spider is paralysed by the sting, not killed (LIFE-03).\n--\n-- What is handed in. The director knows the world only through three functions (`ray`, `clear`, `inRetreat`), the spider only through the\n-- Spider table of this tick and the life clock only through the Block table, so the plain Luau CLI replays it against Godot's goldens\n-- (tests/wasp_reference.json, tools/export_wasp_reference.gd) on an analytic world, and the client gives it the real sill's casts.\n-- Random draws come from `rng` (range, unit, int); the tests hand it a scripted one.\n--\n-- Gentle rules (the wasp touches the spider and leaves; Godot's round 5 modes): the flag is `gentle`; the game sets it for Easy and Free play (and never for the\n-- standard rules). The sound is the host's (captions only; no audio assets).\n\nlocal Data = require(script.Parent.Parent.Data.Wasp)\nlocal PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)\nlocal StationAir = require(script.Parent.Parent.World.StationAir)\n\nlocal WaspDirector = {}\nWaspDirector.__index = WaspDirector\n\n-- (\"taking\", \"seizing\" and \"bearing\" are the game's wasp going for the rival male, ROBLOX-70: flying to it and hanging over it, the strike, carrying it off.)\nWaspDirector.MAX_SLOTS = #Data.game.windows -- the most visits a day the record can hold (the game's windows: two)\n\nWaspDirector.PHASES = table.freeze({ \"away\", \"arriving\", \"searching\", \"inspecting\", \"striking\", \"carrying\", \"leaving\", \"taking\", \"seizing\", \"bearing\" })\n\nexport type Rng = {\n\trange: (Rng, number, number) -> number, -- a number in [lo, hi)\n\tunit: (Rng) -> number, -- a number in [0, 1)\n\tint: (Rng, number, number) -> number, -- a whole number in [lo, hi]\n}\n-- What the director asks of the world. `ray`: something solid between two points. `clear`: a sphere of that radius goes from a to b\n-- without touching the world. `inRetreat`: inside the silk-lined crack.\nexport type World = {\n\tray: (Vector3, Vector3) -> boolean,\n\tclear: (Vector3, Vector3, number) -> boolean,\n\tinRetreat: (Vector3) -> boolean,\n}\n-- The spider this tick.\nexport type Spider = {\n\tposition: Vector3,\n\tvelocity: Vector3,\n\twalkSpeed: number,\n\tairborne: boolean, -- in a jump\n\tfalling: boolean, -- let down on its line (or fallen)\n\tcover: number?, -- ROBLOX-106: the standard rules' factor on notice (Life/Nature.cover); nil: 1\n}\n-- The life this tick (Godot: the habitat loop and the feeding controller).\n-- `rival`: the free rival male the wasp may take, if one is on the sill (RivalSpider.target): where it is and which way is up from it.\nexport type Block = { day: number, hour: number, resting: boolean, moulting: boolean, meals: number, born: number?, rival: { position: Vector3, up: Vector3, present: boolean }? }\nexport type Signal = { kind: string, [string]: any }\n\n-- Godot's one window of the day (the game's two are Data.game.windows).\nlocal ONE_WINDOW: { { number } } = { { Data.windowFromH, Data.windowToH } }\n\nlocal UP = Vector3.new(0, 1, 0)\nlocal DOWN = Vector3.new(0, -1, 0)\nlocal FORWARD = Vector3.new(0, 0, -1)\nlocal TAU = math.pi * 2\n\nlocal function rotateY(v: Vector3, angle: number): Vector3\n\tlocal c, s = math.cos(angle), math.sin(angle)\n\treturn Vector3.new(v.X * c + v.Z * s, v.Y, -v.X * s + v.Z * c)\nend\n\nlocal function pathLength(path: { Vector3 }): number\n\tlocal total = 0.0\n\tfor i = 2, #path do total += (path[i - 1] - path[i]).Magnitude end\n\treturn math.max(total, 1e-3)\nend\n\n-- The default random stream for a visit: the port's Park-Miller, mixed from the seed, the day and the visit.\nlocal function makeStream(seed: number, a: number, b: number): Rng\n\tlocal r = PreyRandom.new((seed * 73856093 + a * 19349663 + b * 83492791 + 12345) % 2147483647)\n\tr:next()\n\tr:next()\n\treturn {\n\t\trange = function(_, lo: number, hi: number): number return lo + (hi - lo) * r:next() end,\n\t\tunit = function(): number return r:next() end,\n\t\tint = function(_, lo: number, hi: number): number return lo + math.min(math.floor(r:next() * (hi - lo + 1)), hi - lo) end,\n\t} :: any\nend\n\n-- `config.seed`: the world's seed. `config.world`: the three functions. `config.enabled`: false and it never comes by itself (test worlds;\n-- force still brings it). `config.makeRng(day, visit)`: the random stream of a visit (tests).\nfunction WaspDirector.new(config: { seed: number, world: World, enabled: boolean?, makeRng: ((number, number) -> Rng)? }): any\n\tlocal self = setmetatable({\n\t\tworld = config.world, enabled = config.enabled ~= false, seed = config.seed, makeRng = config.makeRng,\n\t\t-- The wasp as the spider's senses have it (wasp.gd).\n\t\twasp = {\n\t\t\tposition = Vector3.new(0, 0, 0), heading = FORWARD, velocity = Vector3.new(0, 0, 0), normal = UP,\n\t\t\tmode = \"flying\", search = 0.0, visible = false, prev = Vector3.new(0, 0, 0),\n\t\t},\n\t\tphase = \"away\", visitS = 0.0, phaseS = 0.0, searchLeft = 0.0, notice = 0.0, confusedS = 0.0,\n\t\tnoticedThisVisit = false, sparedThisVisit = false, gentle = false, nature = false, lingers = false,\n\t\tlastVisitDay = 0, lastVisitSlot = 0, visits = 0, escapes = 0,\n\t\tevents = {} :: { { kind: string, t: number } },\n\t\tsignals = {} :: { Signal },\n\t\t-- Where the spider hangs while it is carried (nil otherwise); the host moves the spider there each tick.\n\t\theldAt = nil :: Vector3?, holding = false,\n\t\t-- The rival male (ROBLOX-70): whether this visit is for it, whether it hangs under the wasp, and where.\n\t\ttakeRival = false, holdingRival = false, rivalHeldAt = nil :: Vector3?, rivalNow = nil :: any, takeSub = \"fly\", takeOpen = Vector3.new(0, 0, 0),\n\t\t-- The visit in progress.\n\t\tpoints = Data.points, rng = nil :: Rng?, path = {} :: { Vector3 }, pathI = 1, speed = Data.flySpeed, point = 1, recent = {} :: { number },\n\t\tsub = \"\", subS = 0.0, walkDir = Vector3.new(0, 0, 0), stepS = 0.0, openPos = Vector3.new(0, 0, 0), lastSeen = Vector3.new(0, 0, 0),\n\t\tunseenS = 0.0, holdS = 0.0, lossPos = nil :: Vector3?, strikeFrom = Vector3.new(0, 0, 0), strikeTo = Vector3.new(0, 0, 0),\n\t\tdt = 1 / 60, spider = nil :: Spider?,\n\t}, WaspDirector)\n\treturn self\nend\n\n-- The game's rules (Data/Wasp.game): two visits every day from the second, the longer search of ROBLOX-62 and the rival male's draw. A\n-- director that is never given them replays Godot (one window, some days only, the original rates), which is what the goldens check.\nfunction WaspDirector.useGameRules(self: any)\n\tlocal g = Data.game\n\tself.visitChance, self.searchScale, self.noticeScale, self.inspectScale = g.visitChance, g.searchScale, g.noticeScale, g.inspectScale\n\tself.rivalChance = g.takesRival\n\tself.windowList, self.minGapH = g.windows, g.minGapH\nend\n\nfunction WaspDirector.useStationRules(self: any): boolean\n\tif self.station then return false end\n\tself.station=StationAir;self.points=StationAir.points\n\treturn true\nend\n\nfunction WaspDirector.isVisiting(self: any): boolean\n\treturn self.phase ~= \"away\"\nend\n\n-- A resident's ordinary patrol is not a perpetual combat/modal lock.\nfunction WaspDirector.isThreatening(self: any): boolean\n\tif not self.station then return self:isVisiting() end\n\treturn self.phase==\"inspecting\" or self.phase==\"striking\" or self.phase==\"carrying\"\nend\n\n-- ---------------------------------------------------------------------------------------------------------------- when it comes\n\n-- The windows of the day, as (from, to) hours of the life clock: Godot's one, the game's two.\nfunction WaspDirector.windows(self: any): { { number } }\n\treturn self.windowList or ONE_WINDOW\nend\n\n-- ROBLOX-106: the standard rules' wasp (Data.game.nature): the client sets `nature` when the rules are not gentle. A director without it is as it was.\nfunction WaspDirector.natural(self: any): boolean\n\treturn self.nature == true and not self.gentle\nend\n\n-- The windows of day `day`: the windows, each slid by its own draw of up to Data.game.nature.shiftH either way in the standard rules (ROBLOX-106).\nfunction WaspDirector.dayWindows(self: any, day: number): { { number } }\n\tlocal windows = self:windows()\n\tif not self:natural() then return windows end\n\tlocal shift = Data.game.nature.shiftH\n\tlocal out: { { number } } = {}\n\tfor slot, w in windows do\n\t\tlocal d = -shift + 2 * shift * PreyRandom.mixed(self.seed, day, slot, 47):next()\n\t\tout[slot] = { w[1] + d, w[2] + d }\n\tend\n\treturn out\nend\n\n-- How long visit number `visit` of day `day` searches, as a share of the game's search (1 without the standard rules' draw; ROBLOX-106), and whether it lingers.\nfunction WaspDirector.visitScale(self: any, day: number, visit: number): (number, boolean)\n\tif not self:natural() then return 1.0, false end\n\tlocal n = Data.game.nature\n\tlocal r = PreyRandom.mixed(self.seed, day, visit, 53)\n\tif r:next() < n.lingerChance then return r:draw(n.linger), true end\n\treturn r:draw(n.visit), false\nend\n\n-- Whether each of day `day`'s visits happens, and at what hour: one number for each window, -1 when that visit has none. From the seed, the day\n-- and the visit's place in the day alone (the first visit's stream is the one the Godot replay uses). A visit's hour is in the first part of\n-- its window, up to an hour before the window's end, and not before `minGapH` after the visit before it.\nfunction WaspDirector.plannedHours(self: any, day: number): { number }\n\tlocal hours: { number } = {}\n\tlocal previous = -math.huge\n\tfor slot, window in self:dayWindows(day) do\n\t\tlocal hour = -1.0\n\t\tif day >= Data.firstDay then\n\t\t\tlocal r = makeStream(self.seed, day, 6 + slot)\n\t\t\tif r:unit() < (self.visitChance or Data.visitChance) then\n\t\t\t\tlocal from = math.max(window[1], previous + (self.minGapH or 0.0))\n\t\t\t\thour = r:range(from, math.max(window[2] - 1.0, from))\n\t\t\t\tprevious = hour\n\t\t\tend\n\t\tend\n\t\thours[slot] = hour\n\tend\n\treturn hours\nend\n\n-- Whether day `day` has a visit, and at what hour: -1 when it has none. The day's first visit (the only one in the Godot replay).\nfunction WaspDirector.plannedHour(self: any, day: number): number\n\treturn self:plannedHours(day)[1]\nend\n\n-- Why a visit could not begin now (\"\" when it could), apart from the hour.\nfunction WaspDirector.blocked(_self: any, block: Block): string\n\t-- (ROBLOX-91: `born` is the day before the family's generation began, 0 for the first, and `meals` its own count: a spiderling of the next generation has its first day and\n\t-- first meal protected like a new life, whatever the sill's day counter and the meals of the last family say.)\n\tif block.day - (block.born or 0) < Data.firstDay then return \"the first day\" end\n\tif block.meals < 1 then return \"no meal yet\" end\n\tif block.resting or block.moulting then return \"resting\" end\n\treturn \"\"\nend\n\n-- Begins the day's next visit if its hour has come: the first of the day's visits not yet had whose window the hour is in, from its planned\n-- hour to the window's end, and nothing blocks it. A visit whose window passed unused (a rest through all of it) is simply skipped.\nfunction WaspDirector._maybeBegin(self: any, block: Block)\n\tif self.station then self:beginVisit(block.day,1);return end\n\tlocal day = block.day\n\tlocal windows = self:dayWindows(day)\n\tlocal done = if day == self.lastVisitDay then self.lastVisitSlot else 0\n\tif done >= #windows then return end\n\tlocal hours = self:plannedHours(day)\n\tfor slot = done + 1, #windows do\n\t\tlocal hour = hours[slot]\n\t\tif hour >= 0.0 and block.hour >= hour and block.hour < windows[slot][2] then\n\t\t\tif self:blocked(block) == \"\" then self:beginVisit(day, nil, slot) end\n\t\t\treturn\n\t\tend\n\tend\nend\n\n-- The index of the search place with this id, nil when there is none.\nfunction WaspDirector.pointIndex(id: string): number?\n\tfor i, p in Data.points do\n\t\tif p.id == id then return i end\n\tend\n\treturn nil\nend\n\n-- Brings the wasp now (tests, the test place's attribute). `at`: the id of the place it searches first (nil lets the visit choose). False\n-- when it is already here. It uses up the day's next visit.\nfunction WaspDirector.force(self: any, day: number, at: string?): boolean\n\tif self.phase ~= \"away\" then return false end\n\tlocal first=nil\n\tif at then for i,point in self.points do if point.id==at then first=i;break end end end\n\tself:beginVisit(day, first)\n\treturn true\nend\n\n-- `slot`: which of the day's visits this is (nil: the next one not yet had that day, the last when all were).\nfunction WaspDirector.beginVisit(self: any, day: number, first: number?, slot: number?)\n\tlocal done = if day == self.lastVisitDay then self.lastVisitSlot else 0\n\tself.lastVisitDay = day\n\tself.lastVisitSlot = slot or math.min(done + 1, #self:windows())\n\tself.visits += 1\n\tself.rng = if self.makeRng then self.makeRng(day, self.visits) else makeStream(self.seed, day * 1009 + 13, self.visits)\n\tself.events = {}\n\tself.visitS = 0.0\n\tself.notice = 0.0\n\tself.confusedS = 0.0\n\tself.noticedThisVisit = false\n\tself.sparedThisVisit = false\n\tlocal scale, lingers = self:visitScale(day, self.visits)\n\tself.lingers = lingers\n\tself.searchLeft = Data.searchS * (self.searchScale or 1) * scale\n\tself.recent = {}\n\tself.lossPos = nil\n\tself.holding = false\n\tself.heldAt = nil\n\tself.holdingRival, self.rivalHeldAt = false, nil\n\t-- Whether this visit is for the rival male (the game's wasp only): a draw from a stream of its own, so the other draws are as before.\n\tself.takeRival = self.rivalChance ~= nil and makeStream(self.seed, day * 1009 + 29, self.visits):unit() < self.rivalChance\n\tself.point = first or self.rng:int(1, #self.points)\n\tlocal to: Vector3 = self.points[self.point].hover\n\tself.path = { Data.entry, Data.over, Vector3.new(to.X, Data.cruiseY, to.Z), to }\n\tif self.station then\n\t\tself.takeRival=false\n\t\tself.path=self.station.route(self.station.entry,to)\n\tend\n\tself.pathI = 2\n\tself.speed = pathLength(self.path) / Data.arriveS\n\tself:_place(if self.station then self.station.entry else Data.entry)\n\tself.wasp.mode = \"flying\"\n\tself.wasp.search = 0.0\n\tself.wasp.visible = true\n\tself:_setPhase(\"arriving\")\n\tself:_log(\"warning\")\n\tself:_signal({ kind = \"visit_started\", first = self.visits == 1, point = self.points[self.point].id })\nend\n\n-- ---------------------------------------------------------------------------------------------------------------- the tick\n\n-- One fixed tick, after the spider has moved. `spider`: this tick's spider; `block`: this tick's life. Nothing is read from the spider\n-- while the wasp is away.\nfunction WaspDirector.step(self: any, dt: number, spider: Spider, block: Block)\n\tself.dt = dt\n\tself.spider = spider\n\tself.rivalNow = block.rival\n\tself.protected=self.station~=nil and (block.resting or block.moulting)\n\tlocal phase: string = self.phase\n\tif phase == \"away\" then\n\t\tif self.enabled then self:_maybeBegin(block) end\n\t\treturn\n\tend\n\tself.visitS += dt\n\tself.phaseS += dt\n\tif phase == \"arriving\" then\n\t\tif self:_advance(dt) and (not self.station or self.phaseS>=Data.arriveS) then\n\t\t\tself.openPos = self.wasp.position\n\t\t\tif self.takeRival and self:_beginTaking() then return end\n\t\t\tself:_setPhase(\"searching\")\n\t\t\tself:_log(\"searching\")\n\t\t\tself.sub = \"hover\"\n\t\t\tself.subS = self.rng:range(Data.hoverS[1], Data.hoverS[2])\n\t\tend\n\telseif phase == \"searching\" then\n\t\tself.searchLeft -= dt\n\t\tself:_search(dt)\n\t\tself:_look(dt)\n\t\tif self.notice >= 1.0 then\n\t\t\tself:_beginInspecting()\n\t\telseif self.searchLeft <= 0.0 and (self.sub == \"hover\" or self.sub == \"fly\") then\n\t\t\tself:_beginLeaving()\n\t\tend\n\telseif phase == \"inspecting\" then\n\t\tself:_inspect(dt)\n\telseif phase == \"striking\" then\n\t\tself:_strike(dt)\n\telseif phase == \"carrying\" then\n\t\tlocal done = self:_advance(dt)\n\t\tself:_holdSpider()\n\t\tif done then\n\t\t\tself:_setPhase(\"away\")\n\t\t\tself.wasp.visible = false\n\t\t\tself:_signal({ kind = \"carried_off\" })\n\t\tend\n\telseif phase == \"taking\" then\n\t\tself:_take(dt)\n\telseif phase == \"seizing\" then\n\t\tself:_seize(dt)\n\telseif phase == \"bearing\" then\n\t\tlocal done = self:_advance(dt)\n\t\tself:_holdRival()\n\t\tif done then\n\t\t\tself:_setPhase(if self.station then \"searching\" else \"away\")\n\t\t\tself.wasp.visible = self.station~=nil\n\t\t\tself.holdingRival, self.rivalHeldAt, self.takeRival = false, nil, false\n\t\t\tself:_signal({ kind = \"rival_carried_off\" })\n\t\t\tif self.station then self:_beginLeaving() end\n\t\tend\n\telseif phase == \"leaving\" then\n\t\tif self:_advance(dt) then\n\t\t\tself.wasp.visible = false\n\t\t\tself:_setPhase(\"away\")\n\t\t\tif self.noticedThisVisit then self.escapes += 1 end\n\t\t\tself:_log(\"left\")\n\t\t\tself:_signal({ kind = \"left\", escaped = self.noticedThisVisit })\n\t\tend\n\tend\nend\n\n-- ---------------------------------------------------------------------------------------------------------------- searching\n\nfunction WaspDirector._search(self: any, dt: number)\n\tlocal wasp = self.wasp\n\tlocal sub: string = self.sub\n\tif sub == \"fly\" then\n\t\twasp.search = 0.3\n\t\tif self:_advance(dt) then\n\t\t\tself.openPos = wasp.position\n\t\t\tself.sub = \"hover\"\n\t\t\tself.subS = self.rng:range(Data.hoverS[1], Data.hoverS[2])\n\t\tend\n\telseif sub == \"hover\" then\n\t\twasp.mode = \"flying\"\n\t\twasp.search = 0.8\n\t\tself:_moveTo(wasp.position, rotateY(wasp.heading, math.rad(Data.scanDegS) * dt), dt)\n\t\tself.subS -= dt\n\t\tif self.subS <= 0.0 then\n\t\t\tlocal p = self.points[self.point]\n\t\t\tif p.land ~= nil and self.rng:unit() < Data.landChance and self.searchLeft > Data.landS + Data.walkS then\n\t\t\t\tself.sub = \"land\"\n\t\t\t\tself.path = { wasp.position, p.land }\n\t\t\t\tself.pathI = 2\n\t\t\t\tself.speed = (wasp.position - p.land).Magnitude / Data.landS\n\t\t\telse\n\t\t\t\tself:_nextPoint()\n\t\t\tend\n\t\tend\n\telseif sub == \"land\" then\n\t\tif self:_advance(dt) then\n\t\t\twasp.mode = \"walking\"\n\t\t\twasp.normal = UP\n\t\t\tself.openPos = wasp.position\n\t\t\tself:_shake(\"heavy landing\")\n\t\t\tself:_log(\"landed\")\n\t\t\tself:_signal({ kind = \"landed\", at = wasp.position })\n\t\t\tself.sub = \"walk\"\n\t\t\tself.subS = Data.walkS\n\t\t\tself.stepS = Data.stepEveryS\n\t\t\tself.walkDir = rotateY(FORWARD, self.rng:range(0.0, TAU))\n\t\tend\n\telseif sub == \"walk\" then\n\t\twasp.search = 1.0\n\t\tself:_walk(dt)\n\t\tself.subS -= dt\n\t\tif self.subS <= 0.0 then\n\t\t\tself.sub = \"takeoff\"\n\t\t\tlocal up = wasp.position + UP * 1.2\n\t\t\tself.path = { wasp.position, up }\n\t\t\tself.pathI = 2\n\t\t\tself.speed = Data.flySpeed * 0.5\n\t\t\twasp.mode = \"flying\"\n\t\tend\n\telseif sub == \"takeoff\" then\n\t\tif self:_advance(dt) then\n\t\t\tself.openPos = wasp.position\n\t\t\tself:_nextPoint()\n\t\tend\n\tend\nend\n\n-- A few steps along the surface it stands on, turning back where it would step off.\nfunction WaspDirector._walk(self: any, dt: number)\n\tlocal wasp = self.wasp\n\tlocal p: Vector3 = wasp.position\n\tlocal nxt = p + self.walkDir * Data.walkSpeed * dt\n\tif not self.world.ray(nxt + UP * 0.3, nxt + DOWN * 0.8) or not self:_clear(p, nxt, Data.walkRadius) then\n\t\tself.walkDir = -self.walkDir\n\t\tnxt = p\n\tend\n\tself:_moveTo(nxt, self.walkDir, dt)\n\tself.stepS -= dt\n\tif self.stepS <= 0.0 then\n\t\tself.stepS = Data.stepEveryS\n\t\tself:_shake(\"heavy footsteps\")\n\tend\nend\n\nfunction WaspDirector._nextPoint(self: any)\n\tif self.station then\n\t\t-- A complete circuit through both rooms, rather than repeatedly choosing\n\t\t-- the nearest few sites. Unreachable authored sites are skipped, never\n\t\t-- reached by teleporting through their support or a wall.\n\t\tfor _=1,#self.points do\n\t\t\tself.point=self.point%#self.points+1\n\t\t\tlocal path=self.station.route(self.wasp.position,self.points[self.point].hover)\n\t\t\tif #path>1 then\n\t\t\t\tself.path=path;self.pathI=2;self.speed=12;self.sub=\"fly\";return\n\t\t\tend\n\t\tend\n\t\tself.sub=\"hover\";self.subS=2;return\n\tend\n\ttable.insert(self.recent, self.point)\n\twhile #self.recent > 3 do table.remove(self.recent, 1) end\n\tlocal here: Vector3 = self.wasp.position\n\tlocal choices: { number } = {}\n\tfor i, pt in self.points do\n\t\tif table.find(self.recent, i) then continue end\n\t\tlocal hover: Vector3 = pt.hover\n\t\tlocal loss: Vector3? = self.lossPos\n\t\tif loss ~= nil and (hover - loss).Magnitude < Data.farFromLossWu then continue end\n\t\ttable.insert(choices, i)\n\tend\n\tif #choices == 0 then table.insert(choices, (self.point % #self.points) + 1) end\n\t-- A local search: the nearer half of the places it has not just looked at.\n\ttable.sort(choices, function(a: number, b: number): boolean\n\t\treturn (here - self.points[a].hover).Magnitude < (here - self.points[b].hover).Magnitude\n\tend)\n\tlocal count = math.max(1, (#choices + 1) // 2)\n\tself.point = choices[self.rng:int(1, count)]\n\tself:_flyTo(self.points[self.point].hover, Data.flySpeed)\n\tself.sub = \"fly\"\nend\n\n-- ---------------------------------------------------------------------------------------------------------------- seeing the spider\n\n-- Whether it can see the spider now: in range, nothing in the way, and not in the retreat.\nfunction WaspDirector.canSeeSpider(self: any): boolean\n\tlocal s: Spider? = self.spider\n\tif s == nil or self.holding or not self.wasp.visible then return false end\n\tif self.protected then return false end\n\tif self.world.inRetreat(s.position) then return false end\n\tlocal eye = self:eyePosition()\n\tif (eye - s.position).Magnitude > Data.sightWu then return false end\n\treturn not self.world.ray(eye, s.position)\nend\n\nfunction WaspDirector.eyePosition(self: any): Vector3\n\treturn self.wasp.position + self.wasp.heading * Data.eyeAhead\nend\n\n-- How fast notice grows now (per second) if it can see the spider.\nfunction WaspDirector.noticeRate(self: any): number\n\tlocal s: Spider = self.spider\n\tlocal d = (self:eyePosition() - s.position).Magnitude\n\tlocal walk = math.max(s.walkSpeed, 0.1)\n\tlocal motion = math.clamp(s.velocity.Magnitude / walk, 0.0, 1.5)\n\tif s.airborne then motion = 1.5 end\n\t-- (ROBLOX-106: `cover`, the standard rules' cover factor the client hands in with the spider, Life/Nature.cover; absent, 1, as Godot's)\n\tlocal cover = if self:natural() and type(s.cover) == \"number\" then s.cover else 1\n\treturn (self.noticeScale or 1) * cover * (Data.noticeStill + Data.noticeMoving * motion) * math.max(1.0 - d / Data.sightWu, 0.0)\nend\n\nfunction WaspDirector._look(self: any, dt: number)\n\tif self.confusedS > 0.0 then\n\t\tself.confusedS -= dt\n\t\treturn\n\tend\n\tif self:canSeeSpider() then\n\t\tself.notice += self:noticeRate() * dt\n\t\tself.lastSeen = (self.spider :: Spider).position\n\telse\n\t\tself.notice = math.max(self.notice - Data.noticeDecay * dt, 0.0)\n\tend\nend\n\nfunction WaspDirector._beginInspecting(self: any)\n\tself.notice = 1.0\n\tself.noticedThisVisit = true\n\tself.unseenS = 0.0\n\tself.holdS = 0.0\n\tif self.wasp.mode == \"walking\" then self.wasp.mode = \"flying\" end\n\tself:_setPhase(\"inspecting\")\n\tself:_log(\"noticed\")\n\tself:_signal({ kind = \"noticed\", at = self.lastSeen })\nend\n\n-- Comes to look: to arm's length from where it last saw the spider, then holds there, antennae busy, for INSPECT_S, then strikes. A\n-- jump, a drop, the retreat, or the spider out of sight for LOSE_UNSEEN_S, and it has lost it.\nfunction WaspDirector._inspect(self: any, dt: number)\n\tlocal s: Spider = self.spider\n\tlocal wasp = self.wasp\n\twasp.mode = \"flying\"\n\twasp.search = 1.0\n\tif self.world.inRetreat(s.position) then\n\t\tself:_lose(\"hid\")\n\t\treturn\n\tend\n\tif s.airborne then\n\t\tself:_lose(\"jumped\")\n\t\treturn\n\tend\n\tif s.falling then\n\t\tself:_lose(\"dropped\")\n\t\treturn\n\tend\n\tif self:canSeeSpider() then\n\t\tself.unseenS = 0.0\n\t\tself.lastSeen = s.position\n\telse\n\t\tself.unseenS += dt\n\t\tif self.unseenS > Data.loseUnseenS then\n\t\t\tself:_lose(\"out of sight\")\n\t\t\treturn\n\t\tend\n\tend\n\tif self.phaseS > Data.inspectGiveUpS then\n\t\tself:_lose(\"out of reach\")\n\t\treturn\n\tend\n\tlocal away: Vector3 = wasp.position - self.lastSeen\n\tif away.Magnitude < 1e-3 then away = UP end\n\tlocal standoff = self.lastSeen + away.Unit * Data.standoffWu\n\tlocal to = standoff - wasp.position\n\tlocal step = Data.inspectSpeed * dt\n\tlocal face = self.lastSeen - wasp.position\n\tif to.Magnitude > 0.05 then\n\t\tlocal nxt = wasp.position + (if to.Magnitude > step then to.Unit * step else to)\n\t\tif self:_clear(wasp.position, nxt, Data.radius) then\n\t\t\tself:_moveTo(nxt, face, dt)\n\t\telse\n\t\t\tself:_moveTo(wasp.position, face, dt)\n\t\tend\n\t\tself.holdS = math.max(self.holdS - dt, 0.0)\n\telse\n\t\tself:_moveTo(wasp.position, face, dt)\n\t\tself.holdS += dt\n\t\tif self.holdS >= Data.inspectS * (self.inspectScale or 1) then\n\t\t\tself.strikeFrom = wasp.position\n\t\t\tself.strikeTo = s.position\n\t\t\tself:_setPhase(\"striking\")\n\t\t\tself:_log(\"strike\")\n\t\tend\n\tend\nend\n\nfunction WaspDirector._strike(self: any, dt: number)\n\tlocal k = math.clamp(self.phaseS / Data.strikeS, 0.0, 1.0)\n\tlocal nextPos=self.strikeFrom:Lerp(self.strikeTo,k)\n\tif self.station and (self.protected or not self:_clear(self.wasp.position,nextPos,Data.radius)) then self:_lose(\"blocked\");return end\n\tself:_moveTo(nextPos, self.strikeTo - self.strikeFrom, dt)\n\tif k < 1.0 then return end\n\tlocal s: Spider = self.spider\n\tif (self.wasp.position - s.position).Magnitude <= Data.catchWu and not self.world.inRetreat(s.position) and not s.airborne then\n\t\tif self.gentle then self:_spare() else self:_catch() end\n\telse\n\t\tself:_lose(\"missed\")\n\tend\nend\n\n-- Gentle rules (Godot round 5: Easy and free play): the wasp touches the spider with its antennae and gives up on it, and leaves. The game sets `gentle`\n-- for Easy and Free play.\nfunction WaspDirector._spare(self: any)\n\tself.sparedThisVisit = true\n\tself:_log(\"spared\")\n\tself:_signal({ kind = \"lost\", why = \"spared\" })\n\tself:_beginLeaving()\nend\n\nfunction WaspDirector._catch(self: any)\n\tlocal wasp = self.wasp\n\tself.holding = true\n\twasp.mode = \"holding\"\n\twasp.search = 0.0\n\tlocal p: Vector3 = wasp.position\n\tself.path = { p, p + UP * 2.5, Data.over }\n\tif self.station then self.path=self.station.route(p,self.station.entry) end\n\tself.pathI = 2\n\tself.speed = pathLength(self.path) / Data.carryS\n\tself:_setPhase(\"carrying\")\n\tself:_log(\"caught\")\n\tself:_holdSpider()\n\tself:_signal({ kind = \"caught\" })\nend\n\nfunction WaspDirector._holdSpider(self: any)\n\tif self.holding then self.heldAt = self.wasp.position + DOWN * Data.holdBelow end\nend\n\nfunction WaspDirector._lose(self: any, why: string)\n\tself.lossPos = self.lastSeen\n\tself.notice = Data.afterLossNotice\n\tself.confusedS = Data.confuseS\n\tself:_setPhase(\"searching\")\n\tself:_log(\"lost:\" .. why)\n\tself:_signal({ kind = \"lost\", why = why })\n\tself:_nextPoint()\nend\n\nfunction WaspDirector._beginLeaving(self: any)\n\tif self.station then\n\t\t-- It abandons this hunt, not its home. The recovery/confusion interval\n\t\t-- still gives the spider time to get clear before the next patrol leg.\n\t\tif self.noticedThisVisit then self.escapes+=1 end\n\t\tself.noticedThisVisit=false;self.notice=0;self.confusedS=Data.confuseS\n\t\tself.searchLeft=Data.searchS*(self.searchScale or 1)\n\t\tself:_setPhase(\"searching\");self:_nextPoint()\n\t\tif self.rivalChance and self.rng:unit()<self.rivalChance then self:_beginTaking() end\n\t\treturn\n\tend\n\tlocal p: Vector3 = self.wasp.position\n\tlocal path = self:_route(p, Data.over)\n\ttable.insert(path, Data.entry)\n\tself.path = path\n\tself.pathI = 2\n\tself.speed = pathLength(path) / Data.leaveS\n\tself.wasp.mode = \"flying\"\n\tself.wasp.search = 0.0\n\tself:_setPhase(\"leaving\")\n\tself:_log(\"leaving\")\nend\n\n-- ---------------------------------------------------------------------------------------------------------------- the rival male (ROBLOX-70)\n\n-- Sets off for the rival, if there is a free one on the sill out of the retreat and a way to hang over it: true, and the visit is for the rival\n-- (it does not look for the spider, and the spider is spared that day). False: the visit goes on as any other.\nfunction WaspDirector._beginTaking(self: any): boolean\n\tlocal r = self.rivalNow\n\tif r == nil or not r.present or self.world.inRetreat(r.position) then return false end\n\tlocal D = Data.rival\n\tlocal top: Vector3 = r.position + r.up * D.aboveWu\n\tlocal low: Vector3 = r.position + r.up * 0.5\n\tfor _, off in D.offsets do\n\t\tlocal c = top + Vector3.new(off[1], 0, off[2])\n\t\tlocal sky = Vector3.new(c.X, math.max(Data.cruiseY, c.Y), c.Z)\n\t\tif not self.world.inRetreat(c) and self:_clear(sky, c, Data.radius) and self:_clear(c, low, D.clearRadius) then\n\t\t\tself.path = self:_route(self.wasp.position, c)\n\t\t\tself.pathI = 2\n\t\t\tself.speed = D.flySpeed\n\t\t\tself.takeSub = \"fly\"\n\t\t\tself.takeOpen = c\n\t\t\tself.wasp.mode = \"flying\"\n\t\t\tself.wasp.search = 0.0\n\t\t\tself:_setPhase(\"taking\")\n\t\t\tself:_log(\"taking\")\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\n-- The rival is gone (the spider caught it, say) before the wasp has it: the visit goes on as a search.\nfunction WaspDirector._abortTaking(self: any)\n\tself.takeRival = false\n\tself.openPos = self.takeOpen\n\tself.wasp.mode = \"flying\"\n\tself:_setPhase(\"searching\")\n\tself:_log(\"rival gone\")\n\tself:_nextPoint()\nend\n\nfunction WaspDirector._take(self: any, dt: number)\n\tlocal r = self.rivalNow\n\tif r == nil or not r.present then\n\t\tself:_abortTaking()\n\t\treturn\n\tend\n\tif self.takeSub == \"fly\" then\n\t\tif self:_advance(dt) then\n\t\t\tself.takeSub = \"hover\"\n\t\t\tself.subS = Data.rival.hoverS\n\t\tend\n\t\treturn\n\tend\n\tlocal wasp = self.wasp\n\tself:_moveTo(wasp.position, r.position - wasp.position, dt)\n\tself.subS -= dt\n\tif self.subS <= 0.0 then\n\t\tself.strikeFrom = wasp.position\n\t\tself.strikeTo = r.position + r.up * 0.2\n\t\tself:_setPhase(\"seizing\")\n\t\tself:_log(\"seize\")\n\tend\nend\n\nfunction WaspDirector._seize(self: any, dt: number)\n\tlocal r = self.rivalNow\n\tif r == nil or not r.present then\n\t\tself:_abortTaking()\n\t\treturn\n\tend\n\tlocal k = math.clamp(self.phaseS / Data.rival.strikeS, 0.0, 1.0)\n\tself:_moveTo(self.strikeFrom:Lerp(self.strikeTo, k), self.strikeTo - self.strikeFrom, dt)\n\tif k < 1.0 then return end\n\tlocal wasp = self.wasp\n\tif (wasp.position - r.position).Magnitude > Data.rival.catchWu then\n\t\tself:_abortTaking()\n\t\treturn\n\tend\n\tself.holdingRival = true\n\twasp.mode = \"holding\"\n\twasp.search = 0.0\n\tlocal p: Vector3 = wasp.position\n\tself.path = { p, p + UP * 2.5, Data.over }\n\tself.pathI = 2\n\tself.speed = pathLength(self.path) / Data.carryS\n\tif self.station then\n\t\tself.path=self.station.route(p,self.station.entry)\n\t\tself.speed=pathLength(self.path)/Data.carryS\n\tend\n\tself:_setPhase(\"bearing\")\n\tself:_log(\"seized\")\n\tself:_holdRival()\n\tself:_signal({ kind = \"rival_seized\", at = p })\nend\n\nfunction WaspDirector._holdRival(self: any)\n\tif self.holdingRival then self.rivalHeldAt = self.wasp.position + DOWN * Data.holdBelow end\nend\n\n-- ---------------------------------------------------------------------------------------------------------------- paths and the world\n\nfunction WaspDirector._flyTo(self: any, to: Vector3, speed: number)\n\tself.path = self:_route(self.wasp.position, to)\n\tself.pathI = 2\n\tself.speed = speed\nend\n\n-- Up to cruising height (from somewhere open above it), across, and down to `to`.\nfunction WaspDirector._route(self: any, from: Vector3, to: Vector3): { Vector3 }\n\tif self.station then return self.station.route(from,to) end\n\tlocal path: { Vector3 } = { from }\n\tlocal start = from\n\tif from.Y < Data.cruiseY and not self:_clear(from, Vector3.new(from.X, Data.cruiseY, from.Z), Data.radius) then\n\t\ttable.insert(path, self.openPos)\n\t\tstart = self.openPos\n\tend\n\tif start.Y < Data.cruiseY then table.insert(path, Vector3.new(start.X, Data.cruiseY, start.Z)) end\n\tif to.Y < Data.cruiseY then table.insert(path, Vector3.new(to.X, Data.cruiseY, to.Z)) end\n\ttable.insert(path, to)\n\treturn path\nend\n\n-- Moves along the path at the current speed; true at its end.\nfunction WaspDirector._advance(self: any, dt: number): boolean\n\tlocal wasp = self.wasp\n\tlocal p: Vector3 = wasp.position\n\tlocal left = self.speed * dt\n\tlocal path: { Vector3 } = self.path\n\twhile self.pathI <= #path and left > 0.0 do\n\t\tlocal target = path[self.pathI]\n\t\tlocal d = (target - p).Magnitude\n\t\tif d <= left then\n\t\t\tp = target\n\t\t\tleft -= d\n\t\t\tself.pathI += 1\n\t\telse\n\t\t\tp += (target - p) / d * left\n\t\t\tleft = 0.0\n\t\tend\n\tend\n\tlocal dir = p - wasp.position\n\tif self.station and not self:_clear(wasp.position,p,Data.radius) then\n\t\tself.pathI=#path+1;p=wasp.position;dir=Vector3.zero\n\tend\n\tself:_moveTo(p, if dir.Magnitude > 1e-5 then dir else wasp.heading, self.dt)\n\treturn self.pathI > #path\nend\n\n-- True when a sphere of `radius` moves from `a` to `b` without touching the world.\nfunction WaspDirector._clear(self: any, a: Vector3, b: Vector3, radius: number): boolean\n\tif (a - b).Magnitude < 1e-5 then return true end\n\treturn self.world.clear(a, b, radius)\nend\n\n-- ---------------------------------------------------------------------------------------------------------------- the actor (wasp.gd)\n\n-- Places it and faces it along `dir` (flattened), and works out its velocity from where it was.\nfunction WaspDirector._moveTo(self: any, p: Vector3, dir: Vector3, dt: number)\n\tlocal wasp = self.wasp\n\twasp.position = p\n\twasp.velocity = if dt > 0.0 then (p - wasp.prev) / dt else Vector3.new(0, 0, 0)\n\twasp.prev = p\n\tlocal flat = Vector3.new(dir.X, 0.0, dir.Z)\n\tif flat.Magnitude > 1e-4 then wasp.heading = flat.Unit end\nend\n\n-- Puts it somewhere without a velocity (its first appearance).\nfunction WaspDirector._place(self: any, p: Vector3)\n\tself.wasp.position = p\n\tself.wasp.prev = p\n\tself.wasp.velocity = Vector3.new(0, 0, 0)\nend\n\n-- What the spider's senses get of it: movement, never prey (its percept is capped at movement, so no aim, capture or inspection ever\n-- treats it as something to catch). Nil while it is away.\nfunction WaspDirector.percept(self: any): any\n\tlocal w = self.wasp\n\tif not w.visible then return nil end\n\treturn { id = \"wasp\", position = w.position, radius = Data.sensedRadius, velocity = w.velocity, maxCategory = \"movement\" }\nend\n\nfunction WaspDirector._shake(self: any, kind: string)\n\tself:_signal({ kind = \"shake\", shake = kind, at = self.wasp.position + DOWN * 0.35 })\nend\n\nfunction WaspDirector._setPhase(self: any, p: string)\n\tself.phase = p\n\tself.phaseS = 0.0\nend\n\nfunction WaspDirector._log(self: any, kind: string)\n\ttable.insert(self.events, { kind = kind, t = self.visitS })\nend\n\nfunction WaspDirector._signal(self: any, s: Signal)\n\ttable.insert(self.signals, s)\nend\n\n-- The signals since the last call, oldest first: visit_started, shake (a landing or a footstep), landed, noticed, lost, caught,\n-- carried_off, left.\nfunction WaspDirector.drainSignals(self: any): { Signal }\n\tlocal out = self.signals\n\tself.signals = {}\n\treturn out\nend\n\n-- ---------------------------------------------------------------------------------------------------------------- checkpoints\n\n-- Kept in checkpoints: the day of the last visit, which of that day's visits it was, and how many visits and escapes this life has had. A\n-- visit going on is not kept, because the spider rests in the crack where the wasp cannot find it. A return to a rest therefore meets the\n-- day's remaining visits and never a repeat of the ones had (their hours come from the seed and the day, so nothing is drawn again).\nfunction WaspDirector.toRecord(self: any): { [string]: number }\n\treturn { last_visit_day = self.lastVisitDay, last_visit_slot = self.lastVisitSlot, visits = self.visits, escapes = self.escapes }\nend\n\n-- The record of a life the wasp has not yet visited.\nfunction WaspDirector.defaultRecord(): { [string]: number }\n\treturn { last_visit_day = 0, last_visit_slot = 0, visits = 0, escapes = 0 }\nend\n\n-- Puts a record back and ends any visit going on (the wasp is away and the spider is no longer held).\nfunction WaspDirector.load(self: any, d: any)\n\tself.lastVisitDay = math.floor(tonumber(d.last_visit_day) or 0)\n\t-- A record from before there were two visits a day does not say which one it was: it counts as the day's last, so no visit is repeated.\n\tself.lastVisitSlot = if type(d.last_visit_slot) == \"number\" then math.floor(d.last_visit_slot) else (if self.lastVisitDay > 0 then WaspDirector.MAX_SLOTS else 0)\n\tself.visits = math.floor(tonumber(d.visits) or 0)\n\tself.escapes = math.floor(tonumber(d.escapes) or 0)\n\tself:clearVisit()\nend\n\n-- Ends the visit, if any: away, hidden, nothing held. (A return to a rest, a new life.)\nfunction WaspDirector.clearVisit(self: any)\n\tself.phase = \"away\"\n\tself.phaseS = 0.0\n\tself.visitS = 0.0\n\tself.notice = 0.0\n\tself.confusedS = 0.0\n\tself.holding = false\n\tself.heldAt = nil\n\tself.holdingRival, self.rivalHeldAt, self.takeRival = false, nil, false\n\tself.wasp.visible = false\n\tself.signals = {}\n\tself.events = {}\nend\n\nfunction WaspDirector.problems(d: any): { string }\n\tlocal out: { string } = {}\n\tif type(d) ~= \"table\" then\n\t\ttable.insert(out, \"wasp: not a record\")\n\t\treturn out\n\tend\n\tfor _, key in { \"last_visit_day\", \"visits\", \"escapes\" } do\n\t\tlocal v = d[key]\n\t\tif type(v) ~= \"number\" or v ~= v or v < 0 or v ~= math.floor(v) then\n\t\t\ttable.insert(out, `wasp: {key} must be a whole number, not negative`)\n\t\tend\n\tend\n\tlocal slot = d.last_visit_slot -- optional: a record from before two visits a day has none\n\tif slot ~= nil and (type(slot) ~= \"number\" or slot ~= math.floor(slot) or slot < 0 or slot > WaspDirector.MAX_SLOTS) then\n\t\ttable.insert(out, `wasp: last_visit_slot must be a whole number from 0 to {WaspDirector.MAX_SLOTS}`)\n\tend\n\tif #out == 0 and d.escapes > d.visits then table.insert(out, \"wasp: more escapes than visits\") end\n\treturn out\nend\n\nreturn WaspDirector\n",38964,3336515833},{"Shared/Prey/Ant","--!strict\n-- Ants (ROBLOX-119, the meadow's edge): ambient, not food. Small brown field ants of a hill in the meadow (World/Meadow.HILL, meadow_b4), out on its floor by day on a\n-- seeded wander that keeps within `range` of the hill and turns back to it now and then, and in their nest from dusk to morning (not drawn). They pay the spider no heed.\n-- Jumping spiders leave ants alone, and the ant-mimicking spider's page says why; here a strike at one is refused (Prey/PreyWorld, UI/PreyText) and it runs on. Pure and\n-- seeded, no raycast; a checkpoint records the colony with the region's prey (Persistence/Checkpoint). The speeds and the sizes are the game's.\nlocal R = require(script.Parent.PreyRandom)\n\nlocal Ants = {}\nAnts.__index = Ants\n\nAnts.HOVER = 0.12 -- the body's middle over the floor: low on its legs\nAnts.BODY = 0.4 -- studs long: an ant of about 4 mm\nAnts.RADIUS = 0.2\nAnts.WALK = { 1.6, 2.6 } -- studs a second: brisk\nAnts.EDGE = 1.5\nAnts.NIGHT = { from = 19.5, to = 7.5 } -- in the nest\n\n-- `spec`: World/Meadow.ambient's (kind \"ant\", `home` the hill's way in, `range` round the hill's `centre`); `count`: the tier's; `soil` and `boxes` as the woodlice's.\nfunction Ants.new(spec: any, count: number, soil: { min: Vector3, max: Vector3 }?, boxes: { { min: Vector3, max: Vector3 } }?): any\n\tlocal self: any = setmetatable({ kind = \"ant\", rng = R.new(spec.seed + 6007), now = 0, items = {}, boxes = {}, home = spec.home, centre = spec.centre or spec.home, range = spec.range or 40 }, Ants)\n\tif soil ~= nil then self.soilMin, self.soilMax, self.top = soil.min, soil.max, soil.max.Y else self.top = spec.home.Y end\n\tfor _, b in (boxes or {}) :: { any } do table.insert(self.boxes, { min = b.min, max = b.max }) end\n\tfor i, s in spec.starts do\n\t\tif i > count then break end\n\t\tlocal surf = Vector3.new(s.pos.X, self.top, s.pos.Z)\n\t\tlocal pos = surf + Vector3.yAxis * Ants.HOVER\n\t\ttable.insert(self.items, {\n\t\t\tid = (spec.prefix or \"\") .. \"ant_\" .. i, kind = \"ant\", surface = surf, position = pos, prevPosition = pos, normal = Vector3.yAxis, heading = s.heading,\n\t\t\tspeed = self.rng:draw(Ants.WALK), state = \"walk\", until_ = 0, nextTurn = self.rng:draw({ 0.4, 1.4 }), hidden = false,\n\t\t})\n\tend\n\treturn self\nend\n\n-- Whether a point of the floor is free to walk: on the soil, within its range of the hill, clear of what stands there.\nfunction Ants.free(self: any, p: Vector3): boolean\n\tif self.soilMin ~= nil and (p.X < self.soilMin.X + Ants.EDGE or p.X > self.soilMax.X - Ants.EDGE or p.Z < self.soilMin.Z + Ants.EDGE or p.Z > self.soilMax.Z - Ants.EDGE) then return false end\n\tif (Vector3.new(p.X - self.centre.X, 0, p.Z - self.centre.Z)).Magnitude > self.range then return false end\n\tfor _, b in self.boxes do\n\t\tif p.X > b.min.X - 0.4 and p.X < b.max.X + 0.4 and p.Z > b.min.Z - 0.4 and p.Z < b.max.Z + 0.4 then return false end\n\tend\n\treturn true\nend\n\nlocal function turned(h: Vector3, degrees: number): Vector3\n\treturn CFrame.fromAxisAngle(Vector3.yAxis, math.rad(degrees)):VectorToWorldSpace(h).Unit\nend\nlocal function night(hour: number?): boolean\n\treturn hour ~= nil and (hour >= Ants.NIGHT.from or hour < Ants.NIGHT.to)\nend\n\n-- One fixed tick. The spider is ignored. `ctx.hour`: the life clock's hour (nil: day).\nfunction Ants.step(self: any, dt: number, _spider: Vector3, ctx: any)\n\tself.now += dt\n\tlocal now = self.now\n\tlocal home = Vector3.new(self.home.X, self.top, self.home.Z)\n\tlocal inNest = night(if ctx ~= nil then ctx.hour else nil)\n\tfor _, a in self.items do\n\t\ta.prevPosition = a.position\n\t\tif a.state == \"away\" then\n\t\t\tif not inNest then\n\t\t\t\t-- out of the nest at its way in\n\t\t\t\ta.state, a.hidden = \"walk\", false\n\t\t\t\ta.surface = home\n\t\t\t\ta.position = home + Vector3.yAxis * Ants.HOVER\n\t\t\t\ta.prevPosition = a.position\n\t\t\tend\n\t\t\tcontinue\n\t\tend\n\t\tif inNest then\n\t\t\t-- back to the way in, and in\n\t\t\tlocal to = home - a.surface\n\t\t\tif to.Magnitude <= 0.4 then a.state, a.hidden = \"away\", true; continue end\n\t\t\ta.heading = to.Unit\n\t\t\ta.surface += a.heading * math.min(to.Magnitude, a.speed * dt)\n\t\t\ta.position = a.surface + Vector3.yAxis * Ants.HOVER\n\t\t\tcontinue\n\t\tend\n\t\tif a.state == \"pause\" then\n\t\t\tif now >= a.until_ then a.state = \"walk\" end\n\t\t\tcontinue\n\t\tend\n\t\tif now >= a.nextTurn then\n\t\t\t-- a turn, now and then back toward the hill (the trail home)\n\t\t\tlocal back = home - a.surface\n\t\t\tif self.rng:next() < 0.25 and back.Magnitude > 2 then a.heading = Vector3.new(back.X, 0, back.Z).Unit\n\t\t\telse a.heading = turned(a.heading, self.rng:draw({ -50, 50 })) end\n\t\t\ta.nextTurn = now + self.rng:draw({ 0.4, 1.4 })\n\t\t\tif self.rng:next() < 0.12 then a.state = \"pause\"; a.until_ = now + self.rng:draw({ 0.3, 1.2 }); continue end\n\t\tend\n\t\tlocal nextPos = a.surface + a.heading * (a.speed * dt)\n\t\tif self:free(nextPos) then\n\t\t\ta.surface = nextPos\n\t\t\ta.position = nextPos + Vector3.yAxis * Ants.HOVER\n\t\telse\n\t\t\ta.heading = turned(a.heading, self.rng:draw({ 100, 200 }))\n\t\tend\n\tend\nend\n\n-- What a strike may hit: an ant out of the nest.\nfunction Ants.targets(self: any): { any }\n\tlocal out = {}\n\tfor _, a in self.items do\n\t\tif not a.hidden then table.insert(out, { creature = a, position = a.position, radius = Ants.RADIUS }) end\n\tend\n\treturn out\nend\n\n-- Struck: it turns and runs on, faster for a while.\nfunction Ants.struck(self: any, a: any)\n\ta.heading = -a.heading\n\ta.speed = Ants.WALK[2] * 1.3\n\ta.state = \"walk\"\n\ta.nextTurn = self.now + 1.5\nend\n\nfunction Ants.creatures(self: any): { any } return self.items end\n\nfunction Ants.problems(self: any, lo: Vector3, hi: Vector3): { string }\n\tlocal out: { string } = {}\n\tlocal states = { away = true, walk = true, pause = true }\n\tif type(self.items) ~= \"table\" then return { \"ants: no list\" } end\n\tfor i, a in self.items do\n\t\tif type(a) ~= \"table\" or not states[a.state] then table.insert(out, `ants: {i} is in no known state`); continue end\n\t\tlocal p = a.position\n\t\tif (typeof(p) ~= \"Vector3\" and type(p) ~= \"table\") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then\n\t\t\ttable.insert(out, `ants: {i} is outside its region`)\n\t\tend\n\tend\n\treturn out\nend\n\nreturn Ants\n",6109,675326506},{"Shared/Prey/Feeding","--!strict\n-- Frozen feeding_controller.gd: struggle after landing, then conserved nutrition grants. The energy itself belongs to the\n-- NeedsModel (ROBLOX-24): each tick this advances it (active unless still on a surface, as Godot's controller does) and asks it\n-- to grant what the fly gave up, under the meal's capture key. `needs` is the sandbox model unless the owner gives it another\n-- (the client gives it the life one). taken/granted/ledger are this controller's own totals, kept as before.\n-- The struggle's three numbers (the grip a catch starts with, what a tap adds, the jerks' scale) are Godot's until useGameRules() gives it\n-- Data/Catch.game (ROBLOX-72); a controller never given them replays Godot, which the goldens check.\n-- ROBLOX-77: the struggle scales with the prey. A controller given the game's rules (useGameRules) also reads the caught prey's size from its\n-- profile and applies Catch.scaled(Catch.factorFor(profile)) at capture (the house fly is 1.0 and exactly ROBLOX-72's numbers; a fruit fly\n-- is easier). Three more fields hold Godot's remaining struggle numbers (drainScale 1, tire .5, cap 12) so that useRivalRules can give the\n-- rival's own; the struggle itself is `struggle`, which step runs and a second controller (Predator/RivalGrip) runs alone.\nlocal R=require(script.Parent.PreyRandom)\nlocal NeedsModel=require(script.Parent.Parent.Life.NeedsModel)\nlocal Catch=require(script.Parent.Parent.Data.Catch)\nlocal F={};F.__index=F\nfunction F.new(needs: any?): any\n return setmetatable({held=nil,struggling=false,feeding=false,grip=0,elapsed=0,waiting=0,jerk=0,venom=6,\n  swallow=0,needs=needs or NeedsModel.new(),taken=0,granted=0,ledger={},mealsFinished=0,auto=false,tap=false,note='',rng=R.new(513),\n  startGrip=.4,tapGain=.085,jerkScale=1,drainScale=1,tire=.5,cap=12,game=false,tapToFeed=false,biteWindow=0,bites=0,bitePulse=0},F)\nend\nlocal function apply(self: any,g: any)\n self.startGrip,self.tapGain,self.jerkScale=g.startGrip,g.tapGain,g.jerkScale\n self.drainScale,self.tire,self.cap=g.drainScale,g.tire,g.cap\nend\n-- Opt in to the game's struggle (Data/Catch.game): an easier tap, and a struggle that scales with the prey caught (applied at each capture).\nfunction F.useGameRules(self: any)\n apply(self,Catch.scaled(1));self.game=true\n -- ObjectRecord replaces tables on restore. Older rests have no presentation fields.\n self.bites=self.bites or 0;self.biteWindow=self.biteWindow or 0;self.bitePulse=self.bitePulse or 0\nend\n-- The rival's struggle (ROBLOX-77): its own numbers (Data/Catch.rival), or in the gentle modes the house fly's with no cap. Not scaled by a profile.\nfunction F.useRivalRules(self: any,gentle: boolean)\n apply(self,Catch.forRival(gentle));self.game=false\nend\nfunction F.capture(self: any,fly: any)\n if self.game and fly.profile then apply(self,Catch.scaled(Catch.factorFor(fly.profile))) end\n self.held=fly;self.struggling=true;self.feeding=false;self.grip=self.startGrip;self.elapsed=0;self.waiting=0\n self.biteWindow=0;self.bitePulse=0;self.tap=false\n self.venom=self.rng:draw({6,8});self.jerk=self.rng:draw({.35,.75});self.note='Caught!'\nend\nfunction F.press(self: any)\n if self.struggling then self.tap=true\n elseif self.held and self.tapToFeed and not self.auto then\n  -- A tap opens one bite, never a queue of free nutrition. The fixed tick validates posture.\n  self.biteWindow=.38;self.bitePulse=0;self.feeding=true\n elseif self.held and self.swallow<=0 then self.feeding=not self.feeding end -- nothing to eat: E is the retreat's (LifeLoop)\nend\nfunction F.cancel(self: any) self.feeding=false;self.biteWindow=0 end\n-- The struggle after a capture: waits up to a second for a landing, then the grip drains, jerks, rises with taps and ends in escape(f) (it tore\n-- free; held is nil) or subdued (struggling false). Needs nothing of the reserves, so a second controller can run it alone.\nfunction F.struggle(self: any,dt: number,attached: boolean,escape: (any)->())\n local f=self.held;if not f then self.tap=false;return end\n if not attached and self.waiting<1 then self.waiting+=dt;self.tap=false;return end\n self.elapsed+=dt\n local strength=1-(self.tire or .5)*math.clamp(self.elapsed/self.venom,0,1)\n self.grip-=.32*(self.drainScale or 1)*strength*dt\n self.jerk-=dt\n if self.jerk<=0 then self.grip-=.12*self.jerkScale*strength;self.jerk+=self.rng:draw({.35,.75}) end\n if self.auto then self.grip+=.4*dt end\n if self.tap then self.grip+=self.tapGain end\n self.tap=false\n if self.grip<=0 then self.held=nil;self.struggling=false;self.note='It tore free!';escape(f)\n elseif self.grip>=1 or self.elapsed>=(self.cap or 12) then self.grip=1;self.struggling=false;self.feeding=not self.tapToFeed or self.auto;self.swallow=if self.tapToFeed and not self.auto then 0 else 1;self.note='Subdued.' end\nend\nfunction F.step(self: any,dt: number,attached: boolean,moving: boolean,escape: (any)->())\n self.needs:advance(dt,not attached or moving)\n local f=self.held;if not f then self.tap=false;return end\n if self.struggling then self:struggle(dt,attached,escape);return end\n self.swallow=math.max(0,self.swallow-dt)\n if not attached or moving then self.feeding=false;self.biteWindow=0;return end\n if self.swallow>0 then self.feeding=true end\n local eatingDt=dt\n if self.tapToFeed and not self.auto then\n  eatingDt=math.min(dt,self.biteWindow)\n  self.biteWindow=math.max(0,self.biteWindow-dt)\n  self.feeding=eatingDt>0\n end\n if not self.feeding then return end\n -- Pulses only follow valid eating ticks, including the automatic accessibility path.\n self.bitePulse=(self.bitePulse or 0)-eatingDt\n if self.bitePulse<=0 then self.bites=(self.bites or 0)+1;self.bitePulse=.38 end\n local take=math.min(f.nutrition,f.profile.body.feed_rate_per_s*eatingDt)\n f.nutrition-=take\n local granted=self.needs:grantEnergy(take,f.captureKey)\n self.taken+=take;self.granted+=granted\n self.ledger[f.captureKey]=(self.ledger[f.captureKey] or 0)+granted\n if f.nutrition<=1e-9 then f.nutrition=0;f.state='CONSUMED';self.held=nil;self.feeding=false;self.mealsFinished+=1;self.note='Meal finished.' end\nend\nreturn F\n",6055,1666927766},{"Shared/Prey/Fly","--!strict\n-- Fly's evidence-owned decisions, reactions, flights, glances and surface bursts.\n-- Sources: frozen fly.gd and fly_mind.gd. Geometry and random stream are explicit dependencies.\n-- ROBLOX-96: a profile whose body says `walker` (the aphid, Data/Species) never launches: `launch` refuses every flight, so FlyFlight is never used for it, and\n-- startled it freezes on its perch instead of turning to face the threat. Godot's profiles have no such field, so nothing of theirs is touched.\n-- ROBLOX-101: the bestiary's behaviours are Prey/PreyKinds', called only for a profile that asks: a `hop` profile flees by a ballistic hop (state HOP, stepped\n-- by PreyKinds.step instead of FlyFlight) and a `flightless` one never begins a flight; a `sidestep` profile goes round its stem when watched; a profile with\n-- `flight.wander_local` keeps its wander loops near the height it flew from (the sill's 0.8 to 10 band is the sill's, and the wall and the bed are far below it).\n-- ROBLOX-117: a `hover` profile (the hoverfly) holds still in the air on a calm flight now and then (PreyKinds.hover) instead of stepping its flight.\n-- ROBLOX-120: a `hear` profile (the field cricket) is hushed by a spider moving near (PreyKinds.hear: it holds still), and a `freeze` one alert freezes as a walker does.\nlocal M=require(script.Parent.PreyMath)\nlocal S=require(script.Parent.FlySenses)\nlocal F=require(script.Parent.FlyFlight)\nlocal R=require(script.Parent.PreyRandom)\nlocal K=require(script.Parent.PreyKinds)\nlocal Fly={};Fly.__index=Fly\nfunction Fly.new(id: string,serial: number,seed: number,perch: any,graph: any,profile: any,now: number): any\n local f:any=setmetatable({id=id,serial=serial,profile=profile,graph=graph,rng=R.new(seed),senses=S.new(profile.senses),\n  position=graph:rest(perch),prevPosition=graph:rest(perch),normal=perch.normal,heading=Vector3.new(0,0,-1),velocity=Vector3.zero,\n  state='PERCHED',stateSince=now,goal='rest',goalSince=now,perch=perch,fatigue=0,restlessBias=0,\n  nextDecision=now+(serial*.0371)%(1/profile.behavior.decision_hz),nextGlance=now,nextWalk=now+2,nextGroom=now+6,groomUntil=0,\n  walkLeft=0,burstUntil=0,pauseUntil=0,walkSpeed=0,walk