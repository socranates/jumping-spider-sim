        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Surfaces</string>
            <string name="Source"><![CDATA[--!strict
-- GENERATED by tools/json_to_luau.py from data/surfaces/*.json. Do not edit by hand.
-- Surface profiles, looked up by a part's ProfileId attribute.
local data = {
	bare_wood_rough = {
		schema_version = 1,
		id = "bare_wood_rough",
		attachable = true,
		silk_anchor_allowed = true,
		adhesion_multiplier = 1.1,
		vibration_group = "lab_ledges",
		wetness_response_profile = "wood_default",
	},
	brick_rough = {
		schema_version = 1,
		id = "brick_rough",
		attachable = true,
		silk_anchor_allowed = true,
		adhesion_multiplier = 1.1,
		vibration_group = "lab_block",
		wetness_response_profile = "masonry_default",
	},
	glass_clean = {
		schema_version = 1,
		id = "glass_clean",
		attachable = true,
		silk_anchor_allowed = true,
		adhesion_multiplier = 0.8,
		vibration_group = "lab_glass",
		wetness_response_profile = "glass_default",
	},
	leaf_dry_prototype = {
		schema_version = 1,
		id = "leaf_dry_prototype",
		attachable = true,
		silk_anchor_allowed = true,
		adhesion_multiplier = 1.0,
		vibration_group = "planter_leaves",
		wetness_response_profile = "dry_only_prototype",
	},
	painted_ceiling = {
		schema_version = 1,
		id = "painted_ceiling",
		attachable = true,
		silk_anchor_allowed = true,
		adhesion_multiplier = 1.0,
		vibration_group = "lab_overhang",
		wetness_response_profile = "plaster_default",
	},
	painted_metal_smooth = {
		schema_version = 1,
		id = "painted_metal_smooth",
		attachable = true,
		silk_anchor_allowed = true,
		adhesion_multiplier = 0.9,
		vibration_group = "lab_platforms",
		wetness_response_profile = "metal_default",
	},
	painted_wood_dry = {
		schema_version = 1,
		id = "painted_wood_dry",
		attachable = true,
		silk_anchor_allowed = true,
		adhesion_multiplier = 1.0,
