      <Item class="Folder" referent="83">
        <Properties>
          <string name="Name">Rig</string>
        </Properties>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">Anatomy</string>
            <string name="Source"><![CDATA[--!strict
-- Where the parts of the body sit, worked out from the appearance table alone: pure, Vector3 only, so tests/look.luau checks
-- it. Body frame as in SpiderRig: +Y up, -Z forward. SpiderRig turns the layout into parts; Setae uses it to keep hairs off
-- the eyes and to grow the palps' fluff. Nothing here is placed by eye: eyes, cheeks and palps are found on the head's surface.

local Anatomy = {}

export type Eye = { name: string, side: number, at: Vector3, radii: Vector3, reflectance: number, principal: boolean }
export type Glint = { side: number, at: Vector3, radii: Vector3 }
export type Palp = { side: number, base: Vector3, tip: Vector3 }
export type Zone = { at: Vector3, radius: number }
export type Layout = {
	headCenter: Vector3, headRadii: Vector3,
	abdomenCenter: Vector3, abdomenRadii: Vector3,
	faceCenter: Vector3, faceRadii: Vector3,
	pedicelCenter: Vector3, pedicelRadii: Vector3,
	neck: Vector3,
	eyes: { Eye },
	glints: { Glint },
	cheeks: { { side: number, at: Vector3, radii: Vector3 } },
	jaws: { { side: number, at: Vector3, radii: Vector3 } },
	palps: { Palp },
	spinneret: Vector3,
	hairFree: { Zone },
}

local function v3(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end
Anatomy.v3 = v3

-- z of an ellipsoid's front (-Z) surface at lateral offsets x, y from its centre.
function Anatomy.frontZ(c: Vector3, r: Vector3, x: number, y: number): number
	local q = 1 - (x / r.X) ^ 2 - (y / r.Y) ^ 2
	return c.Z - r.Z * math.sqrt(math.max(q, 0))
end

-- y of an ellipsoid's top surface at offsets x, z from its centre.
function Anatomy.topY(c: Vector3, r: Vector3, x: number, z: number): number
	local q = 1 - (x / r.X) ^ 2 - (z / r.Z) ^ 2
	return c.Y + r.Y * math.sqrt(math.max(q, 0))
end

-- x of an ellipsoid's +X side surface at offsets y, z from its centre.
function Anatomy.sideX(c: Vector3, r: Vector3, y: number, z: number): number
	local q = 1 - (y / r.Y) ^ 2 - (z / r.Z) ^ 2
	return c.X + r.X * math.sqrt(math.max(q, 0))
end

-- Outward unit normal of an ellipsoid at a point on its surface.
function Anatomy.normalAt(c: Vector3, r: Vector3, p: Vector3): Vector3
	local d = p - c
	return Vector3.new(d.X / (r.X * r.X), d.Y / (r.Y * r.Y), d.Z / (r.Z * r.Z)).Unit
end

-- The point of an ellipsoid in direction `dir` (unit-sphere coordinates) and its outward normal.
function Anatomy.ellipsoidPoint(c: Vector3, r: Vector3, dir: Vector3): (Vector3, Vector3)
	local u = dir.Unit
	local p = c + Vector3.new(u.X * r.X, u.Y * r.Y, u.Z * r.Z)
	return p, Anatomy.normalAt(c, r, p)
end

function Anatomy.layout(look: any): Layout
	local hc, hr = v3(look.headCenter), v3(look.headRadii)
	local ac, ar = v3(look.abdomenCenter), v3(look.abdomenRadii)
	local e = look.eye
	local eyes: { Eye } = {}
	local glints: { Glint } = {}
	local zones: { Zone } = {}
	local function addEye(name: string, side: number, anchor: Vector3, r: Vector3, out: number, reflectance: number, principal: boolean): Vector3
		local n = Anatomy.normalAt(hc, hr, anchor)
		local at = anchor + n * (out * math.min(r.X, r.Y, r.Z))
		table.insert(eyes, { name = name, side = side, at = at, radii = r, reflectance = reflectance, principal = principal })
		table.insert(zones, { at = at, radius = math.max(r.X, r.Y, r.Z) * 1.15 + 0.012 })
		return at
	end
	for _, side in { -1, 1 } do
		-- Principal eyes on the front of the face, two catchlights each.
		local a = e.ame
		local ar3 = v3(a.radii)
		local ax, ay = side * a.x, a.y
		local anchor = Vector3.new(hc.X + ax, ay, Anatomy.frontZ(hc, hr, ax, ay - hc.Y))
		local at = addEye("PrincipalEye", side, anchor, ar3, a.out, a.reflectance, true)
		for _, g in a.glints do
			local depth = math.sqrt(math.max(1 - (g.dx / ar3.X) ^ 2 - (g.dy / ar3.Y) ^ 2, 0))
			local gz = -ar3.Z * depth
			table.insert(glints, {
				side = side,
				at = at + Vector3.new(g.dx, g.dy, gz - g.r * 0.2),
				radii = Vector3.new(g.r, g.r, g.r * 0.45),
			})
		end
		-- Anterior lateral eyes at the sides of the face.
		local l = e.ale
		local lx, ly = side * l.x, l.y
		addEye("Eye", side, Vector3.new(hc.X + lx, ly, Anatomy.frontZ(hc, hr, lx, ly - hc.Y)), Vector3.one * l.r, l.out, l.reflectance, false)
		-- Posterior lateral and median eyes on the dome.
		for _, d in { e.ple, e.pme } do
			local dx, dz = side * d.x, d.z
			addEye("Eye", side, Vector3.new(hc.X + dx, Anatomy.topY(hc, hr, dx, dz - hc.Z), dz), Vector3.one * d.r, d.out, d.reflectance, false)
		end
	end
	local cheeks, jaws, palps = {}, {}, {}
	local ch, cl, pl = look.cheek, look.chelicerae, look.palp
	for _, side in { -1, 1 } do
		local cx = Anatomy.sideX(hc, hr, ch.y - hc.Y, ch.z - hc.Z) - ch.inset
		table.insert(cheeks, { side = side, at = Vector3.new(side * cx, ch.y, ch.z), radii = v3(ch.radii) })
		local jaw = Vector3.new(side * cl.x, cl.y, cl.z)
		table.insert(jaws, { side = side, at = jaw, radii = v3(cl.radii) })
		table.insert(zones, { at = jaw, radius = math.max(cl.radii[1], cl.radii[2], cl.radii[3]) * 1.1 + 0.01 })
		local px = side * pl.x
		local base = Vector3.new(px, pl.y, Anatomy.frontZ(hc, hr, px, pl.y - hc.Y))
		table.insert(palps, { side = side, base = base, tip = base + Vector3.new(side * pl.spread, -pl.drop, -pl.reach) })
	end
	return {
		headCenter = hc, headRadii = hr, abdomenCenter = ac, abdomenRadii = ar,
		faceCenter = v3(look.face.center), faceRadii = v3(look.face.radii),
		pedicelCenter = v3(look.pedicel.center), pedicelRadii = v3(look.pedicel.radii),
		neck = v3(look.neck),
		eyes = eyes, glints = glints, cheeks = cheeks, jaws = jaws, palps = palps,
		spinneret = Vector3.new(0, ac.Y + 0.02, ac.Z + ar.Z - 0.005),
		hairFree = zones,
	}
end

return Anatomy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">Idle</string>
            <string name="Source"><![CDATA[--!strict
-- Idle motion for the drawn spider (display only, never fed back into movement): a slow breathing bob, a small curious head
-- tilt and the palps' drumming. Pure functions of time so tests/look.luau can check them. All knobs: Appearances.idle / .palp.
-- `calm` is 0..1: SpiderRig eases it up after the spider has stood still for a moment and back to 0 as soon as it moves.

local Idle = {}

export type Pose = {
	bodyLift: number, -- studs: the whole body rises with a breath
	abdomenLift: number, -- studs: the abdomen rises a little more
	abdomenPitch: number, -- radians, rear end up
	headRoll: number, headYaw: number, headPitch: number, -- radians
}

local TAU = math.pi * 2

function Idle.pose(t: number, calm: number, cfg: any): Pose
	local b, k = cfg.breathe, cfg.tilt
	local breath = math.sin(TAU * t / b.period) * (0.85 + 0.15 * math.sin(TAU * t / (b.period * 2.7) + 0.6))
	local p = k.periods
	return {
		bodyLift = b.bodyLift * breath * calm,
		abdomenLift = b.lift * breath * calm,
		abdomenPitch = math.rad(b.pitchDeg) * breath * calm,
		headRoll = math.rad(k.rollDeg) * calm * (0.65 * math.sin(TAU * t / p[1]) + 0.35 * math.sin(TAU * t / p[2] + 1.1)),
		headYaw = math.rad(k.yawDeg) * calm * (0.7 * math.sin(TAU * t / p[3] + 0.4) + 0.3 * math.sin(TAU * t / p[4] + 2.0)),
		headPitch = math.rad(k.pitchDeg) * calm * math.sin(TAU * t / p[5] + 0.9),
	}
end

-- The largest angle each part of the pose can reach (for tests and for the docs).
function Idle.limits(cfg: any): Pose
	local b, k = cfg.breathe, cfg.tilt
	return {
		bodyLift = b.bodyLift, abdomenLift = b.lift, abdomenPitch = math.rad(b.pitchDeg),
		headRoll = math.rad(k.rollDeg), headYaw = math.rad(k.yawDeg), headPitch = math.rad(k.pitchDeg),
	}
end

-- Palp drumming in bursts while the spider stands still: the angle (radians, about the palp's base) of palp 1 and palp 2.
function Idle.palps(t: number, drum: number, palp: any): { number }
	local out = {}
	for k = 1, 2 do
		local burst = math.clamp((math.sin(t * 1.3 + 0.7 * k) - 0.55) / 0.3, 0, 1)
		local beat = math.max(0, math.sin(t * TAU * palp.drumHz + math.pi * k))
		out[k] = math.rad(palp.drumDeg) * drum * burst * beat
	end
	return out
end

return Idle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">PeacockDance</string>
            <string name="Source"><![CDATA[--!strict
-- The peacock spider's courtship dance as a pose (ROBLOX-29): pure, Vector3-free, display only. Nothing here moves the body, the
-- collider, the senses, the jump or the silk; SpiderRig reads the pose and bends the drawn abdomen, fan, palps and legs III.
-- All numbers are in Data/Peacock (documented ones from Girard et al. 2011, the rest marked artistic).
--
-- A dance is a loop of phases (approach with bobbing and a rumble-rump, the fan raised with legs III up, the fan dance with the leg
-- wave, a freeze with fan-flapping, a second dance, the fold) played from the time it is given: step(dt, standing, moving) adds
-- the dt it is handed, so slow motion slows the dance as it slows everything else. Walking, a jump, leaving the surface or stop()
-- end it at once; the pose then eases out over Peacock.fadeOutSeconds from where it was.

local Peacock = require(script.Parent.Parent.Data.Peacock)

local PeacockDance = {}
PeacockDance.__index = PeacockDance

-- Every angle is in radians. Sway and shiver are signed; fanOpen, legsRaise and legsWave run 0..1 (legsWave: 0 erect, 1 swept down).
export type Pose = {
	phase: string, -- the phase of the loop, "none" when no dance shows
	presence: number, -- 0..1: how much of the pose shows (ramps in and out)
	abdomenPitch: number, -- rear end up
	abdomenSway: number, -- side to side with the fan up
	shiver: number, -- the 12.1 Hz tremble of a rumble-rump
	fanOpen: number,
	palp: number, -- both pedipalps, in unison
	legsRaise: number,
	legsWave: number,
	rumble: number, -- 0..1: a rumble-rump is on (for the felt caption, not for the picture)
}

local TAU = math.pi * 2

local function smooth(x: number): number
	local c = math.clamp(x, 0, 1)
	return c * c * (3 - 2 * c)
end

PeacockDance.NONE = {
	phase = "none", presence = 0, abdomenPitch = 0, abdomenSway = 0, shiver = 0, fanOpen = 0, palp = 0, legsRaise = 0, legsWave = 0, rumble = 0,
} :: Pose

-- Which phase a loop time falls in: its index, the seconds into it and the loop time it starts at.
function PeacockDance.phaseAt(t: number): (number, number, number)
	local phases = Peacock.phases
	local u = t % Peacock.loopSeconds
	local start = 0
	for i, p in phases do
		if u < start + p.seconds then return i, u - start, start end
		start += p.seconds
	end
	return #phases, phases[#phases].seconds, start - phases[#phases].seconds
end

local LEVELS = { "pitch", "open", "legs", "sway", "wave", "flap", "bob", "palp" }

-- The levels (0..1) at a loop time: the previous phase's, eased toward this phase's over its `ease`.
local function levelsAt(t: number): ({ [string]: number }, string)
	local phases = Peacock.phases
	local i, u = PeacockDance.phaseAt(t)
	local cur, prev = phases[i], phases[if i == 1 then #phases else i - 1]
	local k = smooth(u / math.max(math.min(cur.ease or Peacock.ease, cur.seconds), 1e-6))
	local out: { [string]: number } = {}
	for _, name in LEVELS do
		local a, b = (prev :: any)[name] :: number, (cur :: any)[name] :: number
		out[name] = a + (b - a) * k
	end
	return out, cur.id
end

-- 0..1: a rumble-rump is on at this loop time (it starts `rumble` seconds into its phase and lasts Peacock.rumble.seconds).
local function rumbleAt(t: number): number
	local u = t % Peacock.loopSeconds
	local start = 0
	local r = Peacock.rumble
	for _, p in Peacock.phases do
		local at = p.rumble
		if at then
			local from, to = start + at, start + at + r.seconds
			if u >= from and u <= to then
				return math.min(smooth((u - from) / r.edgeSeconds), smooth((to - u) / r.edgeSeconds))
			end
		end
		start += p.seconds
	end
	return 0
end

-- 0..1: inside a bobbing bout (bouts and rests repeat through the loop; the phase's `bob` level says where they show).
local function bobBoutAt(t: number): number
	local b = Peacock.rates.bob
	local u = t % (b.boutSeconds + b.restSeconds)
	if u >= b.boutSeconds then return 0 end
	return math.min(smooth(u / 0.1), smooth((b.boutSeconds - u) / 0.1))
end

-- The whole pose at a loop time, before presence. reduced: ReducedMotion (half amplitudes, no tremble).
function PeacockDance.rawPose(t: number, reduced: boolean): Pose
	local L, id = levelsAt(t)
	local a, r = Peacock.amplitude, Peacock.rates
	local amp = if reduced then Peacock.reducedMotion else 1
	local rumble = rumbleAt(t)
	local bob = L.bob * bobBoutAt(t) * math.sin(TAU * r.bob.hz * t) * math.rad(a.bobDeg) * amp
	local flap = L.flap * a.flapDepth * amp * (0.5 + 0.5 * math.sin(TAU * r.fanFlap.hz * t))
	return {
		phase = id, presence = 1,
		abdomenPitch = L.pitch * math.rad(a.raiseDeg) + bob,
		abdomenSway = L.sway * math.rad(Peacock.fanArcDeg.used / 2) * math.sin(TAU * r.fanDance.hz * t) * amp,
		shiver = if reduced then 0 else rumble * math.rad(a.shiverDeg) * math.sin(TAU * Peacock.rumble.bumpsHz * t),
		fanOpen = L.open * (1 - flap),
		palp = L.palp * math.rad(a.palpDeg) * amp * (0.5 + 0.5 * math.sin(TAU * r.palpFlicker.hz * t)),
		legsRaise = L.legs,
		legsWave = L.wave * amp * (0.5 + 0.5 * math.sin(TAU * r.legWave.hz * t + 1.2)),
		rumble = rumble,
	}
end

local function scaled(p: Pose, k: number): Pose
	return {
		phase = p.phase, presence = k,
		abdomenPitch = p.abdomenPitch * k, abdomenSway = p.abdomenSway * k, shiver = p.shiver * k, fanOpen = p.fanOpen * k,
		palp = p.palp * k, legsRaise = p.legsRaise * k, legsWave = p.legsWave * k, rumble = p.rumble * k,
	}
end

export type Dance = typeof(setmetatable(
	{} :: { t: number, active: boolean, presence: number, raw: Pose?, reduced: boolean },
	PeacockDance
))

function PeacockDance.new(): Dance
	return setmetatable({ t = 0, active = false, presence = 0, raw = nil :: Pose?, reduced = false }, PeacockDance)
end

-- Begin the loop from its start. Refused (false) when the spider is not standing still on a surface.
function PeacockDance.start(self: Dance, standing: boolean, moving: boolean): boolean
	if self.active or not standing or moving then return false end
	self.t, self.active = 0, true
	return true
end

-- End the dance at once; the pose eases out over Peacock.fadeOutSeconds from where it was.
function PeacockDance.stop(self: Dance)
	self.active = false
end

-- Showing at all (dancing, or still easing out).
function PeacockDance.showing(self: Dance): boolean
	return self.active or self.presence > 0
end

-- One step of dt seconds (the simulation's, so slow motion slows the dance). standing: on a surface and not in a jump; moving: walking.
function PeacockDance.step(self: Dance, dt: number, standing: boolean, moving: boolean): Pose
	if self.active and (not standing or moving) then self.active = false end
	if self.active then
		self.t += dt
		self.presence = math.min(1, self.presence + dt / Peacock.rampInSeconds)
		self.raw = PeacockDance.rawPose(self.t, self.reduced)
	else
		self.presence = math.max(0, self.presence - dt / Peacock.fadeOutSeconds)
		if self.presence == 0 then self.raw = nil end
	end
	local raw = self.raw
	if raw == nil then return PeacockDance.NONE end
	return scaled(raw, smooth(self.presence))
end

return PeacockDance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">Setae</string>
            <string name="Source"><![CDATA[--!strict
-- Where the spider's hairs (setae) go: pure layout from the appearance table, Vector3 only, so tests/run.luau and
-- tests/look.luau check it. Body frame as in SpiderRig: +Y up, -Z forward. Deterministic: the same appearance always gives
-- the same fuzz. SpiderRig turns each entry into one thin anchored part.
-- The coat is short and sleek and takes its colour from the daughter's pattern: black hairs on the black areas, white hairs
-- only inside the white spots and the band (the pale cheeks stay clean). Nothing grey or frosted is in the body coat; only
-- the face keeps a little silver (the tufts and the ruff) and the palps their fluff.
--   lock: short thin hairs lying nearly flat, combed toward the rear      pale: the same, white, inside a white spot or the band
--   fringe: short hairs along the sides, lifted a little, for a soft edge  guard: a few short hairs that stand up
--   tuft: the plumes at the upper sides of the head       ruff: pale hair low on each cheek
--   palp: the fluff on the pedipalps (rest pose; SpiderRig moves it with the palp)       leg: see Setae.leg

local Anatomy = require(script.Parent.Anatomy)

local Setae = {}

export type Hair = {
	at: Vector3, dir: Vector3, normal: Vector3, length: number, width: number, thick: number, transparency: number,
	kind: string, group: string, side: number, tone: string, white: boolean, grey: boolean, frost: boolean,
}
export type LegHair = { segment: number, t: number, theta: number, length: number, tone: string, white: boolean, grey: boolean, frost: boolean }
export type Patch = { x: number, z: number, rx: number, rz: number, angle: number }

local GOLDEN = 2.399963229728653

-- A repeatable 0..1 value per index (no global RNG state).
local function hash(i: number, salt: number): number
	local x = math.sin(i * 12.9898 + salt * 78.233) * 43758.5453
	return x - math.floor(x)
end
Setae.hash = hash

local function between(range: { number }, t: number): number
	return range[1] + (range[2] - range[1]) * t
end

-- ---------------------------------------------------------------- the pattern: where the white is
-- The white spots and the band as flat ellipses, in studs from the abdomen's centre (x across, z along): the same ones
-- SpiderRig draws as AbdomenSpot and FrontBand. `angle` turns an ellipse about the vertical (CFrame.Angles(0, angle, 0)).
function Setae.patches(look: any): { Patch }
	local ar = look.abdomenRadii
	local out: { Patch } = {}
	for _, s in look.spots do
		table.insert(out, { x = s.x * ar[1], z = s.z * ar[3], rx = s.rx, rz = s.rz, angle = s.angle })
	end
	local band = look.band
	for i = 0, band.count - 1 do
		table.insert(out, { x = (i - (band.count - 1) / 2) * band.step * ar[1], z = band.z * ar[3], rx = band.rx, rz = band.rz, angle = 0 })
	end
	return out
end

-- Is the offset (dx, dz) from the abdomen's centre inside the patch grown by `grow` studs (negative: shrunk)?
local function inside(p: Patch, dx: number, dz: number, grow: number): boolean
	local rx, rz = p.rx + grow, p.rz + grow
	if rx <= 0 or rz <= 0 then return false end
	local c, s = math.cos(p.angle), math.sin(p.angle)
	local ex, ez = dx - p.x, dz - p.z
	local u = ex * c - ez * s
	local v = ex * s + ez * c
	return (u / rx) ^ 2 + (v / rz) ^ 2 < 1
end

local function insideAny(patches: { Patch }, dx: number, dz: number, grow: number): boolean
	for _, p in patches do
		if inside(p, dx, dz, grow) then return true end
	end
	return false
end
Setae.insideAny = insideAny

-- ---------------------------------------------------------------- one hair
local function hair(at: Vector3, dir: Vector3, normal: Vector3, length: number, width: number, flat: number, transparency: number, kind: string, group: string, side: number, tone: string): Hair
	return {
		at = at, dir = dir, normal = normal, length = length, width = width, thick = width * flat, transparency = transparency,
		kind = kind, group = group, side = side, tone = tone, white = tone == "white", grey = tone == "grey", frost = tone == "frost",
	}
end

-- The way a hair lies: along the surface toward the rear (+Z), turned `yaw` radians to one side, raised `lift` radians off the
-- surface (0 lies flat, pi/2 stands up).
local function comb(normal: Vector3, lift: number, yaw: number): Vector3
	local back = Vector3.new(0, 0, 1)
	local along = back - normal * back:Dot(normal)
	if along.Magnitude < 1e-3 then along = Vector3.new(0, 1, 0) - normal * normal.Y end
	if along.Magnitude < 1e-3 then return normal end
	along = along.Unit
	local side = normal:Cross(along)
	return ((along * math.cos(yaw) + side * math.sin(yaw)) * math.cos(lift) + normal * math.sin(lift)).Unit
end

-- Where a hair of this class starts: a lying hair sits on the surface (half its thickness above it, so it neither sinks in
-- nor floats), a standing one is rooted a little inside.
local function rootOf(surface: Vector3, normal: Vector3, lift: number, thick: number): Vector3
	if lift < math.rad(25) then return surface + normal * (thick * 0.5 + 0.0012) end
	return surface - normal * 0.003
end

-- The hair's three points (root, middle, tip) must all be acceptable.
local function allClear(clear: (Vector3) -> boolean, root: Vector3, dir: Vector3, length: number): boolean
	return clear(root) and clear(root + dir * (length * 0.5)) and clear(root + dir * length)
end

-- One class of coat hairs (kind "lock", "guard" or "fringe") over an ellipsoid; `spec` is the class's table in
-- Appearances.fuzz. `keep(at, unit)` picks where hairs may grow, `clear(point)` rejects a hair that touches something it must
-- leave alone (a white patch, an eye). The colour is black or dark: a hair here is on a black area.
local function coat(out: { Hair }, kind: string, spec: any, center: Vector3, radii: Vector3, samples: number, salt: number, group: string, keep: (Vector3, Vector3) -> boolean, clear: (Vector3) -> boolean)
	for i = 0, samples - 1 do
		local y = 1 - 2 * (i + 0.5) / samples
		local r = math.sqrt(math.max(0, 1 - y * y))
		local a = i * GOLDEN
		local unit = Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
		if unit.Y > -0.25 then
			local surface = center + Vector3.new(unit.X * radii.X, unit.Y * radii.Y, unit.Z * radii.Z)
			local normal = Vector3.new(unit.X / radii.X, unit.Y / radii.Y, unit.Z / radii.Z).Unit
			if keep(surface, unit) then
				local length = between(spec.length, hash(i, salt))
				local lift = math.rad(between(spec.lift, hash(i, salt + 5)))
				local yaw = math.rad(spec.yaw) * (2 * hash(i, salt + 3) - 1)
				local dir = comb(normal, lift, yaw)
				local root = rootOf(surface, normal, lift, spec.width * spec.flat)
				if allClear(clear, root, dir, length) then
					local tone = if hash(i, salt + 11) < spec.black then "black" else "dark"
					table.insert(out, hair(root, dir, normal, length, spec.width, spec.flat, spec.transparency, kind, group, 0, tone))
				end
			end
		end
	end
end

-- White hairs inside the white spots and the band, lying on top of them (the markings are flat, raised discs): a spiral of
-- hair middles in each ellipse at `spec.density` hairs per square stud, every one kept only if the whole hair stays inside
-- the patch (shrunk by `spec.margin`), so the white keeps its edge.
local function pale(out: { Hair }, look: any, A: Anatomy.Layout, spec: any)
	local patches = Setae.patches(look)
	local ac, ar = A.abdomenCenter, A.abdomenRadii
	local n = 0
	for pi, patch in patches do
		local count = math.floor(math.pi * patch.rx * patch.rz * spec.density + 0.5)
		local c, s = math.cos(patch.angle), math.sin(patch.angle)
		for k = 1, count do
			n += 1
			local ring = if count == 1 then 0 else math.sqrt((k - 0.5) / count) * 0.75
			local ang = k * GOLDEN + pi
			local lu, lv = patch.rx * ring * math.cos(ang), patch.rz * ring * math.sin(ang)
			local mx, mz = patch.x + lu * c + lv * s, patch.z - lu * s + lv * c -- the hair's middle, offsets from the abdomen's centre
			local length = between(spec.length, hash(n, 41))
			local yaw = math.rad(spec.yaw) * (2 * hash(n, 43) - 1)
			local lift = math.rad(between(spec.lift, hash(n, 45)))
			local dir = comb(Vector3.yAxis, lift, yaw)
			local rx, rz = mx - dir.X * length * 0.5, mz - dir.Z * length * 0.5 -- its root
			-- the disc's top: SpiderRig lifts a marking 0.007 above the body and gives it a rounded 0.012 half-thickness
			local rho2 = (lu / patch.rx) ^ 2 + (lv / patch.rz) ^ 2
			local thick = spec.width * spec.flat
			local height = Anatomy.topY(ac, ar, rx, rz) + 0.007 + 0.012 * math.sqrt(math.max(0, 1 - rho2)) + thick * 0.5 + 0.0008
			local root = Vector3.new(ac.X + rx, height, ac.Z + rz)
			local ok = true
			for _, along in { 0, 0.5, 1 } do
				ok = ok and insideAny(patches, rx + dir.X * length * along, rz + dir.Z * length * along, -spec.margin)
			end
			if ok then
				table.insert(out, hair(root, dir, Vector3.yAxis, length, spec.width, spec.flat, spec.transparency, "pale", "abdomen", 0, "white"))
			end
		end
	end
end

-- A fan of hairs growing from a point of the head: `spec` = { at (unit-sphere direction, mirrored), lean, fan, spread, ... }.
local function plume(out: { Hair }, A: Anatomy.Layout, side: number, spec: any, count: number, length: number, kind: string, salt: number, pick: (number) -> string)
	local p0, n0 = Anatomy.ellipsoidPoint(A.headCenter, A.headRadii, Vector3.new(side * spec.at[1], spec.at[2], spec.at[3]))
	local axis = Vector3.new(side * spec.lean[1], spec.lean[2], spec.lean[3]).Unit
	local u = axis:Cross(Vector3.zAxis)
	if u.Magnitude < 1e-3 then u = axis:Cross(Vector3.xAxis) end
	u = u.Unit
	local w = axis:Cross(u).Unit
	for k = 1, count do
		local ring = math.sqrt((k - 0.5) / count)
		local ang = k * GOLDEN + side
		local off = u * math.cos(ang) + w * math.sin(ang)
		local dir = (axis + off * (spec.fan * ring)).Unit
		local at = p0 + off * (spec.spread * ring) - n0 * 0.012
		local l = length * (0.82 + 0.36 * hash(k, salt + side))
		table.insert(out, hair(at, dir, n0, l, spec.width, spec.flat, spec.transparency, kind, "head", side, pick(k * 3 + side)))
	end
end

function Setae.body(look: any): { Hair }
	local out: { Hair } = {}
	local f = look.fuzz
	if not f or not f.enabled then return out end
	local A = Anatomy.layout(look)
	local cheek = look.cheek
	local cy = (cheek.y - A.headCenter.Y) / A.headRadii.Y
	local cz = (cheek.z - A.headCenter.Z) / A.headRadii.Z
	local patches = Setae.patches(look)
	local ac, ar = A.abdomenCenter, A.abdomenRadii
	local hc, hr = A.headCenter, A.headRadii

	-- Black hairs keep off the white: no point of a hair may come within `f.clear` studs of a spot or the band, and none
	-- may lie on the pale cheek. (The pattern is on the upper surface; the lower flanks have none.)
	local function offWhiteAbdomen(p: Vector3): boolean
		if p.Y < ac.Y + 0.02 then return true end
		return not insideAny(patches, p.X - ac.X, p.Z - ac.Z, f.clear)
	end
	local function offCheek(p: Vector3): boolean
		local u = Vector3.new((p.X - hc.X) / hr.X, (p.Y - hc.Y) / hr.Y, (p.Z - hc.Z) / hr.Z)
		if math.abs(u.X) < 0.5 * u.Magnitude then return true end
		local dy = (u.Y / u.Magnitude - cy) / (cheek.radii[2] / hr.Y + f.clear / hr.Y)
		local dz = (u.Z / u.Magnitude - cz) / (cheek.radii[3] / hr.Z + f.clear / hr.Z)
		return dy * dy + dz * dz > 1.4
	end

	local coats: { { kind: string, spec: any } } = { { kind = "lock", spec = f.locks }, { kind = "guard", spec = f.guard } }
	if f.fringe then table.insert(coats, { kind = "fringe", spec = f.fringe }) end
	for n, entry in coats do
		local kind, spec = entry.kind, entry.spec
		local sideOnly: number = spec.side or 0 -- the fringe grows only at the sides, where it makes the outline
		coat(out, kind, spec, ac, ar, spec.abdomen, n, "abdomen", function(_at, unit)
			return unit.Z > -0.93 and math.abs(unit.X) >= sideOnly -- not where the abdomen meets the pedicel
		end, offWhiteAbdomen)
		coat(out, kind, spec, hc, hr, spec.head, n + 2, "head", function(at, unit)
			if math.abs(unit.X) < sideOnly then return false end
			if unit.Z < -0.55 and unit.Y < 0.75 then return false end -- the eye face stays clear
			for _, zone in A.hairFree do
				if (at - zone.at).Magnitude < zone.radius then return false end
			end
			return true
		end, offCheek)
	end
	pale(out, look, A, f.pale)

	-- Tufts: dark and silvery plumes up and out at the upper sides of the head.
	for _, side in { -1, 1 } do
		plume(out, A, side, f.tuft, f.tuftHairs, f.tuftLength, "tuft", 7, function(i)
			local r = hash(i, 21)
			return if r < 0.15 then "frost" elseif r < 0.45 then "grey" else "dark"
		end)
	end
	-- Cheek ruff: pale hair low at the sides of the face, beside the jaws.
	local rf = f.ruff
	for _, side in { -1, 1 } do
		plume(out, A, side, { at = rf.at, lean = rf.lean, fan = 0.55, spread = 0.03, width = rf.width, flat = rf.flat, transparency = rf.transparency }, rf.hairs, rf.length, "ruff", 17, function(i)
			local r = hash(i, 23)
			return if r < rf.whiteShare then "white" elseif r < 0.85 then "frost" else "grey"
		end)
	end
	return out
end

-- Fluff on the pedipalps, in the body frame at rest (SpiderRig moves it with the palp it belongs to; side -1 is palp 1).
function Setae.palp(look: any): { Hair }
	local out: { Hair } = {}
	local f = look.fuzz
	if not f or not f.enabled then return out end
	local A = Anatomy.layout(look)
	local pl = look.palp
	local spec = pl.fluff
	for _, p in A.palps do
		local axis = p.tip - p.base
		local ax = axis.Unit
		local u = ax:Cross(Vector3.xAxis)
		if u.Magnitude < 1e-3 then u = ax:Cross(Vector3.yAxis) end
		u = u.Unit
		local w = ax:Cross(u).Unit
		for k = 1, spec.hairs do
			local t = 0.3 + 0.7 * (k - 0.5) / spec.hairs
			local theta = k * GOLDEN + p.side
			local radial = u * math.cos(theta) + w * math.sin(theta)
			local r = if t > 0.7 then pl.club[1] else pl.stalk * 0.5
			local dir = (radial + ax * 0.6).Unit
			local l = spec.length * (0.8 + 0.4 * hash(k, 31 + p.side))
			local rr = hash(k, 33 + p.side)
			local tone = if rr < 0.55 then "white" elseif rr < 0.75 then "frost" else "grey"
			table.insert(out, hair(p.base + axis * t + radial * (r * 0.8), dir, radial, l, spec.width, spec.flat, spec.transparency, "palp", "palp", p.side, tone))
		end
	end
	return out
end

-- Hairs on one leg: segment 1 femur, 2 tibia, 3 tarsus; t along it (0 base .. 1 tip); theta around it.
-- White over the leg's pale band (the middle bandFraction of each segment, as SpiderRig draws it), black everywhere else.
function Setae.leg(look: any, legIndex: number): { LegHair }
	local out: { LegHair } = {}
	local f = look.fuzz
	if not f or not f.enabled then return out end
	local front = (legIndex - 1) % 4 == 0 -- the first legs carry a denser, longer fringe, as in Phidippus
	for segment = 1, 3 do
		local n = if front and segment < 3 then math.floor(f.legHairs[segment] * 1.6) else f.legHairs[segment]
		for k = 1, n do
			local i = legIndex * 100 + segment * 10 + k
			local t = (k - 0.5) / n
			local theta = k * GOLDEN + legIndex
			local white = math.abs(t - 0.5) < look.bandFraction * 0.6
			local tone = if white then "white" elseif hash(i, 13) < f.legBlack then "black" else "dark"
			table.insert(out, {
				segment = segment, t = t, theta = theta,
				length = f.legLength * (0.7 + 0.6 * hash(i, 5)) * (if segment == 3 then 0.6 elseif front then 1.4 else 1),
				tone = tone, white = tone == "white", grey = false, frost = false,
			})
		end
	end
	return out
end

return Setae
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">SpiderChoice</string>
            <string name="Source"><![CDATA[--!strict
-- Which spider the player is (ROBLOX-31): the daughter's first spider or the peacock spider. Pure, so tests/peacock.luau checks it.
-- The choice is remembered for the session in the Player attribute `Appearance`; the Workspace attribute `Appearance` can preselect
-- it for Studio and playtests. Anything that is not a known appearance is the default (the first spider).
local Appearances = require(script.Parent.Parent.Data.Appearances)

local SpiderChoice = {}

-- The spiders to choose between, in the order the crack's key cycles through them.
SpiderChoice.ORDER = { "first_spider", "maratus_volans_male" } :: { string }

local function known(id: any): boolean
	return type(id) == "string" and Appearances.profiles[id] ~= nil
end

-- The appearance to start with: the Player attribute if it names one, else the Workspace attribute, else the default.
function SpiderChoice.start(playerAttribute: any, workspaceAttribute: any): string
	if known(playerAttribute) then return playerAttribute :: string end
	if known(workspaceAttribute) then return workspaceAttribute :: string end
	return Appearances.default
end

-- The appearance after this one.
function SpiderChoice.next(id: string): string
	for i, name in SpiderChoice.ORDER do
		if name == id then return SpiderChoice.ORDER[i % #SpiderChoice.ORDER + 1] end
	end
	return Appearances.default
end

-- Does this appearance have a fan to display (and so a courtship dance)?
function SpiderChoice.canDance(id: string): boolean
	local look = Appearances.profiles[id]
	return look ~= nil and (look :: any).fan ~= nil
end

return SpiderChoice
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">SpiderRig</string>
            <string name="Source"><![CDATA[--!strict
-- The drawn spider for Roblox: a port of scripts/presentation/spider_body.gd and surface_legs.gd (VISUAL-01 look), made cuter in
-- ROBLOX-13. Every part is anchored, non-colliding and non-queryable, and is placed each frame with one Workspace:BulkMoveTo call.
-- Display only: the controller owns the body's CFrame; nothing here feeds back into movement.
-- Body frame: +Y support-up, -Z forward, about 1 stud long (1 Godot WU = 1 cm = 1 stud). Every look number is in
-- Data/Appearances; where things sit comes from Rig/Anatomy, the hairs from Rig/Setae, the idle motion from Rig/Idle.
-- The peacock spider (ROBLOX-30) is a second appearance drawn by the same code: a small body (look.scale) standing low (look.bodyDrop),
-- legs III in their own colours, and a fan of flat discs that the courtship dance (Rig/PeacockDance, set as rig.dance) opens.

local Workspace = game:GetService("Workspace")
local Appearances = require(script.Parent.Parent.Data.Appearances)
local Anatomy = require(script.Parent.Anatomy)
local Setae = require(script.Parent.Setae)
local Idle = require(script.Parent.Idle)
local Growth = require(script.Parent.Parent.Life.Growth)
local v3 = Anatomy.v3

local SpiderRig = {}
SpiderRig.__index = SpiderRig

export type GaitMode = "Tetrapod" | "Unilateral"

local STEP_ERROR = 0.24
local SWING_SECONDS = 0.10
local STEP_HEIGHT = 0.12
local ANKLE_SHARE = 0.62
-- The groups a fixed part follows: the body, the head (tilts about the neck) or the abdomen (breathes).
local G_BODY, G_HEAD, G_ABDOMEN = 0, 1, 2

type Leg = {
	side: number,
	pair: number,
	planted: Vector3?,
	swing: number, -- < 0 planted, 0..1 swinging
	from: Vector3,
	to: Vector3,
	up: Vector3,
	foot: Vector3,
	femur: Part,
	tibia: Part,
	tarsus: Part,
	knee: Part,
	ankle: Part,
	pad: Part?,
	bands: {Part}, -- empty for a pair drawn without pale bands (the peacock spider's legs III)
	hairs: { { part: Part, spec: Setae.LegHair } },
}

type Fixed = { part: Part, offset: CFrame, group: number, palp: number? }

-- The peacock spider's fan: flat ellipsoid discs on the abdomen's back face, stacked fringe first, their size set each frame by how far the fan is open.
type FanDisc = { part: Part, inset: number, y: number }
type FanFigure = { part: Part, x: number, z: number, rx: number, rz: number, angle: number }
type Fan = { front: { FanDisc }, back: { FanDisc }, figure: { FanFigure }, flaps: { { part: Part, side: number } }, cfg: any, parts: { Part } }

export type Rig = typeof(setmetatable(
	{} :: {
		model: Model,
		root: Part,
		gaitMode: GaitMode,
		reducedMotion: boolean,
		_fixed: { Fixed },
		_legs: { Leg },
		_group: number,
		_t: number,
		_drum: number,
		_calm: number,
		_spots: { Part },
		_appearance: any,
		_layout: Anatomy.Layout,
		_cfg: any,
		_detail: string,
		_palpBase: { Vector3 },
		_setae: { Part },
		_eyeView: boolean,
		_bodyHidden: boolean,
		_highlight: Highlight?,
		_params: RaycastParams,
		_parts: { BasePart },
		_cframes: { CFrame },
		_k: number,
  _growth: number,
  _softness: number,
  _condition: number,
  _shownCondition: number,
  _sizes: {[BasePart]: Vector3},
  _colors: {[BasePart]: Color3},
		_drop: number,
		_fan: Fan?,
		dance: any, -- a PeacockDance.Pose, or nil: the peacock spider's display (ignored by an appearance without a fan)
	},
	SpiderRig
))

local function newPart(model: Model, name: string, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = Vector3.new(0.1, 0.1, 0.1)
	p.Parent = model
	return p
end

local function ellipsoid(model: Model, name: string, radii: Vector3, color: Color3, material: Enum.Material): Part
	local p = newPart(model, name, color, material)
	p.Size = radii * 2
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function rod(model: Model, name: string, d: number, color: Color3): Part
	local p = newPart(model, name, color, Enum.Material.SmoothPlastic)
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(1, d, d)
	return p
end

local function disc(model: Model, name: string, color: Color3, reflectance: number): Part
	local p = ellipsoid(model, name, Vector3.new(0.05, 0.002, 0.05), color, Enum.Material.SmoothPlastic)
	p.CastShadow = false
	p.Reflectance = reflectance
	return p
end

local function ball(model: Model, name: string, d: number, color: Color3): Part
	local p = newPart(model, name, color, Enum.Material.SmoothPlastic)
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(d, d, d)
	p.CastShadow = false
	return p
end

-- A cylinder's axis is its local X: aim it from a to b.
local function rodCFrame(a: Vector3, b: Vector3): CFrame
	return CFrame.lookAt((a + b) * 0.5, b) * CFrame.Angles(0, math.pi / 2, 0)
end

-- A hair's "up" for lookAt: its surface normal, unless that is (nearly) along the hair.
local function upFor(dir: Vector3, normal: Vector3): Vector3
	if math.abs(dir:Dot(normal)) < 0.97 then return normal end
	return if math.abs(dir.Y) < 0.9 then Vector3.yAxis else Vector3.zAxis
end

local GROUP_OF: { [string]: number } = { head = G_HEAD, abdomen = G_ABDOMEN }

-- detail "low" is for phones and tablets: fewer hairs, one fur shell, no foot balls, half the speckles, no outline, no
-- breathing or head tilt (Appearances.detail). Anything else is the full look.
function SpiderRig.new(parent: Instance, worldFolder: Instance, appearanceId: string?, detail: string?): Rig
	local look = Appearances.profiles[appearanceId or Appearances.default]
	assert(look, "Unknown spider appearance")
	local detailName = if detail == "low" then "low" else "full"
	local cfg = look.detail[detailName]
	local A = Anatomy.layout(look)
	local function color(rgb): Color3 return Color3.new(rgb[1], rgb[2], rgb[3]) end
	local BODY, LEG = color(look.body), color(look.legs)
	local JOINT, EYE, FANG = color(look.joint or look.white), color(look.eyes), color(look.fangs)
	local ABDOMEN = if look.abdomenColor then color(look.abdomenColor) else BODY
	local WHITE = color(look.white)
	local model = Instance.new("Model")
	model.Name = "Spider"
	model:SetAttribute("AppearanceId", look.id)
	model:SetAttribute("Detail", detailName)
	local root = newPart(model, "Root", BODY, Enum.Material.SmoothPlastic)
	root.Size = Vector3.new(1, 0.5, 1)
	root.Transparency = 1
	root.CastShadow = false
	model.PrimaryPart = root

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { worldFolder }

	local self = setmetatable({
		model = model,
		root = root,
		gaitMode = "Tetrapod" :: GaitMode,
		reducedMotion = false,
		_fixed = {} :: { Fixed },
		_legs = {} :: { Leg },
		_group = 0,
		_t = 0,
		_drum = 0,
		_calm = 0,
		_spots = {} :: { Part },
		_appearance = look,
		_layout = A,
		_cfg = cfg,
		_detail = detailName,
		_palpBase = { A.palps[1].base, A.palps[2].base },
		_setae = {} :: { Part },
		_eyeView = false,
		_bodyHidden = false,
		_highlight = nil :: Highlight?,
		_params = params,
		_parts = {} :: { BasePart },
		_cframes = {} :: { CFrame },
		_k = look.scale or 1,
  _growth = 1, _softness = 0, _condition = 0.55, _shownCondition = 0.55,
  _sizes = {} :: {[BasePart]: Vector3}, _colors = {} :: {[BasePart]: Color3},
		_drop = look.bodyDrop or 0,
		_fan = nil :: Fan?,
		dance = nil :: any,
	}, SpiderRig)

	local function fixed(part: Part, at: Vector3, rot: CFrame?, group: number, palp: number?)
		table.insert(self._fixed, { part = part, offset = CFrame.new(at) * (rot or CFrame.identity), group = group, palp = palp })
	end
	local fabric = Enum.Material.SmoothPlastic -- clean high-contrast silhouette
	fixed(ellipsoid(model, "Cephalothorax", A.headRadii, BODY, fabric), A.headCenter, nil, G_HEAD)
	fixed(ellipsoid(model, "EyeFace", A.faceRadii, BODY, fabric), A.faceCenter, nil, G_HEAD)
	fixed(ellipsoid(model, "Pedicel", A.pedicelRadii, BODY, fabric), A.pedicelCenter, nil, G_BODY)
	fixed(ellipsoid(model, "Abdomen", A.abdomenRadii, ABDOMEN, fabric), A.abdomenCenter, nil, G_ABDOMEN)

	-- The daughter's pattern: markings are fractions of the abdomen's radii.
	local ar, ac = A.abdomenRadii, A.abdomenCenter
	local function marking(name: string, x: number, z: number, rx: number, rz: number, angle: number)
		local y = ar.Y * math.sqrt(math.max(0, 1 - x*x - z*z))
		local spot = ellipsoid(model, name, Vector3.new(rx, 0.012, rz), WHITE, fabric)
		spot.CastShadow = false
		fixed(spot, Vector3.new(x * ar.X, ac.Y + 0.007 + y, ac.Z + z * ar.Z), CFrame.Angles(0, angle, 0), G_ABDOMEN)
		table.insert(self._spots, spot)
	end
	-- A curved pale band across the front of the abdomen.
	local band = look.band
	for i = 0, band.count - 1 do
		marking("FrontBand", (i - (band.count - 1) / 2) * band.step, band.z, band.rx, band.rz, 0)
	end
	for _, spot in look.spots do
		marking("AbdomenSpot", spot.x, spot.z, spot.rx, spot.rz, spot.angle)
	end
	-- Fixed deterministic stippling: no per-frame RNG or extra updates.
	local sp = look.speckle
	for i = 1, look.speckleCount do
		if i % cfg.speckleEvery ~= 0 then continue end
		local angle = i * 2.399963229728653
		local radius = sp.from + (i % 5) * sp.step
		marking("Speckle", math.cos(angle) * radius, math.sin(angle) * radius, sp.rx, sp.rz, angle)
	end

	-- Head: pale cheeks, big glossy eyes with their catchlights, jaws.
	for _, c in A.cheeks do
		local cheek = ellipsoid(model, "PaleCheek", c.radii, WHITE, fabric)
		cheek.CastShadow = false
		fixed(cheek, c.at, nil, G_HEAD)
	end
	-- The peacock spider's red-orange carapace stripes: flat dabs lying on the head's dome, tilted to the slope under them.
	local stripes = look.stripes
	if stripes then
		local STRIPE = color(stripes.color)
		for n = 1, #stripes do
			local st = stripes[n]
			local dx, dz = st.x, st.z - A.headCenter.Z
			local q = math.sqrt(math.max(1 - (dx / A.headRadii.X) ^ 2 - (dz / A.headRadii.Z) ^ 2, 0.05))
			local y = A.headCenter.Y + A.headRadii.Y * q
			local pitch = -math.atan(-A.headRadii.Y * (dz / A.headRadii.Z) / (A.headRadii.Z * q))
			local roll = math.atan(-A.headRadii.Y * (dx / A.headRadii.X) / (A.headRadii.X * q))
			local dab = ellipsoid(model, "CarapaceStripe", Vector3.new(st.rx, 0.006, st.rz), STRIPE, fabric)
			dab.CastShadow = false
			fixed(dab, Vector3.new(st.x, y + 0.002, st.z), CFrame.Angles(pitch, 0, roll) * CFrame.Angles(0, st.angle, 0), G_HEAD)
		end
	end
	local SOCKET = color(look.eye.ame.socket.color)
	for _, e in A.eyes do
		local eye = ellipsoid(model, e.name, e.radii, EYE, Enum.Material.Glass)
		eye.Reflectance = e.reflectance
		eye.CastShadow = false
		fixed(eye, e.at, nil, G_HEAD)
		if e.principal and cfg.sockets then
			local socket = ellipsoid(model, "EyeSocket", e.radii * look.eye.ame.socket.scale, SOCKET, fabric)
			socket.CastShadow = false
			fixed(socket, e.at + Vector3.new(0, 0, 0.03), nil, G_HEAD)
		end
	end
	local GLINT = color(look.eye.glintColor)
	for _, g in A.glints do
		local glint = ellipsoid(model, "Catchlight", g.radii, GLINT, Enum.Material.Neon)
		glint.CastShadow = false
		fixed(glint, g.at, nil, G_HEAD)
	end
	local cl = look.chelicerae
	for _, j in A.jaws do
		local fang = ellipsoid(model, "Chelicera", j.radii, FANG, Enum.Material.Foil)
		fang.Reflectance = cl.reflectance
		fixed(fang, j.at, CFrame.Angles(cl.pitch, 0, j.side * cl.splay), G_HEAD)
	end
	-- Pedipalps: stalk, pale band, club and pale tip, rotating about a pivot at the base (they drum when the spider stands).
	local pl = look.palp
	local pc = look.palpColors
	local PALP_STALK, PALP_CLUB, PALP_TIP = if pc then color(pc.stalk) else LEG, if pc then color(pc.club) else LEG, if pc then color(pc.tip) else JOINT
	for index, palp in A.palps do
		local base, tip = palp.base, palp.tip
		local len = (tip - base).Magnitude
		local toBase = CFrame.new(base):Inverse()
		local stalk = rod(model, "PalpStalk", pl.stalk, PALP_STALK)
		stalk.Size = Vector3.new(len, pl.stalk, pl.stalk)
		fixed(stalk, Vector3.zero, toBase * rodCFrame(base, tip), G_HEAD, index)
		local ring = rod(model, "PalpBand", pl.stalk * 1.05, WHITE)
		ring.Size = Vector3.new(len * look.bandFraction, pl.stalk * 1.05, pl.stalk * 1.05)
		fixed(ring, Vector3.zero, toBase * rodCFrame(base, tip), G_HEAD, index)
		fixed(ellipsoid(model, "PalpClub", v3(pl.club), PALP_CLUB, fabric), tip + Vector3.new(0, -0.005, -0.02) - base, nil, G_HEAD, index)
		fixed(ellipsoid(model, "PalpTip", v3(pl.tipRadii), PALP_TIP, fabric), tip + Vector3.new(0, 0.004, -0.05) - base, nil, G_HEAD, index)
	end

	-- Fuzz: flat locks over the head and abdomen, tufts, a cheek ruff and palp fluff (Rig/Setae), moved with the part they grow from.
	local fuzz = look.fuzz
	local BLACKEST = if fuzz then color(fuzz.black) else BODY
	local DARK = if fuzz then color(fuzz.dark) else BODY
	local GREY = if fuzz then color(fuzz.grey) else BODY
	local FROST = if fuzz then color(fuzz.frost) else BODY
	local function seta(tone: string, width: number, thick: number, length: number, transparency: number): Part
		local h = newPart(model, "Seta", if tone == "white" then WHITE elseif tone == "frost" then FROST elseif tone == "grey" then GREY elseif tone == "black" then BLACKEST else DARK, Enum.Material.SmoothPlastic)
		h.Size = Vector3.new(width, thick, length)
		h.CastShadow = false
		h.Transparency = transparency
		table.insert(self._setae, h)
		return h
	end
	if fuzz and fuzz.enabled then
		local SHELL = color(fuzz.shellColor)
		local hr, hs = A.headRadii, fuzz.headShell
		for k, shell in fuzz.shells do
			if k > cfg.shells then break end
			local a = ellipsoid(model, "FuzzShell", A.abdomenRadii * shell.scale, SHELL, fabric)
			a.Transparency, a.CastShadow = shell.transparency, false
			fixed(a, A.abdomenCenter, nil, G_ABDOMEN)
			local h = ellipsoid(model, "FuzzShell", Vector3.new(hr.X * shell.scale, hr.Y * shell.scale, hr.Z * hs.zScale), SHELL, fabric)
			h.Transparency, h.CastShadow = shell.transparency, false
			fixed(h, A.headCenter + Vector3.new(0, 0, hs.shift + 0.01 * k), nil, G_HEAD)
		end
		local seen: { [string]: number } = {}
		local function keep(kind: string): boolean
			local every = cfg.every[kind] or 1
			if every <= 0 then return false end -- 0 drops the whole class
			local n = (seen[kind] or 0) + 1
			seen[kind] = n
			return n % every == 0
		end
		for _, hair in Setae.body(look) do
			if not keep(hair.kind) then continue end
			local h = seta(hair.tone, hair.width, hair.thick, hair.length, hair.transparency)
			local mid = hair.at + hair.dir * (hair.length * 0.5)
			fixed(h, mid, CFrame.lookAt(Vector3.zero, hair.dir, upFor(hair.dir, hair.normal)), GROUP_OF[hair.group] or G_BODY)
		end
		for _, hair in Setae.palp(look) do
			if not keep("palp") then continue end
			local index = if hair.side < 0 then 1 else 2
			local h = seta(hair.tone, hair.width, hair.thick, hair.length, hair.transparency)
			local mid = hair.at + hair.dir * (hair.length * 0.5)
			local rest = CFrame.lookAt(mid, mid + hair.dir, upFor(hair.dir, hair.normal))
			fixed(h, Vector3.zero, CFrame.new(self._palpBase[index]):Inverse() * rest, G_HEAD, index)
		end
	end

	-- Legs: plump, with rounded joints and (at full detail) round feet.
	local L = look.limbs
	for i = 1, 8 do
		local side = if i <= 4 then -1 else 1
		local pair = (i - 1) % 4 + 1
		local raw = L.diameters[pair]
		local factor = (if pair == 1 then look.frontLegScale else 1) * L.thickness
		local d = {raw[1] * factor, raw[2] * factor}
		-- A pair with its own look (the peacock spider's legs III): a colour and a thickness per segment, and no pale bands.
		local own = if look.pairs then look.pairs[pair] else nil
		local cFemur, cTibia, cTarsus = LEG, LEG, LEG
		local tF, tT, tTar = 1, 1, 1
		local kneeColor, ankleColor = JOINT, JOINT
		local withBands = true
		if own then
			cFemur, cTibia, cTarsus = color(own.colors[1]), color(own.colors[2]), color(own.colors[3])
			tF, tT, tTar = own.thick[1], own.thick[2], own.thick[3]
			kneeColor, ankleColor = cFemur, cTibia
			withBands = own.bands ~= false
		end
		if cfg.legBands == false then withBands = false end -- the low tier of the peacock spider draws no pale bands
		table.insert(self._legs, {
			side = side,
			pair = pair,
			planted = nil :: Vector3?,
			swing = -1,
			from = Vector3.zero,
			to = Vector3.zero,
			up = Vector3.yAxis,
			foot = Vector3.zero,
			femur = rod(model, "Femur" .. i, d[1] * tF, cFemur),
			tibia = rod(model, "Tibia" .. i, d[2] * tT, cTibia),
			tarsus = rod(model, "Tarsus" .. i, d[2] * 0.6 * tTar, cTarsus),
			knee = ball(model, "Knee" .. i, d[1] * tF * 0.95, kneeColor),
			ankle = ball(model, "Ankle" .. i, d[2] * tT * 0.95, ankleColor),
			pad = if cfg.pads then ball(model, "Foot" .. i, d[2] * 0.6 * tTar * L.pad, cTarsus) else nil,
			bands = if withBands then {rod(model, "FemurBand" .. i, d[1], WHITE), rod(model, "TibiaBand" .. i, d[2], WHITE), rod(model, "TarsusBand" .. i, d[2] * 0.6, WHITE)} else {},
			hairs = {},
		})
		local leg = self._legs[#self._legs]
		if fuzz and fuzz.enabled then
			for n, spec in Setae.leg(look, i) do
				if n % cfg.every.leg ~= 0 then continue end
				table.insert(leg.hairs, { part = seta(spec.tone, fuzz.legWidth, fuzz.legWidth, spec.length, fuzz.legTransparency), spec = spec })
			end
		end
	end
	-- The peacock spider's fan (look.fan): the discs of the front face, the figure on them, the repeat on the back and the folded flaps.
	local fc = look.fan
	if fc then
		local fan: Fan = { front = {}, back = {}, figure = {}, flaps = {}, cfg = fc, parts = {} }
		local function add(list: { FanDisc }, spec: any, y: number)
			local part = disc(model, spec.name, color(spec.color), if spec.name == "FanField" then fc.sheen else 0)
			table.insert(list, { part = part, inset = spec.inset, y = y })
			table.insert(fan.parts, part)
		end
		for k = 1, math.min(cfg.fanLayers or #fc.layers, #fc.layers) do
			add(fan.front, fc.layers[k], (k - 1) * fc.layerStep)
		end
		if cfg.fanBack then
			for j, k in fc.back.layers do add(fan.back, fc.layers[k], fc.back.plane - (j - 1) * fc.layerStep) end
		end
		for _, f in fc.figure do
			if f.fullOnly and detailName == "low" then continue end
			local part = disc(model, if f.color then "FanGlint" else "FanFigure", color(f.color or fc.figureColor), 0)
			table.insert(fan.figure, { part = part, x = f.x, z = f.z, rx = f.rx, rz = f.rz, angle = f.angle })
			table.insert(fan.parts, part)
		end
		for _, side in { -1, 1 } do
			local flap = ellipsoid(model, "FanFlap", v3(fc.flaps.radii), color(fc.flaps.color), fabric)
			flap.CastShadow = false
			table.insert(fan.flaps, { part = flap, side = side })
			table.insert(fan.parts, flap)
		end
		self._fan = fan
	end
	if cfg.highlight then
		local hl = Instance.new("Highlight")
		hl.FillTransparency = 1
		hl.OutlineColor = WHITE
		hl.OutlineTransparency = 0.82
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = model
		self._highlight = hl
	end
 for _,p in model:GetChildren() do
  if p:IsA("BasePart") and p~=root then self._sizes[p]=p.Size;self._colors[p]=p.Color end
 end
 model.Parent = parent
	self:setGrowthStage(0)
	return self
end

-- Scale about the support plane, not the collider centre. Planted contacts remain world-space points.
function SpiderRig.setGrowthStage(self: Rig, stage: number)
 local index=math.clamp(math.floor(stage),0,3)
 self.model:SetAttribute("GrowthStage",index)
 local g=Growth.SCALES[index+1]
 if self._growth==g then return end
 self._growth=g
 self._k=(self._appearance.scale or 1)*g
 self._drop=0.31-(0.31-(self._appearance.bodyDrop or 0))*g
 for p,size in self._sizes do p.Size=size*g end
end
function SpiderRig.setSoftness(self: Rig, value: number)
 local s=math.clamp(value,0,1)
 if math.abs(s-self._softness)<0.001 then return end
 self._softness=s
 for p,c in self._colors do
  -- The eyes stay dark and readable; pigment returns as the skin hardens.
  if p.Material~=Enum.Material.Glass and p.Name~="Catchlight" then p.Color=c:Lerp(Color3.new(0.88,0.82,0.69),s*0.72) end
 end
end
function SpiderRig.setCondition(self: Rig, energy: number)
 self._condition=math.clamp(energy,0,1)
end

-- How many parts the drawn spider is made of (the model's direct parts), for budgets and the docs.
function SpiderRig.count(self: Rig): { total: number, hairs: number, shells: number, body: number }
	local total, hairs, shells = 0, 0, 0
	for _, part in self.model:GetChildren() do
		if part:IsA("BasePart") then
			total += 1
			if part.Name == "Seta" then hairs += 1 elseif part.Name == "FuzzShell" then shells += 1 end
		end
	end
	return { total = total, hairs = hairs, shells = shells, body = total - hairs - shells }
end

local function legGroup(self: Rig, i: number): number
	if self.gaitMode == "Unilateral" then
		return if i <= 4 then 0 else 1
	end
	-- Godot's (i % 4 + i / 4) % 2 with 0-based i: L1 R2 L3 R4 against R1 L2 R3 L4.
	local j = i - 1
	return (j % 4 + j // 4) % 2
end

local function restLocal(self: Rig, leg: Leg): Vector3
	local s = self._appearance.limbs.stance
	local longer = self._appearance.limbs.pairReach
	local r = s.reach * (if longer then longer[leg.pair] else 1) -- the peacock spider's legs III are the longest
	return Vector3.new(leg.side * s.x * r, s.y, self._appearance.limbs.tipZ[leg.pair] * r) * self._growth
end

-- Display-only foothold: retract toward the body at a narrow edge; never invents a platform.
local function target(self: Rig, body: CFrame, leg: Leg): RaycastResult?
	local up = body.UpVector
	local rest = restLocal(self, leg)
	local k = self._k
	for _, reach in { 1.0, 0.65, 0.35, 0.12 } do
		local point = body:PointToWorldSpace(Vector3.new(rest.X * reach, 0, rest.Z * reach))
		local hit = Workspace:Raycast(point + up * (0.35 * k), -up * (1.0 * k), self._params)
		if hit and hit.Normal:Dot(up) > 0.35 then
			return hit
		end
	end
	return nil
end

-- body: the drawn body's CFrame. grounded: standing on a surface. moving: walking speed > 0 (for palp drumming and idle motion).
function SpiderRig.update(self: Rig, collider: CFrame, dt: number, grounded: boolean, moving: boolean)
	self._t += dt
	-- The root part (what the camera and tests read) stays at the collider's frame; the drawn body of a small appearance sits lower.
	local body = if self._drop ~= 0 then collider * CFrame.new(0, -self._drop, 0) else collider
	local up = body.UpVector
	local look, cfg, A = self._appearance, self._cfg, self._layout
	local k, g = self._k, self._growth
 self._shownCondition += math.clamp(self._condition-self._shownCondition,-0.12*dt,0.12*dt)
 local conditionValue=self._shownCondition
 local condition=Vector3.new(0.84+0.30*conditionValue,0.84+0.30*conditionValue,0.93+0.12*conditionValue)
 local function scaledFrame(cf: CFrame): CFrame return if g==1 then cf else CFrame.new(cf.Position*g)*cf.Rotation end
	local parts, cframes = self._parts, self._cframes
	table.clear(parts)
	table.clear(cframes)
	local function put(p: BasePart, cf: CFrame)
		table.insert(parts, p)
		table.insert(cframes, cf)
	end
	put(self.root, collider)
	-- The courtship display (rig.dance, a PeacockDance pose), for an appearance that has a fan.
	local display = self.dance
	local fan = self._fan
	local dancing = fan ~= nil and display ~= nil and display.presence > 0

	-- Palps drum in bursts while the spider stands still; breathing and a curious head tilt ease in after a moment. All of
	-- it is full detail only (cfg.idle), and reducedMotion turns it off too.
	local standing = cfg.idle and grounded and not moving and not self.reducedMotion and not dancing
	self._drum = math.clamp(self._drum + (if standing then 3 else -3) * dt, 0, 1)
	local palpAngle = Idle.palps(self._t, self._drum, look.palp)
	local bodyBase, headBase, abdomenBase = body, body, body
	if cfg.idle then
		local idle = look.idle
		self._calm = math.clamp(self._calm + (if standing then dt / idle.riseSeconds else -dt / idle.fallSeconds), 0, 1)
		if self._calm > 0 then
			local c = self._calm * self._calm * (3 - 2 * self._calm)
			local pose = Idle.pose(self._t, c, idle)
			bodyBase = body * CFrame.new(0, pose.bodyLift*g, 0)
			headBase = bodyBase * CFrame.new(A.neck*g) * CFrame.Angles(pose.headPitch, pose.headYaw, pose.headRoll) * CFrame.new(-A.neck*g)
			abdomenBase = bodyBase * CFrame.new(0, pose.abdomenLift*g, 0) * CFrame.new(A.pedicelCenter*g)
				* CFrame.Angles(-pose.abdomenPitch, 0, 0) * CFrame.new(-A.pedicelCenter*g)
		end
	end
	if dancing then
		-- The abdomen pitches up about the pedicel and sways side to side (about the body's long axis), the palps flick in unison.
		abdomenBase = bodyBase * CFrame.new(A.pedicelCenter*g) * CFrame.Angles(0, 0, display.abdomenSway + display.shiver)
			* CFrame.Angles(-display.abdomenPitch, 0, 0) * CFrame.new(-A.pedicelCenter*g)
		palpAngle = { palpAngle[1] + display.palp, palpAngle[2] + display.palp }
	end
	local pivots = {
		CFrame.new(self._palpBase[1]) * CFrame.Angles(palpAngle[1], 0, 0),
		CFrame.new(self._palpBase[2]) * CFrame.Angles(palpAngle[2], 0, 0),
	}
	for _, f in self._fixed do
		local base = if f.group == G_HEAD then headBase elseif f.group == G_ABDOMEN then abdomenBase else bodyBase
		local palp = f.palp
		if palp then
			put(f.part, base * scaledFrame(pivots[palp] * f.offset))
		else
			local offset=f.offset
    if f.group==G_ABDOMEN then
     local p=A.abdomenCenter+(offset.Position-A.abdomenCenter)*condition
     offset=CFrame.new(p)*offset.Rotation
     local size=self._sizes[f.part]*g*condition
     if (f.part.Size-size).Magnitude>1e-5 then f.part.Size=size end
    end
    put(f.part, base * scaledFrame(offset))
		end
	end

	if fan then
		self:_drawFan(abdomenBase, if dancing then display.fanOpen else 0, put)
	end

	-- Legs: planted feet stay put in the world; a leg too far from its rest spot steps, in alternating groups.
	local swinging = false
	for _, leg in self._legs do
		swinging = swinging or leg.swing >= 0
	end
	if grounded and not swinging then
		local worst = STEP_ERROR * k
		for i, leg in self._legs do
			if leg.planted then
				local err = (body:PointToWorldSpace(restLocal(self, leg)) - leg.planted :: Vector3).Magnitude
				if err > worst then
					worst = err
					self._group = legGroup(self, i)
				end
			end
		end
	end
	local L = look.limbs
	local started = false
	for i, leg in self._legs do
		local rest = body:PointToWorldSpace(restLocal(self, leg))
		if not grounded then
			leg.planted = nil
			leg.swing = -1
			leg.foot = body:PointToWorldSpace(Vector3.new(leg.side * 0.47 * k, -0.12 * k, L.tipZ[leg.pair] * 0.72 * g))
		else
			if leg.planted == nil then
				local hit = target(self, body, leg)
				leg.planted = if hit then hit.Position else nil
				leg.foot = if hit then hit.Position else rest + up * 0.16
				leg.swing = -1
			end
			local anchor = leg.planted
			if anchor then
				if leg.swing >= 0 then
					leg.swing = math.min(1, leg.swing + dt / (SWING_SECONDS * math.sqrt(k)))
					local s = leg.swing
					local smooth = s * s * (3 - 2 * s)
					leg.foot = leg.from:Lerp(anchor, smooth) + leg.up * math.sin(math.pi * s) * (STEP_HEIGHT * k)
					if leg.swing >= 1 then
						leg.swing = -1
						leg.foot = anchor
					end
				else
					leg.foot = anchor
					local err = (rest - anchor).Magnitude
					if err > STEP_ERROR * k and ((not swinging and legGroup(self, i) == self._group) or err > 0.60 * k) then
						local hit = target(self, body, leg)
						if hit and (anchor - hit.Position).Magnitude > 0.12 * k then
							leg.from = anchor
							leg.planted = hit.Position
							leg.up = hit.Normal
							leg.swing = 0
							started = true
						end
					end
					if body:PointToObjectSpace(leg.foot).Magnitude > 1.4 * k then
						leg.planted = nil
						leg.foot = rest
					end
				end
			end
		end
	end
	if started then
		self._group = 1 - self._group
	end
	local kneeUp = (if grounded then L.kneeLift else L.kneeLiftAir)*g
	for _, leg in self._legs do
		local hip = bodyBase:PointToWorldSpace(Vector3.new(leg.side * L.hipX, L.hipY, L.hipZ[leg.pair])*g)
		local foot = leg.foot
		local knee = hip:Lerp(foot, 0.48) + up * kneeUp
		local own = if dancing and look.pairs then look.pairs[leg.pair] else nil
		if own and display.legsRaise > 0 then
			-- Legs III go up in a V beside the fan and wave: down and forward over the carapace, and back up (the planted foot below is untouched).
			local raise = display.legsRaise
			local upAt = Vector3.new(leg.side * own.up.x, own.up.y, own.up.z)
			local sweptAt = Vector3.new(leg.side * own.swept.x, own.swept.y, own.swept.z)
			local raised = bodyBase:PointToWorldSpace(upAt:Lerp(sweptAt, display.legsWave)*g)
			foot = foot:Lerp(raised, raise)
			local raisedKnee = hip:Lerp(raised, 0.5) + bodyBase.RightVector * (leg.side * own.kneeOut*g) + up * look.dance.kneeUp*g
			knee = knee:Lerp(raisedKnee, raise)
		end
		local ankle = knee:Lerp(foot, ANKLE_SHARE) + up * (L.ankleLift*g)
		local function segment(index: number, p: Part, band: Part?, a: Vector3, b: Vector3)
			local len = math.max((b - a).Magnitude, 0.01)
			if math.abs(p.Size.X - len) > 1e-3 then
				p.Size = Vector3.new(len, p.Size.Y, p.Size.Z)
			end
			local rc = rodCFrame(a, b) -- local +X runs from a toward b (toward the foot)
			put(p, rc)
			if band then
				band.Size = Vector3.new(len * look.bandFraction, p.Size.Y * 1.035, p.Size.Z * 1.035)
				put(band, rc)
			end
			-- Leg setae stand out from the segment and lean toward the foot.
			local r = p.Size.Y * 0.5
			for _, hair in leg.hairs do
				local spec = hair.spec
				if spec.segment == index then
					local c, s = math.cos(spec.theta), math.sin(spec.theta)
					local base = Vector3.new((spec.t - 0.5) * len, r * 0.8 * c, r * 0.8 * s)
					local dir = Vector3.new(1.3, c, s).Unit
					put(hair.part, rc * CFrame.lookAt(base + dir * (spec.length * g * 0.5), base + dir * spec.length*g, Vector3.xAxis))
				end
			end
		end
		segment(1, leg.femur, leg.bands[1], hip, knee)
		segment(2, leg.tibia, leg.bands[2], knee, ankle)
		segment(3, leg.tarsus, leg.bands[3], ankle, foot)
		put(leg.knee, CFrame.new(knee))
		put(leg.ankle, CFrame.new(ankle))
		if leg.pad then put(leg.pad :: Part, CFrame.new(foot)) end
	end
	Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Sets the fan's discs for how far it is open (0: folded on the abdomen, 1: a near-round disc) in the abdomen's frame. The discs grow from
-- Appearances.fan.folded to full size; the figure and the repeat on the back follow; the folded flaps swing out from the flanks and end
-- under the discs. Flat ellipsoids: only their size and place change.
function SpiderRig._drawFan(self: Rig, abdomen: CFrame, open: number, put: (BasePart, CFrame) -> ())
	local fan = self._fan :: Fan
	local fc, A = fan.cfg, self._layout
 local g=self._growth
 local c=self._shownCondition
 local condition=Vector3.new(.84+.30*c,.84+.30*c,.93+.12*c)
 local output=put
 local inverse=abdomen:Inverse()
 put=function(p: BasePart,cf: CFrame)
  local relative=inverse*cf
  local at=A.abdomenCenter+(relative.Position-A.abdomenCenter)*condition
  p.Size=p.Size*condition
  output(p,abdomen*CFrame.new(at*g)*relative.Rotation)
 end
	local sx = fc.folded[1] + (1 - fc.folded[1]) * open
	local sz = fc.folded[2] + (1 - fc.folded[2]) * open
	local fold = 1 - open
	local top = A.abdomenCenter.Y + A.abdomenRadii.Y + fc.plane - fc.foldedSink * fold
	local z = A.abdomenCenter.Z + fc.zShift * open
	local thick = fc.thickness + (fc.foldedThickness - fc.thickness) * fold
	local function place(d: FanDisc, y: number, t: number)
		local rx, rz = math.max((fc.radii[1] - d.inset) * sx, 0.002), math.max((fc.radii[2] - d.inset) * sz, 0.002)
		local size = Vector3.new(rx * 2, t, rz * 2)*g
		if (d.part.Size - size).Magnitude > 1e-5 then d.part.Size = size end
		put(d.part, abdomen * CFrame.new(0, y, z))
	end
	for _, d in fan.front do place(d, top + d.y, thick) end
	local mid = A.abdomenCenter.Y - A.abdomenRadii.Y
	for _, d in fan.back do place(d, mid + d.y, fc.thickness) end
	local figureY = top + #fan.front * fc.layerStep + (thick - fc.thickness) * 0.5
	local show = open * open * (3 - 2 * open) -- the black figure shows as the fan opens, and is gone when it is folded
	for _, f in fan.figure do
		local size = Vector3.new(math.max(f.rx * fc.radii[1] * sx * 2 * show, 0.002), fc.thickness, math.max(f.rz * fc.radii[2] * sz * 2 * show, 0.002))*g
		if (f.part.Size - size).Magnitude > 1e-5 then f.part.Size = size end
		put(f.part, abdomen * CFrame.new(f.x * fc.radii[1] * sx, figureY, z + f.z * fc.radii[2] * sz) * CFrame.Angles(0, f.angle, 0))
	end
	local fl = fc.flaps
	local angle = math.rad(fl.foldedDeg) * (1 - open)
	for _, f in fan.flaps do
		f.part.Size=self._sizes[f.part]*g
		local hinge = Vector3.new(f.side * fl.hingeX, A.abdomenCenter.Y + fl.hingeY, A.abdomenCenter.Z + fc.zShift * open)
		put(f.part, abdomen * CFrame.new(hinge) * CFrame.Angles(0, 0, f.side * angle) * CFrame.new(f.side * fl.radii[1], 0, 0))
	end
end

-- Spider-eye view (Godot SpiderBody.set_eye_view + SurfaceLegs.eye_view): the body, head and palps are hidden and only the
-- front legs' lower segments stay, reaching into the view. Client-only (LocalTransparencyModifier).
local function applyVisibility(self: Rig)
	local function show(p: BasePart, visible: boolean)
		p.LocalTransparencyModifier = if visible then 0 else 1
	end
	local hideBody = self._eyeView or self._bodyHidden
	if self._highlight then (self._highlight :: Highlight).Enabled = not hideBody end
	for _, f in self._fixed do
		show(f.part, not hideBody)
	end
	local fan = self._fan
	if fan then
		for _, part in fan.parts do show(part, not hideBody) end
	end
	for _, leg in self._legs do
		local frontReach = self._eyeView and leg.pair == 1
		local all = not hideBody
		show(leg.femur, all); show(leg.knee, all)
		show(leg.tibia, all or frontReach)
		show(leg.tarsus, all or frontReach); show(leg.ankle, all or frontReach)
		for n, band in leg.bands do show(band, all or (frontReach and n >= 2)) end
		if leg.pad then show(leg.pad :: Part, all or frontReach) end
		for _, hair in leg.hairs do
			show(hair.part, all or (frontReach and hair.spec.segment >= 2))
		end
	end
end

function SpiderRig.setEyeView(self: Rig, on: boolean)
	self._eyeView = on
	applyVisibility(self)
end

-- The orbit camera hides the spider when its boom is squeezed shorter than BODY_HIDE_LENGTH.
function SpiderRig.setBodyHidden(self: Rig, hidden: boolean)
	self._bodyHidden = hidden
	applyVisibility(self)
end

-- Where the dragline leaves the body.
function SpiderRig.spinneretPoint(self: Rig, body: CFrame): Vector3
	return body:PointToWorldSpace(self._layout.spinneret*self._growth - Vector3.new(0, self._drop, 0))
end

function SpiderRig.destroy(self: Rig)
	self.model:Destroy()
end

return SpiderRig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="90">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">ControlText</string>
            <string name="Source"><![CDATA[--!strict
-- Words on the screen, written for the device the player is using now: keyboard and mouse, a controller, or touch.
-- The texts are the frozen Godot game's (scripts/presentation/jump_feedback.gd, key_names.gd and jump_hud.gd at c87ce00);
-- where Godot wrote both keys ("Q / B"), each device here names only its own key or button. Pure: tests/run.luau checks
-- every prompt without Roblox.
local ControlText = {}

export type Device = "keyboard" | "gamepad" | "touch"

ControlText.TITLES = {
	reachable = "Reachable",
	obstructed = "Blocked",
	unreachable = "Out of reach",
	ineligible = "Can't land there",
	none = "No surface in view",
}
ControlText.REASONS = {
	ok = "",
	no_target = "no surface in view",
	ineligible_surface = "the spider cannot hold on there",
	too_far = "too far or too high",
	no_launch = "no way to leave this surface toward there",
	no_arrival = "it can't land from that angle",
	no_durations = "out of range",
	no_room = "no room to land",
	path_blocked = "something is in the way",
	graze = "it would only graze the surface",
	hop_blocked = "something is in the way",
	no_ground = "nothing to land on ahead",
}
ControlText.ANCHOR_TEXT = {
	ok = "Safety line: anchored here",
	no_silk = "No safety line: this surface won't hold silk",
	too_long = "No safety line: this jump needs more line than you have",
	no_support = "",
}
ControlText.LINE_TITLE = "On your line"
ControlText.LINE_TITLE_REELING = "On your line: reeling in"
ControlText.LINE_BLOCKED = {
	blocked = "Can't reel in: something is in the way. Lower, or let go",
	shortest = "Reeled in as far as it goes",
	snagged = "The line is caught on a second edge and can't be reeled in. Lower, or let go",
}
ControlText.DROP_REFUSED = {
	no_edge = "Nothing below to let yourself down into from here",
	no_silk = "This surface won't hold your silk",
	no_support = "",
	stuck = "Couldn't get to the edge",
}
ControlText.DROP_WALK = "To the edge, to let yourself down"

-- What each device calls the controls. Godot's input_setup.gd bindings; the port keeps the D-pad for walking, so lowering on
-- silk is X on a controller (ROBLOX-05). Touch names are the on-screen buttons.
local NAMES: { [string]: { [string]: string } } = {
	keyboard = {
		feed = "E", jump = "Space", cancel = "Q", letGo = "Q", drop = "F", reel = "W", lower = "S", walk = "WASD", look = "Mouse",
		creep = "Shift", focus = "Right mouse", eye = "V", recenter = "R", slow = "T", reset = "Backspace", help = "H", zoom = "Wheel",
		choose = "C", display = "X", menu = "M", notebook = "N",
	},
	gamepad = {
		feed = "Left-stick click", jump = "A", cancel = "B", letGo = "B", drop = "X", reel = "Stick up", lower = "Stick down", walk = "Left stick",
		look = "Right stick", creep = "LB", focus = "LT", eye = "Y", recenter = "Right-stick click", slow = "RT", reset = "View",
		help = "", zoom = "", choose = "RB", display = "RB", menu = "View", notebook = "View",
	},
	touch = {
		feed = "Eat", jump = "Jump", cancel = "Cancel", letGo = "Let go", drop = "Silk", reel = "↑", lower = "↓", walk = "Arrows",
		look = "Drag", creep = "Creep", focus = "Focus", eye = "Eye", recenter = "Recenter", slow = "", reset = "", help = "", zoom = "", choose = "Change", display = "Dance", menu = "Menu", notebook = "Notebook",
	},
}

-- A PlayStation controller has the same buttons under other names (Roblox reports "ButtonCross" for ButtonA there). The client
-- calls setPadStyle from UserInputService:GetStringForKeyCode(ButtonA) at start and after each controller input; names not listed
-- here (sticks) are the same on both.
local PLAYSTATION: { [string]: string } = {
	feed = "L3", jump = "Cross", cancel = "Circle", letGo = "Circle", drop = "Square", creep = "L1", focus = "L2", eye = "Triangle",
	recenter = "R3", slow = "R2", reset = "Touchpad", choose = "R1", display = "R1", menu = "Touchpad", notebook = "Touchpad",
}
local padStyle = "xbox"

-- "xbox" or "playstation", from what Roblox calls ButtonA on this controller.
function ControlText.padStyleFor(buttonAString: string?): string
	return if buttonAString == "ButtonCross" then "playstation" else "xbox"
end

function ControlText.setPadStyle(style: string)
	padStyle = if style == "playstation" then "playstation" else "xbox"
end

function ControlText.padStyle(): string
	return padStyle
end

function ControlText.name(device: Device, action: string): string
	if device == "gamepad" and padStyle == "playstation" and PLAYSTATION[action] then
		return PLAYSTATION[action]
	end
	return (NAMES[device] or NAMES.keyboard)[action] or ""
end

-- The device whose names to show after an input of this UserInputType (its Enum name). Anything else keeps the previous one.
function ControlText.deviceFor(inputType: string, previous: Device): Device
	if inputType == "Touch" then return "touch" end
	if string.sub(inputType, 1, 7) == "Gamepad" then return "gamepad" end
	if inputType == "Keyboard" or inputType == "TextInput" or string.sub(inputType, 1, 5) == "Mouse" then return "keyboard" end
	return previous
end

-- Before any input: a touch-only device shows touch, a controller without a keyboard (a console) shows the controller.
function ControlText.initialDevice(touch: boolean, keyboard: boolean, gamepad: boolean): Device
	if touch and not keyboard then return "touch" end
	if gamepad and not keyboard then return "gamepad" end
	return "keyboard"
end

function ControlText.reason(plan: any): string
	if plan == nil then return "" end
	return ControlText.REASONS[plan.reason] or tostring(plan.reason or "")
end

-- The two lines at the reticle while aiming (JumpFeedback.describe, hold mode) and Godot's cancel hint beside the second.
function ControlText.describe(plan: any, device: Device): (string, string)
	local cancel = ControlText.name(device, "cancel") .. ": cancel the jump"
	if plan == nil then
		return ControlText.TITLES.none, "release to cancel    " .. cancel
	end
	local kind = plan.kind
	local valid = kind == "reachable"
	local title = ControlText.TITLES[kind] or kind
	if not valid and kind ~= "none" then
		local why = ControlText.reason(plan)
		if why ~= "" then title = title .. ": " .. why end
	end
	return title, (if valid then "release to leap" else "release to cancel") .. "    " .. cancel
end

function ControlText.anchorText(reason: string): string
	return ControlText.ANCHOR_TEXT[reason] or ""
end

-- The toast for a jump outcome (JumpFeedback.toast): "" for outcomes that need none.
function ControlText.toast(kind: string, plan: any): string
	local why = ControlText.reason(plan)
	if kind == "refused" then
		return "Jump cancelled: " .. (if why ~= "" then why else "nothing to land on")
	elseif kind == "hop_refused" then
		return "No hop: " .. (if why ~= "" then why else "nowhere to land")
	elseif kind == "cancelled" then
		return "Jump cancelled"
	elseif kind == "out_of_bounds" then
		return "Out of bounds: back to the last safe spot"
	end
	return ""
end

-- The toast for a line event (JumpFeedback.line_toast). afterMiss: the line had been locked by a miss; dropped: the spider
-- let itself down on this line (the line taking its weight is no surprise then).
function ControlText.lineToast(kind: string, detail: string, afterMiss: boolean, dropped: boolean, device: Device): string
	if kind == "caught" then
		return if dropped then "" else "Caught by your line"
	elseif kind == "drop_walk" then
		return ControlText.DROP_WALK
	elseif kind == "dropped" then
		return `Letting yourself down: hold {ControlText.name(device, "drop")} to lower, {ControlText.name(device, "reel")} to climb`
	elseif kind == "drop_refused" then
		return ControlText.DROP_REFUSED[detail] or ""
	elseif kind == "completed" then
		return if afterMiss then "Holding on again. The line stays behind for a moment" else ""
	elseif kind == "released" then
		return "You let go of the line"
	elseif kind == "lost" then
		return "Your line came loose: its anchor is gone"
	elseif kind == "blocked" then
		return ControlText.LINE_BLOCKED[detail] or ""
	elseif kind == "snagged" then
		return ControlText.LINE_BLOCKED.snagged
	end
	return ""
end

-- The panel at the bottom while on the line: its title, the line's own prompts (distinct from cancelling an aim) and a cue.
-- ctx: reeling, progress (0..1 of a deliberate let-go hold), snagged, block ("", "blocked", "shortest").
function ControlText.linePanel(ctx: any, device: Device): (string, string, string)
	local title = if ctx.reeling then ControlText.LINE_TITLE_REELING else ControlText.LINE_TITLE
	local hint = `{ControlText.name(device, "reel")}: reel in    {ControlText.name(device, "lower")}: lower    hold {ControlText.name(device, "letGo")}: let go`
	local cue = ""
	if (ctx.progress or 0) > 0 then
		cue = `Letting go... {math.floor(ctx.progress * 100 + 0.5)}%`
	elseif ctx.snagged then
		cue = ControlText.LINE_BLOCKED.snagged
	elseif ctx.block and ctx.block ~= "" then
		cue = ControlText.LINE_BLOCKED[ctx.block] or ""
	end
	return title, hint, cue
end

-- Walking (port-only reminder, shown small): how to jump and how to let down on silk.
function ControlText.walkHint(device: Device): string
	local j = ControlText.name(device, "jump")
	return `Tap {j}: hop    hold {j}: aim a leap    {ControlText.name(device, "drop")}: let yourself down on silk`
end

-- Walking to an edge to let down: what stops it.
function ControlText.edgeWalkHint(device: Device): string
	return `{ControlText.DROP_WALK}    {ControlText.name(device, "cancel")} or move: stop`
end

-- The touch Cancel button's words: on the line it is the let-go button (held), elsewhere it cancels.
function ControlText.touchCancelLabel(onLine: boolean): string
	return if onLine then "Let go\n(hold)" else "Cancel"
end

-- The controls card (H): the device's own bindings, one action per line pair.
function ControlText.helpCard(device: Device): string
	if device == "gamepad" then
		local function n(action: string): string return ControlText.name("gamepad", action) end
		return table.concat({
			`Left stick walk   Right stick look   {n("creep")} creep`,
			`Tap {n("jump")} hop   Hold {n("jump")} aim, release to leap   {n("cancel")} cancel`,
			`{n("drop")} lower on silk   On the line: stick up reel, down lower, hold {n("letGo")} let go`,
			`{n("eye")} spider-eye view   {n("recenter")} recenter   {n("focus")} focus   {n("slow")} slow motion`,
			`In the crack: L3 rest (sleep from evening)   {n("reset")}: life menu / last rest`,
		}, "\n")
	elseif device == "touch" then
		return table.concat({
			"Arrows walk   Drag to look   Creep (hold)",
			"Tap Jump hop   Hold Jump aim, release to leap   Cancel",
			"Silk lowers on silk   On the line: ↑ reel, ↓ lower, hold Let go",
			"Eye spider-eye view   Recenter",
			"In the crack: Rest (Sleep from evening)",
		}, "\n")
	end
	return table.concat({
		"WASD walk   Mouse look   Shift creep",
		"Tap Space hop   Hold Space aim, release to leap   Q cancel",
		"F lower on silk   On the line: W reel, S lower, hold Q let go",
		"V spider-eye view   R recenter   Right mouse focus   T slow motion",
		"In the crack: E rest (sleep from evening)   Backspace: last checkpoint   M: life menu",
		"Wheel zoom   G gait   H hide this",
	}, "\n")
end

return ControlText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">EyeOptics</string>
            <string name="Source"><![CDATA[--!strict
-- EyeOptics: the pure half of the spider-eye picture (ROBLOX-20). From k (how much the principal eyes are in use, 0 to 1) and the
-- time it works out the field of view, the colour grade, the blur and the depth of field, where the two retina strips are and how
-- they swing, how big a movement ring is and where an edge arc goes, the vignette's strength, the caption's fade and the UV layer's
-- transparency. Client/SpiderEyes draws what this says; nothing here touches the engine, so tests/eyes.luau checks every rule. The
-- numbers, and what they rest on, are in Shared/Data/Eyes. Angles are degrees, sizes pixels, times seconds. Screen y runs down.
local Eyes = require(script.Parent.Parent.Data.Eyes)

local EyeOptics = {}

-- What the picture looks like at one k (see EyeOptics.profile).
export type Profile = {
	k: number,
	fovDeg: number, -- vertical
	saturation: number,
	tint: Color3,
	contrast: number,
	brightness: number,
	blur: number, -- BlurEffect.Size
	dofFar: number,
	dofNear: number,
	dofRadius: number, -- InFocusRadius, studs
	strokeTransparency: number, -- of the retina strips
	fillTransparency: number,
	sweepDeg: number, -- how far each strip swings side to side
	torsionDeg: number, -- and how far it turns about its middle
	vignette: number, -- opacity at the screen's edge
}
-- A retina strip as a rounded box on the screen: its middle, its size and its turn (clockwise, as GuiObject.Rotation).
export type Strip = { x: number, y: number, w: number, h: number, rotation: number }
-- A thing the lateral eyes saw moving (a Sensor.motionSeen entry with the id it is filed under).
export type Moving = { direction: Vector3, distance: number, apparent: number, tick: number }
export type Mover = { id: string, direction: Vector3, distance: number, apparent: number, tick: number }
-- One short bar of an edge arc.
export type Segment = { x: number, y: number, rotation: number }

-- a(1 - t) + bt, not a + (b - a)t: exactly a at 0 and exactly b at 1 (the looks at k = 0 and k = 1 are the spec's numbers to the digit).
local function lerp(a: number, b: number, t: number): number
	return a * (1 - t) + b * t
end

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

-- Smoothstep.
function EyeOptics.smooth(x: number): number
	local t = clamp01(x)
	return t * t * (3 - 2 * t)
end

-- ---------------------------------------------------------------- how much the principal eyes are in use
-- One step of the engagement clock. `phase` runs 0 to 1 in Eyes.timing.engageSeconds while the principal eyes are wanted (Focus
-- held, or toggled on) and back in releaseSeconds otherwise. It is linear in time, so every frame rate gives the same phase after
-- the same time; a change of mind part-way simply turns it round.
function EyeOptics.stepPhase(phase: number, wanted: boolean, dt: number): number
	local T = Eyes.timing
	local step = math.max(dt, 0)
	return clamp01(phase + (if wanted then step / T.engageSeconds else -step / T.releaseSeconds))
end

-- k: the phase, eased, so the picture starts and settles gently.
function EyeOptics.engagement(phase: number): number
	return EyeOptics.smooth(phase)
end

-- ---------------------------------------------------------------- the field of view and the look
-- The principal eyes' vertical field: 24 degrees, or no narrower than 45 with reduced motion.
function EyeOptics.principalFovDeg(reduced: boolean): number
	if reduced then
		return math.max(Eyes.principal.fovDeg, Eyes.reducedMotion.minFovDeg)
	end
	return Eyes.principal.fovDeg
end

-- The vertical field at k, blended in tangent space (the half-angle's tangent is the screen's half-height at unit distance), so
-- the zoom looks even instead of rushing at the end. Exactly the side eyes' at 0 and the principal eyes' at 1.
function EyeOptics.fovDeg(k: number, reduced: boolean): number
	local far, near = Eyes.side.fovDeg, EyeOptics.principalFovDeg(reduced)
	if k <= 0 then
		return far
	elseif k >= 1 then
		return near
	end
	return math.deg(2 * math.atan(lerp(math.tan(math.rad(far) / 2), math.tan(math.rad(near) / 2), k)))
end

-- How much of the player's look a turn of the view gets at this field of view, so the picture moves as fast across the screen
-- whatever the zoom: tan(fov / 2) against the side eyes' tan(90 / 2) = 1.
function EyeOptics.lookScale(fovDeg: number): number
	return math.tan(math.rad(fovDeg) / 2) / math.tan(math.rad(Eyes.side.fovDeg) / 2)
end

local function mix3(a: { number }, b: { number }, k: number): Color3
	return Color3.new(lerp(a[1], b[1], k) / 255, lerp(a[2], b[2], k) / 255, lerp(a[3], b[3], k) / 255)
end

-- Everything that depends on k, blended: every number is the side eyes' at 0 and the principal eyes' at 1, the field of view in
-- tangent space. focusDistance (studs, what is looked at) sets how deep the sharp zone of the depth of field is.
function EyeOptics.profile(k: number, focusDistance: number, reduced: boolean): Profile
	local t = clamp01(k)
	local s, p = Eyes.side, Eyes.principal
	local distance = math.max(focusDistance, 0)
	local sideRadius = math.max(s.dofRadiusMin, s.dofRadiusPerStud * distance)
	local principalRadius = math.max(p.dofRadiusMin, p.dofRadiusPerStud * distance)
	return {
		k = t,
		fovDeg = EyeOptics.fovDeg(t, reduced),
		saturation = lerp(s.saturation, p.saturation, t),
		tint = mix3(s.tint, p.tint, t),
		contrast = lerp(s.contrast, p.contrast, t),
		brightness = lerp(s.brightness, p.brightness, t),
		blur = lerp(s.blur, p.blur, t),
		dofFar = lerp(s.dofFar, p.dofFar, t),
		dofNear = lerp(s.dofNear, p.dofNear, t),
		dofRadius = lerp(sideRadius, principalRadius, t),
		strokeTransparency = lerp(s.strokeTransparency, p.strokeTransparency, t),
		fillTransparency = lerp(s.fillTransparency, p.fillTransparency, t),
		sweepDeg = if reduced then 0 else lerp(s.sweepDeg, p.sweepDeg, t),
		torsionDeg = if reduced then 0 else lerp(s.torsionDeg, p.torsionDeg, t),
		vignette = lerp(s.vignette, p.vignette, t),
	}
end

-- ---------------------------------------------------------------- where the eyes are focused
-- The distance to focus on: how far the looked-along ray ran before it hit the world (nil when it hit nothing), at most the
-- limit.
function EyeOptics.focusTarget(hitDistance: number?): number
	local limit = Eyes.focus.maxDistance
	if hitDistance == nil then
		return limit
	end
	return math.min(hitDistance, limit)
end

-- One step of the focus racking from one distance to the next: an exponential approach with Eyes.focus.tauSeconds as its time
-- constant. Any frame rate gives the same distance after the same time.
function EyeOptics.focusStep(current: number, target: number, dt: number): number
	return current + (target - current) * (1 - math.exp(-math.max(dt, 0) / Eyes.focus.tauSeconds))
end

-- ---------------------------------------------------------------- sizes on the screen
-- Pixels for one unit of tangent at this vertical field of view: the screen's half-height over tan(fov / 2).
function EyeOptics.pixelsPerTan(fovDeg: number, viewportH: number): number
	return viewportH * 0.5 / math.tan(math.rad(fovDeg) * 0.5)
end

-- How long, in pixels, something that spans `angleDeg` about the middle of the view looks: tangent-correct, so a 20 degree strip
-- at a 24 degree field is tan(10) / tan(12) of the screen's height. Square pixels, so it serves for width and height alike.
function EyeOptics.extentPx(angleDeg: number, fovDeg: number, viewportH: number): number
	return 2 * math.tan(math.rad(math.min(angleDeg, 170)) * 0.5) * EyeOptics.pixelsPerTan(fovDeg, viewportH)
end

-- How far from the middle of the screen, in pixels, a direction `angleDeg` off the view's axis lands.
function EyeOptics.offsetPx(angleDeg: number, fovDeg: number, viewportH: number): number
	return math.tan(math.rad(angleDeg)) * EyeOptics.pixelsPerTan(fovDeg, viewportH)
end

-- ---------------------------------------------------------------- the retinae
-- Strip `index` (1 the left one, 2 the right) at time t: how far it has swayed from its place and turned from its tilt, in
-- degrees. The second strip runs lagSeconds behind the first in both (the retinae do not move as one). The amplitudes come from
-- the profile (large with the side eyes, small tracking with the principal eyes, none with reduced motion).
function EyeOptics.scanPose(index: number, t: number, sweepDeg: number, torsionDeg: number): (number, number)
	local R = Eyes.retina
	local at = t - (index - 1) * R.lagSeconds
	return sweepDeg * math.sin(2 * math.pi * at / R.sweepSeconds), torsionDeg * math.sin(2 * math.pi * at / R.torsionSeconds)
end

-- The two strips as the player sees them, for a profile (its field of view and its swing), the time and the screen's size: each
-- at its true angular size (widthDeg x heightDeg), offsetDeg either side of the middle plus its sway, tilted tiltDeg into a V (the
-- left one leaning out to the left at the top) plus its turn.
function EyeOptics.retinaStrips(t: number, p: Profile, viewportW: number, viewportH: number): { Strip }
	local R = Eyes.retina
	local w = EyeOptics.extentPx(R.widthDeg, p.fovDeg, viewportH)
	local h = EyeOptics.extentPx(R.heightDeg, p.fovDeg, viewportH)
	local out: { Strip } = {}
	for i = 1, 2 do
		local side = if i == 1 then -1 else 1
		local sway, turn = EyeOptics.scanPose(i, t, p.sweepDeg, p.torsionDeg)
		out[i] = {
			x = viewportW * 0.5 + EyeOptics.offsetPx(side * R.offsetDeg + sway, p.fovDeg, viewportH),
			y = viewportH * 0.5,
			w = w,
			h = h,
			rotation = side * R.tiltDeg + turn,
		}
	end
	return out
end

-- True when the screen point lies inside the strip: the rounded box (a stadium, the strip being taller than wide), turned as it
-- is drawn.
function EyeOptics.insideStrip(px: number, py: number, s: Strip): boolean
	local dx, dy = px - s.x, py - s.y
	local a = math.rad(s.rotation)
	local c, sn = math.cos(a), math.sin(a)
	local lx, ly = dx * c + dy * sn, -dx * sn + dy * c
	local r = s.w * 0.5
	local reach = math.max(s.h * 0.5 - r, 0)
	local oy = ly - math.clamp(ly, -reach, reach)
	return lx * lx + oy * oy <= r * r
end

function EyeOptics.insideAnyStrip(px: number, py: number, strips: { Strip }): boolean
	for _, s in strips do
		if EyeOptics.insideStrip(px, py, s) then
			return true
		end
	end
	return false
end

-- ---------------------------------------------------------------- the lateral eyes' movement rings
-- 0 to 1 and back, Eyes.shimmer.hz times a second, from time t; a steady half with reduced motion.
function EyeOptics.pulse(t: number, reduced: boolean): number
	if reduced then
		return 0.5
	end
	return 0.5 - 0.5 * math.cos(2 * math.pi * Eyes.shimmer.hz * t)
end

-- A ring's diameter in pixels: the thing's apparent size (degrees across, as the sensor measured it) at this field of view, at
-- least minPx, times scaleMin to scaleMax as the pulse goes 0 to 1.
function EyeOptics.ringDiameter(apparentDeg: number, fovDeg: number, viewportH: number, pulse: number): number
	local S = Eyes.shimmer
	local base = math.max(S.minPx, EyeOptics.extentPx(apparentDeg, fovDeg, viewportH))
	return base * lerp(S.scaleMin, S.scaleMax, clamp01(pulse))
end

-- 1 when the thing was just seen moving, 0 when the sensor's hold (holdTicks, Sensor.MOTION_HOLD_TICKS) has run out.
function EyeOptics.freshness(nowTick: number, seenTick: number, holdTicks: number): number
	return 1 - clamp01((nowTick - seenTick) / math.max(holdTicks, 1))
end

-- A ring's opacity: the base alpha, as fresh as the sighting, a third of that (insideStripFactor) inside a retina strip.
function EyeOptics.ringAlpha(fresh: number, inside: boolean): number
	local S = Eyes.shimmer
	return S.alpha * clamp01(fresh) * (if inside then S.insideStripFactor else 1)
end

-- An edge arc's opacity: as fresh as the sighting, breathing a little with the pulse.
function EyeOptics.arcAlpha(fresh: number, pulse: number): number
	local A = Eyes.shimmer.arc
	return A.alpha * clamp01(fresh) * lerp(1 - A.breath, 1, clamp01(pulse))
end

-- The things to draw: the freshest first, at most maxCount, ties broken by id so the same record always gives the same list.
function EyeOptics.pickMovers(seen: { [string]: Moving }, maxCount: number): { Mover }
	local list: { Mover } = {}
	for id, e in seen do
		table.insert(list, { id = id, direction = e.direction, distance = e.distance, apparent = e.apparent, tick = e.tick })
	end
	table.sort(list, function(a: Mover, b: Mover): boolean
		if a.tick ~= b.tick then
			return a.tick > b.tick
		end
		return a.id < b.id
	end)
	while #list > maxCount do
		table.remove(list)
	end
	return list
end

-- True when a point (pixels) is inside the screen, give or take `margin`.
function EyeOptics.onScreen(x: number, y: number, viewportW: number, viewportH: number, margin: number): boolean
	return x >= -margin and x <= viewportW + margin and y >= -margin and y <= viewportH + margin
end

-- Where the screen's edge is in the direction of something off screen: (cx, cy) is its direction in the camera's own axes (x
-- right, y up). The same rule as the perception HUD's edge marks: a direction straight behind goes to the top, and the point is
-- `inset` pixels inside the edge. Returns the point's x and y and the unit direction (x, y; y down) from the screen's middle to it.
function EyeOptics.edgeMark(cx: number, cy: number, viewportW: number, viewportH: number, inset: number): (number, number, number, number)
	local vx, vy = cx, -cy
	local m = math.sqrt(vx * vx + vy * vy)
	if m < 0.03 then
		vx, vy, m = 0, -1, 1
	end
	vx, vy = vx / m, vy / m
	local hx, hy = viewportW * 0.5 - inset, viewportH * 0.5 - inset
	local t = math.min(hx / math.max(math.abs(vx), 1e-6), hy / math.max(math.abs(vy), 1e-6))
	return viewportW * 0.5 + vx * t, viewportH * 0.5 + vy * t, vx, vy
end

-- The short bars that make an edge arc: `segments` of them, stepDeg apart along a circle of `radius` pixels whose outermost point
-- is (x, y), where `d` (dx, dy) points out of the screen. Each bar's rotation lays it along the circle there.
function EyeOptics.arcSegments(x: number, y: number, dx: number, dy: number): { Segment }
	local A = Eyes.shimmer.arc
	local cx, cy = x - dx * A.radius, y - dy * A.radius
	local nx, ny = -dy, dx
	local out: { Segment } = {}
	local middle = (A.segments + 1) / 2
	for i = 1, A.segments do
		local phi = math.rad((i - middle) * A.stepDeg)
		local c, s = math.cos(phi), math.sin(phi)
		out[i] = {
			x = cx + A.radius * (c * dx + s * nx),
			y = cy + A.radius * (c * dy + s * ny),
			rotation = math.deg(math.atan2(-s * dy + c * ny, -s * dx + c * nx)),
		}
	end
	return out
end

-- ---------------------------------------------------------------- the words, the UV layer
-- The caption's opacity `age` seconds into the eye view: it fades in, holds and fades out, and is gone after Eyes.caption.seconds.
function EyeOptics.captionAlpha(age: number): number
	local C = Eyes.caption
	if age < 0 or age >= C.seconds then
		return 0
	end
	return EyeOptics.smooth(age / C.fadeInSeconds) * EyeOptics.smooth((C.seconds - age) / C.fadeOutSeconds)
end

-- The caption: what the side eyes do, then how to use the principal eyes. `key` is the device's Focus control (ControlText);
-- `toggled` when Focus is a toggle, which is pressed and not held.
function EyeOptics.captionText(key: string, toggled: boolean): string
	local C = Eyes.caption
	return C.side .. "\n" .. string.format(C.principal, if toggled then C.toggle else C.hold, if key ~= "" then key else "Focus")
end

-- A UV layer part's transparency: clear with the side eyes, as visible as its UVOpacity with the principal eyes.
function EyeOptics.uvTransparency(k: number, opacity: number): number
	return 1 - clamp01(k) * clamp01(opacity)
end

return EyeOptics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">HudLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Where the on-screen controls and the prompt panel go, in the safe area (ScreenInsets.CoreUISafeInsets: clear of notches,
-- the home bar and Roblox's top bar). Pure, so tests/run.luau checks that prompts never sit under a touch button and stay
-- wide enough to read, at phone, tablet and desktop sizes. SpiderInput builds the touch buttons from TOUCH_BUTTONS.
local HudLayout = {}

export type Button = { action: string, label: string, x: number, y: number, size: number, right: boolean, textSize: number? }
export type Rect = { x0: number, y0: number, x1: number, y1: number }

-- x, y: the button's top-left corner as an offset from the safe area's bottom-left (right = false) or bottom-right corner.
HudLayout.TOUCH_BUTTONS = {
	{ action = "Forward", label = "↑", x = 78, y = -188, size = 52, right = false },
	{ action = "Left", label = "←", x = 22, y = -132, size = 52, right = false },
	{ action = "Back", label = "↓", x = 78, y = -76, size = 52, right = false },
	{ action = "Right", label = "→", x = 134, y = -132, size = 52, right = false },
	{ action = "Jump", label = "Jump\n(hold)", x = -92, y = -102, size = 72, right = true },
	{ action = "Cancel", label = "Cancel", x = -166, y = -92, size = 60, right = true, textSize = 16 },
	{ action = "Creep", label = "Creep", x = -86, y = -172, size = 60, right = true },
	{ action = "Drop", label = "Silk", x = -86, y = -242, size = 60, right = true },
	{ action = "Recenter", label = "Re-\ncenter", x = -160, y = -168, size = 52, right = true, textSize = 14 },
	{ action = "Feed", label = "Eat", x = 22, y = -242, size = 52, right = false, textSize = 14 },
	{ action = "Focus", label = "Focus", x = -236, y = -242, size = 60, right = true, textSize = 14 },
	{ action = "Eye", label = "Eye", x = -156, y = -242, size = 60, right = true },
	-- The peacock spider (ROBLOX-31): Change (in the crack) beside Eat, Dance (the peacock spider, standing still) above Silk. Both start hidden.
	{ action = "Choose", label = "Change", x = 82, y = -246, size = 56, right = false, textSize = 13 },
	{ action = "Display", label = "Dance", x = -86, y = -306, size = 56, right = true, textSize = 14 },
} :: { Button }

HudLayout.GAP = 12
HudLayout.MIN_PROMPT_WIDTH = 260
HudLayout.MAX_PROMPT_WIDTH = 760

-- Short landscape safe areas need three rows rather than a tall stack: leave
-- room for the prompt above them, including when Dance/Change are visible.
local COMPACT = {
	Feed={16,-180}, Forward={76,-180}, Choose={136,-180},
	Left={16,-120}, Right={136,-120}, Back={76,-60},
	Focus={-188,-180}, Display={-128,-180}, Drop={-68,-180},
	Eye={-188,-120}, Recenter={-128,-120}, Creep={-68,-120},
	Cancel={-128,-60}, Jump={-68,-60},
}
function HudLayout.layoutButton(b: Button, width: number, height: number): Button
	if width >= 568 and height > 0 and height < 450 then
		local slot = COMPACT[b.action]
		if slot then
			local copy = table.clone(b)
			copy.x, copy.y, copy.size = slot[1], slot[2], 52
			copy.textSize = math.min(b.textSize or 18, 14)
			return copy
		end
	end
	return b
end

function HudLayout.buttonRect(b: Button, width: number, height: number): Rect
	b = HudLayout.layoutButton(b, width, height)
	local x0 = if b.right then width + b.x else b.x
	local y0 = height + b.y
	return { x0 = x0, y0 = y0, x1 = x0 + b.size, y1 = y0 + b.size }
end

-- The touch buttons' combined top edge and the inner edges of the two thumb clusters.
local function clusters(width: number, height: number): (number, number, number)
	local leftEdge, rightEdge, top = 0, width, height
	for _, b in HudLayout.TOUCH_BUTTONS do
		local r = HudLayout.buttonRect(b, width, height)
		if b.right then rightEdge = math.min(rightEdge, r.x0) else leftEdge = math.max(leftEdge, r.x1) end
		top = math.min(top, r.y0)
	end
	return leftEdge, rightEdge, top
end

-- The prompt panel's horizontal span and its bottom edge (it grows upward as it wraps) for a safe area of this size.
-- Keyboard and controller: centred near the bottom. Touch: between the thumb clusters when that leaves room to read,
-- otherwise above them.
function HudLayout.promptSpan(width: number, height: number, device: string): (number, number, number)
	local gap = HudLayout.GAP
	local x0, x1, bottom
	if device == "touch" then
		local leftEdge, rightEdge, top = clusters(width, height)
		if rightEdge - leftEdge - 2 * gap >= HudLayout.MIN_PROMPT_WIDTH then
			x0, x1, bottom = leftEdge + gap, rightEdge - gap, height - gap
		else
			x0, x1, bottom = gap, width - gap, top - gap
		end
	else
		x0, x1, bottom = 24, width - 24, height - 16
	end
	local extra = (x1 - x0) - HudLayout.MAX_PROMPT_WIDTH
	if extra > 0 then
		x0 += extra / 2
		x1 -= extra / 2
	end
	return x0, x1, bottom
end

function HudLayout.overlaps(a: Rect, b: Rect): boolean
	return a.x0 < b.x1 and b.x0 < a.x1 and a.y0 < b.y1 and b.y0 < a.y1
end

return HudLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">LifeText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of the life clock and the retreat for the screen (ROBLOX-24), from Godot's habitat_loop.gd caption(): the day and
-- the part of it, the one line for the time of day or hunger, and the retreat's prompt. Button names come from ControlText for
-- the device in use (Godot's interact is the port's feed button, E; cancel is Q). Pure, checked in tests/life.luau.
local ControlText = require(script.Parent.ControlText)

local LifeText = {}

export type Prompt = { title: string, hint: string }

-- "Day 2, evening".
function LifeText.day(day: number, part: string): string
	return `Day {day}, {part}`
end

-- The line under the day (Godot's precedence, among the lines this port has): starving, hungry, night, evening; nil otherwise.
-- `gentle` rules never say starving (Godot: is_starving() and not gentle).
function LifeText.line(part: string, energy: number, starving: boolean, gentle: boolean, hungryAt: number, weak: boolean?): string?
	if weak and not gentle then return "Starving: your spider will not last another day. Too hungry to sleep; find food." end
	if starving and not gentle then
		return "Starving: your spider's reserve is gone. It must eat soon."
	end
	if energy <= hungryAt then
		return "Hungry: time to hunt."
	end
	if part == "night" then
		return "It is dark, and your eyes reach only a little way. Home is the silk-lined crack at the west end."
	end
	if part == "evening" then
		return "Evening. Jumping spiders go into their silk retreat before dark."
	end
	return nil
end

-- The retreat's prompt: asleep, resting, or able to rest (sleep in the evening and at night); nil when none of these. `extra` (the crack's
-- way to change spider, ROBLOX-31) is added to the resting hint.
function LifeText.prompt(asleep: boolean, resting: boolean, canRest: boolean, sleepTime: boolean, device: ControlText.Device, extra: string?): Prompt?
	local feed, cancel = ControlText.name(device, "feed"), ControlText.name(device, "cancel")
	if asleep then
		return { title = "Asleep in the silk-lined crack", hint = `The night passes. Move, {feed} or {cancel} to wake.` }
	end
	if resting then
		return { title = "Resting in the silk-lined crack", hint = `Move, {feed} or {cancel} to leave.` .. (if extra and extra ~= "" then "    " .. extra else "") }
	end
	if canRest then
		return { title = "The silk-lined crack", hint = if sleepTime then `{feed}: sleep until morning` else `{feed}: rest` }
	end
	return nil
end

-- What the touch feed button says when it is the retreat's (nil: it is the meal's, or hidden).
function LifeText.touchLabel(asleep: boolean, resting: boolean, canRest: boolean, sleepTime: boolean): string?
	if asleep then return "Wake" end
	if resting then return "Leave" end
	if canRest then return if sleepTime then "Sleep" else "Rest" end
	return nil
end

return LifeText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">NotebookText</string>
            <string name="Source"><![CDATA[--!strict
-- The notebook's words and its layout rules for the screen (ROBLOX-37), from Godot's notebook_panel.gd: the heading, the empty
-- page, "In this game:" and the sources, the note that a page opened, and how to open and use the book on the device in use. Pure,
-- so tests/notebook.luau checks them (and the layout at phone, tablet and desktop sizes) without Roblox. Button names come from
-- ControlText (PlayStation names on a PlayStation controller).
local ControlText = require(script.Parent.ControlText)

local NotebookText = {}

NotebookText.HEADING = "Field notebook"
NotebookText.EMPTY = "Pages appear here as you play."
NotebookText.GAME = "In this game: "
NotebookText.CLOSE = "Close"
NotebookText.PAGES = "Pages"
NotebookText.MENU_CHOICE = "Notebook"
NotebookText.BUTTON = "Notebook"

-- Fills {reel}, {letGo}, {drop}, {focus} (any ControlText action name) in a page's "In this game" line with the device's name for it.
function NotebookText.fill(text: string, device: ControlText.Device): string
	local out = string.gsub(text, "{(%w+)}", function(action: string): string
		local name = ControlText.name(device, action)
		return if name ~= "" then name else "{" .. action .. "}"
	end)
	return out
end

-- The page's "In this game: ..." line, or nil when the page has none (Godot: an empty `game` shows nothing).
function NotebookText.gameLine(game: string, device: ControlText.Device): string?
	if game == "" then
		return nil
	end
	
	return NotebookText.GAME .. NotebookText.fill(game, device)
end

-- "Source: x" for one source, "Sources:\nx\ny" for several. The links stay in the text as they are.
function NotebookText.sourcesText(sources: { string }): string
	return (if #sources == 1 then "Source: " else "Sources:\n") .. table.concat(sources, "\n")
end

-- How to open the notebook, on the device in use: N on a keyboard; the Notebook button on touch; a controller has no spare button (the
-- D-pad walks), so it is the life menu (View, or the Touchpad on a PlayStation controller) and then Notebook.
function NotebookText.openHint(device: ControlText.Device): string
	if device == "gamepad" then
		return `{ControlText.name("gamepad", "menu")}, then {NotebookText.MENU_CHOICE},`
	elseif device == "touch" then
		return `the {NotebookText.BUTTON} button`
	end
	return ControlText.name("keyboard", "notebook")
end

-- The note when a page opens during play (Godot: "New in your notebook: %s\n(%s to read)").
function NotebookText.note(title: string, device: ControlText.Device): string
	return `New in your notebook: {title}\n({NotebookText.openHint(device)} to read)`
end

-- The line under the page: what the controls do, on the device in use. `stacked`: one pane at a time (small screens).
function NotebookText.controls(device: ControlText.Device, stacked: boolean): string
	local back = ControlText.name(device, "cancel")
	if device == "gamepad" then
		local a = ControlText.name("gamepad", "jump")
		return `Stick or D-pad: pages    {a}: open    Right stick: scroll    {back}: {if stacked then "back / close" else "close"}`
	elseif device == "touch" then
		return `Tap a page. Drag to scroll.`
	end
	return `Up and Down: pages    {if stacked then "Enter: open    Left and Right: previous and next    " else ""}Wheel, PageUp or PageDown: scroll    N or {back}: close`
end

-- ---------------------------------------------------------------- layout

-- Text sizes by kind at normal text, and the large-text option's factor (the life menu's switch: the Player attribute LargeText).
NotebookText.SIZES = { heading = 26, title = 24, body = 19, game = 17, sources = 14, button = 18, controls = 14 }
NotebookText.LARGE = 1.5
-- A touch target is at least this tall (before the text scale).
NotebookText.MIN_TARGET = 44

export type Layout = { sideBySide: boolean, listFraction: number }

-- Side by side (the pages on the left, the page on the right) needs room; a phone held sideways, a portrait phone or large text
-- show one pane at a time instead. `width` and `height` are the safe area's, `scale` the text scale (1 to LARGE).
function NotebookText.layout(width: number, height: number, scale: number): Layout
	local sideBySide = width >= 640 * scale and height >= 340
	return { sideBySide = sideBySide, listFraction = if sideBySide then 0.34 else 1.0 }
end

export type Metrics = { paperW: number, paperH: number, head: number, hint: number, foot: number, body: number }

-- Pixel sizes of the panel for a safe area of this size: the paper (97% by 95%, at most 1040 by 820), the heading band, the controls
-- line (two lines of text; 0 when the pages would be left with less than MIN_BODY px without it), the footer's buttons and the height
-- left for the pages (what scrolls). Pure, so a short screen can be checked: a phone held sideways is 568 by 320.
NotebookText.MIN_BODY = 120
function NotebookText.metrics(width: number, height: number, scale: number): Metrics
	local paperW, paperH = math.min(width * 0.97, 1040), math.min(height * 0.95, 820)
	local head = math.floor((NotebookText.SIZES.heading + 10) * scale)
	local foot = math.floor((NotebookText.MIN_TARGET + 8) * scale)
	local hint = math.floor(5 * NotebookText.SIZES.controls * scale) + 4
	local body = paperH - 20 - head - foot - 12
	if body - hint >= NotebookText.MIN_BODY then
		body -= hint
	else
		hint = 0
	end
	return { paperW = paperW, paperH = paperH, head = head, hint = hint, foot = foot, body = body }
end


-- Nathan requested an optional checklist on 2026-10-17 (ROBLOX-38).
-- These are invitations, not all possible pages or a completion gate. No task asks a child to starve or get caught.
NotebookText.TRY = {
 {id="bold_jumper",text="Meet your spider and explore the sill."},
 {id="dragline",text="Make a jump and see the safety silk."},
 {id="eight_eyes",text="Switch to the spider-eye view."},
 {id="moving_retinas",text="Spend a little time looking through its eyes."},
 {id="hunting_by_sight",text="Focus on a fly until you recognise it."},
 {id="venom",text="Catch a fly."},
 {id="drinking",text="Finish a meal."},
 {id="retreat",text="Rest inside the silk-lined crack."},
 {id="home_before_dark",text="Sleep in the crack through a night."},
 {id="new_skin",text="Eat, then rest when ready to moult."},
 {id="grown_up",text="Grow through three moults."},
 {id="peacock_dance",text="Change to the peacock while resting, then dance outside."},
}
function NotebookText.checklist(book:any):string
 local lines={}
 for _,entry in NotebookText.TRY do
  table.insert(lines,(if book:isOpen(entry.id) then "[x] " else "[ ] ")..entry.text)
 end
 return table.concat(lines,"\n\n")
end

return NotebookText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">PeacockText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of the peacock spider for the screen (ROBLOX-31): choosing the spider in the crack, the dance's prompts and status
-- line, the controls card's extra lines and the felt caption. Button names come from ControlText for the device in use. The dance's
-- own words are never shown for the first spider; choosing is offered in the crack to both, or the peacock spider could not be found.
-- Pure: checked in tests/peacock.luau.
local ControlText = require(script.Parent.ControlText)
local Peacock = require(script.Parent.Parent.Data.Peacock)
local SpiderChoice = require(script.Parent.Parent.Rig.SpiderChoice)

local PeacockText = {}

PeacockText.NAMES = { first_spider = "the first spider", maratus_volans_male = "the peacock spider" } :: { [string]: string }
PeacockText.STAND = "Stand still on a surface to dance"
PeacockText.NOT_RESTING = "You can change spider while resting in the silk-lined crack"

-- The crack's extra hint while resting: how to become the other spider.
function PeacockText.change(device: ControlText.Device, current: string): string
	local other = SpiderChoice.next(current)
	return `{ControlText.name(device, "choose")}: become {PeacockText.NAMES[other] or other}`
end

function PeacockText.changed(id: string): string
	return `You are {PeacockText.NAMES[id] or id} now`
end

-- The walking hint's extra words for the peacock spider.
function PeacockText.displayHint(device: ControlText.Device, dancing: boolean): string
	if dancing then return `{ControlText.name(device, "display")}: stop dancing` end
	return `{ControlText.name(device, "display")}: courtship dance`
end

-- The status line while the dance runs.
function PeacockText.dancingLine(device: ControlText.Device): string
	return `COURTSHIP DANCE    {ControlText.name(device, "display")} or move: stop`
end

-- The touch buttons' words.
function PeacockText.touchChange(): string return "Change" end
function PeacockText.touchDisplay(dancing: boolean): string return if dancing then "Stop" else "Dance" end

-- Lines added to the controls card (H): the crack's choice for both spiders, the dance for the peacock spider only.
function PeacockText.helpExtra(device: ControlText.Device, peacock: boolean): string
	local choose, display = ControlText.name(device, "choose"), ControlText.name(device, "display")
	local lines = { `In the crack: {choose} change spider (first spider, peacock spider)` }
	if peacock then
		table.insert(lines, `Standing still: {display} courtship dance. Any move, jump or Cancel stops it`)
	end
	return "\n" .. table.concat(lines, "\n")
end

-- The felt caption while a rumble-rump is on: { text, alpha }, or nil when there is none. The vibration is felt through the feet, not seen.
function PeacockText.caption(rumble: number): { text: string, alpha: number }?
	if rumble <= 0.02 then return nil end
	return { text = Peacock.feltCaption, alpha = math.clamp(rumble, 0, 1) }
end

return PeacockText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">PerceptionShapes</string>
            <string name="Source"><![CDATA[--!strict
-- PerceptionShapes: the geometry the perception HUD draws with (ROBLOX-20, the drawer's polish), pure. A last-seen ring is 12 short
-- bars along a circle, an off-screen cue's chevron is two bars, the Focus ticks are four, and a label hangs under the ring it
-- names. Client/PerceptionHud draws each bar as a thin rounded Frame; nothing here reads the engine, so tests/hud.luau checks every
-- rule. What is drawn, its words, opacities and timings are PerceptionView's and are not touched here.
-- Pixels, screen y down; a rotation is in degrees, clockwise, as GuiObject.Rotation.
local Shapes = {}

-- A thin bar: centred on (x, y), `length` long. `rotation` turns a horizontal bar clockwise to lie along it (a bar looks the same
-- turned half a turn, so it is kept in -90 to 90).
export type Bar = { x: number, y: number, length: number, rotation: number }

local function axis(deg: number): number
	return (deg + 90) % 180 - 90
end

-- A last-seen ring (PerceptionView kind "mark") is DASHES dashes at equal steps, the first at the top. `dash` (PerceptionView: 1
-- when the sighting is fresh, 0.3 when it is as stale as it gets) says how much of its step each dash covers, up to DASH_FILL, so
-- the gaps grow as the sighting ages. A dash is straight with both ends on the circle, never shorter than MIN_DASH pixels.
Shapes.DASHES = 12
Shapes.DASH_FILL = 0.85
Shapes.MIN_DASH = 2

function Shapes.dashRing(cx: number, cy: number, radius: number, dash: number): { Bar }
	local step = 2 * math.pi / Shapes.DASHES
	local half = step * Shapes.DASH_FILL * math.clamp(dash, 0, 1) * 0.5 -- half the angle a dash covers
	local length = math.max(2 * radius * math.sin(half), Shapes.MIN_DASH)
	local reach = radius * math.cos(half) -- the middle of a chord lies a little inside the circle
	local out: { Bar } = {}
	for i = 0, Shapes.DASHES - 1 do
		local a = -math.pi / 2 + i * step
		out[i + 1] = { x = cx + math.cos(a) * reach, y = cy + math.sin(a) * reach, length = length, rotation = axis(math.deg(a) + 90) }
	end
	return out
end

-- An off-screen cue's chevron, pointing along the unit direction (dx, dy) from the middle of the screen out to the edge: two arms of
-- CHEVRON_ARM pixels meeting at the tip, each lying CHEVRON_SPREAD degrees back from that direction. It is centred on (x, y)
-- along its direction, which is where the mark sits on the edge.
Shapes.CHEVRON_ARM = 15
Shapes.CHEVRON_SPREAD = 40

function Shapes.chevron(x: number, y: number, dx: number, dy: number): { Bar }
	local arm, spread = Shapes.CHEVRON_ARM, math.rad(Shapes.CHEVRON_SPREAD)
	local heading = math.atan2(dy, dx)
	local depth = arm * math.cos(spread) -- how far the arms reach back from the tip
	local tx, ty = x + math.cos(heading) * depth * 0.5, y + math.sin(heading) * depth * 0.5
	local out: { Bar } = {}
	for i, side in { -1, 1 } do
		local back = heading + math.pi + side * spread
		out[i] = { x = tx + math.cos(back) * arm * 0.5, y = ty + math.sin(back) * arm * 0.5, length = arm, rotation = axis(math.deg(back)) }
	end
	return out
end

-- The Focus ticks around the middle (cx, cy): four short bars, each lying along the line out from the middle, FOCUS_RADIUS pixels
-- out (their middles) and FOCUS_LENGTH long.
Shapes.FOCUS_RADIUS = 11
Shapes.FOCUS_LENGTH = 10

function Shapes.focusTicks(cx: number, cy: number): { Bar }
	local out: { Bar } = {}
	for i = 0, 3 do
		local a = i * math.pi / 2
		out[i + 1] = { x = cx + math.cos(a) * Shapes.FOCUS_RADIUS, y = cy + math.sin(a) * Shapes.FOCUS_RADIUS, length = Shapes.FOCUS_LENGTH, rotation = axis(math.deg(a)) }
	end
	return out
end

-- Where a label's top middle goes. (px, py) is the middle of the ring it names and `offset` PerceptionView's gap from there to the
-- label (the ring's radius and 8). Under the ring, unless the screen has no room for LABEL_HEIGHT pixels there, then above it. When
-- the label's width is known (> 0) it is kept LABEL_MARGIN pixels inside the screen sideways. Returns x, y and whether it is below.
Shapes.LABEL_HEIGHT = 28
Shapes.LABEL_MARGIN = 8

function Shapes.labelAt(px: number, py: number, offset: number, width: number, viewportW: number, viewportH: number): (number, number, boolean)
	local below = py + offset + Shapes.LABEL_HEIGHT <= viewportH - Shapes.LABEL_MARGIN
	local y = if below then py + offset else py - offset - Shapes.LABEL_HEIGHT
	local x = px
	if width > 0 then
		local half = width * 0.5 + Shapes.LABEL_MARGIN
		x = math.clamp(px, math.min(half, viewportW * 0.5), math.max(viewportW - half, viewportW * 0.5))
	end
	return x, y, below
end

return Shapes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">PerceptionText</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen perception_text.gd: words belong to presentation, never the sensor.
local Text = {}
local names = {movement="movement", possible_prey="possible prey", fly_like_prey="fly-like prey"}
function Text.category(category: string): string
	return (names :: {[string]: string})[category] or "movement"
end
function Text.hasNumber(text: string): boolean return string.find(text, "[%d%%]") ~= nil end
Text.LOST = "lost sight"
return table.freeze(Text)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">PerceptionView</string>
            <string name="Source"><![CDATA[--!strict
-- Pure build_view from perception_hud.gd. Only memory and a camera adapter enter; never world actors.
local Text = require(script.Parent.PerceptionText)
local View = {}
function View.edgeFade(age: number): number
	if age < 0 or age >= 1.4 then return 0 end
	local t = math.clamp(age / 0.12, 0, 1)
	return t*t*(3-2*t) * (1-age/1.4)^1.5
end
function View.build(memory: any, camera: any, showMark: boolean?): any
	local out: any = {edges={}, rings={}, labels={}}
	local sectors: {[number]: any} = {}
	for _, c in memory:contacts() do
		if c.cueCount > 0 and c.cueDirection.Magnitude > 0.7 and not c:isInspectedNow() then
			local alpha = 0.6 * View.edgeFade(memory:cueAgeS(c))
			if alpha > 0 then
				local e = camera.edge(c.cueDirection)
				e.alpha, e.trackId = alpha, c.trackId
				local sector = math.floor(math.atan2(c.cueDirection.X, c.cueDirection.Z) / (math.pi/8) + 0.5)
				if not sectors[sector] or sectors[sector].alpha < alpha then sectors[sector] = e end
			end
		end
		if not c.hasPosition then continue end
		local point, visible, radius = camera.project(c.position, c.sizeWu)
		if not visible then continue end
		if c:isInspectedNow() then
			table.insert(out.rings, {pos=point, radius=radius, alpha=0.85, dash=1, kind="live", trackId=c.trackId})
			table.insert(out.labels, {pos=point, offset=radius+8, text=Text.category(c.category), alpha=1})
		elseif c:hasMark() then
			local stale = memory:stalenessOf(c)
			local covered = camera.covered(c.position, math.max(c.sizeWu, 0.2)*0.5+0.06)
			if showMark ~= false then
				table.insert(out.rings, {pos=point, radius=radius, alpha=(0.6-0.48*stale)*(if covered then 0.6 else 1),
					dash=1-0.7*stale, kind="mark", trackId=c.trackId})
			end
			local age = memory:ageS(c)
			if age < 2.5 then table.insert(out.labels, {pos=point, offset=radius+8, text=Text.LOST, alpha=math.clamp(1-age/2.5,0,1)}) end
		end
	end
	for _, e in sectors do table.insert(out.edges, e) end
	return out
end
return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">SaveText</string>
            <string name="Source"><![CDATA[--!strict
-- The words about saving (ROBLOX-39): what the menu and a short toast say. Plain and honest: saved, saving, or off for this visit and why.
-- The reasons are SaveRules.REASONS. Pure; checked in tests/state_client.luau.
local SaveText = {}

SaveText.SAVED = "Your notebook and last rests are saved."
SaveText.SAVING = "Saving..."
SaveText.TROUBLE = "Having trouble saving. Your progress is kept for now and the game keeps trying."
SaveText.OFF = "Saving is off for this visit: your notebook and rests will last only until you leave."
SaveText.LOOKING = "Finding your saved game..."
SaveText.BACK = "Saving is back on."

SaveText.WHY = {
	offline = "The game could not reach its saving service.",
	no_api = "Saving is not available here.",
	load_failed = "Your saved game could not be read just now. It has not been changed, and the game keeps trying.",
	other_session = "Your game is open somewhere else, and this copy cannot save over it.",
	corrupt = "Your saved game could not be read, so it was left exactly as it is.",
	newer = "Your saved game was made by a newer version of this game, so it was left exactly as it is.",
} :: { [string]: string }

local function because(reason: string?): string?
	if reason == nil then return nil end
	return SaveText.WHY[reason]
end

-- The line for the menu: one or two sentences.
function SaveText.menuLine(status: string?, reason: string?): string
	if status == "session" then
		local why = because(reason)
		return SaveText.OFF .. (if why then "\n" .. why else "")
	elseif status == "saving" then
		return if reason == "write_failed" then SaveText.TROUBLE else SaveText.SAVING
	elseif status == "saved" then
		return SaveText.SAVED
	end
	return SaveText.LOOKING
end

-- A short toast when the status changes, or "" when nothing needs saying (a plain saving/saved flicker is not announced).
function SaveText.toast(oldStatus: string?, oldReason: string?, status: string?, reason: string?): string
	local was: string = oldStatus or ""
	local now: string = status or ""
	local toSession = now == "session" and was ~= "session"
	local fromSession = was == "session" and (now == "saved" or now == "saving")
	local newTrouble = now == "saving" and reason == "write_failed" and was ~= "" and not (was == "saving" and oldReason == "write_failed")
	if toSession then
		local why = because(reason)
		return SaveText.OFF .. (if why then " " .. why else "")
	elseif fromSession then
		return SaveText.BACK
	elseif newTrouble then
		return SaveText.TROUBLE
	end
	return ""
end

return SaveText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">WaspText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of the wasp's visit for the screen (ROBLOX-26): the sound captions, the status line while it visits and the plain screen
-- after a catch. The texts are Godot's (scripts/habitat/habitat_loop.gd _wasp_line, scripts/audio/soundscape.gd WASP_CAPTIONS,
-- scripts/presentation/caught_panel.gd); where they differ it is said here. Button names come from ControlText for the device in use.
-- Pure: checked in tests/wasp.luau.
--
-- Differences from Godot: the captions say where the hum is, as the flies' "[buzzing, ahead-left]" does (Godot's wasp captions did
-- not); the second line after a catch does not point to a notebook, which the port does not have yet; with no rest to go back to the
-- one choice is "Back to the start" (Godot offered a new spider as another life, which needs the death rules of round 5, not ported).
local ControlText = require(script.Parent.ControlText)
local Data = require(script.Parent.Parent.Data.Wasp)

local WaspText = {}

WaspText.LINE = "A mud dauber wasp stung the spider and carried it away."
WaspText.SUB = "Its sting does not kill: it paralyses."
WaspText.BACK = "Back to your last rest"
WaspText.START = "Back to the start"

local NAMES = { "ahead", "ahead-left", "left", "behind-left", "behind", "behind-right", "right", "ahead-right" }

local function roundHalfAway(x: number): number
	return if x >= 0 then math.floor(x + 0.5) else -math.floor(-x + 0.5)
end

-- Where `point` is from the spider (Godot VibrationSense.direction_word): the eighth of the compass round its heading, counted
-- counter-clockwise seen from its up, then "above" or "below" when it is more than 35 degrees off the plane the spider stands on.
function WaspText.directionWord(spider: Vector3, heading: Vector3, up: Vector3, point: Vector3): string
	local n = up
	local to = point - spider
	local rise = to:Dot(n)
	local flat = to - n * rise
	local word = ""
	if flat:Dot(flat) > 1.0e-6 then
		local f = flat.Unit
		local angle = math.deg(math.atan2(n:Dot(heading:Cross(f)), heading:Dot(f)))
		word = NAMES[(roundHalfAway(angle / 45.0) % 8) + 1]
	end
	local elevation = math.deg(math.atan2(rise, math.max(flat.Magnitude, 1.0e-6)))
	if elevation > 35.0 then
		word = if word == "" then "above" else "above, " .. word
	elseif elevation < -35.0 then
		word = if word == "" then "below" else "below, " .. word
	end
	return if word ~= "" then word else "here"
end

-- The caption of the visit now: { text, alpha }, or nil when there is none. While it arrives (the whole warning), when it has seen the
-- spider (inspecting, striking), and for a few seconds as it leaves. None begins "[buzzing", which is the flies'.
function WaspText.caption(phase: string, phaseS: number, direction: string): { text: string, alpha: number }?
	if phase == "arriving" then
		return { text = `[a deep, heavy hum outside, {direction}, coming closer]`, alpha = 1.0 }
	elseif phase == "inspecting" or phase == "striking" then
		return { text = `[the deep hum turns toward you, {direction}]`, alpha = 1.0 }
	elseif phase == "leaving" and phaseS < Data.captionTailS then
		local left = Data.captionTailS - phaseS
		return { text = `[the deep hum fades away, {direction}]`, alpha = math.clamp(left / Data.captionFadeS, 0.0, 1.0) }
	end
	return nil
end

-- What the status says while the wasp visits (nil when it is away). The first visit says what wasps do and how to get away.
function WaspText.line(phase: string, confused: boolean, visits: number, spared: boolean, device: ControlText.Device): string?
	if phase == "arriving" then
		if visits <= 1 then
			return `A deep hum outside: a wasp is coming, and wasps hunt spiders. Hide in the crack, keep still, or let yourself down on your line ({ControlText.name(device, "drop")}).`
		end
		return "A deep hum outside: a wasp is coming. Hide in the crack, keep still, or drop on your line."
	elseif phase == "searching" then
		if confused then return "The wasp has lost you. Get out of sight." end
		return "A wasp is searching the sill. Keep still, keep out of sight, or get home to the crack."
	elseif phase == "inspecting" or phase == "striking" then
		return "The wasp has seen you! Get away: jump, drop on your line, or reach the crack."
	elseif phase == "carrying" then
		return "Stung, the spider cannot move. The wasp carries it away."
	elseif phase == "leaving" then
		if spared then return "The wasp touched you with its antennae, gave up, and is leaving." end
		return "The wasp is leaving."
	end
	return nil
end

-- The life in a few plain lines: how long it lived, its meals, the wasp. Never a score. `hours` of life, `meals` finished, and the
-- wasp's visits and escapes.
function WaspText.summary(hours: number, meals: number, visits: number, escapes: number): string
	local lived = "less than a day"
	if hours >= 24.0 then
		local days = math.floor(hours / 24.0)
		lived = `{days} day{if days == 1 then "" else "s"}`
	end
	local out = { `It lived {lived}.`, `It ate {meals} meal{if meals == 1 then "" else "s"}.` }
	if visits > 0 then
		table.insert(out, `The wasp came {visits} time{if visits == 1 then "" else "s"}; it got away from it {escapes} time{if escapes == 1 then "" else "s"}.`)
	end
	return table.concat(out, "\n")
end

-- The catch screen `seconds` after it began: how dim the world is, and whether the line, then the summary and the choices, show.
function WaspText.panel(seconds: number): { dim: number, line: boolean, choices: boolean }
	return {
		dim = math.clamp(seconds / Data.caughtQuietS, 0.0, 1.0) * Data.caughtDim,
		line = seconds >= Data.caughtQuietS,
		choices = seconds >= Data.caughtQuietS + Data.caughtLineS,
	}
end

-- The button's words: back to the last rest when there is one, else back to the start.
function WaspText.choice(hasRest: boolean): string
	return if hasRest then WaspText.BACK else WaspText.START
end

return WaspText
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="102">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="103">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="104">
        <Properties>
          <string name="Name">DataStoreBackend</string>
          <string name="Source"><![CDATA[--!strict
-- The real store backend (ROBLOX-39): a thin adapter from a Roblox DataStore to the interface Shared/Persistence/MemoryBackend documents
-- (read and update, neither raises). It holds no logic of its own; it takes the DataStore object as an argument so a fake can stand in for
-- it (tests/state.luau runs it against one). Only the server requires this module: the server owns all DataStore access.
local DataStoreBackend = {}
DataStoreBackend.__index = DataStoreBackend

function DataStoreBackend.new(dataStore: any): any
	return setmetatable({ ds = dataStore }, DataStoreBackend)
end

-- GetAsync: ok, the value (nil when the key does not exist), the error text.
function DataStoreBackend.read(self: any, key: string): (boolean, any, string?)
	local ok, value = pcall(function(): any return self.ds:GetAsync(key) end)
	if not ok then return false, nil, tostring(value) end
	return true, value, nil
end

-- UpdateAsync: `transform(old)` returns the new value, or nil to leave the key as it is. Roblox may call it more than once.
function DataStoreBackend.update(self: any, key: string, transform: (any) -> any): (boolean, any, string?)
	local ok, value = pcall(function(): any
		local result = self.ds:UpdateAsync(key, transform)
		return result
	end)
	if not ok then return false, nil, tostring(value) end
	return true, value, nil
end

return DataStoreBackend
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="105">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Builds the windowsill (scripts/habitat/windowsill.gd), the drawn world around it (Habitat/Scenery, from Data/Graphics) and the
-- lighting (Habitat/Lit). The spider itself is client-side (StarterPlayerScripts/Client/SpiderClient): one player, one spider,
-- nothing to replicate yet. Lighting Technology (Future) and MaterialService.Use2022Materials are authored in the Rojo projects;
-- runtime scripts cannot set them.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Habitat = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Habitat")
local Scenery = require(Habitat:WaitForChild("Scenery"))
local Lit = require(Habitat:WaitForChild("Lit"))

Players.CharacterAutoLoads = false
Workspace.Gravity = 35 -- species gravity_wu_s2; used by any unanchored props

-- The sill is what the game needs; the looks are best effort. If the lighting or the decor fails (nothing here has run in Roblox
-- Studio yet), the server says so and carries on with the old look: a visible back wall, the plain morning light.
-- Lighting first: the light shafts follow the sun it picks. The macro depth of field is on (full tier) unless the Workspace
-- attribute DepthOfField is false.
local litOk, sun = pcall(Lit.apply, Lighting, Workspace:FindFirstChild("Terrain"), { depthOfField = Workspace:GetAttribute("DepthOfField") ~= false })
if litOk then
	print("[Windowsill] sun: " .. (if sun.ok then "through the window, " else "fallback, ") .. sun.reason)
else
	warn("[Windowsill] lighting set-up failed: " .. tostring(sun))
end

local decorOk, decor, replaced = pcall(Scenery.decor, if litOk and sun.ok then sun.direction else nil)
if not decorOk then
	warn("[Windowsill] decor failed, the back wall and the Pilea's pieces stay as they were: " .. tostring(decor))
end

-- Only the pieces whose drawing exists turn invisible (still solid); if the decor failed nothing is hidden.
local sill = Scenery.sill(if decorOk then replaced else {})
if decorOk then decor.Parent = Workspace end
sill.Parent = Workspace
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="106">
        <Properties>
          <string name="Name">Persistence</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Persistent saves, the server's side (ROBLOX-39). Wires the engine to SaveService: the DataStore, the two remotes, the players coming and
-- going, the once-a-second step and BindToClose. All the logic is in Server/SaveService and Shared/Persistence/Save*; this script only
-- connects them, so a failure here can never stop the world from being built (Main.server.luau is separate).
--
-- Which store: Studio and the test place use "WindowsillTest_v1", a live server "Windowsill_v1" (SaveStores.name). Reading and writing
-- need Game Settings > Security > "Enable Studio Access to API Services" in Studio and a place that has been published; without them
-- DataStore calls fail, the session is session-only and says so ("no_api"), and the game plays exactly as it did before saves existed.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SaveRules = require(Shared.Data.SaveRules)
local SaveStores = require(Shared.Persistence.SaveStores)
local MemoryBackend = require(Shared.Persistence.MemoryBackend)
local SaveService = require(script.Parent.SaveService)
local DataStoreBackend = require(script.Parent.DataStoreBackend)

local isStudio = RunService:IsStudio()
local isTestPlace = ServerScriptService:FindFirstChild("PortTests") ~= nil
local storeName = SaveStores.name(isStudio, isTestPlace, Workspace:GetAttribute("SaveStore"))

-- The real DataStore when the service can be asked for one; otherwise the in-memory backend (a session that lasts as long as the server).
local backend: any
local okStore, store = pcall(function(): any return game:GetService("DataStoreService"):GetDataStore(storeName) end)
if okStore and store ~= nil then
	backend = DataStoreBackend.new(store)
else
	warn("[Windowsill] saves: no DataStore service (" .. tostring(store) .. "); saving stays in memory for this server")
	backend = MemoryBackend.new()
end
print("[Windowsill] saves: store " .. storeName .. (if okStore then "" else " (memory)"))
Workspace:SetAttribute("SaveStoreName", storeName)

local folder = Instance.new("Folder")
folder.Name = SaveRules.REMOTES_NAME
local toServer = Instance.new("RemoteEvent")
toServer.Name = "ToServer"
toServer.Parent = folder
local toClient = Instance.new("RemoteEvent")
toClient.Name = "ToClient"
toClient.Parent = folder

-- The test place files each run's players under a name of their own, so an automated run never meets what an earlier run saved and never
-- leaves a lock for the next. Studio runs of the playable project use the real UserId, so leaving and rejoining there is the real test.
local runTag = tostring(os.time())
local service = SaveService.new({
	backend = backend,
	now = os.time,
	sleep = function(seconds: number) task.wait(seconds) end,
	spawn = function(fn: (...any) -> ...any, ...: any) task.spawn(fn, ...) end,
	send = function(player: SaveService.Player, msg: { [string]: any }) toClient:FireClient(player :: any, msg) end,
	jobId = game.JobId,
	keyOf = if isTestPlace then function(player: SaveService.Player): string | number return `t{runTag}_{player.UserId}` end else nil,
	log = function(text: string) warn("[Windowsill] saves: " .. text) end,
})

toServer.OnServerEvent:Connect(function(player: Player, msg: any)
	service:onMessage(player, msg)
end)
folder.Parent = ReplicatedStorage -- after the event is connected: a client that sees the folder can speak

Players.PlayerAdded:Connect(function(player: Player)
	service:addPlayer(player)
end)
Players.PlayerRemoving:Connect(function(player: Player)
	service:removePlayer(player)
end)
for _, player in Players:GetPlayers() do
	service:addPlayer(player)
end

task.spawn(function()
	while true do
		task.wait(1)
		service:step()
	end
end)

game:BindToClose(function()
	service:shutdown()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="107">
        <Properties>
          <string name="Name">SaveService</string>
          <string name="Source"><![CDATA[--!strict
-- The server's persistence service (ROBLOX-39): one SaveSession per player, and the only place a client's message is turned into anything
-- stored. It knows nothing of the engine: the players, the remotes, the clock, the sleep and the thread starter are handed in, so
-- tests/state.luau runs it on the in-memory backend with scripted clients. Persistence.server.luau wires the real ones.
--
-- Trust: the simulation runs on the client, so what a client sends is not authority; it is only a candidate that must be whole and
-- well-formed. Every message is checked before it touches a session (kind, size, depth, types, ranges, and for a rest the full checkpoint
-- check in SaveRest), is rate limited, and a malformed one is dropped and counted, never raised. This is a boundary for corruption safety,
-- not anti-cheat: it is a solo game with no economy, so a dishonest client can only change its own player's save.
--
-- Client to server (ToServer): { kind = "hello", v } | { kind = "progress", progress } | { kind = "rest", mode, record }
-- Server to client (ToClient): { kind = "loaded", v, status, reason, progress, rests = { main?, free? } }
--                              | { kind = "status", status, reason } | { kind = "rest", mode, record }
local SaveRules = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Data"):WaitForChild("SaveRules"))
local SaveSession = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Persistence"):WaitForChild("SaveSession"))

local SaveService = {}
SaveService.__index = SaveService

export type Player = { UserId: number, Name: string }
export type Config = {
	backend: any, now: () -> number, sleep: (number) -> (), spawn: ((...any) -> ...any, ...any) -> (),
	send: (Player, { [string]: any }) -> (), jobId: string?, log: ((string) -> ())?,
	keyOf: ((Player) -> string | number)?, -- the name a player's records are filed under (default: their UserId); the test place files each run under a fresh one
}

function SaveService.new(cfg: Config): any
	return setmetatable({ cfg = cfg, entries = {} :: { [any]: any }, counter = 0, stats = { dropped = 0, limited = 0, handled = 0 }, closing = false }, SaveService)
end

local function log(self: any, text: string)
	local l = self.cfg.log
	if l then l(text) end
end

local function bucket(burst: number, perSecond: number, now: number): any
	return { tokens = burst, last = now, burst = burst, rate = perSecond }
end

local function take(b: any, now: number): boolean
	b.tokens = math.min(b.burst, b.tokens + (now - b.last) * b.rate)
	b.last = now
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	return false
end

local function sendTo(self: any, player: Player, msg: { [string]: any })
	local ok, err = pcall(self.cfg.send, player, msg)
	if not ok then log(self, "send failed: " .. tostring(err)) end
end

local function loadedMessage(session: any): { [string]: any }
	local snap = session:snapshot()
	return { kind = "loaded", v = SaveRules.PROTOCOL, status = snap.status, reason = snap.reason, progress = snap.progress, rests = snap.rests }
end

-- A player arrived: start their session (the load runs in its own thread) and wait for their hello.
function SaveService.addPlayer(self: any, player: Player)
	if self.entries[player] ~= nil then return end
	self.counter += 1
	local now = self.cfg.now()
	local sessionId = `{self.cfg.jobId or "local"}:{math.floor(now)}:{self.counter}`
	local entry: any = { player = player, hello = false, loaded = false, leaving = false, progressBucket = bucket(SaveRules.PROGRESS_BURST, SaveRules.PROGRESS_PER_SECOND, now), restBucket = bucket(SaveRules.REST_BURST, SaveRules.REST_PER_SECOND, now), helloBucket = bucket(3, 0.2, now) }
	entry.session = SaveSession.new({
		backend = self.cfg.backend, userId = if self.cfg.keyOf then self.cfg.keyOf(player) else player.UserId, sessionId = sessionId, now = self.cfg.now, sleep = self.cfg.sleep,
		log = function(text: string) log(self, text) end,
		onChange = function(status: string, reason: string?)
			if entry.loaded and entry.hello and not entry.leaving then sendTo(self, player, { kind = "status", status = status, reason = reason }) end
		end,
		onLoaded = function(_snap: any)
			if entry.hello and not entry.leaving then sendTo(self, player, loadedMessage(entry.session)) end
		end,
		onRest = function(mode: string, record: any)
			if entry.hello and not entry.leaving then sendTo(self, player, { kind = "rest", mode = mode, record = record }) end
		end,
	})
	self.entries[player] = entry
	self.cfg.spawn(function()
		local ok, err = pcall(function() entry.session:load() end)
		if not ok then
			log(self, "load raised: " .. tostring(err))
			entry.session:demote("load_failed", true)
		end
		entry.loaded = true
		if entry.leaving then
			entry.session:flush() -- the player left while the load was in flight: let go of the lock it took
			return
		end
		if entry.hello then sendTo(self, player, loadedMessage(entry.session)) end
	end)
end

local function handle(self: any, entry: any, msg: any)
	local now = self.cfg.now()
	local kind = msg.kind
	if kind == "hello" then
		if not take(entry.helloBucket, now) then self.stats.limited += 1; return end
		entry.hello = true
		if entry.loaded then sendTo(self, entry.player, loadedMessage(entry.session)) end
	elseif kind == "progress" then
		if not take(entry.progressBucket, now) then self.stats.limited += 1; return end
		if not entry.session:setProgress(msg.progress) then self.stats.dropped += 1 end
	elseif kind == "rest" then
		if not take(entry.restBucket, now) then self.stats.limited += 1; return end
		local mode = msg.mode
		if type(mode) ~= "string" or not entry.session:setRest(mode, msg.record) then self.stats.dropped += 1 end
	else
		self.stats.dropped += 1
	end
end

-- A message from a client. Never raises, whatever it holds.
function SaveService.onMessage(self: any, player: Player, msg: any)
	local entry = self.entries[player]
	if entry == nil or entry.leaving then return end
	if type(msg) ~= "table" or type(msg.kind) ~= "string" then
		self.stats.dropped += 1
		return
	end
	self.stats.handled += 1
	local ok, err = pcall(function(): any
		handle(self, entry, msg)
		return nil
	end)
	if not ok then
		self.stats.dropped += 1
		log(self, "a message raised: " .. tostring(err))
	end
end

-- The player left: write what is waiting, release the lock. Yields.
function SaveService.removePlayer(self: any, player: Player)
	local entry = self.entries[player]
	if entry == nil then return end
	self.entries[player] = nil
	entry.leaving = true
	if not entry.loaded then return end -- the loading thread finishes the job (see addPlayer)
	local ok, err = pcall(function() entry.session:flush() end)
	if not ok then log(self, "flush raised: " .. tostring(err)) end
end

-- About once a second: every session does its periodic work in its own thread (a slow store does not hold up the others).
function SaveService.step(self: any)
	for _, entry in self.entries do
		if entry.loaded and not entry.leaving then
			self.cfg.spawn(function()
				local ok, err = pcall(function() entry.session:step() end)
				if not ok then log(self, "step raised: " .. tostring(err)) end
			end)
		end
	end
end

-- The server is closing: every session writes what is waiting, all at once, within the deadline. Yields until they are done or time is up.
function SaveService.shutdown(self: any)
	self.closing = true
	local deadline = self.cfg.now() + SaveRules.FLUSH_DEADLINE
	local pending = 0
	for player, entry in self.entries do
		entry.leaving = true
		if entry.loaded then
			pending += 1
			self.cfg.spawn(function()
				local ok, err = pcall(function() entry.session:flush(deadline) end)
				if not ok then log(self, "flush raised: " .. tostring(err)) end
				pending -= 1
			end)
		end
		self.entries[player] = nil
	end
	while pending > 0 and self.cfg.now() < deadline do
		self.cfg.sleep(0.25)
	end
end

function SaveService.statusOf(self: any, player: Player): (string?, string?)
	local entry = self.entries[player]
	if entry == nil then return nil, nil end
	local pair = { entry.session:status() }
	return pair[1], pair[2]
end

return SaveService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="108">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="109">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="110">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">CaughtPanel</string>
            <string name="Source"><![CDATA[--!strict
-- Plain end/start screens. Scroll within the safe area; the selected button owns accept,
-- and modal input never leaks into a jump or a held walking key.
local CAS = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UIS = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WaspText = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI"):WaitForChild("WaspText"))
local CaughtPanel = {}
CaughtPanel.__index = CaughtPanel
export type Choice = { id: string, text: string }
local function label(parent: Instance, name: string, size: number, order: number): TextLabel
 local l=Instance.new("TextLabel")
 l.Name=name; l.BackgroundTransparency=1; l.TextColor3=Color3.new(.95,.93,.88)
 l.Font=Enum.Font.GothamMedium; l.TextSize=size; l.TextWrapped=true
 l.Size=UDim2.new(1,-24,0,0); l.AutomaticSize=Enum.AutomaticSize.Y; l.LayoutOrder=order; l.Parent=parent
 return l
end
function CaughtPanel.new(playerGui: Instance, onChoose: (string) -> (), name: string?): any
 local gui=Instance.new("ScreenGui")
 gui.Name=name or "SpiderCaught"; gui.ResetOnSpawn=false; gui.ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets
 gui.DisplayOrder=50; gui.Enabled=false; gui.Parent=playerGui
 local dim=Instance.new("Frame")
 dim.Name="Dim";dim.Size=UDim2.fromScale(1,1);dim.BackgroundColor3=Color3.new(.02,.02,.03);dim.BackgroundTransparency=1
 dim.Active=true;dim.Parent=gui
 local box=Instance.new("ScrollingFrame")
 box.Name="Box";box.BackgroundTransparency=1;box.BorderSizePixel=0;box.AnchorPoint=Vector2.new(.5,.5)
 box.Position=UDim2.fromScale(.5,.5);box.Size=UDim2.fromScale(.92,.88)
 box.CanvasSize=UDim2.new();box.AutomaticCanvasSize=Enum.AutomaticSize.Y;box.ScrollBarThickness=6;box.Parent=dim
 local constraint=Instance.new("UISizeConstraint");constraint.MaxSize=Vector2.new(880,10000);constraint.Parent=box
 local list=Instance.new("UIListLayout");list.HorizontalAlignment=Enum.HorizontalAlignment.Center
 list.SortOrder=Enum.SortOrder.LayoutOrder;list.Padding=UDim.new(0,12);list.Parent=box
 local self=setmetatable({gui=gui,dim=dim,box=box,line=label(box,"Line",28,1),sub=label(box,"Sub",18,2),
 summary=label(box,"Summary",18,3),buttons={},choices={},button=nil,onChoose=onChoose,showing=false,
 seconds=0,bound=false,chosen=false,selected=1,stickDown=false,action="WindowsillChoice"..gui.Name},CaughtPanel)
 return self
end
function CaughtPanel.isShowing(self:any):boolean return self.showing end
function CaughtPanel.select(self:any, delta:number)
 if #self.buttons==0 then return end
 self.selected=(self.selected-1+delta)%#self.buttons+1
 pcall(function() GuiService.SelectedObject=self.buttons[self.selected] end)
end
function CaughtPanel.showChoices(self:any, title:string, subtitle:string, summary:string, choices:{Choice}, immediate:boolean?)
 for _,b in self.buttons do b:Destroy() end
 self.buttons={};self.choices=choices;self.selected=1;self.stickDown=false
 self.showing,self.seconds,self.chosen=true,if immediate then 100 else 0,false
 self.line.Text,self.sub.Text,self.summary.Text=title,subtitle,summary
 self.box.CanvasPosition=Vector2.zero
 for i,c in choices do
  local b=Instance.new("TextButton");b.Name=c.id;b.Text=c.text;b.BackgroundColor3=Color3.new(.16,.16,.18)
  b.TextColor3=Color3.new(1,1,1);b.Font=Enum.Font.GothamMedium;b.TextSize=20;b.TextWrapped=true
  b.Size=UDim2.new(1,-24,0,52);b.AutomaticSize=Enum.AutomaticSize.Y;b.Selectable=true;b.AutoButtonColor=true
  b.LayoutOrder=i+3;b.Parent=self.box
  b.Activated:Connect(function() self:choose(c.id) end)
  table.insert(self.buttons,b)
 end
 self.button=self.buttons[1]
 self.gui.Enabled=true;self:_apply()
 if not self.bound then
  self.bound=true
  CAS:BindActionAtPriority(self.action,function(_,state,input)
   local k=input and input.KeyCode
   if k==Enum.KeyCode.Thumbstick1 then
    local y=if input then input.Position.Y else 0
    if math.abs(y)<.3 then self.stickDown=false
    elseif math.abs(y)>.6 and not self.stickDown then self.stickDown=true;self:select(if y>0 then -1 else 1) end
   elseif state==Enum.UserInputState.Begin then
    if k==Enum.KeyCode.Up or k==Enum.KeyCode.W or k==Enum.KeyCode.DPadUp then self:select(-1)
    elseif k==Enum.KeyCode.Down or k==Enum.KeyCode.S or k==Enum.KeyCode.DPadDown then self:select(1)
    else self:choose() end
   end
   return Enum.ContextActionResult.Sink
  end,false,4000,Enum.KeyCode.Return,Enum.KeyCode.KeypadEnter,Enum.KeyCode.Space,Enum.KeyCode.E,Enum.KeyCode.ButtonA,
   Enum.KeyCode.Up,Enum.KeyCode.Down,Enum.KeyCode.W,Enum.KeyCode.S,Enum.KeyCode.DPadUp,Enum.KeyCode.DPadDown,Enum.KeyCode.Thumbstick1)
 end
 pcall(function() UIS.MouseBehavior=Enum.MouseBehavior.Default;UIS.MouseIconEnabled=true end)
 if immediate then self:select(0) end
end
function CaughtPanel.show(self:any, summary:string, hasRest:boolean)
 self:showChoices(WaspText.LINE,WaspText.SUB,summary,{{id="Back",text=WaspText.choice(hasRest)}})
end
function CaughtPanel.hide(self:any)
 self.showing=false;self.gui.Enabled=false
 if self.bound then self.bound=false;CAS:UnbindAction(self.action) end
 pcall(function() GuiService.SelectedObject=nil end)
end
function CaughtPanel.choose(self:any, id:string?):boolean
 if not self.showing or self.chosen or not WaspText.panel(self.seconds).choices then return false end
 local choice=id
 if not choice then
  local selected=GuiService.SelectedObject
  for i,b in self.buttons do if b==selected then self.selected=i end end
  choice=self.choices[self.selected].id
 end
 local valid=false
 for _,c in self.choices do if c.id==choice then valid=true end end
 if not valid then return false end
 self.chosen=true;self.onChoose(choice :: string);return true
end
function CaughtPanel.setTextScale(self:any, scale:number)
 scale=math.clamp(scale,1,1.5)
 self.line.TextSize=28*scale;self.sub.TextSize=18*scale;self.summary.TextSize=18*scale
 for _,b in self.buttons do b.TextSize=20*scale;b.Size=UDim2.new(1,-24,0,52*scale) end
end
function CaughtPanel._apply(self:any)
 local s=WaspText.panel(self.seconds)
 self.dim.BackgroundTransparency=1-s.dim;self.line.Visible=s.line;self.sub.Visible=s.line
 self.summary.Visible=s.choices and self.summary.Text~=""
 for _,b in self.buttons do b.Visible=s.choices end
end
function CaughtPanel.update(self:any,dt:number)
 if not self.showing then return end
 local before=WaspText.panel(self.seconds).choices
 self.seconds+=dt;self:_apply()
 if not before and WaspText.panel(self.seconds).choices then self:select(0) end
end
return CaughtPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">FlyBodies</string>
            <string name="Source"><![CDATA[--!strict
-- The drawn fly: a house fly (Data/FlyLook has every number) 0.7 cm long, made of ellipsoids and rods: a head with two big red-brown
-- compound eyes and a pale silver face, a grey thorax with four dark stripes, a grey-brown abdomen with a darker dorsal stripe, a short
-- dark proboscis, a few bristles, six two-segment legs, and two thin glass wings with a dark leading vein and a faint iridescent film,
-- folded back in a shallow V at rest. In flight the wings are a soft translucent blur on each side (no strobing flaps) and the legs
-- trail. Every part is anchored, never collides, is never seen by a ray and casts no shadow (Habitat/Shapes); a soft dark oval on the
-- surface under a standing fly stands in for its shadow. One Workspace:BulkMoveTo places all the flies' parts each frame.
-- Display only: the fly's position, heading and normal come from the prey simulation (in the air its back is up); nothing here feeds back.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local FlyLook = require(Shared:WaitForChild("Data"):WaitForChild("FlyLook"))
local Shapes = require(Shared:WaitForChild("Habitat"):WaitForChild("Shapes"))

local FlyBodies = {}
FlyBodies.__index = FlyBodies

-- How a part looks and sits in one pose (at rest or in flight), in the body frame.
type Pose = { size: Vector3, frame: CFrame, transparency: number }
type Spec = {
	name: string,
	rod: boolean, -- a Cylinder part; otherwise an ellipsoid
	color: Color3,
	material: string,
	reflectance: number,
	rest: Pose,
	flight: Pose,
}
type Leg = { name: string, hip: { number }, knee: { number }, foot: { number } }
type Template = {
	specs: { Spec },
	restFrames: { CFrame },
	flightFrames: { CFrame },
	changing: { number }, -- the parts that differ between the poses: legs, wings, veins, films, the shadow
	fans: { [number]: boolean }, -- the wing parts, which tremble a little as a blur in flight
}

local function vec(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

local function mirrored(p: Vector3, side: number): Vector3
	return Vector3.new(p.X * side, p.Y, p.Z)
end

-- The size and frame of a rod (a Cylinder part: its axis is X) from a to b, `extraA` and `extraB` longer at the ends.
local function rodBetween(a: Vector3, b: Vector3, diameter: number, extraA: number, extraB: number): (Vector3, CFrame)
	local dir = (b - a).Unit
	local from, to = a - dir * extraA, b + dir * extraB
	local up = if math.abs(dir.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	return Vector3.new((to - from).Magnitude, diameter, diameter), CFrame.lookAt((from + to) / 2, to, up) * CFrame.Angles(0, math.pi / 2, 0)
end

local function build(): Template
	local C = FlyLook.colors
	local specs: { Spec } = {}
	local fans: { [number]: boolean } = {}
	local function color(name: string): Color3
		return Color3.fromHex(C[name])
	end
	local function same(pose: Pose): Pose
		return { size = pose.size, frame = pose.frame, transparency = pose.transparency }
	end
	local function add(name: string, rod: boolean, tint: Color3, material: string, reflectance: number, rest: Pose, flight: Pose?): number
		table.insert(specs, { name = name, rod = rod, color = tint, material = material, reflectance = reflectance, rest = rest, flight = flight or same(rest) })
		return #specs
	end

	-- head, thorax, abdomen, eyes, face, proboscis
	local ellipsoids: { [string]: { centre: Vector3, radii: Vector3 } } = {}
	for _, item in FlyLook.body do
		local centre, size = vec(item.at), vec(item.size)
		ellipsoids[item.name] = { centre = centre, radii = size / 2 }
		local frame = CFrame.new(centre)
		if item.turn then frame *= CFrame.Angles(math.rad(item.turn[1]), math.rad(item.turn[2]), math.rad(item.turn[3])) end
		add(item.name, false, color(item.color), "SmoothPlastic", item.reflectance or 0, { size = size, frame = frame, transparency = 0 })
	end
	-- the stripes: slices of the ellipsoid they lie on, a little proud of it
	for _, slice in FlyLook.slices do
		local body = ellipsoids[slice.on]
		local share = math.sqrt(1 - (slice.x / body.radii.X) ^ 2)
		local size = Vector3.new(slice.width, 2 * (body.radii.Y * share + FlyLook.proud), 2 * (body.radii.Z * share + FlyLook.proud))
		add(slice.name, false, color(slice.color), "SmoothPlastic", 0, { size = size, frame = CFrame.new(body.centre + Vector3.new(slice.x, 0, 0)), transparency = 0 })
	end

	-- legs: a femur from the hip to the knee and a tibia from the knee to the foot, standing and in flight
	local L = FlyLook.legs
	for _, side in { -1, 1 } do
		local word = if side < 0 then "Left" else "Right"
		for pair = 1, #L.stand do
			local stand, fly = L.stand[pair], L.fly[pair]
			local function segment(label: string, diameter: number, tint: string, a: number, b: number, extraA: number, extraB: number)
				local function joint(leg: Leg, which: number): Vector3 -- 1 the hip, 2 the knee, 3 the foot
					return mirrored(vec(if which == 1 then leg.hip elseif which == 2 then leg.knee else leg.foot), side)
				end
				local size0, frame0 = rodBetween(joint(stand, a), joint(stand, b), diameter, extraA, extraB)
				local size1, frame1 = rodBetween(joint(fly, a), joint(fly, b), diameter, extraA, extraB)
				add(`{word}{stand.name}{label}`, true, color(tint), "SmoothPlastic", 0,
					{ size = size0, frame = frame0, transparency = 0 }, { size = size1, frame = frame1, transparency = 0 })
			end
			segment("Femur", L.femur, "femur", 1, 2, 0, L.overlap)
			segment("Tibia", L.tibia, "tibia", 2, 3, L.overlap, 0)
		end
	end

	-- bristles
	local B = FlyLook.bristles
	local n = 0
	for _, item in B.items do
		local sides: { number } = if item.mirror then { 1, -1 } else { 1 }
		for _, side in sides do
			n += 1
			local size, frame = rodBetween(mirrored(vec(item.from), side), mirrored(vec(item.to), side), B.diameter, 0, 0)
			add("Bristle" .. n, true, color("bristle"), "SmoothPlastic", 0, { size = size, frame = frame, transparency = 0 })
		end
	end

	-- wings: folded back in a V at rest, a fan of blur each side in flight
	local W = FlyLook.wing
	for _, side in { -1, 1 } do
		local word = if side < 0 then "Left" else "Right"
		local pitch, yaw = math.rad(W.pitch), math.rad(W.yaw)
		local along = Vector3.new(side * math.sin(yaw) * math.cos(pitch), math.sin(pitch), math.cos(yaw) * math.cos(pitch)).Unit
		local root = mirrored(vec(W.root), side)
		local centre = root + along * (W.length / 2)
		local up = (Vector3.yAxis - along * along.Y).Unit
		local wing = CFrame.fromMatrix(centre, up:Cross(along), up) * CFrame.Angles(0, 0, -side * math.rad(W.roll))
		local restSize = Vector3.new(W.width, W.thick, W.length)
		-- in flight: a flat fan from the root outward, the outer edge up
		local yawBack = math.rad(W.fan.yaw)
		local reachDir = Vector3.new(side * math.cos(yawBack), 0, math.sin(yawBack))
		local fanRoot = Vector3.new(side * W.root[1], W.root[2] + W.fan.rise, W.root[3] + W.fan.back)
		local function fanFrame(reach: number): CFrame -- a fan reaching `reach` out from the root
			return CFrame.new(fanRoot + reachDir * (reach / 2)) * CFrame.Angles(0, -side * yawBack, 0) * CFrame.Angles(0, 0, side * math.rad(W.fan.roll))
		end
		local fan, fanSize = fanFrame(W.fan.reach), Vector3.new(W.fan.reach, W.thick, W.fan.span)
		local filmFan, filmFanSize = fanFrame(W.fan.film.reach), Vector3.new(W.fan.film.reach, W.thick, W.fan.film.span)

		fans[add(`{word}Wing`, false, color("wing"), "Glass", W.reflectance,
			{ size = restSize, frame = wing, transparency = W.transparency }, { size = fanSize, frame = fan, transparency = W.fan.transparency })] = true
		local V = W.vein
		local from, to = wing * Vector3.new(side * V.offset, W.thick, V.from * W.length), wing * Vector3.new(side * V.offset, W.thick, V.to * W.length)
		local veinSize, veinFrame = rodBetween(from, to, V.diameter, 0, 0)
		add(`{word}Vein`, true, color("vein"), "SmoothPlastic", 0,
			{ size = veinSize, frame = veinFrame, transparency = V.transparency }, { size = veinSize, frame = veinFrame, transparency = 1 })
		local F = W.film
		fans[add(`{word}Film`, false, color("film"), "SmoothPlastic", 0,
			{ size = restSize + Vector3.new(F.grow, 0, F.grow), frame = wing * CFrame.new(0, F.rise, 0), transparency = F.transparency },
			{ size = filmFanSize, frame = filmFan * CFrame.new(0, F.rise, 0), transparency = W.fan.film.transparency })] = true
	end

	-- the shadow: a dark oval on the surface, only while the fly stands
	local S = FlyLook.shadow
	local shadowSize = vec(S.size)
	local shadowFrame = CFrame.new(0, -FlyLook.hover + S.lift + shadowSize.Y / 2, 0.005)
	add("Shadow", false, color("shadow"), "SmoothPlastic", 0, { size = shadowSize, frame = shadowFrame, transparency = S.transparency }, { size = shadowSize, frame = shadowFrame, transparency = 1 })

	local restFrames: { CFrame } = {}
	local flightFrames: { CFrame } = {}
	local changing: { number } = {}
	for i, spec in specs do
		restFrames[i], flightFrames[i] = spec.rest.frame, spec.flight.frame
		if spec.rest.size ~= spec.flight.size or spec.rest.transparency ~= spec.flight.transparency then table.insert(changing, i) end
	end
	return { specs = specs, restFrames = restFrames, flightFrames = flightFrames, changing = changing, fans = fans }
end

function FlyBodies.new(parent: Instance): any
	local folder = Instance.new("Folder")
	folder.Name = "Flies"
	folder.Parent = parent
	return setmetatable({ folder = folder, rigs = {}, template = build(), parts = {}, frames = {} }, FlyBodies)
end

-- One fly's parts, standing.
function FlyBodies.spawn(self: any, id: string): any
	local folder = Instance.new("Folder")
	folder.Name = id
	folder.Parent = self.folder
	local parts: { Part } = {}
	for i, spec in self.template.specs do
		local pose = spec.rest
		local part: Part
		if spec.rod then
			part = Shapes.block(folder, spec.name, pose.size, pose.frame, spec.color, spec.material)
			part.Shape = Enum.PartType.Cylinder
		else
			part = Shapes.ellipsoid(folder, spec.name, pose.size, pose.frame, spec.color, spec.material)
		end
		part.Reflectance = spec.reflectance
		part.Transparency = pose.transparency
		parts[i] = part
	end
	local rig = { folder = folder, parts = parts, flying = false }
	self.rigs[id] = rig
	return rig
end

-- Switches a fly's parts that differ between the poses (the legs' reach, the wings, their veins and films, the shadow).
function FlyBodies.pose(self: any, rig: any, flying: boolean)
	rig.flying = flying
	for _, i in self.template.changing do
		local spec = self.template.specs[i]
		local pose = if flying then spec.flight else spec.rest
		rig.parts[i].Size = pose.size
		rig.parts[i].Transparency = pose.transparency
	end
end

function FlyBodies.draw(self: any, flies: { any }, now: number)
	local template: Template = self.template
	local parts: { BasePart } = self.parts
	local frames: { CFrame } = self.frames
	table.clear(parts)
	table.clear(frames)
	local present: { [string]: boolean } = {}
	local shimmer = FlyLook.wing.fan.shimmer
	for _, fly in flies do
		present[fly.id] = true
		local rig = self.rigs[fly.id] or self:spawn(fly.id)
		local flying = fly:airborne() or fly.state == "CAPTURED"
		if flying ~= rig.flying then self:pose(rig, flying) end
		local heading = fly.heading
		-- the back is up: a fly in the air has no surface (the normal it carries is the one it last stood on, which would roll it sideways after
		-- a take-off from a wall), so it keeps its back to the sky; a held fly follows the spider's grip
		local normal = if fly:airborne() then Vector3.yAxis else fly.normal
		local up = if math.abs(heading.Unit:Dot(normal)) > 0.999 then Vector3.zAxis else normal -- a heading along the normal has no turn to give
		local body = CFrame.lookAt(fly.position, fly.position + heading, up)
		local poses = if flying then template.flightFrames else template.restFrames
		for i, part in rig.parts do
			local frame = body * poses[i]
			if flying and template.fans[i] then frame *= CFrame.Angles(math.sin(now * shimmer[1] + i) * shimmer[2], 0, 0) end
			table.insert(parts, part)
			table.insert(frames, frame)
		end
	end
	for id, rig in self.rigs do
		if not present[id] then
			rig.folder:Destroy()
			self.rigs[id] = nil
		end
	end
	if #parts > 0 then Workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged) end
end

return FlyBodies
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">NotebookArt</string>
            <string name="Source"><![CDATA[--!strict
-- Small authored vector sketches, deliberately diagrams rather than photographs or eye-view claims.
local Art={}
local ink=Color3.fromRGB(44,57,54)
local function shape(parent: Instance,x:number,y:number,w:number,h:number,rotation:number,colour:Color3,round:boolean)
	local p=Instance.new("Frame");p.Name="Ink";p.BorderSizePixel=0;p.BackgroundColor3=colour
	p.AnchorPoint=Vector2.new(.5,.5);p.Position=UDim2.fromOffset(x,y);p.Size=UDim2.fromOffset(w,h);p.Rotation=rotation;p.Parent=parent
	if round then local c=Instance.new("UICorner");c.CornerRadius=UDim.new(1,0);c.Parent=p end
end
function Art.draw(parent: Instance,id:string)
	for _,p in parent:GetChildren() do p:Destroy() end
	local centre=Instance.new("Frame");centre.Name="Sketch";centre.BackgroundTransparency=1
	centre.AnchorPoint=Vector2.new(.5,0);centre.Position=UDim2.fromScale(.5,0);centre.Size=UDim2.fromOffset(210,96);centre.Parent=parent
	if id=="dragline" then shape(centre,105,12,1,24,0,ink,false) end
	if id=="peacock_dance" then
		shape(centre,105,58,78,55,0,Color3.fromRGB(16,125,146),true)
		shape(centre,105,58,58,38,0,Color3.fromRGB(231,125,54),true)
	end
	shape(centre,105,62,34,43,0,ink,true);shape(centre,105,35,30,26,0,ink,true)
	for side=-1,1,2 do
		for i=1,4 do
			shape(centre,105+side*29,26+i*10,38,3,side*(i*19-48),ink,true)
		end
		shape(centre,105+side*6,28,8,8,0,Color3.fromRGB(239,234,213),true)
	end
end
return Art
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">NotebookPanel</string>
            <string name="Source"><![CDATA[--!strict
-- The naturalist's notebook on screen (ROBLOX-37), from Godot's notebook_panel.gd: the pages found so far on the left, in the order they
-- were found, and the page on the right: a few true sentences, "In this game:" where the game simplifies, and the sources with their
-- links as text. No count of pages left to find (spec 4). On a small or narrow screen, or with large text, one pane shows at a time:
-- the pages, then the page, with a Pages button to go back (Shared/UI/NotebookText.layout). It is modal like the life menu: while it is
-- open the world waits (the client's render step stops the fixed ticks), and it owns the input (a Context Action at a priority above the
-- game's bindings) so nothing it uses reaches the spider. Keyboard: Up and Down choose a page, Left and Right go to the previous or next
-- page, Enter opens (one pane), PageUp and PageDown scroll, N or Q closes. Controller: stick or D-pad choose, A opens, LB and RB go to the
-- previous or next page, the right stick scrolls, B goes back or closes. Mouse and touch: tap a page, drag or use the wheel to scroll.
-- The client opens it (N, the Notebook button, or from the life menu or the end screen) and is told when it closes.
local TextService=game:GetService("TextService")
local CAS = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UIS = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI")
local ControlText = require(UI:WaitForChild("ControlText"))
local NotebookText = require(UI:WaitForChild("NotebookText"))

local NotebookPanel = {}
NotebookPanel.__index = NotebookPanel

local PAPER = Color3.new(0.93, 0.90, 0.82)
local PAPER_DARK = Color3.new(0.84, 0.79, 0.68)
local PAPER_LIT = Color3.new(0.99, 0.95, 0.80)
local BORDER = Color3.new(0.45, 0.38, 0.28)
local INK = Color3.new(0.20, 0.16, 0.10)
local BODY = Color3.new(0.15, 0.13, 0.10)
local GREEN = Color3.new(0.18, 0.32, 0.22)
local FAINT = Color3.new(0.35, 0.30, 0.24)
local PRIORITY = 4000 -- above the game's bindings (3000) and level with the life menu's
local SCROLL_PX_S = 520 -- right stick: pixels a second at full tilt
local STEP_PX = 120 -- a key press that scrolls
local ACTION = "WindowsillNotebook"
local KEYS = {
	Enum.KeyCode.C, Enum.KeyCode.ButtonY, Enum.KeyCode.N, Enum.KeyCode.Q, Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace,
	Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter, Enum.KeyCode.Space, Enum.KeyCode.E, Enum.KeyCode.ButtonA,
	Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.W, Enum.KeyCode.S, Enum.KeyCode.DPadUp, Enum.KeyCode.DPadDown,
	Enum.KeyCode.Left, Enum.KeyCode.Right, Enum.KeyCode.A, Enum.KeyCode.D, Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadRight,
	Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonR1, Enum.KeyCode.PageUp, Enum.KeyCode.PageDown,
	Enum.KeyCode.Thumbstick1, Enum.KeyCode.Thumbstick2,
}

local function label(parent: Instance, name: string, order: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.Text = ""
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.Gotham
	l.TextWrapped = true
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	l.Size = UDim2.new(1, -14, 0, 0)
	l.AutomaticSize = Enum.AutomaticSize.None
	l.LayoutOrder = order
	l.Parent = parent
	return l
end

local function scroller(parent: Instance, name: string, padding: number): ScrollingFrame
	local f = Instance.new("ScrollingFrame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.ScrollBarThickness = 6
	f.CanvasSize = UDim2.new()
	f.CanvasPosition=Vector2.zero
	f.AutomaticCanvasSize = Enum.AutomaticSize.Y
	f.ScrollingDirection = Enum.ScrollingDirection.Y
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, padding)
	list.Parent = f
	f.Parent = parent
	return f
end

local function button(parent: Instance, name: string, text: string): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = text
	b.Font = Enum.Font.GothamMedium
	b.TextColor3 = INK
	b.BackgroundColor3 = PAPER_DARK
	b.AutoButtonColor = true
	b.Selectable = false
	b.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = b
	return b
end

-- `book` is the FieldNotebook; `onClose(returnTo)` is called when the panel closes, with what open() was given.
function NotebookPanel.new(playerGui: Instance, book: any, onClose: (string?) -> ()): any
	local gui = Instance.new("ScreenGui")
	gui.Name = "SpiderNotebook"
	gui.ResetOnSpawn = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.DisplayOrder = 55
	gui.Enabled = false
	gui.Parent = playerGui
	local dim = Instance.new("Frame")
	dim.Name = "Dim"
	dim.Size = UDim2.fromScale(1, 1)
	dim.BackgroundColor3 = Color3.new(0.02, 0.02, 0.03)
	dim.BackgroundTransparency = 0.35
	dim.BorderSizePixel = 0
	dim.Active = true
	dim.Parent = gui
	local paper = Instance.new("Frame")
	paper.Name = "Paper"
	paper.AnchorPoint = Vector2.new(0.5, 0.5)
	paper.Position = UDim2.fromScale(0.5, 0.5)
	paper.Size = UDim2.fromScale(0.97, 0.95)
	paper.BackgroundColor3 = PAPER
	paper.BorderSizePixel = 0
	paper.Parent = dim
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = paper
	local stroke = Instance.new("UIStroke")
	stroke.Color = BORDER
	stroke.Thickness = 2
	stroke.Parent = paper
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(1040, 820)
	limit.Parent = paper
	local inner = Instance.new("Frame")
	inner.Name = "Inner"
	inner.BackgroundTransparency = 1
	inner.Position = UDim2.fromOffset(14, 10)
	inner.Size = UDim2.new(1, -28, 1, -20)
	inner.Parent = paper
	local heading = Instance.new("TextLabel")
	heading.Name = "Heading"
	heading.BackgroundTransparency = 1
	heading.Font = Enum.Font.GothamBold
	heading.TextColor3 = INK
	heading.TextXAlignment = Enum.TextXAlignment.Left
	heading.Text = NotebookText.HEADING
	heading.Parent = inner
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Parent = inner
	local list = scroller(body, "Pages", 6)
	local page = scroller(body, "Page", 12)
	local title = label(page, "Title", 1)
	title.Font = Enum.Font.GothamBold
	title.TextColor3 = INK
	local text = label(page, "Text", 2)
	text.TextColor3 = BODY
	local game = label(page, "InThisGame", 3)
	game.TextColor3 = GREEN
	local sources = label(page, "Sources", 4)
	sources.TextColor3 = FAINT
	local empty = label(page, "Empty", 5)
	empty.TextColor3 = FAINT
	empty.Text = NotebookText.EMPTY
	local footer = Instance.new("Frame")
	footer.Name = "Footer"
	footer.BackgroundTransparency = 1
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Parent = inner
	local controls = Instance.new("TextLabel")
	controls.Name = "Controls"
	controls.BackgroundTransparency = 1
	controls.Font = Enum.Font.Gotham
	controls.TextColor3 = FAINT
	controls.TextWrapped = true
	controls.TextXAlignment = Enum.TextXAlignment.Left
	controls.TextYAlignment = Enum.TextYAlignment.Top
	controls.TextTruncate = Enum.TextTruncate.AtEnd -- two lines; tests/studio/NotebookSpec.luau checks the words fit them
	controls.Parent = inner
	local close = button(footer, "Close", NotebookText.CLOSE)
	local back = button(footer, "Back", NotebookText.PAGES)
	local tries = button(footer,"Try","To try")
	back.Visible = false
	local self = setmetatable({
		gui = gui, paper = paper, heading = heading, body = body, list = list, page = page, title = title, text = text, game = game,
		sources = sources, empty = empty, footer = footer, controls = controls, closeButton = close, backButton = back, tryButton = tries,
		book = book, onClose = onClose,
		showing = false, bound = false, returnTo = nil :: string?, device = "keyboard" :: ControlText.Device, scale = 1.0,
		view = "list", shown = "", buttons = {} :: { TextButton }, ids = {} :: { string },
		stickDown = false, scrollAxis = 0.0,
	}, NotebookPanel)
	tries.Activated:Connect(function() self:showChecklist() end)
	close.Activated:Connect(function() self:close() end)
	back.Activated:Connect(function() self:back() end)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:layout() end)
	page:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:fitText() end)
	return self
end

function NotebookPanel.isShowing(self: any): boolean
	return self.showing
end

-- Whether one pane shows at a time (a small screen, or large text).
function NotebookPanel.stacked(self: any): boolean
	local w, h = self:_screen()
	return not NotebookText.layout(w, h, self.scale).sideBySide
end

-- The safe area's size (before the first layout the engine says 0 by 0: a laptop screen's then, and the size signal lays it out again).
function NotebookPanel._screen(self: any): (number, number)
	local size = self.gui.AbsoluteSize
	return if size.X > 0 then size.X else 1280, if size.Y > 0 then size.Y else 720
end

-- Sizes, positions and which pane shows, for the screen's size, the text scale and the view.
function NotebookPanel.layout(self: any)
	local s: number = self.scale
	local sizes = NotebookText.SIZES
	local w, h = self:_screen()
	local m = NotebookText.metrics(w, h, s)
	local lay = NotebookText.layout(w, h, s)
	self.heading.Size = UDim2.new(1, 0, 0, m.head)
	self.heading.TextSize = math.round(sizes.heading * s)
	self.body.Position = UDim2.fromOffset(0, m.head + 4)
	self.body.Size = UDim2.new(1, 0, 0, m.body)
	self.controls.Visible = m.hint > 0
	self.controls.Position = UDim2.fromOffset(0, m.head + 4 + m.body + 4)
	self.controls.Size = UDim2.new(1, 0, 0, m.hint)
	self.controls.TextSize = math.round(sizes.controls * s)
	self.controls.Text = NotebookText.controls(self.device, not lay.sideBySide)
	self.footer.Position = UDim2.fromScale(0, 1)
	self.footer.Size = UDim2.new(1, 0, 0, m.foot)
	local buttonW = math.floor(math.min(112 * s,(m.paperW-28-16)/3))
	local buttonText = math.min(math.round(sizes.button*s),math.floor(buttonW/3.7))
	self.tryButton.Size=UDim2.new(0,buttonW,1,-8)
	self.tryButton.Position=UDim2.fromOffset(0,4)
	self.tryButton.TextSize=if self.device=="gamepad" then math.min(buttonText,math.floor(buttonW/6.5)) else buttonText
	self.tryButton.Text=if self.device=="gamepad" then (if ControlText.padStyle()=="playstation" then "Triangle" else "Y")..": To try" else "To try"
	local backShown = not lay.sideBySide and self.view == "page"
	self.closeButton.Size = UDim2.new(0, buttonW, 1, -8)
	self.closeButton.Position = UDim2.new(1, -buttonW, 0, 4)
	self.closeButton.TextSize = buttonText
	self.backButton.Visible = backShown
	self.backButton.Size = UDim2.new(0, buttonW, 1, -8)
	self.backButton.Position = UDim2.new(1, -(buttonW * 2 + 8), 0, 4)
	self.backButton.TextSize = buttonText
	if lay.sideBySide then
		self.list.Position, self.list.Size = UDim2.fromOffset(0, 0), UDim2.new(lay.listFraction, -8, 1, 0)
		self.page.Position, self.page.Size = UDim2.new(lay.listFraction, 8, 0, 0), UDim2.new(1 - lay.listFraction, -8, 1, 0)
		self.list.Visible, self.page.Visible = true, true
	else
		self.list.Position, self.list.Size = UDim2.fromOffset(0, 0), UDim2.fromScale(1, 1)
		self.page.Position, self.page.Size = UDim2.fromOffset(0, 0), UDim2.fromScale(1, 1)
		self.list.Visible, self.page.Visible = self.view == "list", self.view == "page"
	end
	self.title.TextSize = math.round(sizes.title * s)
	self.text.TextSize = math.round(sizes.body * s)
	self.game.TextSize = math.round(sizes.game * s)
	self.sources.TextSize = math.round(sizes.sources * s)
	self.empty.TextSize = math.round(sizes.body * s)
	for _, b in self.buttons do
		b.TextSize = math.round(sizes.button * s)
		b.Size = UDim2.new(1, -10, 0, math.floor(NotebookText.MIN_TARGET * s)) -- at least this tall (a touch target); a long title makes it taller
	end
	self:fitText()
end

-- The list of found pages, in the order they were found.
function NotebookPanel._rebuildList(self: any)
	for _, b in self.buttons do b:Destroy() end
	self.buttons, self.ids = {}, {}
	for i, entry in self.book:list() do
		local b = button(self.list, "Page_" .. entry.id, entry.title)
		b.LayoutOrder = i
		b.Selectable = false
		b.TextXAlignment = Enum.TextXAlignment.Left
		b.TextWrapped = true
		b.AutomaticSize = Enum.AutomaticSize.Y
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 6)
		pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8)
		pad.Parent = b
		local id = entry.id
		b.Activated:Connect(function() self:choose(id) end)
		table.insert(self.buttons, b)
		table.insert(self.ids, id)
	end
end

-- Shows one found page on the right (nothing about a page that is not found: view() gives nil for it).
function NotebookPanel.showPage(self: any, id: string)
	if id=="_checklist" then self:showChecklist();return end
	local p = if id ~= "" then self.book:view(id) else nil
	self.shown = if p then id else ""
	self.empty.Visible = p == nil
	self.title.Visible, self.text.Visible, self.sources.Visible = p ~= nil, p ~= nil, p ~= nil
	local gameLine = if p then NotebookText.gameLine(p.game, self.device) else nil
	self.game.Visible = gameLine ~= nil
	if p then
		self.title.Text, self.text.Text = p.title, p.text
		self.game.Text = gameLine or ""
		self.sources.Text = NotebookText.sourcesText(p.sources)
	end
	self:fitText()
	self.page.CanvasPosition = Vector2.zero
	for i, b in self.buttons do
		local on = self.ids[i] == self.shown
		b.BackgroundColor3 = if on then PAPER_LIT else PAPER_DARK
	end
	self:_select()
end

-- A controller shows what it has chosen: the list's selection follows the chosen page while the list is up.
function NotebookPanel._select(self: any)
	local at = table.find(self.ids, self.shown)
	local target: GuiObject? = nil -- native selection consumes D-pad before the reading action
	if at and self.list.Visible then
		local b = self.buttons[at]
		local y = b.AbsolutePosition.Y - self.list.AbsolutePosition.Y + self.list.CanvasPosition.Y
		local top = self.list.CanvasPosition.Y
		if y < top then top = y elseif y + b.AbsoluteSize.Y > top + self.list.AbsoluteSize.Y then top = y + b.AbsoluteSize.Y - self.list.AbsoluteSize.Y end
		self.list.CanvasPosition = Vector2.new(0,math.max(0,top))
	end
	pcall(function() GuiService.SelectedObject = target end)
end

-- Opens the notebook at its newest page. `returnTo` comes back to onClose; `device` names the controls; `scale` is the text scale.
function NotebookPanel.open(self: any, returnTo: string?, device: ControlText.Device, scale: number)
	self.returnTo, self.device, self.scale = returnTo, device, math.clamp(scale, 1, NotebookText.LARGE)
	self.showing = true
	self.stickDown, self.scrollAxis = false, 0
	self.gui.Enabled = true
	self:_rebuildList()
	self.view = "page"
	self:layout()
	self:showPage(self.book:newest() or "")
	if #self.ids > 0 and not self:stacked() then self.view = "list" end
	self:layout()
	self:_select()
	if not self.bound then
		self.bound = true
		CAS:BindActionAtPriority(ACTION, function(_, state, input)
			if GuiService.MenuIsOpen then self.scrollAxis=0;return Enum.ContextActionResult.Pass end
			self:_input(state, input)
			return Enum.ContextActionResult.Sink
		end, false, PRIORITY, table.unpack(KEYS))
	end
	pcall(function() UIS.MouseBehavior = Enum.MouseBehavior.Default; UIS.MouseIconEnabled = true end)
end

-- A page opened while the book is open (the list grows; the page on show stays).
function NotebookPanel.refresh(self: any)
	if not self.showing then return end
	local keep = self.shown
	self:_rebuildList()
	self:layout()
	self:showPage(keep)
end

function NotebookPanel.close(self: any)
	if not self.showing then return end
	self.showing = false
	self.gui.Enabled = false
	if self.bound then
		self.bound = false
		CAS:UnbindAction(ACTION)
	end
	pcall(function() GuiService.SelectedObject = nil end)
	local to = self.returnTo
	self.returnTo = nil
	self.onClose(to)
end

-- Chooses a page: it shows on the right; with one pane it takes the whole panel.
function NotebookPanel.choose(self: any, id: string)
	self:showPage(id)
	if self:stacked() then self.view = "page" end
	self:layout()
	self:_select()
end

-- Back from a page to the list when one pane shows; otherwise close.
function NotebookPanel.back(self: any)
	if self:stacked() and self.view == "page" then
		self.view = "list"
		self:layout()
		self:showPage(self.shown)
	else
		self:close()
	end
end

-- Moves the chosen page by `delta` in the list (wraps neither way).
function NotebookPanel.step(self: any, delta: number)
	local n = #self.ids
	if n == 0 then return end
	local at = table.find(self.ids, self.shown) or 1
	local to = math.clamp(at + delta, 1, n)
	self:showPage(self.ids[to])
end

function NotebookPanel.scrollBy(self: any, pixels: number)
	local p: ScrollingFrame = self.page
	local max = math.max(p.AbsoluteCanvasSize.Y - p.AbsoluteSize.Y, 0)
	p.CanvasPosition = Vector2.new(0, math.clamp(p.CanvasPosition.Y + pixels, 0, math.max(max, 0)))
end

-- One input the Context Action got.
function NotebookPanel._input(self: any, state: Enum.UserInputState, input: InputObject?)
	local k = if input then input.KeyCode else nil
	if k == Enum.KeyCode.Thumbstick2 then
		local y = if input and state ~= Enum.UserInputState.Cancel then input.Position.Y else 0
		self.scrollAxis = if math.abs(y) < 0.25 then 0 else -y -- stick up scrolls up the page
		return
	end
	if k == Enum.KeyCode.Thumbstick1 then
		local y = if input and state ~= Enum.UserInputState.Cancel then input.Position.Y else 0
		if math.abs(y) < 0.3 then
			self.stickDown = false
		elseif math.abs(y) > 0.6 and not self.stickDown then
			self.stickDown = true
			self:_vertical(if y > 0 then -1 else 1)
		end
		return
	end
	if state ~= Enum.UserInputState.Begin then return end
	if k==Enum.KeyCode.C or k==Enum.KeyCode.ButtonY then
		self:showChecklist()
	elseif k == Enum.KeyCode.N then
		self:close()
	elseif k == Enum.KeyCode.Q or k == Enum.KeyCode.ButtonB or k == Enum.KeyCode.Backspace then
		self:back()
	elseif k == Enum.KeyCode.Up or k == Enum.KeyCode.W or k == Enum.KeyCode.DPadUp then
		self:_vertical(-1)
	elseif k == Enum.KeyCode.Down or k == Enum.KeyCode.S or k == Enum.KeyCode.DPadDown then
		self:_vertical(1)
	elseif k == Enum.KeyCode.Left or k == Enum.KeyCode.A or k == Enum.KeyCode.DPadLeft or k == Enum.KeyCode.ButtonL1 then
		self:step(-1)
	elseif k == Enum.KeyCode.Right or k == Enum.KeyCode.D or k == Enum.KeyCode.DPadRight or k == Enum.KeyCode.ButtonR1 then
		self:step(1)
	elseif k == Enum.KeyCode.PageUp then
		self:scrollBy(-self.page.AbsoluteSize.Y * 0.8)
	elseif k == Enum.KeyCode.PageDown then
		self:scrollBy(self.page.AbsoluteSize.Y * 0.8)
	else -- Return, Space, E, A: open the chosen page (one pane), or nothing to do (two panes)
		if self:stacked() and self.view == "list" and self.shown ~= "" then self:choose(self.shown) end
	end
end

-- Up and Down: choose a page in the list, or scroll the page when it has the whole panel.
function NotebookPanel._vertical(self: any, dir: number)
	if self.shown=="_checklist" or (self:stacked() and self.view == "page") then
		self:scrollBy(dir * STEP_PX)
	else
		self:step(dir)
	end
end

-- Each rendered frame while open: the right stick scrolls the page.
function NotebookPanel.update(self: any, dt: number)
	if self.showing and not GuiService.MenuIsOpen and self.scrollAxis ~= 0 then
		self:scrollBy(self.scrollAxis * SCROLL_PX_S * math.min(dt, 0.1))
	end
end

-- The controls change with the device in use (a controller picked up while the book is open).
function NotebookPanel.setDevice(self: any, device: ControlText.Device)
	if device == self.device then return end
	self.device = device
	if self.showing then
		self:layout()
		self:showPage(self.shown)
	end
end

-- Explicit full-text heights avoid AutomaticSize clipping long labels to the viewport on resize.
function NotebookPanel.fitText(self:any)
 local width=self.page.AbsoluteSize.X
 if width<=0 then
  local w,h=self:_screen();local lay=NotebookText.layout(w,h,self.scale)
  width=(NotebookText.metrics(w,h,self.scale).paperW-28)*(if lay.sideBySide then 1-lay.listFraction else 1)-(if lay.sideBySide then 8 else 0)
 end
 for _,l in {self.title,self.text,self.game,self.sources,self.empty} do
  local measured=TextService:GetTextSize(l.Text,l.TextSize,l.Font,Vector2.new(math.max(1,width-14),100000))
  l.Size=UDim2.new(1,-14,0,math.ceil(measured.Y)+4)
 end
end
function NotebookPanel.showChecklist(self:any)
 self.shown="_checklist";self.view="page"
 self.empty.Visible=false;self.title.Visible=true;self.text.Visible=true;self.game.Visible=true;self.sources.Visible=false
 self.title.Text="Things to try"
 self.text.Text=NotebookText.checklist(self.book)
 self.game.Text="Choose whatever interests you. Checked things happened during this play session; nothing here is required. The page list contains what you have discovered."
 self.page.CanvasPosition=Vector2.zero
 self:layout();self:_select()
 for _,b in self.buttons do b.BackgroundColor3=PAPER_DARK end
end
return NotebookPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">OldSkins</string>
            <string name="Source"><![CDATA[--!strict
-- At most three pale, empty skins in the retreat. Presentation only, never queried by movement or senses.
local OldSkins={}
OldSkins.__index=OldSkins
function OldSkins.new(parent: Instance): any
 local folder=Instance.new("Folder");folder.Name="OldSkins";folder.Parent=parent
 return setmetatable({folder=folder,key=""},OldSkins)
end
function OldSkins.draw(self: any,positions: {Vector3})
 local key=""
 for _,p in positions do key..=string.format("%.5f,%.5f,%.5f;",p.X,p.Y,p.Z) end
 if key==self.key then return end
 self.key=key;self.folder:ClearAllChildren()
 for i,p in positions do
  local center=p+Vector3.new((i-2)*0.23,-0.25,0.06*(i-1))
  local function piece(name: string,size: Vector3,cf: CFrame)
   local part=Instance.new("Part");part.Name=name;part.Size=size;part.CFrame=cf
   part.Anchored=true;part.CanCollide=false;part.CanQuery=false;part.CanTouch=false;part.CastShadow=false
   part.Color=Color3.new(.78,.71,.57);part.Material=Enum.Material.SmoothPlastic;part.Transparency=.38
   part.Parent=self.folder
   return part
  end
  local shell=piece("EmptySkin",Vector3.new(.21,.08,.30),CFrame.new(center))
  local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Sphere;mesh.Parent=shell
  for j=1,8 do
   local side=if j<=4 then -1 else 1
   local z=((j-1)%4-1.5)*.065
   local a=center+Vector3.new(side*.06,0,z)
   local b=center+Vector3.new(side*.22,.015,z*1.5)
   piece("ShedLeg",Vector3.new(.018,.018,(b-a).Magnitude),CFrame.lookAt((a+b)*.5,b))
  end
 end
end
return OldSkins
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">PerceptionHud</string>
            <string name="Source"><![CDATA[--!strict
-- Thin drawer for the pure memory view (Shared/UI/PerceptionView). Reuses widgets rather than creating Instances every frame.
-- ROBLOX-20, the drawer's polish: a circle is a rounded Frame with a UIStroke, the dashed last-seen ring is 12 short rounded bars,
-- an off-screen cue is a chevron of two bars, the Focus ticks are four bars, and a label is white Builder Sans on a dark pill under
-- the ring it names (above it only when the screen has no room below, so a world billboard over a marker no longer lies on it). The
-- geometry is Shared/UI/PerceptionShapes. What is drawn, and its words, opacities and timings, are PerceptionView's: this changes
-- how it looks, not what it says.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local View = require(Shared.UI.PerceptionView)
local Shapes = require(Shared.UI.PerceptionShapes)
local Hud = {}
Hud.__index = Hud

local WHITE, DARK = Color3.new(1, 1, 1), Color3.new(0, 0, 0)
local PILL = Color3.fromRGB(10, 14, 12)
local FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.SemiBold)
local TEXT_SIZE = 18
local THICKNESS = { dash = 2, chevron = 3, tick = 2 }

local function rounded(f: Instance)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
end

local function outline(f: Instance, color: Color3, thickness: number, mode: Enum.ApplyStrokeMode): UIStroke
	local s = Instance.new("UIStroke")
	s.Color, s.Thickness, s.ApplyStrokeMode = color, thickness, mode
	s.Transparency = 1
	s.Parent = f
	return s
end

local function box(name: string, parent: Instance): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BorderSizePixel = 0
	f.Visible = false
	f.Parent = parent
	return f
end

-- A thin rounded bar with a dark edge: a dash of a last-seen ring, an arm of a chevron, a Focus tick.
local function newBar(parent: Instance): any
	local f = box("Bar", parent)
	f.BackgroundColor3 = WHITE
	rounded(f)
	return { frame = f, edge = outline(f, DARK, 1, Enum.ApplyStrokeMode.Border) }
end

-- A circle: a see-through rounded Frame with a 2 px white stroke and, just outside it, a dark one so it reads on light and dark ground.
local function newCircle(parent: Instance): any
	local f = box("Circle", parent)
	f.BackgroundTransparency = 1
	rounded(f)
	local line = outline(f, WHITE, 2, Enum.ApplyStrokeMode.Border)
	local halo = box("Halo", f)
	halo.Position = UDim2.fromScale(0.5, 0.5)
	halo.Size = UDim2.new(1, 4, 1, 4)
	halo.BackgroundTransparency = 1
	halo.Visible = true
	rounded(halo)
	return { frame = f, line = line, halo = outline(halo, DARK, 1.5, Enum.ApplyStrokeMode.Border) }
end

-- A label: text with a dark edge on a dark pill that grows to fit it.
local function newLabel(parent: Instance): any
	local l = Instance.new("TextLabel")
	l.Name = "Label"
	l.AnchorPoint = Vector2.new(0.5, 0)
	l.AutomaticSize = Enum.AutomaticSize.XY
	l.Size = UDim2.fromOffset(0, 0)
	l.BackgroundColor3 = PILL
	l.BorderSizePixel = 0
	l.FontFace = FONT
	l.TextSize = TEXT_SIZE
	l.TextColor3 = WHITE
	l.TextWrapped = false
	l.ZIndex = 2
	l.Visible = false
	l.Parent = parent
	rounded(l)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
	pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 3), UDim.new(0, 3)
	pad.Parent = l
	return { frame = l, edge = outline(l, DARK, 1.5, Enum.ApplyStrokeMode.Contextual) }
end

local MAKE: { [string]: (Instance) -> any } = { bar = newBar, circle = newCircle, label = newLabel }

function Hud.new(parent: Instance): any
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.IgnoreGuiInset, gui.ResetOnSpawn = "PerceptionHud", true, false
	gui.DisplayOrder = 4
	gui.Parent = parent
	return setmetatable({
		gui = gui,
		pools = { bar = {}, circle = {}, label = {} }, -- every widget made, by kind
		used = { bar = 0, circle = 0, label = 0 }, -- how many this frame has taken
		shown = { bar = 0, circle = 0, label = 0 }, -- how many were showing after the last frame
	}, Hud)
end

function Hud._take(self: any, kind: string): any
	local n = self.used[kind] + 1
	self.used[kind] = n
	local w = self.pools[kind][n]
	if w == nil then
		w = MAKE[kind](self.gui)
		self.pools[kind][n] = w
	end
	return w
end

function Hud._bar(self: any, b: Shapes.Bar, thickness: number, alpha: number)
	local w = self:_take("bar")
	local f = w.frame
	f.Position = UDim2.fromOffset(b.x, b.y)
	f.Size = UDim2.fromOffset(b.length, thickness)
	f.Rotation = b.rotation
	f.BackgroundTransparency = 1 - alpha
	w.edge.Transparency = 1 - alpha * 0.9
	f.Visible = true
end

function Hud._circle(self: any, at: Vector2, radius: number, alpha: number)
	local w = self:_take("circle")
	local f = w.frame
	f.Position = UDim2.fromOffset(at.X, at.Y)
	f.Size = UDim2.fromOffset(radius * 2, radius * 2)
	w.line.Transparency = 1 - alpha
	w.halo.Transparency = 1 - alpha * 0.6
	f.Visible = true
end

-- `offset` is PerceptionView's gap from the ring's middle to the label. The pill's width is whatever it measured last frame.
function Hud._label(self: any, text: string, at: Vector2, offset: number, alpha: number, viewport: Vector2)
	local w = self:_take("label")
	local l = w.frame
	local x, y = Shapes.labelAt(at.X, at.Y, offset, l.AbsoluteSize.X, viewport.X, viewport.Y)
	if l.Text ~= text then
		l.Text = text
	end
	l.Position = UDim2.fromOffset(x, y)
	l.TextTransparency = 1 - alpha
	l.BackgroundTransparency = 1 - 0.55 * alpha
	w.edge.Transparency = 1 - alpha * 0.9
	l.Visible = true
end

-- Hides the widgets the last frame used and this one did not.
function Hud._hideSpare(self: any)
	for kind, pool in self.pools do
		for i = self.used[kind] + 1, self.shown[kind] do
			pool[i].frame.Visible = false
		end
		self.shown[kind] = self.used[kind]
	end
end

function Hud.draw(self: any, memory: any, camera: Camera, cast: any, focusing: boolean, showMark: boolean?)
	local used = self.used
	used.bar, used.circle, used.label = 0, 0, 0
	local viewport = camera.ViewportSize
	local adapter = {
		project = function(at: Vector3, size: number)
			local p = camera:WorldToViewportPoint(at)
			local q = camera:WorldToViewportPoint(at+camera.CFrame.RightVector*math.max(size,0.2)*0.5)
			return Vector2.new(p.X,p.Y), p.Z > 0 and p.X > -40 and p.Y > -40 and p.X < viewport.X+40 and p.Y < viewport.Y+40,
				math.clamp((Vector2.new(p.X,p.Y)-Vector2.new(q.X,q.Y)).Magnitude,10,36)
		end,
		edge = function(dir: Vector3)
			local d = camera.CFrame:VectorToObjectSpace(dir)
			local v = Vector2.new(d.X,-d.Y)
			if v.Magnitude < 0.03 then v = Vector2.new(0,-1) end
			v = v.Unit
			local half = viewport*0.5-Vector2.new(34,34)
			local t = math.min(half.X/math.max(math.abs(v.X),1e-6),half.Y/math.max(math.abs(v.Y),1e-6))
			return {pos=viewport*0.5+v*t, dir=v}
		end,
		covered = function(at: Vector3, slack: number)
			local eye = camera.CFrame.Position
			local hit = cast(eye,at)
			return hit ~= nil and (hit-eye).Magnitude < (at-eye).Magnitude-slack
		end,
	}
	local view = View.build(memory,adapter,showMark)
	for _, e in view.edges do
		for _, b in Shapes.chevron(e.pos.X, e.pos.Y, e.dir.X, e.dir.Y) do
			self:_bar(b, THICKNESS.chevron, e.alpha)
		end
	end
	for _, r in view.rings do
		if r.kind == "mark" then
			-- Twelve dashes; the gaps grow as the sighting ages (r.dash falls from 1 to 0.3).
			for _, b in Shapes.dashRing(r.pos.X, r.pos.Y, r.radius, r.dash) do
				self:_bar(b, THICKNESS.dash, r.alpha)
			end
		else
			self:_circle(r.pos, r.radius, r.alpha)
		end
	end
	for _, l in view.labels do
		self:_label(l.text, l.pos, l.offset, l.alpha, viewport)
	end
	if focusing then
		for _, b in Shapes.focusTicks(viewport.X * 0.5, viewport.Y * 0.5) do
			self:_bar(b, THICKNESS.tick, 0.8)
		end
	end
	self:_hideSpare()
	self.view = view
end
return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">PerceptionStage</string>
            <string name="Source"><![CDATA[--!strict
-- Temporary D-038 stage, away from spawn, crevice and recovery routes. Physical screen/ledge belong to WORLD.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Target = require(Shared.Habitat.TestTarget)
local Stage = {}
function Stage.new(sill: Instance): any
	local folder = Instance.new("Folder")
	folder.Name = "PerceptionStage"
	folder.Parent = sill
	local function part(name: string, at: Vector3, size: Vector3, solid: boolean): Part
		local p = Instance.new("Part")
		p.Name, p.Position, p.Size = name, at, size
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, solid, solid, false
		p.Color = Color3.fromRGB(116, 100, 91)
		if solid then p:SetAttribute("ProfileId", "bare_wood_rough"); p:SetAttribute("SurfaceId", name) end
		p.Parent = folder
		return p
	end
	part("watch_ledge", Vector3.new(-25,1,-3.5), Vector3.new(4,2,3), true)
	part("stage_screen", Vector3.new(-25,1.5,-7), Vector3.new(2,3,0.2), true)
	local marker = part("TestMarker", Vector3.new(-29,2.8,-10), Vector3.one*0.9, false)
	marker.Shape = Enum.PartType.Ball
	marker.Color = Color3.fromRGB(220,31,158)
	local sign = Instance.new("BillboardGui")
	sign.Name, sign.Size, sign.StudsOffset = "TargetSign", UDim2.fromOffset(220,55), Vector3.new(0,1,0)
	sign.AlwaysOnTop = false
	sign.Parent = marker
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1,1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1,1,1)
	label.TextStrokeTransparency = 0
	label.TextSize = 15
	label.Text = "TEST TARGET\nmoving marker, not a fly"
	label.Parent = sign
	local target = Target.new({Vector3.new(-29,2.8,-10), Vector3.new(-21,2.8,-10)})
	return {target=target, marker=marker, folder=folder}
end
return Stage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">SaveClient</string>
            <string name="Source"><![CDATA[--!strict
-- The client's side of persistent saves (ROBLOX-39). It looks for the server's remotes, says hello, hears the saved state, and sends the
-- player's progress and rests up, throttled. It never decides what is saved (the server owns the DataStore and checks everything it is
-- sent) and the game never waits on it for long: with no remotes, no reply, or a server that says saving is off, the game plays exactly as
-- it did before saves existed, with the notebook and rests lasting the session.
--   * update(now): once per frame. Finds the remotes, says hello (again every CLIENT_HELLO_GAP seconds until answered, CLIENT_HELLO_TRIES times),
--     sends queued progress and rests when their gaps allow.
--   * waiting(): the start menu may wait while this is true: the remotes are being looked for (CLIENT_WAIT_REMOTES seconds) or the first reply
--     is awaited (CLIENT_WAIT_REPLY seconds). It is never true for long.
--   * status(): ("saved" | "saving" | "session", reason). Before any reply: nil. With no server: ("session", "offline").
-- `cfg.rules` is Data/SaveRules; `cfg.findRemotes()` returns { server, client } (RemoteEvents) or nil; the callbacks hand the server's messages up.
local SaveClient = {}
SaveClient.__index = SaveClient

export type Config = {
	rules: any, now: () -> number, findRemotes: () -> any?,
	onLoaded: (any) -> (), onRest: (string, any) -> (), onStatus: (string, string?) -> (),
	build: () -> any, -- the progress to send now (called only when something changed and the gap allows)
}

function SaveClient.new(cfg: Config): any
	local now = cfg.now()
	return setmetatable({
		cfg = cfg, born = now, remotes = nil :: any, phase = "searching", helloAt = -1e9, helloTries = 0,
		lastProgress = -1e9, dirty = false, pendingRest = {} :: { [string]: any }, lastRest = {} :: { [string]: number },
		st = nil :: string?, why = nil :: string?, sent = { progress = 0, rest = 0, hello = 0 },
	}, SaveClient)
end

local function receive(self: any, msg: any)
	if type(msg) ~= "table" or type(msg.kind) ~= "string" then return end
	if msg.kind == "loaded" then
		self.phase = "ready"
		self.st, self.why = msg.status, msg.reason
		self.cfg.onLoaded(msg)
		self.cfg.onStatus(msg.status, msg.reason)
	elseif msg.kind == "status" then
		self.st, self.why = msg.status, msg.reason
		self.cfg.onStatus(msg.status, msg.reason)
	elseif msg.kind == "rest" then
		if type(msg.mode) == "string" then self.cfg.onRest(msg.mode, msg.record) end
	end
end
SaveClient.receive = receive

local function connect(self: any, remotes: any)
	self.remotes = remotes
	self.phase = "hello"
	local ev = remotes.client.OnClientEvent
	ev:Connect(function(msg: any)
		local ok = pcall(receive, self, msg)
		if not ok then self.cfg.onStatus("session", "offline") end
	end)
end

function SaveClient.markDirty(self: any)
	self.dirty = true
end

function SaveClient.sendRest(self: any, mode: string, record: any)
	self.pendingRest[mode] = record
end

function SaveClient.waiting(self: any): boolean
	local t = self.cfg.now()
	local rules = self.cfg.rules
	if self.phase == "searching" then return t - self.born < rules.CLIENT_WAIT_REMOTES end
	if self.phase == "hello" then return t - self.born < rules.CLIENT_WAIT_REMOTES + rules.CLIENT_WAIT_REPLY and self.helloTries <= rules.CLIENT_HELLO_TRIES end
	return false
end

function SaveClient.status(self: any): (string?, string?)
	if self.st ~= nil then return self.st, self.why end
	if self.phase == "searching" and self.cfg.now() - self.born >= self.cfg.rules.CLIENT_WAIT_REMOTES then return "session", "offline" end
	if self.phase == "hello" and not self:waiting() then return "session", "offline" end
	return nil, nil
end

function SaveClient.connected(self: any): boolean
	return self.phase == "ready"
end

function SaveClient.update(self: any)
	local t = self.cfg.now()
	local rules = self.cfg.rules
	if self.phase == "searching" then
		local remotes = self.cfg.findRemotes()
		if remotes ~= nil then
			connect(self, remotes)
		else
			return
		end
	end
	if self.phase == "hello" and t - self.helloAt >= rules.CLIENT_HELLO_GAP and self.helloTries < rules.CLIENT_HELLO_TRIES then
		self.helloAt = t
		self.helloTries += 1
		self.sent.hello += 1
		self.remotes.server:FireServer({ kind = "hello", v = rules.PROTOCOL })
	end
	if self.dirty and t - self.lastProgress >= rules.CLIENT_PROGRESS_GAP then
		self.dirty = false
		self.lastProgress = t
		local payload = self.cfg.build()
		if payload ~= nil then
			self.sent.progress += 1
			self.remotes.server:FireServer({ kind = "progress", progress = payload })
		end
	end
	for mode, record in self.pendingRest do
		if t - (self.lastRest[mode] or -1e9) >= rules.CLIENT_PROGRESS_GAP * 2 then
			self.pendingRest[mode] = nil
			self.lastRest[mode] = t
			self.sent.rest += 1
			self.remotes.server:FireServer({ kind = "rest", mode = mode, record = record })
		end
	end
end

return SaveClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">Soundscape</string>
            <string name="Source"><![CDATA[--!strict
-- Original procedural recordings from the frozen Godot sound_bank.gd. Presentation only:
-- never feeds perception, AI or simulation time. Roblox's master volume controls every voice.
local Soundscape = {}
Soundscape.__index = Soundscape
local IDS = {
	room = "rbxassetid://135813320748786", buzz = "rbxassetid://90354950534870",
	takeoff = "rbxassetid://135484013341687", birds = "rbxassetid://105858750316891",
	wasp = "rbxassetid://76049518783466",
}
local function voice(parent: Instance, name: string, volume: number, looped: boolean): Sound
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = IDS[name]
	s.Volume = volume
	s.Looped = looped
	s.RollOffMinDistance = 8
	s.RollOffMaxDistance = 80
	s.Parent = parent
	return s
end
function Soundscape.new(parent: Instance): any
	local root = Instance.new("Folder")
	root.Name = "WindowsillAudio"
	root.Parent = parent
	local emitter = Instance.new("Part")
	emitter.Name = "WaspAudio"
	emitter.Anchored = true; emitter.CanCollide = false; emitter.CanTouch = false; emitter.CanQuery = false
	emitter.Transparency = 1; emitter.Size = Vector3.new(0.1, 0.1, 0.1); emitter.Parent = root
	local hum = voice(emitter, "wasp", 0.42, true)
	hum.RollOffMinDistance = 16; hum.RollOffMaxDistance = 120
	return setmetatable({ root = root, room = voice(root, "room", 0.09, true),
		waspEmitter = emitter, waspHum = hum,
		birds = voice(root, "birds", 0.16, false), slots = {}, elapsed = 0, nextBird = 8 }, Soundscape)
end
local function playing(s: Sound, wanted: boolean)
	if wanted then
		if not s.Playing then s:Resume(); if not s.Playing then s:Play() end end
	elseif s.Playing then s:Pause() end
end
function Soundscape.update(self: any, dt: number, prey: any, daylight: number, paused: boolean, speed: number, muted: boolean)
	local audible = not paused and not muted
	playing(self.room, audible)
	self.room.PlaybackSpeed = speed
	self.birds.PlaybackSpeed = speed
	if not audible or daylight < 0.3 then self.birds:Stop() end
	if audible then
		self.elapsed += math.min(dt, 0.25) * speed
		if self.elapsed >= self.nextBird then
			self.nextBird = self.elapsed + 17
			if daylight >= 0.3 then self.birds:Play() end
		end
	end
	-- A bounded pool, indexed by the current population rather than holding checkpoint fly references.
	for i, fly in prey.flies do
		if i > 8 then break end
		local slot = self.slots[i]
		if not slot then
			local p = Instance.new("Part")
			p.Name = "FlyAudio"
			p.Anchored = true; p.CanCollide = false; p.CanTouch = false; p.CanQuery = false
			p.Transparency = 1; p.Size = Vector3.new(0.1, 0.1, 0.1); p.Parent = self.root
			slot = { part = p, buzz = voice(p, "buzz", 0.23, true), takeoff = voice(p, "takeoff", 0.22, false), flying = false }
			self.slots[i] = slot
		end
		slot.part.Position = fly.position
		local flying = fly:airborne() or (prey.feeding.held == fly and prey.feeding.struggling)
		slot.buzz.PlaybackSpeed = speed; slot.takeoff.PlaybackSpeed = speed
		playing(slot.buzz, audible and flying)
		if not audible then slot.takeoff:Stop()
		elseif flying and not slot.flying then slot.takeoff:Play() end
		slot.flying = flying
	end
	for i, slot in self.slots do
		if i > #prey.flies then slot.part:Destroy(); self.slots[i] = nil end
	end
end
-- The warning starts immediately with the director's arrival phase. Its initial global mix
-- cannot disappear when the third-person camera is far away; the caption supplies direction.
-- Once it reaches the sill, the same voice follows the wasp in 3D. No second warning timer.
function Soundscape.updateWasp(self: any, director: any, paused: boolean, speed: number, muted: boolean)
	local arriving = director.phase == "arriving"
	local active = director.phase ~= "away" and director.wasp.mode ~= "walking"
	local hum: Sound = self.waspHum
	self.waspEmitter.Position = director.wasp.position
	hum.Parent = if arriving then self.root else self.waspEmitter
	hum.Volume = if arriving then 0.32 else 0.42
	hum.PlaybackSpeed = speed
	if not active then hum:Stop()
	else playing(hum, not paused and not muted) end
end
function Soundscape.destroy(self: any)
	self.root:Destroy()
	table.clear(self.slots)
end
return Soundscape
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="120">
          <Properties>
            <string name="Name">SpiderCamera</string>
            <string name="Source"><![CDATA[--!strict
-- The spider's camera: a Roblox port of the frozen Godot rig, scripts/movement/camera_rig.gd (c87ce00).
-- A Scriptable camera, so Roblox's own orbit (which centres on the body and so aimed jumps at the spider's feet)
-- never runs. Pure math lives in Shared/Movement/CameraMath and LineFraming and is checked against Godot's values.
--
-- Orbit view: yaw/pitch only, never rolls (horizon-stable). The pivot stands PIVOT_HEIGHT along the spider's drawn up (so
-- on a wall it stands out from the wall, under an overhang it hangs below). The boom is a sphere cast from the pivot; a hit
-- retracts at once, recovery is rate limited. A squeezed boom searches steeper, then flatter pitches (auto-pitch). Close
-- in, the body is hidden so it never fills the screen. A cast that starts touching geometry counts as blocked (Godot's
-- cast_motion; Roblox's Spherecast would not see that part), so the camera is never placed inside the sill.
-- Line framing (LineFraming, A-017 with Chet's 45-degree cap): hanging on the safety line with the player's own view
-- squeezed where the spider will hang, the view turns by the smallest 15-degree step (at most 45) that sees the spider
-- and the lip; the player's look, a recenter or aiming takes the turn over at once and nothing jumps.
-- Aiming: the screen-centre ray picks the jump target. Vertical look then tilts the camera about its own position
-- (aim pitch) instead of orbiting, so the player can aim above the pivot; it eases back after.
-- Spider-eye view (V / Y): the camera sits just ahead of the principal eyes looking along a gaze the player turns; its up
-- follows the body's at most EYE_ROLL_DEG_S. Walking is relative to the gaze. Switching back snaps behind the spider.
-- The picture (field of view, colour, blur: ROBLOX-20) is Client/SpiderEyes'; it only sets the field of view and lookScale here.
-- Mouse: locked to the screen centre while playing (as the Godot game captures it); the Roblox menu frees it.
-- Placement order (Godot chunk 6B): no boom is trusted until the sill can be seen by queries; until then the camera sits
-- at the pivot with a boom of 0.

local GuiService = game:GetService("GuiService")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Movement = game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Movement")
local CameraMath = require(Movement:WaitForChild("CameraMath"))
local SupportMath = require(Movement:WaitForChild("SupportMath"))
local LineFraming = require(Movement:WaitForChild("LineFraming"))

local SpiderCamera = {}
SpiderCamera.__index = SpiderCamera

local MIN_DISTANCE, MAX_DISTANCE = 2.0, 12.0
local TOUCH_DEG_PER_PIXEL = 0.25

export type Target = { pos: Vector3, drawnUp: Vector3, heading: Vector3, onLine: boolean?, rest: Vector3?, lip: Vector3?, cameraScale: number? }

function SpiderCamera.new(camera: Camera, params: RaycastParams, target: () -> Target, onEye: (boolean) -> ())
	local overlap = OverlapParams.new()
	overlap.FilterType = params.FilterType
	overlap.FilterDescendantsInstances = params.FilterDescendantsInstances
	local self = setmetatable({
		camera = camera,
		params = params,
		overlap = overlap,
		target = target,
		onEye = onEye,
		yaw = 0,
		elevation = math.rad(CameraMath.DEFAULT_ELEVATION_DEG),
		autoPitch = 0, autoPitchPrev = 0, settle = 0,
		aimPitch = 0,
		aiming = false,
		distance = CameraMath.CAMERA_DISTANCE,
  appearanceScale = 1,
		boom = 0, pivot = 0,
		pivotDir = Vector3.yAxis,
		recenterT = -1, recenterYaw0 = 0, recenterElev0 = 0, recenterGaze0 = Vector3.zero,
		eyeView = false,
		lookScale = 1, -- the eye view only: SpiderEyes sets it with the field of view, so a turn of the view moves the picture as fast at any zoom
		gaze = -Vector3.zAxis,
		gazeUp = Vector3.yAxis,
		bodyHidden = false,
		hide = nil :: ((boolean) -> ())?,
		framing = LineFraming.new(),
		wantedKey = "", wantedCache = 0,
		worldReady = false,
		mouse = true, -- false in tests: no mouse lock or mouse look (the Studio specs run on the server)
	}, SpiderCamera)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = CameraMath.FOV_DEG
	UIS.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseWheel and not processed and not self.eyeView then
			self.distance = math.clamp(self.distance * (if input.Position.Z > 0 then 0.88 else 1 / 0.88), MIN_DISTANCE, MAX_DISTANCE)
		end
	end)
	self:snap()
	return self
end

-- The view's yaw: the player's own plus the line framing's turn. Walking steers by it, so the stick means what is on screen.
function SpiderCamera.viewYaw(self: any): number
	return self.yaw + self.framing.assist
end

-- True once the geometry the camera casts against has arrived (placement order).
function SpiderCamera._ready(self: any): boolean
	if not self.worldReady then
		for _, root in self.params.FilterDescendantsInstances do
			if root:FindFirstChildWhichIsA("BasePart", true) then
				self.worldReady = true
				break
			end
		end
	end
	return self.worldReady
end

-- Boom length clear of the sill from `from` along `motion`. A start touching geometry is blocked at once.
function SpiderCamera._cast(self: any, from: Vector3, motion: Vector3): number
	local length = motion.Magnitude
	if length < 1e-6 or not self:_ready() then return 0 end
	if #Workspace:GetPartBoundsInRadius(from, CameraMath.BOOM_RADIUS, self.overlap) > 0 then return 0 end
	local hit = Workspace:Spherecast(from, CameraMath.BOOM_RADIUS, motion, self.params)
	return if hit then math.max(0, hit.Distance - 0.01) else length
end

function SpiderCamera.viewDistance(self: any): number
 return self.distance * self.appearanceScale
end

function SpiderCamera._boomAt(self: any, from: Vector3, yaw: number, pitch: number): number
	return self:_cast(from, CameraMath.backDirection(yaw, pitch) * self:viewDistance())
end

-- camera_rig._pitch_search: the auto-pitch offset from the pivot `from` at this yaw, and the boom it gives.
function SpiderCamera._pitchSearch(self: any, from: Vector3, yaw: number): (number, number)
	local comfort = math.min(CameraMath.COMFORT_BOOM, self:viewDistance())
	local offsets, lengths = { 0 }, { self:_boomAt(from, yaw, self.elevation) }
	local step = math.rad(CameraMath.AUTO_PITCH_STEP_DEG)
	local roomDown = math.max(math.rad(CameraMath.MAX_ELEVATION_DEG) - self.elevation, 0)
	local roomUp = math.max(self.elevation - math.rad(CameraMath.MIN_AUTO_ELEVATION_DEG), 0)
	local offset = 0
	while lengths[#lengths] < comfort and offset < roomDown - 1e-6 do
		offset = math.min(offset + step, roomDown)
		table.insert(offsets, offset)
		table.insert(lengths, self:_boomAt(from, yaw, self.elevation + offset))
	end
	offset = 0
	while lengths[#lengths] < comfort and offset < roomUp - 1e-6 do
		offset = math.min(offset + step, roomUp)
		table.insert(offsets, -offset)
		table.insert(lengths, self:_boomAt(from, yaw, self.elevation - offset))
	end
	local picked = CameraMath.pickPitchOffset(offsets, lengths, comfort)
	local index = table.find(offsets, picked) or 1
	return picked, lengths[index]
end

-- True when nothing in the sill stands between the two points (camera_rig._sees).
function SpiderCamera._sees(self: any, a: Vector3, b: Vector3): boolean
	local d = b - a
	if d.Magnitude < 1e-6 then return true end
	local hit = Workspace:Raycast(a, d, self.params)
	return hit == nil or (hit.Position - a).Magnitude >= d.Magnitude - LineFraming.SIGHT_TOLERANCE
end

-- camera_rig._good_view: from the pivot `from`, at this yaw and the pitch the search picks, the boom is comfortable and
-- the camera sees both the spider where it will hang and the lip.
function SpiderCamera._goodView(self: any, from: Vector3, yaw: number, spot: Vector3, lip: Vector3): boolean
	local offset, length = self:_pitchSearch(from, yaw)
	if length < math.min(CameraMath.COMFORT_BOOM, self:viewDistance()) then return false end
	local camPos = from + CameraMath.backDirection(yaw, CameraMath.effectiveElevation(self.elevation, offset)) * length
	return self:_sees(camPos, spot) and self:_sees(camPos, lip)
end

-- The framing's wanted turn for the rest point and lip, recomputed only when they, the pivot or the player's view move.
function SpiderCamera._wantedTurn(self: any, t: Target): number
	local rest = t.rest or t.pos
	local lip = t.lip or rest
	local from = rest + self.pivotDir * self.pivot
	local function q(v: Vector3): string return string.format("%.2f,%.2f,%.2f", v.X, v.Y, v.Z) end
	local key = q(from) .. "|" .. q(lip) .. "|" .. string.format("%.4f,%.4f,%.2f,%.4f", self.yaw, self.elevation, self:viewDistance(), self.framing.target)
	if key ~= self.wantedKey then
		self.wantedKey = key
		self.wantedCache = LineFraming.wantedTurn(self.framing.target, self.framing.maxTurn, function(turn: number): boolean
			return self:_goodView(from, self.yaw + turn, rest, lip)
		end)
	end
	return self.wantedCache
end

function SpiderCamera._bodyForward(self: any): Vector3
	return self.target().heading
end

-- Puts the orbit camera behind the spider at once (spawn, reset, leaving the eye view). No framing turn survives it.
function SpiderCamera.snap(self: any)
	local t = self.target()
	self.yaw = CameraMath.recenterYaw(t.heading, t.drawnUp, self.yaw)
	self.elevation = math.rad(CameraMath.DEFAULT_ELEVATION_DEG)
	self.recenterT = -1
	self.framing:reset()
	self.wantedKey = ""
	self.pivotDir = t.drawnUp
	self.pivot = CameraMath.PIVOT_HEIGHT
	self.settle = 2
	self.boom = 0
	self:tick(0)
end

-- R / middle mouse / right-stick click: behind the spider over a quarter second. On the line it takes the framing's turn
-- over first (nothing jumps) and keeps the framing off until the line ends. Aiming wins over a recenter.
function SpiderCamera.startRecenter(self: any)
	if self.aiming then return end
	self.recenterT = 0
	if self.eyeView then
		self.recenterGaze0 = self.gaze
	else
		self.yaw += self.framing:playerTurns(self.target().onLine == true)
		self.recenterYaw0, self.recenterElev0 = self.yaw, self.elevation
	end
end

-- Aiming starts or ends (JumpInput). Starting takes the framing's turn over, so the view of the landing stays put.
function SpiderCamera.setAiming(self: any, on: boolean)
	self.aiming = on
	if on then
		self.yaw += self.framing:takeOver()
		self.recenterT = -1
	end
end

-- "Frame the line after a catch" (default on). Switched off with a turn held, the view stays where it is.
function SpiderCamera.setFraming(self: any, on: boolean)
	self.yaw += self.framing:setEnabled(on)
end

function SpiderCamera.setEyeView(self: any, on: boolean)
	if on == self.eyeView then return end
	self.eyeView = on
	self.recenterT = -1
	self.camera.FieldOfView = if on then CameraMath.EYE_FOV_DEG else CameraMath.FOV_DEG
	if on then
		local t = self.target()
		self.yaw += self.framing:takeOver()
		self.aimPitch = 0
		self.gazeUp = t.drawnUp
		self.gaze = CameraMath.clampGaze(t.heading, self.gazeUp, t.heading)
	else
		self:snap()
	end
	self.onEye(on)
end

function SpiderCamera.toggleEyeView(self: any)
	self:setEyeView(not self.eyeView)
end

-- look(dx, dy) in degrees: dx > 0 looks right, dy > 0 looks down (Godot camera_rig.look). Any look takes the line
-- framing's turn over at once; on the line the framing then stays off until the line ends.
function SpiderCamera.look(self: any, dx: number, dy: number)
	if dx == 0 and dy == 0 then return end
	if self.recenterT >= 0 and math.abs(dx) + math.abs(dy) > 1.5 then self.recenterT = -1 end
	if self.eyeView then
		-- The mouse, the stick and a touch drag all arrive here; lookScale (ROBLOX-20) shrinks them with the field of view.
		local scale = self.lookScale
		self.gaze = CameraMath.lookEye(self.gaze, self.gazeUp, math.rad(dx * scale), math.rad(dy * scale), self:_bodyForward())
		return
	end
	self.yaw += self.framing:playerTurns(self.target().onLine == true)
	self.yaw -= math.rad(dx)
	if self.aiming then
		self.aimPitch = CameraMath.clampAimPitch(self.aimPitch - math.rad(dy), CameraMath.effectiveElevation(self.elevation, self.autoPitch))
	else
		self.elevation = math.clamp(self.elevation + math.rad(dy), math.rad(CameraMath.MIN_ELEVATION_DEG), math.rad(CameraMath.MAX_ELEVATION_DEG))
	end
end

function SpiderCamera.touchLook(self: any, delta: Vector2)
	self:look(delta.X * TOUCH_DEG_PER_PIXEL, delta.Y * TOUCH_DEG_PER_PIXEL)
end

-- One fixed 60 Hz tick: pivot, line framing, auto-pitch and boom (orbit), or the gaze carried with the body (eye view).
function SpiderCamera.tick(self: any, dt: number)
 local wantedScale = math.clamp(self.target().cameraScale or 1,0.5,1.5)
 self.appearanceScale += (wantedScale-self.appearanceScale)*(1-math.exp(-4*dt))
	local t = self.target()
	if self.eyeView then
		local up = SupportMath.rotateToward(self.gazeUp, t.drawnUp, math.rad(CameraMath.EYE_ROLL_DEG_S) * dt)
		if SupportMath.angleTo(up, self.gazeUp) > 1e-6 then
			local axis = self.gazeUp:Cross(up)
			if axis.Magnitude > 1e-9 then
				self.gaze = CameraMath.rotate(self.gaze, axis.Unit, SupportMath.angleTo(self.gazeUp, up))
			end
		end
		self.gazeUp = up
		self.gaze = CameraMath.clampGaze(self.gaze, up, t.heading)
		return
	end
	self.pivotDir = t.drawnUp
	self.pivot = CameraMath.nextLength(self.pivot, self:_cast(t.pos, self.pivotDir * CameraMath.PIVOT_HEIGHT), CameraMath.PIVOT_HEIGHT, CameraMath.RECOVER_SPEED, dt)
	local from = t.pos + self.pivotDir * self.pivot
	if dt > 0 then
		self.yaw += self.framing:tick(t.onLine == true, self.aiming, function(): number return self:_wantedTurn(t) end, dt)
	end
	local yaw = self:viewYaw()
	local wanted = self:_pitchSearch(from, yaw)
	if self.settle > 0 then
		self.settle -= 1
		self.autoPitch = wanted
	else
		self.autoPitch = CameraMath.easeOffset(self.autoPitch, wanted, dt, CameraMath.AUTO_PITCH_IN_SECONDS, CameraMath.AUTO_PITCH_OUT_SECONDS)
	end
	local elev = CameraMath.effectiveElevation(self.elevation, self.autoPitch)
	self.boom = CameraMath.nextLength(self.boom, self:_boomAt(from, yaw, elev), self:viewDistance(), CameraMath.RECOVER_SPEED, if self.settle > 0 then 1 else dt)
end

local function smooth(k: number): number
	return k * k * (3 - 2 * k)
end

-- Every rendered frame: the player's look, recentring and the aim's return, then the camera is placed.
function SpiderCamera.render(self: any, frameDt: number, lookX: number, lookY: number)
	if self.mouse then
		local menu = GuiService.MenuIsOpen
		UIS.MouseBehavior = if menu then Enum.MouseBehavior.Default else Enum.MouseBehavior.LockCenter
		UIS.MouseIconEnabled = menu
		if not menu then
			local m = UIS:GetMouseDelta()
			self:look(m.X * CameraMath.MOUSE_DEG_PER_PIXEL, m.Y * CameraMath.MOUSE_DEG_PER_PIXEL)
		end
	end
	local rate = CameraMath.STICK_DEG_PER_SECOND * frameDt
	self:look(lookX * rate, lookY * rate)
	local t = self.target()
	if self.recenterT >= 0 then
		self.recenterT += frameDt
		local k = smooth(math.clamp(self.recenterT / CameraMath.RECENTER_SECONDS, 0, 1))
		if self.eyeView then
			self.gaze = CameraMath.clampGaze(self.recenterGaze0:Lerp(t.heading, k), self.gazeUp, t.heading)
		else
			local goal = CameraMath.recenterYaw(t.heading, t.drawnUp, self.yaw)
			local d = (goal - self.recenterYaw0 + math.pi) % (2 * math.pi) - math.pi
			self.yaw = self.recenterYaw0 + d * k
			self.elevation = self.recenterElev0 + (math.rad(CameraMath.DEFAULT_ELEVATION_DEG) - self.recenterElev0) * k
		end
		if k >= 1 then self.recenterT = -1 end
	end
	if self.eyeView then
		local body = SupportMath.bodyCFrame(t.pos, self.gazeUp, t.heading)
		local eye = body:PointToWorldSpace(Vector3.new(0, CameraMath.EYE_HEIGHT, -CameraMath.EYE_AHEAD))
		self.camera.CFrame = CFrame.lookAt(eye, eye + self.gaze, self.gazeUp)
		self:_hideBody(true)
		return
	end
	if not self.aiming and self.aimPitch ~= 0 then
		self.aimPitch = CameraMath.easeOffset(self.aimPitch, 0, frameDt, CameraMath.AIM_RETURN_SECONDS, CameraMath.AIM_RETURN_SECONDS)
	end
	local yaw = self:viewYaw()
	local elev = CameraMath.effectiveElevation(self.elevation, self.autoPitch)
	local from = t.pos + self.pivotDir * self.pivot
	-- A flick between ticks: cast again along the direction about to be used; only shortening is taken.
	local length = math.min(self.boom, self:_boomAt(from, yaw, elev))
	self.boom = length
	local orbit = CFrame.new(from) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-elev, 0, 0)
	self.camera.CFrame = orbit * CFrame.new(0, 0, length) * CFrame.Angles(CameraMath.clampAimPitch(self.aimPitch, elev), 0, 0)
	self:_hideBody(length < CameraMath.BODY_HIDE_LENGTH)
end

function SpiderCamera._hideBody(self: any, hidden: boolean)
	if hidden ~= self.bodyHidden then
		self.bodyHidden = hidden
		if self.hide then (self.hide :: (boolean) -> ())(hidden) end
	end
end

-- The aim ray: the camera's centre ray.
function SpiderCamera.aimRay(self: any): (Vector3, Vector3)
	local cf = self.camera.CFrame
	return cf.Position, cf.LookVector
end

-- Walking intent for a stick (x right, y forward) on a surface with normal n, relative to the view on screen.
function SpiderCamera.mapStick(self: any, x: number, y: number, n: Vector3): Vector3
	if self.eyeView then
		return CameraMath.mapStickEye(x, y, self.gaze, self:_bodyForward(), n)
	end
	return CameraMath.mapStick(x, y, self:viewYaw(), CameraMath.effectiveElevation(self.elevation, self.autoPitch), n)
end

return SpiderCamera
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="121">
          <Properties>
            <string name="Name">SpiderClient</string>
            <string name="Source"><![CDATA[--!strict
-- The playable spider. Wires one control scheme (SpiderInput: keyboard and mouse, controller and touch together) to the
-- Godot jump controller's phases (Shared/Movement/JumpInput), the body (Shared/Movement/SpiderMotor: walking on any
-- surface, hops and aimed leaps, the safety line), the camera (SpiderCamera, a port of camera_rig.gd), the drawn spider
-- (SpiderRig) and the screen (SpiderHud, words from Shared/UI/ControlText for the device in use). Ports the frozen Godot
-- game at c87ce00: scripts/core/input_setup.gd, player_controller.gd, jump_controller.gd, tether_controller.gd.
--
-- Controls (README.md has the full table): WASD walk relative to the view, mouse looks, Shift creeps. Tap Space: a short
-- hop. Hold Space (0.15 s): the spider holds still and turns toward the centre dot; the landing patch says Reachable /
-- Blocked / Out of reach / Can't land there; release to leap, Q cancels. F lets down on silk (to the nearest edge first on
-- top of a leaf). On the line W reels in, S lowers and holding Q lets go. V spider-eye view, R recenter, right mouse Focus,
-- T slow motion, H controls card, Backspace back to the start, Esc the Roblox menu (the game waits).
-- The peacock spider (ROBLOX-31): resting in the crack, C (RB / R1, the touch Change button) turns the spider into the other one (the first
-- spider or the peacock spider, Maratus volans); as the peacock spider, standing still, X (RB / R1, Dance) starts its courtship dance and any move,
-- jump or Cancel stops it. The dance is a pose of the drawn rig only; the motor, senses, silk and the rest are the same for both.
-- The naturalist's notebook (ROBLOX-37): N, the Notebook button beside Menu, or "Notebook" in the life menu and on the end screen opens it
-- and the world waits. The book is the player's: it lives here, outside the world and its checkpoints, so a return to a rest never erases a
-- page and a new, unrelated spider opens the same book. NotebookWatch opens pages from the events this loop already has.
-- Saving (ROBLOX-39): the server owns the DataStore. This script only says hello, applies what the server sends back (the notebook, an Easy
-- unlock, the chosen spider, the toggles, the last rests) and sends its own progress and rests up (Client/SaveClient). With no server reply
-- it is the session-only game it was before, and the menu says saving is off.

local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local SpiderInput = require(script.Parent.SpiderInput)
local SpiderCamera = require(script.Parent.SpiderCamera)
local SpiderEyes = require(script.Parent.SpiderEyes)
local SpiderHud = require(script.Parent.SpiderHud)
local CaughtPanel = require(script.Parent.CaughtPanel)
local WorldDetail = require(script.Parent.WorldDetail)
local Soundscape = require(script.Parent.Soundscape)
local OldSkins = require(script.Parent.OldSkins)
local skins = OldSkins.new(Workspace)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Movement = Shared:WaitForChild("Movement")
local SupportMath = require(Movement:WaitForChild("SupportMath"))
local SpiderMotor = require(Movement:WaitForChild("SpiderMotor"))
local JumpInput = require(Movement:WaitForChild("JumpInput"))
local StickCarry = require(Movement:WaitForChild("StickCarry"))
local ControlText = require(Shared:WaitForChild("UI"):WaitForChild("ControlText"))
local Species = require(Shared:WaitForChild("Data"):WaitForChild("Species"))
local Surfaces = require(Shared:WaitForChild("Data"):WaitForChild("Surfaces"))
local Detail = require(Shared:WaitForChild("Data"):WaitForChild("Detail"))
local Layout = require(Shared:WaitForChild("Habitat"):WaitForChild("WindowsillLayout"))
local SpiderRig = require(Shared:WaitForChild("Rig"):WaitForChild("SpiderRig"))

local Sensor = require(Shared.Perception.Sensor)
local ObservationMemory = require(Shared.Perception.ObservationMemory)
local FocusState = require(Shared.Movement.FocusState)
local PerceptionStage = require(script.Parent.PerceptionStage)
local PerceptionHud = require(script.Parent.PerceptionHud)
local PreyDirector = require(Shared.Prey.PreyDirector)
local FlyBodies = require(script.Parent.FlyBodies)
local WaspBody = require(script.Parent.WaspBody)
local NeedsModel = require(Shared.Life.NeedsModel)
local LifeLoop = require(Shared.Life.LifeLoop)
local LifeSession = require(Shared.Life.LifeSession)
local session = LifeSession.new()
local LifeText = require(Shared.UI.LifeText)
local DayLight = require(Shared.Habitat.DayLight)
local LifeClock = require(Shared.Life.LifeClock)
local WaspDirector = require(Shared.Predator.WaspDirector)
local WaspText = require(Shared.UI.WaspText)
local SpiderChoice = require(Shared.Rig.SpiderChoice)
local PeacockDance = require(Shared.Rig.PeacockDance)
local PeacockText = require(Shared.UI.PeacockText)
local NotebookPages = require(Shared.Data.NotebookPages)
local FieldNotebook = require(Shared.Learning.FieldNotebook)
local NotebookWatch = require(Shared.Learning.NotebookWatch)
local NotebookText = require(Shared.UI.NotebookText)
local NotebookPanel = require(script.Parent.NotebookPanel)
local Checkpoint = require(Shared.Persistence.Checkpoint)
local CheckpointStore = require(Shared.Persistence.CheckpointStore)
local SaveRules = require(Shared.Data.SaveRules)
local SaveProgress = require(Shared.Persistence.SaveProgress)
local SaveText = require(Shared.UI.SaveText)
local SaveClient = require(script.Parent.SaveClient)
local focusState = FocusState.new()
local DT = SpiderMotor.DT
local SLOW_SPEED = 0.5
local MAX_DRAGLINES = 24 -- two segments per one-bend line
local WALK_HINT_SECONDS = 60
local PATCH_GROW_FROM = 6 -- studs from the camera; beyond it the patch grows with distance (up to 4x), as in Godot
local COLORS = {
	reachable = Color3.new(0.25, 0.92, 0.38), obstructed = Color3.new(1.0, 0.72, 0.1),
	unreachable = Color3.new(1.0, 0.32, 0.28), ineligible = Color3.new(0.72, 0.45, 1.0), none = Color3.new(0.8, 0.8, 0.8),
}
local WARN_EVENTS = { drop_refused = true, snagged = true, lost = true, blocked = true }

local player = Players.LocalPlayer
-- Solo windowsill: the default player list obscures the life-menu button on small screens.
pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false) end)
local camera = Workspace.CurrentCamera
local sill = Workspace:WaitForChild("Windowsill")
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include
params.FilterDescendantsInstances = { sill }

local arc = Instance.new("Folder")
arc.Name = "JumpArc"
arc.Parent = Workspace
local motor: any = SpiderMotor.new({
	world = sill, surfaces = Surfaces, profile = Species.phidippus_audax_prototype,
	spawn = Layout.SPAWN, heading = Layout.SPAWN_HEADING,
	boundsMin = Layout.PLAY_BOUNDS_MIN, boundsMax = Layout.PLAY_BOUNDS_MAX, probeParent = arc,
})
local jump: any = JumpInput.new()
local carry: any = StickCarry.new()
-- Touch-only devices (phones, tablets) run the low tier until a real tablet frame-time check (ROBLOX_PORT.md): lighter fuzz and
-- no idle extras on the spider, fewer optional parts in the world. Workspace attribute Detail = "low" or "full" overrides the guess.
local detail = Detail.choose(UIS.TouchEnabled and not UIS.KeyboardEnabled, Workspace:GetAttribute("Detail"))
-- Which spider: the Player attribute Appearance (kept for the session), else the Workspace attribute Appearance, else the first spider.
local appearance = SpiderChoice.start(player:GetAttribute("Appearance"), Workspace:GetAttribute("Appearance"))
local rig = SpiderRig.new(Workspace, sill, appearance, detail)
local dance = PeacockDance.new() -- the peacock spider's courtship dance (a pose for the rig; nothing else reads it)
local dancePose: any = nil
local bodyHidden = false
task.spawn(function()
	local roots: { Instance } = { Lighting }
	local decor = Workspace:WaitForChild("Decor", 10)
	if decor then table.insert(roots, decor) end
	local terrain = Workspace:FindFirstChild("Terrain")
	if terrain then table.insert(roots, terrain) end
	WorldDetail.apply(detail, roots)
end)
local hud = SpiderHud.new(player:WaitForChild("PlayerGui"))
local device: ControlText.Device = ControlText.initialDevice(UIS.TouchEnabled, UIS.KeyboardEnabled, UIS.GamepadEnabled)
-- PlayStation or Xbox button names (ControlText.setPadStyle): Roblox names ButtonA "ButtonCross" on a PlayStation controller.
local function refreshPadStyle()
	local ok, text = pcall(function() return UIS:GetStringForKeyCode(Enum.KeyCode.ButtonA) end)
	ControlText.setPadStyle(ControlText.padStyleFor(if ok then text else nil))
end
refreshPadStyle()
local memory = ObservationMemory.new()
local sensor = Sensor.new(memory)
-- The naturalist's notebook (ROBLOX-37): the player's own, never part of the world, a checkpoint or a life. The watcher opens its pages.
local book: any = FieldNotebook.new()
local watch: any = NotebookWatch.new(book)
memory.categoryChanged:connect(function(_contact: any, _old: string, new: string) watch:onCategory(new) end)
sensor:configureFrom(Species.phidippus_audax_prototype.perception)
local sightCast = Sensor.workspaceCast(params)
local perceptionHud = PerceptionHud.new(player:WaitForChild("PlayerGui"))
local stage = if Workspace:GetAttribute("TestTarget") == true or (Workspace:GetAttribute("TestTarget") ~= false and script.Parent:FindFirstChild("SilkPlayback")) then PerceptionStage.new(sill) else nil
local prey = PreyDirector.engine(sill, Species.fly_like_prototype, 914, 4)
local flyBodies = FlyBodies.new(Workspace)
local soundscape = Soundscape.new(Workspace)
local waspBody = WaspBody.new(Workspace)
-- LIFE (ROBLOX-24): the windowsill runs the life clock, so hunger runs by its hours (NeedsModel life mode, Standard rules: the
-- port has no Easy mode yet). Feeding grants into the same model. The loop keeps the rest, sleep, daylight and the eyes' reach.
local needs = NeedsModel.new(true, false)
prey.feeding.needs = needs
local life = LifeLoop.new(needs, nil)
-- The mud dauber wasp (ROBLOX-26): a port of Godot's wasp director (Shared/Predator/WaspDirector). It visits by day from the second day,
-- once the first meal is eaten, and not while the spider rests; it is heard (a caption with its direction) for 8 s before it can look.
-- It reads the sill through the same casts as the senses. In the test place it never comes by itself (Workspace attribute Wasp = true
-- allows it); the attribute WaspForce = a place id ("floor_middle") brings it at once, for Studio and playtests. There is no Gentle
-- mode in Roblox yet, so a catch is always a catch.
local testPlace = script.Parent:FindFirstChild("SilkPlayback") ~= nil
local wasp: any = WaspDirector.new({
	seed = 914, enabled = not testPlace,
	world = {
		ray = function(a: Vector3, b: Vector3): boolean return Workspace:Raycast(a, b - a, params) ~= nil end,
		clear = function(a: Vector3, b: Vector3, radius: number): boolean return Workspace:Spherecast(a, radius, b - a, params) == nil end,
		inRetreat = function(p: Vector3): boolean return Layout.inRetreat(p) end,
	},
})
local waspSpider: WaspDirector.Spider = { position = Vector3.zero, velocity = Vector3.zero, walkSpeed = Species.phidippus_audax_prototype.locomotion.walk_speed_wu_s, airborne = false, falling = false }
local menu: any = nil
local initialRecord: any = nil
local menuStarted = false
local panel: any = nil -- the catch screen, made below once returnToCheckpoint exists
local nbPanel: any = nil -- the notebook, made below with the menus
local saveClient: any = nil -- persistent saves (ROBLOX-39), made below with the menus
-- Whether a modal screen has the game: the world waits and the controls belong to it. At the very start the world also waits (a second or
-- so at most) for the server to say what is saved, so the start menu shows the right choices; not in the test place unless the Workspace attribute SaveWait is true.
local function modal(): boolean
	return panel:isShowing() or menu:isShowing() or nbPanel:isShowing()
		or (not menuStarted and (not testPlace or Workspace:GetAttribute("SaveWait") == true) and saveClient ~= nil and saveClient:waiting() == true)
end
-- S01-C retreat checkpoints (ROBLOX-25): resting in the crack, and each morning, keeps one; Backspace / View returns to it. The
-- store is DataStore-shaped but in memory only: a checkpoint lasts the session. No live DataStore is written.
local checkpointWorld: Checkpoint.World = { motor = motor, prey = prey, sensor = sensor, memory = memory, needs = needs, life = life, wasp = wasp }
local function newStore(): any
	return CheckpointStore.new(CheckpointStore.MemoryDataStore.new(), function(r: any): { string } return (Checkpoint.check(r, checkpointWorld)) end)
end
local stores = {main=newStore(), free=newStore()}
local checkpoints = stores.main
life.save = function(): LifeLoop.CheckpointResult
	local why = Checkpoint.boundaryProblem(checkpointWorld)
	if why ~= "" then return { ok = false, message = why } end
	local record, err = Checkpoint.capture(checkpointWorld, os.time())
	if not record then
		warn("[Windowsill] checkpoint: " .. tostring(err))
		return { ok = false, message = "this moment could not be recorded" }
	end
	local r = checkpoints:save(record)
	if not r.ok then warn("[Windowsill] checkpoint: " .. r.message .. ": " .. table.concat(r.errors, "; ")) end
	if r.ok and saveClient ~= nil then saveClient:sendRest(if checkpoints == stores.free then "free" else "main", record) end
	return { ok = r.ok, message = r.message }
end
local feedPending, cancelPending = false, false -- this frame's presses, for the next fixed tick (Godot's just_pressed)
local lifeSpider: LifeLoop.Spider = { inRetreat = false, attached = true, still = true, holding = false, feeding = false }
local dayClock: number? = nil -- the daytime ClockTime (SunPick's choice, read once from the server's Lighting)
local lastLight: number? = nil
local gripPress = false
local function focusActive(): boolean
	return focusState:active(false, player:GetAttribute("FocusToggle") == true, motor.mode == "attached")
end
local drawnUp = motor.up
local slow = false
local helpVisible, helpUntil = true, os.clock() + 20
local started = os.clock()
local afterMiss, dropped = false, false
local lastFeedback: any = nil

-- ---------------------------------------------------------------- the safety line as drawn (mechanics in SilkController)
local lines = Instance.new("Folder")
lines.Name = "Draglines"
lines.Parent = Workspace
local liveLine: Part? = nil
local bendLine: Part? = nil

local function strand(a: Vector3, b: Vector3, p: Part)
	local len = math.max((b - a).Magnitude, 0.01)
	p.Size = Vector3.new(0.012, 0.012, len)
	p.CFrame = CFrame.lookAt((a + b) * 0.5, b)
end

local function newStrand(): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(236, 232, 214)
	p.Transparency = 0.35
	p:SetAttribute("Born", time())
	p.Parent = lines
	local kids = lines:GetChildren()
	if #kids > MAX_DRAGLINES then kids[1]:Destroy() end
	return p
end

local function beginStrands()
	liveLine = newStrand()
	local bend = newStrand()
	bend.Transparency = 1
	bendLine = bend
end

local function dropStrands(keep: boolean)
	if not keep then
		if liveLine then liveLine:Destroy() end
		if bendLine then bendLine:Destroy() end
	end
	liveLine, bendLine = nil, nil
end

-- ---------------------------------------------------------------- jump preview: arc and landing patch
local dots: { Part } = {}
local function display(p: Part)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Transparency = 1
	p.Parent = arc
end
for i = 1, 28 do
	local d = Instance.new("Part")
	d.Name = "Dot" .. i
	d.Shape = Enum.PartType.Ball
	d.Size = Vector3.one * 0.07
	display(d)
	dots[i] = d
end
local patch = Instance.new("Part")
patch.Name = "LandingPatch"
patch.Shape = Enum.PartType.Cylinder
display(patch)
local ring = Instance.new("Part")
ring.Name = "LandingRing"
ring.Shape = Enum.PartType.Cylinder
display(ring)
local cross = Instance.new("Part")
cross.Name = "BlockedMark"
display(cross)

local function hidePreview()
	for _, d in dots do d.Transparency = 1 end
	patch.Transparency, ring.Transparency, cross.Transparency = 1, 1, 1
end

local function showPlan(plan: any)
	hidePreview()
	if not plan or plan.kind == "none" or not plan.point then return end
	local color = COLORS[plan.kind] or COLORS.none
	-- Beyond 6 studs from the camera the whole patch grows with the distance (up to four times), so it stays readable;
	-- its centre is still the exact landing point.
	local grow = math.clamp((camera.CFrame.Position - plan.point).Magnitude / PATCH_GROW_FROM, 1, 4)
	patch.Size = Vector3.new(0.02, 0.9 * grow, 0.9 * grow)
	ring.Size = Vector3.new(0.012, 1.15 * grow, 1.15 * grow)
	cross.Size = Vector3.new(0.5 * grow, 0.05 * grow, 0.05 * grow)
	local face = CFrame.lookAt(plan.point + plan.normal * 0.012, plan.point + plan.normal * 2) * CFrame.Angles(0, math.pi / 2, 0)
	patch.Color, ring.Color = color, color
	patch.CFrame = face
	ring.CFrame = face * CFrame.new(-0.004, 0, 0)
	patch.Transparency = if plan.kind == "reachable" then 0.55 else 0.75
	ring.Transparency = 0.25
	local path = plan.path
	if path and #path > 1 then
		for i, d in dots do
			local k = math.floor((i - 1) / (#dots - 1) * (#path - 1)) + 1
			d.Position = path[k]
			d.Color = color
			d.Transparency = 0.2
		end
	end
	if plan.blockedAt then
		cross.Color = color
		cross.CFrame = CFrame.lookAt(plan.blockedAt, camera.CFrame.Position) * CFrame.Angles(0, 0, math.rad(45))
		cross.Transparency = 0.1
	end
end

-- ---------------------------------------------------------------- camera and input
local cam: any = SpiderCamera.new(camera, params, function()
	return {
		pos = motor.pos, drawnUp = drawnUp, heading = motor.heading,
		onLine = motor:onLine(), rest = motor:lineRestPoint(), lip = motor:lineLip(),
  cameraScale = (rig._appearance.cameraScale or 1)*math.sqrt(rig._growth),
	}
end, function(on: boolean)
	rig:setEyeView(on)
end)
cam.hide = function(hidden: boolean)
	bodyHidden = hidden
	rig:setBodyHidden(hidden)
end
jump.onAim = function(on: boolean)
	cam:setAiming(on)
end
-- The spider-eye picture (ROBLOX-20): field of view, colour, blur, retina strips, movement rings, UV layer, vignette. Presentation only.
local eyes: any = SpiderEyes.new({ parent = player:WaitForChild("PlayerGui"), camera = camera, player = player, cam = cam, sensor = sensor, params = params })

-- Everything held is dropped with no penalty and no message: focus loss, the Roblox menu, a text box, a lost controller.
local function dropAll()
	dance:stop()
	focusState:clear()
	jump:drop(motor)
	local release = motor.silk.release
	release.down, release.counts, release.held, release.progress = true, false, 0, 0
	motor:cancelWalk()
end

local function backToStart()
	dance:stop()
	focusState:clear()
	sensor:reset()
	memory:clear()
	jump:drop(motor)
	motor:respawn()
	dropStrands(false)
	drawnUp = motor.up
	cam:snap()
end

local controls: any -- bound below (SpiderInput.bind)

-- Choosing the spider (ROBLOX-31): only while resting awake in the silk-lined crack. The drawn rig is built again with the other appearance;
-- the gait, the eye view and the hidden body carry over; the choice is kept in the Player attribute Appearance for the session.
local function canChange(): boolean
	return life.resting and not life.asleep and not life.growth:isMoulting()
end
local appearanceTouched = false -- the player chose a spider this visit (only then is the choice sent to be saved)
local function setAppearance(id: string)
	appearance = id
	player:SetAttribute("Appearance", appearance)
	dance:stop()
	dance = PeacockDance.new()
	dancePose = nil
	local old = rig
	rig = SpiderRig.new(Workspace, sill, appearance, detail)
	rig.gaitMode = old.gaitMode
	rig:setEyeView(cam.eyeView)
	rig:setBodyHidden(bodyHidden)
	old:destroy()
end
local function changeSpider()
	if not canChange() then
		hud:toast(PeacockText.NOT_RESTING, false)
		return
	end
	setAppearance(SpiderChoice.next(appearance))
	appearanceTouched = true
	if saveClient ~= nil then saveClient:markDirty() end
	hud:toast(PeacockText.changed(appearance), false)
end
-- X / RB / the Dance button: start the courtship dance, or end it. On a controller RB in the crack changes spider instead (one button for
-- both, as the crack and the open sill never overlap). Not for the first spider: it has no dance.
local function toggleDance()
	if life.resting then
		if device == "gamepad" and not life.asleep then changeSpider() end
		return
	end
	if not SpiderChoice.canDance(appearance) then return end
	if dance:showing() and dance.active then
		dance:stop()
		return
	end
	local standing = motor.mode == "attached" and not motor.preparing and not motor.seized and not motor:onLine() and not jump:isBusy() and motor.silk.walk == nil
	if not dance:start(standing, motor.moving) then
		hud:toast(PeacockText.STAND, false)
	else
		book:notice("dance")
	end
end

-- Backspace / View: back to the retreat checkpoint (the whole sill as it was), or to the start when there is none yet.
local function returnToCheckpoint()
	local best = checkpoints:loadBest()
	if not best.ok then
		backToStart()
		hud:toast(if best.message == "no checkpoint to return to" then "No checkpoint yet: back to the start. Rest in the silk-lined crack to keep one." else "Back to the start: " .. best.message, true)
		return
	end
	jump:drop(motor)
	dance:stop()
	local ok, problems = Checkpoint.restore(best.record, checkpointWorld)
	if not ok then
		warn("[Windowsill] checkpoint refused: " .. table.concat(problems, "; "))
		hud:toast("The checkpoint could not be used: " .. (problems[1] or "unknown"), true)
		return
	end
	session.mode, session.rules, session.ended = life.mode or "main", life.rules or "standard", false
 motor:setReachFactor(life.growth:reachFactor())
 session:finishAdult(life.growth.stage)
	session.summary = nil
	controls:clear()
	focusState:clear()
	dropStrands(false)
	drawnUp = motor.up
	cam:snap()
	lastLight = nil -- the hour may have changed: set the light again
	feedPending, cancelPending = false, false
	watch:resync() -- the world changed under the watcher: it only takes a fresh look
end

-- Player progress is session-only and outside checkpoints. Modes have independent rest stores.
local function setHudShown(shown: boolean)
 hud.safe.Enabled=shown;hud.centre.Enabled=shown
 local touch=player:WaitForChild("PlayerGui"):FindFirstChild("SpiderTouch")
 if touch and touch:IsA("ScreenGui") then touch.Enabled=shown and UIS.TouchEnabled end
end
local function applyRules()
 life.mode,life.rules=session.mode,session.rules
 needs.gentle=session.rules=="gentle";wasp.gentle=needs.gentle
end
local function closeScreens()
 panel:hide();menu:hide();setHudShown(true);controls:clear();dropAll()
end
local function fresh(mode: string, easy: boolean, position: Vector3?): boolean
 if not initialRecord or (easy and not session.finishedMain) then return false end
 local ok=Checkpoint.restore(initialRecord,checkpointWorld)
 if not ok then return false end
 session:begin(mode,easy);applyRules();motor:setReachFactor(life.growth:reachFactor())
 sensor:reset();memory:clear()
 stores[mode]=newStore();checkpoints=stores[mode]
 life.resting=false;life.notice="";life.noticeSeconds=0;life.restoreGrace=0
 wasp:load(WaspDirector.defaultRecord());wasp.gentle=needs.gentle
 if position then motor:place(position,Vector3.yAxis,Layout.SPAWN_HEADING) end
 closeScreens();dropStrands(false);drawnUp=motor.up;cam:snap();lastLight=nil
 feedPending,cancelPending=false,false
 watch:resync()
 return true
end
local function continueAnother()
 local spot=session:another()
 if not spot then return end
 local mode,easy=session.mode,session.rules=="gentle"
 if fresh(mode,easy,spot) then
  life:showNotice("Another young spider, somewhere new on the sill. It is not related to the last.")
  life.noticeSeconds=12
 end
end
local function summaryRecord(cause: string): any
 return {cause=cause,hours=math.max((life.clock.day-1)*24+life.clock.hour-LifeClock.START_H,0),
  meals=prey.feeding.mealsFinished,wasp_visits=wasp.visits,wasp_escapes=wasp.escapes,stage=life.growth.stage}
end
local openNotebook: (string?) -> ()
local lastEnd: any=nil -- the summary of the life that just ended, while its end screen is up
panel=CaughtPanel.new(player:WaitForChild("PlayerGui"),function(choice: string)
 if choice=="Notebook" then openNotebook("end")
 elseif choice=="Another" then lastEnd=nil;continueAnother()
 elseif choice=="Back" then lastEnd=nil;closeScreens();wasp:clearVisit();returnToCheckpoint() end
end)
local function presentEnd(immediate: boolean)
 local rec=lastEnd
 if not rec then return end
 local cause=rec.cause
 local choices: {CaughtPanel.Choice}={}
 if checkpoints:loadBest().ok then table.insert(choices,{id="Back",text="Back to your last rest"}) end
 table.insert(choices,{id="Another",text="Continue as another spider"})
 table.insert(choices,{id="Notebook",text=NotebookText.MENU_CHOICE})
 panel:showChoices(if cause=="starved" then "The spider starved." else WaspText.LINE,
  if cause=="starved" then "It went too long without food." else WaspText.SUB,
  WaspText.summary(rec.hours,rec.meals,rec.wasp_visits,rec.wasp_escapes),choices,immediate)
 panel:setTextScale(if player:GetAttribute("LargeText")==true then 1.5 else 1)
end
local function endLife(cause: string)
 local rec=summaryRecord(cause)
 if not session:endLife(cause,rec) then return end
 controls:clear();dropAll();setHudShown(false)
 lastEnd=rec
 presentEnd(false)
end
local function showCaught() endLife("wasp") end
local openMenu: () -> ()
local confirming: string?=nil
menu=CaughtPanel.new(player:WaitForChild("PlayerGui"),function(choice: string)
 if choice=="Notebook" then openNotebook("menu");return end
 if choice=="Notes" then player:SetAttribute("NotebookNotes",player:GetAttribute("NotebookNotes")==false);openMenu();return end
 if choice=="Resume" then closeScreens();return end
 if choice=="Continue" then checkpoints=stores.main;closeScreens();returnToCheckpoint();return end
 if choice=="Free" then
  local saved=stores.free:loadBest()
  if saved.ok then checkpoints=stores.free;closeScreens();returnToCheckpoint()
  else fresh("free",false,nil) end
  return
 end
 if choice=="Large" then
  player:SetAttribute("LargeText",player:GetAttribute("LargeText")~=true);openMenu();return
 end
 if choice=="New" or choice=="Easy" then
  if session.started and confirming~=choice then
   confirming=choice
   menu:showChoices("Begin a new life?","This replaces the main life's last rest as soon as the new spider rests.","",
    {{id=choice :: string,text="Begin the new life"},{id="CancelNew",text="Keep this life"}},true)
   return
  end
  confirming=nil;session:archive();fresh("main",choice=="Easy",nil);return
 end
 confirming=nil;openMenu()
end,"SpiderLifeMenu")
-- The start menu's body: the saving line, then the Easy note. Also rewritten in place when the saving status changes under an open menu.
local function menuBody(): string
 return SaveText.menuLine(saveClient:status())..(if session.finishedMain then "" else "\nEasy is not available yet; choose Free play for gentle rules.")
end
openMenu=function()
 if panel:isShowing() or not initialRecord then return end
 controls:clear();dropAll();setHudShown(false)
 local choices: {CaughtPanel.Choice}={}
 if session.started then table.insert(choices,{id="Resume",text="Resume this spider"}) end
 if stores.main:loadBest().ok then table.insert(choices,{id="Continue",text="Continue from last rest"}) end
 table.insert(choices,{id="New",text="Begin a new life"})
 if session.finishedMain then table.insert(choices,{id="Easy",text="Begin a new life on Easy"}) end
 table.insert(choices,{id="Free",text="Free play - gentle rules"})
 table.insert(choices,{id="Notebook",text=NotebookText.MENU_CHOICE})
 table.insert(choices,{id="Notes",text=if player:GetAttribute("NotebookNotes")==false then "Discovery notes: off" else "Discovery notes: on"})
 table.insert(choices,{id="Large",text=if player:GetAttribute("LargeText")==true then "Text size: large" else "Text size: normal"})
 menu:showChoices("The Windowsill","A small life on a windowsill.",
  menuBody(),choices,true)
 menu:setTextScale(if player:GetAttribute("LargeText")==true then 1.5 else 1)
end
local menuButton=Instance.new("TextButton")
menuButton.Name="LifeMenu";menuButton.Text="Menu";menuButton.Size=UDim2.fromOffset(72,36)
menuButton.Position=UDim2.new(1,-84,0,48);menuButton.TextSize=16
menuButton.BackgroundColor3=Color3.new(.12,.12,.14);menuButton.TextColor3=Color3.new(1,1,1)
menuButton.Parent=hud.safe;menuButton.Activated:Connect(openMenu)

-- The naturalist's notebook (ROBLOX-37). Opened from the game (N, the button beside Menu), the life menu or the end screen; closing it
-- goes back to wherever it was opened from. The world waits while it is open (modal()).
local function noteScale(): number
 return if player:GetAttribute("LargeText")==true then NotebookText.LARGE else 1
end
nbPanel=NotebookPanel.new(player:WaitForChild("PlayerGui"),book,function(to: string?)
 if to=="menu" then openMenu()
 elseif to=="end" then presentEnd(true)
 else setHudShown(true) end
end)
openNotebook=function(to: string?)
 if nbPanel:isShowing() then return end
 if to=="menu" then menu:hide()
 elseif to=="end" then panel:hide()
 elseif modal() then return
 else controls:clear();dropAll();setHudShown(false) end
 hud:setNote("",0)
 nbPanel:open(to,device,noteScale())
end
book.pageOpened:connect(function(id: string)
 local page=book:view(id)
 if nbPanel:isShowing() then nbPanel:refresh() end
 if page and player:GetAttribute("NotebookNotes")~=false then hud:setNote(NotebookText.note(page.title,device),NotebookPages.noteSeconds) end
end)
local notebookButton=Instance.new("TextButton")
notebookButton.Name="NotebookButton";notebookButton.Text=NotebookText.BUTTON;notebookButton.Size=UDim2.fromOffset(88,36)
notebookButton.Position=UDim2.new(1,-180,0,48);notebookButton.TextSize=14
notebookButton.BackgroundColor3=Color3.new(.12,.12,.14);notebookButton.TextColor3=Color3.new(1,1,1)
notebookButton.Parent=hud.safe;notebookButton.Activated:Connect(function() openNotebook("game") end)

-- ---------------------------------------------------------------- persistent saves (ROBLOX-39)
-- What this visit changed is sent up (the notebook and an adult life always; the spider and the toggles only if the player changed them, so
-- a late reply can never be overwritten by defaults). What the server sends down is applied once, before the start menu, and again if a
-- retry succeeds later: the notebook and the adult life are only ever added to, the rest of the choices only if the player has not already
-- made their own this visit.
local prefTouched: { [string]: boolean } = {}
local applyingSaved = false
local savedStatus: string? = nil
local savedReason: string? = nil
local lastSig = ""
local lastEye = 0.0
local lastEyeCheck = os.clock()
local function refreshMenu()
	if menuStarted and menu:isShowing() and confirming == nil then openMenu() end
end
local function progressSnapshot(): any
	local prefs: { [string]: boolean? } = {}
	for key in prefTouched do
		local v = player:GetAttribute(key)
		if type(v) == "boolean" then prefs[key] = v end
	end
	return SaveProgress.snapshot(book:toRecord(), session.finishedMain, if appearanceTouched then appearance else nil, prefs)
end
local function adoptRest(mode: string, record: any)
	if record == nil or (mode ~= "main" and mode ~= "free") then return end
	if session.started or stores[mode]:loadBest().ok then return end -- this visit has begun, or already has a rest of its own
	local r = stores[mode]:save(record)
	if not r.ok then warn("[Windowsill] saved " .. mode .. " rest not used: " .. r.message .. ": " .. table.concat(r.errors, "; ")) end
end
local function applySaved(msg: any)
	if type(msg) ~= "table" then return end
	local _, p = SaveProgress.sanitize(msg.progress)
	if p then
		local mine = book:toRecord()
		local ids: { string } = {}
		local seen: { [string]: boolean } = {}
		for _, list in { mine.opened, p.notebook.opened } do
			for _, id in list do
				if not seen[id] then seen[id] = true; table.insert(ids, id) end
			end
		end
		book:load({ opened = ids, eye_seconds = math.max(mine.eye_seconds, p.notebook.eye_seconds) })
		if p.finished_main then session.finishedMain = true end
		applyingSaved = true
		for key, v in p.prefs do
			if not prefTouched[key] then player:SetAttribute(key, v) end
		end
		applyingSaved = false
		if p.appearance ~= nil and not appearanceTouched and p.appearance ~= appearance and SpiderChoice.start(p.appearance, nil) == p.appearance then
			setAppearance(p.appearance)
		end
	end
	if type(msg.rests) == "table" then
		adoptRest("main", msg.rests.main)
		adoptRest("free", msg.rests.free)
	end
	lastSig = `{#book.opened}:{session.finishedMain}`
	lastEye = book.eyeSeconds
	if nbPanel:isShowing() then nbPanel:refresh() end
	refreshMenu()
end
saveClient = SaveClient.new({
	rules = SaveRules, now = os.clock,
	findRemotes = function(): any
		local folder = ReplicatedStorage:FindFirstChild(SaveRules.REMOTES_NAME)
		if folder == nil then return nil end
		local toServer, toClient = folder:FindFirstChild("ToServer"), folder:FindFirstChild("ToClient")
		if toServer == nil or toClient == nil then return nil end
		return { server = toServer, client = toClient }
	end,
	onLoaded = applySaved,
	onRest = function(mode: string, record: any) adoptRest(mode, record) end,
	onStatus = function(_status: string, _reason: string?) end, -- (the status is read each frame below)
	build = progressSnapshot,
})
lastSig = `{#book.opened}:{session.finishedMain}`
for _, key in SaveRules.PREF_KEYS do
	player:GetAttributeChangedSignal(key):Connect(function()
		if applyingSaved then return end
		prefTouched[key] = true
		saveClient:markDirty()
	end)
end
-- Each frame: the connection, what changed, and the status (a toast when it changes, a fresh menu line).
local function updateSaves()
	saveClient:update()
	local sig = `{#book.opened}:{session.finishedMain}`
	if sig ~= lastSig then
		lastSig = sig
		saveClient:markDirty()
	end
	local t = os.clock()
	if t - lastEyeCheck >= SaveRules.CLIENT_EYE_GAP then
		lastEyeCheck = t
		if book.eyeSeconds ~= lastEye then
			lastEye = book.eyeSeconds
			saveClient:markDirty()
		end
	end
	local status, reason = saveClient:status()
	if status ~= nil and (status ~= savedStatus or reason ~= savedReason) then
		local text = SaveText.toast(savedStatus, savedReason, status, reason)
		savedStatus, savedReason = status, reason
		if text ~= "" then hud:toast(text, status == "session") end
		if menuStarted and menu:isShowing() and confirming == nil then menu.summary.Text = menuBody() end
	end
end

controls = SpiderInput.bind({
	blocked = modal,
	menu = function() if nbPanel:isShowing() then nbPanel:close() elseif menu:isShowing() and session.started then closeScreens() else openMenu() end end,
	notebook = function() openNotebook("game") end,
	focus = function(phase: string)
		if phase == "begin" then focusState:press(player:GetAttribute("FocusToggle") == true, motor.mode == "attached")
		elseif phase == "cancel" then focusState:clear() end
	end,
	choose = function() changeSpider() end,
	display = function() toggleDance() end,
	feed = function()
		dance:stop()
		prey.feeding:press()
		feedPending = true -- in the crack, with nothing to eat, the same button rests (Godot's interact)
	end,
	jump = function(phase: string)
  if life.growth:isMoulting() then return end
		if phase == "begin" and prey.feeding.struggling then prey.feeding:press(); gripPress=true; return end
		if gripPress then if phase ~= "begin" then gripPress=false end; return end
		if phase == "begin" then
			dance:stop() -- a jump (a hop or an aim) ends the dance
			motor:cancelWalk() -- a jump press takes over from a walk to the edge
			jump:press()
		elseif phase == "end" then
			jump:release()
		else
			jump:cancel()
		end
	end,
	-- Q / B / touch Cancel (Let go on the line): the same button cancels an aim, stops a walk to the edge (and is nothing
	-- else's then) and, held on the line, lets go; SilkController counts only a fresh press after the 0.4 s grace, held 0.6 s.
	cancel = function(phase: string)
		if phase ~= "begin" then return end
		dance:stop()
		cancelPending = true -- also ends a rest
		prey.feeding:cancel()
		if motor:cancelWalk() then return end
		focusState:cancel(jump:isBusy() or #jump.events > 0 or motor:onLine())
		jump:cancel()
	end,
	drop = function() if life.growth:isMoulting() then return end; dance:stop(); motor:requestDrop() end,
	clear = dropAll,
	reset = function() if not panel:isShowing() then returnToCheckpoint() end end, -- the catch screen has its own way back
	gait = function() rig.gaitMode = if rig.gaitMode == "Tetrapod" then "Unilateral" else "Tetrapod" end,
	eye = function() cam:toggleEyeView() end,
	recenter = function() cam:startRecenter() end,
	slow = function() slow = not slow end,
	touchLook = function(delta: Vector2) cam:touchLook(delta) end,
	help = function()
		helpVisible = not helpVisible
		helpUntil = math.huge
	end,
	device = function(name: string)
		device = ControlText.deviceFor(name, device)
		if device == "gamepad" then refreshPadStyle() end
		nbPanel:setDevice(device)
	end,
})

-- One fixed tick's intent from the controls, for the motor.
local function tickInput(): any
 if life.growth:isMoulting() then return SpiderMotor.idleInput() end
	local r, f = controls:axes()
	local wish = Vector3.zero
	if r ~= 0 or f ~= 0 then
		-- Over a sharp edge the stick keeps carrying the spider the way it was going (Godot's carry), so holding forward
		-- never walks it straight back when the camera's idea of forward flips from floor to wall.
		local d = carry:step(r, f, cam:mapStick(r, f, motor.up), motor.transitionSerial, motor.intent, false)
		if d.Magnitude > 1e-6 then wish = d.Unit end
	else
		carry:step(0, 0, Vector3.zero, motor.transitionSerial, motor.intent, false)
	end
	local focusPoint: Vector3? = nil
	if focusState:active(controls.held.Focus == true, player:GetAttribute("FocusToggle") == true, motor.mode == "attached") then
		local origin, dir = cam:aimRay()
		local hit = Workspace:Raycast(origin, dir * SpiderMotor.AIM_RANGE, params)
		focusPoint = if hit then hit.Position else origin + dir * SpiderMotor.AIM_RANGE
	end
	return {
		wish = wish, creep = controls.held.Creep == true, reel = f,
		dropHeld = controls.held.Drop == true, releaseHeld = controls.held.Cancel == true,
		focusPoint = focusPoint, gaze = if cam.eyeView then cam.gaze else nil,
	}
end

-- ---------------------------------------------------------------- the screen
local function handleEvents()
	for _, e in motor:drainEvents() do
		local kind = if e.kind == "landed" then "completed" else e.kind
		if kind == "locked" then afterMiss = true elseif kind == "dropped" then dropped = true end
		if kind == "anchored" or kind == "dropped" then beginStrands() end
		if kind == "completed" then dropStrands(true) end
		if kind == "released" or kind == "lost" or kind == "out_of_bounds" then dropStrands(false) end
		if kind == "out_of_bounds" then
			hud:toast(ControlText.toast("out_of_bounds", nil), true)
			drawnUp = motor.up
			cam:snap()
		else
			hud:toast(ControlText.lineToast(kind, e.detail, afterMiss, dropped, device), WARN_EVENTS[kind] == true)
		end
		if kind == "completed" or kind == "released" or kind == "lost" or kind == "anchored" then
			afterMiss, dropped = false, false
		end
	end
	local last = jump.last
	if last and last ~= lastFeedback then
		lastFeedback = last
		if last.kind == "launched" and last.plan and last.plan.point and last.plan.origin then
			watch:onJump((last.plan.point - last.plan.origin).Magnitude) -- a committed leap, from take-off to the landing point
		end
		hud:toast(ControlText.toast(last.kind, last.plan), last.kind ~= "cancelled")
	end
end

local function updateHud(frameDt: number)
	handleEvents()
	local aiming = jump:isAiming()
	local view: any = {
		device = device, aiming = aiming, focus = controls.held.Focus == true or focusActive(), eyeView = cam.eyeView,
		status = {}, helpVisible = helpVisible, helpText = ControlText.helpCard(device) .. PeacockText.helpExtra(device, SpiderChoice.canDance(appearance)),
		caption = eyes:captionView(device),
	}
	local rumble = if dancePose then PeacockText.caption(dancePose.rumble) else nil -- felt through the feet; the wasp's hum below takes precedence
	if rumble then view.caption = rumble end
	if wasp:isVisiting() then
		local direction = WaspText.directionWord(motor.pos, motor.heading, motor.up, wasp.wasp.position)
		local heard = WaspText.caption(wasp.phase, wasp.phaseS, direction)
		if heard then view.caption = heard end
	end
	if aiming then
		local plan = jump.plan
		local title, hint = ControlText.describe(plan, device)
		view.aimTitle, view.aimHint = title, hint
		view.aimColor = COLORS[if plan then plan.kind else "none"] or COLORS.none
		local reason = motor:anchorPreview(plan)
		view.anchorText, view.anchorOk = ControlText.anchorText(reason), reason == "ok"
		showPlan(plan)
	elseif jump.flash then
		showPlan(jump.flash)
	else
		hidePreview()
	end
	local waspLine = WaspText.line(wasp.phase, wasp.confusedS > 0, wasp.visits, wasp.sparedThisVisit, device)
	if waspLine then table.insert(view.status, waspLine) end
	view.grip = if prey.feeding.struggling then prey.feeding.grip else nil
	if prey.feeding.struggling then
		table.insert(view.status, "Caught — tap " .. ControlText.name(device,"jump") .. " to keep your grip")
	elseif prey.feeding.feeding then table.insert(view.status, "Feeding — move to stop")
	elseif prey.feeding.held then table.insert(view.status, "Meal paused — " .. ControlText.name(device,"feed") .. " to eat") end
	local clock = life.clock
	view.day = LifeText.day(clock.day, clock:partOfDay()) .. " | " .. life.growth:stageName() .. (if session.mode=="free" then " | FREE PLAY" elseif session.rules=="gentle" then " | EASY" else "")
	view.dayLine = LifeText.line(clock:partOfDay(), needs.energy, needs:isStarving(), needs.gentle, LifeLoop.HUNGRY_AT, life:tooHungryToSleep())
 if life.growth.ready then view.dayLine="Ready to moult: rest in the silk-lined crack."
 elseif life.growth:isSoft() then view.dayLine="Soft new skin: shorter jumps until it hardens." end
 view.notice = if life.noticeSeconds > 0 and life.notice ~= "" then life.notice else nil
	local canRest = life:canRest(lifeSpider)
	local restPrompt = LifeText.prompt(life.asleep, life.resting, canRest, clock:isSleepTime() and not life:tooHungryToSleep(), device, PeacockText.change(device, appearance))
 if life.growth:isMoulting() then
  restPrompt={title="Moulting in the silk-lined crack",hint="The spider pulls free of its old skin. Wait here while the hours pass."}
 elseif life.growth.ready and canRest and not life.resting then
  restPrompt={title="Ready to moult",hint=ControlText.name(device,"feed")..": rest and moult in the crack"}
 end
 if not restPrompt and (motor.pos-Vector3.new(-24,1,6)).Magnitude<7 and not prey.feeding.held then
  restPrompt={title="Home: the silk-lined crack",hint=if lifeSpider.inRetreat then "Keep still on a surface, then "..ControlText.name(device,"feed")..": rest" else "Walk through the silk-framed opening under the wooden roof, then stop to rest."}
 end
 local canDance = SpiderChoice.canDance(appearance)
	if restPrompt and not lifeSpider.inRetreat and canDance then restPrompt.hint ..= "    " .. PeacockText.displayHint(device,dance.active) end
	if canDance and dance.active then table.insert(view.status, PeacockText.dancingLine(device)) end
	if focusState.latched then table.insert(view.status, "FOCUS ON    " .. ControlText.name(device,"focus") .. " again to stop" .. (if not jump:isBusy() and not motor:onLine() and not motor.silk.walk then " / " .. ControlText.name(device,"cancel") else "")) end
	if cam.eyeView then table.insert(view.status, `SPIDER-EYE VIEW    {ControlText.name(device, "eye")}: back`) end
	if slow then
		local key = ControlText.name(device, "slow")
		table.insert(view.status, `SLOW MOTION {math.floor(SLOW_SPEED * 100)}%` .. (if key ~= "" then `    {key}: normal speed` else ""))
	end
	local silk = motor.silk
	local onLine = motor:onLine()
	if onLine then
		local _, f = controls:axes()
		local title, hint, cue = ControlText.linePanel({
			reeling = f > 0.2 and silk.block == "" and not silk.snagged,
			progress = silk.release.progress, snagged = silk.snagged, block = silk.block,
		}, device)
		view.prompt = { title = title, hint = hint, cue = cue }
	elseif silk.walk then
		view.prompt = { hint = ControlText.edgeWalkHint(device) }
	elseif restPrompt and not aiming then
		view.prompt = { title = restPrompt.title, hint = restPrompt.hint }
	elseif motor.mode == "attached" and not aiming and (helpVisible or os.clock() - started < WALK_HINT_SECONDS) then
		view.prompt = { hint = ControlText.walkHint(device) .. (if canDance then "    " .. PeacockText.displayHint(device, dance.active) else "") }
	end
	if os.clock() > helpUntil and helpVisible then helpVisible = false end
	local restLabel = LifeText.touchLabel(life.asleep, life.resting, canRest, clock:isSleepTime() and not life:tooHungryToSleep())
	controls:setTouchVisible("Feed", (prey.feeding.held ~= nil or restLabel ~= nil) and not life.growth:isMoulting())
	controls:setTouchLabel("Feed", if prey.feeding.held ~= nil then "Eat" else restLabel or "Eat")
	controls:setTouchLabel("Jump", if prey.feeding.struggling then "Grip" else "Jump")
	controls:setTouchLabel("Cancel", ControlText.touchCancelLabel(onLine))
	controls:setTouchVisible("Jump", not onLine)
	controls:setTouchVisible("Creep", not onLine)
	-- The peacock spider's buttons: Change in the crack, Dance on the open sill (the peacock spider only).
	controls:setTouchVisible("Choose", canChange())
	controls:setTouchVisible("Display", canDance and not onLine and not life.resting and motor.mode == "attached")
	controls:setTouchLabel("Display", PeacockText.touchDisplay(dance.active))
	hud:update(view, frameDt)
end

-- ---------------------------------------------------------------- the frame
local accumulator = 0
RunService:BindToRenderStep("SpiderSim", Enum.RenderPriority.Camera.Value + 1, function(frameDt: number)
	updateSaves()
	if panel:isShowing() then panel:update(frameDt) end
	if nbPanel:isShowing() then nbPanel:update(frameDt) end
	if GuiService.MenuIsOpen or modal() then
		accumulator = 0 -- the Roblox menu is Godot's pause (so is the catch screen): the world waits
	else
		local simDt = frameDt * (if slow then SLOW_SPEED else 1)
		accumulator = math.min(accumulator + simDt, 0.25)
		local origin, dir = cam:aimRay()
		motor:setAimRay(origin, dir)
		while accumulator >= DT do
			accumulator -= DT
			local percepts = prey:percepts()
			if stage then
				local p = stage.target:percept()
				if p then table.insert(percepts,p) end
			end
			local waspPercept = wasp:percept() -- movement to the spider's senses, never prey
			if waspPercept then table.insert(percepts, waspPercept) end
			sensor:step(DT,motor:observer(),percepts,sightCast)
			prey:before(DT,motor.pos,motor:observer(),sensor,sightCast,camera)
			if life.growth:isMoulting() then jump:drop(motor);motor:cancelWalk() else jump:step(motor) end
			local input = tickInput()
			motor:tick(input)
			-- The wasp runs after the spider has moved and before feeding (Godot: physics priority 8).
			wasp.enabled = not testPlace or Workspace:GetAttribute("Wasp") == true
			local forced = if testPlace then Workspace:GetAttribute("WaspForce") else nil
			if typeof(forced) == "string" and forced ~= "" then
				Workspace:SetAttribute("WaspForce", nil)
				wasp:force(life.clock.day, forced)
			end
			local fallingOnLine = motor:onLine() or (motor.mode == "air" and motor.dropped == true)
			waspSpider.position, waspSpider.velocity = motor.pos, motor.vel
			waspSpider.falling = fallingOnLine
			waspSpider.airborne = motor.mode == "air" and not fallingOnLine and not motor.seized
			wasp:step(DT, waspSpider, {
				day = life.clock.day, hour = life.clock.hour, resting = life.resting, moulting = life.growth:isMoulting(), meals = prey.feeding.mealsFinished,
			})
			for _, signal in wasp:drainSignals() do
				watch:onWasp(signal.kind, signal.escaped)
				if signal.kind == "caught" then
					-- Stung: the spider lets go of everything and is carried (Godot SpiderMotor.seize).
					motor:seize()
					dropAll()
					dropStrands(false)
				elseif signal.kind == "carried_off" then
					showCaught()
				end
			end
			if wasp.heldAt then motor:hold(wasp.heldAt) end
			prey.feeding.auto = player:GetAttribute("AutomaticGrip") == true
			prey:after(DT,motor,sensor,sightCast)
			-- The life loop runs last in the tick (Godot's habitat loop, priority 12); the reach it sets is the next tick's.
			local holding = prey.feeding.held ~= nil
			lifeSpider = {
				inRetreat = Layout.inRetreat(motor.pos), attached = motor.mode == "attached" and not motor.preparing,
				still = input.wish.Magnitude < 0.01 and motor.vel.Magnitude < 0.15,
				holding = holding, feeding = holding and prey.feeding.feeding, position = motor.pos,
			}
			life:step(DT, lifeSpider, feedPending, cancelPending)
			feedPending, cancelPending = false, false
			sensor.core.rangeScale = life.rangeScale
			motor:setReachFactor(life.growth:reachFactor())
   for _,event in life:drainEvents() do
    watch:onLife(event.kind,life.growth.stage)
    if event.kind=="starved" then endLife("starved")
    elseif event.kind=="moult_started" then dropAll()
    elseif event.kind=="moulted" and session:finishAdult(life.growth.stage) then
     life:showNotice("Your spider is an adult! Easy is now available in the life menu for this session.")
     life.noticeSeconds=12
    end
   end
            if not initialRecord and Checkpoint.boundaryProblem(checkpointWorld)=="" then
             initialRecord=Checkpoint.capture(checkpointWorld,0)
             if initialRecord and not menuStarted then
              menuStarted=true
              if not testPlace then openMenu() else session.started=true end
             end
            end
            watch:step({
             started=session.started,captures=prey.captures,feeding=prey.feeding.feeding,taken=prey.feeding.taken,
             energy=needs.energy,gentle=needs.gentle,spider=motor.pos,flies=prey.flies,
            })
            if modal() then accumulator=0;break end
			if motor.mode ~= "attached" then focusState:clear() end
			if stage then stage.target:step(DT); stage.marker.Position = stage.target.position end
			cam:tick(DT)
		end
	end
	-- The light of the hour (DayLight; the eyes' reach comes from the clock, not from this). The daytime sun is the one the
	-- server picked, read once it has arrived (or after a few seconds without it).
	if dayClock == nil and (Lighting:GetAttribute("SunPick") ~= nil or os.clock() - started > 5) then dayClock = Lighting.ClockTime end
	local dc = dayClock
	if dc and DayLight.due(lastLight, life.daylight) then
		DayLight.apply(Lighting, DayLight.targets(life.daylight, dc), Workspace:FindFirstChild("Decor"))
		lastLight = life.daylight
	end
	-- Drawn frame: the up vector eases so walls and edges do not snap.
	local simFrame = frameDt * (if slow then SLOW_SPEED else 1)
	drawnUp = drawnUp:Lerp(motor.up, 1 - math.exp(-24 * simFrame)).Unit
	local body = SupportMath.bodyCFrame(motor.pos, drawnUp, motor.heading)
	-- The peacock spider's dance: a pose for the rig, stepped with the simulation's time (slow motion slows it, a menu or the catch screen
	-- holds it). Standing still on a surface; any walking intent, jump, line or rest ends it at once.
	if SpiderChoice.canDance(appearance) then
		dance.reduced = player:GetAttribute("ReducedMotion") == true
		local r, f = controls:axes()
		local standing = motor.mode == "attached" and not motor.preparing and not motor.seized and not motor:onLine() and not life.resting
		local paused = GuiService.MenuIsOpen or modal()
		dancePose = dance:step(if paused then 0 else simFrame, standing, motor.moving or r ~= 0 or f ~= 0)
		rig.dance = if dance:showing() then dancePose else nil
	else
		dancePose = nil
		rig.dance = nil
	end
 rig.reducedMotion=player:GetAttribute("ReducedMotion")==true
 rig:setGrowthStage(life.growth.stage)
 rig:setSoftness(life.growth:softness())
 rig:setCondition(needs.energy)
 local paused=GuiService.MenuIsOpen or modal()
 rig:update(body, if paused then 0 else simFrame, motor.mode == "attached", motor.moving)
 skins:draw(life.growth.exuviae)
 if not paused then watch:frame(simFrame,cam.eyeView,eyes.moversShown) end
	updateHud(frameDt)
	flyBodies:draw(prey.flies,prey.now)
	local soundPaused = GuiService.MenuIsOpen or modal()
	local soundSpeed = if slow then SLOW_SPEED else 1
	local soundMuted = player:GetAttribute("SoundMuted") == true
	soundscape:update(frameDt, prey, life.daylight, soundPaused, soundSpeed, soundMuted)
	soundscape:updateWasp(wasp, soundPaused, soundSpeed, soundMuted)
	waspBody:draw(wasp.wasp, prey.now)
	local silk = motor.silk
	local live, bend = liveLine, bendLine
	if live and bend and silk.mode ~= "none" then
		local tip = rig:spinneretPoint(body)
		strand(silk.anchor, silk.bend or tip, live)
		live.Transparency = 0.35
		if silk.bend then
			strand(silk.bend, tip, bend)
			bend.Transparency = 0.35
		else
			bend.Transparency = 1
		end
	end
	for _, line in lines:GetChildren() do
		if line ~= liveLine and line ~= bendLine and line:IsA("BasePart") then
			local born = line:GetAttribute("Born")
			local age = time() - (if typeof(born) == "number" then born else time())
			if age > 25 then line:Destroy() else line.Transparency = math.max(line.Transparency, 0.35 + 0.65 * age / 25) end
		end
	end
	-- Looking runs in real time, so slow motion never makes the camera sluggish.
	local lx, ly = controls:lookAxes()
	if not modal() then cam:render(frameDt, lx, ly) end
	-- The Focus that feeds the perception HUD also decides how far the principal eyes are in use (the eye view's picture). The
	-- picture sets the field of view, so it comes before the HUD projects anything.
	local focusing = motor.mode == "attached" and (controls.held.Focus == true or focusActive())
	eyes:update(frameDt, focusing)
	perceptionHud:draw(memory,camera,sightCast,focusing,player:GetAttribute("ShowLastSeen") ~= false)
	-- Depth of field: on the spider in third person; in the eye view SpiderEyes owns it and focuses on what is looked at.
	local dof = Lighting:FindFirstChild("MacroDOF")
	if not cam.eyeView and dof and dof:IsA("DepthOfFieldEffect") then
		dof.FocusDistance = (camera.CFrame.Position - motor.pos).Magnitude
	end
end)

-- The test-place-only module exercises this controller in Studio. Absent from the playable build.
local playback = script.Parent:FindFirstChild("SilkPlayback")
if RunService:IsStudio() and playback and playback:IsA("ModuleScript") then
	task.spawn(function()
		local run: any = (require :: any)(playback)
		run({
			prey = prey, flyBodies = flyBodies, waspBody = waspBody, life = life, wasp = wasp, caughtPanel = panel, needs = needs, checkpoints = checkpoints, returnToCheckpoint = function() returnToCheckpoint() end, lifeSpider = function() return lifeSpider end, sensor = sensor, memory = memory, focusState = focusState, perceptionHud = perceptionHud, stage = stage,
			input = controls,
			notebook = book, notebookWatch = watch, notebookPanel = nbPanel, openNotebook = openNotebook,
			session=session, menu=menu, openMenu=openMenu, endLife=endLife, fresh=fresh, continueAnother=continueAnother, currentStore=function() return checkpoints end,
			changeSpider = function() changeSpider() end, dance = function() return dance end, appearance = function() return appearance end, rig = function() return rig end,
			drop = function() motor:requestDrop() end,
			jump = jump,
			motor = motor,
			camera = cam,
			sill = sill,
			setDevice = function(name: ControlText.Device) device = name end,
			place = function(position: Vector3)
				controls:clear()
				jump:drop(motor)
				motor:place(position, Vector3.yAxis, Vector3.zAxis)
				dropStrands(false)
				drawnUp = motor.up
				cam:snap()
			end,
			get = function()
				return { mode = motor.mode, line = motor.silk.mode, taut = motor.silk.taut, position = motor.pos, walking = motor.silk.walk ~= nil }
			end,
		})
	end)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="122">
          <Properties>
            <string name="Name">SpiderEyes</string>
            <string name="Source"><![CDATA[--!strict
-- The spider-eye picture (ROBLOX-20): what the eye view looks like, drawn on this client from the pure rules of Shared/UI/EyeOptics
-- and the numbers, with the science and its citations, of Shared/Data/Eyes. Two ways of seeing, blended by k:
--   k = 0, the side eyes: wide (90 degrees), soft, nearly one colour (green), a little blurred, loosely focused, and they catch
--     movement (a ring where the sensor's sight-line checks found something moving, an arc at the edge when it is out of view);
--   k = 1, the principal eyes (Focus held, or toggled on): a narrow telephoto view (24 degrees), sharp, in green and ultraviolet,
--     only the looked-at distance in focus (depth from defocus), the UV layer of the decor showing.
-- Two retina strips at their true angular size scan the view, a vignette darkens the edges and a caption explains the first time.
-- Each frame in the eye view, after the camera is placed (SpiderCamera.render) and before the perception HUD draws: the camera's
-- field of view and SpiderCamera.lookScale, the colour grade and blur (ColorCorrectionEffect EyeGrade and BlurEffect EyeBlur in
-- Lighting), the depth of field (MacroDOF, if the world has one: this module owns it in the eye view and puts back what it
-- borrowed), the overlay (a ScreenGui under the HUD), and the transparency of the UV layer's parts. Outside the eye view it draws
-- nothing and has put everything back; the camera's field of view then belongs to SpiderCamera again.
-- Presentation only: it reads the sensor's motionSeen (never a fly), the camera and the player's attributes (ReducedMotion,
-- FocusToggle) and moves nothing in the game: the senses, the motor, the jump planner, the aim ray and where the camera stands
-- are as they were.
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Eyes = require(Shared.Data.Eyes)
local EyeOptics = require(Shared.UI.EyeOptics)
local ControlText = require(Shared.UI.ControlText)
local Sensor = require(Shared.Perception.Sensor)

local SpiderEyes = {}
SpiderEyes.__index = SpiderEyes

export type Options = {
	parent: Instance, -- the PlayerGui the overlay goes in
	camera: Camera,
	player: Player,
	cam: any, -- SpiderCamera: eyeView, aimRay(), lookScale
	sensor: any, -- Sensor: motionSeen, lastEye, core.tick
	params: RaycastParams, -- world-only casts (the sill), as the sensor's
}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function sequence(points: { { number } }): NumberSequence
	local keys: { NumberSequenceKeypoint } = {}
	for _, p in points do
		table.insert(keys, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return NumberSequence.new(keys)
end

-- A transparent frame centred on its position.
local function box(name: string, parent: Instance, zIndex: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.ZIndex = zIndex
	f.Visible = false
	f.Parent = parent
	return f
end

local function round(f: GuiObject)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
end

local function outline(f: GuiObject, color: Color3, thickness: number): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = f
	return s
end

local function gradient(f: Instance, rotation: number, points: { { number } }): UIGradient
	local g = Instance.new("UIGradient")
	g.Rotation = rotation
	g.Transparency = sequence(points)
	g.Parent = f
	return g
end

local function vignetteEdge(parent: Instance, name: string, anchor: Vector2, position: UDim2, size: UDim2, rotation: number): Frame
	local f = box("Vignette" .. name, parent, 1)
	f.AnchorPoint = anchor
	f.Position = position
	f.Size = size
	f.BackgroundColor3 = rgb(Eyes.vignette.color)
	f.BackgroundTransparency = 1 - Eyes.side.vignette
	f.Visible = true
	gradient(f, rotation, Eyes.vignette.ramp)
	return f
end

function SpiderEyes.new(o: Options): any
	local gui = Instance.new("ScreenGui")
	gui.Name = Eyes.overlay.name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true -- the middle of this screen is the middle of the camera's view, where the aim ray goes
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.DisplayOrder = Eyes.overlay.displayOrder
	gui.Enabled = false
	gui.Parent = o.parent

	-- The telephoto vignette: four edge frames, darkest at the screen's edge. The gradient's start is the edge.
	local V = Eyes.vignette
	local vignette: { Frame } = {
		vignetteEdge(gui, "Top", Vector2.new(0.5, 0), UDim2.fromScale(0.5, 0), UDim2.fromScale(1, V.topBottom), 90),
		vignetteEdge(gui, "Bottom", Vector2.new(0.5, 1), UDim2.fromScale(0.5, 1), UDim2.fromScale(1, V.topBottom), -90),
		vignetteEdge(gui, "Left", Vector2.new(0, 0.5), UDim2.fromScale(0, 0.5), UDim2.fromScale(V.leftRight, 1), 0),
		vignetteEdge(gui, "Right", Vector2.new(1, 0.5), UDim2.fromScale(1, 0.5), UDim2.fromScale(V.leftRight, 1), 180),
	}

	-- The two retina strips: a faint filled capsule with a thin outline, each with a fill that fades toward its ends.
	local R = Eyes.retina
	local strips: { { frame: Frame, stroke: UIStroke } } = {}
	for i = 1, 2 do
		local f = box("Retina" .. i, gui, 2)
		f.BackgroundColor3 = rgb(R.fillColor)
		f.BackgroundTransparency = Eyes.side.fillTransparency
		round(f)
		gradient(f, 90, R.fillRamp)
		strips[i] = { frame = f, stroke = outline(f, rgb(R.strokeColor), R.strokeThickness) }
	end

	local effects = Eyes.effects
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = effects.grade
	grade.Enabled = false
	grade.Parent = Lighting
	local blur = Instance.new("BlurEffect")
	blur.Name = effects.blur
	blur.Size = 0
	blur.Enabled = false
	blur.Parent = Lighting

	return setmetatable({
		camera = o.camera, player = o.player, cam = o.cam, sensor = o.sensor, params = o.params,
		gui = gui, vignette = vignette, vignetteShown = -1, strips = strips,
		rings = {} :: { any }, arcs = {} :: { any },
		grade = grade, blur = blur,
		on = false,
		phase = 0, k = 0, clock = 0,
		focusDistance = nil :: number?,
		dofSaved = nil :: any,
		uv = { folder = nil :: Instance?, parts = {} :: { any }, wait = 0, scan = true },
		captionAge = 0,
		moversShown = 0, -- how many movement rings and edge arcs the last frame drew (the notebook's "shimmer" reads it)
	}, SpiderEyes)
end

-- ---------------------------------------------------------------- entering and leaving the eye view
function SpiderEyes._enter(self: any)
	self.on = true
	self.phase, self.k = 0, 0
	self.focusDistance = nil
	self.gui.Enabled = true
	self.grade.Enabled = true
	self.uv.scan = true
end

function SpiderEyes._leave(self: any)
	self.on = false
	self.phase, self.k = 0, 0
	self.gui.Enabled = false
	self.grade.Enabled = false
	self.blur.Enabled = false
	self.cam.lookScale = 1
	self:_restoreDepthOfField()
	self:_setUv(0)
	self:_hideMovers(0, 0)
	self.moversShown = 0
end

-- Puts the world's depth of field back as the third person had it.
function SpiderEyes._restoreDepthOfField(self: any)
	local saved = self.dofSaved
	self.dofSaved = nil
	if saved ~= nil and saved.effect.Parent ~= nil then
		saved.effect.FarIntensity = saved.far
		saved.effect.NearIntensity = saved.near
		saved.effect.InFocusRadius = saved.radius
	end
end

-- ---------------------------------------------------------------- depth of field
-- The world's own MacroDOF, if there is one (the low tier has none): in the eye view its sharp zone follows what is looked at.
function SpiderEyes._depthOfField(self: any, p: EyeOptics.Profile)
	local dof = Lighting:FindFirstChild(Eyes.effects.dof)
	if dof == nil or not dof:IsA("DepthOfFieldEffect") or dof.Enabled == false then
		return
	end
	local saved = self.dofSaved
	if saved == nil or saved.effect ~= dof then
		self.dofSaved = { effect = dof, far = dof.FarIntensity, near = dof.NearIntensity, radius = dof.InFocusRadius }
	end
	dof.FocusDistance = self.focusDistance
	dof.FarIntensity = p.dofFar
	dof.NearIntensity = p.dofNear
	dof.InFocusRadius = p.dofRadius
end

-- ---------------------------------------------------------------- the UV layer
local function findUvFolder(): Instance?
	local node: Instance? = Workspace
	for _, name in Eyes.uv.folder do
		node = if node ~= nil then node:FindFirstChild(name) else nil
	end
	return node
end

-- Every part of the folder with the opacity it asks for (its own attribute, else the folder's, else none).
function SpiderEyes._collectUv(self: any, folder: Instance)
	local U = Eyes.uv
	local parts: { any } = {}
	local fallback = folder:GetAttribute(U.opacityAttribute)
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") then
			local own = d:GetAttribute(U.opacityAttribute)
			local opacity = if type(own) == "number" then own elseif type(fallback) == "number" then fallback else 0
			table.insert(parts, { part = d, opacity = opacity, last = 1 })
		end
	end
	self.uv.parts = parts
end

-- Sets the layer for k, looking the folder up first if need be (at most every lookupSeconds until it exists).
function SpiderEyes._updateUv(self: any, k: number, dt: number)
	local uv = self.uv
	if uv.folder == nil or uv.folder.Parent == nil then
		uv.wait -= dt
		if uv.wait > 0 then
			return
		end
		uv.wait = Eyes.uv.lookupSeconds
		uv.folder = findUvFolder()
		uv.scan = true
		if uv.folder == nil then
			return
		end
	end
	if uv.scan then
		uv.scan = false
		self:_collectUv(uv.folder)
	end
	self:_setUv(k)
end

function SpiderEyes._setUv(self: any, k: number)
	for _, e in self.uv.parts do
		local t = EyeOptics.uvTransparency(k, e.opacity)
		if t ~= e.last and e.part.Parent ~= nil then
			e.part.Transparency = t
			e.last = t
		end
	end
end

-- ---------------------------------------------------------------- the overlay
function SpiderEyes._drawVignette(self: any, p: EyeOptics.Profile)
	if p.vignette == self.vignetteShown then
		return
	end
	self.vignetteShown = p.vignette
	for _, f in self.vignette do
		f.BackgroundTransparency = 1 - p.vignette
	end
end

function SpiderEyes._drawStrips(self: any, strips: { EyeOptics.Strip }, p: EyeOptics.Profile)
	for i, s in strips do
		local w = self.strips[i]
		local f = w.frame
		f.Position = UDim2.fromOffset(s.x, s.y)
		f.Size = UDim2.fromOffset(s.w, s.h)
		f.Rotation = s.rotation
		f.BackgroundTransparency = p.fillTransparency
		f.Visible = true
		w.stroke.Transparency = p.strokeTransparency
	end
end

local function newRing(parent: Instance): any
	local S = Eyes.shimmer
	local f = box("Ring", parent, 3)
	round(f)
	local shadow = box("RingShadow", f, 3)
	shadow.Position = UDim2.fromScale(0.5, 0.5)
	shadow.Size = UDim2.new(1, S.shadowGrowPx * 2, 1, S.shadowGrowPx * 2)
	shadow.Visible = true
	round(shadow)
	return {
		frame = f, stroke = outline(f, rgb(S.ringColor), S.ringThickness),
		shadow = shadow, shadowStroke = outline(shadow, rgb(S.shadowColor), S.shadowThickness),
	}
end

local function newArc(parent: Instance): any
	local S, A = Eyes.shimmer, Eyes.shimmer.arc
	local bars: { any } = {}
	for i = 1, A.segments do
		local f = box("ArcBar", parent, 3)
		f.BackgroundColor3 = rgb(S.ringColor)
		f.Size = UDim2.fromOffset(A.length, A.thickness)
		round(f)
		bars[i] = { frame = f, stroke = outline(f, rgb(S.shadowColor), 1) }
	end
	return { bars = bars }
end

-- Hides the rings and arcs from the given counts on (everything when both are 0).
function SpiderEyes._hideMovers(self: any, rings: number, arcs: number)
	for i = rings + 1, #self.rings do
		self.rings[i].frame.Visible = false
	end
	for i = arcs + 1, #self.arcs do
		for _, b in self.arcs[i].bars do
			b.frame.Visible = false
		end
	end
end

-- The lateral eyes' movement sense. Only what the sensor's sight-line checks found moving is drawn (Sensor.motionSeen): the
-- point is where the sensor put the thing (the eye, along the sensed direction, at the sensed distance), never where a fly is.
function SpiderEyes._drawMovers(self: any, strips: { EyeOptics.Strip }, p: EyeOptics.Profile, size: Vector2, reduced: boolean)
	local S, sensor, camera = Eyes.shimmer, self.sensor, self.camera
	local now: number = sensor.core.tick
	local pulse = EyeOptics.pulse(self.clock, reduced)
	local look: CFrame = camera.CFrame
	local rings, arcs = 0, 0
	for _, m in EyeOptics.pickMovers(sensor.motionSeen, S.maxMovers) do
		local fresh = EyeOptics.freshness(now, m.tick, Sensor.MOTION_HOLD_TICKS)
		if fresh <= 0 then
			continue
		end
		local world: Vector3 = sensor.lastEye + m.direction * m.distance
		local v = camera:WorldToViewportPoint(world)
		if v.Z > 0 and EyeOptics.onScreen(v.X, v.Y, size.X, size.Y, 0) then
			rings += 1
			local ring = self.rings[rings]
			if ring == nil then
				ring = newRing(self.gui)
				self.rings[rings] = ring
			end
			local d = EyeOptics.ringDiameter(m.apparent, p.fovDeg, size.Y, pulse)
			local alpha = EyeOptics.ringAlpha(fresh, EyeOptics.insideAnyStrip(v.X, v.Y, strips))
			ring.frame.Position = UDim2.fromOffset(v.X, v.Y)
			ring.frame.Size = UDim2.fromOffset(d, d)
			ring.stroke.Transparency = 1 - alpha
			ring.shadowStroke.Transparency = 1 - alpha * S.shadowAlpha
			ring.frame.Visible = true
		else
			arcs += 1
			local arc = self.arcs[arcs]
			if arc == nil then
				arc = newArc(self.gui)
				self.arcs[arcs] = arc
			end
			local towards = look:VectorToObjectSpace(world - look.Position)
			local x, y, dx, dy = EyeOptics.edgeMark(towards.X, towards.Y, size.X, size.Y, S.arc.inset)
			local alpha = EyeOptics.arcAlpha(fresh, pulse)
			for i, seg in EyeOptics.arcSegments(x, y, dx, dy) do
				local bar = arc.bars[i]
				bar.frame.Position = UDim2.fromOffset(seg.x, seg.y)
				bar.frame.Rotation = seg.rotation
				bar.frame.BackgroundTransparency = 1 - alpha
				bar.stroke.Transparency = 1 - alpha * S.shadowAlpha
				bar.frame.Visible = true
			end
		end
	end
	self:_hideMovers(rings, arcs)
	self.moversShown = rings + arcs
end

-- ---------------------------------------------------------------- the words
-- The caption for the status area (SpiderHud shows it under the status lines): {text, alpha}, or nil when there is none. It is
-- shown the first time the eye view is open, for Eyes.caption.seconds of it, and not again.
function SpiderEyes.captionView(self: any, device: ControlText.Device): { text: string, alpha: number }?
	if not self.cam.eyeView then
		return nil
	end
	local alpha = EyeOptics.captionAlpha(self.captionAge)
	if alpha <= 0 then
		return nil
	end
	return { text = EyeOptics.captionText(ControlText.name(device, "focus"), self.player:GetAttribute("FocusToggle") == true), alpha = alpha }
end

-- ---------------------------------------------------------------- the frame
-- Once a render frame, after SpiderCamera.render. dt: real seconds (looking runs in real time, slow motion or not). focusing: the
-- client's own notion of Focus (held, or toggled on, on a surface), the same that the perception HUD gets.
function SpiderEyes.update(self: any, dt: number, focusing: boolean)
	local on = self.cam.eyeView == true
	if on ~= self.on then
		if on then
			self:_enter()
		else
			self:_leave()
		end
	end
	if not on then
		return
	end
	local reduced = self.player:GetAttribute("ReducedMotion") == true
	self.phase = EyeOptics.stepPhase(self.phase, focusing, dt)
	local k = EyeOptics.engagement(self.phase)
	self.k = k
	self.clock += dt
	if self.captionAge < Eyes.caption.seconds then
		self.captionAge += dt
	end

	-- What is looked at: along the view, to the world only, at most 40 studs; the focus racks toward it.
	local origin, direction = self.cam:aimRay()
	local hit = Workspace:Raycast(origin, direction * Eyes.focus.maxDistance, self.params)
	local target = EyeOptics.focusTarget(if hit ~= nil then hit.Distance else nil)
	local focus: number? = self.focusDistance
	focus = if focus == nil then target else EyeOptics.focusStep(focus, target, dt)
	self.focusDistance = focus
	local p = EyeOptics.profile(k, focus :: number, reduced)

	self.camera.FieldOfView = p.fovDeg
	self.cam.lookScale = EyeOptics.lookScale(p.fovDeg)
	local grade = self.grade
	grade.Saturation, grade.TintColor, grade.Contrast, grade.Brightness = p.saturation, p.tint, p.contrast, p.brightness
	self.blur.Size = p.blur
	self.blur.Enabled = p.blur > 0.05
	self:_depthOfField(p)
	self:_updateUv(k, dt)

	local size = self.camera.ViewportSize
	if size.Y < 1 then
		return
	end
	self:_drawVignette(p)
	local strips = EyeOptics.retinaStrips(self.clock, p, size.X, size.Y)
	self:_drawStrips(strips, p)
	self:_drawMovers(strips, p, size, reduced)
end

-- Puts everything back and removes what this made (tests; the client keeps it for the session).
function SpiderEyes.destroy(self: any)
	if self.on then
		self:_leave()
	end
	self.gui:Destroy()
	self.grade:Destroy()
	self.blur:Destroy()
end

return SpiderEyes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">SpiderHud</string>
            <string name="Source"><![CDATA[--!strict
-- The spider's screen: the centre dot and Focus ticks, the aim's words under them (Godot jump_hud.gd), a status line and
-- short toasts at the top, the controls card, and the prompt panel at the bottom (the line's own prompts while hanging,
-- what stops a walk to the edge, or a small reminder while walking). Words come from Shared/UI/ControlText for the device
-- in use. Everything but the centre dot sits in the safe area (ScreenInsets.CoreUISafeInsets) and wraps; the prompt panel
-- keeps clear of the touch buttons (Shared/UI/HudLayout).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HudLayout = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI"):WaitForChild("HudLayout"))

local Hud = {}
Hud.__index = Hud

local TOAST_SECONDS = 2.6
local OK_COLOR = Color3.new(0.92, 0.94, 0.98)
local WARN_COLOR = Color3.new(1.0, 0.72, 0.1)

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function pad(parent: Instance, x: number, y: number)
	local p = Instance.new("UIPadding")
	p.PaddingLeft, p.PaddingRight = UDim.new(0, x), UDim.new(0, x)
	p.PaddingTop, p.PaddingBottom = UDim.new(0, y), UDim.new(0, y)
	p.Parent = parent
end

-- A label that keeps its width and wraps, growing downward (the safe way to wrap with AutomaticSize).
local function wrapLabel(name: string, parent: Instance, textSize: number, order: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundColor3 = Color3.new(0, 0, 0)
	l.BackgroundTransparency = 0.4
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.GothamMedium
	l.TextSize = textSize
	l.TextWrapped = true
	l.RichText = false
	l.Size = UDim2.new(1, 0, 0, 0)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.LayoutOrder = order
	l.Visible = false
	pad(l, 10, 5)
	corner(l, 8)
	l.Parent = parent
	return l
end

-- A short label sized to its text (single lines broken by hand), for the aim words at the centre.
local function pill(name: string, parent: Instance, textSize: number, order: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundColor3 = Color3.new(0, 0, 0)
	l.BackgroundTransparency = 0.45
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.GothamMedium
	l.TextSize = textSize
	l.TextWrapped = false
	l.AutomaticSize = Enum.AutomaticSize.XY
	l.Size = UDim2.fromOffset(0, 0)
	l.LayoutOrder = order
	l.Visible = false
	pad(l, 10, 4)
	corner(l, 8)
	l.Parent = parent
	return l
end

local function column(name: string, parent: Instance, anchor: Vector2, position: UDim2, align: Enum.VerticalAlignment): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.AnchorPoint = anchor
	f.Position = position
	f.Size = UDim2.new(1, -32, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = align
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 6)
	list.Parent = f
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(HudLayout.MAX_PROMPT_WIDTH, math.huge)
	limit.Parent = f
	f.Parent = parent
	return f
end

function Hud.new(playerGui: Instance): any
	-- The centre dot must be at the true viewport centre (the camera's aim ray), so this layer ignores the insets.
	local centre = Instance.new("ScreenGui")
	centre.Name = "SpiderHud"
	centre.ResetOnSpawn = false
	centre.IgnoreGuiInset = true
	centre.ScreenInsets = Enum.ScreenInsets.None
	centre.Parent = playerGui
	local reticle = Instance.new("Frame")
	reticle.Name = "Reticle"
	reticle.AnchorPoint = Vector2.new(0.5, 0.5)
	reticle.Position = UDim2.fromScale(0.5, 0.5)
	reticle.Size = UDim2.fromOffset(6, 6)
	reticle.BackgroundColor3 = Color3.new(1, 1, 1)
	reticle.Visible = false
	corner(reticle, 3)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 1.5
	stroke.Parent = reticle
	reticle.Parent = centre
	local ticks: { Frame } = {}
	for i, off in { Vector2.new(-16, 0), Vector2.new(16, 0), Vector2.new(0, -16), Vector2.new(0, 16) } do
		local t = Instance.new("Frame")
		t.AnchorPoint = Vector2.new(0.5, 0.5)
		t.Position = UDim2.new(0.5, off.X, 0.5, off.Y)
		t.Size = if i <= 2 then UDim2.fromOffset(8, 2) else UDim2.fromOffset(2, 8)
		t.BackgroundColor3 = Color3.new(1, 1, 1)
		t.BorderSizePixel = 0
		t.Visible = false
		t.Parent = centre
		ticks[i] = t
	end
	local aimBox = Instance.new("Frame")
	aimBox.Name = "AimBox"
	aimBox.BackgroundTransparency = 1
	aimBox.AnchorPoint = Vector2.new(0.5, 0)
	aimBox.Position = UDim2.new(0.5, 0, 0.5, 24)
	aimBox.Size = UDim2.fromOffset(0, 0)
	aimBox.AutomaticSize = Enum.AutomaticSize.XY
	local aimList = Instance.new("UIListLayout")
	aimList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	aimList.SortOrder = Enum.SortOrder.LayoutOrder
	aimList.Padding = UDim.new(0, 3)
	aimList.Parent = aimBox
	aimBox.Parent = centre
	local aimTitle = pill("AimTitle", aimBox, 18, 1)
	local aimHint = pill("AimHint", aimBox, 15, 2)
	local anchorLabel = pill("Anchor", aimBox, 14, 3)

	-- Everything else: inside the safe area.
	local safe = Instance.new("ScreenGui")
	safe.Name = "SpiderPrompts"
	safe.ResetOnSpawn = false
	safe.IgnoreGuiInset = false
	safe.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	safe.Parent = playerGui
	local top = column("Top", safe, Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 8), Enum.VerticalAlignment.Top)
	local grip = Instance.new("Frame")
 grip.Name="GripBar";grip.Size=UDim2.new(.65,0,0,12);grip.LayoutOrder=0;grip.BackgroundColor3=Color3.fromRGB(45,12,12);grip.Visible=false;grip.Parent=top
 local gripFill=Instance.new("Frame");gripFill.Name="Grip";gripFill.Size=UDim2.fromScale(.4,1);gripFill.BackgroundColor3=Color3.fromRGB(245,35,38);gripFill.BorderSizePixel=0;gripFill.Parent=grip
 local status = wrapLabel("Status", top, 16, 1)
	-- The spider-eye view's explanation, the first time (ROBLOX-20): right under the status lines, in the column, so it never covers
	-- the aim words or the prompts. Shown from view.caption = { text, alpha }.
	local caption = wrapLabel("Caption", top, 15, 2)
	-- The life loop's notices ("Morning, day 2", "Checkpoint kept."), for as long as LifeLoop keeps them (ROBLOX-24).
	local notice = wrapLabel("Notice", top, 16, 3)
	local toast = wrapLabel("Toast", top, 17, 4)
	local help = wrapLabel("Controls", top, 15, 5)
	help.TextXAlignment = Enum.TextXAlignment.Left
	-- Day/stage and notices share one vertical flow, so longer life labels never overlap checkpoint messages.
	local dayBox = Instance.new("Frame")
	dayBox.Name = "DayBox"
	dayBox.BackgroundTransparency = 1
	dayBox.LayoutOrder = -1
	dayBox.Size = UDim2.new(1, 0, 0, 0)
	dayBox.AutomaticSize = Enum.AutomaticSize.Y
	local dayList = Instance.new("UIListLayout")
	dayList.HorizontalAlignment = Enum.HorizontalAlignment.Left
	dayList.SortOrder = Enum.SortOrder.LayoutOrder
	dayList.Padding = UDim.new(0, 4)
	dayList.Parent = dayBox
	dayBox.Parent = top
	local day = wrapLabel("Day", dayBox, 15, 1)
	local dayLine = wrapLabel("DayLine", dayBox, 14, 2)
	dayLine.TextXAlignment = Enum.TextXAlignment.Left
	-- The notebook's note that a page opened (ROBLOX-37): under the day, for a few seconds.
	local note = wrapLabel("NotebookNote", dayBox, 15, 3)
	note.TextXAlignment = Enum.TextXAlignment.Left
	note.TextColor3 = Color3.new(0.96, 0.93, 0.82)
	local panel = Instance.new("Frame")
	panel.Name = "PromptPanel"
	panel.BackgroundTransparency = 1
	panel.AnchorPoint = Vector2.new(0, 1)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	local plist = Instance.new("UIListLayout")
	plist.HorizontalAlignment = Enum.HorizontalAlignment.Center
	plist.VerticalAlignment = Enum.VerticalAlignment.Bottom
	plist.SortOrder = Enum.SortOrder.LayoutOrder
	plist.Padding = UDim.new(0, 4)
	plist.Parent = panel
	panel.Parent = safe
	local promptTitle = wrapLabel("PromptTitle", panel, 17, 1)
	promptTitle.Font = Enum.Font.GothamBold
	local promptHint = wrapLabel("PromptHint", panel, 16, 2)
	local promptCue = wrapLabel("PromptCue", panel, 16, 3)
	promptCue.TextColor3 = WARN_COLOR
	local self = setmetatable({
		grip = grip, gripFill = gripFill, centre = centre, safe = safe, reticle = reticle, ticks = ticks,
		aimTitle = aimTitle, aimHint = aimHint, anchorLabel = anchorLabel,
		status = status, caption = caption, toastLabel = toast, help = help, notice = notice, day = day, dayLine = dayLine, noteLabel = note, noteLeft = 0,
		panel = panel, promptTitle = promptTitle, promptHint = promptHint, promptCue = promptCue,
		toastLeft = 0, device = "keyboard", lastSpan = "",
	}, Hud)
	return self
end

function Hud.toast(self: any, text: string, warn: boolean?)
	if text == "" then return end
	self.toastLabel.Text = text
	self.toastLabel.TextColor3 = if warn then WARN_COLOR else OK_COLOR
	self.toastLabel.Visible = true
	self.toastLeft = TOAST_SECONDS
end

-- The note that a page opened in the notebook, for `seconds`.
function Hud.setNote(self: any, text: string, seconds: number)
	self.noteLabel.Text = text
	self.noteLabel.Visible = text ~= ""
	self.noteLeft = if text ~= "" then seconds else 0
end

local function show(label: TextLabel, text: string?)
	local t = text or ""
	if label.Text ~= t then label.Text = t end
	label.Visible = t ~= ""
end

-- Places the prompt panel for the safe area's size and the device (HudLayout.promptSpan).
function Hud._place(self: any)
	local size = self.safe.AbsoluteSize
	local x0, x1, bottom = HudLayout.promptSpan(size.X, size.Y, self.device)
	local key = string.format("%.1f,%.1f,%.1f", x0, x1, bottom)
	if key == self.lastSpan then return end
	self.lastSpan = key
	-- Anchored to the safe area's bottom edge (scale 1), so the panel's gap above the bottom holds even if the reported size
	-- and the children's origin disagree about an inset.
	self.panel.Position = UDim2.new(0, x0, 1, bottom - size.Y)
	self.panel.Size = UDim2.fromOffset(math.max(x1 - x0, 0), 0)
end

-- view: device, aiming, focus, eyeView, aimTitle, aimHint, aimColor, anchorText, anchorOk, status ({string}),
-- caption ({text, alpha} or nil), prompt ({title, hint, cue} or nil), helpVisible, helpText, notice, day and dayLine (strings or nil).
function Hud.update(self: any, view: any, dt: number)
	self.grip.Visible = view.grip ~= nil
 if view.grip then self.gripFill.Size = UDim2.fromScale(math.clamp(view.grip,0,1),1) end
 self.device = view.device
	self:_place()
	self.reticle.Visible = view.aiming or view.focus or view.eyeView
	for _, t in self.ticks do t.Visible = view.focus == true end
	show(self.aimTitle, view.aimTitle)
	if view.aimColor then self.aimTitle.TextColor3 = view.aimColor end
	show(self.aimHint, view.aimHint)
	show(self.anchorLabel, view.anchorText)
	self.anchorLabel.TextColor3 = if view.anchorOk then OK_COLOR else WARN_COLOR
	show(self.status, table.concat(view.status or {}, "\n"))
	show(self.notice, view.notice)
	show(self.day, view.day)
	show(self.dayLine, view.dayLine)
	local caption = view.caption
	if caption then
		if self.caption.Text ~= caption.text then self.caption.Text = caption.text end
		self.caption.TextTransparency = 1 - caption.alpha
		self.caption.BackgroundTransparency = 1 - 0.6 * caption.alpha
		self.caption.Visible = true
	else
		self.caption.Visible = false
	end
	local prompt = view.prompt
	show(self.promptTitle, if prompt then prompt.title else nil)
	show(self.promptHint, if prompt then prompt.hint else nil)
	show(self.promptCue, if prompt then prompt.cue else nil)
	if view.helpVisible then show(self.help, view.helpText) else show(self.help, nil) end
	if self.noteLeft > 0 then
		self.noteLeft -= dt
		if self.noteLeft <= 0 then self.noteLabel.Visible = false end
	end
	if self.toastLeft > 0 then
		self.toastLeft -= dt
		if self.toastLeft <= 0 then self.toastLabel.Visible = false end
	end
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">SpiderInput</string>
            <string name="Source"><![CDATA[--!strict
-- One action path for keyboard, mouse, gamepad and held on-screen touch buttons, all at once.
-- Bindings follow the frozen Godot game's scripts/core/input_setup.gd wherever the action exists in the port:
--   walk WASD / left stick (D-pad too), look mouse / arrow keys / right stick / touch drag, creep Shift / LB,
--   jump Space / A (tap hop, hold aim, release leap), cancel Q / B (cancels an aim or a walk to the edge; held on the
--   line it lets go), focus right mouse / LT, spider-eye view V / Y, recenter R / middle mouse / right-stick click,
--   slow motion T / RT, lower on silk F / X (Godot: F / D-pad down; the port keeps the D-pad for walking, ROBLOX-05).
--   Esc / Menu open Roblox's own menu: the game drops every press and hold and waits (Godot's pause).
-- Port-only: reset to the start Backspace / View (Select), gait toggle G, controls card H (Godot's H is the field notes).
-- The peacock spider (ROBLOX-31): C changes spider in the crack (RB / R1 on a controller, the touch Change button); X, or the same RB / R1
-- outside the crack, starts and stops the courtship dance (the touch Dance button).
-- The naturalist's notebook (ROBLOX-37): N opens it. Godot's D-pad up is the port's walking, so a controller reaches it through the life
-- menu (View / Touchpad, then Notebook); touch has the Notebook button beside Menu (SpiderClient).
--
-- Every button action is held while any source holds it (InputState): a key, a controller button, a finger. Handlers hear
-- one "begin" when the first source goes down and one "end" when the last comes up, so a touch hold and a key or button
-- held at the same time never cancel each other.
local CAS = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local InputState = require(Shared:WaitForChild("Movement"):WaitForChild("InputState"))
local HudLayout = require(Shared:WaitForChild("UI"):WaitForChild("HudLayout"))
local SpiderInput = {}

export type Handlers = {
	blocked: (() -> boolean)?, menu: (() -> ())?,
	feed: (() -> ())?,
	choose: (() -> ())?, -- C: change spider (in the crack)
	notebook: (() -> ())?, -- N: the naturalist's notebook
	display: (() -> ())?, -- X / RB: the peacock spider's courtship dance
	focus: ((string) -> ())?,
	jump: (string) -> (), -- "begin", "end", or "cancel" (the engine took the input away)
	cancel: (string) -> (),
	drop: () -> (),
	clear: () -> (), -- focus loss, the Roblox menu, a text box, a lost controller
	reset: () -> (),
	gait: () -> (),
	eye: () -> (),
	recenter: () -> (),
	slow: () -> (),
	help: () -> (),
	touchLook: (Vector2) -> (),
	device: ((string) -> ())?, -- the last input's UserInputType name
}

local ONE_SHOT = { Menu = "menu", Notebook = "notebook", Reset = "reset", Gait = "gait", Eye = "eye", Recenter = "recenter", Slow = "slow", Help = "help" }

-- Bindings by action. Exported for tests and the controls table in README.md.
SpiderInput.BINDINGS = {
	Forward = { Enum.KeyCode.W, Enum.KeyCode.DPadUp }, Back = { Enum.KeyCode.S, Enum.KeyCode.DPadDown },
	Left = { Enum.KeyCode.A, Enum.KeyCode.DPadLeft }, Right = { Enum.KeyCode.D, Enum.KeyCode.DPadRight },
	LookLeft = { Enum.KeyCode.Left }, LookRight = { Enum.KeyCode.Right }, LookUp = { Enum.KeyCode.Up }, LookDown = { Enum.KeyCode.Down },
	Jump = { Enum.KeyCode.Space, Enum.KeyCode.ButtonA }, Cancel = { Enum.KeyCode.Q, Enum.KeyCode.ButtonB },
	Feed = { Enum.KeyCode.E, Enum.KeyCode.ButtonL3 },
	Drop = { Enum.KeyCode.F, Enum.KeyCode.ButtonX },
	Creep = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL1 },
	Focus = { Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2 },
	Eye = { Enum.KeyCode.V, Enum.KeyCode.ButtonY },
	Recenter = { Enum.KeyCode.R, Enum.UserInputType.MouseButton3, Enum.KeyCode.ButtonR3 },
	Slow = { Enum.KeyCode.T, Enum.KeyCode.ButtonR2 }, Help = { Enum.KeyCode.H },
	Reset = { Enum.KeyCode.Backspace }, Menu = { Enum.KeyCode.M, Enum.KeyCode.ButtonSelect }, Gait = { Enum.KeyCode.G },
	Choose = { Enum.KeyCode.C }, Notebook = { Enum.KeyCode.N }, Display = { Enum.KeyCode.X, Enum.KeyCode.ButtonR1 },
} :: { [string]: { any } }

local function sourceOf(input: InputObject?): any
	if input == nil then return "default" end
	local t = input.UserInputType
	if t == Enum.UserInputType.Touch then return input end -- each finger is its own source
	if t == Enum.UserInputType.Keyboard or string.sub(t.Name, 1, 7) == "Gamepad" then return input.KeyCode end
	return t -- a mouse button
end

function SpiderInput.bind(h: Handlers)
	local state = InputState.new()
	local handlers: { [string]: any } = h :: any
	-- One source of one action went down (down) or up; "cancel" means the engine took the input away (treated as up).
	local function act(action: string, down: boolean, source: any, cancelled: boolean?)
		local blocked: boolean = if h.blocked then h.blocked() else false
		if down and blocked and action ~= tostring("Menu") then return end
		local was, now = state:set(action, down, source)
		if was == now then return end
		if action == "Jump" then
			h.jump(if now then "begin" elseif cancelled then "cancel" else "end")
		elseif action == "Cancel" then
			h.cancel(if now then "begin" else "end")
		elseif action == "Focus" then
			if h.focus then h.focus(if now then "begin" elseif cancelled then "cancel" else "end") end
		elseif action == "Feed" then
			if now and h.feed then h.feed() end
		elseif action == "Choose" then
			if now and h.choose then h.choose() end
		elseif action == "Display" then
			if now and h.display then h.display() end
		elseif action == "Drop" then
			if now then h.drop() end
		elseif ONE_SHOT[action] then
			local fn = if now then handlers[ONE_SHOT[action]] else nil
			if fn then fn() end
		end
	end
	for action, keys in SpiderInput.BINDINGS do
		CAS:BindActionAtPriority("Spider" .. action, function(_, phase, input)
			if UIS:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
			if phase == Enum.UserInputState.Begin then
				act(action, true, sourceOf(input))
			elseif phase == Enum.UserInputState.End or phase == Enum.UserInputState.Cancel then
				act(action, false, sourceOf(input), phase == Enum.UserInputState.Cancel)
			end
			return Enum.ContextActionResult.Sink
		end, false, 3000, table.unpack(keys))
	end
	CAS:BindActionAtPriority("SpiderStick", function(_, phase, input)
		if phase == Enum.UserInputState.Cancel or UIS:GetFocusedTextBox() or (h.blocked and h.blocked()) then state:stick(0, 0)
		else state:stick(input.Position.X, input.Position.Y) end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Thumbstick1)
	CAS:BindActionAtPriority("SpiderLookStick", function(_, phase, input)
		if phase == Enum.UserInputState.Cancel or UIS:GetFocusedTextBox() then state:look(0, 0)
		else state:look(input.Position.X, input.Position.Y) end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Thumbstick2)

	-- Roblox's own touch thumbstick and jump button would sit under ours: this game has its own touch controls.
	pcall(function() GuiService.TouchControlsEnabled = false end)
	local gui = Instance.new("ScreenGui")
	gui.Name = "SpiderTouch"
	gui.ResetOnSpawn = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets -- clear of notches, the home bar and Roblox's top bar
	gui.Enabled = UIS.TouchEnabled
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local active: { [InputObject]: string } = {}
	local buttons: { [string]: TextButton } = {}
	local function clear()
		state:clear()
		table.clear(active)
		h.clear()
	end
	local function button(action: string, label: string, position: UDim2, size: number, textSize: number?)
		local b = Instance.new("TextButton")
		b.Name = action
		b.Text = label
		b.TextSize = textSize or 18
		b.TextWrapped = true
		b.TextColor3 = Color3.new(1, 1, 1)
		b.BackgroundColor3 = Color3.new(0.06, 0.06, 0.06)
		b.BackgroundTransparency = 0.15
		b.Size = UDim2.fromOffset(size, size)
		b.Position = position
		b.AutoButtonColor = true
		b.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 14)
		corner.Parent = b
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				active[input] = action
				act(action, true, input)
			end
		end)
		buttons[action] = b
	end
	-- Left thumb: walking. Right thumb: jump (largest, nearest the corner), cancel / let go beside it, then creep, silk,
	-- recenter and the eye view further in. Offsets from the safe area's bottom corners (HudLayout, checked in tests).
	for _, b in HudLayout.TOUCH_BUTTONS do
		button(b.action, b.label, if b.right then UDim2.new(1, b.x, 1, b.y) else UDim2.new(0, b.x, 1, b.y), b.size, b.textSize)
	end
	local function layoutTouch()
		local size = gui.AbsoluteSize
		for _, spec in HudLayout.TOUCH_BUTTONS do
			local b = HudLayout.layoutButton(spec, size.X, size.Y)
			local control = buttons[b.action]
			control.Position = UDim2.new(if b.right then 1 else 0, b.x, 1, b.y)
			control.Size = UDim2.fromOffset(b.size, b.size)
			control.TextSize = b.textSize or 18
		end
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutTouch)
	layoutTouch()
	UIS.InputEnded:Connect(function(input)
		local action = active[input]
		if action then
			active[input] = nil
			act(action, false, input)
		end
	end)
	-- Touch look: a drag anywhere that is not on a button turns the view (Roblox marks button touches processed).
	UIS.TouchMoved:Connect(function(input, processed)
		if not processed and not active[input] then h.touchLook(Vector2.new(input.Delta.X, input.Delta.Y)) end
	end)
	UIS.WindowFocusReleased:Connect(clear)
	UIS.TextBoxFocused:Connect(clear)
	UIS.GamepadDisconnected:Connect(clear)
	GuiService.MenuOpened:Connect(clear)
	UIS:GetPropertyChangedSignal("TouchEnabled"):Connect(function() gui.Enabled = UIS.TouchEnabled end)
	local deviceHandler = h.device
	if deviceHandler then
		UIS.LastInputTypeChanged:Connect(function(t: Enum.UserInputType) deviceHandler(t.Name) end)
	end

	-- The client relabels and shows/hides touch buttons with the state (the Cancel button is Let go on the line).
	local api: any = state
	function api.setTouchLabel(_self: any, action: string, text: string)
		local b = buttons[action]
		if b and b.Text ~= text then b.Text = text end
	end
	function api.setTouchVisible(_self: any, action: string, visible: boolean)
		local b = buttons[action]
		if b and b.Visible ~= visible then
			b.Visible = visible
			if not visible then
				for input, a in active do
					if a == action then
						active[input] = nil
						act(action, false, input)
					end
				end
			end
		end
	end
	api.touchGui = gui
	-- The test place's playback drives the same path a key, button or finger takes (tests/client/SilkPlayback.luau).
	function api.simulate(_self: any, action: string, down: boolean, source: any?)
		act(action, down, source or "playback")
	end
	return api
end
return SpiderInput
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">WaspBody</string>
            <string name="Source"><![CDATA[--!strict
-- The drawn mud dauber wasp (Data/WaspLook has every number): about 2.5 cm long, built from ellipsoids and rods as the fly is
-- (Client/FlyBodies, ROBLOX-22): a black head with big dark eyes and yellow mandibles, a black thorax with a yellow collar and
-- scutellum, a very long thin yellow petiole and a black gaster, six long legs (black femurs, a yellow band at each knee, yellow
-- tibias and feet), two smoky dark wings each side and two curled antennae that flick while it searches. Every part is anchored, never
-- collides, is never seen by a ray and casts no shadow (Habitat/Shapes). One Workspace:BulkMoveTo places all its parts each frame.
-- Poses: flying (legs trailing, wings a soft translucent blur of the stroke), walking (legs striding at 3 Hz, wings folded back),
-- holding (flying, with the front legs clutching what hangs under it). Display only: where it is, which way it faces, its mode and how
-- busily it searches come from the WaspDirector; nothing here feeds back. Godot's WaspBody (wasp_body.gd) is the source of the joints.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local WaspLook = require(Shared:WaitForChild("Data"):WaitForChild("WaspLook"))
local Shapes = require(Shared:WaitForChild("Habitat"):WaitForChild("Shapes"))

local WaspBody = {}
WaspBody.__index = WaspBody

local TAU = math.pi * 2
local PHASE = 0.37 -- Godot builds the wasp with this phase for its beat

type Spec = { name: string, rod: boolean, color: Color3, reflectance: number }

local function vec(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

local function mirrored(t: { number }, side: number): Vector3
	return Vector3.new(t[1] * side, t[2], t[3])
end

-- The size and frame of a rod (a Cylinder part: its axis is X) from a to b.
local function rodBetween(a: Vector3, b: Vector3, diameter: number, grow: number?): (Vector3, CFrame)
	local d = b - a
	local length = math.max(d.Magnitude, 1e-4)
	local dir = d / length
	local up = if math.abs(dir.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local g = grow or 0
	return Vector3.new(length, diameter + g, diameter + g), CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0)
end

-- Euler turns as Godot applies them: about y, then x, then z.
local function euler(rx: number, ry: number, rz: number): CFrame
	return CFrame.Angles(0, ry, 0) * CFrame.Angles(rx, 0, 0) * CFrame.Angles(0, 0, rz)
end

-- The parts, in a fixed order: the static ones, then the antennae, the legs, the wings. `index` finds a part by name.
local function build(): ({ Spec }, { [string]: number })
	local C, G = WaspLook.colors, WaspLook.gloss
	local specs: { Spec } = {}
	local index: { [string]: number } = {}
	local function add(name: string, rod: boolean, colorName: string, gloss: number?)
		table.insert(specs, { name = name, rod = rod, color = Color3.fromHex(C[colorName]), reflectance = gloss or G[colorName] or 0 })
		index[name] = #specs
	end
	for _, item in WaspLook.body do add(item.name, false, item.color) end
	add("Petiole", true, WaspLook.petiole.color)
	local A = WaspLook.antenna
	for _, side in { "L", "R" } do
		for i = 1, #A.diameters do add(`Antenna{side}{i}`, true, A.colors[i]) end
	end
	local L = WaspLook.legs
	for _, side in { "L", "R" } do
		for pair = 1, #L.hips do
			add(`Leg{side}{pair}Femur`, true, "black")
			add(`Leg{side}{pair}Tibia`, true, "yellow")
			add(`Leg{side}{pair}Tarsus`, true, "yellow")
			add(`Leg{side}{pair}Band`, true, "yellow")
		end
	end
	local W = WaspLook.wing
	for _, side in { "L", "R" } do
		for k = 1, 2 do
			add(`Wing{side}{k}`, false, "wing", W.reflectance)
			add(`Wing{side}{k}Vein`, true, "vein", 0)
			add(`Wing{side}{k}Blur`, false, "blur", 0)
		end
	end
	return specs, index
end

function WaspBody.new(parent: Instance): any
	local folder = Instance.new("Folder")
	folder.Name = "Wasp"
	local specs, index = build()
	local parts: { Part } = {}
	for i, spec in specs do
		local part: Part
		if spec.rod then
			part = Shapes.block(folder, spec.name, Vector3.one * 0.05, CFrame.new(), spec.color, "SmoothPlastic")
			part.Shape = Enum.PartType.Cylinder
		else
			part = Shapes.ellipsoid(folder, spec.name, Vector3.one * 0.1, CFrame.new(), spec.color, "SmoothPlastic")
		end
		part.Reflectance = spec.reflectance
		parts[i] = part
	end
	local self = setmetatable({
		parent = parent, folder = folder, specs = specs, index = index, parts = parts, shown = false,
		sizes = {} :: { Vector3 }, frames = {} :: { CFrame }, transparency = {} :: { number }, world = {} :: { CFrame }, moved = {} :: { Part },
		bob = 0.0,
	}, WaspBody)
	self:pose("flying", 0, 0)
	return self
end

-- The pose of every part in the torso's frame, for this mode ("flying", "walking" or "holding"), time `beat` (seconds) and how busily
-- the antennae flick (0 to 1): fills self.sizes, self.frames and self.transparency (indexed as the parts), and self.bob (the torso's rise).
function WaspBody.pose(self: any, mode: string, beat: number, search: number)
	local sizes, frames, trans, index = self.sizes, self.frames, self.transparency, self.index
	local walking, holding = mode == "walking", mode == "holding"
	local function set(name: string, size: Vector3, frame: CFrame, transparency: number?)
		local i = index[name]
		sizes[i], frames[i], trans[i] = size, frame, transparency or 0
	end
	-- the body
	for _, item in WaspLook.body do
		set(item.name, vec(item.size), CFrame.new(vec(item.at)), 0)
	end
	local P = WaspLook.petiole
	local psize, pframe = rodBetween(vec(P.from), vec(P.to), P.diameter)
	set("Petiole", psize, pframe, 0)
	-- the antennae
	local A = WaspLook.antenna
	for i, word in { "L", "R" } do
		local side = if i == 1 then -1 else 1
		local flick = math.clamp(search, 0, 1) * math.sin(TAU * (A.hertz[1] + A.hertz[2] * (i - 1)) * beat + PHASE) * A.flick
		local node = CFrame.new(mirrored(A.base, side)) * euler(A.rest[1] + flick, side * A.rest[2] + flick * 0.5, 0)
		for s = 1, #A.diameters do
			local size, frame = rodBetween(node * mirrored(A.points[s], side), node * mirrored(A.points[s + 1], side), A.diameters[s])
			set(`Antenna{word}{s}`, size, frame, 0)
		end
	end
	-- the legs
	local L, walk = WaspLook.legs, WaspLook.walk
	for sideIndex, word in { "L", "R" } do
		local side = if sideIndex == 1 then -1 else 1
		for pair = 0, #L.hips - 1 do
			local hip = Vector3.new(side * L.hips[pair + 1][1], L.hips[pair + 1][2], L.hips[pair + 1][3])
			local knee = Vector3.new(side * (0.35 + 0.05 * pair), -0.25, 0.04 + 0.15 * pair)
			local ankle = Vector3.new(side * (0.52 + 0.09 * pair), -0.58, 0.10 + 0.23 * pair)
			local tip = ankle + Vector3.new(side * 0.03, -0.12, 0.12)
			if walking then
				-- the actor stands 0.35 above its surface: the feet reach it
				knee, ankle, tip = Vector3.new(knee.X, -0.08, knee.Z), Vector3.new(ankle.X, -0.20, ankle.Z), Vector3.new(tip.X, -0.23, tip.Z)
				local cycle = TAU * walk.hertz * beat + PHASE + math.pi * ((pair + (sideIndex - 1)) % 2)
				local stride = Vector3.new(0, math.max(0, math.sin(cycle)) * walk.lift, math.cos(cycle) * walk.reach)
				ankle += stride
				tip += stride
			elseif holding and pair < 2 then
				knee, ankle, tip = Vector3.new(side * 0.30, -0.26, -0.05), Vector3.new(side * 0.18, -0.58, -0.07), Vector3.new(side * 0.08, -0.60, -0.16)
			else
				ankle += Vector3.new(0, 0, 0.25 + 0.14 * pair)
				tip = ankle + Vector3.new(0, -0.11, 0.14)
			end
			local name = `Leg{word}{pair + 1}`
			local s1, f1 = rodBetween(hip, hip + knee, L.femur)
			local s2, f2 = rodBetween(hip + knee, hip + ankle, L.tibia)
			local s3, f3 = rodBetween(hip + ankle, hip + tip, L.tarsus)
			local along = knee.Unit
			local s4, f4 = rodBetween(hip + knee - along * L.band.length, hip + knee, L.femur, L.band.grow)
			set(name .. "Femur", s1, f1, 0)
			set(name .. "Tibia", s2, f2, 0)
			set(name .. "Tarsus", s3, f3, 0)
			set(name .. "Band", s4, f4, 0)
		end
	end
	-- the wings: folded back on the ground; in the air a soft translucent blur of the stroke, a little unsteady
	local W = WaspLook.wing
	for sideIndex, word in { "L", "R" } do
		local side = if sideIndex == 1 then -1 else 1
		for k = 1, 2 do
			local share = if k == 1 then 1.0 else W.hindShare
			local pivotAt = Vector3.new(side * W.root[1], W.root[2], W.root[3] + (k - 1) * W.hindStep)
			local yaw, roll = W.folded.yaw, W.folded.roll
			local transparency = W.transparency
			if not walking then
				yaw, roll = W.flight.yaw, W.flight.roll + W.flight.shimmerRoll * math.sin(TAU * W.flight.shimmerHertz * beat + PHASE + k)
				transparency = W.flightTransparency
			end
			local pivot = CFrame.new(pivotAt) * euler(0, math.rad(side * yaw), math.rad(-side * roll))
			local blade = CFrame.new(side * W.centre[1] * share, 0, W.centre[3] * share) * CFrame.Angles(0, math.rad(side * W.sweep), 0)
			local size = Vector3.new(W.width * share, W.thick, W.length * share)
			set(`Wing{word}{k}`, size, pivot * blade, transparency)
			local vsize, vframe = rodBetween(pivot * Vector3.new(0, W.thick, 0.02), pivot * Vector3.new(side * W.vein.tipX * share, W.thick, W.vein.to * W.length * share), W.vein.diameter)
			set(`Wing{word}{k}Vein`, vsize, vframe, transparency * 0.4)
			local widen = if walking then 1.0 else W.blur.widen
			set(`Wing{word}{k}Blur`, Vector3.new(W.width * share * widen, W.thick * 2, W.length * share), pivot * blade, if walking then 1.0 else W.blur.transparency)
		end
	end
	self.bob = if walking then 0.0 else WaspLook.bob.height * math.sin(TAU * WaspLook.bob.hertz * beat + PHASE)
end

-- Draws it as the director has it: `wasp` = { position, heading, mode, search, visible }, `now` the time in seconds. Hidden (taken out of
-- the world) while it is away.
function WaspBody.draw(self: any, wasp: any, now: number)
	if not wasp.visible then
		if self.shown then
			self.shown = false
			self.folder.Parent = nil
		end
		return
	end
	if not self.shown then
		self.shown = true
		self.folder.Parent = self.parent
	end
	self:pose(wasp.mode, now, wasp.search)
	local body = CFrame.lookAt(wasp.position, wasp.position + wasp.heading, Vector3.yAxis) * CFrame.new(0, self.bob, 0)
	local moved, world = self.moved, self.world
	table.clear(moved)
	for i, part in self.parts do
		local size = self.sizes[i]
		if part.Size ~= size then part.Size = size end
		if part.Transparency ~= self.transparency[i] then part.Transparency = self.transparency[i] end
		moved[i] = part
		world[i] = body * self.frames[i]
	end
	Workspace:BulkMoveTo(moved, world, Enum.BulkMoveMode.FireCFrameChanged)
end

function WaspBody.destroy(self: any)
	self.folder:Destroy()
end

return WaspBody
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">WorldDetail</string>
            <string name="Source"><![CDATA[--!strict
-- The low-detail tier of the world, applied on one client: phones and tablets drop what the server built for the full tier
-- (anything carrying the attribute FullOnly: bloom, sun rays, clouds, light shafts, the small details, the busier part of the
-- view) and get a thinner dust. Only this client's copy changes; the server and other players keep theirs.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Graphics = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Data"):WaitForChild("Graphics"))

local WorldDetail = {}

-- detail: "full" or "low". roots: the places the server put optional things in (Decor, Lighting, Terrain). Returns how many
-- instances it removed.
function WorldDetail.apply(detail: string, roots: { Instance }): number
	if detail ~= "low" then return 0 end
	local scale = Graphics.tiers.low.dustRate
	local doomed: { Instance } = {}
	for _, root in roots do
		if root:GetAttribute("FullOnly") == true then
			table.insert(doomed, root)
		else
			for _, d in root:GetDescendants() do
				if d:GetAttribute("FullOnly") == true then
					table.insert(doomed, d)
				elseif d:IsA("ParticleEmitter") and d:GetAttribute("Dust") == true and d:GetAttribute("Thinned") ~= true then
					d.Rate = d.Rate * scale
					d:SetAttribute("Thinned", true)
				end
			end
		end
	end
	for _, d in doomed do d:Destroy() end
	return #doomed
end

return WorldDetail
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
