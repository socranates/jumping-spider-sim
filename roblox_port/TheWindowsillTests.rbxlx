		{ name = "EyeR", color = "eye", at = { 0.15, 0.18, -0.62 }, size = { 0.12, 0.13, 0.12 } },
		{ name = "Thorax", color = "thorax", at = { 0, 0.16, -0.38 }, size = { 0.16, 0.2, 0.34 } },
		{ name = "Stripe", color = "stripe", at = { 0, 0.2, -0.38 }, size = { 0.166, 0.08, 0.3 }, full = true },
		{ name = "Abdomen", color = "abdomen", at = { 0, 0.15, 0.62 }, size = { 0.075, 0.075, 1.75 } },
		{ name = "Ring1", color = "ring", at = { 0, 0.15, 0.1 }, size = { 0.08, 0.08, 0.03 }, full = true },
		{ name = "Ring2", color = "ring", at = { 0, 0.15, 0.4 }, size = { 0.08, 0.08, 0.03 }, full = true },
		{ name = "Ring3", color = "ring", at = { 0, 0.15, 0.7 }, size = { 0.08, 0.08, 0.03 }, full = true },
		{ name = "Tip", color = "tip", at = { 0, 0.15, 1.38 }, size = { 0.085, 0.085, 0.16 } },
	} :: { any },
	rods = {
		{ name = "FrontLeg", color = "leg", d = 0.02, from = { 0.05, 0.08, -0.48 }, to = { 0.14, -0.16, -0.55 }, fly = { { 0.05, 0.08, -0.48 }, { 0.06, -0.06, -0.5 } }, mirror = true },
		{ name = "MiddleLeg", color = "leg", d = 0.02, from = { 0.06, 0.08, -0.4 }, to = { 0.18, -0.16, -0.36 }, fly = { { 0.06, 0.08, -0.4 }, { 0.07, -0.06, -0.38 } }, mirror = true },
		{ name = "HindLeg", color = "leg", d = 0.02, from = { 0.06, 0.08, -0.32 }, to = { 0.17, -0.16, -0.18 }, fly = { { 0.06, 0.08, -0.32 }, { 0.07, -0.06, -0.24 } }, mirror = true },
	} :: { any },
	-- the four wings held together over the abdomen at rest (two pairs, a dark stigma near each tip), a blur in flight
	wings = {
		{ name = "Forewing", color = "wing", material = "Glass", root = { 0.02, 0.27, -0.42 }, length = 1.55, width = 0.17, thick = 0.006, yaw = 4, pitch = 3, roll = 70,
			transparency = 0.6, reflectance = 0.1, fan = { reach = 1.3, span = 0.6, roll = 6, yaw = 80, back = 0.0, rise = 0.02, transparency = 0.8 } },
		{ name = "Hindwing", color = "wing", material = "Glass", root = { 0.02, 0.27, -0.34 }, length = 1.5, width = 0.17, thick = 0.006, yaw = 2, pitch = 3, roll = 72,
			transparency = 0.6, reflectance = 0.1, fan = { reach = 1.25, span = 0.6, roll = 6, yaw = 100, back = 0.05, rise = 0.02, transparency = 0.8 } },
		{ name = "Stigma", color = "stigma", material = "SmoothPlastic", root = { 0.026, 0.27, 0.95 }, length = 0.08, width = 0.05, thick = 0.008, yaw = 4, pitch = 3, roll = 70,
			transparency = 0, reflectance = 0, hide = true, full = true },
	} :: { any },
	shadow = { size = { 0.5, 0.004, 2.6 }, lift = 0.003, transparency = 0.84, full = true },
	motion = { gait = { stride = 0.2, swing = 0.25, lift = 0.25, settle = 8, jump = 0.8 }, kick = 5, antenna = { amp = 0.02, hz = 0.5 }, flap = { hz = 25, amp = 0.5 }, ready = FlyLook.ready },
}

return FlyLook
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Graphics</string>
            <string name="Source"><![CDATA[--!strict
-- How the world looks, apart from the spider (whose look is Data/Appearances). Numbers and names only, so the whole look can
-- be tuned in one place: Habitat/Scenery builds the parts from it, Habitat/Lit sets up the lighting and the sky, Habitat/SunPick
-- finds a sun that shines in through the window, and Client/WorldDetail strips what the low tier does without.
-- Studs: 1 stud = 1 cm. Colours are hex. Materials are Roblox's own (Habitat/Materials), which carry PBR textures once
-- MaterialService.Use2022Materials is on (both Rojo projects set it). Nothing here has been seen in Roblox Studio (ROBLOX-14).

local Graphics = {}

-- ---------------------------------------------------------------- materials
-- Looks only: a surface's grip is its profile in Data/Surfaces, never its material.
Graphics.materials = {
	-- the physical pieces of the sill (Habitat/WindowsillLayout.PIECES), by id. SmoothPlastic is clean at any scale: the sill is
	-- cream enamel, the leaves are glossy; Roblox's textured materials tile in studs, so at 1 stud = 1 cm they are coarse.
	pieces = {
        cover_bark_west = "Wood", cover_bark_east = "Wood", cover_leaf_front = "SmoothPlastic", cover_rim = "Wood",
		upper_ledge = "Wood", garden_step = "Plaster",
		leaf_garden = "SmoothPlastic", stem_garden = "SmoothPlastic", leaf_high = "SmoothPlastic", stem_high = "SmoothPlastic",
		sill_floor = "SmoothPlastic", front_lip = "SmoothPlastic",
		back_frame_west = "Plaster", back_frame_east = "Plaster", back_frame_head = "Plaster", back_frame_rail = "Plaster", left_frame = "Plaster", right_frame = "Plaster",
		planter = "Plaster", planter_rim = "Plaster",
		leaf_west = "SmoothPlastic", leaf_middle = "SmoothPlastic", leaf_east = "SmoothPlastic", leaf_tip = "Plaster",
		stem_west = "SmoothPlastic", stem_middle = "SmoothPlastic", stem_east = "SmoothPlastic",
		crevice_back = "Wood", crevice_roof = "Wood", crevice_north = "Wood", crevice_south = "Wood",
	} :: { [string]: string },
	soil = "Ground",
	-- Glass hides translucent UV petals behind the pane in native Studio. Preserve tint/reflection without refraction.
	wall = "Plaster", trim = "SmoothPlastic", glass = "SmoothPlastic",
	view = "SmoothPlastic", ground = "Grass",
	chip = "Wood", crack = "SmoothPlastic", crumb = "Sand",
	fallback = "SmoothPlastic",
}

-- The colour (and shine) a piece is drawn in when it is not the layout's own colour, which is the frozen Godot habitat's: cream
-- enamel on the sill, plaster side walls, terracotta, weathered dark wood in the crevice. Looks only. Pieces the drawn Pilea
-- replaces keep the layout's colours, which show only if the drawing could not be built.
Graphics.paint = {
	sill_floor = { color = "e8dfcb", reflectance = 0.03 }, front_lip = { color = "e8dfcb", reflectance = 0.03 },
	left_frame = { color = "efe8d8" }, right_frame = { color = "efe8d8" },
	planter = { color = "b8653f" }, planter_rim = { color = "c97a52" },
	crevice_back = { color = "362b20" }, crevice_roof = { color = "4a3c2e" }, crevice_north = { color = "3f3326" }, crevice_south = { color = "3f3326" },
} :: { [string]: { color: string, reflectance: number? } }

-- ---------------------------------------------------------------- the window
-- The back wall is solid, climbable boxes (WindowsillLayout back_frame_*), so the window is drawn: the physical wall turns
-- invisible (still solid, still climbable) and Scenery draws a plaster wall behind its face with an opening for the glass.
Graphics.window = {
	-- the pieces that turn invisible: the back frame, in four since the lower sash was raised (ROBLOX-95: WindowsillLayout's back_frame_*)
	hidden = { "back_frame_west", "back_frame_east", "back_frame_head", "back_frame_rail" } :: { string },
	slabGap = 0.02, -- the drawn wall sits this far behind the climbable face, so the spider's feet never sink into it
	left = -27.5, right = 27.5, bottom = 3, top = 110.5, -- the opening: x from/to, y from/to (ROBLOX-112: the glass up to y 110.5, 13 before: a real window, 1.1 m)
	-- ROBLOX-112: the window in true proportion. The frame and the wall round it go up to the head (`head`, y 112.5, where the brick's lintel is) over the back frame's
	-- 14, standing in for World/Garden's window box above it (`upper`, the region wall_upper's: hidden once drawn here). The sashes meet at the transom (`transom`, its
	-- bottom, `transomH` tall) across all three lights; the middle light's lower sash, raised 6 cm (`opening`), has its top rail that much over the transom, set back
	-- in the frame as its bottom rail is, and its glass behind the upper sash's from the transom to there.
	head = 112.5, upper = "wall_upper_window", transom = 55.5, transomH = 2.5, sashLift = 6,
	trimWidth = 0.5, trimDepth = 0.10, trimReflectance = 0.04, -- the frame bars around the opening, flush with the climbable face; glossy
	wallColor = "efe8d8", trimColor = "f4efe3",
	glass = { color = "cfe3e6", transparency = 0.86, reflectance = 0.12, thickness = 0.04, setback = 0.05 },
	mullions = { -10, 10 }, mullionWidth = 0.7, -- bars between the panes
	-- ROBLOX-95: the middle lower sash is raised 6 cm. `opening` is the gap it leaves (the layout's own: back_frame_rail's top to back_frame_head's
	-- underside, between back_frame_west and back_frame_east), open air from the sill rail up to the sash; the glass over it is gone. The raised sash's
	-- bottom rail is drawn across the top of the opening (`sashRail` tall, `sashDepth` deep, set back `sashSetback` from the face), the jambs either side
	-- (`jambWidth`) line the cut through the wall, and the sill rail is trim.
	opening = { left = -8, right = 8, bottom = 0.7, top = 6 },
	sashRail = 0.8, sashDepth = 0.45, sashSetback = 0.12, jambWidth = 0.5,
	-- WindowsillLayout.DECOR entries Scenery draws itself
	replaces = { window_glass = true, mullion_w = true, mullion_e = true } :: { [string]: boolean },
}

-- ---------------------------------------------------------------- the view out of the window
-- Items are placed as seen from a reference eye (the camera's usual spot over the middle of the sill): u, v are where the
-- item's centre appears on the glass (studs across and up), `depth` how far beyond the glass it really is; Scenery turns
-- that into world positions and sizes, so every item shows where it should whatever the depth. kind "block": a box w x h
-- on the glass, `t` deep; "ball": a sphere of diameter w; "roof": a gable (a square turned 45 degrees) w wide with its
-- eave line at v; "hill" (ROBLOX-103): a flattened ellipsoid w x h x t; "trunk" (ROBLOX-103): a round upright rod w across and h tall. `full`: dropped in the
-- low tier.
Graphics.view = {
	eye = Vector3.new(0, 2.5, 5),
	-- ROBLOX-95: the lawn is at the garden's level now, 0.4 below the soil of the bed under the window (World/WorldMap bed_a, y -90), where the house wall
	-- meets it; it was at -46 when nothing could be walked outside the glass. Everything below stands on it (the trunks and a house were lengthened to reach it).
	-- ROBLOX-114 (everything to scale): `beyond`: a second ground of the same size past the first's far edge (z -1748), under the gardens and the houses across the
	-- way, which stand 21 m from this house's back wall now (a part is at most 2,048 studs: one ground could not reach them)
	ground = { y = -90.4, size = 2048, color = "7d8f62", beyond = true },
	sky = true,
	items = {
		-- far hills (ROBLOX-103: kind "hill", a flattened ellipsoid w x h x t on the glass, low and wide, their feet under the horizon; the middle one shows only over
		-- the roofs; the balls of before stood inside the garden once it could be walked). ROBLOX-114: 36 m off (27 before), behind the bungalows now that those stand
		-- 21 m from this house; a part is at most 2,048 studs, so Scenery draws a hill bigger than that as a part of 2,048 with its sphere mesh scaled up. They are
		-- the near rise of the land beyond the houses, not a range kilometres off (no part could stand that far and be seen), and lower than they were (their tops 1.2
		-- lower on the glass, their feet where they were): at their old height and 36 m off they stood 9 to 11 m tall over the bungalows' 5 m ridges, a dome, not a rise.
		{ id = "hill_w", kind = "hill", u = -20, v = 4.0, depth = 3600, w = 13.2, h = 4.4, t = 13.2, color = "88a08d", full = false },
		{ id = "hill_m", kind = "hill", u = 2, v = 3.6, depth = 3600, w = 13.2, h = 3.6, t = 13.2, color = "92a898", full = true },
		{ id = "hill_e", kind = "hill", u = 22, v = 3.9, depth = 3600, w = 13.2, h = 4.4, t = 13.2, color = "8aa28f", full = false },
		-- (ROBLOX-103: the seven tall houses that stood 1.2 m beyond the glass are Graphics.view.across's bungalows beyond the back fence)
		-- a tree on the left, a smaller one on the right. ROBLOX-103: they stood 72 and 100 studs beyond the glass, lollipops a metre tall just past the bed (the
		-- standards Nathan's "bushes" note was about); now they are real trees in the neighbours' gardens beyond the side fences, 7.4 and 9 m out, the left 5 m tall
		-- with a crown nearly 5 m across, the right 3.5 m, exactly where they were on the glass; their trunks are round ("trunk": a vertical rod w across, h tall).
		-- ROBLOX-114 (to scale): at their depths a stud on the glass is 43.4 (the left) and 52.4 (the right) in the garden, so the left tree is 7.2 m tall with a crown
		-- 9.8 m across (an old apple or a field maple) and the right 5.1 m with one 6.3 m across; their trunks were 56 and 47 cm thick, an oak's, and are 33 and 24 cm
		-- now (w 0.75 and 0.45), a garden tree's trunk for those heights (a judgement from the trees' proportions, not a measured rule: urban trees vary widely,
		-- Vaz Monteiro, Doick & Handley 2016, Urban Forestry & Urban Greening).
		{ id = "trunk_a", kind = "trunk", u = -17, v = 5.43, depth = 742, w = 0.75, h = 10.14, color = "4a3e30", full = false },
		{ id = "canopy_a1", kind = "ball", u = -17, v = 10.5, depth = 742, w = 11, color = "3f6238", full = false },
		{ id = "canopy_a2", kind = "ball", u = -23.5, v = 8.5, depth = 742, w = 8.5, color = "496f40", full = false },
		{ id = "canopy_a3", kind = "ball", u = -10.5, v = 9.0, depth = 742, w = 8, color = "35552f", full = true },
		{ id = "canopy_a4", kind = "ball", u = -19.5, v = 13.5, depth = 742, w = 7, color = "446a3b", full = true },
		{ id = "canopy_a5", kind = "ball", u = -13.5, v = 13.2, depth = 742, w = 6.5, color = "3a5c34", full = true },
		{ id = "canopy_a6", kind = "ball", u = -26, v = 12, depth = 742, w = 6, color = "4d7544", full = true },
		{ id = "trunk_b", kind = "trunk", u = 18.5, v = 3.96, depth = 900, w = 0.45, h = 6.47, color = "50443a", full = true },
		{ id = "canopy_b1", kind = "ball", u = 18.5, v = 7.2, depth = 900, w = 6.5, color = "47703e", full = true },
		{ id = "canopy_b2", kind = "ball", u = 22, v = 6.2, depth = 900, w = 5, color = "3d6336", full = true },
		{ id = "canopy_b3", kind = "ball", u = 15, v = 6.0, depth = 900, w = 4.5, color = "4f7746", full = true },
	} :: { { id: string, kind: string, u: number, v: number, depth: number, w: number, h: number?, t: number?, color: string, full: boolean } },
	-- ROBLOX-103 (W3c, Nathan: "the house a single story"): the houses across the way are bungalows, one storey under a pitched roof, standing where they
	-- would really stand, in the garden's own studs: their fronts `front` (z) beyond the back fence, `wall` tall (2.6 m), `depth` deep, the roof's front slope
	-- rising at `pitch` degrees from eaves that overhang `overhang` to a ridge over the middle; one row of windows and a door, so nothing reads as a second floor.
	-- Each house: `x` its middle, `w` its width, its render and roof colours, how many windows, a door, a chimney (`chimney`: where along the ridge, -0.5 to 0.5).
	-- The low tier keeps the walls and the roofs. ROBLOX-114 (to scale): their faces stood 40 cm behind the back fence, as if they had no gardens; they stand at z -2150
	-- now, 21 m from this house's back wall (the usual British least distance between facing windows of one- and two-storey houses: Cheshire East
	-- Local Plan, policy HOU 13), their gardens 7.3 m deep behind the fence. Ridge 2.6 m + tan 30 x 4.3 m = 5.1 m above the lawn (a bungalow's ridge is about
	-- 4.5 to 5.5 m).
	across = {
		front = -2150, depth = 800, wall = 260, pitch = 30, overhang = 30, ridgeCap = 14,
		window = { w = 120, h = 115, sill = 95, color = "3c4852", frame = "f1ede4" }, door = { w = 95, h = 205, color = "5b4636" },
		chimney = { w = 55, h = 120, t = 55, color = "8c5a48" },
		wallMaterial = "Plaster", roofMaterial = "Slate",
		houses = {
			{ id = "bungalow_1", x = -680, w = 600, wall = "d2bf98", roof = "7d3b2c", windows = 2, door = true, chimney = 0.28 },
			{ id = "bungalow_2", x = 30, w = 760, wall = "dccaa4", roof = "4c4f57", windows = 3, door = false, chimney = -0.3 },
			{ id = "bungalow_3", x = 720, w = 520, wall = "c9b48f", roof = "8a4532", windows = 2, door = true },
		} :: { { id: string, x: number, w: number, wall: string, roof: string, windows: number, door: boolean, chimney: number? } },
	},
	-- ROBLOX-103: the garden's fences (docs/WORLD_MAP_PLAN.md: 10 m wide, 14 m deep): the back fence at `back` and the two side fences along x `x0`, `x1`, from the
	-- house's wall to the back fence, `height` tall (1.8 m), weathered boards; posts along the back (full tier).
	fence = { back = -1420, x0 = -500, x1 = 500, near = -24, height = 180, thick = 4, posts = 6, post = 9, color = "8a6f52", postColor = "6f5841", material = "WoodPlanks" },
}

-- ---------------------------------------------------------------- small details on the sill (full tier only)
-- Flat or tiny, away from the spawn and the silk practice spot, so the landing patch, the silk lines and the prompts stay clear.
Graphics.details = {
	-- chips in the paint, showing the bare wood: where (x, z), size (w across, d deep), turn in degrees, colour
	chips = {
		{ x = -8.6, z = 10.5, w = 0.62, d = 0.40, turn = 20, color = "9b7650" }, { x = -7.7, z = 10.9, w = 0.34, d = 0.27, turn = -35, color = "8f6b47" }, { x = -6.6, z = 10.2, w = 0.45, d = 0.30, turn = 70, color = "9b7650" },
		{ x = 11.6, z = 9.8, w = 0.55, d = 0.38, turn = -15, color = "9b7650" }, { x = 12.5, z = 10.3, w = 0.30, d = 0.22, turn = 50, color = "a58058" }, { x = 24.6, z = 7.9, w = 0.50, d = 0.33, turn = 35, color = "9b7650" },
		{ x = -3.8, z = 5.4, w = 0.36, d = 0.26, turn = -60, color = "8f6b47" }, { x = -14.9, z = 8.6, w = 0.58, d = 0.36, turn = 10, color = "9b7650" }, { x = -15.6, z = 8.1, w = 0.28, d = 0.20, turn = -25, color = "a58058" },
		{ x = 27.0, z = 11.0, w = 0.70, d = 0.45, turn = 0, color = "9b7650" }, { x = 20.5, z = 5.0, w = 0.40, d = 0.30, turn = 80, color = "8f6b47" }, { x = 0.5, z = 8.8, w = 0.32, d = 0.24, turn = -10, color = "9b7650" },
	},
	chipThickness = 0.012,
	-- cracks in the sill: polylines of x, z points; the first is the main crack, the others branch off it
	cracks = {
		{ { -11.0, 9.9 }, { -9.4, 8.9 }, { -8.3, 9.3 }, { -6.5, 7.9 }, { -5.7, 8.2 }, { -3.2, 6.6 } },
		{ { -6.5, 7.9 }, { -5.9, 6.7 }, { -6.3, 5.9 } },
	},
	crackWidth = 0.05, crackColor = "4d3d2e", crackHeight = 0.004,
	-- crumbs: centre (x, y, z), size (sx, sy, sz), turn in degrees, colour
	crumbs = {
		{ x = 14.6, y = 0.11, z = 8.6, sx = 0.34, sy = 0.22, sz = 0.27, turn = 25, color = "d6b684" },
		{ x = 14.95, y = 0.07, z = 8.75, sx = 0.20, sy = 0.14, sz = 0.16, turn = -40, color = "c9a56f" },
		{ x = 14.3, y = 0.045, z = 8.3, sx = 0.12, sy = 0.09, sz = 0.10, turn = 70, color = "e0c493" },
	},
}

-- ---------------------------------------------------------------- lighting
Graphics.lighting = {
	brightness = 2.6,
	ambient = { 70, 66, 58 }, outdoorAmbient = { 150, 146, 132 },
	colorShiftTop = { 255, 240, 214 }, -- a soft warm sun
	environmentDiffuse = 1, environmentSpecular = 1,
	shadowSoftness = 0.2, exposureCompensation = 0.1,
	clockTime = 9.6, latitude = 40.7, -- used when no through-window sun can be found (SunPick)
}
-- SunPick looks for a time of day whose sun stands behind the window and low enough to shine in across the sill.
Graphics.sun = {
	elevationDeg = 30, minElevationDeg = 18, maxElevationDeg = 48,
	azimuthDeg = 30, maxAzimuthDeg = 65, -- angle between straight out of the window (-Z) and the sun's heading
	clockFrom = 7, clockTo = 17, clockStep = 0.25,
}
-- Day and night (ROBLOX-24, after Godot's LIFE-06). The life clock's daylight (0 night to 1 day) blends the daytime values above
-- toward these. At full daylight everything is exactly the daytime look. The sun: Roblox puts the sun from ClockTime, so the
-- day keeps the through-the-window clock SunPick chose, and dusk runs that morning backwards toward `nightClock`, before
-- sunrise, so the sun sinks on the window's side and the sky goes dark with stars; dawn runs it forwards again. Night is dim
-- and blue, never black. Every number is a first guess until it is seen in Studio.
Graphics.dayNight = {
	nightClock = 4.0, -- ClockTime at full night (the sun well below the horizon)
	brightness = 0.6, -- Lighting.Brightness at night (the moon's light)
	ambient = { 38, 42, 58 }, outdoorAmbient = { 58, 68, 98 },
	exposureCompensation = -0.25,
	lowSunColorShiftTop = { 255, 196, 150 }, -- the colour of a low sun; white again by daylight warmFrom (Godot: smoothstep 0 to 0.6)
	warmFrom = 0.6,
	atmosphereColor = { 70, 82, 112 }, atmosphereDecay = { 92, 84, 110 },
	motesAtNight = 0.15, -- the dust motes' brightness at night (they catch the sun by day)
	applyStep = 0.002, -- the light is set again once daylight has changed by this much (and whenever it reaches 0 or 1)
}
Graphics.atmosphere = { density = 0.30, offset = 0.25, color = { 199, 215, 232 }, decay = { 232, 196, 150 }, glare = 0.3, haze = 1.0 }
Graphics.sky = { sunAngularSize = 12, moonAngularSize = 11, starCount = 3000 }
Graphics.clouds = { cover = 0.45, density = 0.5, color = { 250, 248, 240 } }
Graphics.bloom = { intensity = 0.45, size = 24, threshold = 1.4 }
Graphics.grade = { contrast = 0.1, saturation = 0.1, tint = { 255, 246, 232 }, brightness = 0 }
Graphics.sunRays = { intensity = 0.05, spread = 0.7 }
-- Macro depth of field: on in the full tier unless the Workspace attribute DepthOfField is false. The sill stays sharp (everything
-- within `radius` of the focus, which the client sets to the camera-to-spider distance) and the garden outside the window melts
-- into soft bokeh. Nothing near is blurred.
Graphics.depthOfField = { far = 0.3, near = 0, focus = 6, radius = 18 }

-- ---------------------------------------------------------------- dust motes and light shafts
Graphics.dust = {
	at = Vector3.new(0, 6.1, -1), size = Vector3.new(56, 11, 22),
	rate = 7, lifetime = { 14, 18 }, speed = { 0.04, 0.16 }, particle = { 0.05, 0.11 },
	transparency = 0.55, lightEmission = 0.55, lightInfluence = 0.35, color = "fff0d2",
	texture = "rbxasset://textures/particles/smoke_main.dds",
}
-- Soft shafts of light from the window along the sun, a few stacked translucent ribbons each (full tier only).
Graphics.shafts = {
	x = { -18.75, 0, 18.75 }, -- where along the window each starts (the middle of each pane)
	startY = 11.5, -- height on the glass where a shaft starts
	grow = 1.25, -- how much wider a shaft is where it reaches the floor
	layers = { { 2.4, 0.972 }, { 4.0, 0.982 }, { 6.0, 0.99 } }, -- width, transparency
	lightEmission = 0.5, color = "fff0d2",
}

-- ---------------------------------------------------------------- detail tiers
Graphics.tiers = {
	full = { dustRate = 1.0 },
	low = { dustRate = 0.4 }, -- also drops everything built with FullOnly: bloom, sun rays, clouds, shafts, details, the busier view
}

return Graphics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">MatingRules</string>
            <string name="Source"><![CDATA[--!strict
-- The mating cycle's numbers (ROBLOX-79). Game tuning, not measurements: Predator/Mate and Life/Mating read these and nothing else decides them.
-- The cycle: a full-grown, well-fed spider rests; the next morning a mate comes onto the sill; courting it fills a meter; they mate and the male leaves;
-- the next night's sleep in the crack makes the egg sac; two days of guarding; the eggs hatch and the player carries on as one of the spiderlings.
local MatingRules = {}

-- Eligibility, tested at a rest in the crack: the spider is full-grown (Growth's last stage) and has at least this much energy (the hunger bar at 60%).
MatingRules.energyMin = 0.6
-- The mate arrives by the rival's rules (Data/RivalRules, ROBLOX-68): not on the first day, from the morning (the spider's waking hour), not while the
-- spider rests or the wasp visits, not while the spider is within arriveDistance of where it would arrive. It is also not brought in the afternoon: from
-- arriveUntil a visit that has not begun is not begun (it comes tomorrow). The mate goes at leaveHour, the evening (LifeClock.EVENING_H).
MatingRules.firstDay = 2
MatingRules.arriveHour = 7.0
MatingRules.arriveUntil = 16.0
MatingRules.leaveHour = 18.0
MatingRules.arriveDistance = 8.0
MatingRules.arriveAt = Vector3.new(26.0, 0.31, 3.0) -- the east end of the floor, away from the crack at the west end
-- One mate at a time, for at most this many days (mornings it comes); then a new mate, the next morning.
MatingRules.visitsMax = 3

-- Courtship. The player is near the mate (within nearWu), standing still, facing it (the mate within faceDeg of where the player looks) and, for the
-- peacock spider, dancing. The meter then fills over courtSeconds; moving, leaving, turning away or being airborne drains it at decayPerSecond (twice
-- as fast as it fills). While the dance is the only thing missing the meter holds. Jumping at the mate (airborne within jumpAtWu) or striking it
-- (the strike's sweep within strikeWu) drives it off for the day.
MatingRules.courtSeconds = 8.0
MatingRules.decayPerSecond = 0.25
MatingRules.nearWu = 3.0
MatingRules.attendWu = 2.0 -- an interested mate walks up to the spider and stops this far from it
MatingRules.loseWu = 6.0 -- the spider is gone from its attention beyond this (or out of sight for loseSeconds)
MatingRules.loseSeconds = 3.0
MatingRules.faceDeg = 40.0
MatingRules.strikeWu = 0.65
MatingRules.jumpAtWu = 2.0
-- The pause together (ROBLOX-89: it was five seconds and one caption). The mating is a scene of `sceneSeconds` in four beats (Life/MatingScene: she turns, they touch,
-- they settle, one goes). A male mate is together with the spider for `pairSeconds` (the first three beats) and then walks off the sill during the last beat; a female
-- mate (the peacock spider is the male) stays through the whole scene (`stayPairSeconds`), turns away and settles in the last beat, and walks off after it. The scene may
-- be skipped after `skipAfter` seconds, or at once when a wasp comes (nothing keeps the player in the open); then the mate walks off as it always did.
MatingRules.sceneSeconds = 15.0
MatingRules.pairSeconds = 11.0
MatingRules.stayPairSeconds = 15.0
MatingRules.skipAfter = 4.0
-- A mate that leaves (driven off, at dusk, after mating) walks to the edge of the sill, the back corner of the east end of the floor (the waypoint
-- there); it is gone within exitRadius of it, or after leaveSeconds, whichever is first.
MatingRules.leaveSeconds = 120.0
MatingRules.exitAt = Vector3.new(26.4, 0.31, -10.84)
MatingRules.exitRadius = 1.5

-- The mate is drawn with the played spider's look, scaled: a male mate slimmer and smaller, a female mate larger; each mate varies by up to +-scaleSpread
-- about it (a seeded draw from the mate's number).
-- ROBLOX-114 (to scale): the first spider's adult is drawn 14.9 mm long and its mate is a male, so at 0.9 he was up to 14.1 mm, past Phidippus audax's adult males
-- (6 to 13 mm, Wikipedia); at 0.85 he is 12.0 to 13.3. The peacock spider's mate is a female on its 5.0 mm adult; at 1.15 she was up to 6.0 mm against the species'
-- "about 5 mm" for both sexes (Wikipedia, Maratus volans); at 1.05 she is 5.0 to 5.5.
MatingRules.scale = { male = 0.85, female = 1.05 } :: { [string]: number }
MatingRules.scaleSpread = 0.05

-- After mating: the egg sac is made by the next sleep that reaches the morning. It is guarded for guardDays full days (surviving is guarding; nothing can
-- harm the sac), and the eggs hatch on the morning after the last. The brood is a seeded handful for the hatching scene.
MatingRules.guardDays = 2
MatingRules.broodMin = 8
MatingRules.broodMax = 12
-- Where the sac hangs in the retreat, and its size (the crack's interior is x -27.8 to -23.3, z 3 to 9).
MatingRules.sacAt = Vector3.new(-27.1, 0.5, 8.4)
MatingRules.sacRadius = 0.42
-- ROBLOX-106 (W4, Nathan: "mating should not automatically be successful"; "not even mating is a guarantee if you find the mate"): the standard rules only (the client
-- hands `nature` in the snapshot when the rules are not gentle and `on` is true; Easy, Free play and a snapshot without it are as before: a full meter is a mating).
-- When the meter fills the mate decides, by a draw of its own (the world's seed, the mate's number, its visit and the courts so far, all in the record): the chance is
-- `base` x the spider's condition x the courtship's quality. Condition: the reserve, from 0 at `energyLow` up to 1 at `energyFull`, never under `conditionFloor`. Quality, over
-- the court (from the meter's first rise to its fill): each time the spider broke off (moved, turned away, left) costs (1 / (1 + breakCost x breaks)); its mean distance
-- while courting costs up to `farCost` from attendWu (where the mate stands, 1) out to nearWu; the share of the court spent not facing it up to `awayCost`; a court that
-- took more than 1.5 x courtSeconds loses in proportion, to at most `longFloor`. The numbers: a still, close, facing court by a well-fed spider (0.8 or more) is
-- accepted 0.9 of the time; at 0.6 (the least a visitor comes for) 0.5; with two breaks at full condition 0.53; a thin, halting court (0.6, two breaks) 0.3.
-- Refused, the mate walks off for the day ("rejected"), and the words say what weighed most: the spider's condition ("thin"), the court ("clumsy"), or, when both
-- were at least `fairAt`, neither ("choosy": the mate's own choice, the base's 0.1); one may come again the next morning. And on each visit, with `cutChance`, the rival will cut in when the meter
-- passes a drawn level (`cutLevel`) if it is free on the sill within `cutWu` of the mate then: the mate flees for the day ("cut"). The rival that has been eaten, or
-- taken by the wasp, cuts in on nothing.
MatingRules.game = {
	on = true, base = 0.9, energyLow = 0.35, energyFull = 0.8, conditionFloor = 0.3,
	breakCost = 0.35, farCost = 0.3, awayCost = 0.5, longFloor = 0.6, fairAt = 0.85,
	cutChance = 0.35, cutLevel = { 0.35, 0.85 }, cutWu = 10.0,
}

-- A new generation starts like a new life: the first growth stage and this much energy (NeedsModel.ENERGY_START); the day count goes on.
MatingRules.freshEnergy = 0.55

return MatingRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Meshes</string>
            <string name="Source"><![CDATA[--!strict
-- The preserve's first meshes (ROBLOX-126; docs/MESHES.md, assets/meshes/manifest.json): original Blender studies by Chet, uploaded by socranates and verified
-- in Studio at their authored size (1 stud = 1 cm). A drawn record whose shape is "Mesh:<name>" is drawn with one of these (Habitat/Scenery.look): a
-- SpecialMesh FileMesh on a drawn-only part, scaled to the record's size, its long horizontal axis turned onto the record's. Visual only: nothing walks on
-- them, the walkable boxes under them are as they were.
local Meshes = {}

export type Mesh = { id: string, size: Vector3, triangles: number }

Meshes.TEXTURE = "rbxassetid://116765351721069" -- the shared colour atlas

Meshes.list = {
	grass_clump = { id = "rbxassetid://93421946013090", size = Vector3.new(9.739530, 26.041445, 11.812691), triangles = 1400 },
	milkweed_leaf = { id = "rbxassetid://128470594939908", size = Vector3.new(7, 2.125, 19.5), triangles = 1466 },
	coneflower_head = { id = "rbxassetid://136400030278193", size = Vector3.new(10.344988, 3.975, 10.288317), triangles = 4948 },
	bark_chip = { id = "rbxassetid://90087253428470", size = Vector3.new(4.599804, 0.684588, 9), triangles = 1496 },
	stone = { id = "rbxassetid://93673725524671", size = Vector3.new(5.345497, 1.815153, 3.794619), triangles = 320 },
	bench_slat_end = { id = "rbxassetid://109006316168913", size = Vector3.new(14, 3.2, 10), triangles = 188 },
} :: { [string]: Mesh }

-- The mesh a record's shape names, or nil ("Mesh:milkweed_leaf" -> the leaf).
function Meshes.of(shape: string?): Mesh?
	if shape == nil or string.sub(shape, 1, 5) ~= "Mesh:" then return nil end
	return Meshes.list[string.sub(shape, 6)]
end

-- How a mesh fits a record's box: whether to turn it a quarter (its long horizontal axis onto the box's) and the SpecialMesh's Scale (box / native, axis by axis,
-- after the turn). The part keeps the record's size and place; only the mesh is scaled.
function Meshes.fit(mesh: Mesh, size: Vector3): (boolean, Vector3)
	local n = mesh.size
	local turn = (n.Z > n.X) ~= (size.Z > size.X) and math.abs(n.Z - n.X) > 1e-6 and math.abs(size.Z - size.X) > 1e-6
	local sx, sz = if turn then size.Z else size.X, if turn then size.X else size.Z
	return turn, Vector3.new(sx / n.X, size.Y / n.Y, sz / n.Z)
end

return Meshes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">NotebookPages</string>
            <string name="Source"><![CDATA[--!strict
-- The naturalist's notebook pages (LEARN-01), GENERATED by tools/gen_notebook_pages.py from the frozen Godot
-- data/notebook/pages.json. Do not edit by hand. Ids, triggers, titles and sources are Godot's, word for word, and so are the texts
-- except four sentences the audit of 2026-10-19 corrected (the generator's TEXT_FIXES): those pages keep Godot's whole text as `godotText`. The pages after
-- Godot's are the Roblox game's own (the generator's ROBLOX_PAGES), with their own triggers.
-- docs/NOTEBOOK_SOURCES.md says how far each source was checked: every citation was confirmed; a few papers were opened and read in part
-- (that file says which and which parts), none was read in full, and the other pages rest on abstracts, search snippets or textbook knowledge.
-- `game` is the page's "In this game" line: Godot's own where it is true of the Roblox game, otherwise the Roblox one,
-- with Godot's kept as `godotGame` (tests/notebook.luau lists exactly which). {reel}, {letGo}, {drop}, {focus} and {display} are filled
-- in with the name of that control on the device in use. Pages are listed in Godot's order.
-- Numbers: the thresholds Godot's field_notebook.gd and notebook_watch.gd use for the moments that open a page.
local NotebookPages = {}

export type Page = { id: string, trigger: string, title: string, text: string, game: string, godotGame: string?, godotText: string?, sources: { string } }

-- Every trigger a page may name (Godot field_notebook.gd TRIGGERS). "eye_time_N": N seconds in the spider-eye view, all told.
NotebookPages.triggers = {
	"start",
	"jump",
	"jump_far",
	"jump_long",
	"eye_view",
	"eye_time_20",
	"eye_time_60",
	"shimmer",
	"fly_recognised",
	"catch",
	"meal",
	"felt",
	"buzz",
	"rest",
	"sleep",
	"hungry",
	"well_fed",
	"moult_ready",
	"moulted",
	"adult",
	"wasp",
	"wasp_escaped",
	"wasp_caught",
	"starving",
	"dance",
	"antennae",
	"hatched",
	"tarantula",
	"garden_bed",
	"look_springtail",
	"look_leafhopper",
	"look_moth",
	"look_crane_fly",
	"look_ladybird",
	"look_millipede",
	"look_snail",
	"look_harvestman",
	"look_hoverfly",
	"cat",
	"crab_spider",
	"robin",
	"look_cricket",
	"water",
	"frog",
	"look_midge",
	"look_mosquito",
	"look_damselfly",
	"look_skater",
	"darner",
	"rare_luna",
}

-- The reserve at or under hungryAt is "hungry"; at or over wellFedAt, "well fed" (LIFE_DESIGN.md round 1).
NotebookPages.hungryAt = 0.25
NotebookPages.wellFedAt = 0.85
-- A leap at least this long (studs, launch to landing point; one stud is a centimetre) is far; at least jumpLongWu is long.
NotebookPages.jumpFarWu = 5.0
NotebookPages.jumpLongWu = 8.0
-- Seconds in the spider-eye view, all told, that open the pages named eye_time_N.
NotebookPages.eyeMarks = { 20, 60 }
-- A fly taking off this close (studs) is heard (Godot soundscape.gd HEAR_WU, which gave the caption the buzz page answered to).
NotebookPages.hearWu = 10.0
-- How long the note that a page opened stays on the screen (Godot notebook_panel.gd NOTE_S).
NotebookPages.noteSeconds = 6.0
-- ROBLOX-101: a prey of the bestiary within this many studs of the spider is a close look, which opens its kind's page (`looks`: prey kind -> trigger).
NotebookPages.lookWu = 4.0
-- ROBLOX-105: the ambient bugs' close looks too (NotebookWatch: one of the view's bugs of the kind, out in the open, within lookWu).
NotebookPages.looks = { springtail = "look_springtail", leafhopper = "look_leafhopper", moth = "look_moth", crane_fly = "look_crane_fly",
	ladybird = "look_ladybird", millipede = "look_millipede", snail = "look_snail", harvestman = "look_harvestman", hoverfly = "look_hoverfly", cricket = "look_cricket",
	midge = "look_midge", mosquito = "look_mosquito", damselfly = "look_damselfly", skater = "look_skater" } :: { [string]: string }

NotebookPages.pages = {
	{
		id = "bold_jumper",
		trigger = "start",
		title = "The bold jumping spider",
		text = "The first spider is inspired by the bold jumping spider, Phidippus audax. It lives across much of North America, often on walls, fences and windowsills. Adults are about 6 to 15 millimetres long, and females are usually bigger than males. Look for its shining green-blue fangs and the pale spots on its black abdomen.",
		game = "The first spider is inspired by the bold jumper. The peacock spider, the ant mimic and the two tarantulas are costumes on the same body: other species, the same game rules. Our models and four growth stages (three moults) are stylised; one stud represents a centimetre.",
		godotGame = "This windowsill is built at true scale: one game unit is one centimetre, about the length of the spider.",
		sources = {
			"Edwards, G. B. (2004). Revision of the jumping spiders of the genus Phidippus (Araneae: Salticidae). Occasional Papers of the Florida State Collection of Arthropods 11.",
		},
	},
	{
		id = "dragline",
		trigger = "jump",
		title = "A line before every leap",
		text = "Before it jumps, a jumping spider usually fixes a silk line to the surface behind it. In the air the line helps keep its body steady, and if it misses, it can hang from the line and climb back. Spiders of the species Hasarius adansoni landed more steadily when they had their line.",
		game = "The spider here fixes a safety line when it leaps, where the surface holds silk, and a missed jump leaves it hanging. On the line, {reel} reels in and holding {letGo} lets go. {drop} lets it down on its line; hold it to keep lowering.",
		godotGame = "The spider here dips its abdomen to fix the line, and a missed jump leaves it hanging. Reel in with W / stick up; let go with Q / B. F / D-pad down lets it down on its line from anywhere; hold it to keep lowering.",
		sources = {
			"Chen, Y.-K., Liao, C.-P., Tsai, F.-Y. & Chi, K.-J. (2013). More than a safety line: jump-stabilizing silk of salticids. Journal of the Royal Society Interface 10: 20130572. https://pmc.ncbi.nlm.nih.gov/articles/PMC3758018/",
		},
	},
	{
		id = "legs_push",
		trigger = "jump_far",
		title = "Legs that push",
		text = "Jumping spiders have no giant jumping legs like a grasshopper. High-speed films of Phidippus regius show the third and fourth pairs of legs straightening at take-off. Spiders can stretch some leg joints by raising their blood pressure, but that study found the leg muscles could supply the power for a jump.",
		game = "In this game the spider braces and crouches before a jump, then pushes off with its back legs. Both are drawn poses, not measurements.",
		godotGame = "Watch the back legs straighten as the spider leaves the surface.",
		sources = {
			"Nabawy, M. R. A., Sivalingam, G., Garwood, R. J., Crowther, W. J. & Sellers, W. I. (2018). Energy and time optimal trajectories in exploratory jumps of the spider Phidippus regius. Scientific Reports 8: 7142. https://doi.org/10.1038/s41598-018-25227-9",
		},
	},
	{
		id = "eight_eyes",
		trigger = "eye_view",
		title = "Eight eyes, different jobs",
		text = "Jumping spiders have eight eyes. The two big front eyes see sharp detail, but only in a narrow field. The eyes beside them watch for movement, and the others look out to the sides and behind, so the spider can notice something almost anywhere and turn to look at it.",
		game = "The spider-eye view is an impression made from this research, not a recording of what a spider sees.",
		sources = {
			"Land, M. F. (1969). Movements of the retinae of jumping spiders (Salticidae: Dendryphantinae) in response to visual stimuli. Journal of Experimental Biology 51: 471-493. https://doi.org/10.1242/jeb.51.2.471",
			"Zurek, D. B., Taylor, A. J., Evans, C. S. & Nelson, X. J. (2010). The role of the anterior lateral eyes in the vision-based behaviour of jumping spiders. Journal of Experimental Biology 213: 2372-2378. https://doi.org/10.1242/jeb.042382",
		},
	},
	{
		id = "moving_retinas",
		trigger = "eye_time_20",
		title = "Eyes that look without turning",
		text = "The big front eyes cannot turn: their lenses are fixed in the head. Instead, the retina at the back of each eye moves. It sweeps from side to side and slowly twists, so the spider can scan what it is looking at without moving its body.",
		game = "The two sharp strips that sweep and twist in the eye view show this.",
		sources = {
			"Land, M. F. (1969). Movements of the retinae of jumping spiders (Salticidae: Dendryphantinae) in response to visual stimuli. Journal of Experimental Biology 51: 471-493. https://doi.org/10.1242/jeb.51.2.471",
		},
	},
	{
		id = "motion_first",
		trigger = "shimmer",
		title = "Movement first, shape later",
		text = "The eyes beside the big front pair are motion detectors. When everything but these eyes was covered, jumping spiders of the Australian species Servaea vestita still turned toward moving dots and even stalked flies. These eyes can notice a movement smaller than the gap between their own light-sensing cells.",
		game = "The shimmering ring in the eye view shows something the side eyes saw moving before the front eyes can tell what it is.",
		sources = {
			"Zurek, D. B., Taylor, A. J., Evans, C. S. & Nelson, X. J. (2010). The role of the anterior lateral eyes in the vision-based behaviour of jumping spiders. Journal of Experimental Biology 213: 2372-2378. https://doi.org/10.1242/jeb.042382",
			"Zurek, D. B. & Nelson, X. J. (2012). Hyperacute motion detection by the lateral eyes of jumping spiders. Vision Research 66: 26-30.",
		},
	},
	{
		id = "hunting_by_sight",
		trigger = "fly_recognised",
		title = "A hunter that uses its eyes",
		text = "Jumping spiders catch their food without a web. A hunt usually goes like this: turn to face a movement, look at it with the big front eyes, creep closer, crouch, and leap.",
		game = "Here the spider becomes surer of what something is the longer it looks at it.",
		sources = {
			"Jackson, R. R. & Pollard, S. D. (1996). Predatory behavior of jumping spiders. Annual Review of Entomology 41: 287-308.",
		},
	},
	{
		id = "venom",
		trigger = "catch",
		title = "The bite",
		text = "A jumping spider grips its catch with its front legs and fangs and bites. The venom soon stops the prey from struggling.",
		game = "In this game the fly weakens over several seconds as the venom works.",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
		},
	},
	{
		id = "drinking",
		trigger = "meal",
		title = "A meal you drink",
		text = "Spiders cannot swallow solid food. They digest their meal partly outside the body: they pour digestive juices onto the prey and suck up the liquid food.",
		game = "",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
		},
	},
	{
		id = "felt",
		trigger = "felt",
		title = "Feeling through the feet",
		text = "Spiders feel vibrations through tiny slits in the hard skin of their legs, called slit sensilla. A group of them near the end of each leg picks up very small shakes of the surface the spider stands on.",
		game = "The ripple on the screen and the low thrum stand in for this. A vibration reaches the spider only through touching surfaces, never across a gap.",
		sources = {
			"Barth, F. G. (2002). A Spider's World: Senses and Behavior. Springer.",
		},
	},
	{
		id = "hearing",
		trigger = "buzz",
		title = "Hearing without ears",
		text = "Jumping spiders have no ears, yet the bold jumping spider responds to low sounds. In experiments these spiders froze at a low hum, and cells in their brains answered to sounds of 80 to 380 vibrations a second, even from more than 3 metres away. Fine hairs on the legs, moved by the air, probably do the hearing.",
		game = "Buzzing is a human-audible cue, not a recording of what a spider experiences.",
		godotGame = "The fly's buzz you hear here is about 200 vibrations a second, inside that range.",
		sources = {
			"Shamble, P. S., Menda, G., Golden, J. R., et al. (2016). Airborne acoustic perception by a jumping spider. Current Biology 26: 2913-2920. https://doi.org/10.1016/j.cub.2016.08.041",
		},
	},
	{
		id = "retreat",
		trigger = "rest",
		title = "A silk retreat",
		text = "Jumping spiders do not build webs to catch food, but they do spin retreats: small tents of silk in a crack or under a leaf, where they rest at night, moult and shelter from bad weather.",
		game = "In this game the crack in the sill is the retreat. The spider does not spin one yet.",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
		},
	},
	{
		id = "depth_blur",
		trigger = "jump_long",
		title = "Judging distance by blur",
		text = "How does a jumping spider know how far to jump? One answer is blur. The big front eyes have retinas in layers, and one layer always gets a slightly blurred picture; how blurred depends on how far away things are. In green light the spiders of the species Hasarius adansoni jumped accurately. In red light they jumped short, as this idea predicts.",
		game = "In this game a jump lands where the marker shows, whatever the light.",
		sources = {
			"Nagata, T., Koyanagi, M., Tsukamoto, H., et al. (2012). Depth perception from image defocus in a jumping spider. Science 335: 469-471. https://doi.org/10.1126/science.1211667",
		},
	},
	{
		id = "green_uv",
		trigger = "eye_time_60",
		title = "Green and ultraviolet",
		text = "In the big front eyes of the related Phidippus regius, light-sensing cells respond best to green and to ultraviolet, a colour people cannot see; no cells most sensitive to red were found. Some other jumping spiders, such as Habronattus, see red with the help of a red filter inside the eye.",
		game = "A screen cannot show ultraviolet, so the eye view shows it as violet, and only the principal eyes see it ({focus}).",
		godotGame = "A screen cannot show ultraviolet, and ordinary colours carry no ultraviolet information, so the eye view says 'UV not simulated'.",
		sources = {
			"DeVoe, R. D. (1975). Ultraviolet and green receptors in principal eyes of jumping spiders. Journal of General Physiology 66: 193-207. https://doi.org/10.1085/jgp.66.2.193",
			"Zurek, D. B., Cronin, T. W., Taylor, L. A., Byrne, K., Sullivan, M. L. G. & Morehouse, N. I. (2015). Spectral filtering enables trichromatic vision in colorful jumping spiders. Current Biology 25: R403-R404.",
		},
	},
	{
		id = "home_before_dark",
		trigger = "sleep",
		title = "Home before dark",
		text = "Jumping spiders hunt in daylight. Spiders of the related species Phidippus johnsoni go into their silk nests before dark and stay inside through the night, and in bad weather.",
		game = "Rest in the crack in the evening to sleep until morning. A day lasts about fifteen minutes of active play.",
		godotGame = "Rest in the crack in the evening to sleep until morning. The game compresses time: a day here passes in about a quarter of an hour of play, and a real bold jumping spider lives about a year.",
		sources = {
			"Jackson, R. R. (1979). Nests of Phidippus johnsoni (Araneae, Salticidae): characteristics, pattern of occupation, and function. Journal of Arachnology 7: 47-58.",
		},
	},
	{
		id = "hungry_at_home",
		trigger = "hungry",
		title = "Hungry, yet at home",
		text = "In one field study, most bold jumping spiders stayed in their silk nests during the day, and the ones inside were hungrier than the ones out hunting. The author suggests the spiders switch between resting and active spells, with hunger deciding when to switch.",
		game = "Here hunger shows in the spider's thinner abdomen and in the words under the day. A spider that goes too long without food starves, except on Easy and in free play.",
		godotGame = "Here hunger shows in the spider's thinner abdomen and its energy. A reserve that runs out does not yet end a life; that comes in a later version.",
		sources = {
			"Okuyama, T. (2011). Biphasic activity of a jumping spider. Naturwissenschaften 98: 15-22. https://doi.org/10.1007/s00114-010-0734-3",
		},
	},
	{
		id = "full_abdomen",
		trigger = "well_fed",
		title = "A full abdomen",
		text = "A spider's abdomen stretches as it feeds and shrinks as it goes without. Biologists judge how well fed a spider is by the size of its abdomen compared with the rest of its body.",
		game = "Watch the spider's abdomen grow after a meal and slowly shrink over the days.",
		sources = {
			"Jakob, E. M., Marshall, S. D. & Uetz, G. W. (1996). Estimating fitness: a comparison of body condition indices. Oikos 77: 61-67.",
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
		},
	},
	{
		id = "outgrowing_a_skin",
		trigger = "moult_ready",
		title = "Outgrowing a skin",
		text = "A spider's hard outer skin cannot stretch, so to grow it must shed it. This is called moulting. Spiders of the related species Phidippus johnsoni stay in their silk nest for about six days before a moult and two days after it.",
		game = "Rest in the crack when your spider is ready. Real spiders usually stop eating before a moult; here the spider can still eat, and the days are compressed.",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
			"Jackson, R. R. (1979). Nests of Phidippus johnsoni (Araneae, Salticidae): characteristics, pattern of occupation, and function. Journal of Arachnology 7: 47-58.",
		},
	},
	{
		id = "new_skin",
		trigger = "moulted",
		title = "A new skin",
		text = "In a moult the spider pulls itself out of its old skin and leaves an empty husk behind. The new skin is pale and soft at first and hardens over the following hours. Until it does, the spider is more easily hurt.",
		game = "Your spider is pale and its jumps shorter while its skin hardens. The ten game-hour timing is a design choice. The empty skin stays in the crack.",
		godotGame = "Your spider is paler and its jumps shorter while the new skin hardens. How long that takes for a jumping spider has not been measured; the game's timing is a guess. Look for the old skin in the crack.",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
		},
	},
	{
		id = "grown_up",
		trigger = "adult",
		title = "Grown up",
		text = "Jumping spiders moult several times before they are adults. In the lab, males of the related Phidippus johnsoni matured after 5 to 7 moults and females after 6 to 8. Bold jumping spiders spend the winter as juveniles and become adults in spring.",
		game = "The game compresses growth into three moults. Adulthood in a Standard main life opens Easy for this session. The male peacock look and dance are cosmetic choices at every gameplay stage.",
		godotGame = "Your spider is an adult: you have finished the main life. The game shows only its last three moults.",
		godotText = "Jumping spiders moult several times before they are adults. In the field, males of the related Phidippus johnsoni became adult after about six to eight moults and females after about seven to nine. Bold jumping spiders spend the winter as juveniles and become adults in spring.",
		sources = {
			"Jackson, R. R. (1978). The life history of Phidippus johnsoni (Araneae, Salticidae). Journal of Arachnology 6: 1-29.",
			"Taylor, B. B. & Peck, W. B. (1975). A comparison of northern and southern forms of Phidippus audax. Journal of Arachnology 2: 89-99.",
		},
	},
	{
		id = "mud_dauber",
		trigger = "wasp",
		title = "A hunter of spiders",
		text = "The black-and-yellow mud dauber, Sceliphron caementarium, is a wasp about 2 to 3 centimetres long. It builds nests of mud in sheltered places on buildings, such as under eaves, and it is active by day in spring and summer. It hunts spiders, jumping spiders among them. It searches by sight, then checks a spider with its antennae before it stings.",
		game = "You hear the wasp before it reaches the sill. The silk-lined crack is safe. Keeping still makes you hard to notice, and a jump or a drop on your line breaks its approach.",
		godotGame = "You hear the wasp before it reaches the sill, see its shadow, and feel it land. The silk-lined crack is safe. Keeping still makes you hard to notice, and a jump or a drop on your line breaks its approach.",
		godotText = "The black-and-yellow mud dauber, Sceliphron caementarium, is a wasp about 2 to 3 centimetres long. It builds nests of mud in sheltered places on buildings, such as under eaves, and it is active by day in spring and summer. It hunts spiders, jumping spiders among them. It finds a spider by sight, then touches it with its antennae before it stings.",
		sources = {
			"Powell, E. C. & Taylor, L. A. Black and yellow mud dauber, Sceliphron caementarium (Drury, 1773). Featured Creatures EENY-654 / IN1478, University of Florida IFAS Extension. https://ask.ifas.ufl.edu/publication/IN1478",
			"Grissell, E. E. (1973). Sceliphron caementarium (Drury), a mud daubing wasp. Entomology Circular 136, Florida Department of Agriculture and Consumer Services, Division of Plant Industry.",
			"Uma, D., Durkee, C., Herzner, G. & Weiss, M. (2013). Double deception: ant-mimicking spiders elude both visually- and chemically-oriented predators. PLoS ONE 8(11): e79660.",
		},
	},
	{
		id = "what_the_wasp_does",
		trigger = "wasp_caught",
		title = "What the wasp does",
		text = "The wasp's sting does not kill a spider: it paralyses it. The wasp carries the spider to a cell in its mud nest and fills the cell with paralysed spiders, up to twenty or more. It lays an egg on one of them and seals the cell with mud. When the larva hatches, it feeds on the spiders, which have stayed fresh because they are still alive.",
		game = "A catch ends a Standard life. Return to your last rest or continue as an unrelated spider. In Easy and Free play the wasp only touches and leaves.",
		godotGame = "Being caught ends this spider's life. You go back to your last rest.",
		sources = {
			"Powell, E. C. & Taylor, L. A. Black and yellow mud dauber, Sceliphron caementarium (Drury, 1773). Featured Creatures EENY-654 / IN1478, University of Florida IFAS Extension. https://ask.ifas.ufl.edu/publication/IN1478",
			"Grissell, E. E. (1973). Sceliphron caementarium (Drury), a mud daubing wasp. Entomology Circular 136, Florida Department of Agriculture and Consumer Services, Division of Plant Industry.",
			"Long, R. F. (2018). Why mud daubers are on spider patrol. UC ANR Green Blog, University of California Agriculture and Natural Resources.",
		},
	},
	{
		id = "getting_away",
		trigger = "wasp_escaped",
		title = "Getting away",
		text = "Jumping spiders watch what moves around them. When something looms toward a bold jumping spider, it backs away, and experiments showed that its side eyes, the anterior lateral eyes, are what tell it to. The mud dauber searches by sight and then checks with its antennae, so a spider that stays out of sight is safer.",
		game = "The wasp lost you, or gave up. Here a jump, a drop on your line or getting out of sight breaks its approach, and the crack is always safe. Dropping on a line to escape is the game's choice: it is not known to be what jumping spiders do.",
		godotText = "Jumping spiders watch what moves around them. When something looms toward a bold jumping spider, it backs away, and experiments showed that its side eyes, the anterior lateral eyes, are what tell it to. Not being seen matters most: the mud dauber finds its prey by sight.",
		sources = {
			"Spano, L., Long, S. M. & Jakob, E. M. (2012). Secondary eyes mediate the response to looming objects in jumping spiders (Phidippus audax, Salticidae). Biology Letters 8(6): 949-951.",
			"Uma, D., Durkee, C., Herzner, G. & Weiss, M. (2013). Double deception: ant-mimicking spiders elude both visually- and chemically-oriented predators. PLoS ONE 8(11): e79660.",
		},
	},
	{
		id = "going_without_food",
		trigger = "starving",
		title = "Going without food",
		text = "Spiders can go a long time without food. In the lab, jumping spiders have survived weeks without food, longer when cold and still. As a spider uses up its reserves its abdomen shrinks: how plump the abdomen is, against the size of the body, is how scientists judge a spider's condition.",
		game = "Time is compressed here. The hunger bar, full when your spider is fed, empties in a little over a day and a half; a spider that then goes two more days without food dies, after warnings on the screen. On Easy and in free play it empties much more slowly and cannot starve.",
		godotGame = "Time is compressed here. A full reserve lasts about three days; a spider that then goes two more days without food dies, after warnings on the screen. On Easy and in free play it cannot starve.",
		godotText = "Spiders can go a long time without food. Adult females of the related Phidippus johnsoni were kept for 25 to 31 days without eating. As a spider uses up its reserves its abdomen shrinks: how plump the abdomen is, against the size of the body, is how scientists judge a spider's condition.",
		sources = {
			"Jackson, R. R. (1978). The life history of Phidippus johnsoni (Araneae, Salticidae). Journal of Arachnology 6: 1-29.",
			"Jakob, E. M., Marshall, S. D. & Uetz, G. W. (1996). Estimating fitness: a comparison of body condition indices. Oikos 77: 61-67.",
		},
	},
	{
		id = "peacock_dance",
		trigger = "dance",
		title = "A fan and a dance",
		text = "A male peacock spider, Maratus volans, unfolds colourful flaps on its abdomen and waves its third pair of legs during courtship. The display also sends vibrations through the surface beneath it. It is a message to a female, not just a dance people can see.",
		game = "Our repeating dance is inspired by recorded displays. Its size, colour, timing and movement are stylised. Here the dance is also how you court a mate: it is available at every growth stage, but only a full-grown, well-fed spider is visited by one.",
		sources = {
			"Girard, M. B., Kasumovic, M. M. & Elias, D. O. (2011). Multi-Modal Courtship in the Peacock Spider, Maratus volans. PLoS ONE 6(9): e25390. https://doi.org/10.1371/journal.pone.0025390",
		},
	},
	{
		id = "walking_like_an_ant",
		trigger = "antennae",
		title = "Walking like an ant",
		text = "Myrmarachne formicaria is a jumping spider that mimics an ant. It walks on all eight legs, and when it stands still it raises its front legs above its head and moves them together, like an ant's antennae. It makes only short stops, about a tenth of a second long, so it seems to move almost constantly, as ants do. In tests with Phidippus audax as the predator, ordinary spider targets were attacked 4.5 times as often as ants and 3 times as often as mimics; ants and mimics did not differ.",
		game = "The ant mimic is a look only: where you go, how fast and what the wasp does are the first spider's. Its front legs rise when you keep still, and a stop shorter than about 83 milliseconds is not drawn as a pause. The waving, the sway of the body as it walks, the colours and the size are stylised: the real mimic's wobbling path is not walked. The female is drawn.",
		sources = {
			"Shamble, P. S., Hoy, R. R., Cohen, I. & Beatus, T. (2017). Walking like an ant: a quantitative and experimental approach to understanding locomotor mimicry in the jumping spider Myrmarachne formicaria. Proceedings of the Royal Society B 284: 20170308. https://doi.org/10.1098/rspb.2017.0308",
		},
	},
	{
		id = "eggs_and_wind",
		trigger = "hatched",
		title = "Eggs, silk and wind",
		text = "Jumping spiders court mostly by sight, and often by vibration too: a male shows a display and the female decides. She lays her eggs in a silken nest. A Phidippus johnsoni mother stays with it until the young hatch and leave: in the lab the eggs hatched about three weeks after laying, and the spiderlings left about three weeks after that. Many young spiders then travel by ballooning: they climb high, let out a thread of silk and are carried off by the air. The electric field in the air can trigger the take-off.",
		game = "A game day is about fifteen minutes, so weeks become days: a mate on the sill, a courtship you hold for eight seconds, one night to the sac and two guard days. In Normal the mate decides when the courtship is full: a thin spider, or a court that broke off, stood far or looked away, is often refused, and a rival may cut in. The real mother makes and guards the sac; here the sac is drawn the same whichever spider you play, and no claim is made that a male guards eggs. A real brood is far larger than the eight to twelve shown: a Phidippus johnsoni female laid about 200 eggs in all. The first spider's sex is the game's choice (a female), and the peacock spider's mate is drawn with the male's colours although the real female is mottled grey-brown. Nothing can harm the sac. In the preserve you may follow one spiderling on its thread: the wind, the game's seeded draw, mostly sets it down near the hut, in the hut garden or at the meadow's edge, and the next life begins where it lands; or you stay at the hut as one of them. A real spiderling could not choose.",
		sources = {
			"Jackson, R. R. (1978). The life history of Phidippus johnsoni (Araneae, Salticidae). Journal of Arachnology 6: 1-29.",
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
			"Bell, J. R., Bohan, D. A., Shaw, E. M. & Weyman, G. S. (2005). Ballooning dispersal using silk: world fauna, phylogenies, genetics and models. Bulletin of Entomological Research 95(2): 69-114. https://doi.org/10.1079/BER2004350",
			"Morley, E. L. & Robert, D. (2018). Electric Fields Elicit Ballooning in Spiders. Current Biology 28(14): 2324-2330. https://doi.org/10.1016/j.cub.2018.05.057",
		},
	},
	{
		id = "tarantula_cousins",
		trigger = "tarantula",
		title = "Velvet cousins (Theraphosidae)",
		text = "Tarantulas (family Theraphosidae) are large, heavy, long-lived spiders. They are not jumping spiders: their eyes sit close together on a small mound and are poor, and they feel their way with the hairs on their legs. Their fangs strike downward, side by side. Most New World tarantulas have urticating hairs on the abdomen and cast them at an attacker. A threatened tarantula rears up and lifts its front legs, and all of them spin silk from spinnerets at the rear of the abdomen.",
		game = "The Mexican redknee and the Greenbottle blue are costumes on the first spider's body, nothing more. A real tarantula's body is five or more centimetres long; yours is the first spider's size. You still see, jump, spin your safety line and are hunted exactly as the first spider does, which no real tarantula could do. The rear-up and the turn with the spinnerets sweeping ({display}) are drawn poses with invented angles and timing, and no silk mat is laid. The colours are stylised, the redknee's rust patch is drawn as a small cluster of hairs (no hairs are cast), and the greenbottle's bars soften at the last growth stage as a game choice.",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
			"Bertani, R. & Guadanucci, J. P. L. (2013). Morphology, evolution and usage of urticating setae by tarantulas (Araneae: Theraphosidae). Zoologia 30(4): 403-418. https://doi.org/10.1590/S1984-46702013000400006",
		},
	},
	{
		id = "ground_life",
		trigger = "garden_bed",
		title = "Life on the ground",
		text = "Fungus gnats are small dark flies whose larvae live in damp soil and eat fungi and rotting matter; the adults fly weakly. Aphids are soft, pear-shaped insects that live in colonies and suck sap from leaves and stems. A jumping spider hunts small insects of many kinds; the related Phidippus johnsoni takes aphids. Woodlice are crustaceans, not insects, with seven pairs of legs: they keep to damp places under stones and litter, and glands on the sides of the body give off a sticky secretion that puts spiders off.",
		game = "The gnats and the aphids in the bed are the house fly's model made smaller and slower, with no measured numbers behind them: a gnat is a third of a housefly meal here and an aphid a sixth, and the aphids only walk. The woodlice walk the soil, go under cover when you come near and cannot be caught, which is the game's way of saying the spider leaves them alone.",
		sources = {
			"Cranshaw, W. S. & Cloyd, R. A. (2003, reviewed 2025). Fungus Gnats as Houseplant and Indoor Pests. Colorado State University Extension, Fact Sheet 5.584.",
			"Warren, P. & Schalau, J. (2014). Aphids. University of Arizona Cooperative Extension, AZ1635.",
			"Jackson, R. R. (1977). Prey of the jumping spider Phidippus johnsoni (Araneae: Salticidae). Journal of Arachnology 5: 145-149.",
			"Hopkin, S. P. (1991). A key to the woodlice of Britain and Ireland. Field Studies Council (AIDGAP), Shrewsbury.",
			"Katz, O., DeVries, Z. & Larson, J. (2023). Sowbugs and Pillbugs. University of Kentucky Entomology, ENTFACT-439.",
			"Fischer, A., Gries, R., Roman-Torres, C. A., Devireddy, A. & Gries, G. (2025). Glandular quinoline-derivates protect crustacean woodlice from spider predation. Journal of the Royal Society Interface 22: 20250260. https://doi.org/10.1098/rsif.2025.0260",
		},
	},
	{
		id = "springtails",
		trigger = "look_springtail",
		title = "Springtails and the spring",
		text = "Springtails (Collembola) have six legs like insects, but biologists count them a lineage of their own. Most are about a millimetre long, white, grey or blue-grey. Many carry a forked spring, the furcula, clasped under the abdomen; released, it strikes the ground and flips the animal into the air, up to about 10 cm. They live in damp soil and litter and eat fungi and decaying plants, and small or young spiders are among the many small predators that eat them.",
		game = "Here a springtail is an eighth of a housefly meal and easy to hold once caught: the hard part is getting close. Its flick is a hop of 1.5 to 4 studs, set off when you come near or move fast beside it. The numbers are the game's, not measurements.",
		sources = {
			"Koehler, P. G., Aparicio, M. L. & Pfiester, M. (1994, revised 2022). Springtails. University of Florida IFAS Extension, ENY-228.",
			"Missouri Department of Conservation (undated, read 2026). Springtails. Missouri Field Guide, mdc.mo.gov.",
			"Blevins, H., Larson, J. & DeVries, Z. (2023). Springtails. University of Kentucky Entomology, ENTFACT-420.",
		},
	},
	{
		id = "leafhoppers",
		trigger = "look_leafhopper",
		title = "Leafhoppers: the sidestep and the jump",
		text = "Leafhoppers (Cicadellidae) are small wedge-shaped bugs, a few millimetres long and often green, with the wings held like a tent over the back. They suck sap from leaves. Young and adults walk with a sideways sidestep; disturbed, the young often walk round to the other side of the stem or leaf, while adults jump and fly readily. The jump comes from the strong hind legs, which carry rows of spines: long-legged leafhoppers push off in 3 to 5 thousandths of a second.",
		game = "Here a leafhopper is half a housefly meal but struggles as hard as a whole one. Watched from its side it slips round its stem or leaf (the game's adults do it too); come at it fast and it jumps 3 to 10 studs, and sometimes flies on. The numbers are the game's.",
		sources = {
			"University of Illinois Extension (undated, read 2026). Leafhopper. Illinois Extension insect pages, extension.illinois.edu.",
			"University of Nebraska-Lincoln Extension (undated, read 2026). Leafhoppers. Backyard Farmer, byf.unl.edu.",
			"Utah State University Extension (undated, read 2026). Leafhoppers. Utah Pests IPM Ornamental Pest Guide.",
			"Burrows, M. & Sutton, G. P. (2008). The effect of leg length on jumping performance of short- and long-legged leafhopper insects. Journal of Experimental Biology 211: 1317-1325.",
		},
	},
	{
		id = "small_moths",
		trigger = "look_moth",
		title = "Moths at the window",
		text = "Moths are Lepidoptera, the scale-winged insects: tiny scales cover their wings like shingles. Most fly at night, and many are drawn to lights. A flying insect does not steer straight at a lamp: it keeps its back toward the light, as it would to the sky, and near a lamp that can keep it circling. The scales help it escape: they stick to a spider's sticky silk but come away from the wing. Spiders are among the many animals that eat moths, and Phidippus johnsoni has been found with one.",
		game = "Here a moth is a housefly meal. It rests on the wall and the outer sill by day, drawn with its wings spread flat (many moths fold them like a tent), and flutters from dusk. Your first grab at one may slip, leaving scales; a jumping spider's catch is not a web, so that slip is the game's borrowing.",
		sources = {
			"Missouri Department of Conservation (undated, read 2026). Moths. Missouri Field Guide, mdc.mo.gov.",
			"Fabian, S. T., Sondhi, Y., Allen, P. E., Theobald, J. C. & Lin, H.-T. (2024). Why flying insects gather at artificial light. Nature Communications 15. https://doi.org/10.1038/s41467-024-44785-3",
			"Alicea-Serrano, A. M., Onyak, A., Dhinojwala, A. & Blackledge, T. A. (2021). Robust performance of spider viscid silk on hairy and smooth insect substrates. Integrative and Comparative Biology 61(4): 1432-1439, citing Eisner, T., Alsop, R. & Ettershank, G. (1964), Adhesiveness of spider silk, Science 146: 1058-1061.",
			"Jackson, R. R. (1977). Prey of the jumping spider Phidippus johnsoni (Araneae: Salticidae). Journal of Arachnology 5: 145-149.",
		},
	},
	{
		id = "crane_flies",
		trigger = "look_crane_fly",
		title = "Crane flies: legs to spare",
		text = "Crane flies (Tipulidae) are large, slender flies on long, fragile legs. They look like giant mosquitoes, but they are not mosquitoes and do not bite, and the short-lived adults feed little or not at all. A special seam in the legs lets them break off easily, to escape predators. Like most flies they come to lights at night. A Phidippus johnsoni was found with one in the field; its prey is usually a quarter to three quarters its own size, sometimes as large or a little larger.",
		game = "Here a crane fly is two housefly meals and a harder struggle than a house fly; it can leave a leg in your fangs and get away, once, and is drawn with a leg fewer after. It is bigger than your spider: real jumping spiders take prey that large only sometimes. It flies slowly from dusk.",
		sources = {
			"University of Maine Cooperative Extension (undated, read 2026). Crane Flies. Home and Garden IPM.",
			"Layton, B. (2019). Crane Fly. Bug's Eye View 5(5), Mississippi State University Extension.",
			"Jackson, R. R. (1977). Prey of the jumping spider Phidippus johnsoni (Araneae: Salticidae). Journal of Arachnology 5: 145-149.",
		},
	},
	{
		id = "ladybirds",
		trigger = "look_ladybird",
		title = "Ladybirds: bright for a reason",
		text = "Ladybirds, or lady beetles, are beetles with domed, oval bodies, red, orange, yellow, pink or black and usually spotted. The bright colours are a warning, to discourage animals that might eat them: disturbed, a ladybird releases an odorous, noxious fluid from its leg joints, called reflex bleeding. Adults and larvae both eat aphids and other small, soft-bodied insects. The larva looks nothing like the adult: shaped like a small alligator, spiny and black with bright spots.",
		game = "Here the ladybirds walk the dock and the dandelion among the aphids and now and then stop over one and eat it. Strike one and you let it go, which is the game's way of saying the spider leaves it alone. The walks, the waits and how often it eats are the game's.",
		sources = {
			"Bessin, R. (undated, revised 2026). Ladybugs. University of Kentucky Entomology, ENTFACT-702.",
			"Bohart Museum of Entomology (undated, read 2026). Lady Bugs & Lady Beetles. Information No. 055, University of California, Davis.",
		},
	},
	{
		id = "millipedes",
		trigger = "look_millipede",
		title = "Millipedes: the coil",
		text = "Millipedes have long segmented bodies with two pairs of legs on each segment, where centipedes have one pair. Most feed on decaying vegetation, living secretively in soil and leaf mould and beneath stones, logs and bark. When threatened, most roll into a coil with their legs on the inside, offering only their body armour to the predator, and some can release substances that taste or smell foul as a defence.",
		game = "Here a millipede is about 2.4 cm long and walks the bed's soil slowly, going under the stones for a while; come close and it coils, head in the middle, until you have gone. Strike it and you let it go. The speeds and the waits are the game's.",
		sources = {
			"Buglife - The Invertebrate Conservation Trust (undated, read 2026). Millipedes. Bug Directory, buglife.org.uk.",
		},
	},
	{
		id = "garden_snails",
		trigger = "look_snail",
		title = "Snails: eyes on stalks",
		text = "The brown garden snail's shell grows to 28 to 32 mm across. A land snail's head carries retractable tentacles: the longer, upper pair bears the eyes, which see light and dark but no colours, and the shorter pair tastes and smells. It moves by waves of muscle along its foot, aided by mucus that the foot secretes all the time, which leaves a slimy trail. Most land snails are nocturnal, but after rain they may come out by day.",
		game = "Here the snail is far bigger than your spider. It crawls about a millimetre a second over the bed and up the foot of the wall, mostly from dusk, and its trail fades in a few minutes. Its eye stalks draw in when you come near; strike it and it draws into its shell. The speeds and the trail's fading are the game's.",
		sources = {
			"Dekle, G. W. & Fasulo, T. R. (2001, revised 2024). Brown Garden Snail, Cornu aspersum (Muller, 1774). University of Florida IFAS Extension, EENY240.",
			"Missouri Department of Conservation (undated, read 2026). Land Snails and Slugs. Missouri Field Guide, mdc.mo.gov.",
		},
	},
	{
		id = "harvestmen",
		trigger = "look_harvestman",
		title = "Harvestmen: not spiders",
		text = "Harvestmen, or daddy longlegs, are not spiders but opilionids. The body is one simple oval, head and abdomen fused, with only two eyes and no silk or venom glands. Disturbed, they give off a foul odour. A leg falls off easily and goes on twitching, which can distract a predator while the harvestman flees. They are mostly active at night or in shade, and eat many kinds of organic matter, dead animals among them; some prey on aphids and other small insects.",
		game = "Here one harvestman walks the bed's litter and one the house wall, from dusk through the night, high on legs that span about four studs, and takes no notice of you. Strike one and you let it go. The legs drawn and the speeds are the game's.",
		sources = {
			"University of Kentucky Entomology (undated, read 2026). Kentucky Harvestmen. Kentucky Critter Files.",
			"Missouri Department of Conservation (undated, read 2026). Daddy Longlegs (Harvestmen). Missouri Field Guide, mdc.mo.gov.",
		},
	},
	{
		id = "hoverflies",
		trigger = "look_hoverfly",
		title = "Hoverflies: a fly dressed as a bee",
		text = "Hoverflies, or flower flies (Syrphidae), are flies that look like bees or wasps, many with black and yellow stripes across the abdomen; they mimic them as protection from predators. They do not bite or sting. Tell one from a bee by its single pair of wings, its large eyes and short antennae. The adults hover over flowers and dart about, feeding on nectar and pollen. Their larvae hunt aphids: one can eat up to 400 of them.",
		game = "Here a hoverfly is a housefly meal and a half that struggles like one. It holds still in the air a moment over the flowers and then darts on; the hovers, the darts and the meal are the game's numbers.",
		sources = {
			"University of Wisconsin-Madison Extension, Division of Horticulture (undated, read 2026). Hover, Flower, or Syrphid Flies, Syrphidae.",
			"University of Minnesota Extension (undated, read 2026). Syrphid flies. Beneficial insects.",
		},
	},
	{
		id = "the_cat",
		trigger = "cat",
		title = "The cat and the bell",
		text = "A house cat stands 23 to 25 cm at the shoulder and weighs 4 to 5 kg. It hunts small mammals and birds first, and invertebrates last. Free-ranging cats kill an estimated 1.3 to 4.0 billion birds and 6.3 to 22.3 billion mammals a year in the United States. A bell on the collar warns prey: in one study, cats brought home about half as many mammals while they wore bells. A bold jumping spider can hear airborne sound, through special hairs, from more than 3 m away.",
		game = "Here the ranger's cat lives in the hut and never goes outside. It sleeps much of the day and walks the two rooms at dawn and dusk, and you hear its bell before you see it. It pats at what moves near it: get up high, into a gap, or keep still. In Normal a pat that lands kills; on Easy and in free play it knocks you aside. Its day and its reach are the game's.",
		sources = {
			"Gouvernement du Quebec (undated, read 2026). Chat domestique. Fiches des especes fauniques, quebec.ca.",
			"Loss, S. R., Will, T. & Marra, P. P. (2013). The impact of free-ranging domestic cats on wildlife of the United States. Nature Communications 4: 1396. https://doi.org/10.1038/ncomms2380",
			"Ruxton, G. D., Thomas, S. & Wright, J. W. (2002). Bells reduce predation of wildlife by domestic cats (Felis catus). Journal of Zoology 256: 81-83 (as summarised by Conservation Evidence).",
			"Shamble, P. S., Menda, G., Golden, J. R., Nitzany, E. I., Walden, K., Beatus, T., Elias, D. O., Cohen, I., Miles, R. N. & Hoy, R. R. (2016). Airborne acoustic perception by a jumping spider. Current Biology 26: 2913-2920 (as reported by NPR, 14 October 2016).",
		},
	},
	{
		id = "crab_spider",
		trigger = "crab_spider",
		title = "The crab spider on the flower",
		text = "The goldenrod crab spider (Misumena vatia) lives in North America and Europe. Females are 6 to 9 mm long, males 3 to 4 mm. It waits on a flower, usually a yellow or white one, its first two pairs of legs held open, and grabs what comes near, injecting venom with small fangs. It takes flies, bees, butterflies and hoverflies. It can turn from white to yellow to match its flower; that change takes 10 to 25 days, and the change back about six. In North America it is most common on goldenrod.",
		game = "Here two crab spiders sit on the meadow's flowers, a yellow one on goldenrod and a white one on yarrow, still and nearly the flower's colour, front legs open. Walk or land within their reach and they grab: in Normal that ends the life; on Easy and in free play you drop clear. Their reach and where they sit are the game's.",
		sources = {
			"Animal Diversity Web, University of Michigan Museum of Zoology (read 2026). Misumena vatia, goldenrod crab spider.",
			"University of Minnesota Extension (undated, read 2026). Goldenrod crab spider.",
			"Wikipedia (read 2026). Misumena vatia.",
		},
	},
	{
		id = "robin",
		trigger = "robin",
		title = "The robin on the lawn",
		text = "The American robin is a thrush 20 to 28 cm long, about 77 to 85 g, its breast rusty red and its head blackish with a white eye ring broken in front and behind. It forages on the ground: it runs a few steps, stops abruptly, and stares at the ground with its head cocked to one side, finding its food by sight. It eats many earthworms, and insects, snails, spiders and much fruit. Its call is a sharp \"pick! tut-tut-tut\".",
		game = "Here a robin comes to the hut garden's lawn, the gravel by the bench and the meadow's mown edge a few times a day, its shadow and its call first. Move in the open near it and it hops close, cocks its head at you and pauses, then strikes: in Normal that ends the life; on Easy and in free play it misses. Under cover, low in the meadow's grass or keeping still, you are lost to it. Its visits, its reach and its pause are the game's.",
		sources = {
			"National Audubon Society (undated, read 2026). American Robin, Turdus migratorius. Guide to North American Birds, audubon.org.",
			"Cornell Lab of Ornithology (undated, read 2026). American Robin: Life History. All About Birds.",
			"Missouri Department of Conservation (undated, read 2026). American Robin. Missouri Field Guide, mdc.mo.gov.",
		},
	},
	{
		id = "field_crickets",
		trigger = "look_cricket",
		title = "The field cricket",
		text = "The fall field cricket (Gryllus pennsylvanicus) lives across much of North America in grassy places, often near people. Adults are 15 to 25 mm long, shiny black to dark brown, with long antennae and stout hind legs. It eats seeds, seedlings and small fruits, and dead and dying insects. Males sing mostly at night from a burrow or a crack in the ground: short chirps, two or three a second. A cricket's ears are on its front legs. Scared, it escapes into its burrow.",
		game = "Here crickets live in the meadow's thatch and the hut garden's mulch, each worth about three houseflies, and the males chirp from dusk. Move near one and it falls silent and still; come closer and it jumps away. Caught, it kicks hard, and a weak grip loses it. Its hearing, its jump and its kicks are the game's numbers.",
		sources = {
			"Wikipedia (read 2026). Gryllus pennsylvanicus.",
			"Minnesota Seasons (undated, read 2026). Fall field cricket, Gryllus pennsylvanicus. minnesotaseasons.com.",
			"Geological Society of America (2011). The sound of crickets in the Eocene night: fossil insect ears from the Green River Formation. Northeastern Section meeting, abstract (paper 184321), gsa.confex.com.",
		},
	},
	{
		id = "water",
		trigger = "water",
		title = "Spiders and water",
		text = "Most spiders are not built for water. Fishing spiders and many wolf spiders stay dry on the surface film and row across it, but in a comparison of 166 species outside that group only two jumping spiders rowed at all, and in another study the jumping spiders' rowing gave them no clear benefit over walking. Water striders hunt what falls onto the water and struggles: insects, and spiders. They find it by its ripples.",
		game = "Here the pond's water is no place to stand. Fall or walk in and you struggle at the surface; a stem, a stone, a pad or the bank within a few centimetres gives you a chance to climb out. In Normal a spider that cannot reach one drowns, and a long fall into open water is the worst. On Easy and in free play you are always pulled out. The chances are the game's.",
		sources = {
			"Stratton, G. E., Suter, R. B. & Miller, P. R. (2004). Evolution of water surface locomotion by spiders: a comparative approach. Biological Journal of the Linnean Society 81: 63-78.",
			"Suter, R. B., Stratton, G. & Miller, P. R. (2003). Water surface locomotion by spiders: distinct gaits in diverse families. Journal of Arachnology 31: 428-432.",
			"Missouri Department of Conservation (undated, read 2026). Water striders. Missouri Field Guide, mdc.mo.gov.",
		},
	},
	{
		id = "green_frog",
		trigger = "frog",
		title = "The green frog",
		text = "The green frog (Lithobates clamitans) of eastern North America is 5 to 10 cm from snout to vent, its head green and its body brown, grey or green. It lives at the edges of shallow ponds and hunts by sitting and waiting, eating any animal of a mouthful that comes within reach: insects, spiders, snails, crayfish, small frogs. A frog's eye answers to small things that move; food that keeps still is not food to it. Its tongue strikes and is back in under 0.07 seconds.",
		game = "Here a green frog sits on a stone at the water's edge or on a lily pad, one or the other by the day, and keeps still. Move near it and it turns to face you; keep moving within its reach and its tongue strikes: in Normal that ends the life; on Easy and in free play it misses. Keep still and it loses interest. Its reach, its turn and its patience are the game's.",
		sources = {
			"Wikipedia (read 2026). Lithobates clamitans.",
			"Tennessee Wildlife Resources Agency (undated, read 2026). Green Frog, Lithobates clamitans. tn.gov/twra.",
			"Lettvin, J. Y., Maturana, H. R., McCulloch, W. S. & Pitts, W. H. (1959). What the frog's eye tells the frog's brain. Proceedings of the IRE 47: 1940-1951 (as summarised in D. Heeger's perception lecture notes, cns.nyu.edu).",
			"Georgia Institute of Technology, School of Physics (2017, read 2026). The frog tongue is a high-speed adhesive (on Noel, A. C. et al., Journal of the Royal Society Interface 14: 20160764).",
		},
	},
	{
		id = "midges",
		trigger = "look_midge",
		title = "Midges over the water",
		text = "Non-biting midges (Chironomidae) are delicate flies, most under 1 cm long, with clear wings and long front legs; the males have feathery antennae that sense the females' wingbeats. They do not bite. Males gather in swarms in the evening when the sun is low, over a bush or a body of water. Their larvae live in the mud of pond bottoms, some red with haemoglobin: bloodworms. Adults live only a few days. Dragonflies catch midges on passes through their swarms.",
		game = "Here midges rest on the rushes and the cattails by day and rise at dusk to hang over the margin, each a third of a housefly's meal. Their swarms here are a few, the game's.",
		sources = {
			"Missouri Department of Conservation (undated, read 2026). Midges. Missouri Field Guide, mdc.mo.gov.",
			"Virginia Cooperative Extension (undated, read 2026). Non-biting midges. Publication ENTO-438, Virginia Tech.",
		},
	},
	{
		id = "mosquitoes",
		trigger = "look_mosquito",
		title = "Mosquitoes",
		text = "Only female mosquitoes take blood, which they need for their eggs; males feed on nectar. Eggs are laid on water or on damp ground that floods, and the larvae, wrigglers, live in the water and come up to breathe. Most kinds bite from just before dark into the night. In East Africa one jumping spider, Evarcha culicivora, chooses female mosquitoes carrying blood as its prey, Anopheles above all, and can pick them out by how they rest.",
		game = "Here mosquitoes rest in the rushes by day and fly at dusk over the water's edge. None bites you; each is a small meal, a third of a housefly.",
		sources = {
			"Oklahoma State University Extension (undated, read 2026). Mosquitoes. Digital Diagnostics, extension.okstate.edu.",
			"Nelson, X. J. & Jackson, R. R. (2006). A predator from East Africa that chooses malaria vectors as preferred prey. PLoS ONE 1: e132.",
		},
	},
	{
		id = "damselflies",
		trigger = "look_damselfly",
		title = "The eastern forktail",
		text = "The eastern forktail (Ischnura verticalis) is a damselfly 22 to 30 mm long of ponds, marshes and slow streams in eastern North America. The male's thorax is striped black and green and the tip of his abdomen blue. At rest it holds its four wings together over its back. A weak flier, it keeps low in the plants at the water's edge and eats flying insects. Phidippus audax has been seen eating a cicada three times its own length, and leaping at dragonflies far bigger than itself.",
		game = "Here forktails perch on the cattails by day. One is two and a half housefly meals, but it sees you from far off, and caught it thrashes: few holds last. Its wariness and its struggle are the game's numbers.",
		sources = {
			"Wikipedia (read 2026). Eastern forktail.",
			"Minnesota Seasons (undated, read 2026). Eastern forktail, Ischnura verticalis. minnesotaseasons.com.",
			"Lockley, T. C. & Young, O. P. (1987). Phidippus audax (Araneae, Salticidae) predation upon a cicada (Tibicen sp.) (Homoptera, Cicadidae). Journal of Arachnology 14: 393-394.",
		},
	},
	{
		id = "water_striders",
		trigger = "look_skater",
		title = "Water striders",
		text = "Water striders (Gerridae) spend their lives on the water. Water-repellent hairs on their long middle and hind legs let them skate on the surface film: the middle legs row, the hind legs steer, and the short front legs are held ready to grab. Each foot makes a dimple in the surface. They eat insects, and spiders, that fall onto the water and struggle there, finding them by their ripples, and several may share one meal.",
		game = "Here striders skate the open water of the margin, and if you fall in the near ones come toward your ripples. They are not your prey: a strike at one finds it gone.",
		sources = {
			"Missouri Department of Conservation (undated, read 2026). Water striders. Missouri Field Guide, mdc.mo.gov.",
			"Wikipedia (read 2026). Gerris lacustris.",
			"U.S. Geological Survey (undated, read 2026). Surface tension allows a water strider to walk on water. usgs.gov.",
		},
	},
	{
		id = "green_darner",
		trigger = "darner",
		title = "The green darner",
		text = "The common green darner (Anax junius) is one of the commonest dragonflies in North America, 6.8 to 8 cm long with wings to 10 cm across. Its young grow in ponds, lakes and slow streams, eating small water animals. The adults catch flying insects in the air: mosquitoes, flies, moths, wasps, even other dragonflies. In autumn many fly south, on average about 900 km.",
		game = "Here a darner patrols over the pond by day. It hunts what flies, not what clings to a stem: it is no danger to you, and you cannot catch it.",
		sources = {
			"Wikipedia (read 2026). Green darner.",
		},
	},
	{
		id = "rare_luna_moth",
		trigger = "rare_luna",
		title = "Rare sighting: luna moth",
		text = "Actias luna is a native Illinois silk moth, with pale green wings, four eyespots and long hindwing tails. Adults do not feed. In experiments with hunting bats, the spinning tails diverted attacks away from the body. Flight seasons vary across its range; some populations have more than one brood.",
		game = "A warm, dry night may bring one to the hut's outer windowsill until dawn. It is too large to catch. A wing can bear your spider here: an authored invitation to explore, not a claim about wild moths tolerating a rider.",
		sources = {
			"Illinois Department of Natural Resources, Luna moth (species account), https://dnr.illinois.gov/education/wildaboutpages/wildaboutinvertebrates/wildaboutmoths/family-saturniidae/wamblunamoth.html",
			"University of Florida IFAS, Luna Moth Actias luna (IN737), https://ask.ifas.ufl.edu/publication/IN737",
			"Barber et al. 2015, Moth tails divert bat attack (abstract, PNAS), https://pubmed.ncbi.nlm.nih.gov/25730869/",
		},
	},
} :: { Page }

return NotebookPages
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Peacock</string>
            <string name="Source"><![CDATA[--!strict
-- The peacock spider's courtship dance (ROBLOX-29): every number the dance needs, each marked DOC (reported in the paper) or ART
-- (artistic: not reported, chosen to read well on a small screen). The dance is presentation only: a pose for the drawn spider,
-- never a change to the motor, the senses, the jump or the silk.
--
-- Source: Girard, M. B., Kasumovic, M. M. & Elias, D. O. (2011). Multi-Modal Courtship in the Peacock Spider, Maratus volans
-- (O.P.-Cambridge, 1874). PLoS ONE 6(9): e25390 (PMC3181266). Rates are mean +- SD of the paper's high-speed video and laser
-- vibrometer records. Order in the paper: rumble-rumps and bobbing on approach, then leg waving with fan dancing, fan-flapping in
-- the pauses, then a pre-mount display and a mounting attempt. The last two are left out on purpose: this is a family game.
-- A real courtship lasts 6 to 51 minutes (mean 24.35, DOC); `loopSeconds` squeezes one round of it into a loop a player can watch.

local Peacock = {}

export type Phase = {
	id: string, seconds: number, ease: number?, rumble: number?,
	pitch: number, open: number, legs: number, sway: number, wave: number, flap: number, bob: number, palp: number,
}

Peacock.id = "maratus_volans_male"
Peacock.citation = "Girard, Kasumovic & Elias 2011, PLoS ONE 6(9): e25390"

-- Real courtship length in minutes (DOC: range 6 to 51, mean 24.35). The game's loop is ART.
Peacock.courtshipMinutes = { min = 6, max = 51, mean = 24.35 }
Peacock.loopSeconds = 14.0 -- ART: one compressed round of the display (the phases below add up to it)

-- ---------------------------------------------------------------- rates: DOC
-- Hz = cycles (or flicks, waves, flaps, bumps) per second; sd is the paper's standard deviation, kept for the docs and tests.
Peacock.rates = {
	palpFlicker = { hz = 3.5, sd = 1.6 }, -- pedipalps flicker up and down in unison (DOC)
	fanDance = { hz = 3.2, sd = 1.5 }, -- abdomen sways side to side with the fan raised (DOC)
	legWave = { hz = 3.2, sd = 0.6 }, -- legs III wave (DOC)
	fanFlap = { hz = 2.5, sd = 1.8 }, -- the fan flaps in and out during the pauses (DOC)
	-- Opisthosomal bobbing comes in bouts; the paper gives no rate. ART:
	bob = { hz = 4.0, boutSeconds = 0.8, restSeconds = 0.5 },
}
-- Rumble-rumps: vibrations through the substrate (felt, not seen). 2.44 +- 0.28 s long, 12.1 +- 2.9 bumps a second (DOC).
Peacock.rumble = { seconds = 2.44, sd = 0.28, bumpsHz = 12.1, bumpsSd = 2.9, edgeSeconds = 0.12 }
-- The fan dance sweeps the abdomen over an arc of 19 to 35 degrees (DOC); the game uses the middle of the range.
Peacock.fanArcDeg = { min = 19, max = 35, used = 27 }

-- ---------------------------------------------------------------- amplitudes: ART (the paper reports none of these)
Peacock.amplitude = {
	raiseDeg = 80, -- how far the abdomen pitches up (rear end up) to show the fan
	bobDeg = 6, -- the abdomen's bob, either side of its pitch
	shiverDeg = 1.2, -- the abdomen's visible tremble at 12.1 bumps a second during a rumble-rump
	waveDeg = 38, -- how far legs III sweep down in a wave
	flapDepth = 0.45, -- the fan closes to this much narrower (0.45: down to 55 % of its width) at the bottom of a flap
	palpDeg = 22, -- the pedipalps' flick
}

-- ---------------------------------------------------------------- the phases (ART: the order is DOC, the times are ART)
-- Each phase eases the levels from the previous phase's (the last phase's, for the first) over `ease` seconds, then holds them.
-- Levels run 0..1: pitch (the abdomen raised: 1 is amplitude.raiseDeg), open (the fan), legs (legs III up), sway (the fan dance),
-- wave (legs III waving), flap (fan-flapping), bob (bobbing bouts), palp (the pedipalps' flicker). `rumble` starts a rumble-rump
-- `at` seconds into the phase and lasts Peacock.rumble.seconds.
Peacock.ease = 0.45
Peacock.phases = {
	{ id = "approach", seconds = 3.2, ease = 0.4, pitch = 0, open = 0, legs = 0, sway = 0, wave = 0, flap = 0, bob = 1, palp = 0.6, rumble = 0.4 },
	{ id = "raise", seconds = 1.3, ease = 1.1, pitch = 1, open = 1, legs = 1, sway = 0, wave = 0, flap = 0, bob = 0, palp = 0.4 },
	{ id = "dance", seconds = 3.4, ease = 0.4, pitch = 1, open = 1, legs = 1, sway = 1, wave = 1, flap = 0, bob = 0, palp = 1 },
	{ id = "freeze", seconds = 2.2, ease = 0.35, pitch = 1, open = 1, legs = 1, sway = 0, wave = 0, flap = 1, bob = 0, palp = 0.5 },
	{ id = "dance_again", seconds = 2.6, ease = 0.35, pitch = 1, open = 1, legs = 1, sway = 1, wave = 1, flap = 0, bob = 0, palp = 1 },
	{ id = "fold", seconds = 1.3, ease = 1.0, pitch = 0, open = 0, legs = 0, sway = 0, wave = 0, flap = 0, bob = 0, palp = 0.2 },
} :: { Phase }

-- ---------------------------------------------------------------- starting and stopping (ART)
Peacock.rampInSeconds = 0.25 -- the pose arrives
Peacock.fadeOutSeconds = 0.2 -- a stop (a step, a jump, leaving the surface) eases the pose out over this long
Peacock.reducedMotion = 0.5 -- ReducedMotion halves the sway, wave, flap, bob and flick amplitudes and stops the tremble

-- ---------------------------------------------------------------- the words (felt, not seen)
Peacock.feltCaption = "[a fine buzzing through your feet]"

return Peacock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">RareSightings</string>
            <string name="Source"><![CDATA[--!strict
-- Only finished encounters are registered. The thirteen-creature roadmap is
-- documentation, never a locked checklist or an exposed list of future pages.
local Rare = {}
Rare.luna = {
 id="luna_moth",page="rare_luna_moth",chance=.35,days=4,
 -- Authoring bounds for a Midwest spring/summer flight window, not a claim
 -- that all Illinois populations fly on every date in it. See source audit.
 firstDay=121,lastDay=243,minTemperature=16,maxRain=.08,
 at=Vector3.new(18,.45,-20),span=10,
}
return Rare
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">RivalRules</string>
            <string name="Source"><![CDATA[--!strict
-- When the brown rival spider arrives (ROBLOX-68). Game tuning, not measurements. Predator/RivalSpider reads these; nothing else decides it.
-- One rival at a time on the eastern sill: it arrives, and when it is eaten a new one arrives on a later morning.
local RivalRules = {}

-- The protections of a brand-new life, as the wasp has them: no rival on the first day, and none before the first meal is finished.
RivalRules.firstDay = 2
RivalRules.firstMeals = 1
-- A rival (the first, or the one after an eaten rival) arrives from this hour of the life clock: the morning, when the spider wakes (LifeClock.WAKE_H).
RivalRules.arriveHour = 7.0
-- It does not arrive on top of the spider: it waits while the spider is closer than this to the east end of the sill (WU).
RivalRules.arriveDistance = 8.0
-- Where it arrives, at the east end of the sill (WU).
RivalRules.arriveAt = Vector3.new(25, 0.31, 8)

-- ROBLOX-69: the rival roams the whole sill with its own motor. How often it decides (the motor itself steps every tick), how far and how it moves.
RivalRules.thinkSeconds = 0.1
RivalRules.sightWu = 8.0 -- it perceives the player up to here with a clear line (as before)
RivalRules.patrolSpeed = 0.8 -- WU per second (it was 0.45 on its small territory)
RivalRules.stalkSpeed = 1.1
RivalRules.reachWu = 3.2 -- the windup begins this close, on the same face or one that meets it (ROBLOX-73: it was 2.5)
RivalRules.rememberSeconds = 5.0 -- it keeps stalking where it last saw the spider this long after losing sight of it (it was 3)
-- How long it must see the spider before it stalks it: the notice (0 to 1, rising one a second while it sees the spider) at which a patrolling
-- rival starts to stalk. It was 0.6 in Godot's rule; the game's rival is quicker to take an interest (ROBLOX-73).
RivalRules.stalkNotice = 0.45
RivalRules.legSeconds = 240.0 -- a patrol leg that has not arrived by now is dropped for the next
RivalRules.stuckSeconds = 4.0 -- no progress for this long: the route is made again
-- ROBLOX-73: striking a rival that has seen the spider coming is a contest, not a sure catch. A rival is aware when it is stalking or winding up,
-- or patrolling with a notice of at least awareNotice; a recovering rival or a patrolling one that has not noticed is still caught outright. The
-- draw is from a stream of its own (RivalSpider.contest, by the world's seed, the day and how many contests this rival has had): the rival is
-- caught (contestCaptured), springs clear of the strike (contestSprang) or, for the rest, bites back and costs counterCost of the spider's energy
-- (about half of a day's; nothing in the gentle modes). ROBLOX-88: harder to take down: 40 caught, 32 sprang clear, 28 bit back (it was 55/25/20), and a
-- bite costs 0.30 (it was 0.25; a day costs about 0.61 at the game's hunger drain).
RivalRules.awareNotice = 0.3
RivalRules.contestCaptured = 0.40
RivalRules.contestSprang = 0.32 -- (and 0.28 is left for the counter-bite)
RivalRules.counterCost = 0.30
-- ROBLOX-91: the gentle modes (Easy, Free play) keep ROBLOX-73's contest, 55 caught / 25 sprang clear / 20 a bite that costs nothing: ROBLOX-88's harder rival is for
-- the standard rules (the draw is the same stream; only the thresholds differ). The gentle grip (Catch.forRival) and the free bite are as they were.
RivalRules.contestGentle = { captured = 0.55, sprang = 0.25 }
-- ROBLOX-106 (W4, Nathan: "a rival that camps by the retreat"): in the standard rules (the client's drive is told `camps`, and the snapshot `nature`), a patrol leg is now
-- and then a watch by the crack: a draw of its own for each leg (from the world's seed and the leg's number, which the rival's record keeps) makes one leg in `chance`
-- go to one of `spots` on the floor round the crack's mouth (each a stud or more outside the keep-out, two to five from the retreat's door) and stand there `seconds`
-- (drawn) before it patrols on. It still sees, stalks and lunges as on any leg; while the spider is in the crack it waits where it is, as it always has. `camp` (the
-- seconds left, once it is there) is in the rival's record.
RivalRules.camp = {
	chance = 0.15, seconds = { 60.0, 180.0 },
	spots = { Vector3.new(-21.5, 0, 6.0), Vector3.new(-21.5, 0, 3.5), Vector3.new(-21.5, 0, 8.5), Vector3.new(-25.5, 0, 10.8) },
}
-- Nothing the rival does goes in here: the retreat grown by half a stud (the crack itself is also a hard check).
RivalRules.keepOutMin = Vector3.new(-30.0, -0.5, 2.5)
RivalRules.keepOutMax = Vector3.new(-22.8, 2.0, 9.5)
-- The sill the rival may walk (the frames' outer faces and the underside of the floor are outside it).
RivalRules.sillMin = Vector3.new(-31.05, -0.05, -13.55)
RivalRules.sillMax = Vector3.new(31.05, 40.0, 12.55)

return RivalRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">SaveRules</string>
            <string name="Source"><![CDATA[--!strict
-- Every number and name the persistent saves use (ROBLOX-39): store names, key prefixes, sizes, timings, limits. The logic is in
-- Shared/Persistence/Save*.luau; none of it carries a number of its own. Sizes were measured on real checkpoints (tests/state.luau
-- prints them; docs/HANDOFF-roblox-state.md records them).
local SaveRules = {}

-- ---------------------------------------------------------------- where it is kept
SaveRules.STORE_PRODUCTION = "Windowsill_v1"
SaveRules.STORE_TEST = "WindowsillTest_v1" -- Studio and the test place: Chet's runs never touch a real save
SaveRules.KEY_PROGRESS = "P_" -- P_<UserId>: the player's progress (small, precious)
SaveRules.KEY_REST = "R_" -- R_<UserId>_main, R_<UserId>_easy, R_<UserId>_free: the last rest of each slot (larger, replaceable)
-- The slots a rest is filed in (ROBLOX-91): the standard main life ("main": every save made before the Easy slot existed keeps this key, whatever its rules), the main
-- life on Easy's gentle rules ("easy": it used to share the main slot, so starting Easy wiped the standard rest) and free play ("free").
SaveRules.MODES = { "main", "free", "easy" } :: { string }
SaveRules.FORMAT = "the-windowsill save"
SaveRules.REMOTES_NAME = "SaveRemotes" -- the folder in ReplicatedStorage holding ToServer and ToClient

-- ---------------------------------------------------------------- sizes (characters of canonical JSON)
-- Expanded validation bounds, NOT the stored-value budget. The full preserve initialization is 2.28M characters.
-- Server/RestCompression bounds the actual compressed envelope INCLUDING its backup to 1.5M stored characters,
-- and checks its Zstd frame size before expanding (12M maximum). Old uncompressed records remain readable.
SaveRules.MAX_REST_CHARS = 5000000
SaveRules.MAX_REST_NODES = 600000 -- values a rest may hold, checked before encoding/checkpoint graph construction
SaveRules.MAX_DEPTH = 24
SaveRules.MAX_PROGRESS_CHARS = 16384
SaveRules.MAX_VALUE_CHARS = 4194304 -- Roblox's own limit on one stored value
SaveRules.MAX_PROGRESS_NODES = 1500 -- values a progress message may hold, counted before anything reads it
SaveRules.MAX_PROGRESS_DEPTH = 8
SaveRules.MAX_PAGES = 200 -- notebook ids kept (the book has 25 pages; room for the future)
SaveRules.MAX_ID_CHARS = 48
SaveRules.MAX_EYE_SECONDS = 1.0e9

-- ---------------------------------------------------------------- timing (seconds)
SaveRules.PROGRESS_DEBOUNCE = 30 -- at most one progress write in this time (events in between are coalesced)
SaveRules.REST_MIN_INTERVAL = 10 -- a key may be written about every 6 s; this leaves room
SaveRules.HEARTBEAT = 30 -- the session lock is refreshed this often
SaveRules.LOCK_STALE = 120 -- a lock older than this may be taken over by a newer session
SaveRules.BACKOFF_BASE = 2
SaveRules.BACKOFF_CAP = 60
SaveRules.RETRY_LOAD = 15 -- a session that could not load or lock tries again this often
SaveRules.FLUSH_ATTEMPTS = 4 -- tries at leaving or shutting down, with the backoff between
SaveRules.FLUSH_BACKOFF = 1
SaveRules.FLUSH_DEADLINE = 24 -- BindToClose has 30 s in all
SaveRules.REQUESTS_PER_MINUTE = 10 -- DataStore requests one player's session may start in a minute (the budget is 60 + 10 per player)

-- ---------------------------------------------------------------- what the client may send (per player)
SaveRules.PROGRESS_BURST = 6
SaveRules.PROGRESS_PER_SECOND = 0.5
SaveRules.REST_BURST = 2
SaveRules.REST_PER_SECOND = 0.2
SaveRules.LIFE_BURST = 2
SaveRules.LIFE_PER_SECOND = 0.2
SaveRules.MAX_LIFE_SERIAL = 1000000000
SaveRules.MAX_LIFE_TOKEN_CHARS = 160
SaveRules.CLIENT_LIFE_GAP = 5 -- retry one idempotent retirement intent until durable acknowledgement
SaveRules.PROTOCOL = 2 -- the version of the messages between client and server
SaveRules.CLIENT_HELLO_GAP = 2.5 -- the client says hello again this often until the server answers
SaveRules.CLIENT_HELLO_TRIES = 6
SaveRules.CLIENT_PROGRESS_GAP = 2 -- the client sends at most one progress message in this time
SaveRules.CLIENT_EYE_GAP = 30 -- and re-sends the eye-view seconds this often when they changed
SaveRules.CLIENT_WAIT_REMOTES = 1.5 -- the start menu waits this long for the server's remotes to appear
SaveRules.CLIENT_WAIT_REPLY = 4 -- and this long for the first reply after saying hello

-- ---------------------------------------------------------------- words for statuses
SaveRules.STATUS = { saved = "saved", saving = "saving", session = "session" } -- session: this visit only
SaveRules.REASONS = { "offline", "no_api", "load_failed", "other_session", "corrupt", "newer", "write_failed", "rest_refused" } :: { string }

-- The slot a life's rests are filed in: free play's own, the main life on the gentle rules (Easy) its own, and the standard main life the key it always had.
function SaveRules.slotOf(mode: string, rules: string): string
	if mode == "free" then return "free" end
	if rules == "gentle" then return "easy" end
	return "main"
end

return SaveRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">SettingsSpec</string>
            <string name="Source"><![CDATA[--!strict
-- Every setting the player can change (ROBLOX-49): its id, words, kind, default and range. One table, no logic: Shared/UI/SettingsModel
-- checks and steps the values, Client/SettingsPanel shows them, Shared/Persistence/SaveProgress keeps them, and each one is read live by
-- the part of the client it belongs to (tests/settings.luau lists who reads which).
--
-- An id is also the name of the Player attribute that holds the value at run time (the older toggles already were: FocusToggle, ReducedMotion,
-- ShowLastSeen, AutomaticGrip, NotebookNotes, LargeText, SoundMuted), so a setting nobody has changed is an attribute nobody has set.
--
-- Kinds: "toggle" (true or false), "slider" (a number from min to max in steps), "choice" (one of the listed options, by id), and, for a live row only,
-- "action" (a button that does something when it is switched: Inspect your spider, ROBLOX-90; it has no value).
-- The words follow the frozen Godot game's settings (scripts/presentation/settings.gd and pause_menu.gd) where a setting matches; the ones
-- Godot had that the port has no part for (stalk and jump-aim toggles, the jump arc, strike assist, headphones, rumble, slow-motion speed,
-- remapping keys) are left out on purpose and listed in docs/HANDOFF-roblox-settings.md.
local SettingsSpec = {}

-- The version of this table's meaning. Raise it when an id is renamed or a value changes its meaning, and add a step to
-- SettingsModel.MIGRATIONS (the saved settings are carried forward from the version they were written at).
SettingsSpec.VERSION = 1

export type Option = { id: string, label: string }
export type Setting = {
	id: string, section: string, label: string, kind: string, default: boolean | number | string,
	min: number?, max: number?, step: number?, unit: string?, options: { Option }?,
	note: string?, -- a short line under the setting
}

SettingsSpec.SECTIONS = {
	{ id = "sound", title = "Sound" },
	{ id = "camera", title = "Camera" },
	{ id = "comfort", title = "Comfort and accessibility" },
	{ id = "help", title = "Help and hints" },
	{ id = "spider", title = "Your spider" },
} :: { { id: string, title: string } }

-- Units name how a slider's number is shown (SettingsModel.valueText): percent of 1, a plain multiplier, degrees, studs.
SettingsSpec.LIST = {
	-- ---------------------------------------------------------------- sound (Client/Soundscape)
	{ id = "SoundMuted", section = "sound", label = "Mute all sound", kind = "toggle", default = false },
	{ id = "MasterVolume", section = "sound", label = "Volume", kind = "slider", default = 1.0, min = 0.0, max = 1.0, step = 0.05, unit = "percent" },
	{ id = "AmbienceVolume", section = "sound", label = "Room sounds and birds", kind = "slider", default = 1.0, min = 0.0, max = 1.0, step = 0.05, unit = "percent" },
	{ id = "CreatureVolume", section = "sound", label = "Flies and the wasp", kind = "slider", default = 1.0, min = 0.0, max = 1.0, step = 0.05, unit = "percent" },
	{ id = "MusicVolume", section = "sound", label = "Ambient music", kind = "slider", default = 1.0, min = 0.0, max = 1.0, step = 0.05, unit = "percent" },
	{ id = "Captions", section = "sound", label = "Captions for sounds and vibrations", kind = "choice", default = "normal",
		options = { { id = "off", label = "Off" }, { id = "normal", label = "Normal" }, { id = "large", label = "Large" } },
		note = "A line for the wasp's hum and the buzz felt through the feet, with its direction." },
	-- ---------------------------------------------------------------- camera (Client/SpiderCamera)
	{ id = "LookSensitivityMouse", section = "camera", label = "Mouse look speed", kind = "slider", default = 1.0, min = 0.2, max = 3.0, step = 0.05, unit = "times" },
	{ id = "LookSensitivityStick", section = "camera", label = "Stick look speed", kind = "slider", default = 1.0, min = 0.2, max = 3.0, step = 0.05, unit = "times" },
	{ id = "LookSensitivityTouch", section = "camera", label = "Touch drag look speed", kind = "slider", default = 1.0, min = 0.2, max = 3.0, step = 0.05, unit = "times" },
	{ id = "InvertY", section = "camera", label = "Invert look up and down", kind = "toggle", default = false },
	{ id = "InvertX", section = "camera", label = "Invert look left and right", kind = "toggle", default = false },
	{ id = "CameraDistance", section = "camera", label = "Camera distance", kind = "slider", default = 5.0, min = 4.0, max = 7.0, step = 0.1, unit = "studs" },
	{ id = "FieldOfView", section = "camera", label = "Field of view", kind = "slider", default = 65.0, min = 50.0, max = 90.0, step = 1.0, unit = "degrees",
		note = "The spider-eye view keeps its own." },
	{ id = "FrameLine", section = "camera", label = "Frame the line after a catch", kind = "toggle", default = true,
		note = "The view may turn to show the line while the spider hangs on it." },
	-- ---------------------------------------------------------------- comfort and accessibility
	{ id = "ReducedMotion", section = "comfort", label = "Reduced motion (a calmer spider body)", kind = "toggle", default = false },
	{ id = "LargeText", section = "comfort", label = "Large text", kind = "toggle", default = false, note = "Menus, panels and the notebook." },
	{ id = "FocusToggle", section = "comfort", label = "Focus toggles (press to start and stop)", kind = "toggle", default = false },
	{ id = "AutomaticGrip", section = "comfort", label = "Hold prey and eat automatically", kind = "toggle", default = false,
  note = "Keeps your grip and takes bites without repeated taps. Moving still pauses eating." },
	{ id = "ShowNoticed", section = "comfort", label = "Show what the spider notices", kind = "toggle", default = true,
		note = "The rings, marks and words over what it sees. A lock (R or L1) still follows it." }, -- L1 locks on a controller
	{ id = "ShowLastSeen", section = "comfort", label = "Show the last-seen mark", kind = "toggle", default = true },
	{ id = "EyeLevelHorizon", section = "comfort", label = "Spider-eye view: level horizon (no roll on walls)", kind = "toggle", default = false },
	{ id = "EyeGrey", section = "comfort", label = "Spider-eye view: grey instead of green", kind = "toggle", default = false },
	-- ---------------------------------------------------------------- help and hints
	{ id = "ControlHints", section = "help", label = "Show control hints", kind = "toggle", default = true,
		note = "Feeding and dusk/rest prompts, every catch and night. Menu, Controls opens the full controls card." },
	{ id = "NotebookNotes", section = "help", label = "Say when a new notebook page opens", kind = "toggle", default = true },
} :: { Setting }

-- Rows that show and drive something the game already keeps elsewhere, so they are not saved settings (ROBLOX-71): no Player attribute of the
-- id, nothing in the save's settings, nothing in Reset to defaults. The spider is kept in the save as `appearance` (Player attribute
-- `Appearance`), and the client drives it through the panel's Io. `default` is only what an unknown reading says. The options and the words of
-- a live row come from the part that owns it (the Spider row's from Rig/SpiderChoice and UI/PeacockText, through SettingsModel), not from here.
SettingsSpec.LIVE = {
	{ id = "Spider", section = "spider", label = "Spider", kind = "choice", default = "first_spider",
		note = "Change it anywhere you stand safely. Not while jumping, on silk, moulting or holding prey." },
	-- ROBLOX-90: a button, not a value. It closes the panel into Inspect mode (a slow, close look at the spider), when the spider stands safely.
	{ id = "Inspect", section = "spider", label = "Inspect your spider", kind = "action", default = false,
		note = "A slow, close look from every side. Only while you stand safely. Cancel leaves." },
} :: { Setting }

-- How big the caption text is for each Captions option, as a multiple of the HUD's caption size (0: no captions of sounds at all).
SettingsSpec.CAPTION_SCALE = { off = 0, normal = 1, large = 1.5 } :: { [string]: number }

SettingsSpec.WORDS = {
	title = "Settings",
	reset = "Reset to defaults",
	resetSure = "Press again to reset",
	resetDone = "Settings are back to their defaults.",
	close = "Back",
	menuChoice = "Settings",
	on = "On",
	off = "Off",
	savedLine = "Your settings are kept with your saved game.",
	sessionLine = "Saving is off for this visit, so these settings last only until you leave.",
}

return SettingsSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Species</string>
            <string name="Source"><![CDATA[--!strict
-- GENERATED by tools/json_to_luau.py from data/species/*.json. Do not edit by hand.
-- Species profiles. 1 Godot WU = 1 stud, so every value is unchanged.
local data = {
	fly_like_prototype = {
		schema_version = 1,
		id = "fly_like_prototype",
		biological_status = "prototype_behavior_no_species_claim",
		body = {
			radius_wu = 0.3,
			length_wu = 0.7,
			hover_wu = 0.16,
			capture_radius_wu = 0.45, -- Nathan playtest: total contact allowance 0.70 -> 0.75 WU (+7%); senses unchanged
			nutrition = 0.35,
			capture_assist_scale = 1.6,
			feed_rate_per_s = 0.1,
		},
		senses = {
			sight_range_wu = 14.0,
			full_sensitivity_wu = 3.0,
			front_half_deg = 90.0,
			rear_half_deg = 150.0,
			rear_gain = 0.12,
			motion_threshold_deg_s = 10.0,
			motion_scale_deg_s = 6.0,
			loom_scale_deg_s = 80.0,
			appear_motion_deg_s = 18.0,
			appear_range_wu = 8.0,
			sample_gap_max_s = 0.4,
			near_check_range_wu = 8.0,
			far_check_hz = 10.0,
			awareness_alert = 0.3,
			awareness_calm = 0.1,
			awareness_flee = 1.0,
			awareness_max = 1.5,
			decay_relaxed_per_s = 0.35,
			decay_alert_per_s = 0.18,
			unseen_decay_mult = 3.0,
			threat_memory_s = 2.0,
			vigilance_grooming = 0.5,
			vigilance_relaxed = 1.0,
			vigilance_alert = 1.5,
			startle_motion_deg_s = 70.0,
			startle_range_wu = 7.0,
			startle_rear_gain = 0.5,
		},
		reaction = {
			delay_startle_alert_s = { 0.04, 0.1 },
			delay_startle_relaxed_s = { 0.16, 0.36 },
			delay_startle_grooming_s = { 0.28, 0.48 },
			delay_deliberate_s = { 0.12, 0.28 },
		},
		flight = {
			takeoff_accel_wu_s2 = 80.0,
			flee_speed_wu_s = 15.0,
			cruise_speed_wu_s = 7.0,
			landing_speed_wu_s = 2.0,
			landing_slow_wu = 1.2,
			turn_rate_deg_s = 720.0,
			clearance_radius_wu = 0.14,
			lift_wu = 0.7,
			approach_wu = 0.8,
			min_hop_wu = 2.5,
			max_flight_wu = 26.0,
			takeoff_s = 0.18,
			flee_min_s = 0.7,
			safe_distance_wu = 9.0,
			perch_avoid_wu = 4.0,
			path_threat_clearance_wu = 1.5,
			cruise_accel_wu_s2 = 30.0,
			open_escape_wu = 6.0,
		},
		behavior = {
			fidget_interval_s = { 2.5, 7.0 },
			fidget_duration_s = { 0.2, 0.3 },
			fidget_distance_wu = { 0.12, 0.26 },
			perch_radius_wu = 0.4,
			groom_interval_s = { 6.0, 15.0 },
			groom_duration_s = { 1.0, 2.0 },
			alert_min_s = 1.0,
			min_commit_s = 1.2,
			hysteresis = 0.15,
			decision_hz = 7.5,
			restless_per_s = 0.03,
			restless_spread = 0.4,
			fatigue_up_per_s = 0.08,
			fatigue_down_per_s = 0.05,
			candidates_validated = 4,
			interrupt_threat = 0.5,
			block_retry_s = 4.0,
			reposition_max_wu = 12.0,
			glance_interval_s = { 0.8, 2.2 },
			glance_angle_deg = { 45.0, 135.0 },
			walk_interval_s = { 1.5, 5.0 },
			walk_distance_wu = { 0.4, 1.8 },
			walk_speed_wu_s = { 0.9, 1.8 },
			walk_burst_s = { 0.12, 0.35 },
			walk_pause_s = { 0.05, 0.25 },
			wander_radius_wu = 3.0,
			wander_flight_chance = 0.6,
		},
		population = {
			replenish_delay_s = { 25.0, 45.0 },
			replenish_retry_s = 0.5,
			vent_view_margin_deg = 12.0,
			vent_min_distance_wu = 10.0,
			entry_min_flight_wu = 8.0,
		},
		utility = {
			rest_base = 0.65,
			rest_fatigue = 0.4,
			rest_shelter = 0.1,
			rest_food = 0.15,
			rest_threat = 0.35,
			move_restless = 0.85,
			move_food = 0.3,
			move_shelter = 0.2,
			move_travel = 0.2,
			move_fatigue = 0.45,
			move_threat = 0.8,
			flee_threat = 0.9,
			flee_shelter = 0.25,
			flee_away = 0.3,
			flee_travel = 0.6,
		},
	},
	phidippus_audax_prototype = {
		schema_version = 1,
		id = "phidippus_audax_prototype",
		biological_status = "approximation_pending_species_review",
		body_length_wu = 1.0,
		locomotion = {
			walk_speed_wu_s = 2.5,
			stalk_speed_wu_s = 0.65,
			gravity_wu_s2 = 35.0,
			max_launch_speed_wu_s = 20.0,
			flight_time_min_s = 0.35,
			flight_time_max_s = 0.9,
		},
		perception = {
			inspect_cone_degrees = 30.0,
			easy_target_inspection_s = 0.4,
			fly_like_inspection_s = 1.0,
			easy_apparent_size_deg = 3.0,
			min_apparent_size_deg = 0.6,
			peripheral_cone_degrees = 300.0,
			peripheral_sector_degrees = 22.5,
			sensor_range_wu = 40.0,
			motion_min_speed_wu_s = 0.3,
			cue_cooldown_s = 0.8,
			broad_query_hz = 10.0,
			close_check_range_wu = 4.0,
			exposure_grace_s = 0.15,
			memory_decay_s = 6.0,
			focus_turn_rate_deg_s = 180.0,
			gaze_pitch_limit_deg = 35.0,
			contact_speed_bound_wu_s = 2.0,
			contact_size_ratio = 1.5,
		},
		silk = {
			max_line_length_wu = 20.0,
			reel_speed_wu_s = 1.5,
		},
		evidence_refs = { "B1", "B2", "B3", "B4" },
	},
}

-- A second, fruit-fly-inspired prey profile. Reuses the flight/senses model; these are game values,
-- not a claim that Drosophila has the house fly's measured behaviour.
local function copy(value: any): any
 if type(value) ~= "table" then return value end
 local out = {}; for k,v in value do out[k] = copy(v) end; return out
end
local fruit = copy(data.fly_like_prototype)
fruit.body.nutrition = 0.175 -- Exactly half a housefly meal.
fruit.body.visual_scale = 0.60
fruit.body.radius_wu = 0.18
fruit.body.capture_radius_wu = 0.42
fruit.body.prey_kind = "fruit_fly"
data.fruit_fly_prototype = fruit

-- ROBLOX-96 (W3, garden life): two prey of the bed under the window, derived the same way (game values; no claim that a fungus gnat or an aphid has the house
-- fly's measured behaviour, only its model with smaller numbers). Both keep the house fly's hover (the perch graph's number) and are drawn smaller.
-- The fungus gnat: a third of a housefly meal, a weak flier of short flights (half the cruise and flee speeds, flights of at most 10 studs, hops from 1.2), a
-- shorter sight and a shorter escape, slow short walks; it comes into the bed from the soil (its vents) and rests on the soil and under leaves.
local gnat = copy(data.fly_like_prototype)
gnat.body.nutrition = 0.35 / 3 -- a third of a housefly meal
gnat.body.visual_scale = 0.45
gnat.body.radius_wu = 0.12
gnat.body.capture_radius_wu = 0.40
gnat.body.prey_kind = "fungus_gnat"
gnat.senses.sight_range_wu = 9.0
gnat.senses.startle_range_wu = 5.0
gnat.flight.takeoff_accel_wu_s2 = 40.0
gnat.flight.flee_speed_wu_s = 7.0
gnat.flight.cruise_speed_wu_s = 3.5
gnat.flight.landing_speed_wu_s = 1.2
gnat.flight.clearance_radius_wu = 0.10
gnat.flight.lift_wu = 0.5
gnat.flight.approach_wu = 0.5
gnat.flight.min_hop_wu = 1.2
gnat.flight.max_flight_wu = 10.0
gnat.flight.safe_distance_wu = 6.0
gnat.flight.perch_avoid_wu = 2.5
gnat.flight.open_escape_wu = 3.0
gnat.behavior.reposition_max_wu = 10.0 -- (its whole flight: the bed's perches are farther apart than the sill's)
gnat.behavior.restless_per_s = 0.06 -- (restless twice as soon as the house fly: a gnat does not sit long)
gnat.behavior.hysteresis = 0.1 -- (and changes its mind for less: with move_restless 1.0, a restless gnat on open soil flits to the next perch, one under a leaf stays)
gnat.utility.move_restless = 1.0
gnat.behavior.walk_distance_wu = { 0.2, 0.8 }
gnat.behavior.walk_speed_wu_s = { 0.4, 0.9 }
gnat.behavior.wander_radius_wu = 1.5
gnat.behavior.wander_flight_chance = 0.3
gnat.population.vent_min_distance_wu = 8.0
gnat.population.entry_min_flight_wu = 4.0
data.fungus_gnat_prototype = gnat
-- The aphid: a sixth of a housefly meal, and a walker (body.walker): it never flies (Prey/Fly.launch refuses it, so FlyFlight is never used for it), lives on
-- the plants' stems and leaves (the bed's walker perches, in small groups) and only shuffles about its perch; startled, it freezes.
local aphid = copy(data.fly_like_prototype)
aphid.body.nutrition = 0.35 / 6 -- a sixth of a housefly meal
aphid.body.visual_scale = 0.40
aphid.body.radius_wu = 0.10
aphid.body.capture_radius_wu = 0.38
aphid.body.prey_kind = "aphid"
aphid.body.walker = true
aphid.body.feed_rate_per_s = 0.06
aphid.senses.sight_range_wu = 4.0
aphid.senses.startle_range_wu = 3.0
aphid.behavior.walk_distance_wu = { 0.1, 0.4 }
aphid.behavior.walk_speed_wu_s = { 0.15, 0.35 }
aphid.behavior.walk_interval_s = { 4.0, 12.0 }
aphid.behavior.wander_radius_wu = 0.8
aphid.behavior.perch_radius_wu = 0.25
aphid.behavior.fidget_distance_wu = { 0.04, 0.1 }
-- ROBLOX-105 (Nathan's W3 call, "the aphids wander the plant"): now and then, calm, it walks over its plant's faces to another free perch of the same plant,
-- slowly (Prey/PreyKinds.creep): every 40 to 110 s, at 0.12 to 0.25 studs a second, a walk of at most 24 studs. Game values.
aphid.body.creep = { every = { 40.0, 110.0 }, speed = { 0.12, 0.25 }, reach = 24.0 }
data.aphid_prototype = aphid
-- ROBLOX-101 (W3b part A, the garden's bestiary): four more prey, derived the same way (game values throughout; no claim that any of them has the house fly's
-- measured behaviour, only its model with other numbers). Read with Prey/PreyKinds, which owns the new behaviours: `body.hop` (a ballistic escape hop on the
-- reaction model: min and max length, the time in the air, the height of the arc, and the chance of flying on after landing), `body.flightless` (never begins a
-- flight; it hops or stays), `body.sidestep` (when watched closely it goes round to the far side of its stem or leaf), `body.dusk` / `body.day` (the name of the
-- same animal's profile for the other part of the day: restless from dusk through the night, still by day), `body.slip_chance` (the first grip on it may fail:
-- it slips free, once), `body.shed_chance` and `body.shed_after` (in the struggle it may leave a leg and escape, once, that many seconds in), `body.catch_factor`
-- (Data/Catch.factorFor reads it before the meal, when a prey is harder or easier in the jaws than its meal says). Every one is drawn at its true size
-- (visual_scale 1, Data/FlyLook.small) and keeps the house fly's hover, the perch graph's number.
-- The springtail: an eighth of a housefly meal, flightless, and it flicks away from the spider with a hop of 1.5 to 4 studs that takes a sixth of a second; it
-- reacts fast and sees only a little way; it walks and fidgets in tiny steps about its spot on the soil.
local springtail = copy(data.fly_like_prototype)
springtail.body.nutrition = 0.35 / 8
springtail.body.visual_scale = 1.0
springtail.body.radius_wu = 0.08
springtail.body.capture_radius_wu = 0.34
springtail.body.prey_kind = "springtail"
springtail.body.flightless = true
springtail.body.feed_rate_per_s = 0.05
springtail.body.hop = { min = 1.5, max = 4.0, time = 0.16, apex = 0.7 }
springtail.senses.sight_range_wu = 3.0
springtail.senses.startle_range_wu = 2.5
springtail.reaction.delay_startle_alert_s = { 0.01, 0.03 }
springtail.reaction.delay_startle_relaxed_s = { 0.02, 0.06 }
springtail.reaction.delay_startle_grooming_s = { 0.04, 0.09 }
springtail.flight.clearance_radius_wu = 0.06
springtail.behavior.walk_interval_s = { 2.0, 6.0 }
springtail.behavior.walk_distance_wu = { 0.05, 0.3 }
springtail.behavior.walk_speed_wu_s = { 0.1, 0.3 }
springtail.behavior.wander_radius_wu = 0.6
springtail.behavior.perch_radius_wu = 0.2
springtail.behavior.fidget_distance_wu = { 0.02, 0.06 }
springtail.population.replenish_delay_s = { 20.0, 40.0 }
springtail.population.vent_min_distance_wu = 5.0
data.springtail_prototype = springtail
-- The leafhopper: half a housefly meal but as hard in the jaws as a house fly (catch_factor 1.0: it kicks), it sits along a stem or a leaf and sidesteps to the
-- far side when the spider watches it, and when the spider comes close and moves it jumps 3 to 10 studs in under a third of a second, and a third of the time
-- flies on a short way after landing. Its flights are short; it is restless rarely (it sits for minutes).
local leafhopper = copy(data.fly_like_prototype)
