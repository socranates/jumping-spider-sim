# Godot 4+ specific ignores
.godot/
/android/

# Local to each machine
godot_path.txt
tests/reports/

# Local environment and credentials
.env
.env.*
!.env.example

# Godot import files for the pictures in docs (made on each machine, never needed)
docs/**/*.import

# Roblox Studio local edit locks/autosaves
*.rbxlx.lock
*.rbxl.lock
*.rbxlx.autosave
__pycache__/
*.pyc
