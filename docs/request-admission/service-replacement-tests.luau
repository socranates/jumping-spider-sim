for _,mode in Rules.MODES do
 test("actual-replacement-keeps-account-debt-and-originals-"..mode,function()
  local f=fixture();f.recover(mode);local old=f.owner;local lane=old.session.ordinaryAdmission
  f.begin();f.drive(function() return f.client.transition==nil and #f.owners==2 end)
  accounted(f)
  check(old:replacementClosed() and not f.g:live(lane.scope) and f.g:live(f.owner.session.ordinaryAdmission.scope),"replacement overlapped old and new account scopes")
  check(f.seeds==1 and f.owner.session.ordinaryAdmission.scope~=lane.scope and next(f.server.debts)==nil,"replacement reseeded, reused a scope or copied old aggregate debt")
  check(nonP(f.b)==f.before and table.find(f.b.data.P_46001.payload.notebook.opened,"replacement_final_note")~=nil,"typed replacement changed originals or lost final progress")
  local before=f.starts
  f.server:onMessage(f.player,{kind="progress",epoch=f.oldEpoch,progress=Progress.default()})
  f.server:onMessage(f.player,{kind="life_intent",epoch=f.oldEpoch,intent="new",mode=mode,serial=1})
  check(f.starts==before and f.client:decision(mode)==nil,"old epoch traffic acquired authority")
  check(#f.errors==0,"typed replacement hid a service error: "..tostring(f.errors[1]))
  f.server:removePlayer(f.player);closed(f)
 end)
end
test("lost-replacement-control-packets-do-not-create-extra-scopes",function()
 local f=fixture({changingKey=true,drops={session_replace_request=1,session_replace_offer=1,session_replace_ack=1,session_replace_commit=1,session_replace_ready=1,new_loaded=1}})
 f.recover("main");f.begin();f.drive(function() return f.client.transition==nil and #f.owners==2 end)
 check(f.seeds==1 and f.keyLookups==1 and f.owner.session.cfg.userId==46001 and f.b.data.P_46002==nil,"replacement retries changed physical account or reseeded debt")
 check(f.pauses==1 and f.menus==1 and nonP(f.b)==f.before,"lost packets repeated activation or changed originals")
 f.server:removePlayer(f.player);closed(f)
end)
test("failed-replacement-factory-closes-its-new-scope-without-fallback",function()
 local f=fixture({factoryFail=true});f.recover("main");f.begin()
 f.drive(function() return f.client.transition and f.client.transition.stage=="failed" end)
 check(#f.owners==1 and f.oldOwner:replacementClosed() and f.g:inspect().scopes==0,"failed replacement kept a new scope or reused old authority")
 check(nonP(f.b)==f.before and f.seeds==1,"failed replacement changed originals or cleared debt")
 f.server:removePlayer(f.player);closed(f)
end)
test("late-initial-constructor-cannot-replace-a-rejoined-account",function()
 local f=fixture({deferAdd=true,pauseInitialFactory=true})
 local co=coroutine.create(function() f.server:addPlayer(f.player) end);local ok,why=coroutine.resume(co);assert(ok,why)
 check(why=="replacement-factory-paused" and f.g:inspect().scopes==1,"initial account construction did not suspend after admission")
 f.server:removePlayer(f.player);f.server:addPlayer(f.player)
 local fresh=f.owner;local entry=f.server.base.entries[f.player];local starts=f.starts
 ok,why=coroutine.resume(co);assert(ok,why)
 check(#f.owners==1 and f.owner==fresh and f.server.base.entries[f.player]==entry and not fresh.session.closed and f.starts==starts,"late constructor revived or closed the rejoined epoch")
 check(f.g:inspect().scopes==1 and f.g:live(fresh.session.ordinaryAdmission.scope),"late constructor closed the fresh account scope")
 f.server:removePlayer(f.player);closed(f)
end)
test("shutdown-revokes-an-unreturned-constructor",function()
 local f=fixture({deferAdd=true,pauseInitialFactory=true})
 local co=coroutine.create(function() f.server:addPlayer(f.player) end);local ok,why=coroutine.resume(co);assert(ok,why)
 f.server:shutdown();ok,why=coroutine.resume(co);assert(ok,why)
 check(#f.owners==0 and (f.starts or 0)==0 and f.server.base.entries[f.player]==nil,"late shutdown constructor started storage or became an owner")
 closed(f)
end)
test("rejoin-waits-for-cancelled-native-acquisition-and-cleanup",function()
 local f=fixture({deferAdd=true});f.pauseInitialStage="after";local addingA,addingB;local first=true
 f.onSleep=function()
  if coroutine.running()==addingA and first then first=false;coroutine.yield("old-load-awaiting-native")
  elseif coroutine.running()==addingB then coroutine.yield("new-account-awaiting-old") end
 end
 addingA=coroutine.create(function() f.server:addPlayer(f.player) end)
 local ok,why=coroutine.resume(addingA);assert(ok,why);check(why=="old-load-awaiting-native","old load did not wait for its native call")
 local old=f.owner;f.server:removePlayer(f.player)
 addingB=coroutine.create(function() f.server:addPlayer(f.player) end)
 ok,why=coroutine.resume(addingB);assert(ok,why)
 check(why=="new-account-awaiting-old" and #f.owners==1 and f.starts==1 and f.g:inspect().started==1,"rejoin overlapped a cancelled provider")
 f.releaseNative=true;ok,why=coroutine.resume(addingA);assert(ok,why)
 check(coroutine.status(addingA)=="dead" and old.runtime.result.leaseReleased and f.g:inspect().started==0,"cancelled native acquisition did not drain/clean")
 ok,why=coroutine.resume(addingB);assert(ok,why);f.onSleep=nil
 check(coroutine.status(addingB)=="dead" and #f.owners==2 and f.seeds==1 and f.starts==8,"new epoch failed after drain or reset account history")
 check(f.owner.session:isActive() and f.b.data.P_46001.lock.session==f.owner.session.id and old.session.closed,"rejoin revived the old session")
 f.server:removePlayer(f.player);closed(f)
end)
test("shutdown-drains-a-native-initial-load-on-its-own-engine-task",function()
 local f=fixture({deferAdd=true});f.pauseInitialStage="after";local adding;local first=true
 f.onSleep=function()
  if coroutine.running()==adding and first then first=false;coroutine.yield("shutdown-initial-native")
  elseif coroutine.running()~=adding and coroutine.status(adding)=="suspended" then local ok,why=coroutine.resume(adding);assert(ok,why) end
 end
 adding=coroutine.create(function() f.server:addPlayer(f.player) end);local ok,why=coroutine.resume(adding);assert(ok,why)
 check(why=="shutdown-initial-native","shutdown fixture did not await a native load")
 f.releaseNative=true;f.server:shutdown();f.onSleep=nil;closed(f)
 check(coroutine.status(adding)=="dead" and f.starts==4 and f.owner.runtime.result.leaseReleased and f.b.data.P_46001.lock==nil,"shutdown failed initial native drain/release")
end)
test("shutdown-deadline-revokes-a-still-pending-native-provider",function()
 local f=fixture({deferAdd=true});f.pauseInitialStage="after";local adding;local first=true
 f.onSleep=function() if coroutine.running()==adding and first then first=false;coroutine.yield("deadline-native") end end
 adding=coroutine.create(function() f.server:addPlayer(f.player) end);local ok,why=coroutine.resume(adding);assert(ok,why)
 f.server:shutdown()
 local q=f.g:inspect();check(q.scopes==0 and q.started==1 and not f.owner.runtime.result.leaseReleased and f.owner.session.closed,"shutdown deadline left live authority or forged release")
 check(f.starts==1 and f.b.data.P_46001.lock.session==f.owner.session.id,"shutdown deadline rolled back or replayed a committed acquisition")
 f.releaseNative=true;ok,why=coroutine.resume(adding);assert(ok,why);f.onSleep=nil;closed(f)
 check(coroutine.status(adding)=="dead" and f.starts==1 and not f.owner.runtime.result.leaseReleased,"late native completion revived cleanup after its deadline")
end)
