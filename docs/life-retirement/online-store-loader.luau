r = 1.0,\n\t\tvibration_group = \"planter_leaves\",\n\t\twetness_response_profile = \"dry_only_prototype\",\n\t},\n\tpainted_ceiling = {\n\t\tschema_version = 1,\n\t\tid = \"painted_ceiling\",\n\t\tattachable = true,\n\t\tsilk_anchor_allowed = true,\n\t\tadhesion_multiplier = 1.0,\n\t\tvibration_group = \"lab_overhang\",\n\t\twetness_response_profile = \"plaster_default\",\n\t},\n\tpainted_metal_smooth = {\n\t\tschema_version = 1,\n\t\tid = \"painted_metal_smooth\",\n\t\tattachable = true,\n\t\tsilk_anchor_allowed = true,\n\t\tadhesion_multiplier = 0.9,\n\t\tvibration_group = \"lab_platforms\",\n\t\twetness_response_profile = \"metal_default\",\n\t},\n\tpainted_wood_dry = {\n\t\tschema_version = 1,\n\t\tid = \"painted_wood_dry\",\n\t\tattachable = true,\n\t\tsilk_anchor_allowed = true,\n\t\tadhesion_multiplier = 1.0,\n\t\tvibration_group = \"lab_floor\",\n\t\twetness_response_profile = \"wood_default\",\n\t},\n\tplaster_matte = {\n\t\tschema_version = 1,\n\t\tid = \"plaster_matte\",\n\t\tattachable = true,\n\t\tsilk_anchor_allowed = true,\n\t\tadhesion_multiplier = 1.0,\n\t\tvibration_group = \"lab_walls\",\n\t\twetness_response_profile = \"plaster_default\",\n\t},\n\tptfe_coated = {\n\t\tschema_version = 1,\n\t\tid = \"ptfe_coated\",\n\t\tattachable = false,\n\t\tsilk_anchor_allowed = false,\n\t\tadhesion_multiplier = 0.0,\n\t\tvibration_group = \"lab_coated\",\n\t\twetness_response_profile = \"ptfe_default\",\n\t},\n\tvarnished_wood_smooth = {\n\t\tschema_version = 1,\n\t\tid = \"varnished_wood_smooth\",\n\t\tattachable = true,\n\t\tsilk_anchor_allowed = true,\n\t\tadhesion_multiplier = 0.9,\n\t\tvibration_group = \"lab_ramp\",\n\t\twetness_response_profile = \"wood_default\",\n\t},\n}\n\nreturn table.freeze(data)\n",2548,697192054},{"Shared/Data/Tarantula","--!strict\n-- The tarantulas' threat display and silk mat (ROBLOX-82): every number the pose needs. The pose is presentation only: it bends and\n-- turns the drawn spider; it never changes the motor, the collider, the path, the speed, the jump, the senses, the dragline, the wasp or\n-- the rival. Unlike the peacock's dance (Girard et al. 2011) and the ant mimic's walk (Shamble et al. 2017) there is no measured record\n-- behind these numbers: nothing below is a rate or an angle from a paper, and every one is marked ART (artistic: chosen to read well on a\n-- small screen, from what is generally known of the behaviour, which this round did not check against a source; see\n-- docs/NOTEBOOK_SOURCES.md for what the notebook page rests on).\n--\n-- What the pose draws, as general knowledge of New World tarantulas (the pack's two species both are): a threatened tarantula rears up on\n-- its hind legs, raising the front of the body, lifting the first pair of legs and the pedipalps and showing its fangs, and holds the\n-- posture; and tarantulas lay silk by drawing their spinnerets over the ground, in sheets and mats. The game's loop puts the two side by\n-- side: the rear-up, a settle, then a turn about on the spot with the spinnerets swinging side to side as if laying a mat, and back.\n-- The tarantula is a costume on the jumping spider's body (ROBLOX-81), so the display is a drawn pose and nothing more.\n\nlocal Tarantula = {}\n\nTarantula.pack = \"tarantula_pack\"\nTarantula.ids = { \"brachypelma_hamorii\", \"chromatopelma_cyaneopubescens\" } :: { string }\n\n-- ---------------------------------------------------------------- the loop (ART)\n-- One loop is 6 seconds, in order; it repeats until the player ends it. Every level starts and ends the loop at 0, so the repeat has no jump.\n--   rear   the prosoma pitches up and legs I and the pedipalps lift (the rise);\n--   threat the posture is held, with a faint tremble of the raised legs;\n--   settle the prosoma comes back down and legs I and the pedipalps lower;\n--   turn   the drawn body pivots about its up axis, 0 to 180 degrees, the spinnerets swinging side to side;\n--   mat    the body holds at 180 degrees, spinnerets still swinging;\n--   return the body pivots back to 0 as the swing dies away.\nTarantula.loopSeconds = 6.0\nTarantula.phases = {\n\t{ id = \"rear\", seconds = 0.5 },\n\t{ id = \"threat\", seconds = 2.2 },\n\t{ id = \"settle\", seconds = 0.5 },\n\t{ id = \"turn\", seconds = 1.2 },\n\t{ id = \"mat\", seconds = 0.4 },\n\t{ id = \"return\", seconds = 1.2 },\n} :: { { id: string, seconds: number } }\n\n-- ---------------------------------------------------------------- amplitudes and rates (ART)\nTarantula.rearDeg = 32 -- how far the prosoma pitches up about the waist\nTarantula.palpDeg = 55 -- how far each pedipalp lifts at its base (the palp is leg-like, so it comes up with legs I)\nTarantula.pivotDeg = 180 -- how far the body turns about its up axis\nTarantula.sweepDeg = 25 -- how far the spinnerets swing either side of straight back (the second segment swings `tipSweep` times as far: the profile's `threat`)\nTarantula.sweepHz = 1.4 -- the swing's rate (a slow stroke: never above 3 Hz, nothing that flashes)\nTarantula.sweepEaseSeconds = 0.3 -- the swing arrives and leaves over this long at the ends of the turn\nTarantula.tremorHz = 2.2 -- the raised legs' faint tremble in the hold (its size is the profile's `threat.tremor`)\nTarantula.rampInSeconds = 0.1 -- a pose given after a stop does not start with a jump\nTarantula.fadeOutSeconds = 0.25 -- an ended pose eases out over this long and the legs go back to the motor\nTarantula.reducedMotion = 0.5 -- ReducedMotion halves every angle and stops the tremble; the posture still shows\n\nreturn Tarantula\n",3708,1423956400},{"Shared/Data/Wasp","--!strict\n-- The mud dauber wasp's rules: every number of scripts/predator/wasp_director.gd (LIFE round 4, LIFE-14 to LIFE-17), unchanged, in\n-- Godot's units (1 WU = 1 stud = 1 cm). They are design choices tuned for fairness, not measurements (LIFE-17): sight range, notice\n-- rates, timings and the places it looks. The Godot names are in comments where this file renames them. Predator/WaspDirector reads\n-- them; nothing else decides what the wasp does.\n--\n-- Roblox-only additions are marked \"Roblox:\". Everything about how it looks is in Data/WaspLook.\n\nlocal Wasp = {}\n\nexport type Point = { id: string, hover: Vector3, land: Vector3? }\n\n-- When it may come: the days and the warm middle of the day (hours of the life clock).\nWasp.firstDay = 2\nWasp.visitChance = 0.6\nWasp.windowFromH = 10.0\nWasp.windowToH = 15.5\n\n-- The game's own rules, which the Godot replay above does not use (the goldens keep the values above; WaspDirector:useGameRules() applies these):\n-- a visit on every day from firstDay (guaranteed, ROBLOX-67), two a day in two windows of the day (ROBLOX-75), and Chet's longer, slightly\n-- sharper visits (ROBLOX-62). The first-day, first-meal and rest protections do not change.\nWasp.game = {\n\tvisitChance = 1.0, -- 1 = every visit of every day from firstDay (Godot: visitChance above, some days only); a visit of the day is drawn against it each\n\t-- ROBLOX-75 (Nathan: \"the wasp needs to be around more, maybe a couple times through the day\"): two visits a day, one in each of these windows\n\t-- (from, to; hours of the life clock; Godot has the one window windowFromH to windowToH above). The hour of each is drawn from the world's seed,\n\t-- the day and the visit's place in the day, in the window's first part (up to an hour before its end, so a rest can still delay it inside the\n\t-- window), and the afternoon's is at least minGapH after the morning's. Every visit is a full one (the warning, the search, its own takesRival\n\t-- draw below) and has its own protections: a rest or moult at its hour only delays it to the window's end, and a rest through the whole window\n\t-- skips that visit and no other.\n\twindows = { { 9.5, 12.0 }, { 13.5, 16.5 } },\n\tminGapH = 2.0,\n\tsearchScale = 1.6, noticeScale = 1.2, inspectScale = 0.8,\n\t-- ROBLOX-70 (Nathan: \"The wasp should kill the rival male like 10 percent of the time\"): the chance, per visit, that a visit is for the rival\n\t-- male instead of the spider, when there is a free rival on the sill that is not in the retreat. Drawn from a stream of its own (the visit's\n\t-- seed), so the places and times of the other draws do not change. 0 turns it off.\n\ttakesRival = 0.10,\n\t-- ROBLOX-106 (W4, Nathan: \"sometimes you worry about starving because a wasp or other thing won't go away\"): the standard rules only (WaspDirector `nature`, which\n\t-- the client sets when the rules are not gentle). Each day's two windows slide by up to `shiftH` either way (a draw of their own from the seed, the day and the\n\t-- window), so the visits do not keep to the clock; each visit's search lasts its usual 72 s times a draw from `visit` (0.6 to 1.5: 43 to 108 s), and with\n\t-- `lingerChance` (about one visit in twelve, so one lingering visit every six days or so at two a day) it lingers, `linger` times as long (3 to 5: 3.6 to 6 minutes\n\t-- on the sill, five game hours at the most). The draws come from the seed, the day and the visit's number, which the wasp's record keeps, so a return to a rest meets\n\t-- the same visits; a visit going on is not kept, as before.\n\tnature = { shiftH = 1.0, visit = { 0.6, 1.5 }, lingerChance = 0.08, linger = { 3.0, 5.0 } },\n}\n\n-- How it takes the rival (the game only; Godot's wasp has no rival): it flies to a place just above it and a little aside (the first of these\n-- offsets from which the way down is clear), hangs there, strikes and carries it up and away like a spider.\nWasp.rival = {\n\taboveWu = 1.3, -- above the rival's surface, where it hovers\n\toffsets = { { 0.0, 0.0 }, { 1.5, 0.0 }, { -1.5, 0.0 }, { 0.0, 1.5 }, { 0.0, -1.5 }, { 3.0, 0.0 }, { -3.0, 0.0 }, { 0.0, 3.0 }, { 0.0, -3.0 }, { 2.2, 2.2 }, { -2.2, 2.2 }, { 2.2, -2.2 }, { -2.2, -2.2 } },\n\tflySpeed = 5.0, -- it goes straight for it (searching is 4)\n\thoverS = 0.8, -- it hangs over it before it strikes\n\tstrikeS = 0.35,\n\tcatchWu = 0.8,\n\tclearRadius = 0.3, -- the way down to the rival is checked with this sphere\n\tearshotWu = 18.0, -- the player is told what happened (a caption, a notice) when the wasp is this near\n\tsightWu = 24.0, -- ... or in clear sight of it, this far\n}\n\n-- A visit (game seconds): heard while it arrives, searching, flying away, carrying the spider off.\nWasp.arriveS = 8.0\nWasp.searchS = 45.0\nWasp.leaveS = 5.0\nWasp.carryS = 3.5\n\n-- How it flies: between places at cruising height, in over the window frame from outside.\nWasp.cruiseY = 9.0\nWasp.entry = Vector3.new(38.0, 19.0, 2.0)\nWasp.over = Vector3.new(27.0, 15.0, 2.0)\nWasp.flySpeed = 4.0\nWasp.radius = 0.55 -- WU kept clear of the world on its paths in the air\nWasp.hoverS = { 1.5, 2.5 } -- how long it hovers to look\nWasp.scanDegS = 70.0 -- how fast it turns while it hovers\nWasp.landChance = 0.5\nWasp.landS = 0.6\nWasp.walkS = 2.0\nWasp.walkSpeed = 0.7\nWasp.stepEveryS = 0.5\n-- Roblox: the clearance for its steps on a surface. Godot's walk test uses the 0.55 sphere, which the physics engine lets start inside\n-- the floor it stands 0.35 above; Roblox's shape casts are not promised to, so a walking wasp is checked with a sphere that fits.\nWasp.walkRadius = 0.3\n\n-- What it sees.\nWasp.sightWu = 7.0\nWasp.noticeStill = 0.25 -- notice per second for a still spider at point-blank range\nWasp.noticeMoving = 1.6 -- added per second at walking speed\nWasp.noticeDecay = 0.2\nWasp.confuseS = 4.0\nWasp.afterLossNotice = 0.35\nWasp.loseUnseenS = 0.8\nWasp.farFromLossWu = 6.0\n\n-- Inspecting and striking.\nWasp.standoffWu = 1.2\nWasp.inspectSpeed = 2.5\nWasp.inspectS = 1.5\nWasp.inspectGiveUpS = 6.0 -- it cannot get to arm's length: it gives up on that spider\nWasp.strikeS = 0.35\nWasp.catchWu = 0.8\nWasp.holdBelow = 0.5\n\n-- The wasp as the spider's senses have it (wasp.gd): its eyes ahead of its centre, the size the senses give it. To the spider it is\n-- movement, never prey.\nWasp.eyeAhead = 1.0\nWasp.sensedRadius = 0.9\n\n-- The words and timing of the screen (Godot: caught_panel.gd QUIET_S, LINE_S). Roblox: captionTailS is how long the caption of the wasp\n-- leaving stays up and captionFadeS how long it takes to fade.\nWasp.caughtQuietS = 1.5 -- dim and quiet before the line\nWasp.caughtLineS = 1.5 -- the line alone before the summary and the choices\nWasp.caughtDim = 0.82\nWasp.captionTailS = 3.0\nWasp.captionFadeS = 1.0\n\n-- Where it looks for spiders: where it hovers to look and, on open surfaces, where it may land. Every hover point is open straight up\n-- to cruising height (tests check them on Godot's boxes; WaspSpec checks them on the real sill).\nlocal points: { Point } = {\n\t{ id = \"floor_middle\", hover = Vector3.new(0.0, 1.6, 6.0), land = Vector3.new(0.0, 0.35, 6.0) },\n\t{ id = \"floor_east\", hover = Vector3.new(14.0, 1.6, 7.0), land = Vector3.new(14.0, 0.35, 7.0) },\n\t{ id = \"floor_west\", hover = Vector3.new(-13.0, 1.6, 7.0), land = Vector3.new(-13.0, 0.35, 7.0) },\n\t{ id = \"floor_back\", hover = Vector3.new(-7.0, 1.6, -9.0), land = Vector3.new(-7.0, 0.35, -9.0) },\n\t{ id = \"leaf_west\", hover = Vector3.new(-15.0, 5.7, -1.5), land = Vector3.new(-15.0, 4.55, -1.5) },\n\t{ id = \"leaf_middle\", hover = Vector3.new(-1.0, 5.7, -1.5), land = Vector3.new(-1.0, 4.55, -1.5) },\n\t{ id = \"leaf_east\", hover = Vector3.new(21.5, 6.9, -3.0), land = Vector3.new(21.5, 5.75, -3.0) },\n\t{ id = \"planter\", hover = Vector3.new(10.0, 6.1, -4.0), land = Vector3.new(10.0, 4.95, -4.0) },\n\t{ id = \"back_wall_west\", hover = Vector3.new(-12.0, 5.0, -11.2) },\n\t{ id = \"back_wall_east\", hover = Vector3.new(12.0, 7.0, -11.2) },\n\t{ id = \"right_wall\", hover = Vector3.new(28.6, 4.0, 5.0) },\n\t{ id = \"under_leaf_middle\", hover = Vector3.new(-1.0, 2.4, 2.3) },\n\t{ id = \"under_leaf_west\", hover = Vector3.new(-15.0, 2.4, 2.3) },\n\t{ id = \"planter_front\", hover = Vector3.new(10.0, 2.0, 1.5) },\n\t{ id = \"crack_mouth\", hover = Vector3.new(-20.8, 1.6, 6.0) },\n}\nWasp.points = table.freeze(points)\n\nreturn Wasp\n",8223,1629769409},{"Shared/Data/WaspLook","--!strict\n-- How the mud dauber wasp looks: numbers and names only; Client/WaspBody builds the parts and poses them each frame. A black-and-yellow\n-- mud dauber (Sceliphron caementarium) about 2.5 cm long, 1 stud = 1 cm: a black head with big dark eyes and yellow mandibles, a black\n-- thorax with a yellow collar and a yellow scutellum, a very long thin yellow petiole (the thread waist) and a black gaster, six long legs\n-- with black femurs, a yellow band at each knee, and yellow tibias and feet, two smoky dark wings each side, and two curled antennae.\n-- The proportions, joints and walking and hanging poses are Godot's WaspBody (scripts/predator/wasp_body.gd, WASP-01), drawn here from\n-- Roblox parts (the fly's pattern, ROBLOX-22): ellipsoids are Parts with a SpecialMesh sphere, rods are Cylinder parts. Where Godot drew\n-- wings at 23 Hz (which a 60 Hz screen cannot show), the wing here is a soft translucent blur in flight, as the fly's.\n-- Body frame: -Z forward, +Y up, the origin the petiole's base, which is where the wasp's position is. Lengths are studs, colours hex,\n-- angles degrees. Ellipsoid `size` is the full diameters (Godot gave radii).\n\nlocal WaspLook = {}\n\nWaspLook.colors = {\n\tblack = \"191919\", yellow = \"d9af26\", eye = \"302b24\", wing = \"4a3b2b\", vein = \"5b4a31\", blur = \"3a2e22\",\n} :: { [string]: string }\n\n-- Reflectance (a glossy black chitin; the eyes a little more).\nWaspLook.gloss = { black = 0.05, yellow = 0.02, eye = 0.08 } :: { [string]: number }\n\n-- The ellipsoids that never move relative to the torso. `color` names WaspLook.colors.\nWaspLook.body = {\n\t{ name = \"Head\", color = \"black\", at = { 0, 0.04, -1.05 }, size = { 0.46, 0.40, 0.34 } },\n\t{ name = \"Thorax\", color = \"black\", at = { 0, 0.02, -0.63 }, size = { 0.48, 0.48, 0.70 } },\n\t{ name = \"Scutellum\", color = \"yellow\", at = { 0, 0.25, -0.52 }, size = { 0.26, 0.09, 0.17 } },\n\t{ name = \"Collar\", color = \"yellow\", at = { 0, 0.20, -0.85 }, size = { 0.40, 0.08, 0.11 } },\n\t{ name = \"Gaster\", color = \"black\", at = { 0, 0.025, 0.76 }, size = { 0.49, 0.44, 0.78 } },\n\t{ name = \"AbdomenTip\", color = \"black\", at = { 0, -0.01, 1.02 }, size = { 0.30, 0.30, 0.46 } },\n\t{ name = \"AbdomenBase\", color = \"yellow\", at = { 0, 0.04, 0.40 }, size = { 0.24, 0.23, 0.26 } },\n\t{ name = \"EyeL\", color = \"eye\", at = { -0.185, 0.075, -1.075 }, size = { 0.17, 0.30, 0.23 } },\n\t{ name = \"EyeR\", color = \"eye\", at = { 0.185, 0.075, -1.075 }, size = { 0.17, 0.30, 0.23 } },\n\t{ name = \"MandibleL\", color = \"yellow\", at = { -0.055, -0.10, -1.19 }, size = { 0.07, 0.14, 0.13 } },\n\t{ name = \"MandibleR\", color = \"yellow\", at = { 0.055, -0.10, -1.19 }, size = { 0.07, 0.14, 0.13 } },\n} :: { { name: string, color: string, at: { number }, size: { number } } }\n\n-- The thread waist: a thin yellow rod from the thorax to the gaster, a little narrower toward the gaster.\nWaspLook.petiole = { from = { 0, 0, -0.32 }, to = { 0, 0.04, 0.39 }, diameter = 0.062, color = \"yellow\" }\n\n-- The antennae: a base on the head, then a scape and a curled flagellum of three segments, in the antenna's own frame (right side; the\n-- left mirrors it). `rest` is its turn about x and y at rest, `flick` how far a searching wasp swings it (Godot: 0.20 and 0.12 rad, 0.32 rad).\nWaspLook.antenna = {\n\tbase = { 0.075, 0.13, -1.15 },\n\tpoints = { { 0, 0, 0 }, { 0.055, 0.10, -0.17 }, { 0.19, 0.06, -0.53 }, { 0.27, 0.02, -0.71 }, { 0.30, -0.06, -0.80 } },\n\tdiameters = { 0.04, 0.026, 0.020, 0.016 },\n\tcolors = { \"yellow\", \"black\", \"black\", \"black\" },\n\trest = { 0.20, 0.12 }, flick = 0.32, hertz = { 3.0, 0.7 },\n} :: { base: { number }, points: { { number } }, diameters: { number }, colors: { string }, rest: { number }, flick: number, hertz: { number } }\n\n-- A leg: where its hip sits on the torso (right side, front to hind), and the lengths of its parts. The joints come from WaspPose.\nWaspLook.legs = {\n\thips = { { 0.17, -0.12, -0.82 }, { 0.17, -0.12, -0.64 }, { 0.17, -0.12, -0.46 } },\n\tfemur = 0.062, tibia = 0.046, tarsus = 0.026,\n\tband = { length = 0.09, grow = 0.016 }, -- the yellow band at the knee end of the femur\n} :: { hips: { { number } }, femur: number, tibia: number, tarsus: number, band: { length: number, grow: number } }\n\n-- Wings: a fore and a hind wing each side. The membrane is a flat ellipse from the root back and out; in flight it is a soft blur of the\n-- whole stroke. root: where the wing's pivot sits (right side); sizes are the share of the forewing.\nWaspLook.wing = {\n\troot = { 0.14, 0.20, -0.68 }, hindStep = 0.17, hindShare = 0.68,\n\tlength = 1.15, width = 0.44, thick = 0.012, centre = { 0.20, 0, 0.56 }, sweep = 10,\n\t-- the angles (Godot): folded at rest on the ground, and the mean of the flap in the air\n\tfolded = { yaw = 12, roll = 6 }, flight = { yaw = 58, roll = 25, shimmerRoll = 7, shimmerHertz = 5.5 },\n\ttransparency = 0.45, flightTransparency = 0.62,\n\tblur = { widen = 1.55, transparency = 0.86 },\n\tvein = { diameter = 0.014, tipX = 0.30, to = 0.96 }, -- the dark edge from the root to near the tip\n\treflectance = 0.04,\n} :: any\n\n-- The torso's gentle bob in the air and while it holds the spider (Godot: 0.025 at 1.3 Hz).\nWaspLook.bob = { height = 0.025, hertz = 1.3 }\n\n-- The walking pose is a stride at 3 Hz; the feet reach the surface 0.35 below the position (the wasp lands 0.35 above it).\nWaspLook.walk = { hertz = 3.0, lift = 0.13, reach = 0.18 }\n\nreturn WaspLook\n",5360,3745865453},{"Shared/Data/Wear","--!strict\n-- What age and use have done to the sill, the glass and the retreat, and the few small things left lying about: numbers and names\n-- only; Habitat/Patina builds them. Colours are hex, lengths studs (1 stud = 1 cm). All of it is flat, tiny or thin, away from the\n-- spawn (-22, 0, 6), the silk practice lines and the landing patch, and nothing here is solid or queryable.\n\nlocal Wear = {}\n\n-- ---------------------------------------------------------------- the sill's paint\n-- The sill is cream enamel over wood (Graphics.paint); where the paint has gone the wood shows.\nWear.bare = { color = \"9b7650\", material = \"Wood\" }\n\n-- A worn strip along the front lip's top front edge: runs of bare wood between gaps, from x0 to x1 (z from `z0` to the edge).\nWear.lip = {\n\ty = 0.7, z0 = 12.24, z1 = 12.5, height = 0.012, x0 = -29, x1 = 29,\n\truns = { 1.2, 5.5 }, gaps = { 0.6, 3.2 }, -- length ranges\n\tcolors = { \"9b7650\", \"8e6a46\", \"a58058\" }, seed = 31,\n}\n\n-- Grime where the floor meets the walls: thin, translucent lines from (x0, z0) to (x1, z1), this wide.\nWear.grime = {\n\tcolor = \"6e6252\", transparency = 0.55, height = 0.003,\n\tlines = {\n\t\t{ -30.0, -12.36, -11.0, -12.36, 0.28 }, { -13.0, -12.40, 9.0, -12.40, 0.22 }, { 6.0, -12.34, 30.0, -12.34, 0.32 },\n\t\t{ -30.0, -12.20, 30.0, -12.20, 0.07 },\n\t\t{ -29.88, -12.5, -29.88, 11.9, 0.22 }, { -29.70, -9.0, -29.70, 6.0, 0.07 },\n\t\t{ 29.88, -12.5, 29.88, 11.9, 0.22 }, { 29.70, -5.0, 29.70, 10.0, 0.07 },\n\t\t{ -30.0, 11.93, 30.0, 11.93, 0.09 },\n\t},\n}\n\n-- Dust bunnies in the corners (the two at the back and one at the front right): a cluster of tiny, translucent grey spheres each.\nWear.bunnies = {\n\titems = {\n\t\t{ x = -29.1, z = -11.6, count = 9, spread = 0.55, seed = 11 },\n\t\t{ x = 29.0, z = -11.8, count = 7, spread = 0.5, seed = 12 },\n\t\t{ x = 29.0, z = 11.3, count = 6, spread = 0.42, seed = 13 }, -- the front right corner, where the lip meets the frame\n\t},\n\tcolor = \"b4afa5\", transparency = 0.6, radius = { 0.07, 0.17 }, lift = 0.7, -- lift: how flat the spheres are\n}\n\n-- ---------------------------------------------------------------- the window glass (full tier)\n-- Condensation on the lower panes: tiny flattened Glass spheres. Panes: x ranges clear of the mullions (the glass runs from -27.5\n-- to 27.5 with bars at -10 and 10).\nWear.drops = {\n\tcount = 26, size = { 0.1, 0.4 }, seed = 7,\n\ty = { 3.75, 7.2 }, panes = { { -27.0, -10.5 }, { -9.5, 9.5 }, { 10.5, 27.0 } },\n\tcolor = \"e8f3f5\", transparency = 0.35, reflectance = 0.3, flat = 0.018,\n}\nWear.smudges = {\n\titems = {\n\t\t{ x = -16.0, y = 5.0, w = 7.0, h = 3.5, turn = 18 },\n\t\t{ x = 15.5, y = 8.8, w = 6.0, h = 3.0, turn = -24 },\n\t},\n\tcolor = \"f6f4ee\", transparency = 0.93,\n}\n\n-- ---------------------------------------------------------------- the silk retreat in the crevice\n-- Salticids rest in silk retreats: a few overlapping translucent shells at the back and threads across the opening.\nWear.silk = {\n\tcolor = \"f4f4ee\", shellTransparency = 0.82, threadTransparency = 0.62, thread = 0.022,\n\t-- shells: centre x, y, z and radii (flattened domes lying on the floor, inside the crevice)\n\tshells = {\n\t\t{ -27.0, 0.0, 4.4, 1.7, 0.95, 1.5 }, { -26.2, 0.0, 6.6, 1.9, 1.05, 1.7 }, { -26.9, 0.0, 8.1, 1.6, 0.85, 1.2 },\n\t\t{ -25.4, 0.0, 5.3, 1.4, 0.75, 1.1 }, { -27.3, 0.0, 6.0, 1.3, 0.7, 2.1 },\n\t},\n\t-- threads across the opening (x = -23): from x, y, z to x, y, z. The middle of the opening is left clear for the camera that\n\t-- looks out of the retreat when the game starts.\n\tthreads = {\n\t\t{ -23.15, 2.55, 2.8, -23.05, 0.02, 3.4 }, { -23.15, 2.55, 3.7, -23.0, 0.3, 4.1 }, { -23.15, 2.55, 8.9, -23.05, 0.02, 8.4 },\n\t\t{ -23.15, 2.55, 8.1, -23.0, 0.3, 7.8 }, { -23.1, 2.45, 2.7, -23.1, 2.35, 9.3 }, { -23.1, 1.2, 2.7, -23.1, 1.3, 4.0 },\n\t\t{ -23.1, 1.3, 8.0, -23.1, 1.2, 9.3 },\n\t},\n}\n\n-- ---------------------------------------------------------------- small things on the floor\n-- A copper coin lying flat, plain faces, and a few fallen brown Pilea leaves.\nWear.coin = { x = 25.5, z = 9.5, diameter = 1.9, thickness = 0.12, color = \"b5764f\", material = \"Metal\" }\nWear.fallen = {\n\titems = {\n\t\t{ x = -11.6, z = 3.2, diameter = 1.7, color = \"a07a45\" },\n\t\t{ x = 4.8, z = 4.1, diameter = 1.3, color = \"c49a5b\" },\n\t\t{ x = 19.6, z = 2.9, diameter = 2.0, color = \"a07a45\" },\n\t},\n\tthickness = 0.03, material = \"Fabric\",\n}\n\nreturn Wear\n",4336,2361565395},{"Shared/Habitat/Breakaway","--!strict\n-- Godot windowsill.gd T09b: the pale east leaf tip falls on a committed jump.\n-- Called on simulation ticks, never wall time. Its identity survives falling/restores.\nlocal Breakaway={}\nBreakaway.__index=Breakaway\nBreakaway.RESET=8\nBreakaway.FALL=0.7\nfunction Breakaway.new(world: Instance, decor: Instance?): any\n local part=world:FindFirstChild(\"leaf_tip\")\n local pieces={}\n local pilea=if decor then decor:FindFirstChild(\"Pilea\") else nil\n local tip=if pilea then pilea:FindFirstChild(\"leaf_tip\") else nil\n if tip then\n  for _,p in tip:GetDescendants() do\n   if p:IsA(\"BasePart\") then table.insert(pieces,{part=p,frame=p.CFrame,transparency=p.Transparency}) end\n  end\n end\n return setmetatable({pieces=pieces,transparency=if part and part:IsA(\"BasePart\") then part.Transparency else 0,part=part,home=if part and part:IsA(\"BasePart\") then part.CFrame else CFrame.identity,\n  left=0,elapsed=0,last=nil},Breakaway)\nend\nfunction Breakaway.valid(record: any): boolean\n return record==nil or (type(record)==\"table\" and type(record.left)==\"number\" and record.left==record.left and record.left>=0 and record.left<=Breakaway.RESET)\nend\nfunction Breakaway.record(self: any): any return {left=self.left} end\nfunction Breakaway.apply(self: any, record: any)\n self.left=if record then record.left else 0\n self.elapsed=if self.left>0 then Breakaway.FALL else 0\n self.last=nil\n self:draw(false)\nend\nfunction Breakaway.draw(self: any,reduced: boolean)\n local p=self.part\n if not p then return end\n local down=self.left>0\n p.CanCollide=not down;p.CanQuery=not down\n local u=if down then math.clamp(self.elapsed/Breakaway.FALL,0,1) else 0\n local moved=if reduced then self.home else self.home*CFrame.new(.4*u,-5*u*u,0)*CFrame.Angles(0,0,-1.2*u)\n p.CFrame=if #self.pieces>0 then self.home else moved\n p.Transparency=if down and (reduced or u>=1) then 1 else self.transparency\n for _,entry in self.pieces do\n  if entry.part.Parent then\n   entry.part.CFrame=moved*self.home:Inverse()*entry.frame\n   entry.part.Transparency=if down and (reduced or u>=1) then 1 else entry.transparency\n  end\n end\nend\nfunction Breakaway.step(self: any,dt: number,outcome: any,position: Vector3,reduced: boolean): boolean\n local fell=false\n local wasDown=self.left>0\n if outcome and outcome~=self.last then\n  self.last=outcome\n  local p=outcome.plan\n  if self.left==0 and outcome.kind==\"launched\" and p and p.point and self.part then\n   local localPoint=self.home:PointToObjectSpace(p.point)\n   local half=self.part.Size*.5+Vector3.one*.02\n   if math.abs(localPoint.X)<=half.X and math.abs(localPoint.Y)<=half.Y and math.abs(localPoint.Z)<=half.Z then\n    self.left=Breakaway.RESET;self.elapsed=0;fell=true\n   end\n  end\n end\n if self.left>0 and not fell then\n  self.elapsed+=dt;self.left=math.max(0,self.left-dt)\n  if self.left==0 and self.part then\n   local p=self.home:PointToObjectSpace(position);local half=self.part.Size*.5+Vector3.one*1.3\n   if math.abs(p.X)<=half.X and math.abs(p.Y)<=half.Y and math.abs(p.Z)<=half.Z then self.left=.5 end\n  end\n end\n if fell or wasDown then self:draw(reduced) end\n return fell\nend\nreturn Breakaway\n",3112,2496606939},{"Shared/Habitat/DayLight","--!strict\n-- The light of the hour on the sill (ROBLOX-24, after Godot's LIFE-06 set_daylight): the life clock's daylight, 0 (night) to 1\n-- (day), blends the daytime lighting of Data/Graphics toward Graphics.dayNight. Pure apart from `apply`, so tests/life.luau\n-- checks it without an engine.\n--   * Full daylight is exactly the daytime look (Lit.apply's values, and SunPick's through-the-window clock).\n--   * The sun: dusk runs the picked morning backwards toward dayNight.nightClock (before sunrise), so the sun sinks on the\n--     window's side and the sky turns to night; dawn runs it forwards again.\n--   * The room's light, the haze, the sun rays, the light shafts and the dust motes dim with it; a low sun is warmer\n--     (Godot: the sun's colour whitens by daylight 0.6).\n-- The light is only what the screen shows. How far the spider sees comes from the clock (LifeLoop.rangeScale), never from here.\n-- It owns: Lighting's ClockTime, Brightness, Ambient, OutdoorAmbient, ColorShift_Top and ExposureCompensation; the Atmosphere's\n-- Color and Decay; SunRays.Intensity; the Shafts beams' Brightness and Enabled; the Motes' Brightness; and (ROBLOX-74, applyDew) the\n-- Transparency of the morning dew's drops. Never the eye view's effects (EyeGrade, EyeBlur, MacroDOF: SpiderEyes) or the world's Grade.\nlocal Graphics = require(script.Parent.Parent.Data.Graphics)\nlocal Flora = require(script.Parent.Parent.Data.Flora)\n\nlocal DayLight = {}\n\nexport type Targets = {\n\tdaylight: number, clock: number, brightness: number, exposure: number,\n\tambient: { number }, outdoorAmbient: { number }, colorShiftTop: { number },\n\tatmosphereColor: { number }, atmosphereDecay: { number },\n\tsunRays: number, shafts: number, motes: number,\n}\n\nlocal function mix(night: number, day: number, t: number): number\n\tif t >= 1 then return day end\n\tif t <= 0 then return night end\n\treturn night + (day - night) * t\nend\n\nlocal function mixRgb(night: { number }, day: { number }, t: number): { number }\n\treturn { mix(night[1], day[1], t), mix(night[2], day[2], t), mix(night[3], day[3], t) }\nend\n\nlocal function smoothstep(from: number, to: number, x: number): number\n\tlocal s = math.clamp((x - from) / (to - from), 0, 1)\n\treturn s * s * (3 - 2 * s)\nend\n\n-- What every light should be at `daylight` (clamped to [0, 1]). `dayClock` is the ClockTime of the day (SunPick's choice).\nfunction DayLight.targets(daylight: number, dayClock: number): Targets\n\tlocal d = math.clamp(if daylight == daylight then daylight else 1, 0, 1)\n\tlocal L, N, A = Graphics.lighting, Graphics.dayNight, Graphics.atmosphere\n\treturn {\n\t\tdaylight = d,\n\t\tclock = mix(N.nightClock, dayClock, d),\n\t\tbrightness = mix(N.brightness, L.brightness, d),\n\t\texposure = mix(N.exposureCompensation, L.exposureCompensation, d),\n\t\tambient = mixRgb(N.ambient, L.ambient, d),\n\t\toutdoorAmbient = mixRgb(N.outdoorAmbient, L.outdoorAmbient, d),\n\t\tcolorShiftTop = mixRgb(N.lowSunColorShiftTop, L.colorShiftTop, smoothstep(0, N.warmFrom, d)),\n\t\tatmosphereColor = mixRgb(N.atmosphereColor, A.color, d),\n\t\tatmosphereDecay = mixRgb(N.atmosphereDecay, A.decay, d),\n\t\tsunRays = Graphics.sunRays.intensity * d,\n\t\tshafts = d,\n\t\tmotes = mix(N.motesAtNight, 1, d),\n\t}\nend\n\n-- Whether the light needs setting again: it changed by applyStep, or it reached night or day.\nfunction DayLight.due(last: number?, daylight: number): boolean\n\tif last == nil then return true end\n\tif daylight ~= last and (daylight <= 0 or daylight >= 1) then return true end\n\treturn math.abs(daylight - last) >= Graphics.dayNight.applyStep\nend\n\nlocal function rgb(t: { number }): Color3\n\treturn Color3.fromRGB(math.floor(t[1] + 0.5), math.floor(t[2] + 0.5), math.floor(t[3] + 0.5))\nend\n\n-- Sets the lights. `decor` is Workspace.Decor (for the shafts and the motes), when it exists. Anything missing (the low tier\n-- has no sun rays or shafts) is skipped.\nfunction DayLight.apply(lighting: any, t: Targets, decor: Instance?)\n\tlighting.ClockTime = t.clock\n\tlighting.Brightness = t.brightness\n\tlighting.ExposureCompensation = t.exposure\n\tlighting.Ambient = rgb(t.ambient)\n\tlighting.OutdoorAmbient = rgb(t.outdoorAmbient)\n\tlighting.ColorShift_Top = rgb(t.colorShiftTop)\n\tlocal atmosphere = lighting:FindFirstChild(\"Atmosphere\")\n\tif atmosphere and atmosphere:IsA(\"Atmosphere\") then\n\t\tatmosphere.Color = rgb(t.atmosphereColor)\n\t\tatmosphere.Decay = rgb(t.atmosphereDecay)\n\tend\n\tlocal rays = lighting:FindFirstChild(\"SunRays\")\n\tif rays and rays:IsA(\"SunRaysEffect\") then\n\t\trays.Intensity = t.sunRays\n\tend\n\tif decor then\n\t\tlocal shafts = decor:FindFirstChild(\"Shafts\")\n\t\tif shafts then\n\t\t\tfor _, b in shafts:GetDescendants() do\n\t\t\t\tif b:IsA(\"Beam\") then\n\t\t\t\t\tb.Brightness = t.shafts\n\t\t\t\t\tb.Enabled = t.shafts > 0.01\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tlocal motes = decor:FindFirstChild(\"Motes\", true)\n\t\tif motes and motes:IsA(\"ParticleEmitter\") then\n\t\t\tmotes.Brightness = t.motes\n\t\tend\n\tend\nend\n\n-- ---------------------------------------------------------------- the morning dew (ROBLOX-74)\n-- How much dew there is at an hour of the day (0 to 1): it gathers through the night from Flora.dew.formFrom (20:00) to fullBy (05:00),\n-- holds until burnFrom (07:30) and is gone by goneBy (09:30), smoothly. It follows the hour, not the daylight, which is already full by 08:00.\nfunction DayLight.dewAt(hour: number): number\n\tif hour ~= hour or hour == math.huge or hour == -math.huge then return 0 end\n\tlocal D = Flora.dew\n\tlocal h = hour % 24\n\tif h >= D.goneBy and h < D.formFrom then return 0 end\n\tif h >= D.burnFrom and h < D.goneBy then return 1 - smoothstep(D.burnFrom, D.goneBy, h) end\n\treturn smoothstep(D.formFrom, D.fullBy + 24, if h >= D.formFrom then h else h + 24)\nend\n\n-- Sets the dew for `hour` on Workspace.Decor's folder \"Dew\" (Habitat/Dressing): each drop is shown from its Lag (the share of the dew at\n-- which it appears) to full at a dew of 1, with the transparency Base it carries. Nothing is touched unless the dew changed by Flora.dew.step\n-- (or reached 0 or 1); the last level is kept in the folder's attribute Level, so no one else holds state. Returns whether it set the drops.\nfunction DayLight.applyDew(decor: Instance?, hour: number): boolean\n\tlocal dew = if decor then decor:FindFirstChild(\"Dew\") else nil\n\tif not dew then return false end\n\tlocal level = DayLight.dewAt(hour)\n\tlocal last = dew:GetAttribute(\"Level\")\n\tif type(last) == \"number\" then\n\t\tif last == level then return false end\n\t\tif level > 0 and level < 1 and math.abs(level - last) < Flora.dew.step then return false end\n\tend\n\tdew:SetAttribute(\"Level\", level)\n\tfor _, drop in dew:GetDescendants() do\n\t\tlocal lag, base = drop:GetAttribute(\"Lag\"), drop:GetAttribute(\"Base\")\n\t\tif drop:IsA(\"BasePart\") and type(lag) == \"number\" and type(base) == \"number\" then\n\t\t\tlocal seen = math.clamp((level - lag) / (1 - lag), 0, 1)\n\t\t\tdrop.Transparency = 1 - seen * (1 - base)\n\t\tend\n\tend\n\treturn true\nend\n\nreturn DayLight\n",6871,3761040591},{"Shared/Habitat/Dressing","--!strict\n-- Dresses the sill (ROBLOX-74, \"more grass and detail\"), from Data/Flora, on top of what Plants and Patina already draw: moss on the shaded\n-- faces, pebbles and bark chips on the floor, two fallen leaves, and the morning dew. Pure visual density: every part is a drawn-only part\n-- (Habitat/Shapes: anchored, CanCollide, CanQuery and CanTouch all false), nothing here touches Layout.PIECES, and the places it uses are\n-- chosen by Shapes.clearAt, which only reads them. The dew's drops carry the attributes Lag and Base; Habitat/DayLight.applyDew sets their\n-- Transparency from the hour. Everything is placed from the world's seed with a salt of its own, so every player sees the same sill. Optional\n-- parts are marked FullOnly, which Client/WorldDetail removes on phones and tablets.\nlocal Flora = require(script.Parent.Parent.Data.Flora)\nlocal Wear = require(script.Parent.Parent.Data.Wear)\nlocal Graphics = require(script.Parent.Parent.Data.Graphics)\nlocal Plants = require(script.Parent.Plants)\nlocal Shapes = require(script.Parent.Shapes)\n\nlocal Dressing = {}\n\nlocal hex, folder, between = Shapes.hex, Shapes.folder, Shapes.between\nlocal TAU = 2 * math.pi\n\nlocal function pick<T>(list: { T }, rand: () -> number): T\n\treturn list[1 + math.floor(rand() * #list)]\nend\n\nlocal function stream(salt: number): () -> number\n\treturn Shapes.rng(Flora.worldSeed * 100 + salt)\nend\n\n-- ---------------------------------------------------------------- moss on the shaded faces\n-- The sun is behind the window, so the trough's room-side face and the foot of the back wall's room-side face are in shade. Each patch is a\n-- scatter of flattened mounds lying on the face (Flora.moss); the first `core` of a patch stay in the low tier, the rest are full-tier.\nfunction Dressing.moss(parent: Instance): Folder\n\tlocal M = Flora.moss\n\tlocal group = folder(parent, \"Moss\")\n\tlocal rand = stream(M.salt)\n\tfor i, patch in M.patches do\n\t\tlocal normal = Vector3.new(patch.normal[1], patch.normal[2], patch.normal[3])\n\t\tlocal centre = Vector3.new(patch.x, patch.y, patch.z)\n\t\tlocal across = normal:Cross(if math.abs(normal.Y) > 0.9 then Vector3.xAxis else Vector3.yAxis).Unit\n\t\tlocal up = normal:Cross(across)\n\t\tlocal cluster = folder(group, \"Patch\" .. i)\n\t\tlocal fine = folder(cluster, \"Fine\", true)\n\t\tfor j = 1, patch.n do\n\t\t\tlocal angle, dist = rand() * TAU, patch.r * math.sqrt(rand())\n\t\t\tlocal size = between(rand, M.size[1], M.size[2])\n\t\t\tlocal thick = size * M.mound\n\t\t\tlocal at = centre + across * (math.cos(angle) * dist) + up * (math.sin(angle) * dist)\n\t\t\tat = Vector3.new(at.X, math.max(at.Y, size * 0.7), at.Z) + normal * (thick * 0.35 + 0.02) -- not below the floor; sunk a third into the face\n\t\t\tlocal turn = rand() * TAU\n\t\t\tlocal along = across * math.cos(turn) + up * math.sin(turn)\n\t\t\tShapes.ellipsoid(if j <= patch.core then cluster else fine, `Moss{j}`, Vector3.new(size, thick, size * between(rand, 0.7, 1)),\n\t\t\t\tShapes.frame(at, along, normal), hex(pick(M.colors, rand)), M.material)\n\t\tend\n\tend\n\treturn group\nend\n\n-- ---------------------------------------------------------------- pebbles and bark chips on the floor\n-- The feet already taken on the floor (grass, the details, the coin and the Pilea's fallen leaves, the added windfall), so nothing lies on them.\nlocal function occupied(): { Vector3 }\n\tlocal out: { Vector3 } = {}\n\tfor _, blade in Plants.grassBlades() do table.insert(out, blade.foot) end\n\tfor _, c in Graphics.details.chips do table.insert(out, Vector3.new(c.x, 0, c.z)) end\n\tfor _, c in Graphics.details.crumbs do table.insert(out, Vector3.new(c.x, 0, c.z)) end\n\ttable.insert(out, Vector3.new(Wear.coin.x, 0, Wear.coin.z))\n\tfor _, leaf in Wear.fallen.items do table.insert(out, Vector3.new(leaf.x, 0, leaf.z)) end\n\tfor _, leaf in Flora.windfall.items do -- a leaf is long: its middle and a point toward each end (its X runs at `turn` about the vertical)\n\t\tlocal turn = math.rad(leaf.turn)\n\t\tfor _, along in { -0.35, 0, 0.35 } do\n\t\t\ttable.insert(out, Vector3.new(leaf.x + math.cos(turn) * leaf.length * along, 0, leaf.z - math.sin(turn) * leaf.length * along))\n\t\tend\n\tend\n\treturn out\nend\n\n-- How high the middle of a box of `size` turned by `turned` must be for its lowest point to touch the floor.\nlocal function restHeight(turned: CFrame, size: Vector3): number\n\treturn math.abs(turned.RightVector.Y) * size.X / 2 + math.abs(turned.UpVector.Y) * size.Y / 2 + math.abs(turned.LookVector.Y) * size.Z / 2\nend\n\n-- Pebbles first, then bark chips, in the order of Flora.litter; the first `core` of each stay in the low tier.\nfunction Dressing.litter(parent: Instance): Folder\n\tlocal L = Flora.litter\n\tlocal group = folder(parent, \"Litter\")\n\tlocal rand = stream(L.salt)\n\tlocal taken = occupied()\n\tlocal function spot(margin: number): Vector3?\n\t\tfor _ = 1, 40 do\n\t\t\tlocal x, z = between(rand, L.area.x0, L.area.x1), between(rand, L.area.z0, L.area.z1)\n\t\t\tif Shapes.clearAt(x, 0.02, z, margin) then\n\t\t\t\tlocal free = true\n\t\t\t\tfor _, other in taken do\n\t\t\t\t\tif (other.X - x) ^ 2 + (other.Z - z) ^ 2 < L.apart * L.apart then\n\t\t\t\t\t\tfree = false\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif free then return Vector3.new(x, 0, z) end\n\t\t\tend\n\t\tend\n\t\treturn nil\n\tend\n\tlocal B = L.pebbles\n\tlocal pebbles, loose = folder(group, \"Pebbles\"), folder(group, \"FinePebbles\", true)\n\tfor i = 1, B.count do\n\t\tlocal at = spot(0.5)\n\t\tif at then\n\t\t\ttable.insert(taken, at)\n\t\t\tlocal length = between(rand, B.length[1], B.length[2])\n\t\t\tlocal height = length * B.flat\n\t\t\tlocal size = Vector3.new(length, height, length * between(rand, 0.6, 0.9))\n\t\t\tlocal turned = CFrame.Angles(0, rand() * TAU, 0) * CFrame.Angles((rand() - 0.5) * 0.25, 0, (rand() - 0.5) * 0.25)\n\t\t\tShapes.ellipsoid(if i <= B.core then pebbles else loose, \"Pebble\" .. i, size, CFrame.new(at.X, restHeight(turned, size) * 0.8, at.Z) * turned,\n\t\t\t\thex(pick(B.colors, rand)), B.material) -- a fifth of its height sunk into the floor\n\t\tend\n\tend\n\tlocal K = L.bark\n\tlocal chips, fineChips = folder(group, \"Bark\"), folder(group, \"FineBark\", true)\n\tfor i = 1, K.count do\n\t\tlocal at = spot(0.5)\n\t\tif at then\n\t\t\ttable.insert(taken, at)\n\t\t\tlocal length, width, thick = between(rand, K.length[1], K.length[2]), between(rand, K.width[1], K.width[2]), between(rand, K.thick[1], K.thick[2])\n\t\t\tlocal size = Vector3.new(length, thick, width)\n\t\t\tlocal turned = CFrame.Angles(0, rand() * TAU, 0) * CFrame.Angles((rand() - 0.5) * K.tilt, 0, (rand() - 0.5) * K.tilt)\n\t\t\tShapes.block(if i <= K.core then chips else fineChips, \"Chip\" .. i, size, CFrame.new(at.X, restHeight(turned, size), at.Z) * turned, hex(pick(K.colors, rand)), K.material)\n\t\tend\n\tend\n\treturn group\nend\n\n-- ---------------------------------------------------------------- two fallen leaves\ntype Leaf = { x: number, z: number, length: number, width: number, turn: number, curl: number, color: string, rib: string }\n\n-- The frame of a fallen leaf's blade (an ellipsoid whose X runs along the leaf and Y is its thickness), turned about the vertical and with one\n-- edge lifted; the lower edge touches the floor.\nfunction Dressing.windfallFrame(leaf: Leaf): CFrame\n\tlocal W = Flora.windfall\n\tlocal curl = math.rad(leaf.curl)\n\treturn CFrame.new(leaf.x, W.thick * 0.5 + math.sin(curl) * leaf.width * 0.5, leaf.z) * CFrame.Angles(0, math.rad(leaf.turn), 0) * CFrame.Angles(curl, 0, 0)\nend\n\n-- The blade and a stub of stalk (both tiers) and the lighter midrib (full tier).\nfunction Dressing.windfall(parent: Instance): Folder\n\tlocal W = Flora.windfall\n\tlocal group = folder(parent, \"Windfall\")\n\tfor i, leaf in W.items do\n\t\tlocal frame = Dressing.windfallFrame(leaf)\n\t\tlocal one = folder(group, \"Leaf\" .. i)\n\t\tShapes.ellipsoid(one, \"Blade\", Vector3.new(leaf.length, W.thick, leaf.width), frame, hex(leaf.color), W.material)\n\t\tlocal half = leaf.length * 0.5\n\t\tlocal from, to = frame:PointToWorldSpace(Vector3.new(-half * 0.95, 0, 0)), frame:PointToWorldSpace(Vector3.new(-half - W.stalk, 0, 0))\n\t\tShapes.strip(one, \"Stalk\", from, to, 0.08, W.thick, hex(W.stalkColor), W.material)\n\t\tlocal rib = folder(one, \"Detail\", true)\n\t\tShapes.strip(rib, \"Rib\", frame:PointToWorldSpace(Vector3.new(-half * 0.9, W.thick * 0.5, 0)), frame:PointToWorldSpace(Vector3.new(half * 0.85, W.thick * 0.5, 0)),\n\t\t\t0.05, 0.01, hex(leaf.rib), W.material)\n\tend\n\treturn group\nend\n\n-- ---------------------------------------------------------------- the morning dew\n-- Small translucent Glass droplets. Each starts fully transparent (nothing shows until DayLight.applyDew is given an hour) and carries `Lag`, the\n-- share of the dew at which it appears and is gone, and `Base`, the transparency it has when it is there. Where a drop stands on something\n-- that the low tier removes, it is full-tier too.\nlocal function bead(parent: Instance, name: string, centre: Vector3, rand: () -> number, keep: boolean)\n\tlocal D = Flora.dew\n\tlocal d = between(rand, D.size[1], D.size[2])\n\tlocal drop = Shapes.ellipsoid(parent, name, Vector3.new(d, d * D.flat, d), CFrame.new(centre + Vector3.new(0, d * D.flat * 0.4, 0)), hex(D.color), D.material)\n\tdrop.Transparency = 1\n\tdrop.Reflectance = D.reflectance\n\tdrop:SetAttribute(\"Lag\", rand() * D.lag)\n\tdrop:SetAttribute(\"Base\", between(rand, D.transparency[1], D.transparency[2]))\n\tif not keep then drop:SetAttribute(\"FullOnly\", true) end\nend\n\n-- Drops on the tallest blade of most tufts (at the tip), around the rim of each green Pilea leaf and on the fallen leaves' edges, in a folder\n-- \"Dew\". The Pilea and fallen-leaf drops stand on the top of the leaf. Returns the folder.\nfunction Dressing.dew(parent: Instance): Folder\n\tlocal D = Flora.dew\n\tlocal group = folder(parent, \"Dew\")\n\tlocal rand = stream(D.salt)\n\n\tlocal grass = folder(group, \"Grass\")\n\tlocal tallest: { [number]: Plants.Blade } = {}\n\tlocal order: { number } = {}\n\tfor _, blade in Plants.grassBlades() do\n\t\tlocal best = tallest[blade.tuft]\n\t\tif not best then table.insert(order, blade.tuft) end\n\t\tif not best or blade.size.Y > best.size.Y then tallest[blade.tuft] = blade end\n\tend\n\tlocal n = 0\n\tfor _, tuft in order do\n\t\tif rand() < D.grass.chance then\n\t\t\tlocal blade = tallest[tuft]\n\t\t\tn += 1\n\t\t\tbead(grass, \"Drop\" .. n, blade.tip - blade.direction * 0.08, rand, not blade.fine and n % D.grass.keepEvery == 1)\n\t\tend\n\tend\n\n\tlocal leaves = folder(group, \"Leaves\")\n\tfor i, plant in Flora.pilea.plants do\n\t\tlocal kept = 0\n\t\tfor k = 1, D.pilea.perLeaf do\n\t\t\tlocal angle = TAU * (k - 1 + (rand() - 0.5) * 0.4) / D.pilea.perLeaf + i\n\t\t\tlocal keep = k % 2 == 1 and kept < D.pilea.keep\n\t\t\tif keep then kept += 1 end\n\t\t\tbead(leaves, `Drop{i}_{k}`, Plants.leafEdge(plant.leaf, angle, D.pilea.inset), rand, keep)\n\t\tend\n\tend\n\n\tlocal fallen = folder(group, \"Windfall\", true)\n\tfor i, leaf in Flora.windfall.items do\n\t\tlocal frame = Dressing.windfallFrame(leaf)\n\t\tfor k = 1, D.windfall.perLeaf do\n\t\t\tlocal angle = TAU * (k - 1 + (rand() - 0.5) * 0.4) / D.windfall.perLeaf + i\n\t\t\tlocal at = frame:PointToWorldSpace(Vector3.new(math.cos(angle) * leaf.length * 0.36, Flora.windfall.thick * 0.3, math.sin(angle) * leaf.width * 0.36))\n\t\t\tbead(fallen, `Drop{i}_{k}`, at, rand, true)\n\t\tend\n\tend\n\treturn group\nend\n\nreturn Dressing\n",11073,1599658633},{"Shared/Habitat/Lit","--!strict\n-- The lighting, sky and screen effects (Data/Graphics): a soft warm sun picked by SunPick so that it shines in through the\n-- window, Atmosphere haze for the view, a gentle bloom, grade and sun rays, clouds, and (full tier) a macro depth of field that\n-- keeps the sill sharp and melts the garden outside the window. Depth of field is only added when asked for (Server/Main asks\n-- for it unless the Workspace attribute DepthOfField is false).\n-- Technology (Future) cannot be set from a script; the Rojo projects author it. Idempotent: effects are reused by name.\nlocal Graphics = require(script.Parent.Parent.Data.Graphics)\nlocal SunPick = require(script.Parent.SunPick)\n\nlocal Lit = {}\n\nexport type Options = {\n\tsample: ((number, number) -> Vector3)?, -- the sun at (clock, latitude); default: ask the Lighting service\n\tdepthOfField: boolean?, -- true adds the macro depth of field (full tier) that the client keeps focused on the spider\n}\n\nlocal L = Graphics.lighting\n\nlocal function rgb(t: { number }): Color3\n\treturn Color3.fromRGB(t[1], t[2], t[3])\nend\n\n-- The child of `parent` with this name and class, made if missing (a wrong class under that name is replaced).\nlocal function child(parent: Instance, className: string, name: string): Instance\n\tlocal found = parent:FindFirstChild(name)\n\tif found and found.ClassName == className then return found end\n\tif found then found:Destroy() end\n\tlocal made = Instance.new(className)\n\tmade.Name = name\n\tmade.Parent = parent\n\treturn made\nend\n\nfunction Lit.apply(lighting: Lighting, terrain: Instance?, options: Options?): SunPick.Result\n\tlocal opts: Options = options or {}\n\tlighting.Brightness = L.brightness\n\tlighting.Ambient = rgb(L.ambient)\n\tlighting.OutdoorAmbient = rgb(L.outdoorAmbient)\n\tlighting.ColorShift_Top = rgb(L.colorShiftTop)\n\tlighting.EnvironmentDiffuseScale = L.environmentDiffuse\n\tlighting.EnvironmentSpecularScale = L.environmentSpecular\n\tlighting.ShadowSoftness = L.shadowSoftness\n\tlighting.ExposureCompensation = L.exposureCompensation\n\tlighting.GlobalShadows = true\n\n\t-- A sun that comes in through the window; if none can be found the old morning light stays.\n\tlocal sample = opts.sample or function(clock: number, latitude: number): Vector3\n\t\tlighting.GeographicLatitude = latitude\n\t\tlighting.ClockTime = clock\n\t\treturn lighting:GetSunDirection()\n\tend\n\tlocal picked: SunPick.Result? = nil\n\tlocal ok, outcome = pcall(function(): SunPick.Result\n\t\treturn SunPick.choose(sample, L.clockTime, L.latitude, Graphics.sun)\n\tend)\n\tif ok then picked = outcome :: any end\n\tlocal sun: SunPick.Result = picked or {\n\t\tok = false, clock = L.clockTime, latitude = L.latitude, direction = Vector3.new(0, 1, 0),\n\t\televationDeg = 90, azimuthDeg = 0, reason = \"the sun could not be sampled\",\n\t}\n\tlighting.ClockTime = sun.clock\n\tlighting.GeographicLatitude = sun.latitude\n\tlighting:SetAttribute(\"SunPick\", (if sun.ok then \"ok: \" else \"fallback: \") .. sun.reason)\n\n\tlocal A = Graphics.atmosphere\n\tlocal atmosphere = child(lighting, \"Atmosphere\", \"Atmosphere\") :: Atmosphere\n\tatmosphere.Density = A.density\n\tatmosphere.Offset = A.offset\n\tatmosphere.Color = rgb(A.color)\n\tatmosphere.Decay = rgb(A.decay)\n\tatmosphere.Glare = A.glare\n\tatmosphere.Haze = A.haze\n\n\tlocal S = Graphics.sky\n\tlocal sky = child(lighting, \"Sky\", \"Sky\") :: Sky\n\tsky.SunAngularSize = S.sunAngularSize\n\tsky.MoonAngularSize = S.moonAngularSize\n\tsky.StarCount = S.starCount\n\tsky.CelestialBodiesShown = true\n\n\tlocal G = Graphics.grade\n\tlocal grade = child(lighting, \"ColorCorrectionEffect\", \"Grade\") :: ColorCorrectionEffect\n\tgrade.Contrast = G.contrast\n\tgrade.Saturation = G.saturation\n\tgrade.Brightness = G.brightness\n\tgrade.TintColor = rgb(G.tint)\n\n\tlocal B = Graphics.bloom\n\tlocal bloom = child(lighting, \"BloomEffect\", \"Bloom\") :: BloomEffect\n\tbloom.Intensity = B.intensity\n\tbloom.Size = B.size\n\tbloom.Threshold = B.threshold\n\tbloom:SetAttribute(\"FullOnly\", true)\n\n\tlocal R = Graphics.sunRays\n\tlocal rays = child(lighting, \"SunRaysEffect\", \"SunRays\") :: SunRaysEffect\n\trays.Intensity = R.intensity\n\trays.Spread = R.spread\n\trays:SetAttribute(\"FullOnly\", true)\n\n\tlocal stale = lighting:FindFirstChild(\"MacroDOF\")\n\tif opts.depthOfField then\n\t\tlocal D = Graphics.depthOfField\n\t\tlocal dof = child(lighting, \"DepthOfFieldEffect\", \"MacroDOF\") :: DepthOfFieldEffect\n\t\tdof.FarIntensity = D.far\n\t\tdof.NearIntensity = D.near\n\t\tdof.FocusDistance = D.focus\n\t\tdof.InFocusRadius = D.radius\n\t\tdof:SetAttribute(\"FullOnly\", true) -- phones and tablets go without it (Client/WorldDetail)\n\telseif stale then\n\t\tstale:Destroy()\n\tend\n\n\tif terrain then\n\t\tlocal C = Graphics.clouds\n\t\tlocal clouds = child(terrain, \"Clouds\", \"Clouds\") :: Clouds\n\t\tclouds.Cover = C.cover\n\t\tclouds.Density = C.density\n\t\tclouds.Color = rgb(C.color)\n\t\tclouds:SetAttribute(\"FullOnly\", true)\n\tend\n\treturn sun\nend\n\nreturn Lit\n",4810,22767615},{"Shared/Habitat/Materials","--!strict\n-- Material names (as Data/Graphics spells them) to Roblox's Enum.Material, so the data stays plain text and a typo is caught by\n-- tests/world.luau instead of showing up as a grey part in Studio. These are Roblox's built-in materials; with\n-- MaterialService.Use2022Materials on (both Rojo projects set it) they carry their own PBR textures.\nlocal Materials = {}\n\nlocal MAP: { [string]: Enum.Material } = {\n\tPlastic = Enum.Material.Plastic, SmoothPlastic = Enum.Material.SmoothPlastic, Neon = Enum.Material.Neon,\n\tWood = Enum.Material.Wood, WoodPlanks = Enum.Material.WoodPlanks, Plaster = Enum.Material.Plaster,\n\tConcrete = Enum.Material.Concrete, Brick = Enum.Material.Brick, Glass = Enum.Material.Glass,\n\tGround = Enum.Material.Ground, Grass = Enum.Material.Grass, LeafyGrass = Enum.Material.LeafyGrass,\n\tFabric = Enum.Material.Fabric, Cardboard = Enum.Material.Cardboard, Sand = Enum.Material.Sand,\n\tSlate = Enum.Material.Slate, Pebble = Enum.Material.Pebble, Rock = Enum.Material.Rock, Mud = Enum.Material.Mud,\n\tLimestone = Enum.Material.Limestone, Marble = Enum.Material.Marble, Metal = Enum.Material.Metal,\n}\n\nfunction Materials.known(name: string): boolean\n\treturn MAP[name] ~= nil\nend\n\nfunction Materials.get(name: string): Enum.Material\n\treturn MAP[name] or Enum.Material.SmoothPlastic\nend\n\nfunction Materials.names(): { string }\n\tlocal out = {}\n\tfor name in MAP do table.insert(out, name) end\n\ttable.sort(out)\n\treturn out\nend\n\nreturn Materials\n",1466,1979185269},{"Shared/Habitat/Patina","--!strict\n-- Builds what age and use have done to the sill, the glass and the retreat, from Data/Wear: a worn strip along the front lip, grime\n-- in the corners, dust bunnies, condensation and smudges on the glass, the silk retreat in the crevice, and a copper coin and some\n-- fallen Pilea leaves on the floor. All flat, tiny or thin and drawn only (Habitat/Shapes: nothing collides with it and no ray\n-- sees it); each builder returns a folder, and the optional ones are marked FullOnly for Client/WorldDetail.\nlocal Graphics = require(script.Parent.Parent.Data.Graphics)\nlocal Wear = require(script.Parent.Parent.Data.Wear)\nlocal Shapes = require(script.Parent.Shapes)\n\nlocal Patina = {}\n\nlocal hex, folder, between = Shapes.hex, Shapes.folder, Shapes.between\nlocal TAU = 2 * math.pi\n\n-- ---------------------------------------------------------------- the sill (full tier)\n-- Bare wood along the lip's top front edge, grime where the floor meets the walls, dust bunnies in the corners.\nfunction Patina.sill(parent: Instance): Folder\n\tlocal wear = folder(parent, \"Wear\", true)\n\tlocal L = Wear.lip\n\tlocal rand = Shapes.rng(L.seed)\n\tlocal x, n = L.x0, 0\n\twhile x < L.x1 do\n\t\tlocal length = math.min(between(rand, L.runs[1], L.runs[2]), L.x1 - x)\n\t\tlocal z0 = L.z0 + between(rand, 0, 0.04)\n\t\tn += 1\n\t\tShapes.block(wear, \"LipWear\" .. n, Vector3.new(length, L.height, L.z1 - z0), CFrame.new(x + length / 2, L.y + L.height / 2, (z0 + L.z1) / 2),\n\t\t\thex(L.colors[1 + math.floor(rand() * #L.colors)]), Wear.bare.material)\n\t\tx += length + between(rand, L.gaps[1], L.gaps[2])\n\tend\n\tlocal G = Wear.grime\n\tlocal grime = folder(wear, \"Grime\")\n\tlocal y = G.height / 2 + 0.001\n\tfor i, line in G.lines do\n\t\tlocal p = Shapes.strip(grime, \"Grime\" .. i, Vector3.new(line[1], y, line[2]), Vector3.new(line[3], y, line[4]), line[5], G.height, hex(G.color), \"SmoothPlastic\")\n\t\tp.Transparency = G.transparency\n\tend\n\tlocal B = Wear.bunnies\n\tfor i, bunny in B.items do\n\t\tlocal cluster = folder(wear, \"DustBunny\" .. i)\n\t\tlocal brand = Shapes.rng(bunny.seed)\n\t\tfor j = 1, bunny.count do\n\t\t\tlocal a, d = brand() * TAU, bunny.spread * math.sqrt(brand())\n\t\t\tlocal r = between(brand, B.radius[1], B.radius[2])\n\t\t\tlocal fluff = Shapes.ellipsoid(cluster, `Fluff{j}`, Vector3.new(2 * r, 2 * r * B.lift, 2 * r),\n\t\t\t\tCFrame.new(bunny.x + math.cos(a) * d, r * B.lift, bunny.z + math.sin(a) * d) * CFrame.Angles(0, brand() * TAU, 0), hex(B.color), \"Fabric\")\n\t\t\tfluff.Transparency = B.transparency + brand() * 0.12\n\t\tend\n\tend\n\treturn wear\nend\n\n-- ---------------------------------------------------------------- the glass (full tier)\n-- Condensation on the lower panes (tiny flattened Glass spheres) and two faint smudges, on the room side of the glass.\nfunction Patina.glass(parent: Instance): (Folder, Folder)\n\tlocal W = Graphics.window\n\tlocal face = Shapes.piece(W.hidden[1]).hi.Z - W.glass.setback -- the glass's room-side face\n\tlocal D = Wear.drops\n\tlocal drops = folder(parent, \"Condensation\", true)\n\tlocal rand = Shapes.rng(D.seed)\n\t-- ROBLOX-95: the middle lower sash is raised (Graphics.window.opening); a drop that would sit over the gap sits on the raised sash's pane instead, as high\n\t-- above its bottom rail as it would have been above the sill (the same draws, so every other drop is where it was).\n\tlocal O = W.opening\n\tlocal lift = O.top + W.sashRail + 0.25 - D.y[1]\n\tfor i = 1, D.count do\n\t\tlocal pane = D.panes[1 + math.floor(rand() * #D.panes)]\n\t\tlocal d = D.size[1] + (D.size[2] - D.size[1]) * rand() ^ 2.2\n\t\tlocal run = 1.15 + (d - D.size[1]) / (D.size[2] - D.size[1]) * 0.9 -- bigger drops are longer: they have started to run\n\t\tlocal x = between(rand, pane[1], pane[2])\n\t\tlocal y = D.y[1] + (D.y[2] - D.y[1]) * rand() ^ 1.8\n\t\tif x > O.left - W.jambWidth - d and x < O.right + W.jambWidth + d then y += lift end\n\t\tlocal drop = Shapes.ellipsoid(drops, \"Drop\" .. i, Vector3.new(d, math.min(d * run, D.size[2]), 2 * D.flat),\n\t\t\tCFrame.new(x, y, face + D.flat), hex(D.color), \"Glass\")\n\t\tdrop.Transparency = D.transparency\n\t\tdrop.Reflectance = D.reflectance\n\tend\n\tlocal S = Wear.smudges\n\tlocal smudges = folder(parent, \"Smudges\", true)\n\tfor i, m in S.items do\n\t\tlocal smudge = Shapes.ellipsoid(smudges, \"Smudge\" .. i, Vector3.new(m.w, m.h, 0.01),\n\t\t\tCFrame.new(m.x, m.y, face + 0.006) * CFrame.Angles(0, 0, math.rad(m.turn)), hex(S.color), \"SmoothPlastic\")\n\t\tsmudge.Transparency = S.transparency\n\tend\n\treturn drops, smudges\nend\n\n-- ---------------------------------------------------------------- the silk retreat in the crevice\n-- A few overlapping, translucent shells at the back and threads across the opening: salticids rest in silk retreats.\nfunction Patina.retreat(parent: Instance): Folder\n\tlocal S = Wear.silk\n\tlocal retreat = folder(parent, \"Retreat\")\n\tlocal silk = hex(S.color)\n\tfor i, shell in S.shells do\n\t\tlocal piece = Shapes.ellipsoid(retreat, \"Shell\" .. i, Vector3.new(2 * shell[4], 2 * shell[5], 2 * shell[6]), CFrame.new(shell[1], shell[2], shell[3]), silk, \"SmoothPlastic\")\n\t\tpiece.Transparency = S.shellTransparency\n\tend\n\tfor i, thread in S.threads do\n\t\tlocal strand = Shapes.strip(retreat, \"Thread\" .. i, Vector3.new(thread[1], thread[2], thread[3]), Vector3.new(thread[4], thread[5], thread[6]), S.thread, S.thread, silk, \"SmoothPlastic\")\n\t\tstrand.Transparency = S.threadTransparency\n\tend\n\treturn retreat\nend\n\n-- ---------------------------------------------------------------- small things on the floor (full tier)\n-- A copper coin lying flat, plain faces, and a few fallen brown Pilea leaves, each with a stub of stalk.\nfunction Patina.floor(parent: Instance)\n\tlocal C = Wear.coin\n\tShapes.disc(parent, \"Coin\", C.diameter, C.thickness, Vector3.new(C.x, C.thickness / 2, C.z), hex(C.color), C.material).CastShadow = true\n\tlocal F = Wear.fallen\n\tfor i, leaf in F.items do\n\t\tShapes.disc(parent, \"FallenLeaf\" .. i, leaf.diameter, F.thickness, Vector3.new(leaf.x, F.thickness / 2, leaf.z), hex(leaf.color), F.material)\n\t\tlocal a = i * 2.1\n\t\tlocal from = Vector3.new(leaf.x + math.cos(a) * leaf.diameter * 0.45, F.thickness / 2, leaf.z + math.sin(a) * leaf.diameter * 0.45)\n\t\tlocal to = from + Vector3.new(math.cos(a), 0, math.sin(a)) * 0.55\n\t\tShapes.strip(parent, `FallenStalk{i}`, from, to, 0.08, F.thickness, hex(\"7d5c30\"), F.material)\n\tend\nend\n\nreturn Patina\n",6262,2323954079},{"Shared/Habitat/Plants","--!strict\n-- Builds the plants of the drawn world from Data/Flora: the Pilea that replaces the leaf and stem pieces of the sill, the trough's\n-- planting (water stain, soil, pebbles, moss, seedlings) and the garden outside the window (a window box, black-eyed Susans with\n-- their ultraviolet layer, flowering shrubs). Everything is drawn only (Habitat/Shapes: anchored, non-colliding, unqueryable,\n-- untouchable); optional detail is marked FullOnly, which Client/WorldDetail removes on phones and tablets. A drawn leaf's top is\n-- its piece's top and a drawn stem stands inside its piece's box, so what the spider walks on is what the player sees.\nlocal Flora = require(script.Parent.Parent.Data.Flora)\nlocal Graphics = require(script.Parent.Parent.Data.Graphics)\nlocal Layout = require(script.Parent.WindowsillLayout)\nlocal Shapes = require(script.Parent.Shapes)\n\nlocal Plants = {}\n\nlocal hex, folder, between = Shapes.hex, Shapes.folder, Shapes.between\nlocal TAU = 2 * math.pi\n\nlocal piece = Shapes.piece\n\nlocal function pick<T>(list: { T }, rand: () -> number): T\n\treturn list[1 + math.floor(rand() * #list)]\nend\n\n-- ---------------------------------------------------------------- the Pilea\nlocal P = Flora.pilea\n\n-- The ids of the sill pieces the Pilea draws instead: Scenery hides exactly these, and only once they are drawn.\nfunction Plants.pieceIds(): { string }\n\tlocal ids = { P.tip }\n\tfor _, plant in P.plants do\n\t\ttable.insert(ids, plant.leaf)\n\t\ttable.insert(ids, plant.stem)\n\tend\n\treturn ids\nend\n\nlocal function insideRounded(x: number, z: number, x0: number, x1: number, z0: number, z1: number, r: number): boolean\n\tlocal dx = math.max(math.abs(x - (x0 + x1) / 2) - ((x1 - x0) / 2 - r), 0)\n\tlocal dz = math.max(math.abs(z - (z0 + z1) / 2) - ((z1 - z0) / 2 - r), 0)\n\treturn dx * dx + dz * dz <= r * r\nend\n\n-- How far one can go from (sx, sz) along the angle `a` and stay inside the rounded rectangle shrunk by `margin`.\nlocal function reach(sx: number, sz: number, a: number, lo: Vector3, hi: Vector3, r: number, margin: number): number\n\tlocal near, far = 0, math.max(hi.X - lo.X, hi.Z - lo.Z) * 2\n\tlocal c, s = math.cos(a), math.sin(a)\n\tfor _ = 1, 24 do\n\t\tlocal mid = (near + far) / 2\n\t\tif insideRounded(sx + c * mid, sz + s * mid, lo.X + margin, hi.X - margin, lo.Z + margin, hi.Z - margin, math.max(r - margin, 0.05)) then\n\t\t\tnear = mid\n\t\telse\n\t\t\tfar = mid\n\t\tend\n\tend\n\treturn near\nend\n\n-- Dark cracks radiating from a stem's foot and a pinch of crumbled soil: the pups rooted in a crack of the old sill.\nlocal function base(parent: Instance, cx: number, cz: number, rand: () -> number)\n\tlocal C, K = P.cracks, P.crumbs\n\tlocal color = hex(C.color)\n\tfor i = 1, C.count do\n\t\tlocal a = TAU * (i - 1 + rand() * 0.6) / C.count\n\t\tlocal length = between(rand, C.length[1], C.length[2])\n\t\tlocal turn = a + (rand() - 0.5) * 0.9\n\t\tlocal y = C.height / 2 + 0.001\n\t\tlocal p0 = Vector3.new(cx + math.cos(a) * 0.45, y, cz + math.sin(a) * 0.45)\n\t\tlocal p1 = Vector3.new(cx + math.cos(a) * length * 0.6, y, cz + math.sin(a) * length * 0.6)\n\t\tlocal p2 = Vector3.new(p1.X + math.cos(turn) * length * 0.4, y, p1.Z + math.sin(turn) * length * 0.4)\n\t\tfor j, seg in { { p0, p1 }, { p1, p2 } } do\n\t\t\tShapes.strip(parent, `Crack{i}_{j}`, seg[1], seg[2], C.width, C.height, color, \"SmoothPlastic\").Transparency = C.transparency\n\t\tend\n\tend\n\tfor i = 1, K.count do\n\t\tlocal a, d = rand() * TAU, 0.5 + rand() * K.spread\n\t\tlocal size = between(rand, K.size[1], K.size[2])\n\t\tShapes.ellipsoid(parent, \"Crumb\" .. i, Vector3.new(size, size * 0.55, size * 0.8),\n\t\t\tCFrame.new(cx + math.cos(a) * d, size * 0.2, cz + math.sin(a) * d) * CFrame.Angles(0, rand() * TAU, 0), hex(pick(K.colors, rand)), \"Plaster\")\n\tend\nend\n\n-- One pancake leaf over its hidden piece, and the petiole over its stem piece.\nlocal function drawPlant(parent: Instance, leaf: Layout.Piece, stem: Layout.Piece, rand: () -> number)\n\tlocal lo, hi, r = leaf.lo, leaf.hi, P.radius\n\tlocal plant = folder(parent, leaf.id)\n\tfor _, part in Shapes.roundedSlab(plant, \"Blade\", lo, hi, r, hex(P.top), P.material) do part.CastShadow = true end\n\t-- the petiole: a round rod inscribed in the stem's box, joining the blade from below, at the stem's x and z\n\tlocal cx, cz = (stem.lo.X + stem.hi.X) / 2, (stem.lo.Z + stem.hi.Z) / 2\n\tlocal rod = Shapes.rod(plant, \"Petiole\", Vector3.new(cx, stem.lo.Y, cz), Vector3.new(cx, stem.hi.Y, cz),\n\t\tmath.min(stem.hi.X - stem.lo.X, stem.hi.Z - stem.lo.Z), hex(P.petiole), P.material)\n\trod.CastShadow = true\n\tlocal detail = folder(plant, \"Detail\", true)\n\tShapes.roundedSlab(detail, \"Under\", Vector3.new(lo.X - P.underOut, lo.Y - P.underBelow, lo.Z - P.underOut),\n\t\tVector3.new(hi.X + P.underOut, lo.Y + P.underThick, hi.Z + P.underOut), r + P.underOut, hex(P.under), P.material)\n\tShapes.roundedSlab(detail, \"Rim\", Vector3.new(lo.X - P.rimOut, lo.Y + P.rimFoot, lo.Z - P.rimOut),\n\t\tVector3.new(hi.X + P.rimOut, hi.Y - P.rimDrop, hi.Z + P.rimOut), r + P.rimOut, hex(P.rim), P.material)\n\t-- peltate: a pale dot where the stalk joins, and the veins fan out from it\n\tShapes.disc(detail, \"Dot\", P.dotDiameter, P.dotHeight, Vector3.new(cx, hi.Y + P.dotHeight / 2, cz), hex(P.dot), P.material)\n\tlocal V = P.veins\n\tlocal y = hi.Y + V.height / 2\n\tfor i = 1, V.count do\n\t\tlocal a = TAU * (i - 1 + (rand() * 2 - 1) * V.jitter) / V.count\n\t\tlocal far = reach(cx, cz, a, lo, hi, r, V.margin) * V.reach\n\t\tif far > V.start + 0.3 then\n\t\t\tlocal c, s = math.cos(a), math.sin(a)\n\t\t\tShapes.strip(detail, \"Vein\" .. i, Vector3.new(cx + c * V.start, y, cz + s * V.start), Vector3.new(cx + c * far, y, cz + s * far),\n\t\t\t\tV.width, V.height, hex(P.vein), P.material)\n\t\tend\n\tend\n\tShapes.disc(detail, \"Foot\", P.foot.diameter, P.foot.height, Vector3.new(cx, stem.lo.Y + P.foot.height / 2, cz), hex(P.foot.color), P.material)\n\tbase(folder(plant, \"Base\", true), cx, cz, rand)\nend\n\n-- The dry leaf: a curled tan fragment with darker edges.\nlocal function drawTip(parent: Instance, leaf: Layout.Piece)\n\tlocal D = P.dry\n\tlocal lo, hi = leaf.lo, leaf.hi\n\tlocal tip = folder(parent, leaf.id)\n\tfor _, part in Shapes.roundedSlab(tip, \"Blade\", lo, hi, D.radius, hex(D.color), \"Plaster\") do part.CastShadow = true end\n\tlocal detail = folder(tip, \"Detail\", true)\n\tlocal edge, w, h = hex(D.edge), D.edgeWidth, D.edgeHeight\n\tlocal y = hi.Y + h / 2\n\tlocal x0, x1, z0, z1 = lo.X + D.edgeInset + w / 2, hi.X - D.edgeInset - w / 2, lo.Z + D.edgeInset + w / 2, hi.Z - D.edgeInset - w / 2\n\tlocal r = D.radius\n\tShapes.strip(detail, \"EdgeN\", Vector3.new(x0 + r, y, z0), Vector3.new(x1 - r, y, z0), w, h, edge, \"Plaster\")\n\tShapes.strip(detail, \"EdgeS\", Vector3.new(x0 + r, y, z1), Vector3.new(x1 - r, y, z1), w, h, edge, \"Plaster\")\n\tShapes.strip(detail, \"EdgeW\", Vector3.new(x0, y, z0 + r), Vector3.new(x0, y, z1 - r), w, h, edge, \"Plaster\")\n\tShapes.strip(detail, \"EdgeE\", Vector3.new(x1, y, z0 + r), Vector3.new(x1, y, z1 - r), w, h, edge, \"Plaster\")\n\tfor i, c in D.curls do\n\t\tShapes.block(detail, \"Curl\" .. i, Vector3.new(D.curlSize[1], D.curlSize[2], D.curlSize[3]),\n\t\t\tCFrame.new(c.x, hi.Y + 0.07, c.z) * CFrame.Angles(0, math.rad(c.turn), 0) * CFrame.Angles(math.rad(c.tip), 0, 0), hex(D.curl), \"Plaster\")\n\tend\nend\n\n-- Draws the Pilea: leaves, petioles and the dry leaf, into a folder \"Pilea\" under `parent`.\nfunction Plants.pilea(parent: Instance): Folder\n\tlocal pilea = folder(parent, \"Pilea\")\n\tlocal rand = Shapes.rng(P.seed)\n\tfor _, plant in P.plants do\n\t\tdrawPlant(pilea, piece(plant.leaf), piece(plant.stem), rand)\n\tend\n\tdrawTip(pilea, piece(P.tip))\n\treturn pilea\nend\n\n-- ---------------------------------------------------------------- the trough's planting\nlocal T = Flora.planter\n\ntype Face = { name: string, along: string, fixed: number, outward: number, from: number, to: number }\n\n-- A flat sheet on the trough's face: from, to as fractions along the face, y0 to y1 up it; `layer` stacks sheets without z-fighting.\nlocal function sheet(parent: Instance, face: Face, from: number, to: number, y0: number, y1: number, layer: number, color: Color3, transparency: number)\n\tlocal th = T.stain.thickness\n\tlocal a, b = face.from + (face.to - face.from) * from, face.from + (face.to - face.from) * to\n\tlocal off = face.fixed + face.outward * (0.002 + layer * 0.003 + th / 2)\n\tlocal size = if face.along == \"x\" then Vector3.new(b - a, y1 - y0, th) else Vector3.new(th, y1 - y0, b - a)\n\tlocal at = if face.along == \"x\" then Vector3.new((a + b) / 2, (y0 + y1) / 2, off) else Vector3.new(off, (y0 + y1) / 2, (a + b) / 2)\n\tShapes.block(parent, \"Sheet\", size, CFrame.new(at), color, \"SmoothPlastic\").Transparency = transparency\nend\n\n-- A flattened ellipsoid lying on the soil with a random turn: used for pebbles, moss and the damp patches.\nlocal function lump(parent: Instance, name: string, at: Vector3, size: Vector3, color: Color3, material: string, rand: () -> number, tilt: number)\n\tlocal frame = CFrame.new(at) * CFrame.Angles(0, rand() * TAU, 0) * CFrame.Angles((rand() - 0.5) * tilt, 0, (rand() - 0.5) * tilt)\n\treturn Shapes.ellipsoid(parent, name, size, frame, color, material)\nend\n\nfunction Plants.planter(parent: Instance): Folder\n\tlocal trough = piece(\"planter\")\n\tlocal planter = folder(parent, \"Planter\")\n\tlocal stain = folder(planter, \"Stain\", true)\n\tlocal S = T.stain\n\tlocal rand = Shapes.rng(T.pebbles.seed)\n\tlocal faces: { Face } = {\n\t\t{ name = \"Front\", along = \"x\", fixed = trough.hi.Z, outward = 1, from = trough.lo.X, to = trough.hi.X },\n\t\t{ name = \"Back\", along = \"x\", fixed = trough.lo.Z, outward = -1, from = trough.lo.X, to = trough.hi.X },\n\t\t{ name = \"West\", along = \"z\", fixed = trough.lo.X, outward = -1, from = trough.lo.Z, to = trough.hi.Z },\n\t\t{ name = \"East\", along = \"z\", fixed = trough.hi.X, outward = 1, from = trough.lo.Z, to = trough.hi.Z },\n\t}\n\tfor _, face in faces do\n\t\tlocal group = folder(stain, face.name)\n\t\tlocal scale = between(rand, 0.85, 1.15)\n\t\tsheet(group, face, 0, 1, 0, S.height, 0, hex(S.color), S.transparency)\n\t\tfor _, tide in S.tide do\n\t\t\tsheet(group, face, tide[1], tide[2], 0, tide[3] * scale, 1, hex(S.tideColor), S.tideTransparency)\n\t\tend\n\t\tfor _, salt in S.salt do\n\t\t\tlocal middle = (salt[1] + salt[2]) / 2\n\t\t\tlocal top = S.height\n\t\t\tfor _, tide in S.tide do\n\t\t\t\tif middle >= tide[1] and middle <= tide[2] then top = tide[3] * scale end\n\t\t\tend\n\t\t\tsheet(group, face, salt[1], salt[2], top + S.saltGap, top + S.saltGap + S.saltHeight, 2, hex(S.saltColor), S.saltTransparency)\n\t\tend\n\tend\n\n\tlocal area = T.area\n\tlocal mottle = folder(planter, \"Damp\", true)\n\tfor i, m in T.mottle do\n\t\tlocal patch = Shapes.ellipsoid(mottle, \"Damp\" .. i, Vector3.new(m.w, 0.006, m.d), CFrame.new(m.x, area.y, m.z), hex(m.color), \"Plaster\")\n\t\tpatch.Transparency = 0.3\n\tend\n\n\tlocal B = T.pebbles\n\tlocal pebbles = folder(planter, \"Pebbles\", true)\n\tlocal placed: { Vector3 } = {}\n\tfor i = 1, B.count do\n\t\tlocal at = Vector3.zero\n\t\tfor _ = 1, 12 do\n\t\t\tat = Vector3.new(between(rand, area.x0, area.x1), 0, between(rand, area.z0, area.z1))\n\t\t\tlocal clear = true\n\t\t\tfor _, other in placed do\n\t\t\t\tif (other - at).Magnitude < 0.8 then clear = false end\n\t\t\tend\n\t\t\tif clear then break end\n\t\tend\n\t\ttable.insert(placed, at)\n\t\tlocal length = between(rand, B.length[1], B.length[2])\n\t\tlocal height = length * B.flat\n\t\tlump(pebbles, \"Pebble\" .. i, Vector3.new(at.X, area.y + height * 0.3, at.Z), Vector3.new(length, height, length * between(rand, 0.6, 0.9)),\n\t\t\thex(pick(B.colors, rand)), \"Plaster\", rand, 0.25)\n\tend\n\n\tlocal M = T.moss\n\tlocal moss = folder(planter, \"Moss\", true)\n\tlocal mrand = Shapes.rng(M.seed)\n\tfor i, patch in M.patches do\n\t\tfor j = 1, patch.n do\n\t\t\tlocal a, d = mrand() * TAU, patch.r * math.sqrt(mrand())\n\t\t\tlocal size = between(mrand, M.size[1], M.size[2])\n\t\t\tlump(moss, `Moss{i}_{j}`, Vector3.new(patch.x + math.cos(a) * d, area.y + size * M.tall * 0.25, patch.z + math.sin(a) * d),\n\t\t\t\tVector3.new(size, size * M.tall, size * between(mrand, 0.7, 1.0)), hex(pick(M.colors, mrand)), \"Plaster\", mrand, 0.2)\n\t\tend\n\tend\n\n\tlocal seedlings = folder(planter, \"Seedlings\", true)\n\tlocal C = T.cotyledon\n\tfor i, s in T.seedlings do\n\t\tlocal foot = Vector3.new(s.x, area.y, s.z)\n\t\tlocal top = foot + Vector3.new(0, T.stalk, 0)\n\t\tShapes.rod(seedlings, `Seedling{i}Stalk`, foot, top, T.stalkWidth, hex(T.stalkColor), \"SmoothPlastic\")\n\t\tlocal heading = math.rad(s.turn)\n\t\tlocal dir = Vector3.new(math.cos(heading), 0, math.sin(heading))\n\t\tfor side = 1, 2 do\n\t\t\tlocal sign = if side == 1 then 1 else -1\n\t\t\tlocal lift = math.rad(T.cotyledonTip)\n\t\t\tlocal along = dir * (sign * math.cos(lift)) + Vector3.yAxis * math.sin(lift)\n\t\t\tShapes.ellipsoid(seedlings, `Seedling{i}Leaf{side}`, Vector3.new(C[1], C[2], C[3]),\n\t\t\t\tShapes.frame(top + dir * (sign * C[1] * 0.42) + Vector3.new(0, T.cotyledonRise, 0), along, Vector3.yAxis), hex(T.cotyledonColor), \"SmoothPlastic\")\n\t\tend\n\tend\n\treturn planter\nend\n\n-- ---------------------------------------------------------------- the garden outside the window\nlocal G = Flora.garden\n\n-- The ids of the outer sill's pieces the window box draws instead (World/Garden's window_box_west and window_box_east): Scenery hides exactly these, and\n-- only once the garden is drawn (ROBLOX-95).\nfunction Plants.windowBoxIds(): { string }\n\tlocal ids = {}\n\tfor _, half in G.box.boxes do table.insert(ids, half.id) end\n\treturn ids\nend\n\n-- ROBLOX-95: two halves either side of the raised sash, standing on the stone outer sill; each half is drawn as the one box was.\nlocal function windowBox(parent: Instance)\n\tlocal B = G.box\n\tlocal box = folder(parent, \"WindowBox\")\n\tlocal d = B.z1 - B.z0\n\tlocal cz = (B.z0 + B.z1) / 2\n\tlocal rimBottom = B.soilTop - 0.1\n\tlocal rim = hex(B.rim)\n\tlocal rimHeight = B.top - rimBottom\n\tlocal ry = (B.top + rimBottom) / 2\n\tfor _, span in B.boxes do\n\t\tlocal half = folder(box, if span.x1 <= 0 then \"West\" else \"East\")\n\t\tlocal w, cx = span.x1 - span.x0, (span.x0 + span.x1) / 2\n\t\tShapes.block(half, \"Body\", Vector3.new(w, rimBottom - B.bottom, d), CFrame.new(cx, (rimBottom + B.bottom) / 2, cz), hex(B.color), \"Wood\")\n\t\tShapes.block(half, \"Soil\", Vector3.new(w - 2 * B.rimWidth, 0.4, d - 2 * B.rimWidth), CFrame.new(cx, B.soilTop - 0.2, cz), hex(B.soil), \"Ground\")\n\t\tShapes.block(half, \"RimFar\", Vector3.new(w, rimHeight, B.rimWidth), CFrame.new(cx, ry, B.z0 + B.rimWidth / 2), rim, \"Wood\")\n\t\tShapes.block(half, \"RimNear\", Vector3.new(w, rimHeight, B.rimWidth), CFrame.new(cx, ry, B.z1 - B.rimWidth / 2), rim, \"Wood\")\n\t\tShapes.block(half, \"RimWest\", Vector3.new(B.rimWidth, rimHeight, d - 2 * B.rimWidth), CFrame.new(span.x0 + B.rimWidth / 2, ry, cz), rim, \"Wood\")\n\t\tShapes.block(half, \"RimEast\", Vector3.new(B.rimWidth, rimHeight, d - 2 * B.rimWidth), CFrame.new(span.x1 - B.rimWidth / 2, ry, cz), rim, \"Wood\")\n\t\tfor i, peel in B.peel do\n\t\t\tif peel[1] > span.x0 and peel[1] < span.x1 then\n\t\t\t\tShapes.block(half, \"Peel\" .. i, Vector3.new(peel[3], 0.01, peel[4]), CFrame.new(peel[1], B.top + 0.006, peel[2]), hex(B.paint), \"SmoothPlastic\")\n\t\t\tend\n\t\tend\n\tend\nend\n\ntype FlowerSpec = { x: number, z: number, y: number, nod: number, turn: number, size: number }\n\n-- One black-eyed Susan: golden petals round a dark dome, a bent stem and two leaves; its head nods and turns toward the room. The\n-- ultraviolet pattern is a layer of Neon parts, invisible until the eye-view helper fades them in: the outer half of each petal\n-- reflects ultraviolet, the base and the centre absorb it.\nlocal function rudbeckia(parent: Instance, uv: Instance, index: number, spec: FlowerSpec, rand: () -> number)\n\tlocal F = G.rudbeckia\n\tlocal s = spec.size\n\tlocal flower = folder(parent, \"Flower\" .. index)\n\tlocal nod, turn = math.rad(spec.nod), math.rad(spec.turn)\n\tlocal facing = Vector3.new(math.sin(turn) * math.cos(nod), math.sin(nod), math.cos(turn) * math.cos(nod)).Unit\n\tlocal right = Vector3.yAxis:Cross(facing).Unit\n\tlocal up = facing:Cross(right)\n\tlocal head = Vector3.new(spec.x, spec.y, spec.z)\n\tlocal centre = F.centre * s\n\t-- the stem and the head's golden disc and dark dome (both tiers)\n\tlocal soil = Vector3.new(spec.x, G.box.soilTop, spec.z)\n\tlocal back = head - facing * 0.3\n\tlocal side = if rand() < 0.5 then right else -right\n\tlocal bend = back:Lerp(soil, 0.55) + side * (F.stemBend * s)\n\tShapes.rod(flower, \"StemLow\", soil, bend, F.stemWidth * s, hex(F.stem), \"SmoothPlastic\")\n\tShapes.rod(flower, \"StemHigh\", bend, back, F.stemWidth * s * 0.85, hex(F.stem), \"SmoothPlastic\")\n\tlocal discR = centre + F.discOut * s\n\tShapes.ellipsoid(flower, \"Disc\", Vector3.new(2 * discR, 0.1, 2 * discR), CFrame.fromMatrix(head - facing * 0.04, right, facing), hex(F.disc), \"SmoothPlastic\")\n\tShapes.ellipsoid(flower, \"Dome\", Vector3.new(2 * centre, 2 * F.centreHeight * s, 2 * centre), CFrame.fromMatrix(head, right, facing), hex(F.centreColor), \"Plaster\")\n\t-- the petals (full tier) and their ultraviolet halves\n\tlocal petals = folder(flower, \"Petals\", true)\n\tlocal count = math.floor(between(rand, F.petals[1], F.petals[2] + 0.999))\n\tfor i = 1, count do\n\t\tlocal angle = TAU * (i - 1 + (rand() - 0.5) * 0.35) / count\n\t\tlocal dir = right * math.cos(angle) + up * math.sin(angle)\n\t\tlocal droop = math.rad(F.droop) * between(rand, 0.7, 1.3)\n\t\tlocal long = dir * math.cos(droop) - facing * math.sin(droop)\n\t\tlocal thin = facing * math.cos(droop) + dir * math.sin(droop)\n\t\tlocal length = F.petalLength * s * between(rand, 0.92, 1.08)\n\t\tlocal width, thick = F.petalWidth * s, F.petalThick\n\t\tlocal base = centre * 0.9\n\t\tShapes.ellipsoid(petals, \"Petal\" .. i, Vector3.new(length, thick, width), CFrame.fromMatrix(head + long * (base + length / 2), long, thin),\n\t\t\thex(F.petalColors[1 + (i - 1) % #F.petalColors]), \"SmoothPlastic\")\n\t\tlocal U = F.uv\n\t\tlocal patch = Shapes.ellipsoid(uv, `Flower{index}Petal{i}`, Vector3.new(length * 0.5 * 0.95, U.thick, width * 0.85),\n\t\t\tCFrame.fromMatrix(head + long * (base + length * 0.75) + thin * (thick / 2 + U.rise), long, thin), hex(U.color), \"Neon\")\n\t\tpatch.Transparency = 1\n\t\tpatch:SetAttribute(\"UVOpacity\", U.opacity)\n\t\tpatch:SetAttribute(\"FullOnly\", true)\n\tend\n\t-- two leaves low on the stem (full tier)\n\tlocal leaves = folder(flower, \"Leaves\", true)\n\tfor i = 1, 2 do\n\t\tlocal from = soil:Lerp(bend, 0.22 + 0.25 * i)\n\t\tlocal yaw = rand() * TAU\n\t\tlocal out = Vector3.new(math.cos(yaw), 0.5, math.sin(yaw)).Unit\n\t\tlocal size = Vector3.new(F.leafSize[1] * s, F.leafSize[2], F.leafSize[3] * s)\n\t\tShapes.ellipsoid(leaves, \"Leaf\" .. i, size, Shapes.frame(from + out * (size.X / 2), out, Vector3.yAxis), hex(F.leaf), \"SmoothPlastic\")\n\tend\nend\n\n-- A flowering bush to the ground (ROBLOX-103: the shrubs were standards on stems): a rounded core of leaves whose underside is a little above the lawn, lumps of\n-- leaves over its top and sides (the lowest touching the lawn), a woody frame of stems from the lawn up into the crown, and blossoms on the side facing the\n-- house. Each where Flora.garden.shrubs puts it, in the garden's own studs; the low tier keeps the core, a few lumps, two stems and two blossoms. `place` (the\n-- view's projection, Scenery.viewPosition) is no longer needed: the bushes are where they are.\nlocal function shrubs(parent: Instance, _place: (number, number, number) -> (Vector3, number))\n\tlocal S = G.shrub\n\tlocal rand = Shapes.rng(S.seed)\n\tlocal group = folder(parent, \"Shrubs\")\n\tlocal function ball(name: string, at: Vector3, diameter: number, color: Color3, material: string, optional: boolean)\n\t\tlocal p = Shapes.block(group, name, Vector3.one * diameter, CFrame.new(at), color, material)\n\t\tp.Shape = Enum.PartType.Ball\n\t\tif optional then Shapes.fullOnly(p) end\n\tend\n\tlocal ground = Graphics.view.ground.y\n\tfor i, spec in G.shrubs do\n\t\tlocal h, w = spec.h, spec.w\n\t\tlocal base = Vector3.new(spec.x, ground, spec.z)\n\t\t-- the core: a rounded mass of leaves from just above the lawn to the top\n\t\tlocal bottom = ground + h * S.skirt\n\t\tlocal core = Shapes.ellipsoid(group, `Shrub{i}`, Vector3.new(w * 0.94, (h - h * S.skirt) * 0.98, w * 0.88), CFrame.new(spec.x, (bottom + ground + h) / 2, spec.z)\n\t\t\t* CFrame.Angles(0, rand() * TAU, 0), hex(pick(S.foliage, rand)), S.material)\n\t\tcore.CastShadow = false\n\t\t-- the frame: stems from the lawn splaying up into the crown (the low tier keeps the first two)\n\t\tlocal F = S.frame\n\t\tfor k = 1, F.stems do\n\t\t\tlocal a = (k - 1) / F.stems * TAU + rand() * 0.8\n\t\t\tlocal foot = base + Vector3.new(math.cos(a) * w * 0.06, 0, math.sin(a) * w * 0.06)\n\t\t\tlocal top = Vector3.new(spec.x + math.cos(a) * w * F.reach * 0.5, ground + h * between(rand, 0.35, 0.5), spec.z + math.sin(a) * w * F.reach * 0.5)\n\t\t\tlocal stem = Shapes.rod(group, `Shrub{i}Stem{k}`, foot, top, w * F.width * (if k == 1 then 1.2 else 0.85), hex(F.color), F.material)\n\t\t\tstem.CastShadow = false\n\t\t\tif k > F.keepStems then Shapes.fullOnly(stem) end\n\t\tend\n\t\t-- the crown's lumps: the first `keep` on top (sunlit), the rest round the sides down to the lawn\n\t\tfor k = 1, S.clusters do\n\t\t\tlocal top = k <= S.keep\n\t\t\tlocal a = rand() * TAU\n\t\t\tlocal tilt = if top then between(rand, 0, 0.55) else between(rand, 0.9, 1.75) -- from straight up\n\t\t\tlocal dir = Vector3.new(math.cos(a) * math.sin(tilt), math.cos(tilt), math.sin(a) * math.sin(tilt))\n\t\t\tlocal size = w * between(rand, S.clusterSize[1], S.clusterSize[2])\n\t\t\tlocal centre = Vector3.new(spec.x, ground + h * 0.5, spec.z) + Vector3.new(dir.X * w * 0.36, dir.Y * h * 0.36, dir.Z * w * 0.33)\n\t\t\tif centre.Y - size / 2 < ground then centre = Vector3.new(centre.X, ground + size / 2 - size * 0.08, centre.Z) end -- down to the lawn, not under it\n\t\t\tball(`Shrub{i}Leaf{k}`, centre, size, hex(if top then pick(S.sunlit, rand) else pick(S.foliage, rand)), S.material, not top)\n\t\tend\n\t\t-- the blossoms, on the side facing the house (+z) and upward\n\t\tlocal colors = if spec.bloom == \"pink\" then S.pink else S.white\n\t\tfor k = 1, S.blooms do\n\t\t\tlocal a = between(rand, 0.15, math.pi - 0.15)\n\t\t\tlocal tilt = between(rand, 0.35, 1.35)\n\t\t\tlocal dir = Vector3.new(math.cos(a) * math.sin(tilt), math.cos(tilt), math.sin(a) * math.sin(tilt))\n\t\t\tlocal at = Vector3.new(spec.x, ground + h * 0.5, spec.z) + Vector3.new(dir.X * w * 0.47, dir.Y * h * 0.47, dir.Z * w * 0.44)\n\t\t\tball(`Shrub{i}Bloom{k}`, at, between(rand, S.bloomSize[1], S.bloomSize[2]) * w, hex(pick(colors, rand)), \"SmoothPlastic\", k > S.bloomKeep)\n\t\tend\n\tend\nend\n\n-- Builds the garden (window box, flowers, shrubs) into a folder \"Garden\" under `parent`; the UV pattern goes into `uv`.\nfunction Plants.garden(parent: Instance, uv: Instance, place: (number, number, number) -> (Vector3, number)): Folder\n\tlocal garden = folder(parent, \"Garden\")\n\twindowBox(garden)\n\tlocal rand = Shapes.rng(G.rudbeckia.seed)\n\tfor i, spec in G.flowers do\n\t\trudbeckia(garden, uv, i, spec, rand)\n\tend\n\tshrubs(garden, place)\n\treturn garden\nend\n\n-- ---------------------------------------------------------------- the grass\n-- One blade of grass. `foot` is where it stands, `tip` its upper end, `direction` the way it points, `size` the ellipsoid's diameters.\nexport type Blade = { tuft: number, index: number, fine: boolean, size: Vector3, frame: CFrame, foot: Vector3, tip: Vector3, direction: Vector3, color: Color3 }\n\nlocal GR = Flora.grass\n\nlocal function shaded(c: Color3, shade: number): Color3\n\treturn Color3.new(math.min(c.R * shade, 1), math.min(c.G * shade, 1), math.min(c.B * shade, 1))\nend\n\n-- A free place for a tuft in a region (Shapes.clearAt, and `apart` from every foot in `taken` on the same surface), or nil after forty tries.\nlocal function tuftSpot(rand: () -> number, region: { x0: number, x1: number, z0: number, z1: number, y: number }, taken: { Vector3 }, apart: number): Vector3?\n\tfor _ = 1, 40 do\n\t\tlocal x, z = between(rand, region.x0, region.x1), between(rand, region.z0, region.z1)\n\t\tif Shapes.clearAt(x, region.y, z, 0.35) then\n\t\t\tlocal clear = true\n\t\t\tfor _, other in taken do\n\t\t\t\tif math.abs(other.Y - region.y) < 1 and (other.X - x) ^ 2 + (other.Z - z) ^ 2 < apart * apart then\n\t\t\t\t\tclear = false\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\t\tif clear then return Vector3.new(x, region.y, z) end\n\t\tend\n\tend\n\treturn nil\nend\n\n-- Every blade of grass on the sill, tuft by tuft: Chet's 14 patches first (five blades each, built exactly as before) and then the tufts of\n-- ROBLOX-74, placed from the world's seed in Flora.grass.more.regions. Pure: the same blades every time, so the dew can stand on their tips.\nfunction Plants.grassBlades(): { Blade }\n\tlocal out: { Blade } = {}\n\tlocal feet: { Vector3 } = {}\n\tfor i, xyz in GR.patches do\n\t\tlocal origin = Vector3.new(xyz[1], xyz[2], xyz[3])\n\t\ttable.insert(feet, origin)\n\t\tfor j = 1, 5 do\n\t\t\tlocal turn = i * 2.399 + j * 1.257\n\t\t\tlocal height = 0.25 + ((i * 7 + j * 3) % 9) * 0.035\n\t\t\tlocal lean = Vector3.new(math.cos(turn) * 0.14, 0, math.sin(turn) * 0.14)\n\t\t\tlocal frame = CFrame.new(origin + Vector3.new(0, height * 0.5, 0) + lean * 0.5) * CFrame.Angles(0, turn, 0.22)\n\t\t\ttable.insert(out, {\n\t\t\t\ttuft = i, index = j, fine = j > 3, size = Vector3.new(0.065, height, 0.025), frame = frame, foot = origin,\n\t\t\t\ttip = frame:PointToWorldSpace(Vector3.new(0, height * 0.5, 0)), direction = frame.UpVector, color = hex(GR.colors[1 + (i + j) % 3]),\n\t\t\t})\n\t\tend\n\tend\n\tlocal M = GR.more\n\tlocal rand = Shapes.rng(Flora.worldSeed * 100 + M.salt)\n\tlocal tuft = #GR.patches\n\tfor _, region in M.regions do\n\t\tfor _ = 1, region.n do\n\t\t\tlocal origin = tuftSpot(rand, region, feet, M.apart)\n\t\t\tif origin then\n\t\t\t\ttuft += 1\n\t\t\t\ttable.insert(feet, origin)\n\t\t\t\tlocal growth = between(rand, 0.15, 1)\n\t\t\t\tlocal offset = rand() * TAU\n\t\t\t\tfor j = 1, M.blades do\n\t\t\t\t\tlocal height = M.height[1] + (M.height[2] - M.height[1]) * math.min(growth * between(rand, 0.5, 1), 1)\n\t\t\t\t\tlocal width = between(rand, M.width[1], M.width[2])\n\t\t\t\t\tlocal turn = offset + (j - 1) * TAU / M.blades + (rand() - 0.5) * 0.9\n\t\t\t\t\tlocal tilt = between(rand, M.tilt[1], M.tilt[2])\n\t\t\t\t\tlocal frame = CFrame.new(origin) * CFrame.Angles(0, turn, tilt) * CFrame.new(0, height * 0.5, 0)\n\t\t\t\t\tlocal shade = between(rand, M.shade[1], M.shade[2])\n\t\t\t\t\tlocal a = 1 + math.floor(rand() * #GR.colors)\n\t\t\t\t\tlocal b = 1 + math.floor(rand() * #GR.colors)\n\t\t\t\t\tlocal color = shaded(hex(GR.colors[a]):Lerp(hex(GR.colors[b]), rand()), shade)\n\t\t\t\t\tif rand() < M.dryShare then color = shaded(hex(M.dry), shade) end\n\t\t\t\t\ttable.insert(out, {\n\t\t\t\t\t\ttuft = tuft, index = j, fine = j > M.blades - M.fine, size = Vector3.new(width, height, width * 0.4), frame = frame, foot = origin,\n\t\t\t\t\t\ttip = frame:PointToWorldSpace(Vector3.new(0, height * 0.5, 0)), direction = frame.UpVector, color = color,\n\t\t\t\t\t})\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn out\nend\n\n-- Builds the grass: a folder \"GrassTufts\" with one folder per tuft; its fine blades sit in their own full-tier folders.\nfunction Plants.grass(parent: Instance): Folder\n\tlocal group = folder(parent, \"GrassTufts\")\n\tlocal tufts: { [number]: Folder } = {}\n\tfor _, blade in Plants.grassBlades() do\n\t\tlocal tuft = tufts[blade.tuft]\n\t\tif not tuft then\n\t\t\ttuft = folder(group, \"Tuft\" .. blade.tuft)\n\t\t\ttufts[blade.tuft] = tuft\n\t\tend\n\t\tlocal into: Instance = if blade.fine then folder(tuft, \"Fine\" .. blade.index, true) else tuft\n\t\tShapes.ellipsoid(into, \"GrassBlade\", blade.size, blade.frame, blade.color, \"SmoothPlastic\").CastShadow = false\n\tend\n\treturn group\nend\n\n-- A point on the top of the drawn leaf of the piece `id` (its blade is the piece's footprint with rounded corners): in the direction `angle`\n-- (radians, in plan) from the leaf's middle, `inset` in from the edge. Used by the dew.\nfunction Plants.leafEdge(id: string, angle: number, inset: number): Vector3\n\tlocal leaf = piece(id)\n\tlocal cx, cz = (leaf.lo.X + leaf.hi.X) / 2, (leaf.lo.Z + leaf.hi.Z) / 2\n\tlocal far = reach(cx, cz, angle, leaf.lo, leaf.hi, P.radius, inset)\n\treturn Vector3.new(cx + math.cos(angle) * far, leaf.hi.Y, cz + math.sin(angle) * far)\nend\n\nreturn Plants\n",27579,289264621},{"Shared/Habitat/Scenery","--!strict\n-- Builds the drawn world from Data/Graphics: the sill's physical pieces (looks only), and a \"Decor\" model (a persistent one, ROBLOX-94) with the window wall,\n-- glass and trim, the view out of the window, the dust, the small details, the light shafts, and (Habitat/Plants, Habitat/Patina,\n-- from Data/Flora and Data/Wear) the Pilea, the planting, the garden outside the window, the wear on the sill and the glass and\n-- the silk retreat, and (Habitat/Dressing, ROBLOX-74) the shaded moss, the floor's pebbles and bark, the fallen leaves and the morning dew.\n-- Gameplay never reads any of the decor: every decor part is CanQuery = false, CanCollide = false, CanTouch =\n-- false, so the spider's rays, the camera's casts and the jump planner see only the physical pieces. Parts and emitters that\n-- only the full tier keeps carry the attribute FullOnly, which Client/WorldDetail removes on phones and tablets. A piece whose\n-- look is replaced by a drawing (the back wall, the Pilea's leaves and stems) turns invisible only once that drawing exists.\nlocal Graphics = require(script.Parent.Parent.Data.Graphics)\nlocal Flora = require(script.Parent.Parent.Data.Flora)\nlocal Meshes = require(script.Parent.Parent.Data.Meshes)\nlocal Surfaces = require(script.Parent.Parent.Data.Surfaces)\nlocal Layout = require(script.Parent.WindowsillLayout)\nlocal Materials = require(script.Parent.Materials)\nlocal Dressing = require(script.Parent.Dressing)\nlocal Patina = require(script.Parent.Patina)\nlocal Plants = require(script.Parent.Plants)\nlocal Shapes = require(script.Parent.Shapes)\n\nlocal Scenery = {}\n\nlocal W = Graphics.window\nlocal M = Graphics.materials\n\nlocal function hex(s: string): Color3\n\treturn Color3.fromHex(s)\nend\n\nlocal function folder(parent: Instance, name: string): Folder\n\tlocal f = Instance.new(\"Folder\")\n\tf.Name = name\n\tf.Parent = parent\n\treturn f\nend\n\n-- A drawn-only part: anchored, nothing collides with it, no ray sees it.\nlocal function drawn(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: string): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Name = name\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.Size = size\n\tp.CFrame = cframe\n\tp.Color = color\n\tp.Material = Materials.get(material)\n\tp.TopSurface = Enum.SurfaceType.Smooth\n\tp.BottomSurface = Enum.SurfaceType.Smooth\n\tp.Parent = parent\n\treturn p\nend\n\nlocal function piece(id: string): Layout.Piece\n\tfor _, p in Layout.PIECES do\n\t\tif p.id == id then return p end\n\tend\n\terror(\"no piece \" .. id)\nend\n\n-- ---------------------------------------------------------------- the physical sill\n-- The set of piece ids that drawn decor stands in for: the back wall and the Pilea (Scenery.decor returns the ones it built).\nlocal function replaceable(): { [string]: boolean }\n\tlocal all: { [string]: boolean } = {}\n\tfor _, id in W.hidden do all[id] = true end\n\tfor _, id in Plants.pieceIds() do all[id] = true end\n\treturn all\nend\n\n-- The box the drawn window wall stands in for: the union of the back frame's pieces (one box until ROBLOX-95, four around the raised sash since). `min, max`.\nfunction Scenery.wallBox(): (Vector3, Vector3)\n\tlocal first = piece(W.hidden[1])\n\tlocal x0, y0, z0, x1, y1, z1 = first.lo.X, first.lo.Y, first.lo.Z, first.hi.X, first.hi.Y, first.hi.Z\n\tfor _, id in W.hidden do\n\t\tlocal p = piece(id)\n\t\tx0, y0, z0 = math.min(x0, p.lo.X), math.min(y0, p.lo.Y), math.min(z0, p.lo.Z)\n\t\tx1, y1, z1 = math.max(x1, p.hi.X), math.max(y1, p.hi.Y), math.max(z1, p.hi.Z)\n\tend\n\treturn Vector3.new(x0, y0, z0), Vector3.new(x1, y1, z1)\nend\n\n-- The physical parts of some pieces, one anchored Part for each, into `parent` (ROBLOX-94: the part-making the sill always had, for any region's pieces; World/WorldBuild builds\n-- each region with it). `hide`: the ids of the pieces whose look is replaced by a drawing; those turn invisible but stay solid and climbable.\nfunction Scenery.parts(parent: Instance, pieces: { Layout.Piece }, hide: { [string]: boolean })\n\tfor _, spec in pieces do\n\t\tassert(Surfaces[spec.profile], \"unknown surface profile \" .. spec.profile)\n\t\tlocal p = Instance.new(\"Part\")\n\t\tp.Name = spec.id\n\t\tp.Anchored = true\n\t\tp.Size = spec.hi - spec.lo\n\t\tp.Position = (spec.lo + spec.hi) * 0.5\n\t\tlocal paint = Graphics.paint[spec.id]\n\t\tp.Color = if paint then hex(paint.color) else spec.color\n\t\tif paint and paint.reflectance then p.Reflectance = paint.reflectance end\n\t\tp.Material = Materials.get(M.pieces[spec.id] or (spec :: any).material or M.fallback) -- (a garden piece names its own, ROBLOX-95: World/Garden)\n\t\tp.TopSurface = Enum.SurfaceType.Smooth\n\t\tp.BottomSurface = Enum.SurfaceType.Smooth\n\t\tp:SetAttribute(\"SurfaceId\", spec.id)\n\t\tp:SetAttribute(\"ProfileId\", spec.profile)\n\t\tif hide[spec.id] then\n\t\t\t-- still solid and climbable; the decor draws it in its place (the wall with a see-through opening, the leaves and stems)\n\t\t\tp.Transparency = 1\n\t\t\tp.CastShadow = false\n\t\tend\n\t\tp.Parent = parent\n\tend\nend\n\n-- `replaced`: the ids of the pieces whose drawn version exists (Scenery.decor's second result); those turn invisible but stay solid\n-- and climbable. A piece whose drawing could not be built stays visible instead of leaving a hole. nil means all the pieces that\n-- the decor can replace (the wall and the Pilea's leaves and stems). `pieces`: the sill's boxes (the layout's own unless World/WorldBuild hands in its region's, which are the same).\nfunction Scenery.sill(replaced: { [string]: boolean }?, pieces: { Layout.Piece }?): Folder\n\tlocal hide = replaced or replaceable()\n\tlocal sill = Instance.new(\"Folder\")\n\tsill.Name = \"Windowsill\"\n\tsill:SetAttribute(\"ContentRevision\", Layout.CONTENT_REVISION)\n\tScenery.parts(sill, pieces or Layout.PIECES, hide)\n\treturn sill\nend\n\n-- ---------------------------------------------------------------- a drawn look from records (ROBLOX-95)\n-- One drawn-only part for each record of a region's look (World/Garden.Drawn: Region.decor of every kind but the sill's): anchored, nothing collides with it, no\n-- ray sees it, built into a folder per `group` under `parent`; `full` records carry FullOnly (Client/WorldDetail drops them on the low tier). Returns how many.\n-- ROBLOX-108: `first` and `last` build only that slice of the list (a client spreads a look over a few frames, Client/LookStream), and `folders`, kept by the\n-- caller between slices, holds the group folders already made under `parent`, so a look built in slices is the one built at once.\nexport type Drawn = {\n\tid: string, size: Vector3, at: Vector3, color: Color3, transparency: number?,\n\tmaterial: string?, shape: string?, turn: Vector3?, full: boolean?, group: string?, shadow: boolean?,\n\tfar: boolean?, reflectance: number?, -- (ROBLOX-115: the preserve's backdrop: in the zone's far look; a shine)\n\tdew: number?, -- (ROBLOX-117: a dew drop's lag)\n}\nfunction Scenery.look(parent: Instance, list: { Drawn }, first: number?, last: number?, folders: { [string]: Instance }?): number\n\tlocal groups: { [string]: Instance } = folders or {}\n\tlocal i0, i1 = first or 1, math.min(last or #list, #list)\n\tfor i = i0, i1 do\n\t\tlocal d = list[i]\n\t\tlocal name = d.group or \"\"\n\t\tlocal into: Instance? = groups[name]\n\t\tif into == nil then\n\t\t\tlocal made = if name == \"\" then parent else folder(parent, name)\n\t\t\tgroups[name] = made\n\t\t\tinto = made\n\t\tend\n\t\tlocal cframe = CFrame.new(d.at)\n\t\tif d.turn ~= nil then cframe *= CFrame.Angles(math.rad(d.turn.X), math.rad(d.turn.Y), math.rad(d.turn.Z)) end\n\t\t-- (ROBLOX-126) a mesh record: the part turned a quarter when the mesh's long axis lies the other way, the box's size kept\n\t\tlocal fileMesh = Meshes.of(d.shape)\n\t\tlocal size, meshScale = d.size, Vector3.one\n\t\tif fileMesh ~= nil then\n\t\t\tlocal quarter, scale = Meshes.fit(fileMesh, d.size)\n\t\t\tmeshScale = scale\n\t\t\tif quarter then cframe *= CFrame.Angles(0, math.rad(90), 0); size = Vector3.new(d.size.Z, d.size.Y, d.size.X) end\n\t\tend\n\t\tlocal p = drawn(into :: Instance, d.id, size, cframe, if fileMesh ~= nil then Color3.new(1, 1, 1) else d.color, d.material or \"SmoothPlastic\")\n\t\tp.Transparency = d.transparency or 0\n\t\tif d.reflectance ~= nil then p.Reflectance = d.reflectance end\n\t\tp.CastShadow = d.shadow == true\n\t\tif d.shape == \"Ball\" then\n\t\t\tp.Shape = Enum.PartType.Ball\n\t\telseif d.shape == \"Cylinder\" then\n\t\t\tp.Shape = Enum.PartType.Cylinder\n\t\telseif d.shape == \"Ellipsoid\" then\n\t\t\tlocal mesh = Instance.new(\"SpecialMesh\")\n\t\t\tmesh.MeshType = Enum.MeshType.Sphere\n\t\t\tmesh.Parent = p\n\t\telseif fileMesh ~= nil then\n\t\t\tlocal mesh = Instance.new(\"SpecialMesh\")\n\t\t\tmesh.MeshType = Enum.MeshType.FileMesh\n\t\t\tmesh.MeshId = fileMesh.id\n\t\t\tmesh.TextureId = Meshes.TEXTURE\n\t\t\tmesh.Scale = meshScale\n\t\t\tmesh.Parent = p\n\t\tend\n\t\tif d.full then p:SetAttribute(\"FullOnly\", true) end\n\t\t-- (ROBLOX-117) a dew drop: hidden until Habitat/DayLight.applyDew shows it by the hour, from its lag to its transparency at full dew\n\t\tif d.dew ~= nil then\n\t\t\tp:SetAttribute(\"Lag\", d.dew)\n\t\t\tp:SetAttribute(\"Base\", d.transparency or 0.35)\n\t\t\tp.Transparency = 1\n\t\tend\n\tend\n\treturn math.max(0, i1 - i0 + 1)\nend\n\n-- ---------------------------------------------------------------- the window wall\n-- ROBLOX-95: the middle lower sash is raised 6 cm (Graphics.window.opening, the layout's own gap between the back frame's four pieces). The wall below the\n-- window is cut there down to the sill rail, the jambs line the cut, the glass over the gap is gone, and the raised sash's bottom rail runs across its top;\n-- the upper part of the middle pane is the raised sash's glass and the side panes are as they were. Everything drawn stays behind the climbable faces\n-- (`slabGap`) or flush with them, as the wall always has.\nfunction Scenery.window(parent: Instance): Folder\n\tlocal wall = folder(parent, \"Wall\")\n\tlocal lo, hi = Scenery.wallBox()\n\tlocal plane = hi.Z -- the climbable face\n\tlocal slabFront = plane - W.slabGap\n\tlocal zMid = (slabFront + lo.Z) / 2\n\tlocal depth = slabFront - lo.Z\n\tlocal head = math.max(hi.Y, W.head) -- (ROBLOX-112: the frame goes on up over the back frame to the window's head, over World/Garden's window box)\n\tlocal plaster, wood = hex(W.wallColor), hex(W.trimColor)\n\tlocal O, jamb, gap = W.opening, W.jambWidth, W.slabGap\n\tlocal function slab(name: string, x0: number, x1: number, y0: number, y1: number)\n\t\tdrawn(wall, name, Vector3.new(x1 - x0, y1 - y0, depth), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, zMid), plaster, M.wall)\n\tend\n\tslab(\"ApronWest\", lo.X, O.left - jamb, lo.Y, W.bottom)\n\tslab(\"ApronEast\", O.right + jamb, hi.X, lo.Y, W.bottom)\n\tslab(\"Header\", lo.X, hi.X, W.top, head)\n\tslab(\"StileWest\", lo.X, W.left, W.bottom, W.top)\n\tslab(\"StileEast\", W.right, hi.X, W.bottom, W.top)\n\tlocal function bar(name: string, x0: number, x1: number, y0: number, y1: number)\n\t\tlocal trim = drawn(wall, name, Vector3.new(x1 - x0, y1 - y0, W.trimDepth), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, plane - W.trimDepth / 2), wood, M.trim)\n\t\ttrim.Reflectance = W.trimReflectance\n\tend\n\tlocal t0, t1 = W.transom, W.transom + W.transomH\n\tbar(\"TrimBottomWest\", W.left, O.left - jamb, W.bottom, W.bottom + W.trimWidth)\n\tbar(\"TrimBottomEast\", O.right + jamb, W.right, W.bottom, W.bottom + W.trimWidth)\n\tbar(\"TrimTop\", W.left, W.right, W.top - W.trimWidth, W.top)\n\tbar(\"TrimWest\", W.left, W.left + W.trimWidth, W.bottom, W.top)\n\tbar(\"TrimEast\", W.right - W.trimWidth, W.right, W.bottom, W.top)\n\tfor i, x in W.mullions do\n\t\tbar(\"Mullion\" .. i, x - W.mullionWidth / 2, x + W.mullionWidth / 2, W.bottom, W.top)\n\tend\n\t-- (ROBLOX-112) the transom across the side lights and the upper sash's bottom rail across the middle one, where the sashes meet\n\tbar(\"TransomWest\", W.left, O.left - jamb, t0, t1)\n\tbar(\"TransomEast\", O.right + jamb, W.right, t0, t1)\n\tbar(\"MeetingRail\", O.left - jamb, O.right + jamb, t0, t1)\n\t-- the way out: the sill rail (trim, its top a hair under the rail's walkable top), the jambs through the wall's depth either side, and the raised\n\t-- sash's bottom rail across the top, set back in the frame\n\tlocal function block(name: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number): Part\n\t\tlocal p = drawn(wall, name, Vector3.new(x1 - x0, y1 - y0, z1 - z0), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), wood, M.trim)\n\t\tp.Reflectance = W.trimReflectance\n\t\treturn p\n\tend\n\tblock(\"SillRail\", O.left - jamb, O.right + jamb, lo.Y, O.bottom - gap, lo.Z + gap, slabFront)\n\tblock(\"JambWest\", O.left - jamb, O.left - gap, O.bottom - gap, O.top + W.sashRail, lo.Z + gap, slabFront)\n\tblock(\"JambEast\", O.right + gap, O.right + jamb, O.bottom - gap, O.top + W.sashRail, lo.Z + gap, slabFront)\n\tblock(\"SashRail\", O.left - jamb, O.right + jamb, O.top + gap, O.top + W.sashRail, plane - W.sashSetback - W.sashDepth, plane - W.sashSetback)\n\t-- (ROBLOX-112) the raised lower sash's top rail, as far over the transom as the sash is raised, set back as its bottom rail is\n\tblock(\"SashTop\", O.left - jamb, O.right + jamb, t0 + W.sashLift, t1 + W.sashLift, plane - W.sashSetback - W.sashDepth, plane - W.sashSetback)\n\tlocal g = W.glass\n\tlocal gz = plane - g.setback - g.thickness / 2\n\tlocal function pane(name: string, x0: number, x1: number, y0: number, y1: number)\n\t\tlocal glass = drawn(wall, name, Vector3.new(x1 - x0, y1 - y0, g.thickness), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, gz), hex(g.color), M.glass)\n\t\tglass.Transparency = g.transparency\n\t\tglass.Reflectance = g.reflectance\n\t\tglass.CastShadow = false\n\tend\n\tpane(\"GlassWest\", W.left, O.left - jamb, W.bottom, t0)\n\tpane(\"GlassEast\", O.right + jamb, W.right, W.bottom, t0)\n\tpane(\"Glass\", O.left - jamb, O.right + jamb, O.top + W.sashRail, t0 + W.sashLift) -- the raised sash's pane, up behind the upper sash's rail to its own\n\t-- (ROBLOX-112) the upper lights over the transom\n\tpane(\"GlassUpperWest\", W.left, O.left - jamb, t1, W.top)\n\tpane(\"GlassUpperEast\", O.right + jamb, W.right, t1, W.top)\n\tpane(\"GlassUpper\", O.left - jamb, O.right + jamb, t1 + W.sashLift, W.top)\n\treturn wall\nend\n\n-- ---------------------------------------------------------------- dust motes in the window light\nfunction Scenery.dust(parent: Instance): Part\n\tlocal D = Graphics.dust\n\tlocal volume = drawn(parent, \"DustVolume\", D.size, CFrame.new(D.at), Color3.new(1, 1, 1), \"SmoothPlastic\")\n\tvolume.Transparency = 1\n\tvolume.CastShadow = false\n\tlocal motes = Instance.new(\"ParticleEmitter\")\n\tmotes.Name = \"Motes\"\n\tmotes.Texture = D.texture\n\tmotes.Rate = D.rate\n\tmotes.Lifetime = NumberRange.new(D.lifetime[1], D.lifetime[2])\n\tmotes.Speed = NumberRange.new(D.speed[1], D.speed[2])\n\tmotes.SpreadAngle = Vector2.new(180, 180)\n\tmotes.Rotation = NumberRange.new(0, 360)\n\tmotes.RotSpeed = NumberRange.new(-20, 20)\n\tmotes.Size = NumberSequence.new({\n\t\tNumberSequenceKeypoint.new(0, D.particle[1]),\n\t\tNumberSequenceKeypoint.new(0.5, D.particle[2]),\n\t\tNumberSequenceKeypoint.new(1, D.particle[1]),\n\t})\n\tmotes.Transparency = NumberSequence.new({\n\t\tNumberSequenceKeypoint.new(0, 1),\n\t\tNumberSequenceKeypoint.new(0.2, D.transparency),\n\t\tNumberSequenceKeypoint.new(0.8, D.transparency),\n\t\tNumberSequenceKeypoint.new(1, 1),\n\t})\n\tmotes.LightEmission = D.lightEmission\n\tmotes.LightInfluence = D.lightInfluence\n\tmotes.Color = ColorSequence.new(hex(D.color))\n\tmotes.Drag = 0.5\n\tmotes.Acceleration = Vector3.new(0, 0.01, 0)\n\tmotes.Shape = Enum.ParticleEmitterShape.Box\n\tmotes.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward\n\tmotes.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume\n\tmotes:SetAttribute(\"Dust\", true) -- WorldDetail thins it out in the low tier\n\tmotes.Parent = volume\n\treturn volume\nend\n\n-- ---------------------------------------------------------------- the view out of the window\n-- Where an item that should appear at (u, v) on the glass, `depth` beyond it, really goes, and how much bigger it is than\n-- it looks. The reference eye is the camera's usual spot (Graphics.view.eye).\nfunction Scenery.viewPosition(u: number, v: number, depth: number): (Vector3, number)\n\tlocal eye = Graphics.view.eye\n\tlocal _, wallHi = Scenery.wallBox()\n\tlocal plane = wallHi.Z\n\tlocal reach = eye.Z - plane\n\tlocal k = (reach + depth) / reach\n\treturn Vector3.new(eye.X + (u - eye.X) * k, eye.Y + (v - eye.Y) * k, plane - depth), k\nend\n\nScenery.MAX_PART = 2048 -- (ROBLOX-114) the largest a part may be along any axis in Roblox\n\nfunction Scenery.view(parent: Instance): Folder\n\tlocal V = Graphics.view\n\tlocal view = folder(parent, \"View\")\n\tlocal ground = drawn(view, \"Ground\", Vector3.new(V.ground.size, 2, V.ground.size),\n\t\tCFrame.new(0, V.ground.y - 1, -V.ground.size * 0.5 + 300), hex(V.ground.color), M.ground)\n\tground.CastShadow = false\n\tif V.ground.beyond then -- (ROBLOX-114: the same again past its far edge, under the gardens and the houses across the way)\n\t\tlocal far = drawn(view, \"GroundBeyond\", Vector3.new(V.ground.size, 2, V.ground.size),\n\t\t\tCFrame.new(0, V.ground.y - 1, -V.ground.size * 1.5 + 300), hex(V.ground.color), M.ground)\n\t\tfar.CastShadow = false\n\tend\n\tfor _, item in V.items do\n\t\tlocal at, k = Scenery.viewPosition(item.u, item.v, item.depth)\n\t\tlocal t = (item.t or item.w) * k\n\t\tlocal part: Part\n\t\tif item.kind == \"ball\" then\n\t\t\tpart = drawn(view, item.id, Vector3.one * item.w * k, CFrame.new(at), hex(item.color), M.view)\n\t\t\tpart.Shape = Enum.PartType.Ball\n\t\telseif item.kind == \"roof\" then\n\t\t\tlocal side = item.w * k / math.sqrt(2)\n\t\t\tpart = drawn(view, item.id, Vector3.new(side, side, t), CFrame.new(at) * CFrame.Angles(0, 0, math.rad(45)), hex(item.color), M.view)\n\t\telseif item.kind == \"trunk\" then -- (ROBLOX-103: a round upright rod)\n\t\t\tpart = drawn(view, item.id, Vector3.new((item.h or item.w) * k, item.w * k, item.w * k), CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90)), hex(item.color), \"Wood\")\n\t\t\tpart.Shape = Enum.PartType.Cylinder\n\t\telseif item.kind == \"hill\" then -- (ROBLOX-103)\n\t\t\t-- (ROBLOX-114: a part is at most 2,048 studs; a bigger hill is a part of at most that with its sphere mesh scaled up to the hill's size)\n\t\t\tlocal size = Vector3.new(item.w * k, (item.h or item.w) * k, t)\n\t\t\tlocal most = math.max(size.X, size.Y, size.Z)\n\t\t\tlocal shrink = if most > Scenery.MAX_PART then Scenery.MAX_PART / most else 1\n\t\t\tpart = drawn(view, item.id, size * shrink, CFrame.new(at), hex(item.color), M.view)\n\t\t\tlocal mesh = Instance.new(\"SpecialMesh\")\n\t\t\tmesh.MeshType = Enum.MeshType.Sphere\n\t\t\tmesh.Scale = Vector3.one / shrink\n\t\t\tmesh.Parent = part\n\t\telse\n\t\t\tpart = drawn(view, item.id, Vector3.new(item.w * k, (item.h or item.w) * k, t), CFrame.new(at), hex(item.color), M.view)\n\t\tend\n\t\tpart.CastShadow = false\n\t\tif item.full then part:SetAttribute(\"FullOnly\", true) end\n\tend\n\tScenery.across(view)\n\treturn view\nend\n\n-- ROBLOX-103: the bungalows across the way and the garden's fences (Graphics.view.across, Graphics.view.fence), in the garden's own studs, into the view's folder:\n-- for each house its rendered wall, the front slope of its roof up to the ridge (both tiers), a ridge cap, a row of windows, a door and a chimney (full tier);\n-- the back fence and the two side fences (both tiers) and the back fence's posts (full tier). Nothing casts a shadow (the view never has), so the light is the light.\nfunction Scenery.across(view: Instance)\n\tlocal A, F = Graphics.view.across, Graphics.view.fence\n\tlocal ground = Graphics.view.ground.y\n\tlocal function part(name: string, size: Vector3, cframe: CFrame, color: string, material: string, full: boolean): Part\n\t\tlocal p = drawn(view, name, size, cframe, hex(color), material)\n\t\tp.CastShadow = false\n\t\tif full then p:SetAttribute(\"FullOnly\", true) end\n\t\treturn p\n\tend\n\tlocal pitch = math.rad(A.pitch)\n\tlocal run = A.depth / 2 + A.overhang -- from the eave out front to the ridge over the middle, flat\n\tlocal slope = run / math.cos(pitch)\n\tlocal eaveY = ground + A.wall -- (the eave stands `overhang` out from the front wall, toward the garden, +z)\n\tfor _, h in A.houses do\n\t\tlocal backZ = A.front - A.depth\n\t\tpart(h.id .. \"_wall\", Vector3.new(h.w, A.wall, A.depth), CFrame.new(h.x, ground + A.wall / 2, (A.front + backZ) / 2), h.wall, A.wallMaterial, false)\n\t\t-- the roof's front slope: from the eave (over the overhang, in front of the wall) up and back to the ridge over the middle\n\t\tlocal mid = Vector3.new(h.x, eaveY + run * math.tan(pitch) / 2, A.front + A.overhang - run / 2)\n\t\tpart(h.id .. \"_roof\", Vector3.new(h.w + 2 * A.overhang, 6, slope), CFrame.new(mid) * CFrame.Angles(pitch, 0, 0), h.roof, A.roofMaterial, false)\n\t\tlocal ridgeY = eaveY + run * math.tan(pitch)\n\t\tlocal ridgeZ = A.front + A.overhang - run\n\t\tpart(h.id .. \"_ridge\", Vector3.new(h.w + 2 * A.overhang, A.ridgeCap, A.ridgeCap * 1.6), CFrame.new(h.x, ridgeY + 2, ridgeZ), h.roof, A.roofMaterial, true)\n\t\t-- one row of windows (and a door), evenly along the front, a hair proud of the wall\n\t\tlocal W, D = A.window, A.door\n\t\tlocal slots = h.windows + (if h.door then 1 else 0)\n\t\tfor k = 1, slots do\n\t\t\tlocal x = h.x - h.w / 2 + h.w * (k - 0.5) / slots\n\t\t\tif h.door and k == math.ceil(slots / 2) then\n\t\t\t\tpart(`{h.id}_door`, Vector3.new(D.w, D.h, 3), CFrame.new(x, ground + D.h / 2, A.front + 1.4), D.color, A.wallMaterial, true)\n\t\t\telse\n\t\t\t\tpart(`{h.id}_window{k}`, Vector3.new(W.w, W.h, 3), CFrame.new(x, ground + W.sill + W.h / 2, A.front + 1.4), W.color, \"SmoothPlastic\", true).Reflectance = 0.08\n\t\t\tend\n\t\tend\n\t\tif h.chimney ~= nil then\n\t\t\tlocal C = A.chimney\n\t\t\tlocal cx = h.x + h.chimney * h.w\n\t\t\tpart(h.id .. \"_chimney\", Vector3.new(C.w, C.h + 60, C.t), CFrame.new(cx, ridgeY + C.h / 2 - 30, ridgeZ + 40), C.color, \"Brick\", true)\n\t\tend\n\tend\n\t-- the fences: the back one across the garden's end, the sides from the house to it\n\tlocal depthOf = F.near - F.back\n\tpart(\"fence_back\", Vector3.new(F.x1 - F.x0, F.height, F.thick), CFrame.new((F.x0 + F.x1) / 2, ground + F.height / 2, F.back), F.color, F.material, false)\n\tfor i, x in { F.x0, F.x1 } do\n\t\tpart(\"fence_side\" .. i, Vector3.new(F.thick, F.height, depthOf), CFrame.new(x, ground + F.height / 2, (F.near + F.back) / 2), F.color, F.material, false)\n\tend\n\tfor k = 1, F.posts do\n\t\tlocal x = F.x0 + (F.x1 - F.x0) * (k - 0.5) / F.posts\n\t\tpart(\"fence_post\" .. k, Vector3.new(F.post, F.height + 6, F.post), CFrame.new(x, ground + (F.height + 6) / 2, F.back + F.thick / 2 + F.post / 2), F.postColor, \"Wood\", true)\n\tend\nend\n\n-- ---------------------------------------------------------------- chips in the paint, cracks, a crumb, a coin and fallen leaves (full tier)\nfunction Scenery.details(parent: Instance): Folder\n\tlocal D = Graphics.details\n\tlocal details = folder(parent, \"Details\")\n\tdetails:SetAttribute(\"FullOnly\", true)\n\tfor i, c in D.chips do\n\t\tlocal chip = drawn(details, \"PaintChip\" .. i, Vector3.new(c.w, D.chipThickness, c.d),\n\t\t\tCFrame.new(c.x, D.chipThickness / 2 + 0.001, c.z) * CFrame.Angles(0, math.rad(c.turn), 0), hex(c.color), M.chip)\n\t\tchip.CastShadow = false\n\tend\n\tfor n, line in D.cracks do\n\t\tfor i = 1, #line - 1 do\n\t\t\tlocal a, b = line[i], line[i + 1]\n\t\t\tlocal dx, dz = b[1] - a[1], b[2] - a[2]\n\t\t\tlocal length = math.sqrt(dx * dx + dz * dz)\n\t\t\tlocal seg = drawn(details, `Crack{n}_{i}`, Vector3.new(D.crackWidth, D.crackHeight, length + D.crackWidth * 0.6),\n\t\t\t\tCFrame.new((a[1] + b[1]) / 2, D.crackHeight / 2 + 0.001, (a[2] + b[2]) / 2) * CFrame.Angles(0, math.atan2(dx, dz), 0), hex(D.crackColor), M.crack)\n\t\t\tseg.CastShadow = false\n\t\tend\n\tend\n\tfor i, c in D.crumbs do\n\t\tdrawn(details, \"Crumb\" .. i, Vector3.new(c.sx, c.sy, c.sz), CFrame.new(c.x, c.y, c.z) * CFrame.Angles(0, math.rad(c.turn), 0), hex(c.color), M.crumb)\n\tend\n\tPatina.floor(details) -- a copper coin and some fallen Pilea leaves\n\treturn details\nend\n\n-- ---------------------------------------------------------------- soft shafts of light from the window (full tier)\n-- `sun`: the unit vector toward the sun. Nothing is built if the sun is not behind the window and above the horizon.\nfunction Scenery.shafts(parent: Instance, sun: Vector3): Folder?\n\tlocal S = Graphics.shafts\n\tif sun.Y < 0.15 or sun.Z > -0.05 then return nil end\n\tlocal shafts = folder(parent, \"Shafts\")\n\tshafts:SetAttribute(\"FullOnly\", true)\n\tlocal _, wallHi = Scenery.wallBox()\n\tlocal plane = wallHi.Z\n\tfor i, x in S.x do\n\t\tlocal start = Vector3.new(x, S.startY, plane - 0.05)\n\t\tlocal stop = start - sun * ((start.Y - 0.05) / sun.Y) -- along the sun's rays down to just above the floor\n\t\tlocal anchor = drawn(shafts, \"ShaftAnchor\" .. i, Vector3.one * 0.1, CFrame.new(start), Color3.new(1, 1, 1), \"SmoothPlastic\")\n\t\tanchor.Transparency = 1\n\t\tanchor.CastShadow = false\n\t\tlocal a0 = Instance.new(\"Attachment\")\n\t\ta0.Name = \"Start\"\n\t\ta0.Parent = anchor\n\t\tlocal a1 = Instance.new(\"Attachment\")\n\t\ta1.Name = \"End\"\n\t\ta1.Position = anchor.CFrame:PointToObjectSpace(stop)\n\t\ta1.Parent = anchor\n\t\tfor j, layer in S.layers do\n\t\t\tlocal beam = Instance.new(\"Beam\")\n\t\t\tbeam.Name = `Shaft{i}_{j}`\n\t\t\tbeam.Attachment0 = a0\n\t\t\tbeam.Attachment1 = a1\n\t\t\tbeam.Width0 = layer[1]\n\t\t\tbeam.Width1 = layer[1] * S.grow\n\t\t\tbeam.Transparency = NumberSequence.new(layer[2])\n\t\t\tbeam.Color = ColorSequence.new(hex(S.color))\n\t\t\tbeam.LightEmission = S.lightEmission\n\t\t\tbeam.LightInfluence = 0\n\t\t\tbeam.FaceCamera = true\n\t\t\tbeam.Segments = 1\n\t\t\tbeam.Parent = anchor\n\t\tend\n\tend\n\treturn shafts\nend\n\n-- ---------------------------------------------------------------- everything drawn that is not the sill\n-- `sun`: the unit vector toward the sun (Lit.apply's result), for the shafts; nil builds none. Returns the Decor folder and the\n-- ids of the sill pieces whose look it replaced (Scenery.sill hides exactly those).\n-- The looks are best effort: a piece that fails (nothing here has run in Roblox Studio yet) is warned about, whatever it had\n-- already built is removed, and the rest is kept. The wall and the old decor entries are not optional: if they fail,\n-- Scenery.decor fails and the server keeps the plain back wall (Server/Main).\nlocal function attempt(decor: Instance, what: string, build: () -> unknown): boolean\n\tlocal before: { [Instance]: boolean } = {}\n\tfor _, d in decor:GetDescendants() do before[d] = true end\n\tlocal ok, err = pcall(build)\n\tif not ok then\n\t\twarn(`[Windowsill] decor: {what} failed: {tostring(err)}`)\n\t\tfor _, d in decor:GetDescendants() do\n\t\t\tif not before[d] then d:Destroy() end\n\t\tend\n\tend\n\treturn ok\nend\n\n-- ROBLOX-115: `world` (World/Worlds' id; the test garden when nil) is the world outside the window. The preserve's sill is the same sill in the ranger hut's window,\n-- but what it looks out on is the preserve's backdrop (World/PreserveLook, streamed on each client by Client/LookStream), so its Decor draws neither the test\n-- garden's view (the lawn, the trees, the bungalows, the fences, the hills) nor its window box on the outer sill.\nfunction Scenery.decor(sun: Vector3?, world: string?): (Model, { [string]: boolean })\n\tlocal garden = world == nil or world == \"test_garden\"\n\t-- ROBLOX-94: a Model, and a persistent one, so that with instance streaming on (Workspace.StreamingEnabled) the whole drawn sill, and the far view out of the window above\n\t-- all, reaches every client at once and never streams out; a Folder would be streamed part by part around the replication focus, and the view is hundreds of studs away.\n\t-- (Without streaming it is exactly the container the Folder was.) The client's one-time reads of it (Breakaway, WorldDetail, DayLight) depend on it being whole.\n\tlocal decor = Instance.new(\"Model\")\n\tdecor.Name = \"Decor\"\n\tdecor.ModelStreamingMode = Enum.ModelStreamingMode.Persistent\n\tlocal replaced: { [string]: boolean } = {}\n\tfor _, d in Layout.DECOR do\n\t\tif not W.replaces[d.id] then\n\t\t\tlocal p = drawn(decor, d.id, d.size, CFrame.new(d.at), if d.id == \"soil\" then hex(Flora.planter.soil) else d.color, if d.id == \"soil\" then M.soil else \"SmoothPlastic\")\n\t\t\tp.Transparency = d.transparency or 0\n\t\tend\n\tend\n\tScenery.window(decor)\n\tfor _, id in W.hidden do replaced[id] = true end\n\treplaced[W.upper] = true -- (ROBLOX-112: the window above the back frame, World/Garden's box in the region wall_upper, drawn with the rest of it here)\n\tlocal uv = Shapes.folder(decor, \"UVLayer\") -- the ultraviolet pattern of the flowers (the eye-view helper fades it in); always present\n\tattempt(decor, \"dust\", function() return Scenery.dust(decor) end)\n\tif garden then attempt(decor, \"view\", function() return Scenery.view(decor) end) end\n\tattempt(decor, \"details\", function() return Scenery.details(decor) end)\n\tif sun then attempt(decor, \"shafts\", function() return Scenery.shafts(decor, sun) end) end\n\tattempt(decor, \"wear\", function() return Patina.sill(decor) end)\n\tattempt(decor, \"glass details\", function() return Patina.glass(decor) end)\n\tattempt(decor, \"retreat\", function() return Patina.retreat(decor) end)\n\tif attempt(decor, \"pilea\", function() return Plants.pilea(decor) end) then\n\t\tfor _, id in Plants.pieceIds() do replaced[id] = true end\n\tend\n\tattempt(decor, \"grass\", function() return Plants.grass(decor) end)\n\tattempt(decor, \"planting\", function() return Plants.planter(decor) end)\n\tattempt(decor, \"moss\", function() return Dressing.moss(decor) end) -- ROBLOX-74: moss, pebbles and bark, two fallen leaves and the dew\n\tattempt(decor, \"litter\", function() return Dressing.litter(decor) end)\n\tattempt(decor, \"windfall\", function() return Dressing.windfall(decor) end)\n\tattempt(decor, \"dew\", function() return Dressing.dew(decor) end)\n\t-- (the window box's halves stand on the outer sill, solid: World/Garden's pieces, hidden once drawn here, ROBLOX-95)\n\tif garden and attempt(decor, \"garden\", function() return Plants.garden(decor, uv, Scenery.viewPosition) end) then\n\t\tfor _, id in Plants.windowBoxIds() do replaced[id] = true end\n\tend\n\treturn decor, replaced\nend\n\nreturn Scenery\n",29496,3221575414},{"Shared/Habitat/Shapes","--!strict\n-- Drawn-only parts for the decor builders (Habitat/Scenery, Plants, Patina) and the fly (Client/FlyBodies): every part is anchored, nothing collides with it, no\n-- ray sees it and nothing touches it, so the spider's rays, the camera's casts and the jump planner never meet it. Round things are\n-- Cylinder parts (their axis is local X, as in Roblox) or SpecialMesh ellipsoids (Roblox forces a Ball part to be a sphere), as the\n-- spider rig does. A flat leaf is a rounded slab: a cross of two boxes and four discs.\nlocal Layout = require(script.Parent.WindowsillLayout)\nlocal Materials = require(script.Parent.Materials)\n\nlocal Shapes = {}\n\n-- The sill piece with this id (WindowsillLayout.PIECES): the physical box that a drawn shape stands in for or sits on.\nfunction Shapes.piece(id: string): Layout.Piece\n\tfor _, p in Layout.PIECES do\n\t\tif p.id == id then return p end\n\tend\n\terror(\"no piece \" .. id)\nend\n\nlocal function hex(s: string): Color3\n\treturn Color3.fromHex(s)\nend\nShapes.hex = hex\n\n-- A drawn-only block: anchored; nothing collides with it, no ray sees it. Small things cast no shadow (callers switch it on).\nfunction Shapes.block(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: string): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Name = name\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Size = size\n\tp.CFrame = cframe\n\tp.Color = color\n\tp.Material = Materials.get(material)\n\tp.TopSurface = Enum.SurfaceType.Smooth\n\tp.BottomSurface = Enum.SurfaceType.Smooth\n\tp.Parent = parent\n\treturn p\nend\n\n-- An ellipsoid with these full diameters (x, y, z of `cframe`).\nfunction Shapes.ellipsoid(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: string): Part\n\tlocal p = Shapes.block(parent, name, size, cframe, color, material)\n\tlocal mesh = Instance.new(\"SpecialMesh\")\n\tmesh.MeshType = Enum.MeshType.Sphere\n\tmesh.Parent = p\n\treturn p\nend\n\n-- A flat disc whose axis points up: diameter and thickness, centred at `at`.\nfunction Shapes.disc(parent: Instance, name: string, diameter: number, thickness: number, at: Vector3, color: Color3, material: string): Part\n\tlocal p = Shapes.block(parent, name, Vector3.new(thickness, diameter, diameter), CFrame.new(at) * CFrame.Angles(0, 0, math.pi / 2), color, material)\n\tp.Shape = Enum.PartType.Cylinder\n\treturn p\nend\n\n-- A round rod from a to b (a Cylinder part: its axis is X, so Size is length, diameter, diameter).\nfunction Shapes.rod(parent: Instance, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, material: string): Part\n\tlocal up = if math.abs((b - a).Unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis -- a rod along the up vector has no turn to give\n\tlocal p = Shapes.block(parent, name, Vector3.new((b - a).Magnitude, diameter, diameter),\n\t\tCFrame.lookAt((a + b) * 0.5, b, up) * CFrame.Angles(0, math.pi / 2, 0), color, material)\n\tp.Shape = Enum.PartType.Cylinder\n\treturn p\nend\n\n-- A thin square-edged strand or line from a to b: `width` across, `height` tall, as long as a to b.\nfunction Shapes.strip(parent: Instance, name: string, a: Vector3, b: Vector3, width: number, height: number, color: Color3, material: string): Part\n\tlocal up = if math.abs((b - a).Unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis\n\treturn Shapes.block(parent, name, Vector3.new(width, height, (b - a).Magnitude), CFrame.lookAt((a + b) * 0.5, b, up), color, material)\nend\n\n-- A slab with rounded corners in plan, between `lo` and `hi`: two boxes in a cross and a disc in each corner, all the same\n-- colour. The boxes' tops are the slab's top; the discs and the second box sit a hair lower so no two faces share a plane.\nfunction Shapes.roundedSlab(parent: Instance, name: string, lo: Vector3, hi: Vector3, radius: number, color: Color3, material: string): { Part }\n\tlocal width, depth, height = hi.X - lo.X, hi.Z - lo.Z, hi.Y - lo.Y\n\tlocal r = math.min(radius, width / 2, depth / 2)\n\tlocal centre = (lo + hi) * 0.5\n\tlocal out: { Part } = {}\n\ttable.insert(out, Shapes.block(parent, name .. \"A\", Vector3.new(width, height, depth - 2 * r), CFrame.new(centre), color, material))\n\tlocal lower = 0.0008\n\ttable.insert(out, Shapes.block(parent, name .. \"B\", Vector3.new(width - 2 * r, height - lower, depth), CFrame.new(centre - Vector3.new(0, lower / 2, 0)), color, material))\n\tlocal dh = height - 0.0016\n\tfor i, corner in { { lo.X + r, lo.Z + r }, { hi.X - r, lo.Z + r }, { lo.X + r, hi.Z - r }, { hi.X - r, hi.Z - r } } do\n\t\ttable.insert(out, Shapes.disc(parent, name .. \"C\" .. i, 2 * r, dh, Vector3.new(corner[1], lo.Y + dh / 2, corner[2]), color, material))\n\tend\n\treturn out\nend\n\n-- Whether a drawn thing may stand at (x, z) on a surface at height `y` (ROBLOX-74): not inside the footprint of a piece that rises from that\n-- height (grown by `margin`), not within SPAWN_CLEAR of the spawn and not in or by the silk retreat. Reads the layout and changes nothing in it.\nShapes.SPAWN_CLEAR = 4.5\nShapes.RETREAT_CLEAR = 1.5\nfunction Shapes.clearAt(x: number, y: number, z: number, margin: number): boolean\n\tlocal spawn = Layout.SPAWN\n\tif (x - spawn.X) ^ 2 + (z - spawn.Z) ^ 2 < Shapes.SPAWN_CLEAR ^ 2 then return false end\n\tlocal lo, hi, k = Layout.RETREAT_MIN, Layout.RETREAT_MAX, Shapes.RETREAT_CLEAR\n\tif x > lo.X - k and x < hi.X + k and z > lo.Z - k and z < hi.Z + k then return false end\n\tfor _, p in Layout.PIECES do\n\t\tif p.lo.Y < y + 0.5 and p.hi.Y > y + 0.05 and x > p.lo.X - margin and x < p.hi.X + margin and z > p.lo.Z - margin and z < p.hi.Z + margin then\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\n-- A small deterministic random stream (Park-Miller): the same seed always scatters the same way, in Roblox and under the tests.\nfunction Shapes.rng(seed: number): () -> number\n\tlocal state = seed % 2147483647\n\tif state <= 0 then state += 2147483646 end\n\treturn function(): number\n\t\tstate = (state * 16807) % 2147483647\n\t\treturn (state - 1) / 2147483646\n\tend\nend\n\n-- Uniform random number in [a, b] from a stream.\nfunction Shapes.between(rand: () -> number, a: number, b: number): number\n\treturn a + (b - a) * rand()\nend\n\n-- Marks a part (or folder) as optional detail: Client/WorldDetail drops it on phones and tablets.\nfunction Shapes.fullOnly(item: Instance)\n\titem:SetAttribute(\"FullOnly\", true)\nend\n\n-- A folder under `parent`; `optional` marks all of it as full-tier detail.\nfunction Shapes.folder(parent: Instance, name: string, optional: boolean?): Folder\n\tlocal f = Instance.new(\"Folder\")\n\tf.Name = name\n\tif optional then f:SetAttribute(\"FullOnly\", true) end\n\tf.Parent = parent\n\treturn f\nend\n\n-- The frame at `at` whose X axis is `along` and whose Y axis is as close to `up` as it can be (the second axis of a leaf, a petal).\nfunction Shapes.frame(at: Vector3, along: Vector3, up: Vector3): CFrame\n\tlocal x = along.Unit\n\tlocal y = up - x * up:Dot(x)\n\tif y.Magnitude < 1e-6 then y = if math.abs(x.Y) < 0.9 then Vector3.yAxis - x * x.Y else Vector3.xAxis - x * x.X end\n\treturn CFrame.fromMatrix(at, x, y.Unit)\nend\n\nreturn Shapes\n",7047,1799554028},{"Shared/Habitat/SunPick","--!strict\n-- Finds a sun that shines in through the window: behind the back wall (-Z), standing between a low and a middling height,\n-- turned a little to one side so the patch of light and the mullions' shadows fall across the sill diagonally.\n-- Which way Roblox's sun travels for a given ClockTime and GeographicLatitude is not something this code assumes: it asks\n-- (`sample`), scans the day for both signs of the latitude, and takes the best match. Pure apart from `sample`, so\n-- tests/world.luau drives it with invented suns.\n\nlocal SunPick = {}\n\nexport type Target = {\n\televationDeg: number, minElevationDeg: number, maxElevationDeg: number,\n\tazimuthDeg: number, maxAzimuthDeg: number,\n\tclockFrom: number, clockTo: number, clockStep: number,\n}\nexport type Result = {\n\tok: boolean,\n\tclock: number, latitude: number,\n\tdirection: Vector3, -- unit vector from the world toward the sun\n\televationDeg: number, azimuthDeg: number,\n\treason: string,\n}\n\n-- Height above the horizon and angle from -Z (0 = straight out of the window, 90 = along the wall), in degrees.\nfunction SunPick.angles(direction: Vector3): (number, number)\n\tlocal d = direction.Unit\n\tlocal elevation = math.deg(math.asin(math.clamp(d.Y, -1, 1)))\n\tlocal azimuth = math.deg(math.atan2(math.abs(d.X), -d.Z))\n\treturn elevation, azimuth\nend\n\nlocal function result(ok: boolean, clock: number, latitude: number, direction: Vector3, reason: string): Result\n\tlocal elevation, azimuth = SunPick.angles(direction)\n\treturn { ok = ok, clock = clock, latitude = latitude, direction = direction.Unit, elevationDeg = elevation, azimuthDeg = azimuth, reason = reason }\nend\n\n-- sample(clock, latitude): the unit vector toward the sun at that time. baseClock and baseLatitude are what to fall back on.\nfunction SunPick.choose(sample: (number, number) -> Vector3, baseClock: number, baseLatitude: number, target: Target): Result\n\tlocal fallback = sample(baseClock, baseLatitude)\n\t-- A sampler that ignores the clock would make every time look the same; do not pretend to have chosen.\n\tif (sample(6, baseLatitude) - sample(12, baseLatitude)).Magnitude < 1e-6 then\n\t\treturn result(false, baseClock, baseLatitude, fallback, \"the sun direction does not change with the clock\")\n\tend\n\tlocal latitudes = { baseLatitude }\n\tif baseLatitude ~= 0 then table.insert(latitudes, -baseLatitude) end\n\tlocal best: Result? = nil\n\tlocal bestCost = math.huge\n\tfor _, latitude in latitudes do\n\t\tlocal steps = math.floor((target.clockTo - target.clockFrom) / target.clockStep + 0.5)\n\t\tfor i = 0, steps do\n\t\t\tlocal clock = target.clockFrom + i * target.clockStep\n\t\t\tlocal direction = sample(clock, latitude)\n\t\t\tif direction.Magnitude > 1e-6 and direction.Z < 0 then\n\t\t\t\tlocal elevation, azimuth = SunPick.angles(direction)\n\t\t\t\tif elevation >= target.minElevationDeg and elevation <= target.maxElevationDeg and azimuth <= target.maxAzimuthDeg then\n\t\t\t\t\tlocal cost = ((elevation - target.elevationDeg) / 10) ^ 2 + ((azimuth - target.azimuthDeg) / 20) ^ 2 + 0.001 * math.abs(clock - 10)\n\t\t\t\t\tif cost < bestCost then\n\t\t\t\t\t\tbestCost = cost\n\t\t\t\t\t\tbest = result(true, clock, latitude, direction, `clock {clock}, latitude {latitude}`)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tif best then return best end\n\treturn result(false, baseClock, baseLatitude, fallback, \"no time of day puts the sun behind the window\")\nend\n\nreturn SunPick\n",3346,1406365666},{"Shared/Habitat/TestTarget","--!strict\n-- Godot test_target.gd: a labelled prop, never prey. Path stepping is independent of rendering.\nlocal Target = {}\nTarget.__index = Target\nfunction Target.new(path: {Vector3}): any\n\tassert(#path >= 2)\n\treturn setmetatable({path=path, position=path[1], velocity=Vector3.zero, index=2, direction=1,\n\t\tpauseLeft=0, speed=0.8, pauseS=1.2, enabled=true, frozen=false, id=\"test_target\", radius=0.45}, Target)\nend\nfunction Target.step(self: any, dt: number)\n\tself.velocity = Vector3.zero\n\tif not self.enabled or self.frozen then return end\n\tif self.pauseLeft > 0 then self.pauseLeft -= dt; return end\n\tlocal before = self.position\n\tlocal delta = self.path[self.index] - before\n\tif delta.Magnitude <= self.speed * dt then\n\t\tself.position = self.path[self.index]\n\t\tlocal nextIndex = self.index + self.direction\n\t\tif nextIndex < 1 or nextIndex > #self.path then\n\t\t\tself.direction = -self.direction\n\t\t\tnextIndex = self.index + self.direction\n\t\t\tself.pauseLeft = self.pauseS\n\t\tend\n\t\tself.index = nextIndex\n\telse self.position += delta.Unit * self.speed * dt end\n\tself.velocity = (self.position - before) / dt\nend\nfunction Target.percept(self: any): any\n\tif not self.enabled then return nil end\n\treturn {id=self.id, position=self.position, radius=self.radius, velocity=self.velocity, maxCategory=\"fly_like_prey\"}\nend\nreturn Target\n",1328,1385482491},{"Shared/Habitat/WindowsillLayout","--!strict\n-- The windowsill of scripts/habitat/windowsill.gd (\"windowsill-v1\"), box for box. Coordinates are studs = Godot WU = cm,\n-- in the same right-handed, Y-up, -Z-forward frame, so every number is copied unchanged.\n\nexport type Piece = {\n\tid: string,\n\tlo: Vector3,\n\thi: Vector3,\n\tprofile: string,\n\tcolor: Color3,\n}\n\nexport type Decor = {\n\tid: string,\n\tsize: Vector3,\n\tat: Vector3,\n\tcolor: Color3,\n\ttransparency: number?,\n}\n\nlocal function hex(s: string): Color3\n\treturn Color3.fromHex(s)\nend\n\nlocal Layout = {}\n\nLayout.CONTENT_REVISION = \"windowsill-v1\"\nLayout.SPAWN = Vector3.new(-22.0, 0.0, 6.0)\nLayout.SPAWN_HEADING = Vector3.new(1, 0, 0) -- Basis(UP, -90 deg) * forward\nLayout.PLAY_BOUNDS_MIN = Vector3.new(-33, -5, -16)\nLayout.PLAY_BOUNDS_MAX = Vector3.new(33, 35, 16)\nLayout.RETREAT_MIN = Vector3.new(-27.8, 0.0, 3.0)\nLayout.RETREAT_MAX = Vector3.new(-23.3, 1.5, 9.0)\n-- Whether a point is inside the silk-lined crack (Godot's windowsill.gd in_retreat: the box, edges included).\nfunction Layout.inRetreat(p: Vector3): boolean\n\tlocal lo, hi = Layout.RETREAT_MIN, Layout.RETREAT_MAX\n\treturn p.X >= lo.X and p.X <= hi.X and p.Y >= lo.Y and p.Y <= hi.Y and p.Z >= lo.Z and p.Z <= hi.Z\nend\n\nlocal function v(x: number, y: number, z: number): Vector3\n\treturn Vector3.new(x, y, z)\nend\n\n-- Additive upper garden: old support boxes/IDs and retreat remain unchanged for existing rests.\nLayout.PIECES = {\n -- Solid stalking cover: queryable, climbable, and identical on every detail tier.\n { id = \"cover_bark_west\", lo = v(-14.4, 0, 3.4), hi = v(-11.6, 1.3, 4.0), profile = \"bare_wood_rough\", color = hex(\"756047\") },\n { id = \"cover_bark_east\", lo = v(19.5, 0, 5.8), hi = v(20.2, 1.4, 8.2), profile = \"bare_wood_rough\", color = hex(\"79624b\") },\n { id = \"cover_leaf_front\", lo = v(-0.5, 0, 10.0), hi = v(2.5, 1.1, 10.5), profile = \"leaf_dry_prototype\", color = hex(\"657b48\") },\n { id = \"cover_rim\", lo = v(7.0, 4.6, -4.3), hi = v(7.6, 5.7, -2.0), profile = \"bare_wood_rough\", color = hex(\"786148\") },\n\t{ id = \"upper_ledge\", lo = v(-20, 13.8, -12.5), hi = v(18, 14.4, -8), profile = \"bare_wood_rough\", color = hex(\"a78861\") },\n\t{ id = \"garden_step\", lo = v(-12, 0, 5), hi = v(-6, 1.2, 10), profile = \"brick_rough\", color = hex(\"b5744c\") },\n\t{ id = \"leaf_garden\", lo = v(-11.5, 7.4, 3), hi = v(-6, 7.8, 9), profile = \"leaf_dry_prototype\", color = hex(\"66884a\") },\n\t{ id = \"stem_garden\", lo = v(-10, 1.2, 5.5), hi = v(-9, 7.4, 6.5), profile = \"leaf_dry_prototype\", color = hex(\"536b43\") },\n\t{ id = \"leaf_high\", lo = v(-14, 10.8, -9), hi = v(-7, 11.2, -3), profile = \"leaf_dry_prototype\", color = hex(\"78985c\") },\n\t{ id = \"stem_high\", lo = v(-11, 0, -6.5), hi = v(-10, 10.8, -5.5), profile = \"leaf_dry_prototype\", color = hex(\"536b43\") },\n\t{ id = \"sill_floor\", lo = v(-30, -1, -12.5), hi = v(30, 0, 12.5), profile = \"painted_wood_dry\", color = hex(\"b6a082\") },\n\t-- ROBLOX-95: the back frame with the lower sash raised 6 cm, an opening x -8..8, y 0.7..6 through it (the way out onto the outer sill): the wall\n\t-- west and east of it, the frame above it, and the 0.7 cm sill rail below it. Same profile and colour as the one back_frame box they replace.\n\t{ id = \"back_frame_west\", lo = v(-31, 0, -13.5), hi = v(-8, 14, -12.5), profile = \"bare_wood_rough\", color = hex(\"ded7c3\") },\n\t{ id = \"back_frame_east\", lo = v(8, 0, -13.5), hi = v(31, 14, -12.5), profile = \"bare_wood_rough\", color = hex(\"ded7c3\") },\n\t{ id = \"back_frame_head\", lo = v(-8, 6, -13.5), hi = v(8, 14, -12.5), profile = \"bare_wood_rough\", color = hex(\"ded7c3\") },\n\t{ id = \"back_frame_rail\", lo = v(-8, 0, -13.5), hi = v(8, 0.7, -12.5), profile = \"bare_wood_rough\", color = hex(\"ded7c3\") },\n\t{ id = \"left_frame\", lo = v(-31, 0, -12.5), hi = v(-30, 14, 12.5), profile = \"bare_wood_rough\", color = hex(\"ded7c3\") },\n\t{ id = \"right_frame\", lo = v(30, 0, -12.5), hi = v(31, 14, 12.5), profile = \"bare_wood_rough\", color = hex(\"ded7c3\") },\n\t{ id = \"front_lip\", lo = v(-30, 0, 12.0), hi = v(30, 0.7, 12.5), profile = \"bare_wood_rough\", color = hex(\"8b7256\") },\n\t{ id = \"planter\", lo = v(3, 0, -8), hi = v(17, 4, 0), profile = \"brick_rough\", color = hex(\"9f6650\") },\n\t{ id = \"planter_rim\", lo = v(2.5, 4, -8.5), hi = v(17.5, 4.6, 0.5), profile = \"brick_rough\", color = hex(\"ba8264\") },\n\t{ id = \"leaf_west\", lo = v(-18, 3.8, -4), hi = v(-12, 4.2, 1), profile = \"leaf_dry_prototype\", color = hex(\"607952\") },\n\t{ id = \"leaf_middle\", lo = v(-4, 3.8, -4), hi = v(2, 4.2, 1), profile = \"leaf_dry_prototype\", color = hex(\"738a59\") },\n\t{ id = \"leaf_east\", lo = v(18, 5.0, -6), hi = v(25, 5.4, 0), profile = \"leaf_dry_prototype\", color = hex(\"829960\") },\n\t{ id = \"stem_west\", lo = v(-16.5, 0, -2), hi = v(-15.5, 3.8, -1), profile = \"leaf_dry_prototype\", color = hex(\"536b43\") },\n\t{ id = \"stem_middle\", lo = v(-2.5, 0, -2), hi = v(-1.5, 3.8, -1), profile = \"leaf_dry_prototype\", color = hex(\"536b43\") },\n\t{ id = \"stem_east\", lo = v(21, 0, -3.5), hi = v(22, 5, -2.5), profile = \"leaf_dry_prototype\", color = hex(\"536b43\") },\n\t{ id = \"leaf_tip\", lo = v(25.6, 5.15, -4.2), hi = v(28.4, 5.35, -1.8), profile = \"leaf_dry_prototype\", color = hex(\"cdb27a\") },\n\t{ id = \"crevice_back\", lo = v(-29, 0, 2), hi = v(-28, 3, 10), profile = \"bare_wood_rough\", color = hex(\"655640\") },\n\t{ id = \"crevice_roof\", lo = v(-29, 2.6, 2), hi = v(-23, 3, 10), profile = \"bare_wood_rough\", color = hex(\"8b775a\") },\n\t{ id = \"crevice_north\", lo = v(-29, 0, 2), hi = v(-23, 2.6, 2.6), profile = \"bare_wood_rough\", color = hex(\"786448\") },\n\t{ id = \"crevice_south\", lo = v(-29, 0, 9.4), hi = v(-23, 2.6, 10), profile = \"bare_wood_rough\", color = hex(\"786448\") },\n} :: { Piece }\n\nlocal decor: { Decor } = {\n\t{ id = \"soil\", size = v(12, 0.01, 6), at = v(10, 4.61, -4), color = hex(\"665644\") },\n\t-- (the window's record: never drawn, Habitat/Scenery.window draws it from Data/Graphics.window. ROBLOX-112: the window in true proportion, its glass from y 3 to 110.5 and\n\t-- its mullions the frame's height; Godot's were 55 by 10 and 12 tall, centred at y 8)\n\t{ id = \"window_glass\", size = v(55, 107.5, 0.04), at = v(0, 56.75, -12.44), color = hex(\"a9c2c1\"), transparency = 0.55 },\n\t{ id = \"mullion_w\", size = v(0.7, 107.5, 0.1), at = v(-10, 56.75, -12.35), color = hex(\"e2dbc7\") },\n\t{ id = \"mullion_e\", size = v(0.7, 107.5, 0.1), at = v(10, 56.75, -12.35), color = hex(\"e2dbc7\") },\n}\nfor i = 0, 6 do\n\ttable.insert(decor, { id = \"silk_\" .. i, size = v(4.6, 0.012, 0.045), at = v(-25.5, 0.025, 3.3 + i * 0.85), color = hex(\"ddd9bf\") })\nend\nLayout.DECOR = decor\n\nreturn table.freeze(Layout)\n",6495,700339909},{"Shared/Learning/FieldNotebook","--!strict\n-- The naturalist's notebook (LEARN-01), a port of the frozen scripts/learning/field_notebook.gd without the file and the node.\n-- Spec 4: \"an optional naturalist notebook with sourced facts, separated from in-world perception\". Each page of\n-- Data/NotebookPages opens the first time its trigger happens in play: the first jump, the first time in the eye view, a first\n-- meal, and so on. The notebook belongs to the player, not to the spider: the client keeps it outside the world's checkpoints (a\n-- return to a rest never erases a page) and a new, unrelated spider opens the same book. It decides nothing in the game and the\n-- spider learns nothing from it. Pages are listed in the order they were found; a page not yet found cannot be read through\n-- `view` or `list`, and nothing counts the pages left (spec 4: discovery must not become a completion checklist).\n-- Differences from Godot: the book is held in memory for the session (no file: server-owned saving is separate work); `toRecord`\n-- and `load` are the shape of Godot's save and its tolerant reading, for that later work. Checked in tests/notebook.luau.\n\nlocal Signal = require(script.Parent.Parent.Perception.Signal)\nlocal Data = require(script.Parent.Parent.Data.NotebookPages)\n\nlocal FieldNotebook = {}\nFieldNotebook.__index = FieldNotebook\n\nexport type Page = Data.Page\nexport type Record = { opened: { string }, eye_seconds: number }\nexport type Entry = { day: number, text: string }\n\n-- ROBLOX-89: dated lines the game adds to a page the book already has (\"things you saw\"; never a page of their own, and never shown before the page is found): at most\n-- this many to a page, the oldest dropped. They belong to the session, not to the record: `toRecord` and `load` do not carry them (the save has no field for them).\nFieldNotebook.MAX_ENTRIES = 6\n\n-- What is wrong with a page, empty when nothing is (Godot's `problems`): a missing field, an unknown trigger or no source.\nfunction FieldNotebook.problems(p: any): { string }\n\tlocal out: { string } = {}\n\tif type(p) ~= \"table\" then\n\t\treturn { \"not a page\" }\n\tend\n\tfor _, key in { \"id\", \"trigger\", \"title\", \"text\" } do\n\t\tlocal v = p[key]\n\t\tif type(v) ~= \"string\" or string.match(v, \"^%s*$\") then\n\t\t\ttable.insert(out, `no {key}`)\n\t\tend\n\tend\n\tif not table.find(Data.triggers, p.trigger) then\n\t\ttable.insert(out, `unknown trigger {tostring(p.trigger)}`)\n\tend\n\tif type(p.sources) ~= \"table\" or #p.sources == 0 then\n\t\ttable.insert(out, \"no source\")\n\tend\n\treturn out\nend\n\n-- `pages` defaults to the notebook's own; a page with a problem or a repeated id is left out (and listed in `dropped`).\nfunction FieldNotebook.new(pages: { Page }?): any\n\tlocal self = setmetatable({\n\t\tpages = {} :: { Page },\n\t\topened = {} :: { string },\n\t\teyeSeconds = 0.0,\n\t\tdropped = {} :: { string },\n\t\tentries = {} :: { [string]: { Entry } },\n\t\tpageOpened = Signal.new(), -- (id): a page opened now, after it is in `opened`\n\t\t_byId = {} :: { [string]: Page },\n\t\t_open = {} :: { [string]: boolean },\n\t}, FieldNotebook)\n\tfor _, p in pages or Data.pages do\n\t\tif #FieldNotebook.problems(p) == 0 and not self._byId[p.id] then\n\t\t\ttable.insert(self.pages, p)\n\t\t\tself._byId[p.id] = p\n\t\telse\n\t\t\ttable.insert(self.dropped, if type(p) == \"table\" and type(p.id) == \"string\" then p.id else \"?\")\n\t\tend\n\tend\n\treturn self\nend\n\nfunction FieldNotebook.isOpen(self: any, id: string): boolean\n\treturn self._open[id] == true\nend\n\n-- Whether the book has a page of this id at all (found or not). The panel never shows anything else about an unfound page.\nfunction FieldNotebook.has(self: any, id: string): boolean\n\treturn self._byId[id] ~= nil\nend\n\n-- The page, only once it is found: nil before its observation, so nothing can show it early.\nfunction FieldNotebook.view(self: any, id: string): Page?\n\tif self._open[id] then\n\t\treturn self._byId[id]\n\tend\n\treturn nil\nend\n\n-- A dated line on a page of the book (\"Day 4: ...\"), kept for the session. Returns whether it was added (a page the book has, a day and some words, and not a line\n-- the page already has).\nfunction FieldNotebook.addEntry(self: any, id: string, day: number, text: string): boolean\n\tif self._byId[id] == nil or type(text) ~= \"string\" or string.match(text, \"^%s*$\") then return false end\n\tif type(day) ~= \"number\" or day ~= day or day < 0 or day == math.huge then return false end\n\tlocal list: { Entry } = self.entries[id] or {}\n\tfor _, e in list do\n\t\tif e.day == day and e.text == text then return false end\n\tend\n\ttable.insert(list, { day = day, text = text })\n\twhile #list > FieldNotebook.MAX_ENTRIES do table.remove(list, 1) end\n\tself.entries[id] = list\n\treturn true\nend\n\n-- The lines on a page, only once the page is found (a page not yet found shows nothing, its lines included), oldest first.\nfunction FieldNotebook.entriesFor(self: any, id: string): { Entry }\n\tif not self._open[id] then return {} end\n\tlocal out: { Entry } = {}\n\tfor _, e in self.entries[id] or {} do table.insert(out, { day = e.day, text = e.text }) end\n\treturn out\nend\n\n-- Found pages as {id, title}, in the order they were found.\nfunction FieldNotebook.list(self: any): { { id: string, title: string } }\n\tlocal out = {}\n\tfor _, id in self.opened do\n\t\ttable.insert(out, { id = id, title = self._byId[id].title })\n\tend\n\treturn out\nend\n\n-- The id of the page found last (nil when none).\nfunction FieldNotebook.newest(self: any): string?\n\treturn self.opened[#self.opened]\nend\n\n-- Opens every page with this trigger that is not open yet. Returns the ids opened now, in the order of the pages.\nfunction FieldNotebook.notice(self: any, trigger: string): { string }\n\tlocal now: { string } = {}\n\tfor _, p in self.pages do\n\t\tif p.trigger == trigger and not self._open[p.id] then\n\t\t\tself._open[p.id] = true\n\t\t\ttable.insert(self.opened, p.id)\n\t\t\ttable.insert(now, p.id)\n\t\tend\n\tend\n\tfor _, id in now do\n\t\tself.pageOpened:emit(id)\n\tend\n\treturn now\nend\n\n-- A leap of `distanceWu` studs: the first jump, and a far and a long one.\nfunction FieldNotebook.noticeJump(self: any, distanceWu: number)\n\tif distanceWu ~= distanceWu or distanceWu < 0 or distanceWu == math.huge then return end\n\tself:notice(\"jump\")\n\tif distanceWu >= Data.jumpFarWu then\n\t\tself:notice(\"jump_far\")\n\tend\n\tif distanceWu >= Data.jumpLongWu then\n\t\tself:notice(\"jump_long\")\n\tend\nend\n\n-- Time in the spider-eye view, in seconds of play (the game's own time: slow motion slows it, a menu holds it).\nfunction FieldNotebook.addEyeTime(self: any, seconds: number)\n\tlocal before = self.eyeSeconds\n\tif seconds == seconds and seconds > 0 and seconds < math.huge then\n\t\tself.eyeSeconds += seconds\n\tend\n\tfor _, mark in Data.eyeMarks do\n\t\tif before < mark and self.eyeSeconds >= mark then\n\t\t\tself:notice(`eye_time_{mark}`)\n\t\tend\n\tend\nend\n\n-- The player's notebook as a plain record (Godot's file, as a table).\nfunction FieldNotebook.toRecord(self: any): Record\n\treturn { opened = table.clone(self.opened), eye_seconds = self.eyeSeconds }\nend\n\n-- Reads a record (Godot's load_saved). Anything unreadable is an empty notebook; ids no page has any more and repeats are\n-- dropped; a bad number of eye seconds is none. Announces nothing.\nfunction FieldNotebook.load(self: any, record: any)\n\ttable.clear(self.opened)\n\ttable.clear(self._open)\n\tself.eyeSeconds = 0.0\n\tif type(record) ~= \"table\" then\n\t\treturn\n\tend\n\tif type(record.opened) == \"table\" then\n\t\tfor _, id in record.opened do\n\t\t\tif type(id) == \"string\" and self._byId[id] and not self._open[id] then\n\t\t\t\tself._open[id] = true\n\t\t\t\ttable.insert(self.opened, id)\n\t\t\tend\n\t\tend\n\tend\n\tlocal eye = record.eye_seconds\n\tif type(eye) == \"number\" and eye == eye and eye >= 0 and eye < math.huge then\n\t\tself.eyeSeconds = eye\n\tend\nend\n\nreturn FieldNotebook\n",7663,3634763846},{"Shared/Learning/NotebookWatch","--!strict\n-- Watches play for the moments the naturalist's notebook opens pages on: a port of the frozen scripts/learning/notebook_watch.gd.\n-- It only listens and reads: it changes nothing the spider does, knows or senses. Godot connects signals; the Roblox client has an\n-- event loop instead, so the client hands this the events it already has (a committed leap, a refined category, the life loop's and\n-- the wasp's events, the eye view each frame) and, once a fixed tick, a view of the state that has no event (catches, a meal ending,\n-- the reserve changing, a fly taking off). It never reads the HUD's words. Nothing here runs while the game waits (the client\n-- calls it from the fixed tick and the frame it already pauses).\n--\n-- Which trigger comes from where (Godot's -> Roblox's):\n--   start .......... a life is being played (Godot: the world is ready; here, not while the menu waits for the first life)\n--   jump, jump_far, jump_long ... a committed leap, by the distance from take-off to the landing point (hops too)\n--   eye_view, eye_time_N ....... the spider-eye view is on; seconds in it\n--   shimmer ........ the eye view is drawing a movement ring or edge arc\n--   fly_recognised . the memory's category for a contact is refined to fly-like prey\n--   catch .......... a fly is seized (PreyDirector.captures goes up)\n--   meal ........... eating ends with something eaten (Godot's feeding_ended with food taken)\n--   buzz ........... a fly takes off within hearWu of the spider (Godot's caption \"[buzzing\", the flies' take-off within HEAR_WU)\n--   rest, sleep .... the life loop's rest_started, and woke (the morning after a night's sleep)\n--   moult_ready, moulted, adult ... the life loop's events; adult when the moult reaches the adult stage\n--   hungry, well_fed, starving ... the reserve changes to at or under hungryAt, at or over wellFedAt, or to nothing (not on Easy)\n--   wasp, wasp_escaped, wasp_caught ... the director's visit_started, left (it had noticed the spider), caught\n--   antennae ....... the ant-mimicking spider has stood still with its antennae up for AntMimic.noticeSeconds (the client's pose says how long)\n--   garden_bed ..... (ROBLOX-96, the Roblox game's own) the spider's first step onto a bed of the garden: the view's `region` is a region of kind \"bed\"\n--   look_ladybird, look_millipede, look_snail, look_harvestman ... (ROBLOX-105) the same for the ambient bugs: one of the view's `bugs` of the kind, not\n--                    hidden, within lookWu of the spider\n--   look_springtail, look_leafhopper, look_moth, look_crane_fly ... (ROBLOX-101) the first close look at a prey of that kind: one of the view's flies of the kind\n--                    (Species body.prey_kind, NotebookPages.looks) within lookWu of the spider, perched or flying; distance only, not the sensor's say\n-- Not wired: felt. It answers to Godot's vibration sense (a felt shake through touching surfaces), which the port does not have, so\n-- that page cannot open yet; the notebook never opens a page for something the game does not do.\n-- Checked in tests/notebook.luau.\n\nlocal Data = require(script.Parent.Parent.Data.NotebookPages)\nlocal AntMimic = require(script.Parent.Parent.Data.AntMimic)\n\nlocal NotebookWatch = {}\nNotebookWatch.__index = NotebookWatch\n\n-- Triggers this watcher can open a page on, and those it cannot (with the reason).\nNotebookWatch.UNWIRED = { felt = \"the port has no vibration sense\" } :: { [string]: string }\n\n-- The adult stage of Growth (Growth.ADULT), read here as a number so the notebook needs nothing of the life modules.\nlocal ADULT_STAGE = 3\n\n-- What the fixed tick tells the watcher (see `step`).\nexport type View = {\n\tstarted: boolean, -- a life is being played\n\tcaptures: number, -- PreyDirector.captures\n\tfeeding: boolean, -- Feeding.feeding\n\ttaken: number, -- Feeding.taken\n\tenergy: number, -- the reserve, 0 to 1\n\tgentle: boolean, -- Easy or free play: it cannot starve\n\tspider: Vector3,\n\tflies: { any }, -- the flies: .id, .position and :airborne()\n\tregion: string?, -- ROBLOX-96: the kind of the region the spider is in (\"sill\", \"bed\", ...); nil in a world without one\n\tbugs: { any }?, -- ROBLOX-105: the ambient bugs about (Prey/PreyWorld.crawlers: .kind, .position, .hidden); nil or none in a world without them\n}\n\nfunction NotebookWatch.new(book: any): any\n\tlocal self = setmetatable({\n\t\tbook = book,\n\t\tprimed = false, -- whether `step` has taken its first look since the world changed (resync)\n\t\tstarted = false,\n\t\tcaptures = 0, feeding = false, taken = 0.0, takenAtStart = 0.0, energy = 1.0,\n\t\tflying = {} :: { [string]: boolean },\n\t}, NotebookWatch)\n\treturn self\nend\n\n-- The world changed under the watcher (a return to a rest, a new spider): the next `step` only takes a fresh look, so nothing that\n-- happened before the change, or that the change itself did, opens a page.\nfunction NotebookWatch.resync(self: any)\n\tself.primed = false\nend\n\n-- A committed leap of `distance` studs.\nfunction NotebookWatch.onJump(self: any, distance: number)\n\tself.book:noticeJump(distance)\nend\n\n-- A contact's category was refined or fell back to `category` (ObservationMemory.categoryChanged).\nfunction NotebookWatch.onCategory(self: any, category: string)\n\tif category == \"fly_like_prey\" then\n\t\tself.book:notice(\"fly_recognised\")\n\tend\nend\n\n-- A life loop event ({kind, day}); `stage` is the growth stage after it.\nfunction NotebookWatch.onLife(self: any, kind: string, stage: number)\n\tif kind == \"rest_started\" then\n\t\tself.book:notice(\"rest\")\n\telseif kind == \"woke\" then\n\t\tself.book:notice(\"sleep\")\n\telseif kind == \"moult_ready\" then\n\t\tself.book:notice(\"moult_ready\")\n\telseif kind == \"moulted\" then\n\t\tself.book:notice(\"moulted\")\n\t\tif stage >= ADULT_STAGE then\n\t\t\tself.book:notice(\"adult\")\n\t\tend\n\tend\nend\n\n-- A wasp director signal ({kind, escaped}).\nfunction NotebookWatch.onWasp(self: any, kind: string, escaped: boolean?)\n\tif kind == \"visit_started\" then\n\t\tself.book:notice(\"wasp\")\n\telseif kind == \"left\" then\n\t\tif escaped == true then\n\t\t\tself.book:notice(\"wasp_escaped\")\n\t\tend\n\telseif kind == \"caught\" then\n\t\tself.book:notice(\"wasp_caught\")\n\tend\nend\n\n-- (ROBLOX-118) The ranger's cat noticed the spider (Predator/Cat's \"noticed\"): the cat's page.\nfunction NotebookWatch.onCat(self: any)\n\tself.book:notice(\"cat\")\nend\n\n-- (ROBLOX-119) The spider came close to a crab spider on its flower (Predator/CrabSpider's \"seen\"): the crab spider's page.\nfunction NotebookWatch.onCrab(self: any)\n\tself.book:notice(\"crab_spider\")\nend\n\n-- (ROBLOX-122) The green frog noticed the spider, or the spider came close to it: the frog's page.\nfunction NotebookWatch.onFrog(self: any)\n\tself.book:notice(\"frog\")\nend\n\n-- (ROBLOX-122) The green darner passed near the spider: its page.\nfunction NotebookWatch.onDarner(self: any)\n\tself.book:notice(\"darner\")\nend\n\n-- (ROBLOX-122) The spider fell into the water: the page on spiders and water.\nfunction NotebookWatch.onWater(self: any)\n\tself.book:notice(\"water\")\nend\n\n-- (ROBLOX-120) The robin was told to the spider (Predator/Bird: its shadow passed near, it landed near, or it noticed the spider): the robin's page.\nfunction NotebookWatch.onBird(self: any)\n\tself.book:notice(\"robin\")\nend\n\n-- Each rendered frame while the ant-mimicking spider is being played: how long its antennae (legs I) have been fully up. Standing still long\n-- enough for the pose (AntMimic.noticeSeconds) is what opens the walking-like-an-ant page. The client calls this; nothing here reads the pose.\nfunction NotebookWatch.antennae(self: any, shownSeconds: number)\n\tif shownSeconds >= AntMimic.noticeSeconds then\n\t\tself.book:notice(\"antennae\")\n\tend\nend\n\n-- Each rendered frame: `seconds` of play (0 while the game waits), whether the eye view is on and how many movement marks it draws.\nfunction NotebookWatch.frame(self: any, seconds: number, eyeView: boolean, movers: number)\n\tif not eyeView then\n\t\treturn\n\tend\n\tself.book:notice(\"eye_view\")\n\tself.book:addEyeTime(seconds)\n\tif movers > 0 then\n\t\tself.book:notice(\"shimmer\")\n\tend\nend\n\n-- Each fixed tick, after the spider, the flies and the life loop have moved.\nfunction NotebookWatch.step(self: any, v: View)\n\tlocal book = self.book\n\tif v.started and not self.started then\n\t\tself.started = true\n\t\tbook:notice(\"start\")\n\tend\n\tif not self.primed then\n\t\t-- The first look only takes the baseline.\n\t\tself.primed = true\n\t\tself.captures, self.feeding, self.taken, self.takenAtStart, self.energy = v.captures, v.feeding, v.taken, v.taken, v.energy\n\t\ttable.clear(self.flying)\n\t\tfor _, f in v.flies do\n\t\t\tself.flying[f.id] = f:airborne()\n\t\tend\n\t\treturn\n\tend\n\tif v.captures > self.captures then\n\t\tbook:notice(\"catch\")\n\tend\n\tself.captures = v.captures\n\t-- Eating ending with something eaten is a meal (Godot: feeding_ended with food taken).\n\tif v.feeding and not self.feeding then\n\t\tself.takenAtStart = self.taken\n\telseif self.feeding and not v.feeding and v.taken > self.takenAtStart + 1e-9 then\n\t\tbook:notice(\"meal\")\n\tend\n\tself.feeding, self.taken = v.feeding, v.taken\n\t-- The reserve changed (Godot's energy_changed).\n\tif v.energy ~= self.energy then\n\t\tself.energy = v.energy\n\t\tif v.energy <= 0 and not v.gentle then\n\t\t\tbook:notice(\"starving\")\n\t\tend\n\t\tif v.energy <= Data.hungryAt then\n\t\t\tbook:notice(\"hungry\")\n\t\telseif v.energy >= Data.wellFedAt then\n\t\t\tbook:notice(\"well_fed\")\n\t\tend\n\tend\n\t-- ROBLOX-96: the first step onto a garden bed.\n\tif v.region == \"bed\" then\n\t\tbook:notice(\"garden_bed\")\n\tend\n\t-- A fly taking off near enough to hear; (ROBLOX-101) a close look at one of the bestiary's.\n\tlocal seen: { [string]: boolean } = {}\n\tfor _, f in v.flies do\n\t\tlocal kind = if f.profile ~= nil and f.profile.body ~= nil then f.profile.body.prey_kind else nil\n\t\tlocal look = if kind ~= nil then Data.looks[kind] else nil\n\t\tif look ~= nil and (f.position - v.spider).Magnitude <= Data.lookWu then book:notice(look) end\n\t\tlocal up: boolean = f:airborne()\n\t\tseen[f.id] = up\n\t\tif up and not self.flying[f.id] and (f.position - v.spider).Magnitude <= Data.hearWu then\n\t\t\tbook:notice(\"buzz\")\n\t\tend\n\tend\n\tself.flying = seen\n\t-- (ROBLOX-105) a close look at one of the ambient bugs, out in the open (a woodlouse has no `kind`: its page is the ground's)\n\tfor _, b in (v.bugs or {}) :: { any } do\n\t\tlocal look = if b.kind ~= nil then Data.looks[b.kind] else nil\n\t\tif look ~= nil and not b.hidden and (b.position - v.spider).Magnitude <= Data.lookWu then book:notice(look) end\n\tend\nend\n\nreturn NotebookWatch\n",10403,1525196972},{"Shared/Life/Ballooning","--!strict\n-- Ballooning, the lineage moves (ROBLOX-120, docs/PARK_WORLD_DESIGN.md section 5: \"the spiderlings balloon. The player chooses one to follow: where it lands is drawn from\n-- the wind (seeded, honest: mostly nearby zones, rarely far), and the next life starts in that zone\"). The notebook's page \"Eggs, silk and wind\" says what is known: many\n-- young spiders travel by climbing high, letting out a thread of silk and being carried off by the air. Pure: the client plays the ride (Client/MateStage's rider and the\n-- camera's shot) and starts the next generation where it lands; the CLI suites and the self-test ask the same draw.\n--\n-- The draw (`land`): a pure function of the world's seed, the family's number and the day the eggs hatched, so a choice seen again lands in the same place and a\n-- restore never rerolls it. Each zone of ZONES has a weight that falls off with its distance from the hut (WEIGHT_M metres: exp(-d / WEIGHT_M)), so the near zones are\n-- the likely ones and the far ones rare; only a zone that is built (`built`, walkable in the preserve: World/Hut, World/Meadow) can be landed in, the others are listed\n-- for when they are, and drop out of the draw. In a built zone the landing is one of its `landings`, regions whose spawn is a place to stand (a spiderling's thread\n-- snags on what stands up, and it comes down there). The compact preserve keeps the garden most likely, then the meadow and pond. Their odds follow the actual\n-- relocated home ranges rather than retaining probabilities for the former distant pond.\n--\n-- The ride (`ride`, `at`): RIDE_S seconds from the egg sac in the sill's crack out through the window's sash and up over the garden on the wind, its thread streaming\n-- ahead and above it, then down onto the landing; a seeded drift and a sway, never the same twice for two families and always the same for one.\n-- `life.start_zone` (optional in a rest, Persistence/Checkpoint: absent is \"hut\", the generation that began in the crack) and `life.start_region` keep where this\n-- generation began; the ending card, the toast and the notebook's dated line say it (UI/MateText). The nursery's shut window (Life/Nursery) is the hut's inside: a\n-- generation that lands outside is in the wild, and nothing puts it back.\nlocal Preserve = require(script.Parent.Parent.World.Preserve)\n\nlocal Ballooning = {}\n\nBallooning.RIDE_S = 12.0\nBallooning.WEIGHT_M = 10.0\nBallooning.HUT = \"hut\" -- (the start of a generation that stayed in the crack)\nBallooning.SAC = Vector3.new(-27.1, 0.5, 8.4) -- (Data/MatingRules.sacAt: the egg sac in the sill's crack)\nBallooning.SASH = Vector3.new(0, 4, -16) -- the window's lower sash, out of which the threads go (World/Hut.SASH, just outside it)\nBallooning.UP = 260 -- how high over the garden's ground a ride climbs (studs), at most\n\nexport type Zone = { zone: string, name: string, built: boolean, landings: { string } }\nlocal function zone(id: string, name: string, built: boolean, landings: { string }): Zone\n\treturn table.freeze({ zone = id, name = name, built = built, landings = table.freeze(landings) })\nend\nBallooning.ZONES = table.freeze({\n\tzone(\"hut_garden\", \"the hut garden\", true, { \"garden_a2\", \"garden_a4\", \"garden_b1\", \"garden_c2\", \"garden_d2\" }),\n\tzone(\"meadow\", \"the meadow's edge\", true, { \"meadow_b1\", \"meadow_b3\", \"meadow_c3\", \"meadow_d2\", \"meadow_d5\", \"meadow_e3\" }),\n\tzone(\"pond_edge\", \"the pond's edge\", true, { \"pond_a1\", \"pond_b1\", \"deck_n2\", \"deck_s3\" }), -- (ROBLOX-122: built; its threads snag on the sedge, the rushes and the boardwalk's rail)\n\tzone(\"log_pile\", \"the log pile\", false, {}),\n\tzone(\"veteran_oak\", \"the old oak\", false, {}),\n\tzone(\"stone_wall\", \"the stone wall\", false, {}),\n\tzone(\"bramble\", \"the bramble by the railway\", false, {}),\n\tzone(\"compost\", \"the compost bays\", false, {}),\n}) :: { Zone }\nlocal BY_ZONE: { [string]: Zone } = {}\nfor _, z in Ballooning.ZONES do BY_ZONE[z.zone] = z end\nfunction Ballooning.zone(id: string): Zone?\n\treturn BY_ZONE[id]\nend\n\n-- A zone's distance from the hut (metres, home range to home range: World/Preserve.HOME_RANGES).\nfunction Ballooning.distance(id: string): number\n\tlocal hut, here = nil :: Preserve.HomeRange?, nil :: Preserve.HomeRange?\n\tfor _, h in Preserve.HOME_RANGES do\n\t\tif h.id == \"ranger_hut\" then hut = h end\n\t\tif h.id == id then here = h end\n\tend\n\tif hut == nil or here == nil then return math.huge end\n\treturn math.sqrt((here.at[1] - hut.at[1]) ^ 2 + (here.at[2] - hut.at[2]) ^ 2)\nend\n-- A zone's weight in the draw (0 for one not built).\nfunction Ballooning.weight(z: Zone): number\n\tif not z.built or #z.landings == 0 then return 0 end\n\treturn math.exp(-Ballooning.distance(z.zone) / Ballooning.WEIGHT_M)\nend\n\nlocal MOD = 2147483647\nlocal function stream(seed: number, generation: number, day: number, salt: number): () -> number\n\tlocal s = (math.floor(seed) * 83492791 + generation * 19349663 + day * 73856093 + salt * 2654435) % MOD\n\tif s <= 0 then s += MOD - 1 end\n\treturn function(): number\n\t\ts = (s * 48271) % MOD\n\t\treturn (s - 1) / (MOD - 1)\n\tend\nend\n\n-- Where the followed spiderling lands: its zone and its landing region.\nfunction Ballooning.land(seed: number, generation: number, day: number): (string, string)\n\tlocal rand = stream(seed, generation, day, 41)\n\trand()\n\tlocal total = 0\n\tfor _, z in Ballooning.ZONES do total += Ballooning.weight(z) end\n\tlocal x = rand() * total\n\tlocal pick = Ballooning.ZONES[1]\n\tfor _, z in Ballooning.ZONES do\n\t\tlocal w = Ballooning.weight(z)\n\t\tif w > 0 then\n\t\t\tpick = z\n\t\t\tx -= w\n\t\t\tif x <= 0 then break end\n\t\tend\n\tend\n\tlocal i = 1 + math.floor(rand() * #pick.landings) % #pick.landings\n\treturn pick.zone, pick.landings[i]\nend\n\n-- Whether a start zone is one a rest may name: the hut, or a zone that can be landed in.\nfunction Ballooning.valid(id: any): boolean\n\tif id == Ballooning.HUT then return true end\n\tlocal z = if type(id) == \"string\" then BY_ZONE[id] else nil\n\treturn z ~= nil and z.built\nend\n-- Whether a landing region belongs to a start zone.\nfunction Ballooning.landsIn(zoneId: string, region: any): boolean\n\tlocal z = BY_ZONE[zoneId]\n\treturn z ~= nil and type(region) == \"string\" and table.find(z.landings, region) ~= nil\nend\n\n-- The ride from the sac to `to` (the landing region's spawn): its seconds and the seeded drift.\nexport type Ride = { from: Vector3, sash: Vector3, apex: Vector3, over: Vector3, to: Vector3, seconds: number, sway: number, phase: number, wind: Vector3 }\nfunction Ballooning.ride(seed: number, generation: number, day: number, to: Vector3): Ride\n\tlocal rand = stream(seed, generation, day, 43)\n\trand()\n\tlocal mid = Ballooning.SASH:Lerp(to, 0.5)\n\tlocal wind = Vector3.new(rand() - 0.5, 0, rand() - 0.5)\n\tlocal up = math.min(Ballooning.UP, 120 + (to - Ballooning.SASH).Magnitude * 0.18)\n\treturn table.freeze({\n\t\tfrom = Ballooning.SAC, sash = Ballooning.SASH,\n\t\tapex = Vector3.new(mid.X + wind.X * 120, Preserve.GROUND_Y + up + rand() * 40, mid.Z + wind.Z * 60),\n\t\tover = to + Vector3.new(wind.X * 20, 40, wind.Z * 20), to = to,\n\t\tseconds = Ballooning.RIDE_S, sway = 6 + rand() * 6, phase = rand() * 2 * math.pi, wind = wind,\n\t})\nend\n\nlocal function bezier(a: Vector3, b: Vector3, c: Vector3, t: number): Vector3\n\tlocal u = 1 - t\n\treturn a * (u * u) + b * (2 * u * t) + c * (t * t)\nend\n-- Where the rider is `t` seconds into the ride, and the thread's far end (ahead of it and above, downwind). Done at `seconds`: on the landing.\nfunction Ballooning.at(r: Ride, t: number, reduced: boolean?): (Vector3, Vector3)\n\tlocal k = math.clamp(t / r.seconds, 0, 1)\n\tlocal p: Vector3\n\tif k < 0.12 then\n\t\tlocal e = k / 0.12\n\t\tp = r.from:Lerp(r.sash, e * e * (3 - 2 * e))\n\telseif k < 0.86 then\n\t\tlocal e = (k - 0.12) / 0.74\n\t\tp = bezier(r.sash, r.apex, r.over, e)\n\t\tif not reduced then\n\t\t\tlocal s = math.sin(e * math.pi) -- (the sway is nothing at either end)\n\t\t\tp += Vector3.new(math.sin(t * 1.3 + r.phase) * r.sway * s, math.sin(t * 0.9 + r.phase) * r.sway * 0.4 * s, math.cos(t * 1.1 + r.phase) * r.sway * 0.6 * s)\n\t\tend\n\telse\n\t\tlocal e = (k - 0.86) / 0.14\n\t\tp = r.over:Lerp(r.to, e * e * (3 - 2 * e))\n\tend\n\tlocal ahead = (r.over - r.sash)\n\tlocal dir = Vector3.new(ahead.X, 0, ahead.Z)\n\tdir = if dir.Magnitude > 1e-3 then dir.Unit else -Vector3.zAxis\n\tlocal thread = p + (dir * 0.6 + Vector3.yAxis).Unit * (if k < 0.95 then 30 else 30 * (1 - (k - 0.95) / 0.05))\n\treturn p, thread\nend\n\nreturn table.freeze(Ballooning)\n",8372,1233491754},{"Shared/Life/Growth","--!strict\n-- Frozen Godot scripts/life/growth.gd, LIFE-10..12. Durations and scales are game tuning, not measured instars.\nlocal Species = require(script.Parent.Parent.Data.Species)\nlocal Growth = {}\nGrowth.__index = Growth\nGrowth.STAGES = { \"young juvenile\", \"juvenile\", \"subadult\", \"adult\" }\nGrowth.SCALES = { 1, 1.15, 1.32, 1.50 }\nGrowth.ADULT = 3\nGrowth.READY_FOOD = 0.9\n-- What one housefly counts for in `fedSinceMoult`: a third of Godot's 0.9 (ROBLOX-61; a small prey is half of it). The client credits food in these units.\nGrowth.FLY_FOOD = 0.3\n-- The game's own rules (ROBLOX-88), opt-in like NeedsModel.game and Data/Catch.game: the housefly-equivalents a moult asks for. Godot's is 3 (READY_FOOD,\n-- pinned by tests/growth_reference.json); a Growth never given these replays it. Growth:useGameRules() applies them.\n-- First and second game moults require seven and ten flies in every mode.\n-- The later adult moult retains five in Normal and three in the gentle modes.\nGrowth.game = { firstMoultFlies = 7, secondMoultFlies = 10, moultFlies = 5, gentleMoultFlies = 3 }\nGrowth.MOULT_HOURS = 12\nGrowth.SOFT_HOURS = 10\nGrowth.SOFT_REACH = 0.7\nGrowth.SOFT_SPEED = 0.65 -- Gameplay tuning for the vulnerable soft-cuticle period.\nlocal function finite(v: any): boolean\n return type(v)==\"number\" and v==v and math.abs(v)<math.huge\nend\nfunction Growth.new(): any\n return setmetatable({stage=0,fedSinceMoult=0,ready=false,moultingHoursLeft=0,softHoursLeft=0,exuviae={}},Growth)\nend\n-- First/second game moults ask for seven/ten full-fly equivalents in every mode.\n-- The last moult retains `moultFlies` (`gentleMoultFlies` when gentle). Stores the later threshold;\n-- food already eaten is kept (a spider that has eaten two flies has eaten two flies), and a spider already ready to moult stays ready.\nfunction Growth.useGameRules(self: any,gentle: boolean?)\n self.readyFood=(if gentle==true then Growth.game.gentleMoultFlies else Growth.game.moultFlies)*Growth.FLY_FOOD;self.gameRules=true\nend\n-- What swallowing `energy` (of the reserves, in the units a housefly's meal is 0.35 of) credits toward a moult, in `fedSinceMoult`'s units: a housefly credits\n-- FLY_FOOD (0.3) whatever the moult asks for. One formula for the prey and the rival (a whole rival, Rival.FOOD 0.7, is two houseflies); it was written out twice in the client.\nfunction Growth.rivalCredit(energy: number): number\n return energy*Growth.READY_FOOD/(3*Species.fly_like_prototype.body.nutrition)\nend\n-- A meal of `energy` in housefly-equivalents (\"2 meals\" for a whole rival).\nfunction Growth.mealsOf(energy: number): number\n return math.floor(Growth.rivalCredit(energy)/Growth.FLY_FOOD+.5)\nend\n-- The food a moult asks for, in the units of `fedSinceMoult`, and in housefly-equivalents (3 by Godot's rule, 5 in the game).\nfunction Growth.readyAt(self: any): number\n if self.gameRules then\n  if self.stage==0 then return Growth.game.firstMoultFlies*Growth.FLY_FOOD end\n  if self.stage==1 then return Growth.game.secondMoultFlies*Growth.FLY_FOOD end\n end\n return self.readyFood or Growth.READY_FOOD\nend\nfunction Growth.mealGoal(self: any): number return math.floor(self:readyAt()/Growth.FLY_FOOD+.5) end\nfunction Growth.isAdult(self: any): boolean return self.stage>=Growth.ADULT end\nfunction Growth.isMoulting(self: any): boolean return self.moultingHoursLeft>0 end\n-- Discovered through movement after the first completed moult. Derive this from\n-- the saved instar so old saves and a new generation need no extra unlock flag.\nfunction Growth.canRun(self: any): boolean return self.stage>=1 and not self:isMoulting() end\nfunction Growth.canLock(self: any): boolean return self.stage>=2 and not self:isMoulting() end\nfunction Growth.isSoft(self: any): boolean return self.softHoursLeft>0 end\nfunction Growth.stageName(self: any): string return Growth.STAGES[self.stage+1] end\nfunction Growth.reachFactor(self: any): number return if self:isSoft() or self:isMoulting() then Growth.SOFT_REACH else 1 end\nfunction Growth.speedFactor(self: any): number return if self:isSoft() or self:isMoulting() then Growth.SOFT_SPEED else 1 end\nfunction Growth.softness(self: any): number return if self:isMoulting() then 1 else math.clamp(self.softHoursLeft/Growth.SOFT_HOURS,0,1) end\nfunction Growth.eat(self: any, energy: number): boolean\n if not finite(energy) or energy<=0 or self:isAdult() or self:isMoulting() then return false end\n self.fedSinceMoult+=energy\n local before=self.ready\n self.ready=self.fedSinceMoult>=self:readyAt()-1e-9\n return self.ready and not before\nend\nfunction Growth.beginMoult(self: any): boolean\n if not self.ready or self:isAdult() or self:isMoulting() then return false end\n self.moultingHoursLeft=Growth.MOULT_HOURS\n return true\nend\nfunction Growth.passHours(self: any, hours: number, at: Vector3): string\n if not finite(hours) or hours<=0 then return \"\" end\n if self:isMoulting() then\n  self.moultingHoursLeft=math.max(0,self.moultingHoursLeft-hours)\n  if self.moultingHoursLeft==0 then\n   self.stage=math.min(self.stage+1,Growth.ADULT)\n   self.ready=false;self.fedSinceMoult=0;self.softHoursLeft=Growth.SOFT_HOURS\n   table.insert(self.exuviae,at)\n   return \"moulted\"\n  end\n elseif self:isSoft() then\n  self.softHoursLeft=math.max(0,self.softHoursLeft-hours)\n  if self.softHoursLeft==0 then return \"hardened\" end\n end\n return \"\"\nend\nfunction Growth.toRecord(self: any): any\n local skins={}\n for _,p in self.exuviae do table.insert(skins,{p.X,p.Y,p.Z}) end\n return {stage=self.stage,fed_since_moult=self.fedSinceMoult,ready=self.ready,\n  moulting_hours_left=self.moultingHoursLeft,soft_hours_left=self.softHoursLeft,exuviae=skins}\nend\nfunction Growth.problems(r: any): {string}\n if type(r)~=\"table\" then return {\"growth: not a record\"} end\n local e={}\n if not finite(r.stage) or r.stage%1~=0 or r.stage<0 or r.stage>3 then table.insert(e,\"growth: invalid stage\") end\n for _,k in {\"fed_since_moult\",\"moulting_hours_left\",\"soft_hours_left\"} do\n  if not finite(r[k]) or r[k]<0 then table.insert(e,\"growth: invalid \"..k) end\n end\n if type(r.ready)~=\"boolean\" then table.insert(e,\"growth: invalid ready\") end\n if type(r.exuviae)~=\"table\" or #r.exuviae>3 then table.insert(e,\"growth: invalid old skins\")\n else for _,p in r.exuviae do\n  if type(p)~=\"table\" or #p~=3 or not finite(p[1]) or not finite(p[2]) or not finite(p[3]) then table.insert(e,\"growth: invalid skin position\") end\n end end\n return e\nend\nfunction Growth.load(self: any,r: any): boolean\n if #Growth.problems(r)>0 then return false end\n self.stage=r.stage;self.fedSinceMoult=r.fed_since_moult;self.ready=r.ready\n self.moultingHoursLeft=r.moulting_hours_left;self.softHoursLeft=r.soft_hours_left;self.exuviae={}\n for _,p in r.exuviae do table.insert(self.exuviae,Vector3.new(p[1],p[2],p[3])) end\n return true\nend\nreturn Growth\n",6771,4217257691},{"Shared/Life/LifeClock","--!strict\n-- The life clock: a port of the frozen scripts/life/life_clock.gd (LIFE-04). The windowsill's time of day and the spider's\n-- age in days. It is one of three separate clocks: the fixed action tick (SpiderMotor.DT) is unchanged by it, so a jump is\n-- never shortened when the day goes faster, and slow motion slows it with everything else because it is only ever advanced\n-- by action time. While the spider is active the day passes slowly (ACTIVE_HOURS_PER_S game hours for each second of action\n-- time); while it sleeps in its retreat at night the hours pass quickly (SLEEP_HOURS_PER_S), never more than one call's\n-- worth at a time, until morning or until the sleep ends. It moves only when it is told to (LifeLoop, each fixed tick), so\n-- the Roblox menu, which stops the ticks, never passes time.\n-- Time is compressed on purpose. A real Phidippus audax lives about a year; one life here is meant to take a few hours to\n-- play (LIFE-03: about 2 to 3 hours over roughly 10 game days).\n-- Checked against Godot's own values in tests/life_reference.json (tools/export_life_reference.gd).\n-- ROBLOX-94: how fast a region's day runs against the sill's is the game's rule, not Godot's: `LifeClock.game.clockScale` multiplies every advance of game\n-- hours (awake, asleep and moulting alike), 1.0 until the client sets it from the region the spider is in each frame (Client/WorldClient, from Shared/World/WorldMap;\n-- the sill is the only region so far and runs at 1.0; a garden region will run slower, docs/OPEN_WORLD_DESIGN.md). The rates above stay Godot's, and the goldens run\n-- at 1.0, which changes nothing, not even the last bit. It is a dial on the module and not a flag on a clock because it is never saved: hours are state, the rate is\n-- not, and a return to a rest builds a new clock that must run at the pace of where the spider now is, not where it rested.\n\nlocal LifeClock = {}\nLifeClock.__index = LifeClock\n\n-- The day: the spider wakes at WAKE_H, the light goes at DUSK_H and it is fully dark from NIGHT_H until DAWN_H.\nLifeClock.WAKE_H = 7.0\nLifeClock.DAWN_H = 6.0\nLifeClock.DUSK_H = 19.0\nLifeClock.NIGHT_H = 20.5\n-- From this hour a rest in the retreat sleeps until morning (Phidippus goes into its nest before dark).\nLifeClock.EVENING_H = 18.0\nLifeClock.START_DAY = 1\nLifeClock.START_H = 9.0\n-- About 12 waking hours in about 15 minutes of play.\nLifeClock.ACTIVE_HOURS_PER_S = 12.0 / (15.0 * 60.0)\n-- A night of sleep (about 11 hours) in about 8 seconds.\nLifeClock.SLEEP_HOURS_PER_S = 1.4\n-- The game's own rule (ROBLOX-94), not a recorded value: the pace of the day where the spider is now, against the rates above.\nLifeClock.game = { clockScale = 1.0 }\n\nexport type Record = { day: number, hour: number, sleeping: boolean }\n\nlocal function finite(x: number): boolean\n\treturn x == x and x ~= math.huge and x ~= -math.huge\nend\n\n-- Godot's fposmod: the remainder with the sign of the divisor.\nlocal function fposmod(x: number, y: number): number\n\tlocal v = math.fmod(x, y)\n\tif (v < 0 and y > 0) or (v > 0 and y < 0) then\n\t\tv += y\n\tend\n\treturn v\nend\n\n-- Godot's smoothstep (0 below `from`, 1 above `to`, the cubic in between).\nlocal function smoothstep(from: number, to: number, x: number): number\n\tif from == to then\n\t\treturn if x < from then 0 else 1\n\tend\n\tlocal s = math.clamp((x - from) / (to - from), 0, 1)\n\treturn s * s * (3.0 - 2.0 * s)\nend\nLifeClock.smoothstep = smoothstep\n\nfunction LifeClock.new(): any\n\treturn setmetatable({ day = LifeClock.START_DAY, hour = LifeClock.START_H, sleeping = false }, LifeClock)\nend\n\n-- The dial, as a usable number: anything that is not a positive finite number runs at the sill's pace rather than stop or poison the clock.\nfunction LifeClock.currentScale(): number\n\tlocal scale = LifeClock.game.clockScale\n\tif type(scale) == \"number\" and scale > 0.0 and finite(scale) then\n\t\treturn scale\n\tend\n\treturn 1.0\nend\n\nfunction LifeClock._addHours(self: any, hours: number)\n\tself.hour += hours\n\twhile self.hour >= 24.0 do\n\t\tself.hour -= 24.0\n\t\tself.day += 1\n\tend\nend\n\n-- Lets `seconds` of action time pass. Asleep, the hours run at the sleeping rate, and a sleep that reaches the morning ends\n-- there. Returns the game hours that passed.\nfunction LifeClock.advance(self: any, seconds: number, asleep: boolean): number\n\tif not finite(seconds) or seconds <= 0.0 then\n\t\treturn 0.0\n\tend\n\tlocal rate = if asleep then LifeClock.SLEEP_HOURS_PER_S else LifeClock.ACTIVE_HOURS_PER_S\n\tlocal hours = seconds * rate * LifeClock.currentScale()\n\tif asleep then\n\t\tlocal toMorning = self:hoursUntil(LifeClock.WAKE_H)\n\t\tif toMorning <= hours then\n\t\t\thours = toMorning\n\t\t\tself.sleeping = false\n\t\telse\n\t\t\tself.sleeping = true\n\t\tend\n\telse\n\t\tself.sleeping = false\n\tend\n\tself:_addHours(hours)\n\treturn hours\nend\n\n-- A moult passing: the hours run at the sleeping rate and do not stop at morning. Returns the hours that passed. (LifeLoop\n-- runs the moult on it.)\nfunction LifeClock.advanceMoult(self: any, seconds: number): number\n\tif not finite(seconds) or seconds <= 0.0 then\n\t\treturn 0.0\n\tend\n\tself.sleeping = false\n\tlocal hours = seconds * LifeClock.SLEEP_HOURS_PER_S * LifeClock.currentScale()\n\tself:_addHours(hours)\n\treturn hours\nend\n\n-- Hours from now until the clock next shows `target` (0 when it shows it now).\nfunction LifeClock.hoursUntil(self: any, target: number): number\n\treturn fposmod(target - self.hour, 24.0)\nend\n\n-- Whether a rest now would be a night's sleep: the evening, the night, or the early morning before waking.\nfunction LifeClock.isSleepTime(self: any): boolean\n\treturn self.hour >= LifeClock.EVENING_H or self.hour < LifeClock.WAKE_H\nend\n\n-- How much daylight there is, 0 (night) to 1 (full day), easing through dawn and dusk.\nfunction LifeClock.daylightAt(hour: number): number\n\tlocal W, D, N, A = LifeClock.WAKE_H, LifeClock.DUSK_H, LifeClock.NIGHT_H, LifeClock.DAWN_H\n\tif hour >= W + 1.0 and hour <= D then\n\t\treturn 1.0\n\tend\n\tif hour > D and hour < N then\n\t\treturn 1.0 - smoothstep(D, N, hour)\n\tend\n\tif hour >= A and hour < W + 1.0 then\n\t\treturn smoothstep(A, W + 1.0, hour)\n\tend\n\treturn 0.0\nend\n\nfunction LifeClock.daylight(self: any): number\n\treturn LifeClock.daylightAt(self.hour)\nend\n\n-- Words for the time of day, for the screen.\nfunction LifeClock.partOfDay(self: any): string\n\tlocal h = self.hour\n\tif h >= 5.0 and h < 10.0 then return \"morning\" end\n\tif h >= 10.0 and h < 14.0 then return \"midday\" end\n\tif h >= 14.0 and h < 18.0 then return \"afternoon\" end\n\tif h >= 18.0 and h < 20.5 then return \"evening\" end\n\treturn \"night\"\nend\n\nfunction LifeClock.toRecord(self: any): Record\n\treturn { day = self.day, hour = self.hour, sleeping = self.sleeping }\nend\n\n-- What is wrong with a record, in Godot's words (an empty list for a good one).\nfunction LifeClock.problems(d: any): { string }\n\tlocal e: { string } = {}\n\tif type(d) ~= \"table\" then\n\t\ttable.insert(e, \"life: not a record\")\n\t\treturn e\n\tend\n\tlocal dv = d.day\n\tif not (type(dv) == \"number\" and finite(dv) and dv == math.floor(dv)) or dv < 1 then\n\t\ttable.insert(e, \"life: the day is not a whole number from 1\")\n\tend\n\tlocal hv = d.hour\n\tif type(hv) ~= \"number\" or not finite(hv) or hv < 0.0 or hv >= 24.0 then\n\t\ttable.insert(e, \"life: the hour is not in [0, 24)\")\n\tend\n\tif type(d.sleeping) ~= \"boolean\" then\n\t\ttable.insert(e, \"life: 'sleeping' is not true or false\")\n\tend\n\treturn e\nend\n\n-- Restores a record made by toRecord. False, and nothing changed, for anything that is not one.\nfunction LifeClock.load(self: any, d: any): boolean\n\tif #LifeClock.problems(d) > 0 then\n\t\treturn false\n\tend\n\tself.day = d.day\n\tself.hour = d.hour\n\tself.sleeping = d.sleeping\n\treturn true\nend\n\nreturn LifeClock\n",7624,3202471471},{"Shared/Life/LifeLoop","--!strict\n-- LifeLoop: the rest, sleep and day of the frozen scripts/habitat/habitat_loop.gd (T08, LIFE-04 to LIFE-06), without the\n-- world. The client gives it, once a fixed tick and after the spider and its meal have moved, what it needs to know about the\n-- spider (in the crack, on a surface, still, holding or eating prey) and the presses of the feed and cancel buttons; it keeps\n-- the life clock and the rest, tells the NeedsModel how many game hours passed, says how much daylight there is and how far\n-- the eyes reach in it, and asks for the retreat checkpoint when a rest begins and when a night's sleep reaches the morning.\n--\n-- * Resting: in the silk-lined crack, on a surface, keeping still, holding no prey, E rests (Godot's interact). E or Q again,\n--   moving, or anything that makes resting impossible ends it.\n-- * Sleeping: a rest in the evening or at night (18:00 to 07:00) sleeps until morning: the hours pass at the sleeping rate,\n--   never more than one tick's worth at a time. Moving wakes the spider (\"Awake before morning\"). The morning (\"Morning, day\n--   N\") keeps a new checkpoint. A rest by day passes no extra time.\n-- * Light: daylight 0 to 1 from the hour; the eyes reach NIGHT_SIGHT of their range in the dark (LIFE-06). The reach comes\n--   from the clock, never from the lighting on the screen.\n--\n-- Growth, moulting and starvation are ported. The passing shadow and notebook remain separate work.\n-- Checked tick by tick against Godot's own loop in tests/life_reference.json (tools/export_life_reference.gd).\n\nlocal LifeClock = require(script.Parent.LifeClock)\nlocal Growth = require(script.Parent.Growth)\n\nlocal LifeLoop = {}\nLifeLoop.__index = LifeLoop\n\n-- The sensor's reach at night, as a share of its daytime reach (jumping spiders hunt by sight, in daylight).\nLifeLoop.NIGHT_SIGHT = 0.3\n-- How long a notice stays on the screen.\nLifeLoop.NOTICE_S = 6.0\n-- After a checkpoint is restored the spider takes a moment to take hold of its surface again; the restored rest is not ended\n-- meanwhile.\nLifeLoop.RESTORE_GRACE_TICKS = 30\n-- Rest restored per second of resting.\nLifeLoop.REST_PER_S = 0.10\nLifeLoop.HUNGRY_AT = 0.25\nLifeLoop.WEAK_AFTER_H = 24\nLifeLoop.STARVE_AFTER_H = 48\n\n-- What the loop needs to know about the spider this tick.\nexport type Spider = {\n\tinRetreat: boolean, -- inside the silk-lined crack\n\tattached: boolean, -- on a surface (not in the air, not on the line)\n\tstill: boolean, -- not walking or sliding (Godot: intent under 0.01, speed under 0.15)\n\tholding: boolean, -- holds prey (caught, struggling or being eaten)\n\tfeeding: boolean, -- eating right now\n position: Vector3?, -- old skin location; live client always supplies it\n}\nexport type CheckpointResult = { ok: boolean, message: string }\nexport type Event = { kind: string, day: number? }\n\n-- `needs` is the NeedsModel whose hours this loop reports; `save` keeps the retreat checkpoint (nil: none is kept).\nfunction LifeLoop.new(needs: any, save: (() -> CheckpointResult)?): any\n\tlocal self = setmetatable({\n\t\tclock = LifeClock.new(), needs = needs, save = save,\n  growth = Growth.new(), grantedSeen = needs.grantedTotal,\n\t\tmode = \"main\", rules = \"standard\", lifeOver = false,\n\t\tresting = false, restSeconds = 0.0, asleep = false, elapsed = 0.0,\n\t\tcheckpointDue = false, checkpointResult = nil :: CheckpointResult?, checkpoints = 0,\n\t\tnotice = \"\", noticeSeconds = 0.0, morningText = \"\",\n\t\trestoreGrace = 0, events = {} :: { Event },\n\t\tdaylight = 1.0, rangeScale = 1.0,\n\t}, LifeLoop)\n\tself:applyLight()\n\treturn self\nend\n\n-- Live survival pacing; frozen-reference controllers keep their original 24/48h.\nfunction LifeLoop.useGameRules(self: any)\n self.weakAfterH=6;self.starveAfterH=12\nend\n\nfunction LifeLoop.canRest(_self: any, s: Spider): boolean\n\treturn s.inRetreat and not s.holding and not s.feeding and s.attached and s.still\nend\n\nfunction LifeLoop.showNotice(self: any, text: string)\n\tself.notice = text\n\tself.noticeSeconds = LifeLoop.NOTICE_S\nend\n\nfunction LifeLoop._emit(self: any, kind: string, day: number?)\n\ttable.insert(self.events, { kind = kind, day = day })\nend\n\n-- The events since the last call: rest_started, rest_ended, slept, woke (with the day), checkpoint.\nfunction LifeLoop.drainEvents(self: any): { Event }\n\tlocal e = self.events\n\tself.events = {}\n\treturn e\nend\n\nfunction LifeLoop.requestRest(self: any, s: Spider): boolean\n\tif not self:canRest(s) then\n\t\treturn false\n\tend\n\tself.resting = true\n\tself.checkpointDue = true\n\tself:_emit(\"rest_started\")\n\treturn true\nend\n\nfunction LifeLoop.stopRest(self: any)\n\tif self.resting and not self.growth:isMoulting() then\n\t\tself.resting = false\n\t\tself:_emit(\"rest_ended\")\n\tend\nend\n\n-- The light of the hour, and how far the spider's eyes reach in it.\nfunction LifeLoop.applyLight(self: any)\n\tself.daylight = self.clock:daylight()\n\tself.rangeScale = LifeLoop.NIGHT_SIGHT + (1.0 - LifeLoop.NIGHT_SIGHT) * self.daylight\nend\n\nfunction LifeLoop.tooHungryToSleep(self: any): boolean\n\treturn not self.needs.gentle and self.needs.starvingStreakH >= (self.weakAfterH or LifeLoop.WEAK_AFTER_H)\nend\n\nfunction LifeLoop.starved(self: any): boolean\n\treturn not self.needs.gentle and self.needs.starvingStreakH >= (self.starveAfterH or LifeLoop.STARVE_AFTER_H)\nend\n\nfunction LifeLoop._stepLife(self: any, dt: number, at: Vector3)\n local granted = self.needs.grantedTotal\n -- Live play counts food swallowed, including when the energy reserve is full.\n local food = if self.mealFood ~= nil then self.mealFood else granted-self.grantedSeen\n self.mealFood = nil\n if food > 0 and self.growth:eat(food) then\n  self:showNotice(\"Ready to moult. Rest in the silk-lined crack.\")\n  self:_emit(\"moult_ready\")\n end\n self.grantedSeen = granted\n if self.resting and self.growth:beginMoult() then\n  self:showNotice(\"Moulting in the crack. The spider slowly pulls free of its old skin.\")\n  self:_emit(\"moult_started\")\n end\n local moulting = self.growth:isMoulting()\n local wasAsleep = self.asleep\n\tself.asleep = self.resting and not moulting and (self.clock.sleeping or self.clock:isSleepTime()) and not self:tooHungryToSleep()\n\tlocal hours = if moulting then self.clock:advanceMoult(dt) else self.clock:advance(dt, self.asleep)\n local what = self.growth:passHours(hours,at)\n if what == \"moulted\" then\n  self.checkpointDue=true\n  self.morningText=\"Moulted: now a \"..self.growth:stageName()..\". The new skin is soft for a while.\"\n  self:showNotice(self.morningText)\n  self:_emit(\"moulted\")\n elseif what == \"hardened\" then\n  self:showNotice(\"The new skin has hardened. Full-length jumps again.\")\n end\n\tif self.asleep and not self.clock.sleeping then\n\t\t-- The morning came during this tick: awake, still resting in the crack. The new day keeps a checkpoint.\n\t\tself.asleep = false\n\t\tself.checkpointDue = true\n\t\tself.morningText = `Morning, day {self.clock.day}. Rested through the night in the crack.`\n\t\tself:showNotice(self.morningText)\n\t\tself:_emit(\"woke\", self.clock.day)\n\telseif wasAsleep and not self.asleep then\n\t\tself:showNotice(`Awake before morning: it is still {self.clock:partOfDay()}.`)\n\tend\n\tif self.asleep and not wasAsleep then\n\t\tself:_emit(\"slept\")\n\tend\n\tself.needs:addHours(hours, self.asleep or moulting)\n\tself:applyLight()\nend\n\n-- One fixed tick, after the spider and its meal have moved. `feedPressed` and `cancelPressed` are this tick's fresh presses.\nfunction LifeLoop.step(self: any, dt: number, s: Spider, feedPressed: boolean, cancelPressed: boolean)\n\tself.elapsed += dt\n\tif self.restoreGrace > 0 then\n\t\tself.restoreGrace = if s.attached then 0 else self.restoreGrace - 1\n\tend\n\tif self.resting and not self.growth:isMoulting() and (cancelPressed or feedPressed or (self.restoreGrace == 0 and not self:canRest(s))) then\n\t\tself:stopRest()\n\telseif feedPressed and not self.growth:isMoulting() and not s.holding and not s.feeding then\n\t\tself:requestRest(s)\n\tend\n\tif self.resting then\n\t\tself.restSeconds += dt\n\t\tself.needs:restoreRest(dt * LifeLoop.REST_PER_S)\n\tend\n\tself:_stepLife(dt, s.position or Vector3.zero)\n\tif self:starved() and not self.lifeOver and not self.growth:isMoulting() then\n\t\tself.lifeOver = true\n\t\tself:_emit(\"starved\")\n\tend\n\tif self.noticeSeconds > 0.0 then\n\t\tself.noticeSeconds = math.max(0.0, self.noticeSeconds - dt)\n\tend\n\tif self.checkpointDue then\n\t\tself.checkpointDue = false\n\t\tif self.resting then\n\t\t\tself:makeCheckpoint()\n\t\tend\n\tend\nend\n\n-- The retreat checkpoint, now (the end of a tick).\nfunction LifeLoop.makeCheckpoint(self: any): CheckpointResult\n\tlocal result: CheckpointResult = if self.save then self.save() else { ok = false, message = \"There is nowhere to keep a rest\" }\n\tself.checkpointResult = result\n\tif result.ok then\n\t\tself.checkpoints += 1\n\t\tself:showNotice(result.message)\n\telse\n\t\tself:showNotice(\"Resting, but this is not kept as your last rest. \" .. result.message .. \".\") -- (ROBLOX-92: the message is in the game's words, LifeText.restRefusal)\n\tend\n\tif self.morningText ~= \"\" then\n\t\tself:showNotice(self.morningText .. \"\\n\" .. self.notice)\n\t\tself.morningText = \"\"\n\tend\n\tself:_emit(\"checkpoint\")\n\treturn result\nend\n\n-- The loop's part of a checkpoint (Godot's habitat record, with the clock beside it as its \"life\" field).\nfunction LifeLoop.toRecord(self: any): { [string]: any }\n\treturn {\n\t\tretreat_id = \"sill_crevice\", resting = self.resting, rest_seconds = self.restSeconds, elapsed = self.elapsed,\n\t\tlife = self.clock:toRecord(), growth = self.growth:toRecord(),\n\t}\nend\n\nfunction LifeLoop.problems(r: any): { string }\n\tlocal e: { string } = {}\n\tif type(r) ~= \"table\" then\n\t\ttable.insert(e, \"habitat: not a record\")\n\t\treturn e\n\tend\n\tif r.retreat_id ~= \"sill_crevice\" then table.insert(e, \"habitat: not this windowsill's retreat\") end\n\tif type(r.resting) ~= \"boolean\" then table.insert(e, \"habitat: 'resting' is not true or false\") end\n\tfor _, k in { \"rest_seconds\", \"elapsed\" } do\n\t\tlocal v = r[k]\n\t\tif type(v) ~= \"number\" or v ~= v or v < 0 or v == math.huge then table.insert(e, `habitat: '{k}' is not a time`) end\n\tend\n\tif r.growth ~= nil then for _, p in Growth.problems(r.growth) do table.insert(e,p) end end\n for _, p in LifeClock.problems(r.life) do\n\t\ttable.insert(e, p)\n\tend\n\treturn e\nend\n\n-- Restores a record made by toRecord (validated first; false and nothing changed if it is not one). The rest that was going on\n-- goes on; no new checkpoint is owed for it.\nfunction LifeLoop.load(self: any, r: any): boolean\n\tif #LifeLoop.problems(r) > 0 then\n\t\treturn false\n\tend\n\tself.clock:load(r.life)\n self.growth=Growth.new()\n if r.growth then self.growth:load(r.growth) end\n self.grantedSeen=self.needs.grantedTotal\n\tself.resting = r.resting\n\tself.restSeconds = r.rest_seconds\n\tself.elapsed = r.elapsed\n\tself.asleep = false\n\tself.checkpointDue = false\n\tself.morningText = \"\"\n\tself.restoreGrace = LifeLoop.RESTORE_GRACE_TICKS\n\tself:applyLight()\n\tself:showNotice(\"Returned to your last rest: the sill as it was when you rested in the crack. This is a return to the rest, not an exact resume.\")\n\treturn true\nend\n\nreturn LifeLoop\n",10955,3142814520},{"Shared/Life/LifeSession","--!strict\n-- LIFE-19..23: player progress lives outside world checkpoints. Session only until server saves are ported.\nlocal Session = {}\nSession.__index = Session\nSession.SPOTS = { Vector3.new(12,.31,9), Vector3.new(-8,.31,-10), Vector3.new(24,.31,8), Vector3.new(-2,.31,10) }\nfunction Session.new(): any\n\treturn setmetatable({ mode=\"main\", rules=\"standard\", ended=false, summary=nil,\n\t\tdeaths=0, lives={}, finishedMain=false, started=false }, Session)\nend\nfunction Session.begin(self: any, mode: string, easy: boolean): boolean\n\tif mode ~= \"main\" and mode ~= \"free\" then return false end\n\tif mode == \"main\" and easy and not self.finishedMain then return false end\n\tself.mode, self.rules = mode, if mode == \"free\" or easy then \"gentle\" else \"standard\"\n\tself.ended, self.summary, self.started = false, nil, true\n\treturn true\nend\nfunction Session.finishAdult(self: any, stage: number): boolean\n\tif stage ~= 3 or self.mode ~= \"main\" or self.rules ~= \"standard\" or self.finishedMain then return false end\n\tself.finishedMain = true\n\treturn true\nend\nfunction Session.endLife(self: any, cause: string, summary: any): boolean\n\tif self.ended or self.rules == \"gentle\" or (cause ~= \"wasp\" and cause ~= \"starved\" and cause ~= \"rival\" and cause ~= \"night\") then return false end\n\tself.ended, self.deaths = true, self.deaths + 1\n\tself.summary = table.clone(summary)\n\tself.summary.cause, self.summary.mode, self.summary.rules = cause, self.mode, self.rules\n\treturn true\nend\nfunction Session.archive(self: any)\n\tif self.summary then table.insert(self.lives, table.clone(self.summary)) end\n\twhile #self.lives > 30 do table.remove(self.lives,1) end\n\tself.summary = nil\nend\nfunction Session.another(self: any): Vector3?\n\tif not self.ended then return nil end\n\tself:archive()\n\tself.ended, self.started = false, true\n\treturn Session.SPOTS[#self.lives % #Session.SPOTS + 1]\nend\nfunction Session.title(self: any): string\n\treturn if self.mode == \"free\" then \"FREE PLAY\" elseif self.rules == \"gentle\" then \"THE WINDOWSILL (EASY)\" else \"THE WINDOWSILL\"\nend\nreturn Session\n",2048,3086267966},{"Shared/Life/Mating","--!strict\n-- The mating cycle and the new generation (ROBLOX-79). One plain record, life.mating, in LifeLoop's checkpoint graph beside life.mate (the mate's body,\n-- Predator/Mate) and life.generation (how many families the sill has had); nothing here knows the clock, the engine or the player but through the snapshot\n-- the caller hands in, so the CLI tests drive whole cycles. Absent fields mean the old game: a record from before this change restores as stage \"none\",\n-- generation 0, and nothing in it is ever rerolled (the mate's size, the brood and every arrival are pure functions of the world's seed, the day and the\n-- numbers kept in the record).\n--\n-- The cycle, in stages:\n--   none ....... nothing going on. A rest in the crack by a full-grown spider with energy of at least 0.6 sets `ready_day`, the morning of the next 07:00:\n--                from then a mate comes on mornings (Predator/Mate) until the player has courted it.\n--   courted .... the courtship meter is full and the pair are together for the pause (Mate state \"pair\"): the mating scene (ROBLOX-89, Life/MatingScene).\n--   mated ...... the pause is over and the mate is walking off. The next sleep in the crack that reaches the morning makes the egg sac.\n--   sac ........ the morning the sac is there: guard day 1.\n--   guarding ... guard day 2. (Guarding is surviving: nothing in v1 can harm the sac, the wasp and the rival never enter the crack.)\n--   hatched .... the morning after the last guard day: the brood is out. The hatching scene and the ending card belong to the client; carryOn() makes\n--                the next generation when the player takes it.\n-- carryOn: generation += 1, growth back to the first stage, a fresh energy, the day count goes on (it is the clock's), the mating state is none again,\n-- so the cycle can happen again in the next generation.\nlocal Rules = require(script.Parent.Parent.Data.MatingRules)\nlocal Mate = require(script.Parent.Parent.Predator.Mate)\nlocal Growth = require(script.Parent.Growth)\nlocal PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)\n\nlocal Mating = {}\n\nMating.STAGES = { \"none\", \"courted\", \"mated\", \"sac\", \"guarding\", \"hatched\" }\nlocal STAGE: { [string]: boolean } = {}\nfor _, name in Mating.STAGES do STAGE[name] = true end\n\nlocal COUNTERS = { \"ready_day\", \"guard_day\", \"sac_day\", \"hatch_day\", \"brood\", \"mates\", \"visits\", \"visit_day\", \"away_day\", \"drive_offs\" }\n-- ROBLOX-106: the standard rules' counters (courts decided, refusals, rivals that cut in). Optional: a record without them has had none, and normalize leaves them\n-- absent (so a record of the old game is byte for byte what it was); they are made when first needed.\nlocal NATURE_COUNTERS = { \"courts\", \"rejections\", \"cut_ins\" }\n\nlocal function finite(x: any): boolean\n\treturn type(x) == \"number\" and x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal function whole(x: any): boolean\n\treturn finite(x) and x >= 0 and x <= 1e9 and x % 1 == 0\nend\n\nfunction Mating.new(): any\n\treturn {\n\t\tstage = \"none\",\n\t\tready_day = 0, -- the morning (day) from which a mate may come; 0: not yet eligible\n\t\tguard_day = 0, -- 1 or 2 while the sac is guarded\n\t\tsac_day = 0, -- the morning the sac appeared\n\t\thatch_day = 0, hatch_hour = 0.0, brood = 0, -- when the eggs hatched, and how many spiderlings came out\n\t\tmates = 0, visits = 0, visit_day = 0, away_day = 0, drive_offs = 0, -- the mate's bookkeeping: which mate, how many days it has come, the last day it came and left\n\t}\nend\n\n-- Fills any field an older or shorter record does not have (so absent means the old behaviour), in place. Returns the record.\nfunction Mating.normalize(m: any): any\n\tfor _, k in COUNTERS do\n\t\tif m[k] == nil then m[k] = 0 end\n\tend\n\tif m.hatch_hour == nil then m.hatch_hour = 0.0 end\n\tif m.stage == nil then m.stage = \"none\" end\n\treturn m\nend\n\n-- The sex of the played spider: the peacock spider is the male and the ant mimic the female; the first spider has no sex in its design and is the game's\n-- female (its mate is a male, as the rival is). The mate is the opposite.\nfunction Mating.sexOf(appearanceId: string): string\n\tif appearanceId == \"maratus_volans_male\" then return \"male\" end\n\treturn \"female\"\nend\n\n-- Is the spider ready to mate: full-grown (Growth's last stage) and well fed.\nfunction Mating.eligible(growth: any, energy: number): boolean\n\treturn growth ~= nil and growth:isAdult() and energy >= Rules.energyMin - 1e-9\nend\n\n-- The brood: a seeded number of spiderlings, from the world's seed, the family's number and the day the eggs hatched (so a return never rerolls it).\nfunction Mating.broodSize(seed: number, generation: number, day: number): number\n\tlocal g = PreyRandom.new((seed * 83492791 + generation * 19349663 + day * 73856093 + 4093) % 2147483647)\n\tg:next()\n\tg:next()\n\treturn Rules.broodMin + math.floor(g:next() * (Rules.broodMax - Rules.broodMin + 1))\nend\n\n-- Is there an egg sac in the crack to draw: from the morning it is made until the family has carried on (the hatching scene draws it too).\nfunction Mating.hasSac(m: any): boolean\n\treturn m ~= nil and (m.stage == \"sac\" or m.stage == \"guarding\" or m.stage == \"hatched\")\nend\n\n-- The generation of a life (0 for a record that has none).\nfunction Mating.generation(life: any): number\n\treturn if type(life.generation) == \"number\" then life.generation else 0\nend\n\n-- ROBLOX-91: is a full-grown spider at a rest too hungry for a visitor? Only before a cycle has begun (stage none, no morning set) and only when the one thing missing\n-- is the energy: the notice \"Too hungry for a visitor to come\" (MateText) is for that rest, so the gate no longer fails in silence. Asked at the same moment as atRest.\nfunction Mating.tooHungry(life: any): boolean\n\tlocal m = life.mating\n\tif m ~= nil and (m.stage ~= nil and m.stage ~= \"none\" or (m.ready_day or 0) > 0) then return false end\n\tlocal g = life.growth\n\treturn g ~= nil and g:isAdult() and life.needs.energy < Rules.energyMin - 1e-9\nend\n\n-- ROBLOX-91: the protections of a new life (no rival or wasp on the first day, none before the first meal) belong to a generation, not to the sill's day counter and\n-- the meals of every family before: the day before this generation began (0 for the first) and its own count of meals, given the total finished so far.\nfunction Mating.grace(life: any, mealsFinished: number): (number, number)\n\tlocal base = if type(life.mealsBase) == \"number\" then life.mealsBase else 0\n\treturn if type(life.born) == \"number\" then life.born else 0, math.max(0, mealsFinished - base)\nend\n\n-- The day of the 07:00 morning the clock is in (the hours before it belong to the day before).\nlocal function morningOf(day: number, hour: number): number\n\treturn if hour >= Rules.arriveHour then day else day - 1\nend\n\n-- Called when the spider rests in the crack (the caller makes it before the rest's checkpoint, so the checkpoint has it): a full-grown, well-fed spider\n-- makes the next 07:00 the morning from which a mate comes. It sets and never clears, and does nothing during a cycle already going. Returns whether it set it.\nfunction Mating.atRest(life: any, day: number, hour: number): boolean\n\tlocal m = Mating.normalize(life.mating or Mating.new())\n\tlife.mating = m\n\tif m.stage ~= \"none\" or m.ready_day > 0 then return false end\n\tif not Mating.eligible(life.growth, life.needs.energy) then return false end\n\tm.ready_day = if hour >= Rules.arriveHour then day + 1 else day\n\treturn true\nend\n\n-- A night's sleep in the crack reached the morning of `day` (LifeLoop's \"woke\"): after mating, that sleep made the egg sac. Returns \"sac\" or \"\".\nfunction Mating.woke(life: any, day: number): string\n\tlocal m = Mating.normalize(life.mating or Mating.new())\n\tlife.mating = m\n\tif m.stage ~= \"mated\" then return \"\" end\n\tm.stage, m.sac_day, m.guard_day = \"sac\", day, 1\n\treturn \"sac\"\nend\n\n-- ROBLOX-106: a draw of its own for the mating cycle's standard rules: the world's seed, the mate's number and visit, and a counter (the courts so far) and a salt.\nlocal function natureStream(seed: number, m: any, n: number, salt: number): any\n\treturn PreyRandom.mixed(seed, m.mates or 0, m.visits or 0, n, salt)\nend\n\n-- ROBLOX-106: the spider's condition for a mate, 0 to 1, from its reserve (MatingRules.game).\nfunction Mating.condition(energy: number): number\n\tlocal g = Rules.game\n\treturn math.clamp((energy - g.energyLow) / (g.energyFull - g.energyLow), g.conditionFloor, 1)\nend\n\n-- ROBLOX-106: the chance the mate accepts this court now (base x condition x quality), and what weighed most against it: \"thin\" or \"clumsy\", or \"choosy\" when both\n-- are good (at least `fairAt`) and the refusal is the mate's own (the base's share): the words never blame a court that was not at fault.\nfunction Mating.acceptChance(mate: any, energy: number): (number, string)\n\tlocal c, q = Mating.condition(energy), Mate.quality(mate)\n\tlocal why = if math.min(c, q) >= Rules.game.fairAt then \"choosy\" elseif c < q then \"thin\" else \"clumsy\"\n\treturn Rules.game.base * c * q, why\nend\n\n-- ROBLOX-106: the mate decides on a full meter (the standard rules). Returns whether it accepts and, refused, why. Counts the court.\nfunction Mating.decide(life: any, mate: any, s: any): (boolean, string)\n\tlocal m = life.mating\n\tlocal n = m.courts or 0\n\tm.courts = n + 1\n\tlocal p, why = Mating.acceptChance(mate, life.needs.energy)\n\treturn natureStream(s.seed or 0, m, n, 7):next() < p, why\nend\n\n-- ROBLOX-106: the decision on a full meter, played out: refused, the mate walks off for the day and the event \"rejected_thin\", \"rejected_clumsy\" or\n-- \"rejected_choosy\" is added.\nfunction Mating.accepts(life: any, mate: any, s: any, events: { string }): boolean\n\tlocal ok, why = Mating.decide(life, mate, s)\n\tif ok then return true end\n\tlocal m = life.mating\n\tMate.refuse(mate, \"rejected\")\n\tm.rejections = (m.rejections or 0) + 1\n\tm.away_day = s.day\n\ttable.insert(events, \"rejected_\" .. why)\n\treturn false\nend\n\n-- ROBLOX-106: a new visit's rival: whether the rival will cut in on today's court, and at what level of the meter (nil: it will not).\nfunction Mating.cutLevel(seed: number, m: any): number?\n\tlocal g = Rules.game\n\tlocal r = natureStream(seed, m, 0, 13)\n\tif r:next() >= g.cutChance then return nil end\n\treturn g.cutLevel[1] + (g.cutLevel[2] - g.cutLevel[1]) * r:next()\nend\n\n-- One fixed tick of the whole cycle. `s` is the player's snapshot (see Predator/Mate.step) with day, hour, seed and `sex`, `needsDance`, `dancing`. Returns\n-- the events of the tick, in order: \"arrived\" (with \"new_mate\" before it when it is another mate), \"noticed\", \"driven\", \"courted\", \"mated\", \"gone\",\n-- \"guard_day\" (the second guard day began) and \"hatched\"; in the standard rules (ROBLOX-106) \"rejected_thin\", \"rejected_clumsy\" or \"rejected_choosy\" for a refused court and \"cut\" for\n-- a rival cutting in. `s.rivalThreat` (the rival is winding up or lunging, ROBLOX-91) turns \"courted\" into \"courted\", \"mated\".\nfunction Mating.tick(life: any, dt: number, s: any): { string }\n\tlocal events: { string } = {}\n\tlocal m = Mating.normalize(life.mating or Mating.new())\n\tlife.mating = m\n\tlocal mate = life.mate\n\tif mate == nil then\n\t\tmate = Mate.new()\n\t\tlife.mate = mate\n\tend\n\t-- The guard days, by the clock: the morning of the 07:00 the sac was made is day 1.\n\tif (m.stage == \"sac\" or m.stage == \"guarding\") and m.sac_day > 0 then\n\t\tlocal d = morningOf(s.day, s.hour) - m.sac_day + 1\n\t\tif d > Rules.guardDays and s.hour >= Rules.arriveHour then\n\t\t\tm.stage, m.hatch_day, m.hatch_hour = \"hatched\", s.day, s.hour\n\t\t\tm.brood = Mating.broodSize(s.seed or 0, Mating.generation(life), s.day)\n\t\t\ttable.insert(events, \"hatched\")\n\t\telseif d >= 2 and m.guard_day < 2 then\n\t\t\tm.stage, m.guard_day = \"guarding\", math.min(d, Rules.guardDays)\n\t\t\ttable.insert(events, \"guard_day\")\n\t\tend\n\tend\n\t-- The mate.\n\ts.mayArrive = m.stage == \"none\" and m.ready_day > 0 and s.day >= m.ready_day and s.day > m.away_day\n\tlocal event = Mate.step(mate, dt, s)\n\tif event == \"arrived\" then\n\t\t-- One mate at a time, for at most visitsMax mornings; then another one.\n\t\tif m.mates == 0 or m.visits >= Rules.visitsMax then\n\t\t\tm.mates += 1\n\t\t\tm.visits = 0\n\t\t\ttable.insert(events, \"new_mate\")\n\t\tend\n\t\tm.visits += 1\n\t\tm.visit_day = s.day\n\t\tmate.sex = Mate.opposite(s.sex or \"female\")\n\t\tmate.scale = Mate.scaleFor(s.seed or 0, m.mates, mate.sex)\n\t\tif s.nature == true then mate.cut = Mating.cutLevel(s.seed or 0, m) end -- (ROBLOX-106)\n\t\ttable.insert(events, \"arrived\")\n\telseif event == \"courted\" and s.nature == true and not Mating.accepts(life, mate, s, events) then\n\t\t-- (ROBLOX-106: refused; Mating.accepts has sent the mate off and said why)\n\telseif event == \"courted\" then\n\t\tm.stage = \"courted\"\n\t\ttable.insert(events, \"courted\")\n\t\t-- ROBLOX-91: the rival is already winding up or lunging as the meter fills (the caller says so in `s.rivalThreat`): the scene would hold the player in the open, so it is skipped\n\t\t-- at once, as for a wasp's visit, and they have mated.\n\t\tif s.rivalThreat == true and Mate.skip(mate, true) == \"mated\" then\n\t\t\tm.stage = \"mated\"\n\t\t\ttable.insert(events, \"mated\")\n\t\tend\n\telseif event == \"mated\" then\n\t\tm.stage = \"mated\"\n\t\ttable.insert(events, \"mated\")\n\telseif event == \"driven\" then\n\t\tm.drive_offs += 1\n\t\tm.away_day = s.day\n\t\ttable.insert(events, \"driven\")\n\telseif event == \"gone\" then\n\t\tm.away_day = s.day\n\t\ttable.insert(events, \"gone\")\n\telseif event ~= \"\" then\n\t\ttable.insert(events, event)\n\tend\n\t-- ROBLOX-106: the rival cuts in when the meter passes the visit's level, if it is free on the sill and near enough to the mate then.\n\tif s.nature == true and mate.cut ~= nil and Mate.courtable(mate) and mate.meter >= mate.cut then\n\t\tlocal rival = s.rival\n\t\tif rival ~= nil and rival.position ~= nil and (rival.position - mate.position).Magnitude <= Rules.game.cutWu then\n\t\t\tMate.refuse(mate, \"cut\")\n\t\t\tm.cut_ins = (m.cut_ins or 0) + 1\n\t\t\tm.away_day = s.day\n\t\t\ttable.insert(events, \"cut\")\n\t\tend\n\tend\n\treturn events\nend\n\n-- The player skips the mating scene (ROBLOX-89; the client allows it after Rules.skipAfter seconds of it, `force` for a wasp visit): a pause cut short is the\n-- mating at once, the same event Mating.tick reports when the pause ends by itself. Returns the events: {\"mated\"} or {}.\nfunction Mating.skip(life: any, force: boolean?): { string }\n\tlocal mate = life.mate\n\tif mate == nil then return {} end\n\tif Mate.skip(mate, force) ~= \"mated\" then return {} end\n\tlocal m = Mating.normalize(life.mating or Mating.new())\n\tlife.mating = m\n\tm.stage = \"mated\"\n\treturn { \"mated\" }\nend\n\n-- The next generation (after the hatching scene and the ending card). The spider is a spiderling again: the first growth stage and a fresh energy, rested;\n-- the days of the sill go on; the mating state and the mate are new, so the cycle can happen again. Notebook, appearance and the world are not touched.\n-- Returns the new generation number and the day it hatched. ROBLOX-91: it also starts the generation's grace (Mating.grace): the hatching day is its first day, and\n-- `mealsFinished` (the meals eaten so far by every family) is the count its first meal is measured from.\nfunction Mating.carryOn(life: any, needs: any, mealsFinished: number?): (number, number)\n\tlocal m = Mating.normalize(life.mating or Mating.new())\n\tlocal day = m.hatch_day\n\tlocal generation = Mating.generation(life) + 1\n\tlife.generation = generation\n\tlife.born = math.max(0, day - 1)\n\tlife.mealsBase = math.max(0, mealsFinished or 0)\n\tlife.growth = Growth.new()\n\tlife.grantedSeen = needs.grantedTotal\n\tlife.mealFood = nil\n\tlife.lifeOver = false\n\tneeds.energy = Rules.freshEnergy\n\tneeds.rest = 1.0\n\tneeds.starvingHours, needs.starvingStreakH = 0.0, 0.0\n\tlife.mating = Mating.new()\n\tlife.mate = Mate.new()\n\treturn generation, day\nend\n\n-- What is wrong with a mating record (an empty list for a good one; nil is a good one: a life with no cycle yet). Absent fields are good.\nfunction Mating.problems(m: any): { string }\n\tlocal e: { string } = {}\n\tlocal function bad(t: string) table.insert(e, \"mating: \" .. t) end\n\tif m == nil then return e end\n\tif type(m) ~= \"table\" then bad(\"not a record\"); return e end\n\tif m.stage ~= nil and (type(m.stage) ~= \"string\" or not STAGE[m.stage]) then bad(\"unknown stage\") end\n\tfor _, k in COUNTERS do\n\t\tif m[k] ~= nil and not whole(m[k]) then bad(`'{k}' is not a whole number`) end\n\tend\n\tfor _, k in NATURE_COUNTERS do\n\t\tif m[k] ~= nil and not whole(m[k]) then bad(`'{k}' is not a whole number`) end\n\tend\n\tif m.hatch_hour ~= nil and (not finite(m.hatch_hour) or m.hatch_hour < 0 or m.hatch_hour >= 24) then bad(\"the hatch hour is not in [0, 24)\") end\n\tif #e > 0 then return e end\n\tif (m.visits or 0) > Rules.visitsMax then bad(\"a mate has come on more days than it may\") end\n\tif (m.guard_day or 0) > Rules.guardDays then bad(\"more guard days than there are\") end\n\tif (m.brood or 0) > 64 then bad(\"a brood that large\") end\n\tlocal stage = m.stage or \"none\"\n\tif stage == \"sac\" and ((m.sac_day or 0) < 1 or m.guard_day ~= 1) then bad(\"a new sac with no morning, or not on its first guard day\") end\n\tif stage == \"guarding\" and ((m.sac_day or 0) < 1 or (m.guard_day or 0) < 2) then bad(\"a guarded sac with no morning, or before its second guard day\") end\n\tif stage == \"hatched\" and ((m.hatch_day or 0) < 1 or (m.brood or 0) < 1) then bad(\"a hatching with no day or no brood\") end\n\treturn e\nend\n\n-- The checks that need the mate beside the record: a mate on the sill belongs to a cycle that wants one, and the pause together is the stage courted.\nfunction Mating.problemsWith(m: any, mate: any): { string }\n\tlocal e = Mating.problems(m)\n\tif #e > 0 or mate == nil then return e end\n\tlocal stage = if m ~= nil and m.stage ~= nil then m.stage else \"none\"\n\tif mate.state ~= \"away\" and stage ~= \"none\" and stage ~= \"courted\" and stage ~= \"mated\" then\n\t\ttable.insert(e, \"mating: a mate is on the sill during the sac and the guarding\")\n\tend\n\tif stage == \"courted\" and mate.state ~= \"pair\" then table.insert(e, \"mating: courted, but the pair are not together\") end\n\tif mate.state == \"pair\" and stage ~= \"courted\" then table.insert(e, \"mating: together, but not courted\") end\n\tif mate.scene == true and stage ~= \"courted\" and stage ~= \"mated\" then table.insert(e, \"mating: a mating scene, but no mating\") end\n\treturn e\nend\n\nreturn Mating\n",18174,882939508},{"Shared/Life/MatingScene","--!strict\n-- The mating scene (ROBLOX-89): what happens between \"the meter is full\" and \"they part\", as a pure plan. About fifteen seconds, in four beats, with a camera that\n-- eases into a two-shot and makes a slow quarter-orbit over it. Nothing here knows the engine, the clock or the player: it is a function of a seeded plan and the\n-- scene's own time `t` (the pair's pause in the simulation, Predator/Mate.sceneTime, which a wasp visit holds as it holds every timer of the mate), so a scene seen\n-- again is the same scene, a restored world cannot reroll it, and tests/mating.luau checks it without Roblox. The client draws it (camera, cues to both rigs,\n-- captions, the locked controls) and the simulation owns the parting: Life/Mating.tick ends the pause, Life/Mating.skip cuts it short.\n--\n-- The beats (seconds): 0 to 3 she turns to face him (the female turns toward the male: the player's spider as the female, the mate as the female for a peacock player);\n-- 3 to 7 the two touch palps and front legs (a drawn pose through rig:cue(\"meet\") on both rigs: a gentle reach, no more); 7 to 11 they settle together, still, the\n-- abdomens breathing (rig:cue(\"settle\")); 11 to 15 one goes: the male rises and walks off toward the sill's edge and the sill is the player's again, or, for a male\n-- player, the female turns away and settles and he goes on (she stays). The game is for children and shows nothing but this.\n--\n-- The controls are locked for the scene; a skip (a jump or cancel) is allowed from `skipAfter` seconds on, and the scene never outlasts `SECONDS`. Reduced Motion: a\n-- static two-shot (no orbit), the reach and the settle held as poses, the turn away at once.\nlocal Rules = require(script.Parent.Parent.Data.MatingRules)\nlocal PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)\n\nlocal MatingScene = {}\n\nMatingScene.SECONDS = Rules.sceneSeconds\nMatingScene.SKIP_AFTER = Rules.skipAfter\nMatingScene.EASE_SECONDS = 0.8 -- the camera's ease into the two-shot (and out of it after the scene)\nMatingScene.BEATS = {\n\t{ name = \"turn\", from = 0.0, to = 3.0 },\n\t{ name = \"touch\", from = 3.0, to = 7.0 },\n\t{ name = \"settle\", from = 7.0, to = 11.0 },\n\t{ name = \"depart\", from = 11.0, to = 15.0 },\n}\n-- The cues to the rigs. \"meet\" for the touch beat (4 s); \"settle\" from the third beat: the male's for the beat (it rises as it goes) and the female's through the\n-- last (she stays). Seconds are the cue's whole length including its ease in and out.\nMatingScene.MEET_AT, MatingScene.MEET_SECONDS = 3.0, 4.0\nMatingScene.SETTLE_AT = 7.0\nMatingScene.SETTLE_SECONDS = { male = 4.0, female = 8.0 }\n-- The quarter-orbit of the camera about the pair: the sweep, centred on the view from the side (both spiders side by side, never one behind the other).\nMatingScene.ORBIT_DEG = 90.0\n-- The camera's distance from the pair's middle: at least this, or the pair's separation times SEP_K plus SEP_ADD (studs); and the height of the middle's mark above the\n-- surface the pair stand on.\nMatingScene.MIN_DISTANCE, MatingScene.SEP_K, MatingScene.SEP_ADD, MatingScene.LIFT = 4.2, 1.8, 2.6, 0.5\n-- The female mate (a male player) turns away from the player in the last beat: how far and when.\nMatingScene.TURN_AWAY_DEG, MatingScene.TURN_AWAY_AT, MatingScene.TURN_AWAY_SECONDS = 110.0, 11.0, 1.5\n\nexport type Plan = {\n\tseed: number, mateNo: number, day: number,\n\tplayerSex: string, mateSex: string,\n\tdir: number, -- +1 or -1: which way the camera sweeps round the pair\n\tside: number, -- +1 or -1: which side of the pair it starts on\n\tjitterDeg: number, -- the sweep's centre, a few degrees off the side view\n\televationDeg: number, -- the camera's height above the pair's plane (slightly above)\n\tdistanceK: number, -- about 1\n\tturnSign: number, -- +1 or -1: which way the female mate turns away\n}\n\nexport type Pose = {\n\tt: number, beat: string, locked: boolean, canSkip: boolean,\n\torbit: number, -- radians: the camera's turn about the pair from the side view\n\tturnAway: number, -- 0..1: how far the female mate has turned away (0 for a male mate)\n\tover: boolean,\n}\n\nexport type Shot = { focus: Vector3, dir: Vector3, distance: number, up: Vector3, orbit: number, elevation: number }\n\nlocal function smooth(x: number): number\n\tlocal c = math.clamp(x, 0, 1)\n\treturn c * c * (3 - 2 * c)\nend\n\nlocal function sexOpposite(sex: string): string\n\treturn if sex == \"male\" then \"female\" else \"male\"\nend\n\n-- The seeded plan of one scene: from the world's seed, the mate's number (Life/Mating's `mates`) and the day. The same mate on the same day is the same scene on\n-- any return (nothing in it is saved: it is a function of numbers that are).\nfunction MatingScene.plan(seed: number, mateNo: number, day: number, playerSex: string): Plan\n\tlocal g = PreyRandom.new((seed * 19349663 + mateNo * 83492791 + day * 73856093 + 7727) % 2147483647)\n\tg:next()\n\tg:next()\n\tlocal function draw(lo: number, hi: number): number return lo + (hi - lo) * g:next() end\n\tlocal function sign(): number return if g:next() < 0.5 then -1 else 1 end\n\tlocal plan: Plan = {\n\t\tseed = seed, mateNo = mateNo, day = day,\n\t\tplayerSex = playerSex, mateSex = sexOpposite(playerSex),\n\t\tdir = sign(), side = sign(), jitterDeg = draw(-8, 8), elevationDeg = draw(28, 36), distanceK = draw(0.95, 1.05), turnSign = sign(),\n\t}\n\treturn plan\nend\n\n-- The beat at scene time `t`: \"turn\", \"touch\", \"settle\", \"depart\", or \"over\" once the scene is done (and \"\" before it).\nfunction MatingScene.beat(t: number): string\n\tif t < 0 then return \"\" end\n\tfor _, b in MatingScene.BEATS do\n\t\tif t < b.to then return b.name end\n\tend\n\treturn \"over\"\nend\n\n-- Whether the controls are still the scene's.\nfunction MatingScene.locked(t: number): boolean\n\treturn t >= 0 and t < MatingScene.SECONDS\nend\n\n-- Whether a skip is allowed at `t` (after SKIP_AFTER seconds, and while the scene plays).\nfunction MatingScene.canSkip(t: number): boolean\n\treturn t >= MatingScene.SKIP_AFTER - 1e-9 and t < MatingScene.SECONDS\nend\n\n-- The cues that fall due as the scene's clock passes from `from` (exclusive) to `to` (inclusive): { { name, seconds = { male, female } } }. The first call of a\n-- scene is from -1, so a scene entered late (a restored world) gives the cues it has already passed all at once.\nfunction MatingScene.cues(from: number, to: number): { { name: string, at: number, seconds: { male: number, female: number } } }\n\tlocal out = {}\n\tif from < MatingScene.MEET_AT and to >= MatingScene.MEET_AT then\n\t\ttable.insert(out, { name = \"meet\", at = MatingScene.MEET_AT, seconds = { male = MatingScene.MEET_SECONDS, female = MatingScene.MEET_SECONDS } })\n\tend\n\tif from < MatingScene.SETTLE_AT and to >= MatingScene.SETTLE_AT then\n\t\ttable.insert(out, { name = \"settle\", at = MatingScene.SETTLE_AT, seconds = { male = MatingScene.SETTLE_SECONDS.male, female = MatingScene.SETTLE_SECONDS.female } })\n\tend\n\treturn out\nend\n\n-- The camera's turn about the pair at `t`, radians from the side view: the sweep of ORBIT_DEG centred a few degrees off it (`jitterDeg`), one way or the other\n-- (`dir`), slow at the ends; under Reduced Motion none (the centre of the sweep, held).\nfunction MatingScene.orbit(plan: Plan, t: number, reduced: boolean): number\n\tlocal centre = math.rad(plan.jitterDeg)\n\tif reduced then return centre end\n\tlocal u = smooth(t / MatingScene.SECONDS)\n\treturn centre + plan.dir * math.rad(MatingScene.ORBIT_DEG) * (u - 0.5)\nend\n\n-- The female mate's turn away from the player, 0..1 (only when the mate is the female): from TURN_AWAY_AT over TURN_AWAY_SECONDS, at once under Reduced Motion.\nfunction MatingScene.turnAway(plan: Plan, t: number, reduced: boolean): number\n\tif plan.mateSex ~= \"female\" or t < MatingScene.TURN_AWAY_AT then return 0 end\n\tif reduced then return 1 end\n\treturn smooth((t - MatingScene.TURN_AWAY_AT) / MatingScene.TURN_AWAY_SECONDS)\nend\n\nfunction MatingScene.pose(plan: Plan, t: number, reduced: boolean): Pose\n\treturn {\n\t\tt = t, beat = MatingScene.beat(t), locked = MatingScene.locked(t), canSkip = MatingScene.canSkip(t),\n\t\torbit = MatingScene.orbit(plan, t, reduced), turnAway = MatingScene.turnAway(plan, t, reduced), over = t >= MatingScene.SECONDS,\n\t}\nend\n\n-- The two-shot at `t` for the spiders at `a` and `b` standing on a surface whose normal is `up`: the point the camera looks at (the pair's middle, a little up from\n-- the surface), the unit direction from it to the camera (slightly above the pair's plane, at the orbit's angle from the side view), and the distance. Framing the\n-- pair side by side at any separation: the distance grows with it. Pure; the camera (Client/SpiderCamera) turns it into a placed view, shortening it if something\n-- stands in the way.\nfunction MatingScene.shot(plan: Plan, t: number, reduced: boolean, a: Vector3, b: Vector3, up: Vector3): Shot\n\tlocal upU = if up.Magnitude > 1e-6 then up.Unit else Vector3.yAxis\n\tlocal delta = b - a\n\tlocal flat = delta - upU * delta:Dot(upU)\n\tlocal sep = flat.Magnitude\n\tlocal axis = if sep > 1e-4 then flat.Unit else (if math.abs(upU.Y) < 0.9 then upU:Cross(Vector3.yAxis).Unit else Vector3.xAxis)\n\tlocal perp = axis:Cross(upU) * plan.side -- the side of the pair, in the plane they stand on\n\tlocal orbit = MatingScene.orbit(plan, t, reduced)\n\tlocal turned = CFrame.fromAxisAngle(upU, orbit):VectorToWorldSpace(perp).Unit\n\tlocal e = math.rad(plan.elevationDeg)\n\tlocal dir = (turned * math.cos(e) + upU * math.sin(e)).Unit\n\tlocal focus = (a + b) * 0.5 + upU * MatingScene.LIFT\n\tlocal distance = math.max(MatingScene.MIN_DISTANCE, sep * MatingScene.SEP_K + MatingScene.SEP_ADD) * plan.distanceK\n\treturn { focus = focus, dir = dir, distance = distance, up = upU, orbit = orbit, elevation = e }\nend\n\nreturn MatingScene\n",9653,1586724257},{"Shared/Life/Nature","--!strict\n-- Nature's rules (ROBLOX-106, W4 of docs/OPEN_WORLD_DESIGN.md; the design called it \"ROBLOX-97\", a number never used). Nathan: \"Normal mode should feel like it doesn't\n-- want you to survive\"; \"movement expends more energy\"; \"being perched up high avoiding predators and hiding under leaves\"; \"scared I won't make it home at night\".\n-- The game's own rules, in the standard rules (Normal) only: Easy and Free play keep ROBLOX-91's gentleness untouched, and nothing here touches Godot's defaults (the\n-- needs, the wasp's and the rival's numbers, the clock's rates, perception). Pure: the client hands in what it knows each tick (Client/SpiderClient), the CLI tests\n-- drive it alone (tests/nature.luau).\n--\n-- * Movement (`Nature.moved`): which movement the spider made this tick, for NeedsModel.move (NeedsModel.game.moveCost): walking on a surface, a jump as it leaves\n--   the surface, letting down or reeling in on the line. Standing, hanging still and resting cost nothing extra.\n-- * Cover (`Nature.cover`): how much faster or slower a predator's notice grows: halved under a leaf (something solid overhead within `coverWu`, a ray straight up\n--   from the spider) and halved again when still; doubled when moving in the open. The wasp's notice (WaspDirector, `spider.cover`) and the rival's\n--   (RivalSpider, `s.noticeScale`) take it; their own rules are as they were.\n-- * The night (`Nature.night`): out of every retreat after dark anywhere but the sill (the nursery, behind the glass), the ground hunters pass three times a night at\n--   hours drawn from the world's seed and the night; a spider exposed when one passes is found (death: the card says so) or, if the draw spares it, passes a cold\n--   night and is slow until the morning warms. A spider in any retreat, or on the sill, is never drawn against. Dusk is told by the light alone: no notice comes\n--   before it. Restores never reroll: the hours and the draws are pure functions of the seed, the night and the pass, and a return to a rest starts the night's\n--   count again from the restored hour (the passes already behind it are behind it; the spider was in its retreat for them).\nlocal PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)\n\nlocal Nature = {}\n\nNature.game = {\n\t-- Cover: the ray straight up that finds a leaf (or anything solid) over the spider, and the factors.\n\tcoverWu = 6.0, covered = 0.5, still = 0.5, openMoving = 2.0,\n\t-- The night: the passes' windows in hours of the night (an hour after midnight is 24 + it), the chance a pass finds an exposed spider, and the cold morning.\n\tpasses = { { 20.5, 23.5 }, { 23.5, 26.5 }, { 26.5, 29.5 } },\n\tfoundChance = 0.25,\n\tcoldUntilH = 10.0, -- the cold morning lasts until this hour of the day after the night\n\tcoldSpeed = 0.6, -- the walk's speed while it lasts\n\tnightFromH = 18.0, -- (LifeClock.EVENING_H: an hour from here belongs to the night of its own day)\n\tmorningH = 7.0, -- (LifeClock.WAKE_H: an hour before this belongs to the night of the day before)\n}\n\nlocal function finite(x: any): boolean\n\treturn type(x) == \"number\" and x == x and x ~= math.huge and x ~= -math.huge\nend\n\n-- ------------------------------------------------------------------------------------------------------------------- cover\n\n-- The factor on a predator's notice for a spider `covered` (something overhead) and `still`. 1 is the old rule; the standard rules only (the caller asks).\nfunction Nature.cover(covered: boolean, still: boolean): number\n\tlocal g = Nature.game\n\tif covered or still then\n\t\treturn (if covered then g.covered else 1.0) * (if still then g.still else 1.0)\n\tend\n\treturn g.openMoving\nend\n\n-- Whether something solid is over the point within the cover ray. `ray(from, dir)` is the world's cast (nil: nothing).\nfunction Nature.overhead(at: Vector3, ray: (Vector3, Vector3) -> any): boolean\n\treturn ray(at + Vector3.new(0, 0.05, 0), Vector3.new(0, Nature.game.coverWu, 0)) ~= nil\nend\n\n-- ------------------------------------------------------------------------------------------------------------------- movement\n\n-- What the spider did this tick, from the motor (its mode, whether it walks, whether it was dropped, its line's length) and the last tick's `st` (kept by the\n-- caller, updated here): \"jump\" on the tick it leaves a surface by a jump or hop, \"walk\" while it walks a surface, \"line\" while the line's length changes\n-- (letting down, reeling in), else \"\". A drop off an edge onto the line is not a jump; a seized spider does nothing.\nfunction Nature.moved(st: { [string]: any }, mode: string, moving: boolean, dropped: boolean, seized: boolean, onLine: boolean, lineLength: number?): string\n\tlocal was = st.mode\n\tlocal rest = st.rest\n\tst.mode = mode\n\tst.rest = if onLine then lineLength else nil\n\tif seized then return \"\" end\n\tif mode == \"air\" and was == \"attached\" and not dropped then return \"jump\" end\n\tif mode == \"attached\" and moving then return \"walk\" end\n\tif onLine and lineLength ~= nil and rest ~= nil and math.abs(lineLength - rest) > 1e-5 then return \"line\" end\n\treturn \"\"\nend\n\n-- ------------------------------------------------------------------------------------------------------------------- the night\n\n-- The night an hour belongs to (the day it began), and the hour counted in that night (after midnight, 24 + the hour); nil by day.\nfunction Nature.nightOf(day: number, hour: number): (number?, number)\n\tlocal g = Nature.game\n\tif hour >= g.nightFromH then return day, hour end\n\tif hour < g.morningH then return day - 1, hour + 24 end\n\treturn nil, hour\nend\n\n-- One stream a night (the world's seed and the night), drawn in order: the first pass's hour, whether it finds, the second's hour, ... (one stream, so the passes of a\n-- night are independent draws, not offsets of one another).\nlocal function draws(seed: number, night: number): ({ number }, { boolean })\n\tlocal r = PreyRandom.mixed(seed, night, 71)\n\tlocal hours: { number }, found: { boolean } = {}, {}\n\tfor i, w in Nature.game.passes do\n\t\thours[i] = w[1] + (w[2] - w[1]) * r:next()\n\t\tfound[i] = r:next() < Nature.game.foundChance\n\tend\n\treturn hours, found\nend\n\n-- The hours (in the night's count) at which the ground hunters pass on night `night`, one in each window.\nfunction Nature.passHours(seed: number, night: number): { number }\n\treturn (draws(seed, night))\nend\n\n-- Whether pass `pass` of night `night` finds an exposed spider.\nfunction Nature.found(seed: number, night: number, pass: number): boolean\n\tlocal _, found = draws(seed, night)\n\treturn found[pass] == true\nend\n\n-- The kinds of region inside the house, where the garden's night (its ground hunters, its cold) does not reach: the sill, and (ROBLOX-112) the kitchen's counter and floor.\n-- The inside's own night (the house spider, the lamp's moths) is the inside's round (docs/WORLD_MAP_PLAN.md).\n-- (ROBLOX-116: and the ranger hut's inside, World/Hut.INDOORS: its floor, its furniture and the window over the sill)\nNature.INDOORS = table.freeze({ sill = true, counter = true, kitchen_floor = true, hut_window = true, hut_floor = true, hut_desk = true, hut_board = true, hut_shelf = true,\n\thut_chair = true,\n\t-- (ROBLOX-118: the ceiling and the upper walls, the doorway, the front door's head and the volunteers' back room, World/Hut.INDOORS)\n\thut_upper = true, hut_doorway = true, hut_door_up = true, room_floor = true, room_sofa = true, room_tv = true, room_games = true, room_window = true })\n\n-- Whether a spider is exposed to the night where it is: in the standard rules, anywhere outside the house (ROBLOX-106: anywhere but the sill), out of every retreat.\nfunction Nature.exposed(standard: boolean, regionKind: string, inRetreat: boolean): boolean\n\treturn standard and not Nature.INDOORS[regionKind] and not inRetreat\nend\n\n-- One tick of the night. `st` is the caller's (never saved; cleared on a return to a rest and a new life); `life` the LifeLoop (its clock; `cold_day` is set on it,\n-- an optional field the checkpoint keeps). `ctx`: seed, exposed. Returns \"found\" (death), \"cold\" (a pass spared an exposed spider) or \"\".\nfunction Nature.night(st: { [string]: any }, life: any, ctx: { seed: number, exposed: boolean }): string\n\tlocal night, h = Nature.nightOf(life.clock.day, life.clock.hour)\n\tif night == nil then\n\t\tst.night, st.done = nil, nil\n\t\treturn \"\"\n\tend\n\tlocal hours = Nature.passHours(ctx.seed, night)\n\tif st.night ~= night then\n\t\t-- A night met for the first time here: the passes already behind this hour are behind it (a new night at 18:00 has none; a restored rest has the spider in\n\t\t-- its retreat for them).\n\t\tlocal done = 0\n\t\tfor i, ph in hours do if ph <= h then done = i end end\n\t\tst.night, st.done = night, done\n\t\treturn \"\"\n\tend\n\tlocal event = \"\"\n\tfor i = (st.done or 0) + 1, #hours do\n\t\tif hours[i] > h then break end\n\t\tst.done = i\n\t\tif ctx.exposed and event == \"\" then\n\t\t\tif Nature.found(ctx.seed, night, i) then\n\t\t\t\tevent = \"found\"\n\t\t\telse\n\t\t\t\tlife.cold_day = night + 1\n\t\t\t\tevent = \"cold\"\n\t\t\tend\n\t\tend\n\tend\n\treturn event\nend\n\n-- The cold after an exposed night: the factor on the walk's speed now (1 when there is none; a cold that is over is cleared).\nfunction Nature.coldSpeed(life: any): number\n\tlocal d = life.cold_day\n\tif d == nil then return 1.0 end\n\tlocal day, hour = life.clock.day, life.clock.hour\n\tif day < d or (day == d and hour < Nature.game.coldUntilH) then return Nature.game.coldSpeed end\n\tlife.cold_day = nil\n\treturn 1.0\nend\n\n-- Whether a record's `cold_day` is good (nil is).\nfunction Nature.validCold(v: any): boolean\n\treturn v == nil or (finite(v) and v >= 1 and v <= 1e9 and v % 1 == 0)\nend\n\nreturn Nature\n",9574,2739165129},{"Shared/Life/NeedsModel","--!strict\n-- NeedsModel: a port of the frozen scripts/needs/needs_model.gd (spec 11, 19.3, 21.3 NeedState; LIFE-05). The spider's\n-- reserves, and the only place they change. It simulates ENERGY and REST and nothing else (hydration, stress and condition are\n-- named placeholders in the record). The numbers change only through approved calls: time passing (advance, addHours) and food\n-- (grantEnergy). It never reads the world, never decides that anything is eaten, and does not know what a fly is: Feeding asks\n-- it to grant and says which source the energy came from, so its ledger shows that no source ever gave more than it had.\n--\n-- Two modes (explicit, set by whoever builds it; ROBLOX-24):\n--   * sandbox (lifeMode false; Godot's lab and tests that build a model alone): energy drains very slowly with action time and\n--     stops at ENERGY_FLOOR. Nothing happens at the floor.\n--   * life (lifeMode true; the windowsill, where the life clock runs): energy drains with the game hours LifeLoop reports,\n--     faster awake than asleep, and has no floor. It can run out; the hours at zero are counted (starvingHours, and the streak\n--     since the last meal). LifeLoop reads the streak: weak (too hungry to sleep) after 24 hours of it and starved after 48, except in the\n--     gentle modes (ROBLOX-91: the streak is Godot's reset by any meal, or, in the game's rules, eased by each meal by the hours it covers).\n--   * gentle (with lifeMode; Godot's Easy and free play) drains at GENTLE_DRAIN of the rate and never falls below GENTLE_FLOOR.\n-- Both drains are integrated at the 2 Hz update (spec 20) over the action time that actually passed, at most MAX_STEP_S a\n-- call, so the same time drains the same energy at any frame rate and a stall cannot drain more than a capped step.\n-- Rest is a second reserve with no consequence yet: it wears down while the spider is active and builds back while it keeps\n-- still, and the retreat restores it.\n-- Checked against Godot's own values in tests/life_reference.json (tools/export_life_reference.gd).\n\nlocal NeedsModel = {}\nNeedsModel.__index = NeedsModel\n\nNeedsModel.ENERGY_MAX = 1.0\nNeedsModel.ENERGY_START = 0.55\nNeedsModel.ENERGY_DRAIN_PER_S = 0.0006\nNeedsModel.ENERGY_FLOOR = 0.20\nNeedsModel.REST_MAX = 1.0\nNeedsModel.REST_START = 1.0\nNeedsModel.REST_DRAIN_PER_S = 0.0012\nNeedsModel.REST_RECOVER_PER_S = 0.004\nNeedsModel.UPDATE_PERIOD_S = 0.5\nNeedsModel.MAX_STEP_S = 0.25\nNeedsModel.FULL_AT = 0.98\n-- Life mode, at Godot's factor 1: a full reserve lasts about three game days without food, and one fly (0.35) feeds the spider for about a day.\n-- A real Phidippus goes much longer without food; the game compresses time on purpose (LIFE-05).\nNeedsModel.LIFE_DRAIN_AWAKE_PER_H = 0.021\nNeedsModel.LIFE_DRAIN_ASLEEP_PER_H = 0.007\n-- The game's own rules (ROBLOX-78), opt-in like Data/Wasp.game and Data/Catch.game: `drain` multiplies the life-mode drain (awake and asleep alike; the\n-- gentle modes have their own factor, below) of a model that was given them by useGameRules. A model that never is replays Godot (factor 1) and the reference fixtures hold.\n-- The factor is worked out from the constants above: a day is about 11 waking hours and 13 asleep, 11 x 0.021 + 13 x 0.007 = 0.322 energy at factor 1,\n-- so 1.55 cost 0.499, about half the reserve (it was 1.1, 0.354, Chet's ten percent more, ROBLOX-61). ROBLOX-88: 1.9 costs 0.612 a day (11 x 0.021 x 1.9 =\n-- 0.439 awake, 13 x 0.007 x 1.9 = 0.173 asleep): a full reserve lasts 1.63 days, and a housefly (0.35) is 0.57 of a day.\n-- ROBLOX-91: the gentle modes (Easy, Free play) have their own factor, `gentleDrain` 1.1 (ROBLOX-61's, which with the gentle half rate costs 0.177 a day), applied\n-- INSTEAD of `drain` when the model is gentle: ROBLOX-88's hungrier pacing was meant for the standard rules (the gentle day would otherwise have cost 0.306).\n-- `streakDecay`: a meal in the game eases the starving streak by the hours it covers at the current drain (amount / the awake rate) and ends it altogether\n-- only when the reserve rises above `streakEndsAbove` (0.1); Godot's rule, a full reset at any meal, stays the default, so one tiny catch a day at 0% energy\n-- no longer keeps a spider alive for ever.\nNeedsModel.game = { drain = 2.4, gentleDrain = 1.1, streakDecay = true, streakEndsAbove = 0.1 }\n-- ROBLOX-102 (Nathan on v33: \"still more difficult with faster life depletion\"): 1.9 -> 2.4, a day costs 0.773 (11 x 0.021 x 2.4 + 13 x 0.007 x 2.4); a full reserve lasts\n-- about 1.3 days. Gentle modes keep gentleDrain 1.1.\n-- ROBLOX-106 (W4, Nathan: \"movement expends more energy\"; \"hunger always a major concern\"): moving costs energy on top of the clock's drain, in the standard rules only\n-- (a gentle model, Easy and Free play, pays nothing; a model never given the game's rules is Godot's and pays nothing). `moveCost` is per second of action time (the\n-- fixed tick's, so slow motion slows it and the garden's slower clock does not: it is the legs, not the day): walking on a surface `walkPerS`, letting down or reeling in\n-- on the line `linePerS`, and each jump or hop `jump` once as it leaves the surface; standing, hanging still on the line and resting cost nothing extra (the sit-and-wait\n-- economy). The numbers against the 0.773 a day of the drain (11 waking hours, 825 s of play on the sill): a still day 0.773; a typical day (a third of the waking time\n-- walking, 275 s, 30 jumps, a minute on the line) 0.773 + 0.110 + 0.060 + 0.012 = 0.955, about 2.7 houseflies; a restless day (two thirds walking, 550 s, 100 jumps,\n-- three minutes on the line) 0.773 + 0.220 + 0.200 + 0.036 = 1.229, about 3.5 houseflies. A cost the reserve cannot pay is counted as starving time at the awake rate.\nNeedsModel.game.moveCost = { walkPerS = 0.0004, linePerS = 0.0002, jump = 0.002 }\nNeedsModel.PLAY_DRAIN = NeedsModel.game.drain -- (the name the client and tests have used since ROBLOX-61)\nNeedsModel.GENTLE_DRAIN = 0.5\nNeedsModel.GENTLE_FLOOR = 0.1\nNeedsModel.STAGE_ID = \"p0_prototype\"\n\nlocal function finite(x: any): boolean\n\treturn type(x) == \"number\" and x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal function unit(v: any): boolean\n\treturn finite(v) and v >= 0.0 and v <= 1.0\nend\n\nlocal function nonNegative(v: any): boolean\n\treturn finite(v) and v >= 0.0\nend\n\nlocal function pair(v: any): boolean\n\treturn type(v) == \"table\" and #v == 2 and v[3] == nil and nonNegative(v[1]) and nonNegative(v[2])\nend\n\nexport type Record = {\n\tenergy: number, rest: number, enabled: { string }, update_accumulator: { number }, stage_id: string,\n\telapsed_s: number, granted_total: number, granted_by_source: { [string]: number },\n\tlife_mode: boolean, starving_hours: number, hour_accumulator: { number }, starving_streak_h: number,\n}\n\n-- `lifeMode` and `gentle` say which rules apply (see above). Both default to false: the sandbox rules.\nfunction NeedsModel.useGameRules(self: any)\n\tself.drainScale = NeedsModel.game.drain\n\tself.gentleDrainScale = NeedsModel.game.gentleDrain\n\tself.streakDecay = NeedsModel.game.streakDecay\n\tself.moveCosts = true -- (ROBLOX-106: the flag, not the table, so a record carries no copy of the numbers)\nend\n\n-- The factor on the life-mode drain in use: Godot's 1 for a model never given the game's rules, else the game's (the gentle modes have their own).\nfunction NeedsModel.drainFactor(self: any): number\n\tif self.gentle and self.gentleDrainScale ~= nil then return self.gentleDrainScale end\n\treturn self.drainScale or 1\nend\n\nfunction NeedsModel.new(lifeMode: boolean?, gentle: boolean?): any\n\treturn setmetatable({\n\t\tenergy = NeedsModel.ENERGY_START, rest = NeedsModel.REST_START,\n\t\telapsedS = 0.0, grantedTotal = 0.0, grantedBySource = {} :: { [string]: number }, grantsMade = 0, grantsRefused = 0,\n\t\tlifeMode = lifeMode == true, gentle = gentle == true, starvingHours = 0.0, starvingStreakH = 0.0,\n\t\t_accActive = 0.0, _accStill = 0.0, _accHoursAwake = 0.0, _accHoursAsleep = 0.0,\n\t\t-- Called with (before, after) whenever energy changes (Godot's energy_changed signal). Optional.\n\t\tonEnergyChanged = nil :: ((number, number) -> ())?,\n\t}, NeedsModel)\nend\n\nlocal function changed(self: any, before: number)\n\tif self.energy ~= before and self.onEnergyChanged then\n\t\tself.onEnergyChanged(before, self.energy)\n\tend\nend\n\n-- Changes the numbers for a fixture. Keys: energy, rest. Values outside [0, 1] or not finite are ignored.\nfunction NeedsModel.configure(self: any, values: { energy: number?, rest: number? })\n\tif values.energy ~= nil and unit(values.energy) then\n\t\tself.energy = values.energy\n\tend\n\tif values.rest ~= nil and unit(values.rest) then\n\t\tself.rest = values.rest\n\tend\nend\n\nfunction NeedsModel._apply(self: any, period: number, activeShare: number)\n\tlocal before = self.energy\n\tif self.lifeMode then\n\t\tlocal need = (self._accHoursAwake * NeedsModel.LIFE_DRAIN_AWAKE_PER_H + self._accHoursAsleep * NeedsModel.LIFE_DRAIN_ASLEEP_PER_H) * self:drainFactor()\n\t\tlocal hours = self._accHoursAwake + self._accHoursAsleep\n\t\tself._accHoursAwake = 0.0\n\t\tself._accHoursAsleep = 0.0\n\t\tif self.gentle then\n\t\t\tneed *= NeedsModel.GENTLE_DRAIN\n\t\tend\n\t\tif need > 0.0 then\n\t\t\tlocal floorLeft = if self.gentle then math.max(self.energy - NeedsModel.GENTLE_FLOOR, 0.0) else self.energy\n\t\t\tlocal used = math.min(floorLeft, need)\n\t\t\tself.energy -= used\n\t\t\tif need > used and not self.gentle then\n\t\t\t\tlocal starved = hours * (need - used) / need\n\t\t\t\tself.starvingHours += starved\n\t\t\t\tself.starvingStreakH += starved\n\t\t\tend\n\t\tend\n\telseif self.energy > NeedsModel.ENERGY_FLOOR then\n\t\tself.energy = math.max(NeedsModel.ENERGY_FLOOR, self.energy - NeedsModel.ENERGY_DRAIN_PER_S * period)\n\tend\n\tself.rest = math.clamp(\n\t\tself.rest + (NeedsModel.REST_RECOVER_PER_S * (1.0 - activeShare) - NeedsModel.REST_DRAIN_PER_S * activeShare) * period,\n\t\t0.0, NeedsModel.REST_MAX)\n\tchanged(self, before)\nend\n\n-- Lets `dt` seconds of action time pass. `active` is whether the spider spent them moving (walking, leaping, hanging) rather\n-- than keeping still. Non-finite or non-positive time is ignored; a long step counts as at most MAX_STEP_S.\nfunction NeedsModel.advance(self: any, dt: number, active: boolean)\n\tif not finite(dt) or dt <= 0.0 then\n\t\treturn\n\tend\n\tdt = math.min(dt, NeedsModel.MAX_STEP_S)\n\tself.elapsedS += dt\n\tif active then\n\t\tself._accActive += dt\n\telse\n\t\tself._accStill += dt\n\tend\n\tlocal total = self._accActive + self._accStill\n\twhile total >= NeedsModel.UPDATE_PERIOD_S - 1e-9 do\n\t\tself:_apply(NeedsModel.UPDATE_PERIOD_S, self._accActive / total)\n\t\tlocal keep = math.max(0.0, (total - NeedsModel.UPDATE_PERIOD_S) / total)\n\t\tself._accActive *= keep\n\t\tself._accStill *= keep\n\t\ttotal -= NeedsModel.UPDATE_PERIOD_S\n\tend\nend\n\n-- Life mode: `hours` of game time passed, asleep or awake. They are used up at the next 2 Hz update.\nfunction NeedsModel.addHours(self: any, hours: number, asleep: boolean)\n\tif not self.lifeMode or not finite(hours) or hours <= 0.0 then\n\t\treturn\n\tend\n\tif asleep then\n\t\tself._accHoursAsleep += hours\n\telse\n\t\tself._accHoursAwake += hours\n\tend\nend\n\n-- ROBLOX-106: what a movement costs now: `kind` is \"walk\" or \"line\" (for `dt` seconds of it) or \"jump\" (once). Nothing for a model without the game's rules, a gentle\n-- model, a sandbox model or an unknown kind.\nfunction NeedsModel.moveCostOf(self: any, kind: string, dt: number): number\n\tlocal c = NeedsModel.game.moveCost\n\tif self.moveCosts ~= true or self.gentle or not self.lifeMode then return 0.0 end\n\tif kind == \"jump\" then return c.jump or 0.0 end\n\tif not finite(dt) or dt <= 0.0 then return 0.0 end\n\tif kind == \"walk\" then return (c.walkPerS or 0.0) * math.min(dt, NeedsModel.MAX_STEP_S) end\n\tif kind == \"line\" then return (c.linePerS or 0.0) * math.min(dt, NeedsModel.MAX_STEP_S) end\n\treturn 0.0\nend\n\n-- ROBLOX-106: pays for a movement (see moveCostOf) out of the reserve at once. What the reserve cannot pay is starving time at the awake rate, so a restless starving\n-- spider starves sooner than a still one. Returns what was paid from the reserve.\nfunction NeedsModel.move(self: any, kind: string, dt: number): number\n\tlocal cost = self:moveCostOf(kind, dt)\n\tif cost <= 0.0 then return 0.0 end\n\tlocal before = self.energy\n\tlocal paid = math.min(cost, self.energy)\n\tself.energy -= paid\n\tif cost > paid then\n\t\tlocal perHour = NeedsModel.LIFE_DRAIN_AWAKE_PER_H * self:drainFactor()\n\t\tlocal starved = (cost - paid) / perHour\n\t\tself.starvingHours += starved\n\t\tself.starvingStreakH += starved\n\tend\n\tchanged(self, before)\n\treturn paid\nend\n\n-- Whether the reserve has run out (life mode).\nfunction NeedsModel.isStarving(self: any): boolean\n\treturn self.lifeMode and self.energy <= 0.0\nend\n\n-- Energy that could still be added.\nfunction NeedsModel.room(self: any): number\n\treturn math.max(0.0, NeedsModel.ENERGY_MAX - self.energy)\nend\n\n-- Adds food energy from `sourceId` (a meal's capture key). Returns what was actually added: nothing for an amount that is not\n-- a positive finite number or a source with no name, and never more than the room left. The caller (Feeding, only while a\n-- held prey is being eaten) decides that the energy is deserved; this only keeps the books.\nfunction NeedsModel.grantEnergy(self: any, amount: number, sourceId: string): number\n\tif sourceId == \"\" or not finite(amount) or amount <= 0.0 then\n\t\tself.grantsRefused += 1\n\t\treturn 0.0\n\tend\n\tlocal added = math.min(amount, self:room())\n\tif added <= 0.0 then\n\t\treturn 0.0\n\tend\n\tlocal before = self.energy\n\tself.energy = math.min(NeedsModel.ENERGY_MAX, self.energy + added)\n\tadded = self.energy - before\n\tself.grantedTotal += added\n\tself.grantedBySource[sourceId] = (self.grantedBySource[sourceId] or 0.0) + added\n\tself.grantsMade += 1\n\tif self.streakDecay then\n\t\t-- The game: the meal covers the hours it feeds (at the awake rate) and the streak only ends when the reserve is really back.\n\t\tlocal perHour = NeedsModel.LIFE_DRAIN_AWAKE_PER_H * self:drainFactor()\n\t\tself.starvingStreakH = math.max(0.0, self.starvingStreakH - added / perHour)\n\t\tif self.energy > (NeedsModel.game.streakEndsAbove or 0.1) then self.starvingStreakH = 0.0 end\n\telse\n\t\tself.starvingStreakH = 0.0\n\tend\n\tchanged(self, before)\n\treturn added\nend\n\n-- Energy lost to an injury (ROBLOX-73: the rival's counter-bite). Never more than the spider has, and nothing in the gentle modes. Returns what was\n-- lost. It is not time passing, so it leaves the starving hours to the drain; the reserve is already in the record, so nothing else needs keeping.\nfunction NeedsModel.injure(self: any, amount: number): number\n\tif self.gentle or not finite(amount) or amount <= 0.0 then\n\t\treturn 0.0\n\tend\n\tlocal before = self.energy\n\tself.energy = math.max(0.0, self.energy - amount)\n\tchanged(self, before)\n\treturn before - self.energy\nend\n\n-- A valid retreat interaction restores rest; it never grants food energy.\nfunction NeedsModel.restoreRest(self: any, amount: number)\n\tif finite(amount) and amount > 0.0 then\n\t\tself.rest = math.min(NeedsModel.REST_MAX, self.rest + amount)\n\tend\nend\n\nfunction NeedsModel.isFull(self: any): boolean\n\treturn self.energy >= NeedsModel.FULL_AT\nend\n\n-- What one source has given so far.\nfunction NeedsModel.grantedFrom(self: any, sourceId: string): number\n\treturn self.grantedBySource[sourceId] or 0.0\nend\n\n-- The NeedState record (spec 21.3), with Godot's field names. Hydration, stress and condition are not simulated and so absent.\nfunction NeedsModel.toRecord(self: any): Record\n\tlocal by: { [string]: number } = {}\n\tfor k, v in self.grantedBySource do\n\t\tby[k] = v\n\tend\n\treturn {\n\t\tenergy = self.energy, rest = self.rest, enabled = { \"energy\", \"rest\" },\n\t\tupdate_accumulator = { self._accActive, self._accStill }, stage_id = NeedsModel.STAGE_ID,\n\t\telapsed_s = self.elapsedS, granted_total = self.grantedTotal, granted_by_source = by,\n\t\tlife_mode = self.lifeMode, starving_hours = self.starvingHours,\n\t\thour_accumulator = { self._accHoursAwake, self._accHoursAsleep }, starving_streak_h = self.starvingStreakH,\n\t}\nend\n\n-- Restores a record made by toRecord. False, and nothing changed, for anything that is not one: a missing or non-finite number,\n-- a reserve outside [0, 1], an accumulator that is not two non-negative numbers, a grant ledger that does not add up. A record\n-- without the life fields (Godot's older records) loads with them at their defaults. `gentle` is not part of the record.\nfunction NeedsModel.load(self: any, d: any): boolean\n\tif type(d) ~= \"table\" then\n\t\treturn false\n\tend\n\tfor _, key in { \"energy\", \"rest\", \"elapsed_s\", \"granted_total\" } do\n\t\tif not finite(d[key]) then\n\t\t\treturn false\n\t\tend\n\tend\n\tif not unit(d.energy) or not unit(d.rest) or d.elapsed_s < 0.0 or d.granted_total < 0.0 then\n\t\treturn false\n\tend\n\tif not pair(d.update_accumulator) then\n\t\treturn false\n\tend\n\tlocal by = d.granted_by_source\n\tif type(by) ~= \"table\" then\n\t\treturn false\n\tend\n\tlocal sum = 0.0\n\tfor k, v in by do\n\t\tif type(k) ~= \"string\" or not nonNegative(v) then\n\t\t\treturn false\n\t\tend\n\t\tsum += v\n\tend\n\tif math.abs(sum - d.granted_total) > 1e-6 then\n\t\treturn false\n\tend\n\tlocal lm = if d.life_mode == nil then false else d.life_mode\n\tlocal sh = if d.starving_hours == nil then 0.0 else d.starving_hours\n\tlocal ha = if d.hour_accumulator == nil then { 0.0, 0.0 } else d.hour_accumulator\n\tlocal streak = if d.starving_streak_h == nil then 0.0 else d.starving_streak_h\n\tif not nonNegative(streak) then\n\t\treturn false\n\tend\n\tif type(lm) ~= \"boolean\" or not nonNegative(sh) then\n\t\treturn false\n\tend\n\tif not pair(ha) then\n\t\treturn false\n\tend\n\tlocal copy: { [string]: number } = {}\n\tfor k, v in by do\n\t\tcopy[k] = v\n\tend\n\tself.lifeMode = lm\n\tself.starvingHours = sh\n\tself.starvingStreakH = streak\n\tself._accHoursAwake = ha[1]\n\tself._accHoursAsleep = ha[2]\n\tself.energy = d.energy\n\tself.rest = d.rest\n\tself.elapsedS = d.elapsed_s\n\tself.grantedTotal = d.granted_total\n\tself.grantedBySource = copy\n\tself._accActive = d.update_accumulator[1]\n\tself._accStill = d.update_accumulator[2]\n\treturn true\nend\n\nreturn NeedsModel\n",17894,2185641658},{"Shared/Life/Nursery","--!strict\n-- The nursery rule (ROBLOX-116, docs/PARK_WORLD_DESIGN.md: Nathan's \"born on the sill, the sash shut until ready\"). In the preserve's first life the ranger hut's\n-- window is shut and the hut's door is shut: the spider has the sill, the desk and the hut's inside. The window opens once, when the spider has grown past its\n-- first moult and its new cuticle has hardened, on the first morning after that the ranger comes in (a seeded hour of the morning, `arrival`), and it stays\n-- open from then on: the save remembers it (Persistence/SaveProgress `hut_window`), every later life finds it open, and nothing ever shuts it again.\n--\n-- Why the moult and not a number of days: the moult is the life's own proof that the spider can hunt (it has eaten what a moult asks for: five houseflies'\n-- worth in Normal, three in the gentle modes, Life/Growth), and a jumping spider leaves the place it hatched as a juvenile, not after a calendar. A spider that\n-- starves in the nursery has not been let out early: the next life is born in it again. The hardening (Growth.SOFT_HOURS) keeps the open window from meeting a\n-- soft spider: the garden's wasp and its night are no place for one.\n-- Pure: the client asks (Client/HutLife); tests/preserve.luau holds it.\nlocal Nursery = {}\n\n-- The ranger comes in between these hours of the morning (the life clock's); the window can be propped until noon of that day, and on any later morning.\nNursery.ARRIVAL = table.freeze({ 7.5, 9.5 })\nNursery.NOON = 12.0\n-- The stage the spider must have reached (Life/Growth: 0 the young juvenile, 1 after the first moult).\nNursery.STAGE = 1\n\nlocal MOD = 2147483647\n\n-- The hour the ranger comes in on a day (the life clock's day, from 1), from the world's seed: the same hour for the same day forever (a restore never rerolls it).\nfunction Nursery.arrival(seed: number, day: number): number\n\tlocal h = (math.floor(seed) % MOD + math.floor(day) * 104729) % MOD\n\tif h <= 0 then h += MOD - 1 end\n\tfor _ = 1, 4 do h = (h * 48271) % MOD end\n\tlocal u = (h - 1) / (MOD - 1)\n\treturn Nursery.ARRIVAL[1] + (Nursery.ARRIVAL[2] - Nursery.ARRIVAL[1]) * u\nend\n\n-- Whether the spider is ready to leave: past the stage, not moulting, its cuticle hard.\nfunction Nursery.ready(stage: number, moulting: boolean, soft: boolean): boolean\n\treturn stage >= Nursery.STAGE and not moulting and not soft\nend\n\n-- Whether the window is propped now: the spider ready and the ranger in (from the morning's arrival until noon).\nfunction Nursery.opens(seed: number, stage: number, moulting: boolean, soft: boolean, day: number, hour: number): boolean\n\tif not Nursery.ready(stage, moulting, soft) then return false end\n\treturn hour >= Nursery.arrival(seed, day) and hour < Nursery.NOON\nend\n\nreturn table.freeze(Nursery)\n",2770,3928992305},{"Shared/Life/RareDirector","--!strict\nlocal Ledger=require(script.Parent.RareLedger)\nlocal Catalog=require(script.Parent.Parent.Data.RareSightings)\nlocal Environment=require(script.Parent.Parent.World.Environment)\nlocal Director={}\n-- Optional life fields are part of the existing checkpoint object graph.\nfunction Director.beginLife(history: Ledger.Record,life: any)\n life.rareSerial=Ledger.beginLife(history)\n life.rareGeneration=life.generation or 0;life.rareBorn=life.clock.day;life.rareVisit=nil\nend\nfunction Director.ensureLife(history: Ledger.Record,life: any)\n if life.rareSerial==nil then\n  -- Legacy rests get the current high-water mark, not another roll on reload.\n  if history.serial==0 then Ledger.beginLife(history) end\n  life.rareSerial=history.serial;life.rareGeneration=life.generation or 0;life.rareBorn=life.clock.day\n elseif life.rareGeneration~=(life.generation or 0) then Director.beginLife(history,life) end\n history.serial=math.max(history.serial,life.rareSerial)\nend\nfunction Director.plan(seed: number,serial: number,born: number): any?\n local spec=Catalog.luna\n if Environment.hash(seed,serial,701)>=spec.chance then return nil end\n return {id=spec.id,serial=serial,day=born+1+math.floor(Environment.hash(seed,serial,703)*spec.days),\n  hour=20+Environment.hash(seed,serial,709)*2}\nend\nfunction Director.step(history: Ledger.Record,life: any,seed: number): any?\n Director.ensureLife(history,life)\n if life.lifeOver then return nil end\n local spec=Catalog.luna;local day,hour=life.clock.day,life.clock.hour\n local now=(day-1)*24+hour\n local visit=life.rareVisit\n if visit==nil and not history.blocked and (history.claimed[spec.id] or 0)<life.rareSerial then\n  local plan=Director.plan(seed,life.rareSerial,life.rareBorn)\n  if plan then\n   local at=(plan.day-1)*24+plan.hour;local dawn=plan.day*24+6\n   local doy=Environment.solar(plan.day,plan.hour).dayOfYear\n   if now>=at and now<dawn and doy>=spec.firstDay and doy<=spec.lastDay then\n    -- Weather is sampled at the scheduled arrival, not at the player's reload.\n    local weather=Environment.sample(plan.day,plan.hour,seed)\n    if weather.temperature>=spec.minTemperature and weather.rain<=spec.maxRain then\n     history.claimed[spec.id]=life.rareSerial\n     visit={id=spec.id,serial=life.rareSerial,day=plan.day,hour=plan.hour}\n     life.rareVisit=visit\n    end\n   end\n  end\n end\n if visit==nil or visit.serial~=life.rareSerial then return nil end\n local start=(visit.day-1)*24+visit.hour;local dawn=visit.day*24+6\n if now<start or now>=dawn then return nil end\n -- Current weather never rerolls the arrival. Later rain does not erase it.\n return {id=spec.id,serial=visit.serial,at=spec.at,ageHours=now-start,day=visit.day}\nend\nfunction Director.problems(life: any): {string}\n local problems={}\n local function whole(n: any,minimum: number): boolean\n  return type(n)==\"number\" and n==n and n>=minimum and n<=Ledger.MAX_SERIAL and n%1==0\n end\n if life.rareSerial==nil then\n  if life.rareBorn~=nil or life.rareGeneration~=nil or life.rareVisit~=nil then table.insert(problems,\"rare visit without life identity\") end\n  return problems\n end\n if not whole(life.rareSerial,1) or not whole(life.rareBorn,1) or not whole(life.rareGeneration,0) then\n  table.insert(problems,\"invalid rare life identity\")\n end\n local v=life.rareVisit\n if v~=nil then\n  if type(v)~=\"table\" or v.id~=Catalog.luna.id or v.serial~=life.rareSerial or not whole(v.day,1)\n   or type(v.hour)~=\"number\" or v.hour~=v.hour or v.hour<20 or v.hour>=22 then\n   table.insert(problems,\"invalid rare visit\")\n  end\n end\n return problems\nend\nreturn Director\n",3566,2027285952},{"Shared/Life/RareLedger","--!strict\n-- Player progress, outside rests. High-water marks prevent a rewound rest\n-- creating a second visit; restoring a rest DURING a visit restores that animal.\nlocal Ledger = {}\nLedger.LIMIT = 64\nLedger.MAX_SERIAL = 1000000000\nexport type Record = { serial: number, claimed: { [string]: number }, once: { [string]: boolean }, blocked: boolean? }\nfunction Ledger.new(): Record return {serial=0,claimed={},once={}} end\nlocal function whole(x: any): boolean\n return type(x)==\"number\" and x==x and x>=0 and x<=Ledger.MAX_SERIAL and x%1==0\nend\nfunction Ledger.clean(raw: any): Record?\n if type(raw)~=\"table\" or not whole(raw.serial) or type(raw.claimed)~=\"table\" or type(raw.once)~=\"table\" then return nil end\n local out=Ledger.new();out.serial=raw.serial\n if raw.blocked~=nil and type(raw.blocked)~=\"boolean\" then return nil end\n if raw.blocked==true then out.blocked=true end\n for _,field in {\"claimed\",\"once\"} do\n  local count=0\n  for id,value in raw[field] do\n   count+=1\n   if count>Ledger.LIMIT or type(id)~=\"string\" or #id<1 or #id>64 or not string.match(id,\"^[%w_]+$\") then return nil end\n   if field==\"claimed\" then\n    if not whole(value) or value>raw.serial then return nil end\n    out.claimed[id]=value\n   else\n    if value~=true then return nil end\n    out.once[id]=true\n   end\n  end\n end\n return out\nend\nfunction Ledger.merge(a: Record?,b: Record?): Record\n local out=Ledger.new()\n for _,record in {a or Ledger.new(),b or Ledger.new()} do\n  out.serial=math.max(out.serial,record.serial)\n  if record.blocked then out.blocked=true end\n  for id,n in record.claimed do out.claimed[id]=math.max(out.claimed[id] or 0,n) end\n  for id in record.once do out.once[id]=true end\n end\n -- Retain a bounded record even when two individually valid maps overflow on\n -- merge. Fail closed: a discarded claim must never make an animal repeat.\n for _,field in {\"claimed\",\"once\"} do\n  local map=(out :: any)[field];local keys={}\n  for id in map do table.insert(keys,id) end\n  table.sort(keys)\n  for i=Ledger.LIMIT+1,#keys do map[keys[i]]=nil;out.blocked=true end\n end\n return out\nend\nfunction Ledger.signature(record: Record): string\n local sum,count=0,0\n for _,n in record.claimed do sum+=n end\n for _ in record.once do count+=1 end\n return `{record.serial}:{sum}:{count}:{record.blocked==true}`\nend\nfunction Ledger.same(a: Record?,b: Record?): boolean\n local x,y=a or Ledger.new(),b or Ledger.new()\n if x.serial~=y.serial or (x.blocked==true)~=(y.blocked==true) then return false end\n for _,field in {\"claimed\",\"once\"} do\n  for id,value in (x :: any)[field] do if (y :: any)[field][id]~=value then return false end end\n  for id,value in (y :: any)[field] do if (x :: any)[field][id]~=value then return false end end\n end\n return true\nend\nfunction Ledger.beginLife(record: Record): number\n assert(record.serial<Ledger.MAX_SERIAL,\"rare life counter exhausted\")\n record.serial+=1;return record.serial\nend\nreturn Ledger\n",2915,3737183104},{"Shared/Life/Water","--!strict\n-- The water (ROBLOX-122, docs/PARK_WORLD_DESIGN.md zone 4: \"water (drowning)\"): the pond's surface is not a place a jumping spider can live on. The sources the notebook's\n-- page \"Spiders and water\" cites say why: most spiders are not built for it (of 166 species outside the wolf and fishing spiders tested on water, only two jumping\n-- spiders rowed at all, and the jumping spiders that walked or rowed on it got no clear good of it); a fishing spider runs on the water's film, a jumping spider\n-- that falls in struggles. Here the water has no box (World/Pond: nothing to stand on), and a spider whose body goes under its surface (World/Pond.inWater) is in it.\n-- Pure: the client seizes the motor and holds the body at the surface while the struggle lasts, then puts it where this says or ends the life.\n--\n-- The struggle (`fall`, `step`): STRUGGLE seconds at the surface, thrashing (the water striders feel the ripples: Prey/Skater). Then the outcome, a seeded draw (a\n-- hash of the world's seed, the life's day and the falls counted so far, kept in the rest: restores never reroll) against the chance of getting out:\n--   a way out within REACH of where it went in (a stem, a leaf, a stone, a pad, the bank, a post: any box that comes up through the surface or lies on it) gives a\n--   chance that falls from NEAR_CHANCE at the stem's foot to FAR_CHANCE at REACH; a LONG fall (from higher than LONG studs over the water, a plunge that takes the\n--   spider under) halves it. In the standard rules the spider that does not get out drowns (a death with its own card, UI/WaterText), and a long fall into open\n--   water with nothing in reach drowns, honestly. In the gentle rules (Easy, Free play) it is always pulled out: onto the way out in reach, or, with none, washed to\n--   the nearest one (within RESCUE) with a notice.\n-- `out` signals carry where to put the spider: on the way out's top, or on its side face just over the water.\nlocal WorldMap = require(script.Parent.Parent.World.WorldMap)\n\nlocal Water = {}\nWater.__index = Water\n\nWater.STRUGGLE = 3.0 -- seconds at the surface before the outcome\nWater.REACH = 4.0 -- studs from where it went in to a way out it can reach (its legs' span and a short scramble)\nWater.NEAR_CHANCE = 0.9\nWater.FAR_CHANCE = 0.4\nWater.LONG = 20 -- a fall from higher than this over the water is a plunge\nWater.RESCUE = 120 -- how far the gentle rules look for a way out\nWater.UP = 0.6 -- a way out must stand at least this far over the water to climb onto, or lie on it (a pad)\nWater.CAUSE = \"drowned\"\nWater.MOD = 2147483647\n\nexport type Box = { lo: Vector3, hi: Vector3, id: string? }\nexport type Record = { falls: number, out: number }\n\nfunction Water.new(seed: number): any\n\treturn setmetatable({ seed = seed, gentle = false, falls = 0, out = 0, active = nil :: any, signals = {} :: { any } }, Water)\nend\n\n-- The draw for the `n`th fall of the life's `day` (in [0, 1)): the world's seed hashed with the day and the count (World/WorldMap.seed, as a region's).\nfunction Water.draw(seed: number, day: number, n: number): number\n\tlocal s = WorldMap.seed(seed, `water:{math.floor(day)}:{math.floor(n)}`)\n\treturn (s - 1) / (Water.MOD - 1)\nend\n\n-- The nearest way out of the water from `at` (a point at the surface) among `boxes`: a box that comes up through the surface (its top at least UP over it) or lies on\n-- it (a pad), its distance in plan, and where a spider gets onto it (its top if it is low, else its side face just over the water, the side nearest).\nfunction Water.wayOut(at: Vector3, surface: number, boxes: { Box }, limit: number): (Box?, number, Vector3?, Vector3?)\n\tlocal best, bd, bp, bn = nil :: Box?, math.huge, nil :: Vector3?, nil :: Vector3?\n\tfor _, b in boxes do\n\t\tif b.hi.Y < surface + 0.25 or b.lo.Y > surface + 0.5 then continue end -- (it must reach the surface and stand at or over it)\n\t\tlocal cx, cz = math.clamp(at.X, b.lo.X, b.hi.X), math.clamp(at.Z, b.lo.Z, b.hi.Z)\n\t\tlocal d = Vector3.new(at.X - cx, 0, at.Z - cz).Magnitude\n\t\tif d < bd and d <= limit then\n\t\t\tlocal low = b.hi.Y - surface < 6\n\t\t\tlocal p: Vector3, n: Vector3\n\t\t\tif low or d < 1e-6 then\n\t\t\t\tp, n = Vector3.new(math.clamp(at.X, b.lo.X + 0.3, b.hi.X - 0.3), b.hi.Y, math.clamp(at.Z, b.lo.Z + 0.3, b.hi.Z - 0.3)), Vector3.yAxis\n\t\t\telse\n\t\t\t\t-- the side face nearest, a little over the water\n\t\t\t\tlocal dx0, dx1, dz0, dz1 = math.abs(at.X - b.lo.X), math.abs(at.X - b.hi.X), math.abs(at.Z - b.lo.Z), math.abs(at.Z - b.hi.Z)\n\t\t\t\tlocal m = math.min(dx0, dx1, dz0, dz1)\n\t\t\t\tlocal y = surface + 1.5\n\t\t\t\tif m == dx0 then p, n = Vector3.new(b.lo.X, y, cz), -Vector3.xAxis\n\t\t\t\telseif m == dx1 then p, n = Vector3.new(b.hi.X, y, cz), Vector3.xAxis\n\t\t\t\telseif m == dz0 then p, n = Vector3.new(cx, y, b.lo.Z), -Vector3.zAxis\n\t\t\t\telse p, n = Vector3.new(cx, y, b.hi.Z), Vector3.zAxis end\n\t\t\tend\n\t\t\tbest, bd, bp, bn = b, d, p, n\n\t\tend\n\tend\n\treturn best, bd, bp, bn\nend\n\n-- The chance of getting out onto a way out `d` studs off after a fall from `drop` studs over the water.\nfunction Water.chance(d: number, drop: number): number\n\tif d > Water.REACH then return 0 end\n\tlocal c = Water.NEAR_CHANCE + (Water.FAR_CHANCE - Water.NEAR_CHANCE) * math.clamp(d / Water.REACH, 0, 1)\n\tif drop > Water.LONG then c *= 0.5 end\n\treturn c\nend\n\n-- The spider went in at `at` (its body at the surface), having fallen from `drop` studs over the water (0 walking in), on the life's `day`; `boxes` the world's boxes\n-- near it (its region's and its neighbours'), `surface` the water's level. Decides the outcome now (it is told when the struggle ends).\nfunction Water.fall(self: any, at: Vector3, drop: number, day: number, boxes: { Box }, surface: number)\n\tif self.active ~= nil then return end\n\tself.falls += 1\n\tlocal draw = Water.draw(self.seed, day, self.falls)\n\tlocal box, d, p, n = Water.wayOut(at, surface, boxes, Water.REACH)\n\tlocal chance = if box ~= nil then Water.chance(d, drop) else 0\n\tlocal outcome: string\n\tif box ~= nil and draw < chance then outcome = \"out\"\n\telseif self.gentle then\n\t\toutcome = \"pulled\"\n\t\tif box == nil then box, d, p, n = Water.wayOut(at, surface, boxes, Water.RESCUE) end\n\t\tif box == nil then outcome = \"lost\" end\n\telse outcome = \"drowned\" end\n\tself.active = { at = Vector3.new(at.X, surface, at.Z), t = 0, outcome = outcome, to = p, normal = n, drop = drop, chance = chance, draw = draw, reach = d }\n\ttable.insert(self.signals, { kind = \"fell\", at = self.active.at, drop = drop })\nend\n\n-- One tick. Ends the struggle with \"out\" or \"pulled\" (the place and its normal) or \"drowned\"; \"lost\" (gentle, and nothing in RESCUE) is told as \"pulled\" to the\n-- spot it went in from, the client's own safe place.\nfunction Water.step(self: any, dt: number)\n\tlocal a = self.active\n\tif a == nil then return end\n\ta.t += dt\n\tif a.t < Water.STRUGGLE then return end\n\tself.active = nil\n\tif a.outcome == \"out\" or a.outcome == \"pulled\" then self.out += 1 end\n\ttable.insert(self.signals, { kind = a.outcome, at = a.at, to = a.to, normal = a.normal })\nend\n\n-- Where the body is held while it struggles: at the surface, bobbing a little.\nfunction Water.heldAt(self: any): Vector3?\n\tlocal a = self.active\n\tif a == nil then return nil end\n\treturn a.at + Vector3.new(0, 0.05 + 0.08 * math.sin(a.t * 9), 0)\nend\n\nfunction Water.struggling(self: any): boolean\n\treturn self.active ~= nil\nend\n\nfunction Water.drainSignals(self: any): { any }\n\tlocal out = self.signals\n\tself.signals = {}\n\treturn out\nend\n\n-- The record a rest keeps (Persistence/Checkpoint's optional `water`): the falls counted (the draws' counter) and how many got out.\nfunction Water.defaultRecord(): Record\n\treturn { falls = 0, out = 0 }\nend\nfunction Water.toRecord(self: any): Record\n\treturn { falls = self.falls, out = self.out }\nend\nfunction Water.problems(d: any): { string }\n\tlocal out: { string } = {}\n\tif type(d) ~= \"table\" then return { \"water: not a record\" } end\n\tfor _, k in { \"falls\", \"out\" } do\n\t\tlocal x = d[k]\n\t\tif type(x) ~= \"number\" or x ~= x or x < 0 or x > 1e9 or math.floor(x) ~= x then table.insert(out, `water: {k} is not a count`) end\n\tend\n\tif #out == 0 and d.out > d.falls then table.insert(out, \"water: more got out than fell in\") end\n\treturn out\nend\nfunction Water.load(self: any, d: Record)\n\tself.falls, self.out, self.active = d.falls, d.out, nil\n\tself.signals = {}\nend\n\nreturn Water\n",8295,736597333},{"Shared/Movement/CameraMath","--!strict\n-- Pure camera and stick math, ported from the frozen Godot reference (c87ce00):\n--   scripts/movement/boom_math.gd    (orbit basis, boom recovery, eased offsets, pitch pick, smooth damp)\n--   scripts/movement/surface_input.gd (camera-relative walking on floors, walls and undersides)\n--   scripts/movement/camera_rig.gd   (aim free-look clamp, spider-eye gaze clamp, recenter yaw)\n-- Vector3 only, no Instances, so tests/run.luau checks it against values exported from Godot itself.\n-- Conventions match Godot and Roblox alike: right-handed, -Z forward, yaw about world up,\n-- elevation positive puts the camera above the pivot.\n\nlocal CameraMath = {}\n\nCameraMath.PIVOT_HEIGHT = 0.45\nCameraMath.BOOM_RADIUS = 0.15\nCameraMath.DEFAULT_ELEVATION_DEG = 18.0\nCameraMath.MIN_ELEVATION_DEG = -20.0\nCameraMath.MAX_ELEVATION_DEG = 80.0\nCameraMath.MOUSE_DEG_PER_PIXEL = 0.1\nCameraMath.STICK_DEG_PER_SECOND = 150.0\nCameraMath.RECOVER_SPEED = 6.0\nCameraMath.RECENTER_SECONDS = 0.25\nCameraMath.BODY_HIDE_LENGTH = 0.8\nCameraMath.COMFORT_BOOM = 2.5\nCameraMath.AUTO_PITCH_STEP_DEG = 10.0\nCameraMath.MIN_AUTO_ELEVATION_DEG = -45.0\nCameraMath.AUTO_PITCH_IN_SECONDS = 0.08\nCameraMath.AUTO_PITCH_OUT_SECONDS = 0.35\nCameraMath.AIM_PITCH_MIN_DEG = -20.0\nCameraMath.AIM_PITCH_MAX_DEG = 50.0\nCameraMath.AIM_VIEW_LIMIT_DEG = 85.0\nCameraMath.AIM_RETURN_SECONDS = 0.25\nCameraMath.EYE_FOV_DEG = 80.0\nCameraMath.EYE_AHEAD = 0.53\nCameraMath.EYE_HEIGHT = 0.09\nCameraMath.EYE_PITCH_LIMIT_DEG = 80.0\nCameraMath.EYE_ROLL_DEG_S = 240.0\nCameraMath.PRINCIPAL_SCAN_DEG = 30.0\nCameraMath.EYE_SETTLE_DEG = 4.0\nCameraMath.FOV_DEG = 65.0\nCameraMath.CAMERA_DISTANCE = 5.0\n\nlocal SETTLE = 2e-4\nlocal TIE = 1e-3\nlocal FLOOR_BLEND_START = 0.5\nlocal FLOOR_BLEND_END = 0.8660254\n\nlocal function finite(x: number): boolean\n\treturn x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal function smoothstep(a: number, b: number, x: number): number\n\tif a == b then\n\t\treturn if x < a then 0 else 1\n\tend\n\tlocal t = math.clamp((x - a) / (b - a), 0, 1)\n\treturn t * t * (3 - 2 * t)\nend\nCameraMath.smoothstep = smoothstep\n\nlocal function dirOn(v: Vector3, n: Vector3): Vector3\n\tlocal t = v - n * v:Dot(n)\n\tlocal length = t.Magnitude\n\treturn if length > 1e-6 then t / length else Vector3.new(0, 0, 0)\nend\n\n-- BoomMath.next_length: a shorter allowed length is taken at once; growth is rate limited.\nfunction CameraMath.nextLength(current: number, allowed: number, desired: number, recoverSpeed: number, dt: number): number\n\tif not (finite(current) and finite(allowed) and finite(desired) and finite(recoverSpeed) and finite(dt)) then\n\t\treturn 0\n\tend\n\tlocal target = math.max(0, math.min(allowed, desired))\n\tif target <= current then\n\t\treturn target\n\tend\n\treturn math.min(current + math.max(recoverSpeed, 0) * math.max(dt, 0), target)\nend\n\n-- BoomMath.ease_offset: exponential ease, faster away from zero than back toward it.\nfunction CameraMath.easeOffset(current: number, target: number, dt: number, inSeconds: number, outSeconds: number): number\n\tif not (finite(current) and finite(target) and finite(dt) and finite(inSeconds) and finite(outSeconds)) then\n\t\treturn 0\n\tend\n\tlocal seconds = math.max(if math.abs(target) >= math.abs(current) then inSeconds else outSeconds, 1e-4)\n\tlocal nextValue = current + (target - current) * (1 - math.exp(-math.max(dt, 0) / seconds))\n\treturn if math.abs(target - nextValue) < SETTLE then target else nextValue\nend\n\n-- BoomMath.smooth_damp: a critically damped approach of current to target (arrives without overshoot, gentle at both\n-- ends); smoothTime is about the time it takes. Returns the next value and velocity; it lands exactly on the target once\n-- within SETTLE and nearly still. Non-finite input returns 0, 0.\nfunction CameraMath.smoothDamp(current: number, target: number, velocity: number, smoothTime: number, dt: number): (number, number)\n\tif not (finite(current) and finite(target) and finite(velocity) and finite(smoothTime) and finite(dt)) then\n\t\treturn 0, 0\n\tend\n\tlocal omega = 2 / math.max(smoothTime, 1e-4)\n\tlocal x = omega * math.max(dt, 0)\n\tlocal damp = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)\n\tlocal change = current - target\n\tlocal temp = (velocity + omega * change) * dt\n\tlocal nextVelocity = (velocity - omega * temp) * damp\n\tlocal nextValue = target + (change + temp) * damp\n\tif (target - current > 0) == (nextValue > target) then\n\t\treturn target, 0\n\tend\n\tif math.abs(target - nextValue) < SETTLE and math.abs(nextVelocity) < 1e-3 then\n\t\treturn target, 0\n\tend\n\treturn nextValue, nextVelocity\nend\n\n-- BoomMath.pick_pitch_offset: the first comfortable boom, else the longest.\nfunction CameraMath.pickPitchOffset(offsets: { number }, lengths: { number }, comfort: number): number\n\tif #offsets == 0 or #offsets ~= #lengths or not finite(comfort) then\n\t\treturn 0\n\tend\n\tlocal best = 1\n\tfor i = 1, #offsets do\n\t\tif lengths[i] >= comfort then\n\t\t\treturn offsets[i]\n\t\tend\n\t\tif lengths[i] > lengths[best] + TIE then\n\t\t\tbest = i\n\t\tend\n\tend\n\treturn offsets[best]\nend\n\n-- BoomMath.back_direction: unit vector from the pivot toward the camera.\nfunction CameraMath.backDirection(yaw: number, elevation: number): Vector3\n\tlocal ce = math.cos(elevation)\n\treturn Vector3.new(math.sin(yaw) * ce, math.sin(elevation), math.cos(yaw) * ce)\nend\n\n-- The orbit camera's right and up vectors (SurfaceInput.camera_basis x and y columns).\nfunction CameraMath.cameraRight(yaw: number, _elevation: number): Vector3\n\treturn Vector3.new(math.cos(yaw), 0, -math.sin(yaw))\nend\nfunction CameraMath.cameraUp(yaw: number, elevation: number): Vector3\n\tlocal se = math.sin(elevation)\n\treturn Vector3.new(-se * math.sin(yaw), math.cos(elevation), -se * math.cos(yaw))\nend\n\n-- SurfaceInput.tangent_axes: camera-relative right and forward on the plane with normal n.\nfunction CameraMath.tangentAxes(yaw: number, elevation: number, n: Vector3): (Vector3, Vector3)\n\tlocal normal = if n.Magnitude > 1e-5 then n.Unit else Vector3.new(0, 1, 0)\n\tlocal camRight = CameraMath.cameraRight(yaw, elevation)\n\tlocal camUp = CameraMath.cameraUp(yaw, elevation)\n\tlocal flatForward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))\n\tlocal pf = dirOn(flatForward, normal)\n\tlocal pu = dirOn(camUp, normal)\n\tlocal w = smoothstep(FLOOR_BLEND_START, FLOOR_BLEND_END, math.abs(normal.Y))\n\tlocal forward = pf * w + pu * (1 - w)\n\tif forward:Dot(forward) < 1e-6 then\n\t\tlocal pr = dirOn(camRight, normal)\n\t\tif pr.Magnitude == 0 then\n\t\t\tpr = dirOn(Vector3.new(1, 0, 0), normal)\n\t\tend\n\t\tforward = normal:Cross(pr)\n\tend\n\tforward = dirOn(forward, normal)\n\tlocal right = forward:Cross(normal)\n\tright = if right.Magnitude > 1e-9 then right.Unit else right\n\tif right:Dot(camRight) < 0 then\n\t\tright = -right\n\tend\n\treturn right, forward\nend\n\n-- SurfaceInput.map_stick: x right, y forward, length kept (at most 1).\nfunction CameraMath.mapStick(x: number, y: number, yaw: number, elevation: number, n: Vector3): Vector3\n\tlocal length = math.sqrt(x * x + y * y)\n\tif not finite(length) or length < 1e-6 then\n\t\treturn Vector3.new(0, 0, 0)\n\tend\n\tif length > 1 then\n\t\tx, y = x / length, y / length\n\tend\n\tlocal right, forward = CameraMath.tangentAxes(yaw, elevation, n)\n\treturn right * x + forward * y\nend\n\n-- Spider-eye walking: forward is the gaze laid on the surface, right is its right on it.\nfunction CameraMath.mapStickEye(x: number, y: number, gaze: Vector3, bodyForward: Vector3, n: Vector3): Vector3\n\tlocal length = math.sqrt(x * x + y * y)\n\tif not finite(length) or length < 1e-6 then\n\t\treturn Vector3.new(0, 0, 0)\n\tend\n\tif length > 1 then\n\t\tx, y = x / length, y / length\n\tend\n\tlocal forward = gaze - n * gaze:Dot(n)\n\tif forward:Dot(forward) < 1e-6 then\n\t\tforward = bodyForward - n * bodyForward:Dot(n)\n\tend\n\tif forward:Dot(forward) < 1e-6 then\n\t\treturn Vector3.new(0, 0, 0)\n\tend\n\tforward = forward.Unit\n\tlocal right = forward:Cross(n).Unit\n\treturn right * x + forward * y\nend\n\n-- camera_rig._clamp_aim_pitch: the aim free-look range, and the whole view short of straight up or down.\nfunction CameraMath.clampAimPitch(value: number, elevation: number): number\n\tlocal limit = math.rad(CameraMath.AIM_VIEW_LIMIT_DEG)\n\tlocal low = math.max(math.rad(CameraMath.AIM_PITCH_MIN_DEG), elevation - limit)\n\tlocal high = math.min(math.rad(CameraMath.AIM_PITCH_MAX_DEG), elevation + limit)\n\treturn math.clamp(value, low, math.max(low, high))\nend\n\n-- camera_rig._effective_elevation: the player's pitch plus the auto-pitch, inside the automatic range.\nfunction CameraMath.effectiveElevation(elevation: number, offset: number): number\n\tlocal low = math.min(elevation, math.rad(CameraMath.MIN_AUTO_ELEVATION_DEG))\n\tlocal high = math.max(elevation, math.rad(CameraMath.MAX_ELEVATION_DEG))\n\treturn math.clamp(elevation + offset, low, high)\nend\n\n-- The yaw whose flat forward (-sin, 0, -cos) points along v.\nfunction CameraMath.yawOf(v: Vector3): number\n\treturn math.atan2(-v.X, -v.Z)\nend\n\n-- SpiderMotor.get_recenter_yaw: behind the heading on floors and undersides, toward the surface on walls.\nfunction CameraMath.recenterYaw(heading: Vector3, visualUp: Vector3, fallback: number): number\n\tlocal w = visualUp.Y * visualUp.Y\n\tlocal v = Vector3.new(heading.X, 0, heading.Z) * w + Vector3.new(-visualUp.X, 0, -visualUp.Z) * (1 - w)\n\tif v.Magnitude < 1e-3 then\n\t\treturn fallback\n\tend\n\treturn math.atan2(-v.X, -v.Z)\nend\n\nlocal function anyPerpendicular(v: Vector3): Vector3\n\tlocal other = if math.abs(v.Y) < 0.9 then Vector3.new(0, 1, 0) else Vector3.new(1, 0, 0)\n\treturn v:Cross(other).Unit\nend\n\n-- camera_rig._clamp_gaze: unit, and at least EYE_PITCH_LIMIT_DEG from the surface normal either way.\nfunction CameraMath.clampGaze(g: Vector3, up: Vector3, bodyForward: Vector3): Vector3\n\tif not (finite(g.X) and finite(g.Y) and finite(g.Z)) or g:Dot(g) < 1e-10 then\n\t\tg = bodyForward\n\tend\n\tg = g.Unit\n\tlocal tangent = g - up * g:Dot(up)\n\tif tangent:Dot(tangent) < 1e-8 then\n\t\ttangent = bodyForward - up * bodyForward:Dot(up)\n\t\tif tangent:Dot(tangent) < 1e-8 then\n\t\t\ttangent = anyPerpendicular(up)\n\t\tend\n\tend\n\ttangent = tangent.Unit\n\tlocal limit = math.rad(CameraMath.EYE_PITCH_LIMIT_DEG)\n\tlocal elev = math.clamp(math.asin(math.clamp(g:Dot(up), -1, 1)), -limit, limit)\n\treturn (tangent * math.cos(elev) + up * math.sin(elev)).Unit\nend\n\n-- Rodrigues rotation of v about unit axis k by angle a (right-handed).\nfunction CameraMath.rotate(v: Vector3, k: Vector3, a: number): Vector3\n\tlocal c, s = math.cos(a), math.sin(a)\n\treturn v * c + k:Cross(v) * s + k * (k:Dot(v) * (1 - c))\nend\n\n-- camera_rig._look_eye: yaw about the view's up (positive looks right), pitch about the view's right (positive looks down). Normally\n-- that up is the body's (`up`); with the level-horizon comfort switch (ROBLOX-49) the camera's own up (`turnUp`, from viewUp) is used\n-- instead, so the mouse and stick move the picture the way they look on screen. The gaze stays clamped against the body's up either way.\nfunction CameraMath.lookEye(gaze: Vector3, up: Vector3, yawRad: number, pitchRad: number, bodyForward: Vector3, turnUp: Vector3?): Vector3\n\tlocal turn = turnUp or up\n\tlocal g = CameraMath.rotate(gaze, turn, -yawRad)\n\tlocal right = g:Cross(turn)\n\tif right:Dot(right) > 1e-10 then\n\t\tg = CameraMath.rotate(g, right.Unit, -pitchRad)\n\tend\n\treturn CameraMath.clampGaze(g, up, bodyForward)\nend\n\n-- camera_rig.view_up, the level-horizon comfort switch (T13a, ROBLOX-49): the spider-eye picture's up for the gaze `gaze` is the world's up\n-- laid square to the gaze, so the picture never rolls on a wall or an underside. Looking nearly straight up or down, where the world's up\n-- says little about roll, it holds `held` (the up it last had; falling back to the body's up, then any perpendicular). Returns a unit vector\n-- square to `gaze`. Without the switch the caller uses the body's up and keeps it as `held`.\nlocal LEVEL_FROM, LEVEL_TO = 0.1, 0.35 -- how much of the world's up shows in the gaze's square (length) before it takes over, and fully does\nfunction CameraMath.viewUp(gaze: Vector3, bodyUp: Vector3, held: Vector3): Vector3\n\tlocal g = gaze\n\tlocal world = Vector3.new(0, 1, 0) - g * g:Dot(Vector3.new(0, 1, 0))\n\tlocal keep = held - g * g:Dot(held)\n\tif keep:Dot(keep) < 1e-6 then keep = bodyUp - g * g:Dot(bodyUp) end\n\tif keep:Dot(keep) < 1e-6 then keep = anyPerpendicular(g) end\n\tlocal w = smoothstep(LEVEL_FROM, LEVEL_TO, world.Magnitude)\n\tlocal v = (if w > 0 then world.Unit * w else Vector3.zero) + keep.Unit * (1 - w)\n\tif v:Dot(v) < 1e-6 then v = keep end\n\treturn v.Unit\nend\n\nreturn CameraMath\n",12417,1988097614},{"Shared/Movement/FocusState","--!strict\n-- D-041: toggle is optional, grounded only, and Cancel belongs to other actions first.\nlocal Focus = {}\nFocus.__index = Focus\nfunction Focus.new(): any return setmetatable({latched=false}, Focus) end\nfunction Focus.press(self: any, toggle: boolean, grounded: boolean)\n\tif toggle and grounded then self.latched = not self.latched end\nend\nfunction Focus.active(self: any, held: boolean, toggle: boolean, grounded: boolean): boolean\n\tif not grounded or not toggle then self.latched = false end\n\treturn grounded and (if toggle then self.latched else held)\nend\nfunction Focus.cancel(self: any, busy: boolean)\n\tif not busy then self.latched = false end\nend\nfunction Focus.clear(self: any) self.latched = false end\nreturn Focus\n",732,1839071490},{"Shared/Movement/InputState","--!strict\n-- Pure input state: test without Studio. +Y is forward on the control pad; look +X is right, +Y is down\n-- (the Godot camera rig's convention: look(dx, dy) with dy > 0 looking down).\n-- A button action can be held by several sources at once: a key, a controller button, a finger on a touch button. It is\n-- held while any of them is down, so keyboard, controller and touch work together and releasing one never cancels another\n-- (ROBLOX-08). set() returns the held state before and after, so callers act once per press and once per release.\nlocal InputState = {}\nInputState.__index = InputState\n\nlocal MOVE_DEAD = 0.2\nlocal LOOK_DEAD = 0.15\n\nexport type InputState = typeof(setmetatable({} :: {\n\theld: { [string]: boolean? },\n\tsources: { [string]: { [any]: boolean } },\n\tx: number,\n\ty: number,\n\tlx: number,\n\tly: number,\n}, InputState))\n\nfunction InputState.new(): InputState\n\treturn setmetatable({ held = {}, sources = {}, x = 0, y = 0, lx = 0, ly = 0 }, InputState)\nend\n\n-- One source's state of an action (source nil: a single default source). Returns (held before, held now).\nfunction InputState.set(self: InputState, action: string, down: boolean, source: any?): (boolean, boolean)\n\tlocal key: any = if source == nil then \"default\" else source\n\tlocal was = self.held[action] == true\n\tlocal set = self.sources[action]\n\tif down then\n\t\tif not set then\n\t\t\tset = {}\n\t\t\tself.sources[action] = set\n\t\tend\n\t\tset[key] = true\n\telseif set then\n\t\tset[key] = nil\n\tend\n\tlocal now = set ~= nil and next(set) ~= nil\n\tself.held[action] = if now then true else nil\n\treturn was, now\nend\n\n-- How many sources hold the action now.\nfunction InputState.count(self: InputState, action: string): number\n\tlocal n = 0\n\tlocal set: { [any]: boolean } = self.sources[action] or {}\n\tfor _ in set do\n\t\tn += 1\n\tend\n\treturn n\nend\n\nlocal function radial(x: number, y: number, dead: number): (number, number)\n\tlocal length = math.sqrt(x * x + y * y)\n\tlocal strength = math.clamp((length - dead) / (1 - dead), 0, 1)\n\tif length <= 0 then return 0, 0 end\n\treturn x / length * strength, y / length * strength\nend\nfunction InputState.stick(self: InputState, x: number, y: number)\n\tself.x, self.y = radial(x, y, MOVE_DEAD)\nend\n-- Right stick: Roblox reports +Y up; store it as look-down positive.\nfunction InputState.look(self: InputState, x: number, y: number)\n\tlocal rx, ry = radial(x, y, LOOK_DEAD)\n\tself.lx, self.ly = rx, -ry\nend\nfunction InputState.axes(self: InputState): (number, number)\n\tlocal x = self.x + (if self.held.Right then 1 else 0) - (if self.held.Left then 1 else 0)\n\tlocal y = self.y + (if self.held.Forward then 1 else 0) - (if self.held.Back then 1 else 0)\n\tlocal length = math.max(1, math.sqrt(x * x + y * y))\n\treturn x / length, y / length\nend\n-- Look rate in -1..1 per axis: right stick plus arrow keys.\nfunction InputState.lookAxes(self: InputState, aiming: boolean?): (number, number)\n\tlocal x = self.lx + (if aiming then self.x else 0) + (if self.held.LookRight then 1 else 0) - (if self.held.LookLeft then 1 else 0)\n\tlocal y = self.ly - (if aiming then self.y else 0) + (if self.held.LookDown then 1 else 0) - (if self.held.LookUp then 1 else 0)\n\treturn math.clamp(x, -1, 1), math.clamp(y, -1, 1)\nend\n-- Focus loss, the Roblox menu, a text box, a lost controller: nothing stays held.\nfunction InputState.clear(self: InputState)\n\ttable.clear(self.held)\n\ttable.clear(self.sources)\n\tself.x, self.y, self.lx, self.ly = 0, 0, 0, 0\nend\nreturn InputState\n",3450,100955075},{"Shared/Movement/InspectView","--!strict\n-- Inspect mode's view, as numbers (ROBLOX-90): an orbit of the spider by yaw, elevation and distance in body-lengths, the auto-orbit when the player is\n-- idle, the zoom (wheel, stick, pinch), the three preset framings and the 0.8 s ease. Pure, so tests/inspect.luau checks the numbers without Roblox; Client/SpiderCamera turns a\n-- state into a camera (it adds the spider's position, up, heading and drawn length, and casts the boom against the sill).\n--\n-- Yaw is measured round the spider's own up, from its forward direction: 0 is the camera in front of the spider (the face), 90 on its right,\n-- 180 behind it, 270 on its left. A look to the right (dx > 0) moves the camera toward the spider's right, as the game's own orbit does,\n-- and a look down (dy > 0) lifts it, so the inversion settings mean what they always have.\nlocal InspectView = {}\n\nInspectView.HOLD_SECONDS = 0.6 -- holding the choose key or button this long (while resting awake in the crack) starts the view\nInspectView.EASE_SECONDS = 0.8 -- into the view, and back out of it (the mating two-shot's own)\nInspectView.DISTANCE = 1.6 -- body-lengths from the spider where the view begins\nInspectView.ELEVATION_DEG = 20 -- ... and how far above the surface's plane (\"slightly above\")\nInspectView.AUTO_DEG_S = 10 -- the slow orbit, when the player is idle\nInspectView.AUTO_AFTER_SECONDS = 3 -- ... which is to say, once this long has gone by without a turn or a zoom (a new view counts as idle, so it begins at once)\nInspectView.ZOOM_MIN, InspectView.ZOOM_MAX = 1.1, 3.0 -- body-lengths\nInspectView.ZOOM_PER_SECOND = 1.0 -- body-lengths a second at a full push of the left stick (or W and S)\nInspectView.WHEEL_STEP = 0.88 -- one notch of the wheel is this share of the distance (the third-person camera's own)\nInspectView.ELEVATION_MIN_DEG, InspectView.ELEVATION_MAX_DEG = 4, 88\nInspectView.PRESET_EASE_SECONDS = 0.35 -- a preset framing is reached in about this long (an exponential approach, 95 percent of the way)\n\n-- The three preset framings, in the order the button cycles them: the face (in front, a little above, close, on the head), the side (on the\n-- right, low, the whole body) and from above (the top of the body, the head up the screen). `ahead` is how far in front of the body's middle the\n-- focus is, in body-lengths; every distance is within the zoom's range.\nInspectView.PRESETS = {\n\t{ id = \"face\", yawDeg = 0, elevDeg = 10, distance = 1.25, ahead = 0.3 },\n\t{ id = \"side\", yawDeg = 90, elevDeg = 6, distance = 1.8, ahead = 0 },\n\t{ id = \"top\", yawDeg = 180, elevDeg = 84, distance = 2.0, ahead = 0 },\n} :: { { id: string, yawDeg: number, elevDeg: number, distance: number, ahead: number } }\n\nexport type Goal = { yaw: number, elev: number, dist: number, ahead: number }\nexport type State = {\n\tyaw: number, elev: number, dist: number, ahead: number, -- degrees, degrees, body-lengths, body-lengths\n\tauto: boolean, -- the slow orbit may run (a framing held still, or the player's own view, switches it off until the player turns the view)\n\tidle: number, -- seconds since the player last turned, zoomed or pinched the view (the auto-orbit runs once this is AUTO_AFTER_SECONDS)\n\tpreset: number, -- 0 or the index of the preset last chosen\n\tgoal: Goal?, -- a preset still being reached\n}\n\nlocal function wrap(deg: number): number\n\treturn (deg + 180) % 360 - 180\nend\n\n-- A view at this yaw: 1.6 body-lengths away, 20 degrees up, orbiting slowly (nobody has touched it yet).\nfunction InspectView.new(yawDeg: number): State\n\treturn { yaw = wrap(yawDeg), elev = InspectView.ELEVATION_DEG, dist = InspectView.DISTANCE, ahead = 0, auto = true, idle = InspectView.AUTO_AFTER_SECONDS, preset = 0, goal = nil }\nend\n\n-- The yaw (degrees) of a camera at `offset` from the focus, for a spider whose forward and right are given (any length, in its plane).\nfunction InspectView.yawOf(offset: Vector3, forward: Vector3, right: Vector3): number\n\treturn math.deg(math.atan2(offset:Dot(right), offset:Dot(forward)))\nend\n\n-- The player's own turn of the view, in degrees (dx right, dy down): the auto-orbit waits AUTO_AFTER_SECONDS after the last of it (and is allowed again if a framing\n-- had stopped it), and a preset on its way is cancelled.\nfunction InspectView.orbit(s: State, dxDeg: number, dyDeg: number)\n\tif dxDeg == 0 and dyDeg == 0 then return end\n\ts.auto, s.idle, s.goal = true, 0, nil\n\ts.yaw = wrap(s.yaw + dxDeg)\n\ts.elev = math.clamp(s.elev + dyDeg, InspectView.ELEVATION_MIN_DEG, InspectView.ELEVATION_MAX_DEG)\nend\n\nlocal function clampZoom(d: number): number\n\treturn math.clamp(d, InspectView.ZOOM_MIN, InspectView.ZOOM_MAX)\nend\n\n-- A step of the distance in body-lengths (negative: closer). The player is not idle while zooming, so the auto-orbit waits, but a framing's hold is not lifted.\nfunction InspectView.zoomBy(s: State, delta: number)\n\tif delta == 0 then return end\n\ts.goal, s.idle = nil, 0\n\ts.dist = clampZoom(s.dist + delta)\nend\n\n-- One notch of the wheel: `up` is a wheel turned away from the player (closer).\nfunction InspectView.wheel(s: State, up: boolean)\n\ts.goal, s.idle = nil, 0\n\ts.dist = clampZoom(s.dist * (if up then InspectView.WHEEL_STEP else 1 / InspectView.WHEEL_STEP))\nend\n\n-- A pinch on a touch screen: `ratio` is how much further apart the two fingers are than a moment ago (above 1: spread, so closer; below 1: pinched, so further).\nfunction InspectView.pinch(s: State, ratio: number)\n\tif not (ratio > 0) or ratio == math.huge or ratio == 1 then return end\n\ts.goal, s.idle = nil, 0\n\ts.dist = clampZoom(s.dist / ratio)\nend\n\n-- The button: the next preset framing (face, side, top, face ...). The auto-orbit stops (a framing is held still until the player turns the view), and the view goes there. Returns its id.\nfunction InspectView.cycle(s: State): string\n\ts.preset = s.preset % #InspectView.PRESETS + 1\n\tlocal p = InspectView.PRESETS[s.preset]\n\ts.auto, s.idle = false, 0\n\ts.goal = { yaw = p.yawDeg, elev = p.elevDeg, dist = p.distance, ahead = p.ahead }\n\treturn p.id\nend\n\nfunction InspectView.presetId(s: State): string?\n\tlocal p = InspectView.PRESETS[s.preset]\n\treturn if p then p.id else nil\nend\n\n-- One frame: the auto-orbit, or a preset being reached. Reduced motion: no auto-orbit, and a preset is a cut.\nfunction InspectView.step(s: State, dt: number, reduced: boolean)\n\tlocal g = s.goal\n\tif g ~= nil then\n\t\tif reduced then\n\t\t\ts.yaw, s.elev, s.dist, s.ahead, s.goal = wrap(g.yaw), g.elev, g.dist, g.ahead, nil\n\t\t\treturn\n\t\tend\n\t\t-- 95 percent of the way in PRESET_EASE_SECONDS: exp(-k * seconds) = 0.05\n\t\tlocal k = 1 - math.exp(-3 * math.max(dt, 0) / InspectView.PRESET_EASE_SECONDS)\n\t\tlocal dyaw = wrap(g.yaw - s.yaw)\n\t\ts.yaw = wrap(s.yaw + dyaw * k)\n\t\ts.elev += (g.elev - s.elev) * k\n\t\ts.dist += (g.dist - s.dist) * k\n\t\ts.ahead += (g.ahead - s.ahead) * k\n\t\tif math.abs(dyaw) < 0.05 and math.abs(g.elev - s.elev) < 0.05 and math.abs(g.dist - s.dist) < 0.002 and math.abs(g.ahead - s.ahead) < 0.002 then\n\t\t\ts.yaw, s.elev, s.dist, s.ahead, s.goal = wrap(g.yaw), g.elev, g.dist, g.ahead, nil\n\t\tend\n\telseif s.auto and not reduced then\n\t\ts.idle += math.max(dt, 0)\n\t\tif s.idle >= InspectView.AUTO_AFTER_SECONDS then\n\t\t\ts.yaw = wrap(s.yaw + InspectView.AUTO_DEG_S * math.max(dt, 0))\n\t\tend\n\tend\nend\n\n-- The unit vector from the focus to the camera, for the spider's forward, right and up (unit vectors; right = forward x up).\nfunction InspectView.direction(s: State, forward: Vector3, right: Vector3, up: Vector3): Vector3\n\tlocal yaw, elev = math.rad(s.yaw), math.rad(s.elev)\n\treturn (forward * math.cos(yaw) * math.cos(elev) + right * math.sin(yaw) * math.cos(elev) + up * math.sin(elev)).Unit\nend\n\n-- The ease between the player's own camera and this view, 0 to 1: it moves toward 1 while the view is wanted and toward 0 when it is not,\n-- in EASE_SECONDS (0.8 s) from end to end. Reduced motion is a cut.\nfunction InspectView.ease(t: number, dt: number, wanted: boolean, reduced: boolean): number\n\tif reduced then return if wanted then 1 else 0 end\n\tlocal step = math.max(dt, 0) / InspectView.EASE_SECONDS\n\tlocal want = if wanted then 1 else 0\n\treturn math.clamp(t + math.clamp(want - t, -step, step), 0, 1)\nend\n\nfunction InspectView.smooth(k: number): number\n\treturn k * k * (3 - 2 * k)\nend\n\nreturn InspectView\n",8232,2544276687},{"Shared/Movement/JumpInput","--!strict\n-- Jump input: a port of the frozen Godot scripts/movement/jump_controller.gd (c87ce00, hold mode). Pure: the motor is passed\n-- in, so tests/run.luau checks the same rules without Roblox.\n--\n-- A tap of the jump button (Space, A, touch Jump) is a short hop forward. Holding it for HOLD_TICKS (0.15 s) starts aiming:\n-- the spider holds still and the landing patch shows the plan for whatever the screen centre is on. Releasing commits the\n-- plan the patch shows when it is reachable; on anything else nothing is launched and the reason flashes for FLASH_TICKS.\n-- Cancel (Q, B, touch Cancel) leaves a press or an aim with no penalty. drop() is focus loss or the Roblox menu: an aim in\n-- progress ends quietly, so a button released while away can never leap later (Godot's _drop_input). Events are queued and\n-- applied at the start of the next fixed tick, so timing is counted in ticks and does not depend on the frame rate.\n-- `last` records the latest outcome for the HUD and tests: launched, cancelled, refused or hop_refused.\nlocal JumpInput = {}\nJumpInput.__index = JumpInput\n\nJumpInput.HOLD_TICKS = 9 -- math.max(1, math.ceil(0.15 * 60 - 1e-6)), as jump_controller._hold_ticks()\nJumpInput.FLASH_TICKS = 60\n\nexport type Phase = \"idle\" | \"pressed\" | \"aiming\"\n\nfunction JumpInput.new()\n\treturn setmetatable({\n\t\tphase = \"idle\" :: Phase,\n\t\theldTicks = 0,\n\t\tevents = {} :: { string },\n\t\tplan = nil :: any,\n\t\tflash = nil :: any,\n\t\tflashLeft = 0,\n\t\tlast = nil :: any,\n\t\ttick = 0,\n\t\tonAim = nil :: ((boolean) -> ())?,\n\t}, JumpInput)\nend\n\nfunction JumpInput.press(self: any) table.insert(self.events, \"press\") end\nfunction JumpInput.release(self: any) table.insert(self.events, \"release\") end\nfunction JumpInput.cancel(self: any) table.insert(self.events, \"cancel\") end\n\n-- Focus loss or the menu: forget queued presses and end an aim with no message (applied at once).\nfunction JumpInput.drop(self: any, motor: any)\n\ttable.clear(self.events)\n\tif self.phase == \"aiming\" then\n\t\tif motor then motor:cancelPrepare() end\n\t\tself:_endAim(motor)\n\tend\n\tself.phase = \"idle\"\n\tself.heldTicks = 0\nend\n\nfunction JumpInput.isAiming(self: any): boolean return self.phase == \"aiming\" end\n-- True while a press or an aim is in progress: the cancel button belongs to it then.\nfunction JumpInput.isBusy(self: any): boolean return self.phase ~= \"idle\" end\n\nfunction JumpInput._record(self: any, kind: string, plan: any)\n\tself.last = { kind = kind, plan = plan, tick = self.tick }\nend\n\nfunction JumpInput._flash(self: any, plan: any)\n\tif plan ~= nil and plan.kind ~= \"none\" then\n\t\tself.flash = plan\n\t\tself.flashLeft = JumpInput.FLASH_TICKS\n\tend\nend\n\nfunction JumpInput._setAiming(self: any, on: boolean)\n\tlocal f = self.onAim\n\tif f then f(on) end\nend\n\nfunction JumpInput._endAim(self: any, motor: any)\n\tself.phase = \"idle\"\n\tself.heldTicks = 0\n\tself.plan = nil\n\tif motor then motor:clearAimTarget() end\n\tself:_setAiming(false)\nend\n\nfunction JumpInput._beginAim(self: any, motor: any)\n\tif not motor:beginPrepare() then\n\t\tself.phase = \"idle\"\n\t\treturn\n\tend\n\tself.phase = \"aiming\"\n\tself.plan = nil\n\tself:_setAiming(true)\n\tself.plan = motor:aimPlan()\nend\n\n-- Commit the plan the patch is showing; anything not reachable is refused, with its reason, and launches nothing.\nfunction JumpInput._confirm(self: any, motor: any)\n\tlocal shown = self.plan or motor:aimPlan() -- exactly what the patch showed at the last tick\n\tif shown ~= nil and shown.kind == \"reachable\" and motor:commit(shown) then\n\t\tself:_endAim(motor)\n\t\tself:_record(\"launched\", shown)\n\t\treturn\n\tend\n\tself:_flash(shown)\n\tmotor:cancelPrepare()\n\tself:_endAim(motor)\n\tself:_record(\"refused\", shown)\nend\n\nfunction JumpInput._hop(self: any, motor: any)\n\tlocal hop = motor:hopPlan()\n\tif hop ~= nil and hop.kind == \"reachable\" and motor:beginPrepare() then\n\t\tif motor:commit(hop) then\n\t\t\tself:_record(\"launched\", hop)\n\t\t\treturn\n\t\tend\n\t\tmotor:cancelPrepare()\n\tend\n\tself:_flash(hop)\n\tself:_record(\"hop_refused\", hop)\nend\n\n-- One fixed tick: apply the queued events, then count the hold and keep the aim's plan current.\nfunction JumpInput.step(self: any, motor: any)\n\tself.tick += 1\n\tlocal queued = self.events\n\tself.events = {}\n\tfor _, e in queued do\n\t\tif e == \"press\" then\n\t\t\tif self.phase == \"idle\" and motor:canPrepare() then\n\t\t\t\tself.phase = \"pressed\"\n\t\t\t\tself.heldTicks = 0\n\t\t\tend\n\t\telseif e == \"release\" then\n\t\t\tif self.phase == \"pressed\" then\n\t\t\t\tself.phase = \"idle\"\n\t\t\t\tself:_hop(motor)\n\t\t\telseif self.phase == \"aiming\" then\n\t\t\t\tself:_confirm(motor)\n\t\t\tend\n\t\telseif e == \"cancel\" then\n\t\t\tif self.phase == \"pressed\" then\n\t\t\t\tself.phase = \"idle\"\n\t\t\t\tself:_record(\"cancelled\", nil)\n\t\t\telseif self.phase == \"aiming\" then\n\t\t\t\tmotor:cancelPrepare()\n\t\t\t\tself:_endAim(motor)\n\t\t\t\tself:_record(\"cancelled\", nil)\n\t\t\tend\n\t\tend\n\tend\n\tif self.flashLeft > 0 then\n\t\tself.flashLeft -= 1\n\t\tif self.flashLeft == 0 then self.flash = nil end\n\tend\n\tif self.phase == \"pressed\" then\n\t\tif not motor:canPrepare() then\n\t\t\tself.phase = \"idle\"\n\t\telse\n\t\t\tself.heldTicks += 1\n\t\t\tif self.heldTicks >= JumpInput.HOLD_TICKS then self:_beginAim(motor) end\n\t\tend\n\tend\n\tif self.phase == \"aiming\" then\n\t\tif motor:isPreparing() then\n\t\t\tself.plan = motor:aimPlan()\n\t\telse\n\t\t\tself:_endAim(motor) -- the spider lost its support, or was put somewhere else\n\t\tend\n\tend\nend\n\nreturn JumpInput\n",5289,1004393295},{"Shared/Movement/JumpMath","--!strict\n-- Port of scripts/movement/jump_math.gd (spec 6.3, 27). Pure math, no Instances, so it runs in tests/run.luau too.\n--\n-- The motor flies a committed jump with semi-implicit Euler at a fixed 60 Hz tick:\n--   v = v + g * dt, then p = p + v * dt.\n-- After n ticks from launch velocity v0 at p0 that gives, exactly,\n--   p_n = p0 + n * dt * v0 + g * dt^2 * n * (n + 1) / 2\n-- so the launch velocity is solved in this discrete form, not with the continuous 0.5 * g * T^2.\n\nlocal JumpMath = {}\n\n-- Matches SurfaceProfile.STAND_MAX_DEG.\nJumpMath.STAND_MAX_DEG = 45.0\nJumpMath.MIN_LAUNCH_NORMAL_SPEED = 0.05\nJumpMath.STAND_APPROACH_MIN = 0.05\nJumpMath.LAND_APPROACH_MIN = 0.3\n\nlocal UP = Vector3.new(0, 1, 0)\n\nlocal function finite(x: number): boolean\n\treturn x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal function finiteVec(v: Vector3): boolean\n\treturn finite(v.X) and finite(v.Y) and finite(v.Z)\nend\n\nexport type Solution = {\n\tsteps: number,\n\tduration: number,\n\tvelocity: Vector3,\n\tspeed: number,\n\tarrivalVelocity: Vector3,\n\tapproach: number,\n}\n\nexport type SolveResult = {\n\tvalid: { Solution },\n\treason: string, -- \"ok\", \"no_durations\", \"too_far\", \"no_launch\", \"no_arrival\"\n\tminSpeed: number,\n}\n\n-- Tick counts n whose duration n * dt lies inside [tMin, tMax]. nMax < nMin when none fits.\nfunction JumpMath.stepRange(tMin: number, tMax: number, dt: number): (number, number)\n\tif not (finite(tMin) and finite(tMax) and finite(dt)) or dt <= 0 then\n\t\treturn 1, 0\n\tend\n\tlocal nMin = math.ceil(tMin / dt - 1e-6)\n\tlocal nMax = math.floor(tMax / dt + 1e-6)\n\treturn math.max(nMin, 1), nMax\nend\n\nfunction JumpMath.positionAfter(p0: Vector3, v0: Vector3, g: Vector3, dt: number, n: number): Vector3\n\treturn p0 + v0 * (n * dt) + g * (dt * dt * n * (n + 1) * 0.5)\nend\n\nfunction JumpMath.velocityAfter(v0: Vector3, g: Vector3, dt: number, n: number): Vector3\n\treturn v0 + g * (dt * n)\nend\n\nfunction JumpMath.launchVelocity(p0: Vector3, seat: Vector3, g: Vector3, dt: number, n: number): Vector3\n\treturn (seat - p0 - g * (dt * dt * n * (n + 1) * 0.5)) / (n * dt)\nend\n\n-- Body-centre positions p_0 .. p_steps by repeated ticks, in the order the motor does them.\nfunction JumpMath.path(p0: Vector3, v0: Vector3, g: Vector3, dt: number, steps: number): { Vector3 }\n\tlocal out = { p0 }\n\tlocal v, p = v0, p0\n\tfor _ = 1, steps do\n\t\tv += g * dt\n\t\tp += v * dt\n\t\ttable.insert(out, p)\n\tend\n\treturn out\nend\n\nfunction JumpMath.isStanding(normal: Vector3): boolean\n\tif not finiteVec(normal) or normal:Dot(normal) < 1e-10 then\n\t\treturn false\n\tend\n\treturn normal.Unit:Dot(UP) >= math.cos(math.rad(JumpMath.STAND_MAX_DEG)) - 1e-6\nend\n\nfunction JumpMath.minApproach(targetNormal: Vector3): number\n\treturn if JumpMath.isStanding(targetNormal) then JumpMath.STAND_APPROACH_MIN else JumpMath.LAND_APPROACH_MIN\nend\n\n-- Every launch solution for a landing seat, one per allowed whole-tick duration, filtered by the launch speed limit,\n-- by leaving the launch surface and by arriving into the target fast enough. Sorted by speed, lowest first.\nfunction JumpMath.solve(\n\tp0: Vector3,\n\tseat: Vector3,\n\tlaunchNormal: Vector3,\n\ttargetNormal: Vector3,\n\tg: Vector3,\n\tdt: number,\n\ttMin: number,\n\ttMax: number,\n\tmaxSpeed: number\n): SolveResult\n\tlocal valid: { Solution } = {}\n\tlocal nMin, nMax = JumpMath.stepRange(tMin, tMax, dt)\n\tlocal minSpeed = math.huge\n\tlocal anySpeedOk, anyLaunchOk = false, false\n\tlocal need = JumpMath.minApproach(targetNormal)\n\tfor n = nMin, nMax do\n\t\tlocal v0 = JumpMath.launchVelocity(p0, seat, g, dt, n)\n\t\tif finiteVec(v0) then\n\t\t\tlocal speed = v0.Magnitude\n\t\t\tminSpeed = math.min(minSpeed, speed)\n\t\t\tif speed <= maxSpeed then\n\t\t\t\tanySpeedOk = true\n\t\t\t\tif v0:Dot(launchNormal) >= JumpMath.MIN_LAUNCH_NORMAL_SPEED then\n\t\t\t\t\tanyLaunchOk = true\n\t\t\t\t\tlocal arrival = JumpMath.velocityAfter(v0, g, dt, n)\n\t\t\t\t\tlocal approach = -arrival:Dot(targetNormal)\n\t\t\t\t\tif approach >= need then\n\t\t\t\t\t\ttable.insert(valid, {\n\t\t\t\t\t\t\tsteps = n,\n\t\t\t\t\t\t\tduration = n * dt,\n\t\t\t\t\t\t\tvelocity = v0,\n\t\t\t\t\t\t\tspeed = speed,\n\t\t\t\t\t\t\tarrivalVelocity = arrival,\n\t\t\t\t\t\t\tapproach = approach,\n\t\t\t\t\t\t})\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\ttable.sort(valid, function(a: Solution, b: Solution): boolean\n\t\tif math.abs(a.speed - b.speed) > 1e-9 then\n\t\t\treturn a.speed < b.speed\n\t\tend\n\t\treturn a.steps < b.steps\n\tend)\n\tlocal reason = \"ok\"\n\tif #valid == 0 then\n\t\tif nMax < nMin then\n\t\t\treason = \"no_durations\"\n\t\telseif not anySpeedOk then\n\t\t\treason = \"too_far\"\n\t\telseif not anyLaunchOk then\n\t\t\treason = \"no_launch\"\n\t\telse\n\t\t\treason = \"no_arrival\"\n\t\tend\n\tend\n\treturn { valid = valid, reason = reason, minSpeed = minSpeed }\nend\n\nreturn JumpMath\n",4603,2988356167},{"Shared/Movement/LineFraming","--!strict\n-- The camera's line framing at a catch: a port of the frozen Godot camera_rig.gd (c87ce00; A-017, chunk 6A, capped in 6B).\n-- While the spider hangs on its line and the player's own view has no room where the spider will hang (the line's rest\n-- point, so the view does not chase the swing), the view turns by the smallest turn, in 15-degree steps either way, that\n-- gives a comfortable boom with a clear sight of the spider and of the lip the line leaves its support at. The turn is\n-- added to the player's yaw (the view yaw); the player's own yaw is untouched. It never exceeds 45 degrees\n-- (FRAMING_MAX_TURN_DEG), eases in over about 0.12 s, never rolls the view, and is cast like any other boom.\n-- The player always wins: any look input, a recenter or aiming takes the turn over at once (it becomes the player's own\n-- yaw, so nothing moves on screen) and the framing stays off until the line ends. When the line ends the view stays where\n-- the framing left it. Pure: the world queries are behind `good(turn)`, so tests check the decisions against values\n-- exported from Godot (tests/framing_reference.json) and Studio checks the geometry (tests/studio/CameraSpec.luau).\nlocal CameraMath = require(script.Parent.CameraMath)\n\nlocal LineFraming = {}\nLineFraming.__index = LineFraming\n\nLineFraming.ASSIST_STEP_DEG = 15.0\nLineFraming.FRAMING_MAX_TURN_DEG = 45.0 -- Chet's cap (chunk 6B): was a half turn in 6A\nLineFraming.ASSIST_SMOOTH_SECONDS = 0.12\nLineFraming.SIGHT_TOLERANCE = 0.06 -- a ray that stops this short of its end still saw it\n\nfunction LineFraming.new(): any\n\treturn setmetatable({\n\t\tassist = 0, -- the turn added to the player's yaw now, radians\n\t\tprev = 0,\n\t\ttarget = 0, -- the turn wanted at the last tick\n\t\tvelocity = 0,\n\t\toff = false, -- the player turned the view since the line caught: no framing until it ends\n\t\tenabled = true, -- Godot's setting \"Frame the line after a catch\" (default on)\n\t\tmaxTurn = math.rad(LineFraming.FRAMING_MAX_TURN_DEG),\n\t}, LineFraming)\nend\n\nlocal SIDES = { 1, -1 } -- (+ before -; ROBLOX-113: one list, not a new one for every step of every search)\n\n-- camera_rig._wanted_yaw_assist: the turn already held while it still works (so the view does not flip as the rest point\n-- moves), else none when the player's own view works, else the smallest working step within the cap (+ before -),\n-- else none (nowhere works: the view is left to the pitch search).\nfunction LineFraming.wantedTurn(held: number, maxTurn: number, good: (number) -> boolean): number\n\tif held ~= 0 and good(held) then return held end\n\tif good(0) then return 0 end\n\tlocal step = math.rad(LineFraming.ASSIST_STEP_DEG)\n\tlocal k = 1\n\twhile k * step <= maxTurn + 1e-6 do\n\t\tfor _, side in SIDES do\n\t\t\tlocal turn = k * step * side\n\t\t\tif good(turn) then return turn end\n\t\tend\n\t\tk += 1\n\tend\n\treturn 0\nend\n\n-- The player takes the view: returns the turn to add to the player's own yaw, so nothing moves on screen.\nfunction LineFraming.takeOver(self: any): number\n\tif self.assist == 0 and self.prev == 0 and self.target == 0 then return 0 end\n\tlocal delta = self.assist\n\tself.assist, self.prev, self.target, self.velocity = 0, 0, 0, 0\n\treturn delta\nend\n\n-- A look or a recenter: the turn is taken over and, on the line, the framing stays off until the line ends.\nfunction LineFraming.playerTurns(self: any, onLine: boolean): number\n\tlocal delta = self:takeOver()\n\tif onLine then self.off = true end\n\treturn delta\nend\n\n-- One fixed tick (camera_rig._update_assist). Returns a change for the player's yaw: the held turn when the line has just\n-- ended (the view stays where it is), otherwise 0.\nfunction LineFraming.tick(self: any, onLine: boolean, aiming: boolean, wanted: () -> number, dt: number): number\n\tself.prev = self.assist\n\tif not onLine then\n\t\tself.off = false\n\t\treturn self:takeOver()\n\tend\n\tlocal w = 0\n\tif self.enabled and not self.off and not aiming then w = wanted() end\n\tself.target = w\n\tself.assist, self.velocity = CameraMath.smoothDamp(self.assist, w, self.velocity, LineFraming.ASSIST_SMOOTH_SECONDS, dt)\n\treturn 0\nend\n\n-- The setting: switched off while a turn is held, the view stays where it is (the turn becomes the player's).\nfunction LineFraming.setEnabled(self: any, on: boolean): number\n\tself.enabled = on\n\treturn if on then 0 else self:takeOver()\nend\n\n-- A snap (spawn, reset, leaving the eye view): no turn at all.\nfunction LineFraming.reset(self: any)\n\tself.assist, self.prev, self.target, self.velocity, self.off = 0, 0, 0, 0, false\nend\n\nreturn LineFraming\n",4513,3721325342},{"Shared/Movement/LockOn","--!strict\n-- Lock-on and the sidestep (ROBLOX-110). Nathan: \"a lock on so you can track prey without the visual cues and the ability to side step\".\n-- A jumping spider turns its body to keep a prey in its principal eyes and sidles round it, stalking; this is that, for the player.\n--\n-- What can be locked is only what the spider's own perception has: a contact in its memory (Perception/ObservationMemory) that an inspection\n-- has placed (hasPosition), live, or lost with its last-seen mark still good. Never the world's own list of things, so nothing hidden, never\n-- seen or only cued (a bearing without a place) can be locked. Which one a press takes: the one in the principal eyes now nearest the middle of\n-- the view (what the spider is looking at), else the nearest placed contact within `range` in front of the spider (within `frontDeg` of its\n-- facing). Anything the spider sees can be locked (the rival, the mate, the wasp, a fly): a lock is attention, not a promise of a meal.\n--\n-- A lock ends on a second press, on Cancel (when Cancel has nothing else to do), when the memory forgets the contact (sight lost for the\n-- memory's decay time, `memory_decay_s`, 6 s; the remembered spot looked at and found empty; the prey caught and eaten) or when the place it is\n-- believed to be is beyond `releaseRange`. While it holds, the place it follows is the contact's: where it is being seen, or where it was last\n-- seen once sight is lost (the mark never moves), so the lock never knows more than the spider does.\n--\n-- The sidestep: while locked, the left and right of the stick (A, D, the touch arrows) walk the spider round the locked thing at the distance it\n-- had when the stick's forward and back were last let go, and forward and back close or open that distance; it walks at the motor's own creep\n-- (salticids stalk slowly) and the motor keeps its body faced to the thing (SpiderMotor's `face`). The direction is worked out on the plane\n-- the spider stands on, from its own up, so it is the same on a floor, a wall and a leaf's underside.\n--\n-- The camera (Client/SpiderCamera.setLock) keeps the locked thing framed: the orbit turns to look past the spider at it, the eye view's gaze\n-- turns to it; eased, or under Reduced Motion held still and cut only when the thing has drifted `reducedCutDeg` from where the view would be.\n-- Pure: tests/lock.luau checks all of it without Roblox.\nlocal SupportMath = require(script.Parent.SupportMath)\nlocal CameraMath = require(script.Parent.CameraMath)\nlocal Observation = require(script.Parent.Parent.Perception.Observation)\n\nlocal LockOn = {}\n\n-- The game's own numbers (no Godot default is touched).\nLockOn.game = {\n\trange = 12.0, -- WU: a press locks only onto something placed within this of the spider\n\treleaseRange = 16.0, -- WU: a lock ends when the thing is believed farther than this\n\tlookingDeg = 20.0, -- a contact in the principal eyes within this of the middle of the view is the one \"looked at\"\n\tfrontDeg = 90.0, -- otherwise the nearest within this of the spider's facing\n\tminDistance = 0.9, -- WU, on the plane: forward stops closing here\n\tholdGain = 2.0, -- the pull back to the kept distance while circling, per WU of error (clamped to a full step)\n\tcameraRate = 5.0, -- 1/s: how fast the view turns to keep the thing framed\n\treducedCutDeg = 25.0, -- Reduced Motion: the view stays still until the thing is this far from where it would be, then cuts\n}\n\nexport type State = { trackId: string?, keep: number, point: Vector3?, released: string? }\n\nfunction LockOn.new(): State\n\treturn { trackId = nil, keep = 0, point = nil, released = nil }\nend\n\n-- A contact a lock may take or keep: placed by an inspection, and live, or lost with its mark still good.\nfunction LockOn.lockable(c: any): boolean\n\tif c == nil or not c.hasPosition then return false end\n\tif c.state == \"live\" then return true end\n\treturn c.state == \"lost\" and c.markValid == true\nend\n\nlocal function angleBetween(a: Vector3, b: Vector3): number\n\tif a.Magnitude < 1e-6 or b.Magnitude < 1e-6 then return math.pi end\n\treturn math.acos(math.clamp(a.Unit:Dot(b.Unit), -1, 1))\nend\n\n-- The contact a press would lock now, or nil. `eye`: the spider's eyes; `heading`: its facing; `viewOrigin`, `viewDir`: the middle of the view\n-- (the camera's centre ray). Only the memory's contacts are looked at.\nfunction LockOn.pick(memory: any, eye: Vector3, heading: Vector3, viewOrigin: Vector3, viewDir: Vector3): any\n\tlocal g = LockOn.game\n\tlocal looked, lookedAngle = nil, math.rad(g.lookingDeg)\n\tlocal nearest, nearestD = nil, g.range\n\tfor _, c in memory:contacts() do\n\t\tif LockOn.lockable(c) then\n\t\t\tlocal to = c.position - eye\n\t\t\tlocal d = to.Magnitude\n\t\t\tif d <= g.range then\n\t\t\t\tif c.state == \"live\" and c.modality == Observation.INSPECTION then\n\t\t\t\t\tlocal a = angleBetween(viewDir, c.position - viewOrigin)\n\t\t\t\t\tif a <= lookedAngle then looked, lookedAngle = c, a end\n\t\t\t\tend\n\t\t\t\tif d <= nearestD and angleBetween(heading, to) <= math.rad(g.frontDeg) then nearest, nearestD = c, d end\n\t\t\tend\n\t\tend\n\tend\n\treturn looked or nearest\nend\n\n-- The spider's distance to a point on the plane it stands on (up `up`).\nfunction LockOn.planar(pos: Vector3, up: Vector3, point: Vector3): number\n\tlocal d = point - pos\n\treturn (d - up * d:Dot(up)).Magnitude\nend\n\n-- A press of the lock: releases a lock that holds (\"released\"), else locks what pick() gives (\"locked\"), else does nothing (\"none\": the caller\n-- recentres then, on the keys that are also Recentre).\nfunction LockOn.press(s: State, memory: any, pos: Vector3, up: Vector3, eye: Vector3, heading: Vector3, viewOrigin: Vector3, viewDir: Vector3): string\n\tif s.trackId ~= nil then\n\t\tLockOn.release(s, \"pressed\")\n\t\treturn \"released\"\n\tend\n\tlocal c = LockOn.pick(memory, eye, heading, viewOrigin, viewDir)\n\tif c == nil then return \"none\" end\n\ts.trackId, s.point, s.released = c.trackId, c.position, nil\n\ts.keep = math.max(LockOn.planar(pos, up, c.position), LockOn.game.minDistance)\n\treturn \"locked\"\nend\n\nfunction LockOn.release(s: State, why: string)\n\tif s.trackId == nil then return end\n\ts.trackId, s.point, s.released = nil, nil, why\nend\n\n-- Each tick, after the sensor: the lock's point now, or nil when there is none (and why it ended, in s.released).\nfunction LockOn.update(s: State, memory: any, pos: Vector3): Vector3?\n\tlocal id = s.trackId\n\tif id == nil then return nil end\n\tlocal c = memory:getContact(id)\n\tif c == nil then LockOn.release(s, \"forgotten\"); return nil end\n\tif not LockOn.lockable(c) then LockOn.release(s, \"empty\"); return nil end\n\tif (c.position - pos).Magnitude > LockOn.game.releaseRange then LockOn.release(s, \"range\"); return nil end\n\ts.point = c.position\n\treturn s.point\nend\n\n-- The sidestep: the walking direction on the plane of up `up` for the stick (r right, f forward) while locked on `target`, and the distance kept\n-- from now on. Zero when the stick is idle. r circles the target at the kept distance (pulled back to it by holdGain); f closes or opens it, and\n-- the distance it leaves when let go is the one kept.\nfunction LockOn.strafe(pos: Vector3, up: Vector3, target: Vector3, keep: number, r: number, f: number): (Vector3, number)\n\tlocal g = LockOn.game\n\tlocal d = target - pos\n\tlocal planar = d - up * d:Dot(up)\n\tlocal dist = planar.Magnitude\n\tif math.abs(r) < 1e-3 and math.abs(f) < 1e-3 then return Vector3.zero, keep end\n\tif dist < 1e-3 then return Vector3.zero, keep end\n\tlocal toward = planar / dist\n\tlocal right = toward:Cross(up)\n\tlocal radial = f\n\tif math.abs(f) >= 1e-3 then\n\t\tkeep = math.max(dist, g.minDistance)\n\t\tif f > 0 and dist <= g.minDistance then radial = 0 end\n\telse\n\t\tradial = math.clamp((dist - keep) * g.holdGain, -1, 1)\n\tend\n\tlocal w = right * r + toward * radial\n\tif w.Magnitude < 1e-4 then return Vector3.zero, keep end\n\treturn w.Unit, keep\nend\n\n-- The orbit camera's yaw and elevation (CameraMath's: back direction (sin yaw cos e, sin e, cos yaw cos e)) that look from behind the pivot\n-- at the target, the elevation lifted by the game's default so a thing level with the spider is seen over it. nil when they coincide.\nfunction LockOn.orbitGoal(pivot: Vector3, target: Vector3): (number?, number?)\n\tlocal f = target - pivot\n\tif f.Magnitude < 1e-3 then return nil, nil end\n\tf = f.Unit\n\tlocal flat = Vector3.new(f.X, 0, f.Z)\n\tif flat.Magnitude < 1e-3 then return nil, nil end\n\tlocal yaw = math.atan2(-f.X, -f.Z)\n\tlocal elev = math.rad(CameraMath.DEFAULT_ELEVATION_DEG) - math.asin(math.clamp(f.Y, -1, 1))\n\treturn yaw, math.clamp(elev, math.rad(CameraMath.MIN_ELEVATION_DEG), math.rad(CameraMath.MAX_ELEVATION_DEG))\nend\n\nlocal function wrap(a: number): number\n\treturn (a + math.pi) % (2 * math.pi) - math.pi\nend\n\n-- One frame of the orbit's follow: eased toward the goal, or (Reduced Motion) unchanged until either angle is reducedCutDeg off, then the goal.\nfunction LockOn.followOrbit(yaw: number, elev: number, goalYaw: number, goalElev: number, dt: number, reduced: boolean): (number, number)\n\tlocal dy, de = wrap(goalYaw - yaw), goalElev - elev\n\tif reduced then\n\t\tlocal cut = math.rad(LockOn.game.reducedCutDeg)\n\t\tif math.abs(dy) > cut or math.abs(de) > cut then return yaw + dy, goalElev end\n\t\treturn yaw, elev\n\tend\n\tlocal k = 1 - math.exp(-LockOn.game.cameraRate * dt)\n\treturn yaw + dy * k, elev + de * k\nend\n\n-- One frame of the eye view's follow: the gaze turned toward `want` (both unit), eased, or cut under Reduced Motion as the orbit is.\nfunction LockOn.followGaze(gaze: Vector3, want: Vector3, dt: number, reduced: boolean): Vector3\n\tlocal off = angleBetween(gaze, want)\n\tif reduced then\n\t\treturn if off > math.rad(LockOn.game.reducedCutDeg) then want else gaze\n\tend\n\tlocal k = 1 - math.exp(-LockOn.game.cameraRate * dt)\n\treturn SupportMath.rotateToward(gaze, want, off * k)\nend\n\nreturn LockOn\n",9753,3272461534},{"Shared/Movement/SilkController","--!strict\n-- Engine adapter for the frozen safety line. One local-space anchor, at most one bend.\n-- Fixed ticks only. The client owns ordinary walking/jumps; this owns locked-line movement.\nlocal Math = require(script.Parent.TetherMath)\nlocal Silk = {}\nSilk.__index = Silk\nlocal HEIGHT, RADIUS = 0.31, 0.30\nlocal DOWN = Vector3.new(0,-1,0)\n-- The game's own rule (ROBLOX-99), opt-in like NeedsModel.game and Data/Catch.game: how fast the spider lets itself down a line, as a share of Godot's\n-- reel speed (Species silk.reel_speed_wu_s, 1.5 studs a second either way). Nathan: \"make the hang just go slower by default\". Lowering (the stick back, or\n-- the drop key held) runs at `lowerScale` of it; reeling in keeps Godot's speed, so the climb back is as brisk as it was and the rig's head-up climb\n-- (look.hang.climb.speed) still trips. A controller never given the rule (Silk:useGameRules) replays Godot: the tether goldens and the box-world scenarios.\n-- ROBLOX-96: and how long a line may be. Godot's 20 studs (silk.max_line_length_wu) was never reached on the sill; the garden's first set piece is the let-down from\n-- the outer sill's front edge to the bed, 90 studs of brick, so the game's line is `maxLine` studs (a game value: jumping spiders do descend on draglines far\n-- farther than their body length, but no measured length is claimed here). Everything else about the line (the slack, the hang, the release) is Godot's.\nSilk.game = { lowerScale = 0.5, maxLine = 100 }\n\n-- ROBLOX-111: what the line did, counted for the self-test (a Studio run cannot be stepped through): the ticks on the line, how much line was let out\n-- and how far the body fell, the sweeps that stopped a move and what they took off it, the tangent touches let pass, and the push-outs of the skin. Never reset\n-- (a reader takes a copy and the difference); nothing reads it to decide anything.\nfunction Silk.newStats()\n\treturn { ticks = 0, letOut = 0, fell = 0, stops = 0, stopped = 0, grazes = 0, pushes = 0, pushed = 0, pushedUp = 0 }\nend\nfunction Silk.new(world, surfaces, tuning, gravity: number)\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Include\n\tparams.FilterDescendantsInstances = {world}\n\tlocal overlap = OverlapParams.new()\n\toverlap.FilterType = Enum.RaycastFilterType.Include\n\toverlap.FilterDescendantsInstances = {world}\n\treturn setmetatable({world=world, surfaces=surfaces, params=params, overlap=overlap, maximum=tuning.max_line_length_wu,\n\t\tspeed=tuning.reel_speed_wu_s, lowerSpeed=tuning.reel_speed_wu_s, gravity=gravity, mode=\"none\", paid=0, rest=0, taut=false,\n\t\tanchor=Vector3.zero, normal=Vector3.yAxis, anchorPart=nil, bend=nil, bendPart=nil,\n\t\tlowering=false, snagged=false, block=\"\", message=\"\", release=Math.newRelease(), walk=nil,\n\t\tprevious=Vector3.zero, stats=Silk.newStats()},Silk)\nend\n-- Opt in to the game's lowering (Silk.game): the let-down at lowerScale of the reel speed. Reeling in is untouched.\nfunction Silk.useGameRules(self: any)\n\tself.lowerSpeed = self.speed * Silk.game.lowerScale\n\tself.maximum = Silk.game.maxLine\nend\nfunction Silk.profile(self: any, hit)\n\treturn if hit then self.surfaces[hit.Instance:GetAttribute(\"ProfileId\")] else nil\nend\nfunction Silk.clear(self: any)\n\tself.mode=\"none\"; self.anchorPart=nil; self.bend=nil; self.bendPart=nil\n\tself.paid=0; self.rest=0; self.taut=false; self.lowering=false; self.snagged=false; self.block=\"\"\n\tself.walk=nil; self.release=Math.newRelease()\n\tself.message=\"\"\nend\nfunction Silk.anchorAt(self: any, hit, position: Vector3): boolean\n\tself:clear()\n\tlocal profile=self:profile(hit)\n\tif not profile or not profile.silk_anchor_allowed or not hit.Instance:IsA(\"BasePart\") then\n\t\tself.message=\"This surface cannot hold silk\"; return false\n\tend\n\tself.anchorPart=hit.Instance\n\tself.anchorLocal=hit.Instance.CFrame:PointToObjectSpace(hit.Position)\n\tself.normalLocal=hit.Instance.CFrame:VectorToObjectSpace(hit.Normal)\n\tself.anchor=hit.Position; self.normal=hit.Normal; self.previous=position\n\tself.mode=\"payout\"; self.rest=self.maximum; self.paid=math.min((position-self.anchor).Magnitude,self.maximum)\n\tself.message=\"Silk attached\"\n\treturn true\nend\nfunction Silk.pivot(self: any): Vector3 return self.bend or self.anchor end\nfunction Silk.prefix(self: any): number return if self.bend then (self.bend-self.anchor).Magnitude else 0 end\nfunction Silk.path(self: any, position: Vector3): number return self:prefix()+(position-self:pivot()).Magnitude end\nfunction Silk.refresh(self: any): boolean\n\tif not self.anchorPart or not self.anchorPart:IsDescendantOf(self.world) then\n\t\tself:clear(); self.message=\"Silk anchor lost\"; return false\n\tend\n\tself.anchor=self.anchorPart.CFrame:PointToWorldSpace(self.anchorLocal)\n\tself.normal=self.anchorPart.CFrame:VectorToWorldSpace(self.normalLocal)\n\tif self.bendPart then\n\t\tif self.bendPart:IsDescendantOf(self.world) then self.bend=self.bendPart.CFrame:PointToWorldSpace(self.bendLocal)\n\t\telse self.bend=nil; self.bendPart=nil end\n\tend\n\treturn true\nend\nfunction Silk.clearRay(self: any, a: Vector3, b: Vector3): boolean\n\tlocal d=b-a\n\treturn d.Magnitude<=0.02 or workspace:Raycast(a,d.Unit*(d.Magnitude-0.02),self.params)==nil\nend\nfunction Silk.geometry(self: any, position: Vector3)\n\tlocal a=self.anchor+self.normal*0.02\n\tif self:clearRay(a,position) then self.bend=nil; self.bendPart=nil; self.snagged=false\n\telseif self.bend then self.snagged=not self:clearRay(self.bend,position)\n\telseif self:clearRay(a,self.previous) then\n\t\tlocal lo,hi=0,1\n\t\tfor _=1,12 do\n\t\t\tlocal mid=(lo+hi)*0.5\n\t\t\tif self:clearRay(a,self.previous:Lerp(position,mid)) then lo=mid else hi=mid end\n\t\tend\n\t\tlocal hit=workspace:Raycast(a,self.previous:Lerp(position,hi)-a,self.params)\n\t\tself.snagged=true\n\t\tif hit and hit.Instance:IsA(\"BasePart\") then\n\t\t\tlocal side=position-hit.Position\n\t\t\tside-=hit.Normal*side:Dot(hit.Normal)\n\t\t\tif side.Magnitude>1e-6 then side=side.Unit end\n\t\t\tfor _,k in {1,2,4} do\n\t\t\t\tlocal point=hit.Position+(hit.Normal+side)*0.03*k\n\t\t\t\tif self:clearRay(a,point) and self:clearRay(point,position) then\n\t\t\t\t\tself.bend=point; self.bendPart=hit.Instance\n\t\t\t\t\tself.bendLocal=hit.Instance.CFrame:PointToObjectSpace(point)\n\t\t\t\t\tif self.mode==\"locked\" then self.rest=math.min(math.max(self.rest,self:path(position)),self.maximum) end\n\t\t\t\t\tself.snagged=false; break\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\telse self.snagged=true end\n\tself.previous=position\nend\nfunction Silk.lock(self: any, position: Vector3, extension: number)\n\tif self.mode==\"none\" then return end\n\tself.paid,self.rest=Math.lock(self.paid,self:path(position),self.maximum,extension)\n\tself.mode=\"locked\"; self.taut=false; self.block=\"\"; self.release=Math.newRelease()\n\tself.message=\"Silk catching\"\nend\nfunction Silk.payout(self: any, position: Vector3)\n\tif self.mode~=\"payout\" or not self:refresh() then return end\n\tself:geometry(position)\n\tself.paid=math.max(self.paid,self:path(position))\n\tif self.paid>=self.maximum then self.paid=self.maximum; self:lock(position,0) end\nend\nfunction Silk.room(self: any, position: Vector3): number\n\tlocal hit=workspace:Spherecast(position,RADIUS,DOWN*self.maximum,self.params)\n\treturn if hit then hit.Distance else 0\nend\nfunction Silk.planDrop(self: any, position: Vector3, up: Vector3, heading: Vector3): ({direction: Vector3, distance: number}?, string)\n\tlocal hit=workspace:Raycast(position,-up*(HEIGHT+0.12),self.params)\n\tlocal profile=self:profile(hit)\n\tif not profile then return nil,\"No supporting surface\" end\n\tif not profile.silk_anchor_allowed then return nil,\"This surface cannot hold silk\" end\n\tif up:Dot(Vector3.yAxis)<0.707 then\n\t\tif self:room(position+up*0.01)>=1 then return {direction=Vector3.zero,distance=0},\"\" end\n\t\treturn nil,\"Nothing below to lower into\"\n\tend\n\tlocal best: {direction: Vector3, distance: number}? = nil\n\tlocal limit=6\n\tfor i=0,15 do\n\t\tlocal dir=CFrame.fromAxisAngle(up,i*math.pi/8):VectorToWorldSpace(heading)\n\t\tlocal obstacle=workspace:Spherecast(position,RADIUS,dir*6,self.params)\n\t\tlocal free=if obstacle then obstacle.Distance else 6\n\t\tfor step=1,math.floor(math.min(free,limit)*10) do\n\t\t\tlocal distance=step/10\n\t\t\tlocal q=position+dir*distance\n\t\t\tif not workspace:Raycast(q,-up*(HEIGHT+0.12),self.params) then\n\t\t\t\tif self:room(q+dir*HEIGHT)>=1 and (not best or distance<limit-1e-6) then best={direction=dir,distance=distance}; limit=distance end\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\tend\n\treturn best,if best then \"\" else \"Nothing below to lower into\"\nend\nfunction Silk.startDrop(self: any, position: Vector3, up: Vector3, push: Vector3)\n\tlocal hit=workspace:Raycast(position,-up*(HEIGHT+0.12),self.params)\n\tif not self:anchorAt(hit,position) then return false end\n\tself.lowering=true; self:lock(position,Math.DROP_SLACK)\n\tself.message=\"Lowering on silk\"\n\treturn true\nend\n\n-- ROBLOX-107: the body's skin kept by overlap, not by the sweep alone. The real engine's Spherecast does not see a part the sphere starts in, and a\n-- sweep that begins within a hair of a face it is nearly tangent to can miss it (Studio, v35: the self-test's let-down from the outer sill's front edge hung\n-- 0.07 from the brick face, inside its 0.31 skin, where the box world keeps it at 0.31). Once inside the skin nothing pushed it out. So after each move the\n-- body is pushed out of any box of the world it overlaps, by the shortest way out of the nearest point of that box (never through it: a centre already\n-- inside a box is left alone), and the velocity into it is taken away. A box the body is touching (within a thousandth of its radius) that it could land on\n-- by the sweep's own rule is a landing, as the sweep's contact would have been. Boxes only (a Part whose Shape is Block; the world's walkable pieces are\n-- all boxes). With the box world's exact sweeps the body is never inside its skin, so this changes nothing there.\nlocal SKIN = RADIUS + 0.01\nfunction Silk.unstick(self: any, position: Vector3, velocity: Vector3, intent: number): (Vector3, Vector3, any)\n\tlocal p, v = position, velocity\n\tlocal ok, parts = pcall(function() return workspace:GetPartBoundsInRadius(p, SKIN, self.overlap) end)\n\tif not ok or parts == nil then return p, v, nil end\n\tfor _, part in parts do\n\t\tlocal inst = part :: any\n\t\tlocal shape = if inst.ClassName == \"Part\" then inst.Shape else nil\n\t\tif inst:IsA(\"BasePart\") and inst.ClassName == \"Part\" and (shape == nil or shape == Enum.PartType.Block) then\n\t\t\tlocal half = inst.Size * 0.5\n\t\t\tlocal localP = inst.CFrame:PointToObjectSpace(p)\n\t\t\tlocal near = Vector3.new(math.clamp(localP.X, -half.X, half.X), math.clamp(localP.Y, -half.Y, half.Y), math.clamp(localP.Z, -half.Z, half.Z))\n\t\t\tlocal out = localP - near\n\t\t\tlocal d = out.Magnitude\n\t\t\tif d > 1e-6 and d < SKIN - 1e-4 then\n\t\t\t\tlocal n = inst.CFrame:VectorToWorldSpace(out / d)\n\t\t\t\tlocal contact = { Instance = inst, Position = inst.CFrame:PointToWorldSpace(near), Normal = n, Distance = 0 }\n\t\t\t\tlocal stats = self.stats\n\t\t\t\tstats.pushes += 1; stats.pushed += SKIN - d; stats.pushedUp += n.Y * (SKIN - d)\n\t\t\t\tp += n * (SKIN - d)\n\t\t\t\tv -= n * math.min(0, v:Dot(n))\n\t\t\t\tif d < RADIUS + 1e-3 and self:landable(contact, p, intent) then return p, Vector3.zero, contact end\n\t\t\tend\n\t\tend\n\tend\n\treturn p, v, nil\nend\n-- The sweep's landing rule: an attachable surface; while letting down, only ground under the body below the anchor (and not on a reel in).\nfunction Silk.landable(self: any, hit, p: Vector3, intent: number): boolean\n\tlocal profile = self:profile(hit)\n\tlocal allowed = not self.lowering or intent > 0 or (hit.Normal.Y >= 0.707 and hit.Position.Y <= self.anchor.Y - 0.5 and self:groundUnder(p, hit))\n\treturn profile ~= nil and profile.attachable == true and allowed\nend\n-- ROBLOX-107: while letting down, a landing needs ground under the body. The sweep can meet the rounded edge of a box that another box covers (the brick\n-- wall's top under the outer sill's slab, y -3: Studio, v35, \"left the line 2.0 s into the let-down, at (2.00, -2.70, -24.07)\"), with a normal steep enough to\n-- pass the landing rule; the spider then stood on a sliver no one can see. A ray straight down from the body's centre must meet the part it touched\n-- within the legs' reach, as standing on it asks; otherwise it slides on.\nfunction Silk.groundUnder(self: any, p: Vector3, hit): boolean\n\tlocal under = workspace:Raycast(p, DOWN * (HEIGHT + 0.35), self.params)\n\treturn under ~= nil and under.Instance == hit.Instance\nend\n\n-- ROBLOX-111: a contact the move could not have reached. A sweep that