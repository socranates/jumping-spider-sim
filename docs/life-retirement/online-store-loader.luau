rue\n  for key,value in object do\n   if typeof(value)==\"Vector3\" or (type(value)==\"table\" and type(value.X)==\"number\" and type(value.Y)==\"number\" and type(value.Z)==\"number\" and type(value.Dot)==\"function\") then\n    if point(value,offset) then object[key]=value+offset end\n   elseif type(value)==\"table\" then visit(value) end\n  end\n end\n visit(target)\nend\nfunction Migration.prepareRival(decoded: any)\n local rival=decoded.roots.life and decoded.roots.life.rival\n if type(rival)==\"table\" and type(rival.region)==\"string\" then\n  local offset=Migration.offset(rival.region)\n  if offset then Migration.shift(decoded,rival,offset) end\n end\nend\nfunction Migration.apply(decoded: any)\n for id,entry in decoded.roots.garden or {} do\n  local offset=Migration.offset(id)\n  if offset then Migration.shift(decoded,entry,offset)\n  elseif Migration.routeCache(id) then decoded.roots.garden[id]=nil end\n end\n -- Cast skins are world points too; preserve their relation to the moved leaf\n -- or bench without touching life clocks, energy, meals or generation history.\n local growth=decoded.roots.life.growth\n for i,p in growth.exuviae do\n  if p.X>=-310 and p.X<=190 and p.Z<=-816 and p.Z>=-1616 then growth.exuviae[i]=p+MEADOW\n  elseif p.X>=1490 and p.X<=2225 and p.Z<=-2441 and p.Z>=-2841 then growth.exuviae[i]=p+POND end\n end\nend\nreturn table.freeze(Migration)\n",5046,14264216},{"Shared/Persistence/Json","--!strict\n-- What a Roblox DataStore can hold, checked without the engine (ROBLOX-25), and the canonical text a checksum is taken over\n-- (Godot's checkpoint_store.gd: sorted keys, full precision). A value is storable when it is a string, a boolean, a finite\n-- number, a list (keys 1..n, no holes) or a table whose keys are all strings, made of storable values, with no table met\n-- twice. Pure; tests/checkpoint.luau checks it.\n\nlocal Json = {}\n\nlocal function finite(x: number): boolean\n\treturn x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal ESC: { [string]: string } = { ['\"'] = '\\\\\"', [\"\\\\\"] = \"\\\\\\\\\", [\"\\b\"] = \"\\\\b\", [\"\\f\"] = \"\\\\f\", [\"\\n\"] = \"\\\\n\", [\"\\r\"] = \"\\\\r\", [\"\\t\"] = \"\\\\t\" }\n\nlocal function quote(s: string): string\n\tif string.find(s, '[%c\"\\\\]') == nil then return '\"' .. s .. '\"' end -- (ROBLOX-108: most strings need no escape)\n\treturn '\"' .. string.gsub(s, '[%c\"\\\\]', function(c: string): string\n\t\treturn ESC[c] or string.format(\"\\\\u%04x\", string.byte(c))\n\tend) .. '\"'\nend\n\n-- The kind of table: \"list\" (keys exactly 1..n; an empty table counts as a list), \"object\" (all keys strings) or nil.\nlocal function shape(t: { [any]: any }): string?\n\tlocal n, strings, others = 0, 0, 0\n\tfor k in t do\n\t\tif type(k) == \"string\" then\n\t\t\tstrings += 1\n\t\telseif type(k) == \"number\" then\n\t\t\tothers += 1\n\t\telse\n\t\t\treturn nil\n\t\tend\n\t\tn += 1\n\tend\n\tif strings == n then return if n == 0 then \"list\" else \"object\" end\n\tif others == n then\n\t\tfor i = 1, n do\n\t\t\tif t[i] == nil then return nil end\n\t\tend\n\t\treturn \"list\"\n\tend\n\treturn nil\nend\n\n-- The canonical JSON text of `v`, or nil and why it is not storable.\n-- (ROBLOX-108: the path a problem names is kept as a stack of keys and spelt out only when there is a problem; it was a new string for every value, most of the\n-- cost of a checkpoint's save, which runs on the frame the rest begins. The text and every message are as they were.)\nfunction Json.canonical(v: any): (string?, string?)\n\tlocal seen: { [any]: boolean } = {}\n\tlocal problem: string? = nil\n\tlocal trail: { any } = {}\n\tlocal function where(): string\n\t\tlocal out = \"value\"\n\t\tfor _, k in trail do\n\t\t\tif type(k) == \"number\" then out ..= `[{k}]` else out ..= `.{k}` end\n\t\tend\n\t\treturn out\n\tend\n\tlocal function enc(x: any): string\n\t\tif problem then return \"\" end\n\t\tlocal t = type(x)\n\t\tif t == \"string\" then return quote(x) end\n\t\tif t == \"boolean\" then return if x then \"true\" else \"false\" end\n\t\tif t == \"number\" then\n\t\t\tif not finite(x) then\n\t\t\t\tproblem = `{where()}: a number JSON cannot hold`\n\t\t\t\treturn \"\"\n\t\t\tend\n\t\t\tif x == math.floor(x) and math.abs(x) < 2 ^ 53 then return string.format(\"%d\", x) end\n\t\t\treturn string.format(\"%.17g\", x)\n\t\tend\n\t\tif t ~= \"table\" then\n\t\t\tproblem = `{where()}: a {typeof(x)}`\n\t\t\treturn \"\"\n\t\tend\n\t\tif getmetatable(x) ~= nil then\n\t\t\tproblem = `{where()}: a table with a metatable`\n\t\t\treturn \"\"\n\t\tend\n\t\tif seen[x] then\n\t\t\tproblem = `{where()}: a table met twice`\n\t\t\treturn \"\"\n\t\tend\n\t\tseen[x] = true\n\t\tlocal kind = shape(x)\n\t\tlocal depth = #trail + 1\n\t\tif kind == \"list\" then\n\t\t\tlocal parts = table.create(#x)\n\t\t\tfor i, y in ipairs(x) do\n\t\t\t\ttrail[depth] = i\n\t\t\t\tparts[i] = enc(y)\n\t\t\tend\n\t\t\ttrail[depth] = nil\n\t\t\treturn \"[\" .. table.concat(parts, \",\") .. \"]\"\n\t\telseif kind == \"object\" then\n\t\t\tlocal keys: { string } = {}\n\t\t\tfor k in x do table.insert(keys, k) end\n\t\t\ttable.sort(keys)\n\t\t\tlocal parts = table.create(#keys)\n\t\t\tfor i, k in keys do\n\t\t\t\ttrail[depth] = k\n\t\t\t\tparts[i] = quote(k) .. \":\" .. enc(x[k])\n\t\t\tend\n\t\t\ttrail[depth] = nil\n\t\t\treturn \"{\" .. table.concat(parts, \",\") .. \"}\"\n\t\tend\n\t\tproblem = `{where()}: a table with mixed or sparse keys`\n\t\treturn \"\"\n\tend\n\tlocal text = enc(v)\n\tif problem then return nil, problem end\n\treturn text, nil\nend\n\n-- A deep copy of a storable value (what a DataStore hands back is never the table that was given to it).\nlocal function copy(v: any): any\n\tif type(v) ~= \"table\" then return v end\n\tlocal out = {}\n\tfor k, x in v do out[k] = if type(x) == \"table\" then copy(x) else x end\n\treturn out\nend\nJson.copy = copy\n\n-- FNV-1a over the text, two independent 32-bit lanes, as 16 hex digits: enough to catch a record cut short or changed.\n-- x * 16777619 (the FNV prime, 2^24 + 403) modulo 2^32, exactly, as ((x % 256) * 2^24 + x * 403) % 2^32: a plain product of two 32-bit numbers can exceed 2^53.\n-- (ROBLOX-108: the bytes are read a block at a time and the multiply is written out in the loop: the same sums as before, one byte at a time, in less time.)\nlocal BLOCK = 2048\nfunction Json.checksum(text: string): string\n\tlocal a, b = 0x811c9dc5, 0x050c5d1f\n\tlocal n = #text\n\tlocal bxor = bit32.bxor\n\tlocal i0 = 1\n\twhile i0 <= n do\n\t\tlocal i1 = math.min(n, i0 + BLOCK - 1)\n\t\tlocal bytes = { string.byte(text, i0, i1) }\n\t\tfor j, c in bytes do\n\t\t\tlocal x = bxor(a, c)\n\t\t\ta = ((x % 256) * 16777216 + x * 403) % 4294967296\n\t\t\tlocal y = bxor(b, (c + i0 + j - 1) % 256)\n\t\t\tb = ((y % 256) * 16777216 + y * 403) % 4294967296\n\t\tend\n\t\ti0 = i1 + 1\n\tend\n\treturn string.format(\"%08x%08x\", a, b)\nend\n\nreturn Json\n",4986,4176609606},{"Shared/Persistence/MemoryBackend","--!strict\n-- The in-memory store backend (ROBLOX-39): the same interface as the real DataStore backend, with a Roblox DataStore's rules (values\n-- copied in and out, only storable values, the size limit, UpdateAsync that may call its function more than once) and a way to make it\n-- fail in every way the tests need. It is what the CLI tests run on and what a build without DataStore access falls back to (a session\n-- that lasts as long as the server).\n-- Interface (a backend is any table with these):\n--   backend:read(key)              -> ok: boolean, value: any, err: string?\n--   backend:update(key, transform) -> ok: boolean, value: any, err: string?     transform(old) returns the new value, or nil to cancel\n-- A cancelled update is ok with value nil. Neither raises.\n-- Faults: backend:fail{ op = \"read\"|\"update\"|\"any\", key = \"<key or prefix*>\"?, times = n?, message = \"...\", afterWrite = true? }. A fault with\n-- afterWrite lets the write happen and then reports an error (a timeout that did not mean the write was lost). backend:poke(key, value) sets\n-- a raw value (corrupt JSON, a half-written record). `backend.log` lists every request: { op, key, ok }.\nlocal Json = require(script.Parent.Json)\nlocal SaveRules = require(script.Parent.Parent.Data.SaveRules)\n\nlocal MemoryBackend = {}\nMemoryBackend.__index = MemoryBackend\n\nexport type Fault = { op: string, key: string?, times: number, message: string, afterWrite: boolean? }\n\nfunction MemoryBackend.new(): any\n\treturn setmetatable({ data = {} :: { [string]: any }, faults = {} :: { Fault }, log = {} :: { any }, requests = 0, writes = 0, clock = 0 }, MemoryBackend)\nend\n\nfunction MemoryBackend.fail(self: any, fault: { [string]: any })\n\ttable.insert(self.faults, { op = fault.op or \"any\", key = fault.key, times = fault.times or 1, message = fault.message or \"503: the service is unavailable\", afterWrite = fault.afterWrite })\nend\n\nfunction MemoryBackend.clearFaults(self: any)\n\tself.faults = {}\nend\n\nfunction MemoryBackend.poke(self: any, key: string, value: any)\n\tself.data[key] = value\nend\n\nlocal function matches(pattern: string?, key: string): boolean\n\tif pattern == nil then return true end\n\tif string.sub(pattern, -1) == \"*\" then return string.sub(key, 1, #pattern - 1) == string.sub(pattern, 1, #pattern - 1) end\n\treturn pattern == key\nend\n\n-- The first live fault for this request, used up by one.\nlocal function takeFault(self: any, op: string, key: string): Fault?\n\tfor i, f in self.faults do\n\t\tif (f.op == \"any\" or f.op == op) and matches(f.key, key) and f.times > 0 then\n\t\t\tf.times -= 1\n\t\t\tif f.times == 0 then table.remove(self.faults, i) end\n\t\t\treturn f\n\t\tend\n\tend\n\treturn nil\nend\n\nfunction MemoryBackend.read(self: any, key: string): (boolean, any, string?)\n\tself.requests += 1\n\tlocal f = takeFault(self, \"read\", key)\n\tif f then\n\t\ttable.insert(self.log, { op = \"read\", key = key, ok = false })\n\t\treturn false, nil, f.message\n\tend\n\ttable.insert(self.log, { op = \"read\", key = key, ok = true })\n\treturn true, Json.copy(self.data[key]), nil\nend\n\nfunction MemoryBackend.update(self: any, key: string, transform: (any) -> any): (boolean, any, string?)\n\tself.requests += 1\n\tlocal f = takeFault(self, \"update\", key)\n\tif f and not f.afterWrite then\n\t\ttable.insert(self.log, { op = \"update\", key = key, ok = false })\n\t\treturn false, nil, f.message\n\tend\n\tlocal okT, new = pcall(transform, Json.copy(self.data[key]))\n\tif not okT then\n\t\ttable.insert(self.log, { op = \"update\", key = key, ok = false })\n\t\treturn false, nil, \"the update function raised: \" .. tostring(new)\n\tend\n\tif new == nil then\n\t\ttable.insert(self.log, { op = \"update\", key = key, ok = true, cancelled = true })\n\t\treturn true, nil, nil\n\tend\n\tlocal text, why = Json.canonical(new)\n\tif not text then\n\t\ttable.insert(self.log, { op = \"update\", key = key, ok = false })\n\t\treturn false, nil, \"104: Cannot store this value: \" .. tostring(why)\n\tend\n\tif #text > SaveRules.MAX_VALUE_CHARS then\n\t\ttable.insert(self.log, { op = \"update\", key = key, ok = false })\n\t\treturn false, nil, `105: the value is {#text} characters, over the limit`\n\tend\n\tself.data[key] = Json.copy(new)\n\tself.writes += 1\n\tif f and f.afterWrite then\n\t\ttable.insert(self.log, { op = \"update\", key = key, ok = false, wrote = true })\n\t\treturn false, nil, f.message\n\tend\n\ttable.insert(self.log, { op = \"update\", key = key, ok = true })\n\treturn true, Json.copy(new), nil\nend\n\nreturn MemoryBackend\n",4391,3107696525},{"Shared/Persistence/ObjectRecord","--!strict\n-- ObjectRecord (ROBLOX-25): the state of a few live objects as one plain record that a DataStore could hold, and back.\n-- The world's state is a graph of Luau tables (flies point at their perches, a flight at its fly and back, the feeding at the\n-- needs it grants to). Writing a record by hand for each module would miss a field sooner or later, and a missed field is a\n-- checkpoint that comes back different. So this walks the graph from named roots and records every table once, keeping who\n-- points at what, cycles included. Nothing is guessed:\n--   * a table with a metatable is recorded only if its metatable is one of the named `classes`; anything else is refused;\n--   * functions, Instances and any other engine value are refused unless they are named `refs` (the running program's own\n--     things: the world's raycast closures, a probe part, a Signal with its listeners, the species data). A ref is kept as its\n--     name and comes back as whatever has that name when the record is restored;\n--   * numbers that JSON cannot hold (infinities, NaN) and Vector3 values are written as small tagged tables.\n-- The record: { format = FORMAT, roots = { name = { [\"$o\"] = i } }, objects = { { c = class?, e = { { key, value }, ... } } } },\n-- where every key is a string or a finite number, and every value a string, boolean, finite number, or one of\n-- { [\"$o\"] = i } (the i-th object), { [\"$r\"] = name }, { [\"$v\"] = { x, y, z } }, { [\"$n\"] = \"inf\" | \"-inf\" | \"nan\" }.\n-- Entries are sorted, so the same state always gives the same record.\n-- Restoring is in two steps. `decode` checks the whole record and builds every object fresh, touching nothing live; a record\n-- with any problem is refused there, with the reasons. `commit` then moves the fresh roots' contents into the live root tables\n-- (so everything else that holds a live root keeps holding the right table) and cannot fail part way.\n\nlocal ObjectRecord = {}\n\nObjectRecord.FORMAT = \"object-record-1\"\n-- Refuse graphs larger than this many tables (a runaway reference would otherwise record the whole program).\nObjectRecord.MAX_OBJECTS = 20000\n\nexport type Record = { format: string, roots: { [string]: any }, objects: { any } }\nexport type Decoded = { roots: { [string]: any }, objects: { any } }\n\nlocal V3META: any = if type((Vector3 :: any).zero) == \"table\" then getmetatable((Vector3 :: any).zero) else nil\n\nlocal function isVector3(v: any): boolean\n\treturn typeof(v) == \"Vector3\" or (V3META ~= nil and type(v) == \"table\" and getmetatable(v) == V3META)\nend\n\nlocal function finite(x: number): boolean\n\treturn x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal function encodeNumber(x: number): any\n\tif finite(x) then return x end\n\treturn { [\"$n\"] = if x ~= x then \"nan\" elseif x > 0 then \"inf\" else \"-inf\" }\nend\n\nlocal function keyLess(a: any, b: any): boolean\n\tlocal ka, kb = a[1], b[1]\n\tif type(ka) == type(kb) then return ka < kb end\n\treturn type(ka) == \"number\" -- numbers before strings\nend\n\n-- Records the graph reachable from `roots`. `classes`: name -> metatable. `refs`: name -> value. Returns the record, or nil\n-- and the reason (with the path to the first thing it could not record).\nfunction ObjectRecord.capture(roots: { [string]: any }, classes: { [string]: any }, refs: { [string]: any }): (Record?, string?)\n\tlocal classOf: { [any]: string } = {}\n\tfor name, mt in classes do classOf[mt] = name end\n\tlocal refOf: { [any]: string } = {}\n\tfor name, v in refs do\n\t\tif refOf[v] == nil then refOf[v] = name end\n\tend\n\tlocal index: { [any]: number } = {}\n\tlocal objects: { any } = {}\n\tlocal queue: { any } = {}\n\tlocal paths: { [any]: string } = {}\n\tlocal problem: string? = nil\n\n\tlocal function value(v: any, path: string): any\n\t\tif problem then return nil end\n\t\tlocal t = type(v)\n\t\tif t == \"string\" or t == \"boolean\" then return v end\n\t\tif t == \"number\" then return encodeNumber(v) end\n\t\tlocal ref = refOf[v]\n\t\tif ref ~= nil then return { [\"$r\"] = ref } end\n\t\tif isVector3(v) then\n\t\t\treturn { [\"$v\"] = { encodeNumber(v.X), encodeNumber(v.Y), encodeNumber(v.Z) } }\n\t\tend\n\t\tif t == \"table\" then\n\t\t\tlocal mt = getmetatable(v)\n\t\t\tif mt ~= nil and classOf[mt] == nil then\n\t\t\t\tproblem = `{path}: a table of a class this record does not know`\n\t\t\t\treturn nil\n\t\t\tend\n\t\t\tlocal i = index[v]\n\t\t\tif i == nil then\n\t\t\t\tif #objects >= ObjectRecord.MAX_OBJECTS then\n\t\t\t\t\tproblem = `{path}: more than {ObjectRecord.MAX_OBJECTS} tables`\n\t\t\t\t\treturn nil\n\t\t\t\tend\n\t\t\t\ti = #objects + 1\n\t\t\t\tindex[v] = i\n\t\t\t\tobjects[i] = false\n\t\t\t\tpaths[v] = path\n\t\t\t\ttable.insert(queue, v)\n\t\t\tend\n\t\t\treturn { [\"$o\"] = i }\n\t\tend\n\t\tproblem = `{path}: a {typeof(v)} with no name to keep it by`\n\t\treturn nil\n\tend\n\n\tlocal out: Record = { format = ObjectRecord.FORMAT, roots = {}, objects = objects }\n\tlocal rootNames: { string } = {}\n\tfor name in roots do table.insert(rootNames, name) end\n\ttable.sort(rootNames)\n\tfor _, name in rootNames do\n\t\tlocal v = roots[name]\n\t\tif type(v) ~= \"table\" or refOf[v] ~= nil or isVector3(v) then\n\t\t\treturn nil, `root {name} is not an object`\n\t\tend\n\t\tout.roots[name] = value(v, name)\n\tend\n\tlocal q = 1\n\twhile q <= #queue and not problem do\n\t\tlocal obj = queue[q]\n\t\tq += 1\n\t\tlocal entries: { any } = {}\n\t\tlocal path = paths[obj]\n\t\t-- Keys in sorted order, so tables are numbered in the same order whatever the hash order of the live tables.\n\t\tlocal keys: { any } = {}\n\t\tfor k in obj do\n\t\t\tlocal kt = type(k)\n\t\t\tif not ((kt == \"string\") or (kt == \"number\" and finite(k))) then\n\t\t\t\tproblem = `{path}: a key that is not a string or a finite number`\n\t\t\t\tbreak\n\t\t\tend\n\t\t\ttable.insert(keys, { k })\n\t\tend\n\t\ttable.sort(keys, keyLess)\n\t\tfor _, key in keys do\n\t\t\tif problem then break end\n\t\t\tlocal k = key[1]\n\t\t\tlocal enc = value(obj[k], `{path}.{k}`)\n\t\t\tif problem then break end\n\t\t\ttable.insert(entries, { k, enc })\n\t\tend\n\t\tlocal mt = getmetatable(obj)\n\t\tobjects[index[obj]] = if mt ~= nil then { c = classOf[mt], e = entries } else { e = entries }\n\tend\n\tif problem then return nil, problem end\n\treturn out, nil\nend\n\nlocal function decodeNumber(x: any): (number?, string?)\n\tif type(x) == \"number\" then\n\t\tif finite(x) then return x, nil end\n\t\treturn nil, \"a number JSON cannot hold, written bare\"\n\tend\n\tif type(x) == \"table\" then\n\t\tlocal n = x[\"$n\"]\n\t\tif n == \"inf\" then return math.huge, nil end\n\t\tif n == \"-inf\" then return -math.huge, nil end\n\t\tif n == \"nan\" then return 0 / 0, nil end\n\tend\n\treturn nil, \"not a number\"\nend\n\nlocal function only(t: any, key: string): boolean\n\tlocal count = 0\n\tfor _ in t do count += 1 end\n\treturn count == 1 and t[key] ~= nil\nend\n\n-- Checks `record` and builds every object fresh (nothing live is touched). Returns the fresh objects and roots, or nil and\n-- every problem found.\nfunction ObjectRecord.decode(record: any, classes: { [string]: any }, refs: { [string]: any }): (Decoded?, { string })\n\tlocal problems: { string } = {}\n\tlocal function bad(text: string)\n\t\tif #problems < 20 then table.insert(problems, text) end\n\tend\n\tif type(record) ~= \"table\" or record.format ~= ObjectRecord.FORMAT then\n\t\treturn nil, { \"not an object record of this format\" }\n\tend\n\tlocal objects, roots = record.objects, record.roots\n\tif type(objects) ~= \"table\" or type(roots) ~= \"table\" then\n\t\treturn nil, { \"the record has no objects or roots\" }\n\tend\n\tlocal n = #objects\n\tif n > ObjectRecord.MAX_OBJECTS then\n\t\treturn nil, { \"too many objects\" }\n\tend\n\tfor k in objects do\n\t\tif type(k) ~= \"number\" or k < 1 or k > n or k ~= math.floor(k) then\n\t\t\treturn nil, { \"the objects are not a list\" }\n\t\tend\n\tend\n\tlocal fresh: { any } = table.create(n)\n\tfor i = 1, n do fresh[i] = {} end\n\n\tlocal function value(v: any, where: string): any\n\t\tlocal t = type(v)\n\t\tif t == \"string\" or t == \"boolean\" then return v end\n\t\tif t == \"number\" then\n\t\t\tif not finite(v) then bad(`{where}: a bare number JSON cannot hold`) end\n\t\t\treturn v\n\t\tend\n\t\tif t ~= \"table\" then\n\t\t\tbad(`{where}: a {t}`)\n\t\t\treturn nil\n\t\tend\n\t\tif only(v, \"$o\") then\n\t\t\tlocal i = v[\"$o\"]\n\t\t\tif type(i) ~= \"number\" or i < 1 or i > n or i ~= math.floor(i) then\n\t\t\t\tbad(`{where}: points at no object`)\n\t\t\t\treturn nil\n\t\t\tend\n\t\t\treturn fresh[i]\n\t\tend\n\t\tif only(v, \"$r\") then\n\t\t\tlocal name = v[\"$r\"]\n\t\t\tif type(name) ~= \"string\" or refs[name] == nil then\n\t\t\t\tbad(`{where}: names '{tostring(name)}', which this world does not have`)\n\t\t\t\treturn nil\n\t\t\tend\n\t\t\treturn refs[name]\n\t\tend\n\t\tif only(v, \"$v\") then\n\t\t\tlocal xyz = v[\"$v\"]\n\t\t\tif type(xyz) ~= \"table\" or #xyz ~= 3 then\n\t\t\t\tbad(`{where}: a vector without three numbers`)\n\t\t\t\treturn nil\n\t\t\tend\n\t\t\tlocal x, e1 = decodeNumber(xyz[1])\n\t\t\tlocal y, e2 = decodeNumber(xyz[2])\n\t\t\tlocal z, e3 = decodeNumber(xyz[3])\n\t\t\tif e1 or e2 or e3 then\n\t\t\t\tbad(`{where}: a vector with {e1 or e2 or e3}`)\n\t\t\t\treturn nil\n\t\t\tend\n\t\t\treturn Vector3.new(x :: number, y :: number, z :: number)\n\t\tend\n\t\tif only(v, \"$n\") then\n\t\t\tlocal x, e = decodeNumber(v)\n\t\t\tif e then bad(`{where}: {e}`) end\n\t\t\treturn x\n\t\tend\n\t\tbad(`{where}: a table that is none of the record's kinds`)\n\t\treturn nil\n\tend\n\n\tfor i = 1, n do\n\t\tlocal o = objects[i]\n\t\tlocal where = `object {i}`\n\t\tif type(o) ~= \"table\" or type(o.e) ~= \"table\" then\n\t\t\tbad(`{where}: not an object`)\n\t\t\tcontinue\n\t\tend\n\t\tif o.c ~= nil then\n\t\t\tif type(o.c) ~= \"string\" or classes[o.c] == nil then\n\t\t\t\tbad(`{where}: of class '{tostring(o.c)}', which this build does not know`)\n\t\t\t\tcontinue\n\t\t\tend\n\t\tend\n\t\tlocal target = fresh[i]\n\t\tfor j, entry in o.e do\n\t\t\tif type(entry) ~= \"table\" or #entry ~= 2 then\n\t\t\t\tbad(`{where}, entry {j}: not a key and a value`)\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tlocal k = entry[1]\n\t\t\tif not (type(k) == \"string\" or (type(k) == \"number\" and finite(k))) then\n\t\t\t\tbad(`{where}, entry {j}: a key that is not a string or a finite number`)\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tif target[k] ~= nil then\n\t\t\t\tbad(`{where}: the key {k} twice`)\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\ttarget[k] = value(entry[2], `{where}.{k}`)\n\t\tend\n\t\tif o.c ~= nil and classes[o.c] then\n\t\t\tsetmetatable(target, classes[o.c])\n\t\tend\n\tend\n\tlocal out: { [string]: any } = {}\n\tfor name, v in roots do\n\t\tif type(name) ~= \"string\" then\n\t\t\tbad(\"a root without a name\")\n\t\t\tcontinue\n\t\tend\n\t\tlocal r = value(v, `root {name}`)\n\t\tif type(r) ~= \"table\" then\n\t\t\tbad(`root {name} is not an object`)\n\t\tend\n\t\tout[name] = r\n\tend\n\tif #problems > 0 then return nil, problems end\n\treturn { roots = out, objects = fresh }, problems\nend\n\n-- Moves a decoded world into the live one: every live root (by name) ends up with exactly the fresh root's contents and\n-- metatable, and every fresh reference to a fresh root now points at the live root. `live` must name every decoded root.\n-- Plain table work only: it cannot fail part way. Returns false (and changes nothing) if a root is missing from `live`.\nfunction ObjectRecord.commit(decoded: Decoded, live: { [string]: any }): boolean\n\tlocal swap: { [any]: any } = {}\n\tfor name, fresh in decoded.roots do\n\t\tlocal target = live[name]\n\t\tif type(target) ~= \"table\" then return false end\n\t\tswap[fresh] = target\n\tend\n\tfor _, o in decoded.objects do\n\t\tfor k, v in o do\n\t\t\tlocal to = swap[v]\n\t\t\tif to ~= nil then o[k] = to end\n\t\tend\n\tend\n\tfor fresh, target in swap do\n\t\ttable.clear(target)\n\t\tfor k, v in fresh do target[k] = v end\n\t\tsetmetatable(target, getmetatable(fresh))\n\tend\n\treturn true\nend\n\n-- Every plain table reachable from `root` (not through a metatable), named by its path from `name`: the species data a\n-- record should keep by name rather than copy.\nfunction ObjectRecord.constants(name: string, root: any, into: { [string]: any }?): { [string]: any }\n\tlocal out = into or {}\n\tlocal seen: { [any]: boolean } = {}\n\tlocal function walk(v: any, path: string)\n\t\tif type(v) ~= \"table\" or seen[v] or isVector3(v) then return end\n\t\tseen[v] = true\n\t\tout[path] = v\n\t\tfor k, x in v do\n\t\t\tif type(k) == \"string\" or type(k) == \"number\" then walk(x, `{path}.{k}`) end\n\t\tend\n\tend\n\twalk(root, name)\n\treturn out\nend\n\nreturn ObjectRecord\n",11819,159249707},{"Shared/Persistence/SaveEnvelope","--!strict\n-- The versioned envelope every stored save travels in (ROBLOX-39), and how it is opened without ever guessing.\n--   { format, kind, schema, updatedAt, payload, checksum, backup?, lock?, session? }\n-- `checksum` is taken over the canonical JSON of { kind, schema, updatedAt, payload } (Json.checksum, the checkpoint store's own), so a\n-- value that was cut short, changed or written by something else is refused even if what is left still looks like a save. `backup`\n-- is the previous good version of the same kind (schema, updatedAt, payload, checksum), kept inside the same value; `lock` and\n-- `session` are outside the checksum on purpose (the lock is refreshed without touching the payload).\n-- Opening gives a status and never raises:\n--   missing ... nothing is stored\n--   ok ......... a good save of the schema this build writes\n--   migrated ... a good older save, carried forward in memory (the migration table of its kind); nothing is written by opening\n--   newer ...... made by a newer build: left exactly as it is, never read past its header, never written\n--   corrupt .... not a save, a wrong kind, a bad checksum, or a number that is not a schema\n--   invalid .... the checksum is right but the contents are not (or no migration leads from its schema)\n-- A spec describes one kind: { kind, current, migrations = { [from] = function(payload) -> payload of schema from + 1 }, validate }.\n-- `validate(payload)` returns (problems, cleaned payload): an empty list is a good one.\nlocal Json = require(script.Parent.Json)\nlocal SaveRules = require(script.Parent.Parent.Data.SaveRules)\n\nlocal SaveEnvelope = {}\n\nexport type Spec = {\n\tkind: string, current: number,\n\tmigrations: { [number]: (any) -> any },\n\tvalidate: (any) -> ({ string }, any?),\n}\nexport type Opened = {\n\tstatus: string, payload: any?, schema: number?, updatedAt: number?, reasons: { string },\n\tlock: any?, session: string?, backup: Opened?, migratedFrom: number?,\n}\n\nlocal function finite(x: any): boolean\n\treturn type(x) == \"number\" and x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal function checksumOf(kind: string, schema: number, updatedAt: number, payload: any): string?\n\tlocal text = Json.canonical({ kind = kind, schema = schema, updatedAt = updatedAt, payload = payload })\n\tif not text then return nil end\n\treturn Json.checksum(text)\nend\n\n-- The core of a save: what the checksum covers, plus the checksum.\nfunction SaveEnvelope.core(spec: Spec, payload: any, updatedAt: number): { [string]: any }\n\treturn { schema = spec.current, updatedAt = updatedAt, payload = payload, checksum = checksumOf(spec.kind, spec.current, updatedAt, payload) }\nend\n\n-- Whether a stored value is a save of this kind with an intact checksum, whatever its schema (used to keep a backup).\nlocal function intact(spec: Spec, v: any): boolean\n\tif type(v) ~= \"table\" or v.format ~= SaveRules.FORMAT or v.kind ~= spec.kind then return false end\n\tif not finite(v.schema) or v.schema < 1 or v.schema ~= math.floor(v.schema) or not finite(v.updatedAt) then return false end\n\treturn checksumOf(spec.kind, v.schema, v.updatedAt, v.payload) == v.checksum and v.checksum ~= nil\nend\n\nlocal function openCore(spec: Spec, v: any, withBackup: boolean): Opened\n\tlocal function out(status: string, reasons: { string }, extra: { [string]: any }?): Opened\n\t\tlocal o: any = { status = status, reasons = reasons }\n\t\tif extra then for k, x in extra do o[k] = x end end\n\t\treturn o\n\tend\n\tif v == nil then return out(\"missing\", { \"nothing is stored\" }) end\n\tif type(v) ~= \"table\" or v.format ~= SaveRules.FORMAT then return out(\"corrupt\", { \"not a save of this game\" }) end\n\tif v.kind ~= spec.kind then return out(\"corrupt\", { `a {tostring(v.kind)} where a {spec.kind} was expected` }) end\n\tlocal schema = v.schema\n\tif not finite(schema) or schema < 1 or schema ~= math.floor(schema) then return out(\"corrupt\", { \"the schema is not a whole number\" }) end\n\tlocal lock = if type(v.lock) == \"table\" then v.lock else nil\n\tlocal session = if type(v.session) == \"string\" then v.session else nil\n\tif schema > spec.current then\n\t\treturn out(\"newer\", { `made by a newer version of the game (schema {schema}; this one reads up to {spec.current})` }, { schema = schema, updatedAt = if finite(v.updatedAt) then v.updatedAt else nil, lock = lock, session = session })\n\tend\n\tif not finite(v.updatedAt) or type(v.checksum) ~= \"string\" or checksumOf(spec.kind, schema, v.updatedAt, v.payload) ~= v.checksum then\n\t\tlocal extra: any = { schema = schema, lock = lock, session = session }\n\t\tif withBackup and v.backup ~= nil then\n\t\t\tlocal b = v.backup\n\t\t\tif type(b) == \"table\" then\n\t\t\t\textra.backup = openCore(spec, { format = v.format, kind = v.kind, schema = b.schema, updatedAt = b.updatedAt, payload = b.payload, checksum = b.checksum }, false)\n\t\t\tend\n\t\tend\n\t\treturn out(\"corrupt\", { \"the checksum does not match: the save was cut short or changed\" }, extra)\n\tend\n\t-- the stored form is intact: carry it forward to the schema this build uses\n\t-- (a copy: a migration that edits its argument in place must not change the stored value it was given)\n\tlocal payload: any = if schema < spec.current then Json.copy(v.payload) else v.payload\n\tlocal from = schema\n\twhile from < spec.current do\n\t\tlocal step = spec.migrations[from]\n\t\tif step == nil then return out(\"invalid\", { `no migration from schema {from}` }, { schema = schema, updatedAt = v.updatedAt, lock = lock, session = session }) end\n\t\tlocal ok, moved = pcall(step, payload)\n\t\tif not ok or moved == nil then return out(\"invalid\", { `the migration from schema {from} failed` }, { schema = schema, updatedAt = v.updatedAt, lock = lock, session = session }) end\n\t\tpayload = moved\n\t\tfrom += 1\n\tend\n\tlocal okV, problems, cleaned = pcall(spec.validate, payload)\n\tlocal list: { string } = if okV then (problems :: any) else { \"validation raised: \" .. tostring(problems) }\n\tlocal extra: any = { schema = schema, updatedAt = v.updatedAt, lock = lock, session = session }\n\tif #list > 0 then return out(\"invalid\", list, extra) end\n\textra.payload = if cleaned ~= nil then cleaned else payload\n\tif schema < spec.current then extra.migratedFrom = schema end\n\treturn out(if schema < spec.current then \"migrated\" else \"ok\", {}, extra)\nend\n\n-- Opens a stored value. Its backup (if any) is opened too, one level deep, so a caller can fall back without a second look.\n-- `wantBackup` false skips opening the backup (a write path that only needs the current value).\nfunction SaveEnvelope.open(spec: Spec, v: any, wantBackup: boolean?): Opened\n\tlocal want = wantBackup ~= false\n\tlocal o = openCore(spec, v, want)\n\tif want and type(v) == \"table\" and o.backup == nil and v.backup ~= nil and o.status ~= \"newer\" and o.status ~= \"missing\" then\n\t\tlocal b = v.backup\n\t\tif type(b) == \"table\" then\n\t\t\to.backup = openCore(spec, { format = v.format, kind = v.kind, schema = b.schema, updatedAt = b.updatedAt, payload = b.payload, checksum = b.checksum }, false)\n\t\tend\n\tend\n\treturn o\nend\n\n-- The raw backup core of a stored value, when it is itself intact (so it may be kept as the next backup).\nlocal function backupCoreOf(spec: Spec, v: any): { [string]: any }?\n\tif not intact(spec, v) then return nil end\n\treturn { schema = v.schema, updatedAt = v.updatedAt, payload = v.payload, checksum = v.checksum }\nend\n\n-- A new stored value: `payload` at the current schema, the previous good value of the same kind as its backup. `prior` is the raw\n-- stored value (or nil). When the prior is not intact its own backup, if intact, stays the backup. Never raises.\nfunction SaveEnvelope.make(spec: Spec, payload: any, updatedAt: number, prior: any, extras: { [string]: any }?): { [string]: any }\n\tlocal c = SaveEnvelope.core(spec, payload, updatedAt)\n\tlocal env: { [string]: any } = { format = SaveRules.FORMAT, kind = spec.kind, schema = c.schema, updatedAt = c.updatedAt, payload = c.payload, checksum = c.checksum }\n\tlocal backup = backupCoreOf(spec, prior)\n\tif backup == nil and type(prior) == \"table\" and type(prior.backup) == \"table\" then\n\t\tbackup = backupCoreOf(spec, { format = SaveRules.FORMAT, kind = spec.kind, schema = prior.backup.schema, updatedAt = prior.backup.updatedAt, payload = prior.backup.payload, checksum = prior.backup.checksum })\n\tend\n\tenv.backup = backup\n\tif extras then for k, x in extras do env[k] = x end end\n\treturn env\nend\n\n-- The same stored value with only the lock (and who holds it) changed: payload, checksum and backup are carried over untouched.\n-- `lock` nil releases it.\nfunction SaveEnvelope.withLock(v: any, lock: { [string]: any }?): any\n\tlocal out: { [string]: any } = {}\n\tfor k, x in v do out[k] = x end\n\tout.lock = lock\n\treturn out\nend\n\n-- Is this lock held by a live session other than `me` at time `now`? A lock nobody refreshed for LOCK_STALE seconds is not.\nfunction SaveEnvelope.heldByOther(lock: any, me: string, now: number, staleAfter: number): boolean\n\tif type(lock) ~= \"table\" then return false end\n\tif type(lock.session) ~= \"string\" or lock.session == me then return false end\n\tif not finite(lock.beat) then return false end -- a lock with no readable beat protects nothing\n\treturn now - lock.beat <= staleAfter\nend\n\nSaveEnvelope.intact = intact\nreturn SaveEnvelope\n",9182,2880714676},{"Shared/Persistence/SaveProgress","--!strict\n-- The player's progress record (ROBLOX-39): the small precious part of a save, kept apart from the world's rests.\n--   { notebook = { opened = { page ids }, eye_seconds }, finished_main, appearance, settings = { [id] = boolean | number | string }, settings_version }\n-- notebook: the pages found (FieldNotebook.toRecord) and the seconds in the eye view. finished_main: a main-life Standard spider became an\n-- adult, which opens Easy (Session.finishedMain; there is no separate \"adult reached\", it is the same fact). appearance: the spider the\n-- player chose (a free choice, the peacock included). settings: the player's settings the client reads from Player attributes (ROBLOX-49:\n-- Data/SettingsSpec, cleaned by UI/SettingsModel: unknown ids dropped, a wrong type refused, a number clamped into its range) and\n-- settings_version, the SettingsSpec.VERSION they were written at (older ones are carried forward by SettingsModel.migrate).\n-- intro_seen (ROBLOX-109, optional: absent in every record before it, and absent while false): the intro of a new life has been shown in this save, so\n-- it is never shown again. Monotonic like finished_main; no schema change (a record without it reads as not seen).\n-- hut_window (ROBLOX-116, optional, absent while false, as intro_seen): the preserve's ranger hut's window has been propped open (Life/Nursery). Monotonic: once\n-- open it stays open in this save, for every later life. No schema change.\n-- Schema 1 kept only seven true-or-false toggles as `prefs`; its migration moves them to `settings`.\n-- Everything is bounded. Merging is monotonic where it can be (pages found are a union, the longest eye time and a finished main life\n-- stay), and the last change wins for the choices. Unknown page ids that are well formed are kept: a build that lost a page must not\n-- erase what a newer build found. Pure; checked in tests/state.luau.\nlocal SaveRules = require(script.Parent.Parent.Data.SaveRules)\nlocal SaveEnvelope = require(script.Parent.SaveEnvelope)\nlocal SettingsModel = require(script.Parent.Parent.UI.SettingsModel)\n\nlocal RareLedger = require(script.Parent.Parent.Life.RareLedger)\nlocal SaveProgress = {}\n\nSaveProgress.SCHEMA = 2\nexport type Payload = { notebook: { opened: { string }, eye_seconds: number }, finished_main: boolean, appearance: string?, settings: { [string]: SettingsModel.Value }, settings_version: number, intro_seen: boolean?, hut_window: boolean?, rare: RareLedger.Record? }\n\nlocal function finite(x: any): boolean\n\treturn type(x) == \"number\" and x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal function goodId(id: any): boolean\n\treturn type(id) == \"string\" and #id >= 1 and #id <= SaveRules.MAX_ID_CHARS and string.match(id, \"^[%w_]+$\") ~= nil\nend\n\nfunction SaveProgress.default(): Payload\n\treturn { notebook = { opened = {}, eye_seconds = 0 }, finished_main = false, appearance = nil, settings = {}, settings_version = SettingsModel.VERSION }\nend\n\n-- Checks a payload and returns (problems, cleaned copy). A wrongly typed or out-of-range field is a problem; a repeat page id and a\n-- preference this build does not know are dropped quietly. `cleaned` is always a fresh table of the right shape (or nil with problems).\nfunction SaveProgress.sanitize(raw: any): ({ string }, Payload?)\n\tlocal problems: { string } = {}\n\tlocal function bad(t: string) if #problems < 12 then table.insert(problems, t) end end\n\tif type(raw) ~= \"table\" then return { \"progress is not a table\" }, nil end\n\tlocal out = SaveProgress.default()\n\tlocal nb = raw.notebook\n\tif type(nb) ~= \"table\" then\n\t\tbad(\"no notebook\")\n\telse\n\t\tif type(nb.opened) ~= \"table\" then\n\t\t\tbad(\"the notebook's pages are not a list\")\n\t\telse\n\t\t\tlocal n = 0\n\t\t\tfor _ in nb.opened do n += 1 end\n\t\t\tif n > SaveRules.MAX_PAGES or #nb.opened ~= n then\n\t\t\t\tbad(\"too many pages, or not a list\")\n\t\t\telse\n\t\t\t\tlocal seen: { [string]: boolean } = {}\n\t\t\t\tfor _, id in nb.opened do\n\t\t\t\t\tif not goodId(id) then bad(\"a page id that is not a short plain name\"); break end\n\t\t\t\t\tif not seen[id] then\n\t\t\t\t\t\tseen[id] = true\n\t\t\t\t\t\ttable.insert(out.notebook.opened, id)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tlocal eye = nb.eye_seconds\n\t\tif not finite(eye) or eye < 0 or eye > SaveRules.MAX_EYE_SECONDS then bad(\"eye seconds out of range\") else out.notebook.eye_seconds = eye end\n\tend\n\tif type(raw.finished_main) ~= \"boolean\" then bad(\"finished_main is not true or false\") else out.finished_main = raw.finished_main end\n\tif raw.appearance ~= nil then\n\t\tif not goodId(raw.appearance) then bad(\"the appearance is not a short plain name\") else out.appearance = raw.appearance end\n\tend\n\tif raw.intro_seen ~= nil then\n\t\tif type(raw.intro_seen) ~= \"boolean\" then bad(\"intro_seen is not true or false\") elseif raw.intro_seen then out.intro_seen = true end\n\tend\n\tif raw.hut_window ~= nil then\n\t\tif type(raw.hut_window) ~= \"boolean\" then bad(\"hut_window is not true or false\") elseif raw.hut_window then out.hut_window = true end\n\tend\n\tif raw.rare~=nil then\n\t\tout.rare=RareLedger.clean(raw.rare)\n\t\tif out.rare==nil then bad(\"invalid rare encounter history\") end\n\tend\n\tlocal version = SettingsModel.VERSION\n\tif raw.settings_version ~= nil then\n\t\tlocal sv = raw.settings_version\n\t\tif not finite(sv) or sv < 1 or sv ~= math.floor(sv) then bad(\"the settings version is not a whole number\") else version = sv end\n\tend\n\t-- An older build must not silently drop future choices and write a downgraded record.\n\tif version > SettingsModel.VERSION then bad(\"settings were written by a newer build\") end\n\tif raw.settings ~= nil then\n\t\tif type(raw.settings) ~= \"table\" then\n\t\t\tbad(\"settings are not a table\")\n\t\telse\n\t\t\tlocal values: { [string]: any } = raw.settings\n\t\t\tif version < SettingsModel.VERSION then values = SettingsModel.migrate(values, version) end\n\t\t\tlocal settingProblems, settings = SettingsModel.cleanAll(values)\n\t\t\tfor _, text in settingProblems do bad(text) end\n\t\t\tout.settings = settings\n\t\tend\n\tend\n\tif #problems > 0 then return problems, nil end\n\treturn problems, out\nend\n\n-- The envelope spec of this kind. Schema 1 was the first (seven toggles as `prefs`); schema 2 (ROBLOX-49) keeps all settings. Add a migration\n-- here when the payload changes shape (see tests/state.luau for the pattern under test).\nSaveProgress.SPEC = {\n\tkind = \"progress\", current = SaveProgress.SCHEMA,\n\tmigrations = {\n\t\t-- 1 to 2 (ROBLOX-49): the seven toggles kept as `prefs` become `settings`; what no longer reads as a setting is left behind.\n\t\t[1] = function(p: any): any\n\t\t\tlocal _, moved = SettingsModel.cleanAll(p.prefs)\n\t\t\tp.settings, p.settings_version, p.prefs = moved, 1, nil\n\t\t\treturn p\n\t\tend,\n\t} :: { [number]: (any) -> any },\n\tvalidate = function(payload: any): ({ string }, any?) return SaveProgress.sanitize(payload) end,\n} :: SaveEnvelope.Spec\n\n-- Merges two payloads: `base` (stored) and `incoming` (this session's). Pages are a union (base order first), eye seconds the longest,\n-- a finished main life stays finished; the appearance and the settings (key by key) come from `incoming` when it is at least as new\n-- (`incomingTime` >= `baseTime`), else from `base`. Both must already be sanitized. Returns a fresh payload; trims to the page cap.\nfunction SaveProgress.merge(base: Payload, incoming: Payload, baseTime: number, incomingTime: number): Payload\n\tlocal out = SaveProgress.default()\n\tlocal seen: { [string]: boolean } = {}\n\tfor _, list in { base.notebook.opened, incoming.notebook.opened } do\n\t\tfor _, id in list do\n\t\t\tif not seen[id] and #out.notebook.opened < SaveRules.MAX_PAGES then\n\t\t\t\tseen[id] = true\n\t\t\t\ttable.insert(out.notebook.opened, id)\n\t\t\tend\n\t\tend\n\tend\n\tout.notebook.eye_seconds = math.max(base.notebook.eye_seconds, incoming.notebook.eye_seconds)\n\tif base.rare or incoming.rare then out.rare=RareLedger.merge(base.rare,incoming.rare) end\n\tout.finished_main = base.finished_main or incoming.finished_main\n\tif base.intro_seen == true or incoming.intro_seen == true then out.intro_seen = true end\n\tif base.hut_window == true or incoming.hut_window == true then out.hut_window = true end\n\tlocal newer, older = incoming, base\n\tif incomingTime < baseTime then newer, older = base, incoming end\n\tout.appearance = if newer.appearance ~= nil then newer.appearance else older.appearance\n\tfor k, v in older.settings do out.settings[k] = v end\n\tfor k, v in newer.settings do out.settings[k] = v end\n\treturn out\nend\n\n-- Whether two payloads say the same thing (for deciding whether a write would change anything).\nfunction SaveProgress.same(a: Payload, b: Payload): boolean\n\tif not RareLedger.same(a.rare,b.rare) then return false end\n\tif a.finished_main ~= b.finished_main or a.appearance ~= b.appearance or a.notebook.eye_seconds ~= b.notebook.eye_seconds then return false end\n\tif (a.intro_seen == true) ~= (b.intro_seen == true) then return false end\n\tif (a.hut_window == true) ~= (b.hut_window == true) then return false end\n\tif #a.notebook.opened ~= #b.notebook.opened then return false end\n\tfor i, id in a.notebook.opened do if b.notebook.opened[i] ~= id then return false end end\n\tfor k, v in a.settings do if b.settings[k] ~= v then return false end end\n\tfor k, v in b.settings do if a.settings[k] ~= v then return false end end\n\treturn true\nend\n\n-- The payload the client sends, built from what it holds. `settings` maps a setting id to its current value or nil (not set); only values\n-- that are clean (SettingsModel.clean) are sent. `introSeen` (ROBLOX-109): the intro of a new life has been shown (left out, or false: not said). `hutWindow`\n-- (ROBLOX-116): the preserve's hut window is open (left out, or false: not said).\nfunction SaveProgress.snapshot(notebookRecord: any, finishedMain: boolean, appearance: string?, settings: { [string]: any }, introSeen: boolean?, hutWindow: boolean?, rare: RareLedger.Record?): Payload\n\tlocal out = SaveProgress.default()\n\tif type(notebookRecord) == \"table\" then\n\t\tif type(notebookRecord.opened) == \"table\" then\n\t\t\tfor _, id in notebookRecord.opened do\n\t\t\t\tif goodId(id) and #out.notebook.opened < SaveRules.MAX_PAGES and not table.find(out.notebook.opened, id) then table.insert(out.notebook.opened, id) end\n\t\t\tend\n\t\tend\n\t\tif finite(notebookRecord.eye_seconds) and notebookRecord.eye_seconds >= 0 then out.notebook.eye_seconds = math.min(notebookRecord.eye_seconds, SaveRules.MAX_EYE_SECONDS) end\n\tend\n\tif rare and rare.serial>0 then out.rare=RareLedger.clean(rare) end\n\tout.finished_main = finishedMain\n\tif introSeen == true then out.intro_seen = true end\n\tif hutWindow == true then out.hut_window = true end\n\tif appearance ~= nil and goodId(appearance) then out.appearance = appearance end\n\tfor _, id in SettingsModel.ids() do\n\t\tlocal v = SettingsModel.clean(id, settings[id])\n\t\tif v ~= nil then out.settings[id] = v end\n\tend\n\treturn out\nend\n\nreturn SaveProgress\n",10744,1425564381},{"Shared/Persistence/SaveRest","--!strict\n-- The last rest of a mode, as the server keeps it (ROBLOX-39): a retreat checkpoint (Checkpoint) in an envelope, one per mode.\n-- The simulation runs on the client, so the server cannot know the rest is a true one. What it can do, and does, is refuse anything that\n-- is not a whole, well-formed, sensible rest before it is stored: bounded size and depth, only plain values, the full checkpoint check\n-- (Checkpoint.check: format, schema, windowsill, the spider's pose, every reference in the object graph, the books adding up) against a\n-- stand-in world that names the same things the real one does, and the rules in the record agreeing with the mode it is filed under.\n-- This is a boundary for corruption safety, not anti-cheat: this is a solo game with no economy, so a client that lies only affects its\n-- own rest. A rest from a newer game build is refused here and, if it is already stored, left alone by SaveSession.\nlocal SaveRules = require(script.Parent.Parent.Data.SaveRules)\nlocal Species = require(script.Parent.Parent.Data.Species)\nlocal Json = require(script.Parent.Json)\nlocal Checkpoint = require(script.Parent.Checkpoint)\nlocal SaveEnvelope = require(script.Parent.SaveEnvelope)\n\nlocal SaveRest = {}\n\n-- Schema 2 accepts a checksummed {save_retired=true,save_life=token} marker or a checkpoint with optional save_life.\n-- The identity is storage metadata, not simulation state. Schema 1 migrates without changing its checkpoint.\n-- Older readers must refuse schema 2, preserving the marker and its previous-checkpoint backup.\nSaveRest.SCHEMA = 2\nfunction SaveRest.validLife(token: any): boolean\n return type(token)==\"string\" and #token>=1 and #token<=SaveRules.MAX_LIFE_TOKEN_CHARS and string.match(token,\"^[%w_:%.%-]+$\")~=nil\nend\nfunction SaveRest.isRetired(payload: any): boolean\n return type(payload)==\"table\" and rawget(payload,\"save_retired\")==true\nend\nlocal function validateStored(mode: string,payload: any): ({string},any?)\n if SaveRest.isRetired(payload) then\n  if not SaveRest.validLife(payload.save_life) then return {\"invalid retired life identity\"},nil end\n  for key in payload do if key~=\"save_retired\" and key~=\"save_life\" then return {\"unknown retirement field\"},nil end end\n  return {},payload\n end\n if type(payload)==\"table\" and (payload.save_retired~=nil or (payload.save_life~=nil and not SaveRest.validLife(payload.save_life))) then\n  return {\"invalid life identity\"},nil\n end\n return SaveRest.check(mode,payload),payload\nend\n\n-- Counts the values in `v` and refuses anything that is not a plain string, boolean, finite number or table without a metatable, a\n-- table met twice, or a structure deeper than `maxDepth` or larger than `maxNodes`. Cheap and bounded: a hostile payload is stopped\n-- before anything encodes it. Returns the problem, or nil.\nfunction SaveRest.bounded(v: any, maxNodes: number, maxDepth: number): string?\n\tlocal nodes = 0\n\tlocal seen: { [any]: boolean } = {}\n\tlocal problem: string? = nil\n\tlocal function walk(x: any, depth: number)\n\t\tif problem then return end\n\t\tnodes += 1\n\t\tif nodes > maxNodes then problem = \"too many values\"; return end\n\t\tlocal t = type(x)\n\t\tif t == \"string\" or t == \"boolean\" then return end\n\t\tif t == \"number\" then\n\t\t\tif x ~= x or x == math.huge or x == -math.huge then problem = \"a number JSON cannot hold\" end\n\t\t\treturn\n\t\tend\n\t\tif t ~= \"table\" then problem = `a {typeof(x)}, which a save cannot hold`; return end\n\t\tif depth > maxDepth then problem = \"nested too deeply\"; return end\n\t\tif getmetatable(x) ~= nil then problem = \"a table with a metatable\"; return end\n\t\tif seen[x] then problem = \"a table met twice\"; return end\n\t\tseen[x] = true\n\t\tfor k, y in x do\n\t\t\tif type(k) ~= \"string\" and type(k) ~= \"number\" then problem = \"a key that is not a string or a number\"; return end\n\t\t\twalk(y, depth + 1)\n\t\t\tif problem then return end\n\t\tend\n\tend\n\twalk(v, 1)\n\treturn problem\nend\n\n-- The stand-in world: whatever a real client's world offers to Checkpoint.refs, in the same names. A record names these by string; the\n-- server needs only that they exist. The species data is the real one (the record's profile references are paths into it).\nlocal function noop() end\nlocal function stubWorld(): Checkpoint.World\n\treturn {\n\t\tmotor = {}, \n\t\tprey = { p = Species.fly_like_prototype, graph = { cast = noop, sweep = noop, overlap = noop }, probe = {} },\n\t\tsensor = { core = { cueEmitted = {} } },\n\t\tmemory = { contactAcquired = {}, categoryChanged = {}, contactLost = {}, contactReacquired = {}, contactEnded = {} },\n\t\tneeds = { onEnergyChanged = noop },\n\t\tlife = { save = noop },\n\t} :: any\nend\nSaveRest.stubWorld = stubWorld\n\n-- Every problem with a rest filed under slot `mode` (\"main\", \"easy\" or \"free\", SaveRules.slotOf); an empty list for a good one. Never raises.\nfunction SaveRest.check(mode: any, record: any): { string }\n\tif mode ~= \"main\" and mode ~= \"free\" and mode ~= \"easy\" then return { \"unknown mode\" } end\n\tif type(record) ~= \"table\" then return { \"the rest is not a table\" } end\n if rawget(record,\"save_retired\")~=nil or (rawget(record,\"save_life\")~=nil and not SaveRest.validLife(rawget(record,\"save_life\"))) then return {\"reserved or invalid life identity\"} end\n\tlocal why = SaveRest.bounded(record, SaveRules.MAX_REST_NODES, SaveRules.MAX_DEPTH)\n\tif why then return { why } end\n\tlocal text, err = Json.canonical(record)\n\tif not text then return { \"cannot be stored: \" .. tostring(err) } end\n\tif #text > SaveRules.MAX_REST_CHARS then return { `the rest is {#text} characters; the limit is {SaveRules.MAX_REST_CHARS}` } end\n\tlocal rules = record.life_rules\n\t-- (the main slot also takes a main life on the gentle rules: an Easy rest saved before the Easy slot existed was filed there)\n\tif type(rules) ~= \"table\" or rules.mode ~= (if mode == \"free\" then \"free\" else \"main\") or (mode == \"easy\" and rules.rules ~= \"gentle\") then\n\t\treturn { `the rules in this rest are not {mode}'s` }\n\tend\n\tlocal ok, result = pcall(function(): { string }\n\t\tlocal found = Checkpoint.check(record, stubWorld())\n\t\treturn found\n\tend)\n\tif not ok then return { \"the check raised: \" .. tostring(result) } end\n\treturn result :: { string }\nend\n\n-- The envelope spec of a rest of `mode`.\nfunction SaveRest.spec(mode: string): SaveEnvelope.Spec\n\treturn {\n\t\tkind = \"rest_\" .. mode, current = SaveRest.SCHEMA,\n\t\tmigrations = { [1] = function(payload: any): any return payload end } :: { [number]: (any) -> any },\n  validate = function(payload: any): ({ string }, any?) return validateStored(mode,payload) end,\n\t}\nend\n\nSaveRest.SPECS = { main = SaveRest.spec(\"main\"), free = SaveRest.spec(\"free\"), easy = SaveRest.spec(\"easy\") }\n\nreturn SaveRest\n",6622,3518617965},{"Shared/Persistence/SaveScheduler","--!strict\n-- When a save is written (ROBLOX-39): only decisions, no store and no clock of its own (the caller passes `now`, in seconds). It keeps, for\n-- each thing worth saving, whether it has changed since the last good write, the earliest time to try again, and how often it has failed;\n-- plus the lock's heartbeat and the one-minute request budget.\n--   * a change marks the thing dirty; progress is written at most once per PROGRESS_DEBOUNCE (changes in between are coalesced into the\n--     one write), a rest at most once per REST_MIN_INTERVAL (a key takes a write about every 6 s)\n--   * a failure keeps it dirty and waits BACKOFF_BASE * 2^(failures - 1) seconds, up to BACKOFF_CAP (a throttle waits twice as long; a\n--     configuration error waits the cap)\n--   * a success clears it, unless it changed again while the write was in flight (the version counter), when it stays dirty\n--   * the budget: at most REQUESTS_PER_MINUTE requests started in any minute; leaving the game or shutting down may go past it\nlocal SaveRules = require(script.Parent.Parent.Data.SaveRules)\n\nlocal SaveScheduler = {}\nSaveScheduler.__index = SaveScheduler\n\nexport type Item = { dirty: boolean, version: number, sentVersion: number, nextAt: number, lastWriteAt: number, failures: number, minInterval: number, lastClass: string }\n\nfunction SaveScheduler.new(): any\n\treturn setmetatable({ items = {} :: { [string]: Item }, started = {} :: { number }, lastBeat = -1e9 }, SaveScheduler)\nend\n\nfunction SaveScheduler.track(self: any, name: string, minInterval: number)\n\tself.items[name] = { dirty = false, version = 0, sentVersion = 0, nextAt = 0, lastWriteAt = -1e9, failures = 0, minInterval = minInterval, lastClass = \"\" }\nend\n\n-- Something changed. The first change of a clean item sets when it is due; later changes keep that time (they join the same write).\nfunction SaveScheduler.markDirty(self: any, name: string, now: number)\n\tlocal it: Item = self.items[name]\n\tit.version += 1\n\tif not it.dirty then\n\t\tit.dirty = true\n\t\tit.nextAt = math.max(now, it.lastWriteAt + it.minInterval)\n\tend\nend\n\nfunction SaveScheduler.isDirty(self: any, name: string): boolean\n\treturn self.items[name].dirty\nend\n\nfunction SaveScheduler.anyDirty(self: any): boolean\n\tfor _, it in self.items do if it.dirty then return true end end\n\treturn false\nend\n\nfunction SaveScheduler.failures(self: any, name: string): number\n\treturn self.items[name].failures\nend\n\n-- How many requests were started in the last minute.\nlocal function recent(self: any, now: number): number\n\tlocal keep: { number } = {}\n\tfor _, t in self.started do if now - t < 60 then table.insert(keep, t) end end\n\tself.started = keep\n\treturn #keep\nend\n\nfunction SaveScheduler.budgetOk(self: any, now: number): boolean\n\treturn recent(self, now) < SaveRules.REQUESTS_PER_MINUTE\nend\n\n-- A request is starting (counts against the budget). Returns the version being written, to hand back to `succeeded`.\nfunction SaveScheduler.begin(self: any, name: string?, now: number): number\n\ttable.insert(self.started, now)\n\tif name == nil then return 0 end\n\tlocal it: Item = self.items[name]\n\tit.sentVersion = it.version\n\treturn it.version\nend\n\n-- Is this item due: dirty, its time has come, and the budget allows a request?\nfunction SaveScheduler.due(self: any, name: string, now: number): boolean\n\tlocal it: Item = self.items[name]\n\treturn it.dirty and now >= it.nextAt and self:budgetOk(now)\nend\n\nfunction SaveScheduler.succeeded(self: any, name: string, now: number, version: number)\n\tlocal it: Item