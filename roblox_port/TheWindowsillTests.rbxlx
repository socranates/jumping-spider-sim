          <string name="Name">Learning</string>
        </Properties>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">FieldNotebook</string>
            <string name="Source"><![CDATA[--!strict
-- The naturalist's notebook (LEARN-01), a port of the frozen scripts/learning/field_notebook.gd without the file and the node.
-- Spec 4: "an optional naturalist notebook with sourced facts, separated from in-world perception". Each page of
-- Data/NotebookPages opens the first time its trigger happens in play: the first jump, the first time in the eye view, a first
-- meal, and so on. The notebook belongs to the player, not to the spider: the client keeps it outside the world's checkpoints (a
-- return to a rest never erases a page) and a new, unrelated spider opens the same book. It decides nothing in the game and the
-- spider learns nothing from it. Pages are listed in the order they were found; a page not yet found cannot be read through
-- `view` or `list`, and nothing counts the pages left (spec 4: discovery must not become a completion checklist).
-- Differences from Godot: the book is held in memory for the session (no file: server-owned saving is separate work); `toRecord`
-- and `load` are the shape of Godot's save and its tolerant reading, for that later work. Checked in tests/notebook.luau.

local Signal = require(script.Parent.Parent.Perception.Signal)
local Data = require(script.Parent.Parent.Data.NotebookPages)

local FieldNotebook = {}
FieldNotebook.__index = FieldNotebook

export type Page = Data.Page
export type Record = { opened: { string }, eye_seconds: number }
export type Entry = { day: number, text: string }

-- ROBLOX-89: dated lines the game adds to a page the book already has ("things you saw"; never a page of their own, and never shown before the page is found): at most
-- this many to a page, the oldest dropped. They belong to the session, not to the record: `toRecord` and `load` do not carry them (the save has no field for them).
FieldNotebook.MAX_ENTRIES = 6

-- What is wrong with a page, empty when nothing is (Godot's `problems`): a missing field, an unknown trigger or no source.
function FieldNotebook.problems(p: any): { string }
	local out: { string } = {}
	if type(p) ~= "table" then
		return { "not a page" }
	end
	for _, key in { "id", "trigger", "title", "text" } do
		local v = p[key]
		if type(v) ~= "string" or string.match(v, "^%s*$") then
			table.insert(out, `no {key}`)
		end
	end
	if not table.find(Data.triggers, p.trigger) then
		table.insert(out, `unknown trigger {tostring(p.trigger)}`)
	end
	if type(p.sources) ~= "table" or #p.sources == 0 then
		table.insert(out, "no source")
	end
	return out
end

-- `pages` defaults to the notebook's own; a page with a problem or a repeated id is left out (and listed in `dropped`).
function FieldNotebook.new(pages: { Page }?): any
	local self = setmetatable({
		pages = {} :: { Page },
		opened = {} :: { string },
		eyeSeconds = 0.0,
		dropped = {} :: { string },
		entries = {} :: { [string]: { Entry } },
		pageOpened = Signal.new(), -- (id): a page opened now, after it is in `opened`
		_byId = {} :: { [string]: Page },
		_open = {} :: { [string]: boolean },
	}, FieldNotebook)
	for _, p in pages or Data.pages do
		if #FieldNotebook.problems(p) == 0 and not self._byId[p.id] then
			table.insert(self.pages, p)
			self._byId[p.id] = p
		else
			table.insert(self.dropped, if type(p) == "table" and type(p.id) == "string" then p.id else "?")
		end
	end
	return self
end

function FieldNotebook.isOpen(self: any, id: string): boolean
	return self._open[id] == true
end

-- Whether the book has a page of this id at all (found or not). The panel never shows anything else about an unfound page.
function FieldNotebook.has(self: any, id: string): boolean
	return self._byId[id] ~= nil
end

-- The page, only once it is found: nil before its observation, so nothing can show it early.
function FieldNotebook.view(self: any, id: string): Page?
	if self._open[id] then
		return self._byId[id]
	end
	return nil
end

-- A dated line on a page of the book ("Day 4: ..."), kept for the session. Returns whether it was added (a page the book has, a day and some words, and not a line
-- the page already has).
function FieldNotebook.addEntry(self: any, id: string, day: number, text: string): boolean
	if self._byId[id] == nil or type(text) ~= "string" or string.match(text, "^%s*$") then return false end
	if type(day) ~= "number" or day ~= day or day < 0 or day == math.huge then return false end
	local list: { Entry } = self.entries[id] or {}
	for _, e in list do
		if e.day == day and e.text == text then return false end
	end
	table.insert(list, { day = day, text = text })
	while #list > FieldNotebook.MAX_ENTRIES do table.remove(list, 1) end
	self.entries[id] = list
	return true
end

-- The lines on a page, only once the page is found (a page not yet found shows nothing, its lines included), oldest first.
function FieldNotebook.entriesFor(self: any, id: string): { Entry }
	if not self._open[id] then return {} end
	local out: { Entry } = {}
	for _, e in self.entries[id] or {} do table.insert(out, { day = e.day, text = e.text }) end
	return out
end

-- Found pages as {id, title}, in the order they were found.
function FieldNotebook.list(self: any): { { id: string, title: string } }
	local out = {}
	for _, id in self.opened do
		table.insert(out, { id = id, title = self._byId[id].title })
	end
	return out
end

-- The id of the page found last (nil when none).
function FieldNotebook.newest(self: any): string?
	return self.opened[#self.opened]
end

-- Opens every page with this trigger that is not open yet. Returns the ids opened now, in the order of the pages.
function FieldNotebook.notice(self: any, trigger: string): { string }
	local now: { string } = {}
	for _, p in self.pages do
		if p.trigger == trigger and not self._open[p.id] then
			self._open[p.id] = true
			table.insert(self.opened, p.id)
			table.insert(now, p.id)
		end
	end
	for _, id in now do
		self.pageOpened:emit(id)
	end
	return now
end

-- A leap of `distanceWu` studs: the first jump, and a far and a long one.
function FieldNotebook.noticeJump(self: any, distanceWu: number)
	if distanceWu ~= distanceWu or distanceWu < 0 or distanceWu == math.huge then return end
	self:notice("jump")
	if distanceWu >= Data.jumpFarWu then
		self:notice("jump_far")
	end
	if distanceWu >= Data.jumpLongWu then
		self:notice("jump_long")
	end
end

-- Time in the spider-eye view, in seconds of play (the game's own time: slow motion slows it, a menu holds it).
function FieldNotebook.addEyeTime(self: any, seconds: number)
	local before = self.eyeSeconds
	if seconds == seconds and seconds > 0 and seconds < math.huge then
		self.eyeSeconds += seconds
	end
	for _, mark in Data.eyeMarks do
		if before < mark and self.eyeSeconds >= mark then
			self:notice(`eye_time_{mark}`)
		end
	end
end

-- The player's notebook as a plain record (Godot's file, as a table).
function FieldNotebook.toRecord(self: any): Record
	return { opened = table.clone(self.opened), eye_seconds = self.eyeSeconds }
end

-- Reads a record (Godot's load_saved). Anything unreadable is an empty notebook; ids no page has any more and repeats are
-- dropped; a bad number of eye seconds is none. Announces nothing.
function FieldNotebook.load(self: any, record: any)
	table.clear(self.opened)
	table.clear(self._open)
	self.eyeSeconds = 0.0
	if type(record) ~= "table" then
		return
	end
	if type(record.opened) == "table" then
		for _, id in record.opened do
			if type(id) == "string" and self._byId[id] and not self._open[id] then
				self._open[id] = true
				table.insert(self.opened, id)
			end
		end
	end
	local eye = record.eye_seconds
	if type(eye) == "number" and eye == eye and eye >= 0 and eye < math.huge then
		self.eyeSeconds = eye
	end
end

return FieldNotebook
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">NotebookWatch</string>
            <string name="Source"><![CDATA[--!strict
-- Watches play for the moments the naturalist's notebook opens pages on: a port of the frozen scripts/learning/notebook_watch.gd.
-- It only listens and reads: it changes nothing the spider does, knows or senses. Godot connects signals; the Roblox client has an
-- event loop instead, so the client hands this the events it already has (a committed leap, a refined category, the life loop's and
-- the wasp's events, the eye view each frame) and, once a fixed tick, a view of the state that has no event (catches, a meal ending,
-- the reserve changing, a fly taking off). It never reads the HUD's words. Nothing here runs while the game waits (the client
-- calls it from the fixed tick and the frame it already pauses).
--
-- Which trigger comes from where (Godot's -> Roblox's):
--   start .......... a life is being played (Godot: the world is ready; here, not while the menu waits for the first life)
--   jump, jump_far, jump_long ... a committed leap, by the distance from take-off to the landing point (hops too)
--   eye_view, eye_time_N ....... the spider-eye view is on; seconds in it
--   shimmer ........ the eye view is drawing a movement ring or edge arc
--   fly_recognised . the memory's category for a contact is refined to fly-like prey
--   catch .......... a fly is seized (PreyDirector.captures goes up)
--   meal ........... eating ends with something eaten (Godot's feeding_ended with food taken)
--   buzz ........... a fly takes off within hearWu of the spider (Godot's caption "[buzzing", the flies' take-off within HEAR_WU)
--   rest, sleep .... the life loop's rest_started, and woke (the morning after a night's sleep)
--   moult_ready, moulted, adult ... the life loop's events; adult when the moult reaches the adult stage
--   hungry, well_fed, starving ... the reserve changes to at or under hungryAt, at or over wellFedAt, or to nothing (not on Easy)
--   wasp, wasp_escaped, wasp_caught ... the director's visit_started, left (it had noticed the spider), caught
--   antennae ....... the ant-mimicking spider has stood still with its antennae up for AntMimic.noticeSeconds (the client's pose says how long)
--   garden_bed ..... (ROBLOX-96, the Roblox game's own) the spider's first step onto a bed of the garden: the view's `region` is a region of kind "bed"
--   look_ladybird, look_millipede, look_snail, look_harvestman ... (ROBLOX-105) the same for the ambient bugs: one of the view's `bugs` of the kind, not
--                    hidden, within lookWu of the spider
--   look_springtail, look_leafhopper, look_moth, look_crane_fly ... (ROBLOX-101) the first close look at a prey of that kind: one of the view's flies of the kind
--                    (Species body.prey_kind, NotebookPages.looks) within lookWu of the spider, perched or flying; distance only, not the sensor's say
-- Not wired: felt. It answers to Godot's vibration sense (a felt shake through touching surfaces), which the port does not have, so
-- that page cannot open yet; the notebook never opens a page for something the game does not do.
-- Checked in tests/notebook.luau.

local Data = require(script.Parent.Parent.Data.NotebookPages)
local AntMimic = require(script.Parent.Parent.Data.AntMimic)

local NotebookWatch = {}
NotebookWatch.__index = NotebookWatch

-- Triggers this watcher can open a page on, and those it cannot (with the reason).
NotebookWatch.UNWIRED = { felt = "the port has no vibration sense" } :: { [string]: string }

-- The adult stage of Growth (Growth.ADULT), read here as a number so the notebook needs nothing of the life modules.
local ADULT_STAGE = 3

-- What the fixed tick tells the watcher (see `step`).
export type View = {
	started: boolean, -- a life is being played
	captures: number, -- PreyDirector.captures
	feeding: boolean, -- Feeding.feeding
	taken: number, -- Feeding.taken
	energy: number, -- the reserve, 0 to 1
	gentle: boolean, -- Easy or free play: it cannot starve
	spider: Vector3,
	flies: { any }, -- the flies: .id, .position and :airborne()
	region: string?, -- ROBLOX-96: the kind of the region the spider is in ("sill", "bed", ...); nil in a world without one
	bugs: { any }?, -- ROBLOX-105: the ambient bugs about (Prey/PreyWorld.crawlers: .kind, .position, .hidden); nil or none in a world without them
}

function NotebookWatch.new(book: any): any
	local self = setmetatable({
		book = book,
		primed = false, -- whether `step` has taken its first look since the world changed (resync)
		started = false,
		captures = 0, feeding = false, taken = 0.0, takenAtStart = 0.0, energy = 1.0,
		flying = {} :: { [string]: boolean },
	}, NotebookWatch)
	return self
end

-- The world changed under the watcher (a return to a rest, a new spider): the next `step` only takes a fresh look, so nothing that
-- happened before the change, or that the change itself did, opens a page.
function NotebookWatch.resync(self: any)
	self.primed = false
end

-- A committed leap of `distance` studs.
function NotebookWatch.onJump(self: any, distance: number)
	self.book:noticeJump(distance)
end

-- A contact's category was refined or fell back to `category` (ObservationMemory.categoryChanged).
function NotebookWatch.onCategory(self: any, category: string)
	if category == "fly_like_prey" then
		self.book:notice("fly_recognised")
	end
end

-- A life loop event ({kind, day}); `stage` is the growth stage after it.
function NotebookWatch.onLife(self: any, kind: string, stage: number)
	if kind == "rest_started" then
		self.book:notice("rest")
	elseif kind == "woke" then
		self.book:notice("sleep")
	elseif kind == "moult_ready" then
		self.book:notice("moult_ready")
	elseif kind == "moulted" then
		self.book:notice("moulted")
		if stage >= ADULT_STAGE then
			self.book:notice("adult")
		end
	end
end

-- A wasp director signal ({kind, escaped}).
function NotebookWatch.onWasp(self: any, kind: string, escaped: boolean?)
	if kind == "visit_started" then
		self.book:notice("wasp")
	elseif kind == "left" then
		if escaped == true then
			self.book:notice("wasp_escaped")
		end
	elseif kind == "caught" then
		self.book:notice("wasp_caught")
	end
end

-- (ROBLOX-118) The ranger's cat noticed the spider (Predator/Cat's "noticed"): the cat's page.
function NotebookWatch.onCat(self: any)
	self.book:notice("cat")
end

-- (ROBLOX-119) The spider came close to a crab spider on its flower (Predator/CrabSpider's "seen"): the crab spider's page.
function NotebookWatch.onCrab(self: any)
	self.book:notice("crab_spider")
end

-- (ROBLOX-122) The green frog noticed the spider, or the spider came close to it: the frog's page.
function NotebookWatch.onFrog(self: any)
	self.book:notice("frog")
end

-- (ROBLOX-122) The green darner passed near the spider: its page.
function NotebookWatch.onDarner(self: any)
	self.book:notice("darner")
end

-- (ROBLOX-122) The spider fell into the water: the page on spiders and water.
function NotebookWatch.onWater(self: any)
	self.book:notice("water")
end

-- (ROBLOX-120) The robin was told to the spider (Predator/Bird: its shadow passed near, it landed near, or it noticed the spider): the robin's page.
function NotebookWatch.onBird(self: any)
	self.book:notice("robin")
end

-- Each rendered frame while the ant-mimicking spider is being played: how long its antennae (legs I) have been fully up. Standing still long
-- enough for the pose (AntMimic.noticeSeconds) is what opens the walking-like-an-ant page. The client calls this; nothing here reads the pose.
function NotebookWatch.antennae(self: any, shownSeconds: number)
	if shownSeconds >= AntMimic.noticeSeconds then
		self.book:notice("antennae")
	end
end

-- Each rendered frame: `seconds` of play (0 while the game waits), whether the eye view is on and how many movement marks it draws.
function NotebookWatch.frame(self: any, seconds: number, eyeView: boolean, movers: number)
	if not eyeView then
		return
	end
	self.book:notice("eye_view")
	self.book:addEyeTime(seconds)
	if movers > 0 then
		self.book:notice("shimmer")
	end
end

-- Each fixed tick, after the spider, the flies and the life loop have moved.
function NotebookWatch.step(self: any, v: View)
	local book = self.book
	if v.started and not self.started then
		self.started = true
		book:notice("start")
	end
	if not self.primed then
		-- The first look only takes the baseline.
		self.primed = true
		self.captures, self.feeding, self.taken, self.takenAtStart, self.energy = v.captures, v.feeding, v.taken, v.taken, v.energy
		table.clear(self.flying)
		for _, f in v.flies do
			self.flying[f.id] = f:airborne()
		end
		return
	end
	if v.captures > self.captures then
		book:notice("catch")
	end
	self.captures = v.captures
	-- Eating ending with something eaten is a meal (Godot: feeding_ended with food taken).
	if v.feeding and not self.feeding then
		self.takenAtStart = self.taken
	elseif self.feeding and not v.feeding and v.taken > self.takenAtStart + 1e-9 then
		book:notice("meal")
	end
	self.feeding, self.taken = v.feeding, v.taken
	-- The reserve changed (Godot's energy_changed).
	if v.energy ~= self.energy then
		self.energy = v.energy
		if v.energy <= 0 and not v.gentle then
			book:notice("starving")
		end
		if v.energy <= Data.hungryAt then
			book:notice("hungry")
		elseif v.energy >= Data.wellFedAt then
			book:notice("well_fed")
		end
	end
	-- ROBLOX-96: the first step onto a garden bed.
	if v.region == "bed" then
		book:notice("garden_bed")
	end
	-- A fly taking off near enough to hear; (ROBLOX-101) a close look at one of the bestiary's.
	local seen: { [string]: boolean } = {}
	for _, f in v.flies do
		local kind = if f.profile ~= nil and f.profile.body ~= nil then f.profile.body.prey_kind else nil
		local look = if kind ~= nil then Data.looks[kind] else nil
		if look ~= nil and (f.position - v.spider).Magnitude <= Data.lookWu then book:notice(look) end
		local up: boolean = f:airborne()
		seen[f.id] = up
		if up and not self.flying[f.id] and (f.position - v.spider).Magnitude <= Data.hearWu then
			book:notice("buzz")
		end
	end
	self.flying = seen
	-- (ROBLOX-105) a close look at one of the ambient bugs, out in the open (a woodlouse has no `kind`: its page is the ground's)
	for _, b in (v.bugs or {}) :: { any } do
		local look = if b.kind ~= nil then Data.looks[b.kind] else nil
		if look ~= nil and not b.hidden and (b.position - v.spider).Magnitude <= Data.lookWu then book:notice(look) end
	end
end

return NotebookWatch
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">Life</string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Ballooning</string>
            <string name="Source"><![CDATA[--!strict
-- Ballooning, the lineage moves (ROBLOX-120, docs/PARK_WORLD_DESIGN.md section 5: "the spiderlings balloon. The player chooses one to follow: where it lands is drawn from
-- the wind (seeded, honest: mostly nearby zones, rarely far), and the next life starts in that zone"). The notebook's page "Eggs, silk and wind" says what is known: many
-- young spiders travel by climbing high, letting out a thread of silk and being carried off by the air. Pure: the client plays the ride (Client/MateStage's rider and the
-- camera's shot) and starts the next generation where it lands; the CLI suites and the self-test ask the same draw.
--
-- The draw (`land`): a pure function of the world's seed, the family's number and the day the eggs hatched, so a choice seen again lands in the same place and a
-- restore never rerolls it. Each zone of ZONES has a weight that falls off with its distance from the hut (WEIGHT_M metres: exp(-d / WEIGHT_M)), so the near zones are
-- the likely ones and the far ones rare; only a zone that is built (`built`, walkable in the preserve: World/Hut, World/Meadow) can be landed in, the others are listed
-- for when they are, and drop out of the draw. In a built zone the landing is one of its `landings`, regions whose spawn is a place to stand (a spiderling's thread
-- snags on what stands up, and it comes down there). The compact preserve keeps the garden most likely, then the meadow and pond. Their odds follow the actual
-- relocated home ranges rather than retaining probabilities for the former distant pond.
--
-- The ride (`ride`, `at`): RIDE_S seconds from the egg sac in the sill's crack out through the window's sash and up over the garden on the wind, its thread streaming
-- ahead and above it, then down onto the landing; a seeded drift and a sway, never the same twice for two families and always the same for one.
-- `life.start_zone` (optional in a rest, Persistence/Checkpoint: absent is "hut", the generation that began in the crack) and `life.start_region` keep where this
-- generation began; the ending card, the toast and the notebook's dated line say it (UI/MateText). The nursery's shut window (Life/Nursery) is the hut's inside: a
-- generation that lands outside is in the wild, and nothing puts it back.
local Preserve = require(script.Parent.Parent.World.Preserve)

local Ballooning = {}

Ballooning.RIDE_S = 12.0
Ballooning.WEIGHT_M = 10.0
Ballooning.HUT = "hut" -- (the start of a generation that stayed in the crack)
Ballooning.SAC = Vector3.new(-27.1, 0.5, 8.4) -- (Data/MatingRules.sacAt: the egg sac in the sill's crack)
Ballooning.SASH = Vector3.new(0, 4, -16) -- the window's lower sash, out of which the threads go (World/Hut.SASH, just outside it)
Ballooning.UP = 260 -- how high over the garden's ground a ride climbs (studs), at most

export type Zone = { zone: string, name: string, built: boolean, landings: { string } }
local function zone(id: string, name: string, built: boolean, landings: { string }): Zone
	return table.freeze({ zone = id, name = name, built = built, landings = table.freeze(landings) })
end
Ballooning.ZONES = table.freeze({
	zone("hut_garden", "the hut garden", true, { "garden_a2", "garden_a4", "garden_b1", "garden_c2", "garden_d2" }),
	zone("meadow", "the meadow's edge", true, { "meadow_b1", "meadow_b3", "meadow_c3", "meadow_d2", "meadow_d5", "meadow_e3" }),
	zone("pond_edge", "the pond's edge", true, { "pond_a1", "pond_b1", "deck_n2", "deck_s3" }), -- (ROBLOX-122: built; its threads snag on the sedge, the rushes and the boardwalk's rail)
	zone("log_pile", "the log pile", false, {}),
	zone("veteran_oak", "the old oak", false, {}),
	zone("stone_wall", "the stone wall", false, {}),
	zone("bramble", "the bramble by the railway", false, {}),
	zone("compost", "the compost bays", false, {}),
}) :: { Zone }
local BY_ZONE: { [string]: Zone } = {}
for _, z in Ballooning.ZONES do BY_ZONE[z.zone] = z end
function Ballooning.zone(id: string): Zone?
	return BY_ZONE[id]
end

-- A zone's distance from the hut (metres, home range to home range: World/Preserve.HOME_RANGES).
function Ballooning.distance(id: string): number
	local hut, here = nil :: Preserve.HomeRange?, nil :: Preserve.HomeRange?
	for _, h in Preserve.HOME_RANGES do
		if h.id == "ranger_hut" then hut = h end
		if h.id == id then here = h end
	end
	if hut == nil or here == nil then return math.huge end
	return math.sqrt((here.at[1] - hut.at[1]) ^ 2 + (here.at[2] - hut.at[2]) ^ 2)
end
-- A zone's weight in the draw (0 for one not built).
function Ballooning.weight(z: Zone): number
	if not z.built or #z.landings == 0 then return 0 end
	return math.exp(-Ballooning.distance(z.zone) / Ballooning.WEIGHT_M)
end

local MOD = 2147483647
local function stream(seed: number, generation: number, day: number, salt: number): () -> number
	local s = (math.floor(seed) * 83492791 + generation * 19349663 + day * 73856093 + salt * 2654435) % MOD
	if s <= 0 then s += MOD - 1 end
	return function(): number
		s = (s * 48271) % MOD
		return (s - 1) / (MOD - 1)
	end
end

-- Where the followed spiderling lands: its zone and its landing region.
function Ballooning.land(seed: number, generation: number, day: number): (string, string)
	local rand = stream(seed, generation, day, 41)
	rand()
	local total = 0
	for _, z in Ballooning.ZONES do total += Ballooning.weight(z) end
	local x = rand() * total
	local pick = Ballooning.ZONES[1]
	for _, z in Ballooning.ZONES do
		local w = Ballooning.weight(z)
		if w > 0 then
			pick = z
			x -= w
			if x <= 0 then break end
		end
	end
	local i = 1 + math.floor(rand() * #pick.landings) % #pick.landings
	return pick.zone, pick.landings[i]
end

-- Whether a start zone is one a rest may name: the hut, or a zone that can be landed in.
function Ballooning.valid(id: any): boolean
	if id == Ballooning.HUT then return true end
	local z = if type(id) == "string" then BY_ZONE[id] else nil
	return z ~= nil and z.built
end
-- Whether a landing region belongs to a start zone.
function Ballooning.landsIn(zoneId: string, region: any): boolean
	local z = BY_ZONE[zoneId]
	return z ~= nil and type(region) == "string" and table.find(z.landings, region) ~= nil
end

-- The ride from the sac to `to` (the landing region's spawn): its seconds and the seeded drift.
export type Ride = { from: Vector3, sash: Vector3, apex: Vector3, over: Vector3, to: Vector3, seconds: number, sway: number, phase: number, wind: Vector3 }
function Ballooning.ride(seed: number, generation: number, day: number, to: Vector3): Ride
	local rand = stream(seed, generation, day, 43)
	rand()
	local mid = Ballooning.SASH:Lerp(to, 0.5)
	local wind = Vector3.new(rand() - 0.5, 0, rand() - 0.5)
	local up = math.min(Ballooning.UP, 120 + (to - Ballooning.SASH).Magnitude * 0.18)
	return table.freeze({
		from = Ballooning.SAC, sash = Ballooning.SASH,
		apex = Vector3.new(mid.X + wind.X * 120, Preserve.GROUND_Y + up + rand() * 40, mid.Z + wind.Z * 60),
		over = to + Vector3.new(wind.X * 20, 40, wind.Z * 20), to = to,
		seconds = Ballooning.RIDE_S, sway = 6 + rand() * 6, phase = rand() * 2 * math.pi, wind = wind,
	})
end

local function bezier(a: Vector3, b: Vector3, c: Vector3, t: number): Vector3
	local u = 1 - t
	return a * (u * u) + b * (2 * u * t) + c * (t * t)
end
-- Where the rider is `t` seconds into the ride, and the thread's far end (ahead of it and above, downwind). Done at `seconds`: on the landing.
function Ballooning.at(r: Ride, t: number, reduced: boolean?): (Vector3, Vector3)
	local k = math.clamp(t / r.seconds, 0, 1)
	local p: Vector3
	if k < 0.12 then
		local e = k / 0.12
		p = r.from:Lerp(r.sash, e * e * (3 - 2 * e))
	elseif k < 0.86 then
		local e = (k - 0.12) / 0.74
		p = bezier(r.sash, r.apex, r.over, e)
		if not reduced then
			local s = math.sin(e * math.pi) -- (the sway is nothing at either end)
			p += Vector3.new(math.sin(t * 1.3 + r.phase) * r.sway * s, math.sin(t * 0.9 + r.phase) * r.sway * 0.4 * s, math.cos(t * 1.1 + r.phase) * r.sway * 0.6 * s)
		end
	else
		local e = (k - 0.86) / 0.14
		p = r.over:Lerp(r.to, e * e * (3 - 2 * e))
	end
	local ahead = (r.over - r.sash)
	local dir = Vector3.new(ahead.X, 0, ahead.Z)
	dir = if dir.Magnitude > 1e-3 then dir.Unit else -Vector3.zAxis
	local thread = p + (dir * 0.6 + Vector3.yAxis).Unit * (if k < 0.95 then 30 else 30 * (1 - (k - 0.95) / 0.05))
	return p, thread
end

return table.freeze(Ballooning)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Growth</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen Godot scripts/life/growth.gd, LIFE-10..12. Durations and scales are game tuning, not measured instars.
local Species = require(script.Parent.Parent.Data.Species)
local Growth = {}
Growth.__index = Growth
Growth.STAGES = { "young juvenile", "juvenile", "subadult", "adult" }
Growth.SCALES = { 1, 1.15, 1.32, 1.50 }
Growth.ADULT = 3
Growth.READY_FOOD = 0.9
-- What one housefly counts for in `fedSinceMoult`: a third of Godot's 0.9 (ROBLOX-61; a small prey is half of it). The client credits food in these units.
Growth.FLY_FOOD = 0.3
-- The game's own rules (ROBLOX-88), opt-in like NeedsModel.game and Data/Catch.game: the housefly-equivalents a moult asks for. Godot's is 3 (READY_FOOD,
-- pinned by tests/growth_reference.json); a Growth never given these replays it. Growth:useGameRules() applies them.
-- First and second game moults require seven and ten flies in every mode.
-- The later adult moult retains five in Normal and three in the gentle modes.
Growth.game = { firstMoultFlies = 7, secondMoultFlies = 10, moultFlies = 5, gentleMoultFlies = 3 }
Growth.MOULT_HOURS = 12
Growth.SOFT_HOURS = 10
Growth.SOFT_REACH = 0.7
Growth.SOFT_SPEED = 0.65 -- Gameplay tuning for the vulnerable soft-cuticle period.
local function finite(v: any): boolean
 return type(v)=="number" and v==v and math.abs(v)<math.huge
end
function Growth.new(): any
 return setmetatable({stage=0,fedSinceMoult=0,ready=false,moultingHoursLeft=0,softHoursLeft=0,exuviae={}},Growth)
end
-- First/second game moults ask for seven/ten full-fly equivalents in every mode.
-- The last moult retains `moultFlies` (`gentleMoultFlies` when gentle). Stores the later threshold;
-- food already eaten is kept (a spider that has eaten two flies has eaten two flies), and a spider already ready to moult stays ready.
function Growth.useGameRules(self: any,gentle: boolean?)
 self.readyFood=(if gentle==true then Growth.game.gentleMoultFlies else Growth.game.moultFlies)*Growth.FLY_FOOD;self.gameRules=true
end
-- What swallowing `energy` (of the reserves, in the units a housefly's meal is 0.35 of) credits toward a moult, in `fedSinceMoult`'s units: a housefly credits
-- FLY_FOOD (0.3) whatever the moult asks for. One formula for the prey and the rival (a whole rival, Rival.FOOD 0.7, is two houseflies); it was written out twice in the client.
function Growth.rivalCredit(energy: number): number
 return energy*Growth.READY_FOOD/(3*Species.fly_like_prototype.body.nutrition)
end
-- A meal of `energy` in housefly-equivalents ("2 meals" for a whole rival).
function Growth.mealsOf(energy: number): number
 return math.floor(Growth.rivalCredit(energy)/Growth.FLY_FOOD+.5)
end
-- The food a moult asks for, in the units of `fedSinceMoult`, and in housefly-equivalents (3 by Godot's rule, 5 in the game).
function Growth.readyAt(self: any): number
 if self.gameRules then
  if self.stage==0 then return Growth.game.firstMoultFlies*Growth.FLY_FOOD end
  if self.stage==1 then return Growth.game.secondMoultFlies*Growth.FLY_FOOD end
 end
 return self.readyFood or Growth.READY_FOOD
end
function Growth.mealGoal(self: any): number return math.floor(self:readyAt()/Growth.FLY_FOOD+.5) end
function Growth.isAdult(self: any): boolean return self.stage>=Growth.ADULT end
function Growth.isMoulting(self: any): boolean return self.moultingHoursLeft>0 end
-- Discovered through movement after the first completed moult. Derive this from
-- the saved instar so old saves and a new generation need no extra unlock flag.
function Growth.canRun(self: any): boolean return self.stage>=1 and not self:isMoulting() end
function Growth.canLock(self: any): boolean return self.stage>=2 and not self:isMoulting() end
function Growth.isSoft(self: any): boolean return self.softHoursLeft>0 end
function Growth.stageName(self: any): string return Growth.STAGES[self.stage+1] end
function Growth.reachFactor(self: any): number return if self:isSoft() or self:isMoulting() then Growth.SOFT_REACH else 1 end
function Growth.speedFactor(self: any): number return if self:isSoft() or self:isMoulting() then Growth.SOFT_SPEED else 1 end
function Growth.softness(self: any): number return if self:isMoulting() then 1 else math.clamp(self.softHoursLeft/Growth.SOFT_HOURS,0,1) end
function Growth.eat(self: any, energy: number): boolean
 if not finite(energy) or energy<=0 or self:isAdult() or self:isMoulting() then return false end
 self.fedSinceMoult+=energy
 local before=self.ready
 self.ready=self.fedSinceMoult>=self:readyAt()-1e-9
 return self.ready and not before
end
function Growth.beginMoult(self: any): boolean
 if not self.ready or self:isAdult() or self:isMoulting() then return false end
 self.moultingHoursLeft=Growth.MOULT_HOURS
 return true
end
function Growth.passHours(self: any, hours: number, at: Vector3): string
 if not finite(hours) or hours<=0 then return "" end
 if self:isMoulting() then
  self.moultingHoursLeft=math.max(0,self.moultingHoursLeft-hours)
  if self.moultingHoursLeft==0 then
   self.stage=math.min(self.stage+1,Growth.ADULT)
   self.ready=false;self.fedSinceMoult=0;self.softHoursLeft=Growth.SOFT_HOURS
   table.insert(self.exuviae,at)
   return "moulted"
  end
 elseif self:isSoft() then
  self.softHoursLeft=math.max(0,self.softHoursLeft-hours)
  if self.softHoursLeft==0 then return "hardened" end
 end
 return ""
end
function Growth.toRecord(self: any): any
 local skins={}
 for _,p in self.exuviae do table.insert(skins,{p.X,p.Y,p.Z}) end
 return {stage=self.stage,fed_since_moult=self.fedSinceMoult,ready=self.ready,
  moulting_hours_left=self.moultingHoursLeft,soft_hours_left=self.softHoursLeft,exuviae=skins}
end
function Growth.problems(r: any): {string}
 if type(r)~="table" then return {"growth: not a record"} end
 local e={}
 if not finite(r.stage) or r.stage%1~=0 or r.stage<0 or r.stage>3 then table.insert(e,"growth: invalid stage") end
 for _,k in {"fed_since_moult","moulting_hours_left","soft_hours_left"} do
  if not finite(r[k]) or r[k]<0 then table.insert(e,"growth: invalid "..k) end
 end
 if type(r.ready)~="boolean" then table.insert(e,"growth: invalid ready") end
 if type(r.exuviae)~="table" or #r.exuviae>3 then table.insert(e,"growth: invalid old skins")
 else for _,p in r.exuviae do
  if type(p)~="table" or #p~=3 or not finite(p[1]) or not finite(p[2]) or not finite(p[3]) then table.insert(e,"growth: invalid skin position") end
 end end
 return e
end
function Growth.load(self: any,r: any): boolean
 if #Growth.problems(r)>0 then return false end
 self.stage=r.stage;self.fedSinceMoult=r.fed_since_moult;self.ready=r.ready
 self.moultingHoursLeft=r.moulting_hours_left;self.softHoursLeft=r.soft_hours_left;self.exuviae={}
 for _,p in r.exuviae do table.insert(self.exuviae,Vector3.new(p[1],p[2],p[3])) end
 return true
end
return Growth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">LifeClock</string>
            <string name="Source"><![CDATA[--!strict
-- The life clock: a port of the frozen scripts/life/life_clock.gd (LIFE-04). The windowsill's time of day and the spider's
-- age in days. It is one of three separate clocks: the fixed action tick (SpiderMotor.DT) is unchanged by it, so a jump is
-- never shortened when the day goes faster, and slow motion slows it with everything else because it is only ever advanced
-- by action time. While the spider is active the day passes slowly (ACTIVE_HOURS_PER_S game hours for each second of action
-- time); while it sleeps in its retreat at night the hours pass quickly (SLEEP_HOURS_PER_S), never more than one call's
-- worth at a time, until morning or until the sleep ends. It moves only when it is told to (LifeLoop, each fixed tick), so
-- the Roblox menu, which stops the ticks, never passes time.
-- Time is compressed on purpose. A real Phidippus audax lives about a year; one life here is meant to take a few hours to
-- play (LIFE-03: about 2 to 3 hours over roughly 10 game days).
-- Checked against Godot's own values in tests/life_reference.json (tools/export_life_reference.gd).
-- ROBLOX-94: how fast a region's day runs against the sill's is the game's rule, not Godot's: `LifeClock.game.clockScale` multiplies every advance of game
-- hours (awake, asleep and moulting alike), 1.0 until the client sets it from the region the spider is in each frame (Client/WorldClient, from Shared/World/WorldMap;
-- the sill is the only region so far and runs at 1.0; a garden region will run slower, docs/OPEN_WORLD_DESIGN.md). The rates above stay Godot's, and the goldens run
-- at 1.0, which changes nothing, not even the last bit. It is a dial on the module and not a flag on a clock because it is never saved: hours are state, the rate is
-- not, and a return to a rest builds a new clock that must run at the pace of where the spider now is, not where it rested.

local LifeClock = {}
LifeClock.__index = LifeClock

-- The day: the spider wakes at WAKE_H, the light goes at DUSK_H and it is fully dark from NIGHT_H until DAWN_H.
LifeClock.WAKE_H = 7.0
LifeClock.DAWN_H = 6.0
LifeClock.DUSK_H = 19.0
LifeClock.NIGHT_H = 20.5
-- From this hour a rest in the retreat sleeps until morning (Phidippus goes into its nest before dark).
LifeClock.EVENING_H = 18.0
LifeClock.START_DAY = 1
LifeClock.START_H = 9.0
-- About 12 waking hours in about 15 minutes of play.
LifeClock.ACTIVE_HOURS_PER_S = 12.0 / (15.0 * 60.0)
-- A night of sleep (about 11 hours) in about 8 seconds.
LifeClock.SLEEP_HOURS_PER_S = 1.4
-- The game's own rule (ROBLOX-94), not a recorded value: the pace of the day where the spider is now, against the rates above.
LifeClock.game = { clockScale = 1.0 }

export type Record = { day: number, hour: number, sleeping: boolean }

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

-- Godot's fposmod: the remainder with the sign of the divisor.
local function fposmod(x: number, y: number): number
	local v = math.fmod(x, y)
	if (v < 0 and y > 0) or (v > 0 and y < 0) then
		v += y
	end
	return v
end

-- Godot's smoothstep (0 below `from`, 1 above `to`, the cubic in between).
local function smoothstep(from: number, to: number, x: number): number
	if from == to then
		return if x < from then 0 else 1
	end
	local s = math.clamp((x - from) / (to - from), 0, 1)
	return s * s * (3.0 - 2.0 * s)
end
LifeClock.smoothstep = smoothstep

function LifeClock.new(): any
	return setmetatable({ day = LifeClock.START_DAY, hour = LifeClock.START_H, sleeping = false }, LifeClock)
end

-- The dial, as a usable number: anything that is not a positive finite number runs at the sill's pace rather than stop or poison the clock.
function LifeClock.currentScale(): number
	local scale = LifeClock.game.clockScale
	if type(scale) == "number" and scale > 0.0 and finite(scale) then
		return scale
	end
	return 1.0
end

function LifeClock._addHours(self: any, hours: number)
	self.hour += hours
	while self.hour >= 24.0 do
		self.hour -= 24.0
		self.day += 1
	end
end

-- Lets `seconds` of action time pass. Asleep, the hours run at the sleeping rate, and a sleep that reaches the morning ends
-- there. Returns the game hours that passed.
function LifeClock.advance(self: any, seconds: number, asleep: boolean): number
	if not finite(seconds) or seconds <= 0.0 then
		return 0.0
	end
	local rate = if asleep then LifeClock.SLEEP_HOURS_PER_S else LifeClock.ACTIVE_HOURS_PER_S
	local hours = seconds * rate * LifeClock.currentScale()
	if asleep then
		local toMorning = self:hoursUntil(LifeClock.WAKE_H)
		if toMorning <= hours then
			hours = toMorning
			self.sleeping = false
		else
			self.sleeping = true
		end
	else
		self.sleeping = false
	end
	self:_addHours(hours)
	return hours
end

-- A moult passing: the hours run at the sleeping rate and do not stop at morning. Returns the hours that passed. (LifeLoop
-- runs the moult on it.)
function LifeClock.advanceMoult(self: any, seconds: number): number
	if not finite(seconds) or seconds <= 0.0 then
		return 0.0
	end
	self.sleeping = false
	local hours = seconds * LifeClock.SLEEP_HOURS_PER_S * LifeClock.currentScale()
	self:_addHours(hours)
	return hours
end

-- Hours from now until the clock next shows `target` (0 when it shows it now).
function LifeClock.hoursUntil(self: any, target: number): number
	return fposmod(target - self.hour, 24.0)
end

-- Whether a rest now would be a night's sleep: the evening, the night, or the early morning before waking.
function LifeClock.isSleepTime(self: any): boolean
	return self.hour >= LifeClock.EVENING_H or self.hour < LifeClock.WAKE_H
end

-- How much daylight there is, 0 (night) to 1 (full day), easing through dawn and dusk.
function LifeClock.daylightAt(hour: number): number
	local W, D, N, A = LifeClock.WAKE_H, LifeClock.DUSK_H, LifeClock.NIGHT_H, LifeClock.DAWN_H
	if hour >= W + 1.0 and hour <= D then
		return 1.0
	end
	if hour > D and hour < N then
		return 1.0 - smoothstep(D, N, hour)
	end
	if hour >= A and hour < W + 1.0 then
		return smoothstep(A, W + 1.0, hour)
	end
	return 0.0
end

function LifeClock.daylight(self: any): number
	return LifeClock.daylightAt(self.hour)
end

-- Words for the time of day, for the screen.
function LifeClock.partOfDay(self: any): string
	local h = self.hour
	if h >= 5.0 and h < 10.0 then return "morning" end
	if h >= 10.0 and h < 14.0 then return "midday" end
	if h >= 14.0 and h < 18.0 then return "afternoon" end
	if h >= 18.0 and h < 20.5 then return "evening" end
	return "night"
end

function LifeClock.toRecord(self: any): Record
	return { day = self.day, hour = self.hour, sleeping = self.sleeping }
end

-- What is wrong with a record, in Godot's words (an empty list for a good one).
function LifeClock.problems(d: any): { string }
	local e: { string } = {}
	if type(d) ~= "table" then
		table.insert(e, "life: not a record")
		return e
	end
	local dv = d.day
	if not (type(dv) == "number" and finite(dv) and dv == math.floor(dv)) or dv < 1 then
		table.insert(e, "life: the day is not a whole number from 1")
	end
	local hv = d.hour
	if type(hv) ~= "number" or not finite(hv) or hv < 0.0 or hv >= 24.0 then
		table.insert(e, "life: the hour is not in [0, 24)")
	end
	if type(d.sleeping) ~= "boolean" then
		table.insert(e, "life: 'sleeping' is not true or false")
	end
	return e
end

-- Restores a record made by toRecord. False, and nothing changed, for anything that is not one.
function LifeClock.load(self: any, d: any): boolean
	if #LifeClock.problems(d) > 0 then
		return false
	end
	self.day = d.day
	self.hour = d.hour
	self.sleeping = d.sleeping
	return true
end

return LifeClock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">LifeLoop</string>
            <string name="Source"><![CDATA[--!strict
-- LifeLoop: the rest, sleep and day of the frozen scripts/habitat/habitat_loop.gd (T08, LIFE-04 to LIFE-06), without the
-- world. The client gives it, once a fixed tick and after the spider and its meal have moved, what it needs to know about the
-- spider (in the crack, on a surface, still, holding or eating prey) and the presses of the feed and cancel buttons; it keeps
-- the life clock and the rest, tells the NeedsModel how many game hours passed, says how much daylight there is and how far
-- the eyes reach in it, and asks for the retreat checkpoint when a rest begins and when a night's sleep reaches the morning.
--
-- * Resting: in the silk-lined crack, on a surface, keeping still, holding no prey, E rests (Godot's interact). E or Q again,
--   moving, or anything that makes resting impossible ends it.
-- * Sleeping: a rest in the evening or at night (18:00 to 07:00) sleeps until morning: the hours pass at the sleeping rate,
--   never more than one tick's worth at a time. Moving wakes the spider ("Awake before morning"). The morning ("Morning, day
--   N") keeps a new checkpoint. A rest by day passes no extra time.
-- * Light: daylight 0 to 1 from the hour; the eyes reach NIGHT_SIGHT of their range in the dark (LIFE-06). The reach comes
--   from the clock, never from the lighting on the screen.
--
-- Growth, moulting and starvation are ported. The passing shadow and notebook remain separate work.
-- Checked tick by tick against Godot's own loop in tests/life_reference.json (tools/export_life_reference.gd).

local LifeClock = require(script.Parent.LifeClock)
local Growth = require(script.Parent.Growth)

local LifeLoop = {}
LifeLoop.__index = LifeLoop

-- The sensor's reach at night, as a share of its daytime reach (jumping spiders hunt by sight, in daylight).
LifeLoop.NIGHT_SIGHT = 0.3
-- How long a notice stays on the screen.
LifeLoop.NOTICE_S = 6.0
-- After a checkpoint is restored the spider takes a moment to take hold of its surface again; the restored rest is not ended
-- meanwhile.
LifeLoop.RESTORE_GRACE_TICKS = 30
-- Rest restored per second of resting.
LifeLoop.REST_PER_S = 0.10
LifeLoop.HUNGRY_AT = 0.25
LifeLoop.WEAK_AFTER_H = 24
LifeLoop.STARVE_AFTER_H = 48

-- What the loop needs to know about the spider this tick.
export type Spider = {
	inRetreat: boolean, -- inside the silk-lined crack
	attached: boolean, -- on a surface (not in the air, not on the line)
	still: boolean, -- not walking or sliding (Godot: intent under 0.01, speed under 0.15)
	holding: boolean, -- holds prey (caught, struggling or being eaten)
	feeding: boolean, -- eating right now
 position: Vector3?, -- old skin location; live client always supplies it
}
export type CheckpointResult = { ok: boolean, message: string }
export type Event = { kind: string, day: number? }

-- `needs` is the NeedsModel whose hours this loop reports; `save` keeps the retreat checkpoint (nil: none is kept).
function LifeLoop.new(needs: any, save: (() -> CheckpointResult)?): any
	local self = setmetatable({
		clock = LifeClock.new(), needs = needs, save = save,
  growth = Growth.new(), grantedSeen = needs.grantedTotal,
		mode = "main", rules = "standard", lifeOver = false,
		resting = false, restSeconds = 0.0, asleep = false, elapsed = 0.0,
		checkpointDue = false, checkpointResult = nil :: CheckpointResult?, checkpoints = 0,
		notice = "", noticeSeconds = 0.0, morningText = "",
		restoreGrace = 0, events = {} :: { Event },
		daylight = 1.0, rangeScale = 1.0,
	}, LifeLoop)
	self:applyLight()
	return self
end

-- Live survival pacing; frozen-reference controllers keep their original 24/48h.
function LifeLoop.useGameRules(self: any)
 self.weakAfterH=6;self.starveAfterH=12
end

function LifeLoop.canRest(_self: any, s: Spider): boolean
	return s.inRetreat and not s.holding and not s.feeding and s.attached and s.still
end

function LifeLoop.showNotice(self: any, text: string)
	self.notice = text
	self.noticeSeconds = LifeLoop.NOTICE_S
end

function LifeLoop._emit(self: any, kind: string, day: number?)
	table.insert(self.events, { kind = kind, day = day })
end

-- The events since the last call: rest_started, rest_ended, slept, woke (with the day), checkpoint.
function LifeLoop.drainEvents(self: any): { Event }
	local e = self.events
	self.events = {}
	return e
end

function LifeLoop.requestRest(self: any, s: Spider): boolean
	if not self:canRest(s) then
		return false
	end
	self.resting = true
	self.checkpointDue = true
	self:_emit("rest_started")
	return true
end

function LifeLoop.stopRest(self: any)
	if self.resting and not self.growth:isMoulting() then
		self.resting = false
		self:_emit("rest_ended")
	end
end

-- The light of the hour, and how far the spider's eyes reach in it.
function LifeLoop.applyLight(self: any)
	self.daylight = self.clock:daylight()
	self.rangeScale = LifeLoop.NIGHT_SIGHT + (1.0 - LifeLoop.NIGHT_SIGHT) * self.daylight
end

function LifeLoop.tooHungryToSleep(self: any): boolean
	return not self.needs.gentle and self.needs.starvingStreakH >= (self.weakAfterH or LifeLoop.WEAK_AFTER_H)
end

function LifeLoop.starved(self: any): boolean
	return not self.needs.gentle and self.needs.starvingStreakH >= (self.starveAfterH or LifeLoop.STARVE_AFTER_H)
end

function LifeLoop._stepLife(self: any, dt: number, at: Vector3)
 local granted = self.needs.grantedTotal
 -- Live play counts food swallowed, including when the energy reserve is full.
 local food = if self.mealFood ~= nil then self.mealFood else granted-self.grantedSeen
 self.mealFood = nil
 if food > 0 and self.growth:eat(food) then
  self:showNotice("Ready to moult. Rest in the silk-lined crack.")
  self:_emit("moult_ready")
 end
 self.grantedSeen = granted
 if self.resting and self.growth:beginMoult() then
  self:showNotice("Moulting in the crack. The spider slowly pulls free of its old skin.")
  self:_emit("moult_started")
 end
 local moulting = self.growth:isMoulting()
 local wasAsleep = self.asleep
	self.asleep = self.resting and not moulting and (self.clock.sleeping or self.clock:isSleepTime()) and not self:tooHungryToSleep()
	local hours = if moulting then self.clock:advanceMoult(dt) else self.clock:advance(dt, self.asleep)
 local what = self.growth:passHours(hours,at)
 if what == "moulted" then
  self.checkpointDue=true
  self.morningText="Moulted: now a "..self.growth:stageName()..". The new skin is soft for a while."
  self:showNotice(self.morningText)
  self:_emit("moulted")
 elseif what == "hardened" then
  self:showNotice("The new skin has hardened. Full-length jumps again.")
 end
	if self.asleep and not self.clock.sleeping then
		-- The morning came during this tick: awake, still resting in the crack. The new day keeps a checkpoint.
		self.asleep = false
		self.checkpointDue = true
		self.morningText = `Morning, day {self.clock.day}. Rested through the night in the crack.`
		self:showNotice(self.morningText)
		self:_emit("woke", self.clock.day)
	elseif wasAsleep and not self.asleep then
		self:showNotice(`Awake before morning: it is still {self.clock:partOfDay()}.`)
	end
	if self.asleep and not wasAsleep then
		self:_emit("slept")
	end
	self.needs:addHours(hours, self.asleep or moulting)
	self:applyLight()
end

-- One fixed tick, after the spider and its meal have moved. `feedPressed` and `cancelPressed` are this tick's fresh presses.
function LifeLoop.step(self: any, dt: number, s: Spider, feedPressed: boolean, cancelPressed: boolean)
	self.elapsed += dt
	if self.restoreGrace > 0 then
		self.restoreGrace = if s.attached then 0 else self.restoreGrace - 1
	end
	if self.resting and not self.growth:isMoulting() and (cancelPressed or feedPressed or (self.restoreGrace == 0 and not self:canRest(s))) then
		self:stopRest()
	elseif feedPressed and not self.growth:isMoulting() and not s.holding and not s.feeding then
		self:requestRest(s)
	end
	if self.resting then
		self.restSeconds += dt
		self.needs:restoreRest(dt * LifeLoop.REST_PER_S)
	end
	self:_stepLife(dt, s.position or Vector3.zero)
	if self:starved() and not self.lifeOver and not self.growth:isMoulting() then
		self.lifeOver = true
		self:_emit("starved")
	end
	if self.noticeSeconds > 0.0 then
		self.noticeSeconds = math.max(0.0, self.noticeSeconds - dt)
	end
	if self.checkpointDue then
		self.checkpointDue = false
		if self.resting then
			self:makeCheckpoint()
		end
	end
end

-- The retreat checkpoint, now (the end of a tick).
function LifeLoop.makeCheckpoint(self: any): CheckpointResult
	local result: CheckpointResult = if self.save then self.save() else { ok = false, message = "There is nowhere to keep a rest" }
	self.checkpointResult = result
	if result.ok then
		self.checkpoints += 1
		self:showNotice(result.message)
	else
		self:showNotice("Resting, but this is not kept as your last rest. " .. result.message .. ".") -- (ROBLOX-92: the message is in the game's words, LifeText.restRefusal)
	end
	if self.morningText ~= "" then
		self:showNotice(self.morningText .. "\n" .. self.notice)
		self.morningText = ""
	end
	self:_emit("checkpoint")
	return result
end

-- The loop's part of a checkpoint (Godot's habitat record, with the clock beside it as its "life" field).
function LifeLoop.toRecord(self: any): { [string]: any }
	return {
		retreat_id = "sill_crevice", resting = self.resting, rest_seconds = self.restSeconds, elapsed = self.elapsed,
		life = self.clock:toRecord(), growth = self.growth:toRecord(),
	}
end

function LifeLoop.problems(r: any): { string }
	local e: { string } = {}
	if type(r) ~= "table" then
		table.insert(e, "habitat: not a record")
		return e
	end
	if r.retreat_id ~= "sill_crevice" then table.insert(e, "habitat: not this windowsill's retreat") end
	if type(r.resting) ~= "boolean" then table.insert(e, "habitat: 'resting' is not true or false") end
	for _, k in { "rest_seconds", "elapsed" } do
		local v = r[k]
		if type(v) ~= "number" or v ~= v or v < 0 or v == math.huge then table.insert(e, `habitat: '{k}' is not a time`) end
	end
	if r.growth ~= nil then for _, p in Growth.problems(r.growth) do table.insert(e,p) end end
 for _, p in LifeClock.problems(r.life) do
		table.insert(e, p)
	end
	return e
end

-- Restores a record made by toRecord (validated first; false and nothing changed if it is not one). The rest that was going on
-- goes on; no new checkpoint is owed for it.
function LifeLoop.load(self: any, r: any): boolean
	if #LifeLoop.problems(r) > 0 then
		return false
	end
	self.clock:load(r.life)
 self.growth=Growth.new()
 if r.growth then self.growth:load(r.growth) end
 self.grantedSeen=self.needs.grantedTotal
	self.resting = r.resting
	self.restSeconds = r.rest_seconds
	self.elapsed = r.elapsed
	self.asleep = false
	self.checkpointDue = false
	self.morningText = ""
	self.restoreGrace = LifeLoop.RESTORE_GRACE_TICKS
	self:applyLight()
	self:showNotice("Returned to your last rest: the sill as it was when you rested in the crack. This is a return to the rest, not an exact resume.")
	return true
end

return LifeLoop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">LifeSession</string>
            <string name="Source"><![CDATA[--!strict
-- LIFE-19..23: player progress lives outside world checkpoints. Session only until server saves are ported.
local Session = {}
Session.__index = Session
Session.SPOTS = { Vector3.new(12,.31,9), Vector3.new(-8,.31,-10), Vector3.new(24,.31,8), Vector3.new(-2,.31,10) }
function Session.new(): any
	return setmetatable({ mode="main", rules="standard", ended=false, summary=nil,
		deaths=0, lives={}, finishedMain=false, started=false }, Session)
end
function Session.begin(self: any, mode: string, easy: boolean): boolean
	if mode ~= "main" and mode ~= "free" then return false end
	if mode == "main" and easy and not self.finishedMain then return false end
	self.mode, self.rules = mode, if mode == "free" or easy then "gentle" else "standard"
	self.ended, self.summary, self.started = false, nil, true
	return true
end
function Session.finishAdult(self: any, stage: number): boolean
	if stage ~= 3 or self.mode ~= "main" or self.rules ~= "standard" or self.finishedMain then return false end
	self.finishedMain = true
	return true
end
function Session.endLife(self: any, cause: string, summary: any): boolean
	if self.ended or self.rules == "gentle" or (cause ~= "wasp" and cause ~= "starved" and cause ~= "rival" and cause ~= "night") then return false end
	self.ended, self.deaths = true, self.deaths + 1
	self.summary = table.clone(summary)
	self.summary.cause, self.summary.mode, self.summary.rules = cause, self.mode, self.rules
	return true
end
function Session.archive(self: any)
	if self.summary then table.insert(self.lives, table.clone(self.summary)) end
	while #self.lives > 30 do table.remove(self.lives,1) end
	self.summary = nil
end
function Session.another(self: any): Vector3?
	if not self.ended then return nil end
	self:archive()
	self.ended, self.started = false, true
	return Session.SPOTS[#self.lives % #Session.SPOTS + 1]
end
function Session.title(self: any): string
	return if self.mode == "free" then "FREE PLAY" elseif self.rules == "gentle" then "THE WINDOWSILL (EASY)" else "THE WINDOWSILL"
end
return Session
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Mating</string>
            <string name="Source"><![CDATA[--!strict
-- The mating cycle and the new generation (ROBLOX-79). One plain record, life.mating, in LifeLoop's checkpoint graph beside life.mate (the mate's body,
-- Predator/Mate) and life.generation (how many families the sill has had); nothing here knows the clock, the engine or the player but through the snapshot
-- the caller hands in, so the CLI tests drive whole cycles. Absent fields mean the old game: a record from before this change restores as stage "none",
-- generation 0, and nothing in it is ever rerolled (the mate's size, the brood and every arrival are pure functions of the world's seed, the day and the
-- numbers kept in the record).
--
-- The cycle, in stages:
--   none ....... nothing going on. A rest in the crack by a full-grown spider with energy of at least 0.6 sets `ready_day`, the morning of the next 07:00:
--                from then a mate comes on mornings (Predator/Mate) until the player has courted it.
--   courted .... the courtship meter is full and the pair are together for the pause (Mate state "pair"): the mating scene (ROBLOX-89, Life/MatingScene).
--   mated ...... the pause is over and the mate is walking off. The next sleep in the crack that reaches the morning makes the egg sac.
--   sac ........ the morning the sac is there: guard day 1.
--   guarding ... guard day 2. (Guarding is surviving: nothing in v1 can harm the sac, the wasp and the rival never enter the crack.)
--   hatched .... the morning after the last guard day: the brood is out. The hatching scene and the ending card belong to the client; carryOn() makes
--                the next generation when the player takes it.
-- carryOn: generation += 1, growth back to the first stage, a fresh energy, the day count goes on (it is the clock's), the mating state is none again,
-- so the cycle can happen again in the next generation.
local Rules = require(script.Parent.Parent.Data.MatingRules)
local Mate = require(script.Parent.Parent.Predator.Mate)
local Growth = require(script.Parent.Growth)
local PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)

local Mating = {}

Mating.STAGES = { "none", "courted", "mated", "sac", "guarding", "hatched" }
local STAGE: { [string]: boolean } = {}
for _, name in Mating.STAGES do STAGE[name] = true end

local COUNTERS = { "ready_day", "guard_day", "sac_day", "hatch_day", "brood", "mates", "visits", "visit_day", "away_day", "drive_offs" }
-- ROBLOX-106: the standard rules' counters (courts decided, refusals, rivals that cut in). Optional: a record without them has had none, and normalize leaves them
-- absent (so a record of the old game is byte for byte what it was); they are made when first needed.
local NATURE_COUNTERS = { "courts", "rejections", "cut_ins" }

local function finite(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local function whole(x: any): boolean
	return finite(x) and x >= 0 and x <= 1e9 and x % 1 == 0
end

function Mating.new(): any
	return {
		stage = "none",
		ready_day = 0, -- the morning (day) from which a mate may come; 0: not yet eligible
		guard_day = 0, -- 1 or 2 while the sac is guarded
		sac_day = 0, -- the morning the sac appeared
		hatch_day = 0, hatch_hour = 0.0, brood = 0, -- when the eggs hatched, and how many spiderlings came out
		mates = 0, visits = 0, visit_day = 0, away_day = 0, drive_offs = 0, -- the mate's bookkeeping: which mate, how many days it has come, the last day it came and left
	}
end

-- Fills any field an older or shorter record does not have (so absent means the old behaviour), in place. Returns the record.
function Mating.normalize(m: any): any
	for _, k in COUNTERS do
		if m[k] == nil then m[k] = 0 end
	end
	if m.hatch_hour == nil then m.hatch_hour = 0.0 end
	if m.stage == nil then m.stage = "none" end
	return m
end

-- The sex of the played spider: the peacock spider is the male and the ant mimic the female; the first spider has no sex in its design and is the game's
-- female (its mate is a male, as the rival is). The mate is the opposite.
function Mating.sexOf(appearanceId: string): string
	if appearanceId == "maratus_volans_male" then return "male" end
	return "female"
end

-- Is the spider ready to mate: full-grown (Growth's last stage) and well fed.
function Mating.eligible(growth: any, energy: number): boolean
	return growth ~= nil and growth:isAdult() and energy >= Rules.energyMin - 1e-9
end

-- The brood: a seeded number of spiderlings, from the world's seed, the family's number and the day the eggs hatched (so a return never rerolls it).
function Mating.broodSize(seed: number, generation: number, day: number): number
	local g = PreyRandom.new((seed * 83492791 + generation * 19349663 + day * 73856093 + 4093) % 2147483647)
	g:next()
	g:next()
	return Rules.broodMin + math.floor(g:next() * (Rules.broodMax - Rules.broodMin + 1))
end

-- Is there an egg sac in the crack to draw: from the morning it is made until the family has carried on (the hatching scene draws it too).
function Mating.hasSac(m: any): boolean
	return m ~= nil and (m.stage == "sac" or m.stage == "guarding" or m.stage == "hatched")
end

-- The generation of a life (0 for a record that has none).
function Mating.generation(life: any): number
	return if type(life.generation) == "number" then life.generation else 0
end

-- ROBLOX-91: is a full-grown spider at a rest too hungry for a visitor? Only before a cycle has begun (stage none, no morning set) and only when the one thing missing
-- is the energy: the notice "Too hungry for a visitor to come" (MateText) is for that rest, so the gate no longer fails in silence. Asked at the same moment as atRest.
function Mating.tooHungry(life: any): boolean
	local m = life.mating
	if m ~= nil and (m.stage ~= nil and m.stage ~= "none" or (m.ready_day or 0) > 0) then return false end
	local g = life.growth
	return g ~= nil and g:isAdult() and life.needs.energy < Rules.energyMin - 1e-9
end

-- ROBLOX-91: the protections of a new life (no rival or wasp on the first day, none before the first meal) belong to a generation, not to the sill's day counter and
-- the meals of every family before: the day before this generation began (0 for the first) and its own count of meals, given the total finished so far.
function Mating.grace(life: any, mealsFinished: number): (number, number)
	local base = if type(life.mealsBase) == "number" then life.mealsBase else 0
	return if type(life.born) == "number" then life.born else 0, math.max(0, mealsFinished - base)
end

-- The day of the 07:00 morning the clock is in (the hours before it belong to the day before).
local function morningOf(day: number, hour: number): number
	return if hour >= Rules.arriveHour then day else day - 1
end

-- Called when the spider rests in the crack (the caller makes it before the rest's checkpoint, so the checkpoint has it): a full-grown, well-fed spider
-- makes the next 07:00 the morning from which a mate comes. It sets and never clears, and does nothing during a cycle already going. Returns whether it set it.
function Mating.atRest(life: any, day: number, hour: number): boolean
	local m = Mating.normalize(life.mating or Mating.new())
	life.mating = m
	if m.stage ~= "none" or m.ready_day > 0 then return false end
	if not Mating.eligible(life.growth, life.needs.energy) then return false end
	m.ready_day = if hour >= Rules.arriveHour then day + 1 else day
	return true
end

-- A night's sleep in the crack reached the morning of `day` (LifeLoop's "woke"): after mating, that sleep made the egg sac. Returns "sac" or "".
function Mating.woke(life: any, day: number): string
	local m = Mating.normalize(life.mating or Mating.new())
	life.mating = m
	if m.stage ~= "mated" then return "" end
	m.stage, m.sac_day, m.guard_day = "sac", day, 1
	return "sac"
end

-- ROBLOX-106: a draw of its own for the mating cycle's standard rules: the world's seed, the mate's number and visit, and a counter (the courts so far) and a salt.
local function natureStream(seed: number, m: any, n: number, salt: number): any
	return PreyRandom.mixed(seed, m.mates or 0, m.visits or 0, n, salt)
end

-- ROBLOX-106: the spider's condition for a mate, 0 to 1, from its reserve (MatingRules.game).
function Mating.condition(energy: number): number
	local g = Rules.game
	return math.clamp((energy - g.energyLow) / (g.energyFull - g.energyLow), g.conditionFloor, 1)
end

-- ROBLOX-106: the chance the mate accepts this court now (base x condition x quality), and what weighed most against it: "thin" or "clumsy", or "choosy" when both
-- are good (at least `fairAt`) and the refusal is the mate's own (the base's share): the words never blame a court that was not at fault.
function Mating.acceptChance(mate: any, energy: number): (number, string)
	local c, q = Mating.condition(energy), Mate.quality(mate)
	local why = if math.min(c, q) >= Rules.game.fairAt then "choosy" elseif c < q then "thin" else "clumsy"
	return Rules.game.base * c * q, why
end

-- ROBLOX-106: the mate decides on a full meter (the standard rules). Returns whether it accepts and, refused, why. Counts the court.
function Mating.decide(life: any, mate: any, s: any): (boolean, string)
	local m = life.mating
	local n = m.courts or 0
	m.courts = n + 1
	local p, why = Mating.acceptChance(mate, life.needs.energy)
	return natureStream(s.seed or 0, m, n, 7):next() < p, why
end

-- ROBLOX-106: the decision on a full meter, played out: refused, the mate walks off for the day and the event "rejected_thin", "rejected_clumsy" or
-- "rejected_choosy" is added.
function Mating.accepts(life: any, mate: any, s: any, events: { string }): boolean
	local ok, why = Mating.decide(life, mate, s)
	if ok then return true end
	local m = life.mating
	Mate.refuse(mate, "rejected")
	m.rejections = (m.rejections or 0) + 1
	m.away_day = s.day
	table.insert(events, "rejected_" .. why)
	return false
end

-- ROBLOX-106: a new visit's rival: whether the rival will cut in on today's court, and at what level of the meter (nil: it will not).
function Mating.cutLevel(seed: number, m: any): number?
	local g = Rules.game
	local r = natureStream(seed, m, 0, 13)
	if r:next() >= g.cutChance then return nil end
	return g.cutLevel[1] + (g.cutLevel[2] - g.cutLevel[1]) * r:next()
end

-- One fixed tick of the whole cycle. `s` is the player's snapshot (see Predator/Mate.step) with day, hour, seed and `sex`, `needsDance`, `dancing`. Returns
-- the events of the tick, in order: "arrived" (with "new_mate" before it when it is another mate), "noticed", "driven", "courted", "mated", "gone",
-- "guard_day" (the second guard day began) and "hatched"; in the standard rules (ROBLOX-106) "rejected_thin", "rejected_clumsy" or "rejected_choosy" for a refused court and "cut" for
-- a rival cutting in. `s.rivalThreat` (the rival is winding up or lunging, ROBLOX-91) turns "courted" into "courted", "mated".
function Mating.tick(life: any, dt: number, s: any): { string }
	local events: { string } = {}
	local m = Mating.normalize(life.mating or Mating.new())
	life.mating = m
	local mate = life.mate
	if mate == nil then
		mate = Mate.new()
		life.mate = mate
	end
	-- The guard days, by the clock: the morning of the 07:00 the sac was made is day 1.
	if (m.stage == "sac" or m.stage == "guarding") and m.sac_day > 0 then
		local d = morningOf(s.day, s.hour) - m.sac_day + 1
		if d > Rules.guardDays and s.hour >= Rules.arriveHour then
			m.stage, m.hatch_day, m.hatch_hour = "hatched", s.day, s.hour
			m.brood = Mating.broodSize(s.seed or 0, Mating.generation(life), s.day)
			table.insert(events, "hatched")
		elseif d >= 2 and m.guard_day < 2 then
			m.stage, m.guard_day = "guarding", math.min(d, Rules.guardDays)
			table.insert(events, "guard_day")
		end
	end
	-- The mate.
	s.mayArrive = m.stage == "none" and m.ready_day > 0 and s.day >= m.ready_day and s.day > m.away_day
	local event = Mate.step(mate, dt, s)
	if event == "arrived" then
		-- One mate at a time, for at most visitsMax mornings; then another one.
		if m.mates == 0 or m.visits >= Rules.visitsMax then
			m.mates += 1
			m.visits = 0
			table.insert(events, "new_mate")
		end
		m.visits += 1
		m.visit_day = s.day
		mate.sex = Mate.opposite(s.sex or "female")
		mate.scale = Mate.scaleFor(s.seed or 0, m.mates, mate.sex)
		if s.nature == true then mate.cut = Mating.cutLevel(s.seed or 0, m) end -- (ROBLOX-106)
		table.insert(events, "arrived")
	elseif event == "courted" and s.nature == true and not Mating.accepts(life, mate, s, events) then
		-- (ROBLOX-106: refused; Mating.accepts has sent the mate off and said why)
	elseif event == "courted" then
		m.stage = "courted"
		table.insert(events, "courted")
		-- ROBLOX-91: the rival is already winding up or lunging as the meter fills (the caller says so in `s.rivalThreat`): the scene would hold the player in the open, so it is skipped
		-- at once, as for a wasp's visit, and they have mated.
		if s.rivalThreat == true and Mate.skip(mate, true) == "mated" then
			m.stage = "mated"
			table.insert(events, "mated")
		end
	elseif event == "mated" then
		m.stage = "mated"
		table.insert(events, "mated")
	elseif event == "driven" then
		m.drive_offs += 1
		m.away_day = s.day
		table.insert(events, "driven")
	elseif event == "gone" then
		m.away_day = s.day
		table.insert(events, "gone")
	elseif event ~= "" then
		table.insert(events, event)
	end
	-- ROBLOX-106: the rival cuts in when the meter passes the visit's level, if it is free on the sill and near enough to the mate then.
	if s.nature == true and mate.cut ~= nil and Mate.courtable(mate) and mate.meter >= mate.cut then
		local rival = s.rival
		if rival ~= nil and rival.position ~= nil and (rival.position - mate.position).Magnitude <= Rules.game.cutWu then
			Mate.refuse(mate, "cut")
			m.cut_ins = (m.cut_ins or 0) + 1
			m.away_day = s.day
			table.insert(events, "cut")
		end
	end
	return events
end

-- The player skips the mating scene (ROBLOX-89; the client allows it after Rules.skipAfter seconds of it, `force` for a wasp visit): a pause cut short is the
-- mating at once, the same event Mating.tick reports when the pause ends by itself. Returns the events: {"mated"} or {}.
function Mating.skip(life: any, force: boolean?): { string }
	local mate = life.mate
	if mate == nil then return {} end
	if Mate.skip(mate, force) ~= "mated" then return {} end
	local m = Mating.normalize(life.mating or Mating.new())
	life.mating = m
	m.stage = "mated"
	return { "mated" }
end

-- The next generation (after the hatching scene and the ending card). The spider is a spiderling again: the first growth stage and a fresh energy, rested;
-- the days of the sill go on; the mating state and the mate are new, so the cycle can happen again. Notebook, appearance and the world are not touched.
-- Returns the new generation number and the day it hatched. ROBLOX-91: it also starts the generation's grace (Mating.grace): the hatching day is its first day, and
-- `mealsFinished` (the meals eaten so far by every family) is the count its first meal is measured from.
function Mating.carryOn(life: any, needs: any, mealsFinished: number?): (number, number)
	local m = Mating.normalize(life.mating or Mating.new())
	local day = m.hatch_day
	local generation = Mating.generation(life) + 1
	life.generation = generation
	life.born = math.max(0, day - 1)
	life.mealsBase = math.max(0, mealsFinished or 0)
	life.growth = Growth.new()
	life.grantedSeen = needs.grantedTotal
	life.mealFood = nil
	life.lifeOver = false
	needs.energy = Rules.freshEnergy
	needs.rest = 1.0
	needs.starvingHours, needs.starvingStreakH = 0.0, 0.0
	life.mating = Mating.new()
	life.mate = Mate.new()
	return generation, day
end

-- What is wrong with a mating record (an empty list for a good one; nil is a good one: a life with no cycle yet). Absent fields are good.
function Mating.problems(m: any): { string }
	local e: { string } = {}
	local function bad(t: string) table.insert(e, "mating: " .. t) end
	if m == nil then return e end
	if type(m) ~= "table" then bad("not a record"); return e end
	if m.stage ~= nil and (type(m.stage) ~= "string" or not STAGE[m.stage]) then bad("unknown stage") end
	for _, k in COUNTERS do
		if m[k] ~= nil and not whole(m[k]) then bad(`'{k}' is not a whole number`) end
	end
	for _, k in NATURE_COUNTERS do
		if m[k] ~= nil and not whole(m[k]) then bad(`'{k}' is not a whole number`) end
	end
	if m.hatch_hour ~= nil and (not finite(m.hatch_hour) or m.hatch_hour < 0 or m.hatch_hour >= 24) then bad("the hatch hour is not in [0, 24)") end
	if #e > 0 then return e end
	if (m.visits or 0) > Rules.visitsMax then bad("a mate has come on more days than it may") end
	if (m.guard_day or 0) > Rules.guardDays then bad("more guard days than there are") end
	if (m.brood or 0) > 64 then bad("a brood that large") end
	local stage = m.stage or "none"
	if stage == "sac" and ((m.sac_day or 0) < 1 or m.guard_day ~= 1) then bad("a new sac with no morning, or not on its first guard day") end
	if stage == "guarding" and ((m.sac_day or 0) < 1 or (m.guard_day or 0) < 2) then bad("a guarded sac with no morning, or before its second guard day") end
	if stage == "hatched" and ((m.hatch_day or 0) < 1 or (m.brood or 0) < 1) then bad("a hatching with no day or no brood") end
	return e
end

-- The checks that need the mate beside the record: a mate on the sill belongs to a cycle that wants one, and the pause together is the stage courted.
function Mating.problemsWith(m: any, mate: any): { string }
	local e = Mating.problems(m)
	if #e > 0 or mate == nil then return e end
	local stage = if m ~= nil and m.stage ~= nil then m.stage else "none"
	if mate.state ~= "away" and stage ~= "none" and stage ~= "courted" and stage ~= "mated" then
		table.insert(e, "mating: a mate is on the sill during the sac and the guarding")
	end
	if stage == "courted" and mate.state ~= "pair" then table.insert(e, "mating: courted, but the pair are not together") end
	if mate.state == "pair" and stage ~= "courted" then table.insert(e, "mating: together, but not courted") end
	if mate.scene == true and stage ~= "courted" and stage ~= "mated" then table.insert(e, "mating: a mating scene, but no mating") end
	return e
end

return Mating
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">MatingScene</string>
            <string name="Source"><![CDATA[--!strict
-- The mating scene (ROBLOX-89): what happens between "the meter is full" and "they part", as a pure plan. About fifteen seconds, in four beats, with a camera that
-- eases into a two-shot and makes a slow quarter-orbit over it. Nothing here knows the engine, the clock or the player: it is a function of a seeded plan and the
-- scene's own time `t` (the pair's pause in the simulation, Predator/Mate.sceneTime, which a wasp visit holds as it holds every timer of the mate), so a scene seen
-- again is the same scene, a restored world cannot reroll it, and tests/mating.luau checks it without Roblox. The client draws it (camera, cues to both rigs,
-- captions, the locked controls) and the simulation owns the parting: Life/Mating.tick ends the pause, Life/Mating.skip cuts it short.
--
-- The beats (seconds): 0 to 3 she turns to face him (the female turns toward the male: the player's spider as the female, the mate as the female for a peacock player);
-- 3 to 7 the two touch palps and front legs (a drawn pose through rig:cue("meet") on both rigs: a gentle reach, no more); 7 to 11 they settle together, still, the
-- abdomens breathing (rig:cue("settle")); 11 to 15 one goes: the male rises and walks off toward the sill's edge and the sill is the player's again, or, for a male
-- player, the female turns away and settles and he goes on (she stays). The game is for children and shows nothing but this.
--
-- The controls are locked for the scene; a skip (a jump or cancel) is allowed from `skipAfter` seconds on, and the scene never outlasts `SECONDS`. Reduced Motion: a
-- static two-shot (no orbit), the reach and the settle held as poses, the turn away at once.
local Rules = require(script.Parent.Parent.Data.MatingRules)
local PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)

local MatingScene = {}

MatingScene.SECONDS = Rules.sceneSeconds
MatingScene.SKIP_AFTER = Rules.skipAfter
MatingScene.EASE_SECONDS = 0.8 -- the camera's ease into the two-shot (and out of it after the scene)
MatingScene.BEATS = {
	{ name = "turn", from = 0.0, to = 3.0 },
	{ name = "touch", from = 3.0, to = 7.0 },
	{ name = "settle", from = 7.0, to = 11.0 },
	{ name = "depart", from = 11.0, to = 15.0 },
}
-- The cues to the rigs. "meet" for the touch beat (4 s); "settle" from the third beat: the male's for the beat (it rises as it goes) and the female's through the
-- last (she stays). Seconds are the cue's whole length including its ease in and out.
MatingScene.MEET_AT, MatingScene.MEET_SECONDS = 3.0, 4.0
MatingScene.SETTLE_AT = 7.0
MatingScene.SETTLE_SECONDS = { male = 4.0, female = 8.0 }
-- The quarter-orbit of the camera about the pair: the sweep, centred on the view from the side (both spiders side by side, never one behind the other).
MatingScene.ORBIT_DEG = 90.0
-- The camera's distance from the pair's middle: at least this, or the pair's separation times SEP_K plus SEP_ADD (studs); and the height of the middle's mark above the
-- surface the pair stand on.
MatingScene.MIN_DISTANCE, MatingScene.SEP_K, MatingScene.SEP_ADD, MatingScene.LIFT = 4.2, 1.8, 2.6, 0.5
-- The female mate (a male player) turns away from the player in the last beat: how far and when.
MatingScene.TURN_AWAY_DEG, MatingScene.TURN_AWAY_AT, MatingScene.TURN_AWAY_SECONDS = 110.0, 11.0, 1.5

export type Plan = {
	seed: number, mateNo: number, day: number,
	playerSex: string, mateSex: string,
	dir: number, -- +1 or -1: which way the camera sweeps round the pair
	side: number, -- +1 or -1: which side of the pair it starts on
	jitterDeg: number, -- the sweep's centre, a few degrees off the side view
	elevationDeg: number, -- the camera's height above the pair's plane (slightly above)
	distanceK: number, -- about 1
	turnSign: number, -- +1 or -1: which way the female mate turns away
}

export type Pose = {
	t: number, beat: string, locked: boolean, canSkip: boolean,
	orbit: number, -- radians: the camera's turn about the pair from the side view
	turnAway: number, -- 0..1: how far the female mate has turned away (0 for a male mate)
	over: boolean,
}

export type Shot = { focus: Vector3, dir: Vector3, distance: number, up: Vector3, orbit: number, elevation: number }

local function smooth(x: number): number
	local c = math.clamp(x, 0, 1)
	return c * c * (3 - 2 * c)
end

local function sexOpposite(sex: string): string
	return if sex == "male" then "female" else "male"
end

-- The seeded plan of one scene: from the world's seed, the mate's number (Life/Mating's `mates`) and the day. The same mate on the same day is the same scene on
-- any return (nothing in it is saved: it is a function of numbers that are).
function MatingScene.plan(seed: number, mateNo: number, day: number, playerSex: string): Plan
	local g = PreyRandom.new((seed * 19349663 + mateNo * 83492791 + day * 73856093 + 7727) % 2147483647)
	g:next()
	g:next()
	local function draw(lo: number, hi: number): number return lo + (hi - lo) * g:next() end
	local function sign(): number return if g:next() < 0.5 then -1 else 1 end
	local plan: Plan = {
		seed = seed, mateNo = mateNo, day = day,
		playerSex = playerSex, mateSex = sexOpposite(playerSex),
		dir = sign(), side = sign(), jitterDeg = draw(-8, 8), elevationDeg = draw(28, 36), distanceK = draw(0.95, 1.05), turnSign = sign(),
	}
	return plan
end

-- The beat at scene time `t`: "turn", "touch", "settle", "depart", or "over" once the scene is done (and "" before it).
function MatingScene.beat(t: number): string
	if t < 0 then return "" end
	for _, b in MatingScene.BEATS do
		if t < b.to then return b.name end
	end
	return "over"
end

-- Whether the controls are still the scene's.
function MatingScene.locked(t: number): boolean
	return t >= 0 and t < MatingScene.SECONDS
end

-- Whether a skip is allowed at `t` (after SKIP_AFTER seconds, and while the scene plays).
function MatingScene.canSkip(t: number): boolean
	return t >= MatingScene.SKIP_AFTER - 1e-9 and t < MatingScene.SECONDS
end

-- The cues that fall due as the scene's clock passes from `from` (exclusive) to `to` (inclusive): { { name, seconds = { male, female } } }. The first call of a
-- scene is from -1, so a scene entered late (a restored world) gives the cues it has already passed all at once.
function MatingScene.cues(from: number, to: number): { { name: string, at: number, seconds: { male: number, female: number } } }
	local out = {}
	if from < MatingScene.MEET_AT and to >= MatingScene.MEET_AT then
		table.insert(out, { name = "meet", at = MatingScene.MEET_AT, seconds = { male = MatingScene.MEET_SECONDS, female = MatingScene.MEET_SECONDS } })
	end
	if from < MatingScene.SETTLE_AT and to >= MatingScene.SETTLE_AT then
		table.insert(out, { name = "settle", at = MatingScene.SETTLE_AT, seconds = { male = MatingScene.SETTLE_SECONDS.male, female = MatingScene.SETTLE_SECONDS.female } })
	end
	return out
end

-- The camera's turn about the pair at `t`, radians from the side view: the sweep of ORBIT_DEG centred a few degrees off it (`jitterDeg`), one way or the other
-- (`dir`), slow at the ends; under Reduced Motion none (the centre of the sweep, held).
function MatingScene.orbit(plan: Plan, t: number, reduced: boolean): number
	local centre = math.rad(plan.jitterDeg)
	if reduced then return centre end
	local u = smooth(t / MatingScene.SECONDS)
	return centre + plan.dir * math.rad(MatingScene.ORBIT_DEG) * (u - 0.5)
end

-- The female mate's turn away from the player, 0..1 (only when the mate is the female): from TURN_AWAY_AT over TURN_AWAY_SECONDS, at once under Reduced Motion.
function MatingScene.turnAway(plan: Plan, t: number, reduced: boolean): number
	if plan.mateSex ~= "female" or t < MatingScene.TURN_AWAY_AT then return 0 end
	if reduced then return 1 end
	return smooth((t - MatingScene.TURN_AWAY_AT) / MatingScene.TURN_AWAY_SECONDS)
end

function MatingScene.pose(plan: Plan, t: number, reduced: boolean): Pose
	return {
		t = t, beat = MatingScene.beat(t), locked = MatingScene.locked(t), canSkip = MatingScene.canSkip(t),
		orbit = MatingScene.orbit(plan, t, reduced), turnAway = MatingScene.turnAway(plan, t, reduced), over = t >= MatingScene.SECONDS,
	}
end

-- The two-shot at `t` for the spiders at `a` and `b` standing on a surface whose normal is `up`: the point the camera looks at (the pair's middle, a little up from
-- the surface), the unit direction from it to the camera (slightly above the pair's plane, at the orbit's angle from the side view), and the distance. Framing the
-- pair side by side at any separation: the distance grows with it. Pure; the camera (Client/SpiderCamera) turns it into a placed view, shortening it if something
-- stands in the way.
function MatingScene.shot(plan: Plan, t: number, reduced: boolean, a: Vector3, b: Vector3, up: Vector3): Shot
	local upU = if up.Magnitude > 1e-6 then up.Unit else Vector3.yAxis
	local delta = b - a
	local flat = delta - upU * delta:Dot(upU)
	local sep = flat.Magnitude
	local axis = if sep > 1e-4 then flat.Unit else (if math.abs(upU.Y) < 0.9 then upU:Cross(Vector3.yAxis).Unit else Vector3.xAxis)
	local perp = axis:Cross(upU) * plan.side -- the side of the pair, in the plane they stand on
	local orbit = MatingScene.orbit(plan, t, reduced)
	local turned = CFrame.fromAxisAngle(upU, orbit):VectorToWorldSpace(perp).Unit
	local e = math.rad(plan.elevationDeg)
	local dir = (turned * math.cos(e) + upU * math.sin(e)).Unit
	local focus = (a + b) * 0.5 + upU * MatingScene.LIFT
	local distance = math.max(MatingScene.MIN_DISTANCE, sep * MatingScene.SEP_K + MatingScene.SEP_ADD) * plan.distanceK
	return { focus = focus, dir = dir, distance = distance, up = upU, orbit = orbit, elevation = e }
end

return MatingScene
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Nature</string>
            <string name="Source"><![CDATA[--!strict
-- Nature's rules (ROBLOX-106, W4 of docs/OPEN_WORLD_DESIGN.md; the design called it "ROBLOX-97", a number never used). Nathan: "Normal mode should feel like it doesn't
-- want you to survive"; "movement expends more energy"; "being perched up high avoiding predators and hiding under leaves"; "scared I won't make it home at night".
-- The game's own rules, in the standard rules (Normal) only: Easy and Free play keep ROBLOX-91's gentleness untouched, and nothing here touches Godot's defaults (the
-- needs, the wasp's and the rival's numbers, the clock's rates, perception). Pure: the client hands in what it knows each tick (Client/SpiderClient), the CLI tests
-- drive it alone (tests/nature.luau).
--
-- * Movement (`Nature.moved`): which movement the spider made this tick, for NeedsModel.move (NeedsModel.game.moveCost): walking on a surface, a jump as it leaves
--   the surface, letting down or reeling in on the line. Standing, hanging still and resting cost nothing extra.
-- * Cover (`Nature.cover`): how much faster or slower a predator's notice grows: halved under a leaf (something solid overhead within `coverWu`, a ray straight up
--   from the spider) and halved again when still; doubled when moving in the open. The wasp's notice (WaspDirector, `spider.cover`) and the rival's
--   (RivalSpider, `s.noticeScale`) take it; their own rules are as they were.
-- * The night (`Nature.night`): out of every retreat after dark anywhere but the sill (the nursery, behind the glass), the ground hunters pass three times a night at
--   hours drawn from the world's seed and the night; a spider exposed when one passes is found (death: the card says so) or, if the draw spares it, passes a cold
--   night and is slow until the morning warms. A spider in any retreat, or on the sill, is never drawn against. Dusk is told by the light alone: no notice comes
--   before it. Restores never reroll: the hours and the draws are pure functions of the seed, the night and the pass, and a return to a rest starts the night's
--   count again from the restored hour (the passes already behind it are behind it; the spider was in its retreat for them).
local PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)

local Nature = {}

Nature.game = {
	-- Cover: the ray straight up that finds a leaf (or anything solid) over the spider, and the factors.
	coverWu = 6.0, covered = 0.5, still = 0.5, openMoving = 2.0,
	-- The night: the passes' windows in hours of the night (an hour after midnight is 24 + it), the chance a pass finds an exposed spider, and the cold morning.
	passes = { { 20.5, 23.5 }, { 23.5, 26.5 }, { 26.5, 29.5 } },
	foundChance = 0.25,
	coldUntilH = 10.0, -- the cold morning lasts until this hour of the day after the night
	coldSpeed = 0.6, -- the walk's speed while it lasts
	nightFromH = 18.0, -- (LifeClock.EVENING_H: an hour from here belongs to the night of its own day)
	morningH = 7.0, -- (LifeClock.WAKE_H: an hour before this belongs to the night of the day before)
}

local function finite(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

-- ------------------------------------------------------------------------------------------------------------------- cover

-- The factor on a predator's notice for a spider `covered` (something overhead) and `still`. 1 is the old rule; the standard rules only (the caller asks).
function Nature.cover(covered: boolean, still: boolean): number
	local g = Nature.game
	if covered or still then
		return (if covered then g.covered else 1.0) * (if still then g.still else 1.0)
	end
	return g.openMoving
end

-- Whether something solid is over the point within the cover ray. `ray(from, dir)` is the world's cast (nil: nothing).
function Nature.overhead(at: Vector3, ray: (Vector3, Vector3) -> any): boolean
	return ray(at + Vector3.new(0, 0.05, 0), Vector3.new(0, Nature.game.coverWu, 0)) ~= nil
end

-- ------------------------------------------------------------------------------------------------------------------- movement

-- What the spider did this tick, from the motor (its mode, whether it walks, whether it was dropped, its line's length) and the last tick's `st` (kept by the
-- caller, updated here): "jump" on the tick it leaves a surface by a jump or hop, "walk" while it walks a surface, "line" while the line's length changes
-- (letting down, reeling in), else "". A drop off an edge onto the line is not a jump; a seized spider does nothing.
function Nature.moved(st: { [string]: any }, mode: string, moving: boolean, dropped: boolean, seized: boolean, onLine: boolean, lineLength: number?): string
	local was = st.mode
	local rest = st.rest
	st.mode = mode
	st.rest = if onLine then lineLength else nil
	if seized then return "" end
	if mode == "air" and was == "attached" and not dropped then return "jump" end
	if mode == "attached" and moving then return "walk" end
	if onLine and lineLength ~= nil and rest ~= nil and math.abs(lineLength - rest) > 1e-5 then return "line" end
	return ""
end

-- ------------------------------------------------------------------------------------------------------------------- the night

-- The night an hour belongs to (the day it began), and the hour counted in that night (after midnight, 24 + the hour); nil by day.
function Nature.nightOf(day: number, hour: number): (number?, number)
	local g = Nature.game
	if hour >= g.nightFromH then return day, hour end
	if hour < g.morningH then return day - 1, hour + 24 end
	return nil, hour
end

-- One stream a night (the world's seed and the night), drawn in order: the first pass's hour, whether it finds, the second's hour, ... (one stream, so the passes of a
-- night are independent draws, not offsets of one another).
local function draws(seed: number, night: number): ({ number }, { boolean })
	local r = PreyRandom.mixed(seed, night, 71)
	local hours: { number }, found: { boolean } = {}, {}
	for i, w in Nature.game.passes do
		hours[i] = w[1] + (w[2] - w[1]) * r:next()
		found[i] = r:next() < Nature.game.foundChance
	end
	return hours, found
end

-- The hours (in the night's count) at which the ground hunters pass on night `night`, one in each window.
function Nature.passHours(seed: number, night: number): { number }
	return (draws(seed, night))
end

-- Whether pass `pass` of night `night` finds an exposed spider.
function Nature.found(seed: number, night: number, pass: number): boolean
	local _, found = draws(seed, night)
	return found[pass] == true
end

-- The kinds of region inside the house, where the garden's night (its ground hunters, its cold) does not reach: the sill, and (ROBLOX-112) the kitchen's counter and floor.
-- The inside's own night (the house spider, the lamp's moths) is the inside's round (docs/WORLD_MAP_PLAN.md).
-- (ROBLOX-116: and the ranger hut's inside, World/Hut.INDOORS: its floor, its furniture and the window over the sill)
Nature.INDOORS = table.freeze({ sill = true, counter = true, kitchen_floor = true, hut_window = true, hut_floor = true, hut_desk = true, hut_board = true, hut_shelf = true,
	hut_chair = true,
	-- (ROBLOX-118: the ceiling and the upper walls, the doorway, the front door's head and the volunteers' back room, World/Hut.INDOORS)
	hut_upper = true, hut_doorway = true, hut_door_up = true, room_floor = true, room_sofa = true, room_tv = true, room_games = true, room_window = true })

-- Whether a spider is exposed to the night where it is: in the standard rules, anywhere outside the house (ROBLOX-106: anywhere but the sill), out of every retreat.
function Nature.exposed(standard: boolean, regionKind: string, inRetreat: boolean): boolean
	return standard and not Nature.INDOORS[regionKind] and not inRetreat
end

-- One tick of the night. `st` is the caller's (never saved; cleared on a return to a rest and a new life); `life` the LifeLoop (its clock; `cold_day` is set on it,
-- an optional field the checkpoint keeps). `ctx`: seed, exposed. Returns "found" (death), "cold" (a pass spared an exposed spider) or "".
function Nature.night(st: { [string]: any }, life: any, ctx: { seed: number, exposed: boolean }): string
	local night, h = Nature.nightOf(life.clock.day, life.clock.hour)
	if night == nil then
		st.night, st.done = nil, nil
		return ""
	end
	local hours = Nature.passHours(ctx.seed, night)
	if st.night ~= night then
		-- A night met for the first time here: the passes already behind this hour are behind it (a new night at 18:00 has none; a restored rest has the spider in
		-- its retreat for them).
		local done = 0
		for i, ph in hours do if ph <= h then done = i end end
		st.night, st.done = night, done
		return ""
	end
	local event = ""
	for i = (st.done or 0) + 1, #hours do
		if hours[i] > h then break end
		st.done = i
		if ctx.exposed and event == "" then
			if Nature.found(ctx.seed, night, i) then
				event = "found"
			else
				life.cold_day = night + 1
				event = "cold"
			end
		end
	end
	return event
end

-- The cold after an exposed night: the factor on the walk's speed now (1 when there is none; a cold that is over is cleared).
function Nature.coldSpeed(life: any): number
	local d = life.cold_day
	if d == nil then return 1.0 end
	local day, hour = life.clock.day, life.clock.hour
	if day < d or (day == d and hour < Nature.game.coldUntilH) then return Nature.game.coldSpeed end
	life.cold_day = nil
	return 1.0
end

-- Whether a record's `cold_day` is good (nil is).
function Nature.validCold(v: any): boolean
	return v == nil or (finite(v) and v >= 1 and v <= 1e9 and v % 1 == 0)
end

return Nature
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">NeedsModel</string>
            <string name="Source"><![CDATA[--!strict
-- NeedsModel: a port of the frozen scripts/needs/needs_model.gd (spec 11, 19.3, 21.3 NeedState; LIFE-05). The spider's
-- reserves, and the only place they change. It simulates ENERGY and REST and nothing else (hydration, stress and condition are
-- named placeholders in the record). The numbers change only through approved calls: time passing (advance, addHours) and food
-- (grantEnergy). It never reads the world, never decides that anything is eaten, and does not know what a fly is: Feeding asks
-- it to grant and says which source the energy came from, so its ledger shows that no source ever gave more than it had.
--
-- Two modes (explicit, set by whoever builds it; ROBLOX-24):
--   * sandbox (lifeMode false; Godot's lab and tests that build a model alone): energy drains very slowly with action time and
--     stops at ENERGY_FLOOR. Nothing happens at the floor.
--   * life (lifeMode true; the windowsill, where the life clock runs): energy drains with the game hours LifeLoop reports,
--     faster awake than asleep, and has no floor. It can run out; the hours at zero are counted (starvingHours, and the streak
--     since the last meal). LifeLoop reads the streak: weak (too hungry to sleep) after 24 hours of it and starved after 48, except in the
--     gentle modes (ROBLOX-91: the streak is Godot's reset by any meal, or, in the game's rules, eased by each meal by the hours it covers).
--   * gentle (with lifeMode; Godot's Easy and free play) drains at GENTLE_DRAIN of the rate and never falls below GENTLE_FLOOR.
-- Both drains are integrated at the 2 Hz update (spec 20) over the action time that actually passed, at most MAX_STEP_S a
-- call, so the same time drains the same energy at any frame rate and a stall cannot drain more than a capped step.
-- Rest is a second reserve with no consequence yet: it wears down while the spider is active and builds back while it keeps
-- still, and the retreat restores it.
-- Checked against Godot's own values in tests/life_reference.json (tools/export_life_reference.gd).

local NeedsModel = {}
NeedsModel.__index = NeedsModel

NeedsModel.ENERGY_MAX = 1.0
NeedsModel.ENERGY_START = 0.55
NeedsModel.ENERGY_DRAIN_PER_S = 0.0006
NeedsModel.ENERGY_FLOOR = 0.20
NeedsModel.REST_MAX = 1.0
NeedsModel.REST_START = 1.0
NeedsModel.REST_DRAIN_PER_S = 0.0012
NeedsModel.REST_RECOVER_PER_S = 0.004
NeedsModel.UPDATE_PERIOD_S = 0.5
NeedsModel.MAX_STEP_S = 0.25
NeedsModel.FULL_AT = 0.98
-- Life mode, at Godot's factor 1: a full reserve lasts about three game days without food, and one fly (0.35) feeds the spider for about a day.
-- A real Phidippus goes much longer without food; the game compresses time on purpose (LIFE-05).
NeedsModel.LIFE_DRAIN_AWAKE_PER_H = 0.021
NeedsModel.LIFE_DRAIN_ASLEEP_PER_H = 0.007
-- The game's own rules (ROBLOX-78), opt-in like Data/Wasp.game and Data/Catch.game: `drain` multiplies the life-mode drain (awake and asleep alike; the
-- gentle modes have their own factor, below) of a model that was given them by useGameRules. A model that never is replays Godot (factor 1) and the reference fixtures hold.
-- The factor is worked out from the constants above: a day is about 11 waking hours and 13 asleep, 11 x 0.021 + 13 x 0.007 = 0.322 energy at factor 1,
-- so 1.55 cost 0.499, about half the reserve (it was 1.1, 0.354, Chet's ten percent more, ROBLOX-61). ROBLOX-88: 1.9 costs 0.612 a day (11 x 0.021 x 1.9 =
-- 0.439 awake, 13 x 0.007 x 1.9 = 0.173 asleep): a full reserve lasts 1.63 days, and a housefly (0.35) is 0.57 of a day.
-- ROBLOX-91: the gentle modes (Easy, Free play) have their own factor, `gentleDrain` 1.1 (ROBLOX-61's, which with the gentle half rate costs 0.177 a day), applied
-- INSTEAD of `drain` when the model is gentle: ROBLOX-88's hungrier pacing was meant for the standard rules (the gentle day would otherwise have cost 0.306).
-- `streakDecay`: a meal in the game eases the starving streak by the hours it covers at the current drain (amount / the awake rate) and ends it altogether
-- only when the reserve rises above `streakEndsAbove` (0.1); Godot's rule, a full reset at any meal, stays the default, so one tiny catch a day at 0% energy
-- no longer keeps a spider alive for ever.
NeedsModel.game = { drain = 2.4, gentleDrain = 1.1, streakDecay = true, streakEndsAbove = 0.1 }
-- ROBLOX-102 (Nathan on v33: "still more difficult with faster life depletion"): 1.9 -> 2.4, a day costs 0.773 (11 x 0.021 x 2.4 + 13 x 0.007 x 2.4); a full reserve lasts
-- about 1.3 days. Gentle modes keep gentleDrain 1.1.
-- ROBLOX-106 (W4, Nathan: "movement expends more energy"; "hunger always a major concern"): moving costs energy on top of the clock's drain, in the standard rules only
-- (a gentle model, Easy and Free play, pays nothing; a model never given the game's rules is Godot's and pays nothing). `moveCost` is per second of action time (the
-- fixed tick's, so slow motion slows it and the garden's slower clock does not: it is the legs, not the day): walking on a surface `walkPerS`, letting down or reeling in
-- on the line `linePerS`, and each jump or hop `jump` once as it leaves the surface; standing, hanging still on the line and resting cost nothing extra (the sit-and-wait
-- economy). The numbers against the 0.773 a day of the drain (11 waking hours, 825 s of play on the sill): a still day 0.773; a typical day (a third of the waking time
-- walking, 275 s, 30 jumps, a minute on the line) 0.773 + 0.110 + 0.060 + 0.012 = 0.955, about 2.7 houseflies; a restless day (two thirds walking, 550 s, 100 jumps,
-- three minutes on the line) 0.773 + 0.220 + 0.200 + 0.036 = 1.229, about 3.5 houseflies. A cost the reserve cannot pay is counted as starving time at the awake rate.
NeedsModel.game.moveCost = { walkPerS = 0.0004, linePerS = 0.0002, jump = 0.002 }
NeedsModel.PLAY_DRAIN = NeedsModel.game.drain -- (the name the client and tests have used since ROBLOX-61)
NeedsModel.GENTLE_DRAIN = 0.5
NeedsModel.GENTLE_FLOOR = 0.1
NeedsModel.STAGE_ID = "p0_prototype"

local function finite(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local function unit(v: any): boolean
	return finite(v) and v >= 0.0 and v <= 1.0
end

local function nonNegative(v: any): boolean
	return finite(v) and v >= 0.0
end

local function pair(v: any): boolean
	return type(v) == "table" and #v == 2 and v[3] == nil and nonNegative(v[1]) and nonNegative(v[2])
end

export type Record = {
	energy: number, rest: number, enabled: { string }, update_accumulator: { number }, stage_id: string,
	elapsed_s: number, granted_total: number, granted_by_source: { [string]: number },
	life_mode: boolean, starving_hours: number, hour_accumulator: { number }, starving_streak_h: number,
}

-- `lifeMode` and `gentle` say which rules apply (see above). Both default to false: the sandbox rules.
function NeedsModel.useGameRules(self: any)
	self.drainScale = NeedsModel.game.drain
	self.gentleDrainScale = NeedsModel.game.gentleDrain
	self.streakDecay = NeedsModel.game.streakDecay
	self.moveCosts = true -- (ROBLOX-106: the flag, not the table, so a record carries no copy of the numbers)
end

-- The factor on the life-mode drain in use: Godot's 1 for a model never given the game's rules, else the game's (the gentle modes have their own).
function NeedsModel.drainFactor(self: any): number
	if self.gentle and self.gentleDrainScale ~= nil then return self.gentleDrainScale end
	return self.drainScale or 1
end

function NeedsModel.new(lifeMode: boolean?, gentle: boolean?): any
	return setmetatable({
		energy = NeedsModel.ENERGY_START, rest = NeedsModel.REST_START,
		elapsedS = 0.0, grantedTotal = 0.0, grantedBySource = {} :: { [string]: number }, grantsMade = 0, grantsRefused = 0,
		lifeMode = lifeMode == true, gentle = gentle == true, starvingHours = 0.0, starvingStreakH = 0.0,
		_accActive = 0.0, _accStill = 0.0, _accHoursAwake = 0.0, _accHoursAsleep = 0.0,
		-- Called with (before, after) whenever energy changes (Godot's energy_changed signal). Optional.
		onEnergyChanged = nil :: ((number, number) -> ())?,
	}, NeedsModel)
end

local function changed(self: any, before: number)
	if self.energy ~= before and self.onEnergyChanged then
		self.onEnergyChanged(before, self.energy)
	end
end

-- Changes the numbers for a fixture. Keys: energy, rest. Values outside [0, 1] or not finite are ignored.
function NeedsModel.configure(self: any, values: { energy: number?, rest: number? })
	if values.energy ~= nil and unit(values.energy) then
		self.energy = values.energy
	end
	if values.rest ~= nil and unit(values.rest) then
		self.rest = values.rest
	end
end

function NeedsModel._apply(self: any, period: number, activeShare: number)
	local before = self.energy
	if self.lifeMode then
		local need = (self._accHoursAwake * NeedsModel.LIFE_DRAIN_AWAKE_PER_H + self._accHoursAsleep * NeedsModel.LIFE_DRAIN_ASLEEP_PER_H) * self:drainFactor()
		local hours = self._accHoursAwake + self._accHoursAsleep
		self._accHoursAwake = 0.0
		self._accHoursAsleep = 0.0
		if self.gentle then
			need *= NeedsModel.GENTLE_DRAIN
		end
		if need > 0.0 then
			local floorLeft = if self.gentle then math.max(self.energy - NeedsModel.GENTLE_FLOOR, 0.0) else self.energy
			local used = math.min(floorLeft, need)
			self.energy -= used
			if need > used and not self.gentle then
				local starved = hours * (need - used) / need
				self.starvingHours += starved
				self.starvingStreakH += starved
			end
		end
	elseif self.energy > NeedsModel.ENERGY_FLOOR then
		self.energy = math.max(NeedsModel.ENERGY_FLOOR, self.energy - NeedsModel.ENERGY_DRAIN_PER_S * period)
	end
	self.rest = math.clamp(
		self.rest + (NeedsModel.REST_RECOVER_PER_S * (1.0 - activeShare) - NeedsModel.REST_DRAIN_PER_S * activeShare) * period,
		0.0, NeedsModel.REST_MAX)
	changed(self, before)
end

-- Lets `dt` seconds of action time pass. `active` is whether the spider spent them moving (walking, leaping, hanging) rather
-- than keeping still. Non-finite or non-positive time is ignored; a long step counts as at most MAX_STEP_S.
function NeedsModel.advance(self: any, dt: number, active: boolean)
	if not finite(dt) or dt <= 0.0 then
		return
	end
	dt = math.min(dt, NeedsModel.MAX_STEP_S)
	self.elapsedS += dt
	if active then
		self._accActive += dt
	else
		self._accStill += dt
	end
	local total = self._accActive + self._accStill
	while total >= NeedsModel.UPDATE_PERIOD_S - 1e-9 do
		self:_apply(NeedsModel.UPDATE_PERIOD_S, self._accActive / total)
		local keep = math.max(0.0, (total - NeedsModel.UPDATE_PERIOD_S) / total)
		self._accActive *= keep
		self._accStill *= keep
		total -= NeedsModel.UPDATE_PERIOD_S
	end
end

-- Life mode: `hours` of game time passed, asleep or awake. They are used up at the next 2 Hz update.
function NeedsModel.addHours(self: any, hours: number, asleep: boolean)
	if not self.lifeMode or not finite(hours) or hours <= 0.0 then
		return
	end
	if asleep then
		self._accHoursAsleep += hours
	else
		self._accHoursAwake += hours
	end
end

-- ROBLOX-106: what a movement costs now: `kind` is "walk" or "line" (for `dt` seconds of it) or "jump" (once). Nothing for a model without the game's rules, a gentle
-- model, a sandbox model or an unknown kind.
function NeedsModel.moveCostOf(self: any, kind: string, dt: number): number
	local c = NeedsModel.game.moveCost
	if self.moveCosts ~= true or self.gentle or not self.lifeMode then return 0.0 end
	if kind == "jump" then return c.jump or 0.0 end
	if not finite(dt) or dt <= 0.0 then return 0.0 end
	if kind == "walk" then return (c.walkPerS or 0.0) * math.min(dt, NeedsModel.MAX_STEP_S) end
	if kind == "line" then return (c.linePerS or 0.0) * math.min(dt, NeedsModel.MAX_STEP_S) end
	return 0.0
end

-- ROBLOX-106: pays for a movement (see moveCostOf) out of the reserve at once. What the reserve cannot pay is starving time at the awake rate, so a restless starving
-- spider starves sooner than a still one. Returns what was paid from the reserve.
function NeedsModel.move(self: any, kind: string, dt: number): number
	local cost = self:moveCostOf(kind, dt)
	if cost <= 0.0 then return 0.0 end
	local before = self.energy
	local paid = math.min(cost, self.energy)
	self.energy -= paid
	if cost > paid then
		local perHour = NeedsModel.LIFE_DRAIN_AWAKE_PER_H * self:drainFactor()
		local starved = (cost - paid) / perHour
		self.starvingHours += starved
		self.starvingStreakH += starved
	end
	changed(self, before)
	return paid
end

-- Whether the reserve has run out (life mode).
function NeedsModel.isStarving(self: any): boolean
	return self.lifeMode and self.energy <= 0.0
end

-- Energy that could still be added.
function NeedsModel.room(self: any): number
	return math.max(0.0, NeedsModel.ENERGY_MAX - self.energy)
end

-- Adds food energy from `sourceId` (a meal's capture key). Returns what was actually added: nothing for an amount that is not
-- a positive finite number or a source with no name, and never more than the room left. The caller (Feeding, only while a
-- held prey is being eaten) decides that the energy is deserved; this only keeps the books.
function NeedsModel.grantEnergy(self: any, amount: number, sourceId: string): number
	if sourceId == "" or not finite(amount) or amount <= 0.0 then
		self.grantsRefused += 1
		return 0.0
	end
	local added = math.min(amount, self:room())
	if added <= 0.0 then
		return 0.0
	end
	local before = self.energy
	self.energy = math.min(NeedsModel.ENERGY_MAX, self.energy + added)
	added = self.energy - before
	self.grantedTotal += added
	self.grantedBySource[sourceId] = (self.grantedBySource[sourceId] or 0.0) + added
	self.grantsMade += 1
	if self.streakDecay then
		-- The game: the meal covers the hours it feeds (at the awake rate) and the streak only ends when the reserve is really back.
		local perHour = NeedsModel.LIFE_DRAIN_AWAKE_PER_H * self:drainFactor()
		self.starvingStreakH = math.max(0.0, self.starvingStreakH - added / perHour)
		if self.energy > (NeedsModel.game.streakEndsAbove or 0.1) then self.starvingStreakH = 0.0 end
	else
		self.starvingStreakH = 0.0
	end
	changed(self, before)
	return added
end

-- Energy lost to an injury (ROBLOX-73: the rival's counter-bite). Never more than the spider has, and nothing in the gentle modes. Returns what was
-- lost. It is not time passing, so it leaves the starving hours to the drain; the reserve is already in the record, so nothing else needs keeping.
function NeedsModel.injure(self: any, amount: number): number
	if self.gentle or not finite(amount) or amount <= 0.0 then
		return 0.0
	end
	local before = self.energy
	self.energy = math.max(0.0, self.energy - amount)
	changed(self, before)
	return before - self.energy
end

-- A valid retreat interaction restores rest; it never grants food energy.
function NeedsModel.restoreRest(self: any, amount: number)
	if finite(amount) and amount > 0.0 then
		self.rest = math.min(NeedsModel.REST_MAX, self.rest + amount)
	end
end

function NeedsModel.isFull(self: any): boolean
	return self.energy >= NeedsModel.FULL_AT
end

-- What one source has given so far.
function NeedsModel.grantedFrom(self: any, sourceId: string): number
	return self.grantedBySource[sourceId] or 0.0
end

-- The NeedState record (spec 21.3), with Godot's field names. Hydration, stress and condition are not simulated and so absent.
function NeedsModel.toRecord(self: any): Record
	local by: { [string]: number } = {}
	for k, v in self.grantedBySource do
		by[k] = v
	end
	return {
		energy = self.energy, rest = self.rest, enabled = { "energy", "rest" },
		update_accumulator = { self._accActive, self._accStill }, stage_id = NeedsModel.STAGE_ID,
		elapsed_s = self.elapsedS, granted_total = self.grantedTotal, granted_by_source = by,
		life_mode = self.lifeMode, starving_hours = self.starvingHours,
		hour_accumulator = { self._accHoursAwake, self._accHoursAsleep }, starving_streak_h = self.starvingStreakH,
	}
end

-- Restores a record made by toRecord. False, and nothing changed, for anything that is not one: a missing or non-finite number,
-- a reserve outside [0, 1], an accumulator that is not two non-negative numbers, a grant ledger that does not add up. A record
-- without the life fields (Godot's older records) loads with them at their defaults. `gentle` is not part of the record.
function NeedsModel.load(self: any, d: any): boolean
	if type(d) ~= "table" then
		return false
	end
	for _, key in { "energy", "rest", "elapsed_s", "granted_total" } do
		if not finite(d[key]) then
			return false
		end
	end
	if not unit(d.energy) or not unit(d.rest) or d.elapsed_s < 0.0 or d.granted_total < 0.0 then
		return false
	end
	if not pair(d.update_accumulator) then
		return false
	end
	local by = d.granted_by_source
	if type(by) ~= "table" then
		return false
	end
	local sum = 0.0
	for k, v in by do
		if type(k) ~= "string" or not nonNegative(v) then
			return false
		end
		sum += v
	end
	if math.abs(sum - d.granted_total) > 1e-6 then
		return false
	end
	local lm = if d.life_mode == nil then false else d.life_mode
	local sh = if d.starving_hours == nil then 0.0 else d.starving_hours
	local ha = if d.hour_accumulator == nil then { 0.0, 0.0 } else d.hour_accumulator
	local streak = if d.starving_streak_h == nil then 0.0 else d.starving_streak_h
	if not nonNegative(streak) then
		return false
	end
	if type(lm) ~= "boolean" or not nonNegative(sh) then
		return false
	end
	if not pair(ha) then
		return false
	end
	local copy: { [string]: number } = {}
	for k, v in by do
		copy[k] = v
	end
	self.lifeMode = lm
	self.starvingHours = sh
	self.starvingStreakH = streak
	self._accHoursAwake = ha[1]
	self._accHoursAsleep = ha[2]
	self.energy = d.energy
	self.rest = d.rest
	self.elapsedS = d.elapsed_s
	self.grantedTotal = d.granted_total
	self.grantedBySource = copy
	self._accActive = d.update_accumulator[1]
	self._accStill = d.update_accumulator[2]
	return true
end

return NeedsModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Nursery</string>
            <string name="Source"><![CDATA[--!strict
-- The nursery rule (ROBLOX-116, docs/PARK_WORLD_DESIGN.md: Nathan's "born on the sill, the sash shut until ready"). In the preserve's first life the ranger hut's
-- window is shut and the hut's door is shut: the spider has the sill, the desk and the hut's inside. The window opens once, when the spider has grown past its
-- first moult and its new cuticle has hardened, on the first morning after that the ranger comes in (a seeded hour of the morning, `arrival`), and it stays
-- open from then on: the save remembers it (Persistence/SaveProgress `hut_window`), every later life finds it open, and nothing ever shuts it again.
--
-- Why the moult and not a number of days: the moult is the life's own proof that the spider can hunt (it has eaten what a moult asks for: five houseflies'
-- worth in Normal, three in the gentle modes, Life/Growth), and a jumping spider leaves the place it hatched as a juvenile, not after a calendar. A spider that
-- starves in the nursery has not been let out early: the next life is born in it again. The hardening (Growth.SOFT_HOURS) keeps the open window from meeting a
-- soft spider: the garden's wasp and its night are no place for one.
-- Pure: the client asks (Client/HutLife); tests/preserve.luau holds it.
local Nursery = {}

-- The ranger comes in between these hours of the morning (the life clock's); the window can be propped until noon of that day, and on any later morning.
Nursery.ARRIVAL = table.freeze({ 7.5, 9.5 })
Nursery.NOON = 12.0
-- The stage the spider must have reached (Life/Growth: 0 the young juvenile, 1 after the first moult).
Nursery.STAGE = 1

local MOD = 2147483647

-- The hour the ranger comes in on a day (the life clock's day, from 1), from the world's seed: the same hour for the same day forever (a restore never rerolls it).
function Nursery.arrival(seed: number, day: number): number
	local h = (math.floor(seed) % MOD + math.floor(day) * 104729) % MOD
	if h <= 0 then h += MOD - 1 end
	for _ = 1, 4 do h = (h * 48271) % MOD end
	local u = (h - 1) / (MOD - 1)
	return Nursery.ARRIVAL[1] + (Nursery.ARRIVAL[2] - Nursery.ARRIVAL[1]) * u
end

-- Whether the spider is ready to leave: past the stage, not moulting, its cuticle hard.
function Nursery.ready(stage: number, moulting: boolean, soft: boolean): boolean
	return stage >= Nursery.STAGE and not moulting and not soft
end

-- Whether the window is propped now: the spider ready and the ranger in (from the morning's arrival until noon).
function Nursery.opens(seed: number, stage: number, moulting: boolean, soft: boolean, day: number, hour: number): boolean
	if not Nursery.ready(stage, moulting, soft) then return false end
	return hour >= Nursery.arrival(seed, day) and hour < Nursery.NOON
end

return table.freeze(Nursery)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">RareDirector</string>
            <string name="Source"><![CDATA[--!strict
local Ledger=require(script.Parent.RareLedger)
local Catalog=require(script.Parent.Parent.Data.RareSightings)
local Environment=require(script.Parent.Parent.World.Environment)
local Director={}
-- Optional life fields are part of the existing checkpoint object graph.
function Director.beginLife(history: Ledger.Record,life: any)
 life.rareSerial=Ledger.beginLife(history)
 life.rareGeneration=life.generation or 0;life.rareBorn=life.clock.day;life.rareVisit=nil
end
function Director.ensureLife(history: Ledger.Record,life: any)
 if life.rareSerial==nil then
  -- Legacy rests get the current high-water mark, not another roll on reload.
  if history.serial==0 then Ledger.beginLife(history) end
  life.rareSerial=history.serial;life.rareGeneration=life.generation or 0;life.rareBorn=life.clock.day
 elseif life.rareGeneration~=(life.generation or 0) then Director.beginLife(history,life) end
 history.serial=math.max(history.serial,life.rareSerial)
end
function Director.plan(seed: number,serial: number,born: number): any?
 local spec=Catalog.luna
 if Environment.hash(seed,serial,701)>=spec.chance then return nil end
 return {id=spec.id,serial=serial,day=born+1+math.floor(Environment.hash(seed,serial,703)*spec.days),
  hour=20+Environment.hash(seed,serial,709)*2}
end
function Director.step(history: Ledger.Record,life: any,seed: number): any?
 Director.ensureLife(history,life)
 if life.lifeOver then return nil end
 local spec=Catalog.luna;local day,hour=life.clock.day,life.clock.hour
 local now=(day-1)*24+hour
 local visit=life.rareVisit
 if visit==nil and not history.blocked and (history.claimed[spec.id] or 0)<life.rareSerial then
  local plan=Director.plan(seed,life.rareSerial,life.rareBorn)
  if plan then
   local at=(plan.day-1)*24+plan.hour;local dawn=plan.day*24+6
   local doy=Environment.solar(plan.day,plan.hour).dayOfYear
   if now>=at and now<dawn and doy>=spec.firstDay and doy<=spec.lastDay then
    -- Weather is sampled at the scheduled arrival, not at the player's reload.
    local weather=Environment.sample(plan.day,plan.hour,seed)
    if weather.temperature>=spec.minTemperature and weather.rain<=spec.maxRain then
     history.claimed[spec.id]=life.rareSerial
     visit={id=spec.id,serial=life.rareSerial,day=plan.day,hour=plan.hour}
     life.rareVisit=visit
    end
   end
  end
 end
 if visit==nil or visit.serial~=life.rareSerial then return nil end
 local start=(visit.day-1)*24+visit.hour;local dawn=visit.day*24+6
 if now<start or now>=dawn then return nil end
 -- Current weather never rerolls the arrival. Later rain does not erase it.
 return {id=spec.id,serial=visit.serial,at=spec.at,ageHours=now-start,day=visit.day}
end
function Director.problems(life: any): {string}
 local problems={}
 local function whole(n: any,minimum: number): boolean
  return type(n)=="number" and n==n and n>=minimum and n<=Ledger.MAX_SERIAL and n%1==0
 end
 if life.rareSerial==nil then
  if life.rareBorn~=nil or life.rareGeneration~=nil or life.rareVisit~=nil then table.insert(problems,"rare visit without life identity") end
  return problems
 end
 if not whole(life.rareSerial,1) or not whole(life.rareBorn,1) or not whole(life.rareGeneration,0) then
  table.insert(problems,"invalid rare life identity")
 end
 local v=life.rareVisit
 if v~=nil then
  if type(v)~="table" or v.id~=Catalog.luna.id or v.serial~=life.rareSerial or not whole(v.day,1)
   or type(v.hour)~="number" or v.hour~=v.hour or v.hour<20 or v.hour>=22 then
   table.insert(problems,"invalid rare visit")
  end
 end
 return problems
end
return Director
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">RareLedger</string>
            <string name="Source"><![CDATA[--!strict
-- Player progress, outside rests. High-water marks prevent a rewound rest
-- creating a second visit; restoring a rest DURING a visit restores that animal.
local Ledger = {}
Ledger.LIMIT = 64
Ledger.MAX_SERIAL = 1000000000
export type Record = { serial: number, claimed: { [string]: number }, once: { [string]: boolean }, blocked: boolean? }
function Ledger.new(): Record return {serial=0,claimed={},once={}} end
local function whole(x: any): boolean
 return type(x)=="number" and x==x and x>=0 and x<=Ledger.MAX_SERIAL and x%1==0
end
function Ledger.clean(raw: any): Record?
 if type(raw)~="table" or not whole(raw.serial) or type(raw.claimed)~="table" or type(raw.once)~="table" then return nil end
 local out=Ledger.new();out.serial=raw.serial
 if raw.blocked~=nil and type(raw.blocked)~="boolean" then return nil end
 if raw.blocked==true then out.blocked=true end
 for _,field in {"claimed","once"} do
  local count=0
  for id,value in raw[field] do
   count+=1
   if count>Ledger.LIMIT or type(id)~="string" or #id<1 or #id>64 or not string.match(id,"^[%w_]+$") then return nil end
   if field=="claimed" then
    if not whole(value) or value>raw.serial then return nil end
    out.claimed[id]=value
   else
    if value~=true then return nil end
    out.once[id]=true
   end
  end
 end
 return out
end
function Ledger.merge(a: Record?,b: Record?): Record
 local out=Ledger.new()
 for _,record in {a or Ledger.new(),b or Ledger.new()} do
  out.serial=math.max(out.serial,record.serial)
  if record.blocked then out.blocked=true end
  for id,n in record.claimed do out.claimed[id]=math.max(out.claimed[id] or 0,n) end
  for id in record.once do out.once[id]=true end
 end
 -- Retain a bounded record even when two individually valid maps overflow on
 -- merge. Fail closed: a discarded claim must never make an animal repeat.
 for _,field in {"claimed","once"} do
  local map=(out :: any)[field];local keys={}
  for id in map do table.insert(keys,id) end
  table.sort(keys)
  for i=Ledger.LIMIT+1,#keys do map[keys[i]]=nil;out.blocked=true end
 end
 return out
end
function Ledger.signature(record: Record): string
 local sum,count=0,0
 for _,n in record.claimed do sum+=n end
 for _ in record.once do count+=1 end
 return `{record.serial}:{sum}:{count}:{record.blocked==true}`
end
function Ledger.same(a: Record?,b: Record?): boolean
 local x,y=a or Ledger.new(),b or Ledger.new()
 if x.serial~=y.serial or (x.blocked==true)~=(y.blocked==true) then return false end
 for _,field in {"claimed","once"} do
  for id,value in (x :: any)[field] do if (y :: any)[field][id]~=value then return false end end
  for id,value in (y :: any)[field] do if (x :: any)[field][id]~=value then return false end end
 end
 return true
end
function Ledger.beginLife(record: Record): number
 assert(record.serial<Ledger.MAX_SERIAL,"rare life counter exhausted")
 record.serial+=1;return record.serial
end
return Ledger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Water</string>
            <string name="Source"><![CDATA[--!strict
-- The water (ROBLOX-122, docs/PARK_WORLD_DESIGN.md zone 4: "water (drowning)"): the pond's surface is not a place a jumping spider can live on. The sources the notebook's
-- page "Spiders and water" cites say why: most spiders are not built for it (of 166 species outside the wolf and fishing spiders tested on water, only two jumping
-- spiders rowed at all, and the jumping spiders that walked or rowed on it got no clear good of it); a fishing spider runs on the water's film, a jumping spider
-- that falls in struggles. Here the water has no box (World/Pond: nothing to stand on), and a spider whose body goes under its surface (World/Pond.inWater) is in it.
-- Pure: the client seizes the motor and holds the body at the surface while the struggle lasts, then puts it where this says or ends the life.
--
-- The struggle (`fall`, `step`): STRUGGLE seconds at the surface, thrashing (the water striders feel the ripples: Prey/Skater). Then the outcome, a seeded draw (a
-- hash of the world's seed, the life's day and the falls counted so far, kept in the rest: restores never reroll) against the chance of getting out:
--   a way out within REACH of where it went in (a stem, a leaf, a stone, a pad, the bank, a post: any box that comes up through the surface or lies on it) gives a
--   chance that falls from NEAR_CHANCE at the stem's foot to FAR_CHANCE at REACH; a LONG fall (from higher than LONG studs over the water, a plunge that takes the
--   spider under) halves it. In the standard rules the spider that does not get out drowns (a death with its own card, UI/WaterText), and a long fall into open
--   water with nothing in reach drowns, honestly. In the gentle rules (Easy, Free play) it is always pulled out: onto the way out in reach, or, with none, washed to
--   the nearest one (within RESCUE) with a notice.
-- `out` signals carry where to put the spider: on the way out's top, or on its side face just over the water.
local WorldMap = require(script.Parent.Parent.World.WorldMap)

local Water = {}
Water.__index = Water

Water.STRUGGLE = 3.0 -- seconds at the surface before the outcome
Water.REACH = 4.0 -- studs from where it went in to a way out it can reach (its legs' span and a short scramble)
Water.NEAR_CHANCE = 0.9
Water.FAR_CHANCE = 0.4
Water.LONG = 20 -- a fall from higher than this over the water is a plunge
Water.RESCUE = 120 -- how far the gentle rules look for a way out
Water.UP = 0.6 -- a way out must stand at least this far over the water to climb onto, or lie on it (a pad)
Water.CAUSE = "drowned"
Water.MOD = 2147483647

export type Box = { lo: Vector3, hi: Vector3, id: string? }
export type Record = { falls: number, out: number }

function Water.new(seed: number): any
	return setmetatable({ seed = seed, gentle = false, falls = 0, out = 0, active = nil :: any, signals = {} :: { any } }, Water)
end

-- The draw for the `n`th fall of the life's `day` (in [0, 1)): the world's seed hashed with the day and the count (World/WorldMap.seed, as a region's).
function Water.draw(seed: number, day: number, n: number): number
	local s = WorldMap.seed(seed, `water:{math.floor(day)}:{math.floor(n)}`)
	return (s - 1) / (Water.MOD - 1)
end

-- The nearest way out of the water from `at` (a point at the surface) among `boxes`: a box that comes up through the surface (its top at least UP over it) or lies on
-- it (a pad), its distance in plan, and where a spider gets onto it (its top if it is low, else its side face just over the water, the side nearest).
function Water.wayOut(at: Vector3, surface: number, boxes: { Box }, limit: number): (Box?, number, Vector3?, Vector3?)
	local best, bd, bp, bn = nil :: Box?, math.huge, nil :: Vector3?, nil :: Vector3?
	for _, b in boxes do
		if b.hi.Y < surface + 0.25 or b.lo.Y > surface + 0.5 then continue end -- (it must reach the surface and stand at or over it)
		local cx, cz = math.clamp(at.X, b.lo.X, b.hi.X), math.clamp(at.Z, b.lo.Z, b.hi.Z)
		local d = Vector3.new(at.X - cx, 0, at.Z - cz).Magnitude
		if d < bd and d <= limit then
			local low = b.hi.Y - surface < 6
			local p: Vector3, n: Vector3
			if low or d < 1e-6 then
				p, n = Vector3.new(math.clamp(at.X, b.lo.X + 0.3, b.hi.X - 0.3), b.hi.Y, math.clamp(at.Z, b.lo.Z + 0.3, b.hi.Z - 0.3)), Vector3.yAxis
			else
				-- the side face nearest, a little over the water
				local dx0, dx1, dz0, dz1 = math.abs(at.X - b.lo.X), math.abs(at.X - b.hi.X), math.abs(at.Z - b.lo.Z), math.abs(at.Z - b.hi.Z)
				local m = math.min(dx0, dx1, dz0, dz1)
				local y = surface + 1.5
				if m == dx0 then p, n = Vector3.new(b.lo.X, y, cz), -Vector3.xAxis
				elseif m == dx1 then p, n = Vector3.new(b.hi.X, y, cz), Vector3.xAxis
				elseif m == dz0 then p, n = Vector3.new(cx, y, b.lo.Z), -Vector3.zAxis
				else p, n = Vector3.new(cx, y, b.hi.Z), Vector3.zAxis end
			end
			best, bd, bp, bn = b, d, p, n
		end
	end
	return best, bd, bp, bn
end

-- The chance of getting out onto a way out `d` studs off after a fall from `drop` studs over the water.
function Water.chance(d: number, drop: number): number
	if d > Water.REACH then return 0 end
	local c = Water.NEAR_CHANCE + (Water.FAR_CHANCE - Water.NEAR_CHANCE) * math.clamp(d / Water.REACH, 0, 1)
	if drop > Water.LONG then c *= 0.5 end
	return c
end

-- The spider went in at `at` (its body at the surface), having fallen from `drop` studs over the water (0 walking in), on the life's `day`; `boxes` the world's boxes
-- near it (its region's and its neighbours'), `surface` the water's level. Decides the outcome now (it is told when the struggle ends).
function Water.fall(self: any, at: Vector3, drop: number, day: number, boxes: { Box }, surface: number)
	if self.active ~= nil then return end
	self.falls += 1
	local draw = Water.draw(self.seed, day, self.falls)
	local box, d, p, n = Water.wayOut(at, surface, boxes, Water.REACH)
	local chance = if box ~= nil then Water.chance(d, drop) else 0
	local outcome: string
	if box ~= nil and draw < chance then outcome = "out"
	elseif self.gentle then
		outcome = "pulled"
		if box == nil then box, d, p, n = Water.wayOut(at, surface, boxes, Water.RESCUE) end
		if box == nil then outcome = "lost" end
	else outcome = "drowned" end
	self.active = { at = Vector3.new(at.X, surface, at.Z), t = 0, outcome = outcome, to = p, normal = n, drop = drop, chance = chance, draw = draw, reach = d }
	table.insert(self.signals, { kind = "fell", at = self.active.at, drop = drop })
end

-- One tick. Ends the struggle with "out" or "pulled" (the place and its normal) or "drowned"; "lost" (gentle, and nothing in RESCUE) is told as "pulled" to the
-- spot it went in from, the client's own safe place.
function Water.step(self: any, dt: number)
	local a = self.active
	if a == nil then return end
	a.t += dt
	if a.t < Water.STRUGGLE then return end
	self.active = nil
	if a.outcome == "out" or a.outcome == "pulled" then self.out += 1 end
	table.insert(self.signals, { kind = a.outcome, at = a.at, to = a.to, normal = a.normal })
end

-- Where the body is held while it struggles: at the surface, bobbing a little.
function Water.heldAt(self: any): Vector3?
	local a = self.active
	if a == nil then return nil end
	return a.at + Vector3.new(0, 0.05 + 0.08 * math.sin(a.t * 9), 0)
end

function Water.struggling(self: any): boolean
	return self.active ~= nil
end

function Water.drainSignals(self: any): { any }
	local out = self.signals
	self.signals = {}
	return out
end

-- The record a rest keeps (Persistence/Checkpoint's optional `water`): the falls counted (the draws' counter) and how many got out.
function Water.defaultRecord(): Record
	return { falls = 0, out = 0 }
end
function Water.toRecord(self: any): Record
	return { falls = self.falls, out = self.out }
end
function Water.problems(d: any): { string }
	local out: { string } = {}
	if type(d) ~= "table" then return { "water: not a record" } end
	for _, k in { "falls", "out" } do
		local x = d[k]
		if type(x) ~= "number" or x ~= x or x < 0 or x > 1e9 or math.floor(x) ~= x then table.insert(out, `water: {k} is not a count`) end
	end
	if #out == 0 and d.out > d.falls then table.insert(out, "water: more got out than fell in") end
	return out
end
function Water.load(self: any, d: Record)
	self.falls, self.out, self.active = d.falls, d.out, nil
	self.signals = {}
end

return Water
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="58">
        <Properties>
          <string name="Name">Movement</string>
        </Properties>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">CameraMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pure camera and stick math, ported from the frozen Godot reference (c87ce00):
--   scripts/movement/boom_math.gd    (orbit basis, boom recovery, eased offsets, pitch pick, smooth damp)
--   scripts/movement/surface_input.gd (camera-relative walking on floors, walls and undersides)
--   scripts/movement/camera_rig.gd   (aim free-look clamp, spider-eye gaze clamp, recenter yaw)
-- Vector3 only, no Instances, so tests/run.luau checks it against values exported from Godot itself.
-- Conventions match Godot and Roblox alike: right-handed, -Z forward, yaw about world up,
-- elevation positive puts the camera above the pivot.

local CameraMath = {}

CameraMath.PIVOT_HEIGHT = 0.45
CameraMath.BOOM_RADIUS = 0.15
CameraMath.DEFAULT_ELEVATION_DEG = 18.0
CameraMath.MIN_ELEVATION_DEG = -20.0
CameraMath.MAX_ELEVATION_DEG = 80.0
CameraMath.MOUSE_DEG_PER_PIXEL = 0.1
CameraMath.STICK_DEG_PER_SECOND = 150.0
CameraMath.RECOVER_SPEED = 6.0
CameraMath.RECENTER_SECONDS = 0.25
CameraMath.BODY_HIDE_LENGTH = 0.8
CameraMath.COMFORT_BOOM = 2.5
CameraMath.AUTO_PITCH_STEP_DEG = 10.0
CameraMath.MIN_AUTO_ELEVATION_DEG = -45.0
CameraMath.AUTO_PITCH_IN_SECONDS = 0.08
CameraMath.AUTO_PITCH_OUT_SECONDS = 0.35
CameraMath.AIM_PITCH_MIN_DEG = -20.0
CameraMath.AIM_PITCH_MAX_DEG = 50.0
CameraMath.AIM_VIEW_LIMIT_DEG = 85.0
CameraMath.AIM_RETURN_SECONDS = 0.25
CameraMath.EYE_FOV_DEG = 80.0
CameraMath.EYE_AHEAD = 0.53
CameraMath.EYE_HEIGHT = 0.09
CameraMath.EYE_PITCH_LIMIT_DEG = 80.0
CameraMath.EYE_ROLL_DEG_S = 240.0
CameraMath.PRINCIPAL_SCAN_DEG = 30.0
CameraMath.EYE_SETTLE_DEG = 4.0
CameraMath.FOV_DEG = 65.0
CameraMath.CAMERA_DISTANCE = 5.0

local SETTLE = 2e-4
local TIE = 1e-3
local FLOOR_BLEND_START = 0.5
local FLOOR_BLEND_END = 0.8660254

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function smoothstep(a: number, b: number, x: number): number
	if a == b then
		return if x < a then 0 else 1
	end
	local t = math.clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end
CameraMath.smoothstep = smoothstep

local function dirOn(v: Vector3, n: Vector3): Vector3
	local t = v - n * v:Dot(n)
	local length = t.Magnitude
	return if length > 1e-6 then t / length else Vector3.new(0, 0, 0)
end

-- BoomMath.next_length: a shorter allowed length is taken at once; growth is rate limited.
function CameraMath.nextLength(current: number, allowed: number, desired: number, recoverSpeed: number, dt: number): number
	if not (finite(current) and finite(allowed) and finite(desired) and finite(recoverSpeed) and finite(dt)) then
		return 0
	end
	local target = math.max(0, math.min(allowed, desired))
	if target <= current then
		return target
	end
	return math.min(current + math.max(recoverSpeed, 0) * math.max(dt, 0), target)
end

-- BoomMath.ease_offset: exponential ease, faster away from zero than back toward it.
function CameraMath.easeOffset(current: number, target: number, dt: number, inSeconds: number, outSeconds: number): number
	if not (finite(current) and finite(target) and finite(dt) and finite(inSeconds) and finite(outSeconds)) then
		return 0
	end
	local seconds = math.max(if math.abs(target) >= math.abs(current) then inSeconds else outSeconds, 1e-4)
	local nextValue = current + (target - current) * (1 - math.exp(-math.max(dt, 0) / seconds))
	return if math.abs(target - nextValue) < SETTLE then target else nextValue
end

-- BoomMath.smooth_damp: a critically damped approach of current to target (arrives without overshoot, gentle at both
-- ends); smoothTime is about the time it takes. Returns the next value and velocity; it lands exactly on the target once
-- within SETTLE and nearly still. Non-finite input returns 0, 0.
function CameraMath.smoothDamp(current: number, target: number, velocity: number, smoothTime: number, dt: number): (number, number)
	if not (finite(current) and finite(target) and finite(velocity) and finite(smoothTime) and finite(dt)) then
		return 0, 0
	end
	local omega = 2 / math.max(smoothTime, 1e-4)
	local x = omega * math.max(dt, 0)
	local damp = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)
	local change = current - target
	local temp = (velocity + omega * change) * dt
	local nextVelocity = (velocity - omega * temp) * damp
	local nextValue = target + (change + temp) * damp
	if (target - current > 0) == (nextValue > target) then
		return target, 0
	end
	if math.abs(target - nextValue) < SETTLE and math.abs(nextVelocity) < 1e-3 then
		return target, 0
	end
	return nextValue, nextVelocity
end

-- BoomMath.pick_pitch_offset: the first comfortable boom, else the longest.
function CameraMath.pickPitchOffset(offsets: { number }, lengths: { number }, comfort: number): number
	if #offsets == 0 or #offsets ~= #lengths or not finite(comfort) then
		return 0
	end
	local best = 1
	for i = 1, #offsets do
		if lengths[i] >= comfort then
			return offsets[i]
		end
		if lengths[i] > lengths[best] + TIE then
			best = i
		end
	end
	return offsets[best]
end

-- BoomMath.back_direction: unit vector from the pivot toward the camera.
function CameraMath.backDirection(yaw: number, elevation: number): Vector3
	local ce = math.cos(elevation)
	return Vector3.new(math.sin(yaw) * ce, math.sin(elevation), math.cos(yaw) * ce)
end

-- The orbit camera's right and up vectors (SurfaceInput.camera_basis x and y columns).
function CameraMath.cameraRight(yaw: number, _elevation: number): Vector3
	return Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
end
function CameraMath.cameraUp(yaw: number, elevation: number): Vector3
	local se = math.sin(elevation)
	return Vector3.new(-se * math.sin(yaw), math.cos(elevation), -se * math.cos(yaw))
end

-- SurfaceInput.tangent_axes: camera-relative right and forward on the plane with normal n.
function CameraMath.tangentAxes(yaw: number, elevation: number, n: Vector3): (Vector3, Vector3)
	local normal = if n.Magnitude > 1e-5 then n.Unit else Vector3.new(0, 1, 0)
	local camRight = CameraMath.cameraRight(yaw, elevation)
	local camUp = CameraMath.cameraUp(yaw, elevation)
	local flatForward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local pf = dirOn(flatForward, normal)
	local pu = dirOn(camUp, normal)
	local w = smoothstep(FLOOR_BLEND_START, FLOOR_BLEND_END, math.abs(normal.Y))
	local forward = pf * w + pu * (1 - w)
	if forward:Dot(forward) < 1e-6 then
		local pr = dirOn(camRight, normal)
		if pr.Magnitude == 0 then
			pr = dirOn(Vector3.new(1, 0, 0), normal)
		end
		forward = normal:Cross(pr)
	end
	forward = dirOn(forward, normal)
	local right = forward:Cross(normal)
	right = if right.Magnitude > 1e-9 then right.Unit else right
	if right:Dot(camRight) < 0 then
		right = -right
	end
	return right, forward
end

-- SurfaceInput.map_stick: x right, y forward, length kept (at most 1).
function CameraMath.mapStick(x: number, y: number, yaw: number, elevation: number, n: Vector3): Vector3
	local length = math.sqrt(x * x + y * y)
	if not finite(length) or length < 1e-6 then
		return Vector3.new(0, 0, 0)
	end
	if length > 1 then
		x, y = x / length, y / length
	end
	local right, forward = CameraMath.tangentAxes(yaw, elevation, n)
	return right * x + forward * y
end

-- Spider-eye walking: forward is the gaze laid on the surface, right is its right on it.
function CameraMath.mapStickEye(x: number, y: number, gaze: Vector3, bodyForward: Vector3, n: Vector3): Vector3
	local length = math.sqrt(x * x + y * y)
	if not finite(length) or length < 1e-6 then
		return Vector3.new(0, 0, 0)
	end
	if length > 1 then
		x, y = x / length, y / length
	end
	local forward = gaze - n * gaze:Dot(n)
	if forward:Dot(forward) < 1e-6 then
		forward = bodyForward - n * bodyForward:Dot(n)
	end
	if forward:Dot(forward) < 1e-6 then
		return Vector3.new(0, 0, 0)
	end
	forward = forward.Unit
	local right = forward:Cross(n).Unit
	return right * x + forward * y
end

-- camera_rig._clamp_aim_pitch: the aim free-look range, and the whole view short of straight up or down.
function CameraMath.clampAimPitch(value: number, elevation: number): number
	local limit = math.rad(CameraMath.AIM_VIEW_LIMIT_DEG)
	local low = math.max(math.rad(CameraMath.AIM_PITCH_MIN_DEG), elevation - limit)
	local high = math.min(math.rad(CameraMath.AIM_PITCH_MAX_DEG), elevation + limit)
	return math.clamp(value, low, math.max(low, high))
end

-- camera_rig._effective_elevation: the player's pitch plus the auto-pitch, inside the automatic range.
function CameraMath.effectiveElevation(elevation: number, offset: number): number
	local low = math.min(elevation, math.rad(CameraMath.MIN_AUTO_ELEVATION_DEG))
	local high = math.max(elevation, math.rad(CameraMath.MAX_ELEVATION_DEG))
	return math.clamp(elevation + offset, low, high)
end

-- The yaw whose flat forward (-sin, 0, -cos) points along v.
function CameraMath.yawOf(v: Vector3): number
	return math.atan2(-v.X, -v.Z)
end

-- SpiderMotor.get_recenter_yaw: behind the heading on floors and undersides, toward the surface on walls.
function CameraMath.recenterYaw(heading: Vector3, visualUp: Vector3, fallback: number): number
	local w = visualUp.Y * visualUp.Y
	local v = Vector3.new(heading.X, 0, heading.Z) * w + Vector3.new(-visualUp.X, 0, -visualUp.Z) * (1 - w)
	if v.Magnitude < 1e-3 then
		return fallback
	end
	return math.atan2(-v.X, -v.Z)
end

local function anyPerpendicular(v: Vector3): Vector3
	local other = if math.abs(v.Y) < 0.9 then Vector3.new(0, 1, 0) else Vector3.new(1, 0, 0)
	return v:Cross(other).Unit
end

-- camera_rig._clamp_gaze: unit, and at least EYE_PITCH_LIMIT_DEG from the surface normal either way.
function CameraMath.clampGaze(g: Vector3, up: Vector3, bodyForward: Vector3): Vector3
	if not (finite(g.X) and finite(g.Y) and finite(g.Z)) or g:Dot(g) < 1e-10 then
		g = bodyForward
	end
	g = g.Unit
	local tangent = g - up * g:Dot(up)
	if tangent:Dot(tangent) < 1e-8 then
		tangent = bodyForward - up * bodyForward:Dot(up)
		if tangent:Dot(tangent) < 1e-8 then
			tangent = anyPerpendicular(up)
		end
	end
	tangent = tangent.Unit
	local limit = math.rad(CameraMath.EYE_PITCH_LIMIT_DEG)
	local elev = math.clamp(math.asin(math.clamp(g:Dot(up), -1, 1)), -limit, limit)
	return (tangent * math.cos(elev) + up * math.sin(elev)).Unit
end

-- Rodrigues rotation of v about unit axis k by angle a (right-handed).
function CameraMath.rotate(v: Vector3, k: Vector3, a: number): Vector3
	local c, s = math.cos(a), math.sin(a)
	return v * c + k:Cross(v) * s + k * (k:Dot(v) * (1 - c))
end

-- camera_rig._look_eye: yaw about the view's up (positive looks right), pitch about the view's right (positive looks down). Normally
-- that up is the body's (`up`); with the level-horizon comfort switch (ROBLOX-49) the camera's own up (`turnUp`, from viewUp) is used
-- instead, so the mouse and stick move the picture the way they look on screen. The gaze stays clamped against the body's up either way.
function CameraMath.lookEye(gaze: Vector3, up: Vector3, yawRad: number, pitchRad: number, bodyForward: Vector3, turnUp: Vector3?): Vector3
	local turn = turnUp or up
	local g = CameraMath.rotate(gaze, turn, -yawRad)
	local right = g:Cross(turn)
	if right:Dot(right) > 1e-10 then
		g = CameraMath.rotate(g, right.Unit, -pitchRad)
	end
	return CameraMath.clampGaze(g, up, bodyForward)
end

-- camera_rig.view_up, the level-horizon comfort switch (T13a, ROBLOX-49): the spider-eye picture's up for the gaze `gaze` is the world's up
-- laid square to the gaze, so the picture never rolls on a wall or an underside. Looking nearly straight up or down, where the world's up
-- says little about roll, it holds `held` (the up it last had; falling back to the body's up, then any perpendicular). Returns a unit vector
-- square to `gaze`. Without the switch the caller uses the body's up and keeps it as `held`.
local LEVEL_FROM, LEVEL_TO = 0.1, 0.35 -- how much of the world's up shows in the gaze's square (length) before it takes over, and fully does
function CameraMath.viewUp(gaze: Vector3, bodyUp: Vector3, held: Vector3): Vector3
	local g = gaze
	local world = Vector3.new(0, 1, 0) - g * g:Dot(Vector3.new(0, 1, 0))
	local keep = held - g * g:Dot(held)
	if keep:Dot(keep) < 1e-6 then keep = bodyUp - g * g:Dot(bodyUp) end
	if keep:Dot(keep) < 1e-6 then keep = anyPerpendicular(g) end
	local w = smoothstep(LEVEL_FROM, LEVEL_TO, world.Magnitude)
	local v = (if w > 0 then world.Unit * w else Vector3.zero) + keep.Unit * (1 - w)
	if v:Dot(v) < 1e-6 then v = keep end
	return v.Unit
end

return CameraMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">FocusState</string>
            <string name="Source"><![CDATA[--!strict
-- D-041: toggle is optional, grounded only, and Cancel belongs to other actions first.
local Focus = {}
Focus.__index = Focus
function Focus.new(): any return setmetatable({latched=false}, Focus) end
function Focus.press(self: any, toggle: boolean, grounded: boolean)
	if toggle and grounded then self.latched = not self.latched end
end
function Focus.active(self: any, held: boolean, toggle: boolean, grounded: boolean): boolean
	if not grounded or not toggle then self.latched = false end
	return grounded and (if toggle then self.latched else held)
end
function Focus.cancel(self: any, busy: boolean)
	if not busy then self.latched = false end
end
function Focus.clear(self: any) self.latched = false end
return Focus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">InputState</string>
            <string name="Source"><![CDATA[--!strict
-- Pure input state: test without Studio. +Y is forward on the control pad; look +X is right, +Y is down
-- (the Godot camera rig's convention: look(dx, dy) with dy > 0 looking down).
-- A button action can be held by several sources at once: a key, a controller button, a finger on a touch button. It is
-- held while any of them is down, so keyboard, controller and touch work together and releasing one never cancels another
-- (ROBLOX-08). set() returns the held state before and after, so callers act once per press and once per release.
local InputState = {}
InputState.__index = InputState

local MOVE_DEAD = 0.2
local LOOK_DEAD = 0.15

export type InputState = typeof(setmetatable({} :: {
	held: { [string]: boolean? },
	sources: { [string]: { [any]: boolean } },
	x: number,
	y: number,
	lx: number,
	ly: number,
}, InputState))

function InputState.new(): InputState
	return setmetatable({ held = {}, sources = {}, x = 0, y = 0, lx = 0, ly = 0 }, InputState)
end

-- One source's state of an action (source nil: a single default source). Returns (held before, held now).
function InputState.set(self: InputState, action: string, down: boolean, source: any?): (boolean, boolean)
	local key: any = if source == nil then "default" else source
	local was = self.held[action] == true
	local set = self.sources[action]
	if down then
		if not set then
			set = {}
			self.sources[action] = set
		end
		set[key] = true
	elseif set then
		set[key] = nil
	end
	local now = set ~= nil and next(set) ~= nil
	self.held[action] = if now then true else nil
	return was, now
end

-- How many sources hold the action now.
function InputState.count(self: InputState, action: string): number
	local n = 0
	local set: { [any]: boolean } = self.sources[action] or {}
	for _ in set do
		n += 1
	end
	return n
end

local function radial(x: number, y: number, dead: number): (number, number)
	local length = math.sqrt(x * x + y * y)
	local strength = math.clamp((length - dead) / (1 - dead), 0, 1)
	if length <= 0 then return 0, 0 end
	return x / length * strength, y / length * strength
end
function InputState.stick(self: InputState, x: number, y: number)
	self.x, self.y = radial(x, y, MOVE_DEAD)
end
-- Right stick: Roblox reports +Y up; store it as look-down positive.
function InputState.look(self: InputState, x: number, y: number)
	local rx, ry = radial(x, y, LOOK_DEAD)
	self.lx, self.ly = rx, -ry
end
function InputState.axes(self: InputState): (number, number)
	local x = self.x + (if self.held.Right then 1 else 0) - (if self.held.Left then 1 else 0)
	local y = self.y + (if self.held.Forward then 1 else 0) - (if self.held.Back then 1 else 0)
	local length = math.max(1, math.sqrt(x * x + y * y))
	return x / length, y / length
end
-- Look rate in -1..1 per axis: right stick plus arrow keys.
function InputState.lookAxes(self: InputState, aiming: boolean?): (number, number)
	local x = self.lx + (if aiming then self.x else 0) + (if self.held.LookRight then 1 else 0) - (if self.held.LookLeft then 1 else 0)
	local y = self.ly - (if aiming then self.y else 0) + (if self.held.LookDown then 1 else 0) - (if self.held.LookUp then 1 else 0)
	return math.clamp(x, -1, 1), math.clamp(y, -1, 1)
end
-- Focus loss, the Roblox menu, a text box, a lost controller: nothing stays held.
function InputState.clear(self: InputState)
	table.clear(self.held)
	table.clear(self.sources)
	self.x, self.y, self.lx, self.ly = 0, 0, 0, 0
end
return InputState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">InspectView</string>
            <string name="Source"><![CDATA[--!strict
-- Inspect mode's view, as numbers (ROBLOX-90): an orbit of the spider by yaw, elevation and distance in body-lengths, the auto-orbit when the player is
-- idle, the zoom (wheel, stick, pinch), the three preset framings and the 0.8 s ease. Pure, so tests/inspect.luau checks the numbers without Roblox; Client/SpiderCamera turns a
-- state into a camera (it adds the spider's position, up, heading and drawn length, and casts the boom against the sill).
--
-- Yaw is measured round the spider's own up, from its forward direction: 0 is the camera in front of the spider (the face), 90 on its right,
-- 180 behind it, 270 on its left. A look to the right (dx > 0) moves the camera toward the spider's right, as the game's own orbit does,
-- and a look down (dy > 0) lifts it, so the inversion settings mean what they always have.
local InspectView = {}

InspectView.HOLD_SECONDS = 0.6 -- holding the choose key or button this long (while resting awake in the crack) starts the view
InspectView.EASE_SECONDS = 0.8 -- into the view, and back out of it (the mating two-shot's own)
InspectView.DISTANCE = 1.6 -- body-lengths from the spider where the view begins
InspectView.ELEVATION_DEG = 20 -- ... and how far above the surface's plane ("slightly above")
InspectView.AUTO_DEG_S = 10 -- the slow orbit, when the player is idle
InspectView.AUTO_AFTER_SECONDS = 3 -- ... which is to say, once this long has gone by without a turn or a zoom (a new view counts as idle, so it begins at once)
InspectView.ZOOM_MIN, InspectView.ZOOM_MAX = 1.1, 3.0 -- body-lengths
InspectView.ZOOM_PER_SECOND = 1.0 -- body-lengths a second at a full push of the left stick (or W and S)
InspectView.WHEEL_STEP = 0.88 -- one notch of the wheel is this share of the distance (the third-person camera's own)
InspectView.ELEVATION_MIN_DEG, InspectView.ELEVATION_MAX_DEG = 4, 88
InspectView.PRESET_EASE_SECONDS = 0.35 -- a preset framing is reached in about this long (an exponential approach, 95 percent of the way)

-- The three preset framings, in the order the button cycles them: the face (in front, a little above, close, on the head), the side (on the
-- right, low, the whole body) and from above (the top of the body, the head up the screen). `ahead` is how far in front of the body's middle the
-- focus is, in body-lengths; every distance is within the zoom's range.
InspectView.PRESETS = {
	{ id = "face", yawDeg = 0, elevDeg = 10, distance = 1.25, ahead = 0.3 },
	{ id = "side", yawDeg = 90, elevDeg = 6, distance = 1.8, ahead = 0 },
	{ id = "top", yawDeg = 180, elevDeg = 84, distance = 2.0, ahead = 0 },
} :: { { id: string, yawDeg: number, elevDeg: number, distance: number, ahead: number } }

export type Goal = { yaw: number, elev: number, dist: number, ahead: number }
export type State = {
	yaw: number, elev: number, dist: number, ahead: number, -- degrees, degrees, body-lengths, body-lengths
	auto: boolean, -- the slow orbit may run (a framing held still, or the player's own view, switches it off until the player turns the view)
	idle: number, -- seconds since the player last turned, zoomed or pinched the view (the auto-orbit runs once this is AUTO_AFTER_SECONDS)
	preset: number, -- 0 or the index of the preset last chosen
	goal: Goal?, -- a preset still being reached
}

local function wrap(deg: number): number
	return (deg + 180) % 360 - 180
end

-- A view at this yaw: 1.6 body-lengths away, 20 degrees up, orbiting slowly (nobody has touched it yet).
function InspectView.new(yawDeg: number): State
	return { yaw = wrap(yawDeg), elev = InspectView.ELEVATION_DEG, dist = InspectView.DISTANCE, ahead = 0, auto = true, idle = InspectView.AUTO_AFTER_SECONDS, preset = 0, goal = nil }
end

-- The yaw (degrees) of a camera at `offset` from the focus, for a spider whose forward and right are given (any length, in its plane).
function InspectView.yawOf(offset: Vector3, forward: Vector3, right: Vector3): number
	return math.deg(math.atan2(offset:Dot(right), offset:Dot(forward)))
end

-- The player's own turn of the view, in degrees (dx right, dy down): the auto-orbit waits AUTO_AFTER_SECONDS after the last of it (and is allowed again if a framing
-- had stopped it), and a preset on its way is cancelled.
function InspectView.orbit(s: State, dxDeg: number, dyDeg: number)
	if dxDeg == 0 and dyDeg == 0 then return end
	s.auto, s.idle, s.goal = true, 0, nil
	s.yaw = wrap(s.yaw + dxDeg)
	s.elev = math.clamp(s.elev + dyDeg, InspectView.ELEVATION_MIN_DEG, InspectView.ELEVATION_MAX_DEG)
end

local function clampZoom(d: number): number
	return math.clamp(d, InspectView.ZOOM_MIN, InspectView.ZOOM_MAX)
end

-- A step of the distance in body-lengths (negative: closer). The player is not idle while zooming, so the auto-orbit waits, but a framing's hold is not lifted.
function InspectView.zoomBy(s: State, delta: number)
	if delta == 0 then return end
	s.goal, s.idle = nil, 0
	s.dist = clampZoom(s.dist + delta)
end

-- One notch of the wheel: `up` is a wheel turned away from the player (closer).
function InspectView.wheel(s: State, up: boolean)
	s.goal, s.idle = nil, 0
	s.dist = clampZoom(s.dist * (if up then InspectView.WHEEL_STEP else 1 / InspectView.WHEEL_STEP))
end

-- A pinch on a touch screen: `ratio` is how much further apart the two fingers are than a moment ago (above 1: spread, so closer; below 1: pinched, so further).
function InspectView.pinch(s: State, ratio: number)
	if not (ratio > 0) or ratio == math.huge or ratio == 1 then return end
	s.goal, s.idle = nil, 0
	s.dist = clampZoom(s.dist / ratio)
end

-- The button: the next preset framing (face, side, top, face ...). The auto-orbit stops (a framing is held still until the player turns the view), and the view goes there. Returns its id.
function InspectView.cycle(s: State): string
	s.preset = s.preset % #InspectView.PRESETS + 1
	local p = InspectView.PRESETS[s.preset]
	s.auto, s.idle = false, 0
	s.goal = { yaw = p.yawDeg, elev = p.elevDeg, dist = p.distance, ahead = p.ahead }
	return p.id
end

function InspectView.presetId(s: State): string?
	local p = InspectView.PRESETS[s.preset]
	return if p then p.id else nil
end

-- One frame: the auto-orbit, or a preset being reached. Reduced motion: no auto-orbit, and a preset is a cut.
function InspectView.step(s: State, dt: number, reduced: boolean)
	local g = s.goal
	if g ~= nil then
		if reduced then
			s.yaw, s.elev, s.dist, s.ahead, s.goal = wrap(g.yaw), g.elev, g.dist, g.ahead, nil
			return
		end
		-- 95 percent of the way in PRESET_EASE_SECONDS: exp(-k * seconds) = 0.05
		local k = 1 - math.exp(-3 * math.max(dt, 0) / InspectView.PRESET_EASE_SECONDS)
		local dyaw = wrap(g.yaw - s.yaw)
		s.yaw = wrap(s.yaw + dyaw * k)
		s.elev += (g.elev - s.elev) * k
		s.dist += (g.dist - s.dist) * k
		s.ahead += (g.ahead - s.ahead) * k
		if math.abs(dyaw) < 0.05 and math.abs(g.elev - s.elev) < 0.05 and math.abs(g.dist - s.dist) < 0.002 and math.abs(g.ahead - s.ahead) < 0.002 then
			s.yaw, s.elev, s.dist, s.ahead, s.goal = wrap(g.yaw), g.elev, g.dist, g.ahead, nil
		end
	elseif s.auto and not reduced then
		s.idle += math.max(dt, 0)
		if s.idle >= InspectView.AUTO_AFTER_SECONDS then
			s.yaw = wrap(s.yaw + InspectView.AUTO_DEG_S * math.max(dt, 0))
		end
	end
end

-- The unit vector from the focus to the camera, for the spider's forward, right and up (unit vectors; right = forward x up).
function InspectView.direction(s: State, forward: Vector3, right: Vector3, up: Vector3): Vector3
	local yaw, elev = math.rad(s.yaw), math.rad(s.elev)
	return (forward * math.cos(yaw) * math.cos(elev) + right * math.sin(yaw) * math.cos(elev) + up * math.sin(elev)).Unit
end

-- The ease between the player's own camera and this view, 0 to 1: it moves toward 1 while the view is wanted and toward 0 when it is not,
-- in EASE_SECONDS (0.8 s) from end to end. Reduced motion is a cut.
function InspectView.ease(t: number, dt: number, wanted: boolean, reduced: boolean): number
	if reduced then return if wanted then 1 else 0 end
	local step = math.max(dt, 0) / InspectView.EASE_SECONDS
	local want = if wanted then 1 else 0
	return math.clamp(t + math.clamp(want - t, -step, step), 0, 1)
end

function InspectView.smooth(k: number): number
	return k * k * (3 - 2 * k)
end

return InspectView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">JumpInput</string>
            <string name="Source"><![CDATA[--!strict
-- Jump input: a port of the frozen Godot scripts/movement/jump_controller.gd (c87ce00, hold mode). Pure: the motor is passed
-- in, so tests/run.luau checks the same rules without Roblox.
--
-- A tap of the jump button (Space, A, touch Jump) is a short hop forward. Holding it for HOLD_TICKS (0.15 s) starts aiming:
-- the spider holds still and the landing patch shows the plan for whatever the screen centre is on. Releasing commits the
-- plan the patch shows when it is reachable; on anything else nothing is launched and the reason flashes for FLASH_TICKS.
-- Cancel (Q, B, touch Cancel) leaves a press or an aim with no penalty. drop() is focus loss or the Roblox menu: an aim in
-- progress ends quietly, so a button released while away can never leap later (Godot's _drop_input). Events are queued and
-- applied at the start of the next fixed tick, so timing is counted in ticks and does not depend on the frame rate.
-- `last` records the latest outcome for the HUD and tests: launched, cancelled, refused or hop_refused.
local JumpInput = {}
JumpInput.__index = JumpInput

JumpInput.HOLD_TICKS = 9 -- math.max(1, math.ceil(0.15 * 60 - 1e-6)), as jump_controller._hold_ticks()
JumpInput.FLASH_TICKS = 60

export type Phase = "idle" | "pressed" | "aiming"

function JumpInput.new()
	return setmetatable({
		phase = "idle" :: Phase,
		heldTicks = 0,
		events = {} :: { string },
		plan = nil :: any,
		flash = nil :: any,
		flashLeft = 0,
		last = nil :: any,
		tick = 0,
		onAim = nil :: ((boolean) -> ())?,
	}, JumpInput)
end

function JumpInput.press(self: any) table.insert(self.events, "press") end
function JumpInput.release(self: any) table.insert(self.events, "release") end
function JumpInput.cancel(self: any) table.insert(self.events, "cancel") end

-- Focus loss or the menu: forget queued presses and end an aim with no message (applied at once).
function JumpInput.drop(self: any, motor: any)
	table.clear(self.events)
	if self.phase == "aiming" then
		if motor then motor:cancelPrepare() end
		self:_endAim(motor)
	end
	self.phase = "idle"
	self.heldTicks = 0
end

function JumpInput.isAiming(self: any): boolean return self.phase == "aiming" end
-- True while a press or an aim is in progress: the cancel button belongs to it then.
function JumpInput.isBusy(self: any): boolean return self.phase ~= "idle" end

function JumpInput._record(self: any, kind: string, plan: any)
	self.last = { kind = kind, plan = plan, tick = self.tick }
end

function JumpInput._flash(self: any, plan: any)
	if plan ~= nil and plan.kind ~= "none" then
		self.flash = plan
		self.flashLeft = JumpInput.FLASH_TICKS
	end
end

function JumpInput._setAiming(self: any, on: boolean)
	local f = self.onAim
	if f then f(on) end
end

function JumpInput._endAim(self: any, motor: any)
	self.phase = "idle"
	self.heldTicks = 0
	self.plan = nil
	if motor then motor:clearAimTarget() end
	self:_setAiming(false)
end

function JumpInput._beginAim(self: any, motor: any)
	if not motor:beginPrepare() then
		self.phase = "idle"
		return
	end
	self.phase = "aiming"
	self.plan = nil
	self:_setAiming(true)
	self.plan = motor:aimPlan()
end

-- Commit the plan the patch is showing; anything not reachable is refused, with its reason, and launches nothing.
function JumpInput._confirm(self: any, motor: any)
	local shown = self.plan or motor:aimPlan() -- exactly what the patch showed at the last tick
	if shown ~= nil and shown.kind == "reachable" and motor:commit(shown) then
		self:_endAim(motor)
		self:_record("launched", shown)
		return
	end
	self:_flash(shown)
	motor:cancelPrepare()
	self:_endAim(motor)
	self:_record("refused", shown)
end

function JumpInput._hop(self: any, motor: any)
	local hop = motor:hopPlan()
	if hop ~= nil and hop.kind == "reachable" and motor:beginPrepare() then
		if motor:commit(hop) then
			self:_record("launched", hop)
			return
		end
		motor:cancelPrepare()
	end
	self:_flash(hop)
	self:_record("hop_refused", hop)
end

-- One fixed tick: apply the queued events, then count the hold and keep the aim's plan current.
function JumpInput.step(self: any, motor: any)
	self.tick += 1
	local queued = self.events
	self.events = {}
	for _, e in queued do
		if e == "press" then
			if self.phase == "idle" and motor:canPrepare() then
				self.phase = "pressed"
				self.heldTicks = 0
			end
		elseif e == "release" then
			if self.phase == "pressed" then
				self.phase = "idle"
				self:_hop(motor)
			elseif self.phase == "aiming" then
				self:_confirm(motor)
			end
		elseif e == "cancel" then
			if self.phase == "pressed" then
				self.phase = "idle"
				self:_record("cancelled", nil)
			elseif self.phase == "aiming" then
				motor:cancelPrepare()
				self:_endAim(motor)
				self:_record("cancelled", nil)
			end
		end
	end
	if self.flashLeft > 0 then
		self.flashLeft -= 1
		if self.flashLeft == 0 then self.flash = nil end
	end
	if self.phase == "pressed" then
		if not motor:canPrepare() then
			self.phase = "idle"
		else
			self.heldTicks += 1
			if self.heldTicks >= JumpInput.HOLD_TICKS then self:_beginAim(motor) end
		end
	end
	if self.phase == "aiming" then
		if motor:isPreparing() then
			self.plan = motor:aimPlan()
		else
			self:_endAim(motor) -- the spider lost its support, or was put somewhere else
		end
	end
end

return JumpInput
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">JumpMath</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/movement/jump_math.gd (spec 6.3, 27). Pure math, no Instances, so it runs in tests/run.luau too.
--
-- The motor flies a committed jump with semi-implicit Euler at a fixed 60 Hz tick:
--   v = v + g * dt, then p = p + v * dt.
-- After n ticks from launch velocity v0 at p0 that gives, exactly,
--   p_n = p0 + n * dt * v0 + g * dt^2 * n * (n + 1) / 2
-- so the launch velocity is solved in this discrete form, not with the continuous 0.5 * g * T^2.

local JumpMath = {}

-- Matches SurfaceProfile.STAND_MAX_DEG.
JumpMath.STAND_MAX_DEG = 45.0
JumpMath.MIN_LAUNCH_NORMAL_SPEED = 0.05
JumpMath.STAND_APPROACH_MIN = 0.05
JumpMath.LAND_APPROACH_MIN = 0.3

local UP = Vector3.new(0, 1, 0)

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function finiteVec(v: Vector3): boolean
	return finite(v.X) and finite(v.Y) and finite(v.Z)
end

export type Solution = {
	steps: number,
	duration: number,
	velocity: Vector3,
	speed: number,
	arrivalVelocity: Vector3,
	approach: number,
}

export type SolveResult = {
	valid: { Solution },
	reason: string, -- "ok", "no_durations", "too_far", "no_launch", "no_arrival"
	minSpeed: number,
}

-- Tick counts n whose duration n * dt lies inside [tMin, tMax]. nMax < nMin when none fits.
function JumpMath.stepRange(tMin: number, tMax: number, dt: number): (number, number)
	if not (finite(tMin) and finite(tMax) and finite(dt)) or dt <= 0 then
		return 1, 0
	end
	local nMin = math.ceil(tMin / dt - 1e-6)
	local nMax = math.floor(tMax / dt + 1e-6)
	return math.max(nMin, 1), nMax
end

function JumpMath.positionAfter(p0: Vector3, v0: Vector3, g: Vector3, dt: number, n: number): Vector3
	return p0 + v0 * (n * dt) + g * (dt * dt * n * (n + 1) * 0.5)
end

function JumpMath.velocityAfter(v0: Vector3, g: Vector3, dt: number, n: number): Vector3
	return v0 + g * (dt * n)
end

function JumpMath.launchVelocity(p0: Vector3, seat: Vector3, g: Vector3, dt: number, n: number): Vector3
	return (seat - p0 - g * (dt * dt * n * (n + 1) * 0.5)) / (n * dt)
end

-- Body-centre positions p_0 .. p_steps by repeated ticks, in the order the motor does them.
function JumpMath.path(p0: Vector3, v0: Vector3, g: Vector3, dt: number, steps: number): { Vector3 }
	local out = { p0 }
	local v, p = v0, p0
	for _ = 1, steps do
		v += g * dt
		p += v * dt
		table.insert(out, p)
	end
	return out
end

function JumpMath.isStanding(normal: Vector3): boolean
	if not finiteVec(normal) or normal:Dot(normal) < 1e-10 then
		return false
	end
	return normal.Unit:Dot(UP) >= math.cos(math.rad(JumpMath.STAND_MAX_DEG)) - 1e-6
end

function JumpMath.minApproach(targetNormal: Vector3): number
	return if JumpMath.isStanding(targetNormal) then JumpMath.STAND_APPROACH_MIN else JumpMath.LAND_APPROACH_MIN
end

-- Every launch solution for a landing seat, one per allowed whole-tick duration, filtered by the launch speed limit,
-- by leaving the launch surface and by arriving into the target fast enough. Sorted by speed, lowest first.
function JumpMath.solve(
	p0: Vector3,
	seat: Vector3,
	launchNormal: Vector3,
	targetNormal: Vector3,
	g: Vector3,
	dt: number,
	tMin: number,
	tMax: number,
	maxSpeed: number
): SolveResult
	local valid: { Solution } = {}
	local nMin, nMax = JumpMath.stepRange(tMin, tMax, dt)
	local minSpeed = math.huge
	local anySpeedOk, anyLaunchOk = false, false
	local need = JumpMath.minApproach(targetNormal)
	for n = nMin, nMax do
		local v0 = JumpMath.launchVelocity(p0, seat, g, dt, n)
		if finiteVec(v0) then
			local speed = v0.Magnitude
			minSpeed = math.min(minSpeed, speed)
			if speed <= maxSpeed then
				anySpeedOk = true
				if v0:Dot(launchNormal) >= JumpMath.MIN_LAUNCH_NORMAL_SPEED then
					anyLaunchOk = true
					local arrival = JumpMath.velocityAfter(v0, g, dt, n)
					local approach = -arrival:Dot(targetNormal)
					if approach >= need then
						table.insert(valid, {
							steps = n,
							duration = n * dt,
							velocity = v0,
							speed = speed,
							arrivalVelocity = arrival,
							approach = approach,
						})
					end
				end
			end
		end
	end
	table.sort(valid, function(a: Solution, b: Solution): boolean
		if math.abs(a.speed - b.speed) > 1e-9 then
			return a.speed < b.speed
		end
		return a.steps < b.steps
	end)
	local reason = "ok"
	if #valid == 0 then
		if nMax < nMin then
			reason = "no_durations"
		elseif not anySpeedOk then
			reason = "too_far"
		elseif not anyLaunchOk then
			reason = "no_launch"
		else
			reason = "no_arrival"
		end
	end
	return { valid = valid, reason = reason, minSpeed = minSpeed }
end

return JumpMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">LineFraming</string>
            <string name="Source"><![CDATA[--!strict
-- The camera's line framing at a catch: a port of the frozen Godot camera_rig.gd (c87ce00; A-017, chunk 6A, capped in 6B).
-- While the spider hangs on its line and the player's own view has no room where the spider will hang (the line's rest
-- point, so the view does not chase the swing), the view turns by the smallest turn, in 15-degree steps either way, that
-- gives a comfortable boom with a clear sight of the spider and of the lip the line leaves its support at. The turn is
-- added to the player's yaw (the view yaw); the player's own yaw is untouched. It never exceeds 45 degrees
-- (FRAMING_MAX_TURN_DEG), eases in over about 0.12 s, never rolls the view, and is cast like any other boom.
-- The player always wins: any look input, a recenter or aiming takes the turn over at once (it becomes the player's own
-- yaw, so nothing moves on screen) and the framing stays off until the line ends. When the line ends the view stays where
-- the framing left it. Pure: the world queries are behind `good(turn)`, so tests check the decisions against values
-- exported from Godot (tests/framing_reference.json) and Studio checks the geometry (tests/studio/CameraSpec.luau).
local CameraMath = require(script.Parent.CameraMath)

local LineFraming = {}
LineFraming.__index = LineFraming

LineFraming.ASSIST_STEP_DEG = 15.0
LineFraming.FRAMING_MAX_TURN_DEG = 45.0 -- Chet's cap (chunk 6B): was a half turn in 6A
LineFraming.ASSIST_SMOOTH_SECONDS = 0.12
LineFraming.SIGHT_TOLERANCE = 0.06 -- a ray that stops this short of its end still saw it

function LineFraming.new(): any
	return setmetatable({
		assist = 0, -- the turn added to the player's yaw now, radians
		prev = 0,
		target = 0, -- the turn wanted at the last tick
		velocity = 0,
		off = false, -- the player turned the view since the line caught: no framing until it ends
		enabled = true, -- Godot's setting "Frame the line after a catch" (default on)
		maxTurn = math.rad(LineFraming.FRAMING_MAX_TURN_DEG),
	}, LineFraming)
end

local SIDES = { 1, -1 } -- (+ before -; ROBLOX-113: one list, not a new one for every step of every search)

-- camera_rig._wanted_yaw_assist: the turn already held while it still works (so the view does not flip as the rest point
-- moves), else none when the player's own view works, else the smallest working step within the cap (+ before -),
-- else none (nowhere works: the view is left to the pitch search).
function LineFraming.wantedTurn(held: number, maxTurn: number, good: (number) -> boolean): number
	if held ~= 0 and good(held) then return held end
	if good(0) then return 0 end
	local step = math.rad(LineFraming.ASSIST_STEP_DEG)
	local k = 1
	while k * step <= maxTurn + 1e-6 do
		for _, side in SIDES do
			local turn = k * step * side
			if good(turn) then return turn end
		end
		k += 1
	end
	return 0
end

-- The player takes the view: returns the turn to add to the player's own yaw, so nothing moves on screen.
function LineFraming.takeOver(self: any): number
	if self.assist == 0 and self.prev == 0 and self.target == 0 then return 0 end
	local delta = self.assist
	self.assist, self.prev, self.target, self.velocity = 0, 0, 0, 0
	return delta
end

-- A look or a recenter: the turn is taken over and, on the line, the framing stays off until the line ends.
function LineFraming.playerTurns(self: any, onLine: boolean): number
	local delta = self:takeOver()
	if onLine then self.off = true end
	return delta
end

-- One fixed tick (camera_rig._update_assist). Returns a change for the player's yaw: the held turn when the line has just
-- ended (the view stays where it is), otherwise 0.
function LineFraming.tick(self: any, onLine: boolean, aiming: boolean, wanted: () -> number, dt: number): number
	self.prev = self.assist
	if not onLine then
		self.off = false
		return self:takeOver()
	end
	local w = 0
	if self.enabled and not self.off and not aiming then w = wanted() end
	self.target = w
	self.assist, self.velocity = CameraMath.smoothDamp(self.assist, w, self.velocity, LineFraming.ASSIST_SMOOTH_SECONDS, dt)
	return 0
end

-- The setting: switched off while a turn is held, the view stays where it is (the turn becomes the player's).
function LineFraming.setEnabled(self: any, on: boolean): number
	self.enabled = on
	return if on then 0 else self:takeOver()
end

-- A snap (spawn, reset, leaving the eye view): no turn at all.
function LineFraming.reset(self: any)
	self.assist, self.prev, self.target, self.velocity, self.off = 0, 0, 0, 0, false
end

return LineFraming
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">LockOn</string>
            <string name="Source"><![CDATA[--!strict
-- Lock-on and the sidestep (ROBLOX-110). Nathan: "a lock on so you can track prey without the visual cues and the ability to side step".
-- A jumping spider turns its body to keep a prey in its principal eyes and sidles round it, stalking; this is that, for the player.
--
-- What can be locked is only what the spider's own perception has: a contact in its memory (Perception/ObservationMemory) that an inspection
-- has placed (hasPosition), live, or lost with its last-seen mark still good. Never the world's own list of things, so nothing hidden, never
-- seen or only cued (a bearing without a place) can be locked. Which one a press takes: the one in the principal eyes now nearest the middle of
-- the view (what the spider is looking at), else the nearest placed contact within `range` in front of the spider (within `frontDeg` of its
-- facing). Anything the spider sees can be locked (the rival, the mate, the wasp, a fly): a lock is attention, not a promise of a meal.
--
-- A lock ends on a second press, on Cancel (when Cancel has nothing else to do), when the memory forgets the contact (sight lost for the
-- memory's decay time, `memory_decay_s`, 6 s; the remembered spot looked at and found empty; the prey caught and eaten) or when the place it is
-- believed to be is beyond `releaseRange`. While it holds, the place it follows is the contact's: where it is being seen, or where it was last
-- seen once sight is lost (the mark never moves), so the lock never knows more than the spider does.
--
-- The sidestep: while locked, the left and right of the stick (A, D, the touch arrows) walk the spider round the locked thing at the distance it
-- had when the stick's forward and back were last let go, and forward and back close or open that distance; it walks at the motor's own creep
-- (salticids stalk slowly) and the motor keeps its body faced to the thing (SpiderMotor's `face`). The direction is worked out on the plane
-- the spider stands on, from its own up, so it is the same on a floor, a wall and a leaf's underside.
--
-- The camera (Client/SpiderCamera.setLock) keeps the locked thing framed: the orbit turns to look past the spider at it, the eye view's gaze
-- turns to it; eased, or under Reduced Motion held still and cut only when the thing has drifted `reducedCutDeg` from where the view would be.
-- Pure: tests/lock.luau checks all of it without Roblox.
local SupportMath = require(script.Parent.SupportMath)
local CameraMath = require(script.Parent.CameraMath)
local Observation = require(script.Parent.Parent.Perception.Observation)

local LockOn = {}

-- The game's own numbers (no Godot default is touched).
LockOn.game = {
	range = 12.0, -- WU: a press locks only onto something placed within this of the spider
	releaseRange = 16.0, -- WU: a lock ends when the thing is believed farther than this
	lookingDeg = 20.0, -- a contact in the principal eyes within this of the middle of the view is the one "looked at"
	frontDeg = 90.0, -- otherwise the nearest within this of the spider's facing
	minDistance = 0.9, -- WU, on the plane: forward stops closing here
	holdGain = 2.0, -- the pull back to the kept distance while circling, per WU of error (clamped to a full step)
	cameraRate = 5.0, -- 1/s: how fast the view turns to keep the thing framed
	reducedCutDeg = 25.0, -- Reduced Motion: the view stays still until the thing is this far from where it would be, then cuts
}

export type State = { trackId: string?, keep: number, point: Vector3?, released: string? }

function LockOn.new(): State
	return { trackId = nil, keep = 0, point = nil, released = nil }
end

-- A contact a lock may take or keep: placed by an inspection, and live, or lost with its mark still good.
function LockOn.lockable(c: any): boolean
	if c == nil or not c.hasPosition then return false end
	if c.state == "live" then return true end
	return c.state == "lost" and c.markValid == true
end

local function angleBetween(a: Vector3, b: Vector3): number
	if a.Magnitude < 1e-6 or b.Magnitude < 1e-6 then return math.pi end
	return math.acos(math.clamp(a.Unit:Dot(b.Unit), -1, 1))
end

-- The contact a press would lock now, or nil. `eye`: the spider's eyes; `heading`: its facing; `viewOrigin`, `viewDir`: the middle of the view
-- (the camera's centre ray). Only the memory's contacts are looked at.
function LockOn.pick(memory: any, eye: Vector3, heading: Vector3, viewOrigin: Vector3, viewDir: Vector3): any
	local g = LockOn.game
	local looked, lookedAngle = nil, math.rad(g.lookingDeg)
	local nearest, nearestD = nil, g.range
	for _, c in memory:contacts() do
		if LockOn.lockable(c) then
			local to = c.position - eye
			local d = to.Magnitude
			if d <= g.range then
				if c.state == "live" and c.modality == Observation.INSPECTION then
					local a = angleBetween(viewDir, c.position - viewOrigin)
					if a <= lookedAngle then looked, lookedAngle = c, a end
				end
				if d <= nearestD and angleBetween(heading, to) <= math.rad(g.frontDeg) then nearest, nearestD = c, d end
			end
		end
	end
	return looked or nearest
end

-- The spider's distance to a point on the plane it stands on (up `up`).
function LockOn.planar(pos: Vector3, up: Vector3, point: Vector3): number
	local d = point - pos
	return (d - up * d:Dot(up)).Magnitude
end

-- A press of the lock: releases a lock that holds ("released"), else locks what pick() gives ("locked"), else does nothing ("none": the caller
-- recentres then, on the keys that are also Recentre).
function LockOn.press(s: State, memory: any, pos: Vector3, up: Vector3, eye: Vector3, heading: Vector3, viewOrigin: Vector3, viewDir: Vector3): string
	if s.trackId ~= nil then
		LockOn.release(s, "pressed")
		return "released"
	end
	local c = LockOn.pick(memory, eye, heading, viewOrigin, viewDir)
	if c == nil then return "none" end
	s.trackId, s.point, s.released = c.trackId, c.position, nil
	s.keep = math.max(LockOn.planar(pos, up, c.position), LockOn.game.minDistance)
	return "locked"
end

function LockOn.release(s: State, why: string)
	if s.trackId == nil then return end
	s.trackId, s.point, s.released = nil, nil, why
end

-- Each tick, after the sensor: the lock's point now, or nil when there is none (and why it ended, in s.released).
function LockOn.update(s: State, memory: any, pos: Vector3): Vector3?
	local id = s.trackId
	if id == nil then return nil end
	local c = memory:getContact(id)
	if c == nil then LockOn.release(s, "forgotten"); return nil end
	if not LockOn.lockable(c) then LockOn.release(s, "empty"); return nil end
	if (c.position - pos).Magnitude > LockOn.game.releaseRange then LockOn.release(s, "range"); return nil end
	s.point = c.position
	return s.point
end

-- The sidestep: the walking direction on the plane of up `up` for the stick (r right, f forward) while locked on `target`, and the distance kept
-- from now on. Zero when the stick is idle. r circles the target at the kept distance (pulled back to it by holdGain); f closes or opens it, and
-- the distance it leaves when let go is the one kept.
function LockOn.strafe(pos: Vector3, up: Vector3, target: Vector3, keep: number, r: number, f: number): (Vector3, number)
	local g = LockOn.game
	local d = target - pos
	local planar = d - up * d:Dot(up)
	local dist = planar.Magnitude
	if math.abs(r) < 1e-3 and math.abs(f) < 1e-3 then return Vector3.zero, keep end
	if dist < 1e-3 then return Vector3.zero, keep end
	local toward = planar / dist
	local right = toward:Cross(up)
	local radial = f
	if math.abs(f) >= 1e-3 then
		keep = math.max(dist, g.minDistance)
		if f > 0 and dist <= g.minDistance then radial = 0 end
	else
		radial = math.clamp((dist - keep) * g.holdGain, -1, 1)
	end
	local w = right * r + toward * radial
	if w.Magnitude < 1e-4 then return Vector3.zero, keep end
	return w.Unit, keep
end

-- The orbit camera's yaw and elevation (CameraMath's: back direction (sin yaw cos e, sin e, cos yaw cos e)) that look from behind the pivot
-- at the target, the elevation lifted by the game's default so a thing level with the spider is seen over it. nil when they coincide.
function LockOn.orbitGoal(pivot: Vector3, target: Vector3): (number?, number?)
	local f = target - pivot
	if f.Magnitude < 1e-3 then return nil, nil end
	f = f.Unit
	local flat = Vector3.new(f.X, 0, f.Z)
	if flat.Magnitude < 1e-3 then return nil, nil end
	local yaw = math.atan2(-f.X, -f.Z)
	local elev = math.rad(CameraMath.DEFAULT_ELEVATION_DEG) - math.asin(math.clamp(f.Y, -1, 1))
	return yaw, math.clamp(elev, math.rad(CameraMath.MIN_ELEVATION_DEG), math.rad(CameraMath.MAX_ELEVATION_DEG))
end

local function wrap(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

-- One frame of the orbit's follow: eased toward the goal, or (Reduced Motion) unchanged until either angle is reducedCutDeg off, then the goal.
function LockOn.followOrbit(yaw: number, elev: number, goalYaw: number, goalElev: number, dt: number, reduced: boolean): (number, number)
	local dy, de = wrap(goalYaw - yaw), goalElev - elev
	if reduced then
		local cut = math.rad(LockOn.game.reducedCutDeg)
		if math.abs(dy) > cut or math.abs(de) > cut then return yaw + dy, goalElev end
		return yaw, elev
	end
	local k = 1 - math.exp(-LockOn.game.cameraRate * dt)
	return yaw + dy * k, elev + de * k
end

-- One frame of the eye view's follow: the gaze turned toward `want` (both unit), eased, or cut under Reduced Motion as the orbit is.
function LockOn.followGaze(gaze: Vector3, want: Vector3, dt: number, reduced: boolean): Vector3
	local off = angleBetween(gaze, want)
	if reduced then
		return if off > math.rad(LockOn.game.reducedCutDeg) then want else gaze
	end
	local k = 1 - math.exp(-LockOn.game.cameraRate * dt)
	return SupportMath.rotateToward(gaze, want, off * k)
end

return LockOn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">SilkController</string>
            <string name="Source"><![CDATA[--!strict
-- Engine adapter for the frozen safety line. One local-space anchor, at most one bend.
-- Fixed ticks only. The client owns ordinary walking/jumps; this owns locked-line movement.
local Math = require(script.Parent.TetherMath)
local Silk = {}
Silk.__index = Silk
local HEIGHT, RADIUS = 0.31, 0.30
local DOWN = Vector3.new(0,-1,0)
-- The game's own rule (ROBLOX-99), opt-in like NeedsModel.game and Data/Catch.game: how fast the spider lets itself down a line, as a share of Godot's
-- reel speed (Species silk.reel_speed_wu_s, 1.5 studs a second either way). Nathan: "make the hang just go slower by default". Lowering (the stick back, or
-- the drop key held) runs at `lowerScale` of it; reeling in keeps Godot's speed, so the climb back is as brisk as it was and the rig's head-up climb
-- (look.hang.climb.speed) still trips. A controller never given the rule (Silk:useGameRules) replays Godot: the tether goldens and the box-world scenarios.
-- ROBLOX-96: and how long a line may be. Godot's 20 studs (silk.max_line_length_wu) was never reached on the sill; the garden's first set piece is the let-down from
-- the outer sill's front edge to the bed, 90 studs of brick, so the game's line is `maxLine` studs (a game value: jumping spiders do descend on draglines far
-- farther than their body length, but no measured length is claimed here). Everything else about the line (the slack, the hang, the release) is Godot's.
Silk.game = { lowerScale = 0.5, maxLine = 100 }

-- ROBLOX-111: what the line did, counted for the self-test (a Studio run cannot be stepped through): the ticks on the line, how much line was let out
-- and how far the body fell, the sweeps that stopped a move and what they took off it, the tangent touches let pass, and the push-outs of the skin. Never reset
-- (a reader takes a copy and the difference); nothing reads it to decide anything.
function Silk.newStats()
	return { ticks = 0, letOut = 0, fell = 0, stops = 0, stopped = 0, grazes = 0, pushes = 0, pushed = 0, pushedUp = 0 }
end
function Silk.new(world, surfaces, tuning, gravity: number)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = {world}
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = {world}
	return setmetatable({world=world, surfaces=surfaces, params=params, overlap=overlap, maximum=tuning.max_line_length_wu,
		speed=tuning.reel_speed_wu_s, lowerSpeed=tuning.reel_speed_wu_s, gravity=gravity, mode="none", paid=0, rest=0, taut=false,
		anchor=Vector3.zero, normal=Vector3.yAxis, anchorPart=nil, bend=nil, bendPart=nil,
		lowering=false, snagged=false, block="", message="", release=Math.newRelease(), walk=nil,
		previous=Vector3.zero, stats=Silk.newStats()},Silk)
end
-- Opt in to the game's lowering (Silk.game): the let-down at lowerScale of the reel speed. Reeling in is untouched.
function Silk.useGameRules(self: any)
	self.lowerSpeed = self.speed * Silk.game.lowerScale
	self.maximum = Silk.game.maxLine
end
function Silk.profile(self: any, hit)
	return if hit then self.surfaces[hit.Instance:GetAttribute("ProfileId")] else nil
end
function Silk.clear(self: any)
	self.mode="none"; self.anchorPart=nil; self.bend=nil; self.bendPart=nil
	self.paid=0; self.rest=0; self.taut=false; self.lowering=false; self.snagged=false; self.block=""
	self.walk=nil; self.release=Math.newRelease()
	self.message=""
end
function Silk.anchorAt(self: any, hit, position: Vector3): boolean
	self:clear()
	local profile=self:profile(hit)
	if not profile or not profile.silk_anchor_allowed or not hit.Instance:IsA("BasePart") then
		self.message="This surface cannot hold silk"; return false
	end
	self.anchorPart=hit.Instance
	self.anchorLocal=hit.Instance.CFrame:PointToObjectSpace(hit.Position)
	self.normalLocal=hit.Instance.CFrame:VectorToObjectSpace(hit.Normal)
	self.anchor=hit.Position; self.normal=hit.Normal; self.previous=position
	self.mode="payout"; self.rest=self.maximum; self.paid=math.min((position-self.anchor).Magnitude,self.maximum)
	self.message="Silk attached"
	return true
end
function Silk.pivot(self: any): Vector3 return self.bend or self.anchor end
function Silk.prefix(self: any): number return if self.bend then (self.bend-self.anchor).Magnitude else 0 end
function Silk.path(self: any, position: Vector3): number return self:prefix()+(position-self:pivot()).Magnitude end
function Silk.refresh(self: any): boolean
	if not self.anchorPart or not self.anchorPart:IsDescendantOf(self.world) then
		self:clear(); self.message="Silk anchor lost"; return false
	end
	self.anchor=self.anchorPart.CFrame:PointToWorldSpace(self.anchorLocal)
	self.normal=self.anchorPart.CFrame:VectorToWorldSpace(self.normalLocal)
	if self.bendPart then
		if self.bendPart:IsDescendantOf(self.world) then self.bend=self.bendPart.CFrame:PointToWorldSpace(self.bendLocal)
		else self.bend=nil; self.bendPart=nil end
	end
	return true
end
function Silk.clearRay(self: any, a: Vector3, b: Vector3): boolean
	local d=b-a
	return d.Magnitude<=0.02 or workspace:Raycast(a,d.Unit*(d.Magnitude-0.02),self.params)==nil
end
function Silk.geometry(self: any, position: Vector3)
	local a=self.anchor+self.normal*0.02
	if self:clearRay(a,position) then self.bend=nil; self.bendPart=nil; self.snagged=false
	elseif self.bend then self.snagged=not self:clearRay(self.bend,position)
	elseif self:clearRay(a,self.previous) then
		local lo,hi=0,1
		for _=1,12 do
			local mid=(lo+hi)*0.5
			if self:clearRay(a,self.previous:Lerp(position,mid)) then lo=mid else hi=mid end
		end
		local hit=workspace:Raycast(a,self.previous:Lerp(position,hi)-a,self.params)
		self.snagged=true
		if hit and hit.Instance:IsA("BasePart") then
			local side=position-hit.Position
			side-=hit.Normal*side:Dot(hit.Normal)
			if side.Magnitude>1e-6 then side=side.Unit end
			for _,k in {1,2,4} do
				local point=hit.Position+(hit.Normal+side)*0.03*k
				if self:clearRay(a,point) and self:clearRay(point,position) then
					self.bend=point; self.bendPart=hit.Instance
					self.bendLocal=hit.Instance.CFrame:PointToObjectSpace(point)
					if self.mode=="locked" then self.rest=math.min(math.max(self.rest,self:path(position)),self.maximum) end
					self.snagged=false; break
				end
			end
		end
	else self.snagged=true end
	self.previous=position
end
function Silk.lock(self: any, position: Vector3, extension: number)
	if self.mode=="none" then return end
	self.paid,self.rest=Math.lock(self.paid,self:path(position),self.maximum,extension)
	self.mode="locked"; self.taut=false; self.block=""; self.release=Math.newRelease()
	self.message="Silk catching"
end
function Silk.payout(self: any, position: Vector3)
	if self.mode~="payout" or not self:refresh() then return end
	self:geometry(position)
	self.paid=math.max(self.paid,self:path(position))
	if self.paid>=self.maximum then self.paid=self.maximum; self:lock(position,0) end
end
function Silk.room(self: any, position: Vector3): number
	local hit=workspace:Spherecast(position,RADIUS,DOWN*self.maximum,self.params)
	return if hit then hit.Distance else 0
end
function Silk.planDrop(self: any, position: Vector3, up: Vector3, heading: Vector3): ({direction: Vector3, distance: number}?, string)
	local hit=workspace:Raycast(position,-up*(HEIGHT+0.12),self.params)
	local profile=self:profile(hit)
	if not profile then return nil,"No supporting surface" end
	if not profile.silk_anchor_allowed then return nil,"This surface cannot hold silk" end
	if up:Dot(Vector3.yAxis)<0.707 then
		if self:room(position+up*0.01)>=1 then return {direction=Vector3.zero,distance=0},"" end
		return nil,"Nothing below to lower into"
	end
	local best: {direction: Vector3, distance: number}? = nil
	local limit=6
	for i=0,15 do
		local dir=CFrame.fromAxisAngle(up,i*math.pi/8):VectorToWorldSpace(heading)
		local obstacle=workspace:Spherecast(position,RADIUS,dir*6,self.params)
		local free=if obstacle then obstacle.Distance else 6
		for step=1,math.floor(math.min(free,limit)*10) do
			local distance=step/10
			local q=position+dir*distance
			if not workspace:Raycast(q,-up*(HEIGHT+0.12),self.params) then
				if self:room(q+dir*HEIGHT)>=1 and (not best or distance<limit-1e-6) then best={direction=dir,distance=distance}; limit=distance end
				break
			end
		end
	end
	return best,if best then "" else "Nothing below to lower into"
end
function Silk.startDrop(self: any, position: Vector3, up: Vector3, push: Vector3)
	local hit=workspace:Raycast(position,-up*(HEIGHT+0.12),self.params)
	if not self:anchorAt(hit,position) then return false end
	self.lowering=true; self:lock(position,Math.DROP_SLACK)
	self.message="Lowering on silk"
	return true
end

-- ROBLOX-107: the body's skin kept by overlap, not by the sweep alone. The real engine's Spherecast does not see a part the sphere starts in, and a
-- sweep that begins within a hair of a face it is nearly tangent to can miss it (Studio, v35: the self-test's let-down from the outer sill's front edge hung
-- 0.07 from the brick face, inside its 0.31 skin, where the box world keeps it at 0.31). Once inside the skin nothing pushed it out. So after each move the
-- body is pushed out of any box of the world it overlaps, by the shortest way out of the nearest point of that box (never through it: a centre already
-- inside a box is left alone), and the velocity into it is taken away. A box the body is touching (within a thousandth of its radius) that it could land on
-- by the sweep's own rule is a landing, as the sweep's contact would have been. Boxes only (a Part whose Shape is Block; the world's walkable pieces are
-- all boxes). With the box world's exact sweeps the body is never inside its skin, so this changes nothing there.
local SKIN = RADIUS + 0.01
function Silk.unstick(self: any, position: Vector3, velocity: Vector3, intent: number): (Vector3, Vector3, any)
	local p, v = position, velocity
	local ok, parts = pcall(function() return workspace:GetPartBoundsInRadius(p, SKIN, self.overlap) end)
	if not ok or parts == nil then return p, v, nil end
	for _, part in parts do
		local inst = part :: any
		local shape = if inst.ClassName == "Part" then inst.Shape else nil
		if inst:IsA("BasePart") and inst.ClassName == "Part" and (shape == nil or shape == Enum.PartType.Block) then
			local half = inst.Size * 0.5
			local localP = inst.CFrame:PointToObjectSpace(p)
			local near = Vector3.new(math.clamp(localP.X, -half.X, half.X), math.clamp(localP.Y, -half.Y, half.Y), math.clamp(localP.Z, -half.Z, half.Z))
			local out = localP - near
			local d = out.Magnitude
			if d > 1e-6 and d < SKIN - 1e-4 then
				local n = inst.CFrame:VectorToWorldSpace(out / d)
				local contact = { Instance = inst, Position = inst.CFrame:PointToWorldSpace(near), Normal = n, Distance = 0 }
				local stats = self.stats
				stats.pushes += 1; stats.pushed += SKIN - d; stats.pushedUp += n.Y * (SKIN - d)
				p += n * (SKIN - d)
				v -= n * math.min(0, v:Dot(n))
				if d < RADIUS + 1e-3 and self:landable(contact, p, intent) then return p, Vector3.zero, contact end
			end
		end
	end
	return p, v, nil
end
-- The sweep's landing rule: an attachable surface; while letting down, only ground under the body below the anchor (and not on a reel in).
function Silk.landable(self: any, hit, p: Vector3, intent: number): boolean
	local profile = self:profile(hit)
	local allowed = not self.lowering or intent > 0 or (hit.Normal.Y >= 0.707 and hit.Position.Y <= self.anchor.Y - 0.5 and self:groundUnder(p, hit))
	return profile ~= nil and profile.attachable == true and allowed
end
-- ROBLOX-107: while letting down, a landing needs ground under the body. The sweep can meet the rounded edge of a box that another box covers (the brick
-- wall's top under the outer sill's slab, y -3: Studio, v35, "left the line 2.0 s into the let-down, at (2.00, -2.70, -24.07)"), with a normal steep enough to
-- pass the landing rule; the spider then stood on a sliver no one can see. A ray straight down from the body's centre must meet the part it touched
-- within the legs' reach, as standing on it asks; otherwise it slides on.
function Silk.groundUnder(self: any, p: Vector3, hit): boolean
	local under = workspace:Raycast(p, DOWN * (HEIGHT + 0.35), self.params)
	return under ~= nil and under.Instance == hit.Instance
end

-- ROBLOX-111: a contact the move could not have reached. A sweep that reports a face the body is moving along or away from, or one nearer the face than the body
-- now is by less than the move goes into it, is the engine's tangent touch, not a contact: in exact geometry a sphere outside a box meets it only by closing the gap
-- (the box world's sweeps never report one, so nothing changes there). Studio, v36: the let-down from the outer sill's front edge, the body hanging plumb 0.31 off
-- the brick face, ran at 0.559 studs a second where the box world's is 0.752; a sweep that stops the body on such a touch loses the tick's whole move (it
-- slides once, and the slide meets the same face), so a touch on one tick in four is a quarter of the let-down. The skin is kept by the push-out below.
function Silk.grazing(hit, p: Vector3, motion: Vector3): boolean
	local n = hit.Normal
	local into = -motion:Dot(n)
	if into <= 1e-4 then return true end
	local gap = (p - hit.Position):Dot(n) - RADIUS
	return into < gap - 1e-3
end
-- Sweep the body, then slide once. Never satisfy a constraint by teleporting through a wall.
function Silk.move(self: any, position: Vector3, motion: Vector3, velocity: Vector3, intent: number)
	local p=position
	local remaining=motion
	local stopped=false
	for _=1,2 do
		if remaining.Magnitude<1e-7 then break end
		local hit=workspace:Spherecast(p,RADIUS,remaining,self.params)
		if hit and Silk.grazing(hit,p,remaining) then self.stats.grazes+=1; hit=nil end
		if not hit then p+=remaining; break end
		-- Maintain a skin along the contact normal at grazing angles.
		p=hit.Position+hit.Normal*(RADIUS+0.01)
		if self:landable(hit,p,intent) then return p,Vector3.zero,hit end
		local rest=remaining-remaining.Unit*math.min(hit.Distance,remaining.Magnitude)
		remaining=rest-hit.Normal*rest:Dot(hit.Normal)
		stopped=true
		velocity-=hit.Normal*math.min(0,velocity:Dot(hit.Normal))
	end
	if stopped then -- (ROBLOX-111: the counts: a stop, and how much of the move along its own direction it took away)
		local length=motion.Magnitude
		self.stats.stops+=1
		if length>1e-9 then self.stats.stopped+=math.max(0,length-(p-position):Dot(motion/length)) end
	end
	-- While lowering alongside the launch wall, a nearly tangent native sweep can
	-- miss a shallow contact. Maintain the wall's skin without grabbing it again.
	-- Other faces still use the swept landing rules above.
	if self.lowering and math.abs(self.normal.Y)<0.707 then
		local face=workspace:Raycast(p,-self.normal*(RADIUS+0.01),self.params)
		if face and face.Normal:Dot(self.normal)>0.99 then
			local clearance=(p-face.Position):Dot(face.Normal)
			if clearance<RADIUS+0.01 then
				p+=face.Normal*(RADIUS+0.01-clearance)
				velocity-=face.Normal*math.min(0,velocity:Dot(face.Normal))
			end
		end
	end
	local touched
	p,velocity,touched=self:unstick(p,velocity,intent)
	if touched then return p,Vector3.zero,touched end
	return p,velocity,nil
end
function Silk.step(self: any, position: Vector3, velocity: Vector3, intent: number, releaseDown: boolean)
	if self.mode~="locked" or not self:refresh() then return position,velocity,nil end
	local stats=self.stats
	stats.ticks+=1
	if Math.releaseTick(self.release,true,releaseDown) then
		self:clear(); self.message="Silk released"; return position,velocity,nil
	end
	if intent<=0 and self.block=="blocked" then self.block="" end
	local oldRest=self.rest
	-- (ROBLOX-99: letting down runs at the game's lowering speed, reeling in at Godot's; both are the reel speed until useGameRules.)
	if intent<0 or (self.block=="" and not self.snagged) then self.rest=Math.reel(self.rest,self:prefix(),self.maximum,intent,if intent<0 then self.lowerSpeed else self.speed) end
	-- "Shortest" only when a reel actually ran and could not shorten (Godot sets it inside its not-snagged reel branch);
	-- a snag while swinging under a leaf must not leave reeling refused once the line is clear again (ROBLOX-10).
	if intent>0 and not self.snagged and self.rest>=oldRest-1e-6 and self.block=="" then self.block="shortest" end
	if intent<0 and self.rest>oldRest then self.block=""; stats.letOut+=self.rest-oldRest end
	local p=position
	-- A padded bend can leave the shortest line just below the lip. Acquire a nearby
	-- real face with the legs (0.6 stud reach), never through an intervening obstacle.
	if intent>0 and self.block=="shortest" and not self.snagged then
		for _,direction in {self:pivot()-p,Vector3.yAxis,-self.normal} do
			if direction.Magnitude>1e-6 then
				local face=workspace:Raycast(p,direction.Unit*0.6,self.params)
				local profile=self:profile(face)
				if face and profile and profile.attachable then
					local seat=face.Position+face.Normal*HEIGHT
					local motion=seat-p
					local obstacle=if motion.Magnitude>1e-7 then workspace:Spherecast(p,RADIUS,motion,self.params) else nil
					if not obstacle or obstacle.Instance==face.Instance then return seat,Vector3.zero,face end
				end
			end
		end
	end
	if self.rest<oldRest then
		local excess=self:path(p)-self.rest
		if excess>1e-6 then
			local hit
			p,velocity,hit=self:move(p,(self:pivot()-p).Unit*excess,velocity,intent)
			if hit then return p,velocity,hit end
			if self:path(p)>self.rest+1e-4 then self.rest=math.min(self:path(p),self.maximum); self.block="blocked" end
		end
	end
	local energy=Math.energy(p,velocity,self.gravity)
	velocity+=DOWN*self.gravity*Math.DT
	if self.taut and (p-self:pivot()).Magnitude>1e-6 then
		local r=(p-self:pivot()).Unit
		velocity-=(velocity-r*velocity:Dot(r))*(1-math.exp(-Math.DAMPING*Math.DT))
	end
	local c=Math.constrain(self:pivot(),math.max(self.rest-self:prefix(),0),p+velocity*Math.DT,velocity)
	local hit
	p,velocity,hit=self:move(p,c.position-p,c.velocity,intent)
	if hit then return p,velocity,hit end
	local over=self:path(p)-self.rest
	if over>1e-4 then
		p,velocity,hit=self:move(p,(self:pivot()-p).Unit*over,velocity,intent)
		if hit then return p,velocity,hit end
	end
	self:geometry(p)
	if Math.energy(p,velocity,self.gravity)>energy+1e-6 then
		local ke=0.5*velocity:Dot(velocity)
		velocity*=if ke>1e-12 then math.sqrt(math.clamp((energy-self.gravity*p.Y)/ke,0,1)) else 0
	end
	stats.fell+=position.Y-p.Y
	local path=self:path(p)
	self.paid=math.min(math.max(self.paid,path),self.rest)
	self.taut=path>=self.rest-0.003
	self.message=if self.snagged then "Silk snagged — lower or let go" elseif self.block=="blocked" then "Reel blocked — lower or let go"
		elseif self.block=="shortest" then "At the shortest line" elseif intent>0 then "Reeling in" elseif intent<0 then "Lowering" else "Hanging on silk"
	return p,velocity,nil
end
return Silk
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">SpiderMotor</string>
            <string name="Source"><![CDATA[--!strict
-- The spider's body on the windowsill: a kinematic port of the frozen Godot motor's core (scripts/movement/spider_motor.gd,
-- jump_planner.gd and the jump/line parts of player_controller.gd and tether_controller.gd, c87ce00). It walks on any
-- attachable surface (floor, walls, undersides, over edges), plans hops and aimed leaps with the shared JumpMath at a fixed
-- 60 Hz tick, flies them, pays out a safety line from silk-holding ground (SilkController: catch, hang, reel, lower,
-- edge-first lowering, deliberate let-go) and reports line events for the HUD.
--
-- No input devices, camera or drawing here: the client passes a TickInput each fixed tick and an aim ray, so Studio specs
-- (tests/studio/RecoverySpec.luau) run the same motor deterministically, tick by tick, against real geometry. Engine
-- queries only: Workspace raycasts, sphere casts and one overlap query (the room probe).
--
-- The eyes (D-036, spider_motor.gd get_eye_position, get_gaze_direction, get_body_gaze_direction, set_scan_direction, _update_gaze): the
-- senses read the observer() of the body, never the camera. The eyes sit EYE_FORWARD along the facing and EYE_UP along the body's up; the
-- gaze is the facing tilted by the gaze pitch, which follows Focus (at the focus rate, up to the species' gaze limit) and settles to the
-- support plane at half that rate; in the spider-eye view the principal eyes' retinas may point the inspection up to PRINCIPAL_SCAN_DEG
-- off the body's gaze. The camera alone never moves the cone: only Focus and moving do.
local JumpMath = require(script.Parent.JumpMath)
local SupportMath = require(script.Parent.SupportMath)
local SilkController = require(script.Parent.SilkController)

local Motor = {}
Motor.__index = Motor

local DT = 1 / 60
Motor.DT = DT
Motor.RUN_MULTIPLIER = 2 -- faster ground travel; jumps and the safety line retain their own speeds
Motor.HEIGHT = 0.31 -- body centre above the support plane: radius 0.3 + skin 0.01 (Godot seat distance)
local HEIGHT = Motor.HEIGHT
local SWEEP_RADIUS = 0.303 -- body radius + JumpPlanner.SWEEP_MARGIN
local TURN_RATE = math.rad(540)
local FOCUS_RATE = math.rad(180) -- Godot FOCUS_TURN_FALLBACK_DEG_S
local PREPARE_TURN_RATE = math.rad(360) -- SpiderMotor.PREPARE_TURN_RATE_DEG_S: cosmetic turn toward the aim point
local AIM_RANGE = 60
Motor.AIM_RANGE = AIM_RANGE
local HOP_DISTANCE = 1.5
local HOP_PROBE_UP, HOP_PROBE_DOWN = 0.5, 1.2
local MAX_DRIFT = 0.15
local CONTACT_EXTRA_STEPS = 8
local EYE_TURN_START_DEG, EYE_TURN_STOP_DEG = 30, 4 -- CameraMath.PRINCIPAL_SCAN_DEG, EYE_SETTLE_DEG
-- T10a: how far either way of the body's gaze the principal eyes' retinas can point the sharp field (the scan direction).
Motor.PRINCIPAL_SCAN_DEG = 30
local PRINCIPAL_SCAN = math.rad(Motor.PRINCIPAL_SCAN_DEG)
-- Where the eyes are: from the body centre along the facing and along the body's up. Both inside the 0.3 WU body, so a ray from the eye
-- never starts in the world.
Motor.EYE_FORWARD = 0.18
Motor.EYE_UP = 0.08
local EYE_FORWARD, EYE_UP = Motor.EYE_FORWARD, Motor.EYE_UP
local GAZE_PITCH_FALLBACK_DEG = 35 -- used when the species profile has no perception section
local FREE_UP_RATE = math.rad(240) -- the drawn up turns to world up while falling or on the line (Godot VISUAL_TURN)

export type TickInput = {
	wish: Vector3, -- walking direction on the support plane (unit or zero), from the view
	creep: boolean,
	run: boolean?, -- held; creep/lock and an automatic edge walk take priority
	reel: number, -- on the line: +1 reels in, -1 lowers
	dropHeld: boolean, -- F / X / Silk held: lowers on the line
	releaseHeld: boolean, -- Q / B / Let go held: a deliberate let-go after the grace
	focusPoint: Vector3?, -- Focus held: the body turns toward this point
	focusDir: Vector3?, -- Focus held: the aim ray's direction, which the gaze tilts toward when the point is within 0.2 WU of the eyes
	gaze: Vector3?, -- spider-eye view: the body turns to face a gaze beyond 30 degrees
	face: Vector3?, -- the lock's sidestep (ROBLOX-110, Movement/LockOn): walking, the body keeps facing this point instead of turning to the walk
}

export type Config = {
	world: Instance,
	surfaces: any,
	profile: any,
	spawn: Vector3, -- the support point under the body
	heading: Vector3,
	boundsMin: Vector3,
	boundsMax: Vector3,
	probeParent: Instance?,
	-- ROBLOX-95: where the play area is, when it is not one box (the world's regions: the client's WorldClient.inBounds). Out of bounds is then outside the box or
	-- where this says no; without it, the box alone, as Godot has it.
	inBounds: ((Vector3) -> boolean)?,
}

function Motor.idleInput(): TickInput
	return { wish = Vector3.zero, creep = false, reel = 0, dropHeld = false, releaseHeld = false }
end

function Motor.new(config: Config): any
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { config.world }
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = { config.world }
	local probe = Instance.new("Part")
	probe.Name = "RoomProbe"
	probe.Shape = Enum.PartType.Ball
	probe.Size = Vector3.one * (SWEEP_RADIUS * 2)
	probe.Anchored = true
	probe.CanCollide = false
	probe.CanQuery = false
	probe.CanTouch = false
	probe.Transparency = 1
	probe.Parent = config.probeParent or workspace
	local loco = config.profile.locomotion
	local perception = config.profile.perception
	local gazeLimitDeg = if perception ~= nil and typeof(perception.gaze_pitch_limit_deg) == "number" then perception.gaze_pitch_limit_deg else GAZE_PITCH_FALLBACK_DEG
	local self = setmetatable({
		config = config,
		surfaces = config.surfaces,
		loco = loco,
  reachFactor = 1,
  speedFactor = 1,
		gravity = Vector3.new(0, -loco.gravity_wu_s2, 0),
		params = params,
		overlap = overlap,
		probe = probe,
		silk = SilkController.new(config.world, config.surfaces, config.profile.silk, loco.gravity_wu_s2) :: any,
		mode = "attached",
		seized = false, -- taken by a predator (Motor.seize): the motor stands still and the wasp moves the body
		pos = config.spawn + Vector3.new(0, HEIGHT, 0),
		up = Vector3.yAxis,
		heading = config.heading,
		vel = Vector3.zero,
		moving = false,
		preparing = false,
		aimTarget = nil :: Vector3?,
		aimOrigin = Vector3.zero,
		aimDirection = -Vector3.zAxis,
		planKey = "",
		plan = nil :: any,
		flightTicks = 0,
		flightLimit = 0,
		eyeTurning = false,
		gazePitch = 0, -- how far the gaze is tilted off the support plane, radians, up positive (Godot _gaze_pitch)
		gazeLimit = math.rad(gazeLimitDeg),
		scanDir = nil :: Vector3?, -- T10a: where the spider-eye view points the principal eyes (a unit direction); nil: straight ahead
		focusOn = false, -- Focus is turning the gaze (held, or the spider-eye view turning the body); Godot is_focusing
		ticks = 0,
		lineSerial = 0, -- counts lines started, so the drawing knows a new one began
		afterMiss = false,
		dropped = false,
		caught = false,
		safe = { pos = config.spawn + Vector3.new(0, HEIGHT, 0), up = Vector3.yAxis, heading = config.heading },
		supportPart = nil :: Instance?, -- the part the spider last took hold of
		intent = Vector3.zero, -- the walking direction last used, turned with the support at an edge (StickCarry reads it)
		transitionSerial = 0, -- counts sharp support turns while walking (concave and convex edges)
		events = {} :: { { kind: string, detail: string } },
	}, Motor)
	return self
end

function Motor.destroy(self: any)
	self.probe:Destroy()
end

function Motor._event(self: any, kind: string, detail: string?)
	table.insert(self.events, { kind = kind, detail = detail or "" })
end

-- The line and jump events since the last call (for the HUD's toasts), oldest first.
function Motor.drainEvents(self: any): { { kind: string, detail: string } }
	local out = self.events
	self.events = {}
	return out
end

function Motor.profileOf(self: any, inst: Instance?): any
	if not inst then return nil end
	local id = inst:GetAttribute("ProfileId")
	return if typeof(id) == "string" then self.surfaces[id] else nil
end

function Motor.attachable(self: any, hit: RaycastResult?): boolean
	if not hit then return false end
	local p = self:profileOf(hit.Instance)
	return p ~= nil and p.attachable == true
end

-- SurfaceProfile.supports: an attachable surface, or any floor flat enough to stand on.
local STAND_COS = math.cos(math.rad(JumpMath.STAND_MAX_DEG)) - 1e-6
function Motor.supports(_self: any, p: any, normal: Vector3): boolean
	if p ~= nil and p.attachable then return true end
	return normal.Magnitude > 1e-5 and normal.Unit:Dot(Vector3.yAxis) >= STAND_COS
end

local function rotationBetween(a: Vector3, b: Vector3): CFrame
	local angle = SupportMath.angleTo(a, b)
	if angle < 1e-6 then return CFrame.identity end
	local axis = a:Cross(b)
	if axis:Dot(axis) < 1e-12 then axis = SupportMath.anyPerpendicular(a) end
	return CFrame.fromAxisAngle(axis.Unit, angle)
end

function Motor._setSupport(self: any, hit: RaycastResult)
	local turn = rotationBetween(self.up, hit.Normal)
	self.heading = SupportMath.tangentDir(turn * self.heading, hit.Normal)
	if self.heading == Vector3.zero then self.heading = SupportMath.anyPerpendicular(hit.Normal) end
	self.up = hit.Normal
	self.pos = hit.Position + hit.Normal * HEIGHT
	self.supportPart = hit.Instance
end

-- A sharp turn of the support while walking (a wall ahead, an edge to wrap): the walking direction turns with it, as the
-- heading does, and the transition is counted so the controls can carry the stick's direction over the edge.
function Motor._transition(self: any, hit: RaycastResult)
	local turn = rotationBetween(self.up, hit.Normal)
	self.intent = SupportMath.tangentDir(turn * self.intent, hit.Normal)
	self:_setSupport(hit)
	self.transitionSerial += 1
end

function Motor._ray(self: any, from: Vector3, motion: Vector3): RaycastResult?
	return workspace:Raycast(from, motion, self.params)
end

-- Puts the spider somewhere (a reset, a test fixture). Every line, aim and walk ends.
function Motor.place(self: any, position: Vector3, up: Vector3?, heading: Vector3?)
	self.mode = "attached"
	self.seized = false
	self.pos = position
	self.up = up or Vector3.yAxis
	self.heading = SupportMath.tangentDir(heading or self.config.heading, self.up)
	if self.heading == Vector3.zero then self.heading = SupportMath.anyPerpendicular(self.up) end
	self.vel = Vector3.zero
	self.moving = false
	self.intent = Vector3.zero
	self.preparing = false
	self.aimTarget = nil
	self.plan = nil
	self.planKey = ""
	self.gazePitch = 0
	self.silk:clear()
	self.afterMiss, self.dropped, self.caught = false, false, false
	self.safe = { pos = self.pos, up = self.up, heading = self.heading }
end

-- Back to the start, standing on the support point `spawn` facing `heading` (the config's own when none is given; ROBLOX-94: a rest from another revision of the world
-- is put back at its region's spawn, Checkpoint.restore).
function Motor.respawn(self: any, spawn: Vector3?, heading: Vector3?)
	self:place((spawn or self.config.spawn) + Vector3.new(0, HEIGHT, 0), Vector3.yAxis, heading or self.config.heading)
end

-- ---------------------------------------------------------------- the planner (port of jump_planner.gd)
function Motor._sweep(self: any, a: Vector3, b: Vector3): Vector3?
	local d = b - a
	if d.Magnitude < 1e-6 then return nil end
	local hit = workspace:Spherecast(a, SWEEP_RADIUS, d, self.params)
	return if hit then a + d.Unit * hit.Distance else nil
end

function Motor._fits(self: any, center: Vector3): boolean
	self.probe.CFrame = CFrame.new(center)
	return #workspace:GetPartsInPart(self.probe, self.overlap) == 0
end

function Motor._tryCandidate(self: any, origin: Vector3, seat: Vector3, c: any): (boolean, string, { Vector3 }, Vector3?)
	local G = self.gravity
	local pts = JumpMath.path(origin, c.velocity, G, DT, c.steps)
	for k = 2, #pts do
		local at = self:_sweep(pts[k - 1], pts[k])
		if at then
			local cut = table.move(pts, 1, k - 1, 1, {})
			table.insert(cut, at)
			return false, "path_blocked", cut, at
		end
	end
	local v = JumpMath.velocityAfter(c.velocity, G, DT, c.steps)
	local p = pts[#pts]
	for _ = 1, CONTACT_EXTRA_STEPS do
		v += G * DT
		local nextP = p + v * DT
		local at = self:_sweep(p, nextP)
		if at then
			if (at - seat).Magnitude <= MAX_DRIFT then return true, "ok", pts, nil end
			return false, "graze", pts, at
		end
		p = nextP
	end
	return false, "graze", pts, seat
end

-- A plan for a target surface point (JumpPlanner.plan): kind reachable / obstructed / unreachable / ineligible / none, with
-- the reason, the drawn path and, when reachable, the launch velocity and ticks. origin is where the body was.
function Motor.planJump(self: any, point: Vector3?, normal: Vector3?, inst: Instance?): any
	if not point or not normal then return { kind = "none", reason = "no_target" } end
	local loco = self.loco
	local plan: any = { point = point, normal = normal, seat = point + normal * HEIGHT, kind = "unreachable", reason = "", origin = self.pos }
	if not self:supports(self:profileOf(inst), normal) then
		plan.kind, plan.reason = "ineligible", "ineligible_surface"
		return plan
	end
	local solved = JumpMath.solve(self.pos, plan.seat, self.up, normal, self.gravity, DT, loco.flight_time_min_s, math.max(loco.flight_time_min_s,loco.flight_time_max_s*math.sqrt(self.reachFactor)), loco.max_launch_speed_wu_s*math.sqrt(self.reachFactor))
	if #solved.valid == 0 then
		plan.reason = solved.reason
		return plan
	end
	if not self:_fits(plan.seat) then
		plan.kind, plan.reason = "obstructed", "no_room"
		plan.path = JumpMath.path(self.pos, solved.valid[1].velocity, self.gravity, DT, solved.valid[1].steps)
		plan.blockedAt = plan.seat
		return plan
	end
	local firstPath, firstAt, anyBlocked = nil, nil, false
	for _, c in solved.valid do
		local ok, why, path, at = self:_tryCandidate(self.pos, plan.seat, c)
		if ok then
			plan.kind, plan.reason, plan.path, plan.velocity, plan.steps = "reachable", "ok", path, c.velocity, c.steps
			return plan
		end
		if not firstPath then firstPath, firstAt = path, at end
		if why == "path_blocked" then anyBlocked = true end
	end
	plan.path, plan.blockedAt = firstPath, firstAt
	plan.kind, plan.reason = if anyBlocked then "obstructed" else "unreachable", if anyBlocked then "path_blocked" else "graze"
	return plan
end

-- The aim ray the client last gave (the camera's centre ray).
function Motor.setAimRay(self: any, origin: Vector3, direction: Vector3)
	self.aimOrigin, self.aimDirection = origin, direction
end

-- The aim: whatever the centre ray meets (no target magnet). Re-planned only when the aim or the spider moves.
-- Frozen JumpPlanner.configure: scale speed and maximum flight time by sqrt(reach), never gravity or the collider.
function Motor.setReachFactor(self: any, reach: number)
 if self.reachFactor==reach then return end
 self.reachFactor=math.clamp(reach,0.1,10)
 self.planKey="";self.plan=nil
end

function Motor.setSpeedFactor(self: any, speed: number)
 self.speedFactor=math.clamp(speed,0.1,1)
end

-- Opt in to the game's own rules on the line (ROBLOX-99, SilkController.game): the let-down at half Godot's reel speed. A motor never given them replays Godot.
function Motor.useGameRules(self: any)
 self.silk:useGameRules()
end

function Motor.aimPlan(self: any): any
	local hit = self:_ray(self.aimOrigin, self.aimDirection * AIM_RANGE)
	local key = if hit
		then string.format("%.3f,%.3f,%.3f|%.3f,%.3f,%.3f|%.3f,%.3f,%.3f|%.3f,%.3f,%.3f", hit.Position.X, hit.Position.Y, hit.Position.Z, hit.Normal.X, hit.Normal.Y, hit.Normal.Z, self.pos.X, self.pos.Y, self.pos.Z, self.up.X, self.up.Y, self.up.Z)
		else "none"
	if key ~= self.planKey or not self.plan then
		self.planKey = key
		self.plan = if hit then self:planJump(hit.Position, hit.Normal, hit.Instance) else self:planJump(nil, nil, nil)
	end
	if self.preparing then
		self.aimTarget = if hit then hit.Position else nil
	end
	return self.plan
end

-- JumpMotor.plan_hop: the ground HOP_DISTANCE ahead, planned and checked exactly like an aimed jump.
function Motor.hopPlan(self: any): any
	local n = self.up
	local h = SupportMath.tangentDir(self.heading, n)
	if h == Vector3.zero then h = SupportMath.anyPerpendicular(n) end
	local ahead = self:_ray(self.pos, h * (HOP_DISTANCE + HEIGHT))
	if ahead then
		return { kind = "obstructed", reason = "hop_blocked", point = ahead.Position, normal = ahead.Normal, origin = self.pos }
	end
	local finish = self.pos + h * HOP_DISTANCE
	local ground = self:_ray(finish + n * HOP_PROBE_UP, -n * (HOP_PROBE_UP + HOP_PROBE_DOWN))
	if not ground then
		return { kind = "unreachable", reason = "no_ground", point = finish - n * HEIGHT, normal = n, origin = self.pos }
	end
	return self:planJump(ground.Position, ground.Normal, ground.Instance)
end

-- What a leap from here does with the line (SpiderMotor.get_anchor_preview): "ok", "no_silk", "too_long" or "no_support".
function Motor.anchorPreview(self: any, plan: any): string
	if self.mode ~= "attached" then return "no_support" end
	local hit = self:_ray(self.pos, -self.up * (HEIGHT + 0.1))
	local p = if hit then self:profileOf(hit.Instance) else nil
	if not p then return "no_support" end
	if not p.silk_anchor_allowed then return "no_silk" end
	if plan and plan.seat and (plan.seat - self.pos).Magnitude > self.silk.maximum then return "too_long" end
	return "ok"
end

-- ---------------------------------------------------------------- the jump controller's view of the motor (JumpInput)
-- Standing on a surface and not walking itself to an edge's drop: a press or an aim may start.
function Motor.canPrepare(self: any): boolean
	return self.mode == "attached"
end

-- ATTACHED to PREPARING: the spider holds still; a walk to the edge stops (the player took over).
function Motor.beginPrepare(self: any): boolean
	if not self:canPrepare() then return false end
	if self.silk.walk then self:cancelWalk() end
	self.preparing = true
	self.vel = Vector3.zero
	return true
end

function Motor.cancelPrepare(self: any)
	self.preparing = false
	self.aimTarget = nil
end

function Motor.isPreparing(self: any): boolean
	return self.preparing and self.mode == "attached"
end

function Motor.clearAimTarget(self: any)
	self.aimTarget = nil
end

-- Commits a reachable plan made from where the body is now. Anything else changes nothing.
function Motor.commit(self: any, plan: any): boolean
	if plan == nil or plan.kind ~= "reachable" or self.mode ~= "attached" then return false end
	if plan.origin and (plan.origin - self.pos).Magnitude > 1e-3 then return false end
	self:_launch(plan.velocity, plan.steps)
	return true
end

-- A committed leap anchors a safety line at takeoff where the ground holds silk (SilkController pays it out).
function Motor._launch(self: any, velocity: Vector3, steps: number)
	local floorHit = self:_ray(self.pos, -self.up * (HEIGHT + 0.1))
	self.afterMiss, self.dropped, self.caught = false, false, false
	if self.silk:anchorAt(floorHit, self.pos) then
		self.lineSerial += 1
		self:_event("anchored")
	end
	self.preparing = false
	self.aimTarget = nil
	self.flightTicks, self.flightLimit = 0, steps + 4
	self.vel = velocity
	self.mode = "air"
	self:_event("launched")
end

-- ---------------------------------------------------------------- letting down on a line (F / X / Silk)
function Motor._beginDrop(self: any, push: Vector3): boolean
	if not self.silk:startDrop(self.pos, self.up, push) then return false end
	self.lineSerial += 1
	self.afterMiss, self.dropped, self.caught = false, true, false
	self.vel = push * 0.6
	self.mode = "air"
	self.preparing = false
	self.aimTarget = nil
	self:_event("dropped")
	return true
end

-- Godot SpiderMotor.begin_drop: on a wall or underside let down at once; on top of a leaf, walk to the nearest usable
-- edge first. Returns whether something started; a refusal says why in an event.
function Motor.requestDrop(self: any): boolean
	if self.mode ~= "attached" or self.preparing or self.silk.walk then return false end
	local plan, message = self.silk:planDrop(self.pos, self.up, self.heading)
	if not plan then
		self.silk.message = message
		local reason = if message == "This surface cannot hold silk" then "no_silk" elseif message == "No supporting surface" then "no_support" else "no_edge"
		self:_event("drop_refused", reason)
		return false
	end
	if plan.direction.Magnitude < 1e-6 then
		if self:_beginDrop(self.up) then self.pos += self.up * 0.01 end
	else
		self.silk.walk = { direction = plan.direction, ticks = math.ceil((plan.distance / (self.loco.walk_speed_wu_s*self.speedFactor) + 1.5) * 60) }
		self.silk.message = "Walking to the edge — move or cancel to stop"
		self:_event("drop_walk")
	end
	return true
end

-- Stops a walk to the edge (the player moved, aimed or pressed cancel). False when there was none.
function Motor.cancelWalk(self: any): boolean
	if not self.silk.walk then return false end
	self.silk.walk = nil
	self.silk.message = "Edge walk cancelled"
	return true
end

-- True while hanging or reeling on a locked line (Godot is_on_line).
function Motor.onLine(self: any): boolean
	return self.mode == "air" and self.silk.mode == "locked"
end

-- Where the spider will hang (the line's rest point below its pivot) and the lip the line leaves its support at: the
-- camera frames the recovery from these (camera_rig._wanted_yaw_assist, A-017).
function Motor.lineRestPoint(self: any): Vector3
	if self.silk.mode ~= "locked" then return self.pos end
	local pivot = self.silk:pivot()
	return pivot - Vector3.yAxis * math.max(self.silk.rest - self.silk:prefix(), 0)
end

function Motor.lineLip(self: any): Vector3
	return self.silk.bend or (self.silk.anchor + self.silk.normal * 0.04)
end

-- ---------------------------------------------------------------- the eyes (D-036)
-- Where the eyes are (Godot get_eye_position): on the body, a little ahead and a little up.
function Motor.eyePosition(self: any): Vector3
	local frame = SupportMath.bodyCFrame(self.pos, self.up, self.heading)
	return self.pos + frame.LookVector * EYE_FORWARD + frame.UpVector * EYE_UP
end

-- The facing tilted by the gaze pitch about the body's right: where the eyes point with the retinas centred (Godot get_body_gaze_direction).
function Motor.bodyGazeDirection(self: any): Vector3
	local frame = SupportMath.bodyCFrame(self.pos, self.up, self.heading)
	return (frame.LookVector * math.cos(self.gazePitch) + frame.UpVector * math.sin(self.gazePitch)).Unit
end

-- The axis of the inspection cone (Godot get_gaze_direction). The body's own gaze, unless the spider-eye view has pointed the principal
-- eyes' retinas elsewhere (the scan direction): then that direction, held within PRINCIPAL_SCAN_DEG of the body's gaze.
function Motor.gazeDirection(self: any): Vector3
	local axis = self:bodyGazeDirection()
	local scan: Vector3? = self.scanDir
	if scan == nil then
		return axis
	end
	if SupportMath.angleTo(axis, scan) <= PRINCIPAL_SCAN then
		return scan
	end
	local turn = axis:Cross(scan)
	if turn:Dot(turn) < 1e-10 then
		return axis
	end
	return (CFrame.fromAxisAngle(turn.Unit, PRINCIPAL_SCAN) * axis).Unit
end

-- What the senses read of the body (Sensor.step's observer): the eyes, the axis of the cone, the body's up and its facing. Never the camera.
function Motor.observer(self: any): { eye: Vector3, gaze: Vector3, up: Vector3, heading: Vector3 }
	return { eye = self:eyePosition(), gaze = self:gazeDirection(), up = self.up, heading = self.heading }
end

function Motor.scanDirection(self: any): Vector3?
	return self.scanDir
end

-- True while Focus is turning the gaze: held, or the spider-eye view turning the body to face the gaze (Godot is_focusing).
function Motor.isFocusing(self: any): boolean
	return self.focusOn
end

local function moveToward(from: number, to: number, maxStep: number): number
	if math.abs(to - from) <= maxStep then
		return to
	end
	return from + math.sign(to - from) * maxStep
end

-- The direction Focus aims the gaze (Godot player_controller.focus_direction): from the eyes to the point the camera's centre ray meets,
-- or along that ray when the point is within 0.2 WU of them.
function Motor._focusDirection(self: any, input: TickInput): Vector3?
	local point = input.focusPoint
	if point == nil then
		return nil
	end
	local to = point - self:eyePosition()
	if to.Magnitude > 0.2 then
		return to.Unit
	end
	local ray = input.focusDir
	return if ray ~= nil and ray.Magnitude > 1e-4 then ray.Unit else nil
end

-- Godot _update_gaze: the gaze tilts toward the focus direction (within the gaze limit) while Focus is held on a support, and settles back to
-- the support plane, at half that rate, when it is not. T10a: in the spider-eye view it tilts, at that half rate, toward the scan direction;
-- while the body turns to face that gaze it has the full rate, as Focus does.
function Motor._updateGaze(self: any, input: TickInput)
	local wanted, rate = 0.0, FOCUS_RATE * 0.5
	local supported = self.mode == "attached"
	local focus = self:_focusDirection(input)
	local scan: Vector3? = self.scanDir
	self.focusOn = focus ~= nil
	if supported and focus == nil and scan ~= nil and self.eyeTurning and not self.preparing then
		focus = scan
		self.focusOn = true
	end
	if supported and focus ~= nil then
		wanted = math.clamp(math.asin(math.clamp(focus:Dot(self.up), -1, 1)), -self.gazeLimit, self.gazeLimit)
		rate = FOCUS_RATE
	elseif supported and scan ~= nil then
		wanted = math.clamp(math.asin(math.clamp(scan:Dot(self.up), -1, 1)), -self.gazeLimit, self.gazeLimit)
	end
	self.gazePitch = moveToward(self.gazePitch, wanted, rate * DT)
end

-- ---------------------------------------------------------------- the fixed tick
function Motor._turnToward(self: any, dir: Vector3, rate: number)
	local t = SupportMath.tangentDir(dir, self.up)
	if t ~= Vector3.zero then
		self.heading = SupportMath.tangentDir(SupportMath.rotateToward(self.heading, t, rate * DT), self.up)
	end
end

-- Focus (PlayerController.focus_direction) and the spider-eye turn: standing still, the body turns to look.
function Motor._lookTurns(self: any, input: TickInput, stickIdle: boolean)
	if input.focusPoint then
		local eye = self.pos + self.heading * 0.45
		local to = input.focusPoint - eye
		if to.Magnitude > 0.2 then self:_turnToward(to, FOCUS_RATE) end
		self.eyeTurning = false
		return
	end
	if not input.gaze or not stickIdle then
		self.eyeTurning = false
		return
	end
	local look = SupportMath.tangentDir(input.gaze, self.up)
	if look == Vector3.zero then return end
	local off = math.deg(SupportMath.angleTo(self.heading, look))
	if not self.eyeTurning and off > EYE_TURN_START_DEG then
		self.eyeTurning = true
	elseif self.eyeTurning and off < EYE_TURN_STOP_DEG then
		self.eyeTurning = false
	end
	if self.eyeTurning then self:_turnToward(look, FOCUS_RATE) end
end

function Motor._outOfBounds(self: any, p: Vector3): boolean
	local lo, hi = self.config.boundsMin, self.config.boundsMax
	if p.X < lo.X or p.Y < lo.Y or p.Z < lo.Z or p.X > hi.X or p.Y > hi.Y or p.Z > hi.Z then return true end
	local inside = self.config.inBounds
	return inside ~= nil and not inside(p)
end

-- Leaving the play area puts the spider back at its last supported spot (Godot _reset_out_of_bounds).
function Motor._backToSafety(self: any)
	local safe = self.safe
	self:place(safe.pos, safe.up, safe.heading)
	self:_event("out_of_bounds")
end

function Motor._tickAttached(self: any, input: TickInput)
	local silk = self.silk
	local preparing = self.preparing
	local manual = if preparing then Vector3.zero else input.wish
	if silk.walk and manual.Magnitude > 0 then self:cancelWalk() end
	local dir = if preparing then Vector3.zero elseif silk.walk then silk.walk.direction else manual
	if silk.walk then
		silk.walk.ticks -= 1
		if silk.walk.ticks <= 0 then
			silk.walk = nil
			silk.message = "Edge walk stopped"
			self:_event("drop_refused", "stuck")
			return
		end
	end
	self.moving = dir ~= Vector3.zero
	self.intent = dir
	if preparing then
		local target = self.aimTarget
		if target then self:_turnToward(target - self.pos, PREPARE_TURN_RATE) end
	elseif not silk.walk then
		self:_lookTurns(input, not self.moving)
	end
	if not self.moving then
		-- Re-seat on the support so a vanished or moved surface is noticed.
		local below = self:_ray(self.pos + self.up * 0.1, -self.up * (HEIGHT + 0.35))
		if not self:attachable(below) and not (below and self:supports(self:profileOf(below.Instance), below.Normal)) then
			self.mode = "air"
			self.vel = Vector3.zero
			self.preparing = false
			self.flightTicks, self.flightLimit = 0, 0
		else
			self.safe = { pos = self.pos, up = self.up, heading = self.heading }
		end
		return
	end
	local stalk = input.creep and not silk.walk
	local speed = (if stalk then self.loco.stalk_speed_wu_s else self.loco.walk_speed_wu_s)*self.speedFactor
	if input.run == true and not stalk and not silk.walk then speed *= Motor.RUN_MULTIPLIER end
	local face = if input.face ~= nil and not silk.walk then SupportMath.tangentDir(input.face - self.pos, self.up) else Vector3.zero
	self.heading = SupportMath.tangentDir(SupportMath.rotateToward(self.heading, if face ~= Vector3.zero then face else dir, TURN_RATE * DT), self.up) -- (ROBLOX-110: a sidestep faces the locked thing, not the way it walks)
	local step = dir * speed * DT
	-- Concave corner: a wall (or a leaf's edge, a stem) ahead becomes the new support.
	local ahead = self:_ray(self.pos, dir * (HEIGHT + step.Magnitude + 0.02))
	if ahead and self:attachable(ahead) and SupportMath.angleTo(ahead.Normal, self.up) > math.rad(20) then
		self:_transition(ahead)
		return
	end
	local nextPos = self.pos + step
	local below = self:_ray(nextPos + self.up * 0.25, -self.up * (HEIGHT + 0.5))
	if below and self:attachable(below) and SupportMath.angleTo(below.Normal, self.up) < math.rad(60) then
		local n = SupportMath.filterNormal(self.up, below.Normal, 2.0)
		self.up = n
		self.pos = below.Position + n * HEIGHT
		self.heading = SupportMath.tangentDir(self.heading, n)
		self.safe = { pos = self.pos, up = self.up, heading = self.heading }
		return
	end
	if silk.walk then
		-- The walk reached the edge: let down from here (edge-first lowering).
		if self:_beginDrop(dir) then self.pos = nextPos + dir * (HEIGHT + 0.02) end
		return
	end
	-- Convex edge: wrap over it onto the face beyond (sill edge, leaf rim, the top of a wall).
	local around = self:_ray(nextPos - self.up * (HEIGHT + 0.15), -dir * 1.0)
	if around and self:attachable(around) then
		self:_transition(around)
		return
	end
	self.mode = "air"
	self.vel = dir * speed
	self.flightTicks, self.flightLimit = 0, 0
end

function Motor._tickLine(self: any, input: TickInput)
	local silk = self.silk
	-- On the line (spec 17's context override): forward reels in, back lowers, F held lowers, a held Q lets go.
	local intent = if input.dropHeld then math.min(input.reel, 0) - 1 else input.reel
	local p, v, hit = silk:step(self.pos, self.vel, math.clamp(intent, -1, 1), input.releaseHeld == true)
	self.pos, self.vel = p, v
	if hit then
		self:_setSupport(hit)
		self.vel = Vector3.zero
		self.mode = "attached"
		silk:clear()
		self:_event("completed")
		self.safe = { pos = self.pos, up = self.up, heading = self.heading }
		return
	end
	if silk.mode == "none" then
		self:_event(if silk.message == "Silk anchor lost" then "lost" else "released")
		self.flightTicks, self.flightLimit = 0, 0
		return
	end
	if silk.taut and not self.caught then
		self.caught = true
		self:_event("caught")
	end
	if silk.snagged and not self.snagSeen then self:_event("snagged") end
	self.snagSeen = silk.snagged
	self.up = SupportMath.rotateToward(self.up, Vector3.yAxis, FREE_UP_RATE * DT)
	if self:_outOfBounds(self.pos) then self:_backToSafety() end
end

function Motor._lock(self: any, at: Vector3)
	self.silk:lock(at, 0.25)
	self.afterMiss = true
	self.caught = false
	self:_event("locked")
end

function Motor._tickAir(self: any, input: TickInput)
	local silk = self.silk
	if silk.mode == "locked" then
		self:_tickLine(input)
		return
	end
	self.flightTicks += 1
	local from = self.pos
	self.vel += self.gravity * DT
	local to = from + self.vel * DT
	local travel = to - from
	local dir = if travel.Magnitude > 1e-6 then travel.Unit else -self.up
	local hit = self:_ray(from, dir * (travel.Magnitude + HEIGHT))
	if hit then
		local approach = -self.vel:Dot(hit.Normal)
		if self:supports(self:profileOf(hit.Instance), hit.Normal) and approach >= JumpMath.minApproach(hit.Normal) then
			local heading = SupportMath.tangentDir(self.vel, hit.Normal)
			self:_setSupport(hit)
			if heading ~= Vector3.zero then self.heading = heading end
			self.vel = Vector3.zero
			self.mode = "attached"
			if silk.mode ~= "none" then self:_event("landed") end
			silk:clear()
			self.safe = { pos = self.pos, up = self.up, heading = self.heading }
			return
		end
		-- Not landable here: the line locks (a miss), and the body slides along it.
		if silk.mode == "payout" then self:_lock(self.pos) end
		self.vel -= hit.Normal * math.min(0, self.vel:Dot(hit.Normal))
		to = hit.Position + hit.Normal * HEIGHT
	end
	self.pos = to
	silk:payout(to)
	if silk.mode == "payout" and self.flightTicks >= self.flightLimit then self:_lock(to) end
	-- The drawn body turns upright while falling.
	self.up = SupportMath.rotateToward(self.up, Vector3.yAxis, FREE_UP_RATE * DT)
	if self:_outOfBounds(to) then self:_backToSafety() end
end

-- Taken by a predator (Godot SpiderMotor.seize, LIFE round 4; ROBLOX-26): the spider lets go of its surface and its line, takes no more
-- input, and the motor stops. Whatever took it moves the body from now on with `hold`. Nothing undoes it but `place`: the world that
-- follows is a checkpoint's or the start.
function Motor.seize(self: any)
	self.seized = true
	self.mode = "air"
	self.preparing = false
	self.aimTarget = nil
	self.plan = nil
	self.planKey = ""
	self.vel = Vector3.zero
	self.moving = false
	self.intent = Vector3.zero
	self.silk:clear()
end

-- Where the predator holds the body (the spider hangs upright under it).
function Motor.hold(self: any, position: Vector3)
	self.pos = position
	self.up = SupportMath.rotateToward(self.up, Vector3.yAxis, FREE_UP_RATE * DT)
end

-- One fixed 1/60 s tick of the body.
function Motor.tick(self: any, input: TickInput)
	if self.seized then return end
	self.ticks += 1
	local scan = input.gaze
	self.scanDir = if scan ~= nil and scan.Magnitude > 1e-4 then scan.Unit else nil
	if self.mode == "attached" then
		self:_tickAttached(input)
	else
		self.preparing = false
		self:_tickAir(input)
	end
	self:_updateGaze(input)
end

return Motor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">StickCarry</string>
            <string name="Source"><![CDATA[--!strict
-- The carry over an edge: a port of the frozen Godot scripts/movement/player_controller.gd _carry (c87ce00).
-- On a wall, forward is up; on a floor, away from the camera. So holding the stick forward over a sharp edge would flip
-- the camera mapping and walk the spider straight back (it would oscillate at the edge). When the support turns sharply
-- (the motor's transitionSerial changes) while the stick is held, the motor's own direction, which it turned with the
-- support, is kept instead of the fresh mapping. The carry ends when the stick is released or turned by more than
-- CARRY_STICK_DEG, or when the fresh mapping agrees with the carried direction again (within CARRY_AGREE_DEG). Pure.
local StickCarry = {}
StickCarry.__index = StickCarry

StickCarry.CARRY_STICK_DEG = 30.0
StickCarry.CARRY_AGREE_DEG = 25.0

function StickCarry.new(): any
	return setmetatable({ carrying = false, sx = 0, sy = 0, lastSerial = 0 }, StickCarry)
end

local function angleBetween(a: Vector3, b: Vector3): number
	return math.atan2(a:Cross(b).Magnitude, a:Dot(b))
end

-- stick x right, y forward; fresh: the camera mapping on the support now; serial: the motor's transition count;
-- carried: the motor's own walking direction (turned with the support); inTransition: rounding an edge.
function StickCarry.step(self: any, sx: number, sy: number, fresh: Vector3, serial: number, carried: Vector3, inTransition: boolean): Vector3
	local turned = serial ~= self.lastSerial
	self.lastSerial = serial
	local length = math.sqrt(sx * sx + sy * sy)
	if length * length < 1e-8 then
		self.carrying = false
		return Vector3.zero
	end
	local nx, ny = sx / length, sy / length
	if turned and not self.carrying then
		self.carrying = true
		self.sx, self.sy = nx, ny
	end
	if not self.carrying then return fresh end
	if math.acos(math.clamp(nx * self.sx + ny * self.sy, -1, 1)) > math.rad(StickCarry.CARRY_STICK_DEG) then
		self.carrying = false
		return fresh
	end
	if carried:Dot(carried) < 1e-8 then
		self.carrying = false
		return fresh
	end
	local dir = carried.Unit
	if not inTransition and fresh:Dot(fresh) > 1e-8 and angleBetween(fresh.Unit, dir) < math.rad(StickCarry.CARRY_AGREE_DEG) then
		self.carrying = false
		return fresh
	end
	return dir * math.min(length, 1)
end

return StickCarry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">SupportMath</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/movement/support_math.gd (spec 6.1, 6.2). Pure geometry for supported locomotion; unit vectors in world space.

local SupportMath = {}

local RIGHT = Vector3.new(1, 0, 0)
local BACK = Vector3.new(0, 0, 1)

local function angleTo(a: Vector3, b: Vector3): number
	return math.atan2(a:Cross(b).Magnitude, a:Dot(b))
end
SupportMath.angleTo = angleTo

-- The part of v that lies in the plane with unit normal n.
function SupportMath.tangent(v: Vector3, n: Vector3): Vector3
	return v - n * v:Dot(n)
end

-- Unit direction of v on the plane with normal n, or zero when v is (nearly) along n.
function SupportMath.tangentDir(v: Vector3, n: Vector3, eps: number?): Vector3
	local t = SupportMath.tangent(v, n)
	local length = t.Magnitude
	return if length > (eps or 1e-5) then t / length else Vector3.zero
end

-- Hysteresis for the support normal: a candidate within ignoreDeg of the current one is ignored.
function SupportMath.filterNormal(current: Vector3, candidate: Vector3, ignoreDeg: number): Vector3
	if candidate:Dot(candidate) < 1e-10 or candidate.Magnitude ~= candidate.Magnitude then
		return current
	end
	local c = candidate.Unit
	if current:Dot(current) < 1e-10 then
		return c
	end
	if angleTo(current.Unit, c) <= math.rad(ignoreDeg) then
		return current
	end
	return c
end

function SupportMath.anyPerpendicular(v: Vector3): Vector3
	local other = if math.abs(v.Unit.X) < 0.9 then RIGHT else BACK
	return v:Cross(other).Unit
end

-- Turns unit vector `from` toward `to` by at most maxAngle radians (shortest arc).
function SupportMath.rotateToward(from: Vector3, to: Vector3, maxAngle: number): Vector3
	local angle = angleTo(from, to)
	if angle <= maxAngle or angle < 1e-6 then
		return to
	end
	local axis = from:Cross(to)
	if axis:Dot(axis) < 1e-12 then
		axis = SupportMath.anyPerpendicular(from)
	end
	return (CFrame.fromAxisAngle(axis.Unit, maxAngle) * from).Unit
end

-- Signed angle from a to b about axis n.
function SupportMath.signedAngle(a: Vector3, b: Vector3, n: Vector3): number
	return math.atan2(n:Dot(a:Cross(b)), a:Dot(b))
end

-- Body frame for an up vector and a heading: Y is up, -Z (LookVector) is the heading made perpendicular to up.
function SupportMath.bodyCFrame(position: Vector3, up: Vector3, heading: Vector3): CFrame
	local u = up.Unit
	local f = SupportMath.tangentDir(heading, u)
	if f == Vector3.zero then
		f = SupportMath.anyPerpendicular(u)
	end
	local z = -f
	local x = u:Cross(z).Unit
	return CFrame.fromMatrix(position, x, u, z)
end

return SupportMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">TetherMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pure safety-line operations from frozen Godot tether.gd / spider_motor.gd.
-- No renderer, wall clock, Roblox services or collision decisions here.
local T = {}
T.BRAKE = 0.25
T.MIN_REST = 0.4
T.DROP_SLACK = 0.5
T.DAMPING = 1.6
T.DT = 1/60

function T.constrain(pivot: Vector3, length: number, target: Vector3, velocity: Vector3)
	local d = target-pivot
	local distance = d.Magnitude
	local out = {position=target, velocity=velocity, acted=false, radial_before=0, radial_after=0,
		tangential_change=0, distance_before=distance, distance_after=distance}
	if distance < 1e-9 then return out end
	local radial = d/distance
	local speed = velocity:Dot(radial)
	out.radial_before, out.radial_after = speed, speed
	if distance <= length then return out end
	local v = if speed > 0 then velocity-radial*speed else velocity
	out.position = pivot+radial*math.max(length,0)
	out.velocity, out.acted = v, true
	out.radial_after = v:Dot(radial)
	out.tangential_change = ((v-radial*v:Dot(radial))-(velocity-radial*speed)).Magnitude
	out.distance_after = math.max(length,0)
	return out
end
function T.energy(position: Vector3, velocity: Vector3, gravity: number): number
	return 0.5*velocity:Dot(velocity)+gravity*position.Y
end
function T.reelWorkBound(shortening: number, gravity: number, speed: number, length: number): number
	return math.max(shortening,0)*(gravity+speed*speed/math.max(length,0.05))
end
function T.sagDepth(span: number, length: number): number
	local extra = length-span
	if extra <= 1e-4 or span < 1e-4 then return 0 end
	return math.min(math.sqrt(3*span*extra/8),3)
end
function T.lock(paid: number, path: number, maximum: number, extension: number): (number,number)
	local p = math.min(math.max(paid,path),maximum)
	return p,math.min(p+math.max(extension,0),maximum)
end
function T.reel(rest: number, prefix: number, maximum: number, intent: number, speed: number): number
	return math.clamp(rest-math.clamp(intent,-1,1)*speed*T.DT,math.min(prefix+T.MIN_REST,maximum),maximum)
end

-- A press that started before the grace period can NEVER become a release later.
function T.newRelease()
	return {ticks=0, held=0, down=false, counts=false, progress=0}
end
function T.releaseTick(s: any, onLine: boolean, down: boolean): boolean
	s.ticks = if onLine then s.ticks+1 else 0
	if down and not s.down then s.counts = onLine and s.ticks>=24; s.held=0 end
	if not down or not onLine then s.counts=false; s.held=0 end
	s.down = down
	s.held = if s.counts then s.held+1 else 0
	s.progress = math.min(s.held/36,1)
	if s.progress>=1 then s.counts=false; s.held=0; s.progress=0; return true end
	return false
end
return T
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">TitleShots</string>
            <string name="Source"><![CDATA[--!strict
-- The camera of the first minute (ROBLOX-109), as pure functions of time: the drift the splash (First/SplashScreen) and the title card (Client/TitleCard)
-- both draw, and the intro of a new life, shot by shot, with its captions' times and the spider's walk out of the crack. Pure: tests/title.luau checks it,
-- and tools/preview/scene.py --title renders its frames from these same numbers (TitleShots.views).
--
-- The drift: the garden in the morning seen from outside, from over the lawn beyond the bed, low, drawing in toward the window over DRIFT_S seconds, then
-- breathing in place (a slow sway of a stud or two) for as long as the title card is up. It is a function of the game's clock (`time()`), so the splash
-- and the title card, two scripts, put the camera in the same place on the same frame and the hand-over between them cannot jump.
-- The intro: the morning light through the glass from low on the sill; the camera low over the sill floor finding the crack; the spider stepping out of it;
-- then the camera eases into the game's own camera behind the spider and the controls are the player's. Captions come in the notebook's voice
-- (UI/TitleText.captions). Reduced Motion: each shot is held still (its middle frame) and the shots cut; no ease into the game's camera, a cut.
-- One stud is a centimetre: the sill's floor is y 0, the crack's mouth is at x -23.3 (Habitat/WindowsillLayout.RETREAT_MAX), the glass at z -12.6, the
-- outer sill's top y 0 out to z -24 (the house's face), the bed's soil y -90.
local TitleShots = {}

export type Key = { t: number, eye: Vector3, at: Vector3, fov: number }
export type Shot = { name: string, t0: number, t1: number, eye0: Vector3, eye1: Vector3, at0: Vector3, at1: Vector3, fov: number, follow: boolean? }
export type Frame = {
	cframe: CFrame, fov: number, shot: string, veil: number, caption: number?, captionAlpha: number,
	blend: number, walking: boolean, holding: boolean, done: boolean,
}

local v = Vector3.new

TitleShots.DRIFT_S = 36
TitleShots.DRIFT = {
	{ t = 0, eye = v(40, -82, -170), at = v(0, -25, -24), fov = 55 }, -- low over the lawn past the bed: the bed's foot, the bushes, the window high in the wall
	{ t = 18, eye = v(16, -20, -80), at = v(0, 0, -18), fov = 48 }, -- risen in front of the wall, the window in its deep reveal
	{ t = 36, eye = v(10, 6.5, -45), at = v(0, 2.5, -14), fov = 46 }, -- level with the outer sill, looking in: the window boxes, the glass, the sill beyond
} :: { Key }
-- ROBLOX-115: the preserve's drift (World/Preserve: the ranger hut's north window, the sill in it, looking north over the hut garden): from over the hut garden's far
-- end, at a person's knee, drawing in over the herb beds to the window from outside, arriving where the test garden's does (in front of the glass, looking in).
TitleShots.PRESERVE_DRIFT = {
	{ t = 0, eye = v(380, 60, -1250), at = v(0, 30, -16), fov = 55 }, -- over the far end of the hut garden: the beds, the fence, the hut with its window
	{ t = 18, eye = v(120, 25, -360), at = v(0, 15, -16), fov = 48 }, -- in over the herb beds, the hut's log wall and its green casing
	{ t = 36, eye = v(10, 6.5, -45), at = v(0, 2.5, -14), fov = 46 }, -- level with the outer sill, looking in: the glass, the sill beyond
} :: { Key }
-- The drift of each world (World/Worlds' ids); any other world (or none: the splash before the server has said) has the default world's, the preserve's
-- (ROBLOX-118: World/Worlds.DEFAULT, the game's world; this module is required by the splash before World/ is known to have replicated, so it names it itself).
TitleShots.DRIFTS = { test_garden = TitleShots.DRIFT, preserve = TitleShots.PRESERVE_DRIFT } :: { [string]: { Key } }
TitleShots.DEFAULT_WORLD = "preserve"

-- The breathing once the drift has arrived: amplitudes in studs and the periods' rates (radians a second), slow enough never to be noticed as a move.
TitleShots.SWAY = { x = 1.6, y = 0.5, rateX = 0.07, rateY = 0.05 }

local function smooth(k: number): number
	k = math.clamp(k, 0, 1)
	return k * k * (3 - 2 * k)
end

-- The drift's camera and field of view at the game's time `t` (seconds since the client began), in the world `world` (the Workspace attribute World; the
-- default world's drift when nil or unknown: the preserve's since ROBLOX-118).
function TitleShots.drift(t: number, world: string?): (CFrame, number)
	local keys = (if world ~= nil then TitleShots.DRIFTS[world] else nil) or TitleShots.DRIFTS[TitleShots.DEFAULT_WORLD]
	t = math.max(t, 0)
	local last = keys[#keys]
	if t >= last.t then
		local s = TitleShots.SWAY
		local after = t - last.t
		-- (the sway starts from nothing: sin(0) = 0 and its rate is slow, so the arrival is still)
		local eye = last.eye + v(math.sin(after * s.rateX) * s.x, math.sin(after * s.rateY) * s.y, 0)
		return CFrame.lookAt(eye, last.at), last.fov
	end
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if t <= b.t then
			local k = smooth((t - a.t) / (b.t - a.t))
			return CFrame.lookAt(a.eye:Lerp(b.eye, k), a.at:Lerp(b.at, k)), a.fov + (b.fov - a.fov) * k
		end
	end
	return CFrame.lookAt(last.eye, last.at), last.fov
end

-- The intro of a new life. `start` is where the spider is put when it begins (just inside the crack, facing out: the game's spawn heading); it walks out
-- (the motor's own walk, `walk`) from `walk.from` until it is past `walk.untilX` or `walk.latest` has come. `skipAfter`: the skip is refused before it.
-- The captions are UI/TitleText.captions' three, each faded in and out over `captionFade`; the last outlives the intro by a few seconds, over the game.
TitleShots.INTRO = {
	skipAfter = 2.0,
	fadeIn = 0.8,
	start = { pos = v(-25.2, 0.31, 6.0), heading = v(1, 0, 0) },
	walk = { from = 7.4, untilX = -21.6, latest = 11.5 },
	shots = {
		{ name = "glass", t0 = 0, t1 = 3.8, eye0 = v(-15.0, 1.0, 10.5), eye1 = v(-17.0, 0.9, 9.0), at0 = v(-5.0, 4.6, -12.6), at1 = v(-8.0, 4.3, -12.6), fov = 55 },
		{ name = "sill", t0 = 3.8, t1 = 7.4, eye0 = v(-9.5, 0.85, 4.2), eye1 = v(-16.8, 0.7, 5.4), at0 = v(-24.5, 0.6, 6.0), at1 = v(-24.8, 0.55, 6.0), fov = 50 },
		{ name = "out", t0 = 7.4, t1 = 12.2, eye0 = v(-17.6, 0.75, 9.2), eye1 = v(-18.4, 0.7, 8.8), at0 = v(-24.6, 0.5, 6.0), at1 = v(-21.8, 0.5, 6.0), fov = 46, follow = true },
	} :: { Shot },
	blend = { t0 = 12.2, t1 = 13.6 },
	total = 13.6,
	captions = { { t0 = 4.2, t1 = 8.2 }, { t0 = 8.6, t1 = 11.8 }, { t0 = 12.2, t1 = 16.0 } },
	captionFade = 0.6,
	captionsEnd = 16.0,
}

-- ROBLOX-118: in the preserve the intro opens inside the ranger hut: from the room, low over the sill's front edge, the morning coming in through the hut's window
-- over the sill (the sill, its crack and the spider's walk out of it are the same in both worlds: the sill is the same sill at the origin). The other shots are the same.
TitleShots.PRESERVE_GLASS = { name = "glass", t0 = 0, t1 = 3.8, eye0 = v(-4.0, 9.0, 34.0), eye1 = v(-9.0, 6.5, 24.0), at0 = v(0.0, 16.0, -14.0), at1 = v(-3.0, 9.0, -13.0), fov = 58 } :: Shot

-- The intro's shots in a world (the Workspace attribute World): the preserve's opens in the hut; any other world's (or none) is the shared list.
function TitleShots.introShots(world: string?): { Shot }
	local shots: { Shot } = TitleShots.INTRO.shots
	if world ~= "preserve" then return shots end
	local out = table.clone(shots)
	out[1] = TitleShots.PRESERVE_GLASS
	return out
end

-- One frame of the intro at `t` seconds. `reduced`: Reduced Motion. `spider`: where the spider's body is now (the "out" shot looks at it; the planned
-- path when nil). `blend` is how far the view has eased into the game's camera (0 none, 1 all of it; the caller lerps); `holding` is whether the intro
-- still has the camera and the controls, `done` whether everything, the last caption included, is over.
function TitleShots.intro(t: number, reduced: boolean, spider: Vector3?, world: string?): Frame
	local I = TitleShots.INTRO
	local shots: { Shot } = TitleShots.introShots(world) -- (ROBLOX-118: `world` the Workspace attribute World; the preserve's opens in the hut)
	local shot = shots[#shots]
	for _, s in shots do
		if t < s.t1 then shot = s; break end
	end
	local k = if reduced then 0.5 else smooth((t - shot.t0) / (shot.t1 - shot.t0))
	local eye = shot.eye0:Lerp(shot.eye1, k)
	local at = shot.at0:Lerp(shot.at1, k)
	if shot.follow and spider ~= nil then at = spider + v(0, 0.2, 0) end
	local caption: number? = nil
	local alpha = 0
	for i, c in I.captions do
		if t >= c.t0 and t < c.t1 then
			caption = i
			alpha = math.min(1, (t - c.t0) / I.captionFade, (c.t1 - t) / I.captionFade)
		end
	end
	local blend = if reduced then (if t >= I.blend.t1 then 1 else 0) else smooth((t - I.blend.t0) / (I.blend.t1 - I.blend.t0))
	return {
		cframe = CFrame.lookAt(eye, at), fov = shot.fov, shot = shot.name,
		veil = 1 - math.clamp(t / I.fadeIn, 0, 1),
		caption = caption, captionAlpha = math.clamp(alpha, 0, 1),
		blend = blend,
		walking = t >= I.walk.from and t < I.walk.latest,
		holding = t < I.total,
		done = t >= I.captionsEnd,
	}
end

-- The frames tools/preview/scene.py --title renders (and tests/title.luau keeps clear of the world's boxes): the drift's start, middle and arrival, and
-- each intro shot's middle, the "out" shot with the spider where its walk ends.
function TitleShots.views(): { { name: string, eye: Vector3, at: Vector3, fov: number } }
	local out = {}
	for _, key in TitleShots.DRIFT do
		table.insert(out, { name = `title_drift_{key.t}`, eye = key.eye, at = key.at, fov = key.fov })
	end
	for _, s in TitleShots.INTRO.shots do
		table.insert(out, { name = `intro_{s.name}`, eye = s.eye0:Lerp(s.eye1, 0.5), at = s.at0:Lerp(s.at1, 0.5), fov = s.fov })
	end
	return out
end

-- ROBLOX-115: the preserve's drift's three keys as the previewer's views (tools/preview/scene.py --preserve): preserve_drift_0, _18 and _36.
function TitleShots.preserveViews(): { { name: string, eye: Vector3, at: Vector3, fov: number } }
	local out = {}
	for _, key in TitleShots.PRESERVE_DRIFT do
		table.insert(out, { name = `preserve_drift_{key.t}`, eye = key.eye, at = key.at, fov = key.fov })
	end
	-- (ROBLOX-118) and the preserve's first shot of the intro, in the hut
	local g = TitleShots.PRESERVE_GLASS
	table.insert(out, { name = "preserve_intro_glass", eye = g.eye0:Lerp(g.eye1, 0.5), at = g.at0:Lerp(g.at1, 0.5), fov = g.fov })
	return out
end

return TitleShots
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="73">
        <Properties>
          <string name="Name">Perception</string>
        </Properties>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Observation</string>
            <string name="Source"><![CDATA[--!strict
-- Observation (spec 21.3): one piece of sensed evidence, as the sensor makes it and the memory keeps it. A port of the frozen
-- Godot scripts/perception/observation.gd (c87ce00), field for field. Observer, target (only when resolved), estimated position,
-- modality, confidence in [0, 1], the tick it was observed at (an integer action tick) and a category. It is never refreshed from
-- hidden truth: an observation is only ever made from what the observer could see at `observedTick`, and a later one is a new record.
--
-- Two modalities (spec 7):
--   PERIPHERAL  broad coverage, a coarse direction only, no position and no category beyond "movement". The target is not resolved.
--   INSPECTION  the forward cone: a position (to within the target's own size), a category that refines with continuous exposure
--               (movement, possible prey, fly-like prey: A-004), and the target once it is resolved.
-- Words for the categories belong to the presentation, never here. Pure: no engine services, so the plain Luau CLI runs it.
--
-- Naming: Godot's snake_case fields are camelCase here (track_id -> trackId, speed_wu_s -> speedWuS); the values are unchanged.
local Observation = {}
Observation.__index = Observation

Observation.PERIPHERAL = "peripheral_motion"
Observation.INSPECTION = "forward_inspection"

Observation.MOVEMENT = "movement"
Observation.POSSIBLE_PREY = "possible_prey"
Observation.FLY_LIKE_PREY = "fly_like_prey"
-- Refinement order: each is a finer guess than the one before it. No species is ever named (A-004).
Observation.CATEGORIES = table.freeze({ "movement", "possible_prey", "fly_like_prey" })

export type Observation = {
	observerId: string,
	-- The target's persistent id once the observer has resolved it (inspected it long enough), else "".
	targetId: string,
	-- Opaque id the sensor gives one thing it keeps sensing, so the memory can follow it. It is not the target's id.
	trackId: string,
	-- The estimate; meaningful only when hasPosition. A peripheral observation has none: only `direction`.
	estimatedPosition: Vector3,
	hasPosition: boolean,
	-- Unit direction from the observer to the thing, as sensed: exact enough to aim at for an inspection, quantised to a sector
	-- for a peripheral cue.
	direction: Vector3,
	modality: string,
	confidence: number,
	observedTick: number,
	category: string,
	-- Estimated size of the thing, WU (an inspection only). The memory uses it to judge whether a place could hide it.
	sizeWu: number,
	-- How large it looked, degrees of angle across.
	apparentSizeDeg: number,
	-- How fast it was seen moving, WU/s (an inspection only). A lost contact's plausible region grows at least this fast (A-027).
	speedWuS: number,
}

local function isFinite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function vectorIsFinite(v: Vector3): boolean
	return isFinite(v.X) and isFinite(v.Y) and isFinite(v.Z)
end

-- A new record with Godot's defaults (a peripheral movement cue straight ahead with nothing in it); `fields` overrides any of them.
function Observation.new(fields: { [string]: any }?): Observation
	local o = {
		observerId = "",
		targetId = "",
		trackId = "",
		estimatedPosition = Vector3.zero,
		hasPosition = false,
		direction = Vector3.new(0, 0, -1), -- Godot's Vector3.FORWARD (both engines look down -Z)
		modality = Observation.PERIPHERAL,
		confidence = 0.0,
		observedTick = 0,
		category = Observation.MOVEMENT,
		sizeWu = 0.0,
		apparentSizeDeg = 0.0,
		speedWuS = 0.0,
	}
	if fields then
		for k, v in fields do
			(o :: any)[k] = v
		end
	end
	return setmetatable(o, Observation) :: any
end

-- The place of a category in the refinement order: 0 movement, 1 possible prey, 2 fly-like prey; -1 for anything else (Godot's Array.find).
function Observation.rank(c: string): number
	local i = table.find(Observation.CATEGORIES, c)
	return if i then i - 1 else -1
end

-- Problems with the record, empty when it is fine: the invariants of spec 21.3 (no NaN or infinity, confidence in [0, 1], a known
-- modality and category, a position only for an inspection).
function Observation.problems(o: Observation): { string }
	local out: { string } = {}
	if o.observerId == "" then
		table.insert(out, "no observer")
	end
	if o.trackId == "" then
		table.insert(out, "no track")
	end
	if not (o.modality == Observation.PERIPHERAL or o.modality == Observation.INSPECTION) then
		table.insert(out, `unknown modality '{o.modality}'`)
	end
	if not table.find(Observation.CATEGORIES, o.category) then
		table.insert(out, `unknown category '{o.category}'`)
	end
	if not isFinite(o.confidence) or o.confidence < 0.0 or o.confidence > 1.0 then
		table.insert(out, `confidence {o.confidence} is not in [0, 1]`)
	end
	if o.observedTick < 0 then
		table.insert(out, "negative tick")
	end
	if not vectorIsFinite(o.direction) or math.abs(o.direction.Magnitude - 1.0) > 1e-3 then
		table.insert(out, "direction is not a unit vector")
	end
	if o.hasPosition and not vectorIsFinite(o.estimatedPosition) then
		table.insert(out, "estimated position is not finite")
	end
	if o.modality == Observation.PERIPHERAL and o.hasPosition then
		table.insert(out, "a peripheral observation carries no position")
	end
	if o.modality == Observation.PERIPHERAL and (o.category ~= Observation.MOVEMENT or o.targetId ~= "") then
		table.insert(out, "a peripheral observation has no category beyond movement and no resolved target")
	end
	if o.modality == Observation.INSPECTION and not o.hasPosition then
		table.insert(out, "an inspection carries a position")
	end
	if not isFinite(o.speedWuS) or o.speedWuS < 0.0 then
		table.insert(out, "speed is not a finite, non-negative number")
	end
	return out
end

function Observation.isValid(o: Observation): boolean
	return #Observation.problems(o) == 0
end

-- The spec's fields as a plain table; the position is nil unless the record carries one (a cue's record has no position to read).
function Observation.toDict(o: Observation): { [string]: any }
	return {
		observerId = o.observerId,
		targetId = o.targetId,
		trackId = o.trackId,
		estimatedPosition = if o.hasPosition then o.estimatedPosition else nil,
		direction = o.direction,
		modality = o.modality,
		confidence = o.confidence,
		observedTick = o.observedTick,
		category = o.category,
	}
end

return Observation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">ObservationMemory</string>
            <string name="Source"><![CDATA[--!strict
-- ObservationMemory (spec 7, 21.3): what the observer remembers of what it sensed. A port of the frozen Godot
-- scripts/perception/observation_memory.gd (c87ce00), method for method. The sensor hands it Observation records; it keeps one Contact
-- per thing the sensor keeps sensing (a "track"), ages them, and says what is still sensed, what has been lost and what has gone. It
-- never looks at the world: a contact changes only when an observation arrives, when time passes, or when the sensor reports that the
-- remembered spot was inspected and is empty.
--
-- A contact is LIVE while observations keep coming (a peripheral cue repeats every cue cooldown, an inspection every tick) and LOST once
-- none has arrived for the hold time of its modality. A lost contact's confidence falls in a straight line from what it was at the loss to
-- nothing over `decayS` (6 s), and the contact is forgotten at that point. A lost contact that was inspected has a mark (A-002): its last
-- observed position, which never moves, because the only thing that can move a position is a new inspection.
--
-- Which contact an observation belongs to is the sensor's decision, taken from evidence (A-027, D-040): a contact is the spider's
-- hypothesis that some observations are of one visible thing, not the thing's identity in the world. The memory only keeps what it is
-- told, and can fold a contact it knew only from cues into the lost contact it turned out to be (merge). The world id of a thing it is
-- looking at is kept on the contact for as long as sight lasts (targetId) and dropped the moment sight is lost.
--
-- What a peripheral cue may and may not do (spec 7: coarse directional evidence, no label): it starts a contact, and it keeps a contact
-- that is only cues alive. It never gives a position, never changes the category, the confidence or the position of a contact that has
-- been inspected, and never brings an inspected contact back from lost: that takes another inspection (a reacquisition). What the cue
-- did say, a bearing, is kept apart (cueTick, cueDirection) for the presentation's edge markers.
--
-- Differences from Godot that change no decision: the five signals are Signal objects (memory.contactAcquired:connect(fn)); contacts
-- are walked oldest first (creation order) wherever Godot walks a dictionary, so announcements come in a fixed order.
local Observation = require(script.Parent.Observation)
local PerceptionMath = require(script.Parent.PerceptionMath)
local Signal = require(script.Parent.Signal)

local PERIPHERAL, INSPECTION = Observation.PERIPHERAL, Observation.INSPECTION

-- =============================================================================================== Contact

local Contact = {}
Contact.__index = Contact
Contact.LIVE = "live"
Contact.LOST = "lost"

export type Contact = {
	trackId: string,
	observerId: string,
	-- The world id of the thing this contact is live-linked to (spec 21.3: target, only when resolved), for validated interaction and
	-- nothing else. Set while an inspection has resolved the thing, dropped the moment the contact is lost, and never used to decide
	-- which contact an observation belongs to (A-027).
	targetId: string,
	state: string,
	-- Modality of the latest evidence that updated the record (a cue on an inspected contact does not).
	modality: string,
	category: string,
	-- What the contact is believed to be worth now: the latest evidence's while live, falling after a loss.
	confidence: number,
	confidenceAtLoss: number,
	-- The last observed position: only an inspection gives one, and only another inspection changes it.
	hasPosition: boolean,
	position: Vector3,
	positionTick: number,
	sizeWu: number,
	apparentSizeDeg: number,
	-- How fast it was seen moving at the last inspection, WU/s.
	speedWuS: number,
	-- Latest direction from the observer of the evidence that updated the record (coarse for a cue).
	direction: Vector3,
	firstTick: number,
	-- Tick of the latest evidence that updated the record.
	observedTick: number,
	-- The latest peripheral cue, apart from the record: its tick, its coarse bearing and how many there have been.
	cueTick: number,
	cueDirection: Vector3,
	cueCount: number,
	lostTick: number,
	reacquisitions: number,
	-- False once the mark was found to be wrong (the spot was inspected and is empty).
	markValid: boolean,
	-- Creation order: "oldest first" breaks ties with it.
	seq: number,
}

function Contact.new(): Contact
	return setmetatable({
		trackId = "",
		observerId = "",
		targetId = "",
		state = Contact.LIVE,
		modality = PERIPHERAL,
		category = Observation.MOVEMENT,
		confidence = 0.0,
		confidenceAtLoss = 0.0,
		hasPosition = false,
		position = Vector3.zero,
		positionTick = 0,
		sizeWu = 0.0,
		apparentSizeDeg = 0.0,
		speedWuS = 0.0,
		direction = Vector3.new(0, 0, -1),
		firstTick = 0,
		observedTick = 0,
		cueTick = -1000000,
		cueDirection = Vector3.zero,
		cueCount = 0,
		lostTick = 0,
		reacquisitions = 0,
		markValid = true,
		seq = 0,
	}, Contact) :: any
end

function Contact.isLive(c: Contact): boolean
	return c.state == Contact.LIVE
end

-- Live and being inspected: the position is where it is being seen now.
function Contact.isInspectedNow(c: Contact): boolean
	return c.state == Contact.LIVE and c.modality == INSPECTION
end

function Contact.hasMark(c: Contact): boolean
	return c.state == Contact.LOST and c.hasPosition and c.markValid
end

function Contact.toDict(c: Contact): { [string]: any }
	return {
		trackId = c.trackId,
		targetId = c.targetId,
		state = c.state,
		modality = c.modality,
		category = c.category,
		confidence = c.confidence,
		hasPosition = c.hasPosition,
		position = if c.hasPosition then c.position else nil,
		observedTick = c.observedTick,
		positionTick = c.positionTick,
		lostTick = c.lostTick,
	}
end

-- =============================================================================================== Memory

local ObservationMemory = {}
ObservationMemory.__index = ObservationMemory
ObservationMemory.Contact = Contact

export type ObservationMemory = {
	-- Ticks a second lasts (the physics rate), the seconds a lost contact's confidence takes to fall to nothing, and how long a contact
	-- may go without new evidence before it counts as lost.
	hz: number,
	decayS: number,
	holdInspectionS: number,
	holdPeripheralS: number,
	-- The tick the memory was last advanced to.
	nowTick: number,
	-- How many observations were ever ingested, by modality; for tests and the debug view.
	ingested: number,
	ingestedInspection: number,
	ingestedPeripheral: number,
	-- A new contact, or a track picked up again after it had been forgotten.
	contactAcquired: Signal.Signal,
	-- (contact, oldCategory, newCategory): the category a contact is believed to be refined (up) or fell back (down).
	categoryChanged: Signal.Signal,
	-- Sight of a contact ended: its hold time ran out with no new observation.
	contactLost: Signal.Signal,
	-- A lost contact was observed again: the same track, its record updated.
	contactReacquired: Signal.Signal,
	-- (contact, reason): a contact left the memory: "expired" (its confidence reached nothing), "empty" (the sensor inspected the
	-- remembered spot and found nothing there), "merged" (a contact known only from cues turned out to be a lost one) or "captured".
	contactEnded: Signal.Signal,
	_contacts: { [string]: Contact },
	_seq: number,
}

function ObservationMemory.new(): any
	return setmetatable({
		hz = 60.0,
		decayS = 6.0,
		holdInspectionS = 0.15,
		holdPeripheralS = 1.0,
		nowTick = 0,
		ingested = 0,
		ingestedInspection = 0,
		ingestedPeripheral = 0,
		contactAcquired = Signal.new(),
		categoryChanged = Signal.new(),
		contactLost = Signal.new(),
		contactReacquired = Signal.new(),
		contactEnded = Signal.new(),
		_contacts = {},
		_seq = 0,
	}, ObservationMemory)
end

function ObservationMemory.configure(self: any, hz: number, decayS: number, holdInspectionS: number, holdPeripheralS: number)
	self.hz = math.max(hz, 1.0)
	self.decayS = math.max(decayS, 0.01)
	self.holdInspectionS = math.max(holdInspectionS, 0.0)
	self.holdPeripheralS = math.max(holdPeripheralS, 0.0)
end

function ObservationMemory.clear(self: any)
	self._contacts = {}
end

function ObservationMemory.getContact(self: any, trackId: string): Contact?
	return self._contacts[trackId]
end

function ObservationMemory.count(self: any): number
	local n = 0
	for _ in self._contacts do
		n += 1
	end
	return n
end

-- Every contact, oldest first.
function ObservationMemory.contacts(self: any): { Contact }
	local out: { Contact } = {}
	for _, c in self._contacts do
		table.insert(out, c)
	end
	table.sort(out, function(a: Contact, b: Contact): boolean
		if a.firstTick ~= b.firstTick then
			return a.firstTick < b.firstTick
		end
		return a.seq < b.seq
	end)
	return out
end

local function filtered(list: { Contact }, keep: (Contact) -> boolean): { Contact }
	local out: { Contact } = {}
	for _, c in list do
		if keep(c) then
			table.insert(out, c)
		end
	end
	return out
end

function ObservationMemory.liveContacts(self: any): { Contact }
	return filtered(self:contacts(), function(c) return c.state == Contact.LIVE end)
end

function ObservationMemory.lostContacts(self: any): { Contact }
	return filtered(self:contacts(), function(c) return c.state == Contact.LOST end)
end

-- Lost contacts that were inspected and whose spot has not been found empty: the last-seen marks.
function ObservationMemory.marks(self: any): { Contact }
	return filtered(self:contacts(), function(c) return Contact.hasMark(c) end)
end

-- Seconds since sight of a lost contact ended; 0 for a live one.
function ObservationMemory.ageS(self: any, c: Contact): number
	if c.state == Contact.LIVE then
		return 0.0
	end
	return (self.nowTick - c.lostTick) / self.hz
end

-- How much of a thing's earlier inspection still counts if it is seen again: 1 for a live contact, falling to 0 as the memory of a lost one
-- fades, 0 for a track that is gone.
function ObservationMemory.familiarity(self: any, trackId: string): number
	local c = self._contacts[trackId]
	if c == nil then
		return 0.0
	end
	if c.state == Contact.LIVE then
		return 1.0
	end
	return PerceptionMath.decayedConfidence(1.0, self:ageS(c), self.decayS)
end

-- Seconds since the evidence that last updated the record.
function ObservationMemory.observedAgeS(self: any, c: Contact): number
	return (self.nowTick - c.observedTick) / self.hz
end

-- Seconds since the latest peripheral cue (a very large number if there never was one).
function ObservationMemory.cueAgeS(self: any, c: Contact): number
	return (self.nowTick - c.cueTick) / self.hz
end

-- 0 for a live contact and for one just lost, 1 when its memory is gone (the mark is at its stalest).
function ObservationMemory.stalenessOf(self: any, c: Contact): number
	if c.state == Contact.LIVE then
		return 0.0
	end
	return PerceptionMath.staleness(self:ageS(c), self.decayS)
end

-- Ticks a contact may go without evidence of this modality before it counts as lost. The sensor reads the same number to tell unbroken
-- sight (the thing is still the same contact) from sight that was lost.
function ObservationMemory.holdTicks(self: any, modality: string): number
	return math.round((if modality == INSPECTION then self.holdInspectionS else self.holdPeripheralS) * self.hz)
end

-- Take in one observation. A record that is not valid (spec 21.3) is refused and returns nil.
function ObservationMemory.ingest(self: any, obs: Observation.Observation?): Contact?
	if obs == nil or not Observation.isValid(obs) then
		return nil
	end
	self.ingested += 1
	local existing: Contact? = self._contacts[obs.trackId]
	local fresh = existing == nil
	local wasLost = false
	local c: Contact
	if existing == nil then
		c = Contact.new()
		c.trackId = obs.trackId
		c.observerId = obs.observerId
		c.firstTick = obs.observedTick
		c.category = obs.category
		self._seq += 1
		c.seq = self._seq
		self._contacts[c.trackId] = c
	else
		c = existing
		wasLost = c.state == Contact.LOST
	end
	if obs.modality == PERIPHERAL then
		self.ingestedPeripheral += 1
		c.cueTick = obs.observedTick
		c.cueDirection = obs.direction
		c.cueCount += 1
		if not fresh and c.hasPosition then
			return c -- a bearing says nothing new about something that was inspected (see the header)
		end
	end
	local oldCategory = c.category
	c.state = Contact.LIVE
	c.modality = obs.modality
	c.confidence = obs.confidence
	c.observedTick = obs.observedTick
	c.direction = obs.direction
	if obs.targetId ~= "" then
		c.targetId = obs.targetId
	end
	if obs.modality == INSPECTION then
		self.ingestedInspection += 1
		c.hasPosition = true
		c.position = obs.estimatedPosition
		c.positionTick = obs.observedTick
		c.sizeWu = obs.sizeWu
		c.apparentSizeDeg = obs.apparentSizeDeg
		c.speedWuS = obs.speedWuS
		c.markValid = true
		c.category = obs.category
	end
	if fresh then
		self.contactAcquired:emit(c)
	elseif wasLost then
		c.reacquisitions += 1
		self.contactReacquired:emit(c)
	end
	if c.category ~= oldCategory then
		self.categoryChanged:emit(c, oldCategory, c.category)
	end
	return c
end

-- The ids of the contacts, oldest first (the order Godot's dictionary keeps them in).
local function orderedIds(self: any): { string }
	local list: { Contact } = {}
	for _, c in self._contacts do
		table.insert(list, c)
	end
	table.sort(list, function(a: Contact, b: Contact): boolean
		return a.seq < b.seq
	end)
	local ids: { string } = {}
	for _, c in list do
		table.insert(ids, c.trackId)
	end
	return ids
end

-- Moves time on to `tick`: live contacts that have had no evidence for their hold time become lost, lost contacts lose confidence, and
-- those with none left are forgotten.
function ObservationMemory.advance(self: any, tick: number)
	self.nowTick = tick
	for _, id in orderedIds(self) do
		local c: Contact? = self._contacts[id]
		if c == nil then
			continue
		end
		if c.state == Contact.LIVE then
			if tick - c.observedTick > self:holdTicks(c.modality) then
				c.state = Contact.LOST
				c.lostTick = tick
				c.confidenceAtLoss = c.confidence
				c.targetId = "" -- sight is over: the link to the world goes with it
				self.contactLost:emit(c)
			end
		end
		if c.state == Contact.LOST then
			local age = (tick - c.lostTick) / self.hz
			c.confidence = PerceptionMath.decayedConfidence(c.confidenceAtLoss, age, self.decayS)
			if age >= self.decayS - 1e-9 then
				self._contacts[id] = nil
				self.contactEnded:emit(c, "expired")
			end
		end
	end
end

-- The sensor found that a contact it knew only from cues (it has no position) is the lost contact `intoId`, seen again: the bearing of
-- the latest cue and the count of cues go to that record, and the cue-only contact is dropped (reason "merged"). Returns false when either
-- is missing or the one to fold has a position of its own (an inspected contact is never folded into another).
function ObservationMemory.merge(self: any, fromId: string, intoId: string): boolean
	local a: Contact? = self._contacts[fromId]
	local b: Contact? = self._contacts[intoId]
	if a == nil or b == nil or a == b or a.hasPosition then
		return false
	end
	if a.cueTick > b.cueTick then
		b.cueTick = a.cueTick
		b.cueDirection = a.cueDirection
	end
	b.cueCount += a.cueCount
	self._contacts[fromId] = nil
	self.contactEnded:emit(a, "merged")
	return true
end

-- The sensor looked at a lost contact's last observed position, clearly and for long enough, and nothing was there: the memory of the
-- spot is wrong, so it is dropped. Returns false for a contact that is not lost.
function ObservationMemory.invalidate(self: any, trackId: string, reason: string?): boolean
	local c: Contact? = self._contacts[trackId]
	if c == nil or c.state ~= Contact.LOST then
		return false
	end
	c.markValid = false
	c.confidence = 0.0
	self._contacts[trackId] = nil
	self.contactEnded:emit(c, reason or "empty")
	return true
end

-- The sensor resolved a capture by a live link or unique spatial bodily evidence.
function ObservationMemory.resolveCapture(self: any, trackId: string): boolean
	local c: Contact? = self._contacts[trackId]
	if c == nil then
		return false
	end
	self._contacts[trackId] = nil
	self.contactEnded:emit(c, "captured")
	return true
end

return ObservationMemory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">PerceptionMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pure helpers for the perception layer (spec 7): angles, apparent size, the exposure a classification needs, the evidence's
-- confidence, the coarse direction a peripheral cue is given, how a remembered contact fades. A port of the frozen Godot
-- scripts/perception/perception_math.gd (c87ce00), function for function, with the same numbers. Nothing here touches the scene.
-- Checked against values exported from Godot (tests/perception_reference.json) and against the hand-written expectations of Godot's
-- own unit tests (tests/unit/test_perception_math.gd), both in tests/perception.luau.
local Observation = require(script.Parent.Observation)

local PerceptionMath = {}

local EPS = 1e-6
PerceptionMath.EPS = EPS
-- A peripheral cue is given a direction in sectors of the observer's own bearing, and in coarse bands of elevation.
PerceptionMath.PITCH_BAND_DEG = 30.0
-- Visibility of a sample point (A-024, D-039). A ray the world stops short of its sample point has not seen it: the world is in front of
-- it. The only allowance is for a sample that lies in the skin of the surface the thing rests on or against and for the float error of a
-- long cast: SIGHT_SHARE of the thing's own radius plus SIGHT_FLOAT_PER_WU for each WU of ray, and never more than SIGHT_CEILING.
PerceptionMath.SIGHT_SHARE = 0.1
PerceptionMath.SIGHT_FLOAT_PER_WU = 1.0e-5
PerceptionMath.SIGHT_CEILING = 0.05

local function isFinite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

-- Godot's Vector3.normalized(): a vector with no length stays zero.
local function normalized(v: Vector3): Vector3
	local m = v.Magnitude
	if m == 0 then
		return Vector3.zero
	end
	return v / m
end

-- How far short of its sample point a ray may be stopped by the world and still count as having seen it (A-024). The sample points sit up
-- to 0.8 of the radius off the centre, so for a thing of radius r the allowance is a tenth of r: a speck's whole body is never inside it,
-- and a large thing resting on a wall still has the points that lie in the wall's face counted.
function PerceptionMath.sightTolerance(radius: number, rayLength: number): number
	return math.min(
		PerceptionMath.SIGHT_CEILING,
		PerceptionMath.SIGHT_SHARE * math.max(radius, 0.0) + PerceptionMath.SIGHT_FLOAT_PER_WU * math.max(rayLength, 0.0)
	)
end

-- The furthest a lost contact's thing can be from where it was last observed when something is seen `elapsedS` later (A-027, D-040).
-- Three parts, each an observation or an explicit assumption and none of them the truth about where the thing went: the sizes of the two
-- sightings (a position is only good to about the size of what it was taken from), and the distance the thing could have covered in the
-- time at the conservative speed bound, or at the speed it was last seen moving at if that was greater.
function PerceptionMath.plausibleRadius(oldSizeWu: number, newSizeWu: number, elapsedS: number, speedBound: number, observedSpeed: number): number
	return 0.5 * (math.max(oldSizeWu, 0.0) + math.max(newSizeWu, 0.0)) + math.max(speedBound, observedSpeed) * math.max(elapsedS, 0.0)
end

-- Whether two size estimates can belong to one thing: neither is more than `ratio` times the other. A size that is not known (zero) is
-- compatible with anything.
function PerceptionMath.sizesCompatible(a: number, b: number, ratio: number): boolean
	if a <= EPS or b <= EPS then
		return true
	end
	return math.max(a, b) <= math.min(a, b) * math.max(ratio, 1.0) + EPS
end

-- Whether a lost contact refined to `oldCategory` can be a thing whose appearance can be refined no further than `cap`: what was learned
-- about the one cannot be finer than the other can ever look.
function PerceptionMath.categoriesCompatible(oldCategory: string, cap: string): boolean
	return Observation.rank(oldCategory) <= Observation.rank(cap)
end

-- Angle between two vectors (Godot's Vector3.angle_to, which needs no unit length), radians.
function PerceptionMath.angleTo(a: Vector3, b: Vector3): number
	return math.atan2(a:Cross(b).Magnitude, a:Dot(b))
end

-- Angle between two directions, radians; 0 when either has no length.
function PerceptionMath.angleBetween(a: Vector3, b: Vector3): number
	if a:Dot(a) < EPS * EPS or b:Dot(b) < EPS * EPS then
		return 0.0
	end
	return PerceptionMath.angleTo(normalized(a), normalized(b))
end

-- True when `to` lies within `halfAngle` (radians) of `axis`.
function PerceptionMath.inCone(axis: Vector3, to: Vector3, halfAngle: number): boolean
	return to:Dot(to) > EPS * EPS and PerceptionMath.angleBetween(axis, to) <= halfAngle + 1e-9
end

-- How large a thing of `sizeWu` across looks from `distance`, degrees of angle.
function PerceptionMath.apparentSizeDeg(sizeWu: number, distance: number): number
	if distance <= EPS then
		return 180.0
	end
	return math.deg(2.0 * math.atan(sizeWu * 0.5 / distance))
end

-- Continuous exposure a refinement needs: `baseS` for an easy target (one that looks at least `easyDeg` across), and proportionally
-- longer the smaller it looks. Infinite for something with no apparent size.
function PerceptionMath.requiredExposure(baseS: number, apparentDeg: number, easyDeg: number): number
	if apparentDeg <= EPS then
		return math.huge
	end
	return baseS * math.max(1.0, easyDeg / apparentDeg)
end

-- The category continuous exposure supports. Nothing smaller than `minDeg` is refined at all.
function PerceptionMath.classify(exposureS: number, apparentDeg: number, easyS: number, flyS: number, easyDeg: number, minDeg: number): string
	if apparentDeg < minDeg then
		return Observation.MOVEMENT
	end
	if exposureS + EPS >= PerceptionMath.requiredExposure(flyS, apparentDeg, easyDeg) then
		return Observation.FLY_LIKE_PREY
	end
	if exposureS + EPS >= PerceptionMath.requiredExposure(easyS, apparentDeg, easyDeg) then
		return Observation.POSSIBLE_PREY
	end
	return Observation.MOVEMENT
end

-- Confidence of an inspection: it rises with exposure (to the fly-like refinement) and falls with how much of the thing is hidden. From
-- 0.4 x 0.68 = 0.27 (one of five sample points seen, no exposure yet) to 1.
function PerceptionMath.inspectionConfidence(exposureS: number, flyNeededS: number, visibleFraction: number): number
	local progress = 0.0
	if isFinite(flyNeededS) then
		progress = math.clamp(exposureS / math.max(flyNeededS, EPS), 0.0, 1.0)
	end
	return math.clamp((0.4 + 0.6 * progress) * (0.6 + 0.4 * math.clamp(visibleFraction, 0.0, 1.0)), 0.0, 1.0)
end

-- Confidence of a peripheral cue: low, and a little higher the nearer it is. In [0.1, 0.3].
function PerceptionMath.peripheralConfidence(distance: number, rangeWu: number): number
	return math.clamp(0.1 + 0.2 * (1.0 - distance / math.max(rangeWu, EPS)), 0.1, 0.3)
end

-- The direction of a peripheral cue, coarse: its bearing about `up` from `forward` rounded to a sector, its elevation to a band of
-- PITCH_BAND_DEG. Returns a unit vector. This is all a peripheral observation says about where.
function PerceptionMath.quantizeDirection(dir: Vector3, forward: Vector3, up: Vector3, sectorDeg: number): Vector3
	local d = normalized(dir)
	local u = normalized(up)
	local f = forward - u * forward:Dot(u)
	if f:Dot(f) < EPS then
		f = d - u * d:Dot(u)
	end
	if f:Dot(f) < EPS then
		return d -- straight up or down: there is no bearing to round
	end
	f = normalized(f)
	local right = normalized(f:Cross(u))
	local yaw = math.atan2(d:Dot(right), d:Dot(f))
	local pitch = math.asin(math.clamp(d:Dot(u), -1.0, 1.0))
	local sector = math.rad(math.max(sectorDeg, 0.5))
	local band = math.rad(PerceptionMath.PITCH_BAND_DEG)
	local yq = math.round(yaw / sector) * sector
	local pq = math.round(pitch / band) * band
	return normalized(f * (math.cos(pq) * math.cos(yq)) + right * (math.cos(pq) * math.sin(yq)) + u * math.sin(pq))
end

-- Confidence of a contact that is no longer sensed: it falls straight to nothing over `decayS`, from the confidence it had when it was lost.
function PerceptionMath.decayedConfidence(confidenceAtLoss: number, ageS: number, decayS: number): number
	if decayS <= EPS then
		return 0.0
	end
	return math.clamp(confidenceAtLoss * (1.0 - ageS / decayS), 0.0, 1.0)
end

-- 0 when a contact has only just been lost, 1 when its memory is gone.
function PerceptionMath.staleness(ageS: number, decayS: number): number
	if decayS <= EPS then
		return 1.0
	end
	return math.clamp(ageS / decayS, 0.0, 1.0)
end

return PerceptionMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">Sensor</string>
            <string name="Source"><![CDATA[--!strict
-- Sensor: the world half of Godot's SensorSystem (scripts/perception/sensor_system.gd, c87ce00). SensorCore keeps what needs no world (which
-- contact a sighting is filed under, how long a thing has been in view, the cue and its cooldown, the empty-spot check); this is what looks.
-- Each tick it reads the observer's eye and gaze (never the camera's), takes the percept of every perceivable thing and decides what the
-- senses could pick up of it:
--   * a thing inside the broad peripheral field that moves and can be seen through at least one of its sample points gives a PERIPHERAL cue:
--     a coarse bearing and nothing else, at most once per cue cooldown for each thing;
--   * a thing inside the narrow inspection cone along the gaze that can be seen, and looks big enough, is INSPECTED: its position is
--     estimated from the points that could be seen, and the longer it is held in the cone without a break the finer the category.
-- Line of sight is five rays from the eye to sample points of the thing; a point the world stands in front of does not count. Nothing about a
-- thing that cannot be seen reaches the memory: a hidden thing makes no observation, and the memory is never refreshed from where it
-- really is. The sensor also looks at the spots where lost contacts were last seen (SensorCore.checkSpots, through _allVisible below).
--
-- Ported method for method from _physics_process (in its order), _sense, _visible_points, _sample_points, _clear, _all_visible, could_sense,
-- describe_tracks, _record_cost, cost_percentile and reset. Not here: on_capture (the feeding chunk), Focus, and any presentation.
--
-- How a caller drives it: once at the START of every fixed tick (Godot's sensor runs at priority -10, before the motor and the things that
-- move, so it reads the world as the previous tick committed it):
--
--   sensor:step(delta, observer, percepts, cast)
--     observer  {eye, gaze, up, heading}: where the eyes are, the axis of the cone, the body's up and facing (the motor's observer())
--     percepts  one SensorCore.Percept for every perceivable thing that is there to be sensed (a thing that is not simply is not listed)
--     cast      (from, to) -> the position of the first WORLD hit on that segment, nil when it is clear. Only world geometry may stop it:
--               not the observer, not the things sensed (Sensor.workspaceCast makes one from a RaycastParams).
--
-- Rates (spec 20): the broad scan of everything runs at broad_query_hz; things already tracked (a live contact), things whose last position
-- is remembered as a mark, and things within close_check_range_wu of the eye are checked every tick. Tick numbering is Godot's: the tick
-- counts up first (SensorCore.beginTick), so the first broad scan is tick 1 and the next is due 6 ticks later.
--
-- Where the counts live: the sensor's own are fields here (broadScans, rays, checks, cost); the ones SensorCore keeps for the bookkeeping it
-- does are read from sensor.core (tick, cuesMade, inspectionsMade, spotChecksTotal and the cueEmitted signal).
local PerceptionMath = require(script.Parent.PerceptionMath)
local SensorCore = require(script.Parent.SensorCore)
local ObservationMemory = require(script.Parent.ObservationMemory)

local Contact = ObservationMemory.Contact

local Sensor = {}
Sensor.__index = Sensor

Sensor.SAMPLE_COUNT = 5
-- The sample points sit this share of a thing's radius off its centre.
Sensor.SAMPLE_SPREAD = 0.8
-- CPU time of the sensor tick in microseconds: a ring of the latest, for percentiles.
Sensor.COST_RING = 1200
-- T13a, the lateral eyes' motion sense (the spider-eye picture's shimmer): an entry stays this long after the thing was last seen moving.
Sensor.MOTION_HOLD_TICKS = 15

-- The observer the sensor reads (Godot: get_eye_position, get_gaze_direction, get_visual_up, get_heading_vector).
export type Observer = { eye: Vector3, gaze: Vector3, up: Vector3, heading: Vector3 }
-- The position of the first world hit on the segment from, to; nil when nothing of the world is in the way.
export type Cast = (Vector3, Vector3) -> Vector3?
-- What the last check of a thing found, for the developer view (Godot's Track.last_check): the fields appear as the check passes them.
export type Check = {
	inRange: boolean,
	distance: number,
	offAxisDeg: number?,
	visiblePoints: number?,
	inCone: boolean?,
	apparentDeg: number?,
}
-- T13a: a thing the eyes could see moving on its last check: the sensed direction from the eye, the distance, how big it looked, the tick.
export type Moving = { direction: Vector3, distance: number, apparent: number, tick: number }
export type TrackRow = {
	perceptId: string,
	trackId: string,
	exposureS: number,
	inRange: boolean?,
	distance: number?,
	offAxisDeg: number?,
	visiblePoints: number?,
	inCone: boolean?,
	apparentDeg: number?,
}

local EPS = 1e-6

-- Godot's Vector3.normalized(): a vector with no length stays zero.
local function normalized(v: Vector3): Vector3
	local m = v.Magnitude
	if m == 0 then
		return Vector3.zero
	end
	return v / m
end

function Sensor.new(memory: any, observerId: string?): any
	return setmetatable({
		memory = memory,
		core = SensorCore.new(memory, observerId),
		enabled = true,
		-- Statistics, for tests and the developer view.
		broadScans = 0,
		raysThisTick = 0,
		maxRaysInATick = 0,
		raysTotal = 0,
		checksThisTick = 0,
		checksTotal = 0,
		-- The memory-spot checks' rays (also counted in raysTotal); their number of checks is core.spotChecksTotal.
		spotRaysTotal = 0,
		-- CPU time of the ticks that did the work, microseconds: the total, the largest and a ring of the latest for percentiles.
		cpuUsTotal = 0,
		cpuTicks = 0,
		cpuUsMax = 0,
		-- What the observer's eyes, gaze and up were on the last tick (the developer view draws the cones from them).
		lastEye = Vector3.zero,
		lastAxis = Vector3.new(0, 0, -1),
		lastUp = Vector3.new(0, 1, 0),
		-- T13a, for the spider-eye picture only: nothing reads it to decide anything and it holds only what the sightline checks found.
		motionSeen = {} :: { [string]: Moving },
		_checks = {} :: { [string]: Check },
		_nextBroadTick = 0,
		_ring = {} :: { number },
		_costBase = 0,
	}, Sensor)
end

-- Takes the perception section of a species profile (Species.<id>.perception) and sets the memory's timing to match.
function Sensor.configureFrom(self: any, perception: { [string]: number })
	self.core:configureFrom(perception)
end

function Sensor.getTrack(self: any, perceptId: string): SensorCore.Track?
	return self.core:getTrack(perceptId)
end

-- The track a percept id is filed under, "" if it was never sensed. Tests and the developer view only.
function Sensor.trackIdFor(self: any, perceptId: string): string
	return self.core:trackIdFor(perceptId)
end

-- What the last check of a thing found (Godot: get_track(id).last_check); nil for a thing that has no track.
function Sensor.lastCheck(self: any, perceptId: string): Check?
	return self._checks[perceptId]
end

-- Forget everything about what is being tracked (the memory is cleared separately). The tick and the statistics go on.
function Sensor.reset(self: any)
	self.core:reset()
	self.motionSeen = {}
	self._checks = {}
	self._nextBroadTick = 0
end

-- ================================================================================================ the tick

-- One physics tick of the senses (Godot _physics_process): see the header for what the caller passes.
function Sensor.step(self: any, delta: number, observer: Observer, percepts: { SensorCore.Percept }, cast: Cast)
	self.raysThisTick = 0
	self.checksThisTick = 0
	if not self.enabled then
		return
	end
	local t0 = os.clock()
	local core = self.core
	local tick: number = core:beginTick(delta) -- the tick counts up and every track's gap since it was last inspected grows
	local eye, axis, up, forward = observer.eye, observer.gaze, observer.up, observer.heading
	self.lastEye, self.lastAxis, self.lastUp = eye, axis, up
	local broadDue = tick >= self._nextBroadTick
	if broadDue then
		self._nextBroadTick = tick + math.max(1, math.round(SensorCore.HZ / math.max(core.broadHz, 0.1)))
		self.broadScans += 1
	end
	local inspected: { SensorCore.Inspected } = {}
	local sightings: { SensorCore.Sighting } = {}
	local present: { [string]: boolean } = {}
	for _, p in percepts do
		present[p.id] = true
		local t = core:trackOf(p.id)
		local c: ObservationMemory.Contact? = if t.trackId ~= "" then core.memory:getContact(t.trackId) else nil
		local watching = c ~= nil and (c.state == Contact.LIVE or Contact.hasMark(c))
		if broadDue or watching or (p.position - eye).Magnitude <= core.closeRangeWu then
			self.checksThisTick += 1
			self.checksTotal += 1
			self:_sense(t, p, eye, axis, up, forward, cast, delta, inspected, sightings)
		end
	end
	core:fileSightings(sightings, delta)
	core:checkSpots(eye, axis, up, delta, inspected, function(from: Vector3, center: Vector3, radius: number, u: Vector3): boolean
		return self:_allVisible(cast, from, center, radius, u)
	end)
	core:endTick(present) -- the memory moves on to this tick, then the tracks of things that are no longer there go
	for id in self._checks do
		if not present[id] then
			self._checks[id] = nil
		end
	end
	for id, m in self.motionSeen do
		if not present[id] or tick - m.tick > Sensor.MOTION_HOLD_TICKS then
			self.motionSeen[id] = nil
		end
	end
	self.maxRaysInATick = math.max(self.maxRaysInATick, self.raysThisTick)
	self:_recordCost(math.floor((os.clock() - t0) * 1.0e6 + 0.5))
end

-- What the eyes make of one thing (Godot _sense): in range, inside the peripheral field, the sample points that could be seen, and then
-- either an inspection (in the cone and big enough to look at) or, if it moves, a cue.
function Sensor._sense(self: any, t: SensorCore.Track, p: SensorCore.Percept, eye: Vector3, axis: Vector3, up: Vector3, forward: Vector3, cast: Cast, delta: number, inspected: { SensorCore.Inspected }, sightings: { SensorCore.Sighting })
	local core = self.core
	local center = p.position
	local radius = math.max(p.radius, 0.01)
	local to = center - eye
	local dist = to.Magnitude
	local reach: number = core:reachWu()
	local check: Check = { inRange = dist <= reach, distance = dist }
	self._checks[p.id] = check
	if dist > reach or dist < SensorCore.MIN_DISTANCE then
		return
	end
	local dir = to / dist
	local offAxis = PerceptionMath.angleTo(axis, dir)
	check.offAxisDeg = math.deg(offAxis)
	if offAxis > math.rad(core.peripheralConeDeg) * 0.5 then
		return
	end
	local seen = self:_visiblePoints(cast, eye, center, radius, up)
	check.visiblePoints = #seen
	if #seen == 0 then
		return
	end
	local estimate = Vector3.zero
	for _, s in seen do
		estimate += s
	end
	estimate /= #seen
	local estDir = normalized(estimate - eye)
	local apparent = PerceptionMath.apparentSizeDeg(2.0 * radius, dist)
	local inCone = offAxis <= math.rad(core.coneDeg) * 0.5
	check.inCone = inCone
	check.apparentDeg = apparent
	local visibleFraction = #seen / Sensor.SAMPLE_COUNT
	local speed = p.velocity.Magnitude
	if speed >= core.motionMinSpeed then
		self.motionSeen[p.id] = { direction = estDir, distance = dist, apparent = apparent, tick = core.tick }
	end
	if inCone and apparent >= core.minApparentDeg then
		table.insert(sightings, { t = t, p = p, estimate = estimate, estDir = estDir, apparent = apparent, visibleFraction = visibleFraction })
		table.insert(inspected, { position = estimate, radius = radius })
	elseif speed >= core.motionMinSpeed and core.tick >= t.nextCueTick then
		core:cue(t, estDir, forward, up, dist)
	end
end

-- The sample points of a sphere of `radius` at `center` that the eye can see: the centre and four points a little off it, across the line of
-- sight and along it. An empty list means none could be seen.
function Sensor._visiblePoints(self: any, cast: Cast, eye: Vector3, center: Vector3, radius: number, up: Vector3): { Vector3 }
	local out: { Vector3 } = {}
	for _, s in Sensor.samplePoints(eye, center, radius, up) do
		if self:_clear(cast, eye, s, radius) then
			table.insert(out, s)
		end
	end
	return out
end

-- Godot _sample_points: the centre, then +side, -side, +vert, -vert at SAMPLE_SPREAD of the radius, side across the line of sight and
-- horizontal to the body (d x up; d x right when the thing is straight above or below) and vert across both.
function Sensor.samplePoints(eye: Vector3, center: Vector3, radius: number, up: Vector3): { Vector3 }
	local d = normalized(center - eye)
	local side = d:Cross(up)
	if side:Dot(side) < 1e-6 then
		side = d:Cross(Vector3.new(1, 0, 0))
	end
	side = normalized(side)
	local vert = normalized(side:Cross(d))
	local r = radius * Sensor.SAMPLE_SPREAD
	return { center, center + side * r, center - side * r, center + vert * r, center - vert * r }
end

-- True when the eye can see the sample point `to` of a thing of `radius`: the world stops the ray no further than a small allowance short of
-- it (PerceptionMath.sightTolerance, A-024). A world hit before the point is occlusion; it is not forgiven because the point is near. Every
-- ray is counted.
function Sensor._clear(self: any, cast: Cast, from: Vector3, to: Vector3, radius: number): boolean
	self.raysThisTick += 1
	self.raysTotal += 1
	local hit = cast(from, to)
	if hit == nil then
		return true
	end
	local length = (to - from).Magnitude
	return (hit - from).Magnitude >= length - PerceptionMath.sightTolerance(radius, length)
end

-- A remembered spot is called empty only when every sample point of it is in plain view (the first one the world hides ends the check).
-- The number of spot checks is counted by SensorCore.checkSpots; the rays they used are counted here and also in raysTotal.
function Sensor._allVisible(self: any, cast: Cast, eye: Vector3, center: Vector3, radius: number, up: Vector3): boolean
	local before: number = self.raysTotal
	local all = true
	for _, s in Sensor.samplePoints(eye, center, radius, up) do
		if not self:_clear(cast, eye, s, radius) then
			all = false
			break
		end
	end
	self.spotRaysTotal += self.raysTotal - before
	return all
end

-- ================================================================================================ questions

-- Whether the eye could sense a thing of `radius` at `center` right now: in range, inside the field of the peripheral eyes and at least one of
-- its sample points in plain view, which is exactly what a sensed thing has to pass. Changes no state of the senses; the rays are counted.
-- The prey population asks it before a replacement is let in (it must come in where the spider could not sense it).
function Sensor.couldSense(self: any, observer: Observer, center: Vector3, radius: number, cast: Cast): boolean
	local core = self.core
	local eye = observer.eye
	local to = center - eye
	local dist = to.Magnitude
	if dist > core:reachWu() then
		return false
	end
	if dist < SensorCore.MIN_DISTANCE then
		return true
	end
	if PerceptionMath.angleTo(observer.gaze, to / dist) > math.rad(core.peripheralConeDeg) * 0.5 then
		return false
	end
	return #self:_visiblePoints(cast, eye, center, math.max(radius, 0.01), observer.up) > 0
end

-- Developer view: what the last check of each thing found (distance, off-axis angle, how many points were seen, whether it was in the cone),
-- with the exposure so far. Truth-derived numbers, for developers only: nothing in the player's presentation reads this. Sorted by the
-- world's id.
function Sensor.describeTracks(self: any): { TrackRow }
	local core = self.core
	local out: { TrackRow } = {}
	for pid, t in core._tracks do
		local check: Check? = self._checks[pid]
		local row: TrackRow = {
			perceptId = pid,
			trackId = t.trackId,
			exposureS = if t.gapS <= core.graceS + EPS then t.exposure else 0.0,
		}
		if check ~= nil then
			row.inRange, row.distance, row.offAxisDeg = check.inRange, check.distance, check.offAxisDeg
			row.visiblePoints, row.inCone, row.apparentDeg = check.visiblePoints, check.inCone, check.apparentDeg
		end
		table.insert(out, row)
	end
	table.sort(out, function(a: TrackRow, b: TrackRow): boolean
		return a.perceptId < b.perceptId
	end)
	return out
end

-- ================================================================================================ cost

function Sensor._recordCost(self: any, us: number)
	self.cpuUsTotal += us
	self.cpuUsMax = math.max(self.cpuUsMax, us)
	self._ring[self.cpuTicks % Sensor.COST_RING + 1] = us
	self.cpuTicks += 1
end

-- Ticks measured since the window began (the start of the run, or the last resetCost()).
function Sensor.costTicks(self: any): number
	return self.cpuTicks - self._costBase
end

-- Percentile of the latest measured sensor ticks (since the window began), in microseconds.
function Sensor.costPercentile(self: any, q: number): number
	local n = math.min(self:costTicks(), Sensor.COST_RING)
	if n <= 0 then
		return 0
	end
	local xs: { number } = {}
	for i = 0, n - 1 do
		-- (ROBLOX-91: a checkpoint does not keep the ring, so after a return some of the latest ticks have no reading)
		local us = self._ring[(self.cpuTicks - 1 - i) % Sensor.COST_RING + 1]
		if us ~= nil then table.insert(xs, us) end
	end
	if #xs == 0 then
		return 0
	end
	table.sort(xs)
	return xs[math.clamp(math.ceil(q * #xs), 1, #xs)]
end

-- Begins a new measuring window (the totals, the largest and the percentiles start again).
function Sensor.resetCost(self: any)
	self.cpuUsTotal = 0
	self.cpuUsMax = 0
	self._costBase = self.cpuTicks
end

-- ================================================================================================ the engine's rays

-- A cast made of the engine's raycast: the position of the first hit on the segment, nil when it is clear. The caller decides what the rays
-- may meet in `params` (the sill: not the spider, not the things sensed, not anything drawn only).
function Sensor.workspaceCast(params: RaycastParams): Cast
	return function(from: Vector3, to: Vector3): Vector3?
		local hit = workspace:Raycast(from, to - from, params)
		return if hit ~= nil then hit.Position else nil
	end
end

-- Capture is bodily evidence: no world identity crosses this API.
function Sensor.onCapture(self: any,position: Vector3,radius: number): boolean
 local core=self.core;local matches={}
 for _,c in self.memory:contacts() do
  if c.position and c.sizeWu>0 and (c.state==Contact.LIVE or Contact.hasMark(c)) then
   local age=(core.tick-c.positionTick)/SensorCore.HZ
   local reach=PerceptionMath.plausibleRadius(c.sizeWu,radius*2,age,core.contactSpeedBound,c.speedWuS)
   if (c.position-position).Magnitude<=reach and PerceptionMath.sizesCompatible(c.sizeWu,radius*2,core.contactSizeRatio) then table.insert(matches,c.trackId) end
  end
 end
 if #matches~=1 then return false end
 local id=matches[1];self.memory:resolveCapture(id);core._kept[id]=nil;core._spots[id]=nil
 for pid,t in core._tracks do if t.trackId==id then core._tracks[pid]=nil end end
 return true
end

return Sensor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">SensorCore</string>
            <string name="Source"><![CDATA[--!strict
-- SensorCore: the half of Godot's SensorSystem (scripts/perception/sensor_system.gd, c87ce00) that needs no world. The sensor turns world
-- truth into evidence and nothing more; this is what it does with the evidence once the eye has found it: which contact a sighting is filed
-- under (continuous sight, a lost contact it can only be, or a fresh one), how long a thing has been in view and so how finely it can be
-- classified, the peripheral cue, and the looking at remembered spots that drops a mark when the place is seen empty. Ported method for
-- method from _is_linked, _cue_contact, _file_sightings, _placed_and_unbroken, _inspection_contact, _lost_candidates, _inspect, _cue,
-- _check_spots, _forget_gone and the head and tail of _physics_process. NOT here (the next part of the port): the rays that decide what
-- was in plain view (_sense, _visible_points, _clear, _sample_points), the eye and gaze, the broad scan and its rates, Focus, the
-- developer overlay and the motion shimmer. Capture (on_capture) belongs to the feeding chunk. A caller does what _physics_process does:
--
--   core:beginTick(delta)                      -- tick += 1, every track's gap grows by delta
--   core:trackOf(id)                           -- once per percept that exists, sighted or not (creates its track)
--   core:cue(...)                              -- for each thing that gave a peripheral cue this tick
--   core:fileSightings(sightings, delta)       -- all of the tick's inspections together (the association rule needs them together)
--   core:checkSpots(eye, axis, up, delta, inspected, allVisible)
--   core:endTick(present)                      -- memory:advance(tick), then forget the tracks of things that left the world
--
-- Who is who (A-027, D-040). Three things are kept apart. The world's id for a thing is how the sensor finds it again each tick (the key of
-- _tracks); it is never the spider's idea of who the thing is. A contact (the memory's track id) is the spider's hypothesis that some
-- observations are of one visible thing. Familiarity is what earlier exposure to a contact taught, kept per contact (_kept) and faded with
-- the memory of it. A thing's evidence stays under one contact while sight of it is unbroken: the contact is live and the thing itself was
-- filed under it within the memory's hold time for that kind of evidence. Once sight has been lost the world id decides nothing: a new
-- inspection is compared with the lost contacts by where each was last observed, how long ago, how big it looked, what it can look like and
-- how fast it was seen moving, and is taken for a lost contact only when exactly one of them could be it and no other thing sighted in the
-- same tick could be it either (two look-alikes that come into view together are two fresh contacts, and the order the world lists them in
-- decides nothing); otherwise it is a fresh contact that starts again at "movement" and inherits no exposure. A bare cue has no place to
-- compare, so it is always a weak new contact; the inspection that follows it makes the comparison, and a cue-only contact that turns out
-- to be a lost one is folded into it.
local Observation = require(script.Parent.Observation)
local PerceptionMath = require(script.Parent.PerceptionMath)
local Signal = require(script.Parent.Signal)
local ObservationMemory = require(script.Parent.ObservationMemory)

local Contact = ObservationMemory.Contact
local EPS = 1e-6

local SensorCore = {}
SensorCore.__index = SensorCore

-- One game clock: the senses count in its ticks (SimClock.HZ), never in the engine's rate.
SensorCore.HZ = 60
SensorCore.MIN_DISTANCE = 0.05

-- What the sensor keeps for each thing it can sense, under the world's id for it. It is the channel to a visible thing, not an identity.
export type Track = {
	perceptId: string,
	-- The contact this thing's evidence is filed under while sight of it is unbroken. "" until the first observation (only a thing that has
	-- been sensed has one); it is replaced, not trusted, once sight of the thing has been lost.
	trackId: string,
	-- The tick of the last evidence of this thing that was filed under that contact.
	linkTick: number,
	-- Continuous exposure in the cone, seconds.
	exposure: number,
	-- Seconds since the last inspected tick.
	gapS: number,
	nextCueTick: number,
}

-- What may be sensed: the world's truth about a thing, which only the eye reads (Godot's Perceivable percept).
export type Percept = {
	id: string,
	position: Vector3,
	radius: number,
	velocity: Vector3,
	-- The finest category its appearance can ever be refined to (fly-like prey for something that looks like easy prey up close, movement
	-- for something that never looks like more). nil is fly-like prey.
	maxCategory: string?,
}

-- One thing in the inspection cone this tick, as the eye made it: where it was seen (the mean of the sample points in plain view), the
-- direction to there, how big it looked and how much of it was in view.
export type Sighting = {
	t: Track,
	p: Percept,
	estimate: Vector3,
	estDir: Vector3,
	apparent: number,
	visibleFraction: number,
	match: string?,
	candidates: { string }?,
}

-- A thing inspected this tick (position and radius), which the spot checks must not call an empty place.
export type Inspected = { position: Vector3, radius: number }

function SensorCore.new(memory: any, observerId: string?): any
	return setmetatable({
		memory = memory,
		observerId = observerId or "spider",
		-- Parameters: the species profile's perception section (configureFrom). The defaults are Godot's.
		coneDeg = 30.0,
		peripheralConeDeg = 300.0,
		sectorDeg = 22.5,
		rangeWu = 40.0,
		-- How far the eyes reach now, as a share of rangeWu (1 in daylight; the life clock lowers it at night).
		rangeScale = 1.0,
		easyS = 0.4,
		flyS = 1.0,
		easyApparentDeg = 3.0,
		minApparentDeg = 0.6,
		motionMinSpeed = 0.3,
		cueCooldownS = 0.8,
		broadHz = 10.0,
		closeRangeWu = 4.0,
		graceS = 0.15,
		decayS = 6.0,
		-- The association rule (A-027): the assumed top speed of anything unseen, and the size ratio that still counts as one thing.
		contactSpeedBound = 2.0,
		contactSizeRatio = 1.5,
		-- Statistics, for tests and the developer overlay.
		tick = 0,
		inspectionsMade = 0,
		cuesMade = 0,
		spotChecksTotal = 0,
		-- Emitted for every peripheral cue made (after the cooldown), for tests and the developer view.
		cueEmitted = Signal.new(),
		_tracks = {} :: { [string]: Track },
		_serial = 0,
		_spots = {} :: { [string]: { exposure: number, gap: number } },
		_kept = {} :: { [string]: number }, -- track id -> continuous exposure the contact had when sight of it last ended
	}, SensorCore)
end

-- Takes the perception section of a species profile (spec 21.1: Species.<id>.perception, snake_case as in the data) and sets the memory's
-- timing to match.
function SensorCore.configureFrom(self: any, p: { [string]: number })
	self.coneDeg = p.inspect_cone_degrees
	self.peripheralConeDeg = p.peripheral_cone_degrees
	self.sectorDeg = p.peripheral_sector_degrees
	self.rangeWu = p.sensor_range_wu
	self.easyS = p.easy_target_inspection_s
	self.flyS = p.fly_like_inspection_s
	self.easyApparentDeg = p.easy_apparent_size_deg
	self.minApparentDeg = p.min_apparent_size_deg
	self.motionMinSpeed = p.motion_min_speed_wu_s
	self.cueCooldownS = p.cue_cooldown_s
	self.broadHz = p.broad_query_hz
	self.closeRangeWu = p.close_check_range_wu
	self.graceS = p.exposure_grace_s
	self.decayS = p.memory_decay_s
	self.contactSpeedBound = p.contact_speed_bound_wu_s
	self.contactSizeRatio = p.contact_size_ratio
	if self.memory ~= nil then
		self:applyToMemory()
	end
end

-- The memory's timing follows the sensor's: a cue repeats every cooldown, so a peripheral contact is held a little longer than that; an
-- inspection comes every tick, so it is held for the exposure grace.
function SensorCore.applyToMemory(self: any)
	self.memory:configure(SensorCore.HZ, self.decayS, self.graceS, self.cueCooldownS + 0.2)
end

-- The range every check uses.
function SensorCore.reachWu(self: any): number
	return self.rangeWu * math.clamp(self.rangeScale, 0.0, 1.0)
end

function SensorCore.getTrack(self: any, perceptId: string): Track?
	return self._tracks[perceptId]
end

-- The track a percept id is filed under, "" if it was never sensed. Tests and the developer overlay only.
function SensorCore.trackIdFor(self: any, perceptId: string): string
	local t: Track? = self._tracks[perceptId]
	return if t == nil then "" else t.trackId
end

-- Forget everything about what is being tracked (the memory is cleared separately).
function SensorCore.reset(self: any)
	self._tracks = {}
	self._spots = {}
	self._kept = {}
end

function SensorCore.trackOf(self: any, perceptId: string): Track
	local t: Track? = self._tracks[perceptId]
	if t == nil then
		t = {
			perceptId = perceptId,
			trackId = "",
			linkTick = -1000000,
			exposure = 0.0,
			gapS = 1.0e9,
			nextCueTick = 0,
		}
		self._tracks[perceptId] = t
	end
	return t :: Track
end

-- The head of a physics tick: the clock moves on and every track's gap since it was last inspected grows. Returns the tick.
function SensorCore.beginTick(self: any, delta: number): number
	self.tick += 1
	for _, t in self._tracks do
		t.gapS += delta
	end
	return self.tick
end

-- The tail of a physics tick: the memory moves on to this tick, then the tracks of things that are no longer there are dropped.
function SensorCore.endTick(self: any, present: { [string]: boolean })
	self.memory:advance(self.tick)
	self:forgetGone(present)
end

-- Lifecycle (A-029): a thing that is no longer there to be sensed (its node left the world, or it gives no percept) loses its entry; the
-- contacts it made are not touched, they fade and expire on their own clocks. Exposure kept for a contact that is gone goes too.
function SensorCore.forgetGone(self: any, present: { [string]: boolean })
	for pid in self._tracks do
		if not present[pid] then
			self._tracks[pid] = nil
		end
	end
	for id in self._kept do
		if self.memory:getContact(id) == nil then
			self._kept[id] = nil
		end
	end
end

-- A new contact for a thing, with an opaque id; the thing is filed under it from now on.
function SensorCore.newContactFor(self: any, t: Track): string
	self._serial += 1
	t.trackId = `trk_{self._serial}`
	return t.trackId
end

-- True while this thing's evidence is a continuation of the contact it was last filed under (A-027): that contact is live and the thing
-- itself was filed under it within the memory's hold time for that kind of evidence. Sight that was lost for longer is not unbroken,
-- whatever the world's id says, and neither is sight of a thing whose contact someone else kept alive.
function SensorCore.isLinked(self: any, t: Track): boolean
	if t.trackId == "" then
		return false
	end
	local c: ObservationMemory.Contact? = self.memory:getContact(t.trackId)
	return c ~= nil and c.state == Contact.LIVE and self.tick - t.linkTick <= self.memory:holdTicks(c.modality)
end

-- The contact a cue is filed under: the one the thing is unbrokenly filed under, else a new one (a bearing cannot say which remembered
-- place this is).
function SensorCore.cueContact(self: any, t: Track): string
	return if self:isLinked(t) then t.trackId else self:newContactFor(t)
end

-- The sightings of this tick that are first looks after a loss of sight (or at a thing known only from cues) are compared with the lost
-- contacts together, not one after the other (A-027): a lost contact is taken by a sighting only when it is that sighting's one candidate
-- and no other sighting of the tick could be it either. Two look-alikes that come into view at once, both inside the region one lost contact
-- could have reached, are two fresh contacts, whichever of them the sensor happens to handle first; and the order the world lists its
-- things in, like the world's ids, decides nothing. Then each sighting is filed.
function SensorCore.fileSightings(self: any, sightings: { Sighting }, delta: number)
	if #sightings == 0 then
		return
	end
	local claims: { [string]: number } = {} -- lost contact id -> how many sightings of this tick could be it
	for _, s in sightings do
		s.match = ""
		s.candidates = {}
		if self:placedAndUnbroken(s.t) then
			continue
		end
		local found = self:lostCandidates(s.estimate, 2.0 * s.p.radius, s.p.maxCategory or Observation.FLY_LIKE_PREY)
		s.candidates = found
		for _, id in found do
			claims[id] = (claims[id] or 0) + 1
		end
	end
	for _, s in sightings do
		local found = s.candidates :: { string }
		if #found == 1 and claims[found[1]] == 1 then
			s.match = found[1]
		end
	end
	for _, s in sightings do
		self:inspect(s.t, s.p, s.estimate, s.estDir, s.apparent, s.visibleFraction, delta, s.match :: string)
	end
end

-- True while the thing's evidence is a continuation of a contact that already has a place: nothing to compare.
function SensorCore.placedAndUnbroken(self: any, t: Track): boolean
	return self:isLinked(t) and self.memory:getContact(t.trackId).hasPosition
end

-- The contact an inspection is filed under (A-027). Unbroken sight of a thing already being inspected: the same contact. Otherwise this is
-- the first inspection after a loss of sight, or of a thing known only from cues: if the comparison made with the other sightings of the
-- tick (fileSightings) found exactly one lost contact it could be, it is that one (a contact known only from cues is folded into it); if it
-- found none, or more than one, it is the contact the cues made or a new one, with nothing carried over.
function SensorCore.inspectionContact(self: any, t: Track, matched: string): string
	local linked = self:isLinked(t)
	if linked and self.memory:getContact(t.trackId).hasPosition then
		return t.trackId
	end
	if matched ~= "" then
		if linked then
			self.memory:merge(t.trackId, matched)
		end
		t.trackId = matched
		return matched
	end
	return if linked then t.trackId else self:newContactFor(t)
end

-- The lost contacts a new sighting could be (their track ids; empty when none). A contact could be it when the sighting is inside the region
-- its thing could have reached since it was last observed (a function of the time and the speed bound, never of where the thing went),
-- looks about as big, and is not finer in appearance than what was learned. Only a focused sighting is ever asked: a bearing cue says
-- nothing about which remembered place this is.
function SensorCore.lostCandidates(self: any, estimate: Vector3, sizeWu: number, cap: string): { string }
	local found: { string } = {}
	for _, m in self.memory:marks() do
		local elapsed = (self.tick - m.positionTick) / SensorCore.HZ
		local reach = PerceptionMath.plausibleRadius(m.sizeWu, sizeWu, elapsed, self.contactSpeedBound, m.speedWuS)
		if (estimate - m.position).Magnitude > reach then
			continue
		end
		if not PerceptionMath.sizesCompatible(m.sizeWu, sizeWu, self.contactSizeRatio) then
			continue
		end
		if not PerceptionMath.categoriesCompatible(m.category, cap) then
			continue
		end
		table.insert(found, m.trackId)
	end
	return found
end

-- One inspection of a thing in the cone: its exposure (a new stretch after a break longer than the grace starts from what the contact it
-- belongs to was taught, as much as the memory of it lasts), the category that exposure supports (never finer than the thing can look),
-- and the Observation the memory takes in.
function SensorCore.inspect(self: any, t: Track, p: Percept, estimate: Vector3, estDir: Vector3, apparent: number, visibleFraction: number, delta: number, matched: string)
	local cap = p.maxCategory or Observation.FLY_LIKE_PREY
	local id: string = self:inspectionContact(t, matched)
	if t.gapS > self.graceS + EPS then
		-- A new stretch of exposure. What an earlier one taught the contact it belongs to still counts, as much as the memory of it does: a
		-- new contact has been taught nothing.
		t.exposure = (self._kept[id] or 0.0) * self.memory:familiarity(id)
	end
	t.exposure += delta
	self._kept[id] = t.exposure
	t.gapS = 0.0
	local category = PerceptionMath.classify(t.exposure, apparent, self.easyS, self.flyS, self.easyApparentDeg, self.minApparentDeg)
	if Observation.rank(category) > Observation.rank(cap) then
		category = cap
	end
	local obs = Observation.new()
	obs.observerId = self.observerId
	obs.trackId = id
	obs.targetId = if Observation.rank(category) >= Observation.rank(Observation.POSSIBLE_PREY) then p.id else ""
	obs.modality = Observation.INSPECTION
	obs.hasPosition = true
	obs.estimatedPosition = estimate
	obs.direction = estDir
	obs.confidence = PerceptionMath.inspectionConfidence(t.exposure, PerceptionMath.requiredExposure(self.flyS, apparent, self.easyApparentDeg), visibleFraction)
	obs.observedTick = self.tick
	obs.category = category
	obs.sizeWu = 2.0 * p.radius
	obs.apparentSizeDeg = apparent
	obs.speedWuS = p.velocity.Magnitude
	if self.memory:ingest(obs) ~= nil then
		self.inspectionsMade += 1
		t.linkTick = self.tick
	end
end

-- A peripheral cue: a coarse bearing, low confidence, and nothing else. The caller has already decided that the thing moves, is in the
-- field and in sight, and that `self.tick >= t.nextCueTick` (at most one cue per cooldown for each thing).
function SensorCore.cue(self: any, t: Track, estDir: Vector3, forward: Vector3, up: Vector3, dist: number)
	t.nextCueTick = self.tick + math.round(self.cueCooldownS * SensorCore.HZ)
	local obs = Observation.new()
	obs.observerId = self.observerId
	obs.trackId = self:cueContact(t)
	obs.modality = Observation.PERIPHERAL
	obs.hasPosition = false
	obs.direction = PerceptionMath.quantizeDirection(estDir, forward, up, self.sectorDeg)
	obs.confidence = PerceptionMath.peripheralConfidence(dist, self:reachWu())
	obs.observedTick = self.tick
	obs.category = Observation.MOVEMENT
	if self.memory:ingest(obs) ~= nil then
		self.cuesMade += 1
		t.linkTick = self.tick
		self.cueEmitted:emit(obs)
	end
end

-- The remembered spots of lost contacts: inspecting one that is in plain view and empty drops its mark. A spot is looked at when it is in
-- the cone, close enough that the thing would look big enough, and entirely in plain view (`allVisible(eye, position, radius, up)`: the
-- rays, which the world half supplies) with nothing inspected there this tick; it must be looked at for the time an easy target needs
-- (a break up to the grace does not start it again).
function SensorCore.checkSpots(self: any, eye: Vector3, axis: Vector3, up: Vector3, delta: number, inspected: { Inspected }, allVisible: (Vector3, Vector3, number, Vector3) -> boolean)
	local half = math.rad(self.coneDeg) * 0.5
	local marks: { ObservationMemory.Contact } = self.memory:marks()
	for id in self._spots do
		local still = false
		for _, m in marks do
			if m.trackId == id then
				still = true
			end
		end
		if not still then
			self._spots[id] = nil
		end
	end
	for _, m in marks do
		local st = self._spots[m.trackId] or { exposure = 0.0, gap = 1.0e9 }
		st.gap += delta
		local to = m.position - eye
		local dist = to.Magnitude
		local size = math.max(m.sizeWu, 0.2)
		local apparent = PerceptionMath.apparentSizeDeg(size, dist)
		local plain = false
		if dist >= SensorCore.MIN_DISTANCE and dist <= self:reachWu() and PerceptionMath.angleTo(axis, to / dist) <= half and apparent >= self.minApparentDeg then
			self.spotChecksTotal += 1
			plain = allVisible(eye, m.position, size * 0.5, up)
			if plain then
				for _, q in inspected do
					if (q.position - m.position).Magnitude < size + q.radius then
						plain = false -- something is there: not an empty spot
					end
				end
			end
		end
		if plain then
			if st.gap > self.graceS + EPS then
				st.exposure = 0.0
			end
			st.exposure += delta
			st.gap = 0.0
			if st.exposure + EPS >= PerceptionMath.requiredExposure(self.easyS, apparent, self.easyApparentDeg) then
				self.memory:invalidate(m.trackId, "empty")
				self._spots[m.trackId] = nil
				continue
			end
		end
		self._spots[m.trackId] = st
	end
end

return SensorCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- A minimal in-process signal, the stand-in for a Godot `signal`: handlers run synchronously, in the order they were connected, when
-- the signal is emitted. Pure Luau (no BindableEvent) so the plain CLI can run the perception logic that announces its changes with it.
local Signal = {}
Signal.__index = Signal

export type Signal = {
	connect: (self: Signal, handler: (...any) -> ()) -> () -> (),
	emit: (self: Signal, ...any) -> (),
}

function Signal.new(): Signal
	return setmetatable({ _handlers = {} }, Signal) :: any
end

-- Returns a function that disconnects this handler.
function Signal.connect(self: any, handler: (...any) -> ()): () -> ()
	table.insert(self._handlers, handler)
	return function()
		local i = table.find(self._handlers, handler)
		if i then
			table.remove(self._handlers, i)
		end
	end
end

function Signal.emit(self: any, ...: any)
	local handlers: { (...any) -> () } = table.clone(self._handlers)
	for _, handler in handlers do
		handler(...)
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="80">
        <Properties>
          <string name="Name">Persistence</string>
        </Properties>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">Checkpoint</string>
            <string name="Source"><![CDATA[--!strict
-- The retreat checkpoint (S01-C; Godot's scripts/persistence/checkpoint.gd, T09; ROBLOX-25). A checkpoint is the whole world
-- at one tick boundary in one plain record: the spider standing on its surface, its reserves and the books of what fed them,
-- the life clock and the rest, every fly with its random stream and whatever it was in the middle of, who sits on and who
-- has reserved each perch, the replacements still owed, the captures made, the meal in the jaws, and what the spider's senses
-- and memory held. Restoring one puts back all of it together, so an earlier spider is never put into a newer world and a fly
-- eaten after the checkpoint is not eaten twice: the fly and the energy it gave come back together.
--
-- When: only at the end of a tick, from a still spider on a surface that is not mid-meal, mid-struggle or mid-strike
-- (boundaryProblem). The player makes one by resting in the silk-lined crack (LifeLoop) and when a night's sleep reaches the
-- morning. Airborne, hanging, aiming and eating are refused: exact arbitrary-state resume (the original S01) stays deferred.
-- How: the live objects are recorded as one graph (ObjectRecord), so no field can be forgotten; the spider's body is
-- recorded by its pose (Godot's player record) and put back with SpiderMotor.place.
-- Validation happens on the record alone, before anything live changes: the format, schema and windowsill, the spider's
-- pose, every reference in the graph, and then the meaning of the rebuilt world (reserves in range and books that add up,
-- the clock, unique flies, perches held by flies that exist, the meal in the jaws one of them). A record with any problem is
-- refused with its reasons and the live world is left exactly as it was.
-- The wasp keeps a small record beside the graph (Godot's checkpoint schema 6): the day of its last visit and this life's visits and
-- escapes, so a return to a rest meets the same wasp. A visit going on is not kept; restoring ends it. A record without one (the port's
-- first checkpoints were made before the wasp) gets the record of a life it has not yet visited.
-- Differences from Godot: the record is the port's own (its flies are the port's, Chet's ROBLOX flies, not Godot's), so
-- Godot checkpoints are not read and schema numbers start again at 1. Schema 3 adds growth and its food ledger cursor.
-- The passing shadow and notebook are not recorded.
-- ROBLOX-91: nor are the two profiling windows of the live world: the prey director's `cpu` (the last 1200 ticks' microseconds) and the sensor's cost ring. They are
-- clock readings, different on every run, and were about 2400 floats, twice the rest of the record; capture leaves them out and a restore (of an old record too)
-- leaves them empty.
-- ROBLOX-94: where in the world the rest was kept is `world_map` = { seed, revision, region, retreat, diffs } (not `world`: that is the recorded object graph). The world is
-- never saved, only the seed and the revision it was made from and what changed in it (`diffs`, empty until something in the world can change). A record without one (every
-- rest before the world) means the sill of the default world with no changes. A region that is not on the map, or a position outside that region's bounds, is refused like
-- any bad record. A rest made in another revision of the world, or from another seed, is put back at its region's spawn: the position was kept for geometry that may have
-- moved, so it is not trusted (the rest of the record is: the life, the reserves, the clock).
-- ROBLOX-95: the world is at revision world-2 (the sill's back frame opened, the garden added) and a record without `world_map` is read as world-1's, the sill
-- of before: every rest kept before this round is put back at its region's spawn with the notice. A rest in the garden (the gap under the bed's stone) records
-- region bed_a and retreat bed_a_stone and is put back there. SCHEMA_VERSION and CONTENT_REVISION do not change (a new content revision would refuse old records).
-- ROBLOX-112: world-3 (the window in true proportion, the eaves raised, the kitchen): a rest kept under world-2 is put back at its region's spawn the same way, and a
-- rest under the toaster on the kitchen's counter records region kitchen_counter and retreat kitchen_toaster.
-- ROBLOX-96: the prey is per region. The `prey` root is still the sill's director, byte for byte what it was (an old record, sill-only prey, restores unchanged);
-- the regions outside are an optional `garden` root, { [regionId] = { prey = a PreyDirector?, bugs = a Woodlice? } } (Prey/PreyWorld's table), recorded when the
-- world has one and checked like the sill's: every fly in a known state with a meal inside its own profile's, every held perch held by a living fly, the woodlice
-- inside their region. A record without one leaves the live garden as it is (nothing rerolls); one with a region the map lacks is refused.
-- ROBLOX-101: a region's entry may hold `kinds`, the bestiary's directors by kind ({ [kind] = director }), checked as W3's director is; the wall and the outer
-- sill may now be named (they have bestiary prey). The new profiles are kept by name (springtailProfile ... craneFlyDuskProfile) and a hopper in the air is in
-- the state HOP. A W3 record (its bed with gnats, aphids and woodlice alone) restores unchanged; the bestiary's directors it lacks are made afresh from their
-- seeds when their region is next whole (Prey/PreyWorld.kinds), so nothing is rerolled that the record had. SCHEMA_VERSION, CONTENT_REVISION and the
-- world's revision stay as they were (W3's precedent: an optional part an old record lacks needs none of them).
-- ROBLOX-105: a region's entry may hold `ambient`, the ambient bugs' colonies by kind ({ ladybird = Ladybirds, millipede = Millipedes, snail = Snails,
-- harvestman = Harvestmen }), each of the kind the region has and in order (its creatures in known states inside the region's bounds). A record without it (every
-- rest before this round) restores unchanged and the colonies it lacks are made afresh from their seeds when their region is next whole (Prey/PreyWorld.ambient).
-- ROBLOX-106: the life may hold `cold_day` (the morning a night out in the garden left cold, Life/Nature), the rival `camp` (its watch by the crack), the mate its
-- courtship's record and the rival's level (`court_*`, `cut`) and the mating its counters (`courts`, `rejections`, `cut_ins`): all optional, absent in every record
-- before, checked when present.
-- ROBLOX-120: the life may hold `start_zone` and `start_region` (where a generation followed on the wind came down, Life/Ballooning): optional, absent in every record
-- before and in a generation that stayed at the hut, checked when present. The robin (Predator/Bird) keeps nothing: its day is the seed's, as the crab spiders' is.

local Species = require(script.Parent.Parent.Data.Species)
local ObjectRecord = require(script.Parent.ObjectRecord)
local Fly = require(script.Parent.Parent.Prey.Fly)
local FlyFlight = require(script.Parent.Parent.Prey.FlyFlight)
local FlySenses = require(script.Parent.Parent.Prey.FlySenses)
local PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)
local PreyPopulation = require(script.Parent.Parent.Prey.PreyPopulation)
local PerchGraph = require(script.Parent.Parent.Prey.PerchGraph)
local Feeding = require(script.Parent.Parent.Prey.Feeding)
local PreyDirector = require(script.Parent.Parent.Prey.PreyDirector)
local Sensor = require(script.Parent.Parent.Perception.Sensor)
local SensorCore = require(script.Parent.Parent.Perception.SensorCore)
local ObservationMemory = require(script.Parent.Parent.Perception.ObservationMemory)
local Observation = require(script.Parent.Parent.Perception.Observation)
local NeedsModel = require(script.Parent.Parent.Life.NeedsModel)
local LifeLoop = require(script.Parent.Parent.Life.LifeLoop)
local LifeClock = require(script.Parent.Parent.Life.LifeClock)
local Growth = require(script.Parent.Parent.Life.Growth)
local RareDirector = require(script.Parent.Parent.Life.RareDirector)
local WorldMap = require(script.Parent.Parent.World.WorldMap)
local WaspDirector = require(script.Parent.Parent.Predator.WaspDirector)
local Cat = require(script.Parent.Parent.Predator.Cat)
local Woodlice = require(script.Parent.Parent.Prey.Woodlouse)
local Ladybirds = require(script.Parent.Parent.Prey.Ladybird)
local Millipedes = require(script.Parent.Parent.Prey.Millipede)
local Snails = require(script.Parent.Parent.Prey.Snail)
local Harvestmen = require(script.Parent.Parent.Prey.Harvestman)
local Ants = require(script.Parent.Parent.Prey.Ant) -- (ROBLOX-119: the meadow's ants)
local Skaters = require(script.Parent.Parent.Prey.Skater) -- (ROBLOX-122: the pond's water striders)
local Garden = require(script.Parent.Parent.World.Garden)
local Ballooning = require(script.Parent.Parent.Life.Ballooning) -- (ROBLOX-120: a generation's start)
local Water = require(script.Parent.Parent.Life.Water) -- (ROBLOX-122: the water's falls counted)

local RivalSpider = require(script.Parent.Parent.Predator.RivalSpider)
local Mate = require(script.Parent.Parent.Predator.Mate)
local Mating = require(script.Parent.Parent.Life.Mating)
local Breakaway = require(script.Parent.Parent.Habitat.Breakaway)
local Nature = require(script.Parent.Parent.Life.Nature)
local CompactMigration = require(script.Parent.CompactMigration)
local Checkpoint = {}

Checkpoint.SCHEMA_VERSION = 3
Checkpoint.KIND = "retreat_checkpoint"
Checkpoint.GAME = "the-windowsill-roblox"
-- Changes whenever the windowsill's pieces or perches change in a way an old checkpoint could not be put back into.
Checkpoint.CONTENT_REVISION = "windowsill-roblox-1"
Checkpoint.STILL_SPEED = 0.15
Checkpoint.ROOTS = { "prey", "sensor", "memory", "needs", "life" }

-- The classes a world record may hold.
Checkpoint.CLASSES = {
	Fly = Fly, FlyFlight = FlyFlight, FlySenses = FlySenses, PreyRandom = PreyRandom, PreyPopulation = PreyPopulation,
	PerchGraph = PerchGraph, Feeding = Feeding, PreyDirector = PreyDirector, Woodlice = Woodlice,
	Ladybirds = Ladybirds, Millipedes = Millipedes, Snails = Snails, Harvestmen = Harvestmen, -- (ROBLOX-105)
	Ants = Ants, -- (ROBLOX-119)
	Skaters = Skaters, -- (ROBLOX-122)
	Sensor = Sensor, SensorCore = SensorCore, ObservationMemory = ObservationMemory, Contact = ObservationMemory.Contact,
	Observation = Observation,
	NeedsModel = NeedsModel, LifeLoop = LifeLoop, LifeClock = LifeClock, Growth = Growth,
}

-- What the world is made of that a record keeps by name instead of copying (see ObjectRecord). The same function names them
-- when a record is made and when it is put back, so a name always means this world's own thing.
export type World = {
	motor: any, prey: any, sensor: any, memory: any, needs: any, life: any,
	breakaway: any?,
	wasp: any?, -- the WaspDirector (nil: no wasp in this world)
	cat: any?, -- (ROBLOX-118) the ranger's cat, Predator/Cat (nil: no cat in this world: the test garden)
	water: any?, -- (ROBLOX-122) the water, Life/Water: its falls counted (nil: no pond in this world: the test garden)
	garden: { [string]: any }?, -- ROBLOX-96: the regions' prey and bugs outside the sill (Prey/PreyWorld's table; nil: a world of the sill alone)
	extraRefs: { [string]: any }?, -- anything else the world's state points at that the record should keep by name
}

function Checkpoint.refs(world: World): { [string]: any }
	local refs: { [string]: any } = {}
	local prey = world.prey
	ObjectRecord.constants("flyProfile", prey.p, refs)
	ObjectRecord.constants("fruitFlyProfile", Species.fruit_fly_prototype, refs)
	ObjectRecord.constants("gnatProfile", Species.fungus_gnat_prototype, refs) -- (ROBLOX-96: the bed's prey)
	ObjectRecord.constants("aphidProfile", Species.aphid_prototype, refs)
	-- (ROBLOX-101: the bestiary's prey, by day and from dusk)
	for _, pair in { { "springtailProfile", Species.springtail_prototype }, { "leafhopperProfile", Species.leafhopper_prototype }, { "mothProfile", Species.moth_prototype },
		{ "mothDuskProfile", Species.moth_dusk_prototype }, { "craneFlyProfile", Species.crane_fly_prototype }, { "craneFlyDuskProfile", Species.crane_fly_dusk_prototype },
		{ "hoverflyProfile", Species.hoverfly_prototype }, -- (ROBLOX-117: the hut garden's hoverflies)
		{ "midgeProfile", Species.midge_prototype }, { "midgeDuskProfile", Species.midge_dusk_prototype }, { "mosquitoProfile", Species.mosquito_prototype },
		{ "mosquitoDuskProfile", Species.mosquito_dusk_prototype }, { "damselflyProfile", Species.damselfly_prototype } } :: { { any } } do -- (ROBLOX-122: the pond's)
		local name: string, profile: any = pair[1], pair[2]
		ObjectRecord.constants(name, profile, refs)
	end
	local g = prey.graph
	refs["graph.cast"], refs["graph.sweep"], refs["graph.overlap"] = g.cast, g.sweep, g.overlap
	if prey.probe ~= nil then refs["prey.probe"] = prey.probe end
	if world.life.save ~= nil then refs["life.save"] = world.life.save end
	local m = world.memory
	for _, k in { "contactAcquired", "categoryChanged", "contactLost", "contactReacquired", "contactEnded" } do
		if m[k] ~= nil then refs["memory." .. k] = m[k] end
	end
	local core = world.sensor.core
	if core and core.cueEmitted ~= nil then refs["sensor.cueEmitted"] = core.cueEmitted end
	if world.needs.onEnergyChanged ~= nil then refs["needs.onEnergyChanged"] = world.needs.onEnergyChanged end
	local extra: { [string]: any } = world.extraRefs or {}
	for k, v in extra do refs[k] = v end
	return refs
end

local function liveRoots(world: World): { [string]: any }
	local roots: { [string]: any } = { prey = world.prey, sensor = world.sensor, memory = world.memory, needs = world.needs, life = world.life }
	if world.garden ~= nil then roots.garden = world.garden end
	return roots
end

local function v3(v: Vector3): { number }
	return { v.X, v.Y, v.Z }
end

local function finite(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local function vec(t: any): Vector3?
	if type(t) ~= "table" or #t ~= 3 or not finite(t[1]) or not finite(t[2]) or not finite(t[3]) then return nil end
	return Vector3.new(t[1], t[2], t[3])
end

-- The world record of a checkpoint with the defaults of a record from before there was a world: the default world's seed, the first revision of the world
-- (WorldMap.FIRST_REVISION, ROBLOX-95: such a rest was kept on the sill before its back frame opened, so it is put back at the spawn like any rest from
-- world-1), the sill, the retreat the player block names, no changes. Returns it and what is wrong with a record that has one (an empty list for a good one or
-- an old one).
-- ROBLOX-115: `world`, the world the rest was kept in (World/Worlds), written only outside the test garden: a record without it (every rest before, and every rest
-- kept in the test garden, byte for byte as before) is the test garden's. A rest from another world than the one running is put back where a life begins here.
export type MapRecord = { seed: number, revision: string, region: string, retreat: string, diffs: { any }, world: string }
local function mapRecord(record: any): (MapRecord, { string })
	local problems: { string } = {}
	local p = record.player
	local out: MapRecord = {
		seed = WorldMap.SEED, revision = WorldMap.FIRST_REVISION, region = WorldMap.HOME, diffs = {}, world = "test_garden",
		retreat = if type(p) == "table" and type(p.retreat_id) == "string" then p.retreat_id else "",
	}
	local m = record.world_map
	if m == nil then return out, problems end
	local function bad(t: string) table.insert(problems, t) end
	if type(m) ~= "table" then
		bad("world: the place in the world is not a record")
		return out, problems
	end
	if not finite(m.seed) or m.seed < 0 or m.seed > 4294967295 or m.seed % 1 ~= 0 then bad("world: the world's seed is not a whole number") else out.seed = m.seed end
	if type(m.revision) ~= "string" or #m.revision < 1 or #m.revision > 64 then bad("world: the world's revision is not a name") else out.revision = m.revision end
	if type(m.region) ~= "string" then
		bad("world: the region is not a name")
	else
		out.region = m.region
	end
	if type(m.retreat) ~= "string" then bad("world: the retreat is not a name") else out.retreat = m.retreat end
	if m.world ~= nil then
		if type(m.world) ~= "string" or #m.world < 1 or #m.world > 64 then bad("world: the world is not a name") else out.world = m.world end
	end
	if type(m.diffs) ~= "table" or getmetatable(m.diffs) ~= nil then
		bad("world: the changes to the world are not a list")
	elseif next(m.diffs) ~= nil then
		bad("world: the world has changes this game does not know (nothing in it can change yet)") -- later entries are { kind, region, id, data }, each kind with its own check
	end
	if #problems==0 and CompactMigration.applies(out) then out.region=CompactMigration.alias(out.region) end
	return out, problems
end

-- Whether a rest was kept in another world than this game's (another revision of it, or another seed): its position is not to be trusted.
function Checkpoint.worldMoved(record: any): boolean
	local map = mapRecord(record)
	return map.world ~= WorldMap.world() or map.revision ~= WorldMap.revision() or map.seed ~= WorldMap.SEED
end

-- Whether a rest was kept in another world than the one running (ROBLOX-115): its region and retreat are that world's, not looked for here.
local function otherWorld(record: any): boolean
	return mapRecord(record).world ~= WorldMap.world()
end

local function hasRetreat(region: WorldMap.Region, id: string): boolean
	for _, t in region.retreats do
		if t.id == id then return true end
	end
	return false
end

-- Why a checkpoint cannot be made of the world now; "" when it can.
function Checkpoint.boundaryProblem(world: World): string
	local motor, prey = world.motor, world.prey
	if motor.mode ~= "attached" or motor.preparing then return "the spider is not standing on a surface" end
	if motor.vel.Magnitude > Checkpoint.STILL_SPEED then return "the spider is moving" end
	if world.life.rival and world.life.rival.state=="captured" then
		return if world.life.rival.subdued == false then "the rival in the jaws is still struggling" else "the spider is eating its rival"
	end
	-- ROBLOX-89: the mating scene is playing (the pause together, and a male mate's walk off the sill that ends it): no rest is kept inside it.
	if world.life.mate and world.life.mate.scene == true then return "the two spiders are together" end
	-- ROBLOX-79: the brood is out and the ending is the player's to take; a rest here would keep a family that has already hatched.
	if world.life.mating and world.life.mating.stage == "hatched" then return "the brood is hatching" end
	if prey.feeding.feeding then return "the spider is feeding" end
	if prey.feeding.struggling then return "the prey in the jaws is still struggling" end
	if prey.tick <= prey.strikeEnd then return "a strike is still in progress" end
	return ""
end

-- The checkpoint record of the world as it is now (call boundaryProblem first). Nil and the reason if something in the world
-- could not be recorded (a field this file does not know how to keep; the tests make sure there is none).
function Checkpoint.capture(world: World, createdAt: number?): ({ [string]: any }?, string?)
	local motor = world.motor
	-- (the live windows are put aside for the capture and put straight back)
	local prey, sensor = world.prey, world.sensor
	local cpu, ring = prey.cpu, sensor._ring
	if cpu ~= nil then prey.cpu = {} end
	if ring ~= nil then sensor._ring = {} end
	local gardenCpu: { [any]: any } = {}
	for _, entry in (world.garden or {}) :: { [string]: any } do
		if type(entry) == "table" and entry.prey ~= nil and entry.prey.cpu ~= nil then gardenCpu[entry.prey] = entry.prey.cpu; entry.prey.cpu = {} end
		if type(entry) == "table" and type(entry.kinds) == "table" then
			for _, d in entry.kinds do if type(d) == "table" and d.cpu ~= nil then gardenCpu[d] = d.cpu; d.cpu = {} end end
		end
	end
	local graph, why = ObjectRecord.capture(liveRoots(world), Checkpoint.CLASSES, Checkpoint.refs(world))
	if cpu ~= nil then prey.cpu = cpu end
	if ring ~= nil then sensor._ring = ring end
	for d, window in gardenCpu do d.cpu = window end
	if not graph then return nil, why end
	local region = WorldMap.at(motor.pos) or WorldMap.region(WorldMap.HOME) :: WorldMap.Region
	local retreat = WorldMap.inRetreat(motor.pos) or ""
	return {
		schema_version = Checkpoint.SCHEMA_VERSION, kind = Checkpoint.KIND, game = Checkpoint.GAME,
		content_revision = Checkpoint.CONTENT_REVISION, created_at = createdAt or 0, snapshot_tick = world.prey.tick,
		player = {
			position = v3(motor.pos), normal = v3(motor.up), heading = v3(motor.heading), gaze_pitch = motor.gazePitch,
			retreat_id = retreat, state = "ATTACHED",
		},
		world_map = { seed = WorldMap.SEED, revision = WorldMap.revision(), region = region.id, retreat = retreat, diffs = {},
			world = if WorldMap.world() == "test_garden" then nil else WorldMap.world() },
		world = graph,
		life_rules = { mode = world.life.mode or "main", rules = world.life.rules or "standard" },
		breakaway = if world.breakaway then world.breakaway:record() else nil,
		wasp = if world.wasp ~= nil then world.wasp:toRecord() else nil,
		cat = if world.cat ~= nil then world.cat:toRecord() else nil, -- (ROBLOX-118: optional; a test garden rest has none)
		water = if world.water ~= nil then world.water:toRecord() else nil, -- (ROBLOX-122: optional; a test garden rest has none)
	}, nil
end

-- The checks on the rebuilt (fresh, not live) world: what a good world must be.
local function checkWorld(roots: { [string]: any }, problems: { string }, legacyCompact: boolean?)
	local function bad(t: string) table.insert(problems, t) end
	for _, name in Checkpoint.ROOTS do
		if type(roots[name]) ~= "table" then bad(`world: no {name}`) end
	end
	if #problems > 0 then return end
	local prey, needs, life, sensor, memory = roots.prey, roots.needs, roots.life, roots.sensor, roots.memory
	if getmetatable(prey) ~= PreyDirector then bad("world: the prey is not a prey director") end
	if getmetatable(needs) ~= NeedsModel then bad("world: the needs are not a needs model") end
	if getmetatable(life) ~= LifeLoop then bad("world: the life is not a life loop") end
	if getmetatable(sensor) ~= Sensor then bad("world: the sensor is not a sensor") end
	if getmetatable(memory) ~= ObservationMemory then bad("world: the memory is not an observation memory") end
	if #problems > 0 then return end
	-- The reserves and their books (NeedsModel's own record check).
	local scratch = NeedsModel.new()
	local ok, rec = pcall(function() return NeedsModel.toRecord(needs) end)
	if not ok or not scratch:load(rec) then bad("needs: the reserves or their books are not valid") end
	-- One needs model: the one feeding grants to is the one the life loop reports hours to.
	if prey.feeding == nil or prey.feeding.needs ~= needs or life.needs ~= needs then bad("needs: feeding and the life loop do not share the reserves") end
	-- The clock and the rest.
	for _, p in LifeClock.problems(if type(life.clock) == "table" then LifeClock.toRecord(life.clock) else nil) do bad(p) end
	if getmetatable(life.clock) ~= LifeClock then bad("life: the clock is not a life clock") end
	if getmetatable(life.growth) ~= Growth then bad("growth: missing growth state")
 else
  for _,p in Growth.problems(life.growth:toRecord()) do bad(p) end
  if life.growth:isMoulting() and not life.resting then bad("growth: moult outside rest") end
 end
 if not finite(life.grantedSeen) or life.grantedSeen<0 or life.grantedSeen>needs.grantedTotal+1e-6 then bad("growth: invalid food ledger cursor") end
 if not RivalSpider.valid(life.rival) then bad("life: invalid rival state") end
 -- ROBLOX-79: the mate, the mating cycle and the generation. All three are missing in a record from before (a life with no mate, stage none, generation 0).
 if not Mate.valid(life.mate) then bad("life: invalid mate state") end
 for _, text in Mating.problemsWith(life.mating, life.mate) do bad(text) end
 if not Nature.validCold(life.cold_day) then bad("life: invalid cold morning") end -- (ROBLOX-106: optional, set by a night out in the garden)
 if life.generation ~= nil and not (finite(life.generation) and life.generation >= 0 and life.generation <= 1e6 and life.generation % 1 == 0) then bad("life: invalid generation") end
 -- ROBLOX-120: where this generation began (Life/Ballooning): absent in every record before, and in a generation that stayed at the hut; a zone that can be landed in,
 -- and its landing region with it.
 if life.start_zone ~= nil and (not Ballooning.valid(life.start_zone) or life.start_zone == Ballooning.HUT) then bad("life: invalid start zone") end
 if life.start_region ~= nil and (life.start_zone == nil or not Ballooning.landsIn(life.start_zone, life.start_region)) then bad("life: invalid start region") end
 if life.start_zone ~= nil and life.start_region == nil then bad("life: a start zone with no landing") end
 for _,text in RareDirector.problems(life) do bad("life: "..text) end
 -- ROBLOX-91: where this generation's grace began (Mating.grace); absent in a record from before (the first generation's: the sill's own day and meals).
 for _, k in { "born", "mealsBase" } do
  local v = life[k]
  if v ~= nil and not (finite(v) and v >= 0 and v <= 1e9 and v % 1 == 0) then bad("life: invalid " .. k) end
 end
 if type(life.resting) ~= "boolean" then bad("life: 'resting' is not true or false") end
	-- The flies: unique ids, a known state, finite places, a meal no bigger than the profile's (ROBLOX-96: each profile's own; the fruit fly's was special-cased
	-- before), perches held only by flies that exist. The same checks for each region's director outside (the `garden` root); `ids` is every fly of the world.
	local every: { [any]: boolean } = {} -- every fly of the world, by identity
	local states = { PERCHED = true, ALERT = true, TAKEOFF = true, FLEE = true, SEEK_PERCH = true, REPOSITION = true, CAPTURED = true, CONSUMED = true, HOP = true }
	local function checkFlies(director: any, label: string): boolean
		if type(director.flies) ~= "table" then
			bad(`{label}: no list of flies`)
			return false
		end
		local ids: { [string]: any } = {}
		for i, f in director.flies do
			if getmetatable(f) ~= Fly or type(f.id) ~= "string" then
				bad(`{label}: fly {i} is not a fly`)
				continue
			end
			if ids[f.id] then bad(`{label}: two flies called {f.id}`) end
			ids[f.id] = f
			every[f] = true
			if not states[f.state] then bad(`{label}: {f.id} is in no known state`) end
			if typeof(f.position) ~= "Vector3" and type(f.position) ~= "table" then bad(`{label}: {f.id} has no position`) end
			if type(f.profile) ~= "table" or type(f.profile.body) ~= "table" or not finite(f.profile.body.nutrition) then bad(`{label}: {f.id} has no profile`)
			elseif not finite(f.nutrition) or f.nutrition < 0 or f.nutrition > f.profile.body.nutrition + 1e-9 then bad(`{label}: {f.id}'s nutrition is out of range`) end
			if f.flight == nil or f.flight.fly ~= f then bad(`{label}: {f.id}'s flight is not its own`) end
		end
		if type(director.graph) == "table" and type(director.graph.perches) == "table" then
			for _, p in director.graph.perches do
				if p.occupant ~= "" and (ids[p.occupant] == nil or not ids[p.occupant]:alive()) then bad(`{label}: perch {p.id} is held by {p.occupant}, which is not a living fly`) end
				if p.reserved ~= "" and ids[p.reserved] == nil then bad(`{label}: perch {p.id} is reserved by {p.reserved}, which is not a fly`) end
			end
		else
			bad(`{label}: no perches`)
		end
		return true
	end
	if not checkFlies(prey, "prey") then return end
	-- ROBLOX-96: the regions outside. Each a region of the map with prey of its own, its director a director sharing the jaws, its woodlice inside the region.
	local garden = roots.garden
	if garden ~= nil then
		if type(garden) ~= "table" or getmetatable(garden) ~= nil then
			bad("garden: not a record of regions")
		else
			for id, entry in garden do
				local region = if type(id) == "string" then (if legacyCompact then CompactMigration.legacyRegion(id) else WorldMap.region(id)) else nil
				local kinds: any = if region ~= nil then Garden.bestiary(region) else nil
				if legacyCompact and region~=nil and region.kind=="verge" then kinds={{kind="springtail"},{kind="housefly"}} end
				-- (ROBLOX-116: or with woodlice or ambient bugs alone, as the hut garden's lawn has)
				if region == nil or (Garden.prey(region) == nil and kinds == nil and Garden.bugs(region) == nil and Garden.ambient(region) == nil) then bad(`garden: {tostring(id)} is not a region with prey`); continue end
				if type(entry) ~= "table" or getmetatable(entry) ~= nil then bad(`garden: {id} is not a record`); continue end
				if entry.prey ~= nil then
					if getmetatable(entry.prey) ~= PreyDirector then bad(`garden: {id}'s prey is not a prey director`)
					else
						if entry.prey.feeding ~= prey.feeding then bad(`garden: {id}'s prey does not eat with the sill's jaws`) end
						checkFlies(entry.prey, `garden {id}`)
					end
				end
				if entry.prey ~= nil and Garden.prey(region) == nil then bad(`garden: {id} has no prey of the bed's kind`) end
				-- ROBLOX-101: the bestiary's directors, one per kind the region has
				if entry.kinds ~= nil then
					if type(entry.kinds) ~= "table" or getmetatable(entry.kinds) ~= nil then bad(`garden: {id}'s kinds are not a record`)
					else
						local known: { [string]: boolean } = {}
						for _, k in (kinds or {}) :: { any } do known[k.kind] = true end
						for kind, d in entry.kinds do
							if type(kind) ~= "string" or not known[kind] then bad(`garden: {id} has no prey of the kind {tostring(kind)}`)
							elseif getmetatable(d) ~= PreyDirector then bad(`garden: {id}'s {kind} is not a prey director`)
							else
								if d.feeding ~= prey.feeding then bad(`garden: {id}'s {kind} does not eat with the sill's jaws`) end
								checkFlies(d, `garden {id} {kind}`)
							end
						end
					end
				end
				if entry.bugs ~= nil then
					if getmetatable(entry.bugs) ~= Woodlice then bad(`garden: {id}'s bugs are not woodlice`)
					else for _, text in entry.bugs:problems(region.bounds[1], region.bounds[2]) do bad(`garden: {id}: {text}`) end end
				end
				-- ROBLOX-105: the ambient bugs' colonies, one per kind the region has, each of its kind's class
				if entry.ambient ~= nil then
					if type(entry.ambient) ~= "table" or getmetatable(entry.ambient) ~= nil then bad(`garden: {id}'s ambient bugs are not a record`)
					else
						local known: { [string]: boolean } = {}
						for _, a in (Garden.ambient(region) or {}) :: { any } do known[a.kind] = true end
						local classes = { ladybird = Ladybirds, millipede = Millipedes, snail = Snails, harvestman = Harvestmen, ant = Ants, skater = Skaters } :: { [string]: any }
						for kind, c in entry.ambient do
							if type(kind) ~= "string" or not known[kind] then bad(`garden: {id} has no ambient bug of the kind {tostring(kind)}`)
							elseif getmetatable(c) ~= classes[kind] then bad(`garden: {id}'s {kind} is not a colony of its kind`)
							else for _, text in c:problems(region.bounds[1], region.bounds[2]) do bad(`garden: {id}: {text}`) end end
						end
					end
				end
			end
		end
	end
	-- The meal in the jaws.
	local held = prey.feeding.held
	if held ~= nil then
		if not every[held] or held.state ~= "CAPTURED" then bad("feeding: the prey in the jaws is not a caught fly of this world") end
	end
	local sum = 0
	for _, g in prey.feeding.ledger do
		if not finite(g) or g < 0 then bad("feeding: a meal's energy is not a number") end
		sum += if finite(g) then g else 0
	end
	if math.abs(sum - prey.feeding.granted) > 1e-6 then bad("feeding: the meals' energy does not add up") end
	if prey.feeding.granted > needs.grantedTotal + 1e-6 then bad("feeding: more energy was eaten than the reserves were given") end
end

-- Every problem with `record` (an empty list for a good one), and the rebuilt world when it is good. Nothing live changes.
function Checkpoint.check(record: any, world: World): ({ string }, ObjectRecord.Decoded?)
	local problems: { string } = {}
	local function bad(t: string) table.insert(problems, t) end
	if type(record) ~= "table" then return { "not a checkpoint" }, nil end
	local sv = record.schema_version
	if not finite(sv) or sv ~= math.floor(sv) or sv < 1 then
		return { "the schema version is not a whole number" }, nil
	end
	if sv > Checkpoint.SCHEMA_VERSION then
		return { `made by a newer version of the game (schema {sv}; this one reads up to {Checkpoint.SCHEMA_VERSION})` }, nil
	end
	if record.kind ~= Checkpoint.KIND then bad("not a retreat checkpoint") end
	if record.game ~= Checkpoint.GAME then bad("not a checkpoint of this game") end
	if record.content_revision ~= Checkpoint.CONTENT_REVISION then bad(`made for another windowsill ({tostring(record.content_revision)})`) end
	if not finite(record.snapshot_tick) or record.snapshot_tick < 0 then bad("the tick is not a number") end
	-- ROBLOX-94: which region the rest was kept in, and whether this is the world it was kept in.
	local map, mapProblemList = mapRecord(record)
	for _, text in mapProblemList do bad(text) end
	local elsewhere = otherWorld(record)
	local region = if elsewhere then nil else WorldMap.region(map.region)
	if #mapProblemList == 0 and region == nil and not elsewhere then bad("the spider is in a region this world does not have") end
	local moved = Checkpoint.worldMoved(record)
	if region ~= nil and #mapProblemList == 0 and map.retreat ~= "" and not hasRetreat(region, map.retreat) then bad("the spider is in an unknown retreat") end
	local p = record.player
	if type(p) ~= "table" then
		bad("no spider")
	else
		local pos, n, h = vec(p.position), vec(p.normal), vec(p.heading)
		if not pos then bad("the spider has no position")
		elseif region ~= nil and not moved and not WorldMap.inBounds(pos, region.id) then
			bad(if region.id == WorldMap.HOME then "the spider is outside the windowsill" else `the spider is outside {region.id}`) -- (a rest from another world is put back at the spawn: its position is not tested)
		end
		if not n or math.abs(n.Magnitude - 1) > 1e-3 then bad("the spider's surface normal is not a unit vector") end
		if not h or math.abs(h.Magnitude - 1) > 1e-3 then bad("the spider's heading is not a unit vector") end
		if not finite(p.gaze_pitch) or math.abs(p.gaze_pitch) > math.pi / 2 then bad("the spider's gaze is not a number") end
		if p.state ~= "ATTACHED" then bad("the spider is not standing on a surface") end
		if p.retreat_id ~= "" and (type(p.retreat_id) ~= "string" or (region ~= nil and not hasRetreat(region, p.retreat_id)) or (region == nil and not elsewhere and WorldMap.retreat(p.retreat_id) == nil)) then bad("the spider is in an unknown retreat") end
		-- The player block's retreat and the world record's are one answer written twice (capture writes both from the same lookup); a record where they differ was not made by a capture.
		if type(record.world_map) == "table" and #mapProblemList == 0 and p.retreat_id ~= map.retreat then bad("the spider's retreat and the world record's retreat disagree") end
	end
	if not Breakaway.valid(record.breakaway) then bad("invalid falling leaf state") end
	local rules = record.life_rules
	if record.schema_version >= 2 and rules == nil then bad("missing life rules") end
	if rules ~= nil and (type(rules) ~= "table" or (rules.mode ~= "main" and rules.mode ~= "free") or (rules.rules ~= "standard" and rules.rules ~= "gentle") or (rules.mode == "free" and rules.rules ~= "gentle")) then bad("invalid life rules") end
	if record.wasp ~= nil then
		for _, text in WaspDirector.problems(record.wasp) do bad(text) end
	end
	if record.cat ~= nil then
		for _, text in Cat.problems(record.cat) do bad(text) end
	end
	if record.water ~= nil then
		for _, text in Water.problems(record.water) do bad(text) end
	end
	if #problems > 0 then return problems, nil end
	local decoded, why = ObjectRecord.decode(record.world, Checkpoint.CLASSES, Checkpoint.refs(world))
	if not decoded then
		for _, w in why do bad("world: " .. w) end
		return problems, nil
	end
	local roots = decoded.roots
 -- Schemas 1/2 had no growth. Migrate only old records; never repair a damaged schema 3 record.
 if sv < 3 and type(roots.life)=="table" and type(roots.needs)=="table" then
  if roots.life.growth == nil then roots.life.growth=Growth.new() end
  if roots.life.grantedSeen == nil then roots.life.grantedSeen=roots.needs.grantedTotal end
 end
	local ok: boolean, err: any = pcall(function()
		if CompactMigration.applies(map) then
			CompactMigration.prepareRival(decoded)
			checkWorld(roots,problems,true) -- Validate before retiring any old route ecology.
			if #problems==0 then
				CompactMigration.apply(decoded)
				checkWorld(roots,problems)
			end
		else checkWorld(roots,problems) end
	end)
	if not ok then bad("world: " .. tostring(err)) end
	if #problems > 0 then return problems, nil end
	return problems, decoded
end

-- Puts the world back as the record has it, or changes nothing. Returns true, or false and the problems.
-- The caller then lets go of anything the motor or the screen held (aims, lines, the camera); SpiderMotor.place already
-- ends every line, aim and walk.
function Checkpoint.restore(record: any, world: World): (boolean, { string })
	local problems, decoded = Checkpoint.check(record, world)
	if not decoded then return false, problems end
	local p = record.player
	local pos, n, h = vec(p.position) :: Vector3, vec(p.normal) :: Vector3, vec(p.heading) :: Vector3
	if not ObjectRecord.commit(decoded, liveRoots(world)) then
		return false, { "the live world is missing a part" }
	end
	-- The profiling windows are not in the record (an older one holds them): empty, and the sensor's window begins now.
	world.prey.cpu = {}
	world.sensor._ring = {}
	for _, entry in (world.garden or {}) :: { [string]: any } do
		if type(entry) == "table" and entry.prey ~= nil then entry.prey.cpu = {} end
		if type(entry) == "table" and type(entry.kinds) == "table" then for _, d in entry.kinds do d.cpu = {} end end
	end
	-- ROBLOX-94: a rest from another world than this game's is put back at its region's spawn; its position was kept for geometry that may have moved.
	local moved = Checkpoint.worldMoved(record)
	if moved then
		local home = WorldMap.region(WorldMap.HOME) :: WorldMap.Region
		local map=mapRecord(record)
		local offset=if CompactMigration.applies(map) then CompactMigration.offset(record.world_map.region) else nil
		if offset and WorldMap.inBounds(pos+offset,map.region) then
			world.motor:place(pos+offset,n.Unit,h.Unit)
			world.motor.gazePitch=p.gaze_pitch
		else
			local at = (if otherWorld(record) then home else WorldMap.region(map.region) or home).spawn
			world.motor:respawn(at.pos, at.heading)
		end
		if CompactMigration.applies(map) then world.sensor:reset();world.memory:clear() end
	else
		world.motor:place(pos, n.Unit, h.Unit)
		world.motor.gazePitch = p.gaze_pitch
	end
	if world.breakaway then world.breakaway:apply(record.breakaway) end
	if world.wasp ~= nil then world.wasp:load(record.wasp or WaspDirector.defaultRecord()) end
	if world.cat ~= nil then world.cat:load(record.cat or Cat.defaultRecord()) end -- (ROBLOX-118: a rest without one is a cat that has not met this spider)
	if world.water ~= nil then world.water:load(record.water or Water.defaultRecord()) end -- (ROBLOX-122: a rest without one has counted no falls)
	-- Godot's apply_record: the rest that was going on goes on, the spider takes a moment to take hold, and the screen says
	-- this is checkpoint recovery. What was owed or announced at that tick is not done again.
	local life = world.life
	local rules = record.life_rules or {mode="main",rules="standard"}
	life.mode, life.rules, life.lifeOver = rules.mode, rules.rules, false
	world.needs.gentle = rules.rules == "gentle"
	if world.wasp then world.wasp.gentle = world.needs.gentle end
	life.asleep = false
	life.checkpointDue = false
	life.morningText = ""
	life.events = {}
	life.restoreGrace = LifeLoop.RESTORE_GRACE_TICKS
	life:applyLight()
	life:showNotice(if moved then "Returned to your last rest, but the world has changed since you rested, so you stand where a life begins in it. Everything else is as you left it."
		else "Returned to your last rest: the sill as it was when you rested in the crack. This is a return to the rest, not an exact resume.")
	return true, {}
end

return Checkpoint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">CheckpointStore</string>
            <string name="Source"><![CDATA[--!strict
-- Where checkpoints live (S02; Godot's scripts/persistence/checkpoint_store.gd; ROBLOX-25), behind a DataStore-shaped
-- interface. This build uses only MemoryDataStore, an in-memory stand-in with a Roblox DataStore's rules (GetAsync, SetAsync,
-- RemoveAsync that may raise, values copied in and out, only storable values, a size limit). No live DataStore is written:
-- the in-memory store lasts as long as the session. A real DataStore can take its place later without changing the rest.
--
-- Keys: <key> the current checkpoint; <key>.bak the previous valid one; <key>.tmp a write in progress (never read as a
-- checkpoint); <key>.aside.N something this build could not read, set aside unchanged (never deleted).
-- An entry is { format, checksum, checkpoint }; the checksum is taken over the checkpoint's canonical JSON, so an entry that
-- was cut short or changed is refused even if what is left still looks like a checkpoint.
-- Saving: the record is checked, written to the temporary key, read back and checked again (checksum and validation). Only
-- then does the current entry (if it is itself good) become the backup and the new one the current. A current entry that is
-- damaged, or made by a newer version, never pushes out a good backup: it is set aside unchanged. Loading never writes: the
-- current entry is tried, then the backup, and each refusal says why. A newer schema is reported and left as it is.
local Json = require(script.Parent.Json)

local CheckpointStore = {}
CheckpointStore.__index = CheckpointStore
CheckpointStore.FORMAT = "the-windowsill checkpoint"

-- ------------------------------------------------------------------------------------------------ the in-memory DataStore
local MemoryDataStore = {}
MemoryDataStore.__index = MemoryDataStore
CheckpointStore.MemoryDataStore = MemoryDataStore
-- A Roblox DataStore value may be at most 4,194,304 characters once encoded.
MemoryDataStore.MAX_CHARS = 4194304

function MemoryDataStore.new(): any
	return setmetatable({ data = {} :: { [string]: any }, writes = 0, failNext = 0, failReads = 0, sizes = {} :: { [string]: number },
		written = setmetatable({}, { __mode = "k" }) :: any, -- (ROBLOX-108) per table written (weakly held): the store's copy of it and its text
	}, MemoryDataStore)
end

function MemoryDataStore.GetAsync(self: any, key: string): any
	if self.failReads > 0 then
		self.failReads -= 1
		error("MemoryDataStore: the read failed (a test asked it to)")
	end
	return Json.copy(self.data[key])
end

-- Whether two storable values are the same, value for value.
local function same(a: any, b: any): boolean
	if type(a) ~= "table" or type(b) ~= "table" then return a == b end
	for k, x in a do
		if not same(x, b[k]) then return false end
	end
	for k in b do
		if a[k] == nil then return false end
	end
	return true
end

function MemoryDataStore.SetAsync(self: any, key: string, value: any)
	if self.failNext > 0 then
		self.failNext -= 1
		error("MemoryDataStore: the write failed (a test asked it to)")
	end
	-- (ROBLOX-108: the same table written again unchanged, value for value, as a checkpoint's entry is to the temporary key and then the current one, has the text it
	-- had: it is not encoded a second time. The store's own copy of what was written is never handed out, so it cannot have changed.)
	local text: string?, why: string? = nil, nil
	local last = if type(value) == "table" then self.written[value] else nil
	if last ~= nil and same(value, last.copy) then
		text = last.text
	else
		text, why = Json.canonical(value)
	end
	if not text then error("MemoryDataStore: cannot store this value: " .. tostring(why)) end
	if #text > MemoryDataStore.MAX_CHARS then error(`MemoryDataStore: the value is {#text} characters, over the limit`) end
	local copy = Json.copy(value)
	self.data[key] = copy
	self.sizes[key] = #text
	self.writes += 1
	if type(value) == "table" then self.written[value] = { copy = copy, text = text :: string } end
end

function MemoryDataStore.RemoveAsync(self: any, key: string): any
	local old = self.data[key]
	self.data[key] = nil
	self.sizes[key] = nil
	return old
end

-- ------------------------------------------------------------------------------------------------ the checkpoint store
export type Result = { ok: boolean, message: string, errors: { string }, record: any?, source: string? }

-- `store` is DataStore-shaped (GetAsync, SetAsync, RemoveAsync). `validate(record)` returns the record's problems (an empty
-- list for a good one): the world's own checks (Checkpoint.check).
function CheckpointStore.new(store: any, validate: (any) -> { string }, key: string?): any
	return setmetatable({ store = store, validate = validate, key = key or "checkpoint", last = nil :: Result?,
		placed = nil :: { checksum: string, text: string }?, -- (ROBLOX-108) the entry this store last put in place, by its checksum and its record's text
	}, CheckpointStore)
end

local function result(self: any, ok: boolean, message: string, errors: { string }?, extra: { [string]: any }?): Result
	local r: any = { ok = ok, message = message, errors = errors or {} }
	local more: { [string]: any } = extra or {}
	for k, v in more do r[k] = v end
	self.last = r
	return r
end

-- The entry for a record, or nil and why it cannot be stored (and, ROBLOX-108, the record's canonical text).
function CheckpointStore.entry(record: any): (any?, string?, string?)
	local text, why = Json.canonical(record)
	if not text then return nil, why, nil end
	return { format = CheckpointStore.FORMAT, checksum = Json.checksum(text), checkpoint = record }, nil, text
end

-- Reads an entry: the record, or nil and why not. `newer` is true when it was made by a newer version (left as it is).
function CheckpointStore.read(self: any, entry: any): (any?, { string }, boolean)
	if entry == nil then return nil, { "there is none" }, false end
	if type(entry) ~= "table" or entry.format ~= CheckpointStore.FORMAT then return nil, { "not a checkpoint entry" }, false end
	local text = Json.canonical(entry.checkpoint)
	if not text or Json.checksum(text) ~= entry.checksum then return nil, { "the checksum does not match: the entry was cut short or changed" }, false end
	local problems = self.validate(entry.checkpoint)
	if #problems > 0 then
		local newer = string.find(problems[1], "newer version", 1, true) ~= nil
		return nil, problems, newer
	end
	return entry.checkpoint, {}, false
end

local function try(fn: () -> ...any): (boolean, any)
	return pcall(fn)
end

-- Sets aside an entry this build could not read: never deleted, never overwritten. Returns the key used, or "".
function CheckpointStore._setAside(self: any, entry: any): string
	for i = 1, 50 do
		local k = `{self.key}.aside.{i}`
		local ok, existing = try(function() return self.store:GetAsync(k) end)
		if ok and existing == nil then
			local wrote = try(function() self.store:SetAsync(k, entry) end)
			return if wrote then k else ""
		end
	end
	return ""
end

-- Writes `record` as the current checkpoint, keeping the previous good one as the backup.
function CheckpointStore.save(self: any, record: any): Result
	local problems = self.validate(record)
	if #problems > 0 then return result(self, false, "the checkpoint is not valid", problems) end
	local entry, why, text = CheckpointStore.entry(record)
	if not entry then return result(self, false, "the checkpoint cannot be stored", { why :: string }) end
	local tmp, main, bak = self.key .. ".tmp", self.key, self.key .. ".bak"
	local wrote, err = try(function() self.store:SetAsync(tmp, entry) end)
	if not wrote then return result(self, false, "the checkpoint could not be written", { tostring(err) }) end
	local readOk, back = try(function() return self.store:GetAsync(tmp) end)
	local again, againProblems = nil, { "it could not be read back" }
	-- (ROBLOX-108: what was read back is what was written when its text is the record's text, word for word: then its checksum is the entry's and its checks are
	-- the record's, already passed, and neither is taken again. Anything else is read as any entry is.)
	if readOk and type(back) == "table" and back.format == CheckpointStore.FORMAT and back.checksum == entry.checksum and Json.canonical(back.checkpoint) == text then
		again, againProblems = back.checkpoint, {}
	elseif readOk then
		again, againProblems = self:read(back)
	end
	if not again then return result(self, false, "the checkpoint did not read back correctly", againProblems) end
	local curOk, current = try(function() return self.store:GetAsync(main) end)
	if not curOk then return result(self, false, "the current checkpoint could not be read", { tostring(current) }) end
	if current ~= nil then
		-- (ROBLOX-108: the current entry that is word for word the one this store put in place last is good without taking its checksum and checks again)
		local placed = self.placed
		local good: any = nil
		if placed ~= nil and type(current) == "table" and current.format == CheckpointStore.FORMAT and current.checksum == placed.checksum
			and Json.canonical(current.checkpoint) == placed.text then
			good = current.checkpoint
		else
			good = self:read(current)
		end
		if good then
			local moved, merr = try(function() self.store:SetAsync(bak, current) end)
			if not moved then return result(self, false, "the previous checkpoint could not be kept as the backup", { tostring(merr) }) end
		elseif self:_setAside(current) == "" then
			return result(self, false, "a damaged checkpoint could not be set aside, so it was left in place", {})
		end
	end
	local put, perr = try(function() self.store:SetAsync(main, entry) end)
	if not put then return result(self, false, "the checkpoint could not be put in place", { tostring(perr) }) end
	self.placed = { checksum = entry.checksum, text = text }
	try(function() self.store:RemoveAsync(tmp) end)
	return result(self, true, "Last rest kept.", {}) -- (ROBLOX-92: the player's word for a checkpoint is the last rest)
end

-- The newest good checkpoint: { ok, record, source = "current" | "backup", message, errors }. Never writes.
function CheckpointStore.loadBest(self: any): Result
	local errors: { string } = {}
	for _, which in { { self.key, "current" }, { self.key .. ".bak", "backup" } } do
		local ok, entry = try(function() return self.store:GetAsync(which[1]) end)
		if not ok then
			table.insert(errors, `{which[2]}: it could not be read ({tostring(entry)})`)
			continue
		end
		local record, problems, newer = self:read(entry)
		if record then
			return result(self, true, if which[2] == "current" then "the last rest" else "the backup of the last rest (the newest could not be used)", errors, { record = record, source = which[2] })
		end
		for _, p in problems do table.insert(errors, `{which[2]}: {p}`) end
		if newer then
			return result(self, false, "the last rest was made by a newer version of the game; it was left as it is", errors)
		end
	end
	return result(self, false, "no last rest to return to", errors)
end

return CheckpointStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">CompactMigration</string>
            <string name="Source"><![CDATA[--!strict
-- preserve-2 -> preserve-3: relocate habitats, not spider scale or progress.
-- Operates only on decoded fresh objects. Live roots, shared feeding ledgers and
-- named immutable profile references are never traversed or changed.
local Map=require(script.Parent.Parent.World.WorldMap)
local Migration={}
local MEADOW=Vector3.new(0,0,300)
local POND=Vector3.new(-1300,0,1625)
function Migration.applies(map: any): boolean
 return Map.world()=="preserve" and Map.revision()=="preserve-3" and map.world=="preserve"
  and map.revision=="preserve-2" and map.seed==Map.SEED
end
function Migration.offset(id: string): Vector3?
 if string.match(id,"^pad_") or string.match(id,"^meadow_") or string.match(id,"^bench_[we]$") or id=="bin" or string.match(id,"^lamp_[1-4]$") then return MEADOW end
 if string.match(id,"^pond_") or string.match(id,"^deck_") or string.match(id,"^walk_") or string.match(id,"^cattail_") then return POND end
 if not Migration.routeCache(id) and Map.region(id) then return Vector3.zero end
 return nil
end
local function route(id: string): (string?,number?)
 local kind,n=string.match(id,"^mown_([en])(%d+)$")
 if not n then return nil,nil end
 local index=tonumber(n) :: number
 if index<1 or index>(if kind=="e" then 15 else 14) then return nil,nil end
 return kind,index
end
function Migration.alias(id: string): string
 local kind,n=route(id)
 if kind=="e" then return if (n :: number)<=7 then "mown_e1" else "mown_e2" end
 if kind=="n" then return "mown_n1" end
 if string.match(id,"^verge_%-?%d+_%-?%d+$") then return Map.HOME end
 return id
end
function Migration.routeCache(id: string): boolean
 local kind=route(id)
 return kind~=nil or string.match(id,"^verge_%-?%d+_%-?%d+$")~=nil or string.match(id,"^path_m[1-4]$")~=nil
end
function Migration.legacyRegion(id: string): any
 local current=Map.region(id)
 local offset=Migration.offset(id)
 if current and offset then
  local old=table.clone(current);old.bounds={current.bounds[1]-offset,current.bounds[2]-offset}
  old.spawn={pos=current.spawn.pos-offset,heading=current.spawn.heading}
  return old
 end
 local kind,n=route(id)
 if kind then
  local x0,x1,z0,z1
  if kind=="e" then
   x0=90+((n :: number)-1)*100;x1=x0+100;z0=-1030;z1=-930
  else
   x0=1490;x1=1590;z1=-1030-((n :: number)-1)*100;z0=if n==14 then -2441 else z1-100
  end
  return {id=id,kind="mown_path",seed=Map.seed(Map.SEED,id),bounds={Vector3.new(x0,-88,z0),Vector3.new(x1,-44.6,z1)},
   spawn={pos=Vector3.new((x0+x1)/2,-84.6,(z0+z1)/2)},origin=Vector3.new(x0,-84.6,z0),neighbors={},retreats={}}
 end
 local x,z=string.match(id,"^verge_(%-?%d+)_(%-?%d+)$")
 if x and z then
  local a,b=tonumber(x) :: number,tonumber(z) :: number
  if a>=-400 and a<=1590 and b>=-2441 and b<=-16 then
   return {id=id,kind="verge",seed=Map.seed(Map.SEED,id),bounds={Vector3.new(a,-87.6,b),Vector3.new(a+100,-49.6,b+100)},
    spawn={pos=Vector3.new(a+50,-84.6,b+50)},neighbors={},retreats={}}
  end
 end
 return current
end
local function point(value: Vector3,offset: Vector3): boolean
 -- All translated habitats were far north of the origin. Unit normals, local
 -- offsets, velocities, dimensions and direction vectors do not pass this gate.
 return value.Z < -700 and (offset.X==0 or value.X>1000)
end
function Migration.shift(decoded: any,target: any,offset: Vector3)
 local fresh,blocked,seen={},{},{}
 for _,object in decoded.objects do fresh[object]=true end
 for _,root in decoded.roots do blocked[root]=true end
 if decoded.roots.prey.feeding then blocked[decoded.roots.prey.feeding]=true end
 local function visit(object: any)
  if type(object)~="table" or not fresh[object] or blocked[object] or seen[object] then return end
  seen[object]=true
  for key,value in object do
   if typeof(value)=="Vector3" or (type(value)=="table" and type(value.X)=="number" and type(value.Y)=="number" and type(value.Z)=="number" and type(value.Dot)=="function") then
    if point(value,offset) then object[key]=value+offset end
   elseif type(value)=="table" then visit(value) end
  end
 end
 visit(target)
end
function Migration.prepareRival(decoded: any)
 local rival=decoded.roots.life and decoded.roots.life.rival
 if type(rival)=="table" and type(rival.region)=="string" then
  local offset=Migration.offset(rival.region)
  if offset then Migration.shift(decoded,rival,offset) end
 end
end
function Migration.apply(decoded: any)
 for id,entry in decoded.roots.garden or {} do
  local offset=Migration.offset(id)
  if offset then Migration.shift(decoded,entry,offset)
  elseif Migration.routeCache(id) then decoded.roots.garden[id]=nil end
 end
 -- Cast skins are world points too; preserve their relation to the moved leaf
 -- or bench without touching life clocks, energy, meals or generation history.
 local growth=decoded.roots.life.growth
 for i,p in growth.exuviae do
  if p.X>=-310 and p.X<=190 and p.Z<=-816 and p.Z>=-1616 then growth.exuviae[i]=p+MEADOW
  elseif p.X>=1490 and p.X<=2225 and p.Z<=-2441 and p.Z>=-2841 then growth.exuviae[i]=p+POND end
 end
end
return table.freeze(Migration)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">Json</string>
            <string name="Source"><![CDATA[--!strict
-- What a Roblox DataStore can hold, checked without the engine (ROBLOX-25), and the canonical text a checksum is taken over
-- (Godot's checkpoint_store.gd: sorted keys, full precision). A value is storable when it is a string, a boolean, a finite
-- number, a list (keys 1..n, no holes) or a table whose keys are all strings, made of storable values, with no table met
-- twice. Pure; tests/checkpoint.luau checks it.

local Json = {}

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local ESC: { [string]: string } = { ['"'] = '\\"', ["\\"] = "\\\\", ["\b"] = "\\b", ["\f"] = "\\f", ["\n"] = "\\n", ["\r"] = "\\r", ["\t"] = "\\t" }

local function quote(s: string): string
	if string.find(s, '[%c"\\]') == nil then return '"' .. s .. '"' end -- (ROBLOX-108: most strings need no escape)
	return '"' .. string.gsub(s, '[%c"\\]', function(c: string): string
		return ESC[c] or string.format("\\u%04x", string.byte(c))
	end) .. '"'
end

-- The kind of table: "list" (keys exactly 1..n; an empty table counts as a list), "object" (all keys strings) or nil.
local function shape(t: { [any]: any }): string?
	local n, strings, others = 0, 0, 0
	for k in t do
		if type(k) == "string" then
			strings += 1
		elseif type(k) == "number" then
			others += 1
		else
			return nil
		end
		n += 1
	end
	if strings == n then return if n == 0 then "list" else "object" end
	if others == n then
		for i = 1, n do
			if t[i] == nil then return nil end
		end
		return "list"
	end
	return nil
end

-- The canonical JSON text of `v`, or nil and why it is not storable.
-- (ROBLOX-108: the path a problem names is kept as a stack of keys and spelt out only when there is a problem; it was a new string for every value, most of the
-- cost of a checkpoint's save, which runs on the frame the rest begins. The text and every message are as they were.)
function Json.canonical(v: any): (string?, string?)
	local seen: { [any]: boolean } = {}
	local problem: string? = nil
	local trail: { any } = {}
	local function where(): string
		local out = "value"
		for _, k in trail do
			if type(k) == "number" then out ..= `[{k}]` else out ..= `.{k}` end
		end
		return out
	end
	local function enc(x: any): string
		if problem then return "" end
		local t = type(x)
		if t == "string" then return quote(x) end
		if t == "boolean" then return if x then "true" else "false" end
		if t == "number" then
			if not finite(x) then
				problem = `{where()}: a number JSON cannot hold`
				return ""
			end
			if x == math.floor(x) and math.abs(x) < 2 ^ 53 then return string.format("%d", x) end
			return string.format("%.17g", x)
		end
		if t ~= "table" then
			problem = `{where()}: a {typeof(x)}`
			return ""
		end
		if getmetatable(x) ~= nil then
			problem = `{where()}: a table with a metatable`
			return ""
		end
		if seen[x] then
			problem = `{where()}: a table met twice`
			return ""
		end
		seen[x] = true
		local kind = shape(x)
		local depth = #trail + 1
		if kind == "list" then
			local parts = table.create(#x)
			for i, y in ipairs(x) do
				trail[depth] = i
				parts[i] = enc(y)
			end
			trail[depth] = nil
			return "[" .. table.concat(parts, ",") .. "]"
		elseif kind == "object" then
			local keys: { string } = {}
			for k in x do table.insert(keys, k) end
			table.sort(keys)
			local parts = table.create(#keys)
			for i, k in keys do
				trail[depth] = k
				parts[i] = quote(k) .. ":" .. enc(x[k])
			end
			trail[depth] = nil
			return "{" .. table.concat(parts, ",") .. "}"
		end
		problem = `{where()}: a table with mixed or sparse keys`
		return ""
	end
	local text = enc(v)
	if problem then return nil, problem end
	return text, nil
end

-- A deep copy of a storable value (what a DataStore hands back is never the table that was given to it).
local function copy(v: any): any
	if type(v) ~= "table" then return v end
	local out = {}
	for k, x in v do out[k] = if type(x) == "table" then copy(x) else x end
	return out
end
Json.copy = copy

-- FNV-1a over the text, two independent 32-bit lanes, as 16 hex digits: enough to catch a record cut short or changed.
-- x * 16777619 (the FNV prime, 2^24 + 403) modulo 2^32, exactly, as ((x % 256) * 2^24 + x * 403) % 2^32: a plain product of two 32-bit numbers can exceed 2^53.
-- (ROBLOX-108: the bytes are read a block at a time and the multiply is written out in the loop: the same sums as before, one byte at a time, in less time.)
local BLOCK = 2048
function Json.checksum(text: string): string
	local a, b = 0x811c9dc5, 0x050c5d1f
	local n = #text
	local bxor = bit32.bxor
	local i0 = 1
	while i0 <= n do
		local i1 = math.min(n, i0 + BLOCK - 1)
		local bytes = { string.byte(text, i0, i1) }
		for j, c in bytes do
			local x = bxor(a, c)
			a = ((x % 256) * 16777216 + x * 403) % 4294967296
			local y = bxor(b, (c + i0 + j - 1) % 256)
			b = ((y % 256) * 16777216 + y * 403) % 4294967296
		end
		i0 = i1 + 1
	end
	return string.format("%08x%08x", a, b)
end

return Json
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">MemoryBackend</string>
            <string name="Source"><![CDATA[--!strict
-- The in-memory store backend (ROBLOX-39): the same interface as the real DataStore backend, with a Roblox DataStore's rules (values
-- copied in and out, only storable values, the size limit, UpdateAsync that may call its function more than once) and a way to make it
-- fail in every way the tests need. It is what the CLI tests run on and what a build without DataStore access falls back to (a session
-- that lasts as long as the server).
-- Interface (a backend is any table with these):
--   backend:read(key)              -> ok: boolean, value: any, err: string?
--   backend:update(key, transform) -> ok: boolean, value: any, err: string?     transform(old) returns the new value, or nil to cancel
-- A cancelled update is ok with value nil. Neither raises.
-- Faults: backend:fail{ op = "read"|"update"|"any", key = "<key or prefix*>"?, times = n?, message = "...", afterWrite = true? }. A fault with
-- afterWrite lets the write happen and then reports an error (a timeout that did not mean the write was lost). backend:poke(key, value) sets
-- a raw value (corrupt JSON, a half-written record). `backend.log` lists every request: { op, key, ok }.
local Json = require(script.Parent.Json)
local SaveRules = require(script.Parent.Parent.Data.SaveRules)

local MemoryBackend = {}
MemoryBackend.__index = MemoryBackend

export type Fault = { op: string, key: string?, times: number, message: string, afterWrite: boolean? }

function MemoryBackend.new(): any
	return setmetatable({ data = {} :: { [string]: any }, faults = {} :: { Fault }, log = {} :: { any }, requests = 0, writes = 0, clock = 0 }, MemoryBackend)
end

function MemoryBackend.fail(self: any, fault: { [string]: any })
	table.insert(self.faults, { op = fault.op or "any", key = fault.key, times = fault.times or 1, message = fault.message or "503: the service is unavailable", afterWrite = fault.afterWrite })
end

function MemoryBackend.clearFaults(self: any)
	self.faults = {}
end

function MemoryBackend.poke(self: any, key: string, value: any)
	self.data[key] = value
end

local function matches(pattern: string?, key: string): boolean
	if pattern == nil then return true end
	if string.sub(pattern, -1) == "*" then return string.sub(key, 1, #pattern - 1) == string.sub(pattern, 1, #pattern - 1) end
	return pattern == key
end

-- The first live fault for this request, used up by one.
local function takeFault(self: any, op: string, key: string): Fault?
	for i, f in self.faults do
		if (f.op == "any" or f.op == op) and matches(f.key, key) and f.times > 0 then
			f.times -= 1
			if f.times == 0 then table.remove(self.faults, i) end
			return f
		end
	end
	return nil
end

function MemoryBackend.read(self: any, key: string): (boolean, any, string?)
	self.requests += 1
	local f = takeFault(self, "read", key)
	if f then
		table.insert(self.log, { op = "read", key = key, ok = false })
		return false, nil, f.message
	end
	table.insert(self.log, { op = "read", key = key, ok = true })
	return true, Json.copy(self.data[key]), nil
end

function MemoryBackend.update(self: any, key: string, transform: (any) -> any): (boolean, any, string?)
	self.requests += 1
	local f = takeFault(self, "update", key)
	if f and not f.afterWrite then
		table.insert(self.log, { op = "update", key = key, ok = false })
		return false, nil, f.message
	end
	local okT, new = pcall(transform, Json.copy(self.data[key]))
	if not okT then
		table.insert(self.log, { op = "update", key = key, ok = false })
		return false, nil, "the update function raised: " .. tostring(new)
	end
	if new == nil then
		table.insert(self.log, { op = "update", key = key, ok = true, cancelled = true })
		return true, nil, nil
	end
	local text, why = Json.canonical(new)
	if not text then
		table.insert(self.log, { op = "update", key = key, ok = false })
		return false, nil, "104: Cannot store this value: " .. tostring(why)
	end
	if #text > SaveRules.MAX_VALUE_CHARS then
		table.insert(self.log, { op = "update", key = key, ok = false })
		return false, nil, `105: the value is {#text} characters, over the limit`
	end
	self.data[key] = Json.copy(new)
	self.writes += 1
	if f and f.afterWrite then
		table.insert(self.log, { op = "update", key = key, ok = false, wrote = true })
		return false, nil, f.message
	end
	table.insert(self.log, { op = "update", key = key, ok = true })
	return true, Json.copy(new), nil
end

return MemoryBackend
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">ObjectRecord</string>
            <string name="Source"><![CDATA[--!strict
-- ObjectRecord (ROBLOX-25): the state of a few live objects as one plain record that a DataStore could hold, and back.
-- The world's state is a graph of Luau tables (flies point at their perches, a flight at its fly and back, the feeding at the
-- needs it grants to). Writing a record by hand for each module would miss a field sooner or later, and a missed field is a
-- checkpoint that comes back different. So this walks the graph from named roots and records every table once, keeping who
-- points at what, cycles included. Nothing is guessed:
--   * a table with a metatable is recorded only if its metatable is one of the named `classes`; anything else is refused;
--   * functions, Instances and any other engine value are refused unless they are named `refs` (the running program's own
--     things: the world's raycast closures, a probe part, a Signal with its listeners, the species data). A ref is kept as its
--     name and comes back as whatever has that name when the record is restored;
--   * numbers that JSON cannot hold (infinities, NaN) and Vector3 values are written as small tagged tables.
-- The record: { format = FORMAT, roots = { name = { ["$o"] = i } }, objects = { { c = class?, e = { { key, value }, ... } } } },
-- where every key is a string or a finite number, and every value a string, boolean, finite number, or one of
-- { ["$o"] = i } (the i-th object), { ["$r"] = name }, { ["$v"] = { x, y, z } }, { ["$n"] = "inf" | "-inf" | "nan" }.
-- Entries are sorted, so the same state always gives the same record.
-- Restoring is in two steps. `decode` checks the whole record and builds every object fresh, touching nothing live; a record
-- with any problem is refused there, with the reasons. `commit` then moves the fresh roots' contents into the live root tables
-- (so everything else that holds a live root keeps holding the right table) and cannot fail part way.

local ObjectRecord = {}

ObjectRecord.FORMAT = "object-record-1"
-- Refuse graphs larger than this many tables (a runaway reference would otherwise record the whole program).
ObjectRecord.MAX_OBJECTS = 20000

export type Record = { format: string, roots: { [string]: any }, objects: { any } }
export type Decoded = { roots: { [string]: any }, objects: { any } }

local V3META: any = if type((Vector3 :: any).zero) == "table" then getmetatable((Vector3 :: any).zero) else nil

local function isVector3(v: any): boolean
	return typeof(v) == "Vector3" or (V3META ~= nil and type(v) == "table" and getmetatable(v) == V3META)
end

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function encodeNumber(x: number): any
	if finite(x) then return x end
	return { ["$n"] = if x ~= x then "nan" elseif x > 0 then "inf" else "-inf" }
end

local function keyLess(a: any, b: any): boolean
	local ka, kb = a[1], b[1]
	if type(ka) == type(kb) then return ka < kb end
	return type(ka) == "number" -- numbers before strings
end

-- Records the graph reachable from `roots`. `classes`: name -> metatable. `refs`: name -> value. Returns the record, or nil
-- and the reason (with the path to the first thing it could not record).
function ObjectRecord.capture(roots: { [string]: any }, classes: { [string]: any }, refs: { [string]: any }): (Record?, string?)
	local classOf: { [any]: string } = {}
	for name, mt in classes do classOf[mt] = name end
	local refOf: { [any]: string } = {}
	for name, v in refs do
		if refOf[v] == nil then refOf[v] = name end
	end
	local index: { [any]: number } = {}
	local objects: { any } = {}
	local queue: { any } = {}
	local paths: { [any]: string } = {}
	local problem: string? = nil

	local function value(v: any, path: string): any
		if problem then return nil end
		local t = type(v)
		if t == "string" or t == "boolean" then return v end
		if t == "number" then return encodeNumber(v) end
		local ref = refOf[v]
		if ref ~= nil then return { ["$r"] = ref } end
		if isVector3(v) then
			return { ["$v"] = { encodeNumber(v.X), encodeNumber(v.Y), encodeNumber(v.Z) } }
		end
		if t == "table" then
			local mt = getmetatable(v)
			if mt ~= nil and classOf[mt] == nil then
				problem = `{path}: a table of a class this record does not know`
				return nil
			end
			local i = index[v]
			if i == nil then
				if #objects >= ObjectRecord.MAX_OBJECTS then
					problem = `{path}: more than {ObjectRecord.MAX_OBJECTS} tables`
					return nil
				end
				i = #objects + 1
				index[v] = i
				objects[i] = false
				paths[v] = path
				table.insert(queue, v)
			end
			return { ["$o"] = i }
		end
		problem = `{path}: a {typeof(v)} with no name to keep it by`
		return nil
	end

	local out: Record = { format = ObjectRecord.FORMAT, roots = {}, objects = objects }
	local rootNames: { string } = {}
	for name in roots do table.insert(rootNames, name) end
	table.sort(rootNames)
	for _, name in rootNames do
		local v = roots[name]
		if type(v) ~= "table" or refOf[v] ~= nil or isVector3(v) then
			return nil, `root {name} is not an object`
		end
		out.roots[name] = value(v, name)
	end
	local q = 1
	while q <= #queue and not problem do
		local obj = queue[q]
		q += 1
		local entries: { any } = {}
		local path = paths[obj]
		-- Keys in sorted order, so tables are numbered in the same order whatever the hash order of the live tables.
		local keys: { any } = {}
		for k in obj do
			local kt = type(k)
			if not ((kt == "string") or (kt == "number" and finite(k))) then
				problem = `{path}: a key that is not a string or a finite number`
				break
			end
			table.insert(keys, { k })
		end
		table.sort(keys, keyLess)
		for _, key in keys do
			if problem then break end
			local k = key[1]
			local enc = value(obj[k], `{path}.{k}`)
			if problem then break end
			table.insert(entries, { k, enc })
		end
		local mt = getmetatable(obj)
		objects[index[obj]] = if mt ~= nil then { c = classOf[mt], e = entries } else { e = entries }
	end
	if problem then return nil, problem end
	return out, nil
end

local function decodeNumber(x: any): (number?, string?)
	if type(x) == "number" then
		if finite(x) then return x, nil end
		return nil, "a number JSON cannot hold, written bare"
	end
	if type(x) == "table" then
		local n = x["$n"]
		if n == "inf" then return math.huge, nil end
		if n == "-inf" then return -math.huge, nil end
		if n == "nan" then return 0 / 0, nil end
	end
	return nil, "not a number"
end

local function only(t: any, key: string): boolean
	local count = 0
	for _ in t do count += 1 end
	return count == 1 and t[key] ~= nil
end

-- Checks `record` and builds every object fresh (nothing live is touched). Returns the fresh objects and roots, or nil and
-- every problem found.
function ObjectRecord.decode(record: any, classes: { [string]: any }, refs: { [string]: any }): (Decoded?, { string })
	local problems: { string } = {}
	local function bad(text: string)
		if #problems < 20 then table.insert(problems, text) end
	end
	if type(record) ~= "table" or record.format ~= ObjectRecord.FORMAT then
		return nil, { "not an object record of this format" }
	end
	local objects, roots = record.objects, record.roots
	if type(objects) ~= "table" or type(roots) ~= "table" then
		return nil, { "the record has no objects or roots" }
	end
	local n = #objects
	if n > ObjectRecord.MAX_OBJECTS then
		return nil, { "too many objects" }
	end
	for k in objects do
		if type(k) ~= "number" or k < 1 or k > n or k ~= math.floor(k) then
			return nil, { "the objects are not a list" }
		end
	end
	local fresh: { any } = table.create(n)
	for i = 1, n do fresh[i] = {} end

	local function value(v: any, where: string): any
		local t = type(v)
		if t == "string" or t == "boolean" then return v end
		if t == "number" then
			if not finite(v) then bad(`{where}: a bare number JSON cannot hold`) end
			return v
		end
		if t ~= "table" then
			bad(`{where}: a {t}`)
			return nil
		end
		if only(v, "$o") then
			local i = v["$o"]
			if type(i) ~= "number" or i < 1 or i > n or i ~= math.floor(i) then
				bad(`{where}: points at no object`)
				return nil
			end
			return fresh[i]
		end
		if only(v, "$r") then
			local name = v["$r"]
			if type(name) ~= "string" or refs[name] == nil then
				bad(`{where}: names '{tostring(name)}', which this world does not have`)
				return nil
			end
			return refs[name]
		end
		if only(v, "$v") then
			local xyz = v["$v"]
			if type(xyz) ~= "table" or #xyz ~= 3 then
				bad(`{where}: a vector without three numbers`)
				return nil
			end
			local x, e1 = decodeNumber(xyz[1])
			local y, e2 = decodeNumber(xyz[2])
			local z, e3 = decodeNumber(xyz[3])
			if e1 or e2 or e3 then
				bad(`{where}: a vector with {e1 or e2 or e3}`)
				return nil
			end
			return Vector3.new(x :: number, y :: number, z :: number)
		end
		if only(v, "$n") then
			local x, e = decodeNumber(v)
			if e then bad(`{where}: {e}`) end
			return x
		end
		bad(`{where}: a table that is none of the record's kinds`)
		return nil
	end

	for i = 1, n do
		local o = objects[i]
		local where = `object {i}`
		if type(o) ~= "table" or type(o.e) ~= "table" then
			bad(`{where}: not an object`)
			continue
		end
		if o.c ~= nil then
			if type(o.c) ~= "string" or classes[o.c] == nil then
				bad(`{where}: of class '{tostring(o.c)}', which this build does not know`)
				continue
			end
		end
		local target = fresh[i]
		for j, entry in o.e do
			if type(entry) ~= "table" or #entry ~= 2 then
				bad(`{where}, entry {j}: not a key and a value`)
				continue
			end
			local k = entry[1]
			if not (type(k) == "string" or (type(k) == "number" and finite(k))) then
				bad(`{where}, entry {j}: a key that is not a string or a finite number`)
				continue
			end
			if target[k] ~= nil then
				bad(`{where}: the key {k} twice`)
				continue
			end
			target[k] = value(entry[2], `{where}.{k}`)
		end
		if o.c ~= nil and classes[o.c] then
			setmetatable(target, classes[o.c])
		end
	end
	local out: { [string]: any } = {}
	for name, v in roots do
		if type(name) ~= "string" then
			bad("a root without a name")
			continue
		end
		local r = value(v, `root {name}`)
		if type(r) ~= "table" then
			bad(`root {name} is not an object`)
		end
		out[name] = r
	end
	if #problems > 0 then return nil, problems end
	return { roots = out, objects = fresh }, problems
end

-- Moves a decoded world into the live one: every live root (by name) ends up with exactly the fresh root's contents and
-- metatable, and every fresh reference to a fresh root now points at the live root. `live` must name every decoded root.
-- Plain table work only: it cannot fail part way. Returns false (and changes nothing) if a root is missing from `live`.
function ObjectRecord.commit(decoded: Decoded, live: { [string]: any }): boolean
	local swap: { [any]: any } = {}
	for name, fresh in decoded.roots do
		local target = live[name]
		if type(target) ~= "table" then return false end
		swap[fresh] = target
	end
	for _, o in decoded.objects do
		for k, v in o do
			local to = swap[v]
			if to ~= nil then o[k] = to end
		end
	end
	for fresh, target in swap do
		table.clear(target)
		for k, v in fresh do target[k] = v end
		setmetatable(target, getmetatable(fresh))
	end
	return true
end

-- Every plain table reachable from `root` (not through a metatable), named by its path from `name`: the species data a
-- record should keep by name rather than copy.
function ObjectRecord.constants(name: string, root: any, into: { [string]: any }?): { [string]: any }
	local out = into or {}
	local seen: { [any]: boolean } = {}
	local function walk(v: any, path: string)
		if type(v) ~= "table" or seen[v] or isVector3(v) then return end
		seen[v] = true
		out[path] = v
		for k, x in v do
			if type(k) == "string" or type(k) == "number" then walk(x, `{path}.{k}`) end
		end
	end
	walk(root, name)
	return out
end

return ObjectRecord
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">SaveEnvelope</string>
            <string name="Source"><![CDATA[--!strict
-- The versioned envelope every stored save travels in (ROBLOX-39), and how it is opened without ever guessing.
--   { format, kind, schema, updatedAt, payload, checksum, backup?, lock?, session? }
-- `checksum` is taken over the canonical JSON of { kind, schema, updatedAt, payload } (Json.checksum, the checkpoint store's own), so a
-- value that was cut short, changed or written by something else is refused even if what is left still looks like a save. `backup`
-- is the previous good version of the same kind (schema, updatedAt, payload, checksum), kept inside the same value; `lock` and
-- `session` are outside the checksum on purpose (the lock is refreshed without touching the payload).
-- Opening gives a status and never raises:
--   missing ... nothing is stored
--   ok ......... a good save of the schema this build writes
--   migrated ... a good older save, carried forward in memory (the migration table of its kind); nothing is written by opening
--   newer ...... made by a newer build: left exactly as it is, never read past its header, never written
--   corrupt .... not a save, a wrong kind, a bad checksum, or a number that is not a schema
--   invalid .... the checksum is right but the contents are not (or no migration leads from its schema)
-- A spec describes one kind: { kind, current, migrations = { [from] = function(payload) -> payload of schema from + 1 }, validate }.
-- `validate(payload)` returns (problems, cleaned payload): an empty list is a good one.
local Json = require(script.Parent.Json)
local SaveRules = require(script.Parent.Parent.Data.SaveRules)

local SaveEnvelope = {}

export type Spec = {
	kind: string, current: number,
	migrations: { [number]: (any) -> any },
	validate: (any) -> ({ string }, any?),
}
export type Opened = {
	status: string, payload: any?, schema: number?, updatedAt: number?, reasons: { string },
	lock: any?, session: string?, backup: Opened?, migratedFrom: number?,
}

local function finite(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local function checksumOf(kind: string, schema: number, updatedAt: number, payload: any): string?
	local text = Json.canonical({ kind = kind, schema = schema, updatedAt = updatedAt, payload = payload })
	if not text then return nil end
	return Json.checksum(text)
end

-- The core of a save: what the checksum covers, plus the checksum.
function SaveEnvelope.core(spec: Spec, payload: any, updatedAt: number): { [string]: any }
	return { schema = spec.current, updatedAt = updatedAt, payload = payload, checksum = checksumOf(spec.kind, spec.current, updatedAt, payload) }
end

-- Whether a stored value is a save of this kind with an intact checksum, whatever its schema (used to keep a backup).
local function intact(spec: Spec, v: any): boolean
	if type(v) ~= "table" or v.format ~= SaveRules.FORMAT or v.kind ~= spec.kind then return false end
	if not finite(v.schema) or v.schema < 1 or v.schema ~= math.floor(v.schema) or not finite(v.updatedAt) then return false end
	return checksumOf(spec.kind, v.schema, v.updatedAt, v.payload) == v.checksum and v.checksum ~= nil
end

local function openCore(spec: Spec, v: any, withBackup: boolean): Opened
	local function out(status: string, reasons: { string }, extra: { [string]: any }?): Opened
		local o: any = { status = status, reasons = reasons }
		if extra then for k, x in extra do o[k] = x end end
		return o
	end
	if v == nil then return out("missing", { "nothing is stored" }) end
	if type(v) ~= "table" or v.format ~= SaveRules.FORMAT then return out("corrupt", { "not a save of this game" }) end
	if v.kind ~= spec.kind then return out("corrupt", { `a {tostring(v.kind)} where a {spec.kind} was expected` }) end
	local schema = v.schema
	if not finite(schema) or schema < 1 or schema ~= math.floor(schema) then return out("corrupt", { "the schema is not a whole number" }) end
	local lock = if type(v.lock) == "table" then v.lock else nil
	local session = if type(v.session) == "string" then v.session else nil
	if schema > spec.current then
		return out("newer", { `made by a newer version of the game (schema {schema}; this one reads up to {spec.current})` }, { schema = schema, updatedAt = if finite(v.updatedAt) then v.updatedAt else nil, lock = lock, session = session })
	end
	if not finite(v.updatedAt) or type(v.checksum) ~= "string" or checksumOf(spec.kind, schema, v.updatedAt, v.payload) ~= v.checksum then
		local extra: any = { schema = schema, lock = lock, session = session }
		if withBackup and v.backup ~= nil then
			local b = v.backup
			if type(b) == "table" then
				extra.backup = openCore(spec, { format = v.format, kind = v.kind, schema = b.schema, updatedAt = b.updatedAt, payload = b.payload, checksum = b.checksum }, false)
			end
		end
		return out("corrupt", { "the checksum does not match: the save was cut short or changed" }, extra)
	end
	-- the stored form is intact: carry it forward to the schema this build uses
	-- (a copy: a migration that edits its argument in place must not change the stored value it was given)
	local payload: any = if schema < spec.current then Json.copy(v.payload) else v.payload
	local from = schema
	while from < spec.current do
		local step = spec.migrations[from]
		if step == nil then return out("invalid", { `no migration from schema {from}` }, { schema = schema, updatedAt = v.updatedAt, lock = lock, session = session }) end
		local ok, moved = pcall(step, payload)
		if not ok or moved == nil then return out("invalid", { `the migration from schema {from} failed` }, { schema = schema, updatedAt = v.updatedAt, lock = lock, session = session }) end
		payload = moved
		from += 1
	end
	local okV, problems, cleaned = pcall(spec.validate, payload)
	local list: { string } = if okV then (problems :: any) else { "validation raised: " .. tostring(problems) }
	local extra: any = { schema = schema, updatedAt = v.updatedAt, lock = lock, session = session }
	if #list > 0 then return out("invalid", list, extra) end
	extra.payload = if cleaned ~= nil then cleaned else payload
	if schema < spec.current then extra.migratedFrom = schema end
	return out(if schema < spec.current then "migrated" else "ok", {}, extra)
end

-- Opens a stored value. Its backup (if any) is opened too, one level deep, so a caller can fall back without a second look.
-- `wantBackup` false skips opening the backup (a write path that only needs the current value).
function SaveEnvelope.open(spec: Spec, v: any, wantBackup: boolean?): Opened
	local want = wantBackup ~= false
	local o = openCore(spec, v, want)
	if want and type(v) == "table" and o.backup == nil and v.backup ~= nil and o.status ~= "newer" and o.status ~= "missing" then
		local b = v.backup
		if type(b) == "table" then
			o.backup = openCore(spec, { format = v.format, kind = v.kind, schema = b.schema, updatedAt = b.updatedAt, payload = b.payload, checksum = b.checksum }, false)
		end
	end
	return o
end

-- The raw backup core of a stored value, when it is itself intact (so it may be kept as the next backup).
local function backupCoreOf(spec: Spec, v: any): { [string]: any }?
	if not intact(spec, v) then return nil end
	return { schema = v.schema, updatedAt = v.updatedAt, payload = v.payload, checksum = v.checksum }
end

-- A new stored value: `payload` at the current schema, the previous good value of the same kind as its backup. `prior` is the raw
-- stored value (or nil). When the prior is not intact its own backup, if intact, stays the backup. Never raises.
function SaveEnvelope.make(spec: Spec, payload: any, updatedAt: number, prior: any, extras: { [string]: any }?): { [string]: any }
	local c = SaveEnvelope.core(spec, payload, updatedAt)
	local env: { [string]: any } = { format = SaveRules.FORMAT, kind = spec.kind, schema = c.schema, updatedAt = c.updatedAt, payload = c.payload, checksum = c.checksum }
	local backup = backupCoreOf(spec, prior)
	if backup == nil and type(prior) == "table" and type(prior.backup) == "table" then
		backup = backupCoreOf(spec, { format = SaveRules.FORMAT, kind = spec.kind, schema = prior.backup.schema, updatedAt = prior.backup.updatedAt, payload = prior.backup.payload, checksum = prior.backup.checksum })
	end
	env.backup = backup
	if extras then for k, x in extras do env[k] = x end end
	return env
end

-- The same stored value with only the lock (and who holds it) changed: payload, checksum and backup are carried over untouched.
-- `lock` nil releases it.
function SaveEnvelope.withLock(v: any, lock: { [string]: any }?): any
	local out: { [string]: any } = {}
	for k, x in v do out[k] = x end
	out.lock = lock
	return out
end

-- Is this lock held by a live session other than `me` at time `now`? A lock nobody refreshed for LOCK_STALE seconds is not.
function SaveEnvelope.heldByOther(lock: any, me: string, now: number, staleAfter: number): boolean
	if type(lock) ~= "table" then return false end
	if type(lock.session) ~= "string" or lock.session == me then return false end
	if not finite(lock.beat) then return false end -- a lock with no readable beat protects nothing
	return now - lock.beat <= staleAfter
end

SaveEnvelope.intact = intact
return SaveEnvelope
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">SaveProgress</string>
            <string name="Source"><![CDATA[--!strict
-- The player's progress record (ROBLOX-39): the small precious part of a save, kept apart from the world's rests.
--   { notebook = { opened = { page ids }, eye_seconds }, finished_main, appearance, settings = { [id] = boolean | number | string }, settings_version }
-- notebook: the pages found (FieldNotebook.toRecord) and the seconds in the eye view. finished_main: a main-life Standard spider became an
-- adult, which opens Easy (Session.finishedMain; there is no separate "adult reached", it is the same fact). appearance: the spider the
-- player chose (a free choice, the peacock included). settings: the player's settings the client reads from Player attributes (ROBLOX-49:
-- Data/SettingsSpec, cleaned by UI/SettingsModel: unknown ids dropped, a wrong type refused, a number clamped into its range) and
-- settings_version, the SettingsSpec.VERSION they were written at (older ones are carried forward by SettingsModel.migrate).
-- intro_seen (ROBLOX-109, optional: absent in every record before it, and absent while false): the intro of a new life has been shown in this save, so
-- it is never shown again. Monotonic like finished_main; no schema change (a record without it reads as not seen).
-- hut_window (ROBLOX-116, optional, absent while false, as intro_seen): the preserve's ranger hut's window has been propped open (Life/Nursery). Monotonic: once
-- open it stays open in this save, for every later life. No schema change.
-- Schema 1 kept only seven true-or-false toggles as `prefs`; its migration moves them to `settings`.
-- Everything is bounded. Merging is monotonic where it can be (pages found are a union, the longest eye time and a finished main life
-- stay), and the last change wins for the choices. Unknown page ids that are well formed are kept: a build that lost a page must not
-- erase what a newer build found. Pure; checked in tests/state.luau.
local SaveRules = require(script.Parent.Parent.Data.SaveRules)
local SaveEnvelope = require(script.Parent.SaveEnvelope)
local SettingsModel = require(script.Parent.Parent.UI.SettingsModel)

local RareLedger = require(script.Parent.Parent.Life.RareLedger)
local SaveProgress = {}

SaveProgress.SCHEMA = 2
export type Payload = { notebook: { opened: { string }, eye_seconds: number }, finished_main: boolean, appearance: string?, settings: { [string]: SettingsModel.Value }, settings_version: number, intro_seen: boolean?, hut_window: boolean?, rare: RareLedger.Record? }

local function finite(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local function goodId(id: any): boolean
	return type(id) == "string" and #id >= 1 and #id <= SaveRules.MAX_ID_CHARS and string.match(id, "^[%w_]+$") ~= nil
end

function SaveProgress.default(): Payload
	return { notebook = { opened = {}, eye_seconds = 0 }, finished_main = false, appearance = nil, settings = {}, settings_version = SettingsModel.VERSION }
end

-- Checks a payload and returns (problems, cleaned copy). A wrongly typed or out-of-range field is a problem; a repeat page id and a
-- preference this build does not know are dropped quietly. `cleaned` is always a fresh table of the right shape (or nil with problems).
function SaveProgress.sanitize(raw: any): ({ string }, Payload?)
	local problems: { string } = {}
	local function bad(t: string) if #problems < 12 then table.insert(problems, t) end end
	if type(raw) ~= "table" then return { "progress is not a table" }, nil end
	local out = SaveProgress.default()
	local nb = raw.notebook
	if type(nb) ~= "table" then
		bad("no notebook")
	else
		if type(nb.opened) ~= "table" then
			bad("the notebook's pages are not a list")
		else
			local n = 0
			for _ in nb.opened do n += 1 end
			if n > SaveRules.MAX_PAGES or #nb.opened ~= n then
				bad("too many pages, or not a list")
			else
				local seen: { [string]: boolean } = {}
				for _, id in nb.opened do
					if not goodId(id) then bad("a page id that is not a short plain name"); break end
					if not seen[id] then
						seen[id] = true
						table.insert(out.notebook.opened, id)
					end
				end
			end
		end
		local eye = nb.eye_seconds
		if not finite(eye) or eye < 0 or eye > SaveRules.MAX_EYE_SECONDS then bad("eye seconds out of range") else out.notebook.eye_seconds = eye end
	end
	if type(raw.finished_main) ~= "boolean" then bad("finished_main is not true or false") else out.finished_main = raw.finished_main end
	if raw.appearance ~= nil then
		if not goodId(raw.appearance) then bad("the appearance is not a short plain name") else out.appearance = raw.appearance end
	end
	if raw.intro_seen ~= nil then
		if type(raw.intro_seen) ~= "boolean" then bad("intro_seen is not true or false") elseif raw.intro_seen then out.intro_seen = true end
	end
	if raw.hut_window ~= nil then
		if type(raw.hut_window) ~= "boolean" then bad("hut_window is not true or false") elseif raw.hut_window then out.hut_window = true end
	end
	if raw.rare~=nil then
		out.rare=RareLedger.clean(raw.rare)
		if out.rare==nil then bad("invalid rare encounter history") end
	end
	local version = SettingsModel.VERSION
	if raw.settings_version ~= nil then
		local sv = raw.settings_version
		if not finite(sv) or sv < 1 or sv ~= math.floor(sv) then bad("the settings version is not a whole number") else version = sv end
	end
	-- An older build must not silently drop future choices and write a downgraded record.
	if version > SettingsModel.VERSION then bad("settings were written by a newer build") end
	if raw.settings ~= nil then
		if type(raw.settings) ~= "table" then
			bad("settings are not a table")
		else
			local values: { [string]: any } = raw.settings
			if version < SettingsModel.VERSION then values = SettingsModel.migrate(values, version) end
			local settingProblems, settings = SettingsModel.cleanAll(values)
			for _, text in settingProblems do bad(text) end
			out.settings = settings
		end
	end
	if #problems > 0 then return problems, nil end
	return problems, out
end

-- The envelope spec of this kind. Schema 1 was the first (seven toggles as `prefs`); schema 2 (ROBLOX-49) keeps all settings. Add a migration
-- here when the payload changes shape (see tests/state.luau for the pattern under test).
SaveProgress.SPEC = {
	kind = "progress", current = SaveProgress.SCHEMA,
	migrations = {
		-- 1 to 2 (ROBLOX-49): the seven toggles kept as `prefs` become `settings`; what no longer reads as a setting is left behind.
		[1] = function(p: any): any
			local _, moved = SettingsModel.cleanAll(p.prefs)
			p.settings, p.settings_version, p.prefs = moved, 1, nil
			return p
		end,
	} :: { [number]: (any) -> any },
	validate = function(payload: any): ({ string }, any?) return SaveProgress.sanitize(payload) end,
} :: SaveEnvelope.Spec

-- Merges two payloads: `base` (stored) and `incoming` (this session's). Pages are a union (base order first), eye seconds the longest,
-- a finished main life stays finished; the appearance and the settings (key by key) come from `incoming` when it is at least as new
-- (`incomingTime` >= `baseTime`), else from `base`. Both must already be sanitized. Returns a fresh payload; trims to the page cap.
function SaveProgress.merge(base: Payload, incoming: Payload, baseTime: number, incomingTime: number): Payload
	local out = SaveProgress.default()
	local seen: { [string]: boolean } = {}
	for _, list in { base.notebook.opened, incoming.notebook.opened } do
		for _, id in list do
			if not seen[id] and #out.notebook.opened < SaveRules.MAX_PAGES then
				seen[id] = true
				table.insert(out.notebook.opened, id)
			end
		end
	end
	out.notebook.eye_seconds = math.max(base.notebook.eye_seconds, incoming.notebook.eye_seconds)
	if base.rare or incoming.rare then out.rare=RareLedger.merge(base.rare,incoming.rare) end
	out.finished_main = base.finished_main or incoming.finished_main
	if base.intro_seen == true or incoming.intro_seen == true then out.intro_seen = true end
	if base.hut_window == true or incoming.hut_window == true then out.hut_window = true end
	local newer, older = incoming, base
	if incomingTime < baseTime then newer, older = base, incoming end
	out.appearance = if newer.appearance ~= nil then newer.appearance else older.appearance
	for k, v in older.settings do out.settings[k] = v end
	for k, v in newer.settings do out.settings[k] = v end
	return out
end

-- Whether two payloads say the same thing (for deciding whether a write would change anything).
function SaveProgress.same(a: Payload, b: Payload): boolean
	if not RareLedger.same(a.rare,b.rare) then return false end
	if a.finished_main ~= b.finished_main or a.appearance ~= b.appearance or a.notebook.eye_seconds ~= b.notebook.eye_seconds then return false end
	if (a.intro_seen == true) ~= (b.intro_seen == true) then return false end
	if (a.hut_window == true) ~= (b.hut_window == true) then return false end
	if #a.notebook.opened ~= #b.notebook.opened then return false end
	for i, id in a.notebook.opened do if b.notebook.opened[i] ~= id then return false end end
	for k, v in a.settings do if b.settings[k] ~= v then return false end end
	for k, v in b.settings do if a.settings[k] ~= v then return false end end
	return true
end

-- The payload the client sends, built from what it holds. `settings` maps a setting id to its current value or nil (not set); only values
-- that are clean (SettingsModel.clean) are sent. `introSeen` (ROBLOX-109): the intro of a new life has been shown (left out, or false: not said). `hutWindow`
-- (ROBLOX-116): the preserve's hut window is open (left out, or false: not said).
function SaveProgress.snapshot(notebookRecord: any, finishedMain: boolean, appearance: string?, settings: { [string]: any }, introSeen: boolean?, hutWindow: boolean?, rare: RareLedger.Record?): Payload
	local out = SaveProgress.default()
	if type(notebookRecord) == "table" then
		if type(notebookRecord.opened) == "table" then
			for _, id in notebookRecord.opened do
				if goodId(id) and #out.notebook.opened < SaveRules.MAX_PAGES and not table.find(out.notebook.opened, id) then table.insert(out.notebook.opened, id) end
			end
		end
		if finite(notebookRecord.eye_seconds) and notebookRecord.eye_seconds >= 0 then out.notebook.eye_seconds = math.min(notebookRecord.eye_seconds, SaveRules.MAX_EYE_SECONDS) end
	end
	if rare and rare.serial>0 then out.rare=RareLedger.clean(rare) end
	out.finished_main = finishedMain
	if introSeen == true then out.intro_seen = true end
	if hutWindow == true then out.hut_window = true end
	if appearance ~= nil and goodId(appearance) then out.appearance = appearance end
	for _, id in SettingsModel.ids() do
		local v = SettingsModel.clean(id, settings[id])
		if v ~= nil then out.settings[id] = v end
	end
	return out
end

return SaveProgress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">SaveRest</string>
            <string name="Source"><![CDATA[--!strict
-- The last rest of a mode, as the server keeps it (ROBLOX-39): a retreat checkpoint (Checkpoint) in an envelope, one per mode.
-- The simulation runs on the client, so the server cannot know the rest is a true one. What it can do, and does, is refuse anything that
-- is not a whole, well-formed, sensible rest before it is stored: bounded size and depth, only plain values, the full checkpoint check
-- (Checkpoint.check: format, schema, windowsill, the spider's pose, every reference in the object graph, the books adding up) against a
-- stand-in world that names the same things the real one does, and the rules in the record agreeing with the mode it is filed under.
-- This is a boundary for corruption safety, not anti-cheat: this is a solo game with no economy, so a client that lies only affects its
-- own rest. A rest from a newer game build is refused here and, if it is already stored, left alone by SaveSession.
local SaveRules = require(script.Parent.Parent.Data.SaveRules)
local Species = require(script.Parent.Parent.Data.Species)
local Json = require(script.Parent.Json)
local Checkpoint = require(script.Parent.Checkpoint)
local SaveEnvelope = require(script.Parent.SaveEnvelope)

local SaveRest = {}

-- Schema 2 accepts a checksummed {save_retired=true,save_life=token} marker or a checkpoint with optional save_life.
-- The identity is storage metadata, not simulation state. Schema 1 migrates without changing its checkpoint.
-- Older readers must refuse schema 2, preserving the marker and its previous-checkpoint backup.
SaveRest.SCHEMA = 2
function SaveRest.validLife(token: any): boolean
 return type(token)=="string" and #token>=1 and #token<=SaveRules.MAX_LIFE_TOKEN_CHARS and string.match(token,"^[%w_:%.%-]+$")~=nil
end
function SaveRest.isRetired(payload: any): boolean
 return type(payload)=="table" and rawget(payload,"save_retired")==true
end
local function validateStored(mode: string,payload: any): ({string},any?)
 if SaveRest.isRetired(payload) then
  if not SaveRest.validLife(payload.save_life) then return {"invalid retired life identity"},nil end
  for key in payload do if key~="save_retired" and key~="save_life" then return {"unknown retirement field"},nil end end
  return {},payload
 end
 if type(payload)=="table" and (payload.save_retired~=nil or (payload.save_life~=nil and not SaveRest.validLife(payload.save_life))) then
  return {"invalid life identity"},nil
 end
 return SaveRest.check(mode,payload),payload
end

-- Counts the values in `v` and refuses anything that is not a plain string, boolean, finite number or table without a metatable, a
-- table met twice, or a structure deeper than `maxDepth` or larger than `maxNodes`. Cheap and bounded: a hostile payload is stopped
-- before anything encodes it. Returns the problem, or nil.
function SaveRest.bounded(v: any, maxNodes: number, maxDepth: number): string?
	local nodes = 0
	local seen: { [any]: boolean } = {}
	local problem: string? = nil
	local function walk(x: any, depth: number)
		if problem then return end
		nodes += 1
		if nodes > maxNodes then problem = "too many values"; return end
		local t = type(x)
		if t == "string" or t == "boolean" then return end
		if t == "number" then
			if x ~= x or x == math.huge or x == -math.huge then problem = "a number JSON cannot hold" end
			return
		end
		if t ~= "table" then problem = `a {typeof(x)}, which a save cannot hold`; return end
		if depth > maxDepth then problem = "nested too deeply"; return end
		if getmetatable(x) ~= nil then problem = "a table with a metatable"; return end
		if seen[x] then problem = "a table met twice"; return end
		seen[x] = true
		for k, y in x do
			if type(k) ~= "string" and type(k) ~= "number" then problem = "a key that is not a string or a number"; return end
			walk(y, depth + 1)
			if problem then return end
		end
	end
	walk(v, 1)
	return problem
end

-- The stand-in world: whatever a real client's world offers to Checkpoint.refs, in the same names. A record names these by string; the
-- server needs only that they exist. The species data is the real one (the record's profile references are paths into it).
local function noop() end
local function stubWorld(): Checkpoint.World
	return {
		motor = {}, 
		prey = { p = Species.fly_like_prototype, graph = { cast = noop, sweep = noop, overlap = noop }, probe = {} },
		sensor = { core = { cueEmitted = {} } },
		memory = { contactAcquired = {}, categoryChanged = {}, contactLost = {}, contactReacquired = {}, contactEnded = {} },
		needs = { onEnergyChanged = noop },
		life = { save = noop },
	} :: any
end
SaveRest.stubWorld = stubWorld

-- Every problem with a rest filed under slot `mode` ("main", "easy" or "free", SaveRules.slotOf); an empty list for a good one. Never raises.
function SaveRest.check(mode: any, record: any): { string }
	if mode ~= "main" and mode ~= "free" and mode ~= "easy" then return { "unknown mode" } end
	if type(record) ~= "table" then return { "the rest is not a table" } end
 if rawget(record,"save_retired")~=nil or (rawget(record,"save_life")~=nil and not SaveRest.validLife(rawget(record,"save_life"))) then return {"reserved or invalid life identity"} end
	local why = SaveRest.bounded(record, SaveRules.MAX_REST_NODES, SaveRules.MAX_DEPTH)
	if why then return { why } end
	local text, err = Json.canonical(record)
	if not text then return { "cannot be stored: " .. tostring(err) } end
	if #text > SaveRules.MAX_REST_CHARS then return { `the rest is {#text} characters; the limit is {SaveRules.MAX_REST_CHARS}` } end
	local rules = record.life_rules
	-- (the main slot also takes a main life on the gentle rules: an Easy rest saved before the Easy slot existed was filed there)
	if type(rules) ~= "table" or rules.mode ~= (if mode == "free" then "free" else "main") or (mode == "easy" and rules.rules ~= "gentle") then
		return { `the rules in this rest are not {mode}'s` }
	end
	local ok, result = pcall(function(): { string }
		local found = Checkpoint.check(record, stubWorld())
		return found
	end)
	if not ok then return { "the check raised: " .. tostring(result) } end
	return result :: { string }
end

-- The envelope spec of a rest of `mode`.
function SaveRest.spec(mode: string): SaveEnvelope.Spec
	return {
		kind = "rest_" .. mode, current = SaveRest.SCHEMA,
		migrations = { [1] = function(payload: any): any return payload end } :: { [number]: (any) -> any },
  validate = function(payload: any): ({ string }, any?) return validateStored(mode,payload) end,
	}
end

SaveRest.SPECS = { main = SaveRest.spec("main"), free = SaveRest.spec("free"), easy = SaveRest.spec("easy") }

return SaveRest
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">SaveScheduler</string>
            <string name="Source"><![CDATA[--!strict
-- When a save is written (ROBLOX-39): only decisions, no store and no clock of its own (the caller passes `now`, in seconds). It keeps, for
-- each thing worth saving, whether it has changed since the last good write, the earliest time to try again, and how often it has failed;
-- plus the lock's heartbeat and the one-minute request budget.
--   * a change marks the thing dirty; progress is written at most once per PROGRESS_DEBOUNCE (changes in between are coalesced into the
--     one write), a rest at most once per REST_MIN_INTERVAL (a key takes a write about every 6 s)
--   * a failure keeps it dirty and waits BACKOFF_BASE * 2^(failures - 1) seconds, up to BACKOFF_CAP (a throttle waits twice as long; a
--     configuration error waits the cap)
--   * a success clears it, unless it changed again while the write was in flight (the version counter), when it stays dirty
--   * the budget: at most REQUESTS_PER_MINUTE requests started in any minute; leaving the game or shutting down may go past it
local SaveRules = require(script.Parent.Parent.Data.SaveRules)

local SaveScheduler = {}
SaveScheduler.__index = SaveScheduler

export type Item = { dirty: boolean, version: number, sentVersion: number, nextAt: number, lastWriteAt: number, failures: number, minInterval: number, lastClass: string }

function SaveScheduler.new(): any
	return setmetatable({ items = {} :: { [string]: Item }, started = {} :: { number }, lastBeat = -1e9 }, SaveScheduler)
end

function SaveScheduler.track(self: any, name: string, minInterval: number)
	self.items[name] = { dirty = false, version = 0, sentVersion = 0, nextAt = 0, lastWriteAt = -1e9, failures = 0, minInterval = minInterval, lastClass = "" }
end

-- Something changed. The first change of a clean item sets when it is due; later changes keep that time (they join the same write).
function SaveScheduler.markDirty(self: any, name: string, now: number)
	local it: Item = self.items[name]
	it.version += 1
	if not it.dirty then
		it.dirty = true
		it.nextAt = math.max(now, it.lastWriteAt + it.minInterval)
	end
end

function SaveScheduler.isDirty(self: any, name: string): boolean
	return self.items[name].dirty
end

function SaveScheduler.anyDirty(self: any): boolean
	for _, it in self.items do if it.dirty then return true end end
	return false
end

function SaveScheduler.failures(self: any, name: string): number
	return self.items[name].failures
end

-- How many requests were started in the last minute.
local function recent(self: any, now: number): number
	local keep: { number } = {}
	for _, t in self.started do if now - t < 60 then table.insert(keep, t) end end
	self.started = keep
	return #keep
end

function SaveScheduler.budgetOk(self: any, now: number): boolean
	return recent(self, now) < SaveRules.REQUESTS_PER_MINUTE
end

-- A request is starting (counts against the budget). Returns the version being written, to hand back to `succeeded`.
function SaveScheduler.begin(self: any, name: string?, now: number): number
	table.insert(self.started, now)
	if name == nil then return 0 end
	local it: Item = self.items[name]
	it.sentVersion = it.version
	return it.version
end

-- Is this item due: dirty, its time has come, and the budget allows a request?
function SaveScheduler.due(self: any, name: string, now: number): boolean
	local it: Item = self.items[name]
	return it.dirty and now >= it.nextAt and self:budgetOk(now)
end

function SaveScheduler.succeeded(self: any, name: string, now: number, version: number)
	local it: Item = self.items[name]
	it.failures = 0
	it.lastWriteAt = now
	it.lastClass = ""
	if it.version == version then
		it.dirty = false
	else -- changed while it was being written: still dirty, due once the interval has passed
		it.nextAt = math.max(now, now + it.minInterval)
	end
end

function SaveScheduler.backoff(failures: number, class: string): number
	local n = math.max(failures, 1)
	local base = SaveRules.BACKOFF_BASE * 2 ^ (n - 1)
	if class == "throttle" then base *= 2 end
	if class == "config" then base = SaveRules.BACKOFF_CAP end
	return math.min(base, SaveRules.BACKOFF_CAP)
end

function SaveScheduler.failed(self: any, name: string, now: number, class: string): number
	local it: Item = self.items[name]
	it.failures += 1
	it.lastClass = class
	local wait = SaveScheduler.backoff(it.failures, class)
	it.nextAt = now + wait
	return wait
end

-- Gives up on an item whose current content can never be stored (class "value"): clean again, nothing pending.
function SaveScheduler.abandon(self: any, name: string)
	local it: Item = self.items[name]
	it.dirty = false
	it.failures = 0
end

function SaveScheduler.heartbeatDue(self: any, now: number): boolean
	return now - self.lastBeat >= SaveRules.HEARTBEAT and self:budgetOk(now)
end

function SaveScheduler.beat(self: any, now: number)
	self.lastBeat = now
end

return SaveScheduler
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">SaveSession</string>
            <string name="Source"><![CDATA[--!strict
-- One player's save session (ROBLOX-39): loads their records through a store backend, keeps their progress and rests in memory, and writes
-- them back safely. All the decisions are here, with no engine in them: the backend (a real DataStore or the in-memory one), the clock and
-- the sleep are handed in, so the tests drive every failure.
--
-- What it promises
--   * Nothing stored is ever replaced by a default, a guess or a lesser copy. The first thing a session does is an UpdateAsync that reads the
--     progress record and takes its lock; a record that cannot be read, is corrupt (checksum), is invalid, is made by a NEWER build, or is
--     held by a live session makes the session session-only: it keeps the player's progress in memory, tells them, and writes nothing.
--   * Writes are UpdateAsync that merge (pages are a union, eye time the longest, a finished life stays) and refuse to touch a lock another
--     live session holds. A previous good version is kept inside the value as its backup.
--   * One lock, one heartbeat: the progress record carries { session, beat }. A newer session may take it over once the beat is LOCK_STALE
--     old; the older one finds out at its next write or heartbeat and goes read-only. A read-only or failed-to-load session tries again
--     every RETRY_LOAD seconds and, once it holds the lock, merges what it kept with what is stored.
--   * Rests are separate values (one per mode): replaceable, with their own backup. A rest is written only if nobody wrote a newer one
--     since this session read it.
-- States: "loading", "active", "session" (session-only: `reason` says why: offline, no_api, load_failed, other_session, corrupt, newer).
local SaveRules = require(script.Parent.Parent.Data.SaveRules)
local SaveEnvelope = require(script.Parent.SaveEnvelope)
local SaveProgress = require(script.Parent.SaveProgress)
local SaveRest = require(script.Parent.SaveRest)
local SaveScheduler = require(script.Parent.SaveScheduler)
local SaveStores = require(script.Parent.SaveStores)
local Json = require(script.Parent.Json)

local function canonical(v: any): string
	return (Json.canonical(v)) or ""
end

local SaveSession = {}
SaveSession.__index = SaveSession

export type Config = {
	backend: any, userId: number | string, sessionId: string, now: () -> number,
	sleep: ((number) -> ())?, log: ((string) -> ())?, progressSpec: SaveEnvelope.Spec?, -- (a test may hand in a later schema)
	onChange: ((string, string?) -> ())?, onLoaded: ((any) -> ())?, onRest: ((string, any) -> ())?, onLife: ((string,number,string) -> ())?,
}


function SaveSession.new(cfg: Config): any
	local sched = SaveScheduler.new()
	sched:track("progress", SaveRules.PROGRESS_DEBOUNCE)
	local rkey: { [string]: string } = {}
	for _, mode in SaveRules.MODES do
		sched:track("rest_" .. mode, SaveRules.REST_MIN_INTERVAL)
		rkey[mode] = `{SaveRules.KEY_REST}{cfg.userId}_{mode}`
	end
	return setmetatable({
		cfg = cfg, backend = cfg.backend, id = cfg.sessionId, now = cfg.now, pspec = cfg.progressSpec or SaveProgress.SPEC,
		pkey = SaveRules.KEY_PROGRESS .. tostring(cfg.userId),
		rkey = rkey,
		sched = sched,
		state = "loading", reason = nil :: string?, canRetry = false, retryAt = 0,
		progress = SaveProgress.default(), progressTime = 0, storedTime = 0,
		rests = {} :: { [string]: any }, lifeTokens = {} :: {[string]:string}, lifeRequests = {} :: {[string]:any},
		restBase = {} :: { [string]: number }, -- updatedAt of the rest this session last read or wrote (nil: unknown)
		restPending = {} :: { [string]: any }, restPendingTime = {} :: { [string]: number },
		restLoaded = {} :: { [string]: boolean }, restRetryAt = 0,
		restRejected = {} :: { [string]: boolean }, -- a locally kept rest the server could not accept
		lockHeld = false, busy = false, closed = false,
		lastStatus = "", lastReason = "",
		counters = { requests = 0, writes = 0, rejected = 0 },
	}, SaveSession)
end

local function log(self: any, text: string)
	local l = self.cfg.log
	if l then l(`[save {self.cfg.userId}] {text}`) end
end

local function lockNow(self: any, now: number): { [string]: any }
	return { session = self.id, beat = now }
end

-- Every slot's rest has been read (or found missing) at least once.
function SaveSession.restsLoaded(self: any): boolean
	for _, mode in SaveRules.MODES do
		if not self.restLoaded[mode] then return false end
	end
	return true
end

function SaveSession.isActive(self: any): boolean
	return self.state == "active"
end

function SaveSession.status(self: any): (string, string?)
	if self.state == "session" then return SaveRules.STATUS.session, self.reason end
	if self.state == "loading" then return SaveRules.STATUS.saving, nil end
	if next(self.restRejected) ~= nil then return SaveRules.STATUS.saving, "rest_refused" end
	if self.busy or self.sched:anyDirty() or not SaveSession.restsLoaded(self) then
		local trouble = false
		for _, item in self.sched.items do
			if item.dirty and item.failures >= 3 then trouble = true end
		end
		return SaveRules.STATUS.saving, if trouble then "write_failed" else nil
	end
	return SaveRules.STATUS.saved, nil
end

function SaveSession.notify(self: any)
	local status, reason = self:status()
	local r = reason or ""
	if status ~= self.lastStatus or r ~= self.lastReason then
		self.lastStatus, self.lastReason = status, r
		local f = self.cfg.onChange
		if f then f(status, reason) end
	end
end

-- Goes session-only. The progress in memory stays; nothing more is written until the lock is held again (when `retry` is true).
function SaveSession.demote(self: any, reason: string, retry: boolean)
	if self.state == "session" and self.reason == reason then return end
	log(self, "session-only: " .. reason)
	self.state, self.reason, self.lockHeld = "session", reason, false
	self.canRetry = retry
	self.retryAt = self.now() + SaveRules.RETRY_LOAD
	self:notify()
end

-- ---------------------------------------------------------------- loading
-- One try at reading the progress record and taking its lock. Returns a verdict:
--   "ok" (held), "locked", "newer", "corrupt", "failed" (the store failed: class in .errClass), "config".
local function attemptLock(self: any): (string, any)
	local now = self.now()
	local verdict = ""
	local info: any = nil
	self.sched:begin(nil, now)
	self.counters.requests += 1
	local ok, _, err = self.backend:update(self.pkey, function(old: any): any
		local op = SaveEnvelope.open(self.pspec, old)
		info = op
		verdict = op.status
		if op.status == "newer" or op.status == "corrupt" or op.status == "invalid" then return nil end
		if op.status == "missing" then
			verdict = "ok"
			return SaveEnvelope.make(self.pspec, SaveProgress.default(), now, nil, { lock = lockNow(self, now) })
		end
		if SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then
			verdict = "locked"
			return nil
		end
		verdict = "ok"
		return SaveEnvelope.withLock(old, lockNow(self, now))
	end)
	if not ok then
		local class = SaveStores.classify(err)
		return if class == "config" then "config" else "failed", { err = err, class = class }
	end
	if verdict == "invalid" then verdict = "corrupt" end
	return verdict, info
end

local function adoptStored(self: any, info: any)
	-- The progress in memory (kept while the session was session-only, or sent by the client before the load finished) is merged into what is stored.
	local stored: any = if info and info.payload then info.payload else SaveProgress.default()
	local storedTime = if info and info.updatedAt then info.updatedAt else 0
	local mem = self.progress
	self.progress = SaveProgress.merge(stored, mem, storedTime, self.progressTime)
	self.storedTime = storedTime
	if not SaveProgress.same(self.progress, stored) then
		self.sched:markDirty("progress", self.now())
	end
end

local function readRests(self: any)
	for _, mode in SaveRules.MODES do
		if not self.restLoaded[mode] then
			local ok, value, err = self.backend:read(self.rkey[mode])
			self.sched:begin(nil, self.now())
			self.counters.requests += 1
			if not ok then
				log(self, `could not read the {mode} rest: {tostring(err)}`)
				self.restRetryAt = self.now() + SaveScheduler.backoff(1, SaveStores.classify(err))
			else
				local spec = SaveRest.SPECS[mode]
				local op = SaveEnvelope.open(spec, value)
				self.restLoaded[mode] = true
				if op.status == "ok" or op.status == "migrated" then
					self.restBase[mode] = op.updatedAt
					self.lifeTokens[mode] = op.payload.save_life
     self.rests[mode] = if SaveRest.isRetired(op.payload) then nil else op.payload
				elseif op.status == "missing" then
					self.restBase[mode] = 0
     self.lifeTokens[mode],self.rests[mode]=nil,nil
				else
					-- A readable backup is offered in memory only. Preserve the original unreadable record for recovery.
					self.restBase[mode] = op.updatedAt or 0
					local b = op.backup
					if b and (b.status == "ok" or b.status == "migrated") and not SaveRest.isRetired(b.payload) then self.rests[mode] = b.payload end
					log(self, `the {mode} rest is {op.status}: {op.reasons[1] or ""}`)
					self:demote(if op.status == "newer" then "newer" else "corrupt", false)
				end
				local request=self.lifeRequests[mode]
    local queued=self.restPending[mode]
    if (request and request.done and request.token~=self.lifeTokens[mode])
     or (queued and not SaveRest.isRetired(queued) and queued.save_life~=self.lifeTokens[mode]) then
     self:demote("other_session",false) -- another life won while ownership was unavailable; never relabel our queued world
    end
    if request and not request.done then self.rests[mode]=nil end
    -- a rest we hold unsent that is newer than the one stored stays pending; an older one is dropped
				local pending = self.restPendingTime[mode]
				if pending ~= nil and not SaveRest.isRetired(self.restPending[mode]) and (self.restBase[mode] or 0) > pending then
					self.restPending[mode], self.restPendingTime[mode] = nil, nil
					self.sched.items["rest_" .. mode].dirty = false
				end
			end
		end
	end
end

-- Loads the player's records. Yields (backend calls). Returns the state: "active" or "session".
function SaveSession.load(self: any): string
	if self.closed then return self.state end
	local verdict, info = attemptLock(self)
	local first = self.state == "loading"
	if verdict == "ok" then
		adoptStored(self, info)
		self.state, self.reason, self.lockHeld, self.canRetry = "active", nil, true, false
		self.sched:beat(self.now())
		self.restLoaded = {} -- read again: another session may have written a rest while this one could not
		readRests(self)
	elseif verdict == "locked" then
		if info and info.payload then self.progress = SaveProgress.merge(info.payload, self.progress, info.updatedAt or 0, self.progressTime) end
		self.state = "session"
		self:demote("other_session", true)
	elseif verdict == "newer" then
		self.state = "session"
		self:demote("newer", false)
	elseif verdict == "corrupt" then
		-- the stored record is left exactly as it is. If its backup is good the player sees that much of their notebook meanwhile.
		local b = info and info.backup
		if b and (b.status == "ok" or b.status == "migrated") then self.progress = SaveProgress.merge(b.payload, self.progress, b.updatedAt or 0, self.progressTime) end
		log(self, "the progress record is not readable: " .. tostring(info and info.reasons and info.reasons[1]))
		self.state = "session"
		self:demote("corrupt", false)
	elseif verdict == "config" then
		self.state = "session"
		self:demote("no_api", false)
	else
		log(self, "could not load: " .. tostring(info and info.err))
		self.state = "session"
		self:demote("load_failed", true)
	end
	if first or self.state == "active" then self:notify() end
	return self.state
end

-- ---------------------------------------------------------------- what the client gives and what is known
function SaveSession.setProgress(self: any, payload: any): boolean
	if self.closed then return false end
	local big = SaveRest.bounded(payload, SaveRules.MAX_PROGRESS_NODES, SaveRules.MAX_PROGRESS_DEPTH)
	if big then
		self.counters.rejected += 1
		log(self, "progress refused: " .. big)
		return false
	end
	local problems, clean = SaveProgress.sanitize(payload)
	if clean == nil then
		self.counters.rejected += 1
		log(self, "progress refused: " .. tostring(problems[1]))
		return false
	end
	local now = self.now()
	local merged = SaveProgress.merge(self.progress, clean, self.progressTime, now)
	if not SaveProgress.same(merged, self.progress) then
		self.progress = merged
		self.progressTime = now
		self.sched:markDirty("progress", now)
		self:notify()
	end
	return true
end

-- A session-local increasing intent makes retries idempotent and later New Life choices supersede earlier ones.
-- The marker goes through the same guarded UpdateAsync and backup path as a rest; never DeleteAsync.
function SaveSession.beginLife(self: any,mode: string,serial: any): boolean
 if self.closed or SaveRest.SPECS[mode]==nil or type(serial)~="number" or serial~=serial or serial<1 or serial>SaveRules.MAX_LIFE_SERIAL or serial~=math.floor(serial) then return false end
 local prior=self.lifeRequests[mode]
 if prior and serial<prior.serial then return false end
 if prior and serial==prior.serial then
  if prior.done and self.cfg.onLife then pcall(self.cfg.onLife,mode,serial,prior.token) end
  return true
 end
 local token=`{self.id}:{mode}:{serial}`
 if not SaveRest.validLife(token) then return false end
 self.lifeRequests[mode]={serial=serial,token=token,done=false}
 self.rests[mode],self.restRejected[mode]=nil,nil
 self.restPending[mode]={save_retired=true,save_life=token}
 self.restPendingTime[mode]=self.now()
 self.sched:markDirty("rest_"..mode,self.now());self:notify()
 return true
end

-- Legacy callers intentionally have no life credential; extra Lua return values are ignored here.
function SaveSession.setRest(self: any,mode: string,record: any): boolean
 return self:setRestForLife(mode,record,nil)
end
function SaveSession.setRestForLife(self: any, mode: string, record: any,lifeToken: string?): boolean
	if self.closed or SaveRest.SPECS[mode] == nil then return false end
 local request=self.lifeRequests[mode]
 if (request and not request.done) or lifeToken~=self.lifeTokens[mode] then
  self.counters.rejected+=1
  return false -- never let a late prior-life rest cross a retirement boundary
 end
-- Validate the exact stored candidate, including our identity metadata, against both size and node caps.
 local stamped=record
 local copyProblem: string?=nil
 if type(record)=="table" and getmetatable(record)==nil then
  stamped={}
  local count=0
  for key,value in record do
   count+=1
   if count>SaveRules.MAX_REST_NODES then copyProblem="too many root values";break end
   stamped[key]=value
  end
  stamped.save_life=self.lifeTokens[mode]
 end
 local problems = if copyProblem then {copyProblem} else SaveRest.check(mode, stamped)
	if #problems > 0 then
		self.counters.rejected += 1
		log(self, `the {mode} rest was refused: {problems[1]}`)
		self.restRejected[mode] = true
		self:notify()
		return false
	end
	local now = self.now()
	self.restRejected[mode] = nil
 self.restPending[mode], self.restPendingTime[mode] = stamped, now
	self.sched:markDirty("rest_" .. mode, now)
	self:notify()
	return true
end

-- ---------------------------------------------------------------- writing
-- Writes the progress (merged with what is stored). `release`: also let go of the lock. Returns true when it is stored.
local function writeProgress(self: any, release: boolean): boolean
	local now = self.now()
	local version = self.sched:begin("progress", now)
	self.counters.requests += 1
	local outcome = ""
	local merged: any = nil
	local newTime = now
	local ok, _, err = self.backend:update(self.pkey, function(old: any): any
		outcome = ""
		local op = SaveEnvelope.open(self.pspec, old, false)
		if op.status == "newer" then outcome = "newer"; return nil end
		if op.status == "corrupt" or op.status == "invalid" then outcome = "corrupt"; return nil end
		if op.status ~= "missing" and SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then outcome = "locked"; return nil end
		local base: any = if op.payload then op.payload else SaveProgress.default()
		local baseTime = op.updatedAt or 0
		merged = SaveProgress.merge(base, self.progress, baseTime, self.progressTime)
		newTime = math.max(now, baseTime)
		outcome = "ok"
		local lock = if release then nil else lockNow(self, now)
		if op.status ~= "missing" and SaveProgress.same(merged, base) and op.status == "ok" then
			return SaveEnvelope.withLock(old, lock) -- nothing new to say: only the lock moves (payload, checksum and backup untouched)
		end
		return SaveEnvelope.make(self.pspec, merged, newTime, old, { lock = lock })
	end)
	if not ok then
		local class = SaveStores.classify(err)
		if class == "value" then
			log(self, "the progress record cannot be stored: " .. tostring(err))
			self.sched:abandon("progress")
			self:demote("write_failed", false)
			return false
		end
		local wait = self.sched:failed("progress", now, class)
		log(self, `progress write failed ({class}, retry in {wait} s): {tostring(err)}`)
		return false
	end
	if outcome == "ok" then
		-- UpdateAsync yields after its callback. Keep progress that arrived while the request was in flight.
		self.progress = SaveProgress.merge(merged, self.progress, newTime, self.progressTime)
		self.storedTime = newTime
		self.sched:succeeded("progress", now, version)
		self.sched:beat(now)
		self.counters.writes += 1
		if release then self.lockHeld = false end
		return true
	end
	if outcome == "locked" then
		self:demote("other_session", true)
	elseif outcome == "newer" then
		self:demote("newer", false)
	elseif outcome == "corrupt" then
		self:demote("corrupt", false)
	end
	return false
end

local function writeRest(self: any, mode: string): boolean
	-- Never overwrite a record whose load failed, including during shutdown.
	if not self.restLoaded[mode] or self.restBase[mode] == nil then return false end
	local name = "rest_" .. mode
	local record = self.restPending[mode]
	if record == nil then
		self.sched.items[name].dirty = false
		return true
	end
	if not SaveRest.isRetired(record) and record.save_life~=self.lifeTokens[mode] then
  self.restPending[mode],self.restPendingTime[mode]=nil,nil
  self.sched:abandon(name);self:demote("other_session",false)
  return false
 end
 local now = self.now()
 local version = self.sched:begin(name, now)
	self.counters.requests += 1
	local spec = SaveRest.SPECS[mode]
	local outcome = ""
	local newTime = now
 local expectedLife=self.lifeTokens[mode]
	local ok, _, err = self.backend:update(self.rkey[mode], function(old: any): any
		outcome = ""
		local op = SaveEnvelope.open(spec, old, false)
		if op.status == "newer" then outcome = "newer"; return nil end
		if op.status == "corrupt" or op.status == "invalid" then outcome = "corrupt"; return nil end
		if (op.status=="ok" or op.status=="migrated") and op.payload.save_life~=expectedLife and op.session~=self.id then
   outcome="superseded";return nil -- life identities protect even simultaneous writes with equal timestamps
  end
  local base = self.restBase[mode]
		if (op.status == "ok" or op.status == "migrated") and base ~= nil and (op.updatedAt or 0) > base and op.session ~= self.id then
			outcome = "superseded"
			return nil
		end
		if (op.status == "ok") and canonical(op.payload) == canonical(record) then
			-- already stored (an earlier try whose answer was lost): nothing to write, and the backup must not become a copy of it
			newTime = op.updatedAt or now
			outcome = "ok"
			return nil
		end
		newTime = math.max(now, op.updatedAt or 0)
		outcome = "ok"
		return SaveEnvelope.make(spec, record, newTime, old, { session = self.id })
	end)
	if not ok then
		local class = SaveStores.classify(err)
		if class == "value" then
			log(self, `the {mode} rest cannot be stored: {tostring(err)}`)
			self.restPending[mode], self.restPendingTime[mode] = nil, nil
			self.sched:abandon(name)
			self:demote("write_failed", false)
			return false
		end
		local wait = self.sched:failed(name, now, class)
		log(self, `{mode} rest write failed ({class}, retry in {wait} s): {tostring(err)}`)
		return false
	end
	if outcome == "ok" then
		self.restBase[mode] = newTime
		self.lifeTokens[mode]=record.save_life
  self.rests[mode] = if SaveRest.isRetired(record) then nil else record
  local request=self.lifeRequests[mode]
  if SaveRest.isRetired(record) and request and request.token==record.save_life then
   request.done=true
   if self.cfg.onLife then pcall(self.cfg.onLife,mode,request.serial,request.token) end
  end
  if self.restPending[mode] == record then self.restPending[mode], self.restPendingTime[mode] = nil, nil end
		self.sched:succeeded(name, now, version)
		self.counters.writes += 1
		return true
	end
	if outcome == "superseded" then
		self:demote("other_session", true)
	elseif outcome == "newer" then
		self:demote("newer", false)
	elseif outcome == "corrupt" then
		self:demote("corrupt", false)
	end
	return false
end

-- Refreshes the lock when no write has done it lately.
local function heartbeat(self: any)
	local now = self.now()
	self.sched:begin(nil, now)
	self.counters.requests += 1
	local outcome = ""
	local ok, _, err = self.backend:update(self.pkey, function(old: any): any
		outcome = ""
		local op = SaveEnvelope.open(self.pspec, old, false)
		if op.status == "missing" then outcome = "missing"; return nil end
		if op.status == "newer" then outcome = "newer"; return nil end
		if op.status == "corrupt" or op.status == "invalid" then outcome = "corrupt"; return nil end
		if SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then outcome = "locked"; return nil end
		outcome = "ok"
		return SaveEnvelope.withLock(old, lockNow(self, now))
	end)
	if not ok then
		log(self, "heartbeat failed: " .. tostring(err))
		self.sched:beat(now - SaveRules.HEARTBEAT + 5) -- try again in a few seconds
		return
	end
	self.sched:beat(now)
	if outcome == "locked" then self:demote("other_session", true)
	elseif outcome == "newer" then self:demote("newer", false)
	elseif outcome == "corrupt" then self:demote("corrupt", false) end
end

-- One pass of the periodic work; the server calls it about once a second. Does at most one request per call. Returns whether it asked.
local function stepInner(self: any): boolean
	local now = self.now()
	local did = true
	if self.state == "session" then
		if self.canRetry and now >= self.retryAt and self.sched:budgetOk(now) then
			self.retryAt = now + SaveRules.RETRY_LOAD
			local wasReason = self.reason
			self:load()
			if SaveSession.isActive(self) then
				log(self, `holds the record again (was: {tostring(wasReason)})`)
				local f = self.cfg.onLoaded
				if f then f(self:snapshot()) end
			end
		else
			did = false
		end
	elseif self.state == "active" then
		-- A failed rest read must not starve lock renewal for a live player.
		if self.sched:due("progress", now) then
			writeProgress(self, false) -- also renews the lock
		elseif self.sched:heartbeatDue(now) then
			heartbeat(self)
		elseif not SaveSession.restsLoaded(self) then
			if now >= self.restRetryAt and self.sched:budgetOk(now) then
				local before: { [string]: any } = {}
				for _, mode in SaveRules.MODES do before[mode] = self.rests[mode] end
				readRests(self)
				for _, mode in SaveRules.MODES do
					if self.rests[mode] ~= nil and before[mode] == nil then
						local f = self.cfg.onRest
						if f then f(mode, self.rests[mode]) end
					end
				end
			else
				did = false
			end
		else
			did = false
			for _, mode in SaveRules.MODES do
				if self.sched:due("rest_" .. mode, now) then
					writeRest(self, mode)
					did = true
					break
				end
			end
		end
	else
		did = false
	end
	return did
end

function SaveSession.step(self: any): boolean
	if self.closed or self.busy then return false end
	self.busy = true
	local ok, did = pcall(stepInner, self)
	self.busy = false
	if not ok then
		log(self, "step failed: " .. tostring(did))
		return false
	end
	self:notify()
	return did :: boolean
end

-- The state to hand the client: progress, the rests found, and the status.
function SaveSession.snapshot(self: any): any
	local status, reason = self:status()
	local rests: { [string]: any } = {}
	for _, mode in SaveRules.MODES do
  local request=self.lifeRequests[mode]
  if not request or request.done then rests[mode]=self.rests[mode] end
 end
 return { status = status, reason = reason, progress = self.progress, rests = rests, lives = Json.copy(self.lifeTokens) }
end

-- Leaving/shutdown keeps ownership until the pending records finish; a new visit must not load half a flush.
function SaveSession.flush(self: any, deadline: number?)
	if self.closed or self.flushing then return end
	self.flushing = true
	local sleep = self.cfg.sleep
	local limit = deadline or (self.now() + SaveRules.FLUSH_DEADLINE)
	while self.busy and self.now() < limit and sleep do sleep(0.25) end
	if self.busy or self.now() >= limit then
		self.closed, self.flushing = true, false
		return -- never overlap an in-flight request; its lock will expire if it cannot finish
	end
	if self.state == "active" then
		self.busy = true
		local attempt = 0
		while attempt < SaveRules.FLUSH_ATTEMPTS and self.state == "active" and self.now() < limit do
			attempt += 1
			-- Also checks ownership before touching a rest, even when progress itself is unchanged.
			local progressDone = writeProgress(self, false)
			local restsDone = true
			if progressDone and self.state == "active" then
				for _, mode in SaveRules.MODES do
					if self.restPending[mode] ~= nil then
						if self.now() >= limit or self.state ~= "active" or not writeRest(self, mode) then restsDone = false end
					end
				end
				if restsDone and self.state == "active" and self.now() < limit then
					if writeProgress(self, true) then break end -- release only after every rest has completed
				end
			end
			if self.now() >= limit or sleep == nil then break end
			sleep(math.min(SaveRules.FLUSH_BACKOFF * 2 ^ (attempt - 1), math.max(0, limit - self.now())))
		end
		self.busy = false
	end
	self.closed, self.flushing = true, false
	self:notify()
end

return SaveSession
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">SaveStores</string>
            <string name="Source"><![CDATA[--!strict
-- Two small pure rules about the stores (ROBLOX-39): which store a build writes to, and what kind of failure a DataStore error is.
local SaveRules = require(script.Parent.Parent.Data.SaveRules)

local SaveStores = {}

-- Which DataStore name to use. Studio and the test place always use the test store, so a Studio run (even with API access on, even of the
-- production project) never touches a real save. A live server of the production place uses the production store. `attribute` is the
-- Workspace attribute SaveStore: it may only choose a test-looking name or the test default, never the production name for a test run.
function SaveStores.name(isStudio: boolean, isTestPlace: boolean, attribute: any): string
	if isStudio or isTestPlace then
		if type(attribute) == "string" and string.match(attribute, "^WindowsillTest[%w_]*$") and #attribute <= 40 then return attribute end
		return SaveRules.STORE_TEST
	end
	return SaveRules.STORE_PRODUCTION
end

-- What kind of failure a DataStore error is, from its message (Roblox puts a number and a sentence in it: "104: Cannot store ..." and the
-- like). Classes:
--   "throttle"  the request was over a budget or queued out: wait and try again, slower
--   "config"    saving cannot work here at all (Studio API access off, an unpublished place, DataStores disabled): do not keep hammering
--   "value"     this key or value can never be stored (a bad key, too large, not storable): retrying the same thing cannot work
--   "transient" anything else (a timeout, the service down, an unknown error): try again later
-- The mapping of messages to classes is from Roblox's documented error codes (101-106 key and value, 301-306 throttles, 4xx and 5xx
-- service); it has not been checked against a live DataStore, and an unknown message is treated as transient on purpose.
function SaveStores.classify(message: any): string
	local m = string.lower(tostring(message))
	local code = tonumber(string.match(m, "^%s*(%d%d%d)%s*:"))
	if code ~= nil then
		if code >= 301 and code <= 306 then return "throttle" end
		if code == 101 or code == 102 or code == 103 or code == 104 or code == 105 then return "value" end
		if code == 403 or code == 401 or code == 402 then return "config" end
	end
	if string.find(m, "studio access", 1, true) or string.find(m, "studioaccesstoapis", 1, true) or string.find(m, "not allowed", 1, true)
		or string.find(m, "publish", 1, true) or string.find(m, "disabled", 1, true) or string.find(m, "must be enabled", 1, true) then
		return "config"
	end
	if string.find(m, "throttl", 1, true) or string.find(m, "over limit", 1, true) or string.find(m, "request queue", 1, true) or string.find(m, "too many requests", 1, true) then
		return "throttle"
	end
	if string.find(m, "too large", 1, true) or string.find(m, "cannot store", 1, true) or string.find(m, "value size", 1, true) or string.find(m, "exceeds", 1, true) then
		return "value"
	end
	return "transient"
end

return SaveStores
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="93">
        <Properties>
          <string name="Name">Predator</string>
        </Properties>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">Bird</string>
            <string name="Source"><![CDATA[--!strict
-- The robin of the open ground (ROBLOX-120, docs/PARK_WORLD_DESIGN.md sections 4 and 5: the bird is the danger of the hut garden, the meadow and the open ground
-- between; section 10 names the American robin at the feeder). An American robin (Turdus migratorius), at true size: 25 cm from bill to tail (the sources give 20 to
-- 28 cm), foraging on the ground as the sources describe it: it runs or hops a few steps, stops abruptly, stands still with its head cocked to one side looking at the
-- ground, and takes what it sees (earthworms most of all, and insects, snails and spiders). Pure: no engine, no drawing (Client/BirdBody draws it), so the client,
-- the self-test, the previewer and the CLI suites ask exactly the same bird.
--
-- Its day is a seeded schedule (`Bird.plan(seed, day)`: the world's seed through WorldMap.seed(914, "bird"), a Park-Miller stream per day): four to six visits between
-- 06:00 and 19:30, each to one of SITES (the hut garden's lawn west and east of the path, the bench patch's gravel by the path's end, the meadow's mown edge; ROBLOX-122:
-- the mown path east toward the pond), so where
-- the robin is at an hour of a day is a pure function of the seed, the day and the hour, and a return to a rest finds it where the schedule says (restores never reroll;
-- nothing of it is saved). A visit, in seconds at the outdoors' pace (HOUR_PER_S: the garden's clock, 0.33 of the hut's):
--   approach ..... it flies in low over the ground from FLY_FROM studs off, gliding down onto the site's first point: its SHADOW sweeps over the ground ahead of it,
--                  and it calls ("pick, tut-tut-tut") as it comes in. This is how it is told first: a shadow and a call.
--   ground ....... it forages along the site's line, a stop (STOP seconds, its head cocked, now and then a peck at the ground) and a hop (HOP_LEN studs in HOP_S), over
--                  and back, for FORAGE seconds.
--   leave ........ it flies off up and away (its shadow again), calling.
--
-- What it does to a jumping spider (`step`): on the ground, a spider that MOVES in the open within NOTICE of its head catches its eye (`noticed`). It hops toward it
-- (never more than STALK_MAX off its line), and in REACH it stops dead with its head cocked at the spider for TELL seconds: the honest tell, a pause anyone watching
-- can see. If the spider is still moving in the open at the end of it, the robin strikes: in the standard rules a death with its own card (UI/BirdText, `struck`), in
-- the gentle rules (Easy, Free play) the bill misses (`missed`). The way out is cover or stillness: a spider in a retreat or resting (`hidden`), under something
-- (`Bird.covered`: a box over it within COVER_UP), low in the meadow's grass (`Bird.inGrass`), or keeping still for STILL_LOSE seconds, is lost (`lost`), and the
-- robin goes back to its foraging for COOLDOWN seconds before anything catches its eye again. It never reacts while it flies, and a spider high up (more than HIGH over
-- the ground it stands on) is not on its ground. Live state that is not saved: the reaction, how far it hopped off its line (eased back after).
-- Studs (a stud is a centimetre), the sill's frame (World/Preserve: +x east, -z north; the garden's ground World/Hut.GROUND).
local Bird = {}
Bird.__index = Bird

local GT = -84.6 -- the ground of the hut garden and the meadow (World/Hut.GROUND, World/Meadow.GROUND)
local v = Vector3.new

-- ---------------------------------------------------------------- the numbers (the game's, but the bird's size and its run-and-stop are the sources')
Bird.LENGTH = 25 -- studs, bill to tail
Bird.HEAD_Y = 13 -- its head over the ground, standing
Bird.HOUR_PER_S = 12.0 / (15.0 * 60.0) * 0.33 -- game hours a second at the outdoors' pace (Life/LifeClock.ACTIVE_HOURS_PER_S x the garden's clockScale)
Bird.APPROACH_S = 3.0 -- the flight in
Bird.LEAVE_S = 2.5 -- and off
Bird.FLY_FROM = 900 -- how far off (studs, in plan) the flight in starts
Bird.FLY_UP = 320 -- and how high over the ground
Bird.FORAGE = table.freeze({ 70.0, 150.0 }) -- seconds on the ground a visit
Bird.STOP = table.freeze({ 1.2, 3.6 }) -- a stop, head cocked
Bird.HOP_S = 0.3 -- a hop (a few quick steps: the "run")
Bird.HOP_LEN = table.freeze({ 10.0, 26.0 })
Bird.PECK = 0.35 -- a share of the stops end in a peck at the ground
Bird.VISITS = table.freeze({ 4, 6 })
Bird.DAY = table.freeze({ 6.0, 19.5 })
Bird.NOTICE = 70 -- how near (studs, in plan, from its head) a moving spider catches its eye
Bird.HIGH = 30 -- a spider more than this over the ground it stands on is not on its ground
Bird.REACH = 16 -- in plan from its bill's base: the dash and the stab
Bird.STALK_MAX = 90 -- how far it hops off its line toward what it saw
Bird.STALK_SPEED = 45 -- studs a second, hopping toward it
Bird.TELL = 0.85 -- the pause, head cocked at the spider, before the strike
Bird.STRIKE_S = 0.2 -- the stab
Bird.MOVING = 0.5 -- studs a second: slower than this, a spider is keeping still
Bird.STILL_LOSE = 1.2 -- seconds still and it loses the spider
Bird.COOLDOWN = 6.0 -- seconds after it lost one before anything catches its eye again
Bird.COVER_UP = 60 -- a box over the spider within this is cover from a bird's eye
Bird.GRASS_LOW = 25 -- in the meadow, lower than this over the ground is down in the grass
Bird.SHADOW_NEAR = 80 -- a shadow passing within this (in plan) of the spider is told
Bird.HEAR = 2500 -- studs: how far its call carries for the caption (25 m)
Bird.CALL_S = 2.5 -- it calls this long as it lands and as it leaves

-- The sites it forages, each a line on the ground it hops along (over and back): the hut garden's lawn either side of the path (clear of the trough, the stone and the
-- feeder's pole), the bench patch's gravel by the path's end (clear of the slab and the grate) and the meadow's mown edge along the gravel. `from`: the way it flies in
-- from (in plan), `zone` World/Preserve's.
export type Site = { id: string, zone: string, line: { Vector3 }, from: Vector3 }
local function site(id: string, zone: string, from: Vector3, pts: { { number } }): Site
	local line = {}
	for _, p in pts do table.insert(line, v(p[1], GT, p[2])) end
	return table.freeze({ id = id, zone = zone, line = table.freeze(line), from = from.Unit })
end
Bird.SITES = table.freeze({
	site("lawn_w", "hut_garden", v(-1, 0, -0.4), { { -185, -80 }, { -130, -115 }, { -70, -90 }, { -15, -125 } }),
	site("lawn_e", "hut_garden", v(1, 0, -0.3), { { 20, -130 }, { 80, -125 }, { 130, -100 }, { 185, -112 } }),
	site("gravel", "bench", v(0.4, 0, 1), { { -190, -550 }, { -100, -580 }, { -20, -545 }, { 70, -590 } }),
	site("edge", "meadow", v(-1, 0, 0.5), { { -290, -826 }, { -180, -822 }, { -60, -827 }, { 60, -823 }, { 170, -826 } }),
	-- (ROBLOX-122) the mown path east from the bench patch toward the pond (World/Pond's mown_e*): the long open way between the meadow and the boardwalk
	site("path", "ground", v(0.3, 0, 1), { { 110, -682 }, { 150, -675 }, { 190, -685 }, { 230, -678 }, { 270, -683 } }),
}) :: { Site }
Bird.GROUND = GT

-- ---------------------------------------------------------------- the schedule
local MOD = 2147483647
local function rng(seed: number, salt: number): () -> number
	local state = (seed + salt * 7919) % MOD
	if state <= 0 then state += MOD - 1 end
	return function(): number
		state = (state * 16807) % MOD
		return (state - 1) / (MOD - 1)
	end
end
local function between(rand: () -> number, a: number, b: number): number
	return a + (b - a) * rand()
end

-- A move on the ground: a stop from t0 (head cocked; a peck from `peck` if it pecks) and a hop from t1 to t2 from `a` to `b`.
export type Move = { t0: number, t1: number, t2: number, a: Vector3, b: Vector3, heading: Vector3, peck: number? }
-- A visit: its start (hours), its site, its seconds (approach, ground, leave) and its moves on the ground.
export type Visit = { h0: number, h1: number, site: Site, forage: number, moves: { Move }, leaveFrom: Vector3, leaveTo: Vector3, cock: number }

-- The point `d` studs along a line walked over and back (a ping-pong), and the way it faces there.
local function along(line: { Vector3 }, d: number): (Vector3, Vector3)
	local total = 0
	for i = 2, #line do total += (line[i] - line[i - 1]).Magnitude end
	local s = d % (2 * total)
	local back = s > total
	if back then s = 2 * total - s end
	for i = 2, #line do
		local a, b = line[i - 1], line[i]
		local l = (b - a).Magnitude
		if s <= l or i == #line then
			local k = math.clamp(s / l, 0, 1)
			local dir = (b - a).Unit
			return a:Lerp(b, k), if back then -dir else dir
		end
		s -= l
	end
	return line[1], Vector3.xAxis
end

local planCache: { [string]: { Visit } } = {}
-- The robin's day: its visits, in order (none overlap).
function Bird.plan(seed: number, day: number): { Visit }
	local key = tostring(seed) .. "/" .. tostring(day)
	if planCache[key] then return planCache[key] end
	local rand = rng(seed, 2000 + day)
	local n = Bird.VISITS[1] + math.floor(rand() * (Bird.VISITS[2] - Bird.VISITS[1] + 1))
	local span = (Bird.DAY[2] - Bird.DAY[1]) / n
	local out: { Visit } = {}
	for i = 1, n do
		local s = Bird.SITES[1 + math.floor(rand() * #Bird.SITES) % #Bird.SITES]
		local forage = between(rand, Bird.FORAGE[1], Bird.FORAGE[2])
		local whole = (Bird.APPROACH_S + forage + Bird.LEAVE_S) * Bird.HOUR_PER_S
		local h0 = Bird.DAY[1] + (i - 1) * span + rand() * math.max(0, span - whole)
		-- the moves: from the line's first point, a stop and a hop, over and back
		local moves: { Move } = {}
		local t = 0.0
		local d = 0.0
		local here, heading = along(s.line, 0)
		while t < forage do
			local stop = between(rand, Bird.STOP[1], Bird.STOP[2])
			local peck = if rand() < Bird.PECK then t + stop * between(rand, 0.4, 0.75) else nil
			d += between(rand, Bird.HOP_LEN[1], Bird.HOP_LEN[2])
			local nextAt, nextHeading = along(s.line, d)
			local t1 = math.min(t + stop, forage)
			local t2 = math.min(t1 + Bird.HOP_S, forage)
			table.insert(moves, table.freeze({ t0 = t, t1 = t1, t2 = t2, a = here, b = if t2 > t1 then nextAt else here, heading = heading, peck = peck }))
			here, heading = (if t2 > t1 then nextAt else here), nextHeading
			t = t2
		end
		local up = Vector3.new(-s.from.X, 0, -s.from.Z)
		table.insert(out, table.freeze({
			h0 = h0, h1 = h0 + whole, site = s, forage = forage, moves = table.freeze(moves), leaveFrom = here,
			leaveTo = here + up * Bird.FLY_FROM + Vector3.yAxis * Bird.FLY_UP, cock = if rand() < 0.5 then -1 else 1,
		}))
	end
	planCache[key] = table.freeze(out)
	return out
end

-- Where the schedule has it at `hour` of `day`: nil when it is not here; else its place (pos: its feet, or its body in flight), heading, pose ("fly", "land",
-- "hop", "stand", "peck", "leave"), the shadow's place on the ground (nil while it stands: then the shadow is under it, drawn by the body), and whether it calls.
export type Place = { pos: Vector3, heading: Vector3, pose: string, shadow: Vector3?, calling: boolean, visit: Visit, secs: number, flying: boolean }
function Bird.at(seed: number, day: number, hour: number): Place?
	for _, visit in Bird.plan(seed, day) do
		if hour >= visit.h0 and hour < visit.h1 then
			local secs = (hour - visit.h0) / Bird.HOUR_PER_S
			local s = visit.site
			if secs < Bird.APPROACH_S then
				-- the glide in: from FLY_FROM off and FLY_UP up, down onto the line's first point, flattening out at the end
				local k = secs / Bird.APPROACH_S
				local land = s.line[1]
				local start = land + s.from * Bird.FLY_FROM + Vector3.yAxis * Bird.FLY_UP
				local e = 1 - (1 - k) * (1 - k)
				local flat = land:Lerp(start, 1 - k)
				local p = v(flat.X, land.Y + Bird.FLY_UP * (1 - e), flat.Z)
				local h = -s.from
				return { pos = p, heading = h, pose = if k > 0.85 then "land" else "fly", shadow = v(p.X, GT, p.Z), calling = true, visit = visit, secs = secs, flying = k <= 0.85 }
			end
			local g = secs - Bird.APPROACH_S
			if g < visit.forage then
				for _, m in visit.moves do
					if g < m.t2 or m == visit.moves[#visit.moves] then
						local calling = g < Bird.CALL_S
						if g < m.t1 then
							local pose = if m.peck ~= nil and g >= m.peck and g < m.peck + 0.4 then "peck" else "stand"
							return { pos = m.a, heading = m.heading, pose = pose, shadow = nil, calling = calling, visit = visit, secs = secs, flying = false }
						end
						local k = math.clamp((g - m.t1) / math.max(m.t2 - m.t1, 1e-6), 0, 1)
						local flat = m.b - m.a
						local hd = if flat.Magnitude > 1e-3 then v(flat.X, 0, flat.Z).Unit else m.heading
						return { pos = m.a:Lerp(m.b, k) + Vector3.yAxis * (math.sin(k * math.pi) * 3), heading = hd, pose = "hop", shadow = nil, calling = calling, visit = visit,
							secs = secs, flying = false }
					end
				end
			end
			-- off: up and away along the way it came, the other way
			local k = math.clamp((g - visit.forage) / Bird.LEAVE_S, 0, 1)
			local e = k * k
			local flat = visit.leaveFrom:Lerp(visit.leaveTo, e)
			local p = v(flat.X, GT + (visit.leaveTo.Y - GT) * e, flat.Z)
			local hd = v(visit.leaveTo.X - visit.leaveFrom.X, 0, visit.leaveTo.Z - visit.leaveFrom.Z).Unit
			return { pos = p, heading = hd, pose = "leave", shadow = v(p.X, GT, p.Z), calling = k < 0.6, visit = visit, secs = secs, flying = k > 0.08 }
		end
	end
	return nil
end

-- ---------------------------------------------------------------- cover (pure: the client hands in the region's boxes)
-- Whether a box of `pieces` is over a spider at `p`: its footprint over the point and its underside above it, within COVER_UP.
function Bird.covered(pieces: { any }, p: Vector3): boolean
	for _, b in pieces do
		local lo, hi = b.lo or b.min, b.hi or b.max
		if lo.Y > p.Y + 0.3 and lo.Y < p.Y + Bird.COVER_UP and p.X > lo.X - 0.2 and p.X < hi.X + 0.2 and p.Z > lo.Z - 0.2 and p.Z < hi.Z + 0.2 then return true end
	end
	return false
end
-- Whether a spider at `p` in a region of `kind` is down in the meadow's grass.
function Bird.inGrass(kind: string?, p: Vector3): boolean
	return kind == "meadow" and p.Y - GT < Bird.GRASS_LOW
end

-- ---------------------------------------------------------------- the live robin
export type Spider = { pos: Vector3, speed: number, hidden: boolean, covered: boolean }
export type Signal = { kind: string, at: Vector3? }

function Bird.new(seed: number): any
	return setmetatable({
		seed = seed, day = 1, hour = 0, here = false,
		pos = Vector3.zero, heading = Vector3.xAxis, pose = "away", shadow = nil :: Vector3?, calling = false, flying = false, site = nil :: string?,
		look = nil :: Vector3?, cock = 1, -- the point its cocked head looks at, and which side the head tips
		react = "none", reactS = 0, stillS = 0, cooldown = 0, offset = Vector3.zero, strikeAt = nil :: Vector3?, strikeS = -1,
		notices = 0, strikes = 0, misses = 0, losses = 0, shadows = 0, landings = 0, -- (this session's: the self-test reads them)
		gentle = false, enabled = true, signals = {} :: { Signal }, shadowNear = false, wasHere = false,
	}, Bird)
end

-- Its head (where it looks from) and its bill's base (where it strikes from).
function Bird.head(self: any): Vector3
	return self.pos + self.heading * 6 + Vector3.yAxis * Bird.HEAD_Y
end
function Bird.bill(self: any): Vector3
	return v(self.pos.X, GT, self.pos.Z) + self.heading * 9
end
local function flat(a: Vector3, b: Vector3): number
	return v(a.X - b.X, 0, a.Z - b.Z).Magnitude
end
local function emit(self: any, kind: string, at: Vector3?)
	table.insert(self.signals, { kind = kind, at = at })
end

-- One step of `dt` seconds at the life clock's (day, hour), with the spider as it is now (nil while there is no life to touch). Signals: "landed" (it is on the
-- ground: told by its call), "shadow" (its shadow passed near the spider), "noticed", "lost", "struck" (standard rules), "missed" (gentle rules).
function Bird.step(self: any, dt: number, day: number, hour: number, spider: Spider?)
	self.day, self.hour = day, hour
	self.cooldown = math.max(0, self.cooldown - dt)
	if self.strikeS >= 0 then self.strikeS += dt; if self.strikeS > Bird.STRIKE_S + 0.3 then self.strikeS = -1 end end
	local place = Bird.at(self.seed, day, hour)
	if place == nil then
		self.here, self.pose, self.shadow, self.calling, self.flying, self.site = false, "away", nil, false, false, nil
		self.react, self.look, self.offset, self.wasHere = "none", nil, Vector3.zero, false
		return
	end
	self.here = true
	self.site = place.visit.site.id
	self.cock = place.visit.cock
	if not self.wasHere then self.wasHere = true end
	local onGround = not place.flying and place.pose ~= "fly" and place.pose ~= "leave" and place.pose ~= "land"
	if onGround and self.pose ~= "stand" and self.pose ~= "hop" and self.pose ~= "peck" and self.pose ~= "watch" and self.pose ~= "strike" then
		self.landings += 1
		emit(self, "landed", place.pos)
	end
	-- the stalk's offset eases back when it is not reacting, and is gone once it flies
	if not onGround then self.offset, self.react, self.look = Vector3.zero, "none", nil end
	if self.react == "none" and self.offset.Magnitude > 0 then
		local back = math.min(self.offset.Magnitude, Bird.STALK_SPEED * 0.5 * dt)
		self.offset -= self.offset.Unit * back
	end
	self.pos = place.pos + self.offset
	self.shadow, self.calling, self.flying = place.shadow, place.calling, place.flying
	if self.react == "none" then self.heading, self.pose, self.look = place.heading, place.pose, nil end
	-- the shadow passing over the spider (told once a pass)
	if spider ~= nil and place.shadow ~= nil then
		local near = flat(place.shadow, spider.pos) <= Bird.SHADOW_NEAR
		if near and not self.shadowNear then self.shadows += 1; emit(self, "shadow", place.shadow) end
		self.shadowNear = near
	else
		self.shadowNear = false
	end
	if not self.enabled or spider == nil or not onGround then return end
	local moving = spider.speed >= Bird.MOVING
	local open = not spider.hidden and not spider.covered and spider.pos.Y - GT <= Bird.HIGH
	if self.react == "none" then
		if self.cooldown <= 0 and moving and open and flat(Bird.head(self), spider.pos) <= Bird.NOTICE then
			self.react, self.reactS, self.stillS = "stalk", 0, 0
			self.notices += 1
			emit(self, "noticed", spider.pos)
		end
		return
	end
	-- a reaction under way: it faces the spider
	self.reactS += dt
	self.look = spider.pos
	local toward = v(spider.pos.X - self.pos.X, 0, spider.pos.Z - self.pos.Z)
	if toward.Magnitude > 0.5 then self.heading = toward.Unit end
	self.stillS = if moving then 0 else self.stillS + dt
	local function lose()
		self.react, self.cooldown, self.look = "none", Bird.COOLDOWN, nil
		self.losses += 1
		emit(self, "lost", spider.pos)
	end
	if not open or self.stillS >= Bird.STILL_LOSE or flat(Bird.head(self), spider.pos) > Bird.NOTICE * 1.4 then lose(); return end
	if self.react == "stalk" then
		if flat(Bird.bill(self), spider.pos) <= Bird.REACH then
			self.react, self.reactS, self.pose = "tell", 0, "watch"
			return
		end
		-- hop toward it, never far off its line
		self.pose = "hop"
		local step = toward.Unit * math.min(Bird.STALK_SPEED * dt, math.max(0, toward.Magnitude - Bird.REACH * 0.5))
		local nextOffset = self.offset + step
		if nextOffset.Magnitude <= Bird.STALK_MAX then self.offset = nextOffset; self.pos = place.pos + nextOffset else self.pose = "watch" end
		return
	end
	if self.react == "tell" then
		self.pose = "watch" -- (the head cocked at the spider, still: the tell)
		if self.reactS >= Bird.TELL then
			self.react, self.reactS, self.pose = "none", 0, "strike"
			self.strikeS, self.strikeAt = 0, spider.pos
			self.cooldown = Bird.COOLDOWN
			if flat(Bird.bill(self), spider.pos) <= Bird.REACH * 1.25 and moving then
				if self.gentle then
					self.misses += 1
					emit(self, "missed", spider.pos)
				else
					self.strikes += 1
					emit(self, "struck", spider.pos)
				end
			else
				self.losses += 1
				emit(self, "lost", spider.pos)
			end
		end
	end
end

-- Takes the signals since the last call.
function Bird.drainSignals(self: any): { Signal }
	local out = self.signals
	self.signals = {}
	return out
end

-- How loud its call is to a spider at `at` (0..1): while it calls, by distance.
function Bird.call(self: any, at: Vector3): number
	if not self.here or not self.calling then return 0 end
	return math.clamp(1 - (self.pos - at).Magnitude / Bird.HEAR, 0, 1)
end

-- Whether it is in the middle of something with the spider.
function Bird.reacting(self: any): boolean
	return self.react ~= "none"
end

-- The first visit of a day to a site (for the self-test and the previewer: a place and an hour where it is on the ground there), or nil.
function Bird.visitTo(seed: number, day: number, siteId: string): Visit?
	for _, visit in Bird.plan(seed, day) do
		if visit.site.id == siteId then return visit end
	end
	return nil
end
-- The hour `secs` seconds into a visit.
function Bird.hourOf(visit: Visit, secs: number): number
	return visit.h0 + secs * Bird.HOUR_PER_S
end

return Bird
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">Cat</string>
            <string name="Source"><![CDATA[--!strict
-- The ranger's cat (ROBLOX-118, docs/PARK_WORLD_DESIGN.md section 10: "the cat and the game room live in the hut"): a house cat that lives in the ranger hut's
-- two rooms and never leaves them. Pure: no engine, no drawing (Rig/CatPose draws it, Client/CatBody puts the parts in the world), so the client, the self-test
-- and the CLI suites ask exactly the same cat.
--
-- Its day is a seeded schedule (`Cat.plan(seed, day)`: the world's seed through WorldMap.seed(914, "cat"), a Park-Miller stream per day), so where the cat is at
-- an hour of a day is a pure function of the seed, the day and the hour, and a return to a rest finds it where the schedule says (restores never reroll): it
-- sleeps on the back room's sofa or on the chair at the desk by the sill through much of the day, as cats do (they sleep twelve hours or more, most of it in
-- naps); it is up at dawn and dusk and for a while in the night, and then it walks the two rooms through the doorway, eats at its bowls by the door, grooms
-- on the rug, waits by the door for the ranger, and sits on the back room's deep window sill looking out. Every day begins and ends asleep on the sofa.
--
-- It is heard before it is seen: the bell on its collar rings with every step (a small bell carries a few metres), and it purrs as it settles to rest
-- (`sound`). It notices a small thing that moves near it (`step`): it stops, its head follows the thing, and if the thing keeps moving and is in reach it
-- crouches and pats at it with a forepaw, fast. What saves a spider is what saves any small thing from a cat: being out of its reach (up high: the desk, the
-- lamp, the bookcase's top, a wall), in a gap it cannot get a paw into (a home, the gap under the sofa), or keeping still until it loses interest. In Normal a
-- pat that lands kills the spider (`struck`); in the gentle rules (Easy, Free play) it only knocks it aside (`nudged`).
--
-- Live state that is not saved: the reaction under way, how far the cat has stepped off its schedule to stalk, and how far behind its schedule watching left it
-- (`lag`: it then runs its schedule a little faster until it has caught up). A return to a rest ends a reaction and puts the cat where its schedule says. Saved
-- (`toRecord`, Persistence/Checkpoint's optional `cat`): the day it last swatted and this life's notices, pats that missed and pats that landed.
--
-- Studs (a stud is a centimetre), the sill's frame (World/Hut: +x east, -z north, the hut's floor at y -70). True size: a domestic cat about 46 cm long without
-- its tail, 23 to 25 cm at the shoulder (Rig/CatPose has the body).
local Cat = {}
Cat.__index = Cat

local FL = -70 -- the floor (World/Hut.FLOOR)
local v = Vector3.new

-- ---------------------------------------------------------------- the numbers
Cat.WALK_SPEED = 60 -- studs a second: a cat's unhurried walk, 0.6 m/s
Cat.JUMP_S = 0.55 -- seconds a jump up or down takes
Cat.NOTICE = 125 -- how near (studs, in plan, from its head) a moving thing catches its eye
Cat.NOTICE_UP = 130 -- and how high over the surface it stands on (it watches what moves on a wall)
Cat.REACH = 24 -- how far its pat reaches in plan from its chest
Cat.REACH_UP = 50 -- and how high over its surface (up on its hind legs)
Cat.MOVING = 0.5 -- studs a second: slower than this, a spider is keeping still
Cat.WAKE_SPEED = 1.1 -- creeping can pass a sleeping cat; sustained walking wakes it
Cat.WAKE_S = 2 -- seconds of nearby roaming before it gets up
Cat.STILL_LOSE = 2.5 -- seconds of stillness and it loses interest
Cat.HIGH_LOSE = 5.0 -- seconds staring at what it cannot reach and it gives up
Cat.WATCH = table.freeze({ 1.2, 3.0 }) -- seconds it watches before it moves on what it watches (a draw per notice)
Cat.CROUCH_S = 0.6 -- the crouch and the wiggle before the pat
Cat.SWAT_S = 0.25 -- the pat itself (the paw is at the far end of its reach halfway through)
Cat.STALK_SPEED = 20 -- studs a second, low and slow toward the thing
Cat.STALK_MAX = 80 -- the farthest it steps off its schedule's place to stalk
Cat.COOLDOWN = 12 -- seconds after it gives up before anything catches its eye again
Cat.MISSES = 2 -- pats that miss before it gives up
Cat.CATCH_UP = 0.5 -- after a reaction its schedule runs this much faster until it has caught up
Cat.HEAR_BELL = 350 -- studs: how far the bell is heard (about 3.5 m)
Cat.HEAR_PURR = 70 -- and the purr (under a metre)
Cat.PURR_H = 0.4 -- hours of purring as it settles to a rest
local HOUR_PER_S = 12.0 / (15.0 * 60.0) -- Life/LifeClock.ACTIVE_HOURS_PER_S: game hours a second at the hut's pace (1.0)
Cat.HOUR_PER_S = HOUR_PER_S

-- Where it rests and sits, the surface it is on, which way it faces, and the floor point it jumps up from (or walks to).
export type Spot = { pos: Vector3, heading: Vector3, kind: string, node: string, up: boolean }
Cat.SPOTS = table.freeze({
	sofa = table.freeze({ pos = v(300, -25, 205), heading = v(1, 0, 0), kind = "rest", node = "sofa_front", up = true }), -- on the sofa's seat (World/Hut.SOFA)
	chair = table.freeze({ pos = v(86, -24, 108), heading = v(0, 0, -1), kind = "rest", node = "chair_side", up = true }), -- on the chair at the desk by the sill
	window = table.freeze({ pos = v(437, 0, 134), heading = v(1, 0, 0), kind = "sit", node = "window_floor", up = true }), -- on the back room's window sill
	bowls = table.freeze({ pos = v(-87, FL, 220), heading = v(0, 0, 1), kind = "eat", node = "bowls", up = false }), -- at its bowls by the door
	door = table.freeze({ pos = v(0, FL, 228), heading = v(0, 0, 1), kind = "sit", node = "door", up = false }), -- waiting by the door
	rug = table.freeze({ pos = v(315, FL + 1, 130), heading = v(1, 0, 0.3).Unit, kind = "groom", node = "rug", up = false }), -- grooming on the rug
}) :: { [string]: Spot }
Cat.SPOT_ORDER = table.freeze({ "sofa", "chair", "window", "bowls", "door", "rug" })
-- The floor's ways through the two rooms (clear of the furniture: the sofa, the television's unit, the shelves, the caddy, the radiator), and the doorway.
Cat.NODES = table.freeze({
	hut_mid = v(0, FL, 160), chair_side = v(45, FL, 108), bowls = v(-87, FL, 220), door = v(0, FL, 228),
	doorway_w = v(125, FL, 215), doorway_e = v(195, FL, 215), room_w = v(205, FL, 140), rug = v(315, FL + 1, 130),
	sofa_front = v(300, FL, 152), window_floor = v(405, FL, 134),
}) :: { [string]: Vector3 }
local EDGES = {
	{ "hut_mid", "chair_side" }, { "hut_mid", "bowls" }, { "hut_mid", "door" }, { "bowls", "door" }, { "hut_mid", "doorway_w" }, { "doorway_w", "doorway_e" },
	{ "doorway_e", "room_w" }, { "room_w", "rug" }, { "room_w", "sofa_front" }, { "rug", "sofa_front" }, { "rug", "window_floor" }, { "sofa_front", "window_floor" },
}
Cat.EDGES = EDGES
-- The two rooms in plan (it notices only what is in the room it is in; the doorway is both), and what its body cannot go into when it stalks.
Cat.ROOMS = table.freeze({ hut = table.freeze({ -146.5, 146.5 }), back = table.freeze({ 175, 445 }) }) :: { [string]: { number } }
local BLOCKS = {
	{ 225, 425, 165.5, 254 }, { 185, 275, 14, 52.5 }, { 360, 440, 14, 44 }, { 425, 441, 100, 163 }, -- the sofa, the television's unit, the games, the radiator
	{ -146.5, -118.5, 116, 204 }, { 68, 90, 228, 246 }, -- the bookcase, the caddy
	{ -101, -73, 38, 66 }, { -140.4, -120, 59, 81 }, -- station boots and field pack
}
Cat.BLOCKS = BLOCKS

-- ---------------------------------------------------------------- the schedule
local MOD = 2147483647
local function rng(seed: number, salt: number): () -> number
	local state = (seed + salt * 7919) % MOD
	if state <= 0 then state += MOD - 1 end
	return function(): number
		state = (state * 16807) % MOD
		return (state - 1) / (MOD - 1)
	end
end
local function between(rand: () -> number, a: number, b: number): number
	return a + (b - a) * rand()
end

-- The shortest way over the floor between two nodes (Dijkstra over the few edges), as points.
local routeCache: { [string]: { Vector3 } } = {}
local function route(a: string, b: string): { Vector3 }
	local key = a .. ">" .. b
	if routeCache[key] then return routeCache[key] end
	local N = Cat.NODES
	local dist: { [string]: number } = { [a] = 0 }
	local prev: { [string]: string } = {}
	local done: { [string]: boolean } = {}
	while true do
		local best, bd = nil :: string?, math.huge
		for n, d in dist do if not done[n] and d < bd then best, bd = n, d end end
		if best == nil or best == b then break end
		done[best] = true
		for _, e in EDGES do
			local other = if e[1] == best then e[2] elseif e[2] == best then e[1] else nil
			if other ~= nil and not done[other] then
				local d = bd + (N[best] - N[other]).Magnitude
				if dist[other] == nil or d < dist[other] then dist[other] = d; prev[other] = best end
			end
		end
	end
	local out = {}
	local n: string? = b
	while n ~= nil do
		table.insert(out, 1, N[n])
		n = if n == a then nil else prev[n]
	end
	routeCache[key] = out
	return out
end
Cat.route = route

export type Segment = { t0: number, t1: number, kind: string, spot: string, from: string?, path: { Vector3 }?, length: number?, up: number?, down: number? }

-- The way from one spot to another: down from the first (when it is up on something), over the floor, up onto the second; its points, its length on the
-- floor, and the seconds of its jumps.
local function walkBetween(a: string, b: string): ({ Vector3 }, number, number, number)
	local A, B = Cat.SPOTS[a], Cat.SPOTS[b]
	local pts: { Vector3 } = {}
	if A.up then table.insert(pts, A.pos) end
	local floor = route(A.node, B.node)
	for _, p in floor do table.insert(pts, p) end
	if B.up then table.insert(pts, B.pos) end
	local length = 0 -- (on the floor only: the jumps take their own time)
	for i = 2, #floor do length += (floor[i] - floor[i - 1]).Magnitude end
	return pts, length, if B.up then Cat.JUMP_S else 0, if A.up then Cat.JUMP_S else 0
end

-- How long each kind of stop lasts (hours), by the part of the day.
local function partOf(h: number): string
	if (h >= 5 and h < 8.5) or (h >= 17 and h < 21) then return "crepuscular" end
	if h >= 8.5 and h < 17 then return "day" end
	return "night"
end
local WEIGHTS: { [string]: { [string]: number } } = {
	crepuscular = { bowls = 0.22, window = 0.28, rug = 0.2, door = 0.12, chair = 0.06, sofa = 0.12 },
	day = { sofa = 0.36, chair = 0.3, window = 0.14, rug = 0.1, bowls = 0.05, door = 0.05 },
	night = { sofa = 0.55, rug = 0.15, bowls = 0.12, window = 0.18 },
}
local function stay(spot: string, part: string, rand: () -> number): number
	local kind = Cat.SPOTS[spot].kind
	if kind == "rest" then return if part == "day" then between(rand, 1.4, 3.2) else between(rand, 0.5, 1.4) end
	if spot == "window" then return between(rand, 0.3, 1.0) end
	if kind == "eat" then return between(rand, 0.08, 0.16) end
	if kind == "groom" then return between(rand, 0.15, 0.4) end
	return between(rand, 0.1, 0.3) -- (by the door)
end

local planCache: { [string]: { Segment } } = {}
-- The cat's day: its segments from 0 to 24 hours, each a stop at a spot or a walk between two (the walk's points, its floor length and its jumps).
function Cat.plan(seed: number, day: number): { Segment }
	local key = tostring(seed) .. "/" .. tostring(day)
	if planCache[key] then return planCache[key] end
	local rand = rng(seed, 1000 + day)
	local out: { Segment } = {}
	local spot = "sofa"
	local t = between(rand, 4.5, 5.5)
	table.insert(out, { t0 = 0, t1 = t, kind = "rest", spot = "sofa" })
	local function go(to: string)
		local pts, length, up, down = walkBetween(spot, to)
		local dur = (length / Cat.WALK_SPEED + up + down) * HOUR_PER_S
		table.insert(out, { t0 = t, t1 = t + dur, kind = "walk", spot = to, from = spot, path = pts, length = length, up = up, down = down })
		t += dur
		spot = to
	end
	while t < 22.5 do
		local part = partOf(t)
		local w = WEIGHTS[part]
		local total = 0
		for _, name in Cat.SPOT_ORDER do if name ~= spot then total += w[name] or 0 end end
		local x = rand() * total
		local pick = "sofa"
		for _, name in Cat.SPOT_ORDER do
			if name ~= spot and (w[name] or 0) > 0 then
				x -= w[name]
				if x <= 0 then pick = name; break end
			end
		end
		go(pick)
		local d = stay(pick, part, rand)
		local t1 = math.min(t + d, 23.2)
		table.insert(out, { t0 = t, t1 = t1, kind = Cat.SPOTS[pick].kind, spot = pick })
		t = t1
	end
	if spot ~= "sofa" then go("sofa") end
	table.insert(out, { t0 = t, t1 = 24, kind = "rest", spot = "sofa" })
	for _, s in out do table.freeze(s) end
	planCache[key] = table.freeze(out)
	return out
end

-- Where the schedule has the cat at `hour` of `day`: its position (on the surface it stands on), heading, pose ("walk", "jump", "sit", "rest", "sleep", "eat",
-- "groom"), the surface's height, and whether it is purring.
export type Place = { pos: Vector3, heading: Vector3, pose: string, surface: number, purring: boolean, spot: string, segment: Segment }
function Cat.at(seed: number, day: number, hour: number): Place
	local plan = Cat.plan(seed, day)
	local h = math.clamp(hour, 0, 24 - 1e-9)
	local seg = plan[#plan]
	for _, s in plan do
		if h < s.t1 then seg = s; break end
	end
	if seg.kind ~= "walk" then
		local S = Cat.SPOTS[seg.spot]
		local pose = seg.kind
		local purring = false
		if seg.kind == "rest" then
			purring = h - seg.t0 < Cat.PURR_H and seg.t0 > 0
			pose = if purring then "rest" else "sleep"
		end
		return { pos = S.pos, heading = S.heading, pose = pose, surface = S.pos.Y, purring = purring, spot = seg.spot, segment = seg }
	end
	-- a walk: down from where it was (a jump), along the floor, up onto where it is going (a jump), each at its own pace
	local secs = (h - seg.t0) / HOUR_PER_S
	local pts = seg.path :: { Vector3 }
	local down, up, length = seg.down or 0, seg.up or 0, seg.length or 0
	local first, last = 1, #pts
	local function jump(a: Vector3, b: Vector3, k: number): Place
		local p = a:Lerp(b, k) + v(0, math.sin(k * math.pi) * 18, 0)
		local flat = v(b.X - a.X, 0, b.Z - a.Z)
		local hd = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.zAxis
		return { pos = p, heading = hd, pose = "jump", surface = p.Y, purring = false, spot = seg.spot, segment = seg }
	end
	if down > 0 then
		if secs < down then return jump(pts[1], pts[2], secs / down) end
		secs -= down
		first = 2
	end
	local floorEnd = if up > 0 then last - 1 else last
	local walkS = length / Cat.WALK_SPEED
	if secs >= walkS and up > 0 then return jump(pts[floorEnd], pts[last], math.clamp((secs - walkS) / up, 0, 1)) end
	-- along the floor's points from `first` to `floorEnd`
	local d = math.clamp(secs, 0, walkS) * Cat.WALK_SPEED
	for i = first, floorEnd - 1 do
		local a, b = pts[i], pts[i + 1]
		local l = (b - a).Magnitude
		if d <= l or i == floorEnd - 1 then
			local k = if l > 1e-6 then math.clamp(d / l, 0, 1) else 1
			local flat = v(b.X - a.X, 0, b.Z - a.Z)
			return { pos = a:Lerp(b, k), heading = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.zAxis, pose = "walk", surface = a.Y + (b.Y - a.Y) * k,
				purring = false, spot = seg.spot, segment = seg }
		end
		d -= l
	end
	local p = pts[floorEnd]
	return { pos = p, heading = Vector3.zAxis, pose = "walk", surface = p.Y, purring = false, spot = seg.spot, segment = seg }
end

-- ---------------------------------------------------------------- the live cat
export type Spider = { pos: Vector3, speed: number, hidden: boolean, visible: boolean? }
export type Signal = { kind: string, at: Vector3?, away: Vector3? }

-- A new cat for a world seed (WorldMap.seed(914, "cat")).
function Cat.new(seed: number): any
	local self = setmetatable({
		seed = seed, day = 1, hour = 0,
		-- where it is and what it is doing, as drawn
		pos = Cat.SPOTS.sofa.pos, heading = Cat.SPOTS.sofa.heading, pose = "sleep", surface = Cat.SPOTS.sofa.pos.Y, purring = false, spot = "sofa",
		look = nil :: Vector3?, -- the point its head follows, while it watches something
		-- the live reaction (never saved)
		react = "none", reactS = 0, watchS = 0, stillS = 0, highS = 0, misses = 0, cooldown = 0, lag = 0, offset = Vector3.zero, pawAt = nil :: Vector3?, swatHit = false,
		-- this life's record (saved)
		notices = 0, pats = 0, swats = 0, lastSwatDay = 0,
		gentle = false, enabled = true, wakeS = 0, advance = 0,
		signals = {} :: { Signal },
	}, Cat)
	return self
end

-- The room a point is in, in plan ("hut", "back", or "doorway" for the doorway between, which is both).
function Cat.roomOf(p: Vector3): string?
	if p.X >= 146.5 and p.X <= 175 and p.Z >= 180 and p.Z <= 250 then return "doorway" end
	-- The window recess belongs to the room up to the pane. Otherwise both
	-- a spider on the sill and the seated cat's eyes were classified outside.
	if p.X > 445 and p.X < 459 and p.Z >= 98 and p.Z <= 170 then return "back" end
	for name, r in Cat.ROOMS do if p.X >= r[1] - 1 and p.X <= r[2] + 1 and p.Z >= 12.5 - 30 and p.Z <= 255.5 + 1 then return name end end
	return nil
end
local function sameRoom(a: Vector3, b: Vector3): boolean
	local ra, rb = Cat.roomOf(a), Cat.roomOf(b)
	if ra == nil or rb == nil then return false end
	return ra == rb or ra == "doorway" or rb == "doorway"
end
-- Whether its body can step to (x, z) on the floor when it stalks.
function Cat.free(x: number, z: number): boolean
	if x > 120 and x < 200 and z > 188 and z < 242 then return true end -- (through the doorway, x 146.5..175, z 180..250, and either side of it)
	for _, b in BLOCKS do if x > b[1] - 10 and x < b[2] + 10 and z > b[3] - 10 and z < b[4] + 10 then return false end end
	local r = Cat.roomOf(v(x, FL, z))
	if r == "hut" then return x > -146.5 + 12 and x < 146.5 - 12 and z > 12.5 + 12 and z < 255.5 - 12 end
	if r == "back" then return x > 175 + 12 and x < 445 - 12 and z > 12.5 + 12 and z < 255.5 - 12 end
	return r == "doorway"
end

-- Whether a spider at `p` is under the sofa (in the dark under its frame, where no paw reaches: World/Hut.SOFA's footprint, under its frame's 8 cm).
function Cat.under(p: Vector3): boolean
	local b = BLOCKS[1]
	return p.X > b[1] + 4 and p.X < b[2] - 4 and p.Z > b[3] + 4 and p.Z < b[4] - 4 and p.Y < -62
end

-- Its head and its chest, where it looks from and pats from.
function Cat.head(self: any): Vector3
	local seated = self.pose == "sit" or self.pose == "groom"
		or (self.pose == "watch" and (self.spot == "window" or self.surface > -60))
	-- Match CatPose's seated head, not its standing head outside the glass.
	if seated then return self.pos + self.heading * 12.5 + v(0,29,0) end
	return self.pos + self.heading * 24 + v(0, if self.pose == "sleep" or self.pose == "rest" then 8 else 22, 0)
end
function Cat.chest(self: any): Vector3
	return self.pos + self.heading * 14
end

local function flat(a: Vector3, b: Vector3): number
	return v(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Whether a spider at `p` is in its paw's reach: near its chest in plan, and no higher over its surface than it can rise to.
function Cat.inReach(self: any, p: Vector3): boolean
	return flat(Cat.chest(self), p) <= Cat.REACH and p.Y - self.surface <= Cat.REACH_UP and p.Y >= self.surface - 3
end

local function emit(self: any, kind: string, at: Vector3?, away: Vector3?)
	table.insert(self.signals, { kind = kind, at = at, away = away })
end

-- A draw for this notice (its watch's length), from the seed and how many it has made: the same for the same notice after a return to a rest.
local function draw(self: any, salt: number): number
	return rng(self.seed, 5000 + self.notices * 13 + salt)()
end

-- One step of `dt` seconds at the life clock's (day, hour), with the spider as it is now (`spider`: its body's position, its speed, whether it is hidden: in a
-- home, under the sofa). Puts the cat where its schedule (and any reaction) has it, and reacts. Signals: "noticed", "pat" (a pat that missed), "struck" (a pat
-- that landed in the standard rules), "nudged" (in the gentle rules: knocked aside, `away` the push's direction), "gave_up".
function Cat.step(self: any, dt: number, day: number, hour: number, spider: Spider?)
	self.day, self.hour = day, hour
	-- the schedule's place at its own time (behind by its lag while it caught up after a reaction)
	if self.react == "none" and self.lag > 0 then self.lag = math.max(0, self.lag - dt * Cat.CATCH_UP * HOUR_PER_S) end
	if self.react ~= "none" then self.lag += dt * HOUR_PER_S end
	local h = hour - self.lag + self.advance
	local dd = day
	while h < 0 do h += 24; dd -= 1 end
	while h >= 24 do h -= 24; dd += 1 end
	local place = Cat.at(self.seed, math.max(dd, 1), h)
	-- Movement can disturb a nap. Skip the remaining rest, not the trip off the
	-- furniture: the next authored walk begins at precisely the same perch.
	local resting = place.pose == "sleep" or place.pose == "rest"
	local disturbing = self.enabled and spider ~= nil and not spider.hidden
		and spider.speed >= Cat.WAKE_SPEED and sameRoom(place.pos, spider.pos)
		and flat(place.pos, spider.pos) <= Cat.NOTICE and math.abs(spider.pos.Y - place.surface) <= Cat.NOTICE_UP
	self.wakeS = if resting and disturbing then self.wakeS + dt else math.max(0, self.wakeS - dt * 2)
	if self.react == "none" and resting and self.cooldown <= 0 and self.wakeS >= Cat.WAKE_S then
		local departure: Segment? = nil
		local departureDay = math.max(dd, 1)
		for _, seg in Cat.plan(self.seed, departureDay) do
			if seg.kind == "walk" and seg.from == place.spot and seg.t0 >= h then departure = seg; break end
		end
		-- The final rest is on the sofa; its next departure is tomorrow morning.
		if departure == nil and place.spot == "sofa" then
			departureDay += 1
			departure = Cat.plan(self.seed, departureDay)[2]
		end
		if departure ~= nil then
			self.advance += (departureDay - math.max(dd, 1)) * 24 + departure.t0 - h
			place = Cat.at(self.seed, departureDay, departure.t0)
			self.wakeS = 0
			emit(self, "woke", place.pos)
		end
	end
	-- the stalk's offset comes back to nothing when it is not stalking
	if self.react == "none" and self.offset.Magnitude > 0 then
		local back = math.min(self.offset.Magnitude, Cat.WALK_SPEED * dt)
		self.offset -= self.offset.Unit * back
	end
	self.pos = place.pos + self.offset
	self.surface = place.surface
	self.spot = place.spot
	if self.react == "none" then
		self.heading, self.pose, self.purring = place.heading, (if self.offset.Magnitude > 0.5 then "walk" else place.pose), place.purring
		self.look = nil
	end
	self.cooldown = math.max(0, self.cooldown - dt)
	if not self.enabled or spider == nil then return end
	local awake = place.pose ~= "sleep" and place.pose ~= "jump"
	local moving = spider.speed >= Cat.MOVING
	if self.react == "none" then
		if awake and self.cooldown <= 0 and moving and not spider.hidden and spider.visible ~= false and sameRoom(Cat.head(self), spider.pos)
			and flat(Cat.head(self), spider.pos) <= Cat.NOTICE and spider.pos.Y - self.surface <= Cat.NOTICE_UP and spider.pos.Y >= self.surface - 5 then
			self.react, self.reactS, self.stillS, self.highS, self.misses = "watch", 0, 0, 0, 0
			self.watchS = Cat.WATCH[1] + (Cat.WATCH[2] - Cat.WATCH[1]) * draw(self, 1)
			self.notices += 1
			self.pose, self.purring = "watch", false
			emit(self, "noticed", spider.pos)
		end
		return
	end
	-- a reaction under way: it faces the thing and follows it with its head
	self.reactS += dt
	self.look = spider.pos
	local toward = v(spider.pos.X - self.pos.X, 0, spider.pos.Z - self.pos.Z)
	if toward.Magnitude > 1 and self.react ~= "swat" then
		local want = toward.Unit
		local turned = self.heading:Lerp(want, math.clamp(dt * 6, 0, 1))
		self.heading = if turned.Magnitude > 1e-3 then turned.Unit else want
	end
	local function giveUp()
		self.react, self.cooldown, self.look = "none", Cat.COOLDOWN, nil
		emit(self, "gave_up", spider.pos)
	end
	-- Losing sight behind a prop stops tracking immediately, including a pat.
	-- Hearing may wake the cat, but never supplies a target through a wall.
	if spider.hidden or spider.visible == false then giveUp(); return end
	self.stillS = if moving then 0 else self.stillS + dt
	local high = spider.pos.Y - self.surface > Cat.REACH_UP
	self.highS = if high then self.highS + dt else 0
	if self.react == "watch" or self.react == "stalk" then
		if self.stillS >= Cat.STILL_LOSE or self.highS >= Cat.HIGH_LOSE or not sameRoom(Cat.head(self), spider.pos) or flat(Cat.head(self), spider.pos) > Cat.NOTICE * 1.5 then
			giveUp()
			return
		end
		if Cat.inReach(self, spider.pos) and self.reactS >= self.watchS and self.stillS < 0.5 then -- (it pounces on what moves)
			self.react, self.reactS, self.pose = "crouch", 0, "crouch"
			return
		end
		-- not in reach: on the floor it creeps nearer (never off its own floor, never into the furniture, never far from its schedule's place)
		self.pose = "watch"
		if not high and self.surface <= FL + 2 and flat(Cat.chest(self), spider.pos) > Cat.REACH - 4 and self.reactS >= self.watchS * 0.5 then
			local step = toward.Unit * math.min(Cat.STALK_SPEED * dt, math.max(0, flat(Cat.chest(self), spider.pos) - (Cat.REACH - 6)))
			local next = self.offset + step
			local at = place.pos + next
			if next.Magnitude <= Cat.STALK_MAX and Cat.free(at.X, at.Z) then
				self.offset = next
				self.pos = at
				self.react, self.pose = "stalk", "stalk"
			end
		end
		return
	end
	if self.react == "crouch" then
		self.pose = "crouch"
		if self.reactS >= Cat.CROUCH_S then
			self.react, self.reactS, self.pose, self.swatHit = "swat", 0, "swat", false
			self.pawAt = spider.pos
		end
		return
	end
	if self.react == "swat" then
		self.pose = "swat"
		if not self.swatHit and self.reactS >= Cat.SWAT_S * 0.5 then
			self.swatHit = true
			if Cat.inReach(self, spider.pos) then
				self.swats += 1
				self.lastSwatDay = day
				local away = v(spider.pos.X - self.pos.X, 0, spider.pos.Z - self.pos.Z)
				away = if away.Magnitude > 1e-3 then away.Unit else self.heading
				if self.gentle then
					emit(self, "nudged", spider.pos, away)
					self.react, self.cooldown, self.look = "none", Cat.COOLDOWN, nil
				else
					emit(self, "struck", spider.pos, away)
					self.react, self.cooldown, self.look = "none", Cat.COOLDOWN, nil
				end
				return
			end
			self.pats += 1
			self.misses += 1
			emit(self, "pat", spider.pos)
		end
		if self.reactS >= Cat.SWAT_S then
			if self.misses >= Cat.MISSES then giveUp(); return end
			self.react, self.reactS, self.pose = "watch", 0, "watch"
			self.watchS = 0.6
		end
	end
end

-- Takes the signals since the last call.
function Cat.drainSignals(self: any): { Signal }
	local out = self.signals
	self.signals = {}
	return out
end

-- What a spider at `at` hears of it: the bell (0..1, while it walks, jumps, stalks or pats, by distance) and the purr (0..1, while it settles, close).
function Cat.sound(self: any, at: Vector3): (number, number)
	local d = (Cat.head(self) - at).Magnitude
	local moving = self.pose == "walk" or self.pose == "jump" or self.pose == "stalk" or self.pose == "swat" or self.pose == "crouch"
	local bell = if moving then math.clamp(1 - d / Cat.HEAR_BELL, 0, 1) else 0
	if self.pose == "stalk" or self.pose == "crouch" then bell *= 0.35 end -- (stalking, it moves so slowly the bell barely rings)
	local purr = if self.purring then math.clamp(1 - d / Cat.HEAR_PURR, 0, 1) else 0
	return bell, purr
end

-- Whether it is in the middle of something with the spider (a watch, a stalk, a crouch or a pat).
function Cat.reacting(self: any): boolean
	return self.react ~= "none"
end

-- ---------------------------------------------------------------- its record (Persistence/Checkpoint's optional `cat`)
export type Record = { notices: number, pats: number, swats: number, last_swat_day: number }
function Cat.defaultRecord(): Record
	return { notices = 0, pats = 0, swats = 0, last_swat_day = 0 }
end
function Cat.toRecord(self: any): Record
	return { notices = self.notices, pats = self.pats, swats = self.swats, last_swat_day = self.lastSwatDay }
end
local function count(x: any): boolean
	return type(x) == "number" and x == x and x >= 0 and x <= 1e6 and math.floor(x) == x
end
-- What is wrong with a record (none for a good one).
function Cat.problems(d: any): { string }
	local out: { string } = {}
	if type(d) ~= "table" then return { "cat: not a record" } end
	for _, k in { "notices", "pats", "swats", "last_swat_day" } do
		if not count(d[k]) then table.insert(out, `cat: {k} is not a count`) end
	end
	return out
end
-- Puts the record back (a good one; the caller checked it) and ends whatever it was doing: the next step puts it where its schedule says.
function Cat.load(self: any, d: Record)
	self.notices, self.pats, self.swats, self.lastSwatDay = d.notices, d.pats, d.swats, d.last_swat_day
	self.react, self.reactS, self.lag, self.offset, self.cooldown, self.look, self.misses = "none", 0, 0, Vector3.zero, 0, nil, 0
	self.wakeS, self.advance = 0, 0
	self.spiderPrevious = nil
	table.clear(self.signals)
end

return Cat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">CrabSpider</string>
            <string name="Source"><![CDATA[--!strict
-- The crab spiders of the meadow's edge (ROBLOX-119, docs/PARK_WORLD_DESIGN.md zone 3; the notebook's page "The crab spider on the flower" says what is known of them):
-- the goldenrod crab spider, Misumena vatia, sits still on a flower in the flower's colour with its first two pairs of legs held open, and grabs what comes in reach.
-- Here two of them live on the meadow's flowers (World/Meadow.CRAB_SITES): a yellow one on a goldenrod's plume and a white one on a yarrow's head, each on one of its two
-- flowers a day (a seeded draw per day: where it is at a day is a pure function of the seed and the day, so a return to a rest finds it where it was).
--
-- What it does to a jumping spider is what it does to anything that comes to its flower: one that walks or lands within its reach (REACH, from its body's middle) and
-- stays there LATENCY seconds is grabbed. In the standard rules that is a death with its own card (UI/CrabText); in the gentle rules (Easy, Free play) it lunges and the
-- spider drops clear (a "nudged" signal: Client/SpiderClient knocks it off the flower) and it waits COOLDOWN seconds. The honest tell, for a careful player, is how it is
-- drawn (Client/CrabBody): its front legs held wide, its colour a shade off the flower's, and a crab spider's shape. A spider in a retreat is never in reach. Its first
-- close look (within SEEN) opens its page ("seen"). Nothing of it is saved: its day is the seed's, and a grab under way is not kept, as a wasp's visit is not.
-- Simplifications, said here: it never leaves its flower in a day, and it does not hunt the flies of the meadow (it is drawn with a caught one some days).
local WorldMap = require(script.Parent.Parent.World.WorldMap)
local Meadow = require(script.Parent.Parent.World.Meadow)

local CrabSpider = {}
CrabSpider.__index = CrabSpider

CrabSpider.REACH = 2.2 -- studs from its body's middle to the jumping spider's: its open front legs (a female's are about as long as her body) and the spider's own body
CrabSpider.LATENCY = 0.3 -- seconds in reach before the legs close
CrabSpider.SEEN = 9 -- studs: the first close look opens its page
CrabSpider.COOLDOWN = 8 -- seconds after a lunge in the gentle rules before it can lunge again
CrabSpider.LIFT = 0.25 -- its body's middle over the flower's top (its legs on the florets)
CrabSpider.HOLDING = 0.3 -- the share of days it is drawn holding a caught fly
CrabSpider.CAUSE = "crab_spider"

export type Crab = { site: number, form: string, region: string, pos: Vector3, top: Vector3, heading: Vector3, touch: number, cooldown: number, strike: number, holding: boolean }
export type Signal = { kind: string, at: Vector3?, away: Vector3? }
export type Spider = { pos: Vector3, hidden: boolean }

local MOD = 2147483647
-- The day's draw for crab spider `k` (in [0, 1)): a Park-Miller step from the seed, the crab and the day.
local function draw(seed: number, k: number, day: number, salt: number): number
	local s = (seed + k * 7919 + day * 104729 + salt * 15485863) % MOD
	if s <= 0 then s += MOD - 1 end
	for _ = 1, 3 do s = (s * 48271) % MOD end
	return (s - 1) / (MOD - 1)
end

-- Which of its two flowers crab spider `k` sits on, on `day` (1 or 2), and whether it holds a caught fly.
function CrabSpider.siteOf(seed: number, k: number, day: number): (number, boolean)
	return 1 + math.floor(draw(seed, k, day, 1) * 2), draw(seed, k, day, 2) < CrabSpider.HOLDING
end

-- The top of a site's flower head (the active world's map: the preserve's; nil where there is none).
local tops: { [string]: Vector3 } = {}
function CrabSpider.topOf(site: Meadow.CrabSite): Vector3?
	local key = site.piece
	local known = tops[key]
	if known then return known end
	local region = WorldMap.region(site.region)
	if region == nil then return nil end
	for _, p in Meadow.pieces(region :: any) do
		if p.id == site.piece then
			local top = Vector3.new((p.lo.X + p.hi.X) / 2, p.hi.Y, (p.lo.Z + p.hi.Z) / 2)
			tops[key] = top
			return top
		end
	end
	return nil
end

function CrabSpider.new(seed: number): any
	return setmetatable({
		seed = seed, gentle = false, enabled = true, day = -1, crabs = {} :: { Crab }, signals = {} :: { Signal }, met = false,
		grabs = 0, lunges = 0, now = 0, -- (this session's: the self-test reads them)
	}, CrabSpider)
end

-- Puts each crab spider on its flower for `day`.
function CrabSpider.place(self: any, day: number)
	self.day = day
	table.clear(self.crabs)
	for k, sites in Meadow.CRAB_SITES do
		local i, holding = CrabSpider.siteOf(self.seed, k, day)
		local site = sites[i]
		local top = CrabSpider.topOf(site)
		if top ~= nil then
			local a = draw(self.seed, k, day, 3) * 2 * math.pi
			table.insert(self.crabs, {
				site = i, form = site.form, region = site.region, top = top, pos = top + Vector3.yAxis * CrabSpider.LIFT, heading = Vector3.new(math.cos(a), 0, math.sin(a)),
				touch = 0, cooldown = 0, strike = -1, holding = holding,
			})
		end
	end
end

local function signal(self: any, kind: string, at: Vector3?, away: Vector3?)
	table.insert(self.signals, { kind = kind, at = at, away = away })
end

-- One tick: `spider` nil while there is no life to touch (the end screen, a menu).
function CrabSpider.step(self: any, dt: number, day: number, _hour: number, spider: Spider?)
	self.now += dt
	if day ~= self.day then self:place(day) end
	for _, c in self.crabs do
		if c.strike >= 0 then c.strike += dt; if c.strike > 0.6 then c.strike = -1 end end
		if c.cooldown > 0 then c.cooldown = math.max(0, c.cooldown - dt) end
		if spider == nil or not self.enabled or spider.hidden then c.touch = 0; continue end
		local d = (spider.pos - c.pos).Magnitude
		if d <= CrabSpider.SEEN and not self.met then
			self.met = true
			signal(self, "seen", c.pos)
		end
		if d <= CrabSpider.REACH and c.cooldown <= 0 then
			c.touch += dt
			if c.touch >= CrabSpider.LATENCY then
				c.touch = 0
				c.strike = 0
				if self.gentle then
					local away = Vector3.new(spider.pos.X - c.pos.X, 0, spider.pos.Z - c.pos.Z)
					away = if away.Magnitude > 1e-3 then away.Unit else -c.heading
					c.cooldown = CrabSpider.COOLDOWN
					self.lunges += 1
					signal(self, "nudged", c.pos, away)
				else
					self.grabs += 1
					c.cooldown = CrabSpider.COOLDOWN
					signal(self, "struck", c.pos)
				end
			end
		else
			c.touch = 0
		end
	end
end

-- Takes the signals since the last call.
function CrabSpider.drainSignals(self: any): { Signal }
	local out = self.signals
	self.signals = {}
	return out
end

-- The nearest crab spider to a point, and how far (nil when none is placed).
function CrabSpider.nearest(self: any, at: Vector3): (Crab?, number)
	local best, bd = nil, math.huge
	for _, c in self.crabs do
		local d = (c.pos - at).Magnitude
		if d < bd then best, bd = c, d end
	end
	return best, bd
end

return CrabSpider
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">Frog</string>
            <string name="Source"><![CDATA[--!strict
-- The green frog of the pond's edge (ROBLOX-122, docs/PARK_WORLD_DESIGN.md zone 4: "a frog's tongue"; the notebook's page "The green frog" says what is known of it).
-- A green frog (Lithobates clamitans), at true size: 7.8 cm from snout to vent (the sources: 5 to 10 cm), a sit-and-wait hunter at the water's edge that takes
-- whatever moving thing of a mouthful comes within reach, a spider among it. A frog's eye reacts to small things that move; one that keeps still is not food to it
-- (the sources: a frog surrounded by still food can starve). Its tongue is out and back in under 0.07 s.
--
-- Its day: it sits on one of two seats (World/Pond.FROG_SITES: the flat stone at the water's edge, the big lily pad), one a day by a seeded draw (a pure function
-- of the seed and the day, so a return to a rest finds it where it was; nothing of it is saved), facing the open margin. It sits still. That is the tell: a still
-- green shape at the edge, its eyes up, where a frog would be.
-- What it does (`step`): a spider that MOVES (faster than MOVING) within NOTICE of its head catches its eye: it turns to face it, a pivot of TURN_S seconds (it shifts
-- on its seat: the only movement it makes), and if the spider is still moving and within REACH of its mouth when it faces it, the tongue strikes: in the standard
-- rules a death with its own card (UI/FrogText, `struck`), in the gentle rules (Easy, Free play) it misses (`missed`) and the client knocks the spider aside. A spider
-- that keeps still for STILL_LOSE seconds, or is out of NOTICE, or hidden (a home, a rest) is lost to it, and it settles for COOLDOWN seconds. Its first close look
-- (SEEN) opens its page (`seen`). Live state that is not saved: its turn, its strike.
local Pond = require(script.Parent.Parent.World.Pond)
local WorldMap = require(script.Parent.Parent.World.WorldMap)

local Frog = {}
Frog.__index = Frog

Frog.LENGTH = 7.8 -- studs, snout to vent
Frog.NOTICE = 30 -- studs from its head: a moving spider within this catches its eye
Frog.REACH = 11 -- studs from its mouth: a lunge and the tongue
Frog.MOVING = 0.5 -- studs a second: slower than this, a spider is keeping still
Frog.TURN_S = 0.6 -- the pivot to face what moved
Frog.FACE = 0.85 -- the cosine within which it faces it
Frog.STILL_LOSE = 2.0 -- seconds still and it loses the spider
Frog.COOLDOWN = 5.0
Frog.SEEN = 40 -- the first close look
Frog.STRIKE_S = 0.07 -- the tongue, out and back
Frog.EYE_Y = 2.2 -- its eyes over its seat
Frog.MOUTH = 4.4 -- its mouth ahead of its middle
Frog.CAUSE = "frog"

local MOD = 2147483647
local function draw(seed: number, day: number, salt: number): number
	local s = (seed + day * 104729 + salt * 15485863) % MOD
	if s <= 0 then s += MOD - 1 end
	for _ = 1, 3 do s = (s * 48271) % MOD end
	return (s - 1) / (MOD - 1)
end

-- Which seat it sits on (1 or 2) on `day`, and the slight turn it sits at (degrees off the seat's facing).
function Frog.seatOf(seed: number, day: number): (number, number)
	return 1 + math.floor(draw(seed, day, 1) * #Pond.FROG_SITES), (draw(seed, day, 2) - 0.5) * 50
end

local seats: { [number]: any } = {}
function Frog.seatAt(i: number): Vector3?
	if seats[i] ~= nil then return seats[i] end
	local site = Pond.FROG_SITES[i]
	local r = WorldMap.region(site.region)
	if r == nil then return nil end
	local at = Pond.frogSeat(site, { r :: any })
	if at ~= nil then seats[i] = at end
	return at
end

function Frog.new(seed: number): any
	return setmetatable({
		seed = seed, gentle = false, enabled = true, day = -1, seat = 0, pos = Vector3.zero, heading = Vector3.xAxis, rest = Vector3.xAxis, state = "sit",
		t = 0, still = 0, cooldown = 0, strike = -1, met = false, signals = {}, strikes = 0, misses = 0, notices = 0, now = 0,
	}, Frog)
end

-- Puts it on its seat for `day`.
function Frog.place(self: any, day: number)
	self.day = day
	local i, turn = Frog.seatOf(self.seed, day)
	local at = Frog.seatAt(i)
	self.seat = i
	if at == nil then self.pos = Vector3.zero; self.here = false; return end
	self.here = true
	self.pos = at
	local f = Pond.FROG_SITES[i].facing
	local a = math.rad(turn)
	self.rest = Vector3.new(f.X * math.cos(a) - f.Z * math.sin(a), 0, f.X * math.sin(a) + f.Z * math.cos(a)).Unit
	self.heading = self.rest
	self.state, self.t, self.still, self.cooldown, self.strike = "sit", 0, 0, 0, -1
end

local function signal(self: any, kind: string, at: Vector3?)
	table.insert(self.signals, { kind = kind, at = at })
end

function Frog.head(self: any): Vector3
	return self.pos + Vector3.new(0, Frog.EYE_Y, 0) + self.heading * (Frog.MOUTH * 0.6)
end
function Frog.mouth(self: any): Vector3
	return self.pos + Vector3.new(0, 0.9, 0) + self.heading * Frog.MOUTH
end

-- One tick. `spider`: { pos, speed, hidden } or nil (no life to touch).
function Frog.step(self: any, dt: number, day: number, spider: any)
	self.now += dt
	if day ~= self.day then self:place(day) end
	if self.strike >= 0 then self.strike += dt; if self.strike > 0.4 then self.strike = -1 end end
	if self.cooldown > 0 then self.cooldown = math.max(0, self.cooldown - dt) end
	if not self.here then return end
	if spider == nil or not self.enabled then self.state = "sit"; return end
	local head = self:head()
	local toSpider = spider.pos - head
	local d = toSpider.Magnitude
	if d <= Frog.SEEN and not self.met then
		self.met = true
		signal(self, "seen", self.pos)
	end
	local flat = Vector3.new(spider.pos.X - self.pos.X, 0, spider.pos.Z - self.pos.Z)
	local moving = spider.speed > Frog.MOVING
	if self.state == "sit" then
		if self.cooldown <= 0 and not spider.hidden and moving and d <= Frog.NOTICE and flat.Magnitude > 1e-3 then
			self.state, self.t, self.still = "turn", 0, 0
			self.from = self.heading
			self.notices += 1
			signal(self, "noticed", spider.pos)
		else
			-- (back to how it sat, slowly)
			self.heading = self.heading:Lerp(self.rest, math.min(1, dt * 0.5)).Unit
		end
		return
	end
	-- turning or facing it: lost when hidden, out of notice, or still long enough
	if spider.hidden or d > Frog.NOTICE then self.state = "sit"; self.cooldown = Frog.COOLDOWN; signal(self, "lost", spider.pos); return end
	if moving then self.still = 0 else self.still += dt end
	if self.still >= Frog.STILL_LOSE then self.state = "sit"; self.cooldown = Frog.COOLDOWN; signal(self, "lost", spider.pos); return end
	local want = flat.Unit
	if self.state == "turn" then
		self.t += dt
		local k = math.clamp(self.t / Frog.TURN_S, 0, 1)
		self.heading = (self.from :: Vector3):Lerp(want, k)
		if self.heading.Magnitude < 1e-3 then self.heading = want end
		self.heading = self.heading.Unit
		if k >= 1 then self.state = "watch" end
		return
	end
	-- watching: it follows it with small shifts; a moving spider within reach in front of it is struck
	self.heading = self.heading:Lerp(want, math.min(1, dt * 4)).Unit
	local mouthTo = (spider.pos - self:mouth()).Magnitude
	if moving and mouthTo <= Frog.REACH and self.heading:Dot(want) >= Frog.FACE then
		self.strike = 0
		self.state = "sit"
		self.cooldown = Frog.COOLDOWN
		if self.gentle then
			self.misses += 1
			signal(self, "missed", spider.pos)
		else
			self.strikes += 1
			signal(self, "struck", spider.pos)
		end
	end
end

function Frog.drainSignals(self: any): { any }
	local out = self.signals
	self.signals = {}
	return out
end

-- Where the tongue's tip is, while it strikes (nil otherwise): out to the struck place and back in STRIKE_S.
function Frog.tongue(self: any, target: Vector3?): Vector3?
	if self.strike < 0 or self.strike > Frog.STRIKE_S then return nil end
	local m = self:mouth()
	local t = self.strike / Frog.STRIKE_S
	local out = if t < 0.5 then t * 2 else (1 - t) * 2
	return m:Lerp(target or (m + self.heading * Frog.REACH), out)
end

return Frog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">Mate</string>
            <string name="Source"><![CDATA[--!strict
-- The mate (ROBLOX-79): a spider of the opposite sex that comes onto the sill when the played spider is full-grown and well fed, is courted by the
-- player, mates and walks off. It is not prey (the player's strike drives it off, it is never caught or eaten), it is not a rival (it never attacks),
-- and the wasp ignores it. It is the shape of the rival: a plain record in LifeLoop's checkpoint graph (life.mate), a step that decides what it is doing
-- from a snapshot of the player (no clock, no engine, no hidden tracking), arrival rules like the rival's (Data/MatingRules), and legs that are the
-- rival's own (Predator/MateDrive, which gives RivalDrive a record in the rival's vocabulary). It keeps out of the retreat for the same reason.
--
-- ROBLOX-89: the pair's pause is the mating scene (Life/MatingScene, drawn by the client). `scene` is true from the moment the meter fills until the scene is over:
-- the whole pause, and for a male mate the walk off the sill that is its last beat. Nothing else reads it but the checkpoint (no rest is kept inside the scene) and
-- the client (the camera, the locked controls, the captions: `Mate.sceneTime` is the scene's clock, which a wasp visit holds like every other timer of the mate).
--
-- States: away (not on the sill: not arrived yet, driven off, gone for the day or for good), wander (walking the sill, in no hurry), approach (it has
-- seen the spider and walks up to it), attend (it stands facing the spider, close), pair (the pause together once the courtship meter is full), leaving
-- (walking to the edge: driven off, the evening, or after mating). The courtship meter lives here (m.meter, 0 to 1) and is the player's to fill.
--
-- The snapshot `s` (the player's place and what it is doing, and the day) is built by the caller each tick; Life/Mating.tick does it for the game and
-- adds `mayArrive`, which says whether the cycle wants a mate on the sill now.
local Rules = require(script.Parent.Parent.Data.MatingRules)
local PreyMath = require(script.Parent.Parent.Prey.PreyMath)
local PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)
local WorldMap = require(script.Parent.Parent.World.WorldMap)
local Hut = require(script.Parent.Parent.World.Hut)

local Mate = {}

-- ROBLOX-117: where the mate arrives (and its region) and where it leaves by: the sill's east end in the test garden (Data/MatingRules; no region, as before), the hut
-- garden's path where it comes in from round the hut's east end in the preserve (World/Hut.CREATURES); and the regions it roams there (Hut.ROAM).
function Mate.arriveAt(): (Vector3, string?)
	if WorldMap.world() == "preserve" then return Hut.CREATURES.mate.at, Hut.CREATURES.mate.region end
	return Rules.arriveAt, nil
end
function Mate.exitAt(): Vector3
	if WorldMap.world() == "preserve" then return Hut.CREATURES.mate.exit end
	return Rules.exitAt
end
function Mate.roam(): { [string]: boolean }?
	if WorldMap.world() == "preserve" then return Hut.ROAM end
	return nil
end
-- A record of another world's mate (a rest put back in the other world): it is not here.
function Mate.misplaced(m: any): boolean
	local _, region = Mate.arriveAt()
	if region == nil then return m.region ~= nil end
	return type(m.region) ~= "string" or WorldMap.region(m.region) == nil
end

local STATES: { [string]: boolean } = { away = true, wander = true, approach = true, attend = true, pair = true, leaving = true }
local REASONS: { [string]: boolean } = { [""] = true, driven = true, dusk = true, rest = true, mated = true, sex = true, rejected = true, cut = true }
-- ROBLOX-106: the courtship's record while it goes on, in the standard rules (Mate.track): seconds of the court, seconds courting well, the distance summed over those,
-- seconds near it but not facing it, the breaks, and whether it was courting well last tick. All optional (a record from before has none).
local COURT = { "court_t", "court_ok", "court_near", "court_away", "court_breaks" }
Mate.STATES = STATES

local function finite(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local function vec3(v: any): boolean
	return (typeof(v) == "Vector3" or type(v) == "table") and finite(v.X) and finite(v.Y) and finite(v.Z) and v.Magnitude <= 1000
end

function Mate.new(): any
	local at, region = Mate.arriveAt()
	local m = {
		state = "away", position = at, previous = at, up = Vector3.yAxis, heading = -Vector3.xAxis,
		leg = 0, elapsed = 0, meter = 0, lost = 0, sex = "male", scale = 1, reason = "", scene = false,
	}
	if region ~= nil then (m :: any).region = region end
	return m
end

-- How long the pair are together before the mate leaves: a male mate for the first three beats of the scene, a female mate through all four.
function Mate.pairLength(m: any): number
	return if m.sex == "female" then Rules.stayPairSeconds else Rules.pairSeconds
end

-- The scene's clock in seconds (0 to Rules.sceneSeconds) while the mating scene plays, or nil when it does not.
function Mate.sceneTime(m: any): number?
	if m == nil or m.scene ~= true then return nil end
	if m.state == "pair" then return m.elapsed end
	if m.state == "leaving" then return Mate.pairLength(m) + m.elapsed end
	return nil
end

function Mate.opposite(sex: string): string
	return if sex == "male" then "female" else "male"
end

-- The size of this mate relative to the played spider's look: a male slimmer and smaller, a female larger, each varying a little by a seeded draw from its
-- number (the same world, the same mate: the same size, on any return to a rest).
function Mate.scaleFor(seed: number, n: number, sex: string): number
	local g = PreyRandom.new((seed * 73856093 + n * 19349663 + 5821) % 2147483647)
	g:next()
	local u = g:next()
	return (Rules.scale[sex] or 1) * (1 + (u - 0.5) * 2 * Rules.scaleSpread)
end

-- On the sill (anything but away).
function Mate.present(m: any): boolean
	return m ~= nil and m.state ~= "away"
end

-- Walking, at the rival's pace; or standing (the courtship states, a wasp visit).
function Mate.walking(m: any): boolean
	return m.state == "wander" or m.state == "approach" or m.state == "leaving"
end

-- Can the player court it now? It is on the sill and not on its way out or together already.
function Mate.courtable(m: any): boolean
	return m ~= nil and (m.state == "wander" or m.state == "approach" or m.state == "attend")
end

-- The mating scene is playing, or the pair are together (ROBLOX-91: the rival is paused for it, and so is the arrival of a new one).
function Mate.sceneActive(m: any): boolean
	return m ~= nil and (m.scene == true or m.state == "pair")
end

-- Is the player courting it now (ROBLOX-91)? It can be courted and the courtship meter is rising or falling (it is not empty), or the spider is within courting range of it
-- (Rules.nearWu). The rival keeps away from a courting pair: Predator/RivalSpider pauses it, like the wasp's visit, so a lunge cannot land on a spider standing still for the meter.
function Mate.courting(m: any, position: Vector3): boolean
	if m == nil or not Mate.courtable(m) then return false end
	return m.meter > 0 or (m.position - position).Magnitude <= Rules.nearWu
end

local function clearCourt(m: any)
	for _, k in COURT do m[k] = nil end
	m.court_on = nil
end

local function leave(m: any, reason: string)
	m.state, m.elapsed, m.meter, m.reason, m.lost, m.scene = "leaving", 0, 0, reason, 0, false
	clearCourt(m)
	m.cut = nil
end

-- ROBLOX-106: the mate refuses the spider (`reason` "rejected") or flees a rival cutting in ("cut"): out of the pair, off the sill for the day, as a driven-off mate.
function Mate.refuse(m: any, reason: string)
	leave(m, reason)
end

-- ROBLOX-106: one tick of the courtship's record (the standard rules; Mate.step calls it when the snapshot says `nature`). `ok`: courting well this tick (close, in sight,
-- facing, still); `facing`; `dist` to the spider. The record starts with the court and is cleared when the meter is empty and the spider is not courting.
function Mate.track(m: any, ok: boolean, facing: boolean, dist: number, dt: number)
	if not ok and m.meter <= 0 then
		if m.court_t ~= nil then clearCourt(m) end
		return
	end
	if m.court_t == nil then
		for _, k in COURT do m[k] = 0 end
		m.court_on = false
	end
	m.court_t += dt
	if ok then
		m.court_ok += dt
		m.court_near += dist * dt
	else
		if m.court_on == true then m.court_breaks += 1 end
		if dist <= Rules.nearWu and not facing then m.court_away += dt end
	end
	m.court_on = ok
end

-- ROBLOX-106: the courtship's quality, 0 to 1 (MatingRules.game), from its record: breaks, distance, facing and length. 1 for a mate with no record.
function Mate.quality(m: any): number
	local g = Rules.game
	if m.court_t == nil or m.court_t <= 0 then return 1.0 end
	local still = 1 / (1 + g.breakCost * (m.court_breaks or 0))
	local mean = if (m.court_ok or 0) > 1e-6 then m.court_near / m.court_ok else Rules.attendWu
	local near = 1 - g.farCost * math.clamp((mean - Rules.attendWu) / (Rules.nearWu - Rules.attendWu), 0, 1)
	local face = 1 - g.awayCost * math.clamp((m.court_away or 0) / m.court_t, 0, 1)
	local long = math.clamp(Rules.courtSeconds * 1.5 / m.court_t, g.longFloor, 1)
	return still * near * face * long
end

local function gone(m: any)
	m.state, m.elapsed, m.meter, m.lost, m.scene = "away", 0, 0, 0, false
	clearCourt(m)
	m.cut = nil
end

-- The pause is over (its time, or a rest during it): it leaves, mated. A male mate's walk off the sill is still the scene's last beat.
local function parted(m: any)
	leave(m, "mated")
	m.scene = m.sex ~= "female" and Rules.sceneSeconds > Rules.pairSeconds
end

-- The player skips the scene (a jump or cancel after Rules.skipAfter seconds of it; `force` for a wasp visit, which cannot wait): the pair part at once and the mate
-- walks off. Returns "mated" for a pause cut short, and "" when there is nothing to part (a male mate already walking just ends the scene's last beat).
function Mate.skip(m: any, force: boolean?): string
	if m == nil or m.scene ~= true then return "" end
	if m.state == "pair" then
		if force ~= true and m.elapsed < Rules.skipAfter - 1e-9 then return "" end
		leave(m, "mated")
		return "mated"
	end
	if m.state == "leaving" and (force == true or Mate.sceneTime(m) :: number >= Rules.skipAfter - 1e-9) then m.scene = false end
	return ""
end

-- Whether the player is facing it: the mate within Rules.faceDeg of where the player looks, in the plane the player stands on.
function Mate.facing(m: any, s: any): boolean
	local delta = m.position - s.position
	local up = s.up or Vector3.yAxis
	local flat = delta - up * delta:Dot(up)
	if flat.Magnitude < 0.05 then return true end
	return s.heading:Dot(flat.Unit) >= math.cos(math.rad(Rules.faceDeg))
end

-- The conditions of courting this tick: close, in sight, facing it, standing still; `dance` is whether the display the peacock spider owes is being given
-- (always true for a spider that owes none).
function Mate.conditions(m: any, s: any, sees: boolean): (boolean, boolean)
	local dist = (m.position - s.position).Magnitude
	local still = s.grounded ~= false and not s.moving and not s.airborne and not s.onLine
	local ok = dist <= Rules.nearWu and sees and Mate.facing(m, s) and still
	local dance = (not s.needsDance) or s.dancing == true
	return ok, dance
end

-- One fixed tick. Returns the event of this tick: "" (nothing), "arrived", "noticed" (it has seen the spider), "driven" (struck at or jumped at: it
-- leaves for the day), "courted" (the meter is full: they are together), "mated" (the pause is over: it leaves) or "gone" (it is off the sill; m.reason
-- says why: driven, dusk, rest, mated or sex). The mate does not move itself: the drive does (MateDrive); a mate with no drive stands where it is put.
function Mate.step(m: any, dt: number, s: any): string
	if dt <= 0 or dt ~= dt then return "" end
	dt = math.min(dt, 0.05)
	m.previous = m.position
	-- (ROBLOX-117) another world's mate is not here: away, and it comes again where this world's does
	if m.state ~= "away" and m.scene ~= true and Mate.misplaced(m) then gone(m) end
	local st = m.state
	if st == "away" then
		if not s.mayArrive or s.day < Rules.firstDay or s.hour < Rules.arriveHour or s.hour >= Rules.arriveUntil then return "" end
		if s.resting or s.wasp then return "" end
		local at, region = Mate.arriveAt()
		if (s.position - at).Magnitude < Rules.arriveDistance then return "" end
		m.state, m.elapsed, m.meter, m.lost, m.reason = "wander", 0, 0, 0, ""
		m.position, m.previous, m.up, m.heading, m.leg = at, at, Vector3.yAxis, -Vector3.xAxis, (s.day or 0) * 7
		if region ~= nil then m.region = region elseif m.region ~= nil then m.region = nil end
		return "arrived"
	end
	-- The player rests: it is gone without being seen to go. (A pair that is together finishes first: the mating is not cut short.)
	if s.resting then
		if st == "pair" then
			parted(m)
			return "mated"
		end
		gone(m)
		m.reason = if st == "leaving" and m.reason == "mated" then "mated" else "rest"
		return "gone"
	end
	-- A wasp visit holds everything still (like the rival): no time passes for it and the meter is not touched.
	if s.wasp then return "" end
	m.elapsed += dt
	local delta = s.position - m.position
	local dist = delta.Magnitude
	if st == "leaving" then
		if m.scene == true and Mate.pairLength(m) + m.elapsed >= Rules.sceneSeconds then m.scene = false end -- (the scene's last beat is over)
		local out = (m.position - Mate.exitAt())
		if m.elapsed >= Rules.leaveSeconds or Vector3.new(out.X, 0, out.Z).Magnitude <= Rules.exitRadius then
			gone(m)
			return "gone"
		end
		return ""
	end
	if st == "pair" then
		if m.elapsed >= Mate.pairLength(m) then
			parted(m)
			return "mated"
		end
		return ""
	end
	-- The player became the same sex as the mate (the spider was changed in the Settings): it has no business here.
	if s.sex ~= nil and s.sex == m.sex then
		leave(m, "sex")
		return ""
	end
	-- The evening, or the hours before the morning (only a restored record can have it here at night).
	if s.hour >= Rules.leaveHour or s.hour < Rules.arriveHour then
		leave(m, "dusk")
		return ""
	end
	-- A jump at it, or a strike at it: driven off for the day. It is never caught.
	local struck = false
	if s.striking and not s.holding and s.previous ~= nil then
		local _, d = PreyMath.sweepClosest(s.previous, s.position, m.previous, m.position)
		struck = d < Rules.strikeWu
	end
	if struck or (s.airborne and dist < Rules.jumpAtWu) then
		leave(m, "driven")
		return "driven"
	end
	-- What it sees: the drive's decision (ten times a second, at any height) or, with no drive, distance and the sight query.
	local D = s.drive
	local sees: boolean
	if D then sees = D.sees == true else sees = dist < 8 and not (s.blocked ~= nil and s.blocked(m.position, s.position)) end
	if s.safe then sees = false end -- the retreat is private: it neither notices nor courts a spider in the crack
	local event = ""
	if st == "wander" then
		if sees then
			m.state, m.lost = "approach", 0
			event = "noticed"
		end
	else
		if sees then m.lost = 0 else m.lost += dt end
		if m.lost >= Rules.loseSeconds or dist > Rules.loseWu * 3 then
			m.state, m.lost = "wander", 0
		elseif st == "approach" and dist <= Rules.attendWu then
			m.state = "attend"
		elseif st == "attend" and dist > Rules.loseWu then
			m.state = "approach"
		end
	end
	-- The meter.
	local ok, dance = Mate.conditions(m, s, sees)
	if s.nature == true then Mate.track(m, ok, Mate.facing(m, s), dist, dt) end -- (ROBLOX-106)
	if ok and dance then
		m.meter = math.min(1, m.meter + dt / Rules.courtSeconds)
	elseif not ok then
		m.meter = math.max(0, m.meter - dt * Rules.decayPerSecond)
	end
	if m.meter >= 1 - 1e-9 then
		m.meter, m.state, m.elapsed, m.scene = 1, "pair", 0, true
		return "courted"
	end
	return event
end

-- What the spider's senses make of it: a moving thing on the sill, like the rival and unlike prey (never a target).
function Mate.percept(m: any): any
	if m == nil or m.state == "away" then return nil end
	return { id = "mate_spider", position = m.position, radius = 0.4, velocity = (m.position - m.previous) * 60, maxCategory = "movement" }
end

-- Whether a record is good (nil is: a life that has had no mate). It is on the sill, never in the crack, when it is on the sill. ROBLOX-94: `region` is the region it
-- belongs to (the sill's unless given): where it may stand is that region's bounds, outside that region's retreats.
function Mate.valid(m: any, region: string?): boolean
	if m == nil then return true end
	if type(m) ~= "table" or not STATES[m.state] then return false end
	for _, k in { "elapsed", "lost" } do
		local n = m[k]
		if n ~= nil and (not finite(n) or n < 0) then return false end
	end
	if m.meter ~= nil and (not finite(m.meter) or m.meter < 0 or m.meter > 1) then return false end
	if m.leg ~= nil and (not finite(m.leg) or m.leg < 0 or m.leg > 1e9 or m.leg % 1 ~= 0) then return false end
	if m.sex ~= nil and m.sex ~= "male" and m.sex ~= "female" then return false end
	if m.scale ~= nil and (not finite(m.scale) or m.scale < 0.5 or m.scale > 2) then return false end
	if m.reason ~= nil and (type(m.reason) ~= "string" or not REASONS[m.reason]) then return false end
	if m.scene ~= nil and type(m.scene) ~= "boolean" then return false end
	-- (ROBLOX-106: the courtship's record and the rival's level, optional)
	for _, k in COURT do
		local n = m[k]
		if n ~= nil and (not finite(n) or n < 0 or n > 1e6) then return false end
	end
	if m.court_breaks ~= nil and m.court_breaks % 1 ~= 0 then return false end
	if m.court_on ~= nil and type(m.court_on) ~= "boolean" then return false end
	if m.cut ~= nil and (not finite(m.cut) or m.cut < 0 or m.cut > 1) then return false end
	local atRest = m.state == "away" -- (the scene is the pause, or the walk off after it: never away)
	if m.scene == true and (atRest or not (m.state == "pair" or (m.state == "leaving" and m.reason == "mated"))) then return false end -- (the scene is the pause, or the walk off after it)
	for _, k in { "position", "previous", "heading", "up" } do
		if m[k] ~= nil and not vec3(m[k]) then return false end
	end
	if m.up ~= nil and math.abs(m.up.Magnitude - 1) > 0.05 then return false end
	-- (ROBLOX-117: `region`, optional, names a region; one this world has not is another world's mate, Mate.misplaced, and its place is not looked at here)
	if m.region ~= nil and (type(m.region) ~= "string" or #m.region < 1 or #m.region > 64) then return false end
	if not atRest then
		local p, id = m.position, region or m.region or WorldMap.HOME
		if p == nil or (WorldMap.region(id) ~= nil and (not WorldMap.inBounds(p, id) or WorldMap.inRetreat(Vector3.new(p.X, p.Y, p.Z), id) ~= nil)) then return false end
	end
	return true
end

return Mate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">MateDrive</string>
            <string name="Source"><![CDATA[--!strict
-- The mate's legs (ROBLOX-79): the rival's own drive (Predator/RivalDrive: a SpiderMotor over the whole sill, the route graph, the keep-out around the
-- retreat) given a record in the rival's vocabulary. RivalDrive and RivalRoute are used as they are and are not changed; this module only translates:
--   the mate wanders       -> the rival patrols (about 100 places over every face, in a fixed order by the leg number)
--   the mate approaches    -> the rival stalks (toward where it sees the spider; it is Mate.step that stops it at attendWu)
--   the mate attends, pairs-> the rival winds up (it stands, facing the spider)
--   the mate leaves        -> a patrol whose one place is the exit (Data/MatingRules.exitAt)
--   a wasp visit, or away  -> recover (it stands) / dormant (it is not on the sill)
-- Nothing is kept here that cannot be made again from life.mate: the motor stands where the record says (the drive puts it there when the two differ,
-- which is also how a returned rest works). `sees` is the drive's last decision about the spider, which Mate.step reads as s.drive.sees.
-- ROBLOX-117: in the preserve the mate roams the hut garden's regions as the rival does (`roam`, RivalDrive): its record's `region` goes to and from the proxy, and
-- the exit it leaves by is the waypoint of the region it is in nearest the world's exit (Predator/Mate.exitAt).
local RivalDrive = require(script.Parent.RivalDrive)
local Mate = require(script.Parent.Mate)

local MateDrive = {}
MateDrive.__index = MateDrive

local MAP: { [string]: string } = {
	away = "dormant", wander = "patrol", approach = "stalk", attend = "windup", pair = "windup", leaving = "patrol",
}

-- `motor`: a SpiderMotor made for the mate; `blocked(a, b)`: something opaque between the points (the sight query). ROBLOX-94: `region` (the sill's unless given) is the
-- region it walks in (RivalDrive.new).
-- The waypoint of the drive's region nearest the exit, on a floor.
local function exitOf(drive: any): any
	local exit: any = nil
	local best = math.huge
	local at = Mate.exitAt()
	for _, w in drive.waypoints do
		local d = (w.pos - at).Magnitude
		if w.up.Y > 0.5 and d < best then exit, best = w, d end
	end
	return exit
end

function MateDrive.new(motor: any, blocked: (Vector3, Vector3) -> any, region: string?, roam: { [string]: boolean }?): any
	local drive = RivalDrive.new(motor, blocked, region, roam)
	return setmetatable({
		drive = drive, exit = exitOf(drive), exitRegion = drive.region, leaving = false, sees = false, player = {},
		proxy = { state = "dormant", position = motor.pos, previous = motor.pos, up = motor.up, heading = motor.heading, origin = motor.pos, leg = 0, elapsed = 0, notice = 0 },
	}, MateDrive)
end

function MateDrive.destroy(self: any)
	self.drive:destroy()
end

-- One fixed tick, after Mate.step. `s` is the same snapshot Mate.step was given (it has the player's `up` and `grounded` as RivalDrive needs).
function MateDrive.update(self: any, mate: any, dt: number, s: any)
	local proxy = self.proxy
	local state = mate.state
	local mapped = MAP[state] or "dormant"
	if s.wasp and state ~= "away" then mapped = "recover" end
	proxy.state = mapped
	proxy.position, proxy.up, proxy.heading, proxy.leg = mate.position, mate.up or Vector3.yAxis, mate.heading, mate.leg or 0
	proxy.region = mate.region
	if self.exitRegion ~= (mate.region or self.drive.region) then
		-- (ROBLOX-117: the region changed under it: the exit is this region's)
		if mate.region ~= nil then self.drive:useRegion(mate.region) end
		self.exit, self.exitRegion, self.leaving = exitOf(self.drive), self.drive.region, false
	end
	-- Leaving: the one place it goes to is the exit; entering the state sets it once.
	if state == "leaving" then
		if not self.leaving and self.exit ~= nil and mapped == "patrol" then
			self.drive:_setGoal(self.exit, "patrol")
			self.leaving = true
		end
	else
		self.leaving = false
	end
	-- Courtship/scene flags keep the rival away from this pair. They must not
	-- blind the mate to its own partner. Preserve retreat, rest, wasp and sight
	-- restrictions in a reused private snapshot; never mutate the caller's table.
	local player = self.player
	table.clear(player)
	for k,v in s do player[k]=v end
	player.courting, player.scene = nil, nil
	self.drive:update(proxy, dt, player)
	mate.position, mate.up, mate.heading, mate.leg = proxy.position, proxy.up, proxy.heading, proxy.leg
	if proxy.region ~= nil then mate.region = proxy.region end
	if self.drive.region ~= self.exitRegion then self.exit, self.exitRegion = exitOf(self.drive), self.drive.region end
	self.sees = self.drive.sees == true and state ~= "away"
end

return MateDrive
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">RivalDisplay</string>
            <string name="Source"><![CDATA[--!strict
-- The male rival's contest display (ROBLOX-127): how a male jumping spider meets another spider, drawn on top of the rival's rules. Pure, Vector3-free and
-- display only: nothing here moves the rival, its collider, its senses, its timing or any outcome (Predator/RivalSpider and RivalDrive decide all of that as
-- before); SpiderRig reads the pose (look.contest) and the client hands it the rival's state each frame.
--
-- What the sources describe (DOC): male contests open at a distance with the males facing each other, the body raised and legs I held up and forward (Phidippus
-- clarus, Elias et al. 2008, PMC2598435: a hunched posture, the front legs curled in front, then approaches or retreats with legs I stretched out); in Cosmophasis
-- umbratica (Lim & Li 2004) the males close by short skittering with legs I raised in two positions and the chelicerae held open, the basal segments 30 to 90 degrees
-- apart, lunge, and grapple (hooking and pushing down each other's legs, locked chelicerae) only in the contests that go that far; the one pushed back, and in a
-- mismatched pair the smaller, decamps (both papers; in P. clarus the bigger male mostly won because its rival retreated). Phidippus males also zigzag in display
-- (Edwards 1981, Psyche 88:199, of courting P. mystaceus). The game's ritual, mapped onto the rival's states (ART: which state shows which act, every number):
--   "faceoff"  stalking within FACE_WU of the spider: body raised, legs I up and forward, palps up, the chelicerae a little open, and stop-and-go sideways skitters
--              (the zigzag: the drawn body steps a little to one side or the other in seeded bursts and pauses; the simulation's path is the drive's, untouched)
--   "spread"   stalking within SPREAD_WU, and the windup: legs I high and spread wide, the chelicerae open, a tremor in the raised legs, the skitters
--   "grapple"  the lunge (the escalation, when neither has backed down): legs I forward and down to hook, the chelicerae wide
--   "retreat"  recovering after the spider got clear of its lunge, sprang clear of the spider's strike, bit back, or tore free: legs I lowered, the body low and turned a
--              little away, when it is the smaller of the two; the bigger holds its ground, legs I half up (`hold`)
--   "none"     anything else (patrol, far off, held, carried, gone): the pose eases out and the motor's legs are the rig's again
-- The skitters' rhythm and the side the retreat turns to are drawn from the rival's own seeded stream (the world's seed, the day, its contests and its patrol
-- leg, all kept in its record, and the display's own count of bouts): the same rival in the same moment shows the same display, and a return to a rest rerolls nothing
-- of the simulation (the display keeps no record; it starts again from rest).
local PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)

local RivalDisplay = {}

export type Pose = {
	phase: string, presence: number,
	rear: number, legs: number, palps: number, yaw: number, sweep: number, tremor: number, -- (the tarantula's pose's fields, as SpiderRig reads them)
	reach: number, hook: number, spread: number, lateral: number, lower: number,
}

RivalDisplay.FACE_WU = 6.0 -- studs: within this, a stalking rival faces off (its sight is 8)
RivalDisplay.SPREAD_WU = 4.4 -- within this, the full display (the windup begins at 3.2, RivalRules.reachWu)
RivalDisplay.RETREAT_SECONDS = 3.0 -- as long as the rival's recover lasts
RivalDisplay.RISE = 1 / 0.35 -- how fast a level goes up (per second) and comes down
RivalDisplay.FALL = 1 / 0.5
RivalDisplay.SKITTER = { step = { 0.18, 0.42 }, pause = { 0.25, 0.70 }, amplitude = 0.11, yawDeg = 12 } -- a burst's seconds, a pause's, how far the drawn body steps (studs at scale 1), the turn with it
RivalDisplay.REAR_DEG = 9 -- the prosoma raised in the face-off and the display
RivalDisplay.PALPS_DEG = 16
RivalDisplay.TURN_AWAY_DEG = 28 -- the retreat's turn
RivalDisplay.TREMOR_HZ = 7

-- The levels each phase asks for: legs I raised (legs), how high and spread (reach), hooked (hook), the chelicerae (spread), the body raised (rear, a share of REAR_DEG),
-- the palps (palps, a share of PALPS_DEG), the crouch (lower) and whether the skitters run (skitter).
RivalDisplay.TARGETS = {
	none = { legs = 0, reach = 0, hook = 0, spread = 0, rear = 0, palps = 0, lower = 0, skitter = 0 },
	faceoff = { legs = 0.85, reach = 0, hook = 0, spread = 0.35, rear = 0.8, palps = 0.6, lower = 0, skitter = 1 },
	spread = { legs = 1, reach = 1, hook = 0, spread = 1, rear = 1, palps = 1, lower = 0, skitter = 1 },
	grapple = { legs = 1, reach = 0, hook = 1, spread = 1, rear = 0.3, palps = 0.4, lower = 0, skitter = 0 },
	retreat = { legs = 0, reach = 0, hook = 0, spread = 0, rear = 0, palps = 0, lower = 1, skitter = 0 },
	hold = { legs = 0.55, reach = 0, hook = 0, spread = 0.3, rear = 0.5, palps = 0.4, lower = 0, skitter = 0 },
} :: { [string]: { [string]: number } }

-- The rival's events after which it backs off (RivalSpider.step's and RivalGrip.step's): its lunge missed, the spider sprang clear or bit back, or it tore free.
RivalDisplay.BACKS_OFF = { missed = true, sprang = true, counter = true, tore = true, touch = true } :: { [string]: boolean }

export type State = {
	phase: string, t: number, bout: number, rng: any?, key: string,
	skitterSide: number, skitterFrom: number, skitterTo: number, skitterT: number, skitterLeft: number, moving: boolean,
	retreatLeft: number, awaySide: number,
	levels: { [string]: number }, lateral: number, yaw: number, presence: number,
	pose: Pose,
}

function RivalDisplay.new(): State
	return {
		phase = "none", t = 0, bout = 0, rng = nil, key = "",
		skitterSide = 1, skitterFrom = 0, skitterTo = 0, skitterT = 0, skitterLeft = 0, moving = false,
		retreatLeft = 0, awaySide = 1,
		levels = { legs = 0, reach = 0, hook = 0, spread = 0, rear = 0, palps = 0, lower = 0, skitter = 0 },
		lateral = 0, yaw = 0, presence = 0,
		pose = { phase = "none", presence = 0, rear = 0, legs = 0, palps = 0, yaw = 0, sweep = 0, tremor = 0, reach = 0, hook = 0, spread = 0, lateral = 0, lower = 0 },
	}
end

-- The phase the rival's state asks for. `i`: state (the rival's), distance (studs, to the spider), event (this tick's, "" for none), smaller (the rival is the smaller
-- of the two, by drawn body length).
function RivalDisplay.phaseFor(d: State, i: any): string
	local s = i.state
	if s == "lunge" then return "grapple" end
	if d.retreatLeft > 0 and (s == "recover" or s == "patrol") then return if i.smaller then "retreat" else "hold" end
	if s == "windup" then return "spread" end
	if s == "stalk" and type(i.distance) == "number" then
		if i.distance <= RivalDisplay.SPREAD_WU then return "spread" end
		if i.distance <= RivalDisplay.FACE_WU then return "faceoff" end
	end
	return "none"
end

-- The seeded stream of one bout of display (a face-off that begins after none): the world's seed, the day, the rival's contests and patrol leg, the bout.
function RivalDisplay.stream(seed: number, day: number, contests: number, leg: number, bout: number): any
	return PreyRandom.mixed(seed, day, contests, leg, bout, 127)
end

local function smooth(x: number): number
	local c = math.clamp(x, 0, 1)
	return c * c * (3 - 2 * c)
end

-- One frame. `dt` is the frame's simulated time (0 when paused: nothing moves). `i` = { state, distance, event, smaller, seed, day, contests, leg, reduced }.
-- Returns the pose (the same table each time) for rig.threat.
function RivalDisplay.step(d: State, dt: number, i: any): Pose
	dt = math.max(0, dt)
	if RivalDisplay.BACKS_OFF[i.event or ""] then
		d.retreatLeft = RivalDisplay.RETREAT_SECONDS
		local g = RivalDisplay.stream(i.seed or 0, i.day or 0, i.contests or 0, i.leg or 0, d.bout + 1000)
		d.awaySide = if g:next() < 0.5 then -1 else 1
	end
	d.retreatLeft = math.max(0, d.retreatLeft - dt)
	local phase = RivalDisplay.phaseFor(d, i)
	if phase ~= d.phase then
		if (phase == "faceoff" or phase == "spread") and (d.phase == "none" or d.phase == "retreat" or d.phase == "hold") then
			-- a new bout of display: its own stream, from where the rival is in its record
			d.bout += 1
			d.rng = RivalDisplay.stream(i.seed or 0, i.day or 0, i.contests or 0, i.leg or 0, d.bout)
			d.skitterLeft, d.moving = 0, false
		end
		d.phase = phase
	end
	d.t += dt
	local target = RivalDisplay.TARGETS[phase]
	for k, v in target do
		local now = d.levels[k] or 0
		local rate = if v > now then RivalDisplay.RISE else RivalDisplay.FALL
		d.levels[k] = now + math.clamp(v - now, -rate * dt, rate * dt)
	end
	-- The skitters: a burst to a new side, then a pause; the drawn body steps there and back on the seeded rhythm.
	local sk = RivalDisplay.SKITTER
	if d.levels.skitter > 0 and d.rng ~= nil and not i.reduced then
		d.skitterLeft -= dt
		if d.skitterLeft <= 0 then
			local g = d.rng
			if d.moving then
				d.moving = false
				d.skitterFrom = d.skitterTo
				d.skitterLeft = sk.pause[1] + (sk.pause[2] - sk.pause[1]) * g:next()
			else
				d.moving = true
				d.skitterSide = -d.skitterSide
				d.skitterFrom = d.lateral / sk.amplitude
				d.skitterTo = d.skitterSide * (0.45 + 0.55 * g:next())
				d.skitterT = sk.step[1] + (sk.step[2] - sk.step[1]) * g:next()
				d.skitterLeft = d.skitterT
			end
		end
		local u = if d.moving and d.skitterT > 0 then smooth(1 - d.skitterLeft / d.skitterT) else 1
		local at = d.skitterFrom + (d.skitterTo - d.skitterFrom) * u
		d.lateral = at * sk.amplitude * d.levels.skitter
		d.yaw = (if d.moving then -d.skitterSide else 0) * math.rad(sk.yawDeg) * d.levels.skitter * math.sin(math.pi * u)
	else
		-- (no skitter: the step eases back to the middle; Reduced Motion has none at all)
		d.lateral = if i.reduced then 0 else d.lateral * math.max(0, 1 - 4 * dt)
		d.yaw = 0
	end
	local away = d.awaySide * math.rad(RivalDisplay.TURN_AWAY_DEG) * d.levels.lower
	local L = d.levels
	local presence = math.max(L.legs, L.reach, L.hook, L.spread, L.rear, L.palps, L.lower, math.abs(d.lateral) / RivalDisplay.SKITTER.amplitude)
	local p = d.pose
	p.phase = if presence > 0 then phase else "none"
	p.presence = presence
	p.legs, p.reach, p.hook, p.spread, p.lower = L.legs, L.reach, L.hook, L.spread, L.lower
	p.rear = math.rad(RivalDisplay.REAR_DEG) * L.rear
	p.palps = math.rad(RivalDisplay.PALPS_DEG) * L.palps
	p.yaw = d.yaw + away
	p.lateral = d.lateral
	p.sweep = 0
	p.tremor = if i.reduced then 0 else math.sin(math.pi * 2 * RivalDisplay.TREMOR_HZ * d.t) * L.reach
	return p
end

return RivalDisplay
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">RivalDrive</string>
            <string name="Source"><![CDATA[--!strict
-- The rival spider's legs (ROBLOX-69): its own SpiderMotor, the player's proven surface-walking motor with the same collider, drives it over
-- every face of the windowsill. This module is the brain between RivalSpider's state (patrol, stalk, windup, ...) and that motor: it picks the
-- places to patrol to, plans the seams to cross (RivalRoute), and hands the motor an ordinary TickInput each tick. Decisions (sight, faces,
-- routes) run every Rules.thinkSeconds, not every tick; the motor itself steps every tick while it walks and every tenth while it stands.
-- The rival's plain state (RivalSpider) stays the one thing a checkpoint holds: the drive keeps only what can be made again from it. It does
-- not know the engine: the motor and a sight query are handed in, so the CLI runs it on the box world and Studio on the real sill.
-- ROBLOX-117 (the preserve's hut garden): a drive told its `roam` (a set of region ids: World/Hut.ROAM) walks from region to region across their flat seams. It walks one
-- region's graph at a time (RivalRoute.graph of `region`); now and then a patrol leg is a crossing (a seeded draw for the leg, `Drive.crossLeg`) to a seam's point
-- on the way to a neighbour of the roam, and when it stands there the region becomes the neighbour's (`r.region`, kept in the record) and it walks on in a couple of
-- studs before it plans again; a stalk follows the spider across a seam the same way. A record's `region` that differs from the drive's (a rest put back, a new
-- rival) makes the drive the record's. Without `roam` nothing of this happens: the sill's rival and mate are as they were.
local Route = require(script.Parent.RivalRoute)
local Rules = require(script.Parent.Parent.Data.RivalRules)
local WorldMap = require(script.Parent.Parent.World.WorldMap)
local SupportMath = require(script.Parent.Parent.Movement.SupportMath)
local Motor = require(script.Parent.Parent.Movement.SpiderMotor)
local PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)
local Station = require(script.Parent.Parent.World.StationTerritory)

local Drive = {}
Drive.__index = Drive

local SEAT = Route.SEAT
local IDLE_EVERY = 10 -- a standing rival re-checks its support every tenth tick

local function gcd(a: number, b: number): number
	while b ~= 0 do a, b = b, a % b end
	return a
end

-- `motor`: a SpiderMotor made for the rival (its own world query and probe). `blocked(a, b)`: something opaque between the points. ROBLOX-94: `region` (the sill's unless
-- given) is the region it walks in, whose retreats it never enters.
local function graphAndPoints(id: string, incremental: boolean?): (any, { any })
	if incremental then
		Route.request(id)
		local g = Route.prepared(id)
		return g, if g ~= nil then Route.preparedWaypoints(g) else {}
	end
	local g = Route.graph(id)
	return g, g:waypoints()
end
function Drive.prepare(roam: { [string]: boolean }?, first: string)
	local ids = {}
	if roam ~= nil then for id in roam do table.insert(ids, id) end end
	table.sort(ids)
	for _, id in ids do Route.request(id, false) end
	Route.request(first)
end
-- Time limits the cost on slower devices; the secondary work quota also
-- prevents an unusually fast clock/read from making this an unbounded loop.
function Drive.advance(): (boolean, string?) return Route.advance(2048, .002) end
function Drive.new(motor: any, blocked: (Vector3, Vector3) -> any, region: string?, roam: { [string]: boolean }?, incremental: boolean?): any
	local id = region or WorldMap.HOME
	local g, waypoints = graphAndPoints(id, incremental)
	local stride = 7
	while gcd(stride, math.max(#waypoints, 1)) ~= 1 do stride += 1 end
	return setmetatable({
		motor = motor, blocked = blocked, region = id, g = g, waypoints = waypoints, stride = stride, roam = roam, crossing = nil :: any,
		incremental = incremental == true, preparingCross = false,
		ticks = 0, think = 0.0, face = nil :: number?, route = nil :: { any }?, hop = 1,
		goal = nil :: any, goalKey = "", prevState = "dormant",
		lastUp = Vector3.yAxis, sees = false, reach = false, remember = false, seen = nil :: Vector3?, seenUp = Vector3.yAxis, lost = 0.0,
		legT = 0.0, stuckT = 0.0, stuckAt = nil :: Vector3?, noFaceT = 0.0, safe = nil :: any,
		speed = 0.0, wish = Vector3.zero, stats = { thinks = 0, plans = 0, replans = 0, resets = 0, arrivals = 0 },
	}, Drive)
end

function Drive.destroy(self: any)
	self.motor:destroy()
end

-- (ROBLOX-117) The drive walks this region's graph from now on: its waypoints, its stride.
function Drive.useRegion(self: any, id: string)
	if id == self.region and self.g ~= nil then return end
	self.region = id
	self.g, self.waypoints = graphAndPoints(id, self.incremental)
	local stride = 7
	while gcd(stride, math.max(#self.waypoints, 1)) ~= 1 do stride += 1 end
	self.stride = stride
	self.campList = nil
	self.route, self.goal, self.face = nil, nil, nil
end

-- (ROBLOX-117) A crossing to a neighbour of the roam: the seam point of this region's graph nearest `toward` (or any) on a flat seam to a region of the roam (only
-- `only`, if given), as a goal { pos, up, face, cross = { to, aim } }; nil when there is none.
function Drive.crossTo(self: any, toward: Vector3?, only: string?): any
	self.preparingCross = false
	if self.roam == nil then return nil end
	local best, bestD = nil, math.huge
	for _, pair in self.g:allSeams() do
		local e = pair.edge
		if (e.flat or Station.contains(self.region)) and self.roam[e.region] and (only == nil or e.region == only) and #e.samples > 0 then
			local face = self.g.faces[pair.face]
			for _, sp in e.samples do
				local d = if toward ~= nil then (sp - toward).Magnitude else 0
				if face ~= nil and (face.normal.Y > 0.9 or Station.contains(self.region)) and not self.g:inKeepOut(sp + face.normal * SEAT) and d < bestD then
					local nextFace=Route.graph(e.region).faces[e.to]
					local across=if e.flat then e.ahead elseif e.convex then -face.normal else face.normal
					best, bestD = { pos = sp, up = face.normal, face = pair.face, cross = {
						to = e.region, aim = sp + across * 2.5 + nextFace.normal * SEAT,
						ahead=if e.flat then nil else e.ahead, up=face.normal,
					} }, d
				end
			end
			if toward == nil and best ~= nil then break end
		end
	end
	if best ~= nil and self.incremental and Route.prepared(best.cross.to) == nil then
		Route.request(best.cross.to)
		self.preparingCross = true
		return nil
	end
	return best
end

-- (ROBLOX-117) Whether patrol leg `leg` is a crossing to a neighbour (a stream of its own from the world's seed and the leg's number), and to which: the first of
-- the neighbours of the roam in a drawn order that has a flat seam.
Drive.CROSS_CHANCE = 0.4
function Drive.crossLeg(self: any, seed: number, leg: number): any
	self.preparingCross = false
	if self.roam == nil then return nil end
	local g = PreyRandom.mixed(seed, leg, 89)
	if g:next() >= Drive.CROSS_CHANCE then return nil end
	local reg = WorldMap.region(self.region)
	if reg == nil then return nil end
	local options: { string } = {}
	for _, n in reg.neighbors do if self.roam[n.id] and table.find(options, n.id) == nil then table.insert(options, n.id) end end
	if #options == 0 then return nil end
	local start = 1 + math.floor(g:next() * #options)
	for k = 0, #options - 1 do
		local w = self:crossTo(nil, options[((start - 1 + k) % #options) + 1])
		if w ~= nil then return w end
		if self.preparingCross then return nil end -- retain the same seeded choice until it is ready
	end
	return nil
end

local function surfacePointOf(center: Vector3, up: Vector3): Vector3
	return center - up * SEAT
end

local function goalFaceOf(self: any): number
	return if self.goal ~= nil then self.goal.face else -1
end

-- ROBLOX-106: the places to watch from (Rules.camp.spots on the floor round the crack's mouth), as goals on the sill's faces, outside the keep-out. Made once; none in a
-- region without a retreat.
function Drive.campPlaces(self: any): { any }
	if self.campList ~= nil then return self.campList end
	local list: { any } = {}
	local reg = WorldMap.region(self.region)
	if reg ~= nil and #reg.retreats > 0 and self.region == WorldMap.HOME then
		for _, p in Rules.camp.spots do
			local up = Vector3.yAxis
			local face = self.g:faceAt(p + up * SEAT, up)
			if face ~= nil and not self.g:inKeepOut(p + up * SEAT) and WorldMap.inRetreat(p + up * SEAT, self.region) == nil then
				table.insert(list, { pos = p, up = up, face = face })
			end
		end
	end
	self.campList = list
	return list
end

-- ROBLOX-106: whether patrol leg `leg` is a watch by the crack, and which place and for how long: a stream of its own from the world's seed and the leg's number.
function Drive.campLeg(self: any, seed: number, leg: number): (any, number)
	local places = self:campPlaces()
	if #places == 0 then return nil, 0 end
	local g = PreyRandom.mixed(seed, leg, 83)
	if g:next() >= Rules.camp.chance then return nil, 0 end
	local w = places[math.min(#places, 1 + math.floor(g:next() * #places))]
	local secs = Rules.camp.seconds
	return w, secs[1] + (secs[2] - secs[1]) * g:next()
end

-- The patrol place for this leg: deterministic from the leg number, spread over every face by a stride that visits all. ROBLOX-106: in the standard rules (`s.nature`, a
-- drive told it `camps`) a leg may be a watch by the crack instead (Drive.campLeg).
function Drive._pickWaypoint(self: any, r: any, s: any?): any
	local n = #self.waypoints
	if n == 0 then return nil end
	if self.camps == true and s ~= nil and s.nature == true then
		local w = self:campLeg(s.seed or 0, r.leg or 0)
		if w ~= nil then
			self.campHere = true
			return w
		end
	end
	self.campHere = false
	-- (ROBLOX-117: in a roam, a leg may be a crossing to a neighbour)
	if s ~= nil and self.roam ~= nil then
		local w = self:crossLeg(s.seed or 0, r.leg or 0)
		if w ~= nil then return w end
		if self.preparingCross then return nil end
	end
	for attempt = 0, 6 do
		local leg = (r.leg or 0) + attempt
		local w = self.waypoints[((leg * self.stride) % n) + 1]
		if (w.pos + w.up * SEAT - self.motor.pos).Magnitude > 3.0 then
			if attempt > 0 then r.leg = leg end
			return w
		end
	end
	return nil
end

function Drive._setGoal(self: any, goal: any, key: string)
	self.goal, self.goalKey = goal, key
	self.route = nil
	self.hop = 1
	self.legT = 0.0
	self.stuckT = 0.0
	self.stuckAt = self.motor.pos
end

-- Plans the seams from here to the goal; false when there is no way (the caller drops that goal).
function Drive._plan(self: any): boolean
	local goal, motor = self.goal, self.motor
	if goal == nil or self.face == nil then return false end
	self.stats.plans += 1
	local hops = self.g:plan(self.face, surfacePointOf(motor.pos, motor.up), goal.face, goal.pos)
	self.route, self.hop = hops, 1
	return hops ~= nil
end

-- The corners rounded: a `via` hop is done once the body is at it.
function Drive._rounded(self: any)
	local route = self.route :: { any }?
	if route == nil then return end
	while self.hop <= #route do
		local h = route[self.hop]
		if h.via and self.face == h.from and (h.aim - self.motor.pos).Magnitude < 0.4 then self.hop += 1 else break end
	end
end

-- The seams crossed: the face it stands on is the one a seam leads to (or a later one), or it has gone astray and the way is planned again.
-- Made at each think and at once when the support turns (a wall taken, an edge wrapped), so the next aim is always for the face it is on.
function Drive._hops(self: any)
	local route = self.route :: { any }?
	if route == nil or self.face == nil or self.goal == nil then return end
	self:_rounded()
	local here = route[self.hop]
	-- Still on the face the next hop leaves (a corner to round, or a seam to reach): nothing to change.
	if here ~= nil and self.face == here.from then return end
	for i = self.hop, #route do
		if not route[i].via and route[i].face == self.face then
			self.hop = i + 1
			self:_rounded()
			return
		end
	end
	local from = if self.hop <= #route then route[self.hop].from else goalFaceOf(self)
	if self.face ~= from then
		self.stats.replans += 1
		if self.log then self.log("replan", self.face, from, route, self.hop, self.goal) end
		self.route = nil
		if not self:_plan() then self.goal = nil end
	end
end

-- One decision: what it sees, where it is, where it is going. Cheap, and made ten times a second, not every tick.
function Drive._think(self: any, r: any, s: any)
	local motor = self.motor
	self.stats.thinks += 1
	local delta = s.position - r.position
	self.sees = not (s.safe or s.resting or s.scene or s.courting or s.wasp) and delta.Magnitude < Rules.sightWu and not self.blocked(r.position, s.position)
	if self.sees then
		self.seen, self.seenUp, self.lost = s.position, s.up or Vector3.yAxis, 0.0
	else
		self.lost += Rules.thinkSeconds
	end
	self.remember = not self.sees and self.seen ~= nil and self.lost < Rules.rememberSeconds
	self.face = if motor.mode == "attached" then self.g:faceAt(motor.pos, motor.up) else nil
	self.lastUp = motor.up
	local playerFace = if s.grounded ~= false and s.up ~= nil then self.g:faceAt(s.position, s.up) else nil
	self.reach = self.g:adjacent(self.face, playerFace)
	self.noFaceT = if self.face == nil and motor.mode == "attached" then self.noFaceT + Rules.thinkSeconds else 0.0

	local state = r.state
	if state ~= "patrol" and state ~= "stalk" then
		self.goal, self.route, self.crossing = nil, nil, nil
		return
	end
	-- (ROBLOX-117) walking in over a seam just crossed: no plan until it stands on the new region's ground, a couple of studs in
	if self.crossing ~= nil then
		self.crossing.t += Rules.thinkSeconds
		if (self.face ~= nil and (motor.pos - self.crossing.aim).Magnitude < 0.8) or self.crossing.t > 4 then self.crossing = nil else return end
	end
	if self.face == nil then return end
	-- The goal: where it last saw the spider (stalk) or the patrol place of this leg.
	if state == "stalk" then
		local at = if self.sees then s.position else self.seen
		local up = if self.sees then (s.up or Vector3.yAxis) else self.seenUp
		if at == nil then return end
		local face = self.g:faceAt(at, up)
		local key = "stalk"
		if face == nil and self.roam ~= nil then
			-- (ROBLOX-117) the spider is over a seam in a neighbour of the roam: the crossing toward it is the goal
			local there = WorldMap.at(at)
			if there ~= nil and self.roam[there.id] then
				local w = self:crossTo(at, there.id)
				if w ~= nil and (self.goal == nil or self.goal.cross == nil or self.goal.cross.to ~= there.id) then self:_setGoal(w, "stalk") end
			end
			if self.goal == nil or self.goal.cross == nil then return end
		elseif face == nil then return end
		if self.goal ~= nil and self.goal.cross ~= nil and face == nil then
			-- (keep the crossing)
		elseif self.goal == nil or self.goalKey ~= key or self.goal.face ~= face or (self.goal.pos - surfacePointOf(at, up)).Magnitude > 1.0 then
			self:_setGoal({ pos = surfacePointOf(at, up), up = up, face = face }, key)
		end
	else
		if self.goal == nil or self.goalKey ~= "patrol" then
			local w = self:_pickWaypoint(r, s)
			if w == nil then return end
			self:_setGoal(w, "patrol")
		end
	end
	if self.route == nil then
		if not self:_plan() then
			-- No way there: drop it (the next leg, or the next think of the stalk).
			if self.goalKey == "patrol" then r.leg = (r.leg or 0) + 1 end
			self.goal = nil
			return
		end
	end
	self:_hops()
	-- ROBLOX-106: standing its watch is not being stuck, and the leg's time does not run out under it.
	if r.camp ~= nil and self.campHere == true and self.goal ~= nil and (self.goal.pos + self.goal.up * SEAT - motor.pos).Magnitude < 0.6 then
		self.stuckT, self.stuckAt, self.legT = 0.0, motor.pos, 0.0
	end
	-- Progress: a leg that has taken too long, or no movement for a while, is dropped or planned again.
	self.legT += Rules.thinkSeconds
	self.stuckT += Rules.thinkSeconds
	if self.stuckT >= Rules.stuckSeconds then
		if self.stuckAt ~= nil and (motor.pos - self.stuckAt).Magnitude < 0.3 and self.goal ~= nil then
			self.stats.resets += 1
			self.route = nil
			if self.goalKey == "patrol" then r.leg = (r.leg or 0) + 1; self.goal = nil end
		end
		self.stuckT, self.stuckAt = 0.0, motor.pos
	end
	if self.goalKey == "patrol" and self.legT >= Rules.legSeconds and r.camp == nil then
		r.leg = (r.leg or 0) + 1
		self.goal = nil
	end
end

-- The motor's input for this tick: where to head. Nil wish: stand.
function Drive._wish(self: any, r: any, s: any): (Vector3, Vector3?)
	local motor = self.motor
	local state = r.state
	if state == "windup" then return Vector3.zero, s.position end
	-- (ROBLOX-117) walking in over the seam it has crossed
	if (state == "patrol" or state == "stalk") and self.crossing ~= nil then
		if self.crossing.ahead and motor.up:Dot(self.crossing.up)>.9 then return SupportMath.tangentDir(self.crossing.ahead,motor.up),nil end
		return SupportMath.tangentDir(self.crossing.aim - motor.pos, motor.up), nil
	end
	if (state ~= "patrol" and state ~= "stalk") or self.goal == nil or self.route == nil then return Vector3.zero, nil end
	local route = self.route :: { any }
	local target: Vector3
	self:_rounded()
	if self.hop <= #route then
		target = route[self.hop].aim
	else
		target = self.goal.pos + self.goal.up * SEAT
		if (target - motor.pos).Magnitude < 0.6 and self.goal.cross ~= nil then
			-- (ROBLOX-117) at the seam: the neighbour's region is its own from here, and it walks in a little before it plans again
			local cross = self.goal.cross
			if self.goalKey == "patrol" then r.leg = (r.leg or 0) + 1 end
			self.stats.arrivals += 1
			self:useRegion(cross.to)
			r.region = cross.to
			self.crossing = { aim = cross.aim, t = 0, ahead=cross.ahead, up=cross.up }
			self.stats.crossings = (self.stats.crossings or 0) + 1
			return SupportMath.tangentDir(cross.aim - motor.pos, motor.up), nil
		end
		if (target - motor.pos).Magnitude < 0.6 then
			-- ROBLOX-106: at a watch by the crack it stands its time (Drive.update counts it down) before it takes the next place.
			if self.goalKey == "patrol" and self.campHere == true then
				if r.camp == nil then
					self.stats.arrivals += 1
					local _, secs = self:campLeg(s.seed or 0, r.leg or 0)
					r.camp = secs
				end
				if r.camp > 0 then return Vector3.zero, nil end
				r.camp = nil
				r.leg = (r.leg or 0) + 1; self.goal = nil; self.route = nil; self.campHere = false
				return Vector3.zero, nil
			end
			-- Arrived. A patrol takes the next place; a stalk stands where the spider was.
			self.stats.arrivals += 1
			if self.goalKey == "patrol" then r.leg = (r.leg or 0) + 1; self.goal = nil; self.route = nil end
			return Vector3.zero, nil
		end
	end
	target = self.g:aroundKeepOut(motor.pos, target)
	return SupportMath.tangentDir(target - motor.pos, motor.up), if state == "stalk" and self.sees then s.position else nil
end

-- A rival that has just arrived or been restored: the motor stands where the state says.
function Drive._place(self: any, r: any)
	local motor = self.motor
	motor:place(r.position, r.up or Vector3.yAxis, r.heading)
	self.route, self.goal, self.face = nil, nil, nil
	self.stuckAt = motor.pos
	self.safe = { pos = motor.pos, up = motor.up, heading = motor.heading }
end

-- After a lunge it is somewhere in the air or inside the spider: back onto the face it lunged over, or back to where it started.
function Drive._reseat(self: any, r: any)
	local motor = self.motor
	local up = r.up or Vector3.yAxis
	local hit = workspace:Raycast(r.position + up * 0.3, -up * 1.2, motor.params)
	if hit ~= nil and motor:attachable(hit) and WorldMap.inRetreat(hit.Position + hit.Normal * SEAT, self.region) == nil then
		motor:place(hit.Position + hit.Normal * SEAT, hit.Normal, r.heading)
	else
		local at = r.origin
		motor:place(at, up, r.heading)
	end
	self.route, self.goal = nil, nil
	r.position, r.up, r.heading = motor.pos, motor.up, motor.heading
	self.safe = { pos = motor.pos, up = motor.up, heading = motor.heading }
end

-- One fixed tick, after RivalSpider.step. `s` is the same player snapshot step was given plus `up` (the player's support normal).
function Drive.update(self: any, r: any, dt: number, s: any)
	local motor = self.motor
	local state = r.state
	self.ticks += 1
	if r.up == nil then r.up = Vector3.yAxis end
	-- (ROBLOX-117) the record's region is the drive's (a rest put back, a new rival arrived somewhere else)
	if r.region ~= nil and r.region ~= self.region and WorldMap.region(r.region) ~= nil then
		self:useRegion(r.region)
		self.crossing = nil
	end
	if self.incremental and self.g == nil then
		Route.request(self.region)
		if Route.prepared(self.region) == nil then self.wish = Vector3.zero; return end
		self:useRegion(self.region)
	end
	local prev = self.prevState
	self.prevState = state
	if state == "dormant" or state == "consumed" then
		self.route, self.goal = nil, nil
		return
	end
	if prev == "dormant" or prev == "consumed" then
		self:_place(r)
	end
	if state == "captured" then
		-- Held and eaten where the spider is: the state moves it.
		motor:place(r.position, r.up, r.heading)
		return
	end
	if state == "lunge" or state == "taken" then return end
	if prev == "lunge" then
		self:_reseat(r)
	elseif (motor.pos - r.position).Magnitude > 0.05 or (r.up :: Vector3):Dot(motor.up) < 0.99 then
		-- A restored checkpoint, or anything else that moved it: stand where the state says.
		self.stats.resets += 1
		self:_place(r)
	end
	-- ROBLOX-106: a watch by the crack counts down while it patrols (stands there) or waits (the spider in the crack, a wasp's visit); a stalk does not use it up.
	if r.camp ~= nil and (state == "patrol" or state == "recover") then r.camp = math.max(0, r.camp - dt) end
	self.think -= dt
	if self.think <= 0 then
		self.think += Rules.thinkSeconds
		if self.think < 0 then self.think = 0 end
		self:_think(r, s)
	end
	local wish, focus = self:_wish(r, s)
	self.wish = wish
	local stalking = state == "stalk"
	local speed = if wish.Magnitude > 0 then (if stalking then Rules.stalkSpeed else Rules.patrolSpeed) else 0.0
	if speed > 0 then motor:setSpeedFactor(speed / motor.loco.walk_speed_wu_s) end
	if wish.Magnitude > 0 or focus ~= nil or motor.mode ~= "attached" or self.ticks % IDLE_EVERY == 0 then
		local input = Motor.idleInput()
		input.wish = wish
		input.focusPoint = focus
		motor:tick(input)
	end
	if motor.up:Dot(self.lastUp) < 0.99 then
		self.lastUp = motor.up
		self.face = if motor.mode == "attached" then self.g:faceAt(motor.pos, motor.up) else nil
		self:_hops()
	end
	-- The crack is never entered: whatever happened, back to the last place outside it.
	if WorldMap.inRetreat(motor.pos, self.region) ~= nil then
		local safe = self.safe
		motor:place(safe.pos, safe.up, safe.heading)
		self.route, self.goal = nil, nil
	elseif not self.g:inKeepOut(motor.pos) and motor.mode == "attached" then
		self.safe = { pos = motor.pos, up = motor.up, heading = motor.heading }
	end
	r.position, r.up, r.heading = motor.pos, motor.up, motor.heading
end

return Drive
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">RivalGrip</string>
            <string name="Source"><![CDATA[--!strict
-- The grip on a caught rival (ROBLOX-77): the same tapping struggle as the fly's (Prey/Feeding's grip math, so the HUD's grip bar and the Grip button
-- work as they do for a fly) with the rival's own numbers (Data/Catch.rival; the gentle modes get the house fly's, and nothing here ever harms the
-- player). A second Feeding controller is kept for it: only its `struggle` runs, never `step`, so it does not advance the reserves a second time.
-- RivalSpider holds the rival (`subdued` false) and this decides how it ends: subdued (RivalSpider.subdue, then it is eaten as before) or it tears
-- free (RivalSpider.tearFree: back to recover, nothing lost). The grip itself is scratch, never recorded: a rival found held and not subdued begins a
-- fresh grip, and a checkpoint is never taken while it is held (Checkpoint.boundaryProblem), so a return can only land at a rest.
local Feeding = require(script.Parent.Parent.Prey.Feeding)
local PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)
local Rival = require(script.Parent.RivalSpider)

local Grip = {}

-- A new grip. `needs` is only given to the controller (its struggle never touches it).
function Grip.new(needs: any?): any
	return { feeding = Feeding.new(needs), began = 0 }
end

-- Is the player's grip on a rival being fought for now (so the jump button is a tap and the HUD shows the grip)?
function Grip.active(g: any): boolean
	return g.feeding.struggling == true
end

-- The grip's strength 0..1 for the HUD, or nil when there is no struggle.
function Grip.level(g: any): number?
	if g.feeding.struggling then return g.feeding.grip end
	return nil
end

-- A tap of the Grip button.
function Grip.tap(g: any)
	g.feeding:press()
end

-- The seeded stream of this rival's struggle: the world's seed, the day, which contest it was (the rival's own count) and, ROBLOX-91, which grip on it this was
-- (`grips`, kept in its record: a rival that tore free and is caught again, without a contest in between, does not jerk at the same moments as the first time).
-- The first grip (grips 0) is the seed it always was. Nothing else in the game draws from it.
local function seedOf(seed: number, day: number, n: number, grips: number): number
	return (seed * 19349663 + (day * 1013 + 7) * 83492791 + n * 73856093 + grips * 40503793 + 54321) % 2147483647
end

-- One tick. `r` is the rival's record, `s` the same table RivalSpider.step gets (grounded, gentle, day, seed) plus `auto` (Automatic grip).
-- Returns "" (nothing happened), "begin" (a fresh grip on a rival just held), "subdued" (it is yours: eat it) or "tore" (it tore free).
function Grip.step(g: any, r: any, dt: number, s: any): string
	local f = g.feeding
	if not Rival.struggling(r) then
		if f.struggling then f.struggling = false; f.held = nil; f.tap = false end -- the rival is gone from the fangs by some other way
		return ""
	end
	local event = ""
	if not f.struggling then
		f.rng = PreyRandom.new(seedOf(s.seed or 0, s.day or 0, r.contests or 0, r.grips or 0))
		r.grips = (r.grips or 0) + 1
		f:useRivalRules(s.gentle == true)
		f.tap = false
		f:capture(r)
		g.began += 1
		event = "begin"
	end
	f.auto = s.auto == true
	local tore = false
	f:struggle(dt, s.grounded ~= false, function() tore = true end)
	if tore then
		Rival.tearFree(r)
		return "tore"
	end
	if not f.struggling and f.held ~= nil then
		f.held = nil
		f.feeding = false
		f.swallow = 0
		Rival.subdue(r)
		return "subdued"
	end
	return event
end

return Grip
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">RivalRoute</string>
            <string name="Source"><![CDATA[--!strict
-- Where the rival spider can walk, and the ways between (ROBLOX-69). A graph of a region's box faces (the sill's, ROBLOX-94; any region's, ROBLOX-95, below):
-- every face of every box is a node; two faces that meet along a line (a box's own edge, convex, or a wall rising from a floor, concave) are
-- joined by that seam. The rival's own SpiderMotor walks any seam the way the player's does (a wall ahead becomes the support, an edge is wrapped), so a
-- route is only a list of seams to cross and where to head to cross them. Pure and Vector3-light: the CLI checks it on the boxes, and the
-- same module runs in the game. Nothing here knows about time, state or the engine.
--
-- Faces are looked up by their box, the axis and the side. A face is "stand-able" at the sample points where a body of the motor's radius fits
-- without touching another box. The crack (the crevice boxes) is forbidden: no route enters it, and the keep-out box around the retreat turns
-- every straight walk aside; the open sash (ROBLOX-95) is a second keep-out box of the sill.
local Rules = require(script.Parent.Parent.Data.RivalRules)
local WorldMap = require(script.Parent.Parent.World.WorldMap)
local Region = require(script.Parent.Parent.World.Region)

local Route = {}

-- ROBLOX-94: the graph was the sill's, region 0 of the world. ROBLOX-95: it is region-scoped. `Route.graph(id)` is the graph of one region, built from that region's pieces
-- (Region.pieces) and keep-outs (Region.keepOut), with its neighbours' boxes as obstacles (a body that fits on a face fits there in the whole world), and with seam edges to
-- its neighbours' graphs along the seams the map declares (WorldMap neighbors): the faces of two regions that meet along a seam's line, across a corner or flat across the
-- same plane, are joined by an edge of the seam (`Graph:seamsOf(face)`). The functions of this module (faces, faceAt, adjacent, plan, aroundKeepOut, inKeepOut, waypoints,
-- walkBlocked) are the sill's graph's, as the rival and the mate have always called them: they are bound to the sill this round, never plan across a seam, and keep out of
-- its open sash (the sill's second keep-out box). The bed's graph is built and checked (tests/rivalnav.luau) and nothing walks it yet.
local AXIS = { "X", "Y", "Z" }
local SEAT = 0.31 -- the motor's body centre above its support (SpiderMotor.HEIGHT)
local BODY = 0.2 -- a stand-able point keeps this much clear (the motor itself only casts rays, so less than its radius of 0.3 will do)
local EPS = 1e-4
local MIN_SEAM = 0.3 -- shorter seams are not used

export type Edge = {
	to: number,
	samples: { Vector3 }, -- surface points on the seam where a body can cross
	ahead: Vector3, -- on the face this edge leaves: the direction toward the seam
	convex: boolean,
}
export type Face = {
	id: number,
	piece: string,
	axis: number,
	sign: number,
	normal: Vector3,
	plane: number,
	lo: { number },
	hi: { number },
	area: number,
	forbidden: boolean,
	stand: { Vector3 }, -- surface points where a body fits
	edges: { Edge },
	corners: { Vector3 }?, -- surface points just outside the corners of boxes standing on this face (made when first asked)
}
-- A hop is a seam crossed (from one face to the next), or a `via`: a corner of a box standing on the face, rounded so the walk does not run into it.
export type Hop = { from: number, face: number, seam: Vector3, aim: Vector3, via: boolean? }
-- An edge of a seam between regions: from a face of one region's graph to a face of a neighbour's (`region`; `to` is the face's id in that region's graph), across a
-- corner (`convex` or not) or `flat` across one plane.
export type SeamEdge = { region: string, to: number, samples: { Vector3 }, ahead: Vector3, convex: boolean, flat: boolean }

type BoxSpec = { id: string, lo: { number }, hi: { number } }

local Graph = {}
Graph.__index = Graph
local graphs: { [string]: any } = {}

local function comp(v: Vector3, axis: number): number
	return (v :: any)[AXIS[axis]]
end

local function vec(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end

local function axisVec(axis: number, s: number): Vector3
	return if axis == 1 then vec(s, 0, 0) elseif axis == 2 then vec(0, s, 0) else vec(0, 0, s)
end

-- Whether a point is strictly inside any box (a hair of tolerance). `real`: only the pieces (the keep-out boxes left out).
local function solid(g: any, p: Vector3, real: boolean?): boolean
	for i, b in g.boxes do
		if real and i > g.real then break end
		if p.X > b.lo[1] + EPS and p.X < b.hi[1] - EPS and p.Y > b.lo[2] + EPS and p.Y < b.hi[2] - EPS and p.Z > b.lo[3] + EPS and p.Z < b.hi[3] - EPS then
			return true
		end
	end
	return false
end

-- Whether a body of the motor's radius centred here touches no box. `real`: only the pieces (the keep-out boxes left out).
local function bodyFits(g: any, c: Vector3, radius: number?, real: boolean?): boolean
	local r = radius or BODY
	for i, b in g.boxes do
		if real and i > g.real then break end
		local dx = math.max(b.lo[1] - c.X, 0, c.X - b.hi[1])
		local dy = math.max(b.lo[2] - c.Y, 0, c.Y - b.hi[2])
		local dz = math.max(b.lo[3] - c.Z, 0, c.Z - b.hi[3])
		if dx * dx + dy * dy + dz * dz < r * r then return false end
	end
	return true
end

-- The keep-out boxes: the retreats, grown by a margin, and on the sill its open sash. Nothing the region's creatures do goes in.
function Graph.inKeepOut(self: any, p: Vector3): boolean
	for _, k in self.keep do
		local lo, hi = k.min, k.max
		if p.X >= lo.X and p.X <= hi.X and p.Y >= lo.Y and p.Y <= hi.Y and p.Z >= lo.Z and p.Z <= hi.Z then return true end
	end
	return false
end

local function forbiddenPiece(g: any, id: string): boolean
	return g.region.kind == "sill" and (string.sub(id, 1, 8) == "crevice_" or id == "leaf_tip")
end

local function boxOf(piece: { id: string, lo: Vector3, hi: Vector3 }): BoxSpec
	return { id = piece.id, lo = { piece.lo.X, piece.lo.Y, piece.lo.Z }, hi = { piece.hi.X, piece.hi.Y, piece.hi.Z } }
end

local function build(g: any)
	if g.built then return end
	g.built = true
	local boxes, faces = g.boxes, g.faces
	for _, piece in Region.pieces(g.region) do
		table.insert(boxes, boxOf(piece))
		if g.work then g.work() end
	end
	g.own = #boxes
	-- The neighbours' boxes are obstacles here (a body beside the seam fits only where it fits in the whole world), and have no faces in this graph.
	for _, n in g.region.neighbors do
		local other = WorldMap.region(n.id)
		if other ~= nil then
			for _, piece in Region.pieces(other) do table.insert(boxes, boxOf(piece)) end
		end
	end
	-- Where the region's creatures may be: the sill's walkable sill (the frames' outer faces and the floor's underside are outside it), any other region's bounds.
	local slo, shi = Rules.sillMin, Rules.sillMax
	if g.region.kind ~= "sill" then slo, shi = g.region.bounds[1], g.region.bounds[2] end
	-- Faces: six to a box.
	for bi = 1, g.own do
		local b = boxes[bi]
		for axis = 1, 3 do
			for _, sign in { -1, 1 } do
				local o1, o2 = (axis % 3) + 1, ((axis + 1) % 3) + 1
				local face: Face = {
					id = #faces + 1, piece = b.id, axis = axis, sign = sign, normal = axisVec(axis, sign),
					plane = if sign > 0 then b.hi[axis] else b.lo[axis], lo = { 0, 0, 0 }, hi = { 0, 0, 0 },
					area = (b.hi[o1] - b.lo[o1]) * (b.hi[o2] - b.lo[o2]), forbidden = forbiddenPiece(g, b.id), stand = {}, edges = {},
				}
				for k = 1, 3 do
					face.lo[k], face.hi[k] = b.lo[k], b.hi[k]
				end
				face.lo[axis], face.hi[axis] = face.plane, face.plane
				-- Where a body fits on this face: a grid over its rectangle, inset a little from the rim.
				local n = if face.area > 60 then 9 else 5
				for i = 0, n - 1 do
					for j = 0, n - 1 do
						if g.work then g.work() end
						local pt = { 0, 0, 0 }
						pt[axis] = face.plane
						local function at(k: number, t: number): number
							local inset = math.min(0.3, (b.hi[k] - b.lo[k]) / 2)
							return b.lo[k] + inset + (b.hi[k] - b.lo[k] - 2 * inset) * t
						end
						pt[o1] = at(o1, (i + 0.5) / n)
						pt[o2] = at(o2, (j + 0.5) / n)
						local surface = vec(pt[1], pt[2], pt[3])
						if bodyFits(g, surface + face.normal * SEAT) then table.insert(face.stand, surface) end
					end
				end
				-- Outer faces (the frames' backs, the floor's underside) are outside where the creatures may be: no route enters them.
				local mid = vec((face.lo[1] + face.hi[1]) / 2, (face.lo[2] + face.hi[2]) / 2, (face.lo[3] + face.hi[3]) / 2) + face.normal * SEAT
				if mid.X < slo.X or mid.X > shi.X or mid.Y < slo.Y or mid.Y > shi.Y or mid.Z < slo.Z or mid.Z > shi.Z then face.forbidden = true end
				table.insert(faces, face)
			end
		end
	end
	-- Seams between faces on different axes.
	for _, f in faces do
		local A = boxes[1]
		for bi = 1, g.own do
			if boxes[bi].id == f.piece then A = boxes[bi]; break end
		end
		for _, h in faces do
			if h.axis ~= f.axis then
				if g.work then g.work() end
				local B = boxes[1]
				for bi = 1, g.own do
					if boxes[bi].id == h.piece then B = boxes[bi]; break end
				end
				local a, b = f.axis, h.axis
				local c = 6 - a - b
				local cA, cB = f.plane, h.plane
				if cB >= A.lo[b] - EPS and cB <= A.hi[b] + EPS and cA >= B.lo[a] - EPS and cA <= B.hi[a] + EPS then
					local lo, hi = math.max(A.lo[c], B.lo[c]), math.min(A.hi[c], B.hi[c])
					if hi - lo >= MIN_SEAM then
						local convex = f.piece == h.piece
						local mid = { 0, 0, 0 }
						mid[a], mid[b], mid[c] = cA, cB, (lo + hi) / 2
						local corner = vec(mid[1], mid[2], mid[3]) + f.normal * 0.15 + h.normal * 0.15
						if not solid(g, corner) then
							-- From the seam into each face: a face meets a wall of another box on the wall's free side, and meets the rest of its own box
							-- away from the edge it turns over.
							local intoF = if convex then -h.normal else h.normal
							local intoG = if convex then -f.normal else f.normal
							local samples: { Vector3 } = {}
							for _, t in { 0.12, 0.3, 0.5, 0.7, 0.88 } do
								local pc = lo + (hi - lo) * t
								if pc - lo >= 0.2 and hi - pc >= 0.2 or t == 0.5 then
									local s = { 0, 0, 0 }
									s[a], s[b], s[c] = cA, cB, pc
									local seam = vec(s[1], s[2], s[3])
									-- (A crossing may be a narrow strip, such as the underside of the planter's rim: only the places right at the seam are tested.)
									if bodyFits(g, seam + intoF * 0.12 + f.normal * SEAT, 0.1) and bodyFits(g, seam + intoG * 0.12 + h.normal * SEAT, 0.1)
										and not g:inKeepOut(seam) then
										table.insert(samples, seam)
									end
								end
							end
							if #samples > 0 then
								table.insert(f.edges, { to = h.id, samples = samples, ahead = -intoF, convex = convex })
							end
						end
					end
				end
			end
		end
	end
	-- The keep-out boxes are obstacles like any box (the walk tests and the corners to round count them) but have no faces: nothing walks on them.
	g.real = #boxes
	for _, k in g.keep do
		table.insert(boxes, { id = "keepout", lo = { k.min.X, k.min.Y, k.min.Z }, hi = { k.max.X, k.max.Y, k.max.Z } })
	end
end

-- The graph of a region (the sill's when no id is given), built when first asked. Errors for a region that is not on the map.
function Route.graph(regionId: string?): any
	local id = regionId or WorldMap.HOME
	local key = WorldMap.world() .. "/" .. id -- (ROBLOX-115: a region's graph is its world's: the preserve's sill has no neighbours' boxes in it)
	local g = graphs[key]
	if g ~= nil then return g end
	local region = WorldMap.region(id)
	assert(region ~= nil, "no region " .. id)
	local made = setmetatable({ region = region, own = 0, real = 0, boxes = {}, faces = {}, keep = Region.keepOut(region), built = false, seamsBuilt = false, seams = {} }, Graph)
	graphs[key] = made :: any
	return made
end

function Graph.allFaces(self: any): { Face }
	build(self)
	return self.faces
end

-- The face a body stands on: its centre, the support's normal. Nil when it is on no known face (in the air, or on a face this graph lacks).
function Graph.faceAt(self: any, center: Vector3, up: Vector3): number?
	build(self)
	local surface = center - up * SEAT
	local best, bestD = nil :: number?, 0.12
	for _, f in self.faces do
		if f.normal:Dot(up) > 0.98 then
			local d = math.abs(comp(surface, f.axis) - f.plane)
			if d < bestD then
				local inside = true
				for k = 1, 3 do
					if k ~= f.axis and (comp(surface, k) < f.lo[k] - 0.12 or comp(surface, k) > f.hi[k] + 0.12) then inside = false; break end
				end
				if inside then best, bestD = f.id, d end
			end
		end
	end
	return best
end

-- Whether two faces are the same or meet along a seam: the rival may strike from one onto the other.
function Graph.adjacent(self: any, a: number?, b: number?): boolean
	if a == nil or b == nil then return false end
	if a == b then return true end
	build(self)
	for _, e in self.faces[a].edges do
		if e.to == b then return true end
	end
	return false
end

-- Whether a straight walk across a face of the box `own` from one surface point to another would run into a box standing on it (the body is a ball of
-- 0.3, kept 0.2 off; the stretch next to the end points is not tested, they are at seams and walls by design).
function Graph.walkBlocked(self: any, a: Vector3, b: Vector3, normal: Vector3, own: string): boolean
	build(self)
	local d = b - a
	local len = d.Magnitude
	if len < 0.35 then return false end
	local dir = d / len
	local cut = math.min(0.4, len * 0.5)
	local pa = a + dir * cut + normal * SEAT
	local pb = b - dir * cut + normal * SEAT
	local seg = pb - pa
	for _, box in self.boxes do
		local tmin, tmax = 0.0, 1.0
		local hit = box.id ~= own
		for k = 1, 3 do
			local o, dk = comp(pa, k), comp(seg, k)
			local l, h = box.lo[k] - 0.35, box.hi[k] + 0.35
			if math.abs(dk) < 1e-9 then
				if o < l or o > h then hit = false; break end
			else
				local t1, t2 = (l - o) / dk, (h - o) / dk
				if t1 > t2 then t1, t2 = t2, t1 end
				tmin, tmax = math.max(tmin, t1), math.min(tmax, t2)
				if tmin > tmax then hit = false; break end
			end
		end
		-- Starting beside a box and not walking toward it is not blocked: the start is inside its margin for a stride only.
		if hit then
			local away = false
			if tmin <= 1e-6 then
				local n = { 0.0, 0.0, 0.0 }
				for k = 1, 3 do
					local o = comp(pa, k)
					if o < box.lo[k] then n[k] = o - box.lo[k] elseif o > box.hi[k] then n[k] = o - box.hi[k] end
				end
				away = (n[1] ~= 0 or n[2] ~= 0 or n[3] ~= 0) and seg.X * n[1] + seg.Y * n[2] + seg.Z * n[3] >= -1e-9
			end
			if not away then return true end
		end
	end
	return false
end

-- The places to round a box that stands on a face: just outside each of its corners (0.42 off, the walk test keeps 0.35), where a body fits.
local function cornersOf(g: any, f: Face): { Vector3 }
	if f.corners ~= nil then return f.corners :: { Vector3 } end
	local out: { Vector3 } = {}
	f.corners = out
	local o1, o2 = (f.axis % 3) + 1, ((f.axis + 1) % 3) + 1
	local level = f.plane + f.sign * SEAT
	local M = 0.42
	for _, b in g.boxes do
		if b.id ~= f.piece and level >= b.lo[f.axis] - 0.35 and level <= b.hi[f.axis] + 0.35
			and b.hi[o1] + M > f.lo[o1] and b.lo[o1] - M < f.hi[o1] and b.hi[o2] + M > f.lo[o2] and b.lo[o2] - M < f.hi[o2] then
			for _, c1 in { b.lo[o1] - M, b.hi[o1] + M } do
				for _, c2 in { b.lo[o2] - M, b.hi[o2] + M } do
					if c1 >= f.lo[o1] + 0.2 and c1 <= f.hi[o1] - 0.2 and c2 >= f.lo[o2] + 0.2 and c2 <= f.hi[o2] - 0.2 then
						local pt = { 0, 0, 0 }
						pt[f.axis], pt[o1], pt[o2] = f.plane, c1, c2
						local surface = vec(pt[1], pt[2], pt[3])
						local centre = surface + f.normal * SEAT
						if bodyFits(g, centre, 0.3) and not g:inKeepOut(surface) and not g:inKeepOut(centre) then
							table.insert(out, surface)
						end
					end
				end
			end
		end
	end
	return out
end

-- A binary min-heap of {priority, id}.
local function heapPush(h: { any }, pri: number, id: number)
	table.insert(h, { pri, id })
	local i = #h
	while i > 1 do
		local p = i // 2
		if h[p][1] <= h[i][1] then break end
		h[p], h[i] = h[i], h[p]
		i = p
	end
end
local function heapPop(h: { any }): (number, number)
	local top = h[1]
	local last = table.remove(h) :: any
	if #h > 0 then
		h[1] = last
		local i = 1
		while true do
			local l, r, m = i * 2, i * 2 + 1, i
			if l <= #h and h[l][1] < h[m][1] then m = l end
			if r <= #h and h[r][1] < h[m][1] then m = r end
			if m == i then break end
			h[m], h[i] = h[i], h[m]
			i = m
		end
	end
	return top[1], top[2]
end

-- The shortest way from a surface point on one face to a surface point on another, as the seams to cross and the corners to round. Nil when there
-- is none. `from` and `goal` are surface points (not body centres). The search is over crossings and corners, not faces: a face is walked
-- differently from where it is entered (a floor entered beside a box is not the floor entered on the far side of it), and a straight walk across
-- a face that a box stands on is not a walk at all. Within the region: seams to its neighbours are not crossed.
function Graph.plan(self: any, fromFace: number, from: Vector3, goalFace: number, goal: Vector3): { Hop }?
	build(self)
	local faces = self.faces
	local TURN = 0.6
	local BLOCKED = 25.0
	-- States: 1 is the start; the others are crossings (1), corners (2) and the goal (3), numbered as they are found.
	local stFace: { number } = { fromFace }
	local stPos: { Vector3 } = { from }
	local stPrev: { number } = { 0 }
	local stKind: { number } = { 0 }
	local stSeam: { Vector3 } = { from }
	local stAim: { Vector3 } = { from }
	local stDist: { number } = { 0 }
	local stCame: { number } = { 0 } -- the face a crossing chain started from (no turning straight back over the seam just crossed)
	local settled: { [number]: boolean } = {}
	local heap: { any } = {}
	heapPush(heap, 0, 1)
	local bestVia: { [number]: number } = {} -- the cheapest cost found for each crossing (a face and which of its seams) and corner
	local goalCost = math.huge
	local goalState = 0
	local function add(face: number, pos: Vector3, prev: number, kind: number, aim: Vector3, dist: number, came: number)
		table.insert(stFace, face)
		table.insert(stPos, pos)
		table.insert(stPrev, prev)
		table.insert(stKind, kind)
		table.insert(stSeam, pos)
		table.insert(stAim, aim)
		table.insert(stDist, dist)
		table.insert(stCame, came)
		heapPush(heap, dist, #stFace)
	end
	while #heap > 0 do
		local _, id = heapPop(heap)
		if not settled[id] then
			settled[id] = true
			if stKind[id] == 3 then goalState = id; break end
			local fid = stFace[id]
			local face = faces[fid]
			local here = stPos[id]
			local cost = stDist[id]
			if fid == goalFace then
				local nd = cost + (goal - here).Magnitude + (if self:walkBlocked(here, goal, face.normal, face.piece) then BLOCKED else 0)
				if nd < goalCost then
					goalCost = nd
					add(goalFace, goal, id, 3, goal, nd, stCame[id])
				end
			end
			-- Round the corner of a box standing on this face.
			for ci, c in cornersOf(self, face) do
				local key = -(fid * 256 + ci)
				local nd = cost + (c - here).Magnitude + 0.1
				local known = bestVia[key]
				if (known == nil or nd < known - 1e-9) and (c - here).Magnitude > 0.05 and not self:walkBlocked(here, c, face.normal, face.piece) then
					bestVia[key] = nd
					add(fid, c, id, 2, c + face.normal * SEAT, nd, stCame[id])
				end
			end
			-- Cross a seam.
			for ei, e in face.edges do
				local g = faces[e.to]
				if not g.forbidden and e.to ~= stCame[id] then
					local ordered = table.clone(e.samples)
					table.sort(ordered, function(p: Vector3, q: Vector3): boolean return (p - here).Magnitude < (q - here).Magnitude end)
					local best, bestD = ordered[1], (ordered[1] - here).Magnitude + BLOCKED
					for i = 1, math.min(#ordered, 3) do
						if not self:walkBlocked(here, ordered[i], face.normal, face.piece) then
							best, bestD = ordered[i], (ordered[i] - here).Magnitude
							break
						end
					end
					local nd = cost + bestD + TURN
					local key = fid * 64 + ei
					local known = bestVia[key]
					if known == nil or nd < known - 1e-9 then
						bestVia[key] = nd
						add(e.to, best, id, 1, best + e.ahead * 0.5, nd, fid)
					end
				end
			end
		end
	end
	if goalState == 0 then return nil end
	local hops: { Hop } = {}
	local at = stPrev[goalState]
	while stPrev[at] ~= 0 do
		local p = stPrev[at]
		if stKind[at] == 2 then
			table.insert(hops, 1, { from = stFace[at], face = stFace[at], seam = stSeam[at], aim = stAim[at], via = true })
		else
			table.insert(hops, 1, { from = stFace[p], face = stFace[at], seam = stSeam[at], aim = stAim[at] })
		end
		at = p
	end
	return hops
end

-- Where to head so a straight walk does not cross the first keep-out box (the retreat's): the goal itself, or a corner of the box to round first.
function Graph.aroundKeepOut(self: any, from: Vector3, goal: Vector3): Vector3
	local keep = self.keep[1]
	if keep == nil then return goal end
	local lo, hi = keep.min, keep.max
	-- The segment against the box, on the plane of the floor (the box is only a little taller than the spider).
	local function crosses(a: Vector3, b: Vector3): boolean
		local tmin, tmax = 0, 1
		for _, axis in { "X", "Z" } do
			local da = (b :: any)[axis] - (a :: any)[axis]
			local oa = (a :: any)[axis]
			local l, h = (lo :: any)[axis], (hi :: any)[axis]
			if math.abs(da) < 1e-9 then
				if oa < l or oa > h then return false end
			else
				local t1, t2 = (l - oa) / da, (h - oa) / da
				if t1 > t2 then t1, t2 = t2, t1 end
				tmin, tmax = math.max(tmin, t1), math.min(tmax, t2)
				if tmin > tmax then return false end
			end
		end
		return true
	end
	local inFirst = from.X >= lo.X and from.X <= hi.X and from.Y >= lo.Y and from.Y <= hi.Y and from.Z >= lo.Z and from.Z <= hi.Z
	if inFirst or from.Y > hi.Y + 0.4 or goal.Y > hi.Y + 0.4 then return goal end
	if not crosses(from, goal) then return goal end
	local y = from.Y
	local best, bestLen = goal, math.huge
	for _, x in { lo.X - 0.05, hi.X + 0.05 } do
		for _, z in { lo.Z - 0.05, hi.Z + 0.05 } do
			local corner = vec(x, y, z)
			if not crosses(from, corner) and not crosses(corner, goal) then
				local len = (corner - from).Magnitude + (goal - corner).Magnitude
				if len < bestLen then best, bestLen = corner, len end
			end
		end
	end
	return best
end

export type Waypoint = { pos: Vector3, up: Vector3, face: number }

-- Places to patrol to, spread over every face the region's creatures may walk: the tops of the boxes and their climbable sides (not undersides, not
-- the crack), a few on a big face, always a spot where a body fits.
function Graph.waypoints(self: any): { Waypoint }
	build(self)
	local out: { Waypoint } = {}
	for _, f in self.faces do
		if self.work then self.work() end
		if not f.forbidden and f.normal.Y > -0.5 and f.area >= 1.5 and #f.stand > 0 then
			local k = math.clamp(math.floor(f.area / 70) + 1, 1, 5)
			local picked: { Vector3 } = {}
			local pool: { Vector3 } = {}
			for _, s in f.stand do
				if self.work then self.work() end
				if not self:inKeepOut(s + f.normal * SEAT) and not self:inKeepOut(s) then table.insert(pool, s) end
			end
			if #pool > 0 then
				table.insert(picked, pool[math.ceil(#pool / 2)])
				while #picked < math.min(k, #pool) do
					local far, farD = pool[1], -1.0
					for _, s in pool do
						if self.work then self.work() end
						local nearest = math.huge
						for _, q in picked do nearest = math.min(nearest, (s - q).Magnitude) end
						if nearest > farD then far, farD = s, nearest end
					end
					table.insert(picked, far)
				end
				for _, s in picked do table.insert(out, { pos = s, up = f.normal, face = f.id }) end
			end
		end
	end
	return out
end

-- Whether a point lies on the segment a-b (within a hair), and the part of the segment [lo, hi] along `axis` it shares with a line at the other two coordinates.
local function onLine(a: Vector3, b: Vector3, axis: number, fixed: { number }, lo: number, hi: number): (number, number)
	for k = 1, 3 do
		if k ~= axis and (math.abs(comp(a, k) - fixed[k]) > 0.05 or math.abs(comp(b, k) - fixed[k]) > 0.05) then return 0, -1 end
	end
	local s0, s1 = math.min(comp(a, axis), comp(b, axis)), math.max(comp(a, axis), comp(b, axis))
	return math.max(lo, s0), math.min(hi, s1)
end

-- The seams to this region's neighbours, built when first asked: for every seam the map declares, the pairs of faces (one here, one in the neighbour's graph) that meet
-- along its line, across a corner or flat across one plane, with the places on the line where a body can cross (both sides tested against the whole world's boxes).
-- The keep-outs do not prune these: a seam edge is the map's topology, and whether a creature may cross it is its own rule (this round none does).
local function buildSeams(g: any)
	if g.seamsBuilt then return end
	g.seamsBuilt = true
	build(g)
	for _, n in g.region.neighbors do
		local other = if g.resolve then g.resolve(n.id) else Route.graph(n.id)
		build(other)
		for _, f in g.faces do
			for _, h in other.faces do
				if g.work then g.work() end
				local samplesLine: { number }? = nil
				local axis, fixed, ahead, convex, flat = 0, { 0, 0, 0 }, Vector3.zero, false, false
				local nf, nh = f.normal, h.normal
				if h.axis ~= f.axis then
					-- across a corner: the line where the two planes meet, along the third axis, inside both faces
					local a, b = f.axis, h.axis
					local c = 6 - a - b
					if h.plane >= f.lo[b] - EPS and h.plane <= f.hi[b] + EPS and f.plane >= h.lo[a] - EPS and f.plane <= h.hi[a] + EPS then
						fixed[a], fixed[b] = f.plane, h.plane
						local lo, hi = onLine(n.a, n.b, c, fixed, math.max(f.lo[c], h.lo[c]), math.min(f.hi[c], h.hi[c]))
						if hi - lo >= MIN_SEAM then
							local mid = { 0, 0, 0 }
							mid[a], mid[b], mid[c] = f.plane, h.plane, (lo + hi) / 2
							local m = vec(mid[1], mid[2], mid[3])
							if not solid(g, m + nf * 0.15 + nh * 0.15, true) then
								local isConvex = not solid(g, m + nf * 0.15 - nh * 0.15, true)
								-- each face must go on from the line the way the corner says (a wall's foot onto the floor in front of it, an edge onto the box's
								-- own side): a face that lies against the other box (a slab's underside on the wall it sits on) is no way across
								local intoF = if isConvex then -nh else nh
								local intoH = if isConvex then -nf else nf
								local pf, ph = m + intoF * 0.12, m + intoH * 0.12
								if comp(pf, b) >= f.lo[b] - EPS and comp(pf, b) <= f.hi[b] + EPS and comp(ph, a) >= h.lo[a] - EPS and comp(ph, a) <= h.hi[a] + EPS then
									convex = isConvex
									axis = c
									samplesLine = { lo, hi }
									ahead = -intoF
								end
							end
						end
					end
				elseif h.sign == f.sign and math.abs(h.plane - f.plane) < EPS then
					-- flat across one plane: the two rectangles touch along an edge
					local a = f.axis
					for _, o in { (a % 3) + 1, ((a + 1) % 3) + 1 } do
						local along = 6 - a - o
						for _, touch in { { f.hi[o], h.lo[o], 1 }, { f.lo[o], h.hi[o], -1 } } do
							if samplesLine == nil and math.abs(touch[1] - touch[2]) < EPS then
								fixed[a], fixed[o] = f.plane, touch[1]
								local lo, hi = onLine(n.a, n.b, along, fixed, math.max(f.lo[along], h.lo[along]), math.min(f.hi[along], h.hi[along]))
								if hi - lo >= MIN_SEAM then
									axis, samplesLine, flat = along, { lo, hi }, true
									ahead = axisVec(o, touch[3])
								end
							end
						end
					end
				end
				if samplesLine ~= nil then
					local line = samplesLine :: { number }
					local samples: { Vector3 } = {}
					for _, t in { 0.12, 0.3, 0.5, 0.7, 0.88 } do
						local pc = line[1] + (line[2] - line[1]) * t
						local s = table.clone(fixed)
						s[axis] = pc
						local seam = vec(s[1], s[2], s[3])
						local intoF = -ahead
						local intoH = if flat then ahead elseif convex then -nf else nf
						if bodyFits(g, seam + intoF * 0.12 + nf * SEAT, 0.1, true) and bodyFits(g, seam + intoH * 0.12 + nh * SEAT, 0.1, true) then
							table.insert(samples, seam)
						end
					end
					if #samples > 0 then
						local list = g.seams[f.id]
						if list == nil then list = {}; g.seams[f.id] = list end
						table.insert(list, { region = n.id, to = h.id, samples = samples, ahead = ahead, convex = convex, flat = flat })
					end
				end
			end
		end
	end
end

-- The seam edges leaving a face of this region's graph for its neighbours' (none for most faces).
function Graph.seamsOf(self: any, face: number): { SeamEdge }
	buildSeams(self)
	return self.seams[face] or {}
end

-- Every seam edge of this region's graph, as { face, edge } pairs.
function Graph.allSeams(self: any): { { face: number, edge: SeamEdge } }
	buildSeams(self)
	local out = {}
	for fid = 1, #self.faces do
		for _, e in self.seams[fid] or {} do table.insert(out, { face = fid, edge = e }) end
	end
	return out
end

-- Opt-in frame-budgeted preparation. Legacy graph queries stay synchronous.
-- Jobs own their construction tables; the public cache receives only completed
-- face graphs, and prepared() requires complete seams and patrol waypoints too.
local pending: { [string]: any } = {}
local queue: { any } = {}
local active: any = nil
local budget = { left = 0, deadline = 0.0 }
local preparation = { completed = 0, cancelled = 0, failed = 0, lastUnits = 0, lastSeconds = 0.0, largestSlice = 0.0, error = "" }

local function keyOf(id: string): string return WorldMap.world() .. "/" .. id end
local function ready(g: any): boolean
	return g ~= nil and g.built == true and g.seamsBuilt == true and g.preparedWaypoints ~= nil
end
function Route.prepared(id: string): any
	local g = graphs[keyOf(id)]
	return if ready(g) then g else nil
end
function Route.preparedWaypoints(g: any): { Waypoint }
	assert(ready(g), "route is not prepared")
	local out = {}
	for _, p in g.preparedWaypoints do table.insert(out, table.clone(p)) end
	return out
end
local function checkpoint()
	budget.left -= 1
	if budget.left <= 0 or os.clock() >= budget.deadline then coroutine.yield() end
end
local function privateGraph(id: string): any
	local old = graphs[keyOf(id)]
	if old ~= nil and old.built then
		-- Built faces/obstacles are stable. Seams are written only on this clone.
		return setmetatable(table.clone(old), Graph)
	end
	local region = WorldMap.region(id)
	assert(region ~= nil, "no region " .. id)
	return setmetatable({ region = region, own = 0, real = 0, boxes = {}, faces = {}, keep = Region.keepOut(region), built = false, seamsBuilt = false, seams = {} }, Graph)
end
function Route.request(id: string, priority: boolean?): boolean
	if Route.prepared(id) ~= nil then return true end
	assert(WorldMap.region(id) ~= nil, "no region " .. id)
	local key = keyOf(id)
	local job = pending[key]
	if job ~= nil then
		if priority ~= false and job ~= active then
			local at = table.find(queue, job)
			if at ~= nil and at > 1 then table.remove(queue, at); table.insert(queue, 1, job) end
		end
		return false
	end
	job = { id = id, key = key, world = WorldMap.world() }
	job.thread = coroutine.create(function()
		local shadows: { [string]: any } = {}
		local function resolve(otherId: string): any
			if shadows[otherId] ~= nil then return shadows[otherId] end
			local old = graphs[keyOf(otherId)]
			if old ~= nil and old.built then return old end
			local made = privateGraph(otherId)
			made.work = checkpoint
			shadows[otherId] = made
			return made
		end
		local root = privateGraph(id)
		-- A pending clone must never append to a public partial seam table.
		if not root.seamsBuilt then root.seams = {} end
		root.work, root.resolve = checkpoint, resolve
		shadows[id] = root
		buildSeams(root)
		root.preparedWaypoints = root:waypoints()
		-- No yields during publication. A world change cancels the job before
		-- its next resume, so these keys always name the world being prepared.
		for otherId, made in shadows do
			made.work, made.resolve = nil, nil
			local old = graphs[keyOf(otherId)]
			if otherId == id then
				if not ready(old) then graphs[keyOf(otherId)] = made end
			elseif old == nil or not old.built then graphs[keyOf(otherId)] = made end
		end
	end)
	pending[key] = job
	if priority == false then table.insert(queue, job) else table.insert(queue, 1, job) end
	return false
end
function Route.cancelPreparation()
	for _ in pending do preparation.cancelled += 1 end
	pending, queue, active = {}, {}, nil
end
function Route.advance(maxUnits: number?, seconds: number?): (boolean, string?)
	local started = os.clock()
	local units = math.max(1, math.floor(maxUnits or 512))
	budget.left, budget.deadline = units, started + math.max(0, seconds or .002)
	local ok, problem = true, nil :: string?
	while budget.left > 0 and os.clock() < budget.deadline do
		if active == nil then active = table.remove(queue, 1) end
		if active == nil then break end
		local job = active
		if job.world ~= WorldMap.world() then
			pending[job.key], active = nil, nil
			preparation.cancelled += 1
			continue
		end
		local resumed, why = coroutine.resume(job.thread)
		if not resumed then
			preparation.failed += 1; preparation.error = tostring(why)
			pending[job.key], active = nil, nil
			ok, problem = false, tostring(why)
			break
		elseif coroutine.status(job.thread) == "dead" then
			pending[job.key], active = nil, nil
			preparation.completed += 1
		else break end
	end
	preparation.lastUnits = units - budget.left
	preparation.lastSeconds = os.clock() - started
	preparation.largestSlice = math.max(preparation.largestSlice, preparation.lastSeconds)
	return ok, problem
end
function Route.preparationStats(): any
	local out: any = table.clone(preparation)
	local count = 0; for _ in pending do count += 1 end
	out.pending, out.active = count, if active then active.id else nil
	return out
end

-- ---------------------------------------------------------------- the sill's graph, as the rival and the mate call it
local function sill(): any
	return Route.graph(WorldMap.HOME)
end

function Route.faces(): { Face }
	return sill():allFaces()
end

function Route.inKeepOut(p: Vector3): boolean
	return sill():inKeepOut(p)
end

function Route.faceAt(center: Vector3, up: Vector3): number?
	return sill():faceAt(center, up)
end

function Route.adjacent(a: number?, b: number?): boolean
	return sill():adjacent(a, b)
end

function Route.plan(fromFace: number, from: Vector3, goalFace: number, goal: Vector3): { Hop }?
	return sill():plan(fromFace, from, goalFace, goal)
end

function Route.aroundKeepOut(from: Vector3, goal: Vector3): Vector3
	return sill():aroundKeepOut(from, goal)
end

function Route.waypoints(): { Waypoint }
	return sill():waypoints()
end

Route.SEAT = SEAT
Route.walkBlocked = function(a: Vector3, b: Vector3, normal: Vector3, own: string): boolean
	return sill():walkBlocked(a, b, normal, own)
end

return Route
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">RivalSpider</string>
            <string name="Source"><![CDATA[--!strict
-- Intraguild predator: the preserve's resident ranger-station patrol, present
-- from the first day. The frozen test garden retains its daily visiting rival.
-- Timings/reward are game tuning, not species measurements.
-- Plain state lives in LifeLoop's checkpoint graph; no clock, engine instance or hidden player tracking.
-- ROBLOX-73: the spider's strike catches a rival that has not seen it coming outright, but a rival that has (stalking, winding up, or patrolling
-- with a notice of Rules.awareNotice) is a contest: caught, sprang clear, or a counter-bite that costs energy. The draw is the rival's own stream.
-- ROBLOX-77: a rival that was caught is held but not yet eaten: it struggles (`subdued` false) until the player has subdued it with the tapping
-- grip (Predator/RivalGrip runs that; Rival.subdue marks it) or it tears free (Rival.tearFree: back to recover, its day kept). Only a subdued rival
-- is eaten. A held rival with no `subdued` at all (a record from before) is eaten as it always was.
-- ROBLOX-91: a rival that tore free is `shaken` while it recovers: it is aware (a strike is the contest again, with its counter-bite, and not a free re-catch);
-- the mark goes at its next change of phase. The rival keeps away from a courting pair and from the mating scene (`s.courting`, `s.scene`: it recovers, like
-- the wasp's visit). The day it was eaten is a morning, not the raw day counter: a new one comes at the next 07:00 after the 07:00 it was eaten in.
local M=require(script.Parent.Parent.Prey.PreyMath)
local PreyRandom=require(script.Parent.Parent.Prey.PreyRandom)
local Rules=require(script.Parent.Parent.Data.RivalRules)
local WorldMap=require(script.Parent.Parent.World.WorldMap)
local Station=require(script.Parent.Parent.World.StationTerritory)
local Rival={}
local function phase(r: any,s: string) if r.state~=s then r.shaken=nil end;r.state=s;r.elapsed=0 end
Rival.FOOD=.7 -- two housefly-equivalent meals
Rival.FAR=6000 -- (ROBLOX-119) how far from the sill a record's places may be: World/Preserve.LIMIT
local states={dormant=true,patrol=true,stalk=true,windup=true,lunge=true,recover=true,captured=true,consumed=true,taken=true}
-- "dormant" is "has not arrived yet". `day` (nil in a record from before the daily rival) is the day it was eaten, so the next one comes after it.
-- ROBLOX-117: where a rival arrives, and its region: the sill's east end in the test garden (Data/RivalRules; no region, as every record there has always been), the
-- station floor in the preserve (StationTerritory), with its region kept in the record.
function Rival.arriveAt(): (Vector3,string?)
 if WorldMap.world()=="preserve" then return Station.ARRIVE,Station.REGION end
 return Rules.arriveAt,nil
end
-- The regions a rival roams (nil: the legacy sill). The preserve's mate keeps its garden territory.
function Rival.roam(): {[string]:boolean}?
 if WorldMap.world()=="preserve" then return Station.roam() end
 return nil
end
function Rival.new(): any
 local at,region=Rival.arriveAt()
 local r={state="dormant",position=at,previous=at,heading=-Vector3.xAxis,
  elapsed=0,notice=0,food=Rival.FOOD,target=at,origin=at,patrol=0,up=Vector3.yAxis,leg=0,contests=0,grips=0}
 if region~=nil then r.region=region end
 return r
end
-- ROBLOX-117: a record of another world's rival (a rest kept in one world and put back in the other): a preserve rival in the test garden, or a sill rival (or one of a
-- region this world has not) in the preserve. That rival is not here: this world's is a new one, yet to arrive.
function Rival.misplaced(r: any): boolean
 local _,region=Rival.arriveAt()
 if region==nil then return r.region~=nil end
 return not Station.contains(r.region)
end
-- The morning an hour of the clock belongs to: the hours before 07:00 are the night of the day before.
function Rival.morning(day: number,hour: number?): number
 return if (hour or Rules.arriveHour)>=Rules.arriveHour then day else day-1
end
-- Has it seen the spider coming (so that a strike is a contest and not a sure catch)?
function Rival.aware(r: any): boolean
 return r.state=="stalk" or r.state=="windup" or (r.state=="patrol" and r.notice>=Rules.awareNotice) or (r.state=="recover" and r.shaken==true)
end
-- The outcome of a contest, from a stream of its own so no other draw moves: "captured", "sprang" or "counter". It depends only on the world's seed,
-- the day and `n` (how many contests this rival has had, kept in its record), so a return to a rest brings back the same outcome for the same strike.
-- ROBLOX-91: `gentle` (Easy, Free play) keeps ROBLOX-73's odds (Rules.contestGentle), the standard rules ROBLOX-88's harder ones.
function Rival.contest(seed: number,day: number,n: number,gentle: boolean?): string
 local g=PreyRandom.new((seed*73856093+(day*1009+41)*19349663+n*83492791+12345)%2147483647)
 g:next();g:next()
 local u=g:next()
 local captured,sprang=Rules.contestCaptured,Rules.contestSprang
 if gentle==true then captured,sprang=Rules.contestGentle.captured,Rules.contestGentle.sprang end
 if u<captured then return "captured" end
 if u<captured+sprang then return "sprang" end
 return "counter"
end
-- The player has the caught rival subdued: it can now be eaten (stay still).
function Rival.subdue(r: any): boolean
 if r==nil or r.state~="captured" then return false end
 r.subdued=true;return true
end
-- The caught rival tore free of the fangs (ROBLOX-77): it is simply gone from them and recovers where it stands, with its day, its food and its
-- contest count as they were; not a contest and no new rival. ROBLOX-91: it is `shaken` while it recovers (see Rival.aware): the next strike at it is the contest
-- again, with the counter-bite, not a free re-catch that skips both.
function Rival.tearFree(r: any): boolean
 if r==nil or r.state~="captured" then return false end
 phase(r,"recover");r.notice=0;r.subdued=nil;r.shaken=true;return true
end
-- Held and still fighting the player's grip (a held rival with no `subdued`, as in an older record, is not).
function Rival.struggling(r: any): boolean
 return r~=nil and r.state=="captured" and r.subdued==false
end
-- The next rival, in the same table (the world holds this table): a fresh one that has not yet arrived.
function Rival.renew(r: any)
 r.region=nil -- (ROBLOX-117: Rival.new gives it again where this world has one)
 for k,v in Rival.new() do r[k]=v end
 r.day=nil
 r.hour=nil
 r.fate=nil
 r.subdued=nil
 r.shaken=nil
 r.camp=nil
end
-- Where the wasp may take it from (ROBLOX-70): nil unless it is on the sill, awake and free; never in the retreat. ROBLOX-94: `region` (the sill's unless given) is the
-- region it belongs to, whose retreats it keeps out of.
function Rival.target(r: any,region: string?): any
 if r==nil or not (r.state=="patrol" or r.state=="stalk" or r.state=="windup" or r.state=="recover") or WorldMap.inRetreat(r.position,region or r.region or WorldMap.HOME)~=nil then return nil end
 return {position=r.position,up=r.up or Vector3.yAxis,present=true}
end
-- The wasp has it: it hangs under the wasp and nothing else touches it.
function Rival.seize(r: any): boolean
 if r==nil or Rival.target(r)==nil then return false end
 phase(r,"taken");return true
end
-- The wasp has carried it off the sill: gone for today (food for no one), and a new one comes on a later morning like after an eaten one. `hour` (the clock's,
-- ROBLOX-91) says which morning it belongs to; without it the day's own.
function Rival.carried(r: any,day: number,hour: number?)
 r.state="consumed";r.elapsed=0;r.food=0;r.day=day;r.hour=hour;r.fate="taken by the wasp";r.shaken=nil
end
-- ROBLOX-94: `region` is the region the rival belongs to (the sill's unless given): where it may stand is that region's bounds, outside that region's retreats.
function Rival.valid(r: any,region: string?): boolean
 if r==nil then return true end
 if type(r)~="table" or not states[r.state] then return false end
 for _,k in {"elapsed","notice","food","patrol"} do
  local n=r[k];if type(n)~="number" or n~=n or n<0 or n==math.huge then return false end
 end
 if r.food>Rival.FOOD+1e-8 then return false end
 -- ROBLOX-69: where it stands. `up` (the face under it) and `leg` (patrol places visited) are missing in older records: they mean the floor and
 -- none. It is on the sill, never in the crack.
 if r.up~=nil then
  local u=r.up
  if (typeof(u)~="Vector3" and type(u)~="table") or type(u.X)~="number" or type(u.Y)~="number" or type(u.Z)~="number"
   or u.X~=u.X or u.Y~=u.Y or u.Z~=u.Z or math.abs(u.Magnitude-1)>.05 then return false end
 end
 if r.leg~=nil and (type(r.leg)~="number" or r.leg~=r.leg or r.leg<0 or r.leg>1e9 or r.leg%1~=0) then return false end
 if r.contests~=nil and (type(r.contests)~="number" or r.contests~=r.contests or r.contests<0 or r.contests>1e9 or r.contests%1~=0) then return false end
 if r.spared~=nil and type(r.spared)~="boolean" then return false end
 if r.subdued~=nil and type(r.subdued)~="boolean" then return false end
 if r.shaken~=nil and type(r.shaken)~="boolean" then return false end
 if r.camp~=nil and (type(r.camp)~="number" or r.camp~=r.camp or r.camp<0 or r.camp>1e4) then return false end -- (ROBLOX-106: the watch by the crack)
 if r.grips~=nil and (type(r.grips)~="number" or r.grips~=r.grips or r.grips<0 or r.grips>1e9 or r.grips%1~=0) then return false end
 if r.hour~=nil and (type(r.hour)~="number" or r.hour~=r.hour or r.hour<0 or r.hour>=24) then return false end
 if r.fate~=nil and r.fate~="eaten" and r.fate~="taken by the wasp" then return false end
 -- ROBLOX-117: `region` (optional: the preserve's rival roams the hut garden) names a region of 1 to 64 characters. One this world has not is another world's rival
 -- (Rival.misplaced: a new one comes); its place is not looked at here.
 if r.region~=nil and (type(r.region)~="string" or #r.region<1 or #r.region>64) then return false end
 if r.state=="patrol" or r.state=="stalk" or r.state=="windup" or r.state=="lunge" or r.state=="recover" then
  local p,id=r.position,region or r.region or WorldMap.HOME
  if WorldMap.region(id)~=nil and (not WorldMap.inBounds(p,id) or WorldMap.inRetreat(Vector3.new(p.X,p.Y,p.Z),id)~=nil) then return false end
 end
 if r.day~=nil and (type(r.day)~="number" or r.day~=r.day or r.day<0 or r.day==math.huge) then return false end
 -- (ROBLOX-119: within the preserve's precision limit, World/Preserve.LIMIT: its roam reaches the meadow's edge, 16 m from the sill; it was 1000 studs)
 for _,k in {"position","previous","heading","target","origin"} do
  local v=r[k];if typeof(v)~="Vector3" and type(v)~="table" then return false end
  if type(v.X)~="number" or type(v.Y)~="number" or type(v.Z)~="number" or type(v.Magnitude)~="number" or v.X~=v.X or v.Y~=v.Y or v.Z~=v.Z or v.Magnitude>Rival.FAR then return false end
 end
 return true
end
-- blocked(a,b) is the same opaque-world sight query as flies use. Player input is a snapshot of this fixed tick.
-- Returns an event and the amount swallowed; the caller owns food grants and end-of-life presentation. The strike's contest (ROBLOX-73) returns
-- "captured", "sprang" (it got clear) or "counter" (it bit back) with, for "counter", the energy that costs (0 in the gentle modes) in place of the amount
-- swallowed. `s.seed` is the world's seed (nil: 0).
function Rival.step(r: any,dt: number,s: any,blocked: (Vector3,Vector3)->any): (string,number)
 if dt<=0 or dt~=dt then return "",0 end
 if r.state~="captured" and r.state~="taken" and Rival.misplaced(r) then Rival.renew(r) end -- (ROBLOX-117: another world's rival is not here)
 dt=math.min(dt,.05);r.previous=r.position
 if r.state=="taken" then
  -- In the wasp's grip. If the wasp no longer holds it (a record returned to), it is gone: carried off.
  if s.taken then return "",0 end
  Rival.carried(r,s.day or 0,s.hour);return "taken",0
 end
 if r.state=="consumed" then
  if WorldMap.world()=="preserve" then
   r.elapsed+=dt
   local at=Station.ARRIVE
   -- A defeated rival stays defeated. A later replacement enters below the window,
   -- only after a quiet minute and out of sight, never on top of the player.
   if r.elapsed>=Station.REPLACE_SECONDS and (s.position-at).Magnitude>Rules.arriveDistance and blocked(s.position,at) then
    Rival.renew(r)
   else return "",0 end
  else
  -- An old record has no day: the day it is first seen eaten is the day it was eaten. A new rival comes on a later morning.
  if r.day==nil then r.day=s.day end
  -- (ROBLOX-91: by morning, not by the day counter: one eaten in the small hours belongs to the night before, and one eaten just before midnight still
  -- gives way at the next 07:00.)
  if Rival.morning(s.day,s.hour)>Rival.morning(r.day,r.hour or Rules.arriveHour) then Rival.renew(r) else return "",0 end
  end
 end
 if r.state=="captured" then
  r.position=s.position+s.heading*.4;r.heading=s.heading
  if r.subdued==false then return "struggling",0 end -- fighting the grip: nothing is eaten and no time passes toward it
  if not s.grounded or s.moving then return "paused",0 end
  local food=math.min(r.food,.14*dt);r.food=math.max(0,r.food-food)
  if r.food<=1e-8 then r.food=0;r.day=s.day;r.hour=s.hour;r.fate="eaten";phase(r,"consumed");return "eaten",food end
  return "feeding",food
 end
 if r.state=="dormant" then
  -- (`s.born` ROBLOX-91: the day before this generation began, and `s.meals` this generation's: the first day and first meal of a spiderling are protected too.)
  if WorldMap.world()~="preserve" and (s.day-(s.born or 0)<Rules.firstDay or s.meals<Rules.firstMeals or (s.hour or Rules.arriveHour)<Rules.arriveHour
   or (s.position-r.position).Magnitude<Rules.arriveDistance or s.resting or s.wasp or s.scene or s.courting) then return "",0 end
  phase(r,"patrol")
  if s.drive then r.leg=(s.day or 0)*5 end -- a different first place to patrol to each day
 end
 -- Never stack two attackers or pursue into the retreat. No hidden-target chase.
 -- (ROBLOX-91: and while the spider is courting or mating, so a lunge cannot land on a pair: the rival keeps away from them.)
 if s.safe or s.resting or s.wasp or s.scene or s.courting then
  if WorldMap.world()=="preserve" then
   if r.state~="patrol" then phase(r,"patrol") end
   r.elapsed+=dt;r.notice=0
  else phase(r,"recover");r.notice=0 end
  return "",0
 end
 r.elapsed+=dt
 local delta=s.position-r.position
 -- Driven by a RivalDrive (its own motor over the whole sill): what it sees is decided ten times a second, at any height; otherwise
 -- (the CLI's floor-only checks, Godot's rule) every tick and on the floor's level.
 local D=s.drive
 local visible
 if D then visible=D.sees else visible=delta.Magnitude<8 and math.abs(delta.Y)<1.5 and not blocked(r.position,s.position) end
 if not s.striking then r.spared=nil end
 if s.striking and not s.holding and r.state~="lunge" and not r.spared then
  local _,d=M.sweepClosest(s.previous,s.position,r.previous,r.position)
  if d<.65 and not blocked(s.position,r.position) then
   local outcome="captured"
   if Rival.aware(r) then
    outcome=Rival.contest(s.seed or 0,s.day or 0,r.contests or 0,s.gentle)
    r.contests=(r.contests or 0)+1
   end
   if outcome=="captured" then phase(r,"captured");r.subdued=false;return "captured",0 end
   -- It got away from this strike: it recovers, and the rest of the same strike cannot catch it (the next one, a recovering rival, can).
   phase(r,"recover");r.spared=true
   if outcome=="counter" then return "counter",if s.gentle then 0 else Rules.counterCost end
   return "sprang",0
  end
 end
 if r.state=="lunge" then
  local k=math.clamp(r.elapsed/.4,0,1)
  local next=r.origin:Lerp(r.target,k)+(if D then r.up or Vector3.yAxis else Vector3.yAxis)*(.35*4*k*(1-k))
  if blocked(r.position,next) then phase(r,"recover");return "missed",0 end
  r.position=next
  local _,d=M.sweepClosest(s.previous,s.position,r.previous,r.position)
  if d<.6 and not blocked(r.position,s.position) then
   phase(r,"recover");return if s.gentle then "touch" else "caught",0
  end
  if k>=1 then if not D then r.position=Vector3.new(r.position.X,.31,r.position.Z) end;phase(r,"recover") end
 elseif r.state=="windup" then
  if not visible or s.airborne or s.onLine then phase(r,"recover");return "missed",0 end
  if r.elapsed>=1 then
   r.origin=r.position
   if D then
    -- At the spider's own place, wherever that is; never at the crack.
    if WorldMap.inRetreat(s.position)~=nil then phase(r,"recover");return "missed",0 end
    r.target=s.position
   else r.target=Vector3.new(math.clamp(s.position.X,18,28),.31,math.clamp(s.position.Z,3,10.8)) end
   phase(r,"lunge")
  end
 elseif r.state=="recover" then
  if not D then r.position=Vector3.new(r.position.X,.31,r.position.Z) end
  if r.elapsed>=3 then phase(r,"patrol") end
 else
  -- (ROBLOX-106: `s.noticeScale`, the standard rules' cover factor, Life/Nature.cover: halved under a leaf and when still, doubled moving in the open; absent, 1)
  local rate=if type(s.noticeScale)=="number" then s.noticeScale else 1
  r.notice=if visible then math.min(1,r.notice+dt*rate) else math.max(0,r.notice-dt*2)
  if visible and r.notice>=Rules.stalkNotice then
   phase(r,"stalk")
   local flat=if D then delta else Vector3.new(delta.X,0,delta.Z)
   if not D and flat.Magnitude>.01 then r.heading=flat.Unit end
   if flat.Magnitude<(if D then Rules.reachWu else 2.5) and (not D or D.reach) then phase(r,"windup");return "warning",0 end
  elseif not visible and not (D and r.state=="stalk" and D.remember) then r.state="patrol" end
  if D then return "",0 end -- its legs are the drive's
  local next=r.position
  if r.state=="stalk" then next+=r.heading*dt*1.1
  elseif r.state=="patrol" then
   r.patrol+=dt
   r.heading=if math.floor(r.patrol/4)%2==0 then -Vector3.xAxis else Vector3.xAxis
   next+=r.heading*dt*.45
  end
  next=Vector3.new(math.clamp(next.X,18,28),.31,math.clamp(next.Z,3,10.8))
  if not blocked(r.position,next) then r.position=next end
 end
 return "",0
end
function Rival.percept(r: any): any
 if r.state=="dormant" or r.state=="captured" or r.state=="consumed" or r.state=="taken" then return nil end
 return {id="rival_spider",position=r.position,radius=.45,velocity=(r.position-r.previous)*60,maxCategory="movement"}
end
return Rival
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">WaspDirector</string>
            <string name="Source"><![CDATA[--!strict
-- WaspDirector: the black-and-yellow mud dauber's visits to the sill, without the engine. A port of the frozen
-- scripts/predator/wasp_director.gd and its actor scripts/predator/wasp.gd (LIFE round 4; LIFE-03 the first predator; LIFE-01 death can
-- be real and jarring, not sensationalized; spec 2 no threat spawning behind the player and no unexplained death; spec 8.3 search,
-- inspect, approach, strike, disengage). Every number is in Data/Wasp.
--
-- When. At most one visit a day in the Godot replay (some days only) and two in the game (every day from the second, one in the morning and
-- one in the afternoon; useGameRules, ROBLOX-75), in the warm part of the day, never on the first day, never before the spider has finished its
-- first meal, and never while it rests or moults in the crack. Whether a day has a visit, and when, follows from the world's seed and the day
-- alone, so a return to a checkpoint meets the same wasp (the port's own hash: Godot's cannot be reproduced in Luau, so the same seed
-- does not give the same days as Godot). What a day has had is kept as the day of the last visit and which of the day's visits it was.
--
-- Warned. The wasp is heard before it is near: it comes in over the window frame from outside for ARRIVE_S and does not search until it
-- is on the sill. When it lands the spider feels it. When it has seen the spider it turns toward it and comes to look (INSPECT_S at arm's
-- length) before it strikes.
--
-- Search by sight. It moves between authored places on the sill where a spider might be: it hovers and looks, and on open surfaces it may
-- land and walk, its antennae flicking. It knows nothing it has not seen. Each tick that it can see the spider (in range, a clear line,
-- not in the retreat) its notice grows, much faster when the spider moves than when it keeps still, and faster near than far. Out of
-- sight, notice fades. Full notice: it has found the spider.
--
-- Escapes. The silk-lined crack is safe. A jump, a drop on the line, or getting out of sight breaks its approach; then it is confused and
-- searches somewhere at least FAR_FROM_LOSS_WU away. Its strike is a short lunge at where the spider was: a spider that moves off quickly
-- is missed. After SEARCH_S of searching it gives up and flies away.
--
-- Caught. The wasp stings and the spider goes still; the wasp carries it up and away over the frame (`heldAt` is where the spider hangs).
-- The host presents that. The spider is paralysed by the sting, not killed (LIFE-03).
--
-- What is handed in. The director knows the world only through three functions (`ray`, `clear`, `inRetreat`), the spider only through the
-- Spider table of this tick and the life clock only through the Block table, so the plain Luau CLI replays it against Godot's goldens
-- (tests/wasp_reference.json, tools/export_wasp_reference.gd) on an analytic world, and the client gives it the real sill's casts.
-- Random draws come from `rng` (range, unit, int); the tests hand it a scripted one.
--
-- Gentle rules (the wasp touches the spider and leaves; Godot's round 5 modes): the flag is `gentle`; the game sets it for Easy and Free play (and never for the
-- standard rules). The sound is the host's (captions only; no audio assets).

local Data = require(script.Parent.Parent.Data.Wasp)
local PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)
local StationAir = require(script.Parent.Parent.World.StationAir)

local WaspDirector = {}
WaspDirector.__index = WaspDirector

-- ("taking", "seizing" and "bearing" are the game's wasp going for the rival male, ROBLOX-70: flying to it and hanging over it, the strike, carrying it off.)
WaspDirector.MAX_SLOTS = #Data.game.windows -- the most visits a day the record can hold (the game's windows: two)

WaspDirector.PHASES = table.freeze({ "away", "arriving", "searching", "inspecting", "striking", "carrying", "leaving", "taking", "seizing", "bearing" })

export type Rng = {
	range: (Rng, number, number) -> number, -- a number in [lo, hi)
	unit: (Rng) -> number, -- a number in [0, 1)
	int: (Rng, number, number) -> number, -- a whole number in [lo, hi]
}
-- What the director asks of the world. `ray`: something solid between two points. `clear`: a sphere of that radius goes from a to b
-- without touching the world. `inRetreat`: inside the silk-lined crack.
export type World = {
	ray: (Vector3, Vector3) -> boolean,
	clear: (Vector3, Vector3, number) -> boolean,
	inRetreat: (Vector3) -> boolean,
}
-- The spider this tick.
export type Spider = {
	position: Vector3,
	velocity: Vector3,
	walkSpeed: number,
	airborne: boolean, -- in a jump
	falling: boolean, -- let down on its line (or fallen)
	cover: number?, -- ROBLOX-106: the standard rules' factor on notice (Life/Nature.cover); nil: 1
}
-- The life this tick (Godot: the habitat loop and the feeding controller).
-- `rival`: the free rival male the wasp may take, if one is on the sill (RivalSpider.target): where it is and which way is up from it.
export type Block = { day: number, hour: number, resting: boolean, moulting: boolean, meals: number, born: number?, rival: { position: Vector3, up: Vector3, present: boolean }? }
export type Signal = { kind: string, [string]: any }

-- Godot's one window of the day (the game's two are Data.game.windows).
local ONE_WINDOW: { { number } } = { { Data.windowFromH, Data.windowToH } }

local UP = Vector3.new(0, 1, 0)
local DOWN = Vector3.new(0, -1, 0)
local FORWARD = Vector3.new(0, 0, -1)
local TAU = math.pi * 2

local function rotateY(v: Vector3, angle: number): Vector3
	local c, s = math.cos(angle), math.sin(angle)
	return Vector3.new(v.X * c + v.Z * s, v.Y, -v.X * s + v.Z * c)
end

local function pathLength(path: { Vector3 }): number
	local total = 0.0
	for i = 2, #path do total += (path[i - 1] - path[i]).Magnitude end
	return math.max(total, 1e-3)
end

-- The default random stream for a visit: the port's Park-Miller, mixed from the seed, the day and the visit.
local function makeStream(seed: number, a: number, b: number): Rng
	local r = PreyRandom.new((seed * 73856093 + a * 19349663 + b * 83492791 + 12345) % 2147483647)
	r:next()
	r:next()
	return {
		range = function(_, lo: number, hi: number): number return lo + (hi - lo) * r:next() end,
		unit = function(): number return r:next() end,
		int = function(_, lo: number, hi: number): number return lo + math.min(math.floor(r:next() * (hi - lo + 1)), hi - lo) end,
	} :: any
end

-- `config.seed`: the world's seed. `config.world`: the three functions. `config.enabled`: false and it never comes by itself (test worlds;
-- force still brings it). `config.makeRng(day, visit)`: the random stream of a visit (tests).
function WaspDirector.new(config: { seed: number, world: World, enabled: boolean?, makeRng: ((number, number) -> Rng)? }): any
	local self = setmetatable({
		world = config.world, enabled = config.enabled ~= false, seed = config.seed, makeRng = config.makeRng,
		-- The wasp as the spider's senses have it (wasp.gd).
		wasp = {
			position = Vector3.new(0, 0, 0), heading = FORWARD, velocity = Vector3.new(0, 0, 0), normal = UP,
			mode = "flying", search = 0.0, visible = false, prev = Vector3.new(0, 0, 0),
		},
		phase = "away", visitS = 0.0, phaseS = 0.0, searchLeft = 0.0, notice = 0.0, confusedS = 0.0,
		noticedThisVisit = false, sparedThisVisit = false, gentle = false, nature = false, lingers = false,
		lastVisitDay = 0, lastVisitSlot = 0, visits = 0, escapes = 0,
		events = {} :: { { kind: string, t: number } },
		signals = {} :: { Signal },
		-- Where the spider hangs while it is carried (nil otherwise); the host moves the spider there each tick.
		heldAt = nil :: Vector3?, holding = false,
		-- The rival male (ROBLOX-70): whether this visit is for it, whether it hangs under the wasp, and where.
		takeRival = false, holdingRival = false, rivalHeldAt = nil :: Vector3?, rivalNow = nil :: any, takeSub = "fly", takeOpen = Vector3.new(0, 0, 0),
		-- The visit in progress.
		points = Data.points, rng = nil :: Rng?, path = {} :: { Vector3 }, pathI = 1, speed = Data.flySpeed, point = 1, recent = {} :: { number },
		sub = "", subS = 0.0, walkDir = Vector3.new(0, 0, 0), stepS = 0.0, openPos = Vector3.new(0, 0, 0), lastSeen = Vector3.new(0, 0, 0),
		unseenS = 0.0, holdS = 0.0, lossPos = nil :: Vector3?, strikeFrom = Vector3.new(0, 0, 0), strikeTo = Vector3.new(0, 0, 0),
		dt = 1 / 60, spider = nil :: Spider?,
	}, WaspDirector)
	return self
end

-- The game's rules (Data/Wasp.game): two visits every day from the second, the longer search of ROBLOX-62 and the rival male's draw. A
-- director that is never given them replays Godot (one window, some days only, the original rates), which is what the goldens check.
function WaspDirector.useGameRules(self: any)
	local g = Data.game
	self.visitChance, self.searchScale, self.noticeScale, self.inspectScale = g.visitChance, g.searchScale, g.noticeScale, g.inspectScale
	self.rivalChance = g.takesRival
	self.windowList, self.minGapH = g.windows, g.minGapH
end

function WaspDirector.useStationRules(self: any): boolean
	if self.station then return false end
	self.station=StationAir;self.points=StationAir.points
	return true
end

function WaspDirector.isVisiting(self: any): boolean
	return self.phase ~= "away"
end

-- A resident's ordinary patrol is not a perpetual combat/modal lock.
function WaspDirector.isThreatening(self: any): boolean
	if not self.station then return self:isVisiting() end
	return self.phase=="inspecting" or self.phase=="striking" or self.phase=="carrying"
end

-- ---------------------------------------------------------------------------------------------------------------- when it comes

-- The windows of the day, as (from, to) hours of the life clock: Godot's one, the game's two.
function WaspDirector.windows(self: any): { { number } }
	return self.windowList or ONE_WINDOW
end

-- ROBLOX-106: the standard rules' wasp (Data.game.nature): the client sets `nature` when the rules are not gentle. A director without it is as it was.
function WaspDirector.natural(self: any): boolean
	return self.nature == true and not self.gentle
end

-- The windows of day `day`: the windows, each slid by its own draw of up to Data.game.nature.shiftH either way in the standard rules (ROBLOX-106).
function WaspDirector.dayWindows(self: any, day: number): { { number } }
	local windows = self:windows()
	if not self:natural() then return windows end
	local shift = Data.game.nature.shiftH
	local out: { { number } } = {}
	for slot, w in windows do
		local d = -shift + 2 * shift * PreyRandom.mixed(self.seed, day, slot, 47):next()
		out[slot] = { w[1] + d, w[2] + d }
	end
	return out
end

-- How long visit number `visit` of day `day` searches, as a share of the game's search (1 without the standard rules' draw; ROBLOX-106), and whether it lingers.
function WaspDirector.visitScale(self: any, day: number, visit: number): (number, boolean)
	if not self:natural() then return 1.0, false end
	local n = Data.game.nature
	local r = PreyRandom.mixed(self.seed, day, visit, 53)
	if r:next() < n.lingerChance then return r:draw(n.linger), true end
	return r:draw(n.visit), false
end

-- Whether each of day `day`'s visits happens, and at what hour: one number for each window, -1 when that visit has none. From the seed, the day
-- and the visit's place in the day alone (the first visit's stream is the one the Godot replay uses). A visit's hour is in the first part of
-- its window, up to an hour before the window's end, and not before `minGapH` after the visit before it.
function WaspDirector.plannedHours(self: any, day: number): { number }
	local hours: { number } = {}
	local previous = -math.huge
	for slot, window in self:dayWindows(day) do
		local hour = -1.0
		if day >= Data.firstDay then
			local r = makeStream(self.seed, day, 6 + slot)
			if r:unit() < (self.visitChance or Data.visitChance) then
				local from = math.max(window[1], previous + (self.minGapH or 0.0))
				hour = r:range(from, math.max(window[2] - 1.0, from))
				previous = hour
			end
		end
		hours[slot] = hour
	end
	return hours
end

-- Whether day `day` has a visit, and at what hour: -1 when it has none. The day's first visit (the only one in the Godot replay).
function WaspDirector.plannedHour(self: any, day: number): number
	return self:plannedHours(day)[1]
end

-- Why a visit could not begin now ("" when it could), apart from the hour.
function WaspDirector.blocked(_self: any, block: Block): string
	-- (ROBLOX-91: `born` is the day before the family's generation began, 0 for the first, and `meals` its own count: a spiderling of the next generation has its first day and
	-- first meal protected like a new life, whatever the sill's day counter and the meals of the last family say.)
	if block.day - (block.born or 0) < Data.firstDay then return "the first day" end
	if block.meals < 1 then return "no meal yet" end
	if block.resting or block.moulting then return "resting" end
	return ""
end

-- Begins the day's next visit if its hour has come: the first of the day's visits not yet had whose window the hour is in, from its planned
-- hour to the window's end, and nothing blocks it. A visit whose window passed unused (a rest through all of it) is simply skipped.
function WaspDirector._maybeBegin(self: any, block: Block)
	if self.station then self:beginVisit(block.day,1);return end
	local day = block.day
	local windows = self:dayWindows(day)
	local done = if day == self.lastVisitDay then self.lastVisitSlot else 0
	if done >= #windows then return end
	local hours = self:plannedHours(day)
	for slot = done + 1, #windows do
		local hour = hours[slot]
		if hour >= 0.0 and block.hour >= hour and block.hour < windows[slot][2] then
			if self:blocked(block) == "" then self:beginVisit(day, nil, slot) end
			return
		end
	end
end

-- The index of the search place with this id, nil when there is none.
function WaspDirector.pointIndex(id: string): number?
	for i, p in Data.points do
		if p.id == id then return i end
	end
	return nil
end

-- Brings the wasp now (tests, the test place's attribute). `at`: the id of the place it searches first (nil lets the visit choose). False
-- when it is already here. It uses up the day's next visit.
function WaspDirector.force(self: any, day: number, at: string?): boolean
	if self.phase ~= "away" then return false end
	local first=nil
	if at then for i,point in self.points do if point.id==at then first=i;break end end end
	self:beginVisit(day, first)
	return true
end

-- `slot`: which of the day's visits this is (nil: the next one not yet had that day, the last when all were).
function WaspDirector.beginVisit(self: any, day: number, first: number?, slot: number?)
	local done = if day == self.lastVisitDay then self.lastVisitSlot else 0
	self.lastVisitDay = day
	self.lastVisitSlot = slot or math.min(done + 1, #self:windows())
	self.visits += 1
	self.rng = if self.makeRng then self.makeRng(day, self.visits) else makeStream(self.seed, day * 1009 + 13, self.visits)
	self.events = {}
	self.visitS = 0.0
	self.notice = 0.0
	self.confusedS = 0.0
	self.noticedThisVisit = false
	self.sparedThisVisit = false
	local scale, lingers = self:visitScale(day, self.visits)
	self.lingers = lingers
	self.searchLeft = Data.searchS * (self.searchScale or 1) * scale
	self.recent = {}
	self.lossPos = nil
	self.holding = false
	self.heldAt = nil
	self.holdingRival, self.rivalHeldAt = false, nil
	-- Whether this visit is for the rival male (the game's wasp only): a draw from a stream of its own, so the other draws are as before.
	self.takeRival = self.rivalChance ~= nil and makeStream(self.seed, day * 1009 + 29, self.visits):unit() < self.rivalChance
	self.point = first or self.rng:int(1, #self.points)
	local to: Vector3 = self.points[self.point].hover
	self.path = { Data.entry, Data.over, Vector3.new(to.X, Data.cruiseY, to.Z), to }
	if self.station then
		self.takeRival=false
		self.path=self.station.route(self.station.entry,to)
	end
	self.pathI = 2
	self.speed = pathLength(self.path) / Data.arriveS
	self:_place(if self.station then self.station.entry else Data.entry)
	self.wasp.mode = "flying"
	self.wasp.search = 0.0
	self.wasp.visible = true
	self:_setPhase("arriving")
	self:_log("warning")
	self:_signal({ kind = "visit_started", first = self.visits == 1, point = self.points[self.point].id })
end

-- ---------------------------------------------------------------------------------------------------------------- the tick

-- One fixed tick, after the spider has moved. `spider`: this tick's spider; `block`: this tick's life. Nothing is read from the spider
-- while the wasp is away.
function WaspDirector.step(self: any, dt: number, spider: Spider, block: Block)
	self.dt = dt
	self.spider = spider
	self.rivalNow = block.rival
	self.protected=self.station~=nil and (block.resting or block.moulting)
	local phase: string = self.phase
	if phase == "away" then
		if self.enabled then self:_maybeBegin(block) end
		return
	end
	self.visitS += dt
	self.phaseS += dt
	if phase == "arriving" then
		if self:_advance(dt) and (not self.station or self.phaseS>=Data.arriveS) then
			self.openPos = self.wasp.position
			if self.takeRival and self:_beginTaking() then return end
			self:_setPhase("searching")
			self:_log("searching")
			self.sub = "hover"
			self.subS = self.rng:range(Data.hoverS[1], Data.hoverS[2])
		end
	elseif phase == "searching" then
		self.searchLeft -= dt
		self:_search(dt)
		self:_look(dt)
		if self.notice >= 1.0 then
			self:_beginInspecting()
		elseif self.searchLeft <= 0.0 and (self.sub == "hover" or self.sub == "fly") then
			self:_beginLeaving()
		end
	elseif phase == "inspecting" then
		self:_inspect(dt)
	elseif phase == "striking" then
		self:_strike(dt)
	elseif phase == "carrying" then
		local done = self:_advance(dt)
		self:_holdSpider()
		if done then
			self:_setPhase("away")
			self.wasp.visible = false
			self:_signal({ kind = "carried_off" })
		end
	elseif phase == "taking" then
		self:_take(dt)
	elseif phase == "seizing" then
		self:_seize(dt)
	elseif phase == "bearing" then
		local done = self:_advance(dt)
		self:_holdRival()
		if done then
			self:_setPhase(if self.station then "searching" else "away")
			self.wasp.visible = self.station~=nil
			self.holdingRival, self.rivalHeldAt, self.takeRival = false, nil, false
			self:_signal({ kind = "rival_carried_off" })
			if self.station then self:_beginLeaving() end
		end
	elseif phase == "leaving" then
		if self:_advance(dt) then
			self.wasp.visible = false
			self:_setPhase("away")
			if self.noticedThisVisit then self.escapes += 1 end
			self:_log("left")
			self:_signal({ kind = "left", escaped = self.noticedThisVisit })
		end
	end
end

-- ---------------------------------------------------------------------------------------------------------------- searching

function WaspDirector._search(self: any, dt: number)
	local wasp = self.wasp
	local sub: string = self.sub
	if sub == "fly" then
		wasp.search = 0.3
		if self:_advance(dt) then
			self.openPos = wasp.position
			self.sub = "hover"
			self.subS = self.rng:range(Data.hoverS[1], Data.hoverS[2])
		end
	elseif sub == "hover" then
		wasp.mode = "flying"
		wasp.search = 0.8
		self:_moveTo(wasp.position, rotateY(wasp.heading, math.rad(Data.scanDegS) * dt), dt)
		self.subS -= dt
		if self.subS <= 0.0 then
			local p = self.points[self.point]
			if p.land ~= nil and self.rng:unit() < Data.landChance and self.searchLeft > Data.landS + Data.walkS then
				self.sub = "land"
				self.path = { wasp.position, p.land }
				self.pathI = 2
				self.speed = (wasp.position - p.land).Magnitude / Data.landS
			else
				self:_nextPoint()
			end
		end
	elseif sub == "land" then
		if self:_advance(dt) then
			wasp.mode = "walking"
			wasp.normal = UP
			self.openPos = wasp.position
			self:_shake("heavy landing")
			self:_log("landed")
			self:_signal({ kind = "landed", at = wasp.position })
			self.sub = "walk"
			self.subS = Data.walkS
			self.stepS = Data.stepEveryS
			self.walkDir = rotateY(FORWARD, self.rng:range(0.0, TAU))
		end
	elseif sub == "walk" then
		wasp.search = 1.0
		self:_walk(dt)
		self.subS -= dt
		if self.subS <= 0.0 then
			self.sub = "takeoff"
			local up = wasp.position + UP * 1.2
			self.path = { wasp.position, up }
			self.pathI = 2
			self.speed = Data.flySpeed * 0.5
			wasp.mode = "flying"
		end
	elseif sub == "takeoff" then
		if self:_advance(dt) then
			self.openPos = wasp.position
			self:_nextPoint()
		end
	end
end

-- A few steps along the surface it stands on, turning back where it would step off.
function WaspDirector._walk(self: any, dt: number)
	local wasp = self.wasp
	local p: Vector3 = wasp.position
	local nxt = p + self.walkDir * Data.walkSpeed * dt
	if not self.world.ray(nxt + UP * 0.3, nxt + DOWN * 0.8) or not self:_clear(p, nxt, Data.walkRadius) then
		self.walkDir = -self.walkDir
		nxt = p
	end
	self:_moveTo(nxt, self.walkDir, dt)
	self.stepS -= dt
	if self.stepS <= 0.0 then
		self.stepS = Data.stepEveryS
		self:_shake("heavy footsteps")
	end
end

function WaspDirector._nextPoint(self: any)
	if self.station then
		-- A complete circuit through both rooms, rather than repeatedly choosing
		-- the nearest few sites. Unreachable authored sites are skipped, never
		-- reached by teleporting through their support or a wall.
		for _=1,#self.points do
			self.point=self.point%#self.points+1
			local path=self.station.route(self.wasp.position,self.points[self.point].hover)
			if #path>1 then
				self.path=path;self.pathI=2;self.speed=12;self.sub="fly";return
			end
		end
		self.sub="hover";self.subS=2;return
	end
	table.insert(self.recent, self.point)
	while #self.recent > 3 do table.remove(self.recent, 1) end
	local here: Vector3 = self.wasp.position
	local choices: { number } = {}
	for i, pt in self.points do
		if table.find(self.recent, i) then continue end
		local hover: Vector3 = pt.hover
		local loss: Vector3? = self.lossPos
		if loss ~= nil and (hover - loss).Magnitude < Data.farFromLossWu then continue end
		table.insert(choices, i)
	end
	if #choices == 0 then table.insert(choices, (self.point % #self.points) + 1) end
	-- A local search: the nearer half of the places it has not just looked at.
	table.sort(choices, function(a: number, b: number): boolean
		return (here - self.points[a].hover).Magnitude < (here - self.points[b].hover).Magnitude
	end)
	local count = math.max(1, (#choices + 1) // 2)
	self.point = choices[self.rng:int(1, count)]
	self:_flyTo(self.points[self.point].hover, Data.flySpeed)
	self.sub = "fly"
end

-- ---------------------------------------------------------------------------------------------------------------- seeing the spider

-- Whether it can see the spider now: in range, nothing in the way, and not in the retreat.
function WaspDirector.canSeeSpider(self: any): boolean
	local s: Spider? = self.spider
	if s == nil or self.holding or not self.wasp.visible then return false end
	if self.protected then return false end
	if self.world.inRetreat(s.position) then return false end
	local eye = self:eyePosition()
	if (eye - s.position).Magnitude > Data.sightWu then return false end
	return not self.world.ray(eye, s.position)
end

function WaspDirector.eyePosition(self: any): Vector3
	return self.wasp.position + self.wasp.heading * Data.eyeAhead
end

-- How fast notice grows now (per second) if it can see the spider.
function WaspDirector.noticeRate(self: any): number
	local s: Spider = self.spider
	local d = (self:eyePosition() - s.position).Magnitude
	local walk = math.max(s.walkSpeed, 0.1)
	local motion = math.clamp(s.velocity.Magnitude / walk, 0.0, 1.5)
	if s.airborne then motion = 1.5 end
	-- (ROBLOX-106: `cover`, the standard rules' cover factor the client hands in with the spider, Life/Nature.cover; absent, 1, as Godot's)
	local cover = if self:natural() and type(s.cover) == "number" then s.cover else 1
	return (self.noticeScale or 1) * cover * (Data.noticeStill + Data.noticeMoving * motion) * math.max(1.0 - d / Data.sightWu, 0.0)
end

function WaspDirector._look(self: any, dt: number)
	if self.confusedS > 0.0 then
		self.confusedS -= dt
		return
	end
	if self:canSeeSpider() then
		self.notice += self:noticeRate() * dt
		self.lastSeen = (self.spider :: Spider).position
	else
		self.notice = math.max(self.notice - Data.noticeDecay * dt, 0.0)
	end
end

function WaspDirector._beginInspecting(self: any)
	self.notice = 1.0
	self.noticedThisVisit = true
	self.unseenS = 0.0
	self.holdS = 0.0
	if self.wasp.mode == "walking" then self.wasp.mode = "flying" end
	self:_setPhase("inspecting")
	self:_log("noticed")
	self:_signal({ kind = "noticed", at = self.lastSeen })
end

-- Comes to look: to arm's length from where it last saw the spider, then holds there, antennae busy, for INSPECT_S, then strikes. A
-- jump, a drop, the retreat, or the spider out of sight for LOSE_UNSEEN_S, and it has lost it.
function WaspDirector._inspect(self: any, dt: number)
	local s: Spider = self.spider
	local wasp = self.wasp
	wasp.mode = "flying"
	wasp.search = 1.0
	if self.world.inRetreat(s.position) then
		self:_lose("hid")
		return
	end
	if s.airborne then
		self:_lose("jumped")
		return
	end
	if s.falling then
		self:_lose("dropped")
		return
	end
	if self:canSeeSpider() then
		self.unseenS = 0.0
		self.lastSeen = s.position
	else
		self.unseenS += dt
		if self.unseenS > Data.loseUnseenS then
			self:_lose("out of sight")
			return
		end
	end
	if self.phaseS > Data.inspectGiveUpS then
		self:_lose("out of reach")
		return
	end
	local away: Vector3 = wasp.position - self.lastSeen
	if away.Magnitude < 1e-3 then away = UP end
	local standoff = self.lastSeen + away.Unit * Data.standoffWu
	local to = standoff - wasp.position
	local step = Data.inspectSpeed * dt
	local face = self.lastSeen - wasp.position
	if to.Magnitude > 0.05 then
		local nxt = wasp.position + (if to.Magnitude > step then to.Unit * step else to)
		if self:_clear(wasp.position, nxt, Data.radius) then
			self:_moveTo(nxt, face, dt)
		else
			self:_moveTo(wasp.position, face, dt)
		end
		self.holdS = math.max(self.holdS - dt, 0.0)
	else
		self:_moveTo(wasp.position, face, dt)
		self.holdS += dt
		if self.holdS >= Data.inspectS * (self.inspectScale or 1) then
			self.strikeFrom = wasp.position
			self.strikeTo = s.position
			self:_setPhase("striking")
			self:_log("strike")
		end
	end
end

function WaspDirector._strike(self: any, dt: number)
	local k = math.clamp(self.phaseS / Data.strikeS, 0.0, 1.0)
	local nextPos=self.strikeFrom:Lerp(self.strikeTo,k)
	if self.station and (self.protected or not self:_clear(self.wasp.position,nextPos,Data.radius)) then self:_lose("blocked");return end
	self:_moveTo(nextPos, self.strikeTo - self.strikeFrom, dt)
	if k < 1.0 then return end
	local s: Spider = self.spider
	if (self.wasp.position - s.position).Magnitude <= Data.catchWu and not self.world.inRetreat(s.position) and not s.airborne then
		if self.gentle then self:_spare() else self:_catch() end
	else
		self:_lose("missed")
	end
end

-- Gentle rules (Godot round 5: Easy and free play): the wasp touches the spider with its antennae and gives up on it, and leaves. The game sets `gentle`
-- for Easy and Free play.
function WaspDirector._spare(self: any)
	self.sparedThisVisit = true
	self:_log("spared")
	self:_signal({ kind = "lost", why = "spared" })
	self:_beginLeaving()
end

function WaspDirector._catch(self: any)
	local wasp = self.wasp
	self.holding = true
	wasp.mode = "holding"
	wasp.search = 0.0
	local p: Vector3 = wasp.position
	self.path = { p, p + UP * 2.5, Data.over }
	if self.station then self.path=self.station.route(p,self.station.entry) end
	self.pathI = 2
	self.speed = pathLength(self.path) / Data.carryS
	self:_setPhase("carrying")
	self:_log("caught")
	self:_holdSpider()
	self:_signal({ kind = "caught" })
end

function WaspDirector._holdSpider(self: any)
	if self.holding then self.heldAt = self.wasp.position + DOWN * Data.holdBelow end
end

function WaspDirector._lose(self: any, why: string)
	self.lossPos = self.lastSeen
	self.notice = Data.afterLossNotice
	self.confusedS = Data.confuseS
	self:_setPhase("searching")
	self:_log("lost:" .. why)
	self:_signal({ kind = "lost", why = why })
	self:_nextPoint()
end

function WaspDirector._beginLeaving(self: any)
	if self.station then
		-- It abandons this hunt, not its home. The recovery/confusion interval
		-- still gives the spider time to get clear before the next patrol leg.
		if self.noticedThisVisit then self.escapes+=1 end
		self.noticedThisVisit=false;self.notice=0;self.confusedS=Data.confuseS
		self.searchLeft=Data.searchS*(self.searchScale or 1)
		self:_setPhase("searching");self:_nextPoint()
		if self.rivalChance and self.rng:unit()<self.rivalChance then self:_beginTaking() end
		return
	end
	local p: Vector3 = self.wasp.position
	local path = self:_route(p, Data.over)
	table.insert(path, Data.entry)
	self.path = path
	self.pathI = 2
	self.speed = pathLength(path) / Data.leaveS
	self.wasp.mode = "flying"
	self.wasp.search = 0.0
	self:_setPhase("leaving")
	self:_log("leaving")
end

-- ---------------------------------------------------------------------------------------------------------------- the rival male (ROBLOX-70)

-- Sets off for the rival, if there is a free one on the sill out of the retreat and a way to hang over it: true, and the visit is for the rival
-- (it does not look for the spider, and the spider is spared that day). False: the visit goes on as any other.
function WaspDirector._beginTaking(self: any): boolean
	local r = self.rivalNow
	if r == nil or not r.present or self.world.inRetreat(r.position) then return false end
	local D = Data.rival
	local top: Vector3 = r.position + r.up * D.aboveWu
	local low: Vector3 = r.position + r.up * 0.5
	for _, off in D.offsets do
		local c = top + Vector3.new(off[1], 0, off[2])
		local sky = Vector3.new(c.X, math.max(Data.cruiseY, c.Y), c.Z)
		if not self.world.inRetreat(c) and self:_clear(sky, c, Data.radius) and self:_clear(c, low, D.clearRadius) then
			self.path = self:_route(self.wasp.position, c)
			self.pathI = 2
			self.speed = D.flySpeed
			self.takeSub = "fly"
			self.takeOpen = c
			self.wasp.mode = "flying"
			self.wasp.search = 0.0
			self:_setPhase("taking")
			self:_log("taking")
			return true
		end
	end
	return false
end

-- The rival is gone (the spider caught it, say) before the wasp has it: the visit goes on as a search.
function WaspDirector._abortTaking(self: any)
	self.takeRival = false
	self.openPos = self.takeOpen
	self.wasp.mode = "flying"
	self:_setPhase("searching")
	self:_log("rival gone")
	self:_nextPoint()
end

function WaspDirector._take(self: any, dt: number)
	local r = self.rivalNow
	if r == nil or not r.present then
		self:_abortTaking()
		return
	end
	if self.takeSub == "fly" then
		if self:_advance(dt) then
			self.takeSub = "hover"
			self.subS = Data.rival.hoverS
		end
		return
	end
	local wasp = self.wasp
	self:_moveTo(wasp.position, r.position - wasp.position, dt)
	self.subS -= dt
	if self.subS <= 0.0 then
		self.strikeFrom = wasp.position
		self.strikeTo = r.position + r.up * 0.2
		self:_setPhase("seizing")
		self:_log("seize")
	end
end

function WaspDirector._seize(self: any, dt: number)
	local r = self.rivalNow
	if r == nil or not r.present then
		self:_abortTaking()
		return
	end
	local k = math.clamp(self.phaseS / Data.rival.strikeS, 0.0, 1.0)
	self:_moveTo(self.strikeFrom:Lerp(self.strikeTo, k), self.strikeTo - self.strikeFrom, dt)
	if k < 1.0 then return end
	local wasp = self.wasp
	if (wasp.position - r.position).Magnitude > Data.rival.catchWu then
		self:_abortTaking()
		return
	end
	self.holdingRival = true
	wasp.mode = "holding"
	wasp.search = 0.0
	local p: Vector3 = wasp.position
	self.path = { p, p + UP * 2.5, Data.over }
	self.pathI = 2
	self.speed = pathLength(self.path) / Data.carryS
	if self.station then
		self.path=self.station.route(p,self.station.entry)
		self.speed=pathLength(self.path)/Data.carryS
	end
	self:_setPhase("bearing")
	self:_log("seized")
	self:_holdRival()
	self:_signal({ kind = "rival_seized", at = p })
end

function WaspDirector._holdRival(self: any)
	if self.holdingRival then self.rivalHeldAt = self.wasp.position + DOWN * Data.holdBelow end
end

-- ---------------------------------------------------------------------------------------------------------------- paths and the world

function WaspDirector._flyTo(self: any, to: Vector3, speed: number)
	self.path = self:_route(self.wasp.position, to)
	self.pathI = 2
	self.speed = speed
end

-- Up to cruising height (from somewhere open above it), across, and down to `to`.
function WaspDirector._route(self: any, from: Vector3, to: Vector3): { Vector3 }
	if self.station then return self.station.route(from,to) end
	local path: { Vector3 } = { from }
	local start = from
	if from.Y < Data.cruiseY and not self:_clear(from, Vector3.new(from.X, Data.cruiseY, from.Z), Data.radius) then
		table.insert(path, self.openPos)
		start = self.openPos
	end
	if start.Y < Data.cruiseY then table.insert(path, Vector3.new(start.X, Data.cruiseY, start.Z)) end
	if to.Y < Data.cruiseY then table.insert(path, Vector3.new(to.X, Data.cruiseY, to.Z)) end
	table.insert(path, to)
	return path
end

-- Moves along the path at the current speed; true at its end.
function WaspDirector._advance(self: any, dt: number): boolean
	local wasp = self.wasp
	local p: Vector3 = wasp.position
	local left = self.speed * dt
	local path: { Vector3 } = self.path
	while self.pathI <= #path and left > 0.0 do
		local target = path[self.pathI]
		local d = (target - p).Magnitude
		if d <= left then
			p = target
			left -= d
			self.pathI += 1
		else
			p += (target - p) / d * left
			left = 0.0
		end
	end
	local dir = p - wasp.position
	if self.station and not self:_clear(wasp.position,p,Data.radius) then
		self.pathI=#path+1;p=wasp.position;dir=Vector3.zero
	end
	self:_moveTo(p, if dir.Magnitude > 1e-5 then dir else wasp.heading, self.dt)
	return self.pathI > #path
end

-- True when a sphere of `radius` moves from `a` to `b` without touching the world.
function WaspDirector._clear(self: any, a: Vector3, b: Vector3, radius: number): boolean
	if (a - b).Magnitude < 1e-5 then return true end
	return self.world.clear(a, b, radius)
end

-- ---------------------------------------------------------------------------------------------------------------- the actor (wasp.gd)

-- Places it and faces it along `dir` (flattened), and works out its velocity from where it was.
function WaspDirector._moveTo(self: any, p: Vector3, dir: Vector3, dt: number)
	local wasp = self.wasp
	wasp.position = p
	wasp.velocity = if dt > 0.0 then (p - wasp.prev) / dt else Vector3.new(0, 0, 0)
	wasp.prev = p
	local flat = Vector3.new(dir.X, 0.0, dir.Z)
	if flat.Magnitude > 1e-4 then wasp.heading = flat.Unit end
end

-- Puts it somewhere without a velocity (its first appearance).
function WaspDirector._place(self: any, p: Vector3)
	self.wasp.position = p
	self.wasp.prev = p
	self.wasp.velocity = Vector3.new(0, 0, 0)
end

-- What the spider's senses get of it: movement, never prey (its percept is capped at movement, so no aim, capture or inspection ever
-- treats it as something to catch). Nil while it is away.
function WaspDirector.percept(self: any): any
	local w = self.wasp
	if not w.visible then return nil end
	return { id = "wasp", position = w.position, radius = Data.sensedRadius, velocity = w.velocity, maxCategory = "movement" }
end

function WaspDirector._shake(self: any, kind: string)
	self:_signal({ kind = "shake", shake = kind, at = self.wasp.position + DOWN * 0.35 })
end

function WaspDirector._setPhase(self: any, p: string)
	self.phase = p
	self.phaseS = 0.0
end

function WaspDirector._log(self: any, kind: string)
	table.insert(self.events, { kind = kind, t = self.visitS })
end

function WaspDirector._signal(self: any, s: Signal)
	table.insert(self.signals, s)
end

-- The signals since the last call, oldest first: visit_started, shake (a landing or a footstep), landed, noticed, lost, caught,
-- carried_off, left.
function WaspDirector.drainSignals(self: any): { Signal }
	local out = self.signals
	self.signals = {}
	return out
end

-- ---------------------------------------------------------------------------------------------------------------- checkpoints

-- Kept in checkpoints: the day of the last visit, which of that day's visits it was, and how many visits and escapes this life has had. A
-- visit going on is not kept, because the spider rests in the crack where the wasp cannot find it. A return to a rest therefore meets the
-- day's remaining visits and never a repeat of the ones had (their hours come from the seed and the day, so nothing is drawn again).
function WaspDirector.toRecord(self: any): { [string]: number }
	return { last_visit_day = self.lastVisitDay, last_visit_slot = self.lastVisitSlot, visits = self.visits, escapes = self.escapes }
end

-- The record of a life the wasp has not yet visited.
function WaspDirector.defaultRecord(): { [string]: number }
	return { last_visit_day = 0, last_visit_slot = 0, visits = 0, escapes = 0 }
end

-- Puts a record back and ends any visit going on (the wasp is away and the spider is no longer held).
function WaspDirector.load(self: any, d: any)
	self.lastVisitDay = math.floor(tonumber(d.last_visit_day) or 0)
	-- A record from before there were two visits a day does not say which one it was: it counts as the day's last, so no visit is repeated.
	self.lastVisitSlot = if type(d.last_visit_slot) == "number" then math.floor(d.last_visit_slot) else (if self.lastVisitDay > 0 then WaspDirector.MAX_SLOTS else 0)
	self.visits = math.floor(tonumber(d.visits) or 0)
	self.escapes = math.floor(tonumber(d.escapes) or 0)
	self:clearVisit()
end

-- Ends the visit, if any: away, hidden, nothing held. (A return to a rest, a new life.)
function WaspDirector.clearVisit(self: any)
	self.phase = "away"
	self.phaseS = 0.0
	self.visitS = 0.0
	self.notice = 0.0
	self.confusedS = 0.0
	self.holding = false
	self.heldAt = nil
	self.holdingRival, self.rivalHeldAt, self.takeRival = false, nil, false
	self.wasp.visible = false
	self.signals = {}
	self.events = {}
end

function WaspDirector.problems(d: any): { string }
	local out: { string } = {}
	if type(d) ~= "table" then
		table.insert(out, "wasp: not a record")
		return out
	end
	for _, key in { "last_visit_day", "visits", "escapes" } do
		local v = d[key]
		if type(v) ~= "number" or v ~= v or v < 0 or v ~= math.floor(v) then
			table.insert(out, `wasp: {key} must be a whole number, not negative`)
		end
	end
	local slot = d.last_visit_slot -- optional: a record from before two visits a day has none
	if slot ~= nil and (type(slot) ~= "number" or slot ~= math.floor(slot) or slot < 0 or slot > WaspDirector.MAX_SLOTS) then
		table.insert(out, `wasp: last_visit_slot must be a whole number from 0 to {WaspDirector.MAX_SLOTS}`)
	end
	if #out == 0 and d.escapes > d.visits then table.insert(out, "wasp: more escapes than visits") end
	return out
end

return WaspDirector
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="106">
        <Properties>
          <string name="Name">Prey</string>
        </Properties>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">Ant</string>
            <string name="Source"><![CDATA[--!strict
-- Ants (ROBLOX-119, the meadow's edge): ambient, not food. Small brown field ants of a hill in the meadow (World/Meadow.HILL, meadow_b4), out on its floor by day on a
-- seeded wander that keeps within `range` of the hill and turns back to it now and then, and in their nest from dusk to morning (not drawn). They pay the spider no heed.
-- Jumping spiders leave ants alone, and the ant-mimicking spider's page says why; here a strike at one is refused (Prey/PreyWorld, UI/PreyText) and it runs on. Pure and
-- seeded, no raycast; a checkpoint records the colony with the region's prey (Persistence/Checkpoint). The speeds and the sizes are the game's.
local R = require(script.Parent.PreyRandom)

local Ants = {}
Ants.__index = Ants

Ants.HOVER = 0.12 -- the body's middle over the floor: low on its legs
Ants.BODY = 0.4 -- studs long: an ant of about 4 mm
Ants.RADIUS = 0.2
Ants.WALK = { 1.6, 2.6 } -- studs a second: brisk
Ants.EDGE = 1.5
Ants.NIGHT = { from = 19.5, to = 7.5 } -- in the nest

-- `spec`: World/Meadow.ambient's (kind "ant", `home` the hill's way in, `range` round the hill's `centre`); `count`: the tier's; `soil` and `boxes` as the woodlice's.
function Ants.new(spec: any, count: number, soil: { min: Vector3, max: Vector3 }?, boxes: { { min: Vector3, max: Vector3 } }?): any
	local self: any = setmetatable({ kind = "ant", rng = R.new(spec.seed + 6007), now = 0, items = {}, boxes = {}, home = spec.home, centre = spec.centre or spec.home, range = spec.range or 40 }, Ants)
	if soil ~= nil then self.soilMin, self.soilMax, self.top = soil.min, soil.max, soil.max.Y else self.top = spec.home.Y end
	for _, b in (boxes or {}) :: { any } do table.insert(self.boxes, { min = b.min, max = b.max }) end
	for i, s in spec.starts do
		if i > count then break end
		local surf = Vector3.new(s.pos.X, self.top, s.pos.Z)
		local pos = surf + Vector3.yAxis * Ants.HOVER
		table.insert(self.items, {
			id = (spec.prefix or "") .. "ant_" .. i, kind = "ant", surface = surf, position = pos, prevPosition = pos, normal = Vector3.yAxis, heading = s.heading,
			speed = self.rng:draw(Ants.WALK), state = "walk", until_ = 0, nextTurn = self.rng:draw({ 0.4, 1.4 }), hidden = false,
		})
	end
	return self
end

-- Whether a point of the floor is free to walk: on the soil, within its range of the hill, clear of what stands there.
function Ants.free(self: any, p: Vector3): boolean
	if self.soilMin ~= nil and (p.X < self.soilMin.X + Ants.EDGE or p.X > self.soilMax.X - Ants.EDGE or p.Z < self.soilMin.Z + Ants.EDGE or p.Z > self.soilMax.Z - Ants.EDGE) then return false end
	if (Vector3.new(p.X - self.centre.X, 0, p.Z - self.centre.Z)).Magnitude > self.range then return false end
	for _, b in self.boxes do
		if p.X > b.min.X - 0.4 and p.X < b.max.X + 0.4 and p.Z > b.min.Z - 0.4 and p.Z < b.max.Z + 0.4 then return false end
	end
	return true
end

local function turned(h: Vector3, degrees: number): Vector3
	return CFrame.fromAxisAngle(Vector3.yAxis, math.rad(degrees)):VectorToWorldSpace(h).Unit
end
local function night(hour: number?): boolean
	return hour ~= nil and (hour >= Ants.NIGHT.from or hour < Ants.NIGHT.to)
end

-- One fixed tick. The spider is ignored. `ctx.hour`: the life clock's hour (nil: day).
function Ants.step(self: any, dt: number, _spider: Vector3, ctx: any)
	self.now += dt
	local now = self.now
	local home = Vector3.new(self.home.X, self.top, self.home.Z)
	local inNest = night(if ctx ~= nil then ctx.hour else nil)
	for _, a in self.items do
		a.prevPosition = a.position
		if a.state == "away" then
			if not inNest then
				-- out of the nest at its way in
				a.state, a.hidden = "walk", false
				a.surface = home
				a.position = home + Vector3.yAxis * Ants.HOVER
				a.prevPosition = a.position
			end
			continue
		end
		if inNest then
			-- back to the way in, and in
			local to = home - a.surface
			if to.Magnitude <= 0.4 then a.state, a.hidden = "away", true; continue end
			a.heading = to.Unit
			a.surface += a.heading * math.min(to.Magnitude, a.speed * dt)
			a.position = a.surface + Vector3.yAxis * Ants.HOVER
			continue
		end
		if a.state == "pause" then
			if now >= a.until_ then a.state = "walk" end
			continue
		end
		if now >= a.nextTurn then
			-- a turn, now and then back toward the hill (the trail home)
			local back = home - a.surface
			if self.rng:next() < 0.25 and back.Magnitude > 2 then a.heading = Vector3.new(back.X, 0, back.Z).Unit
			else a.heading = turned(a.heading, self.rng:draw({ -50, 50 })) end
			a.nextTurn = now + self.rng:draw({ 0.4, 1.4 })
			if self.rng:next() < 0.12 then a.state = "pause"; a.until_ = now + self.rng:draw({ 0.3, 1.2 }); continue end
		end
		local nextPos = a.surface + a.heading * (a.speed * dt)
		if self:free(nextPos) then
			a.surface = nextPos
			a.position = nextPos + Vector3.yAxis * Ants.HOVER
		else
			a.heading = turned(a.heading, self.rng:draw({ 100, 200 }))
		end
	end
end

-- What a strike may hit: an ant out of the nest.
function Ants.targets(self: any): { any }
	local out = {}
	for _, a in self.items do
		if not a.hidden then table.insert(out, { creature = a, position = a.position, radius = Ants.RADIUS }) end
	end
	return out
end

-- Struck: it turns and runs on, faster for a while.
function Ants.struck(self: any, a: any)
	a.heading = -a.heading
	a.speed = Ants.WALK[2] * 1.3
	a.state = "walk"
	a.nextTurn = self.now + 1.5
end

function Ants.creatures(self: any): { any } return self.items end

function Ants.problems(self: any, lo: Vector3, hi: Vector3): { string }
	local out: { string } = {}
	local states = { away = true, walk = true, pause = true }
	if type(self.items) ~= "table" then return { "ants: no list" } end
	for i, a in self.items do
		if type(a) ~= "table" or not states[a.state] then table.insert(out, `ants: {i} is in no known state`); continue end
		local p = a.position
		if (typeof(p) ~= "Vector3" and type(p) ~= "table") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then
			table.insert(out, `ants: {i} is outside its region`)
		end
	end
	return out
end

return Ants
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">Feeding</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen feeding_controller.gd: struggle after landing, then conserved nutrition grants. The energy itself belongs to the
-- NeedsModel (ROBLOX-24): each tick this advances it (active unless still on a surface, as Godot's controller does) and asks it
-- to grant what the fly gave up, under the meal's capture key. `needs` is the sandbox model unless the owner gives it another
-- (the client gives it the life one). taken/granted/ledger are this controller's own totals, kept as before.
-- The struggle's three numbers (the grip a catch starts with, what a tap adds, the jerks' scale) are Godot's until useGameRules() gives it
-- Data/Catch.game (ROBLOX-72); a controller never given them replays Godot, which the goldens check.
-- ROBLOX-77: the struggle scales with the prey. A controller given the game's rules (useGameRules) also reads the caught prey's size from its
-- profile and applies Catch.scaled(Catch.factorFor(profile)) at capture (the house fly is 1.0 and exactly ROBLOX-72's numbers; a fruit fly
-- is easier). Three more fields hold Godot's remaining struggle numbers (drainScale 1, tire .5, cap 12) so that useRivalRules can give the
-- rival's own; the struggle itself is `struggle`, which step runs and a second controller (Predator/RivalGrip) runs alone.
local R=require(script.Parent.PreyRandom)
local NeedsModel=require(script.Parent.Parent.Life.NeedsModel)
local Catch=require(script.Parent.Parent.Data.Catch)
local F={};F.__index=F
function F.new(needs: any?): any
 return setmetatable({held=nil,struggling=false,feeding=false,grip=0,elapsed=0,waiting=0,jerk=0,venom=6,
  swallow=0,needs=needs or NeedsModel.new(),taken=0,granted=0,ledger={},mealsFinished=0,auto=false,tap=false,note='',rng=R.new(513),
  startGrip=.4,tapGain=.085,jerkScale=1,drainScale=1,tire=.5,cap=12,game=false,tapToFeed=false,biteWindow=0,bites=0,bitePulse=0},F)
end
local function apply(self: any,g: any)
 self.startGrip,self.tapGain,self.jerkScale=g.startGrip,g.tapGain,g.jerkScale
 self.drainScale,self.tire,self.cap=g.drainScale,g.tire,g.cap
end
-- Opt in to the game's struggle (Data/Catch.game): an easier tap, and a struggle that scales with the prey caught (applied at each capture).
function F.useGameRules(self: any)
 apply(self,Catch.scaled(1));self.game=true
 -- ObjectRecord replaces tables on restore. Older rests have no presentation fields.
 self.bites=self.bites or 0;self.biteWindow=self.biteWindow or 0;self.bitePulse=self.bitePulse or 0
end
-- The rival's struggle (ROBLOX-77): its own numbers (Data/Catch.rival), or in the gentle modes the house fly's with no cap. Not scaled by a profile.
function F.useRivalRules(self: any,gentle: boolean)
 apply(self,Catch.forRival(gentle));self.game=false
end
function F.capture(self: any,fly: any)
 if self.game and fly.profile then apply(self,Catch.scaled(Catch.factorFor(fly.profile))) end
 self.held=fly;self.struggling=true;self.feeding=false;self.grip=self.startGrip;self.elapsed=0;self.waiting=0
 self.biteWindow=0;self.bitePulse=0;self.tap=false
 self.venom=self.rng:draw({6,8});self.jerk=self.rng:draw({.35,.75});self.note='Caught!'
end
function F.press(self: any)
 if self.struggling then self.tap=true
 elseif self.held and self.tapToFeed and not self.auto then
  -- A tap opens one bite, never a queue of free nutrition. The fixed tick validates posture.
  self.biteWindow=.38;self.bitePulse=0;self.feeding=true
 elseif self.held and self.swallow<=0 then self.feeding=not self.feeding end -- nothing to eat: E is the retreat's (LifeLoop)
end
function F.cancel(self: any) self.feeding=false;self.biteWindow=0 end
-- The struggle after a capture: waits up to a second for a landing, then the grip drains, jerks, rises with taps and ends in escape(f) (it tore
-- free; held is nil) or subdued (struggling false). Needs nothing of the reserves, so a second controller can run it alone.
function F.struggle(self: any,dt: number,attached: boolean,escape: (any)->())
 local f=self.held;if not f then self.tap=false;return end
 if not attached and self.waiting<1 then self.waiting+=dt;self.tap=false;return end
 self.elapsed+=dt
 local strength=1-(self.tire or .5)*math.clamp(self.elapsed/self.venom,0,1)
 self.grip-=.32*(self.drainScale or 1)*strength*dt
 self.jerk-=dt
 if self.jerk<=0 then self.grip-=.12*self.jerkScale*strength;self.jerk+=self.rng:draw({.35,.75}) end
 if self.auto then self.grip+=.4*dt end
 if self.tap then self.grip+=self.tapGain end
 self.tap=false
 if self.grip<=0 then self.held=nil;self.struggling=false;self.note='It tore free!';escape(f)
 elseif self.grip>=1 or self.elapsed>=(self.cap or 12) then self.grip=1;self.struggling=false;self.feeding=not self.tapToFeed or self.auto;self.swallow=if self.tapToFeed and not self.auto then 0 else 1;self.note='Subdued.' end
end
function F.step(self: any,dt: number,attached: boolean,moving: boolean,escape: (any)->())
 self.needs:advance(dt,not attached or moving)
 local f=self.held;if not f then self.tap=false;return end
 if self.struggling then self:struggle(dt,attached,escape);return end
 self.swallow=math.max(0,self.swallow-dt)
 if not attached or moving then self.feeding=false;self.biteWindow=0;return end
 if self.swallow>0 then self.feeding=true end
 local eatingDt=dt
 if self.tapToFeed and not self.auto then
  eatingDt=math.min(dt,self.biteWindow)
  self.biteWindow=math.max(0,self.biteWindow-dt)
  self.feeding=eatingDt>0
 end
 if not self.feeding then return end
 -- Pulses only follow valid eating ticks, including the automatic accessibility path.
 self.bitePulse=(self.bitePulse or 0)-eatingDt
 if self.bitePulse<=0 then self.bites=(self.bites or 0)+1;self.bitePulse=.38 end
 local take=math.min(f.nutrition,f.profile.body.feed_rate_per_s*eatingDt)
 f.nutrition-=take
 local granted=self.needs:grantEnergy(take,f.captureKey)
 self.taken+=take;self.granted+=granted
 self.ledger[f.captureKey]=(self.ledger[f.captureKey] or 0)+granted
 if f.nutrition<=1e-9 then f.nutrition=0;f.state='CONSUMED';self.held=nil;self.feeding=false;self.mealsFinished+=1;self.note='Meal finished.' end
end
return F
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">Fly</string>
            <string name="Source"><![CDATA[--!strict
-- Fly's evidence-owned decisions, reactions, flights, glances and surface bursts.
-- Sources: frozen fly.gd and fly_mind.gd. Geometry and random stream are explicit dependencies.
-- ROBLOX-96: a profile whose body says `walker` (the aphid, Data/Species) never launches: `launch` refuses every flight, so FlyFlight is never used for it, and
-- startled it freezes on its perch instead of turning to face the threat. Godot's profiles have no such field, so nothing of theirs is touched.
-- ROBLOX-101: the bestiary's behaviours are Prey/PreyKinds', called only for a profile that asks: a `hop` profile flees by a ballistic hop (state HOP, stepped
-- by PreyKinds.step instead of FlyFlight) and a `flightless` one never begins a flight; a `sidestep` profile goes round its stem when watched; a profile with
-- `flight.wander_local` keeps its wander loops near the height it flew from (the sill's 0.8 to 10 band is the sill's, and the wall and the bed are far below it).
-- ROBLOX-117: a `hover` profile (the hoverfly) holds still in the air on a calm flight now and then (PreyKinds.hover) instead of stepping its flight.
-- ROBLOX-120: a `hear` profile (the field cricket) is hushed by a spider moving near (PreyKinds.hear: it holds still), and a `freeze` one alert freezes as a walker does.
local M=require(script.Parent.PreyMath)
local S=require(script.Parent.FlySenses)
local F=require(script.Parent.FlyFlight)
local R=require(script.Parent.PreyRandom)
local K=require(script.Parent.PreyKinds)
local Fly={};Fly.__index=Fly
function Fly.new(id: string,serial: number,seed: number,perch: any,graph: any,profile: any,now: number): any
 local f:any=setmetatable({id=id,serial=serial,profile=profile,graph=graph,rng=R.new(seed),senses=S.new(profile.senses),
  position=graph:rest(perch),prevPosition=graph:rest(perch),normal=perch.normal,heading=Vector3.new(0,0,-1),velocity=Vector3.zero,
  state='PERCHED',stateSince=now,goal='rest',goalSince=now,perch=perch,fatigue=0,restlessBias=0,
  nextDecision=now+(serial*.0371)%(1/profile.behavior.decision_hz),nextGlance=now,nextWalk=now+2,nextGroom=now+6,groomUntil=0,
  walkLeft=0,burstUntil=0,pauseUntil=0,walkSpeed=0,walkDirection=Vector3.zero,pending=nil,blocked={},candidates=0,
  nutrition=profile.body.nutrition,captureSerial=0,trace={},enabled=true},Fly)
 f.flight=F.new(f,graph);perch.occupant=id;f:beginStay(now)
 return f
end
function Fly.beginStay(self: any,now: number)
 local p=self.profile.behavior
 self.perchedSince=now;self.restlessRate=p.restless_per_s*(1+p.restless_spread*(self.rng:next()*2-1))
 self.nextGroom=now+self.rng:draw(p.groom_interval_s);self.groomUntil=0
 self.nextGlance=now+self.rng:draw(p.glance_interval_s);self.glanceSign=if self.rng:next()<.5 then -1 else 1
 self.nextWalk=now+self.rng:draw(p.walk_interval_s);self.nextFidget=now+self.rng:draw(p.fidget_interval_s)
 self.homeHeading=self.heading;self.glanceTarget=nil;self.fidgetUntil=0;self.restSpot=self.position;self.walkLeft=0
end
function Fly.turn(self: any,target: Vector3,dt: number): boolean
 local tangent=target-self.normal*target:Dot(self.normal)
 if tangent.Magnitude<1e-6 then return true end
 local angle=math.atan2(self.normal:Dot(self.heading:Cross(tangent.Unit)),self.heading:Dot(tangent.Unit))
 local limit=math.rad(self.profile.flight.turn_rate_deg_s)*dt
 self.heading=CFrame.fromAxisAngle(self.normal,math.clamp(angle,-limit,limit)):VectorToWorldSpace(self.heading).Unit
 return math.abs(angle)<=limit+1e-4
end
function Fly.surface(self: any,point: Vector3): boolean
 local hit=self.graph.cast(point+self.normal*.3,point-self.normal*.3)
 return hit~=nil and hit.Normal:Dot(self.normal)>.98 and math.abs((hit.Position+self.normal*self.profile.body.hover_wu-point):Dot(self.normal))<=.06
end
function Fly.alive(self: any): boolean return self.state~='CAPTURED' and self.state~='CONSUMED' end
function Fly.airborne(self: any): boolean return self.state~='PERCHED' and self.state~='ALERT' and self:alive() end
function Fly.percept(self: any): any
 if not self:alive() then return nil end
 return {id=self.id,position=self.position,radius=self.profile.body.radius_wu,velocity=self.velocity,maxCategory='fly_like_prey'}
end
function Fly.relevance(self: any,now: number): number
 local s=self.senses;if not s.hasLastSeen then return 0 end
 local p=self.profile
 return math.clamp(1-(now-s.lastSeenTime-.4)/math.max(p.senses.threat_memory_s-.4,.1),0,1)
  *math.clamp((p.flight.safe_distance_wu*1.5-(self.position-s.lastSeenPosition).Magnitude)/p.flight.safe_distance_wu,0,1)
end
function Fly.ranked(self: any,kind: string,now: number,threat: number,relaxed: boolean?): {any}
 local p=self.profile;local origin=self.position;local list={}
 local restless=math.clamp((now-self.perchedSince)*self.restlessRate,0,1)
 for _,c in self.graph.perches do
  local d=(origin-c.position).Magnitude
  local minimum=if kind=='flee' and not relaxed then math.max(p.flight.min_hop_wu,p.flight.flee_speed_wu_s*p.flight.flee_min_s*.5) else p.flight.min_hop_wu
  local maximum=if kind=='move' then p.behavior.reposition_max_wu else p.flight.max_flight_wu
  local away=if self.senses.hasLastSeen then (c.position-self.senses.lastSeenPosition).Magnitude else p.flight.safe_distance_wu*.5
  if c.valid and c.occupant=='' and (c.reserved=='' or c.reserved==self.id) and d>=minimum and d<=maximum and (self.blocked[c.id] or 0)<=now
   and (kind~='flee' or relaxed or away>=p.flight.perch_avoid_wu) then
   self.candidates+=1
   local travel=math.clamp(d/p.flight.max_flight_wu,0,1)
   local score=if kind=='move' then M.scoreMove(p.utility,restless,math.clamp(c.food-self.perch.food,0,1),math.clamp(c.shelter-self.perch.shelter,0,1),travel,self.fatigue,threat)
    else M.scoreFlee(p.utility,threat,c.shelter,math.clamp(away/p.flight.safe_distance_wu,0,1),travel)
   table.insert(list,{perch=c,score=score})
  end
 end
 table.sort(list,function(a,b) return a.score>b.score or (a.score==b.score and a.perch.id<b.perch.id) end)
 return list
end
function Fly.choose(self: any,kind: string,now: number,threat: number,relaxed: boolean?): (any,{Vector3}?)
 local danger=if kind=='flee' and self.senses.hasLastSeen then self.senses.lastSeenPosition else nil
 for i,c in self:ranked(kind,now,threat,relaxed) do
  if i>self.profile.behavior.candidates_validated then break end
  local path=self.graph:plan(self.position,if self:airborne() then Vector3.zero else self.normal,c.perch,danger)
  if path then return c.perch,path end
  self.blocked[c.perch.id]=now+self.profile.behavior.block_retry_s
 end
 return nil,nil
end
function Fly.launch(self: any,kind: string,now: number): boolean
 if self.profile.body.walker then return false end -- (ROBLOX-96: a walker never flies)
 if self.hop then return false end -- (ROBLOX-101: in the air on a hop already)
 if kind=='flee' and self.profile.body.hop and K.hop(self,now) then return true end -- (ROBLOX-101: the escape hop first)
 if self.profile.body.flightless then return false end
 local target,path=self:choose(kind,now,if kind=='flee' then 1 else 0)
 if not path and kind=='flee' then target,path=self:choose(kind,now,1,true) end
 if not path and kind=='flee' then
  local away=if self.senses.hasLastSeen then self.position-self.senses.lastSeenPosition else self.heading
  local angle=math.atan2(away.X,away.Z)
  for i=0,7 do
   local a=angle+i*math.pi/4;local dest=self.position+Vector3.new(math.sin(a),.35,math.cos(a)).Unit*self.profile.flight.open_escape_wu
   if self.graph:clear(self.position,dest) then path={self.position,dest};break end
  end
 end
 if not path then return false end
 if kind=='move' and target and not self:airborne() and self.rng:next()<self.profile.behavior.wander_flight_chance then
  local lifted=self.position+self.normal*self.profile.flight.lift_wu
  for _=1,4 do
   local a=self.rng:next()*math.pi*2;local d=self.rng:draw({2.5,6})
   local w=lifted+Vector3.new(math.cos(a)*d,0,math.sin(a)*d)
   local rise=self.rng:draw({.5,3.5})
   w=Vector3.new(w.X,if self.profile.flight.wander_local then lifted.Y+rise else math.clamp(lifted.Y+rise,.8,10),w.Z)
   if self.graph:clear(self.position,lifted) and self.graph:clear(lifted,w) then
    local tail=self.graph:plan(w,Vector3.zero,target,nil)
    if tail then local loop={self.position,lifted};for _,point in tail do table.insert(loop,point) end
     if M.pathLength(loop)<=self.profile.flight.max_flight_wu*1.6 then path=loop;break end
    end
   end
  end
 end
 self.flight:begin(path,target,kind,now);self.goal=kind;self.goalSince=now;self.walkLeft=0
 table.insert(self.trace,{t=now,goal=kind,target=if target then target.id else 'open'});if #self.trace>80 then table.remove(self.trace,1) end
 return true
end
function Fly.schedule(self: any,now: number,startle: boolean)
 local p=self.profile.reaction
 local pair=p.delay_deliberate_s
 if startle then pair=if self.state=='ALERT' then p.delay_startle_alert_s elseif now<self.groomUntil then p.delay_startle_grooming_s else p.delay_startle_relaxed_s end
 self.pending=now+self.rng:draw(pair);self.goal='flee'
end
function Fly.think(self: any,now: number)
 local p=self.profile;local s=self.senses;local ev=s.evidence
 if ev.t==now and ev.startle and not self.pending and (self.state=='PERCHED' or self.state=='ALERT' or self.state=='SEEK_PERCH' or self.state=='REPOSITION') then self:schedule(now,true) end
 if self.state=='PERCHED' and ((s.awareness>=p.senses.awareness_alert and self:relevance(now)>=.5) or self.pending) then self.state='ALERT';self.stateSince=now;self.walkLeft=0 end
 if self.pending and now>=self.pending then self.pending=nil;self:launch('flee',now) end
 if now<self.nextDecision then return end
 self.nextDecision=now+1/p.behavior.decision_hz
 local threat=M.threat(s.awareness,p.senses.awareness_calm,p.senses.awareness_flee)*self:relevance(now)
 if self:airborne() then
  if self.state=='SEEK_PERCH' and not self.flight.target then
   if not self:launch('move',now) and self.profile.flight.home_in then K.homeIn(self,now) end -- (ROBLOX-101: no perch in reach, fly toward the nearest)
  end
  if (self.state=='REPOSITION' or self.state=='SEEK_PERCH') and not self.pending and threat>=p.behavior.interrupt_threat and ev.seen and now-ev.t<=.3 and ev.gain>0 and ev.distance<=p.flight.safe_distance_wu then self:schedule(now,false) end
  return
 end
 local scores={rest=M.scoreRest(p.utility,self.fatigue,self.perch.shelter,self.perch.food,threat)}
 local move=if self.state=='PERCHED' then self:ranked('move',now,threat) else {}
 local flee=if threat>.02 then self:ranked('flee',now,threat) else {}
 if move[1] then scores.move=move[1].score end;if flee[1] then scores.flee=flee[1].score end
 local chosen=M.pickGoal(scores,self.goal,p.behavior.hysteresis)
 if chosen~=self.goal and threat<p.behavior.interrupt_threat and now-self.goalSince<p.behavior.min_commit_s then chosen=self.goal end
 if chosen=='flee' and not self.pending then self:schedule(now,false)
 elseif chosen=='move' and not self.pending and self.state=='PERCHED' then self:launch('move',now)
 elseif chosen=='rest' and not self.pending then
  if self.goal~='rest' then self.goal='rest';self.goalSince=now end
  if self.state=='ALERT' and (s.awareness<p.senses.awareness_calm or self:relevance(now)<.25) and now-self.stateSince>=p.behavior.alert_min_s then self.state='PERCHED';self.stateSince=now end
 end
end
function Fly.rest(self: any,now: number,dt: number)
 local p=self.profile.behavior
 if self.profile.body.sidestep and K.sidestep(self,now,dt) then return end -- (ROBLOX-101: round the stem, away from the spider)
 if self.profile.body.creep and K.creep(self,now,dt) then return end -- (ROBLOX-105: the aphid's walk over its plant to another perch)
 if self.state=='ALERT' then
  self.groomUntil=0;self.fidgetUntil=0;self.glanceTarget=nil
  if self.profile.body.walker or self.profile.body.freeze then return end -- (ROBLOX-96: a walker freezes; ROBLOX-120: so does a cricket)
  if self.senses.hasLastSeen then local d=self.senses.lastSeenPosition-self.position;local flat=d-self.normal*d:Dot(self.normal);if flat.Magnitude>.001 then self:turn(flat.Unit,dt) end end
  return
 end
 if self.profile.body.hear and K.hushed(self,now) then self.walkLeft=0;self.glanceTarget=nil;return end -- (ROBLOX-120: hushed, the cricket holds still)
 if now<self.fidgetUntil then
  local t=math.clamp((now-self.fidgetStarted)/(self.fidgetUntil-self.fidgetStarted),0,1)
  self.position=self.fidgetFrom:Lerp(self.fidgetTo,t*t*(3-2*t));return
 end
 if self.glanceTarget then if self:turn(self.glanceTarget,dt) then self.glanceTarget=nil end;return end
 if now>=self.nextGroom then self.groomUntil=now+self.rng:draw(p.groom_duration_s);self.nextGroom=self.groomUntil+self.rng:draw(p.groom_interval_s) end
 if now<self.groomUntil then return end
 if now>=self.nextGlance and self.walkLeft<=0 then
  self.glanceTarget=CFrame.fromAxisAngle(self.normal,math.rad(self.rng:draw(p.glance_angle_deg))*self.glanceSign):VectorToWorldSpace(self.homeHeading)
  self.glanceSign=-self.glanceSign;self.nextGlance=now+self.rng:draw(p.glance_interval_s);return
 end
 if now>=self.nextWalk and self.walkLeft<=0 then
  local home=self.graph:rest(self.perch)-self.position
  local direction=if home.Magnitude>p.wander_radius_wu*.5 then home.Unit else self.heading
  local angle=if home.Magnitude>p.wander_radius_wu*.5 then 40 else 100
  self.walkDirection=CFrame.fromAxisAngle(self.normal,math.rad(self.rng:draw({-angle,angle}))):VectorToWorldSpace(direction)
  local wanted=self.rng:draw(p.walk_distance_wu);self.walkLeft=0
  for distance=.15,wanted,.15 do
   local nextPos=self.position+self.walkDirection*distance
   if not self:surface(nextPos) or (nextPos-self.graph:rest(self.perch)).Magnitude>p.wander_radius_wu or not self.graph:clear(self.position,nextPos) then break end
   self.walkLeft=distance
  end
  if self.walkLeft<.2 then self.walkLeft=0 end
  self.walkSpeed=self.rng:draw(p.walk_speed_wu_s)
  self.burstUntil=now+self.rng:draw(p.walk_burst_s);self.pauseUntil=0;self.nextWalk=now+self.rng:draw(p.walk_interval_s)
 end
 if self.walkLeft>0 then
  if math.deg(math.acos(math.clamp(self.heading:Dot(self.walkDirection),-1,1)))>20 then self:turn(self.walkDirection,dt);return end
  if now<self.pauseUntil then return end
  if now>=self.burstUntil then self.pauseUntil=now+self.rng:draw(p.walk_pause_s);self.burstUntil=self.pauseUntil+self.rng:draw(p.walk_burst_s);return end
  local step=math.min(self.walkLeft,self.walkSpeed*dt);local nextPos=self.position+self.walkDirection*step
  local hit=self.graph.cast(nextPos+self.normal*.3,nextPos-self.normal*.3)
  if hit and hit.Normal:Dot(self.normal)>.98 and math.abs((hit.Position+self.normal*self.profile.body.hover_wu-nextPos):Dot(self.normal))<=.06
   and (nextPos-self.graph:rest(self.perch)).Magnitude<=p.wander_radius_wu and self.graph:clear(self.position,nextPos) then
   self.position=nextPos;self.walkLeft-=step;self.heading=self.heading:Lerp(self.walkDirection,.3).Unit
   if self.walkLeft<=.001 then self.restSpot=self.position;self.homeHeading=self.heading end
  else self.walkLeft=0 end
 elseif now>=self.nextFidget then
  local dir=CFrame.fromAxisAngle(self.normal,self.rng:next()*math.pi*2):VectorToWorldSpace(self.heading)
  local distance=self.rng:draw(p.fidget_distance_wu);local duration=self.rng:draw(p.fidget_duration_s)
  if (self.position+dir*distance-self.restSpot).Magnitude>p.perch_radius_wu and (self.restSpot-self.position).Magnitude>.001 then dir=(self.restSpot-self.position).Unit end
  local target=self.position+dir*distance
  self.nextFidget=now+duration+self.rng:draw(p.fidget_interval_s)
  if self:surface(target) and self.graph:clear(self.position,target) then
   self.fidgetFrom=self.position;self.fidgetTo=target;self.fidgetStarted=now;self.fidgetUntil=now+duration
  end
 end
end
function Fly.step(self: any,dt: number,now: number,stimulus: Vector3,radius: number,cast: any)
 self.prevPosition=self.position
 if not self:alive() or not self.enabled then return end
 local p=self.profile
 if p.body.hear then K.hear(self,now,dt,stimulus) end -- (ROBLOX-120: the cricket's ear)
 if self.senses:shouldCheck(now) then
  local vigilant=if self.state=='ALERT' then p.senses.vigilance_alert elseif now<self.groomUntil then p.senses.vigilance_grooming else p.senses.vigilance_relaxed
  self.senses:update(cast,self.position+self.normal*.1,if self:airborne() and self.velocity.Magnitude>.1 then self.velocity.Unit else self.heading,if self:airborne() then Vector3.yAxis else self.normal,stimulus,radius,now,vigilant,if self.state=='ALERT' then p.senses.decay_alert_per_s else p.senses.decay_relaxed_per_s)
 end
 self:think(now)
 if self:airborne() then if self.hop then K.step(self,now,dt) elseif not (p.body.hover and K.hover(self,now,dt)) then self.flight:step(now,dt) end;self.fatigue=math.min(1,self.fatigue+p.behavior.fatigue_up_per_s*dt)
 else self:rest(now,dt);self.fatigue=math.max(0,self.fatigue-p.behavior.fatigue_down_per_s*dt) end
 if not self:airborne() and math.abs(self.heading:Dot(self.normal))>.9 then K.upright(self) end -- (ROBLOX-101: landed on a wall facing it; never on the sill's flat perches)
 self.velocity=(self.position-self.prevPosition)/dt
end
return Fly
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">FlyFlight</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen FlyFlight: accelerate, sweep every step, brake for landing, reserve the destination.
local M=require(script.Parent.PreyMath)
local F={};F.__index=F
function F.new(fly: any,graph: any): any
 return setmetatable({fly=fly,graph=graph,path={},length=0,s=0,speed=0,target=nil,mode='',started=0,replans=0,blocked=0,landings=0,sweeps=0},F)
end
function F.release(self: any)
 if self.target and self.target.reserved==self.fly.id then self.target.reserved='' end
 self.target=nil
end
function F.begin(self: any,path: {Vector3},target: any,mode: string,now: number)
 local f=self.fly;local air=f.state~='PERCHED' and f.state~='ALERT'
 self:release();self.path=path;self.length=M.pathLength(path);self.s=0;self.speed=if air then f.velocity.Magnitude else 0
 self.mode=mode;self.target=target;self.started=now;self.replans=0
 if target then target.reserved=f.id end
 if f.perch and f.perch.occupant==f.id then f.perch.occupant='' end
 f.state=if mode=='flee' then (if air then 'FLEE' else 'TAKEOFF') else 'REPOSITION'
 f.stateSince=now
end
function F.step(self: any,now: number,dt: number): boolean
 local f=self.fly;local p=f.profile.flight
 if self.length<=1e-6 or #self.path<2 then self.speed=0;f.velocity=Vector3.zero;return false end
 local fast=f.state=='TAKEOFF' or f.state=='FLEE'
 local top=if fast then p.flee_speed_wu_s else p.cruise_speed_wu_s
 local targetSpeed=if self.target then M.targetSpeed(self.length-self.s,top,p.landing_speed_wu_s,p.landing_slow_wu) else top
 self.speed=M.stepSpeed(self.speed,targetSpeed,if fast then p.takeoff_accel_wu_s2 else p.cruise_accel_wu_s2,dt)
 local sn=math.min(self.length,self.s+self.speed*dt);local nextPos=M.pointAt(self.path,sn)
 self.sweeps+=1
 if not self.graph:clear(f.position,nextPos) then
  self.blocked+=1;f.velocity=Vector3.zero
  if self.target and self.replans<3 then
   self.replans+=1
   local path=self.graph:plan(f.position,Vector3.zero,self.target,if self.mode=='flee' and f.senses.hasLastSeen then f.senses.lastSeenPosition else nil)
   if path then self.path=path;self.length=M.pathLength(path);self.s=0;return false end
  end
  self:release();self.path={};self.length=0;f.state='SEEK_PERCH';return false
 end
 local delta=nextPos-f.position;f.velocity=delta/dt;f.position=nextPos;self.s=sn
 local flat=Vector3.new(delta.X,0,delta.Z)
 if flat.Magnitude>.004 then
  local desired=math.atan2(-flat.X,-flat.Z);local old=math.atan2(-f.heading.X,-f.heading.Z)
  local diff=math.atan2(math.sin(desired-old),math.cos(desired-old));local angle=old+math.clamp(diff,-math.rad(p.turn_rate_deg_s)*dt,math.rad(p.turn_rate_deg_s)*dt)
  f.heading=Vector3.new(-math.sin(angle),0,-math.cos(angle))
 end
 if f.state=='TAKEOFF' and now-f.stateSince>=p.takeoff_s then f.state='FLEE';f.stateSince=now
 elseif f.state=='FLEE' and self.target and self.length-self.s<=p.approach_wu+p.landing_slow_wu then f.state='SEEK_PERCH' end
 if self.s>=self.length-1e-4 then
  local target=self.target
  if target and (f.position-self.graph:rest(target)).Magnitude<=.06 then
   self:release();self.path={};self.length=0;self.speed=0;self.landings+=1
   f.perch=target;target.occupant=f.id;f.position=self.graph:rest(target);f.normal=target.normal;f.velocity=Vector3.zero
   f.state='PERCHED';f.stateSince=now;f.goal='rest';f.goalSince=now;f:beginStay(now);return true
  end
  self:release();self.path={};self.length=0;f.state='SEEK_PERCH'
 end
 return false
end
return F
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">FlySenses</string>
            <string name="Source"><![CDATA[--!strict
-- scripts/prey/fly_senses.gd, A-028. No controls, plans or velocity enter this interface.
local M=require(script.Parent.PreyMath)
local PM=require(script.Parent.Parent.Perception.PerceptionMath)
local S={};S.__index=S
function S.new(profile: any): any
 return setmetatable({p=profile,awareness=0,evidence={},hasLastSeen=false,lastSeenPosition=Vector3.zero,lastSeenTime=-1e9,
  started=false,hasLast=false,lastPoint=Vector3.zero,lastTime=-1e9,lastMask=0,lastCheck=-1e9,nextCheck=0,checks=0,rays=0},S)
end
function S.shouldCheck(self: any,now: number): boolean return now+1e-9>=self.nextCheck end
function S.finish(self: any,ev: any,now: number,dt: number,gain: number,decay: number,seen: boolean): any
 if not seen then self.hasLast=false end
 self.started=true
 self.awareness=M.integrateAwareness(self.awareness,gain,dt,decay*(if seen then 1 else self.p.unseen_decay_mult),self.p.awareness_max)
 ev.awareness=self.awareness;ev.seen=seen;self.evidence=ev
 self.nextCheck=if seen and ev.distance<=self.p.near_check_range_wu then now else now+1/math.max(self.p.far_check_hz,.1)
 return ev
end
function S.update(self: any,cast: (Vector3,Vector3)->Vector3?,eye: Vector3,facing: Vector3,up: Vector3,pos: Vector3,radius: number,now: number,vigilance: number,decay: number): any
 local p=self.p;local dt=if self.started then math.clamp(now-self.lastCheck,0,.25) else 0
 self.lastCheck=now;self.checks+=1
 local offset=pos-eye;local dist=offset.Magnitude
 local ev={t=now,dt=dt,seen=false,distance=dist,reason='',startle=false,appeared=false,bearing=0,loom=0,motion=0,gain=0,visible=0}
 if dist>p.sight_range_wu or dist<.05 then ev.reason='out of range';return self:finish(ev,now,dt,0,decay,false) end
 local dir=offset/dist
 local off=if facing.Magnitude>1e-9 then math.deg(math.acos(math.clamp(facing.Unit:Dot(dir),-1,1))) else 0
 local face=M.facingWeight(off,p.front_half_deg,p.rear_half_deg,p.rear_gain)
 local distance=M.distanceWeight(dist,p.full_sensitivity_wu,p.sight_range_wu)
 local side=dir:Cross(up);if side.Magnitude<.001 then side=dir:Cross(Vector3.xAxis) end
 side=if side.Magnitude>0 then side.Unit else Vector3.zero
 local centre=Vector3.zero;local count,mask=0,0
 for i,point in {pos,pos+side*radius*.8,pos-side*radius*.8} do
  self.rays+=1;local hit=cast(eye,point);local length=(point-eye).Magnitude
  if hit==nil or (hit-eye).Magnitude>=length-PM.sightTolerance(radius,length) then
   centre+=point;count+=1;mask+=2^(i-1)
  end
 end
 if count==0 then ev.reason='no line of sight';return self:finish(ev,now,dt,0,decay,false) end
 centre/=count;offset=centre-eye;local vd=offset.Magnitude;local angle=M.apparentAngle(radius,vd)
 ev.visible=count/3;ev.distance=vd
 if self.started then
  if self.hasLast and now-self.lastTime<=p.sample_gap_max_s+1e-9 then
   if mask==self.lastMask then
    local gap=math.max(now-self.lastTime,1e-9);local old=self.lastPoint-eye
    ev.bearing=M.bearingRate(old,offset,gap);ev.loom=M.loomRate(M.apparentAngle(radius,old.Magnitude),angle,gap,p.loom_scale_deg_s)
   end
  elseif vd<=p.appear_range_wu then ev.appeared=true;ev.bearing=p.appear_motion_deg_s end
 end
 ev.motion=math.max(ev.bearing,ev.loom)
 ev.gain=M.awarenessGain(ev.motion,p.motion_threshold_deg_s,p.motion_scale_deg_s,distance,face,ev.visible,vigilance)
 ev.startle=ev.motion*math.max(face,p.startle_rear_gain)*ev.visible>=p.startle_motion_deg_s and vd<=p.startle_range_wu
 self.hasLast=true;self.lastPoint=centre;self.lastTime=now;self.lastMask=mask
 self.hasLastSeen=true;self.lastSeenPosition=centre;self.lastSeenTime=now
 return self:finish(ev,now,dt,ev.gain,decay,true)
end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">Harvestman</string>
            <string name="Source"><![CDATA[--!strict
-- Harvestmen (ROBLOX-105, W3b part B): ambient, not food, not spiders: a small oval body high on eight very long legs. One walks the bed's soil and litter and one
-- the house wall's brick, from dusk through the night (the life clock's hour, as the moths'); by day each is away in its corner (the bed's first litter hide
-- spot, the wall's foot at its west end) and is not drawn. It walks its surface on a seeded wander, round what stands on the soil, and pays the spider no heed:
-- it neither hides nor hurries. Struck, the strike is refused (Prey/PreyWorld, UI/PreyText) and it walks on. Pure and seeded, no raycast; a checkpoint records
-- it with the region's prey.
-- Sources (docs/NOTEBOOK_SOURCES.md, the harvestman page): one oval body, two eyes, no silk and no venom glands; a foul odour when disturbed; legs that come off
-- easily and twitch; mostly active at night or in shade. The speeds and the leg lengths drawn are the game's.
local R = require(script.Parent.PreyRandom)

local Harvestmen = {}
Harvestmen.__index = Harvestmen

Harvestmen.HOVER = 0.9 -- the body's centre above the surface: it rides high on its legs
Harvestmen.BODY = 0.5 -- studs long: a body about 5 mm
Harvestmen.RADIUS = 0.35
Harvestmen.WALK = { 0.8, 1.4 } -- studs a second
Harvestmen.EDGE = 1.5
Harvestmen.DUSK = { from = 18, to = 6 }

-- `spec`: one of World/Garden.ambient's (kind "harvestman", surface "soil" or "wall"); `count`: the tier's; for the soil, `soil` and `boxes` as the woodlice's.
function Harvestmen.new(spec: any, count: number, soil: { min: Vector3, max: Vector3 }?, boxes: { { min: Vector3, max: Vector3 } }?): any
	local self: any = setmetatable({ kind = "harvestman", rng = R.new(spec.seed + 5059), now = 0, items = {}, boxes = {}, surface = spec.surface or "soil",
		home = spec.home, rect = spec.rect }, Harvestmen)
	if soil ~= nil then self.soilMin, self.soilMax, self.top = soil.min, soil.max, soil.max.Y end
	for _, b in (boxes or {}) :: { any } do table.insert(self.boxes, { min = b.min, max = b.max }) end
	local normal = if self.surface == "wall" then -Vector3.zAxis else Vector3.yAxis
	for i, s in spec.starts do
		if i > count then break end
		local surf = if self.surface == "wall" then s.pos else Vector3.new(s.pos.X, self.top, s.pos.Z)
		local pos = surf + normal * Harvestmen.HOVER
		table.insert(self.items, {
			id = (spec.prefix or "") .. "harvestman_" .. i, kind = "harvestman", surface = surf, position = pos, prevPosition = pos, normal = normal, heading = s.heading,
			speed = self.rng:draw(Harvestmen.WALK), state = "away", until_ = 0, nextTurn = self.rng:draw({ 1, 3 }), hidden = true,
		})
	end
	return self
end

-- Whether a point of its surface is free to stand over.
function Harvestmen.free(self: any, p: Vector3): boolean
	if self.surface == "wall" then
		local r = self.rect
		return p.X >= r.x[1] and p.X <= r.x[2] and p.Y >= r.y[1] and p.Y <= r.y[2]
	end
	if p.X < self.soilMin.X + Harvestmen.EDGE or p.X > self.soilMax.X - Harvestmen.EDGE or p.Z < self.soilMin.Z + Harvestmen.EDGE or p.Z > self.soilMax.Z - Harvestmen.EDGE then return false end
	for _, b in self.boxes do
		if p.X > b.min.X - 0.6 and p.X < b.max.X + 0.6 and p.Z > b.min.Z - 0.6 and p.Z < b.max.Z + 0.6 then return false end
	end
	return true
end

-- The heading turned by `degrees` about the surface's normal.
local function turned(self: any, h: Vector3, degrees: number): Vector3
	local n = if self.surface == "wall" then -Vector3.zAxis else Vector3.yAxis
	return CFrame.fromAxisAngle(n, math.rad(degrees)):VectorToWorldSpace(h).Unit
end

local function dusk(hour: number?): boolean
	return hour ~= nil and (hour >= Harvestmen.DUSK.from or hour < Harvestmen.DUSK.to)
end

-- One fixed tick. The spider is ignored. `ctx.hour`: the life clock's hour (nil: day).
function Harvestmen.step(self: any, dt: number, _spider: Vector3, ctx: any)
	self.now += dt
	local now = self.now
	local out = dusk(if ctx ~= nil then ctx.hour else nil)
	for _, h in self.items do
		h.prevPosition = h.position
		if h.state == "away" then
			if out then
				-- out from its corner
				h.state = "walk"; h.hidden = false
				local home = self.home
				if home ~= nil then
					h.surface = if self.surface == "wall" then home else Vector3.new(home.X, self.top, home.Z)
					h.position = h.surface + h.normal * Harvestmen.HOVER
					h.prevPosition = h.position
				end
			end
			continue
		end
		if not out and self.home ~= nil then
			-- day: back to its corner
			local home = if self.surface == "wall" then self.home else Vector3.new(self.home.X, self.top, self.home.Z)
			local to = home - h.surface
			if to.Magnitude <= 0.3 then h.state = "away"; h.hidden = true; continue end
			h.heading = to.Unit
			h.surface += h.heading * math.min(to.Magnitude, h.speed * dt)
			h.position = h.surface + h.normal * Harvestmen.HOVER
			continue
		end
		if h.state == "pause" then
			if now >= h.until_ then h.state = "walk" end
			continue
		end
		if now >= h.nextTurn then
			h.heading = turned(self, h.heading, self.rng:draw({ -60, 60 }))
			h.nextTurn = now + self.rng:draw({ 1, 3 })
			if self.rng:next() < 0.2 then h.state = "pause"; h.until_ = now + self.rng:draw({ 1, 5 }); continue end
		end
		local nextPos = h.surface + h.heading * (h.speed * dt)
		if self:free(nextPos) then
			h.surface = nextPos
			h.position = nextPos + h.normal * Harvestmen.HOVER
		else
			h.heading = turned(self, h.heading, self.rng:draw({ 100, 200 }))
		end
	end
end

-- What a strike may hit: the body, while it is out.
function Harvestmen.targets(self: any): { any }
	local out = {}
	for _, h in self.items do
		if not h.hidden then table.insert(out, { creature = h, position = h.position, radius = Harvestmen.RADIUS }) end
	end
	return out
end

-- Struck: it walks on.
function Harvestmen.struck(_self: any, _h: any) end

function Harvestmen.creatures(self: any): { any } return self.items end

function Harvestmen.problems(self: any, lo: Vector3, hi: Vector3): { string }
	local out: { string } = {}
	local states = { away = true, walk = true, pause = true }
	if type(self.items) ~= "table" then return { "harvestmen: no list" } end
	if self.surface ~= "soil" and self.surface ~= "wall" then table.insert(out, "harvestmen: on no known surface") end
	for i, h in self.items do
		if type(h) ~= "table" or not states[h.state] then table.insert(out, `harvestmen: {i} is in no known state`); continue end
		local p = h.position
		if (typeof(p) ~= "Vector3" and type(p) ~= "table") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then
			table.insert(out, `harvestmen: {i} is outside its region`)
		end
	end
	return out
end

return Harvestmen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">Ladybird</string>
            <string name="Source"><![CDATA[--!strict
-- Ladybirds (ROBLOX-105, W3b part B): ambient beetles, not food, that walk the bed's plants among the aphids (World/Garden.plants: one on the dock, one on the
-- dandelion at the full tier). Each walks its plant's faces from one place to the next (Prey/PlantWalk over Garden.plantPath), pauses, and now and then, when its
-- appetite has come back, walks to a perch where an aphid sits and eats it there in plain view: it stands over the aphid for 8 to 14 s and the aphid is gone
-- (the aphid's director tidies it away and its population owes another, as after the spider's own meal). Struck by the spider it is refused (Prey/PreyWorld,
-- UI/PreyText) and reflex-bleeds: a drop of the fluid shows at its front leg joints for a while and it keeps still. The spider does not otherwise trouble it.
-- Pure and seeded (a Prey/PreyRandom stream of its own from the region's ambient seed), no raycast; a checkpoint records the colony with the region's prey and
-- puts it back where it was (Persistence/Checkpoint's `garden` root, the region's `ambient`).
-- Sources (docs/NOTEBOOK_SOURCES.md, the ladybird page): adults and larvae eat aphids and other small soft-bodied insects; the colours are a warning; disturbed,
-- they release a noxious fluid from the leg joints. The speeds, waits and how often it eats are the game's.
local R = require(script.Parent.PreyRandom)
local PlantWalk = require(script.Parent.PlantWalk)
local Garden = require(script.Parent.Parent.World.Garden)

local Ladybirds = {}
Ladybirds.__index = Ladybirds

Ladybirds.HOVER = 0.17 -- the body's centre above the surface it walks on
Ladybirds.LENGTH = 0.6 -- studs: a seven-spot ladybird is 5 to 8 mm long
Ladybirds.RADIUS = 0.3 -- what a strike must come within
Ladybirds.WALK = { 0.35, 0.6 } -- studs a second
Ladybirds.PAUSE = { 2, 7 }
Ladybirds.EAT = { 8, 14 } -- seconds over an aphid
Ladybirds.APPETITE = { 50, 120 } -- seconds before it goes after another aphid
Ladybirds.REACH = 0.8 -- an aphid this near when it arrives is the one it eats
Ladybirds.BLEED_S = 6 -- how long the drop shows and it keeps still, struck

export type Beetle = {
	id: string, kind: string, plant: string, node: string, walk: PlantWalk.Walk?, surface: Vector3, position: Vector3, prevPosition: Vector3, normal: Vector3,
	heading: Vector3, speed: number, state: string, -- walk | pause | eat | still
	until_: number, target: string?, -- the aphid's perch it is making for
	prey: string?, -- the aphid it is eating
	nextMeal: number, bleedUntil: number, eaten: number, hidden: boolean,
}

-- `spec`: one of World/Garden.ambient's (kind "ladybird"); `count`: how many (the tier's); `plants`: the region's World/Garden.plants.
function Ladybirds.new(spec: any, count: number, plants: { [string]: any }): any
	local self: any = setmetatable({ kind = "ladybird", rng = R.new(spec.seed + 2027), now = 0, beetles = {} }, Ladybirds)
	for i, s in spec.starts do
		if i > count then break end
		local plant = plants[s.plant]
		local node = plant and plant.nodes[s.node]
		if node ~= nil then
			local p = if #node.route > 0 then node.route[#node.route] else plant.highway[node.hub]
			local a = self.rng:next() * math.pi * 2
			local h = Vector3.new(math.cos(a), 0, math.sin(a))
			local t = h - p.normal * h:Dot(p.normal)
			if t.Magnitude < 1e-3 then t = Vector3.yAxis - p.normal * p.normal.Y end
			if t.Magnitude < 1e-3 then t = Vector3.zAxis end
			local pos = p.pos + p.normal * Ladybirds.HOVER
			table.insert(self.beetles, {
				id = (spec.prefix or "") .. "ladybird_" .. i, kind = "ladybird", plant = s.plant, node = s.node, walk = nil, surface = p.pos, position = pos, prevPosition = pos,
				normal = p.normal, heading = t.Unit, speed = self.rng:draw(Ladybirds.WALK), state = "pause", until_ = self.rng:draw(Ladybirds.PAUSE),
				target = nil, prey = nil, nextMeal = self.rng:draw(Ladybirds.APPETITE), bleedUntil = -1, eaten = 0, hidden = false,
			})
		end
	end
	return self
end

-- The aphid (a fly of the bed's director) with this id, or nil.
local function aphidById(flies: { any }, id: string?): any
	if id == nil then return nil end
	for _, f in flies do if f.id == id then return f end end
	return nil
end

-- An aphid that can be eaten: alive, sitting (not in the jaws, not on its way between perches, not another's meal).
local function edible(f: any, by: string?): boolean
	return f ~= nil and (f.state == "PERCHED" or f.state == "ALERT") and f.creep == nil and (f.heldBy == nil or f.heldBy == by)
		and f.profile ~= nil and f.profile.body ~= nil and f.profile.body.prey_kind == "aphid"
end

-- Sets off for a node of its plant: an aphid's perch on it when its appetite is back and one sits there, else a seeded place of the plant.
local function setOff(self: any, b: any, plant: any, flies: { any })
	local to: string? = nil
	b.target = nil
	if self.now >= b.nextMeal then
		for _, f in flies do
			if edible(f, nil) and f.perch ~= nil and plant.nodes[f.perch.id] ~= nil and f.perch.id ~= b.node then to = f.perch.id; b.target = f.perch.id; break end
		end
	end
	if to == nil then
		local list = {}
		for _, id in plant.order do if id ~= b.node then table.insert(list, id) end end
		if #list == 0 then return end
		to = list[1 + math.floor(self.rng:next() * #list) % #list]
	end
	local path = Garden.plantPath(plant, b.node, to :: string)
	if path == nil then return end
	b.walk = PlantWalk.new(path, b.surface, b.normal)
	if b.target ~= nil then (b.walk :: any).length = math.max(0, (b.walk :: any).length - 0.35) end -- (it stops just short of the aphid, facing it)
	b.node = to :: string
	b.state = "walk"
end

-- One fixed tick. `ctx`: { plants = the region's Garden.plants, flies = the bed's prey director's flies (the aphids among them), hour = the life clock's hour? }.
function Ladybirds.step(self: any, dt: number, _spider: Vector3, ctx: any)
	self.now += dt
	local now = self.now
	local plants = ctx.plants or {}
	local flies = ctx.flies or {}
	for _, b in self.beetles do
		b.prevPosition = b.position
		local plant = plants[b.plant]
		if plant == nil then continue end
		if b.state == "still" then
			if now >= b.until_ then b.state = "pause"; b.until_ = now + self.rng:draw(Ladybirds.PAUSE) end
		elseif b.state == "pause" then
			if now >= b.until_ then setOff(self, b, plant, flies) end
		elseif b.state == "eat" then
			local f = aphidById(flies, b.prey)
			if not edible(f, b.id) or (f.position - b.position).Magnitude > Ladybirds.REACH + 0.4 then
				if f ~= nil and f.heldBy == b.id then f.heldBy = nil end
				b.prey = nil; b.state = "pause"; b.until_ = now + self.rng:draw(Ladybirds.PAUSE)
			elseif now >= b.until_ then
				-- the meal is over: the aphid is gone (its director tidies it away; its population owes another)
				f.heldBy = nil
				if f.perch ~= nil and f.perch.occupant == f.id then f.perch.occupant = "" end
				f.state = "CONSUMED"
				b.eaten += 1
				b.prey = nil
				b.nextMeal = now + self.rng:draw(Ladybirds.APPETITE)
				b.state = "pause"; b.until_ = now + self.rng:draw(Ladybirds.PAUSE)
			end
		elseif b.state == "walk" and b.walk ~= nil then
			local p, n, dir, done = PlantWalk.advance(b.walk, b.speed * dt)
			b.surface, b.normal = p, n
			if dir.Magnitude > 0.5 then b.heading = dir end
			b.position = p + n * Ladybirds.HOVER
			if done then
				b.walk = nil
				local f: any = nil
				if b.target ~= nil then
					for _, x in flies do
						if edible(x, nil) and x.perch ~= nil and x.perch.id == b.target and (x.position - b.position).Magnitude <= Ladybirds.REACH + 0.4 then f = x; break end
					end
				end
				b.target = nil
				if f ~= nil then
					f.heldBy = b.id
					b.prey = f.id
					b.state = "eat"; b.until_ = now + self.rng:draw(Ladybirds.EAT)
					local to = f.position - b.position
					local t = to - n * to:Dot(n)
					if t.Magnitude > 1e-3 then b.heading = t.Unit end
				else
					b.state = "pause"; b.until_ = now + self.rng:draw(Ladybirds.PAUSE)
				end
			end
		end
	end
end

-- What a strike may hit: { creature, position, radius }.
function Ladybirds.targets(self: any): { any }
	local out = {}
	for _, b in self.beetles do table.insert(out, { creature = b, position = b.position, radius = Ladybirds.RADIUS }) end
	return out
end

-- Struck by the spider: it bleeds from its leg joints and keeps still (a meal under way is left).
function Ladybirds.struck(self: any, b: any)
	b.bleedUntil = self.now + Ladybirds.BLEED_S
	if b.prey ~= nil then b.prey = nil end
	b.walk = nil
	b.state = "still"; b.until_ = self.now + Ladybirds.BLEED_S
end

-- The drawn creatures.
function Ladybirds.creatures(self: any): { any }
	return self.beetles
end

-- What is wrong with a colony put back from a record.
function Ladybirds.problems(self: any, lo: Vector3, hi: Vector3): { string }
	local out: { string } = {}
	local states = { walk = true, pause = true, eat = true, still = true }
	if type(self.beetles) ~= "table" then return { "ladybirds: no list" } end
	for i, b in self.beetles do
		if type(b) ~= "table" or not states[b.state] then table.insert(out, `ladybirds: beetle {i} is in no known state`); continue end
		local p = b.position
		if (typeof(p) ~= "Vector3" and type(p) ~= "table") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then
			table.insert(out, `ladybirds: beetle {i} is outside its region`)
		end
		if b.plant ~= "dock" and b.plant ~= "dandelion" and b.plant ~= "milkweed" then table.insert(out, `ladybirds: beetle {i} is on no plant`) end -- (ROBLOX-116: the hut garden's milkweed)
		if b.walk ~= nil then
			local why = PlantWalk.problem(b.walk)
			if why ~= nil then table.insert(out, `ladybirds: beetle {i}: {why}`) end
		end
	end
	return out
end

return Ladybirds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">Millipede</string>
            <string name="Source"><![CDATA[--!strict
-- Millipedes (ROBLOX-105, W3b part B): ambient, not food. A seeded few in the bed walk the soil slowly round what stands on it, as the woodlice do (Prey/Woodlouse),
-- and now and then go under the stones for a while (the hide spots by the stones the woodlice use). The body follows the head: the head's track is kept as a
-- trail of points (`trail`), and Client/BugBodies lays the rings along it. When the spider comes within COIL_WU it stops and coils, head in the middle; it stays
-- coiled until the spider has been gone a while, then uncoils and walks on. Struck, it coils at once and the strike is refused (Prey/PreyWorld, UI/PreyText).
-- Pure and seeded, no raycast; a checkpoint records it with the region's prey (Persistence/Checkpoint's `garden` root, the region's `ambient`).
-- Sources (docs/NOTEBOOK_SOURCES.md, the millipede page): two pairs of legs on each segment; most feed on decaying vegetation and live in soil and leaf mould and
-- beneath stones; threatened, most roll into a coil with the legs inside, and some release foul-tasting or foul-smelling substances. Speeds and waits are the game's.
local R = require(script.Parent.PreyRandom)

local Millipedes = {}
Millipedes.__index = Millipedes

Millipedes.HOVER = 0.12 -- the rings' centres above the soil
Millipedes.RINGS = 12 -- body rings drawn behind the head
Millipedes.SPACING = 0.19 -- studs from ring to ring: a body about 2.4 cm long
Millipedes.RADIUS = 0.3
Millipedes.WALK = { 0.15, 0.28 } -- studs a second
Millipedes.COIL_WU = 2.5 -- the spider this near makes it coil
Millipedes.CALM_WU = 5.0 -- it uncoils once the spider is this far, and has been for CALM_S
Millipedes.CALM_S = { 6, 12 }
Millipedes.COIL_S = 1.0 -- seconds to coil
Millipedes.UNCOIL_S = 2.5
Millipedes.UNDER_EVERY = { 60, 140 } -- how often it goes under a stone
Millipedes.UNDER_S = { 20, 45 } -- and how long it stays
Millipedes.EDGE = 1.0
Millipedes.TURN = 90 -- degrees a second it turns at, walking on: it steers round in an arc, never folds back on itself
Millipedes.AHEAD = 0.8 -- how far ahead it feels for what stands in its way

-- `spec`: one of World/Garden.ambient's (kind "millipede"); `count`: the tier's; `soil` the soil's top box; `boxes` the standing boxes' footprints.
function Millipedes.new(spec: any, count: number, soil: { min: Vector3, max: Vector3 }, boxes: { { min: Vector3, max: Vector3 } }): any
	local self: any = setmetatable({ kind = "millipede", rng = R.new(spec.seed + 3041), now = 0, hides = {}, boxes = {}, items = {},
		soilMin = soil.min, soilMax = soil.max, top = soil.max.Y }, Millipedes)
	for _, h in spec.hides or {} do table.insert(self.hides, { pos = h.pos, kind = h.kind }) end
	for _, b in boxes do table.insert(self.boxes, { min = b.min, max = b.max }) end
	for i, s in spec.starts do
		if i > count then break end
		local pos = Vector3.new(s.pos.X, self.top + Millipedes.HOVER, s.pos.Z)
		local trail = {}
		for k = 1, Millipedes.RINGS do table.insert(trail, pos - s.heading * (k * Millipedes.SPACING)) end
		table.insert(self.items, {
			id = (spec.prefix or "") .. "millipede_" .. i, kind = "millipede", position = pos, prevPosition = pos, heading = s.heading, normal = Vector3.yAxis,
			speed = self.rng:draw(Millipedes.WALK), state = "walk", coil = 0, until_ = 0, nextTurn = self.rng:draw({ 2, 5 }),
			nextUnder = self.rng:draw(Millipedes.UNDER_EVERY), hide = 0, trail = trail, hidden = false, turn = 0,
		})
	end
	return self
end

-- Whether a point on the soil is free to stand on (inside the soil's edge, in no standing box's footprint grown by `margin`).
function Millipedes.free(self: any, p: Vector3, margin: number): boolean
	if p.X < self.soilMin.X + Millipedes.EDGE or p.X > self.soilMax.X - Millipedes.EDGE or p.Z < self.soilMin.Z + Millipedes.EDGE or p.Z > self.soilMax.Z - Millipedes.EDGE then return false end
	for _, b in self.boxes do
		if p.X > b.min.X - margin and p.X < b.max.X + margin and p.Z > b.min.Z - margin and p.Z < b.max.Z + margin then return false end
	end
	return true
end

local function flat(v: Vector3): Vector3 return Vector3.new(v.X, 0, v.Z) end
local function turned(heading: Vector3, degrees: number): Vector3
	local a = math.atan2(heading.Z, heading.X) + math.rad(degrees)
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

-- The head moved: drop a trail point once it is a ring's spacing from the last.
local function track(m: any)
	local last = m.trail[1]
	if last == nil or (m.position - last).Magnitude >= Millipedes.SPACING then
		table.insert(m.trail, 1, m.position)
		while #m.trail > Millipedes.RINGS + 1 do table.remove(m.trail) end
	end
end

-- One fixed tick. `spider`: where the spider is.
function Millipedes.step(self: any, dt: number, spider: Vector3, _ctx: any)
	self.now += dt
	local now = self.now
	for _, m in self.items do
		m.prevPosition = m.position
		local d = (flat(spider) - flat(m.position)).Magnitude
		local near = d <= Millipedes.COIL_WU and math.abs(spider.Y - m.position.Y) < 4
		if near and (m.state == "walk" or m.state == "pause" or m.state == "going") then m.state = "coiled"; m.until_ = math.huge end
		if m.state == "coiled" then
			m.coil = math.min(1, m.coil + dt / Millipedes.COIL_S)
			if d >= Millipedes.CALM_WU then
				if m.until_ == math.huge then m.until_ = now + self.rng:draw(Millipedes.CALM_S) end
				if now >= m.until_ then m.state = "walk"; m.nextTurn = now + self.rng:draw({ 2, 5 }) end
			else
				m.until_ = math.huge
			end
		elseif m.coil > 0 then
			m.coil = math.max(0, m.coil - dt / Millipedes.UNCOIL_S) -- (uncoiling: it does not walk until it is straight)
		elseif m.state == "under" then
			if now >= m.until_ then m.state = "walk"; m.hidden = false; m.heading = turned(m.heading, self.rng:draw({ 120, 240 })); m.nextUnder = now + self.rng:draw(Millipedes.UNDER_EVERY) end
		elseif m.state == "going" then
			local goal = self.hides[m.hide].pos
			local to = flat(goal) - flat(m.position)
			if to.Magnitude <= 0.25 then
				m.state = "under"; m.hidden = true; m.until_ = now + self.rng:draw(Millipedes.UNDER_S)
			else
				m.heading = to.Unit
				m.position += m.heading * math.min(to.Magnitude, m.speed * dt)
				track(m)
			end
		elseif m.state == "pause" then
			if now >= m.until_ then m.state = "walk"; m.nextTurn = now + self.rng:draw({ 2, 5 }) end
		elseif m.state == "walk" then
			if now >= m.nextUnder and #self.hides > 0 then
				local best, bestD = 0, math.huge
				for i, h in self.hides do
					local dd = (flat(h.pos) - flat(m.position)).Magnitude
					if dd < bestD then best, bestD = i, dd end
				end
				m.hide = best
				m.state = "going"
			else
				local paused = false
				if now >= m.nextTurn then
					m.turn = self.rng:draw({ -40, 40 })
					m.nextTurn = now + self.rng:draw({ 2, 5 })
					if self.rng:next() < 0.2 then m.state = "pause"; m.until_ = now + self.rng:draw({ 2, 6 }); paused = true end
				end
				if not paused then
					-- something ahead: steer away in an arc (the turn is drawn once, then taken a little each tick)
					if math.abs(m.turn or 0) < 1 and not self:free(m.position + m.heading * Millipedes.AHEAD, 0.3) then
						m.turn = (if self.rng:next() < 0.5 then -1 else 1) * self.rng:draw({ 90, 180 })
					end
					local turn = m.turn or 0
					if math.abs(turn) > 1e-6 then
						local by = math.clamp(turn, -Millipedes.TURN * dt, Millipedes.TURN * dt)
						m.heading = turned(m.heading, by)
						m.turn = turn - by
					end
					local nextPos = m.position + m.heading * (m.speed * dt)
					if self:free(nextPos, 0.3) then
						m.position = nextPos
						track(m)
					elseif math.abs(m.turn or 0) < 1 then
						m.turn = (if self.rng:next() < 0.5 then -1 else 1) * self.rng:draw({ 90, 180 })
					end
				end
			end
		end
	end
end

-- What a strike may hit: the head and the body's middle.
function Millipedes.targets(self: any): { any }
	local out = {}
	for _, m in self.items do
		if not m.hidden then
			table.insert(out, { creature = m, position = m.position, radius = Millipedes.RADIUS })
			local mid = m.trail[math.max(1, math.floor(#m.trail / 2))]
			if mid ~= nil and m.coil < 0.5 then table.insert(out, { creature = m, position = mid, radius = Millipedes.RADIUS }) end
		end
	end
	return out
end

-- Struck by the spider: it coils at once.
function Millipedes.struck(self: any, m: any)
	m.state = "coiled"
	m.until_ = math.huge
	m.coil = math.max(m.coil, 0.5)
end

function Millipedes.creatures(self: any): { any } return self.items end

function Millipedes.problems(self: any, lo: Vector3, hi: Vector3): { string }
	local out: { string } = {}
	local states = { walk = true, pause = true, coiled = true, going = true, under = true }
	if type(self.items) ~= "table" then return { "millipedes: no list" } end
	for i, m in self.items do
		if type(m) ~= "table" or not states[m.state] then table.insert(out, `millipedes: {i} is in no known state`); continue end
		local p = m.position
		if (typeof(p) ~= "Vector3" and type(p) ~= "table") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then
			table.insert(out, `millipedes: {i} is outside its region`)
		end
		if type(m.trail) ~= "table" or #m.trail > Millipedes.RINGS + 1 then table.insert(out, `millipedes: {i} has no body trail`) end
		if type(m.coil) ~= "number" or m.coil < 0 or m.coil > 1 then table.insert(out, `millipedes: {i} is coiled beyond belief`) end
		if (m.state == "going" or m.state == "under") and (type(self.hides) ~= "table" or self.hides[m.hide] == nil) then table.insert(out, `millipedes: {i} hides in no known spot`) end
	end
	return out
end

return Millipedes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">PerchGraph</string>
            <string name="Source"><![CDATA[--!strict
-- Geometry adapter for the frozen PerchGraph. Every planned leg and every flight tick is swept.
local M=require(script.Parent.PreyMath)
local G={};G.__index=G
export type Perch={id:string,position:Vector3,normal:Vector3,shelter:number,food:number,start:boolean,valid:boolean,occupant:string,reserved:string}
function G.new(cast: any,sweep: any,overlap: any,profile: any): any
 return setmetatable({cast=cast,sweep=sweep,overlap=overlap,p=profile,perches={},plans=0,sweeps=0},G)
end
function G.rest(self: any,p: Perch): Vector3 return p.position+p.normal*self.p.body.hover_wu end
function G.clear(self: any,a: Vector3,b: Vector3): boolean
 self.sweeps+=1
 return not self.overlap(a,self.p.flight.clearance_radius_wu) and not self.sweep(a,b,self.p.flight.clearance_radius_wu)
end
function G.add(self: any,id: string,position: Vector3,normal: Vector3,shelter: number,food: number,start: boolean): Perch
 local p: Perch={id=id,position=position,normal=normal,shelter=shelter,food=food,start=start,valid=false,occupant='',reserved=''}
 local hit=self.cast(position+normal*.5,position-normal*.5)
 if hit and math.abs((hit.Position-position):Dot(normal))<=.06 and hit.Normal:Dot(normal)>=math.cos(math.rad(12)) then
  p.position=hit.Position;p.valid=self:clear(self:rest(p),self:rest(p)+normal*self.p.flight.lift_wu)
 end
 table.insert(self.perches,p);return p
end
function G.plan(self: any,start: Vector3,normal: Vector3,target: Perch,threat: Vector3?): {Vector3}?
 self.plans+=1;local p=self.p.flight
 -- (ROBLOX-119) the band its routes climb in: the sill's 0 to 11 studs unless the graph is told its own (`floor`, `ceiling`: PreyDirector.new from a spec that
 -- names them, World/Meadow's and World/Hut's flowers and lamps, far over and under the sill); the sill's routes are as they were
 local floor,ceil=self.floor or 0,self.ceiling or 11
 local rest=self:rest(target);if (start-rest).Magnitude>p.max_flight_wu then return nil end
 local lifted=start+normal*p.lift_wu;local approach=rest+target.normal*p.approach_wu
 if not self:clear(start,lifted) or not self:clear(approach,rest) then return nil end
 local routes: {{Vector3}}={{lifted,approach}};local mid=(lifted+approach)*.5
 for _,h in {2.5,5,8,11} do local y=math.min(mid.Y+h,ceil)
  if y>mid.Y+.5 then table.insert(routes,{lifted,Vector3.new(mid.X,y,mid.Z),approach}) end
 end
 for _,h in {6,9,11} do local y=math.min(math.max(floor+h,math.max(lifted.Y,approach.Y)+.5),ceil)
  if y>math.max(lifted.Y,approach.Y)+.3 then table.insert(routes,{lifted,Vector3.new(lifted.X,y,lifted.Z),Vector3.new(approach.X,y,approach.Z),approach}) end
 end
 for _,route in routes do
  local clear=true
  for i=2,#route do if not self:clear(route[i-1],route[i]) then clear=false;break end end
  if clear then
   local pts={start};for _,v in route do table.insert(pts,v) end;table.insert(pts,rest)
   if (not threat or M.distanceToPath(pts,threat)>=p.path_threat_clearance_wu) and M.pathLength(pts)<=p.max_flight_wu*1.6 then return pts end
  end
 end
 return nil
end
return G
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">PlantWalk</string>
            <string name="Source"><![CDATA[--!strict
-- A walk along a list of points on surfaces (ROBLOX-105, W3b part B): the aphid's creep from one of its perches to another and the ladybird's rounds over a
-- plant (World/Garden.plantPath), and the snail's crawl over the soil and up the wall's foot. A walk is plain data (the points, their surfaces' normals, how far
-- along it is), so a rest records it and puts it back where it was. Pure: no engine, no random draw.
local PlantWalk = {}

export type Walk = { points: { Vector3 }, normals: { Vector3 }, lengths: { number }, length: number, s: number }

-- A walk over `path` ({ pos, normal } each), from `from` (a place on the first point's surface) when given.
function PlantWalk.new(path: { any }, from: Vector3?, fromNormal: Vector3?): Walk
	local points, normals = {}, {}
	if from ~= nil and (path[1] == nil or (path[1].pos - from).Magnitude > 1e-4) then
		table.insert(points, from)
		table.insert(normals, fromNormal or (if path[1] ~= nil then path[1].normal else Vector3.yAxis))
	end
	for _, p in path do
		if #points == 0 or (points[#points] - p.pos).Magnitude > 1e-6 then
			table.insert(points, p.pos)
			table.insert(normals, p.normal)
		end
	end
	local lengths, total = {}, 0
	for i = 2, #points do
		local d = (points[i] - points[i - 1]).Magnitude
		table.insert(lengths, d)
		total += d
	end
	return { points = points, normals = normals, lengths = lengths, length = total, s = 0 }
end

-- Where the walk is at distance `s` along it: the point on the surface, the surface's normal there (turning from one face's to the next's along each leg) and
-- the direction of travel.
function PlantWalk.at(w: Walk, s: number): (Vector3, Vector3, Vector3)
	local pts, nrm = w.points, w.normals
	if #pts == 1 then return pts[1], nrm[1], Vector3.zero end
	local left = math.clamp(s, 0, w.length)
	for i, d in w.lengths do
		if left <= d or i == #w.lengths then
			local t = if d > 1e-9 then math.clamp(left / d, 0, 1) else 1
			local n = nrm[i]:Lerp(nrm[i + 1], t)
			if n.Magnitude < 1e-6 then n = nrm[i + 1] end
			local dir = if d > 1e-9 then (pts[i + 1] - pts[i]) / d else Vector3.zero
			return pts[i]:Lerp(pts[i + 1], t), n.Unit, dir
		end
		left -= d
	end
	return pts[#pts], nrm[#nrm], Vector3.zero
end

-- Moves the walk on by `distance`; returns the place, the normal, the direction (laid on the surface) and whether it has arrived.
function PlantWalk.advance(w: Walk, distance: number): (Vector3, Vector3, Vector3, boolean)
	w.s = math.min(w.length, w.s + math.max(0, distance))
	local p, n, dir = PlantWalk.at(w, w.s)
	local flat = dir - n * dir:Dot(n)
	return p, n, (if flat.Magnitude > 1e-6 then flat.Unit else Vector3.zero), w.s >= w.length - 1e-9
end

-- What is wrong with a walk put back from a record (nil for a good one).
function PlantWalk.problem(w: any): string?
	if type(w) ~= "table" or type(w.points) ~= "table" or type(w.normals) ~= "table" or type(w.lengths) ~= "table" then return "a walk with no points" end
	if #w.points < 1 or #w.normals ~= #w.points or #w.lengths ~= #w.points - 1 then return "a walk whose points do not match" end
	if type(w.s) ~= "number" or w.s ~= w.s or type(w.length) ~= "number" or w.s < 0 or w.s > w.length + 1e-6 then return "a walk out of its length" end
	return nil
end

return PlantWalk
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">PreyDirector</string>
            <string name="Source"><![CDATA[--!strict
-- Solo client world of perceivable flies. Godot order: sensor, prey, motor, capture/feeding.
-- ROBLOX-96 (W3, garden life): a director is one region's prey. Without a `spec` it is the sill's, exactly as it always was: the twelve authored perches below, the
-- two window vents, a house fly with every third fly a fruit fly when `mixed`. With a `spec` (World/Garden.prey, for the bed) its perches and vents are the
-- spec's: a perch marked `walker` is a plant perch that only a walker (the aphid, Species body.walker) is spawned on, and never needs a flight to be valid; a
-- vent marked `walker` is where an aphid appears, on a free walker perch within the vent's reach, out of the spider's sight (the population's own check), with
-- no flight. Several directors share one Feeding (the jaws): Prey/PreyWorld runs the home director's `after` with the feeding step and every other active
-- director's `afterShared`, which strikes and tidies but never advances the reserves; a fly that tears free is sent back to the director it belongs to.
-- ROBLOX-101 (W3b part A): a director per bestiary kind (World/Garden.bestiary: the springtails and leafhoppers of the bed, the moths and crane flies of the wall
-- and the outer sill), each with its kind's profile. A perch marked `hop` is one a hopper uses (it needs no flight to be valid); `behind` and `round` are the
-- leafhopper's far-side perch and the point it passes going round (Prey/PreyKinds.sidestep). A vent marked `appear` is where a prey of the director's own kind
-- appears on any free perch within the vent's reach, out of the spider's sight, with no flight (the walker vents' rule without the aphid). A hopper torn free
-- hops off if it can; a flightless one that cannot is put back as a walker is.
local Fly=require(script.Parent.Fly)
local Species=require(script.Parent.Parent.Data.Species)
local Graph=require(script.Parent.PerchGraph)
local Population=require(script.Parent.PreyPopulation)
local Feeding=require(script.Parent.Feeding)
local M=require(script.Parent.PreyMath)
local D={};D.__index=D
local POINTS: {{string | number}}={
 {'sill_first_hunt',-13,0,6},{'rim_hunt',10,4.6,-3},{'leaf_hunt',-1,4.2,-1},{'east_hunt',23,0,7},
 {'west_leaf',-15,4.2,-1},{'east_leaf',22,5.4,-2},{'under_leaf',-12.8,0,-2},{'front_path',1,0,8},
 {'east_corner',27,0,-7},{'back_path',-9,0,-9},{'rim_west',5,4.6,-5},{'rim_east',15,4.6,-5},
}
-- A region's prey, authored or generated (World/Garden.prey): `perches` { id, position, normal, shelter, food, start, walker? }, `vents` { id, position, normal,
-- walker?, reach? }, `prefix` (the flies' ids begin with it; the sill's is 'fly_').
export type Spec={perches:{any},vents:{any},prefix:string?}
function D.new(graph: any,profile: any,seed: number,target: number,mixed: boolean?,spec: Spec?): any
 local self:any=setmetatable({graph=graph,p=profile,mixed=mixed==true,seed=seed,target=target,flies={},serial=0,now=0,tick=0,
  population=Population.new(profile.population,seed+117,target),feeding=Feeding.new(),vents={},strikeEnd=-1,previousMode='attached',
  captures=0,enabled=true,cpu={},candidates=0,entryChecks=0},D)
 if spec then
  self.prefix=spec.prefix or 'fly_' -- (a region's flies carry its name, so no two flies of the world share an id)
  -- (ROBLOX-119: a spec may name the band its flights climb in, `floor` and `ceiling`, PerchGraph.plan; World/Meadow's and the hut's moths and hoverflies do)
  local band=spec::any
  if type(band.floor)=="number" and type(band.ceiling)=="number" then graph.floor=band.floor;graph.ceiling=band.ceiling end
  for _,row in spec.perches do
   local p=graph:add(row.id,row.position,row.normal,row.shelter,row.food,row.start==true)
   if row.walker then p.walker=true end
   if row.hop then p.hop=true end -- (ROBLOX-101)
   if row.behind then p.behind=row.behind;p.round=row.round end
  end
 else
  for i,row in POINTS do
   local id=row[1]::string
   graph:add(id,Vector3.new(row[2]::number,row[3]::number,row[4]::number),Vector3.yAxis,if id=='under_leaf' then .5 else .2,if string.find(id,'rim') then .5 else .1,i<=6)
  end
 end
 -- Keep only perches with a valid outgoing flight (a walker's perch needs none: nothing flies from it).
 for _,p in graph.perches do
  if p.valid and not p.walker and not p.hop then
   local linked=false;local tries=0
   for _,other in graph.perches do if other~=p and other.valid and (other.position-p.position).Magnitude<=profile.flight.max_flight_wu then
    tries+=1;if graph:plan(graph:rest(p),p.normal,other,nil) then linked=true;break end
    if tries>=5 then break end
   end end
   p.valid=linked
  end
 end
 for _,p in graph.perches do if #self.flies<target and p.start and p.valid then self:spawn(p) end end
 if spec then
  for _,v in spec.vents do
   table.insert(self.vents,{id=v.id,position=v.position,normal=v.normal,shelter=0,food=0,start=false,valid=true,occupant='',reserved='',walker=v.walker==true,reach=v.reach or 4,appear=if v.appear then true else nil})
  end
 else
  for i,x in {-23,23} do
   -- Authored window vents face into the sill. Entry paths are still swept before a fly exists.
   table.insert(self.vents,{id='vent_'..i,position=Vector3.new(x,8,-12.5),normal=Vector3.zAxis,shelter=0,food=0,start=false,valid=true,occupant='',reserved=''})
  end
 end
 return self
end
function D.spawn(self: any,perch: any): any
 self.serial+=1
 local profile = if perch.walker then Species.aphid_prototype elseif self.mixed~=false and self.serial%3==0 then Species.fruit_fly_prototype else self.p
 local f=Fly.new((self.prefix or 'fly_')..self.serial,self.serial,self.seed+self.serial*997,perch,self.graph,profile,self.now)
 table.insert(self.flies,f);return f
end
function D.percepts(self: any): {any}
 local out={};for _,f in self.flies do local p=f:percept();if p then table.insert(out,p) end end;return out
end
-- Whether this director's list holds the fly.
function D.owns(self: any,f: any): boolean
 return table.find(self.flies,f)~=nil
end
function D.before(self: any,dt: number,position: Vector3,observer: any,sensor: any,cast: any,camera: any)
 if not self.enabled then return end
 local started=os.clock();self.now+=dt;self.tick+=1;self.previousPosition=position
 local alive=0;for _,f in self.flies do if f:alive() then alive+=1 end end
 self.population:step(self.now,alive,self.vents,function(v)
  self.entryChecks+=1
  local pos=self.graph:rest(v)
  if (position-pos).Magnitude<self.p.population.vent_min_distance_wu then return false end
  if M.inView(camera.CFrame,camera.FieldOfView,camera.ViewportSize.X/math.max(1,camera.ViewportSize.Y),pos,self.p.population.vent_view_margin_deg) then return false end
  return not sensor:couldSense(observer,pos,self.p.body.radius_wu,cast)
 end,function(v)
  if v.walker then
   -- (ROBLOX-96) a walker is born on a free plant perch within the vent's reach: no flight, out of sight
   for _,target in self.graph.perches do
    if target.walker and target.valid and target.occupant=='' and target.reserved=='' and (target.position-v.position).Magnitude<=v.reach then
     self:spawn(target);return true
    end
   end
   return false
  end
  if v.appear then
   -- (ROBLOX-101) a prey of the director's kind appears on any free perch within the vent's reach: no flight, out of sight
   for _,target in self.graph.perches do
    if target.valid and target.occupant=='' and target.reserved=='' and (target.position-v.position).Magnitude<=v.reach then
     self:spawn(target);return true
    end
   end
   return false
  end
  for _,target in self.graph.perches do
   if target.valid and target.occupant=='' and target.reserved=='' then
    local path=self.graph:plan(self.graph:rest(v),v.normal,target,nil)
    if path and M.pathLength(path)>=self.p.population.entry_min_flight_wu then
     local f=self:spawn(v);f.flight:begin(path,target,'move',self.now);return true
    end
   end
  end
  return false
 end)
 for _,f in self.flies do f:step(dt,self.now,position,.3,cast) end
 self.beforeCost=(os.clock()-started)*1e6
end
function D.escape(self: any,f: any)
 if f.profile.body.flightless then
  -- (ROBLOX-101) a flightless hopper torn free flicks away if it can, and otherwise is put back as a walker is (below)
  f.state='ALERT';f.stateSince=self.now;f.senses.awareness=f.profile.senses.awareness_max
  f.senses.hasLastSeen=true;f.senses.lastSeenPosition=self.previousPosition;f.senses.lastSeenTime=self.now
  if f:launch('flee',self.now) then return end
 end
 if f.profile.body.walker or f.profile.body.flightless then
  -- (ROBLOX-96) a walker that tears free is back on its perch if the perch is still free; if not, it is gone (the population owes another)
  local perch=f.perch;f.creep=nil;f.heldBy=nil -- (ROBLOX-105: a creep or a ladybird's meal does not survive the jaws)
  if perch and perch.occupant=='' then
   perch.occupant=f.id;f.position=self.graph:rest(perch);f.prevPosition=f.position;f.normal=perch.normal;f.velocity=Vector3.zero
   f.state='ALERT';f.stateSince=self.now;f.goal='rest';f.goalSince=self.now;f:beginStay(self.now)
  else
   f.state='CONSUMED'
  end
  return
 end
 f.state='SEEK_PERCH';f.stateSince=self.now;f.senses.awareness=f.profile.senses.awareness_max
 f.senses.hasLastSeen=true;f.senses.lastSeenPosition=self.previousPosition;f.senses.lastSeenTime=self.now
 f:launch('flee',self.now)
end
-- The strike: a sweep of the spider's body against every living fly while a strike window is open, and a capture into the jaws. Returns the time it took.
function D.strike(self: any,motor: any,sensor: any,cast: any)
 if motor.mode=='air' and self.previousMode~='air' then
  for _,event in motor.events do if event.kind=='launched' then self.strikeEnd=self.tick+240;break end end
 end
 if self.previousMode=='air' and motor.mode~='air' then self.strikeEnd=math.min(self.strikeEnd,self.tick+3) end
 self.previousMode=motor.mode
 if self.tick<=self.strikeEnd and not self.feeding.held then
  for _,f in self.flies do if f:alive() and not (f.freeUntil and f.freeUntil>self.now) then -- (ROBLOX-101: freeUntil, a prey that just slipped the jaws)
   local t,d=M.sweepClosest(self.previousPosition,motor.pos,f.prevPosition,f.position)
   if d<=f.profile.body.capture_radius_wu+.3 then
    local a=self.previousPosition:Lerp(motor.pos,t);local b=f.prevPosition:Lerp(f.position,t)
    if not cast(a,b) then
     f.flight:release();if f.perch and f.perch.occupant==f.id then f.perch.occupant='' end
     if f.hop then if f.hop.target and f.hop.target.reserved==f.id then f.hop.target.reserved='' end;f.hop=nil end;f.side=nil -- (ROBLOX-101: caught mid-hop or mid-sidestep)
     f.state='CAPTURED';f.captureSerial+=1;f.captureKey=f.id..':'..f.captureSerial;f.velocity=Vector3.zero
     sensor:onCapture(b,f.profile.body.radius_wu);self.feeding:capture(f);self.captures+=1;break
    end
   end
  end end
 end
end
-- Flies that have been eaten leave the list.
function D.tidy(self: any)
 for i=#self.flies,1,-1 do if self.flies[i].state=='CONSUMED' then table.remove(self.flies,i) end end
end
-- After the motor: the strike, the feeding (the reserves advance here, once a tick), the meal held in the jaws, and the tidying. `escape` (optional, PreyWorld's)
-- takes a fly that tore free; without it the fly is this director's own.
function D.after(self: any,dt: number,motor: any,sensor: any,cast: any,escape: ((any)->())?)
 if not self.enabled then return end
 local started=os.clock()
 self:strike(motor,sensor,cast)
 self.feeding:step(dt,motor.mode=='attached' and not motor.preparing,motor.moving or motor.vel.Magnitude>.15,escape or function(f) self:escape(f) end)
 local held=self.feeding.held
 if held then
  held.position=motor:eyePosition()+motor.heading*(if self.feeding.struggling then .42 else .2)+motor.up*(if self.feeding.struggling then .04 else -.13)
  held.normal=motor.up;held.heading=motor.heading;held.prevPosition=held.position
 end
 self:tidy()
 table.insert(self.cpu,(self.beforeCost or 0)+(os.clock()-started)*1e6);if #self.cpu>1200 then table.remove(self.cpu,1) end
end
-- After the motor, for a director whose jaws are another's (ROBLOX-96): the strike and the tidying only; the feeding step and the held fly are the home
-- director's, run once a tick.
function D.afterShared(self: any,motor: any,sensor: any,cast: any)
 if not self.enabled then return end
 local started=os.clock()
 self:strike(motor,sensor,cast)
 self:tidy()
 table.insert(self.cpu,(self.beforeCost or 0)+(os.clock()-started)*1e6);if #self.cpu>1200 then table.remove(self.cpu,1) end
end
-- The engine's geometry for a director: the casts against `world` and the clearance probe. Several directors may share one (PreyWorld: one set of closures, so a
-- checkpoint names them once).
function D.casts(world: Instance): any
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={world}
 local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Include;overlap.FilterDescendantsInstances={world}
 local probe=Instance.new('Part');probe.Name='FlyClearanceProbe';probe.Shape=Enum.PartType.Ball;probe.Anchored=true;probe.CanCollide=false;probe.CanQuery=false;probe.CanTouch=false;probe.Transparency=1;probe.Parent=workspace
 return {
  probe=probe,
  cast=function(a: Vector3,b: Vector3) return workspace:Raycast(a,b-a,params) end,
  sweep=function(a: Vector3,b: Vector3,r: number) if (b-a).Magnitude<1e-7 then return false end;return workspace:Spherecast(a,r,b-a,params)~=nil end,
  overlap=function(a: Vector3,r: number) probe.Size=Vector3.one*r*2;probe.Position=a;return #workspace:GetPartsInPart(probe,overlap)>0 end,
 }
end
function D.engine(world: Instance,profile: any,seed: number,target: number,mixed: boolean?,spec: Spec?,casts: any?): any
 local c=casts or D.casts(world)
 local graph=Graph.new(c.cast,c.sweep,c.overlap,profile)
 local self=D.new(graph,profile,seed,target,mixed,spec);self.probe=c.probe;return self
end
return D
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">PreyKinds</string>
            <string name="Source"><![CDATA[--!strict
-- The bestiary's prey behaviours (ROBLOX-101, W3b part A), kept out of the frozen fly model: Prey/Fly calls in here only for a profile whose body asks for it
-- (Data/Species: `hop`, `sidestep`, `dusk`/`day`, `slip_chance`, `shed_chance`), and Godot's profiles ask for none of them, so the house fly, the fruit fly,
-- the gnat and the aphid run exactly as before. Game rules, not measurements; every draw is the fly's own PreyRandom stream (recorded with it), so a rest
-- puts back a moth that has used its slip, or a crane fly with a leg gone, and replays the same.
--   the hop ......... a ballistic escape on the reaction model (the springtail's flick, the leafhopper's jump): a parabola from where it stands to a free perch
--                     of its kind (or, on level ground, a spot on the same surface) between the hop's `min` and `max`, away from the danger, swept for
--                     clearance before it leaves; in the air for `time`, as high as `apex`; it lands perched and may fly on (`fly_after`)
--   the sidestep .... (the leafhopper) alert and watched from its own side, it goes round its stem or leaf to the perch on the far side (`behind`), passing the
--                     perch's `round` point, in `time` seconds, and not again for `rest`
--   dusk ............ a director of a kind with a `dusk` profile swaps every fly of it to that profile from dusk through the night and back by day; the
--                     restlessness each fly drew is kept, its clock of restlessness starts again at the change (so they do not all take off at once)
--   the grip ........ the moth's slip (the first grip on it fails at `slip_chance`, once) and the crane fly's shed leg (once, at `shed_chance`, `shed_after`
--                     seconds into the struggle): the prey leaves the jaws and escapes as a torn-free fly does
--   the ear ......... (ROBLOX-120, the field cricket: body.hear) a spider moving faster than `still` studs a second within `range` studs hushes it: it falls silent and
--                     holds still (no walk, no fidget) for `hold` seconds after the last it heard; a `freeze` profile alert freezes where it stands (as a walker
--                     does) until it jumps; a `chirp` profile (the night's) sings while it is perched, calm and not hushed, the males only (odd serials)
--   the kick ........ (ROBLOX-120, the field cricket: body.kick) in the jaws its hind legs kick: `first` seconds in and then every `every`, each takes `size` times its
--                     strength off the grip (on top of the struggle's jerks), from its own stream; a grip that falls to nothing is a prey torn free
--   the creep ....... (ROBLOX-105, the aphid: body.creep) now and then, perched and calm, it walks slowly over its plant's faces to another free perch of the
--                     same plant (World/Garden.plantPath: down its stem or round its rosette and out along the other leaf), at `speed`, every `every`
--                     seconds; startled on the way it freezes where it is; it never leaves its plant
local Species = require(script.Parent.Parent.Data.Species)
local Garden = require(script.Parent.Parent.World.Garden)
local PlantWalk = require(script.Parent.PlantWalk)

local K = {}

-- (ROBLOX-105) The aphid's creep (a profile with body.creep): carries on one under way (true while it moves or stands frozen on the way), or, perched, calm, not
-- walking or fidgeting and its time come, begins one to a free perch of its own plant within `reach` studs of walking (the stream draws the perch and the next
-- time). An aphid a ladybird is eating (`heldBy`) does not set off.
function K.creep(f: any, now: number, dt: number): boolean
	local c = f.creep
	local hover = f.profile.body.hover_wu
	if c ~= nil then
		if f.state ~= "PERCHED" and f.state ~= "ALERT" then f.creep = nil; return false end
		if f.state == "ALERT" then return true end -- (startled on the way: it freezes where it is)
		local p, n, dir, done = PlantWalk.advance(c, (f.creepSpeed or 0.1) * dt)
		f.position = p + n * hover
		f.normal = n
		if dir.Magnitude > 0.5 then f.heading = dir end
		if done then
			f.creep = nil
			f.normal = f.perch.normal
			f.position = f.graph:rest(f.perch)
			local t = f.heading - f.normal * f.heading:Dot(f.normal)
			if t.Magnitude > 1e-3 then f.heading = t.Unit end
			f.restSpot = f.position; f.homeHeading = f.heading; f.walkLeft = 0; f.fidgetUntil = 0; f.perchedSince = now
		end
		return true
	end
	local spec = f.profile.body.creep
	if spec == nil or f.state ~= "PERCHED" or f.walkLeft > 0 or now < f.fidgetUntil or f.heldBy ~= nil or f.perch == nil then return false end
	if f.creepNext == nil then f.creepNext = now + f.rng:draw(spec.every); return false end
	if now < f.creepNext then return false end
	f.creepNext = now + f.rng:draw(spec.every)
	local here = f.perch
	local name, plants = Garden.plantOf(here.id)
	if name == nil or plants == nil then return false end
	local plant = plants[name]
	local list = {}
	for _, other in f.graph.perches do
		if other ~= here and other.walker and other.valid and other.occupant == "" and other.reserved == "" and plant.nodes[other.id] ~= nil then
			local path = Garden.plantPath(plant, here.id, other.id)
			if path ~= nil then
				local w = PlantWalk.new(path, f.position - f.normal * hover, f.normal)
				if w.length <= spec.reach then table.insert(list, { perch = other, walk = w }) end
			end
		end
	end
	if #list == 0 then return false end
	local pick = list[1 + math.floor(f.rng:next() * #list) % #list]
	if here.occupant == f.id then here.occupant = "" end
	pick.perch.occupant = f.id
	f.perch = pick.perch
	f.creep = pick.walk
	f.creepSpeed = f.rng:draw(spec.speed)
	f.creeps = (f.creeps or 0) + 1
	f.glanceTarget = nil
	return true
end

-- (ROBLOX-117) The hoverfly's hover (a profile with body.hover): on a calm flight (REPOSITION: not a flight from the spider), once a flight and at `chance`, part of the way
-- along, it stops dead in the air and holds there, wavering a little, for `hold` seconds drawn from its stream; then the flight goes on from a standstill at its quick
-- cruise (the dart). Startled while it holds, it flees as any fly does. Returns true while it holds (the flight does not step).
function K.hover(f: any, now: number, _dt: number): boolean
	local h = f.profile.body.hover
	local flight = f.flight
	if f.state ~= "REPOSITION" or flight.length <= 1e-6 then f.hoverUntil = nil; return false end
	if f.hoverUntil ~= nil then
		if now < f.hoverUntil then
			local t = now - (f.hoverSince or now)
			local at = f.hoverAt :: Vector3
			f.position = at + Vector3.new(math.sin(t * 7.3) * h.waver, math.sin(t * 5.1) * h.waver * 0.6, math.cos(t * 6.1) * h.waver)
			flight.speed = 0
			return true
		end
		f.hoverUntil = nil
		return false
	end
	if f.hoveredFlight ~= flight.started and flight.s > flight.length * 0.3 and flight.s < flight.length * 0.75 then
		f.hoveredFlight = flight.started
		if f.rng:next() < h.chance then
			f.hoverSince, f.hoverUntil, f.hoverAt = now, now + f.rng:draw(h.hold), f.position
			f.hovers = (f.hovers or 0) + 1
			flight.speed = 0
			return true
		end
	end
	return false
end

-- The arc's points along the hop: s from 0 to 1.
local function arcPoint(from: Vector3, to: Vector3, apex: number, s: number): Vector3
	return from:Lerp(to, s) + Vector3.yAxis * (4 * apex * s * (1 - s))
end
K.arcPoint = arcPoint

-- Whether the whole arc is clear for the fly's graph (six chords).
local function arcClear(f: any, from: Vector3, to: Vector3, apex: number): boolean
	local prev = from
	for i = 1, 6 do
		local p = arcPoint(from, to, apex, i / 6)
		if not f.graph:clear(prev, p) then return false end
		prev = p
	end
	return true
end

local function begin(f: any, target: any, to: Vector3, normal: Vector3, now: number): boolean
	local h = f.profile.body.hop
	f.flight:release()
	f.side = nil
	if target ~= nil then
		if f.perch and f.perch.occupant == f.id then f.perch.occupant = "" end
		target.reserved = f.id
	end
	local d = (to - f.position).Magnitude
	f.hop = { from = f.position, to = to, apex = h.apex, t0 = now, time = h.time * (0.6 + 0.4 * math.clamp(d / h.max, 0, 1)), target = target, normal = normal }
	f.state = "HOP"; f.stateSince = now; f.goal = "flee"; f.goalSince = now; f.walkLeft = 0; f.pending = nil
	f.hops = (f.hops or 0) + 1
	return true
end

-- The escape hop, from where the fly is (perched, alert or in the jaws): true when one began.
function K.hop(f: any, now: number): boolean
	local h = f.profile.body.hop
	if h == nil or f.hop ~= nil then return false end
	local from = f.position
	local danger = if f.senses.hasLastSeen then f.senses.lastSeenPosition else from - f.heading
	local here = (from - danger).Magnitude
	local list = {}
	for _, c in f.graph.perches do
		if c ~= f.perch and c.valid and c.occupant == "" and c.reserved == "" then
			local rest = f.graph:rest(c)
			local d = (rest - from).Magnitude
			local away = (rest - danger).Magnitude
			if d >= h.min and d <= h.max and away > here then table.insert(list, { perch = c, rest = rest, score = away + c.shelter * 2 }) end
		end
	end
	table.sort(list, function(a: any, b: any) return a.score > b.score or (a.score == b.score and a.perch.id < b.perch.id) end)
	for i, c in list do
		if i > 4 then break end
		if arcClear(f, from, c.rest, h.apex) then return begin(f, c.perch, c.rest, c.perch.normal, now) end
	end
	-- level ground: a spot on the surface it stands on, away from the danger, half way between the hop's shortest and longest
	if f.normal:Dot(Vector3.yAxis) > 0.9 then
		local away = from - danger
		local base = if Vector3.new(away.X, 0, away.Z).Magnitude > 1e-3 then math.atan2(away.X, away.Z) else math.atan2(f.heading.X, f.heading.Z)
		local dist = (h.min + h.max) / 2
		for i = 0, 7 do
			local a = base + (if i % 2 == 0 then 1 else -1) * math.floor((i + 1) / 2) * math.pi / 4
			local spot = Vector3.new(from.X + math.sin(a) * dist, from.Y, from.Z + math.cos(a) * dist)
			local hit = f.graph.cast(spot + Vector3.yAxis * 0.6, spot - Vector3.yAxis * 1.0)
			if hit and hit.Normal:Dot(Vector3.yAxis) > 0.98 then
				local rest = hit.Position + Vector3.yAxis * f.graph.p.body.hover_wu
				if arcClear(f, from, rest, h.apex) then return begin(f, nil, rest, Vector3.yAxis, now) end
			end
		end
	end
	return false
end

-- One tick of a hop in the air; it lands at the end.
function K.step(f: any, now: number, _dt: number)
	local h = f.hop
	local s = math.clamp((now - h.t0) / h.time, 0, 1)
	local p = arcPoint(h.from, h.to, h.apex, s)
	local flat = Vector3.new(p.X - f.position.X, 0, p.Z - f.position.Z)
	if flat.Magnitude > 1e-4 then f.heading = flat.Unit end
	f.position = p
	if s < 1 then return end
	f.hop = nil
	local target = h.target
	if target ~= nil then
		if target.reserved == f.id then target.reserved = "" end
		if target.occupant == "" then target.occupant = f.id end
		f.perch = target
		f.position = f.graph:rest(target)
		f.normal = target.normal
	else
		f.position = h.to
		f.normal = h.normal
		if f.perch and f.perch.occupant == "" then f.perch.occupant = f.id end
	end
	-- a heading along the new normal has no turn to give: lay it flat on the surface
	local tangent = f.heading - f.normal * f.heading:Dot(f.normal)
	f.heading = if tangent.Magnitude > 1e-3 then tangent.Unit else (if math.abs(f.normal.Y) > 0.9 then Vector3.new(0, 0, -1) else Vector3.yAxis)
	f.state = "PERCHED"; f.stateSince = now; f.goal = "rest"; f.goalSince = now
	f:beginStay(now)
	local after = f.profile.body.hop.fly_after
	if after ~= nil and not f.profile.body.flightless and f.rng:next() < after then f:launch("move", now) end
end

-- A flier of the bestiary (flight.home_in) in the air with no perch within a flight (one that slipped the jaws far from its perches, carried there by the
-- spider): a leg of open flight toward the nearest free perch, at most four fifths of its longest flight, then it looks again. True when one began.
function K.homeIn(f: any, now: number): boolean
	local best: any, far = nil, math.huge
	for _, c in f.graph.perches do
		if c.valid and c.occupant == "" and c.reserved == "" then
			local d = (f.graph:rest(c) - f.position).Magnitude
			if d < far then best, far = c, d end
		end
	end
	if best == nil then return false end
	local p = f.profile.flight
	local to = f.graph:rest(best) + best.normal * p.approach_wu
	local dir = (to - f.position).Unit
	local step = math.min(far - p.approach_wu, p.max_flight_wu * 0.8)
	for _, rise in { 0, 2, 4 } do
		local point = f.position + dir * step + Vector3.yAxis * rise
		if f.graph:clear(f.position, point) then
			f.flight:begin({ f.position, point }, nil, "move", now)
			f.homing = (f.homing or 0) + 1
			return true
		end
	end
	return false
end

-- A fly standing on a surface with its heading along the surface's normal (a flight that ended square on to the wall, a fly spawned on the wall) has no way to
-- turn or walk and no frame to be drawn in: its heading is laid on the surface, head up a wall (along the world's up, or along -Z on a level face).
function K.upright(f: any)
	local up = if math.abs(f.normal.Y) > 0.9 then Vector3.new(0, 0, -1) else Vector3.yAxis
	f.heading = (up - f.normal * up:Dot(f.normal)).Unit
	f.homeHeading = f.heading
end

-- The sidestep (a profile with body.sidestep): carries on one under way, or begins one when the fly is alert, watched from its own side and the perch behind
-- is free. True while it is moving round.
function K.sidestep(f: any, now: number, _dt: number): boolean
	local s = f.side
	if s ~= nil then
		local t = math.clamp((now - s.t0) / s.time, 0, 1)
		local u = 1 - t
		f.position = s.from * (u * u) + s.ctrl * (2 * u * t) + s.to * (t * t)
		if t >= 1 then
			f.side = nil
			f.normal = s.normal
			f.restSpot = f.position; f.homeHeading = f.heading; f.walkLeft = 0; f.fidgetUntil = 0
		end
		return true
	end
	if f.state ~= "ALERT" or not f.senses.hasLastSeen or now < (f.sideNext or 0) then return false end
	local perch = f.perch
	if perch == nil or perch.behind == nil then return false end
	if (f.senses.lastSeenPosition - f.position):Dot(f.normal) <= 0 then return false end -- already on the far side from the spider
	local other: any = nil
	for _, c in f.graph.perches do if c.id == perch.behind then other = c; break end end
	if other == nil or not other.valid or other.occupant ~= "" or other.reserved ~= "" then return false end
	local spec = f.profile.body.sidestep
	if perch.occupant == f.id then perch.occupant = "" end
	other.occupant = f.id
	f.perch = other
	local to = f.graph:rest(other)
	local round: Vector3 = perch.round or (f.position + to) / 2
	f.side = { from = f.position, to = to, ctrl = round * 2 - (f.position + to) / 2, t0 = now, time = spec.time, normal = other.normal }
	f.sideNext = now + spec.time + spec.rest
	f.sidesteps = (f.sidesteps or 0) + 1
	return true
end

-- The profile of the same animal for the other part of the day, or nil when `p` is already the right one (or has none).
function K.counterpart(p: any, dusk: boolean): any
	local name = if dusk then p.body.dusk else p.body.day
	if name == nil then return nil end
	return (Species :: any)[name]
end

-- Dusk or day for a director of a kind with a dusk profile: swaps the director's profile (what it spawns) and every fly's.
function K.light(d: any, dusk: boolean)
	local to = K.counterpart(d.p, dusk)
	if to == nil then return end
	local from = d.p
	d.p = to
	for _, f in d.flies do
		if f.profile == from then
			local rate = from.behavior.restless_per_s
			f.restlessRate = if rate > 0 then f.restlessRate / rate * to.behavior.restless_per_s else to.behavior.restless_per_s
			f.profile = to
			f.perchedSince = d.now
		end
	end
	d.dusk = dusk
end

-- Whether an hour of the life clock is the moths' time: from `from` (dusk) through the night to `to` (dawn).
function K.isDusk(hour: number, from: number, to: number): boolean
	return hour >= from or hour < to
end

-- (ROBLOX-120) The ear (a profile with body.hear), each tick before the fly's senses: the spider at `stimulus` moving within range hushes it.
function K.hear(f: any, now: number, dt: number, stimulus: Vector3)
	local h = f.profile.body.hear
	local last = f.heardFrom
	f.heardFrom = stimulus
	if last == nil or dt <= 0 or not f:alive() then return end
	if (stimulus - last).Magnitude / dt >= h.still and (stimulus - f.position).Magnitude <= h.range then
		if now >= (f.hushUntil or 0) then f.hushes = (f.hushes or 0) + 1 end
		f.hushUntil = now + h.hold
	end
	f.hushed = now < (f.hushUntil or 0) -- (what the drawing and the client's ears read, with no clock of the director's)
end
-- (ROBLOX-120) Whether it is hushed (it heard the spider lately): it holds still.
function K.hushed(f: any, now: number): boolean
	return f.profile.body.hear ~= nil and now < (f.hushUntil or 0)
end
-- (ROBLOX-120) Whether it is singing now: a chirping profile (the night's), a male (an odd serial), perched and calm, not hushed, alive.
function K.chirping(f: any): boolean
	return f.profile.body.chirp == true and f.serial % 2 == 1 and f.state == "PERCHED" and f.hop == nil and f.hushed ~= true and f:alive()
end

-- The grip on a struggling prey, each tick before the jaws' own step: a moth's first grip may slip, a crane fly may leave a leg, a cricket kicks (ROBLOX-120: its kicks
-- take grip; the jaws' own step lets it go when the grip is gone). Returns "slip" or "shed" when the prey got away (it is out of the jaws and `escape` has taken it),
-- else nil.
function K.grip(feeding: any, escape: (any) -> ()): string?
	local f = feeding.held
	if f == nil or not feeding.struggling then return nil end
	local b = f.profile.body
	if b.kick ~= nil and feeding.elapsed > 0 then
		if f.kickAt == nil then f.kickAt = f.rng:draw(b.kick.first) end
		if feeding.elapsed >= f.kickAt then
			local strength = 1 - (feeding.tire or 0.5) * math.clamp(feeding.elapsed / math.max(feeding.venom, 1e-3), 0, 1)
			feeding.grip -= b.kick.size * strength
			f.kicks = (f.kicks or 0) + 1
			f.kickAt = feeding.elapsed + f.rng:draw(b.kick.every)
		end
	end
	local what: string? = nil
	if b.slip_chance ~= nil and not f.slipDrawn then
		f.slipDrawn = true
		if f.rng:next() < b.slip_chance then what = "slip" end
	end
	if what == nil and b.shed_chance ~= nil and not f.shedDrawn then
		f.shedDrawn = true
		if f.rng:next() < b.shed_chance then f.shedAt = f.rng:draw(b.shed_after) end
	end
	if what == nil and f.shedAt ~= nil and feeding.elapsed >= f.shedAt then
		f.shedAt = nil
		f.legsLost = (f.legsLost or 0) + 1
		what = "shed"
	end
	if what == nil then return nil end
	feeding.held = nil
	feeding.struggling = false
	feeding.feeding = false
	feeding.note = if what == "slip" then "It slipped free." else "It left a leg and got away."
	escape(f)
	return what
end

return K
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">PreyMath</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen scripts/prey/prey_math.gd: explicit evidence, utility and swept-contact math.
local M = {}
local EPS = 1e-6
function M.sweepClosest(a0: Vector3,a1: Vector3,b0: Vector3,b1: Vector3): (number,number)
 local d=a0-b0; local dv=a1-b1-d
 local t=if dv:Dot(dv)>EPS*EPS then math.clamp(-d:Dot(dv)/dv:Dot(dv),0,1) else 0
 return t,(d+dv*t).Magnitude
end
function M.apparentAngle(radius: number,distance: number): number return 2*math.atan(math.max(radius,0)/math.max(distance,EPS)) end
function M.bearingRate(a: Vector3,b: Vector3,dt: number): number
 if dt<=EPS or a:Dot(a)<EPS or b:Dot(b)<EPS then return 0 end
 return math.deg(math.acos(math.clamp(a.Unit:Dot(b.Unit),-1,1)))/dt
end
function M.loomRate(old: number,angle: number,dt: number,scale: number): number
 return if dt<=EPS or angle<=EPS then 0 else scale*math.max(0,((angle-old)/dt)/angle)
end
function M.distanceWeight(d: number,full: number,zero: number): number
 if zero<=full then return if d<=full then 1 else 0 end
 return math.clamp((zero-d)/(zero-full),0,1)
end
function M.facingWeight(angle: number,front: number,rear: number,gain: number): number
 if angle<=front then return 1 end
 if angle>=rear or rear<=front then return gain end
 local t=(angle-front)/(rear-front); return 1+(gain-1)*t*t*(3-2*t)
end
function M.awarenessGain(motion: number,threshold: number,scale: number,distance: number,facing: number,visible: number,vigilance: number): number
 return if motion<=threshold or scale<=EPS then 0 else (motion-threshold)/scale*distance*facing*math.clamp(visible,0,1)*math.max(vigilance,0)
end
function M.integrateAwareness(a: number,gain: number,dt: number,decay: number,maximum: number): number
 return math.clamp(a+(if gain>0 then gain else -decay)*math.max(dt,0),0,maximum)
end
function M.threat(a: number,calm: number,flee: number): number
 if flee<=calm then return if a>=flee then 1 else 0 end
 return math.clamp((a-calm)/(flee-calm),0,1)
end
function M.scoreRest(w: any,fatigue: number,shelter: number,food: number,threat: number): number
 return w.rest_base+w.rest_fatigue*fatigue+w.rest_shelter*shelter+w.rest_food*food-w.rest_threat*threat
end
function M.scoreMove(w: any,restless: number,food: number,shelter: number,travel: number,fatigue: number,threat: number): number
 return w.move_restless*restless+w.move_food*food+w.move_shelter*shelter-w.move_travel*travel-w.move_fatigue*fatigue-w.move_threat*threat
end
function M.scoreFlee(w: any,threat: number,shelter: number,away: number,travel: number): number
 return threat*(w.flee_threat+w.flee_shelter*shelter+w.flee_away*away-w.flee_travel*travel)
end
function M.pickGoal(scores: {[string]:number},current: string,hysteresis: number): string
 local best,value=current,-math.huge
 for _,g in {'rest','move','flee'} do
  if scores[g] then local v=scores[g]+(if g==current then hysteresis else 0); if v>value+1e-9 then best,value=g,v end end
 end
 return best
end
function M.pathLength(points: {Vector3}): number
 local total=0; for i=2,#points do total+=(points[i]-points[i-1]).Magnitude end; return total
end
function M.pointAt(points: {Vector3},s: number): Vector3
 if #points==0 then return Vector3.zero end
 if s<=0 or #points==1 then return points[1] end
 for i=2,#points do local n=(points[i]-points[i-1]).Magnitude
  if s<=n then return if n<EPS then points[i-1] else points[i-1]:Lerp(points[i],s/n) end; s-=n
 end
 return points[#points]
end
function M.distanceToPath(points: {Vector3},p: Vector3): number
 if #points==0 then return math.huge end
 local best=(points[1]-p).Magnitude
 for i=2,#points do local a=points[i-1];local ab=points[i]-a
  local t=if ab:Dot(ab)<EPS*EPS then 0 else math.clamp((p-a):Dot(ab)/ab:Dot(ab),0,1)
  best=math.min(best,(a+ab*t-p).Magnitude)
 end
 return best
end
function M.targetSpeed(remaining: number,top: number,landing: number,slow: number): number
 return if slow<=EPS or remaining>=slow then top else landing+(top-landing)*math.clamp(remaining/slow,0,1)
end
function M.stepSpeed(speed: number,target: number,accel: number,dt: number): number
 return if speed>=target then target else math.min(speed+accel*dt,target)
end
function M.inView(cf: CFrame,fov: number,aspect: number,p: Vector3,margin: number): boolean
 local v=cf:PointToObjectSpace(p);if v.Z>=-EPS then return false end
 return math.atan2(math.abs(v.X),-v.Z)<=math.atan(math.tan(math.rad(fov)*.5)*math.max(aspect,.1))+math.rad(margin)
  and math.atan2(math.abs(v.Y),-v.Z)<=math.rad(fov)*.5+math.rad(margin)
end
return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="120">
          <Properties>
            <string name="Name">PreyPopulation</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen prey_population.gd: delayed, twice-unseen vent entries; never teleport a replacement onto a perch.
local R=require(script.Parent.PreyRandom)
local P={};P.__index=P
function P.new(profile: any,seed: number,target: number): any
 return setmetatable({p=profile,rng=R.new(seed),target=target,owed={},eligible={},rest={},nextCheck=0,entries=0,deferred=0},P)
end
function P.step(self: any,now: number,living: number,vents: {any},safe: (any)->boolean,enter: (any)->boolean)
 local missing=math.max(0,self.target-living)
 while #self.owed>missing do table.remove(self.owed) end
 while #self.owed<missing do table.insert(self.owed,now+self.rng:draw(self.p.replenish_delay_s)) end
 table.sort(self.owed)
 if #self.owed==0 or now<self.owed[1] or now<self.nextCheck then return end
 self.nextCheck=now+self.p.replenish_retry_s
 for _,vent in vents do
  if now>=(self.rest[vent.id] or 0) and safe(vent) then
   local old=self.eligible[vent.id]
   self.eligible[vent.id]=now
   if old and now-old<=self.p.replenish_retry_s*1.6+1e-6 and enter(vent) then
    table.remove(self.owed,1);self.rest[vent.id]=now+6;self.eligible[vent.id]=nil;self.entries+=1;return
   end
  else self.eligible[vent.id]=nil end
 end
 self.deferred+=1
end
return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="121">
          <Properties>
            <string name="Name">PreyRandom</string>
            <string name="Source"><![CDATA[--!strict
-- A repeatable port stream (Park-Miller); Godot's random inputs are exported for parity fixtures.
local R={};R.__index=R
function R.new(seed: number): any return setmetatable({state=math.max(1,math.floor(seed)%2147483647)},R) end
function R.next(self: any): number self.state=(self.state*16807)%2147483647;return self.state/2147483647 end
function R.draw(self: any,pair: {number}): number return pair[1]+(pair[2]-pair[1])*self:next() end
-- ROBLOX-106: a stream whose seed is a hash of whole numbers (FNV-1a, 32 bits, exact in doubles), drawn twice before use. The draws of W4's rules use it so that the
-- streams of neighbouring days, nights, visits or legs are not fixed offsets of one another (a plain Park-Miller seed made from a linear mix gives first draws that step
-- round the unit interval by a constant, which reads as a schedule).
function R.mixed(...: number): any
	local h = 2166136261
	for i = 1, select("#", ...) do
		local v = math.floor((select(i, ...))) % 4294967296
		for k = 0, 3 do
			h = bit32.bxor(h, bit32.band(bit32.rshift(v, 8 * k), 255))
			h = (h * 403 + bit32.lshift(h, 24)) % 4294967296 -- (h x 16777619, the FNV prime, mod 2^32: 16777619 = 2^24 + 403)
		end
	end
	local r = R.new(h % 2147483646 + 1)
	r:next()
	r:next()
	return r
end
return R
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="122">
          <Properties>
            <string name="Name">PreyWorld</string>
            <string name="Source"><![CDATA[--!strict
-- The prey of the whole world (ROBLOX-96, W3): one Prey/PreyDirector per region that has prey, run only where the spider is. The sill's director is the one the
-- client always had (`home`: its flies, its seed 914, its Feeding, which is the jaws and the only one that advances the reserves); the bed's is made from
-- World/Garden.prey(region) with the region's own seed (WorldMap.seed) when the bed has first arrived whole and the spider is in it or beside it, and it keeps
-- its own PreyRandom streams and its own clock ever after: crossing a seam rerolls nothing, and a region the spider has left simply waits (its clock stops) with its
-- flies where they were. The gate is Client/WorldClient:regionReady (`world`): a region's director is never made, and never steps, while a box of the region may
-- be missing, since every perch and every flight is a raycast. A neighbour's prey runs only when the farthest of its perches is inside ACTIVE_RADIUS (the
-- streaming radius always sent) of the spider. The woodlice (Prey/Woodlouse) run beside the bed's director under the same gate, and are never swept.
-- The directors share one set of casts (PreyDirector.casts: one probe, one set of closures) so a checkpoint names them once; the bed's director and its woodlice
-- live in `garden` (the table Persistence/Checkpoint records as its `garden` root), so a rest under the stone keeps the bed's prey and puts it back where it was.
-- ROBLOX-101 (W3b part A): the bestiary's prey, a director per kind per region (World/Garden.bestiary: springtails and leafhoppers in the bed, moths and crane
-- flies on the wall and the outer sill), kept in the region's entry as `kinds` ({ [kind] = director }) and run in the spec's order beside W3's director, under the
-- same gate. Each is made with its kind's profile, its own seed and the tier's target (`tier`: "full" or "low", the client's detail tier, read when a director is
-- made). The moths and the crane flies follow the life clock's hour (`before`'s `hour`): restless from dusk through the night (Prey/PreyKinds.light). A moth's
-- slip and a crane fly's shed leg are decided here, on the jaws, before their step (PreyKinds.grip), and the last of them is kept as `event` for the screen.
-- The prey outside the sill never runs while the spider is on the sill itself (its neighbour the outer sill has prey now): the sill plays as it always did.
-- ROBLOX-105 (W3b part B): the garden's ambient bugs that are not food (World/Garden.ambient: ladybirds on the bed's plants, millipedes and a snail on its soil
-- and a harvestman in its litter, a harvestman on the house wall), a colony per kind per region (Prey/Ladybird, Millipede, Snail, Harvestman), kept in the
-- region's entry as `ambient` ({ [kind] = colony }), made under the same gate and stepped beside the woodlice. None of them, and no longer the woodlice, is
-- shown to the spider's senses: the perception modules know only movement, possible prey and fly-like prey, and a movement contact carries no name the HUD
-- could caption "not food", so (Nathan's W3 call) they are left out of `percepts` rather than shown as movement the player might hunt. A strike that comes
-- within one of them is refused (`event` { kind = "refused", prey = kind }, UI/PreyText) and the creature answers (a ladybird bleeds, a millipede coils, the
-- snail withdraws, a woodlouse runs for cover); nothing of theirs is ever held.
local PreyDirector = require(script.Parent.PreyDirector)
local PreyKinds = require(script.Parent.PreyKinds)
local Woodlouse = require(script.Parent.Woodlouse)
local Ladybird = require(script.Parent.Ladybird)
local Millipede = require(script.Parent.Millipede)
local Snail = require(script.Parent.Snail)
local Harvestman = require(script.Parent.Harvestman)
local Ant = require(script.Parent.Ant) -- (ROBLOX-119: the meadow's ants)
local Skater = require(script.Parent.Skater) -- (ROBLOX-122: the pond's water striders)
local Species = require(script.Parent.Parent.Data.Species)
local Garden = require(script.Parent.Parent.World.Garden)
local Region = require(script.Parent.Parent.World.Region)

local PreyWorld = {}
PreyWorld.__index = PreyWorld

-- (ROBLOX-105) The ambient colonies' classes by kind.
PreyWorld.AMBIENT = { ladybird = Ladybird, millipede = Millipede, snail = Snail, harvestman = Harvestman, ant = Ant, skater = Skater } :: { [string]: any }
-- (ROBLOX-105) Whether the woodlice and the ambient bugs are shown to the spider's senses (see the head of this file: they are not).
PreyWorld.SENSED = false

-- A neighbouring region's prey runs while its farthest perch is inside this many studs of the spider (Workspace.StreamingMinRadius, 96: what is always sent).
PreyWorld.ACTIVE_RADIUS = 96

-- `home`: the sill's director; `world`: the client's world (WorldClient: `region`, `home`, `map`, `regionReady`); `garden`: the table the checkpoint records
-- ({ [regionId] = { prey = director?, bugs = woodlice? } }); `root`: the folder the casts include (nil: no engine, no director is ever made); `casts`: the home's
-- casts, when it has them (PreyDirector.casts), else new ones.
function PreyWorld.new(home: any, world: any, garden: { [string]: any }, root: Instance?, casts: any?): any
	return setmetatable({
		home = home, world = world, garden = garden, root = root,
		casts = casts or (if root ~= nil then PreyDirector.casts(root) else nil),
		clock = 0, -- a running clock for the drawing (the directors' own stop while they wait)
		active = {} :: { string }, -- the regions whose prey ran this tick
		view = { flies = {}, feeding = home.feeding }, -- what the sound and the drawing read: the active flies and the jaws
		made = 0, -- directors made so far
		tier = "full", -- (ROBLOX-101) the detail tier, for how many of the bestiary's prey a region holds
		hour = nil :: number?, -- (ROBLOX-101) the life clock's hour, when the client gives it
		event = nil :: any, -- (ROBLOX-101) the last prey that got out of the jaws by its own trick: { kind = "slip" | "shed", prey = prey kind }; (ROBLOX-105) or a strike refused
		strikeEnd = -1, -- (ROBLOX-105) the ambient strike's window: open until this clock time
		strikeMode = "attached", -- the motor's mode last tick
		strikeFrom = nil :: Vector3?, -- where the spider was last tick
		refused = 0, -- strikes refused so far
	}, PreyWorld)
end

-- The farthest a region's prey can be from the spider: over the perches and vents of its directors where it has them, else of its specs (W3's and the
-- bestiary's).
local function reach(self: any, region: any, pos: Vector3): number
	local far = 0
	local function over(list: { any }) for _, p in list do far = math.max(far, (p.position - pos).Magnitude) end end
	if region.id == self.world.home then
		over(self.home.graph.perches); over(self.home.vents)
		return far
	end
	local entry = self.garden[region.id] or {}
	local any = false
	local spec = Garden.prey(region)
	if entry.prey ~= nil then over(entry.prey.graph.perches); over(entry.prey.vents); any = true
	elseif spec ~= nil then over(spec.perches); over(spec.vents); any = true end
	for _, k in (Garden.bestiary(region) or {}) :: { any } do
		local d = if entry.kinds ~= nil then entry.kinds[k.kind] else nil
		if d ~= nil then over(d.graph.perches); over(d.vents) else over(k.perches); over(k.vents) end
		any = true
	end
	return if any then far else math.huge
end

-- Whether a region has prey at all: the sill's (the home), or a kind Garden places prey in (W3's or the bestiary's). (ROBLOX-116: or woodlice or ambient bugs alone,
-- as the hut garden's lawn by the trough and the stone has: every region of the test garden with those has prey too, so nothing there changes.)
function PreyWorld.hasPrey(self: any, region: any): boolean
	return region.id == self.world.home or Garden.prey(region) ~= nil or Garden.bestiary(region) ~= nil or Garden.bugs(region) ~= nil or Garden.ambient(region) ~= nil
end

-- The ids of the regions whose prey runs at this place: the spider's own, and each neighbour with prey whose farthest perch is within ACTIVE_RADIUS (none while
-- the spider is on the sill itself: ROBLOX-101 keeps the sill as it was now that the outer sill has prey).
function PreyWorld.activeAt(self: any, pos: Vector3): { string }
	local here = self.world.region
	local out: { string } = {}
	if self:hasPrey(here) then table.insert(out, here.id) end
	if here.id == self.world.home then return out end
	for _, n in here.neighbors do
		local r = self.world.map.region(n.id)
		if r ~= nil and self:hasPrey(r) and reach(self, r, pos) <= PreyWorld.ACTIVE_RADIUS then table.insert(out, r.id) end
	end
	return out
end

-- The region's director, made now if the region is whole and it has none yet (nil for a region with no prey, or one not yet whole). The sill's is the home.
function PreyWorld.director(self: any, id: string): any
	if id == self.world.home then return self.home end
	local entry = self.garden[id]
	if entry ~= nil and entry.prey ~= nil then
		entry.prey.feeding = self.home.feeding -- (a return to a rest rebuilds the jaws: every director eats with the home's)
		return entry.prey
	end
	local region = self.world.map.region(id)
	local spec = if region ~= nil then Garden.prey(region) else nil
	if spec == nil then return nil end
	if self.root == nil or not self.world:regionReady(id) then return nil end
	local d = PreyDirector.engine(self.root, Species.fungus_gnat_prototype, spec.seed, spec.target, false, spec, self.casts)
	d.feeding = self.home.feeding -- one jaws, one reserve
	entry = entry or {}
	entry.prey = d
	self.garden[id] = entry
	self.made += 1
	return d
end

-- The region's bestiary directors in the spec's order, each made now if the region is whole and it has none yet (an empty list for a region without any).
function PreyWorld.kinds(self: any, id: string): { any }
	local out = {}
	if id == self.world.home then return out end
	local region = self.world.map.region(id)
	local specs = if region ~= nil then Garden.bestiary(region) else nil
	if specs == nil then return out end
	local entry = self.garden[id]
	for _, spec in specs do
		local d = if entry ~= nil and entry.kinds ~= nil then entry.kinds[spec.kind] else nil
		if d == nil and self.root ~= nil and self.world:regionReady(id) then
			local target = if self.tier == "low" then spec.low else spec.target
			d = PreyDirector.engine(self.root, (Species :: any)[spec.profile], spec.seed, target, false, spec, self.casts)
			entry = entry or {}
			entry.kinds = entry.kinds or {}
			entry.kinds[spec.kind] = d
			self.garden[id] = entry
			self.made += 1
		end
		if d ~= nil then
			d.feeding = self.home.feeding -- (one jaws: a return to a rest rebuilds them)
			table.insert(out, d)
		end
	end
	return out
end

-- Every director of a region: W3's (the bed's gnats and aphids), then the bestiary's.
function PreyWorld.directors(self: any, id: string): { any }
	local out = {}
	local d = self:director(id)
	if d ~= nil then table.insert(out, d) end
	for _, k in self:kinds(id) do table.insert(out, k) end
	return out
end

-- The region's woodlice, made with its director's gate (nil for a region without any, or one not yet whole).
function PreyWorld.bugs(self: any, id: string): any
	if id == self.world.home then return nil end
	local entry = self.garden[id]
	if entry ~= nil and entry.bugs ~= nil then return entry.bugs end
	local region = self.world.map.region(id)
	local spec = if region ~= nil then Garden.bugs(region) else nil
	if spec == nil then return nil end
	if not self.world:regionReady(id) then return nil end
	local soil: any, boxes = nil, {}
	for _, p in Region.pieces(region) do
		if p.id == region.id .. "_soil" then soil = { min = p.lo, max = p.hi }
		elseif p.lo.Y <= region.origin.Y + 0.01 then table.insert(boxes, { min = p.lo, max = p.hi }) end
	end
	for _, b in Garden.standingFrom(region) do table.insert(boxes, b) end -- (ROBLOX-107: the drainpipe's foot, wall_west's box, on a chunk of the bushes' litter)
	if soil == nil then return nil end
	local w = Woodlouse.new(spec, soil, boxes)
	entry = entry or {}
	entry.bugs = w
	self.garden[id] = entry
	return w
end

-- The region's ambient colonies in Garden.AMBIENT's order, each made now if the region is whole and it has none yet (an empty list for a region without any).
-- A colony on the soil needs the soil and the standing boxes, as the woodlice do.
function PreyWorld.ambient(self: any, id: string): { any }
	local out = {}
	if id == self.world.home then return out end
	local region = self.world.map.region(id)
	local specs = if region ~= nil then Garden.ambient(region) else nil
	if specs == nil then return out end
	local entry = self.garden[id]
	local soil: any, boxes: { any }? = nil, nil
	for _, spec in specs do
		local c = if entry ~= nil and entry.ambient ~= nil then entry.ambient[spec.kind] else nil
		if c == nil and self.world:regionReady(id) then
			local count = if self.tier == "low" then spec.low else spec.full
			if spec.surface == "soil" and soil == nil then
				boxes = {}
				for _, p in Region.pieces(region) do
					if p.id == region.id .. "_soil" then soil = { min = p.lo, max = p.hi }
					elseif p.lo.Y <= region.origin.Y + 0.01 then table.insert(boxes :: any, { min = p.lo, max = p.hi }) end
				end
				for _, b in Garden.standingFrom(region) do table.insert(boxes :: any, b) end
			end
			if spec.kind == "ladybird" then c = Ladybird.new(spec, count, Garden.plants(region) or {})
			elseif spec.kind == "millipede" and soil ~= nil then c = Millipede.new(spec, count, soil, boxes :: any)
			elseif spec.kind == "snail" and soil ~= nil then c = Snail.new(spec, count, soil, boxes :: any)
			elseif spec.kind == "harvestman" then c = Harvestman.new(spec, count, soil, boxes)
			elseif spec.kind == "ant" and soil ~= nil then c = Ant.new(spec, count, soil, boxes)
			elseif spec.kind == "skater" then c = Skater.new(spec, count) end
			if c ~= nil then
				entry = entry or {}
				entry.ambient = entry.ambient or {}
				entry.ambient[spec.kind] = c
				self.garden[id] = entry
			end
		end
		if c ~= nil then table.insert(out, c) end
	end
	return out
end

-- Every percept of the active regions: their flies (the woodlice and the ambient bugs only if SENSED, as movement).
function PreyWorld.percepts(self: any): { any }
	local out = {}
	for _, id in self.active do
		for _, d in self:directors(id) do for _, p in d:percepts() do table.insert(out, p) end end
		local w = if PreyWorld.SENSED then self:bugs(id) else nil
		if w ~= nil then for _, p in w:percepts() do table.insert(out, p) end end
	end
	return out
end

-- Before the motor (the client's order): which regions are active at this place, then each active director's `before` and its woodlice.
-- `hour` (ROBLOX-101): the life clock's hour, for the kinds that fly from dusk (nil: the last one given, or day).
function PreyWorld.before(self: any, dt: number, position: Vector3, observer: any, sensor: any, cast: any, camera: any, hour: number?)
	self.clock += dt
	if hour ~= nil then self.hour = hour end
	self.active = self:activeAt(position)
	for _, id in self.active do
		for _, d in self:directors(id) do
			local dusk = Garden.BESTIARY.dusk
			if PreyKinds.counterpart(d.p, true) ~= nil or PreyKinds.counterpart(d.p, false) ~= nil then
				PreyKinds.light(d, self.hour ~= nil and PreyKinds.isDusk(self.hour, dusk.from, dusk.to))
			end
			d:before(dt, position, observer, sensor, cast, camera)
		end
		local w = self:bugs(id)
		if w ~= nil then w:step(dt, position) end
		local list = self:ambient(id)
		if #list > 0 then
			local region = self.world.map.region(id)
			local aphids = {}
			local d = self:director(id)
			if d ~= nil then for _, f in d.flies do table.insert(aphids, f) end end
			local ctx = { hour = self.hour, flies = aphids, plants = if region ~= nil then Garden.plants(region) else nil, ripple = self.ripple } -- (ROBLOX-122: `ripple`, a spider struggling in the water: Life/Water)
			for _, c in list do c:step(dt, position, ctx) end
		end
	end
end

-- Whether the home's prey ran this tick.
function PreyWorld.homeActive(self: any): boolean
	return table.find(self.active, self.world.home) ~= nil
end

-- A fly that tore free goes back to the director it belongs to (returned).
function PreyWorld.escape(self: any, f: any): any
	if not self.home:owns(f) then
		for _, entry in self.garden do
			if entry.prey ~= nil and entry.prey:owns(f) then entry.prey:escape(f); return entry.prey end
			for _, d in entry.kinds or {} do
				if d:owns(f) then d:escape(f); return d end
			end
		end
	end
	self.home:escape(f)
	return self.home
end

-- (ROBLOX-101) A prey that got out of the jaws by its own trick cannot be struck again for this long (seconds): it leaves from the spider's mouth while the
-- strike that took it may still be open, and a slip that is caught again on the same tick would be no slip.
PreyWorld.FREE_S = 0.5

-- After the motor: the home's `after` always (the jaws, the reserves, once a tick; with no sweep where its prey did not run), every other active director's
-- `afterShared`. Then the view the sound and the drawing read.
function PreyWorld.after(self: any, dt: number, motor: any, sensor: any, cast: any)
	if not self:homeActive() then self.home.previousPosition = motor.pos end
	-- (ROBLOX-101) a moth's slip, a crane fly's shed leg: out of the jaws before they step
	local held = self.home.feeding.held
	local trick = PreyKinds.grip(self.home.feeding, function(f)
		local d = self:escape(f)
		f.freeUntil = d.now + PreyWorld.FREE_S
	end)
	if trick ~= nil then self.event = { kind = trick, prey = held.profile.body.prey_kind } end
	self.home:after(dt, motor, sensor, cast, function(f) self:escape(f) end)
	for _, id in self.active do
		if id ~= self.world.home then
			for _, d in self:directors(id) do d:afterShared(motor, sensor, cast) end
		end
	end
	self:strikeAmbient(motor)
	local flies = {}
	for _, id in self.active do
		for _, d in self:directors(id) do for _, f in d.flies do table.insert(flies, f) end end
	end
	self.view.flies = flies
	self.view.feeding = self.home.feeding
end

-- The active regions' flies, for the drawing and the notebook's watcher.
function PreyWorld.flies(self: any): { any }
	return self.view.flies
end

-- (ROBLOX-105) The strike against what is not food: a window opened by a leap (the motor's `launched` as it leaves the ground, as the directors' own) and closed
-- just after it lands; while it is open and the jaws are empty, a sweep of the spider's body from last tick's place to this one against every woodlouse and
-- ambient bug of the active regions. The first one within its radius (and the directors' 0.3) is refused: `event`, the creature's answer, the window shut.
function PreyWorld.strikeAmbient(self: any, motor: any)
	local mode = motor.mode
	if mode == "air" and self.strikeMode ~= "air" then
		for _, e in motor.events or {} do if e.kind == "launched" then self.strikeEnd = self.clock + 4; break end end
	end
	if self.strikeMode == "air" and mode ~= "air" then self.strikeEnd = math.min(self.strikeEnd, self.clock + 0.05) end
	self.strikeMode = mode
	local from = self.strikeFrom or motor.pos
	self.strikeFrom = motor.pos
	if self.clock > self.strikeEnd or self.home.feeding.held ~= nil then return end
	local seg = motor.pos - from
	local len2 = seg:Dot(seg)
	for _, id in self.active do
		local colonies = {}
		local w = self:bugs(id)
		if w ~= nil then table.insert(colonies, { c = w, kind = "woodlouse" }) end
		for _, c in self:ambient(id) do table.insert(colonies, { c = c, kind = c.kind }) end
		for _, e in colonies do
			for _, t in e.c:targets() do
				local u = if len2 > 1e-12 then math.clamp((t.position - from):Dot(seg) / len2, 0, 1) else 0
				if ((from + seg * u) - t.position).Magnitude <= t.radius + 0.3 then
					e.c:struck(t.creature)
					self.event = { kind = "refused", prey = e.kind }
					self.refused += 1
					self.strikeEnd = -1
					return
				end
			end
		end
	end
end

-- (ROBLOX-105) Every woodlouse and ambient bug of the active regions, for the drawing (Client/BugBodies: a creature with no `kind` is a woodlouse) and the
-- notebook's close look.
function PreyWorld.crawlers(self: any): { any }
	local out = {}
	for _, id in self.active do
		local w = self:bugs(id)
		if w ~= nil then for _, l in w.lice do table.insert(out, l) end end
		for _, c in self:ambient(id) do for _, b in c:creatures() do table.insert(out, b) end end
	end
	return out
end

-- The active regions' woodlice, for the drawing.
function PreyWorld.woodlice(self: any): { any }
	local out = {}
	for _, id in self.active do
		local w = self:bugs(id)
		if w ~= nil then for _, l in w.lice do table.insert(out, l) end end
	end
	return out
end

-- Every capture made, in every region.
function PreyWorld.captures(self: any): number
	local n = self.home.captures
	for _, entry in self.garden do
		if entry.prey ~= nil then n += entry.prey.captures end
		for _, d in entry.kinds or {} do n += d.captures end
	end
	return n
end

return PreyWorld
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">Skater</string>
            <string name="Source"><![CDATA[--!strict
-- Water striders (ROBLOX-122, the pond's edge): ambient, not the spider's food here. Common water striders (Gerridae) on the open water of the pond's margin
-- (World/Pond.LIFE.skaters): they stand on the surface on their long water-repellent middle and hind legs, row with the middle pair in a quick stroke and glide,
-- turn, rest, and keep to the open water between the pads and the stems. They are predators of what falls onto the water and struggles there, the sources say, a
-- spider among it, and they find it by its ripples: while the spider is struggling in the water (`ctx.ripple`, Life/Water through Prey/PreyWorld) the ones within
-- RIPPLE turn and skate toward it, a few studs off. They do not harm it here (the struggle is the water's). By night they rest where they are. A strike at one is
-- refused (Prey/PreyWorld, UI/PreyText): it skates off. Pure and seeded, no raycast; a checkpoint records the colony with the region's prey. The speeds are the game's.
local R = require(script.Parent.PreyRandom)

local Skaters = {}
Skaters.__index = Skaters

Skaters.HOVER = 0.15 -- the body's middle over the surface: up on its legs
Skaters.BODY = 1.2 -- studs long: a strider of about 12 mm (the sources: 1/2 to 3/4 inch for the large one, Gerris under 1/2 inch)
Skaters.RADIUS = 0.4
Skaters.STROKE = { 18, 36 } -- studs a second at a stroke's start
Skaters.DRAG = 3.2 -- how fast a glide slows (a second's share)
Skaters.REST = { 0.4, 2.5 } -- seconds between strokes
Skaters.EDGE = 2.0
Skaters.RIPPLE = 60 -- studs: how far a struggling thing's ripples draw them
Skaters.CLOSE = 5 -- and how near they come
Skaters.NIGHT = { from = 20.5, to = 6.5 }

-- `spec`: World/Pond.ambient's (kind "skater", `water` the open water's rectangle, `boxes` the stems, pads and stones it skates round); `count`: the tier's.
function Skaters.new(spec: any, count: number): any
	local self: any = setmetatable({ kind = "skater", rng = R.new(spec.seed + 6011), now = 0, items = {}, boxes = {}, waterMin = spec.water.min, waterMax = spec.water.max }, Skaters)
	self.top = spec.water.max.Y
	for _, b in (spec.boxes or {}) :: { any } do table.insert(self.boxes, { min = b.min, max = b.max }) end
	for i, s in spec.starts do
		if i > count then break end
		local surf = Vector3.new(s.pos.X, self.top, s.pos.Z)
		local pos = surf + Vector3.yAxis * Skaters.HOVER
		table.insert(self.items, {
			id = (spec.prefix or "") .. "skater_" .. i, kind = "skater", surface = surf, position = pos, prevPosition = pos, normal = Vector3.yAxis, heading = s.heading,
			speed = 0, state = "rest", until_ = self.rng:draw(Skaters.REST), hidden = false,
		})
	end
	return self
end

-- Whether a point of the surface is open water to skate: inside the rectangle, clear of what stands in it.
function Skaters.free(self: any, p: Vector3): boolean
	if p.X < self.waterMin.X + Skaters.EDGE or p.X > self.waterMax.X - Skaters.EDGE or p.Z < self.waterMin.Z + Skaters.EDGE or p.Z > self.waterMax.Z - Skaters.EDGE then return false end
	for _, b in self.boxes do
		if b.max.Y >= self.top - 0.5 and p.X > b.min.X - 0.8 and p.X < b.max.X + 0.8 and p.Z > b.min.Z - 0.8 and p.Z < b.max.Z + 0.8 then return false end
	end
	return true
end

local function turned(h: Vector3, degrees: number): Vector3
	return CFrame.fromAxisAngle(Vector3.yAxis, math.rad(degrees)):VectorToWorldSpace(h).Unit
end
local function night(hour: number?): boolean
	return hour ~= nil and (hour >= Skaters.NIGHT.from or hour < Skaters.NIGHT.to)
end

-- One fixed tick. `ctx.hour`: the life clock's hour (nil: day); `ctx.ripple`: where something struggles in the water now (nil: nothing).
function Skaters.step(self: any, dt: number, _spider: Vector3, ctx: any)
	self.now += dt
	local now = self.now
	local ripple: any = if ctx ~= nil then ctx.ripple else nil
	local resting = night(if ctx ~= nil then ctx.hour else nil)
	for _, a in self.items do
		a.prevPosition = a.position
		local toward: any = nil
		if ripple ~= nil then
			local d = Vector3.new(ripple.X - a.surface.X, 0, ripple.Z - a.surface.Z)
			if d.Magnitude < Skaters.RIPPLE and d.Magnitude > Skaters.CLOSE then toward = d.Unit end
		end
		if a.state == "glide" then
			a.speed *= math.max(0, 1 - Skaters.DRAG * dt)
			local nextPos = a.surface + a.heading * (a.speed * dt)
			if self:free(nextPos) then
				a.surface = nextPos
			else
				a.heading = turned(-a.heading, self.rng:draw({ -40, 40 }))
				a.speed *= 0.4
			end
			if a.speed < 1.0 then
				a.state, a.speed = "rest", 0
				a.until_ = now + (if toward ~= nil then 0.2 else self.rng:draw(Skaters.REST))
			end
		elseif now >= a.until_ and not resting or (toward ~= nil and now >= a.until_) then
			-- a stroke: a turn now and then, or toward the ripples
			if toward ~= nil then a.heading = toward
			elseif self.rng:next() < 0.6 then a.heading = turned(a.heading, self.rng:draw({ -120, 120 })) end
			a.state, a.speed = "glide", self.rng:draw(Skaters.STROKE)
			a.strokeAt = now
		end
		a.position = a.surface + Vector3.yAxis * Skaters.HOVER
	end
end

-- What a strike may hit: a strider on the water.
function Skaters.targets(self: any): { any }
	local out = {}
	for _, a in self.items do table.insert(out, { creature = a, position = a.position, radius = Skaters.RADIUS }) end
	return out
end

-- Struck: it skates off at once, away.
function Skaters.struck(self: any, a: any)
	a.heading = -a.heading
	a.state, a.speed = "glide", Skaters.STROKE[2]
end

function Skaters.creatures(self: any): { any } return self.items end

function Skaters.problems(self: any, lo: Vector3, hi: Vector3): { string }
	local out: { string } = {}
	local states = { rest = true, glide = true }
	if type(self.items) ~= "table" then return { "skaters: no list" } end
	for i, a in self.items do
		if type(a) ~= "table" or not states[a.state] then table.insert(out, `skaters: {i} is in no known state`); continue end
		local p = a.position
		if (typeof(p) ~= "Vector3" and type(p) ~= "table") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then
			table.insert(out, `skaters: {i} is outside its region`)
		end
	end
	return out
end

return Skaters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">Snail</string>
            <string name="Source"><![CDATA[--!strict
-- The garden snail (ROBLOX-105, W3b part B): ambient, not food, three times the spider's length. It crawls very slowly over the bed's soil and up the foot of the
-- house wall (World/Garden.AMBIENT.wallFoot) from one seeded goal to the next (Prey/PlantWalk over a straight leg on the soil, the corner where the soil meets
-- the brick, and up the brick), resting between; it is a night animal, so by day it mostly rests and from dusk it mostly crawls (the life clock's hour, as the
-- moths'). It leaves a slime trail (`trail`, points dropped as it goes, drawn by Client/BugBodies fading over FADE_S). Its eye stalks draw in when the spider
-- comes within EYES_WU and stay in until it has gone past CALM_WU; it does not crawl with them in. Struck, it withdraws into its shell for a while and the strike
-- is refused (Prey/PreyWorld, UI/PreyText). Pure and seeded, no raycast; a checkpoint records it with the region's prey.
-- Sources (docs/NOTEBOOK_SOURCES.md, the snail page): the shell 28 to 32 mm across; the eyes on the longer upper tentacles, which are retractable; mucus from
-- the foot that aids its movement and leaves a slimy trail; mostly nocturnal, out by day after rain. The speeds, waits and distances are the game's.
local R = require(script.Parent.PreyRandom)
local PlantWalk = require(script.Parent.PlantWalk)

local Snails = {}
Snails.__index = Snails

Snails.SHELL = 3.0 -- studs across: 28 to 32 mm
Snails.RADIUS = 1.5
Snails.CRAWL = { 0.07, 0.12 } -- studs a second: about a millimetre a second
Snails.EYES_WU = 5.0 -- the spider this near: the eye stalks draw in
Snails.CALM_WU = 7.0 -- and come out again once it is this far
Snails.IN_RATE = 3.0 -- the stalks' travel a second, in and out
Snails.OUT_RATE = 0.25
Snails.SHELL_S = { 25, 45 } -- in its shell this long, struck
Snails.REST_DAY = { 90, 240 }
Snails.REST_NIGHT = { 8, 30 }
Snails.DROP = 0.5 -- a trail point every this many studs crawled
Snails.TRAIL = 25 -- trail points kept (the drawing shows the newest 24 legs at the full tier)
Snails.FADE_S = 240 -- seconds for a trail to fade
Snails.EDGE = 2.0
Snails.WALL = -24 -- the house wall's face (z)

-- `spec`: one of World/Garden.ambient's (kind "snail"); `count`: the tier's; `soil` the soil's top box; `boxes` the standing boxes' footprints.
function Snails.new(spec: any, count: number, soil: { min: Vector3, max: Vector3 }, boxes: { { min: Vector3, max: Vector3 } }): any
	local self: any = setmetatable({ kind = "snail", rng = R.new(spec.seed + 4057), now = 0, boxes = {}, items = {}, rect = spec.rect,
		soilMin = soil.min, soilMax = soil.max, top = soil.max.Y }, Snails)
	for _, b in boxes do table.insert(self.boxes, { min = b.min, max = b.max }) end
	for i, s in spec.starts do
		if i > count then break end
		local surf = Vector3.new(s.pos.X, self.top, s.pos.Z)
		table.insert(self.items, {
			id = (spec.prefix or "") .. "snail_" .. i, kind = "snail", surface = surf, position = surf, prevPosition = surf, normal = Vector3.yAxis, heading = s.heading,
			speed = self.rng:draw(Snails.CRAWL), state = "rest", until_ = self.rng:draw({ 3, 12 }), walk = nil, eyes = 1.0, trail = {}, lastDrop = surf,
			crawled = 0, hidden = false,
		})
	end
	return self
end

-- Whether a point on the soil is clear for the shell (inside the soil's edge, in no standing box's footprint grown by `margin`).
function Snails.free(self: any, p: Vector3, margin: number): boolean
	if p.X < self.soilMin.X + Snails.EDGE or p.X > self.soilMax.X - Snails.EDGE or p.Z < self.soilMin.Z + Snails.EDGE or p.Z > self.soilMax.Z - 0.6 then return false end
	for _, b in self.boxes do
		if p.X > b.min.X - margin and p.X < b.max.X + margin and p.Z > b.min.Z - margin and p.Z < b.max.Z + margin then return false end
	end
	return true
end

-- Whether a straight leg over the soil is clear all the way.
local function clearLeg(self: any, a: Vector3, b: Vector3): boolean
	local n = math.max(1, math.ceil((b - a).Magnitude / 0.5))
	for i = 0, n do
		if not self:free(a:Lerp(b, i / n), 1.0) then return false end
	end
	return true
end

-- A new goal and the walk to it: a seeded spot on the soil, or (a third of the time) on the wall's foot, by way of the corner. False when no clear leg was found.
local function setOff(self: any, s: any): boolean
	local Y, Z = Vector3.yAxis, -Vector3.zAxis
	local onWall = s.normal.Z < -0.5
	for _ = 1, 8 do
		local path: { any }
		if self.rng:next() < 0.33 and self.rect ~= nil then
			-- the wall's foot: up the brick from the corner below the goal
			local x = self.rng:draw(self.rect.x)
			local y = self.top + self.rng:draw(self.rect.y)
			local foot = Vector3.new(x, self.top, Snails.WALL)
			local goal = Vector3.new(x, y, Snails.WALL)
			if onWall then
				path = { { pos = goal, normal = Z } }
			else
				local approach = Vector3.new(x, self.top, Snails.WALL - 2.0)
				if not clearLeg(self, s.surface, approach) then continue end
				path = { { pos = approach, normal = Y }, { pos = foot, normal = (Y + Z).Unit }, { pos = goal, normal = Z } }
			end
		else
			local goal = Vector3.new(self.rng:draw({ self.soilMin.X + Snails.EDGE, self.soilMax.X - Snails.EDGE }), self.top,
				self.rng:draw({ self.soilMin.Z + Snails.EDGE, self.soilMax.Z - 2.5 }))
			if onWall then
				local foot = Vector3.new(s.surface.X, self.top, Snails.WALL)
				local away = Vector3.new(s.surface.X, self.top, Snails.WALL - 2.0)
				if not self:free(away, 1.0) or not clearLeg(self, away, goal) then continue end
				path = { { pos = foot, normal = (Y + Z).Unit }, { pos = away, normal = Y }, { pos = goal, normal = Y } }
			else
				if not self:free(goal, 1.0) or not clearLeg(self, s.surface, goal) then continue end
				path = { { pos = goal, normal = Y } }
			end
		end
		s.walk = PlantWalk.new(path, s.surface, s.normal)
		s.state = "crawl"
		return true
	end
	return false
end

local function night(hour: number?): boolean
	return hour ~= nil and (hour >= 18 or hour < 6)
end

-- One fixed tick. `ctx.hour`: the life clock's hour (nil: day).
function Snails.step(self: any, dt: number, spider: Vector3, ctx: any)
	self.now += dt
	local now = self.now
	local hour = if ctx ~= nil then ctx.hour else nil
	-- the trail dries
	for _, s in self.items do
		s.prevPosition = s.position
		while #s.trail > 0 and now - s.trail[#s.trail].t > Snails.FADE_S do table.remove(s.trail) end
		local d = (spider - s.position).Magnitude
		if s.state ~= "shell" then
			if d <= Snails.EYES_WU then s.eyes = math.max(0, s.eyes - Snails.IN_RATE * dt)
			elseif d >= Snails.CALM_WU then s.eyes = math.min(1, s.eyes + Snails.OUT_RATE * dt) end
		end
		if s.state == "shell" then
			if now >= s.until_ then
				-- out again: a crawl it was on goes on (once its eyes are out), else it rests a little
				if s.walk ~= nil then s.state = "crawl" else s.state = "rest"; s.until_ = now + self.rng:draw({ 4, 10 }) end
			end
		elseif s.state == "rest" then
			if now >= s.until_ and s.eyes >= 0.6 then
				if not setOff(self, s) then s.until_ = now + self.rng:draw({ 5, 15 }) end
			end
		elseif s.state == "crawl" and s.walk ~= nil then
			if s.eyes >= 0.6 then
				local p, n, dir, done = PlantWalk.advance(s.walk, s.speed * dt)
				s.crawled += (p - s.surface).Magnitude
				s.surface, s.normal = p, n
				if dir.Magnitude > 0.5 then s.heading = dir end
				s.position = p
				if (p - s.lastDrop).Magnitude >= Snails.DROP then
					table.insert(s.trail, 1, { p = p, n = n, t = now })
					while #s.trail > Snails.TRAIL do table.remove(s.trail) end
					s.lastDrop = p
				end
				if done then
					s.walk = nil
					s.state = "rest"
					s.until_ = now + self.rng:draw(if night(hour) then Snails.REST_NIGHT else Snails.REST_DAY)
				end
			end
		end
	end
end

-- What a strike may hit: the shell.
function Snails.targets(self: any): { any }
	local out = {}
	for _, s in self.items do
		table.insert(out, { creature = s, position = s.position + s.normal * (Snails.SHELL * 0.5), radius = Snails.RADIUS })
	end
	return out
end

-- Struck by the spider: into its shell.
function Snails.struck(self: any, s: any)
	s.state = "shell"
	s.eyes = 0
	s.until_ = self.now + self.rng:draw(Snails.SHELL_S) -- (a crawl under way is kept and taken up again once it is out)
end

function Snails.creatures(self: any): { any } return self.items end

function Snails.problems(self: any, lo: Vector3, hi: Vector3): { string }
	local out: { string } = {}
	local states = { rest = true, crawl = true, shell = true }
	if type(self.items) ~= "table" then return { "snails: no list" } end
	for i, s in self.items do
		if type(s) ~= "table" or not states[s.state] then table.insert(out, `snails: {i} is in no known state`); continue end
		local p = s.position
		if (typeof(p) ~= "Vector3" and type(p) ~= "table") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then
			table.insert(out, `snails: {i} is outside its region`)
		end
		if type(s.trail) ~= "table" or #s.trail > Snails.TRAIL then table.insert(out, `snails: {i} has a trail beyond belief`) end
		if type(s.eyes) ~= "number" or s.eyes < 0 or s.eyes > 1 then table.insert(out, `snails: {i}'s eyes are nowhere`) end
		if s.state == "crawl" and s.walk == nil then table.insert(out, `snails: {i} crawls nowhere`) end
		if s.walk ~= nil then
			local why = PlantWalk.problem(s.walk)
			if why ~= nil then table.insert(out, `snails: {i}: {why}`) end
		end
	end
	return out
end

return Snails
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">StationMouse</string>
            <string name="Source"><![CDATA[--!strict
-- One ambient house mouse: authored floor routes, seeded pauses, no prey or
-- damage interface. It adds life without becoming another source of meals.
local Mouse = {}
Mouse.__index = Mouse
local v = Vector3.new
Mouse.ROUTE = table.freeze({
	v(-132,-70,88), v(-110,-70,88), v(-110,-70,150),
	v(-105,-70,215), v(20,-70,215), v(125,-70,215),
	v(195,-70,215), v(214,-70,220), v(245,-70,220),
})
Mouse.SPEED = 24
Mouse.FLEE_SPEED = 42
function Mouse.new(seed: number): any
	return setmetatable({pos=Mouse.ROUTE[1],heading=Vector3.xAxis,leg=1,direction=1,
		wait=8,seed=math.max(1,seed % 2147483647),moving=false,distance=0},Mouse)
end
local function random(self: any): number
	self.seed=self.seed*16807%2147483647
	return (self.seed-1)/2147483646
end
function Mouse.step(self: any, dt: number, spider: Vector3?, cat: Vector3?)
	local alarm=(spider~=nil and (spider-self.pos).Magnitude<9)
		or (cat~=nil and (cat-self.pos).Magnitude<65)
	self.moving=false
	if self.wait>0 then
		self.wait=math.max(0,self.wait-dt)
		-- A refuge is a safe stopping place even while the cat passes.
		if self.leg==1 or self.leg==#Mouse.ROUTE or not alarm then return end
		self.wait=0
	end
	local target=Mouse.ROUTE[self.leg+self.direction]
	local delta=target-self.pos
	local length=delta.Magnitude
	local travel=math.min(length,(if alarm then Mouse.FLEE_SPEED else Mouse.SPEED)*dt)
	if length>1e-6 then
		self.heading=delta.Unit;self.pos+=self.heading*travel
		self.distance+=travel;self.moving=travel>0
	end
	if travel>=length then
		self.leg+=self.direction
		if self.leg==1 or self.leg==#Mouse.ROUTE then
			self.direction=-self.direction;self.wait=12+random(self)*18
		else self.wait=if alarm then 0 else .3+random(self)*1.8 end
	end
end
return Mouse
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">Woodlouse</string>
            <string name="Source"><![CDATA[--!strict
-- Woodlice (ROBLOX-96, W3): the garden's first ambient bugs, a seeded few in the bed that walk slowly about the soil, go under the big stone, the other stones' feet
-- or the litter when the spider comes near, and come back out when it has gone. They are not prey: nothing here can be struck, caught or eaten (Prey/PreyWorld never
-- sweeps them), and to the spider's senses they are movement and nothing finer (`percepts` caps them at "movement", as the wasp's, the rival's and the mate's are;
-- the perception modules are untouched). A colony is one plain object, pure and seeded (a Prey/PreyRandom stream of its own from the region's seed), with no
-- raycast: the soil is flat and the standing boxes (the mounds, the stones, the plants) are footprints it steers round. A checkpoint records it with the region's
-- prey (Persistence/Checkpoint's `garden` root) and puts it back where it was.
-- Sources for the rules (docs/NOTEBOOK_SOURCES.md, the ground-life page): woodlice are isopod crustaceans with seven pairs of walking legs that live in damp dark
-- places under stones and litter and come out mostly at night (Hopkin 1991; Sutton 1972); their tegumental glands give a secretion that repels spiders and other
-- predators (Gorvett 1956), which is why a jumping spider here leaves them alone. The numbers below (speeds, distances, waits) are the game's.
local R = require(script.Parent.PreyRandom)

local Woodlice = {}
Woodlice.__index = Woodlice

Woodlice.HOVER = 0.12 -- the body's centre above the soil (half its height)
Woodlice.LENGTH = 1.0 -- studs; a common woodlouse is about a centimetre long
Woodlice.RADIUS = 0.35 -- as the senses see it
Woodlice.HIDE_WU = 4.0 -- the spider this near sends a woodlouse to cover
Woodlice.OUT_WU = 6.0 -- it stays under cover until the spider is this far
Woodlice.WALK = { 0.35, 0.65 } -- studs a second, each louse its own
Woodlice.FLEE = 1.2
Woodlice.RETURN_S = { 8, 15 } -- how long it waits under cover once the spider has gone
Woodlice.EDGE = 1.0 -- how far inside the soil's edge it keeps

export type Louse = {
	id: string, position: Vector3, prevPosition: Vector3, heading: Vector3, speed: number,
	state: string, -- walk | pause | hiding | hidden | emerging
	hide: number, -- the hide spot it is making for or under (an index into `hides`), 0 for none
	until_: number, -- when the pause, the wait under cover or the emerging ends
	nextTurn: number,
}

-- `spec`: World/Garden.bugs (the starting places, the hide spots, the seed, and the id prefix a region other than the bed gives its woodlice, ROBLOX-107); `soil` the soil's top box { min, max }; `boxes` the standing boxes' footprints
-- ({ min, max }, their y ignored).
function Woodlice.new(spec: any, soil: { min: Vector3, max: Vector3 }, boxes: { { min: Vector3, max: Vector3 } }): any
	local self: any = setmetatable({
		rng = R.new(spec.seed + 1013), now = 0, hides = {}, boxes = {}, lice = {},
		soilMin = soil.min, soilMax = soil.max, top = soil.max.Y,
	}, Woodlice)
	for _, h in spec.hides do table.insert(self.hides, { pos = h.pos, kind = h.kind }) end
	for _, b in boxes do table.insert(self.boxes, { min = b.min, max = b.max }) end
	for i, w in spec.woodlice do
		local pos = Vector3.new(w.pos.X, self.top + Woodlice.HOVER, w.pos.Z)
		table.insert(self.lice, {
			id = (spec.prefix or "") .. "louse_" .. i, position = pos, prevPosition = pos, heading = w.heading, speed = self.rng:draw(Woodlice.WALK),
			state = "walk", hide = 0, until_ = 0, nextTurn = self.rng:draw({ 1, 3 }),
		})
	end
	return self
end

-- Whether a point on the soil is free to stand on: inside the soil's edge and in no standing box's footprint (grown by `margin`).
function Woodlice.free(self: any, p: Vector3, margin: number): boolean
	if p.X < self.soilMin.X + Woodlice.EDGE or p.X > self.soilMax.X - Woodlice.EDGE or p.Z < self.soilMin.Z + Woodlice.EDGE or p.Z > self.soilMax.Z - Woodlice.EDGE then return false end
	for _, b in self.boxes do
		if p.X > b.min.X - margin and p.X < b.max.X + margin and p.Z > b.min.Z - margin and p.Z < b.max.Z + margin then return false end
	end
	return true
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- The hide spot nearest the louse.
function Woodlice.nearestHide(self: any, p: Vector3): number
	local best, bestD = 0, math.huge
	for i, h in self.hides do
		local d = (flat(h.pos) - flat(p)).Magnitude
		if d < bestD then best, bestD = i, d end
	end
	return best
end

local function turned(heading: Vector3, degrees: number): Vector3
	local a = math.atan2(heading.Z, heading.X) + math.rad(degrees)
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

-- One fixed tick. `spider`: where the spider is.
function Woodlice.step(self: any, dt: number, spider: Vector3)
	self.now += dt
	local now = self.now
	for _, w in self.lice do
		w.prevPosition = w.position
		local d = (flat(spider) - flat(w.position)).Magnitude
		local near = d <= Woodlice.HIDE_WU and math.abs(spider.Y - w.position.Y) < 6
		if w.state == "walk" or w.state == "pause" or w.state == "emerging" then
			if near and #self.hides > 0 then
				w.state = "hiding"
				w.hide = self:nearestHide(w.position)
			end
		end
		if w.state == "hiding" then
			local goal = self.hides[w.hide].pos
			local to = flat(goal) - flat(w.position)
			if to.Magnitude <= 0.25 then
				w.position = Vector3.new(goal.X, w.position.Y, goal.Z)
				w.state = "hidden"
				w.until_ = math.huge
			else
				w.heading = to.Unit
				local step = math.min(to.Magnitude, Woodlice.FLEE * dt)
				w.position += w.heading * step
			end
		elseif w.state == "hidden" then
			if d >= Woodlice.OUT_WU or (spider - w.position).Magnitude >= Woodlice.OUT_WU then
				if w.until_ == math.huge then w.until_ = now + self.rng:draw(Woodlice.RETURN_S) end
				if now >= w.until_ then
					w.state = "emerging"
					w.heading = turned(w.heading, self.rng:draw({ 120, 240 }))
					w.until_ = now + 1.5
				end
			else
				w.until_ = math.huge -- (the spider came back: the wait starts again once it goes)
			end
		elseif w.state == "pause" then
			if now >= w.until_ then w.state = "walk"; w.nextTurn = now + self.rng:draw({ 1, 3 }) end
		elseif w.state == "walk" or w.state == "emerging" then
			if w.state == "emerging" and now >= w.until_ then w.state = "walk" end
			local paused = false
			if now >= w.nextTurn then
				w.heading = turned(w.heading, self.rng:draw({ -50, 50 }))
				w.nextTurn = now + self.rng:draw({ 1, 3 })
				if self.rng:next() < 0.25 then w.state = "pause"; w.until_ = now + self.rng:draw({ 1, 4 }); paused = true end
			end
			if not paused then
				local nextPos = w.position + w.heading * (w.speed * dt)
				if self:free(nextPos, 0.3) then
					w.position = nextPos
				else
					w.heading = turned(w.heading, self.rng:draw({ 90, 180 }))
				end
			end
		end
	end
end

-- The woodlice the spider could see: movement to its senses, never prey.
function Woodlice.percepts(self: any): { any }
	local out = {}
	for _, w in self.lice do
		if w.state ~= "hidden" then
			table.insert(out, { id = w.id, position = w.position, radius = Woodlice.RADIUS, velocity = Vector3.zero, maxCategory = "movement" })
		end
	end
	return out
end

-- (ROBLOX-105) What a strike may hit: { creature, position, radius } for each louse not under cover.
function Woodlice.targets(self: any): { any }
	local out = {}
	for _, w in self.lice do
		if w.state ~= "hidden" then table.insert(out, { creature = w, position = w.position, radius = Woodlice.RADIUS }) end
	end
	return out
end

-- (ROBLOX-105) Struck by the spider (the strike is refused, Prey/PreyWorld): it makes for cover.
function Woodlice.struck(self: any, w: any)
	if w.state ~= "hidden" and #self.hides > 0 then
		w.state = "hiding"
		w.hide = self:nearestHide(w.position)
	end
end

-- How many are under cover now.
function Woodlice.hiddenCount(self: any): number
	local n = 0
	for _, w in self.lice do if w.state == "hidden" then n += 1 end end
	return n
end

-- What is wrong with a colony put back from a record (an empty list for a good one): the states, finite places inside the box given.
function Woodlice.problems(self: any, lo: Vector3, hi: Vector3): { string }
	local out: { string } = {}
	local states = { walk = true, pause = true, hiding = true, hidden = true, emerging = true }
	if type(self.lice) ~= "table" then return { "woodlice: no list" } end
	for i, w in self.lice do
		if type(w) ~= "table" or not states[w.state] then table.insert(out, `woodlice: louse {i} is in no known state`); continue end
		local p = w.position
		if typeof(p) ~= "Vector3" and type(p) ~= "table" then table.insert(out, `woodlice: louse {i} has no position`); continue end
		if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then table.insert(out, `woodlice: louse {i} is outside its region`) end
		if w.hide ~= 0 and (type(self.hides) ~= "table" or self.hides[w.hide] == nil) then table.insert(out, `woodlice: louse {i} hides in no known spot`) end
	end
	return out
end

return Woodlice
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="127">
        <Properties>
          <string name="Name">Rig</string>
        </Properties>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">Anatomy</string>
            <string name="Source"><![CDATA[--!strict
-- Where the parts of the body sit, worked out from the appearance table alone: pure, Vector3 only, so tests/look.luau checks
-- it. Body frame as in SpiderRig: +Y up, -Z forward. SpiderRig turns the layout into parts; Setae uses it to keep hairs off
-- the eyes and to grow the palps' fluff. Nothing here is placed by eye: eyes, cheeks and palps are found on the head's surface.

local Anatomy = {}

-- `kind`: "ame" (the principal eyes), "ale", "ple", "pme" or "tubercle" (a tarantula's bead). `margin` (ROBLOX-93): the eye's place on the head's (or the tubercle's) surface is found from
-- its offsets across and along, so it is only on the surface where those lie inside the ellipse the surface covers: `margin` is 1 minus the sum of their squared shares of
-- the radii, 0 at the rim (where the place is clamped) and 1 at the middle. The tests keep every eye of every look at 0.02 or more.
export type Eye = { name: string, side: number, kind: string, at: Vector3, radii: Vector3, reflectance: number, principal: boolean, margin: number }
export type Glint = { side: number, at: Vector3, radii: Vector3 }
export type Palp = { side: number, base: Vector3, tip: Vector3 }
export type Zone = { at: Vector3, radius: number }
-- One segment of a fang, an ellipsoid whose long axis (local Z) runs along `dir`; `index` counts from the chelicera (1) out to the tip.
export type Fang = { side: number, index: number, at: Vector3, dir: Vector3, radii: Vector3 }
export type Layout = {
	headCenter: Vector3, headRadii: Vector3,
	abdomenCenter: Vector3, abdomenRadii: Vector3,
	faceCenter: Vector3, faceRadii: Vector3,
	pedicelCenter: Vector3, pedicelRadii: Vector3,
	neck: Vector3,
	eyes: { Eye },
	glints: { Glint },
	cheeks: { { side: number, at: Vector3, radii: Vector3 } },
	jaws: { { side: number, at: Vector3, radii: Vector3 } },
	palps: { Palp },
	fangs: { Fang }, -- empty for an appearance without a `fang` table (ROBLOX-84)
	spinneret: Vector3,
	hairFree: { Zone },
	tubercle: { center: Vector3, radii: Vector3 }?, -- a tarantula's ocular tubercle, which carries its eyes
}

local function v3(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end
Anatomy.v3 = v3

-- z of an ellipsoid's front (-Z) surface at lateral offsets x, y from its centre.
function Anatomy.frontZ(c: Vector3, r: Vector3, x: number, y: number): number
	local q = 1 - (x / r.X) ^ 2 - (y / r.Y) ^ 2
	return c.Z - r.Z * math.sqrt(math.max(q, 0))
end

-- y of an ellipsoid's top surface at offsets x, z from its centre.
function Anatomy.topY(c: Vector3, r: Vector3, x: number, z: number): number
	local q = 1 - (x / r.X) ^ 2 - (z / r.Z) ^ 2
	return c.Y + r.Y * math.sqrt(math.max(q, 0))
end

-- x of an ellipsoid's +X side surface at offsets y, z from its centre.
function Anatomy.sideX(c: Vector3, r: Vector3, y: number, z: number): number
	local q = 1 - (y / r.Y) ^ 2 - (z / r.Z) ^ 2
	return c.X + r.X * math.sqrt(math.max(q, 0))
end

-- Outward unit normal of an ellipsoid at a point on its surface.
function Anatomy.normalAt(c: Vector3, r: Vector3, p: Vector3): Vector3
	local d = p - c
	return Vector3.new(d.X / (r.X * r.X), d.Y / (r.Y * r.Y), d.Z / (r.Z * r.Z)).Unit
end

-- The point of an ellipsoid in direction `dir` (unit-sphere coordinates) and its outward normal.
function Anatomy.ellipsoidPoint(c: Vector3, r: Vector3, dir: Vector3): (Vector3, Vector3)
	local u = dir.Unit
	local p = c + Vector3.new(u.X * r.X, u.Y * r.Y, u.Z * r.Z)
	return p, Anatomy.normalAt(c, r, p)
end

-- Does the segment from a to b come within `pad` studs of the eye (its ellipsoid, axes along the body frame's, each radius grown by `pad`)? The segment's closest point in the
-- ellipsoid's own space (every axis divided by its radius) is found exactly, not sampled: the squared distance there is a quadratic in the segment's parameter.
function Anatomy.touchesEye(eye: Eye, a: Vector3, b: Vector3, pad: number): boolean
	local r = eye.radii + Vector3.one * pad
	local u0 = Vector3.new((a.X - eye.at.X) / r.X, (a.Y - eye.at.Y) / r.Y, (a.Z - eye.at.Z) / r.Z)
	local d = Vector3.new((b.X - a.X) / r.X, (b.Y - a.Y) / r.Y, (b.Z - a.Z) / r.Z)
	local dd = d:Dot(d)
	local t = if dd > 1e-12 then math.clamp(-u0:Dot(d) / dd, 0, 1) else 0
	return (u0 + d * t).Magnitude < 1
end

function Anatomy.layout(look: any): Layout
	local hc, hr = v3(look.headCenter), v3(look.headRadii)
	local ac, ar = v3(look.abdomenCenter), v3(look.abdomenRadii)
	local e = look.eye
	local eyes: { Eye } = {}
	local glints: { Glint } = {}
	local zones: { Zone } = {}
	local function addEye(name: string, kind: string, side: number, anchor: Vector3, r: Vector3, out: number, reflectance: number, principal: boolean, margin: number): Vector3
		local n = Anatomy.normalAt(hc, hr, anchor)
		local at = anchor + n * (out * math.min(r.X, r.Y, r.Z))
		table.insert(eyes, { name = name, side = side, kind = kind, at = at, radii = r, reflectance = reflectance, principal = principal, margin = margin })
		table.insert(zones, { at = at, radius = math.max(r.X, r.Y, r.Z) * 1.15 + 0.012 })
		return at
	end
	local tub = look.tubercle
	if tub then
		-- A tarantula (ROBLOX-81): no big front pair; eight tiny eyes clustered on a small mound, their beads standing a little out of it, and one
		-- catchlight on the first bead of each side. Placed on the mound's surface like the others are on the head's.
		local tc, tr = v3(tub.center), v3(tub.radii)
		for _, side in { -1, 1 } do
			for n, spec in tub.eyes do
				local dx, dz = side * spec.x, spec.z
				local q = math.sqrt(math.max(1 - (dx / tr.X) ^ 2 - (dz / tr.Z) ^ 2, 0.05))
				local anchor = Vector3.new(tc.X + dx, tc.Y + tr.Y * q, tc.Z + dz)
				local at = anchor + Anatomy.normalAt(tc, tr, anchor) * (0.3 * spec.r)
				local r3 = Vector3.one * spec.r
				table.insert(eyes, { name = "Eye", side = side, kind = "tubercle", at = at, radii = r3, reflectance = tub.eyeReflectance, principal = false, margin = 1 - (dx / tr.X) ^ 2 - (dz / tr.Z) ^ 2 })
				table.insert(zones, { at = at, radius = spec.r * 1.15 + 0.012 })
				if n == 1 then
					local g = tub.glint
					table.insert(glints, { side = side, at = at + Vector3.new(side * g.dx, g.dy, -spec.r * 0.75), radii = Vector3.new(g.r, g.r, g.r * 0.45) })
				end
			end
		end
	end
	local frontSides: { number } = if tub then {} else { -1, 1 } -- (a tarantula's eyes are on its tubercle, above)
	for _, side in frontSides do
		-- Principal eyes on the front of the face, two catchlights each.
		local a = e.ame
		local ar3 = v3(a.radii)
		local ax, ay = side * a.x, a.y
		local anchor = Vector3.new(hc.X + ax, ay, Anatomy.frontZ(hc, hr, ax, ay - hc.Y))
		local at = addEye("PrincipalEye", "ame", side, anchor, ar3, a.out, a.reflectance, true, 1 - (ax / hr.X) ^ 2 - ((ay - hc.Y) / hr.Y) ^ 2)
		for _, g in a.glints do
			local depth = math.sqrt(math.max(1 - (g.dx / ar3.X) ^ 2 - (g.dy / ar3.Y) ^ 2, 0))
			local gz = -ar3.Z * depth
			table.insert(glints, {
				side = side,
				at = at + Vector3.new(g.dx, g.dy, gz - g.r * 0.2),
				radii = Vector3.new(g.r, g.r, g.r * 0.45),
			})
		end
		-- Anterior lateral eyes at the sides of the face.
		local l = e.ale
		local lx, ly = side * l.x, l.y
		addEye("Eye", "ale", side, Vector3.new(hc.X + lx, ly, Anatomy.frontZ(hc, hr, lx, ly - hc.Y)), Vector3.one * l.r, l.out, l.reflectance, false, 1 - (lx / hr.X) ^ 2 - ((ly - hc.Y) / hr.Y) ^ 2)
		-- Posterior lateral and median eyes on the dome.
		for n, d in { e.ple, e.pme } do
			local dx, dz = side * d.x, d.z
			addEye("Eye", if n == 1 then "ple" else "pme", side, Vector3.new(hc.X + dx, Anatomy.topY(hc, hr, dx, dz - hc.Z), dz), Vector3.one * d.r, d.out, d.reflectance, false, 1 - (dx / hr.X) ^ 2 - ((dz - hc.Z) / hr.Z) ^ 2)
		end
	end
	local cheeks, jaws, palps = {}, {}, {}
	local ch, cl, pl = look.cheek, look.chelicerae, look.palp
	for _, side in { -1, 1 } do
		if ch then -- an appearance without pale cheeks (the ant-mimicking spider) has none
			local cx = Anatomy.sideX(hc, hr, ch.y - hc.Y, ch.z - hc.Z) - ch.inset
			table.insert(cheeks, { side = side, at = Vector3.new(side * cx, ch.y, ch.z), radii = v3(ch.radii) })
		end
		local jaw = Vector3.new(side * cl.x, cl.y, cl.z)
		table.insert(jaws, { side = side, at = jaw, radii = v3(cl.radii) })
		table.insert(zones, { at = jaw, radius = math.max(cl.radii[1], cl.radii[2], cl.radii[3]) * 1.1 + 0.01 })
		local px = side * pl.x
		local base = Vector3.new(px, pl.y, Anatomy.frontZ(hc, hr, px, pl.y - hc.Y))
		table.insert(palps, { side = side, base = base, tip = base + Vector3.new(side * pl.spread, -pl.drop, -pl.reach) })
	end
	-- Fangs (ROBLOX-84): each hangs from the lower front of its chelicera as a short chain of ellipsoids, every segment `length` studs long and
	-- turned to its own direction (x is mirrored for the left one; -Z forward, -Y down), so a chain of two curves in and a single one points
	-- straight out. Where the base is, how long and how thick are in the appearance's `fang` table.
	local fangs: { Fang } = {}
	local fg = look.fang
	if fg then
		for _, side in { -1, 1 } do
			local p = Vector3.new(side * fg.x, fg.y, fg.z)
			for index, seg in fg.segments do
				local dir = Vector3.new(side * seg.dir[1], seg.dir[2], seg.dir[3]).Unit
				table.insert(fangs, { side = side, index = index, at = p + dir * (seg.length * 0.5), dir = dir, radii = Vector3.new(seg.radius, seg.radius, seg.length * 0.5 + seg.radius * 0.35) })
				p += dir * seg.length
			end
		end
	end
	return {
		headCenter = hc, headRadii = hr, abdomenCenter = ac, abdomenRadii = ar,
		faceCenter = v3(look.face.center), faceRadii = v3(look.face.radii),
		pedicelCenter = v3(look.pedicel.center), pedicelRadii = v3(look.pedicel.radii),
		neck = v3(look.neck),
		eyes = eyes, glints = glints, cheeks = cheeks, jaws = jaws, palps = palps, fangs = fangs,
		spinneret = Vector3.new(0, ac.Y + 0.02, ac.Z + ar.Z - 0.005),
		hairFree = zones,
		tubercle = if tub then { center = v3(tub.center), radii = v3(tub.radii) } else nil,
	}
end

return Anatomy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">AntMimicPose</string>
            <string name="Source"><![CDATA[--!strict
-- The ant-mimicking spider's antennae and walk as a pose (ROBLOX-64): pure and Vector3-free, display only. SpiderRig reads the pose, turns
-- the drawn body and raises legs I; nothing here moves the collider, the path, the speed, the senses, the jump or the silk. All
-- numbers are in Data/AntMimic (documented ones from Shamble et al. 2017, the rest marked artistic).
--
-- Standing still, legs I go up (above head height) and wave in phase like ant antennae; walking, all eight legs walk and the drawn body
-- yaws and sways along a sine of the distance walked, wavelength ten body lengths. A stop shorter than the mimic's mean stop (83.3 ms)
-- is not drawn as a pause. step(dt, standing, moving, distance) adds the dt it is handed, so slow motion slows the waving as it slows
-- everything else; the wobble depends on distance only.

local AntMimic = require(script.Parent.Parent.Data.AntMimic)

local AntMimicPose = {}
AntMimicPose.__index = AntMimicPose

export type Pose = {
	antennae: number, -- 0..1: legs I raised (0 they are legs)
	high: number, -- 0..1: the display pose (higher and wider)
	wave: number, -- 0..1: legs I swept from "up" toward "swept"; both legs share the one value (they move in phase)
	yaw: number, -- radians: the drawn body's turn about its up axis
	lateral: number, -- studs: the drawn body's sway to its right
	walking: boolean, -- drawn as walking (a stop shorter than the hold does not end it)
	shownSeconds: number, -- seconds the antennae have been fully up
}

local TAU = math.pi * 2

local function smooth(x: number): number
	local c = math.clamp(x, 0, 1)
	return c * c * (3 - 2 * c)
end

AntMimicPose.BODY_LENGTH = AntMimic.bodyLengthStuds -- the drawn body's length (studs) at full growth: a wavelength is ten of them

AntMimicPose.NONE = { antennae = 0, high = 0, wave = 0, yaw = 0, lateral = 0, walking = false, shownSeconds = 0 } :: Pose

export type State = typeof(setmetatable(
	{} :: {
		walked: number, still: number, walking: boolean, antennae: number, high: number, walkLevel: number, phase: number, shown: number,
		emphasis: boolean, reduced: boolean, bodyLength: number,
	},
	AntMimicPose
))

function AntMimicPose.new(): State
	return setmetatable({
		walked = 0, still = 0, walking = false, antennae = 0, high = 0, walkLevel = 0, phase = 0, shown = 0,
		emphasis = false, reduced = false, bodyLength = AntMimic.bodyLengthStuds,
	}, AntMimicPose)
end

-- The display key: legs I high and waving faster. Refused (false) unless the spider is standing still on a surface.
function AntMimicPose.start(self: State, standing: boolean, moving: boolean): boolean
	if self.emphasis or not standing or moving then return false end
	self.emphasis = true
	return true
end

function AntMimicPose.stop(self: State)
	self.emphasis = false
end

-- The display pose is on.
function AntMimicPose.displaying(self: State): boolean
	return self.emphasis
end

-- The pose after one step of dt seconds (the simulation's). standing: on a surface and not in a jump, on the line or resting; moving: walking
-- (or asked to); distance: studs the spider actually moved this step.
function AntMimicPose.step(self: State, dt: number, standing: boolean, moving: boolean, distance: number): Pose
	local a, w = AntMimic.antennae, AntMimic.walk
	if standing and not moving then self.still += dt else self.still = 0 end
	if not standing or moving then self.emphasis = false end
	-- Walking carries over a stop shorter than the mimic's mean stop; a spider that was not walking is not.
	local walking = standing and (moving or (self.walking and self.still < w.stopHoldSeconds))
	self.walking = walking
	if standing and moving and distance > 0 and distance <= w.teleportStuds then
		self.walked += distance
	end
	-- The antennae: up after a short stillness (at once for the display key), down quickly when it moves.
	local up = standing and not walking and (self.emphasis or self.still >= a.delaySeconds)
	if up then
		self.antennae = math.min(1, self.antennae + dt / a.riseSeconds)
	else
		self.antennae = math.max(0, self.antennae - dt / a.fallSeconds)
	end
	self.high = math.clamp(self.high + (if self.emphasis then dt else -dt) / a.riseSeconds, 0, 1)
	-- The drawn wobble eases in and out.
	if walking then
		self.walkLevel = math.min(1, self.walkLevel + dt / w.easeInSeconds)
	else
		self.walkLevel = math.max(0, self.walkLevel - dt / w.easeOutSeconds)
	end
	local shownA, shownHigh, shownWalk = smooth(self.antennae), smooth(self.high), smooth(self.walkLevel)
	local hz = a.waveHz + (a.highWaveHz - a.waveHz) * shownHigh
	self.phase = (self.phase + TAU * hz * dt) % TAU
	if self.antennae >= 0.999 then self.shown += dt else self.shown = 0 end
	local amp = if self.reduced then AntMimic.reducedMotion else 1
	local amount = a.waveAmount + (a.highWaveAmount - a.waveAmount) * shownHigh
	local wavelength = AntMimic.path.wavelengthBodyLengths.used * self.bodyLength
	local turn = TAU * self.walked / wavelength
	return {
		antennae = shownA,
		high = shownHigh,
		wave = if self.reduced then 0 else shownA * amount * (0.5 + 0.5 * math.sin(self.phase)),
		-- The path is x = A sin(s), so the heading follows its slope, cos(s): the body turns most where the sway crosses the middle.
		yaw = shownWalk * math.rad(w.yawDeg) * amp * math.cos(turn),
		lateral = shownWalk * w.lateralStuds * amp * math.sin(turn),
		walking = walking,
		shownSeconds = self.shown,
	}
end

return AntMimicPose
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="130">
          <Properties>
            <string name="Name">CatPose</string>
            <string name="Source"><![CDATA[--!strict
-- The ranger's cat drawn (ROBLOX-118; its sim is Predator/Cat): a domestic cat at true size, a brown mackerel tabby, posed from what the cat is doing. Pure: a list
-- of parts (each an ellipsoid, a ball or a cylinder with its size, its frame in the cat's own frame, its colour and whether the low tier keeps it), so
-- Client/CatBody draws it, tools/preview/scene.py renders it and tests/preserve.luau measures it, all from these same numbers.
--
-- The cat's frame: its origin on the surface it stands on, under the middle of its body; forward -Z (CFrame.lookAt's), up +Y, right +X. Studs are centimetres.
-- True size (a domestic cat, Felis catus): about 46 cm from the nose to the root of the tail, a tail about 28 cm, 23 to 25 cm at the shoulder, the head about
-- 9.5 cm across, the ears 4.5 cm tall, the eyes about 2 cm across (the shoulder here 24, the body 46 from the nose's tip to the hips' back).
--
-- Poses: walk (a lateral-sequence walk, each foot 62% of its stride on the ground, the tail up), jump (stretched out), sit (on its haunches, the tail round its
-- feet), rest (lying as a loaf, its eyes half shut: it purrs as it settles), sleep (curled round itself, its eyes shut, its tail over its nose), eat (head down
-- to the bowl), groom (sitting, licking a raised forepaw), watch (still, its head following what moved, its tail's tip twitching), stalk (low, slow), crouch (low
-- at the front, the hindquarters' wiggle), swat (a forepaw out at the thing and back). It breathes always (about 25 breaths a minute awake and 20 asleep), and
-- now and then, sitting or lying awake, it gives a slow blink.
local CatPose = {}

export type Part = { name: string, kind: string, size: Vector3, cf: CFrame, color: string, full: boolean }
export type State = {
	pose: string, t: number, -- the pose and the seconds the cat has lived (the breath, the gait, the blink, the twitch)
	speed: number?, -- studs a second over the ground (the gait)
	look: Vector3?, -- the point its head follows, in its own frame
	paw: Vector3?, -- where its pat is aimed, in its own frame
	swat: number?, -- how far through the pat (0..1)
	seated: boolean?, -- (watch) sitting rather than standing
}

local v = Vector3.new
local TAU = 2 * math.pi
CatPose.COLORS = table.freeze({
	fur = "8a7a66", stripe = "4b4036", light = "c9bba5", white = "e8e0d2", nose = "c98a85", inner = "d6a49a", iris = "b9a33a", pupil = "141210",
	collar = "a8322c", bell = "c9a33a", whisker = "f2eee6",
})
local C = CatPose.COLORS

-- An ellipsoid of `size` (x across, y up, z along) whose long axis runs from a to b.
local function along(a: Vector3, b: Vector3): CFrame
	local d = b - a
	if d.Magnitude < 1e-4 then return CFrame.new(a) end
	local up = if math.abs(d.Unit.Y) > 0.98 then Vector3.xAxis else Vector3.yAxis
	return CFrame.lookAt((a + b) * 0.5, b, up)
end

-- The skeleton of a pose: where the body's three masses are and how they are pitched, the neck, the head's place and turn, each leg's joints, the tail's points,
-- how far the eyes are shut and how much the breath swells.
type Leg = { a: Vector3, b: Vector3, c: Vector3, d: Vector3? } -- front: shoulder, elbow, paw; hind: hip, stifle, hock, paw
type Skeleton = {
	chest: Vector3, chestPitch: number, belly: Vector3, bellyPitch: number, hips: Vector3, hipsPitch: number, yawBody: { number }?,
	neckA: Vector3, neckB: Vector3, head: Vector3, headYaw: number, headPitch: number, headRoll: number,
	fl: Leg, fr: Leg, hl: Leg, hr: Leg, tail: { Vector3 }, shut: number, breath: number, low: boolean?,
}

local function frontLeg(shoulder: Vector3, paw: Vector3): Leg
	local wrist = paw + v(0, 2.2, 0.4)
	local elbow = (shoulder + wrist) * 0.5 + v(0, 0, 1.8)
	return { a = shoulder, b = elbow, c = wrist, d = paw }
end
local function hindLeg(hip: Vector3, paw: Vector3, heel: Vector3?): Leg
	local hock = heel or (paw + v(0, 5, 3.4))
	local stifle = (hip + hock) * 0.5 + v(0, 0, -3.6)
	return { a = hip, b = stifle, c = hock, d = paw }
end

-- The tail's eleven points from its root along a curve: `dirs` gives its direction at the root and at the tip; `sway` swings it sideways.
local function tailCurve(root: Vector3, d0: Vector3, d1: Vector3, length: number, sway: number): { Vector3 }
	local pts = { root }
	local p = root
	for i = 1, 10 do
		local s = i / 10
		local d = d0:Lerp(d1, s * s)
		d = (d + v(sway * s, 0, 0))
		p = p + d.Unit * (length / 10)
		table.insert(pts, p)
	end
	return pts
end
-- The tail lying round the feet: an arc on the ground about `centre`, from `a0` to `a1` radians (0 behind, +pi/2 to its right), radius `r`.
local function tailRound(root: Vector3, centre: Vector3, r: number, a0: number, a1: number, y: number): { Vector3 }
	local pts = { root }
	for i = 1, 10 do
		local a = a0 + (a1 - a0) * (i / 10)
		table.insert(pts, v(centre.X + r * math.sin(a), y, centre.Z + r * math.cos(a)))
	end
	return pts
end

-- The slow blink: shut over 0.35 s, held 0.4 s, opened over 0.6 s, once every 7 to 11 s (from the clock alone, so it is the same on every client).
local function blink(t: number): number
	local period = 9.0
	local k = t % period
	local start = 6.5 + 1.5 * math.sin(math.floor(t / period) * 1.7)
	local x = k - start
	if x < 0 or x > 1.35 then return 0 end
	if x < 0.35 then return x / 0.35 end
	if x < 0.75 then return 1 end
	return 1 - (x - 0.75) / 0.6
end

local function standing(t: number, speed: number, low: number): Skeleton
	-- the walk: a lateral sequence (left hind, left fore, right hind, right fore a quarter apart), each foot on the ground 62% of the time
	local moving = speed > 1
	local period = if speed > 30 then 0.5 else 0.9
	local reach = if moving then speed * period * 0.62 / 2 else 0
	local function foot(neutral: Vector3, phase: number): Vector3
		if not moving then return neutral end
		local p = ((t / period) + phase) % 1
		if p < 0.62 then return neutral + v(0, 0, reach * (2 * p / 0.62 - 1)) end
		local s = (p - 0.62) / 0.38
		return neutral + v(0, 3.5 * math.sin(s * math.pi), reach * (1 - 2 * s))
	end
	local bob = if moving then 0.4 * math.sin(TAU * t / period * 2) else 0
	local y = -low
	local sk: Skeleton = {
		chest = v(0, 16 + y + bob, -11), chestPitch = 0, belly = v(0, 15.5 + y + bob, 1), bellyPitch = 0, hips = v(0, 16.5 + y * 0.8 + bob, 11.5), hipsPitch = 0,
		neckA = v(0, 19 + y + bob, -15.5), neckB = v(0, 24 + y * 1.2 + bob, -20.5), head = v(0, 25.5 + y * 1.3 + bob, -24), headYaw = 0, headPitch = 0, headRoll = 0,
		fl = frontLeg(v(-3.8, 16 + y, -12.5), foot(v(-3.8, 1, -13.5), 0.25)), fr = frontLeg(v(3.8, 16 + y, -12.5), foot(v(3.8, 1, -13.5), 0.75)),
		hl = hindLeg(v(-4.2, 16 + y * 0.8, 12), foot(v(-4.2, 1, 12.5), 0)), hr = hindLeg(v(4.2, 16 + y * 0.8, 12), foot(v(4.2, 1, 12.5), 0.5)),
		tail = {}, shut = 0, breath = 0,
	}
	-- the tail held up in a loose question mark, swinging a little as it walks
	sk.tail = tailCurve(v(0, 18.5 + y * 0.8 + bob, 18), v(0, 0.6, 0.8), v(0, 0.7, -0.6), 28, 0.25 * math.sin(TAU * t * 0.7))
	return sk
end

local function sitting(t: number): Skeleton
	local sk: Skeleton = {
		chest = v(0, 17, -6), chestPitch = -55, belly = v(0, 11.5, 1), bellyPitch = -40, hips = v(0, 7, 7), hipsPitch = -10,
		neckA = v(0, 21, -8), neckB = v(0, 26, -10), head = v(0, 29, -12.5), headYaw = 0, headPitch = 0, headRoll = 0,
		fl = frontLeg(v(-3.6, 15, -7), v(-3.4, 1, -10.5)), fr = frontLeg(v(3.6, 15, -7), v(3.4, 1, -10.5)),
		hl = hindLeg(v(-4.8, 8, 8), v(-4.6, 1, -3), v(-4.9, 1.6, 7)), hr = hindLeg(v(4.8, 8, 8), v(4.6, 1, -3), v(4.9, 1.6, 7)),
		tail = tailRound(v(0, 3, 13.5), v(0, 1.5, 3), 11, 0.15, 2.7, 1.5), shut = 0, breath = 0,
	}
	return sk
end

local function lying(t: number): Skeleton
	local sk: Skeleton = {
		chest = v(0, 8, -8), chestPitch = 0, belly = v(0, 8.5, 1), bellyPitch = 0, hips = v(0, 8, 10), hipsPitch = 0,
		neckA = v(0, 11, -12), neckB = v(0, 14, -15.5), head = v(0, 15, -18.5), headYaw = 0, headPitch = -8, headRoll = 0,
		fl = frontLeg(v(-3.4, 7, -9), v(-3, 1.1, -13.5)), fr = frontLeg(v(3.4, 7, -9), v(3, 1.1, -13.5)),
		hl = hindLeg(v(-4.6, 7, 10), v(-4.8, 1.1, 3), v(-5, 1.6, 12)), hr = hindLeg(v(4.6, 7, 10), v(4.8, 1.1, 3), v(5, 1.6, 12)),
		tail = tailRound(v(0, 3, 16), v(0, 1.5, 0), 12.5, 0.2, 2.5, 1.6), shut = 0.5, breath = 0,
	}
	return sk
end

-- Curled asleep: the body round an arc, the head tucked against the hindquarters, the tail over the nose.
local function curled(): Skeleton
	local R = 5.5
	local function onArc(deg: number, y: number, r: number?): Vector3
		local a = math.rad(deg)
		return v((r or R) * math.sin(a), y, -(r or R) * math.cos(a))
	end
	local sk: Skeleton = {
		chest = onArc(-35, 7), chestPitch = 0, belly = onArc(45, 7.5), bellyPitch = 0, hips = onArc(125, 7), hipsPitch = 0,
		yawBody = { 125, 45, -35 }, -- (each mass turned along the arc, its front toward the head: 90 degrees less its place on the arc)
		neckA = onArc(-60, 7.5, 6), neckB = onArc(-80, 8, 8), head = onArc(-95, 8, 10.5), headYaw = 35, headPitch = -18, headRoll = 28, -- (its head laid on its paws, its face turned out)
		fl = frontLeg(onArc(-30, 5, 6), onArc(-75, 1.2, 5)), fr = frontLeg(onArc(-20, 5, 10), onArc(-60, 1.2, 8)),
		hl = hindLeg(onArc(130, 5, 6), onArc(80, 1.2, 4), onArc(150, 1.6, 4)), hr = hindLeg(onArc(140, 5, 11), onArc(95, 1.2, 9), onArc(165, 1.6, 9)),
		tail = {}, shut = 1, breath = 0,
	}
	local pts = { onArc(140, 4.5, 8) }
	for i = 1, 10 do table.insert(pts, onArc(140 + i * 22, 2.6, 11.5)) end
	sk.tail = pts
	return sk
end

local function jumping(t: number): Skeleton
	local sk = standing(t, 0, 0)
	sk.chest, sk.belly, sk.hips = v(0, 17, -13), v(0, 16, 1), v(0, 15, 13)
	sk.chestPitch, sk.hipsPitch = 8, -8
	sk.fl = frontLeg(v(-3.6, 16, -14), v(-3.4, 8, -27))
	sk.fr = frontLeg(v(3.6, 16, -14), v(3.4, 8, -27))
	sk.hl = hindLeg(v(-4.2, 15, 13), v(-4, 7, 30), v(-4.1, 9, 24))
	sk.hr = hindLeg(v(4.2, 15, 13), v(4, 7, 30), v(4.1, 9, 24))
	sk.tail = tailCurve(v(0, 17, 19), v(0, 0.1, 1), v(0, 0.2, 1), 28, 0)
	return sk
end

-- Turns the head toward a point in the cat's frame (clamped as a cat's neck allows), from where its neck meets it.
local function lookAt(sk: Skeleton, target: Vector3)
	local d = target - sk.neckB
	local yaw = math.deg(math.atan2(-d.X, -d.Z))
	local pitch = math.deg(math.atan2(d.Y, math.sqrt(d.X * d.X + d.Z * d.Z)))
	sk.headYaw = math.clamp(yaw, -75, 75)
	sk.headPitch = math.clamp(pitch, -45, 55)
end

-- The skeleton for a state.
function CatPose.skeleton(state: State): Skeleton
	local t = state.t
	local pose = state.pose
	local sk: Skeleton
	if pose == "walk" then
		sk = standing(t, state.speed or 60, 0)
	elseif pose == "jump" then
		sk = jumping(t)
	elseif pose == "sit" then
		sk = sitting(t)
		sk.headYaw = 25 * math.sin(t * 0.21) -- (it looks about, slowly)
		sk.shut = 0
	elseif pose == "rest" then
		sk = lying(t)
	elseif pose == "sleep" then
		sk = curled()
	elseif pose == "eat" then
		sk = standing(t, 0, 0)
		sk.neckA, sk.neckB, sk.head = v(0, 17, -16), v(0, 12, -22), v(0, 8.5, -25)
		sk.headPitch = -55 + 4 * math.sin(t * 6)
	elseif pose == "groom" then
		sk = sitting(t)
		sk.fr = frontLeg(v(3.6, 15, -7), v(2.4, 21, -14.5))
		sk.head = v(1.2, 26.5, -12.5)
		sk.headYaw, sk.headPitch = -20, -35 + 6 * math.sin(t * 7)
	elseif pose == "stalk" then
		sk = standing(t, state.speed or 20, 6)
		sk.head = sk.head + v(0, -2, -2)
		sk.tail = tailCurve(sk.hips + v(0, 2, 6), v(0, -0.1, 1), v(0, 0.15, 1), 28, 0.3 * math.sin(t * 9))
	elseif pose == "crouch" or pose == "swat" then
		sk = standing(t, 0, 7)
		sk.hips = sk.hips + v(1.2 * math.sin(TAU * 3 * t), 2.5, 0) -- (the wiggle before the pat)
		sk.hl, sk.hr = hindLeg(v(-4.2, 11.5, 12), v(-4.2, 1, 13)), hindLeg(v(4.2, 11.5, 12), v(4.2, 1, 13))
		sk.tail = tailCurve(sk.hips + v(0, 2, 6), v(0, 0, 1), v(0, 0.3, 1), 28, 0.5 * math.sin(t * 11))
		if pose == "swat" then
			local k = math.clamp(state.swat or 0, 0, 1)
			local out = math.sin(k * math.pi) -- (out to the far end of its reach halfway through, and back)
			local target = state.paw or v(3.5, 2, -34)
			local shoulder = v(3.8, 10, -12.5)
			local d = target - shoulder
			if d.Magnitude > 26 then d = d.Unit * 26 end
			sk.fr = frontLeg(shoulder, shoulder:Lerp(shoulder + d, out) + v(0, 3 * out, 0))
		end
	else -- "watch"
		sk = if state.seated then sitting(t) else standing(t, 0, 2)
		sk.tail[#sk.tail] = sk.tail[#sk.tail] + v(0.8 * math.sin(t * 10), 0, 0) -- (its tail's tip twitches)
	end
	if state.look ~= nil and pose ~= "sleep" and pose ~= "eat" and pose ~= "groom" then lookAt(sk, state.look) end
	-- the breath, and the eyes: shut asleep, half shut lying awake, a slow blink now and then sitting or lying awake, wide open watching
	sk.breath = 0.025 * math.sin(TAU * t / (if pose == "sleep" then 3.0 else 2.4))
	if pose == "sit" or pose == "rest" or pose == "groom" then sk.shut = math.max(sk.shut, blink(t)) end
	if pose == "watch" or pose == "stalk" or pose == "crouch" or pose == "swat" then sk.shut = 0 end
	return sk
end

-- The parts of a state, in a fixed order (the same names and count for every pose).
function CatPose.parts(state: State): { Part }
	local sk = CatPose.skeleton(state)
	local out: { Part } = {}
	local function add(name: string, kind: string, size: Vector3, cf: CFrame, color: string, full: boolean)
		table.insert(out, { name = name, kind = kind, size = size, cf = cf, color = color, full = full })
	end
	local b = 1 + sk.breath
	local function mass(c: Vector3, pitch: number, yaw: number?): CFrame
		return CFrame.new(c) * CFrame.Angles(0, math.rad(yaw or 0), 0) * CFrame.Angles(math.rad(pitch), 0, 0)
	end
	local yaws = sk.yawBody or { 0, 0, 0 }
	local chestCF, bellyCF, hipsCF = mass(sk.chest, -sk.chestPitch, yaws[1]), mass(sk.belly, -sk.bellyPitch, yaws[2]), mass(sk.hips, -sk.hipsPitch, yaws[3])
	add("Chest", "ellipsoid", v(12 * b, 14 * b, 16), chestCF, C.fur, false)
	add("Belly", "ellipsoid", v(12.5 * b, 12 * b, 22), bellyCF, C.fur, false)
	add("Hips", "ellipsoid", v(12, 13, 12), hipsCF, C.fur, false)
	add("BellyFur", "ellipsoid", v(9.5, 7, 18), bellyCF * CFrame.new(0, -3.2, 0), C.light, true)
	add("Bib", "ellipsoid", v(8, 10, 6), chestCF * CFrame.new(0, -1.5, -5.6), C.light, true)
	-- the tabby's stripes: bands round each of the body's masses, a little proud of it (so they follow it however it lies)
	-- (each band is the mass's own cross-section where it lies, a millimetre proud: an ellipsoid's section at z is its x and y scaled by sqrt(1 - (z / half its length)^2))
	local bands: { { any } } = { { chestCF, -2.5, v(12 * b, 14 * b, 16) }, { chestCF, 3.5, v(12 * b, 14 * b, 16) }, { bellyCF, -5.5, v(12.5 * b, 12 * b, 22) },
		{ bellyCF, 4.5, v(12.5 * b, 12 * b, 22) }, { hipsCF, -2.5, v(12, 13, 12) }, { hipsCF, 3, v(12, 13, 12) } }
	for i, band in bands do
		local size: Vector3 = band[3]
		local k = math.sqrt(math.max(0.05, 1 - ((band[2] :: number) / (size.Z / 2)) ^ 2))
		add(`Stripe{i}`, "ellipsoid", v(size.X * k + 0.08, size.Y * k + 0.08, 1.2), (band[1] :: CFrame) * CFrame.new(0, 0, band[2]), C.stripe, true)
	end
	-- the neck, the collar round it and its bell
	local neckCF = along(sk.neckA, sk.neckB)
	add("Neck", "ellipsoid", v(7.6, 8.6, (sk.neckB - sk.neckA).Magnitude + 5), neckCF, C.fur, false)
	local collarAt = sk.neckA:Lerp(sk.neckB, 0.45)
	local collarCF = along(collarAt - (sk.neckB - sk.neckA).Unit * 0.6, collarAt + (sk.neckB - sk.neckA).Unit * 0.6) * CFrame.Angles(0, math.pi / 2, 0)
	add("Collar", "cylinder", v(1.2, 8.8, 8.8), collarCF, C.collar, false)
	add("Bell", "ball", v(1.4, 1.4, 1.4), CFrame.new(collarAt + (neckCF.UpVector * -4.6)), C.bell, false)
	-- the head and its face
	local headCF = CFrame.new(sk.head) * CFrame.Angles(0, math.rad(sk.headYaw), 0) * CFrame.Angles(math.rad(sk.headPitch), 0, 0) * CFrame.Angles(0, 0, math.rad(sk.headRoll))
	add("Head", "ellipsoid", v(9.5, 8.5, 8.5), headCF, C.fur, false)
	add("CheekL", "ellipsoid", v(4.2, 4.4, 4), headCF * CFrame.new(-3.2, -1.4, -2), C.fur, true)
	add("CheekR", "ellipsoid", v(4.2, 4.4, 4), headCF * CFrame.new(3.2, -1.4, -2), C.fur, true)
	add("Muzzle", "ellipsoid", v(4.6, 3.4, 3.2), headCF * CFrame.new(0, -2, -4.2), C.white, false)
	add("Nose", "ellipsoid", v(1.3, 0.8, 0.7), headCF * CFrame.new(0, -0.9, -5.75), C.nose, false)
	add("Chin", "ellipsoid", v(3, 1.6, 2.5), headCF * CFrame.new(0, -3.4, -3), C.white, true)
	for i, side in { -1, 1 } do
		local tag = if side < 0 then "L" else "R"
		local ear = headCF * CFrame.new(side * 3, 4.3, 0.6) * CFrame.Angles(math.rad(-10), 0, math.rad(-side * 16))
		add("Ear" .. tag, "ellipsoid", v(3.6, 4.8, 0.9), ear, C.fur, false)
		add("EarIn" .. tag, "ellipsoid", v(2.4, 3.3, 0.3), ear * CFrame.new(0, -0.3, -0.45), C.inner, true)
		local _ = i
	end
	for _, side in { -1, 1 } do
		local tag = if side < 0 then "L" else "R"
		local eye = headCF * CFrame.new(side * 2.2, 1, -3.35)
		add("Eye" .. tag, "ball", v(1.95, 1.95, 1.95), eye, C.iris, false)
		add("Pupil" .. tag, "ellipsoid", v(0.45, 1.5, 0.3), eye * CFrame.new(0, 0, -0.92), C.pupil, false)
		local shut = math.clamp(sk.shut, 0, 1)
		add("Lid" .. tag, "ellipsoid", v(2.15, 0.25 + shut * 1.9, 2.1), eye * CFrame.new(0, 0.98 * (1 - shut), 0.02), C.fur, false)
	end
	for _, side in { -1, 1 } do
		for k = 1, 3 do
			local a = (headCF * CFrame.new(side * 2.1, -2.1, -5)).Position
			local bb = (headCF * CFrame.new(side * 8.5, -2.6 + k * 0.8, -5.6 + k * 0.5)).Position
			add(`Whisker{if side < 0 then "L" else "R"}{k}`, "cylinder", v((bb - a).Magnitude, 0.09, 0.09), along(a, bb) * CFrame.Angles(0, math.pi / 2, 0), C.whisker, true)
		end
	end
	-- the legs: bones as ellipsoids along them, and the paws
	local function bone(name: string, a: Vector3, bb: Vector3, d: number, color: string)
		add(name, "ellipsoid", v(d, d, (bb - a).Magnitude + d * 0.7), along(a, bb), color, false)
	end
	for _, item in { { "FL", sk.fl }, { "FR", sk.fr } } :: { { any } } do
		local leg: Leg = item[2]
		bone(item[1] .. "Upper", leg.a, leg.b, 3.4, C.fur)
		bone(item[1] .. "Lower", leg.b, leg.c, 2.5, C.fur)
		add(item[1] .. "Paw", "ellipsoid", v(2.8, 1.8, 3.6), CFrame.new(leg.d :: Vector3), C.light, false)
	end
	for _, item in { { "HL", sk.hl }, { "HR", sk.hr } } :: { { any } } do
		local leg: Leg = item[2]
		bone(item[1] .. "Thigh", leg.a, leg.b, 4.2, C.fur)
		bone(item[1] .. "Shank", leg.b, leg.c, 2.7, C.fur)
		bone(item[1] .. "Foot", leg.c, leg.d :: Vector3, 2.1, C.fur)
		add(item[1] .. "Paw", "ellipsoid", v(2.8, 1.8, 3.4), CFrame.new(leg.d :: Vector3), C.light, false)
	end
	-- the tail, ringed dark and light, thinning to its tip
	for i = 1, 10 do
		local d = 2.9 - 1.2 * (i - 1) / 9
		bone(`Tail{i}`, sk.tail[i], sk.tail[i + 1], d, if i % 2 == 0 then C.stripe else C.fur)
	end
	-- the forehead's dark marks (the tabby's "M")
	add("Brow1", "ellipsoid", v(0.8, 0.4, 3), headCF * CFrame.new(-1.1, 3.9, -1.2), C.stripe, true)
	add("Brow2", "ellipsoid", v(0.8, 0.4, 3), headCF * CFrame.new(1.1, 3.9, -1.2), C.stripe, true)
	return out
end

-- The cat's frame in the world: on its surface at `pos`, facing `heading` (flat).
function CatPose.frame(pos: Vector3, heading: Vector3): CFrame
	local f = v(heading.X, 0, heading.Z)
	if f.Magnitude < 1e-4 then f = v(0, 0, -1) end
	return CFrame.lookAt(pos, pos + f.Unit, Vector3.yAxis)
end

return table.freeze(CatPose)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">DogGait</string>
            <string name="Source"><![CDATA[--!strict
-- Presentation only. Stance paws remain in world space; travel drives the
-- diagonal step pairs. Two-bone joints connect those paws to the moving body.
local DogGait={}
DogGait.STRIDE=40
DogGait.STANCE=.6
DogGait.UPPER=22
DogGait.LOWER=20
local Y=Vector3.yAxis
local function smooth(t: number): number return t*t*(3-2*t) end
local function nominal(frame: CFrame,i: number,lead: number): Vector3
 return frame:PointToWorldSpace(Vector3.new(if i%2==1 then -8 else 8,0,if i<=2 then -20-lead else 19-lead))
end
function DogGait.new(): any
 return {cycle=0,previous=nil,heading=nil,feet={},resets=0}
end
function DogGait.joint(hip: Vector3,ankle: Vector3,pole: Vector3): (Vector3,Vector3)
 local delta=ankle-hip
 local distance=math.clamp(delta.Magnitude,math.abs(DogGait.UPPER-DogGait.LOWER)+.01,DogGait.UPPER+DogGait.LOWER-.01)
 local direction=if delta.Magnitude>.001 then delta.Unit else -Y
 local along=(DogGait.UPPER^2-DogGait.LOWER^2+distance^2)/(2*distance)
 local bend=pole-direction*pole:Dot(direction)
 if bend.Magnitude<.001 then
  local axis=if math.abs(direction.X)<.9 then Vector3.xAxis else Vector3.zAxis
  bend=axis-direction*axis:Dot(direction)
 end
 local knee=hip+direction*along+bend.Unit*math.sqrt(math.max(0,DogGait.UPPER^2-along^2))
 return knee,hip+direction*distance
end
function DogGait.step(self: any,frame: CFrame,dt: number,ground: (Vector3)->Vector3?,reduced: boolean): any
 local travelled=if self.previous then (frame.Position-self.previous).Magnitude else 0
 local turn=if self.heading then math.acos(math.clamp(self.heading:Dot(frame.LookVector),-1,1)) else 0
 local reset=self.previous==nil or travelled>DogGait.STRIDE*.75 or turn>1.3
 self.previous,self.heading=frame.Position,frame.LookVector
 if reset then self.feet={};self.cycle=0;self.resets+=1;travelled=0;turn=0 end
 local moving=travelled>.001 or turn>.001
 if not reduced then self.cycle+=(travelled+turn*12)/DogGait.STRIDE end
 local supported=true
 for i=1,4 do
  local phase=self.cycle+(if i==1 or i==4 then 0 else .5)
  local cycle=math.floor(phase);phase%=1
  local f=self.feet[i]
  if f==nil then
   local lead=if reduced then 0 else 12-math.min(phase/DogGait.STANCE,1)*24
   local at=ground(nominal(frame,i,lead))
   f={anchor=at or nominal(frame,i,lead),supported=at~=nil,lastCycle=-1,u=0,heading=frame.LookVector}
   self.feet[i]=f
  end
  if reduced then
   -- A static pose follows the animal without procedural stepping or bobbing.
   local at=ground(nominal(frame,i,0));f.anchor=at or f.anchor;f.supported=at~=nil;f.swing=nil
  elseif phase>=DogGait.STANCE and f.lastCycle~=cycle then
   f.lastCycle=cycle
   local target=ground(nominal(frame,i,if travelled>.05 then 28 else 0))
   if target then
    f.swing={from=f.anchor,to=target,heading=frame.LookVector};f.u=0
   else f.supported=false end
  end
  local hip=nominal(frame,i,0)+Y*33
  -- During a sniff turn the hips move round planted paws without forward
  -- travel. Reposition a reaching paw instead of letting the leg disconnect.
  if not reduced and f.swing==nil and (hip-f.anchor-Y*3.5).Magnitude>36 then
   local target=ground(nominal(frame,i,0))
   if target then f.swing={from=f.anchor,to=target,heading=frame.LookVector,turn=true};f.u=0 end
  end
  if f.swing then
   local u=if f.swing.turn then f.u+math.clamp(dt,0,.15)/.15
    elseif cycle>f.lastCycle then 1 else math.clamp((phase-DogGait.STANCE)/(1-DogGait.STANCE),0,1)
   if not moving then u=math.max(u,f.u+math.clamp(dt,0,.15)/.15) end
   f.u=math.clamp(math.max(u,f.u),0,1)
   f.anchor=f.swing.from:Lerp(f.swing.to,smooth(f.u))+Y*(math.sin(f.u*math.pi)*5)
   if f.u>=1 then f.anchor=f.swing.to;f.heading=f.swing.heading;f.supported=true;f.swing=nil end
  end
  f.hip=hip
  f.knee,f.ankle=DogGait.joint(hip,f.anchor+Y*3.5,frame.LookVector*(if i<=2 then -1 else 1))
  supported=supported and f.supported
 end
 return {feet=self.feet,supported=supported,moving=moving}
end
return DogGait
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="132">
          <Properties>
            <string name="Name">Idle</string>
            <string name="Source"><![CDATA[--!strict
-- Idle motion for the drawn spider (display only, never fed back into movement): a slow breathing bob, a small curious head
-- tilt and the palps' drumming. Pure functions of time so tests/look.luau can check them. All knobs: Appearances.idle / .palp.
-- `calm` is 0..1: SpiderRig eases it up after the spider has stood still for a moment and back to 0 as soon as it moves.

local Idle = {}

export type Pose = {
	bodyLift: number, -- studs: the whole body rises with a breath
	abdomenLift: number, -- studs: the abdomen rises a little more
	abdomenPitch: number, -- radians, rear end up
	headRoll: number, headYaw: number, headPitch: number, -- radians
}

local TAU = math.pi * 2

-- One breath, -1 to 1: a sine of the period with a slow wobble in its depth. The body's lift, the abdomen's pitch and its scale (ROBLOX-87) all follow it.
function Idle.breath(t: number, period: number): number
	return math.sin(TAU * t / period) * (0.85 + 0.15 * math.sin(TAU * t / (period * 2.7) + 0.6))
end

-- The abdomen's scale (ROBLOX-87): 1 plus `breathe.scale` of a breath, as much as `amount` (0..1: standing is 1, moving `breathe.movingShare`, Reduced Motion 0).
-- Appearances without `breathe.scale` (the peacock spider's fan, the ant mimic) do not pulse.
function Idle.abdomenScale(t: number, amount: number, cfg: any): number
	local b = cfg.breathe
	return 1 + (b.scale or 0) * Idle.breath(t, b.period) * amount
end

-- The pose at time t. `out` (ROBLOX-93): a pose to fill and return instead of making a new one, so the rig, which asks every frame, makes no table of it.
function Idle.pose(t: number, calm: number, cfg: any, out: Pose?): Pose
	local b, k = cfg.breathe, cfg.tilt
	local breath = Idle.breath(t, b.period)
	local p = k.periods
	local pose: Pose = out or { bodyLift = 0, abdomenLift = 0, abdomenPitch = 0, headRoll = 0, headYaw = 0, headPitch = 0 }
	pose.bodyLift = b.bodyLift * breath * calm
	pose.abdomenLift = b.lift * breath * calm
	pose.abdomenPitch = math.rad(b.pitchDeg) * breath * calm
	pose.headRoll = math.rad(k.rollDeg) * calm * (0.65 * math.sin(TAU * t / p[1]) + 0.35 * math.sin(TAU * t / p[2] + 1.1))
	pose.headYaw = math.rad(k.yawDeg) * calm * (0.7 * math.sin(TAU * t / p[3] + 0.4) + 0.3 * math.sin(TAU * t / p[4] + 2.0))
	pose.headPitch = math.rad(k.pitchDeg) * calm * math.sin(TAU * t / p[5] + 0.9)
	return pose
end

-- The largest angle each part of the pose can reach (for tests and for the docs).
function Idle.limits(cfg: any): Pose
	local b, k = cfg.breathe, cfg.tilt
	return {
		bodyLift = b.bodyLift, abdomenLift = b.lift, abdomenPitch = math.rad(b.pitchDeg),
		headRoll = math.rad(k.rollDeg), headYaw = math.rad(k.yawDeg), headPitch = math.rad(k.pitchDeg),
	}
end

-- Palp drumming in bursts while the spider stands still: the angle (radians, about the palp's base) of palp k (1 or 2). The rig asks for each palp on its own,
-- every frame (ROBLOX-93: no table made of the pair); `Idle.palps` is the pair, for the tests and the docs.
function Idle.palp(t: number, drum: number, palp: any, k: number): number
	local burst = math.clamp((math.sin(t * 1.3 + 0.7 * k) - 0.55) / 0.3, 0, 1)
	local beat = math.max(0, math.sin(t * TAU * palp.drumHz + math.pi * k))
	return math.rad(palp.drumDeg) * drum * burst * beat
end
function Idle.palps(t: number, drum: number, palp: any): { number }
	return { Idle.palp(t, drum, palp, 1), Idle.palp(t, drum, palp, 2) }
end

-- Authored salticid-like stop/snap/settle accents, not a measured biological frequency.
-- Short asymmetric pulses separated by stillness, instead of continuous vibration.
local function pulse(t: number, period: number, offset: number): number
	local phase = (t + offset) % period
	if phase >= 0.19 then return 0 end
	if phase < 0.035 then return phase / 0.035 end
	return (1 - (phase - 0.035) / 0.155) ^ 2
end
function Idle.snap(t: number, moving: boolean): (number, number)
	local a, b = pulse(t, 1.37, 0.31), pulse(t, 2.11, 0.83)
	return math.rad(if moving then 3 else 5) * (a - b), 0.022 * a
end

return Idle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">Living</string>
            <string name="Source"><![CDATA[--!strict
-- Living motion for the drawn spider (ROBLOX-87): the small things an animal does when it is not being asked to do anything. Display only, full
-- detail only (the rig makes one only when its detail tier has `idle`), never fed back into movement, the camera, the collider, the senses or the
-- simulation's clock. Pure numbers, stepped by SpiderRig with the frame's time, so tests/idle.luau steps it on its own: no Roblox types.
--
-- What it keeps: (1) ATTENTION: a yaw offset of the whole drawn body toward what the player is watching, at most `attention.maxDeg`, eased over
-- `attention.easeSeconds` and back to nothing while the spider walks, and a glance of the principal eyes toward the same point; (2) GROOMING: after
-- `groom.after` seconds of standing, a bout every `groom.gap` seconds from a seeded stream (a palp drawn through the jaws, or a leg I pulled forward and
-- wiped by the palps), and after a meal (the "groom" cue) a longer cleaning (both palps, then legs I and II); (3) ALARM: the "alarm" cue (the wasp's warning, the
-- rival's windup) raises legs I and freezes the idle motion for `alarm.seconds`; (4) a tarantula's STRETCH: with `stretch`, every `stretch.gap` seconds one
-- leg reaches out and settles again over `stretch.seconds`, and it never grooms. Breathing is in Rig/Idle (the abdomen's scale) and SpiderRig.
-- Reduced Motion is none of it. Every number is in the appearance's `idle` table (`groom`, `attention`, `alarm`, `stretch`) and is ART, not measured.

local Living = {}
Living.__index = Living

-- One leg's override: `w` is how far it is drawn there (0..1). `rel` says (x, y, z) is an offset from where the foot is (a stretch), else a place in the
-- body frame in studs (x mirrored for the left leg). `kneeOut` and `kneeUp` bend the knee out and up.
export type LegPose = { w: number, rel: boolean, x: number, y: number, z: number, kneeOut: number, kneeUp: number }
export type Pose = {
	yaw: number, -- radians, the drawn body's extra turn (positive turns toward -X: the body frame's +Y axis)
	glanceX: number, glanceY: number, -- -1..1: where the principal eyes look, across and up
	palpYaw: { number }, palpPitch: { number }, -- the palps' extra turn (toward the jaws) and pitch, radians, palp 1 (left) and palp 2 (right)
	legs: { LegPose }, -- by leg: 1..4 the left legs I to IV, 5..8 the right
	freeze: number, -- 0..1: an alarm: the idle motion stands still
	settle: number, -- 0..1: the mating scene's settle (ROBLOX-89): the body sinks and the breath deepens
	breath: number, -- the breath's gain: 1, and `settle.breath` at full settle
	bout: string?, -- the bout now ("palp", "leg", "meal", "stretch"), or nil
	act: string?, -- the act of the bout now (tests)
}
type Act = { kind: string, start: number, dur: number, index: number }
type Bout = { kind: string, t: number, total: number, acts: { Act }, abort: boolean }
export type State = {
	cfg: any,
	t: number, standS: number, wait: number, weight: number,
	yaw: number, glanceX: number, glanceY: number,
	bout: Bout?, pendingMeal: number?, alarmT: number?,
	meetT: number?, meetLen: number, meetW: number, settleT: number?, settleLen: number, settleW: number, -- the scene's cues (ROBLOX-89): their clock, length and eased weight
	rng: number,
	pose: Pose,
	log: { { t: number, kind: string } }, -- the bouts begun (tests; kept to the last 64)
}

local TAU = math.pi * 2

function Living.hash(text: string): number
	local h = 5381
	for i = 1, #text do h = (h * 33 + string.byte(text, i)) % 4294967296 end
	return h
end

local function unit(self: State): number -- a seeded stream: a linear congruential generator, not a measured anything
	self.rng = (self.rng * 1664525 + 1013904223) % 4294967296
	return self.rng / 4294967296
end
local function range(self: State, r: { number }): number return r[1] + (r[2] - r[1]) * unit(self) end

local function smooth(x: number): number
	local c = math.clamp(x, 0, 1)
	return c * c * (3 - 2 * c)
end

function Living.new(cfg: any, seed: number): State
	local legs: { LegPose } = {}
	for i = 1, 8 do legs[i] = { w = 0, rel = false, x = 0, y = 0, z = 0, kneeOut = 0, kneeUp = 0 } end
	local self: State = {
		cfg = cfg, t = 0, standS = 0, wait = 0, weight = 0, yaw = 0, glanceX = 0, glanceY = 0,
		bout = nil, pendingMeal = nil, alarmT = nil, rng = seed % 4294967296,
		meetT = nil, meetLen = 0, meetW = 0, settleT = nil, settleLen = 0, settleW = 0,
		pose = { yaw = 0, glanceX = 0, glanceY = 0, palpYaw = { 0, 0 }, palpPitch = { 0, 0 }, legs = legs, freeze = 0, settle = 0, breath = 1, bout = nil, act = nil },
		log = {},
	}
	unit(self) -- (the first draws of a small seed are close together)
	unit(self)
	local first = if cfg.groom then cfg.groom.firstWait elseif cfg.stretch then cfg.stretch.firstWait else { 1, 2 }
	self.wait = range(self, first)
	return self
end

-- The cue from the host: "groom" (a meal has ended: a longer cleaning, once it stands still) or "alarm" (a warning: raise legs I and freeze); and, for the mating scene
-- (ROBLOX-89), "meet" (reach out to the other spider) and "settle" (sink and breathe deeper), each for `seconds` (default the look's own) with its ease in and out,
-- and "release", which lets both go at once.
function Living.cue(self: State, name: string, seconds: number?)
	if name == "groom" and self.cfg.groom then
		self.pendingMeal = 30
	elseif name == "alarm" and self.cfg.alarm then
		self.alarmT = 0
	elseif name == "meet" and self.cfg.meet then
		self.meetT, self.meetLen = 0, seconds or self.cfg.meet.seconds
	elseif name == "settle" and self.cfg.settle then
		self.settleT, self.settleLen = 0, seconds or self.cfg.settle.seconds
	elseif name == "release" then
		self.meetT, self.settleT = nil, nil
	end
end

-- A cue's eased weight (a slew-limited share, so a release or a late cue never pops): up while `on`, down otherwise. Under Reduced Motion it is a held pose, all or nothing.
-- (A function of the module, not made again every step: ROBLOX-93.)
local function ease(w: number, on: boolean, spec: any, dt: number, reduced: boolean): number
	if spec == nil then return 0 end
	if reduced then return if on then 1 else 0 end
	return math.clamp(w + (if on then dt / spec.riseSeconds else -dt / spec.fallSeconds), 0, 1)
end

-- The scene's cues for one step: their clocks, and their eased weights.
local function stepScene(self: State, dt: number, reduced: boolean)
	local cfg = self.cfg
	local meet, settle = cfg.meet, cfg.settle
	if self.meetT ~= nil then
		self.meetT += dt
		if self.meetT >= self.meetLen then self.meetT = nil end
	end
	if self.settleT ~= nil then
		self.settleT += dt
		if self.settleT >= self.settleLen then self.settleT = nil end
	end
	-- (a cue's seconds are its whole length, the ease out included: it is let go `fallSeconds` before its end)
	self.meetW = ease(self.meetW, self.meetT ~= nil and meet ~= nil and self.meetT < self.meetLen - meet.fallSeconds, meet, dt, reduced)
	self.settleW = ease(self.settleW, self.settleT ~= nil and settle ~= nil and self.settleT < self.settleLen - settle.fallSeconds, settle, dt, reduced)
end

local function acts(self: State, kind: string): ({ Act }, number)
	local g, out, at = self.cfg.groom, {} :: { Act }, 0
	local function add(k: string, dur: number, index: number)
		table.insert(out, { kind = k, start = at, dur = dur, index = index })
		at += dur
	end
	if kind == "palp" then
		add("palp", g.palpSeconds, 1 + math.floor(unit(self) * 2))
	elseif kind == "leg" then
		add("leg", g.legSeconds, if unit(self) < 0.5 then 1 else 5)
	elseif kind == "meal" then
		add("palps", g.mealPalpSeconds, 0)
		for _, index in { 1, 5, 2, 6 } do add("leg", g.legSeconds, index) end -- both legs I, then both legs II
	elseif kind == "stretch" then
		add("stretch", self.cfg.stretch.seconds, 1 + math.floor(unit(self) * 8))
	end
	return out, at
end

local function begin(self: State, kind: string)
	local list, total = acts(self, kind)
	self.bout = { kind = kind, t = 0, total = total, acts = list, abort = false }
	table.insert(self.log, { t = self.t, kind = kind })
	if #self.log > 64 then table.remove(self.log, 1) end
end

local function clearPose(pose: Pose)
	pose.yaw, pose.glanceX, pose.glanceY, pose.freeze, pose.bout, pose.act = 0, 0, 0, 0, nil, nil
	pose.settle, pose.breath = 0, 1
	pose.palpYaw[1], pose.palpYaw[2], pose.palpPitch[1], pose.palpPitch[2] = 0, 0, 0, 0
	for _, leg in pose.legs do leg.w = 0 end
end

-- (the numbers, not a table of them: a grooming leg and a stretch are set every step, ROBLOX-93)
local function setLeg(pose: Pose, index: number, w: number, x: number, y: number, z: number, kneeOut: number, kneeUp: number, rel: boolean)
	local leg = pose.legs[index]
	leg.w, leg.rel, leg.x, leg.y, leg.z = w, rel, x, y, z
	leg.kneeOut, leg.kneeUp = kneeOut, kneeUp
end
-- A leg to a look's own place (`spec` = { x, y, z, kneeOut, kneeUp }, the last two optional).
local function setLegAt(pose: Pose, index: number, w: number, spec: any, rel: boolean)
	setLeg(pose, index, w, spec.x, spec.y, spec.z, spec.kneeOut or 0, spec.kneeUp or 0, rel)
end

-- The pose of the scene's cues now (their weights are in the state): legs I reach, the palps come up and in, the body sinks and the breath deepens.
function Living._sceneLegs(self: State, pose: Pose, legsFree: boolean)
	local cfg = self.cfg
	local meet, settle = cfg.meet, cfg.settle
	local m = smooth(self.meetW)
	if meet ~= nil and m > 0 then
		if legsFree then
			setLegAt(pose, 1, m, meet.reach, false)
			setLegAt(pose, 5, m, meet.reach, false)
		end
		for k = 1, 2 do
			local inward = if k == 1 then -1 else 1
			pose.palpYaw[k] = inward * math.rad(meet.palpYawDeg) * m
			pose.palpPitch[k] = -math.rad(meet.palpLiftDeg) * m
		end
	end
	local s = smooth(self.settleW)
	if settle ~= nil and s > 0 then
		pose.settle = s
		pose.breath = 1 + (settle.breath - 1) * s
	end
end

-- One step. standing: still on a surface with nothing else drawn on the body; reduced: Reduced Motion; focusYaw and focusPitch (radians) are where the
-- watched point is from the drawn body's heading (nil when nothing is watched); alarmLegs: the legs may be drawn raised (nothing else has them).
function Living.step(self: State, dt: number, standing: boolean, reduced: boolean, focusYaw: number?, focusPitch: number?, alarmLegs: boolean): Pose
	local cfg, pose = self.cfg, self.pose
	clearPose(pose)
	stepScene(self, dt, reduced)
	if reduced then -- no motion at all: whatever was under way is gone (the scene's reach and settle are held as poses, not moved)
		self.bout, self.weight, self.alarmT, self.yaw, self.glanceX, self.glanceY, self.pendingMeal, self.standS = nil, 0, nil, 0, 0, 0, nil, 0
		Living._sceneLegs(self, pose, alarmLegs)
		return pose
	end
	self.t += dt
	self.standS = if standing then self.standS + dt else 0

	Living._sceneLegs(self, pose, alarmLegs)

	-- attention: the body's turn toward the watched point (only while it stands), the eyes' glance toward it (always)
	local att = cfg.attention
	if att then
		local ease = 1 - math.exp(-dt / (att.easeSeconds / 3))
		local want = if standing and focusYaw ~= nil then math.clamp(focusYaw, -math.rad(att.maxDeg), math.rad(att.maxDeg)) else 0
		self.yaw += (want - self.yaw) * ease
		local span = math.rad(att.glanceSpanDeg)
		local gx = if focusYaw ~= nil then math.clamp(-(focusYaw - self.yaw) / span, -1, 1) else 0
		local gy = if focusPitch ~= nil and focusYaw ~= nil then math.clamp(focusPitch / span, -1, 1) else 0
		self.glanceX += (gx - self.glanceX) * ease
		self.glanceY += (gy - self.glanceY) * ease
		pose.yaw, pose.glanceX, pose.glanceY = self.yaw, self.glanceX, self.glanceY
	end

	-- alarm: legs I up and everything else still
	local alarm = cfg.alarm
	local alarming = false
	if self.alarmT ~= nil and alarm then
		local t = self.alarmT + dt
		self.alarmT = if t >= alarm.seconds then nil else t
		local env = smooth(math.min(t / alarm.riseSeconds, (alarm.seconds - t) / alarm.fallSeconds, 1))
		if env > 0 then
			alarming = true
			pose.freeze = env
			if alarmLegs then
				setLegAt(pose, 1, env, alarm.raise, false)
				setLegAt(pose, 5, env, alarm.raise, false)
			end
		end
	end

	-- the scene's reach and settle (ROBLOX-89): grooming and the accents give way, the breath goes on (an alarm still wins the legs)
	if self.meetW > 0 or self.settleW > 0 then alarming = true end

	-- bouts
	local groom = cfg.groom
	local bout = self.bout
	if bout ~= nil then
		if not standing or alarming then bout.abort = true end
		if bout.abort then
			self.weight -= dt / (if groom then groom.abortSeconds else 0.25)
			if self.weight <= 0 then
				self.bout, self.weight = nil, 0
				self.wait = range(self, if groom then groom.gap else cfg.stretch.gap) -- (a bout that was cut short is not begun again at once)
			end
		else
			self.weight = math.min(1, self.weight + dt / 0.2)
			bout.t += dt
			if bout.t >= bout.total then
				self.bout, self.weight = nil, 0
				self.wait = range(self, if groom then groom.gap else cfg.stretch.gap)
			end
		end
	end
	if self.bout == nil and standing and not alarming and (groom or cfg.stretch) then
		local pending = self.pendingMeal
		if pending ~= nil then
			self.pendingMeal = if pending - dt <= 0 then nil else pending - dt
		end
		local after = if groom then groom.after else cfg.stretch.after
		if pending ~= nil and groom and self.standS >= groom.mealDelay then
			self.pendingMeal = nil
			begin(self, "meal")
		elseif self.standS >= after and (groom or cfg.stretch) then
			self.wait -= dt
			if self.wait <= 0 then
				begin(self, if groom then (if unit(self) < 0.5 then "palp" else "leg") else "stretch")
			end
		end
	end

	-- the pose of the act now
	local live = self.bout
	if live ~= nil and self.weight > 0 then
		local current: Act = live.acts[#live.acts]
		for _, a in live.acts do
			if live.t >= a.start and live.t < a.start + a.dur then current = a end
		end
		local a = current
		local u = math.clamp((live.t - a.start) / a.dur, 0, 1)
		local w = smooth(math.min(u, 1 - u) / (if groom then groom.fade else 0.18)) * self.weight
		pose.bout, pose.act = live.kind, a.kind
		if a.kind == "palp" or a.kind == "palps" then
			for k = 1, 2 do
				if a.kind == "palp" and a.index ~= k then continue end
				local phase = if a.kind == "palps" and k == 2 then math.pi else 0
				local stroke = 0.5 - 0.5 * math.cos(TAU * groom.strokes * u + phase) -- 0 at the start of a stroke, 1 at its end
				local inward = if k == 1 then -1 else 1 -- (the yaw that turns each palp toward the midline)
				pose.palpYaw[k] = inward * math.rad(groom.palpYawDeg) * w * (0.35 + 0.65 * stroke)
				pose.palpPitch[k] = math.rad(groom.palpPitchDeg) * w * stroke
			end
		elseif a.kind == "leg" then
			local pair = (a.index - 1) % 4 + 1
			local spec = groom.legs[pair]
			local sweep = math.sin(TAU * groom.strokes * u) -- the leg is drawn through the palps to and fro
			setLeg(pose, a.index, w, spec.x, spec.y, spec.z + spec.sweep * sweep, spec.kneeOut or 0, spec.kneeUp or 0, false)
			for k = 1, 2 do -- both palps come in to hold it
				local inward = if k == 1 then -1 else 1
				pose.palpYaw[k] = inward * math.rad(groom.legPalpYawDeg) * w
				pose.palpPitch[k] = math.rad(groom.palpPitchDeg) * 0.5 * w * (0.5 + 0.5 * sweep)
			end
		elseif a.kind == "stretch" then
			local st = cfg.stretch
			local pair = (a.index - 1) % 4 + 1
			local along = if pair <= 2 then -st.along else st.along * 0.6
			setLeg(pose, a.index, smooth(math.min(u, 1 - u) / 0.35) * self.weight, st.out, st.lift, along, 0, st.kneeUp or 0, true)
		end
	end
	return pose
end

return Living
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">PeacockDance</string>
            <string name="Source"><![CDATA[--!strict
-- The peacock spider's courtship dance as a pose (ROBLOX-29): pure, Vector3-free, display only. Nothing here moves the body, the
-- collider, the senses, the jump or the silk; SpiderRig reads the pose and bends the drawn abdomen, fan, palps and legs III.
-- All numbers are in Data/Peacock (documented ones from Girard et al. 2011, the rest marked artistic).
--
-- A dance is a loop of phases (approach with bobbing and a rumble-rump, the fan raised with legs III up, the fan dance with the leg
-- wave, a freeze with fan-flapping, a second dance, the fold) played from the time it is given: step(dt, standing, moving) adds
-- the dt it is handed, so slow motion slows the dance as it slows everything else. Walking, a jump, leaving the surface or stop()
-- end it at once; the pose then eases out over Peacock.fadeOutSeconds from where it was.

local Peacock = require(script.Parent.Parent.Data.Peacock)

local PeacockDance = {}
PeacockDance.__index = PeacockDance

-- Every angle is in radians. Sway and shiver are signed; fanOpen, legsRaise and legsWave run 0..1 (legsWave: 0 erect, 1 swept down).
export type Pose = {
	phase: string, -- the phase of the loop, "none" when no dance shows
	presence: number, -- 0..1: how much of the pose shows (ramps in and out)
	abdomenPitch: number, -- rear end up
	abdomenSway: number, -- side to side with the fan up
	shiver: number, -- the 12.1 Hz tremble of a rumble-rump
	fanOpen: number,
	palp: number, -- both pedipalps, in unison
	legsRaise: number,
	legsWave: number,
	rumble: number, -- 0..1: a rumble-rump is on (for the felt caption, not for the picture)
}

local TAU = math.pi * 2

local function smooth(x: number): number
	local c = math.clamp(x, 0, 1)
	return c * c * (3 - 2 * c)
end

PeacockDance.NONE = {
	phase = "none", presence = 0, abdomenPitch = 0, abdomenSway = 0, shiver = 0, fanOpen = 0, palp = 0, legsRaise = 0, legsWave = 0, rumble = 0,
} :: Pose

-- Which phase a loop time falls in: its index, the seconds into it and the loop time it starts at.
function PeacockDance.phaseAt(t: number): (number, number, number)
	local phases = Peacock.phases
	local u = t % Peacock.loopSeconds
	local start = 0
	for i, p in phases do
		if u < start + p.seconds then return i, u - start, start end
		start += p.seconds
	end
	return #phases, phases[#phases].seconds, start - phases[#phases].seconds
end

local LEVELS = { "pitch", "open", "legs", "sway", "wave", "flap", "bob", "palp" }

-- The levels (0..1) at a loop time: the previous phase's, eased toward this phase's over its `ease`.
local function levelsAt(t: number): ({ [string]: number }, string)
	local phases = Peacock.phases
	local i, u = PeacockDance.phaseAt(t)
	local cur, prev = phases[i], phases[if i == 1 then #phases else i - 1]
	local k = smooth(u / math.max(math.min(cur.ease or Peacock.ease, cur.seconds), 1e-6))
	local out: { [string]: number } = {}
	for _, name in LEVELS do
		local a, b = (prev :: any)[name] :: number, (cur :: any)[name] :: number
		out[name] = a + (b - a) * k
	end
	return out, cur.id
end

-- 0..1: a rumble-rump is on at this loop time (it starts `rumble` seconds into its phase and lasts Peacock.rumble.seconds).
local function rumbleAt(t: number): number
	local u = t % Peacock.loopSeconds
	local start = 0
	local r = Peacock.rumble
	for _, p in Peacock.phases do
		local at = p.rumble
		if at then
			local from, to = start + at, start + at + r.seconds
			if u >= from and u <= to then
				return math.min(smooth((u - from) / r.edgeSeconds), smooth((to - u) / r.edgeSeconds))
			end
		end
		start += p.seconds
	end
	return 0
end

-- 0..1: inside a bobbing bout (bouts and rests repeat through the loop; the phase's `bob` level says where they show).
local function bobBoutAt(t: number): number
	local b = Peacock.rates.bob
	local u = t % (b.boutSeconds + b.restSeconds)
	if u >= b.boutSeconds then return 0 end
	return math.min(smooth(u / 0.1), smooth((b.boutSeconds - u) / 0.1))
end

-- The whole pose at a loop time, before presence. reduced: ReducedMotion (half amplitudes, no tremble).
function PeacockDance.rawPose(t: number, reduced: boolean): Pose
	local L, id = levelsAt(t)
	local a, r = Peacock.amplitude, Peacock.rates
	local amp = if reduced then Peacock.reducedMotion else 1
	local rumble = rumbleAt(t)
	local bob = L.bob * bobBoutAt(t) * math.sin(TAU * r.bob.hz * t) * math.rad(a.bobDeg) * amp
	local flap = L.flap * a.flapDepth * amp * (0.5 + 0.5 * math.sin(TAU * r.fanFlap.hz * t))
	return {
		phase = id, presence = 1,
		abdomenPitch = L.pitch * math.rad(a.raiseDeg) + bob,
		abdomenSway = L.sway * math.rad(Peacock.fanArcDeg.used / 2) * math.sin(TAU * r.fanDance.hz * t) * amp,
		shiver = if reduced then 0 else rumble * math.rad(a.shiverDeg) * math.sin(TAU * Peacock.rumble.bumpsHz * t),
		fanOpen = L.open * (1 - flap),
		palp = L.palp * math.rad(a.palpDeg) * amp * (0.5 + 0.5 * math.sin(TAU * r.palpFlicker.hz * t)),
		legsRaise = L.legs,
		legsWave = L.wave * amp * (0.5 + 0.5 * math.sin(TAU * r.legWave.hz * t + 1.2)),
		rumble = rumble,
	}
end

local function scaled(p: Pose, k: number): Pose
	return {
		phase = p.phase, presence = k,
		abdomenPitch = p.abdomenPitch * k, abdomenSway = p.abdomenSway * k, shiver = p.shiver * k, fanOpen = p.fanOpen * k,
		palp = p.palp * k, legsRaise = p.legsRaise * k, legsWave = p.legsWave * k, rumble = p.rumble * k,
	}
end

export type Dance = typeof(setmetatable(
	{} :: { t: number, active: boolean, presence: number, raw: Pose?, reduced: boolean },
	PeacockDance
))

function PeacockDance.new(): Dance
	return setmetatable({ t = 0, active = false, presence = 0, raw = nil :: Pose?, reduced = false }, PeacockDance)
end

-- Begin the loop from its start. Refused (false) when the spider is not standing still on a surface.
function PeacockDance.start(self: Dance, standing: boolean, moving: boolean): boolean
	if self.active or not standing or moving then return false end
	self.t, self.active = 0, true
	return true
end

-- End the dance at once; the pose eases out over Peacock.fadeOutSeconds from where it was.
function PeacockDance.stop(self: Dance)
	self.active = false
end

-- Showing at all (dancing, or still easing out).
function PeacockDance.showing(self: Dance): boolean
	return self.active or self.presence > 0
end

-- One step of dt seconds (the simulation's, so slow motion slows the dance). standing: on a surface and not in a jump; moving: walking.
function PeacockDance.step(self: Dance, dt: number, standing: boolean, moving: boolean): Pose
	if self.active and (not standing or moving) then self.active = false end
	if self.active then
		self.t += dt
		self.presence = math.min(1, self.presence + dt / Peacock.rampInSeconds)
		self.raw = PeacockDance.rawPose(self.t, self.reduced)
	else
		self.presence = math.max(0, self.presence - dt / Peacock.fadeOutSeconds)
		if self.presence == 0 then self.raw = nil end
	end
	local raw = self.raw
	if raw == nil then return PeacockDance.NONE end
	return scaled(raw, smooth(self.presence))
end

return PeacockDance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">Setae</string>
            <string name="Source"><![CDATA[--!strict
-- Where the spider's hairs (setae) go: pure layout from the appearance table, Vector3 only, so tests/run.luau and
-- tests/look.luau check it. Body frame as in SpiderRig: +Y up, -Z forward. Deterministic: the same appearance always gives
-- the same fuzz. SpiderRig turns each entry into one thin anchored part.
-- The coat is short and sleek and takes its colour from the daughter's pattern: black hairs on the black areas, white hairs
-- only inside the white spots and the band (the pale cheeks stay clean). Nothing grey or frosted is in the body coat; only
-- the face keeps a little silver (the tufts and the ruff) and the palps their fluff.
--   lock: short thin hairs lying nearly flat, combed toward the rear      pale: the same, white, inside a white spot or the band
--   fringe: short hairs along the sides, lifted a little, for a soft edge  guard: a few short hairs that stand up
--   tuft: the plumes at the upper sides of the head       ruff: pale hair low on each cheek
--   palp: the fluff on the pedipalps (rest pose; SpiderRig moves it with the palp)       leg: see Setae.leg
-- The hairs that come in pairs (the tufts, the ruff, the palps' fluff, a leg and the leg that mirrors it) are mirror images of each other, hair for hair (ROBLOX-93), so that a tier
-- that keeps one in so many keeps the same ones on both sides (Setae.thin), and a hair that must be left out for an eye is left out on both. No hair touches an eye (EYE_PAD).

local Anatomy = require(script.Parent.Anatomy)

local Setae = {}

export type Hair = {
	at: Vector3, dir: Vector3, normal: Vector3, length: number, width: number, thick: number, transparency: number,
	kind: string, group: string, side: number, tone: string, white: boolean, grey: boolean, frost: boolean,
}
export type LegHair = { segment: number, t: number, theta: number, length: number, tone: string, white: boolean, grey: boolean, frost: boolean, lift: number?, width: number?, transparency: number? } -- (width, transparency: a fringe's own, ROBLOX-127)
export type Patch = { x: number, z: number, rx: number, rz: number, angle: number }

local GOLDEN = 2.399963229728653
-- How far (studs) any part of a hair stays off every eye's ellipsoid: a little more than half the widest hair's width.
local EYE_PAD = 0.004

-- A repeatable 0..1 value per index (no global RNG state).
local function hash(i: number, salt: number): number
	local x = math.sin(i * 12.9898 + salt * 78.233) * 43758.5453
	return x - math.floor(x)
end
Setae.hash = hash

local function between(range: { number }, t: number): number
	return range[1] + (range[2] - range[1]) * t
end

-- ---------------------------------------------------------------- the pattern: where the white is
-- The white spots and the band as flat ellipses, in studs from the abdomen's centre (x across, z along): the same ones
-- SpiderRig draws as AbdomenSpot and FrontBand. `angle` turns an ellipse about the vertical (CFrame.Angles(0, angle, 0)).
function Setae.patches(look: any): { Patch }
	local ar = look.abdomenRadii
	local out: { Patch } = {}
	for _, s in look.spots do
		table.insert(out, { x = s.x * ar[1], z = s.z * ar[3], rx = s.rx, rz = s.rz, angle = s.angle })
	end
	local band = look.band
	for i = 0, band.count - 1 do
		table.insert(out, { x = (i - (band.count - 1) / 2) * band.step * ar[1], z = band.z * ar[3], rx = band.rx, rz = band.rz, angle = 0 })
	end
	return out
end

-- Is the offset (dx, dz) from the abdomen's centre inside the patch grown by `grow` studs (negative: shrunk)?
local function inside(p: Patch, dx: number, dz: number, grow: number): boolean
	local rx, rz = p.rx + grow, p.rz + grow
	if rx <= 0 or rz <= 0 then return false end
	local c, s = math.cos(p.angle), math.sin(p.angle)
	local ex, ez = dx - p.x, dz - p.z
	local u = ex * c - ez * s
	local v = ex * s + ez * c
	return (u / rx) ^ 2 + (v / rz) ^ 2 < 1
end

local function insideAny(patches: { Patch }, dx: number, dz: number, grow: number): boolean
	for _, p in patches do
		if inside(p, dx, dz, grow) then return true end
	end
	return false
end
Setae.insideAny = insideAny

-- ---------------------------------------------------------------- one hair
local function hair(at: Vector3, dir: Vector3, normal: Vector3, length: number, width: number, flat: number, transparency: number, kind: string, group: string, side: number, tone: string): Hair
	return {
		at = at, dir = dir, normal = normal, length = length, width = width, thick = width * flat, transparency = transparency,
		kind = kind, group = group, side = side, tone = tone, white = tone == "white", grey = tone == "grey", frost = tone == "frost",
	}
end

-- The way a hair lies: along the surface toward the rear (+Z), turned `yaw` radians to one side, raised `lift` radians off the
-- surface (0 lies flat, pi/2 stands up).
local function comb(normal: Vector3, lift: number, yaw: number, outward: number?): Vector3
	local back = Vector3.new(0, 0, 1)
	local along = back - normal * back:Dot(normal)
	if along.Magnitude < 1e-3 then along = Vector3.new(0, 1, 0) - normal * normal.Y end
	if along.Magnitude < 1e-3 then return normal end
	along = along.Unit
	local side = normal:Cross(along)
	local turn = yaw
	if outward and math.abs(normal.X) > 0.05 then
		-- fur that flows back and out: turned away from the back's midline, toward the flank on top and down the flank at the side (ROBLOX-85)
		local away = Vector3.new(normal.Y * (if normal.X >= 0 then 1 else -1), -math.abs(normal.X), 0)
		turn += (if side:Dot(away) >= 0 then 1 else -1) * outward
	end
	return ((along * math.cos(turn) + side * math.sin(turn)) * math.cos(lift) + normal * math.sin(lift)).Unit
end

-- Where a hair of this class starts: a lying hair sits on the surface (half its thickness above it, so it neither sinks in
-- nor floats), a standing one is rooted a little inside.
local function rootOf(surface: Vector3, normal: Vector3, lift: number, thick: number): Vector3
	if lift < math.rad(25) then return surface + normal * (thick * 0.5 + 0.0012) end
	return surface - normal * 0.003
end

-- The hair's three points (root, middle, tip) must all be acceptable.
local function allClear(clear: (Vector3) -> boolean, root: Vector3, dir: Vector3, length: number): boolean
	return clear(root) and clear(root + dir * (length * 0.5)) and clear(root + dir * length)
end

-- One class of coat hairs (kind "lock", "guard" or "fringe") over an ellipsoid; `spec` is the class's table in
-- Appearances.fuzz. `keep(at, unit)` picks where hairs may grow, `clear(point)` rejects a hair that touches something it must
-- leave alone (a white patch, an eye). The colour is black or dark: a hair here is on a black area.
-- (`clearSeg`, if given, is asked of the whole hair, root to tip, as well: ROBLOX-93, so that a hair cannot pass through an eye between its three points.)
local function coat(out: { Hair }, kind: string, spec: any, center: Vector3, radii: Vector3, samples: number, salt: number, group: string, keep: (Vector3, Vector3) -> boolean, clear: (Vector3) -> boolean, clearSeg: ((Vector3, Vector3) -> boolean)?)
	for i = 0, samples - 1 do
		local y = 1 - 2 * (i + 0.5) / samples
		local r = math.sqrt(math.max(0, 1 - y * y))
		local a = i * GOLDEN
		local unit = Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
		if unit.Y > -0.25 then
			local surface = center + Vector3.new(unit.X * radii.X, unit.Y * radii.Y, unit.Z * radii.Z)
			local normal = Vector3.new(unit.X / radii.X, unit.Y / radii.Y, unit.Z / radii.Z).Unit
			if keep(surface, unit) then
				local length = between(spec.length, hash(i, salt))
				local lift = math.rad(between(spec.lift, hash(i, salt + 5)))
				local yaw = math.rad(spec.yaw) * (2 * hash(i, salt + 3) - 1)
				local dir = comb(normal, lift, yaw, if spec.out then math.rad(spec.out) * (0.5 + 0.5 * hash(i, salt + 9)) else nil)
				local root = rootOf(surface, normal, lift, spec.width * spec.flat)
				if allClear(clear, root, dir, length) and (clearSeg == nil or clearSeg(root, root + dir * length)) then
					-- black or dark, and (`tip`) a few with a paler, greyer cast: the tips of a coat catching the light
					local tone = if hash(i, salt + 11) < spec.black then "black" else "dark"
					if spec.tip and hash(i, salt + 17) < spec.tip then tone = "grey" end
					table.insert(out, hair(root, dir, normal, length, spec.width, spec.flat, spec.transparency, kind, group, 0, tone))
				end
			end
		end
	end
end

-- White hairs inside the white spots and the band, lying on top of them (the markings are flat, raised discs): a spiral of
-- hair middles in each ellipse at `spec.density` hairs per square stud, every one kept only if the whole hair stays inside
-- the patch (shrunk by `spec.margin`), so the white keeps its edge.
local function pale(out: { Hair }, look: any, A: Anatomy.Layout, spec: any)
	local patches = Setae.patches(look)
	local ac, ar = A.abdomenCenter, A.abdomenRadii
	local n = 0
	for pi, patch in patches do
		local count = math.floor(math.pi * patch.rx * patch.rz * spec.density + 0.5)
		local c, s = math.cos(patch.angle), math.sin(patch.angle)
		for k = 1, count do
			n += 1
			local ring = if count == 1 then 0 else math.sqrt((k - 0.5) / count) * 0.75
			local ang = k * GOLDEN + pi
			local lu, lv = patch.rx * ring * math.cos(ang), patch.rz * ring * math.sin(ang)
			local mx, mz = patch.x + lu * c + lv * s, patch.z - lu * s + lv * c -- the hair's middle, offsets from the abdomen's centre
			local length = between(spec.length, hash(n, 41))
			local yaw = math.rad(spec.yaw) * (2 * hash(n, 43) - 1)
			local lift = math.rad(between(spec.lift, hash(n, 45)))
			local dir = comb(Vector3.yAxis, lift, yaw)
			local rx, rz = mx - dir.X * length * 0.5, mz - dir.Z * length * 0.5 -- its root
			-- the disc's top: SpiderRig lifts a marking 0.007 above the body and gives it a rounded 0.012 half-thickness
			local rho2 = (lu / patch.rx) ^ 2 + (lv / patch.rz) ^ 2
			local thick = spec.width * spec.flat
			local height = Anatomy.topY(ac, ar, rx, rz) + 0.007 + 0.012 * math.sqrt(math.max(0, 1 - rho2)) + thick * 0.5 + 0.0008
			local root = Vector3.new(ac.X + rx, height, ac.Z + rz)
			local ok = true
			for _, along in { 0, 0.5, 1 } do
				ok = ok and insideAny(patches, rx + dir.X * length * along, rz + dir.Z * length * along, -spec.margin)
			end
			if ok then
				table.insert(out, hair(root, dir, Vector3.yAxis, length, spec.width, spec.flat, spec.transparency, "pale", "abdomen", 0, "white"))
			end
		end
	end
end

-- A fan of hairs growing from a point of the head: `spec` = { at (unit-sphere direction, mirrored), lean, fan, spread, ... }.
-- The two sides are mirror images: the left fan's angles are the right's turned the other way, and a hair's length and tone do not depend on the side. A hair whose
-- length touches an eye (`clearSeg`) is left out (on both sides, being mirror images).
local function plume(out: { Hair }, A: Anatomy.Layout, side: number, spec: any, count: number, length: number, kind: string, salt: number, pick: (number) -> string, clearSeg: (Vector3, Vector3) -> boolean)
	local p0, n0 = Anatomy.ellipsoidPoint(A.headCenter, A.headRadii, Vector3.new(side * spec.at[1], spec.at[2], spec.at[3]))
	local axis = Vector3.new(side * spec.lean[1], spec.lean[2], spec.lean[3]).Unit
	local u = axis:Cross(Vector3.zAxis)
	if u.Magnitude < 1e-3 then u = axis:Cross(Vector3.xAxis) end
	u = u.Unit
	local w = axis:Cross(u).Unit
	for k = 1, count do
		local ring = math.sqrt((k - 0.5) / count)
		local ang = if side > 0 then k * GOLDEN + 1 else math.pi - (k * GOLDEN + 1)
		local off = u * math.cos(ang) + w * math.sin(ang)
		local dir = (axis + off * (spec.fan * ring)).Unit
		local at = p0 + off * (spec.spread * ring) - n0 * 0.012
		local l = length * (0.82 + 0.36 * hash(k, salt))
		if clearSeg(at, at + dir * l) then
			table.insert(out, hair(at, dir, n0, l, spec.width, spec.flat, spec.transparency, kind, "head", side, pick(k * 3)))
		end
	end
end

function Setae.body(look: any): { Hair }
	local out: { Hair } = {}
	local f = look.fuzz
	if not f or not f.enabled or f.legsOnly then return out end -- (legsOnly: bristles on the legs and nowhere else, the Greenbottle blue)
	local A = Anatomy.layout(look)
	local cheek = look.cheek
	local cy = (cheek.y - A.headCenter.Y) / A.headRadii.Y
	local cz = (cheek.z - A.headCenter.Z) / A.headRadii.Z
	local patches = Setae.patches(look)
	local ac, ar = A.abdomenCenter, A.abdomenRadii
	local hc, hr = A.headCenter, A.headRadii

	-- Black hairs keep off the white: no point of a hair may come within `f.clear` studs of a spot or the band, and none
	-- may lie on the pale cheek. (The pattern is on the upper surface; the lower flanks have none.)
	local function offWhiteAbdomen(p: Vector3): boolean
		if p.Y < ac.Y + 0.02 then return true end
		return not insideAny(patches, p.X - ac.X, p.Z - ac.Z, f.clear)
	end
	local function offCheek(p: Vector3): boolean
		local u = Vector3.new((p.X - hc.X) / hr.X, (p.Y - hc.Y) / hr.Y, (p.Z - hc.Z) / hr.Z)
		if math.abs(u.X) < 0.5 * u.Magnitude then return true end
		local dy = (u.Y / u.Magnitude - cy) / (cheek.radii[2] / hr.Y + f.clear / hr.Y)
		local dz = (u.Z / u.Magnitude - cz) / (cheek.radii[3] / hr.Z + f.clear / hr.Z)
		return dy * dy + dz * dz > 1.4
	end

	-- No part of a hair touches an eye (the whole hair, root to tip, against every eye's ellipsoid).
	local function offEyes(a: Vector3, b: Vector3): boolean
		for _, eye in A.eyes do
			if Anatomy.touchesEye(eye, a, b, EYE_PAD) then return false end
		end
		return true
	end

	local coats: { { kind: string, spec: any } } = { { kind = "lock", spec = f.locks }, { kind = "guard", spec = f.guard } }
	if f.fringe then table.insert(coats, { kind = "fringe", spec = f.fringe }) end
	for n, entry in coats do
		local kind, spec = entry.kind, entry.spec
		local sideOnly: number = spec.side or 0 -- the fringe grows only at the sides, where it makes the outline
		coat(out, kind, spec, ac, ar, spec.abdomen, n, "abdomen", function(_at, unit)
			return unit.Z > -0.93 and math.abs(unit.X) >= sideOnly -- not where the abdomen meets the pedicel
		end, offWhiteAbdomen)
		coat(out, kind, spec, hc, hr, spec.head, n + 2, "head", function(at, unit)
			if math.abs(unit.X) < sideOnly then return false end
			if unit.Z < -0.55 and unit.Y < 0.75 then return false end -- the eye face stays clear
			for _, zone in A.hairFree do
				if (at - zone.at).Magnitude < zone.radius then return false end
			end
			return true
		end, offCheek, offEyes)
	end
	pale(out, look, A, f.pale)

	-- Tufts: dark and silvery plumes up and out at the upper sides of the head.
	for _, side in { -1, 1 } do
		plume(out, A, side, f.tuft, f.tuftHairs, f.tuftLength, "tuft", 7, function(i)
			local r = hash(i, 21)
			return if r < 0.15 then "frost" elseif r < 0.45 then "grey" else "dark"
		end, offEyes)
	end
	-- Cheek ruff: pale hair low at the sides of the face, beside the jaws.
	local rf = f.ruff
	for _, side in { -1, 1 } do
		plume(out, A, side, { at = rf.at, lean = rf.lean, fan = 0.55, spread = 0.03, width = rf.width, flat = rf.flat, transparency = rf.transparency }, rf.hairs, rf.length, "ruff", 17, function(i)
			local r = hash(i, 23)
			return if r < rf.whiteShare then "white" elseif r < 0.85 then "frost" else "grey"
		end, offEyes)
	end
	return out
end

-- Fluff on the pedipalps, in the body frame at rest (SpiderRig moves it with the palp it belongs to; side -1 is palp 1).
function Setae.palp(look: any): { Hair }
	local out: { Hair } = {}
	local f = look.fuzz
	if not f or not f.enabled or f.legsOnly then return out end
	local A = Anatomy.layout(look)
	local pl = look.palp
	local spec = pl.fluff
	for _, p in A.palps do
		local axis = p.tip - p.base
		local ax = axis.Unit
		local u = ax:Cross(Vector3.xAxis)
		if u.Magnitude < 1e-3 then u = ax:Cross(Vector3.yAxis) end
		u = u.Unit
		local w = ax:Cross(u).Unit
		for k = 1, spec.hairs do
			local t = 0.3 + 0.7 * (k - 0.5) / spec.hairs
			local theta = (k * GOLDEN + 1) * p.side -- (the left palp's angles are the right's turned the other way: its hairs are the mirror images of the right's)
			local radial = u * math.cos(theta) + w * math.sin(theta)
			local r = if t > 0.7 then pl.club[1] else pl.stalk * 0.5
			local dir = (radial + ax * 0.6).Unit
			local l = spec.length * (0.8 + 0.4 * hash(k, 31))
			local rr = hash(k, 33)
			local tone = if rr < 0.55 then "white" elseif rr < 0.75 then "frost" else "grey"
			table.insert(out, hair(p.base + axis * t + radial * (r * 0.8), dir, radial, l, spec.width, spec.flat, spec.transparency, "palp", "palp", p.side, tone))
		end
	end
	return out
end

-- The hairs a tier keeps (ROBLOX-93; it was in SpiderRig, and is here so that the tests read what it keeps): one in `every[kind]` of each kind (a kind not listed keeps all, 0 drops
-- the kind), counted in the order the hairs were laid out and, for the hairs that come in a mirrored pair (`side` is -1 or 1: the tufts, the ruff, the palps' fluff), on each side
-- by itself, so both sides keep the same indices and the same number: one count over both, with an odd number to a side, kept different hairs, and a different number, on the two.
function Setae.thin(hairs: { Hair }, every: { [string]: number }): { Hair }
	local out: { Hair } = {}
	local seen: { [string]: number } = {}
	for _, h in hairs do
		local each = every[h.kind] or 1
		if each <= 0 then continue end
		local key = h.kind .. h.side
		local n = (seen[key] or 0) + 1
		seen[key] = n
		if n % each == 0 then table.insert(out, h) end
	end
	return out
end

-- Hairs on one leg: segment 1 femur, 2 tibia, 3 tarsus; t along it (0 base .. 1 tip); theta around it.
-- White over the leg's pale band (the middle bandFraction of each segment, as SpiderRig draws it), black everywhere else.
-- ROBLOX-93: legs 5 to 8 (the right) are the mirror images of legs 1 to 4: the same hairs, every angle round the leg turned the other way (the rod frames of the two sides face
-- opposite ways, so a hair at the same angle would stand on the other side of the leg), and so a tier that keeps the same indices on both keeps the same hairs. `hipBare` (a share of
-- the femur from the hip, for each pair): the femurs of the first two pairs start at the face, where the anterior lateral eyes are, and hairs there would stand in the eyes.
function Setae.leg(look: any, legIndex: number): { LegHair }
	local out: { LegHair } = {}
	local f = look.fuzz
	if not f or not f.enabled then return out end
	local twin = (legIndex - 1) % 4 + 1 -- the pair, and the left leg of it
	local mirror = if legIndex > 4 then -1 else 1
	local front = twin == 1 -- the first legs carry a denser, longer fringe, as in Phidippus
	local byPair = if f.legPairs then f.legPairs[twin] else nil -- (legPairs: a count per segment for each pair of legs, the front pair's the most)
	local bare = if f.hipBare then f.hipBare[twin] else 0
	for segment = 1, 3 do
		local n = if byPair then byPair[segment] elseif front and segment < 3 then math.floor(f.legHairs[segment] * 1.6) else f.legHairs[segment]
		for k = 1, n do
			local i = twin * 100 + segment * 10 + k
			local t = (k - 0.5) / n
			if f.legSpan then t = f.legSpan[1] + (f.legSpan[2] - f.legSpan[1]) * t end -- (legSpan: only this stretch of the link carries hairs, clear of the patella and the ankle)
			if segment == 1 then t = bare + (1 - bare) * t end -- (hipBare: the femur's hairs are spread over the rest of it)
			-- legEdge: the hairs grow from the sides of the leg, between these two angles (degrees from the top), one side and the other in turn: a fringe
			local theta = mirror * (if f.legEdge then (if (k + twin) % 2 == 0 then 1 else -1) * math.rad(between(f.legEdge, hash(i, 9))) else k * GOLDEN + twin)
			local white = math.abs(t - 0.5) < look.bandFraction * 0.6
			local tone = if f.legTone then f.legTone elseif white then "white" elseif hash(i, 13) < f.legBlack then "black" else "dark" -- (legTone: every bristle one tone)
			if f.legTip and tone ~= "white" and hash(i, 17) < f.legTip then tone = "grey" end
			table.insert(out, {
				segment = segment, t = t, theta = theta,
				length = f.legLength * (0.7 + 0.6 * hash(i, 5)) * (if segment == 3 then 0.6 elseif front then 1.4 else 1),
				tone = tone, white = tone == "white", grey = tone == "grey", frost = tone == "frost",
				lift = if f.legLift then math.rad(between(f.legLift, hash(i, 7))) else nil, -- (legLift: the hair lies at this angle off the leg, toward the foot)
			})
		end
	end
	return out
end

-- The fringe on a leg (ROBLOX-127; look.fuzz.legFringe): longer hairs standing out from the sides and underside of a link, leaning toward the foot, the fringes a
-- bold jumping spider has on its first legs (and a male's heavier and, in the rival, dark). `pairs[pair]` gives the count on the femur, tibia and tarsus; the hairs
-- are spread over the middle of the link (0.15 to 0.9 of it), one side and then the other between `edge`'s two angles (degrees from the top of the leg). Legs 5 to 8
-- mirror 1 to 4 as Setae.leg's do. The same LegHair shape: SpiderRig draws them with the leg's own hairs, and a tier keeps one in `every.legFringe`.
function Setae.legFringe(look: any, legIndex: number): { LegHair }
	local out: { LegHair } = {}
	local f = look.fuzz
	local spec = if f and f.enabled then f.legFringe else nil
	if spec == nil then return out end
	local twin = (legIndex - 1) % 4 + 1
	local mirror = if legIndex > 4 then -1 else 1
	local counts = spec.pairs[twin]
	if counts == nil then return out end
	local bare = if f.hipBare then f.hipBare[twin] else 0
	for segment = 1, 3 do
		local n = counts[segment] or 0
		for k = 1, n do
			local i = twin * 1000 + segment * 100 + k
			local t = 0.15 + 0.75 * (k - 0.5) / n
			if segment == 1 then t = bare + (1 - bare) * t end -- (as the leg's own hairs: none on the femur's bare stretch by the face, where the anterior lateral eyes are)
			local theta = mirror * (if k % 2 == 0 then 1 else -1) * math.rad(between(spec.edge, hash(i, 51)))
			table.insert(out, {
				segment = segment, t = t, theta = theta,
				length = between(spec.length, hash(i, 53)) * (if segment == 1 then 0.8 else 1),
				tone = spec.tone, white = spec.tone == "white", grey = spec.tone == "grey", frost = spec.tone == "frost",
				lift = math.rad(between(spec.lift, hash(i, 57))), width = spec.width, transparency = spec.transparency,
			})
		end
	end
	return out
end

-- A tarantula's urticating patch (ROBLOX-85): a denser cluster of short, ginger-rust hairs standing out of the patch on the abdomen's back, combed
-- toward the rear, in the body frame. `look.cluster` = { mark (the name of the patch in look.marks), hairs, length, lift, yaw, width, flat, color, paler }.
function Setae.cluster(look: any): { Hair }
	local out: { Hair } = {}
	local c = look.cluster
	if not c then return out end
	local mark
	for _, m in look.marks do
		if m.name == c.mark then mark = m end
	end
	if not mark then return out end
	local ac, ar = Anatomy.v3(look.abdomenCenter), Anatomy.v3(look.abdomenRadii)
	for k = 1, c.hairs do
		local ring = math.sqrt((k - 0.5) / c.hairs) * 0.82
		local ang = k * GOLDEN
		local dx, dz = mark.rx * ring * math.cos(ang), mark.rz * ring * math.sin(ang)
		local x, z = mark.x * ar.X + dx, mark.z * ar.Z + dz
		local surface = Vector3.new(ac.X + x, Anatomy.topY(ac, ar, x, z), ac.Z + z)
		local normal = Anatomy.normalAt(ac, ar, surface)
		local lift = math.rad(between(c.lift, hash(k, 61)))
		local yaw = math.rad(c.yaw) * (2 * hash(k, 63) - 1)
		local dir = comb(normal, lift, yaw)
		local length = between(c.length, hash(k, 65))
		local h = hair(surface - normal * 0.003, dir, normal, length, c.width, c.flat, c.transparency, "cluster", "abdomen", 0, if hash(k, 67) < c.paler then "frost" else "grey")
		table.insert(out, h)
	end
	return out
end

return Setae
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">SpiderChoice</string>
            <string name="Source"><![CDATA[--!strict
-- Which spider the player is (ROBLOX-31, ROBLOX-64, ROBLOX-81): the first spider, the peacock spider, the ant-mimicking spider or one of the two
-- tarantulas of the tarantula pack. Pure, so tests/peacock.luau checks it.
-- The choice is remembered for the session in the Player attribute `Appearance`; the Workspace attribute `Appearance` can preselect
-- it for Studio and playtests. Anything that is not a known appearance is the default (the first spider).
local Appearances = require(script.Parent.Parent.Data.Appearances)

local SpiderChoice = {}

-- The spiders to choose between, in the order the crack's key cycles through them.
SpiderChoice.ORDER = { "first_spider", "maratus_volans_male", "myrmarachne_formicaria_female", "brachypelma_hamorii", "chromatopelma_cyaneopubescens" } :: { string }

-- Only a spider in ORDER can be the player: the brown rival's look (Data/Appearances.rival_spider) is drawn for the other spider and is never
-- offered by the cycle or accepted from an attribute or a save.
local function known(id: any): boolean
	if type(id) ~= "string" or Appearances.profiles[id] == nil then return false end
	for _, name in SpiderChoice.ORDER do
		if name == id then return true end
	end
	return false
end

-- The appearance to start with: the Player attribute if it names one, else the Workspace attribute, else the default.
function SpiderChoice.start(playerAttribute: any, workspaceAttribute: any): string
	if known(playerAttribute) then return playerAttribute :: string end
	if known(workspaceAttribute) then return workspaceAttribute :: string end
	return Appearances.default
end

-- Is this spider not the player's to be yet (ROBLOX-71)? Nothing is locked while the add-ons are free for testing (ROBLOX-66), so this is
-- always false. It is the one place to wire ownership when Nathan says the sales start: ROBLOX-48's Game Pass pattern (the server checks
-- ownership, a replicated Player attribute holds the answer, a Studio override) fills `owned` ({ [appearance id] = true }), and this
-- returns true for a pass-only spider (the peacock, the ant mimic, and the pair in the tarantula pack, `packOf` below) that is not in it. The
-- first spider is never locked. Both ways of choosing, the crack's key and the Settings row, skip a locked spider through next() and step()
-- below. Nathan's default for the tarantula pack (ROBLOX-81) is both tarantulas in one pass of about US$0.99, so the pack, and not the
-- spider, is the thing `owned` would say (an owned pack opens both); selling each on its own is his open call. Nothing is sold now.
function SpiderChoice.locked(id: string, owned: { [string]: boolean }?): boolean
	return false
end

-- The pack a spider belongs to (Appearances `pack`), or nil for the first spider, the peacock and the ant mimic, which are not in one.
function SpiderChoice.packOf(id: string): string?
	local look = Appearances.profiles[id]
	return if look ~= nil then (look :: any).pack else nil
end

-- The appearance `dir` (+1 or -1) places from this one in ORDER, wrapping and skipping any that is locked. When nothing else is open it is
-- this one again. An id that is not in ORDER steps to the default (the first spider).
function SpiderChoice.step(id: string, dir: number, owned: { [string]: boolean }?): string
	local n = #SpiderChoice.ORDER
	local at = table.find(SpiderChoice.ORDER, id)
	if at == nil then return Appearances.default end
	local way = if dir < 0 then -1 else 1
	for k = 1, n - 1 do
		local name = SpiderChoice.ORDER[(at - 1 + way * k) % n + 1]
		if not SpiderChoice.locked(name, owned) then return name end
	end
	return id
end

-- The appearance after this one (the crack's key).
function SpiderChoice.next(id: string, owned: { [string]: boolean }?): string
	return SpiderChoice.step(id, 1, owned)
end

-- What the spider is doing, as the client reads it off the motor, the jump, the growth and the struggle (all booleans but `mode`).
export type Standing = { mode: string, seized: boolean, preparing: boolean, jumping: boolean, onLine: boolean, moulting: boolean, struggling: boolean }

-- May the Settings row change the spider now (ROBLOX-71)? Anywhere on the sill, but only while standing safely: attached to a surface and
-- not held by the wasp, not winding up a jump or in the air, not on a silk line, not moulting and not holding a struggling fly. The crack
-- keeps its own rule (resting awake) and does not ask this.
function SpiderChoice.safeToChange(s: Standing): boolean
	return s.mode == "attached" and not s.seized and not s.preparing and not s.jumping and not s.onLine and not s.moulting and not s.struggling
end

-- May the close look (Inspect mode, ROBLOX-90) begin or go on? Standing safely, as for a change of spider, and also hanging on a locked dragline: a line is a good place to be
-- looked at. Not while winding up a jump or in flight (a jump's safety line is a line too), held by the wasp, moulting or holding a struggling fly.
function SpiderChoice.safeToInspect(s: Standing): boolean
	return (s.mode == "attached" or s.onLine) and not s.seized and not s.preparing and not s.jumping and not s.moulting and not s.struggling
end

-- Does this appearance have a fan to display (and so a courtship dance)?
function SpiderChoice.canDance(id: string): boolean
	local look = Appearances.profiles[id]
	return look ~= nil and (look :: any).fan ~= nil
end

-- Does this appearance have antennae to show (legs I raised when it stands still) and so an antennae pose on the display key?
function SpiderChoice.hasAntennae(id: string): boolean
	local look = Appearances.profiles[id]
	return look ~= nil and (look :: any).antennae ~= nil
end

-- Does this appearance have a threat display and silk mat (the tarantulas', ROBLOX-82) on the display key?
function SpiderChoice.hasThreat(id: string): boolean
	local look = Appearances.profiles[id]
	return look ~= nil and (look :: any).threat ~= nil
end

-- What the display key (X / RB / the touch button) does for this appearance: "dance" (the peacock's courtship dance), "antennae" (the
-- ant mimic's antennae pose), "threat" (the tarantulas' rear-up and silk mat) or nil (the first spider has none).
function SpiderChoice.displayKind(id: string): string?
	if SpiderChoice.canDance(id) then return "dance" end
	if SpiderChoice.hasAntennae(id) then return "antennae" end
	if SpiderChoice.hasThreat(id) then return "threat" end
	return nil
end

return SpiderChoice
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">SpiderRig</string>
            <string name="Source"><![CDATA[--!strict
-- The drawn spider for Roblox: a port of scripts/presentation/spider_body.gd and surface_legs.gd (VISUAL-01 look), made cuter in
-- ROBLOX-13. Every part is anchored, non-colliding and non-queryable, and is placed each frame with one Workspace:BulkMoveTo call.
-- Display only: the controller owns the body's CFrame; nothing here feeds back into movement.
-- Body frame: +Y support-up, -Z forward, about 1 stud long (1 Godot WU = 1 cm = 1 stud). Every look number is in
-- Data/Appearances; where things sit comes from Rig/Anatomy, the hairs from Rig/Setae, the idle motion from Rig/Idle.
-- The peacock spider (ROBLOX-30) is a second appearance drawn by the same code: a small body (look.scale) standing low (look.bodyDrop),
-- legs III in their own colours, and a fan of flat discs that the courtship dance (Rig/PeacockDance, set as rig.dance) opens.
-- The ant-mimicking spider (ROBLOX-64) is a third: extra body segments (look.extras), glossy cuticle (look.gloss), and a pose (Rig/AntMimicPose,
-- set as rig.ant) that raises legs I as antennae when it stands and turns the drawn body a little as it walks.
-- The two tarantulas (ROBLOX-81) are two more: a broad low carapace with a rim (look.extras), an ocular tubercle with eight tiny eyes
-- (Anatomy's tubercle), markings on the abdomen (look.marks), legs coloured segment by segment (look.legColors, look.legBands) and, for the
-- Greenbottle blue, leg bristles only (fuzz.legsOnly) and bars that soften at the last growth stage (look.barFade). A pose (Rig/TarantulaPose, set as
-- rig.threat, ROBLOX-82) rears the prosoma, lifts legs I and the pedipalps, turns the drawn body about and swings the spinnerets.
-- ROBLOX-84 draws the legs, feet, fangs and palps of the first spider and the two tarantulas as the segments they have (look.legForm,
-- look.fang, look.palpForm): the same three-link chain and the same targets, each link now one or two rods, a patella at the knee, a break in
-- the tarsus, a pad (and claws) at the foot. An appearance without those tables is drawn exactly as it was.

local Workspace = game:GetService("Workspace")
local Appearances = require(script.Parent.Parent.Data.Appearances)
local Anatomy = require(script.Parent.Anatomy)
local Setae = require(script.Parent.Setae)
local Idle = require(script.Parent.Idle)
local Living = require(script.Parent.Living)
local Growth = require(script.Parent.Parent.Life.Growth)
local v3 = Anatomy.v3

local SpiderRig = {}
SpiderRig.__index = SpiderRig

export type GaitMode = "Tetrapod" | "Unilateral"

local STEP_ERROR = 0.24
local SWING_SECONDS = 0.10
local STEP_HEIGHT = 0.12
local made = 0 -- rigs made so far: each one's living motion draws from its own seeded stream
local ANKLE_SHARE = 0.62
-- The groups a fixed part follows: the body, the head (tilts about the neck) or the abdomen (breathes).
local G_BODY, G_HEAD, G_ABDOMEN = 0, 1, 2
-- Drawing only what moved (ROBLOX-93). The hairs follow one frame each (the head's, the abdomen's, a palp's, a leg link's) and are sent to the engine in a second
-- batch, after the body's: a kind of hair is placed again only when its frame has moved by more than MOVE_STUDS (a place, studs) or MOVE_RADIANS (a turn) since it
-- was last placed, or when the abdomen's scale (its condition, its breath) has moved by more than SCALE_STEP. The tolerance is measured from where the hairs were last
-- placed, not from the last frame, so a slow drift cannot hide: it is placed again once it has added up. (The body's batch is every frame as it was.)
local MOVE_STUDS, MOVE_RADIANS, SCALE_STEP = 1e-4, 1e-3, 1e-4
-- A leg's pale band is given a new length only when it is more than BAND_STEP off (the rods' own tolerance), so a leg that stands still writes none.
local BAND_STEP = 1e-3
local MOVE_TURN = MOVE_RADIANS * MOVE_RADIANS -- (3 minus the trace of the relative rotation is about the turn's square)
-- A rival or a mate farther than FAR_STUDS from the camera is drawn once every FAR_SECONDS (SpiderRig.drawStep).
local FAR_STUDS, FAR_SECONDS = 25, 0.1
-- The lengths of a reach to a foothold, tried in turn (a narrow edge takes the shorter ones).
local REACHES = { 1.0, 0.65, 0.35, 0.12 }
local LEG_NAMES = { "femur", "tibia", "tarsus" }

-- One leg hair: its part and where it grows (spec), with what the drawing needs of it worked out once (ROBLOX-93): the angle round the leg as a cosine and a sine,
-- how far out of the leg it grows (k: 0.8 of the radius, or 1 for a coat that lies along the leg) and its direction in the link's frame.
type LegHair = { part: Part, spec: Setae.LegHair, c: number, s: number, k: number, dir: Vector3 }
-- One link of a leg (femur, tibia, tarsus): its rod, the thinner tip rod and the pale band it may have, the length each is drawn at and the diameters of the rods (what
-- the part's Size holds; kept here so a frame reads no property), the hairs on it, and where they were last placed (its frame and length).
type Seg = {
	rod: Part, tip: Part?, band: Part?, hairs: { LegHair },
	x: number, tipX: number, bandX: number, dy: number, dz: number, tipDy: number, tipDz: number,
	rc: CFrame, len: number,
}

type Leg = {
	side: number,
	pair: number,
	planted: Vector3?,
	swing: number, -- < 0 planted, 0..1 swinging
	from: Vector3,
	to: Vector3,
	up: Vector3,
	foot: Vector3,
	femur: Part,
	tibia: Part,
	tarsus: Part,
	knee: Part,
	ankle: Part,
	pad: Part?,
	femurTip: Part?, -- the thinner distal rod of a tapered femur or tibia, the thinner distal rod of the tarsus and the ball on its break (look.legForm;
	tibiaTip: Part?, -- all nil for an appearance without one), and the foot's claws
	tarsusTip: Part?,
	joint: Part?,
	toes: {Part},
	bands: {Part}, -- empty for a pair drawn without pale bands (the peacock spider's legs III)
	hangKnee: Vector3?, -- where the hanging pose puts the knee and the ankle this frame (world space), or nil off the line (ROBLOX-86)
	hangAnkle: Vector3?,
	hairs: { LegHair },
	segs: { Seg }, -- the femur, the tibia, the tarsus
	rest: Vector3, hip: Vector3, -- where the foot rests and where the hip is, in the body frame at the rig's scale (worked out when the scale changes, not every frame)
	noise: { number }?, -- the hanging pose's fixed scatter for this leg (six numbers), made the first time it hangs
}

-- (glance: a principal eye or its catchlight, which shifts toward what is watched; big: an abdomen mass that is resized as it breathes.) `pos` and `rot` are the offset's
-- two halves, `scaled` the offset at the rig's scale, `size0` the part's size at scale 1 and `size` the size it has now (ROBLOX-93: kept here, so a frame reads no property).
type Fixed = {
	part: Part, offset: CFrame, group: number, palp: number?, sweep: number?, glance: boolean?, big: boolean?,
	pos: Vector3, rot: CFrame, scaled: CFrame, size0: Vector3, size: Vector3,
	jaw: number?, pivot: Vector3?, -- (ROBLOX-127) a chelicera or a fang: its side, and the point at the chelicera's base it swings out about in the rival's display
}

-- The parts of one BulkMoveTo and where each goes: a rig makes two a frame, the body's and the hairs' (the hairs' only when they moved).
type Batch = { parts: { BasePart }, frames: { CFrame }, n: number }

-- Where each group of hairs, and each size that follows the abdomen's condition, was last placed (see MOVE_STUDS): the frame it followed, the abdomen's breath then,
-- the condition its sizes were made for and the scale epoch they were made at.
type Seen = {
	body: CFrame, head: CFrame, abdomen: CFrame, palpHead: { CFrame }, pivot: { CFrame },
	breath: number, sizeKey: Vector3, epoch: number,
}

-- The peacock spider's fan: flat ellipsoid discs on the abdomen's back face, stacked fringe first, their size set each frame by how far the fan is open.
-- (`sizes`: what each part's Size holds, kept here so that a frame reads none and writes only what changed.)
type FanDisc = { part: Part, inset: number, y: number }
type FanFigure = { part: Part, x: number, z: number, rx: number, rz: number, angle: number, turn: CFrame } -- (turn: the angle as a CFrame, made once: ROBLOX-113)
type Fan = { front: { FanDisc }, back: { FanDisc }, figure: { FanFigure }, flaps: { { part: Part, side: number } }, cfg: any, parts: { Part }, sizes: { [BasePart]: Vector3 } }

export type Rig = typeof(setmetatable(
	{} :: {
		model: Model,
		root: Part,
		gaitMode: GaitMode,
		reducedMotion: boolean,
		_fixed: { Fixed },
		_legs: { Leg },
		_group: number,
		_t: number,
		_drum: number,
		_calm: number,
		_spots: { Part },
		_appearance: any,
		_layout: Anatomy.Layout,
		_cfg: any,
		_detail: string,
		_palpBase: { Vector3 },
		_setae: { Part },
		_eyeView: boolean,
		_bodyHidden: boolean,
		_highlight: Highlight?,
		_params: RaycastParams,
		_bodyBatch: Batch, -- the body's parts and where they go this frame
		_hairBatch: Batch, -- the hairs that moved this frame (none when nothing did)
		_bodyFixed: { Fixed }, -- _fixed without the hairs; the hairs by the frame they follow (the head, the body, each palp, the abdomen)
		_headHairs: { Fixed },
		_bodyHairs: { Fixed },
		_palpHairs: { { Fixed } },
		_abdomenHairs: { Fixed },
		_seen: Seen,
		_pose: Idle.Pose, -- the idle pose, made again in place each frame
		_epoch: number, -- counts the scale changes: what was placed for an earlier scale is placed again
		_exact: boolean, -- tests: place every hair again every frame, with no tolerance (what the drawing is compared with)
		_stage: number, -- the growth stage last applied (-1 before the first)
		_owed: number, _drawn: boolean, -- drawStep: the time not yet drawn, and whether the rig has been drawn at all
		placed: number?, -- the parts the last drawing placed (ROBLOX-113, for the self-test's profile)
		_k: number,
  _growth: number,
  _softness: number,
  _condition: number,
  _shownCondition: number,
  hangDirection: Vector3?,
  _hang: number,
  focusPoint: Vector3?, -- the point the player watches (world space), or nil: the drawn body turns toward it a little and the eyes glance at it (ROBLOX-87)
  _living: Living.State?, -- the living motion (attention, grooming, alarm, a tarantula's stretch), or nil below the full tier
  _breath: number, -- how much the abdomen breathes now, 0..1
  _mealsSeen: number?,
  _lineDir: Vector3, -- the last direction up the line (it stays while the pose blends out)
  _hangT: number, -- seconds since the drop: the sway's clock
  _spin: number, _spinVel: number, -- the slow turn about the line (radians, radians a second)
  _hangCount: number, -- drops so far (the turn alternates its direction)
  _lastPos: Vector3?, _lineSpeed: number, _climbing: boolean, _climb: number, -- the climb: speed along the line, whether it counts, the head-up blend 0..1
  _spinneret: Vector3?,
  _mouth: CFrame?,
  mealPulse: number?,
  mealHeld: boolean?,
  jumpLoad: number,
  jumpPush: number,
  _shownLoad: number,
  _sizes: {[BasePart]: Vector3},
  _colors: {[BasePart]: Color3},
  _bars: { Part }, -- the Greenbottle blue's diagonal bars, which soften at the last growth stage
		_drop: number,
		_fan: Fan?,
		dance: any, -- a PeacockDance.Pose, or nil: the peacock spider's display (ignored by an appearance without a fan)
		ant: any, -- an AntMimicPose.Pose, or nil: the ant-mimicking spider's antennae and walk (ignored by an appearance without look.antennae)
		threat: any, -- a TarantulaPose.Pose, or nil: a tarantula's threat display and silk mat (ignored by an appearance without look.threat)
	},
	SpiderRig
))

local function newPart(model: Model, name: string, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = Vector3.new(0.1, 0.1, 0.1)
	p.Parent = model
	return p
end

local function ellipsoid(model: Model, name: string, radii: Vector3, color: Color3, material: Enum.Material): Part
	local p = newPart(model, name, color, material)
	p.Size = radii * 2
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function rod(model: Model, name: string, d: number, color: Color3): Part
	local p = newPart(model, name, color, Enum.Material.SmoothPlastic)
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(1, d, d)
	return p
end

local function disc(model: Model, name: string, color: Color3, reflectance: number): Part
	local p = ellipsoid(model, name, Vector3.new(0.05, 0.002, 0.05), color, Enum.Material.SmoothPlastic)
	p.CastShadow = false
	p.Reflectance = reflectance
	return p
end

local function ball(model: Model, name: string, d: number, color: Color3): Part
	local p = newPart(model, name, color, Enum.Material.SmoothPlastic)
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(d, d, d)
	p.CastShadow = false
	return p
end

-- A cylinder's axis is its local X: aim it from a to b. (ROBLOX-113: the quarter turn is made once, not with every rod of every frame; the frames are the same to the bit.)
local QUARTER = CFrame.Angles(0, math.pi / 2, 0)
local function rodCFrame(a: Vector3, b: Vector3): CFrame
	return CFrame.lookAt((a + b) * 0.5, b) * QUARTER
end

-- A hair's "up" for lookAt: its surface normal, unless that is (nearly) along the hair.
local function upFor(dir: Vector3, normal: Vector3): Vector3
	if math.abs(dir:Dot(normal)) < 0.97 then return normal end
	return if math.abs(dir.Y) < 0.9 then Vector3.yAxis else Vector3.zAxis
end

local GROUP_OF: { [string]: number } = { head = G_HEAD, abdomen = G_ABDOMEN }

-- ---------------------------------------------------------------- what a frame is made of: module functions, so that nothing is made again every frame (ROBLOX-93)

-- Adds a part and its place to a batch.
local function put(batch: Batch, p: BasePart, cf: CFrame)
	local n = batch.n + 1
	batch.n = n
	batch.parts[n] = p
	batch.frames[n] = cf
end

local function emptyBatch(): Batch
	return { parts = {}, frames = {}, n = 0 }
end

local function clearBatch(batch: Batch)
	table.clear(batch.parts)
	table.clear(batch.frames)
	batch.n = 0
end

-- An offset at the rig's scale: its place is scaled about the body's origin, its turn is not.
-- (ROBLOX-113: a rotation moved to a place is `rotation + place`, one CFrame where CFrame.new(place) * rotation made two; the same frame to the bit, since the
-- product with the identity adds only zeros. A frame of the full rig made about 1,700 CFrames for 690 parts; this and the like below are most of the difference.)
local function scaled(cf: CFrame, g: number): CFrame
	return if g == 1 then cf else cf.Rotation + cf.Position * g
end

-- Has `now` moved from `was` by more than MOVE_STUDS in place or MOVE_RADIANS in turn? The turn comes from the trace of the relative rotation, the sum of the dot
-- products of the two frames' three axes (no angle is worked out): it is 3 for no turn and 3 - 2 (1 - cos a) for a turn of a.
local function moved(was: CFrame, now: CFrame): boolean
	if (now.Position - was.Position).Magnitude > MOVE_STUDS then return true end
	local trace = now.RightVector:Dot(was.RightVector) + now.UpVector:Dot(was.UpVector) + now.LookVector:Dot(was.LookVector)
	return 3 - trace > MOVE_TURN
end

-- Gives an abdomen part the size it should have, if it differs from what it has (a part's size is kept in `f.size`; the property is written, never read).
local function resize(f: Fixed, size: Vector3)
	if (f.size - size).Magnitude > 1e-5 then
		f.size = size
		f.part.Size = size
	end
end

-- A link of a leg that has not been drawn yet: refreshScale fills in its sizes, and bandX and len at -1 mean "write the band's size, place the hairs" at the first drawing.
local function newSeg(rod: Part, tip: Part?, band: Part?): Seg
	return {
		rod = rod, tip = tip, band = band, hairs = {},
		x = 0, tipX = 0, bandX = -1, dy = 0, dz = 0, tipDy = 0, tipDz = 0,
		rc = CFrame.identity, len = -1,
	}
end

-- Works out what the rig's scale fixes (ROBLOX-93), when the rig is made and whenever the scale changes: each fixed part's offset and size at that scale (the size
-- setScale has just given every part), each leg's hip and rest in the body frame, the lengths and diameters its links hold, and the fan's sizes. A frame only reads these.
local function refreshScale(self: Rig)
	local g, sizes = self._growth, self._sizes
	for _, f in self._fixed do
		f.scaled = scaled(f.offset, g)
		f.size0 = sizes[f.part]
		f.size = f.size0 * g
	end
	local L = self._appearance.limbs
	local stance, longer = L.stance, L.pairReach
	for _, leg in self._legs do
		local r = stance.reach * (if longer then longer[leg.pair] else 1) -- (the peacock spider's legs III are the longest)
		leg.rest = Vector3.new(leg.side * stance.x * r, stance.y, L.tipZ[leg.pair] * r) * g
		leg.hip = Vector3.new(leg.side * L.hipX, L.hipY, L.hipZ[leg.pair]) * g
		for _, seg in leg.segs do
			local size = sizes[seg.rod]
			seg.x, seg.dy, seg.dz = size.X * g, size.Y * g, size.Z * g
			local tip = seg.tip
			if tip then
				local tipSize = sizes[tip]
				seg.tipX, seg.tipDy, seg.tipDz = tipSize.X * g, tipSize.Y * g, tipSize.Z * g
			end
			seg.bandX, seg.len = -1, -1 -- the band is given its size, and the hairs their places, at the next drawing
		end
	end
	local fan = self._fan
	if fan then
		for _, part in fan.parts do fan.sizes[part] = sizes[part] * g end
	end
end

-- detail "low" is for phones and tablets: fewer hairs, one fur shell, no foot balls, half the speckles, no outline, no
-- breathing or head tilt (Appearances.detail). Anything else is the full look. `living` (ROBLOX-89: the mate, which has to breathe and take the mating scene's cues
-- at the low tier) turns the living motion on at a tier that has none, for the same parts.
function SpiderRig.new(parent: Instance, worldFolder: Instance, appearanceId: string?, detail: string?, living: boolean?): Rig
	local look = Appearances.profiles[appearanceId or Appearances.default]
	assert(look, "Unknown spider appearance")
	local detailName = if detail == "low" then "low" else "full"
	local cfg = look.detail[detailName]
	if living == true and not cfg.idle then
		cfg = table.clone(cfg)
		cfg.idle = true
	end
	local A = Anatomy.layout(look)
	local function color(rgb): Color3 return Color3.new(rgb[1], rgb[2], rgb[3]) end
	local BODY, LEG = color(look.body), color(look.legs)
	local JOINT, EYE, FANG = color(look.joint or look.white), color(look.eyes), color(look.fangs)
	local ABDOMEN = if look.abdomenColor then color(look.abdomenColor) else BODY
	local WHITE = color(look.white)
	local model = Instance.new("Model")
	model.Name = "Spider"
	model:SetAttribute("AppearanceId", look.id)
	model:SetAttribute("Detail", detailName)
	local root = newPart(model, "Root", BODY, Enum.Material.SmoothPlastic)
	root.Size = Vector3.new(1, 0.5, 1)
	root.Transparency = 1
	root.CastShadow = false
	model.PrimaryPart = root

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { worldFolder }

	local self = setmetatable({
		model = model,
		root = root,
		gaitMode = "Tetrapod" :: GaitMode,
		reducedMotion = false,
		_fixed = {} :: { Fixed },
		_legs = {} :: { Leg },
		_group = 0,
		_t = 0,
		_drum = 0,
		_calm = 0,
		_spots = {} :: { Part },
		_appearance = look,
		_layout = A,
		_cfg = cfg,
		_detail = detailName,
		_palpBase = { A.palps[1].base, A.palps[2].base },
		_setae = {} :: { Part },
		_eyeView = false,
		_bodyHidden = false,
		_highlight = nil :: Highlight?,
		_params = params,
		_bodyBatch = emptyBatch(),
		_hairBatch = emptyBatch(),
		_bodyFixed = {} :: { Fixed },
		_headHairs = {} :: { Fixed },
		_bodyHairs = {} :: { Fixed },
		_palpHairs = { {}, {} } :: { { Fixed } },
		_abdomenHairs = {} :: { Fixed },
		_seen = {
			body = CFrame.identity, head = CFrame.identity, abdomen = CFrame.identity, palpHead = { CFrame.identity, CFrame.identity }, pivot = { CFrame.identity, CFrame.identity },
			breath = 0, sizeKey = Vector3.zero, epoch = 0,
		} :: Seen,
		_pose = { bodyLift = 0, abdomenLift = 0, abdomenPitch = 0, headRoll = 0, headYaw = 0, headPitch = 0 } :: Idle.Pose,
		_epoch = 1,
		_exact = false,
		_stage = -1,
		_owed = 0,
		_drawn = false,
		_k = look.scale or 1,
  _growth = 1, _softness = 0, _condition = 0.55, _shownCondition = 0.55, jumpLoad = 0, jumpPush = 0, _shownLoad = 0,
  hangDirection=nil :: Vector3?, _hang=0, _spinneret=nil :: Vector3?,
  focusPoint = nil :: Vector3?, _living = nil :: Living.State?, _breath = 0, _mealsSeen = nil :: number?,
  _lineDir = Vector3.yAxis, _hangT = 0, _spin = 0, _spinVel = 0, _hangCount = 0, _lastPos = nil :: Vector3?, _lineSpeed = 0, _climbing = false, _climb = 0,
  _sizes = {} :: {[BasePart]: Vector3}, _colors = {} :: {[BasePart]: Color3}, _bars = {} :: { Part },
		_drop = look.bodyDrop or 0,
		_fan = nil :: Fan?,
		dance = nil :: any,
		ant = nil :: any,
		threat = nil :: any,
	}, SpiderRig)

	made += 1
	local idleLook = look.idle
	if cfg.idle and (idleLook.groom or idleLook.attention or idleLook.alarm or idleLook.stretch or idleLook.meet or idleLook.settle) then
		self._living = Living.new(idleLook, Living.hash(look.id) + 7919 * made)
	end
	local function fixed(part: Part, at: Vector3, rot: CFrame?, group: number, palp: number?): Fixed
		local offset = CFrame.new(at) * (rot or CFrame.identity)
		local entry: Fixed = {
			part = part, offset = offset, group = group, palp = palp, sweep = nil, glance = nil, big = nil,
			pos = offset.Position, rot = offset.Rotation, scaled = offset, size0 = Vector3.zero, size = Vector3.zero, jaw = nil, pivot = nil,
		}
		table.insert(self._fixed, entry)
		return entry
	end
	local fabric = Enum.Material.SmoothPlastic -- clean high-contrast silhouette
	fixed(ellipsoid(model, "Cephalothorax", A.headRadii, BODY, fabric), A.headCenter, nil, G_HEAD)
	fixed(ellipsoid(model, "EyeFace", A.faceRadii, BODY, fabric), A.faceCenter, nil, G_HEAD)
	fixed(ellipsoid(model, "Pedicel", A.pedicelRadii, BODY, fabric), A.pedicelCenter, nil, G_BODY)
	fixed(ellipsoid(model, "Abdomen", A.abdomenRadii, ABDOMEN, fabric), A.abdomenCenter, nil, G_ABDOMEN).big = true
	-- More segments (the ant-mimicking spider's thorax and the node on its waist), and a glossy cuticle where the look asks for one.
	-- (`fullOnly` extras are left out at low detail; `sweep` marks a spinneret segment that the silk-mat pose swings.)
	for _, ex in look.extras or {} do
		if ex.fullOnly and detailName == "low" then continue end
		local seg = ellipsoid(model, ex.name, v3(ex.radii), if ex.color then color(ex.color) else BODY, fabric)
		fixed(seg, v3(ex.center), nil, GROUP_OF[ex.group] or G_BODY).sweep = ex.sweep
	end
	-- A tarantula's ocular tubercle, the mound that carries its eyes (the eyes themselves are below).
	local tubercle = A.tubercle
	if tubercle then
		local mound = ellipsoid(model, "OcularTubercle", tubercle.radii, color(look.tubercle.color), fabric)
		mound.Reflectance = look.tubercle.reflectance
		fixed(mound, tubercle.center, nil, G_HEAD)
	end
	-- A tarantula's velvet (look.velvet, ROBLOX-85): a fur shell per body mass, a little larger than the carapace and the abdomen it covers, partly
	-- transparent, in Fabric and in the fur's colour. The head's stops short of the tubercle's eyes by being no taller than the carapace's dome.
	local velvet = look.velvet
	if velvet and cfg.velvet then
		local cover = ellipsoid(model, "FuzzShell", A.headRadii * velvet.head.scale, color(velvet.head.color), Enum.Material.Fabric)
		cover.Transparency, cover.CastShadow = velvet.head.transparency, false
		fixed(cover, A.headCenter, nil, G_HEAD)
		local coat = ellipsoid(model, "FuzzShell", A.abdomenRadii * velvet.abdomen.scale, color(velvet.abdomen.color), Enum.Material.Fabric)
		coat.Transparency, coat.CastShadow = velvet.abdomen.transparency, false
		fixed(coat, A.abdomenCenter, nil, G_ABDOMEN).big = true
	end
	if look.gloss then
		for _, f in self._fixed do
			local name = f.part.Name
			if name == "Cephalothorax" or name == "EyeFace" or name == "Pedicel" or name == "Abdomen" or name == "Thorax" or name == "PetioleNode" or name == "CarapaceRim" then
				f.part.Reflectance = look.gloss
			end
		end
	end

	-- The daughter's pattern: markings are fractions of the abdomen's radii.
	local ar, ac = A.abdomenRadii, A.abdomenCenter
	local function marking(name: string, x: number, z: number, rx: number, rz: number, angle: number)
		local y = ar.Y * math.sqrt(math.max(0, 1 - x*x - z*z))
		local spot = ellipsoid(model, name, Vector3.new(rx, 0.012, rz), WHITE, fabric)
		spot.CastShadow = false
		fixed(spot, Vector3.new(x * ar.X, ac.Y + 0.007 + y, ac.Z + z * ar.Z), CFrame.Angles(0, angle, 0), G_ABDOMEN)
		table.insert(self._spots, spot)
	end
	-- A curved pale band across the front of the abdomen.
	local band = look.band
	for i = 0, band.count - 1 do
		marking("FrontBand", (i - (band.count - 1) / 2) * band.step, band.z, band.rx, band.rz, 0)
	end
	for _, spot in look.spots do
		marking("AbdomenSpot", spot.x, spot.z, spot.rx, spot.rz, spot.angle)
	end
	-- Fixed deterministic stippling: no per-frame RNG or extra updates.
	local sp = look.speckle
	for i = 1, look.speckleCount do
		if i % cfg.speckleEvery ~= 0 then continue end
		local angle = i * 2.399963229728653
		local radius = sp.from + (i % 5) * sp.step
		marking("Speckle", math.cos(angle) * radius, math.sin(angle) * radius, sp.rx, sp.rz, angle)
	end

	-- A tarantula's markings on the abdomen (look.marks): flat dabs in their own colours lying on the back, each tilted to the slope under it.
	-- x and z are fractions of the abdomen's radii, rx and rz the dab's half sizes in studs. `mirror` also draws the other side, `fullOnly`
	-- leaves it out at low detail, `bar` lists it among the bars that soften with growth (look.barFade).
	for _, m in look.marks or {} do
		if m.fullOnly and detailName == "low" then continue end
		local sides: { number } = if m.mirror then { 1, -1 } else { 1 }
		for _, side in sides do
			local x, z = side * m.x, m.z
			local q = math.sqrt(math.max(1 - x * x - z * z, 0.05))
			local pitch = math.atan(ar.Y * z / (ar.Z * q))
			local roll = math.atan(-ar.Y * x / (ar.X * q))
			-- (`height`: a ridge, a thin rod-shaped ellipsoid that stands that many studs half-height out of the surface, centred `raise` above it,
			-- instead of a flat dab, ROBLOX-85; its pointed ends dive into the fur shell, so it follows the dome where a straight cylinder would float)
			local dab = ellipsoid(model, m.name, Vector3.new(m.rx, m.height or 0.010, m.rz), color(m.color), fabric)
			dab.CastShadow = false
			fixed(dab, Vector3.new(x * ar.X, ac.Y + ar.Y * q + (m.raise or 0.002), ac.Z + z * ar.Z), CFrame.Angles(pitch, 0, roll) * CFrame.Angles(0, side * m.angle, 0), G_ABDOMEN)
			if m.bar then table.insert(self._bars, dab) end
		end
	end

	-- Head: pale cheeks, big glossy eyes with their catchlights, jaws.
	for _, c in A.cheeks do
		local cheek = ellipsoid(model, "PaleCheek", c.radii, WHITE, fabric)
		cheek.CastShadow = false
		fixed(cheek, c.at, nil, G_HEAD)
	end
	-- The peacock spider's red-orange carapace stripes: flat dabs lying on the head's dome, tilted to the slope under them.
	local stripes = look.stripes
	if stripes then
		local STRIPE = color(stripes.color)
		for n = 1, #stripes do
			local st = stripes[n]
			local dx, dz = st.x, st.z - A.headCenter.Z
			local q = math.sqrt(math.max(1 - (dx / A.headRadii.X) ^ 2 - (dz / A.headRadii.Z) ^ 2, 0.05))
			local y = A.headCenter.Y + A.headRadii.Y * q
			local pitch = -math.atan(-A.headRadii.Y * (dz / A.headRadii.Z) / (A.headRadii.Z * q))
			local roll = math.atan(-A.headRadii.Y * (dx / A.headRadii.X) / (A.headRadii.X * q))
			local dab = ellipsoid(model, "CarapaceStripe", Vector3.new(st.rx, 0.006, st.rz), STRIPE, fabric)
			dab.CastShadow = false
			fixed(dab, Vector3.new(st.x, y + 0.002, st.z), CFrame.Angles(pitch, 0, roll) * CFrame.Angles(0, st.angle, 0), G_HEAD)
		end
	end
	local SOCKET = if look.eye.ame then color(look.eye.ame.socket.color) else EYE -- (a tarantula has no big front eyes to frame)
	for _, e in A.eyes do
		local eye = ellipsoid(model, e.name, e.radii, EYE, Enum.Material.Glass)
		eye.Reflectance = e.reflectance
		eye.CastShadow = false
		fixed(eye, e.at, nil, G_HEAD).glance = e.principal
		-- (ROBLOX-127) depth: the lens lets a little light through onto a dark retina set back in the eye (look.eye.ame.lens; the full tier's `retina`)
		local lens = if e.principal and look.eye.ame then look.eye.ame.lens else nil
		if lens and cfg.retina then
			eye.Transparency = lens.transparency
			local rt = lens.retina
			local retina = ellipsoid(model, "Retina", e.radii * rt.scale, color(rt.color), fabric)
			retina.CastShadow = false
			fixed(retina, e.at + Vector3.new(0, 0, e.radii.Z * rt.depth), nil, G_HEAD).glance = true
		end
		if e.principal and cfg.sockets then
			local socket = ellipsoid(model, "EyeSocket", e.radii * look.eye.ame.socket.scale, SOCKET, fabric)
			socket.CastShadow = false
			fixed(socket, e.at + Vector3.new(0, 0, 0.03), nil, G_HEAD).glance = true
		end
	end
	local GLINT = color(look.eye.glintColor)
	for _, g in A.glints do
		local glint = ellipsoid(model, "Catchlight", g.radii, GLINT, Enum.Material.Neon)
		glint.CastShadow = false
		fixed(glint, g.at, nil, G_HEAD).glance = tubercle == nil -- (the catchlights of the big front eyes; a tarantula's are on its tubercle's beads)
	end
	local cl = look.chelicerae
	local jawPivot: { [number]: Vector3 } = {}
	for _, j in A.jaws do
		local fang = ellipsoid(model, "Chelicera", j.radii, if cl.color then color(cl.color) else FANG, Enum.Material.Foil) -- (ROBLOX-127: a colour of their own, the bold jumper's green)
		fang.Reflectance = cl.reflectance
		local entry = fixed(fang, j.at, CFrame.Angles(cl.pitch, 0, j.side * cl.splay), G_HEAD)
		jawPivot[j.side] = j.at + Vector3.new(0, j.radii.Y * 0.75, j.radii.Z * 0.3) -- the chelicera's base, high at the back, where it joins the face
		entry.jaw, entry.pivot = j.side, jawPivot[j.side]
	end
	-- Fangs (look.fang): chains of dark, glossy ellipsoids hanging from the chelicerae's lower front, each segment turned along its own direction.
	for _, f in A.fangs do
		if f.index > (cfg.fangSegments or 0) then continue end
		local tooth = ellipsoid(model, "Fang", f.radii, if look.fang.color then color(look.fang.color) else FANG, Enum.Material.Foil)
		tooth.Reflectance = look.fang.reflectance
		tooth.CastShadow = false
		local entry = fixed(tooth, f.at, CFrame.lookAt(Vector3.zero, f.dir), G_HEAD)
		entry.jaw, entry.pivot = f.side, jawPivot[f.side] -- (a fang goes where its chelicera goes)
	end
	-- Pedipalps: stalk, pale band, club and pale tip, rotating about a pivot at the base (they drum when the spider stands).
	local pl = look.palp
	local pc = look.palpColors
	local PALP_STALK, PALP_CLUB, PALP_TIP = if pc then color(pc.stalk) else LEG, if pc then color(pc.club) else LEG, if pc then color(pc.tip) else JOINT
	for index, palp in A.palps do
		local base, tip = palp.base, palp.tip
		local len = (tip - base).Magnitude
		local toBase = CFrame.new(base):Inverse()
		local stalk = rod(model, "PalpStalk", pl.stalk, PALP_STALK)
		local pf = look.palpForm -- a leg-like palp tapers like a femur: a thick rod, then a thinner one out to the club
		local reach = if pf then len * pf.split else len
		stalk.Size = Vector3.new(reach, pl.stalk, pl.stalk)
		fixed(stalk, Vector3.zero, toBase * rodCFrame(base, base:Lerp(tip, reach / len)), G_HEAD, index)
		if pf then
			local thin = rod(model, "PalpStalkTip", pl.stalk * pf.taper, PALP_STALK)
			thin.Size = Vector3.new(len - reach, pl.stalk * pf.taper, pl.stalk * pf.taper)
			fixed(thin, Vector3.zero, toBase * rodCFrame(base:Lerp(tip, reach / len), tip), G_HEAD, index)
		end
		local ring = rod(model, "PalpBand", pl.stalk * 1.05, WHITE)
		ring.Size = Vector3.new(len * look.bandFraction, pl.stalk * 1.05, pl.stalk * 1.05)
		fixed(ring, Vector3.zero, toBase * rodCFrame(base, tip), G_HEAD, index)
		local os = pl.offsetScale or 1 -- the club and tip sit a little past the stalk's end; a very small spider scales that down
		fixed(ellipsoid(model, "PalpClub", v3(pl.club), PALP_CLUB, fabric), tip + Vector3.new(0, -0.005, -0.02) * os - base, nil, G_HEAD, index)
		fixed(ellipsoid(model, "PalpTip", v3(pl.tipRadii), PALP_TIP, fabric), tip + Vector3.new(0, 0.004, -0.05) * os - base, nil, G_HEAD, index)
	end

	-- Fuzz: flat locks over the head and abdomen, tufts, a cheek ruff and palp fluff (Rig/Setae), moved with the part they grow from.
	local fuzz = look.fuzz
	local BLACKEST = if fuzz then color(fuzz.black) else BODY
	local DARK = if fuzz then color(fuzz.dark) else BODY
	local GREY = if fuzz then color(fuzz.grey) else BODY
	local FROST = if fuzz then color(fuzz.frost) else BODY
	local function seta(tone: string, width: number, thick: number, length: number, transparency: number): Part
		local h = newPart(model, "Seta", if tone == "white" then WHITE elseif tone == "frost" then FROST elseif tone == "grey" then GREY elseif tone == "black" then BLACKEST else DARK, Enum.Material.SmoothPlastic)
		h.Size = Vector3.new(width, thick, length)
		h.CastShadow = false
		h.Transparency = transparency
		table.insert(self._setae, h)
		return h
	end
	if fuzz and fuzz.enabled then
		local SHELL = color(fuzz.shellColor)
		local hr, hs = A.headRadii, fuzz.headShell
		for k, shell in fuzz.shells do
			if k > cfg.shells then break end
			local a = ellipsoid(model, "FuzzShell", A.abdomenRadii * shell.scale, SHELL, fabric)
			a.Transparency, a.CastShadow = shell.transparency, false
			fixed(a, A.abdomenCenter, nil, G_ABDOMEN).big = true
			local h = ellipsoid(model, "FuzzShell", Vector3.new(hr.X * shell.scale, hr.Y * shell.scale, hr.Z * hs.zScale), SHELL, fabric)
			h.Transparency, h.CastShadow = shell.transparency, false
			fixed(h, A.headCenter + Vector3.new(0, 0, hs.shift + 0.01 * k), nil, G_HEAD)
		end
		-- (A tier keeps one hair in `every` of each class: Setae.thin, which counts the two sides of a mirrored pair each by itself.)
		for _, hair in Setae.thin(Setae.body(look), cfg.every) do
			local h = seta(hair.tone, hair.width, hair.thick, hair.length, hair.transparency)
			local mid = hair.at + hair.dir * (hair.length * 0.5)
			fixed(h, mid, CFrame.lookAt(Vector3.zero, hair.dir, upFor(hair.dir, hair.normal)), GROUP_OF[hair.group] or G_BODY)
		end
		for _, hair in Setae.thin(Setae.palp(look), cfg.every) do
			local index = if hair.side < 0 then 1 else 2
			local h = seta(hair.tone, hair.width, hair.thick, hair.length, hair.transparency)
			local mid = hair.at + hair.dir * (hair.length * 0.5)
			local rest = CFrame.lookAt(mid, mid + hair.dir, upFor(hair.dir, hair.normal))
			fixed(h, Vector3.zero, CFrame.new(self._palpBase[index]):Inverse() * rest, G_HEAD, index)
		end
	end

	-- The redknee's urticating patch (look.cluster, ROBLOX-85): a tuft of ginger-rust hairs standing out of the patch, combed toward the rear.
	if look.cluster and cfg.cluster then
		local tuftLook = look.cluster
		for _, hair in Setae.cluster(look) do
			local h = newPart(model, "Seta", color(if hair.tone == "frost" then tuftLook.light else tuftLook.color), fabric)
			h.Size, h.CastShadow, h.Transparency = Vector3.new(hair.width, hair.thick, hair.length), false, hair.transparency
			table.insert(self._setae, h)
			fixed(h, hair.at + hair.dir * (hair.length * 0.5), CFrame.lookAt(Vector3.zero, hair.dir, upFor(hair.dir, hair.normal)), G_ABDOMEN)
		end
	end

	-- A leg's pale bands: white on the femur, tibia and tarsus unless the look lists its own (look.legBands: a colour for each segment that has
	-- one, so the redknee's single band is { tibia = ... } and the greenbottle's none is {}).
	local function legBands(i: number, d: { number }): { Part }
		local lb = look.legBands
		if lb == nil then
			return {rod(model, "FemurBand" .. i, d[1], WHITE), rod(model, "TibiaBand" .. i, d[2], WHITE), rod(model, "TarsusBand" .. i, d[2] * 0.6, WHITE)}
		end
		local out: { Part } = {}
		if lb.femur then out[1] = rod(model, "FemurBand" .. i, d[1], color(lb.femur)) end
		if lb.tibia then out[2] = rod(model, "TibiaBand" .. i, d[2], color(lb.tibia)) end
		if lb.tarsus then out[3] = rod(model, "TarsusBand" .. i, d[2] * 0.6, color(lb.tarsus)) end
		return out
	end
	-- Legs: plump, with rounded joints and (at full detail) round feet.
	local L = look.limbs
	for i = 1, 8 do
		local side = if i <= 4 then -1 else 1
		local pair = (i - 1) % 4 + 1
		local raw = L.diameters[pair]
		local factor = (if pair == 1 then look.frontLegScale else 1) * L.thickness
		local d = {raw[1] * factor, raw[2] * factor}
		-- A pair with its own look (the peacock spider's legs III): a colour and a thickness per segment, and no pale bands.
		local own = if look.pairs then look.pairs[pair] else nil
		local cFemur, cTibia, cTarsus = LEG, LEG, LEG
		local tF, tT, tTar = 1, 1, 1
		local kneeColor, ankleColor = JOINT, JOINT
		local lc = look.legColors -- a tarantula's legs are coloured segment by segment: the patella is the knee, the metatarsus and tarsus the foot
		if lc then
			cFemur, cTibia, cTarsus, kneeColor, ankleColor = color(lc.femur), color(lc.tibia), color(lc.tarsus), color(lc.knee), color(lc.ankle)
		end
		local withBands = true
		if own then
			cFemur, cTibia, cTarsus = color(own.colors[1]), color(own.colors[2]), color(own.colors[3])
			tF, tT, tTar = own.thick[1], own.thick[2], own.thick[3]
			kneeColor, ankleColor = cFemur, cTibia
			withBands = own.bands ~= false
		end
		if cfg.legBands == false then withBands = false end -- the low tier of the peacock spider draws no pale bands
		-- The shape of the leg (look.legForm, ROBLOX-84): a tapered femur and tibia, a patella for a knee, a break in the tarsus, a pad and its toes.
		local form = look.legForm
		local D1, D2, DT = d[1] * tF, d[2] * tT, d[2] * 0.6 * tTar -- the femur's, tibia's and tarsus' diameters
		local knee: Part
		local pad: Part? = nil
		local toes: {Part} = {}
		if form then
			local pt = form.patella
			knee = ellipsoid(model, "Knee" .. i, Vector3.new(D1 * pt.length, D1 * pt.width, D1 * pt.width) * 0.5, kneeColor, fabric)
			knee.CastShadow = false
			if cfg.pads then
				local ft = form.foot
				local sole = ellipsoid(model, "Foot" .. i, Vector3.new(ft.rx, ft.ry, ft.rz) * DT, cTarsus, fabric)
				sole.CastShadow = false
				pad = sole
				local cw = form.claws
				for _ = 1, if cw then cfg.claws or 0 else 0 do
					local claw = rod(model, "Claw", cw.radius * 2, FANG)
					claw.Size, claw.CastShadow = Vector3.new(cw.length, cw.radius * 2, cw.radius * 2), false
					table.insert(toes, claw)
				end
			end
		else
			knee = ball(model, "Knee" .. i, D1 * 0.95, kneeColor)
			pad = if cfg.pads then ball(model, "Foot" .. i, DT * L.pad, cTarsus) else nil
		end
		table.insert(self._legs, {
			side = side,
			pair = pair,
			planted = nil :: Vector3?,
			swing = -1,
			from = Vector3.zero,
			to = Vector3.zero,
			up = Vector3.yAxis,
			foot = Vector3.zero,
			femur = rod(model, "Femur" .. i, d[1] * tF, cFemur),
			tibia = rod(model, "Tibia" .. i, d[2] * tT, cTibia),
			tarsus = rod(model, "Tarsus" .. i, d[2] * 0.6 * tTar, cTarsus),
			knee = knee,
			ankle = ball(model, "Ankle" .. i, d[2] * tT * 0.95, ankleColor),
			pad = pad,
			femurTip = if form and cfg.taper then rod(model, "FemurTip" .. i, D1 * form.femur.taper, cFemur) else nil,
			tibiaTip = if form and form.tibia and cfg.tibiaTaper then rod(model, "TibiaTip" .. i, D2 * form.tibia.taper, cTibia) else nil,
			tarsusTip = if form and form.tarsus.tip and cfg.jointBreak then rod(model, "TarsusTip" .. i, DT * form.tarsus.tip, cTarsus) else nil,
			joint = if form and cfg.jointBreak then ball(model, "TarsalJoint" .. i, DT * form.tarsus.joint, ankleColor) else nil,
			toes = toes,
			bands = if not withBands then {} else legBands(i, d),
			hangKnee = nil :: Vector3?,
			hangAnkle = nil :: Vector3?,
			hairs = {},
			segs = {},
			rest = Vector3.zero, hip = Vector3.zero,
			noise = nil :: { number }?,
		})
		local leg = self._legs[#self._legs]
		leg.segs = { newSeg(leg.femur, leg.femurTip, leg.bands[1]), newSeg(leg.tibia, leg.tibiaTip, leg.bands[2]), newSeg(leg.tarsus, leg.tarsusTip, leg.bands[3]) }
		if fuzz and fuzz.enabled then
			for n, spec in Setae.leg(look, i) do
				if cfg.every.leg <= 0 or n % cfg.every.leg ~= 0 then continue end
				-- (what the drawing needs of a hair is worked out here, once: see LegHair)
				local c, sn, lie = math.cos(spec.theta), math.sin(spec.theta), spec.lift
				local entry: LegHair = {
					part = seta(spec.tone, fuzz.legWidth, fuzz.legWidth, spec.length, fuzz.legTransparency), spec = spec, c = c, s = sn,
					k = if lie then 1.0 else 0.8,
					dir = if lie then Vector3.new(math.cos(lie), math.sin(lie) * c, math.sin(lie) * sn) else Vector3.new(1.3, c, sn).Unit,
				}
				table.insert(leg.hairs, entry)
				table.insert(leg.segs[spec.segment].hairs, entry)
			end
			-- (ROBLOX-127) the fringe: longer hairs of their own width standing out from the link's sides (look.fuzz.legFringe), one in `every.legFringe` kept
			local keepFringe = cfg.every.legFringe or 1
			for n, spec in Setae.legFringe(look, i) do
				if keepFringe <= 0 or n % keepFringe ~= 0 then continue end
				local c, sn, lie = math.cos(spec.theta), math.sin(spec.theta), spec.lift or 1
				local width = spec.width or fuzz.legWidth
				local entry: LegHair = {
					part = seta(spec.tone, width, width, spec.length, spec.transparency or fuzz.legTransparency), spec = spec, c = c, s = sn, k = 0.9,
					dir = Vector3.new(math.cos(lie), math.sin(lie) * c, math.sin(lie) * sn),
				}
				table.insert(leg.hairs, entry)
				table.insert(leg.segs[spec.segment].hairs, entry)
			end
		end
	end
	if look.legGloss then -- the Greenbottle blue's legs are a little glossy
		for _, leg in self._legs do
			leg.femur.Reflectance, leg.tibia.Reflectance, leg.tarsus.Reflectance = look.legGloss, look.legGloss, look.legGloss
			if leg.femurTip then leg.femurTip.Reflectance = look.legGloss end
			if leg.tibiaTip then leg.tibiaTip.Reflectance = look.legGloss end
			if leg.tarsusTip then leg.tarsusTip.Reflectance = look.legGloss end
		end
	end
	-- The peacock spider's fan (look.fan): the discs of the front face, the figure on them, the repeat on the back and the folded flaps.
	local fc = look.fan
	if fc then
		local fan: Fan = { front = {}, back = {}, figure = {}, flaps = {}, cfg = fc, parts = {}, sizes = {} }
		local function add(list: { FanDisc }, spec: any, y: number)
			local part = disc(model, spec.name, color(spec.color), if spec.name == "FanField" then fc.sheen else 0)
			table.insert(list, { part = part, inset = spec.inset, y = y })
			table.insert(fan.parts, part)
		end
		for k = 1, math.min(cfg.fanLayers or #fc.layers, #fc.layers) do
			add(fan.front, fc.layers[k], (k - 1) * fc.layerStep)
		end
		if cfg.fanBack then
			for j, k in fc.back.layers do add(fan.back, fc.layers[k], fc.back.plane - (j - 1) * fc.layerStep) end
		end
		for _, f in fc.figure do
			if f.fullOnly and detailName == "low" then continue end
			local part = disc(model, if f.color then "FanGlint" else "FanFigure", color(f.color or fc.figureColor), 0)
			table.insert(fan.figure, { part = part, x = f.x, z = f.z, rx = f.rx, rz = f.rz, angle = f.angle, turn = CFrame.Angles(0, f.angle, 0) })
			table.insert(fan.parts, part)
		end
		for _, side in { -1, 1 } do
			local flap = ellipsoid(model, "FanFlap", v3(fc.flaps.radii), color(fc.flaps.color), fabric)
			flap.CastShadow = false
			table.insert(fan.flaps, { part = flap, side = side })
			table.insert(fan.parts, flap)
		end
		self._fan = fan
	end
	if cfg.highlight then
		local hl = Instance.new("Highlight")
		hl.FillTransparency = 1
		hl.OutlineColor = if look.outline then color(look.outline) else WHITE
		hl.OutlineTransparency = 0.82
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = model
		self._highlight = hl
	end
 for _,p in model:GetChildren() do
  if p:IsA("BasePart") and p~=root then self._sizes[p]=p.Size;self._colors[p]=p.Color end
 end
	-- The body's parts are placed every frame; the hairs, by the frame each follows (ROBLOX-93), only when that frame has moved.
	for _, f in self._fixed do
		local palp = f.palp
		if f.part.Name ~= "Seta" then
			table.insert(self._bodyFixed, f)
		elseif palp ~= nil then
			table.insert(self._palpHairs[palp], f)
		elseif f.group == G_HEAD then
			table.insert(self._headHairs, f)
		elseif f.group == G_ABDOMEN then
			table.insert(self._abdomenHairs, f)
		else
			table.insert(self._bodyHairs, f)
		end
	end
	refreshScale(self)
	model.Parent = parent
	self:setGrowthStage(0)
	return self
end

-- Scale about the support plane, not the collider centre. Planted contacts remain world-space points.
-- (ROBLOX-93: a stage already applied writes nothing again, and setScale returns at once for the scale it has: the mate stage asks every frame.)
function SpiderRig.setGrowthStage(self: Rig, stage: number)
 local index=math.clamp(math.floor(stage),0,3)
 if index~=self._stage then
  self._stage=index
  self.model:SetAttribute("GrowthStage",index)
  local fade=self._appearance.barFade -- the Greenbottle blue's juvenile bars soften at the last stage
  if fade then for _,bar in self._bars do bar.Transparency=fade[index+1] end end
 end
 self:setScale(self:growthScale(index))
end
-- (ROBLOX-114) The scale a growth stage is drawn at: Growth.SCALES (golden), or the appearance's own `growth` where it has one (a costume whose species' adult is
-- smaller than Growth's adult would draw it: the peacock spider and the ant mimic grow to their real adults' size, 5 and 6 mm). The collider is never touched.
function SpiderRig.growthScale(self: Rig, stage: number): number
 local index=math.clamp(math.floor(stage),0,3)
 local scales=self._appearance.growth or Growth.SCALES
 return scales[index+1]
end
-- Any size, not only a growth stage's (ROBLOX-80: the mate is the played spider's look at the adult scale times its own factor). The same scaling as a stage.
function SpiderRig.setScale(self: Rig, g: number)
 if self._growth==g then return end
 self._growth=g
 self._k=(self._appearance.scale or 1)*g
 self._drop=0.31-(0.31-(self._appearance.bodyDrop or 0))*g
 self._epoch+=1 -- what was placed for the old scale is placed again
 for p,size in self._sizes do p.Size=size*g end
 refreshScale(self)
end
function SpiderRig.setSoftness(self: Rig, value: number)
 local s=math.clamp(value,0,1)
 if math.abs(s-self._softness)<0.001 then return end
 self._softness=s
 for p,c in self._colors do
  -- The eyes stay dark and readable; pigment returns as the skin hardens.
  if p.Material~=Enum.Material.Glass and p.Name~="Catchlight" and p.Name~="Retina" then p.Color=c:Lerp(Color3.new(0.88,0.82,0.69),s*0.72) end
 end
end
function SpiderRig.setCondition(self: Rig, energy: number)
 self._condition=math.clamp(energy,0,1)
end

-- A cue from the host for the living motion (ROBLOX-87): "groom" (a meal has just ended: a longer cleaning once it stands still) or "alarm" (the wasp's
-- warning or the rival's windup: legs I up and the idle motion frozen for a moment). Anything else, or a rig below the full tier, ignores it.
-- ROBLOX-89: "meet" (reach out to the other spider) and "settle" (sink and breathe deeper) for the mating scene, each for `seconds` (default the look's own), and
-- "release" to let both go; a rig without the living motion (the ant mimic, the low tier unless made `living`) ignores them.
function SpiderRig.cue(self: Rig, name: string, seconds: number?)
	local living = self._living
	if living ~= nil then Living.cue(living, name, seconds) end
end

-- The host's count of meals finished so far: a rise cues the "groom". (The first count only sets the baseline: a spider loaded from a save does not clean itself.)
function SpiderRig.noteMeals(self: Rig, count: number)
	local seen = self._mealsSeen
	self._mealsSeen = count
	if seen ~= nil and count > seen then self:cue("groom") end
end

-- How many parts the drawn spider is made of (the model's direct parts), for budgets and the docs.
function SpiderRig.count(self: Rig): { total: number, hairs: number, shells: number, body: number }
	local total, hairs, shells = 0, 0, 0
	for _, part in self.model:GetChildren() do
		if part:IsA("BasePart") then
			total += 1
			if part.Name == "Seta" then hairs += 1 elseif part.Name == "FuzzShell" then shells += 1 end
		end
	end
	return { total = total, hairs = hairs, shells = shells, body = total - hairs - shells }
end

local function legGroup(self: Rig, i: number): number
	if self.gaitMode == "Unilateral" then
		return if i <= 4 then 0 else 1
	end
	-- Godot's (i % 4 + i / 4) % 2 with 0-based i: L1 R2 L3 R4 against R1 L2 R3 L4.
	local j = i - 1
	return (j % 4 + j // 4) % 2
end


-- Display-only foothold: retract toward the body at a narrow edge; never invents a platform.
local function target(self: Rig, body: CFrame, leg: Leg): RaycastResult?
	local up = body.UpVector
	local rest = leg.rest
	local k = self._k
	for _, reach in REACHES do
		local point = body:PointToWorldSpace(Vector3.new(rest.X * reach, 0, rest.Z * reach))
		local hit = Workspace:Raycast(point + up * (0.35 * k), -up * (1.0 * k), self._params)
		if hit and hit.Normal:Dot(up) > 0.35 then
			return hit
		end
	end
	return nil
end

-- The hanging pose of one leg (ROBLOX-86): the knee, the ankle and the foot in world space, from the directions in look.hang.legs. Each link keeps
-- the length it has standing (hip to knee, knee to ankle, ankle to foot, as the walking pose draws them), so legs I and II curl forward and back up
-- toward the line, III and IV fold back along the body, and nothing reaches for the ground. A fixed scatter per leg keeps the pair from mirroring
-- exactly; the feet tremble a little (not with Reduced Motion); going up the line the legs' directions along the body turn over (`_climb`), so legs I
-- reach up the line and legs IV trail.
function SpiderRig._hangLeg(self: Rig, leg: Leg, body: CFrame): (Vector3, Vector3, Vector3)
	local look, L, g = self._appearance, self._appearance.limbs, self._growth
	local hang = look.hang
	local hip, rest = leg.hip, leg.rest
	local knee0 = hip:Lerp(rest, 0.48) + Vector3.yAxis * (L.kneeLift * g)
	local ankle0 = knee0:Lerp(rest, ANKLE_SHARE) + Vector3.yAxis * (L.ankleLift * g)
	local len1, len2, len3 = (knee0 - hip).Magnitude, (ankle0 - knee0).Magnitude, (rest - ankle0).Magnitude
	local spec = hang.legs[leg.pair]
	-- (ROBLOX-93: the scatter of each link is a fixed pair of numbers, worked out the first time the leg hangs and kept, and no table is made of the lengths or the joints)
	local scatter: { number } = leg.noise or {}
	if leg.noise == nil then
		local made = scatter
		for n = 1, 3 do
			made[2 * n - 1] = math.sin(leg.pair * 12.9898 + leg.side * 78.233 + n * 37.719)
			made[2 * n] = math.sin(leg.pair * 39.346 + leg.side * 11.135 + n * 83.155)
		end
		leg.noise = made
	end
	local climb = self._climb
	local tremble = if self.reducedMotion then 0 else math.sin(self._t * 3.2 + leg.pair * 1.7 + leg.side) * hang.wiggle
	local j1, j2, j3 = hip, hip, hip
	local at = hip
	for n = 1, 3 do
		local d = spec[LEG_NAMES[n]]
		local noise, noise2 = scatter[2 * n - 1], scatter[2 * n]
		local dz = d[3] * (1 - (if leg.pair <= 2 then 2.0 else 1.2) * climb) -- going up, legs I and II reach up the line and III and IV go out to grip it
		local dir = Vector3.new(leg.side * d[1] + noise * hang.asym, d[2] + noise2 * hang.asym + (if n == 3 then tremble else 0), dz + noise * noise2 * hang.asym).Unit
		at = at + dir * (if n == 1 then len1 elseif n == 2 then len2 else len3)
		if n == 1 then j1 = at elseif n == 2 then j2 = at else j3 = at end
	end
	return body:PointToWorldSpace(j1), body:PointToWorldSpace(j2), body:PointToWorldSpace(j3)
end

-- One link of a leg (ROBLOX-93: a function of the module, so that a frame makes no closure of it): its rod runs from a to b; with a thinner `tip` rod the first runs a to m
-- and the tip m to b (a tapered femur or tibia, the break in the tarsus). The pale band (one `bandFraction` of the whole link) and the hairs follow the link, not the
-- pieces. A size is written only when it is more than its step from the one the part has (kept in `seg`, so nothing is read from the part), and the hairs, which
-- go to the second batch, are placed again only when the link has moved.
local function drawSegment(seg: Seg, bandFraction: number, g: number, a: Vector3, m: Vector3, b: Vector3, bodyBatch: Batch, hairBatch: Batch, exact: boolean)
	local rod, tip, band = seg.rod, seg.tip, seg.band
	local len = math.max((b - a).Magnitude, 0.01)
	local ends = if tip then m else b
	local plen = math.max((ends - a).Magnitude, 0.01)
	if math.abs(seg.x - plen) > 1e-3 then
		seg.x = plen
		rod.Size = Vector3.new(plen, seg.dy, seg.dz)
	end
	local rc = rodCFrame(a, b) -- local +X runs from a toward b (toward the foot)
	put(bodyBatch, rod, if tip then rodCFrame(a, m) else rc)
	local share = plen / len
	if tip then
		local tlen = math.max((b - m).Magnitude, 0.01)
		if math.abs(seg.tipX - tlen) > 1e-3 then
			seg.tipX = tlen
			tip.Size = Vector3.new(tlen, seg.tipDy, seg.tipDz)
		end
		put(bodyBatch, tip, rodCFrame(m, b))
	end
	if band then
		local blen = len * bandFraction
		if math.abs(seg.bandX - blen) > BAND_STEP then
			seg.bandX = blen
			band.Size = Vector3.new(blen, seg.dy * 1.035, seg.dz * 1.035)
		end
		put(bodyBatch, band, rc)
	end
	-- Leg setae stand out from the segment and lean toward the foot (or, for a coat that lies along the leg, lie at their own angle).
	if exact or moved(seg.rc, rc) or math.abs(len - seg.len) > MOVE_STUDS then
		seg.rc, seg.len = rc, len
		local radius, tipRadius = seg.dy * 0.5, seg.tipDy * 0.5
		for _, hair in seg.hairs do
			local spec = hair.spec
			local r = if tip and spec.t > share then tipRadius else radius
			local base = Vector3.new((spec.t - 0.5) * len, r * hair.k * hair.c, r * hair.k * hair.s)
			local dir = hair.dir
			put(hairBatch, hair.part, rc * CFrame.lookAt(base + dir * (spec.length * g * 0.5), base + dir * spec.length*g, Vector3.xAxis))
		end
	end
end

-- Writes the size a fan part should have, if it differs from what it has (the fan keeps what each part holds; nothing is read from the part).
local function fanSize(fan: Fan, part: BasePart, size: Vector3)
	local was: Vector3? = fan.sizes[part]
	if was == nil or (was - size).Magnitude > 1e-5 then
		fan.sizes[part] = size
		part.Size = size
	end
end

-- Sets the fan's discs for how far it is open (0: folded on the abdomen, 1: a near-round disc) in the abdomen's frame. The discs grow from
-- Appearances.fan.folded to full size; the figure and the repeat on the back follow; the folded flaps swing out from the flanks and end
-- under the discs. Flat ellipsoids: only their size and place change. Each part lies on the abdomen, so its place (about the abdomen's centre) and its size go with the
-- abdomen's `condition`; ROBLOX-93: both are worked out once, from the part's own size, and a size is written once or not at all.
local function drawFan(self: Rig, fan: Fan, abdomen: CFrame, open: number, condition: Vector3, batch: Batch)
	local fc, A, g = fan.cfg, self._layout, self._growth
	local center = A.abdomenCenter
	local sx = fc.folded[1] + (1 - fc.folded[1]) * open
	local sz = fc.folded[2] + (1 - fc.folded[2]) * open
	local fold = 1 - open
	local top = center.Y + A.abdomenRadii.Y + fc.plane - fc.foldedSink * fold
	local z = center.Z + fc.zShift * open
	local thick = fc.thickness + (fc.foldedThickness - fc.thickness) * fold
	local mid = center.Y - A.abdomenRadii.Y
	for pass = 1, 2 do
		local discs: { FanDisc } = if pass == 1 then fan.front else fan.back
		local y0, t = if pass == 1 then top else mid, if pass == 1 then thick else fc.thickness
		for _, d in discs do
			local rx, rz = math.max((fc.radii[1] - d.inset) * sx, 0.002), math.max((fc.radii[2] - d.inset) * sz, 0.002)
			fanSize(fan, d.part, Vector3.new(rx * 2, t, rz * 2) * g * condition)
			put(batch, d.part, abdomen * CFrame.new((center + (Vector3.new(0, y0 + d.y, z) - center) * condition) * g))
		end
	end
	local figureY = top + #fan.front * fc.layerStep + (thick - fc.thickness) * 0.5
	local show = open * open * (3 - 2 * open) -- the black figure shows as the fan opens, and is gone when it is folded
	for _, f in fan.figure do
		fanSize(fan, f.part, Vector3.new(math.max(f.rx * fc.radii[1] * sx * 2 * show, 0.002), fc.thickness, math.max(f.rz * fc.radii[2] * sz * 2 * show, 0.002)) * g * condition)
		local at = Vector3.new(f.x * fc.radii[1] * sx, figureY, z + f.z * fc.radii[2] * sz)
		put(batch, f.part, abdomen * CFrame.new((center + (at - center) * condition) * g) * f.turn)
	end
	local fl = fc.flaps
	local angle = math.rad(fl.foldedDeg) * (1 - open)
	for _, f in fan.flaps do
		fanSize(fan, f.part, self._sizes[f.part] * g * condition)
		local hinge = Vector3.new(f.side * fl.hingeX, center.Y + fl.hingeY, center.Z + fc.zShift * open)
		local cf = (CFrame.Angles(0, 0, f.side * angle) + hinge) * CFrame.new(f.side * fl.radii[1], 0, 0)
		put(batch, f.part, abdomen * CFrame.new((center + (cf.Position - center) * condition) * g) * cf.Rotation)
	end
end

-- body: the drawn body's CFrame. grounded: standing on a surface. moving: walking speed > 0 (for palp drumming and idle motion).
function SpiderRig.update(self: Rig, collider: CFrame, dt: number, grounded: boolean, moving: boolean)
	self._t += dt
	-- The root part (what the camera and tests read) stays at the collider's frame; the drawn body of a small appearance sits lower.
	local body = if self._drop ~= 0 then collider * CFrame.new(0, -self._drop, 0) else collider
	-- The ant-mimicking spider's drawn walk: the body yaws and sways a little along a sine of the distance walked (the collider and the path
	-- are untouched; the root part stays at the collider's frame).
	local antPose = if self._appearance.antennae ~= nil then self.ant else nil
	if antPose ~= nil and (antPose.yaw ~= 0 or antPose.lateral ~= 0) then
		body = body * CFrame.new(antPose.lateral * self._growth, 0, 0) * CFrame.Angles(0, antPose.yaw, 0)
	end
	-- A tarantula's threat display and silk mat (ROBLOX-82): the drawn body pivots about its up axis (the root and the collider do not); what else
	-- the pose does (rears the prosoma, raises legs I and the palps, swings the spinnerets) is further down.
	-- (ROBLOX-127) the rival's contest display (look.contest, a RivalDisplay pose) goes the same way, with a sideways step of the drawn body (`lateral`, studs at scale 1:
	-- the zigzag), legs I between three places (`reach`, `hook`), the chelicerae spread (`spread`) and a crouch (`lower`).
	local tc = self._appearance.threat or self._appearance.contest
	local threatPose = if tc ~= nil then self.threat else nil
	local threatening = threatPose ~= nil and threatPose.presence > 0
	if threatening and (threatPose.lateral or 0) ~= 0 then
		body = body * CFrame.new(threatPose.lateral * self._growth, 0, 0)
	end
	if threatening and threatPose.yaw ~= 0 then
		body = body * CFrame.Angles(0, threatPose.yaw, 0)
	end
	local up = body.UpVector
	local look, cfg, A = self._appearance, self._cfg, self._layout
	local k, g = self._k, self._growth
 self._shownCondition += math.clamp(self._condition-self._shownCondition,-0.12*dt,0.12*dt)
 local conditionValue=self._shownCondition
 local condition=Vector3.new(0.84+0.30*conditionValue,0.84+0.30*conditionValue,0.93+0.12*conditionValue)
	-- Suspension (ROBLOX-59; hung properly in ROBLOX-86). The drawn body turns about its middle until its long axis, from the face to the spinneret,
	-- runs along the line (the shortest turn: no angle limit), so the tail lands on the line and the silk leaves the spinneret tip; the root, the camera,
	-- the collider and the tether never move. Then a small lean, a damped pendulum sway (about the spinneret, started by the drop) and a slow damped turn
	-- about the line, none of it with Reduced Motion. Going up the line (the collider travelling toward the anchor) the body turns head-up (`_climb`).
	local hang = look.hang
	local hanging = not grounded and self.hangDirection ~= nil and hang ~= nil
	if hanging then
		local d = (self.hangDirection :: Vector3)
		if d.Magnitude > 1e-6 then self._lineDir = d.Unit end
	end
	local lineUp = self._lineDir
	local blend = if hang ~= nil then hang.rate * dt else 5 * dt
	local before = self._hang
	self._hang += math.clamp((if hanging then 1 else 0) - self._hang, -blend, blend)
	if grounded then self._hang = 0 end
	if hang ~= nil then
		if hanging and dt > 1e-6 and self._lastPos ~= nil then
			local speed = (collider.Position - (self._lastPos :: Vector3)):Dot(lineUp) / dt
			self._lineSpeed += (speed - self._lineSpeed) * math.min(1, dt / 0.25)
			if self._lineSpeed > hang.climb.speed then self._climbing = true elseif self._lineSpeed < hang.climb.speed * 0.4 then self._climbing = false end
		elseif not hanging then
			self._lineSpeed, self._climbing = 0, false
		end
		self._lastPos = collider.Position
		local step = if self.reducedMotion then 1 else math.max(dt, 1e-6) / hang.climb.seconds
		self._climb += math.clamp((if self._climbing and hanging then 1 else 0) - self._climb, -step, step)
		if not hanging and self._hang <= 0 then self._climb = 0 end
	end
	if self._hang > 0 and hang ~= nil then
		local h = self._hang
		if before <= 0 then -- the drop: the swing and the turn start now (the turn goes one way, then the other, drop by drop)
			self._hangT, self._spin = 0, 0
			self._spinVel = math.rad(hang.spin.degPerS) * (if self._hangCount % 2 == 0 then 1 else -1)
			self._hangCount += 1
		end
		self._hangT += dt
		local calm = not self.reducedMotion
		if calm then
			self._spinVel *= math.exp(-dt / hang.spin.decay)
			self._spin += self._spinVel * dt
		end
		local c = self._climb
		-- the long axis: the face's centre to the spinneret tip, turned (about the middle) onto the line
		local nose = Vector3.new(0, A.faceCenter.Y, A.faceCenter.Z) * g
		local tail = (A.abdomenCenter + (A.spinneret - A.abdomenCenter) * condition) * g
		local middle = body:PointToWorldSpace((nose + tail) * 0.5)
		local axis = body:VectorToWorldSpace((tail - nose).Unit)
		local turn = axis:Cross(lineUp)
		local offLine = math.acos(math.clamp(axis:Dot(lineUp), -1, 1))
		local align = CFrame.identity
		if turn.Magnitude > 1e-5 then align = CFrame.fromAxisAngle(turn.Unit, offLine * h)
		elseif axis:Dot(lineUp) < 0 then align = CFrame.fromAxisAngle(body.UpVector, math.pi * h) end
		body = CFrame.new(middle) * align * CFrame.new(-middle) * body
		if c > 0 then -- head up: end over end about the middle, the body standing off the line toward its back so the silk runs along the belly
			body = CFrame.new(middle) * CFrame.fromAxisAngle(body.RightVector, math.pi * c * h) * CFrame.new(-middle) * body
			body = CFrame.new(body.UpVector * (A.headRadii.Y * hang.climb.shift * g * c * h)) * body
		end
		local pivot = body:PointToWorldSpace(tail)
		local side = body.RightVector
		local forward = lineUp:Cross(side)
		if forward.Magnitude > 1e-6 then forward = forward.Unit end
		local rest = (1 - c) * h
		local swing = if calm then math.exp(-self._hangT / hang.sway.decay) * math.sin(math.pi * 2 * self._hangT / hang.sway.period) else 0
		local swingAcross = if calm then math.exp(-self._hangT / hang.sway.decay) * math.cos(math.pi * 2 * self._hangT / hang.sway.period) * (1 - math.exp(-self._hangT / 0.3)) else 0
		local sway = math.rad(hang.sway.deg) * swing
		local sideways = math.rad(hang.sway.deg) * hang.sway.across * swingAcross
		local lean = CFrame.fromAxisAngle(side, (math.rad(hang.leanDeg) + sway) * rest) * CFrame.fromAxisAngle(forward, sideways * rest)
		body = CFrame.new(pivot) * CFrame.fromAxisAngle(lineUp, self._spin * rest) * lean * CFrame.new(-pivot) * body
		up = body.UpVector
	end
	-- The drawing is two batches (ROBLOX-93): the body's parts every frame, then the hairs that moved (see MOVE_STUDS). Both are tables the rig keeps.
	local bodyBatch, hairBatch = self._bodyBatch, self._hairBatch
	clearBatch(bodyBatch)
	clearBatch(hairBatch)
	put(bodyBatch, self.root, collider)
	-- The courtship display (rig.dance, a PeacockDance pose), for an appearance that has a fan.
	local display = self.dance
	local fan = self._fan
	local dancing = fan ~= nil and display ~= nil and display.presence > 0
	local posed = dancing or threatening -- a display pose is on: no idle motion, twitch or jump brace on top of it

	-- Palps drum in bursts while the spider stands still; breathing and a curious head tilt ease in after a moment. All of
	-- it is full detail only (cfg.idle), and reducedMotion turns it off too.
	local loading = grounded and self.jumpLoad > 0
 local push = if self.reducedMotion then 0 else math.clamp(self.jumpPush,0,1)
 local desiredLoad = if loading and not self.reducedMotion then math.clamp(self.jumpLoad,0,1) else 0
 self._shownLoad += math.clamp(desiredLoad-self._shownLoad,-12*dt,6*dt)
 local load = if self.reducedMotion then 0 else self._shownLoad
 local standing = cfg.idle and grounded and not moving and not self.reducedMotion and not posed and not loading
	-- Living motion (ROBLOX-87), full detail only: the watched point as an angle from the drawn body's heading, then the pose of attention, grooming, alarm and
	-- a tarantula's stretch. It only ever turns and bends drawn parts: the planted feet, the root, the motor and the camera do not know it.
	local lp: Living.Pose? = nil
	local living = self._living
	if living ~= nil then
		local focusYaw: number?, focusPitch: number? = nil, nil
		local watched = self.focusPoint
		if watched ~= nil and grounded and not posed and self._hang <= 0 then
			local d = body:PointToObjectSpace(watched)
			local flat = math.sqrt(d.X * d.X + d.Z * d.Z)
			if flat > 0.25 * k then
				focusYaw, focusPitch = math.atan2(-d.X, -d.Z), math.atan2(d.Y - A.faceCenter.Y * g, flat)
			end
		end
		lp = Living.step(living, dt, standing == true, self.reducedMotion, focusYaw, focusPitch, grounded and not posed and self._hang <= 0)
	end
	local freeze = if lp ~= nil then lp.freeze else 0
	-- The abdomen breathes: all of it at a stand, `movingShare` of it otherwise (and none with Reduced Motion or below the full tier).
	local breathing = 0
	if cfg.idle and not self.reducedMotion then breathing = if standing then 1 else (look.idle.breathe.movingShare or 0) end
	self._breath += math.clamp(breathing - self._breath, -dt / 0.6, dt / 0.6)
	local gain = if lp ~= nil then lp.breath else 1 -- (the mating scene's settle: a deeper breath, ROBLOX-89)
	local breathScale = if cfg.idle then Idle.abdomenScale(self._t, self._breath * (1 - 0.8 * freeze) * gain, look.idle) else 1
	self._drum = math.clamp(self._drum + (if standing then 3 else -3) * dt, 0, 1)
	local drum = self._drum * (1 - freeze)
	local palp1, palp2 = Idle.palp(self._t, drum, look.palp, 1), Idle.palp(self._t, drum, look.palp, 2) -- (the palps' angles)
	local bodyBase, headBase, abdomenBase = body, body, body
	if cfg.idle then
		local idle = look.idle
		self._calm = math.clamp(self._calm + (if standing then dt / idle.riseSeconds else -dt / idle.fallSeconds), 0, 1)
		if self._calm > 0 then
			local c = self._calm * self._calm * (3 - 2 * self._calm) * (1 - freeze)
			local pose = Idle.pose(self._t, c, idle, self._pose)
			bodyBase = body * CFrame.new(0, pose.bodyLift*g*gain, 0)
			headBase = bodyBase * CFrame.new(A.neck*g) * CFrame.Angles(pose.headPitch, pose.headYaw, pose.headRoll) * CFrame.new(-A.neck*g)
			abdomenBase = bodyBase * CFrame.new(0, pose.abdomenLift*g*gain, 0) * CFrame.new(A.pedicelCenter*g)
				* CFrame.Angles(-pose.abdomenPitch*gain, 0, 0) * CFrame.new(-A.pedicelCenter*g)
		end
	end
	-- Display-only snaps also run on low-detail devices. Camera/root, foot anchors and motor stay unchanged.
	if grounded and not self.reducedMotion and not posed and not loading then
		local yaw, lift = Idle.snap(self._t, moving)
		yaw, lift = yaw * (1 - freeze), lift * (1 - freeze)
		local accent = body * CFrame.new(0, lift * g, 0) * CFrame.Angles(0, yaw, 0) * body:Inverse()
		bodyBase, headBase, abdomenBase = accent * bodyBase, accent * headBase, accent * abdomenBase
	end
	-- Attention: the whole drawn body turns toward what is watched (the hips go with it; the planted feet stay where they are).
	if lp ~= nil and lp.yaw ~= 0 then
		local turn = body * CFrame.Angles(0, lp.yaw, 0) * body:Inverse()
		bodyBase, headBase, abdomenBase = turn * bodyBase, turn * headBase, turn * abdomenBase
	end
	-- The mating scene's settle (ROBLOX-89): the whole drawn body sinks a little toward the surface (the planted feet stay where they are).
	if lp ~= nil and lp.settle > 0 and look.idle.settle ~= nil then
		local sink = body * CFrame.new(0, -look.idle.settle.lower * g * lp.settle, 0) * body:Inverse()
		bodyBase, headBase, abdomenBase = sink * bodyBase, sink * headBase, sink * abdomenBase
	end
 -- A visible preparation and extension, not a pressure gauge or an inflated body. Hydraulic
 -- extension and muscle action both matter; their jump contribution varies among species
 -- (Nabawy et al. 2018, doi:10.1038/s41598-018-25227-9). Timings are display tuning.
 if not posed and (load > 0 or push > 0) then
  local brace = body * CFrame.new(0,(-0.065*load+0.025*push)*k,0)
   * CFrame.Angles(-0.07*load+0.05*push,0,0) * body:Inverse()
  bodyBase,headBase,abdomenBase=brace*bodyBase,brace*headBase,brace*abdomenBase
 end
	if dancing then
		-- The abdomen pitches up about the pedicel and sways side to side (about the body's long axis), the palps flick in unison.
		abdomenBase = bodyBase * CFrame.new(A.pedicelCenter*g) * CFrame.Angles(0, 0, display.abdomenSway + display.shiver)
			* CFrame.Angles(-display.abdomenPitch, 0, 0) * CFrame.new(-A.pedicelCenter*g)
		palp1, palp2 = palp1 + display.palp, palp2 + display.palp
	end
	-- The threat display: the prosoma (the head with the palps, and every leg's hip) pitches up about the waist; the palps lift at their bases.
	local prosoma = bodyBase
	if threatening and threatPose.rear ~= 0 then
		local waist = A.pedicelCenter * g
		prosoma = bodyBase * CFrame.new(waist) * CFrame.Angles(threatPose.rear, 0, 0) * CFrame.new(-waist)
		headBase = prosoma * (bodyBase:Inverse() * headBase) -- (keeps any head tilt the idle motion still has)
	end
	if threatening then
		palp1, palp2 = palp1 + threatPose.palps, palp2 + threatPose.palps
		local sink = (threatPose.lower or 0) * (if tc.lower then tc.lower else 0)
		if sink ~= 0 then -- backing off: the whole drawn body low to the surface (the planted feet stay where they are)
			local down = body * CFrame.new(0, -sink * g, 0) * body:Inverse()
			bodyBase, headBase, abdomenBase, prosoma = down * bodyBase, down * headBase, down * abdomenBase, down * prosoma
		end
	end
 -- Feeding follows the drawn head, never the motor or camera. Both tiers use this pose.
 local bite=(self.mealPulse or 0)*(if self.reducedMotion then .2 else 1)
 if self.mealHeld then
  headBase*=CFrame.new(0,-.012*bite*g,-.02*bite*g)*CFrame.Angles(-.035*bite,0,0)
  palp1-=.16+.1*bite;palp2-=.16+.1*bite
 end
 self._mouth=headBase*CFrame.new(((A.jaws[1].at+A.jaws[2].at)*.5+Vector3.new(0,-.015,-.075))*g)
	local spreadAngle = if threatening and tc.spreadDeg then math.rad(tc.spreadDeg) * (threatPose.spread or 0) else (if self.mealHeld then .05+.08*bite else 0)
 if self._hang > 0 and hang ~= nil then -- hanging: the palps are drawn in toward the jaws
  local tuck = -math.rad(hang.palpTuckDeg) * self._hang
  palp1, palp2 = palp1 + tuck, palp2 + tuck
 end
 self._spinneret=abdomenBase:PointToWorldSpace((A.abdomenCenter+(A.spinneret-A.abdomenCenter)*condition)*g)
	-- Grooming: a palp is drawn in toward the jaws (turned toward the midline and tipped down) about its base.
	local palpYaw1, palpYaw2 = 0, 0
	if lp ~= nil then
		palp1, palp2 = palp1 - lp.palpPitch[1], palp2 - lp.palpPitch[2]
		palpYaw1, palpYaw2 = lp.palpYaw[1], lp.palpYaw[2]
	end
	local glanceAt = Vector3.zero -- the principal eyes' shift in the head's frame, studs, toward what is watched
	if lp ~= nil and look.idle.attention ~= nil then
		local reach = look.idle.attention.glance
		glanceAt = Vector3.new(lp.glanceX * reach, lp.glanceY * reach * 0.6, 0)
	end
	local pivot1 = CFrame.Angles(palp1, palpYaw1, 0) + self._palpBase[1]
	local pivot2 = CFrame.Angles(palp2, palpYaw2, 0) + self._palpBase[2]
	-- What has changed since the hairs were last placed: after a change of scale (a new epoch) everything, otherwise the abdomen's condition (its parts' sizes and places)
	-- and, below, the frame each kind of hair follows.
	local seen, epoch = self._seen, self._epoch
	local fresh = seen.epoch ~= epoch or self._exact
	local abdomenAt = A.abdomenCenter
	local sizesDue = fresh or (condition - seen.sizeKey).Magnitude > SCALE_STEP
	local glanced = glanceAt ~= Vector3.zero
	local sweeping = threatening and threatPose.sweep ~= 0
	for _, f in self._bodyFixed do
		local group = f.group
		local base = if group == G_HEAD then headBase elseif group == G_ABDOMEN then abdomenBase else bodyBase
		local palp = f.palp
		if palp then
			put(bodyBatch, f.part, base * scaled((if palp == 1 then pivot1 else pivot2) * f.offset, g))
		else
			local offset, edited = f.offset, false
			if f.glance == true and glanced then offset, edited = CFrame.new(glanceAt) * offset, true end
			if spreadAngle ~= 0 and f.jaw ~= nil and f.pivot ~= nil then
				-- The rival's display: each chelicera (and its fang) swings out about its base, the tip outward and a little apart (ROBLOX-127).
				local side, at = f.jaw, f.pivot
				offset, edited = CFrame.new(at) * CFrame.Angles(0, -side * spreadAngle * 0.35, side * spreadAngle) * CFrame.new(-at) * offset, true
			end
			if sweeping and f.sweep ~= nil then
				-- A spinneret segment swings side to side about a point just inside the abdomen's rear tip (the second segment farther).
				local at = A.spinneret - Vector3.new(0, 0, tc.sweepBack)
				offset, edited = CFrame.new(at) * CFrame.Angles(0, threatPose.sweep * (if f.sweep > 1 then tc.tipSweep else 1), 0) * CFrame.new(-at) * offset, true
			end
			if group == G_ABDOMEN then
				-- (the whole abdomen, its hairs and its shells, breathes; only the big masses are resized every frame, the rest when the condition has changed)
				local pos, rot = f.pos, f.rot
				if edited then pos, rot = offset.Position, offset.Rotation end
				local p = abdomenAt + (pos - abdomenAt) * condition * breathScale
				put(bodyBatch, f.part, base * (rot + (if g == 1 then p else p * g)))
				if f.big == true then
					resize(f, f.size0 * g * condition * breathScale)
				elseif sizesDue then
					resize(f, f.size0 * g * condition)
				end
			else
				put(bodyBatch, f.part, base * (if edited then scaled(offset, g) else f.scaled))
			end
		end
	end

	-- The hairs, in the second batch: a kind is placed again only if the frame it follows has moved since it was last placed (fresh: after a change of scale, all).
	if fresh or moved(seen.head, headBase) then
		seen.head = headBase
		for _, f in self._headHairs do put(hairBatch, f.part, headBase * f.scaled) end
	end
	if fresh or moved(seen.body, bodyBase) then
		seen.body = bodyBase
		for _, f in self._bodyHairs do put(hairBatch, f.part, bodyBase * f.scaled) end
	end
	for index = 1, 2 do
		local pivot = if index == 1 then pivot1 else pivot2
		if fresh or moved(seen.palpHead[index], headBase) or moved(seen.pivot[index], pivot) then
			seen.palpHead[index], seen.pivot[index] = headBase, pivot
			for _, f in self._palpHairs[index] do put(hairBatch, f.part, headBase * scaled(pivot * f.offset, g)) end
		end
	end
	if sizesDue or math.abs(breathScale - seen.breath) > SCALE_STEP or moved(seen.abdomen, abdomenBase) then
		seen.abdomen, seen.breath = abdomenBase, breathScale
		for _, f in self._abdomenHairs do
			local p = abdomenAt + (f.pos - abdomenAt) * condition * breathScale
			put(hairBatch, f.part, abdomenBase * (f.rot + (if g == 1 then p else p * g)))
			if sizesDue then resize(f, f.size0 * g * condition) end
		end
	end
	if sizesDue then seen.sizeKey = condition end
	seen.epoch = epoch

	if fan then
		drawFan(self, fan, abdomenBase, if dancing then display.fanOpen else 0, condition, bodyBatch)
	end

	-- Legs: planted feet stay put in the world; a leg too far from its rest spot steps, in alternating groups.
	local swinging = false
	for _, leg in self._legs do
		swinging = swinging or leg.swing >= 0
	end
	if grounded and not swinging then
		local worst = STEP_ERROR * k
		for i, leg in self._legs do
			if leg.planted then
				local err = (body:PointToWorldSpace(leg.rest) - leg.planted :: Vector3).Magnitude
				if err > worst then
					worst = err
					self._group = legGroup(self, i)
				end
			end
		end
	end
	local L = look.limbs
	local bandFraction = look.bandFraction
	local exact = self._exact
	local started = false
	for i, leg in self._legs do
		local rest = body:PointToWorldSpace(leg.rest)
		if not grounded then
			leg.planted = nil
			leg.swing = -1
   local free=Vector3.new(leg.side*.47*k,-.12*k,L.tipZ[leg.pair]*.72*g)
   leg.foot=body:PointToWorldSpace(free)
   leg.hangKnee, leg.hangAnkle = nil, nil
   if self._hang>0 then
    local knee,ankle,foot=self:_hangLeg(leg,body)
    leg.hangKnee,leg.hangAnkle=knee,ankle
    leg.foot=leg.foot:Lerp(foot,self._hang)
   end
		else
			leg.hangKnee, leg.hangAnkle = nil, nil
			if leg.planted == nil then
				local hit = target(self, body, leg)
				leg.planted = if hit then hit.Position else nil
				leg.foot = if hit then hit.Position else rest + up * 0.16
				leg.swing = -1
			end
			local anchor = leg.planted
			if anchor then
				if leg.swing >= 0 then
					leg.swing = math.min(1, leg.swing + dt / (SWING_SECONDS * math.sqrt(k)))
					local s = leg.swing
					local smooth = s * s * (3 - 2 * s)
					leg.foot = leg.from:Lerp(anchor, smooth) + leg.up * math.sin(math.pi * s) * (STEP_HEIGHT * k)
					if leg.swing >= 1 then
						leg.swing = -1
						leg.foot = anchor
					end
				else
					leg.foot = anchor
					local err = (rest - anchor).Magnitude
					if err > STEP_ERROR * k and ((not swinging and legGroup(self, i) == self._group) or err > 0.60 * k) then
						local hit = target(self, body, leg)
						if hit and (anchor - hit.Position).Magnitude > 0.12 * k then
							leg.from = anchor
							leg.planted = hit.Position
							leg.up = hit.Normal
							leg.swing = 0
							started = true
						end
					end
					if body:PointToObjectSpace(leg.foot).Magnitude > 1.4 * k then
						leg.planted = nil
						leg.foot = rest
					end
				end
			end
		end
	end
	if started then
		self._group = 1 - self._group
	end
	local kneeUp = (if grounded then L.kneeLift else L.kneeLiftAir)*g
	for index, leg in self._legs do
		local hip = prosoma:PointToWorldSpace(leg.hip)
		local foot = leg.foot
  local rear = leg.pair >= 3
  if not grounded and rear and push > 0 then
   foot += body:VectorToWorldSpace(Vector3.new(leg.side*.05,-.25,.18)*k*push)
  end
		local knee = hip:Lerp(foot, 0.48) + up * (if rear then kneeUp*(1-.7*push)+.035*k*load else kneeUp)
		-- A leg of the living motion (ROBLOX-87): pulled forward to be groomed, raised in an alarm, or reaching out in a tarantula's stretch. The planted foot below is untouched.
		local alive = if lp ~= nil then lp.legs[index] else nil
		if alive ~= nil and alive.w > 0 then
			local spot = Vector3.new(leg.side * alive.x, alive.y, alive.z) * g
			local reached = if alive.rel then foot + bodyBase:VectorToWorldSpace(spot) else bodyBase:PointToWorldSpace(spot)
			foot = foot:Lerp(reached, alive.w)
			local bent = hip:Lerp(reached, 0.5) + bodyBase.RightVector * (leg.side * alive.kneeOut * g) + up * (alive.kneeUp * g)
			knee = knee:Lerp(bent, alive.w)
		end
		local own = if dancing and look.pairs then look.pairs[leg.pair] else nil
		if own and display.legsRaise > 0 then
			-- Legs III go up in a V beside the fan and wave: down and forward over the carapace, and back up (the planted foot below is untouched).
			local raise = display.legsRaise
			local upAt = Vector3.new(leg.side * own.up.x, own.up.y, own.up.z)
			local sweptAt = Vector3.new(leg.side * own.swept.x, own.swept.y, own.swept.z)
			local raised = bodyBase:PointToWorldSpace(upAt:Lerp(sweptAt, display.legsWave)*g)
			foot = foot:Lerp(raised, raise)
			local raisedKnee = hip:Lerp(raised, 0.5) + bodyBase.RightVector * (leg.side * own.kneeOut*g) + up * look.dance.kneeUp*g
			knee = knee:Lerp(raisedKnee, raise)
		end
		-- The antennal illusion: legs I go up above the head, both in phase (one wave value), and the planted foot below is untouched.
		local antCfg = look.antennae
		if antPose ~= nil and antCfg ~= nil and leg.pair == antCfg.pair and antPose.antennae > 0 then
			local highShift = Vector3.new(0, antCfg.high.y - antCfg.up.y, antCfg.high.z - antCfg.up.z) * antPose.high
			local upAt = Vector3.new(leg.side * antCfg.up.x, antCfg.up.y, antCfg.up.z)
				+ Vector3.new(leg.side * (antCfg.high.x - antCfg.up.x) * antPose.high, 0, 0) + highShift
			local sweptAt = Vector3.new(leg.side * antCfg.swept.x, antCfg.swept.y, antCfg.swept.z) + highShift
			local raised = bodyBase:PointToWorldSpace(upAt:Lerp(sweptAt, antPose.wave) * g)
			foot = foot:Lerp(raised, antPose.antennae)
			local raisedKnee = hip:Lerp(raised, 0.5) + bodyBase.RightVector * (leg.side * antCfg.kneeOut * g) + up * (antCfg.kneeUp * g)
			knee = knee:Lerp(raisedKnee, antPose.antennae)
		end
		-- The threat posture: legs I go up and out in front of the reared prosoma, trembling a little; the planted foot below is untouched.
		if threatening and tc ~= nil and leg.pair == tc.pair and threatPose.legs > 0 then
			local upAt = Vector3.new(leg.side * tc.up.x, tc.up.y + threatPose.tremor * tc.tremor, tc.up.z)
			local reach, hook = threatPose.reach or 0, threatPose.hook or 0
			if reach > 0 and tc.wide then upAt = upAt:Lerp(Vector3.new(leg.side * tc.wide.x, tc.wide.y + threatPose.tremor * tc.tremor, tc.wide.z), reach) end -- (ROBLOX-127: high and spread)
			if hook > 0 and tc.hook then upAt = upAt:Lerp(Vector3.new(leg.side * tc.hook.x, tc.hook.y, tc.hook.z), hook) end -- (forward and down, grappling)
			local raised = prosoma:PointToWorldSpace(upAt * g)
			foot = foot:Lerp(raised, threatPose.legs)
			local raisedKnee = hip:Lerp(raised, 0.5) + prosoma.RightVector * (leg.side * tc.kneeOut * g) + up * (tc.kneeUp * g)
			knee = knee:Lerp(raisedKnee, threatPose.legs)
		end
		local hangKnee, hangAnkle = leg.hangKnee, leg.hangAnkle
		if hangKnee ~= nil and hangAnkle ~= nil then knee = knee:Lerp(hangKnee, self._hang) end
		local ankle = knee:Lerp(foot, ANKLE_SHARE) + up * (L.ankleLift*g)
		if hangKnee ~= nil and hangAnkle ~= nil then ankle = ankle:Lerp(hangAnkle, self._hang) end
		local form = look.legForm
		local femurMid = if form and leg.femurTip then hip:Lerp(knee, form.femur.split) else knee
		local tibiaMid = if form and form.tibia and leg.tibiaTip then knee:Lerp(ankle, form.tibia.split) else ankle
		local tarsusMid = if form and leg.joint then ankle:Lerp(foot, form.tarsus.split) + up * (if leg.tarsusTip then form.tarsus.bend * g else 0) else foot
		drawSegment(leg.segs[1], bandFraction, g, hip, femurMid, knee, bodyBatch, hairBatch, exact)
		drawSegment(leg.segs[2], bandFraction, g, knee, tibiaMid, ankle, bodyBatch, hairBatch, exact)
		drawSegment(leg.segs[3], bandFraction, g, ankle, tarsusMid, foot, bodyBatch, hairBatch, exact)
		if form then
			-- The knee is a patella: a short stout ellipsoid lying along the bend of the leg there.
			local bend = (knee - hip).Unit + (ankle - knee).Unit
			local along = if bend.Magnitude > 1e-3 then bend.Unit else (knee - hip).Unit
			put(bodyBatch, leg.knee, rodCFrame(knee - along, knee + along))
		else
			put(bodyBatch, leg.knee, CFrame.new(knee))
		end
		put(bodyBatch, leg.ankle, CFrame.new(ankle))
		if leg.joint then put(bodyBatch, leg.joint, CFrame.new(tarsusMid)) end
		local pad = leg.pad
		if pad and form then
			-- The tarsal pad lies on the surface under the foot, flattened, its long side along the way the foot points; the first spider's claws leave
			-- its front. All of it is display: the planted foot is where it was.
			local into = foot - (if leg.joint then tarsusMid else ankle)
			local flat = into - up * into:Dot(up)
			local heading = if flat.Magnitude > 1e-4 then flat.Unit else body.LookVector
			local center = foot + up * (pad.Size.Y * 0.35)
			put(bodyBatch, pad, CFrame.lookAt(center, center + heading, up) * QUARTER)
			local right = heading:Cross(up)
			for n, claw in leg.toes do
				-- two claws: from the pad's front, forward and down, splayed apart
				local from = center + heading * (pad.Size.X * 0.42)
				local aim = (heading * 0.85 - up * 0.45 + right * ((if n % 2 == 1 then -1 else 1) * form.claws.splay)).Unit
				put(bodyBatch, claw, rodCFrame(from, from + aim * claw.Size.X))
			end
		elseif pad then
			put(bodyBatch, pad, CFrame.new(foot))
		end
	end
	self.placed = bodyBatch.n + hairBatch.n -- (ROBLOX-113: the parts this drawing placed, for the self-test's profile)
	Workspace:BulkMoveTo(bodyBatch.parts, bodyBatch.frames, Enum.BulkMoveMode.FireCFrameChanged)
	if hairBatch.n > 0 then
		Workspace:BulkMoveTo(hairBatch.parts, hairBatch.frames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Draws the rig for a frame (ROBLOX-93): an update when the rig has not been drawn yet or is within FAR_STUDS of the camera (`distance`, studs), otherwise once every
-- FAR_SECONDS with all the time since the last drawing. The sim goes on stepping every tick; a rival or a mate too far off to show its legs need not be redrawn sixty
-- times a second. (A caller that must have the full rate, a lunge or a windup, gives a distance of 0.) Returns whether it drew.
-- (Six frames of 1/60 add up to a hair under 0.1, so the interval is met a millionth of a second early: ten drawings a second at 60 Hz, not eight and a half.)
function SpiderRig.drawStep(self: Rig, collider: CFrame, dt: number, grounded: boolean, moving: boolean, distance: number): boolean
	local owed = self._owed + dt
	if self._drawn and distance > FAR_STUDS and owed < FAR_SECONDS - 1e-6 then
		self._owed = owed
		return false
	end
	self._owed, self._drawn = 0, true
	self:update(collider, owed, grounded, moving)
	return true
end

-- Spider-eye view (Godot SpiderBody.set_eye_view + SurfaceLegs.eye_view): the body, head and palps are hidden and only the
-- front legs' lower segments stay, reaching into the view. Client-only (LocalTransparencyModifier).
local function applyVisibility(self: Rig)
	local function show(p: BasePart, visible: boolean)
		p.LocalTransparencyModifier = if visible then 0 else 1
	end
	local hideBody = self._eyeView or self._bodyHidden
	if self._highlight then (self._highlight :: Highlight).Enabled = not hideBody end
	for _, f in self._fixed do
		show(f.part, not hideBody)
	end
	local fan = self._fan
	if fan then
		for _, part in fan.parts do show(part, not hideBody) end
	end
	for _, leg in self._legs do
		local frontReach = self._eyeView and leg.pair == 1
		local all = not hideBody
		show(leg.femur, all); show(leg.knee, all)
		if leg.femurTip then show(leg.femurTip, all) end
		show(leg.tibia, all or frontReach)
		if leg.tibiaTip then show(leg.tibiaTip, all or frontReach) end
		show(leg.tarsus, all or frontReach); show(leg.ankle, all or frontReach)
		if leg.tarsusTip then show(leg.tarsusTip, all or frontReach) end
		if leg.joint then show(leg.joint, all or frontReach) end
		for _, toe in leg.toes do show(toe, all or frontReach) end
		for n, band in leg.bands do show(band, all or (frontReach and n >= 2)) end
		if leg.pad then show(leg.pad :: Part, all or frontReach) end
		for _, hair in leg.hairs do
			show(hair.part, all or (frontReach and hair.spec.segment >= 2))
		end
	end
end

function SpiderRig.setEyeView(self: Rig, on: boolean)
	self._eyeView = on
	applyVisibility(self)
end

-- The orbit camera hides the spider when its boom is squeezed shorter than BODY_HIDE_LENGTH.
function SpiderRig.setBodyHidden(self: Rig, hidden: boolean)
	self._bodyHidden = hidden
	applyVisibility(self)
end

-- The drawn body's length in studs now, head to abdomen: 0.97 for the first spider at its first stage and 1.455 as an adult (0.455 and 0.68 for the peacock spider,
-- 0.485 and 0.73 for the ant mimic), times the growth stage. Inspect mode (ROBLOX-90) measures its distances in these.
SpiderRig.BODY_STUDS = 0.97
function SpiderRig.bodyLength(self: Rig): number
 return SpiderRig.BODY_STUDS * self._k
end


-- Where the dragline leaves the body.
function SpiderRig.spinneretPoint(self: Rig, body: CFrame): Vector3
	return self._spinneret or body:PointToWorldSpace(self._layout.spinneret*self._growth - Vector3.new(0, self._drop, 0))
end

function SpiderRig.destroy(self: Rig)
	self.model:Destroy()
end

function SpiderRig.mouthFrame(self: any): CFrame
 return self._mouth or self.root.CFrame
end

return SpiderRig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">TarantulaPose</string>
            <string name="Source"><![CDATA[--!strict
-- The tarantulas' threat display and silk mat as a pose (ROBLOX-82): pure and Vector3-free, display only. Nothing here moves the body, the
-- collider, the senses, the jump or the silk; SpiderRig reads the pose, rears the drawn prosoma, lifts legs I and the pedipalps, turns the drawn
-- body and swings the spinnerets. All numbers are in Data/Tarantula (all artistic: no paper measures this).
--
-- A loop of phases (rear up, hold the threat posture, settle, turn about while the spinnerets sweep, hold, turn back) played from the time
-- it is given: step(dt, standing, moving) adds the dt it is handed, so slow motion slows the pose as it slows everything else. Walking,
-- a jump, leaving the surface or stop() end it at once; the pose then eases out over Tarantula.fadeOutSeconds from where it was, which is
-- how the legs go back to the motor. The same shape as PeacockDance.

local Tarantula = require(script.Parent.Parent.Data.Tarantula)

local TarantulaPose = {}
TarantulaPose.__index = TarantulaPose

-- Angles in radians. rear and palps are positive for up (the prosoma's front, the palps' tips); yaw is the body's turn about its up axis;
-- sweep is signed (the spinnerets' swing); legs and presence run 0..1; tremor is -1..1 (times the profile's size).
export type Pose = {
	phase: string, -- the phase of the loop, "none" when no pose shows
	presence: number, -- 0..1: how much of the pose shows (ramps in and out)
	rear: number,
	legs: number, -- legs I raised into the threat posture
	palps: number,
	yaw: number,
	sweep: number,
	tremor: number,
}

local TAU = math.pi * 2

local function smooth(x: number): number
	local c = math.clamp(x, 0, 1)
	return c * c * (3 - 2 * c)
end

TarantulaPose.NONE = { phase = "none", presence = 0, rear = 0, legs = 0, palps = 0, yaw = 0, sweep = 0, tremor = 0 } :: Pose

-- Which phase a loop time falls in: its index, the seconds into it and the loop time it starts at.
function TarantulaPose.phaseAt(t: number): (number, number, number)
	local phases = Tarantula.phases
	local u = t % Tarantula.loopSeconds
	local start = 0
	for i, p in phases do
		if u < start + p.seconds then return i, u - start, start end
		start += p.seconds
	end
	return #phases, phases[#phases].seconds, start - phases[#phases].seconds
end

-- The seconds each phase starts at, in order (so the levels below read by phase).
local function starts(): { [string]: number }
	local out: { [string]: number } = {}
	local at = 0
	for _, p in Tarantula.phases do
		out[p.id] = at
		at += p.seconds
	end
	return out
end
local START = starts()
local function seconds(id: string): number
	for _, p in Tarantula.phases do
		if p.id == id then return p.seconds end
	end
	return 0
end

-- The levels (0..1) at a loop time: `rise` (the prosoma, legs I and the palps up), `turn` (the body's pivot) and `swing` (the spinnerets' stroke).
local function levelsAt(u: number): (number, number, number)
	local rear, settle, turn, back = seconds("rear"), seconds("settle"), seconds("turn"), seconds("return")
	local rise = 0
	if u < START.threat then
		rise = smooth(u / rear)
	elseif u < START.settle then
		rise = 1
	elseif u < START.turn then
		rise = 1 - smooth((u - START.settle) / settle)
	end
	local pivot = 0
	if u >= START.turn and u < START.mat then
		pivot = smooth((u - START.turn) / turn)
	elseif u >= START.mat and u < START["return"] then
		pivot = 1
	elseif u >= START["return"] then
		pivot = 1 - smooth((u - START["return"]) / back)
	end
	local swing = 0
	if u >= START.turn then
		local ease = Tarantula.sweepEaseSeconds
		swing = math.min(smooth((u - START.turn) / ease), smooth((Tarantula.loopSeconds - u) / ease))
	end
	return rise, pivot, swing
end

-- The whole pose at a loop time, before presence. reduced: ReducedMotion (every angle halved, no tremble).
function TarantulaPose.rawPose(t: number, reduced: boolean): Pose
	local i, _, _ = TarantulaPose.phaseAt(t)
	local u = t % Tarantula.loopSeconds
	local rise, pivot, swing = levelsAt(u)
	local amp = if reduced then Tarantula.reducedMotion else 1
	local holding = u >= START.threat and u < START.settle
	local strokeT = u - START.turn
	return {
		phase = Tarantula.phases[i].id, presence = 1,
		rear = rise * math.rad(Tarantula.rearDeg) * amp,
		legs = rise,
		palps = rise * math.rad(Tarantula.palpDeg) * amp,
		yaw = pivot * math.rad(Tarantula.pivotDeg) * amp,
		sweep = swing * math.rad(Tarantula.sweepDeg) * amp * math.sin(TAU * Tarantula.sweepHz * strokeT),
		tremor = if reduced or not holding then 0 else math.sin(TAU * Tarantula.tremorHz * t) * smooth((u - START.threat) / 0.3) * smooth((START.settle - u) / 0.3),
	}
end

local function scaled(p: Pose, k: number): Pose
	return {
		phase = p.phase, presence = k, rear = p.rear * k, legs = p.legs * k, palps = p.palps * k, yaw = p.yaw * k, sweep = p.sweep * k, tremor = p.tremor * k,
	}
end

export type State = typeof(setmetatable(
	{} :: { t: number, active: boolean, presence: number, raw: Pose?, reduced: boolean },
	TarantulaPose
))

function TarantulaPose.new(): State
	return setmetatable({ t = 0, active = false, presence = 0, raw = nil :: Pose?, reduced = false }, TarantulaPose)
end

-- The display key: begin the loop from its start. Refused (false) when the spider is not standing still on a surface, or it is already on.
function TarantulaPose.start(self: State, standing: boolean, moving: boolean): boolean
	if self.active or not standing or moving then return false end
	self.t, self.active = 0, true
	return true
end

-- End the pose at once; it eases out over Tarantula.fadeOutSeconds from where it was.
function TarantulaPose.stop(self: State)
	self.active = false
end

-- The pose is on (it has not been ended).
function TarantulaPose.displaying(self: State): boolean
	return self.active
end

-- Showing at all (on, or still easing out).
function TarantulaPose.showing(self: State): boolean
	return self.active or self.presence > 0
end

-- One step of dt seconds (the simulation's, so slow motion slows the pose). standing: on a surface and not in a jump, on the line or resting;
-- moving: walking (or asked to).
function TarantulaPose.step(self: State, dt: number, standing: boolean, moving: boolean): Pose
	if self.active and (not standing or moving) then self.active = false end
	if self.active then
		self.t += dt
		self.presence = math.min(1, self.presence + dt / Tarantula.rampInSeconds)
		self.raw = TarantulaPose.rawPose(self.t, self.reduced)
	else
		self.presence = math.max(0, self.presence - dt / Tarantula.fadeOutSeconds)
		if self.presence == 0 then self.raw = nil end
	end
	local raw = self.raw
	if raw == nil then return TarantulaPose.NONE end
	return scaled(raw, smooth(self.presence))
end

return TarantulaPose
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="139">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">AntMimicText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of the ant-mimicking spider's display key for the screen (ROBLOX-64): the prompt, the status line, the touch button and the
-- controls card's line. The walking hint, the status line and the card carry them only for that spider. Button names come from
-- ControlText for the device in use, except on touch, where the button says "Wave" (ControlText's "Dance" is the peacock's). Pure:
-- checked in tests/antmimic.luau.
local ControlText = require(script.Parent.ControlText)

local AntMimicText = {}

AntMimicText.STAND = "Stand still on a surface to wave your antennae"

local function key(device: ControlText.Device): string
	return if device == "touch" then "Wave" else ControlText.name(device, "display")
end

-- The walking hint's extra words.
function AntMimicText.displayHint(device: ControlText.Device, showing: boolean): string
	if showing then return `{key(device)}: antennae down` end
	return `{key(device)}: wave antennae`
end

-- The status line while the display pose is on.
function AntMimicText.statusLine(device: ControlText.Device): string
	return `ANTENNAE UP    {key(device)} or move: stop`
end

-- The touch button's words.
function AntMimicText.touchDisplay(showing: boolean): string return if showing then "Stop" else "Wave" end

-- The controls card's line (legs I rise by themselves when the spider keeps still; the key makes them higher and faster).
function AntMimicText.helpLine(device: ControlText.Device): string
	return `{key(device)}{if device == "touch" then " button:" else ""} wave antennae higher (any move, jump or Cancel stops it)`
end

return AntMimicText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">BirdText</string>
            <string name="Source"><![CDATA[--!strict
-- The robin in words (ROBLOX-120; the robin is Predator/Bird): its death card, the notice when its bill misses (the gentle rules), and the captions of what tells of it
-- first (the Captions setting, as the cat's bell is captioned): its call as it comes in and goes, and its shadow sweeping over the ground. Pure: tests/preserve.luau
-- checks the words, tests/quiet.luau their classes.
local BirdText = {}

BirdText.LINE = "The robin's bill came down."
BirdText.SUB = "It stood still with its head cocked, watching what moved in the open. Under cover, or keeping still, the spider would have lived."
BirdText.MISSED = "The robin stabbed at you and missed."
BirdText.CAUSE = "bird" -- (the end of a life's cause, LifeSession)
BirdText.SHADOW = "[a shadow sweeps over the ground]"

-- The caption of what is heard or seen of it now, or nil: its call (`call` 0..1, Predator/Bird.call; `direction` UI/WaspText.directionWord's) or its shadow passing
-- (`shadow`: the seconds since one passed near, nil if none lately).
function BirdText.caption(call: number, direction: string, shadow: number?): { text: string, alpha: number }?
	if shadow ~= nil and shadow < 2.0 then return { text = BirdText.SHADOW, alpha = 1 } end
	if call > 0.05 then
		return { text = `[a robin calls, {direction}: pick, tut-tut-tut]`, alpha = math.clamp(0.4 + call, 0, 1) }
	end
	return nil
end

return table.freeze(BirdText)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="142">
          <Properties>
            <string name="Name">CatText</string>
            <string name="Source"><![CDATA[--!strict
-- The ranger's cat in words (ROBLOX-118; the cat is Predator/Cat): its death card, the notice when its pat only knocks the spider aside (the gentle rules), and the
-- captions of what the spider hears of it (the Captions setting, as the wasp's hum is captioned): the bell on its collar while it moves, its purr close by. A
-- jumping spider hears airborne sound (the notebook's cat page says how it is known), so the bell is the first anyone knows of it. Pure: tests/preserve.luau
-- checks the words, tests/quiet.luau their classes.
local CatText = {}

CatText.LINE = "The cat's paw came down."
CatText.SUB = "A cat pats at small things that move. Up out of its reach, in a gap, or keeping still, the spider would have lived."
CatText.NUDGED = "The cat's paw knocked you aside. It has lost interest, for now."
CatText.CAUSE = "cat" -- (the end of a life's cause, LifeSession)

-- The caption of what is heard now (`bell` and `purr`, 0..1, Predator/Cat.sound; `direction` UI/WaspText.directionWord's), or nil. The bell wins: it is the warning.
function CatText.caption(bell: number, purr: number, direction: string, nearer: boolean): { text: string, alpha: number }?
	if bell > 0.05 then
		return { text = `[a small bell, {direction}{if nearer then ", coming closer" else ""}]`, alpha = math.clamp(0.4 + bell, 0, 1) }
	end
	if purr > 0.05 then
		return { text = `[a low purr, {direction}]`, alpha = math.clamp(0.4 + purr, 0, 1) }
	end
	return nil
end

return table.freeze(CatText)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="143">
          <Properties>
            <string name="Name">ContextPrompts</string>
            <string name="Source"><![CDATA[--!strict
-- Only the player-requested meal and dusk prompts enter the minimal play HUD.
local ControlText=require(script.Parent.ControlText)
local LifeClock=require(script.Parent.Parent.Life.LifeClock)
local LifeText=require(script.Parent.LifeText)
local P={};P.__index=P
function P.new(): any return setmetatable({night=nil,dismissed=false,away=0,key="",view=nil},P) end
function P.reset(self: any) self.night=nil;self.dismissed=false;self.away=0;self.key="";self.view=nil end
function P.step(self: any,dt: number,s: any): any
 local night=if s.hour>=LifeClock.DUSK_H then s.day elseif s.hour<LifeClock.WAKE_H then s.day-1 else nil
 if night~=self.night then self.night=night;self.dismissed=false;self.away=0 end
 if night~=nil and s.resting then self.dismissed=true end
 local text: string?=nil
 if s.enabled and not s.blocked then
  local key=ControlText.name(s.device,"feed")
  if s.held then
   if not s.canEat then text="Land and keep still to eat."
   elseif s.struggling and not s.auto then text=`Tap {if s.device=="touch" then "Grip" else key}: hold your prey`
   elseif s.struggling then text="Holding your prey"
   elseif s.auto then text="Eating - move to pause"
   else text=if s.device=="touch" then "Tap Eat" else `Tap {key}: eat` end
  elseif night~=nil and not self.dismissed then
   if s.weak then text="Too hungry to sleep; find food."
   elseif s.canRest then text=`{if s.device=="touch" then "Rest" else key}: rest`
   elseif self.away<8 then
    local home=LifeText.HOMES[s.home or "sill_crevice"] or LifeText.HOMES.sill_crevice
    text="It is dark. Rest "..(if string.sub(home.name,1,6)=="under " then home.name else "in "..home.name).."."
    self.away+=dt
   end
  end
 end
 local cache=text or ""
 if cache~=self.key then self.key=cache;self.view=if text then {hint=text} else nil end
 return self.view
end
return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="144">
          <Properties>
            <string name="Name">ControlText</string>
            <string name="Source"><![CDATA[--!strict
-- Words on the screen, written for the device the player is using now: keyboard and mouse, a controller, or touch.
-- The texts are the frozen Godot game's (scripts/presentation/jump_feedback.gd, key_names.gd and jump_hud.gd at c87ce00);
-- where Godot wrote both keys ("Q / B"), each device here names only its own key or button. Pure: tests/run.luau checks
-- every prompt without Roblox.
local ControlText = {}

export type Device = "keyboard" | "gamepad" | "touch"

ControlText.TITLES = {
	reachable = "Reachable",
	obstructed = "Blocked",
	unreachable = "Out of reach",
	ineligible = "Can't land there",
	none = "No surface in view",
}
ControlText.REASONS = {
	ok = "",
	no_target = "no surface in view",
	ineligible_surface = "the spider cannot hold on there",
	too_far = "too far or too high",
	no_launch = "no way to leave this surface toward there",
	no_arrival = "it can't land from that angle",
	no_durations = "out of range",
	no_room = "no room to land",
	path_blocked = "something is in the way",
	graze = "it would only graze the surface",
	hop_blocked = "something is in the way",
	no_ground = "nothing to land on ahead",
}
ControlText.ANCHOR_TEXT = {
	ok = "Safety line: anchored here",
	no_silk = "No safety line: this surface won't hold silk",
	too_long = "No safety line: this jump needs more line than you have",
	no_support = "",
}
ControlText.LINE_TITLE = "On your line"
ControlText.LINE_TITLE_REELING = "On your line: reeling in"
ControlText.LINE_BLOCKED = {
	blocked = "Can't reel in: something is in the way. Lower, or let go",
	shortest = "Reeled in as far as it goes",
	snagged = "The line is caught on a second edge and can't be reeled in. Lower, or let go",
}
ControlText.DROP_REFUSED = {
	no_edge = "Nothing below to let yourself down into from here",
	no_silk = "This surface won't hold your silk",
	no_support = "",
	stuck = "Couldn't get to the edge",
}
ControlText.DROP_WALK = "To the edge, to let yourself down"

-- What each device calls the controls. (L1 / LB locks, R2 / RT focuses, L2 / LT runs; the right-stick click recentres.) Godot's input_setup.gd bindings; the port keeps the D-pad for walking, so lowering on
-- silk is X on a controller (ROBLOX-05). Touch names are the on-screen buttons.
local NAMES: { [string]: { [string]: string } } = {
	keyboard = {
		feed = "E", jump = "Space", cancel = "Q", letGo = "Q", drop = "F", reel = "W", lower = "S", walk = "WASD", look = "Mouse",
		creep = "Ctrl", run = "Shift", focus = "Right mouse", eye = "V", recenter = "R", lock = "R", slow = "T", reset = "Backspace", help = "H", zoom = "Wheel",
		choose = "C", display = "X", menu = "M", notebook = "N", settings = "O",
	},
	gamepad = {
		feed = "Left-stick click", jump = "A", cancel = "B", letGo = "B", drop = "X", reel = "Stick up", lower = "Stick down", walk = "Left stick",
		look = "Right stick", creep = "LB", run = "LT", focus = "RT", eye = "Y", recenter = "Right-stick click", lock = "LB", slow = "", reset = "View",
		help = "", zoom = "", choose = "RB", display = "RB", menu = "View", notebook = "View",
	},
	touch = {
		feed = "Eat", jump = "Jump", cancel = "Cancel", letGo = "Let go", drop = "Silk", reel = "↑", lower = "↓", walk = "Arrows",
		look = "Drag", creep = "Creep", run = "Run", focus = "Focus", eye = "Eye", recenter = "Recentre", lock = "Lock", slow = "", reset = "", help = "", zoom = "", choose = "Change", display = "Dance", menu = "Menu", notebook = "Notebook",
	},
}

-- A PlayStation controller has the same buttons under other names (Roblox reports "ButtonCross" for ButtonA there). The client
-- calls setPadStyle from UserInputService:GetStringForKeyCode(ButtonA) at start and after each controller input; names not listed
-- here (sticks) are the same on both.
local PLAYSTATION: { [string]: string } = {
	feed = "L3", jump = "Cross", cancel = "Circle", letGo = "Circle", drop = "Square", creep = "L1", run = "L2", focus = "R2", eye = "Triangle",
	recenter = "R3", lock = "L1", slow = "", reset = "Touchpad", choose = "R1", display = "R1", menu = "Touchpad", notebook = "Touchpad",
}
local padStyle = "xbox"

-- "xbox" or "playstation", from what Roblox calls ButtonA on this controller.
function ControlText.padStyleFor(buttonAString: string?): string
	return if buttonAString == "ButtonCross" then "playstation" else "xbox"
end

function ControlText.setPadStyle(style: string)
	padStyle = if style == "playstation" then "playstation" else "xbox"
end

function ControlText.padStyle(): string
	return padStyle
end

function ControlText.name(device: Device, action: string): string
	if device == "gamepad" and padStyle == "playstation" and PLAYSTATION[action] then
		return PLAYSTATION[action]
	end
	return (NAMES[device] or NAMES.keyboard)[action] or ""
end

-- The device whose names to show after an input of this UserInputType (its Enum name). Anything else keeps the previous one.
function ControlText.deviceFor(inputType: string, previous: Device): Device
	if inputType == "Touch" then return "touch" end
	if string.sub(inputType, 1, 7) == "Gamepad" then return "gamepad" end
	if inputType == "Keyboard" or inputType == "TextInput" or string.sub(inputType, 1, 5) == "Mouse" then return "keyboard" end
	return previous
end

-- Before any input: a touch-only device shows touch, a controller without a keyboard (a console) shows the controller.
function ControlText.initialDevice(touch: boolean, keyboard: boolean, gamepad: boolean): Device
	if touch and not keyboard then return "touch" end
	if gamepad and not keyboard then return "gamepad" end
	return "keyboard"
end

function ControlText.reason(plan: any): string
	if plan == nil then return "" end
	return ControlText.REASONS[plan.reason] or tostring(plan.reason or "")
end

-- The two lines at the reticle while aiming (JumpFeedback.describe, hold mode) and Godot's cancel hint beside the second.
function ControlText.describe(plan: any, device: Device): (string, string)
	local cancel = (if device == "gamepad" then "Left stick: aim    " else "") .. ControlText.name(device, "cancel") .. ": cancel the jump"
	if plan == nil then
		return ControlText.TITLES.none, "release to cancel    " .. cancel
	end
	local kind = plan.kind
	local valid = kind == "reachable"
	local title = ControlText.TITLES[kind] or kind
	if not valid and kind ~= "none" then
		local why = ControlText.reason(plan)
		if why ~= "" then title = title .. ": " .. why end
	end
	return title, (if valid then "release to leap" else "release to cancel") .. "    " .. cancel
end

function ControlText.anchorText(reason: string): string
	return ControlText.ANCHOR_TEXT[reason] or ""
end

-- The toast for a jump outcome (JumpFeedback.toast): "" for outcomes that need none.
function ControlText.toast(kind: string, plan: any): string
	local why = ControlText.reason(plan)
	if kind == "refused" then
		return "Jump cancelled: " .. (if why ~= "" then why else "nothing to land on")
	elseif kind == "hop_refused" then
		return "No hop: " .. (if why ~= "" then why else "nowhere to land")
	elseif kind == "cancelled" then
		return "Jump cancelled"
	elseif kind == "out_of_bounds" then
		return "Out of bounds: back to the last safe spot"
	end
	return ""
end

-- The toast for a line event (JumpFeedback.line_toast). afterMiss: the line had been locked by a miss; dropped: the spider
-- let itself down on this line (the line taking its weight is no surprise then).
function ControlText.lineToast(kind: string, detail: string, afterMiss: boolean, dropped: boolean, device: Device): string
	if kind == "caught" then
		return if dropped then "" else "Caught by your line"
	elseif kind == "drop_walk" then
		return ControlText.DROP_WALK
	elseif kind == "dropped" then
		return `Letting yourself down: hold {ControlText.name(device, "drop")} to lower, {ControlText.name(device, "reel")} to climb`
	elseif kind == "drop_refused" then
		return ControlText.DROP_REFUSED[detail] or ""
	elseif kind == "completed" then
		return if afterMiss then "Holding on again. The line stays behind for a moment" else ""
	elseif kind == "released" then
		return "You let go of the line"
	elseif kind == "lost" then
		return "Your line came loose: its anchor is gone"
	elseif kind == "blocked" then
		return ControlText.LINE_BLOCKED[detail] or ""
	elseif kind == "snagged" then
		return ControlText.LINE_BLOCKED.snagged
	end
	return ""
end

-- The panel at the bottom while on the line: its title, the line's own prompts (distinct from cancelling an aim) and a cue.
-- ctx: reeling, progress (0..1 of a deliberate let-go hold), snagged, block ("", "blocked", "shortest").
function ControlText.linePanel(ctx: any, device: Device): (string, string, string)
	local title = if ctx.reeling then ControlText.LINE_TITLE_REELING else ControlText.LINE_TITLE
	local hint = `{ControlText.name(device, "reel")}: reel in    {ControlText.name(device, "lower")}: lower    hold {ControlText.name(device, "letGo")}: let go`
	local cue = ""
	if (ctx.progress or 0) > 0 then
		cue = `Letting go... {math.floor(ctx.progress * 100 + 0.5)}%`
	elseif ctx.snagged then
		cue = ControlText.LINE_BLOCKED.snagged
	elseif ctx.block and ctx.block ~= "" then
		cue = ControlText.LINE_BLOCKED[ctx.block] or ""
	end
	return title, hint, cue
end

-- Walking (port-only reminder, shown small): how to jump and how to let down on silk.
function ControlText.walkHint(device: Device): string
	local j = ControlText.name(device, "jump")
	return `Tap {j}: hop    hold {j}: aim a leap    {ControlText.name(device, "drop")}: let yourself down on silk`
end

-- Walking to an edge to let down: what stops it.
function ControlText.edgeWalkHint(device: Device): string
	return `{ControlText.DROP_WALK}    {ControlText.name(device, "cancel")} or move: stop`
end

-- Focus can be held or latched with the existing accessibility option.
function ControlText.focusAgain(device: Device): string
	return `{ControlText.name(device, "focus")} again to stop`
end

-- The touch Lock button's words (ROBLOX-110): Lock, or Unlock while a lock holds.
ControlText.LOCK_LABEL, ControlText.UNLOCK_LABEL = "Lock", "Unlock"
function ControlText.touchLockLabel(locked: boolean): string
	return if locked then ControlText.UNLOCK_LABEL else ControlText.LOCK_LABEL
end

-- The touch Cancel button's words: on the line it is the let-go button (held), elsewhere it cancels.
function ControlText.touchCancelLabel(onLine: boolean): string
	return if onLine then "Let go\n(hold)" else "Cancel"
end

-- The controls card (H): the device's own bindings, one group of actions to a line. The whole card the player reads is PeacockText.card (this, then the crack's line,
-- the pointer to the Settings row and the display key's line), and it is at most ten lines at the width the HUD gives it (tests/peacock.luau, the Studio PromptSpec);
-- each line here is at most 61 characters (the card's width at its text size) so that, on a keyboard or a controller, none wraps. The touch card has the room to wrap.
function ControlText.runUnlocked(device: Device): string
	return `You can now run. Hold {ControlText.name(device, "run")} while moving.`
end

function ControlText.lockUnlocked(device: Device): string
	return `You can now lock on. Press {ControlText.name(device, "lock")} near visible prey, then move to circle it.`
end

function ControlText.helpCard(device: Device, runAvailable: boolean?, lockAvailable: boolean?): string
	if device == "gamepad" then
		local function n(action: string): string return ControlText.name("gamepad", action) end
		-- L1 locks, R2 focuses, and L2 runs; the right-stick click recentres.
		return table.concat({
			"Left stick: walk/creep   Right stick look, click: recentre",
			`Tap {n("jump")} hop   Hold {n("jump")} aim, release to leap`,
			`{n("drop")} lower on silk   {n("cancel")} cancel   {n("eye")} eye view`,
			`On the line: up reel, down lower, hold {n("letGo")} let go`,
			(if lockAvailable == false then `{n("creep")} creep   {n("focus")} focus` else `{n("lock")} creep/lock (circle)   {n("focus")} focus`) .. (if runAvailable == false then "" else `   {n("run")} run`),
			`In the crack: {n("feed")} rest (sleep from evening)`,
			`{n("menu")}: menu, then last rest, notebook, settings`,
		}, "\n")
	elseif device == "touch" then
		return table.concat({
			if runAvailable == false then "Arrows walk   Drag to look   Hold Creep" else "Arrows walk   Drag to look   Hold Run or Creep",
			"Tap Jump hop   Hold Jump aim, release to leap   Cancel",
			"Silk: lower on a line   On it: ↑ reel, ↓ lower, hold Let go",
			if lockAvailable == false then "Recentre   Focus   Eye" else "Lock (← → circle)   Recentre   Focus   Eye",
			"In the crack: Rest (Sleep from evening)",
			"Menu: last rest, notebook, settings, this card",
		}, "\n")
	end
	return table.concat({
		if runAvailable == false then "WASD walk   Mouse look   Ctrl creep   G gait" else "WASD walk   Mouse look   Shift run   Ctrl creep   G gait",
		"Tap Space hop   Hold Space aim, release to leap   Q cancel",
		"F lower on silk   On the line: W reel, S lower, hold Q let go",
		"V eye view   Right mouse focus   T slow motion   H: hide this",
		if lockAvailable == false then "R recentre" else "R lock on or recentre   Locked: A/D circle, W/S close in",
		"In the crack: E rest (sleep from evening)",
		"Backspace: last rest   M: menu   N: notebook   O: settings",
	}, "\n")
end

return ControlText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="145">
          <Properties>
            <string name="Name">CrabText</string>
            <string name="Source"><![CDATA[--!strict
-- The crab spider in words (ROBLOX-119; the crab spider is Predator/CrabSpider): its death card and the notice when its lunge only knocks the spider off the flower (the
-- gentle rules). Pure: tests/preserve.luau checks the words, tests/quiet.luau their classes.
local CrabText = {}

CrabText.LINE = "The crab spider's legs closed."
CrabText.SUB = "It sat still on the flower in the flower's colour, its front legs held open. A careful look before landing would have shown it."
CrabText.NUDGED = "A crab spider lunged from the flower. You dropped clear."
CrabText.CAUSE = "crab_spider" -- (the end of a life's cause, LifeSession; Predator/CrabSpider.CAUSE)

return table.freeze(CrabText)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="146">
          <Properties>
            <string name="Name">EyeOptics</string>
            <string name="Source"><![CDATA[--!strict
-- EyeOptics: the pure half of the spider-eye picture (ROBLOX-20). From k (how much the principal eyes are in use, 0 to 1) and the
-- time it works out the field of view, the colour grade, the blur and the depth of field, where the two retina strips are and how
-- they swing, how big a movement ring is and where an edge arc goes, the vignette's strength, the caption's fade and the UV layer's
-- transparency. Client/SpiderEyes draws what this says; nothing here touches the engine, so tests/eyes.luau checks every rule. The
-- numbers, and what they rest on, are in Shared/Data/Eyes. Angles are degrees, sizes pixels, times seconds. Screen y runs down.
local Eyes = require(script.Parent.Parent.Data.Eyes)

local EyeOptics = {}

-- What the picture looks like at one k (see EyeOptics.profile).
export type Profile = {
	k: number,
	fovDeg: number, -- vertical
	saturation: number,
	tint: Color3,
	contrast: number,
	brightness: number,
	blur: number, -- BlurEffect.Size
	dofFar: number,
	dofNear: number,
	dofRadius: number, -- InFocusRadius, studs
	strokeTransparency: number, -- of the retina strips
	fillTransparency: number,
	sweepDeg: number, -- how far each strip swings side to side
	torsionDeg: number, -- and how far it turns about its middle
	vignette: number, -- opacity at the screen's edge
}
-- A retina strip as a rounded box on the screen: its middle, its size and its turn (clockwise, as GuiObject.Rotation).
export type Strip = { x: number, y: number, w: number, h: number, rotation: number }
-- A thing the lateral eyes saw moving (a Sensor.motionSeen entry with the id it is filed under).
export type Moving = { direction: Vector3, distance: number, apparent: number, tick: number }
export type Mover = { id: string, direction: Vector3, distance: number, apparent: number, tick: number }
-- One short bar of an edge arc.
export type Segment = { x: number, y: number, rotation: number }

-- a(1 - t) + bt, not a + (b - a)t: exactly a at 0 and exactly b at 1 (the looks at k = 0 and k = 1 are the spec's numbers to the digit).
local function lerp(a: number, b: number, t: number): number
	return a * (1 - t) + b * t
end

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

-- Smoothstep.
function EyeOptics.smooth(x: number): number
	local t = clamp01(x)
	return t * t * (3 - 2 * t)
end

-- ---------------------------------------------------------------- how much the principal eyes are in use
-- One step of the engagement clock. `phase` runs 0 to 1 in Eyes.timing.engageSeconds while the principal eyes are wanted (Focus
-- held, or toggled on) and back in releaseSeconds otherwise. It is linear in time, so every frame rate gives the same phase after
-- the same time; a change of mind part-way simply turns it round.
function EyeOptics.stepPhase(phase: number, wanted: boolean, dt: number): number
	local T = Eyes.timing
	local step = math.max(dt, 0)
	return clamp01(phase + (if wanted then step / T.engageSeconds else -step / T.releaseSeconds))
end

-- k: the phase, eased, so the picture starts and settles gently.
function EyeOptics.engagement(phase: number): number
	return EyeOptics.smooth(phase)
end

-- ---------------------------------------------------------------- the field of view and the look
-- The principal eyes' vertical field: 24 degrees, or no narrower than 45 with reduced motion.
function EyeOptics.principalFovDeg(reduced: boolean): number
	if reduced then
		return math.max(Eyes.principal.fovDeg, Eyes.reducedMotion.minFovDeg)
	end
	return Eyes.principal.fovDeg
end

-- The vertical field at k, blended in tangent space (the half-angle's tangent is the screen's half-height at unit distance), so
-- the zoom looks even instead of rushing at the end. Exactly the side eyes' at 0 and the principal eyes' at 1.
function EyeOptics.fovDeg(k: number, reduced: boolean): number
	local far, near = Eyes.side.fovDeg, EyeOptics.principalFovDeg(reduced)
	if k <= 0 then
		return far
	elseif k >= 1 then
		return near
	end
	return math.deg(2 * math.atan(lerp(math.tan(math.rad(far) / 2), math.tan(math.rad(near) / 2), k)))
end

-- How much of the player's look a turn of the view gets at this field of view, so the picture moves as fast across the screen
-- whatever the zoom: tan(fov / 2) against the side eyes' tan(90 / 2) = 1.
function EyeOptics.lookScale(fovDeg: number): number
	return math.tan(math.rad(fovDeg) / 2) / math.tan(math.rad(Eyes.side.fovDeg) / 2)
end

local function mix3(a: { number }, b: { number }, k: number): Color3
	return Color3.new(lerp(a[1], b[1], k) / 255, lerp(a[2], b[2], k) / 255, lerp(a[3], b[3], k) / 255)
end

-- Everything that depends on k, blended: every number is the side eyes' at 0 and the principal eyes' at 1, the field of view in
-- tangent space. focusDistance (studs, what is looked at) sets how deep the sharp zone of the depth of field is.
function EyeOptics.profile(k: number, focusDistance: number, reduced: boolean): Profile
	local t = clamp01(k)
	local s, p = Eyes.side, Eyes.principal
	local distance = math.max(focusDistance, 0)
	local sideRadius = math.max(s.dofRadiusMin, s.dofRadiusPerStud * distance)
	local principalRadius = math.max(p.dofRadiusMin, p.dofRadiusPerStud * distance)
	return {
		k = t,
		fovDeg = EyeOptics.fovDeg(t, reduced),
		saturation = lerp(s.saturation, p.saturation, t),
		tint = mix3(s.tint, p.tint, t),
		contrast = lerp(s.contrast, p.contrast, t),
		brightness = lerp(s.brightness, p.brightness, t),
		blur = lerp(s.blur, p.blur, t),
		dofFar = lerp(s.dofFar, p.dofFar, t),
		dofNear = lerp(s.dofNear, p.dofNear, t),
		dofRadius = lerp(sideRadius, principalRadius, t),
		strokeTransparency = lerp(s.strokeTransparency, p.strokeTransparency, t),
		fillTransparency = lerp(s.fillTransparency, p.fillTransparency, t),
		sweepDeg = if reduced then 0 else lerp(s.sweepDeg, p.sweepDeg, t),
		torsionDeg = if reduced then 0 else lerp(s.torsionDeg, p.torsionDeg, t),
		vignette = lerp(s.vignette, p.vignette, t),
	}
end

-- ---------------------------------------------------------------- where the eyes are focused
-- The distance to focus on: how far the looked-along ray ran before it hit the world (nil when it hit nothing), at most the
-- limit.
function EyeOptics.focusTarget(hitDistance: number?): number
	local limit = Eyes.focus.maxDistance
	if hitDistance == nil then
		return limit
	end
	return math.min(hitDistance, limit)
end

-- One step of the focus racking from one distance to the next: an exponential approach with Eyes.focus.tauSeconds as its time
-- constant. Any frame rate gives the same distance after the same time.
function EyeOptics.focusStep(current: number, target: number, dt: number): number
	return current + (target - current) * (1 - math.exp(-math.max(dt, 0) / Eyes.focus.tauSeconds))
end

-- ---------------------------------------------------------------- sizes on the screen
-- Pixels for one unit of tangent at this vertical field of view: the screen's half-height over tan(fov / 2).
function EyeOptics.pixelsPerTan(fovDeg: number, viewportH: number): number
	return viewportH * 0.5 / math.tan(math.rad(fovDeg) * 0.5)
end

-- How long, in pixels, something that spans `angleDeg` about the middle of the view looks: tangent-correct, so a 20 degree strip
-- at a 24 degree field is tan(10) / tan(12) of the screen's height. Square pixels, so it serves for width and height alike.
function EyeOptics.extentPx(angleDeg: number, fovDeg: number, viewportH: number): number
	return 2 * math.tan(math.rad(math.min(angleDeg, 170)) * 0.5) * EyeOptics.pixelsPerTan(fovDeg, viewportH)
end

-- How far from the middle of the screen, in pixels, a direction `angleDeg` off the view's axis lands.
function EyeOptics.offsetPx(angleDeg: number, fovDeg: number, viewportH: number): number
	return math.tan(math.rad(angleDeg)) * EyeOptics.pixelsPerTan(fovDeg, viewportH)
end

-- ---------------------------------------------------------------- the retinae
-- Strip `index` (1 the left one, 2 the right) at time t: how far it has swayed from its place and turned from its tilt, in
-- degrees. The second strip runs lagSeconds behind the first in both (the retinae do not move as one). The amplitudes come from
-- the profile (large with the side eyes, small tracking with the principal eyes, none with reduced motion).
function EyeOptics.scanPose(index: number, t: number, sweepDeg: number, torsionDeg: number): (number, number)
	local R = Eyes.retina
	local at = t - (index - 1) * R.lagSeconds
	return sweepDeg * math.sin(2 * math.pi * at / R.sweepSeconds), torsionDeg * math.sin(2 * math.pi * at / R.torsionSeconds)
end

-- The two strips as the player sees them, for a profile (its field of view and its swing), the time and the screen's size: each
-- at its true angular size (widthDeg x heightDeg), offsetDeg either side of the middle plus its sway, tilted tiltDeg into a V (the
-- left one leaning out to the left at the top) plus its turn.
function EyeOptics.retinaStrips(t: number, p: Profile, viewportW: number, viewportH: number): { Strip }
	local R = Eyes.retina
	local w = EyeOptics.extentPx(R.widthDeg, p.fovDeg, viewportH)
	local h = EyeOptics.extentPx(R.heightDeg, p.fovDeg, viewportH)
	local out: { Strip } = {}
	for i = 1, 2 do
		local side = if i == 1 then -1 else 1
		local sway, turn = EyeOptics.scanPose(i, t, p.sweepDeg, p.torsionDeg)
		out[i] = {
			x = viewportW * 0.5 + EyeOptics.offsetPx(side * R.offsetDeg + sway, p.fovDeg, viewportH),
			y = viewportH * 0.5,
			w = w,
			h = h,
			rotation = side * R.tiltDeg + turn,
		}
	end
	return out
end

-- True when the screen point lies inside the strip: the rounded box (a stadium, the strip being taller than wide), turned as it
-- is drawn.
function EyeOptics.insideStrip(px: number, py: number, s: Strip): boolean
	local dx, dy = px - s.x, py - s.y
	local a = math.rad(s.rotation)
	local c, sn = math.cos(a), math.sin(a)
	local lx, ly = dx * c + dy * sn, -dx * sn + dy * c
	local r = s.w * 0.5
	local reach = math.max(s.h * 0.5 - r, 0)
	local oy = ly - math.clamp(ly, -reach, reach)
	return lx * lx + oy * oy <= r * r
end

function EyeOptics.insideAnyStrip(px: number, py: number, strips: { Strip }): boolean
	for _, s in strips do
		if EyeOptics.insideStrip(px, py, s) then
			return true
		end
	end
	return false
end

-- ---------------------------------------------------------------- the lateral eyes' movement rings
-- 0 to 1 and back, Eyes.shimmer.hz times a second, from time t; a steady half with reduced motion.
function EyeOptics.pulse(t: number, reduced: boolean): number
	if reduced then
		return 0.5
	end
	return 0.5 - 0.5 * math.cos(2 * math.pi * Eyes.shimmer.hz * t)
end

-- A ring's diameter in pixels: the thing's apparent size (degrees across, as the sensor measured it) at this field of view, at
-- least minPx, times scaleMin to scaleMax as the pulse goes 0 to 1.
function EyeOptics.ringDiameter(apparentDeg: number, fovDeg: number, viewportH: number, pulse: number): number
	local S = Eyes.shimmer
	local base = math.max(S.minPx, EyeOptics.extentPx(apparentDeg, fovDeg, viewportH))
	return base * lerp(S.scaleMin, S.scaleMax, clamp01(pulse))
end

-- 1 when the thing was just seen moving, 0 when the sensor's hold (holdTicks, Sensor.MOTION_HOLD_TICKS) has run out.
function EyeOptics.freshness(nowTick: number, seenTick: number, holdTicks: number): number
	return 1 - clamp01((nowTick - seenTick) / math.max(holdTicks, 1))
end

-- A ring's opacity: the base alpha, as fresh as the sighting, a third of that (insideStripFactor) inside a retina strip.
function EyeOptics.ringAlpha(fresh: number, inside: boolean): number
	local S = Eyes.shimmer
	return S.alpha * clamp01(fresh) * (if inside then S.insideStripFactor else 1)
end

-- An edge arc's opacity: as fresh as the sighting, breathing a little with the pulse.
function EyeOptics.arcAlpha(fresh: number, pulse: number): number
	local A = Eyes.shimmer.arc
	return A.alpha * clamp01(fresh) * lerp(1 - A.breath, 1, clamp01(pulse))
end

-- The things to draw: the freshest first, at most maxCount, ties broken by id so the same record always gives the same list.
function EyeOptics.pickMovers(seen: { [string]: Moving }, maxCount: number): { Mover }
	local list: { Mover } = {}
	for id, e in seen do
		table.insert(list, { id = id, direction = e.direction, distance = e.distance, apparent = e.apparent, tick = e.tick })
	end
	table.sort(list, function(a: Mover, b: Mover): boolean
		if a.tick ~= b.tick then
			return a.tick > b.tick
		end
		return a.id < b.id
	end)
	while #list > maxCount do
		table.remove(list)
	end
	return list
end

-- True when a point (pixels) is inside the screen, give or take `margin`.
function EyeOptics.onScreen(x: number, y: number, viewportW: number, viewportH: number, margin: number): boolean
	return x >= -margin and x <= viewportW + margin and y >= -margin and y <= viewportH + margin
end

-- Where the screen's edge is in the direction of something off screen: (cx, cy) is its direction in the camera's own axes (x
-- right, y up). The same rule as the perception HUD's edge marks: a direction straight behind goes to the top, and the point is
-- `inset` pixels inside the edge. Returns the point's x and y and the unit direction (x, y; y down) from the screen's middle to it.
function EyeOptics.edgeMark(cx: number, cy: number, viewportW: number, viewportH: number, inset: number): (number, number, number, number)
	local vx, vy = cx, -cy
	local m = math.sqrt(vx * vx + vy * vy)
	if m < 0.03 then
		vx, vy, m = 0, -1, 1
	end
	vx, vy = vx / m, vy / m
	local hx, hy = viewportW * 0.5 - inset, viewportH * 0.5 - inset
	local t = math.min(hx / math.max(math.abs(vx), 1e-6), hy / math.max(math.abs(vy), 1e-6))
	return viewportW * 0.5 + vx * t, viewportH * 0.5 + vy * t, vx, vy
end

-- The short bars that make an edge arc: `segments` of them, stepDeg apart along a circle of `radius` pixels whose outermost point
-- is (x, y), where `d` (dx, dy) points out of the screen. Each bar's rotation lays it along the circle there.
function EyeOptics.arcSegments(x: number, y: number, dx: number, dy: number): { Segment }
	local A = Eyes.shimmer.arc
	local cx, cy = x - dx * A.radius, y - dy * A.radius
	local nx, ny = -dy, dx
	local out: { Segment } = {}
	local middle = (A.segments + 1) / 2
	for i = 1, A.segments do
		local phi = math.rad((i - middle) * A.stepDeg)
		local c, s = math.cos(phi), math.sin(phi)
		out[i] = {
			x = cx + A.radius * (c * dx + s * nx),
			y = cy + A.radius * (c * dy + s * ny),
			rotation = math.deg(math.atan2(-s * dy + c * ny, -s * dx + c * nx)),
		}
	end
	return out
end

-- ---------------------------------------------------------------- the words, the UV layer
-- The caption's opacity `age` seconds into the eye view: it fades in, holds and fades out, and is gone after Eyes.caption.seconds.
function EyeOptics.captionAlpha(age: number): number
	local C = Eyes.caption
	if age < 0 or age >= C.seconds then
		return 0
	end
	return EyeOptics.smooth(age / C.fadeInSeconds) * EyeOptics.smooth((C.seconds - age) / C.fadeOutSeconds)
end

-- The caption: what the side eyes do, then how to use the principal eyes. `key` is the device's Focus control (ControlText);
-- `toggled` when Focus is a toggle, which is pressed and not held.
-- `held` (ROBLOX-115): the key is held even to latch a toggled Focus (a controller's L2, whose tap is the lock), so the words say Hold either way.
function EyeOptics.captionText(key: string, toggled: boolean, held: boolean?): string
	local C = Eyes.caption
	return C.side .. "\n" .. string.format(C.principal, if toggled and not held then C.toggle else C.hold, if key ~= "" then key else "Focus")
end

-- A UV layer part's transparency: clear with the side eyes, as visible as its UVOpacity with the principal eyes.
function EyeOptics.uvTransparency(k: number, opacity: number): number
	return 1 - clamp01(k) * clamp01(opacity)
end

return EyeOptics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="147">
          <Properties>
            <string name="Name">FrogText</string>
            <string name="Source"><![CDATA[--!strict
-- The green frog in words (ROBLOX-122; the frog is Predator/Frog): its death card and the notice when its tongue misses (the gentle rules). Pure: tests/preserve.luau
-- checks the words, tests/quiet.luau their classes.
local FrogText = {}

FrogText.LINE = "The frog's tongue was quicker."
FrogText.SUB = "It sat still at the water's edge and struck at what moved within its reach. Keeping still, or keeping clear of it, the spider would have lived."
FrogText.MISSED = "A frog's tongue slapped down beside you. You jumped clear."
FrogText.CAUSE = "frog" -- (the end of a life's cause, LifeSession; Predator/Frog.CAUSE)

return table.freeze(FrogText)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="148">
          <Properties>
            <string name="Name">Heard</string>
            <string name="Source"><![CDATA[--!strict
-- What the player can hear or see of something that is not at the spider (ROBLOX-92): a creature on the sill is told of (a notice, a caption, a status line) only to a spider
-- that could perceive it, within earshot, or in clear sight of it and not too far. The rule is the one the wasp's taking of the rival has always used (Data/Wasp.rival,
-- ROBLOX-70); the mate's arrival, notice and leaving (ROBLOX-80) use it too. Pure: checked in tests/wasp.luau and tests/client_mating.luau.
local Data = require(script.Parent.Parent.Data.Wasp)

local Heard = {}

-- `distance` is the studs between the spider and the thing; `seen` whether the spider has a clear line of sight to it.
function Heard.within(distance: number, seen: boolean): boolean
	return distance <= Data.rival.earshotWu or (seen and distance <= Data.rival.sightWu)
end

-- The farthest distance at which anything can be perceived (the sight limit): beyond it a sight test is not needed.
function Heard.farthest(): number
	return math.max(Data.rival.earshotWu, Data.rival.sightWu)
end

return Heard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="149">
          <Properties>
            <string name="Name">HudLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Where the on-screen controls and the prompt panel go, in the safe area (ScreenInsets.CoreUISafeInsets: clear of notches,
-- the home bar and Roblox's top bar). Pure, so tests/run.luau checks that prompts never sit under a touch button and stay
-- wide enough to read, at phone, tablet and desktop sizes. SpiderInput builds the touch buttons from TOUCH_BUTTONS.
local HudLayout = {}

export type Button = { action: string, label: string, x: number, y: number, size: number, right: boolean, textSize: number? }
export type Rect = { x0: number, y0: number, x1: number, y1: number }

-- x, y: the button's top-left corner as an offset from the safe area's bottom-left (right = false) or bottom-right corner.
HudLayout.TOUCH_BUTTONS = {
	{ action = "Forward", label = "↑", x = 78, y = -188, size = 52, right = false },
	{ action = "Left", label = "←", x = 22, y = -132, size = 52, right = false },
	{ action = "Back", label = "↓", x = 78, y = -76, size = 52, right = false },
	{ action = "Right", label = "→", x = 134, y = -132, size = 52, right = false },
	{ action = "Jump", label = "Jump\n(hold)", x = -92, y = -102, size = 72, right = true },
	{ action = "Cancel", label = "Cancel", x = -166, y = -92, size = 60, right = true, textSize = 16 },
	{ action = "Creep", label = "Creep", x = -86, y = -172, size = 60, right = true },
	{ action = "Drop", label = "Silk", x = -86, y = -242, size = 60, right = true },
	{ action = "Recenter", label = "Re-\ncentre", x = -160, y = -168, size = 52, right = true, textSize = 14 },
	{ action = "Run", label = "Run", x = 146, y = -242, size = 52, right = false, textSize = 14 },
	{ action = "Feed", label = "Eat", x = 22, y = -242, size = 52, right = false, textSize = 14 },
	{ action = "Focus", label = "Focus", x = -236, y = -242, size = 60, right = true, textSize = 14 },
	{ action = "Eye", label = "Eye", x = -156, y = -242, size = 60, right = true },
	-- The peacock spider (ROBLOX-31): Change (in the crack) beside Eat, Dance (the peacock spider, standing still) above Silk. Both start hidden.
	{ action = "Choose", label = "Change", x = 82, y = -252, size = 56, right = false, textSize = 13 },
	{ action = "Display", label = "Dance", x = -86, y = -306, size = 56, right = true, textSize = 14 },
	-- The lock (ROBLOX-110): a small button left of Cancel, by Jump; shown only while something can be locked or a lock holds.
	{ action = "Lock", label = "Lock", x = -226, y = -90, size = 50, right = true, textSize = 12 }, -- (12: "Unlock" fits its 44 px)
} :: { Button }

HudLayout.GAP = 12
HudLayout.MIN_PROMPT_WIDTH = 260
HudLayout.MAX_PROMPT_WIDTH = 760

-- Short landscape safe areas need three rows rather than a tall stack: leave
-- room for the prompt above them, including when Dance/Change are visible.
local COMPACT = {
	Feed={16,-180}, Forward={76,-180}, Choose={136,-180},
	Left={16,-120}, Right={136,-120}, Back={76,-60},
	Focus={-188,-180}, Display={-128,-180}, Drop={-68,-180},
	Eye={-188,-120}, Recenter={-128,-120}, Creep={-68,-120},
	Cancel={-128,-60}, Jump={-68,-60}, Lock={-188,-60}, Run={196,-60},
}
-- A short screen (under 450 px tall: a phone held sideways, whatever its width, ROBLOX-92: it was 568 px and wider only, so a 480 px phone had the tall stack) is laid out in three rows.
function HudLayout.isShort(width: number, height: number): boolean
	return width > 0 and height > 0 and height < 450
end
function HudLayout.layoutButton(b: Button, width: number, height: number): Button
	local short = HudLayout.isShort(width, height)
	if b.action == "Run" and width < 400 and not short then
		local copy = table.clone(b)
		copy.x, copy.y = 22, -304
		return copy
	end
	-- A narrow phone (under 400 px) has no room for Focus beside the left thumb's cluster: it goes one row up.
	if b.action == "Focus" and width < 400 and not short then
		local copy = table.clone(b)
		copy.y = -320
		return copy
	end
	-- ... nor for Lock left of Cancel: it goes up beside Focus.
	if b.action == "Lock" and width < 400 and not short then
		local copy = table.clone(b)
		copy.x, copy.y = -158, -316
		return copy
	end
	if short then
		local slot = COMPACT[b.action]
		if slot then
			local copy = table.clone(b)
			copy.x, copy.y, copy.size = slot[1], slot[2], 52
			copy.textSize = math.min(b.textSize or 18, 14)
			return copy
		end
	end
	return b
end

function HudLayout.buttonRect(b: Button, width: number, height: number): Rect
	b = HudLayout.layoutButton(b, width, height)
	local x0 = if b.right then width + b.x else b.x
	local y0 = height + b.y
	return { x0 = x0, y0 = y0, x1 = x0 + b.size, y1 = y0 + b.size }
end

-- The touch buttons' combined top edge and the inner edges of the two thumb clusters.
local function clusters(width: number, height: number): (number, number, number)
	local leftEdge, rightEdge, top = 0, width, height
	for _, b in HudLayout.TOUCH_BUTTONS do
		local r = HudLayout.buttonRect(b, width, height)
		if b.right then rightEdge = math.min(rightEdge, r.x0) else leftEdge = math.max(leftEdge, r.x1) end
		top = math.min(top, r.y0)
	end
	return leftEdge, rightEdge, top
end

-- The prompt panel's horizontal span and its bottom edge (it grows upward as it wraps) for a safe area of this size.
-- Keyboard and controller: centred near the bottom. Touch: between the thumb clusters when that leaves room to read,
-- otherwise above them.
function HudLayout.promptSpan(width: number, height: number, device: string): (number, number, number)
	local gap = HudLayout.GAP
	local x0, x1, bottom
	if device == "touch" then
		local leftEdge, rightEdge, top = clusters(width, height)
		if rightEdge - leftEdge - 2 * gap >= HudLayout.MIN_PROMPT_WIDTH then
			x0, x1, bottom = leftEdge + gap, rightEdge - gap, height - gap
		else
			x0, x1, bottom = gap, width - gap, top - gap
			-- (above the clusters on a short screen the panel reaches the top: keep it out of the Menu and Notebook stack)
			local strip = HudLayout.topLayout(width, height)
			if strip.stacked then x1 = math.min(x1, strip.notebook.x0 - gap) end
		end
	else
		x0, x1, bottom = 24, width - 24, height - 16
	end
	local extra = (x1 - x0) - HudLayout.MAX_PROMPT_WIDTH
	if extra > 0 then
		x0 += extra / 2
		x1 -= extra / 2
	end
	return x0, x1, bottom
end

-- The Menu and Notebook buttons (ROBLOX-50) and the HUD's top column of status lines (day, notices, toasts, captions), laid out together so none
-- covers another and every button is a touch target (at least MIN_TARGET px each way). Where the screen is wide enough the two buttons stack at
-- the top right and the column gives up that strip on both sides (it stays centred); on a narrow phone they sit side by side in a row at the
-- top and the column starts under them. Rects are offsets from the safe area's top-left corner.
HudLayout.MIN_TARGET = 48
HudLayout.TOP = { menuW = 80, notebookW = 104, h = 48, margin = 12, gap = 8, columnY = 8, columnInset = 16, minColumn = 300 }
HudLayout.TOP_SHORT = { menuW = 64, notebookW = 92, h = 48, margin = 8, gap = 6, columnY = 8, columnInset = 16, minColumn = 260 }
export type Top = { menu: Rect, notebook: Rect, columnX0: number, columnX1: number, columnY: number, stacked: boolean }
function HudLayout.topLayout(width: number, height: number): Top
	local t = HudLayout.TOP
	-- (ROBLOX-92) A short, narrow landscape phone (480 x 320) cannot spare a strip of 124 px on each side, and the column under a row of buttons would meet the prompts above the thumbs:
	-- there the buttons are a little narrower (still 48 px tall, wider than their words) and the stack fits.
	if HudLayout.isShort(width, height) and width - 2 * (t.margin + t.notebookW + t.gap) < t.minColumn then t = HudLayout.TOP_SHORT end
	local x1 = width - t.margin
	local side = t.margin + t.notebookW + t.gap -- the strip the buttons take on each side of a centred column
	if width - 2 * side >= t.minColumn then
		local menu = { x0 = x1 - t.menuW, y0 = t.columnY, x1 = x1, y1 = t.columnY + t.h }
		local notebook = { x0 = x1 - t.notebookW, y0 = menu.y1 + t.gap, x1 = x1, y1 = menu.y1 + t.gap + t.h }
		return { menu = menu, notebook = notebook, columnX0 = side, columnX1 = width - side, columnY = t.columnY, stacked = true }
	end
	local menu = { x0 = x1 - t.menuW, y0 = t.columnY, x1 = x1, y1 = t.columnY + t.h }
	local notebook = { x0 = menu.x0 - t.gap - t.notebookW, y0 = t.columnY, x1 = menu.x0 - t.gap, y1 = t.columnY + t.h }
	return { menu = menu, notebook = notebook, columnX0 = t.columnInset, columnX1 = width - t.columnInset, columnY = menu.y1 + t.gap, stacked = false }
end

function HudLayout.overlaps(a: Rect, b: Rect): boolean
	return a.x0 < b.x1 and b.x0 < a.x1 and a.y0 < b.y1 and b.y0 < a.y1
end

return HudLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="150">
          <Properties>
            <string name="Name">InspectText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of Inspect mode (ROBLOX-90): the Settings row's button (its label and note are in Data/SettingsSpec), the refusal, the name line on entering it, the name line and the controls line on screen, the toast for a
-- framing and what the touch buttons say. Button names come from ControlText for the device in use (PlayStation
-- names on a PlayStation controller). Pure: checked in tests/inspect.luau.
local ControlText = require(script.Parent.ControlText)
local PeacockText = require(script.Parent.PeacockText)

local InspectText = {}

InspectText.BUTTON = "Look closely"
-- The touch buttons while looking: Cancel becomes Back, Eye becomes View (the framings).
InspectText.TOUCH_BACK = "Back"
InspectText.TOUCH_VIEW = "View"
InspectText.NOT_NOW = "You cannot look closely now. Stand safely on a surface first"
InspectText.DANGER = "The close look ends: something is coming"
InspectText.ENDED = "The close look ends"
InspectText.FRAMINGS = { face = "Face", side = "Side", top = "From above" } :: { [string]: string }

-- The name line on screen: the spider being looked at, with a capital.
function InspectText.nameLine(appearance: string): string
	return PeacockText.title(appearance)
end

-- The one line of controls on screen, for the device in use.
function InspectText.hint(device: ControlText.Device): string
	local n = function(action: string): string return ControlText.name(device, action) end
	if device == "gamepad" then
		return `{n("look")}: orbit    {n("walk")}: zoom    {n("eye")}: face, side, top    {n("cancel")} or {n("choose")}: back`
	elseif device == "touch" then
		return `{n("look")}: orbit    Pinch or {n("reel")} {n("lower")}: zoom    {InspectText.TOUCH_VIEW}: face, side, top    {InspectText.TOUCH_BACK}: leave`
	end
	return `{n("look")}: orbit    {n("zoom")} or {n("reel")} {n("lower")}: zoom    {n("eye")}: face, side, top    {n("cancel")} or {n("choose")}: back`
end

-- The toast when the framing changes.
function InspectText.framing(id: string): string
	return `Framing: {InspectText.FRAMINGS[id] or id}`
end

-- The crack's prompt, after the change-spider hint.
function InspectText.holdHint(device: ControlText.Device): string
	return `hold {ControlText.name(device, "choose")}: look closely`
end

-- (The controls card's mention of the close look is inside PeacockText.crackLine, ROBLOX-92: the same hold, in the crack's line.)

return InspectText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="151">
          <Properties>
            <string name="Name">LifeText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of the life clock and the retreat for the screen (ROBLOX-24), from Godot's habitat_loop.gd caption(): the day and
-- the part of it, the one line for the time of day or hunger, and the retreat's prompt. Button names come from ControlText for
-- the device in use (Godot's interact is the port's feed button, E; cancel is Q). Pure, checked in tests/life.luau.
local ControlText = require(script.Parent.ControlText)
local MateText = require(script.Parent.MateText)

local LifeText = {}

export type Prompt = { title: string, hint: string }

-- ROBLOX-106 (W4): the night in the garden (Life/Nature) and the end of a life in the standard rules. Nothing tells the dusk but the light.
LifeText.NIGHT_LINE = "The night found the spider."
LifeText.NIGHT_SUB = "Out on the ground after dark, something that hunts there found it."
LifeText.NIGHT_COLD = "A cold night in the open, and something passed close by. You are stiff and slow until the morning warms."
-- The end screen's last line in the standard rules (Easy and Free play keep theirs): what "Back to your last rest" costs, and what another spider is.
LifeText.DAY_LOST = "In Normal a death loses the day: back at your last rest, the meals, the growth and what you saw since then are gone (the notebook keeps its pages). Another spider is a new life from the start."
LifeText.NO_REST = "There is no rest to go back to. Another spider is a new life from the start."
function LifeText.dayLost(hasRest: boolean): string
	return if hasRest then LifeText.DAY_LOST else LifeText.NO_REST
end

-- "Day 2, evening".
function LifeText.day(day: number, part: string): string
	return `Day {day}, {part}`
end

-- The line under the day (Godot's precedence, among the lines this port has): starving, hungry, night, evening; nil otherwise.
-- `gentle` rules never say starving (Godot: is_starving() and not gentle).
function LifeText.line(part: string, energy: number, starving: boolean, gentle: boolean, hungryAt: number, weak: boolean?): string?
	if weak and not gentle then return "Starving: your spider will not last another day. Too hungry to sleep; find food." end
	if starving and not gentle then
		return "Starving: your spider's reserve is gone. It must eat soon."
	end
	if energy <= hungryAt then
		return "Hungry: time to hunt."
	end
	if part == "night" then
		return "It is dark, and your eyes reach only a little way. Home is the silk-lined crack at the west end."
	end
	if part == "evening" then
		return "Evening. Jumping spiders go into their silk retreat before dark."
	end
	return nil
end

-- The HUD bar's label (ROBLOX-78), the Minecraft way: the bar is the spider's hunger, FULL when it is fed and emptying as it grows hungry, and
-- eating fills it. `fed` is the reserve, 0 to 1; the word after it is the same one the line under the day uses.
function LifeText.hunger(fed: number, gentle: boolean): string
	local v = math.clamp(fed, 0, 1)
	return string.format("Hunger %d%%", math.floor(v * 100 + 0.5)) .. (if gentle then " · gentle" elseif v <= 0 then " · starving" elseif v <= 0.25 then " · hungry" else "")
end

-- ROBLOX-96: the homes, by the retreat's id on the map (World/WorldMap): what each is called in the prompts, how a rest there is told, and where it is. The crack
-- is the default and every word of it is as it was; the gap under the bed's stone is the first garden home. A retreat this table does not know reads as the crack.
LifeText.HOMES = {
	sill_crevice = {
		name = "the silk-lined crack", -- "Asleep in the silk-lined crack", "Resting in the silk-lined crack"
		title = "The silk-lined crack", -- the prompt when the spider can rest
		home = "Home: the silk-lined crack", -- the line near home
		way = "Walk through the silk-framed opening under the wooden roof, then stop to rest.",
		kept = "Last rest kept.", -- (CheckpointStore's own words, kept as they were)
	},
	bed_a_stone = {
		name = "under the stone",
		title = "Under the stone",
		home = "Home: under the stone",
		way = "Walk into the gap under the big stone in the bed, then stop to rest.",
		kept = "Last rest kept, under the stone.",
	},
	-- ROBLOX-112: the first home inside, the gap under the toaster on the kitchen's counter
	kitchen_toaster = {
		name = "under the toaster",
		title = "Under the toaster",
		home = "Home: under the toaster",
		way = "Walk into the gap under the toaster on the counter, then stop to rest.",
		kept = "Last rest kept, under the toaster.",
	},
	-- ROBLOX-116: the ranger hut's homes, inside and in its garden
	hut_desk_drawer = {
		name = "under the drawer",
		title = "Under the drawer",
		home = "Home: under the desk's drawer",
		way = "Walk into the gap under the desk's drawer, then stop to rest.",
		kept = "Last rest kept, under the drawer.",
	},
	hut_board_gap = {
		name = "behind the notice board",
		title = "Behind the notice board",
		home = "Home: behind the notice board",
		way = "Walk into the gap behind the notice board, then stop to rest.",
		kept = "Last rest kept, behind the notice board.",
	},
	garden_a1_trough = {
		name = "under the trough",
		title = "Under the trough",
		home = "Home: under the trough",
		way = "Walk into the gap under the trough by the hut, then stop to rest.",
		kept = "Last rest kept, under the trough.",
	},
	garden_a3_stone = {
		name = "under the stone",
		title = "Under the stone",
		home = "Home: under the stone",
		way = "Walk into the gap under the flat stone in the grass, then stop to rest.",
		kept = "Last rest kept, under the stone.",
	},
	garden_d3_mulch = {
		name = "under the bark chip",
		title = "Under the bark chip",
		home = "Home: under the bark chip",
		way = "Walk into the gap under the bark chip in the mulch, then stop to rest.",
		kept = "Last rest kept, under the bark chip.",
	},
	-- ROBLOX-118: the darkest place in the hut, the gap under the back room's sofa
	room_sofa_under = {
		name = "under the sofa",
		title = "Under the sofa",
		home = "Home: under the sofa",
		way = "Walk in under the sofa in the back room, deep into the dark, then stop to rest.",
		kept = "Last rest kept, under the sofa.",
	},
	-- ROBLOX-119: the meadow's edge and the bench patch
	meadow_b2_leaf = {
		name = "under the curled leaf",
		title = "Under the curled leaf",
		home = "Home: under the curled leaf",
		way = "Walk in under the curled dead leaf in the meadow's grass, then stop to rest.",
		kept = "Last rest kept, under the curled leaf.",
	},
	bench_slats = {
		name = "the gap in the bench's slats",
		title = "The gap in the bench's slats",
		home = "Home: the gap in the bench's slats",
		way = "Climb down into the gap between the bench's seat slats, then stop to rest.",
		kept = "Last rest kept, in the bench's slats.",
	},
	bin_lip = {
		name = "under the bin's lip",
		title = "Under the bin's lip",
		home = "Home: under the bin's lip",
		way = "Walk in under the litter bin's base, between its feet, then stop to rest.",
		kept = "Last rest kept, under the bin's lip.",
	},
	-- ROBLOX-122: the pond's edge and the boardwalk
	deck_gap = {
		name = "the gap in the boardwalk",
		title = "The gap in the boardwalk",
		home = "Home: the gap in the boardwalk",
		way = "Climb down into the wide gap between two of the boardwalk's boards, then stop to rest.",
		kept = "Last rest kept, in the boardwalk's gap.",
	},
	pond_stone = {
		name = "under the flat stone",
		title = "Under the flat stone",
		home = "Home: under the flat stone",
		way = "Walk in under the flat stone on the pond's bank, then stop to rest.",
		kept = "Last rest kept, under the flat stone.",
	},
	cattail_leaf = {
		name = "under the dead cattail leaf",
		title = "Under the dead cattail leaf",
		home = "Home: under the dead cattail leaf",
		way = "Walk in under the curled dead cattail leaf on the pond's bank, then stop to rest.",
		kept = "Last rest kept, under the cattail leaf.",
	},
} :: { [string]: { name: string, title: string, home: string, way: string, kept: string } }
LifeText.DEFAULT_HOME = "sill_crevice"
local function homeOf(retreat: string?): { name: string, title: string, home: string, way: string, kept: string }
	return LifeText.HOMES[retreat or LifeText.DEFAULT_HOME] or LifeText.HOMES[LifeText.DEFAULT_HOME]
end
local function inWords(name: string): string
	return if string.sub(name, 1, 6) == "under " then name else "in " .. name
end

-- The retreat's prompt: asleep, resting, or able to rest (sleep in the evening and at night); nil when none of these. `extra` (the crack's
-- way to change spider, ROBLOX-31) is added to the resting hint. `retreat` (ROBLOX-96): which home, by its id; the crack when nil.
function LifeText.prompt(asleep: boolean, resting: boolean, canRest: boolean, sleepTime: boolean, device: ControlText.Device, extra: string?, retreat: string?): Prompt?
	local feed, cancel = ControlText.name(device, "feed"), ControlText.name(device, "cancel")
	local h = homeOf(retreat)
	if asleep then
		return { title = `Asleep {inWords(h.name)}`, hint = `The night passes. Move, {feed} or {cancel} to wake.` }
	end
	if resting then
		return { title = `Resting {inWords(h.name)}`, hint = `Move, {feed} or {cancel} to leave.` .. (if extra and extra ~= "" then "    " .. extra else "") }
	end
	if canRest then
		return { title = h.title, hint = if sleepTime then `{feed}: sleep until morning` else `{feed}: rest` }
	end
	return nil
end

-- The line near a home when there is no prompt (ROBLOX-96): "Home: the silk-lined crack" and how to get in, or, inside it, how to rest. `retreat` is the home's id.
function LifeText.homeLine(retreat: string?, inside: boolean, device: ControlText.Device): Prompt
	local h = homeOf(retreat)
	return { title = h.home, hint = if inside then `Keep still on a surface, then {ControlText.name(device, "feed")}: rest` else h.way }
end

-- What a kept rest says (ROBLOX-96): the store's own words for the crack, and the place for any other home. `message` is what the store said.
function LifeText.restKept(retreat: string?, message: string): string
	if retreat == nil or retreat == LifeText.DEFAULT_HOME or LifeText.HOMES[retreat] == nil then return message end
	return homeOf(retreat).kept
end

-- What the touch feed button says when it is the retreat's (nil: it is the meal's, or hidden).
function LifeText.touchLabel(asleep: boolean, resting: boolean, canRest: boolean, sleepTime: boolean): string?
	if asleep then return "Wake" end
	if resting then return "Leave" end
	if canRest then return if sleepTime then "Sleep" else "Rest" end
	return nil
end

-- Why a rest is not kept as the last rest (ROBLOX-92), in the game's own words. The keys are the reasons Persistence/Checkpoint.boundaryProblem gives (engineering words, never
-- shown); a reason this table does not know says LifeText.REST_FALLBACK, and tests/checkpoint.luau checks that every reason the sim can give is known.
LifeText.REST_FALLBACK = "Not now"
LifeText.KEEP_FAILED = "This rest could not be kept"
LifeText.REST_REFUSALS = {
	["the spider is not standing on a surface"] = "Not now — stand still on a surface first",
	["the spider is moving"] = "Not now — keep still first",
	["the rival in the jaws is still struggling"] = "Not while a fight is on",
	["the spider is eating its rival"] = "Not while you are feeding",
	["the two spiders are together"] = MateText.REST_TOGETHER,
	["the brood is hatching"] = MateText.REST_HATCHING,
	["the spider is feeding"] = "Not while you are feeding",
	["the prey in the jaws is still struggling"] = "Not while a fight is on",
	["a strike is still in progress"] = "Not now — wait for the strike to finish",
} :: { [string]: string }
function LifeText.restRefusal(reason: string): string
	return LifeText.REST_REFUSALS[reason] or LifeText.REST_FALLBACK
end

-- ROBLOX-96: what the meal line says of the prey in the jaws, by its kind (Species body.prey_kind): how many of it make a housefly meal, and how finely the count is
-- shown (halves for the sill's prey, as always; tenths for the bed's smaller ones, so a gnat's third shows).
LifeText.MEALS = {
	fruit_fly = { rule = "2 small prey = 1 housefly", step = 2 },
	fungus_gnat = { rule = "3 gnats = 1 housefly", step = 10 },
	aphid = { rule = "6 aphids = 1 housefly", step = 10 },
	-- ROBLOX-101: the bestiary's
	springtail = { rule = "8 springtails = 1 housefly", step = 10 },
	leafhopper = { rule = "2 leafhoppers = 1 housefly", step = 2 },
	moth = { rule = "1 moth = 1 housefly", step = 2 },
	crane_fly = { rule = "1 crane fly = 2 houseflies", step = 2 },
	hoverfly = { rule = "2 hoverflies = 3 houseflies", step = 2 }, -- (ROBLOX-117)
} :: { [string]: { rule: string, step: number } }
local DEFAULT_MEAL = { rule = "2 small prey = 1 housefly", step = 2 }

-- Housefly-equivalent meals: a small prey counts as half. Partial feeding is retained. `kind` (ROBLOX-96): the prey in the jaws, for the rule it says.
function LifeText.growth(g: any, required: number, meal: number, kind: string?): string
 if g:isAdult() then return "Adult: keep your hunger bar full." end
 if g:isMoulting() then return "Moulting: stay in the crack." end
 if g.ready then return "Ready to moult: rest in the crack." end
 -- (ROBLOX-88: the goal is the growth's own, 3 by Godot's rule and 5 in the game; `required` and `meal` serve a growth that cannot say.)
 local goal = if g.mealGoal ~= nil then g:mealGoal() else math.ceil(required / meal)
 required = if g.readyAt ~= nil then g:readyAt() else required
 local rule = LifeText.MEALS[kind or ""] or DEFAULT_MEAL
 local count = math.min(goal, math.floor(g.fedSinceMoult / required * goal * rule.step + 1e-8) / rule.step)
 return `Next moult: {count} of {goal} meals · {rule.rule}`
end
-- ROBLOX-113 (W5, Shared/UI/QuietHud): the growth line in Normal after the first day: the count without the prey's rule ("Next moult: 2 of 5 meals"), "Ready to moult",
-- or nothing (moulting: the prompt's title says it; an adult: the day line's stage says it). The arguments are growth's.
function LifeText.growthQuiet(g: any, required: number, meal: number, kind: string?): string?
	if g:isAdult() or g:isMoulting() then return nil end
	if g.ready then return "Ready to moult" end
	local full = LifeText.growth(g, required, meal, kind)
	return string.match(full, "^(.-) · ") or full
end
return LifeText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="152">
          <Properties>
            <string name="Name">MateText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of the mating cycle for the screen (ROBLOX-80): the notices for each beat Life/Mating reports, the status line while courting and while
-- guarding the sac, the captions, the ending card of the hatching and the toast of the next generation. Button names come from ControlText for the device in
-- use. The game is for children and about nature: nothing is shown or said about the mating but that the two spiders stay together a moment.
-- Pure: checked in tests/client_mating.luau.
local ControlText = require(script.Parent.ControlText)

local MateText = {}

MateText.TITLE = "The sill continues"
MateText.BUTTON = "Carry on"
MateText.METER = "Courtship"

-- The words for the mate: "male" or "female".
local function kind(sex: string): string
	return if sex == "male" then "a male spider" else "a female spider"
end

-- A mate came onto the sill. The peacock spider is told that its dance is the way to court it.
function MateText.arrived(sex: string, needsDance: boolean, device: ControlText.Device): string
	local line = `A visitor: {kind(sex)} has come onto the sill. Walk close, face it and keep still.`
	if needsDance then line ..= ` Dance for it ({ControlText.name(device, "display")}).` end
	return line
end

MateText.NOTICED = "It has seen you."
MateText.DRIVEN = "You frightened it. It leaves the sill for today."
MateText.COURTED = "The two spiders stay together for a moment."
MateText.MATED = "They have parted. The visitor walks away and will not come again."
MateText.SAC = "An egg sac, made in the night, hangs in the crack. Rest in the crack to pass the nights."
MateText.GUARD_DAY = "Second day with the eggs. They hatch tomorrow morning."
MateText.HATCHING = "The eggs are hatching!"
-- ROBLOX-91: the mating gate (a full-grown spider with energy of at least 0.6, at a rest) said nothing when it was the hunger that was missing.
MateText.TOO_HUNGRY = "Too hungry for a visitor to come. Eat well, then rest in the crack again."

-- ROBLOX-92: the mating scene can be skipped after four seconds and said nothing of it. From then on the scene shows what ends it (its status line, not a sound
-- caption: the Captions setting does not hide it), by the device in use; on touch the Jump button is relabelled Skip for the scene, as it is Grip for a struggle.
MateText.TOUCH_SKIP = "Skip"
function MateText.skipLine(device: ControlText.Device): string
	local jump = if device == "touch" then MateText.TOUCH_SKIP else ControlText.name(device, "jump")
	return `{jump} or {ControlText.name(device, "cancel")}: part`
end

-- ROBLOX-92: why a rest is not kept as the last rest, in the game's own words (LifeText.restRefusal maps the rest of the reasons).
MateText.REST_TOGETHER = "Not now — the two of you are together"
MateText.REST_HATCHING = "Not while the brood is hatching"

-- The end screen's choice to go on as a new spider (ROBLOX-91): a new life, not the family's: the sac and the generation are left behind. While there is an egg sac (or a
-- hatched brood not yet carried on) it says so; "Back to your last rest" keeps them (the rest has them).
MateText.ANOTHER = "Continue as another spider"
MateText.ANOTHER_BROOD = "Continue as another spider (a new life: the brood is lost)"
function MateText.another(hasSac: boolean): string
	return if hasSac then MateText.ANOTHER_BROOD else MateText.ANOTHER
end

-- ROBLOX-106: a courtship that failed (the standard rules). The mate refuses on a full meter, by the spider's condition and the court's quality (Life/Mating.acceptChance):
-- the words say which weighed most, "thin" (the reserve) or "clumsy" (breaks, distance, facing, length), or "choosy" when neither was at fault. Or the rival cut in. Each is the end of that day's visit; a
-- visitor may come the next morning (Life/Mating: the cycle wants one until the pair have mated), and the words say no more than that.
MateText.REJECTED_THIN = {
	female = "She turns away and walks off. She will not take a male this thin. A visitor may come again tomorrow.",
	male = "He turns away from a female this thin and walks off. A visitor may come again tomorrow.",
}
MateText.REJECTED_CLUMSY = {
	female = "She turns away and walks off: the courtship faltered. A visitor may come again tomorrow.",
	male = "He turns away and walks off: the courtship faltered. A visitor may come again tomorrow.",
}
MateText.REJECTED_CHOOSY = {
	female = "She watches, then turns away and walks off. Not every female takes a male. A visitor may come again tomorrow.",
	male = "He watches, then turns away and walks off. Not every male stays. A visitor may come again tomorrow.",
}
MateText.CUT = "The other spider pushed in, and the visitor fled the sill for today."
function MateText.rejected(sex: string, why: string): string
	local t = if why == "thin" then MateText.REJECTED_THIN elseif why == "choosy" then MateText.REJECTED_CHOOSY else MateText.REJECTED_CLUMSY
	return if sex == "female" then t.female else t.male
end

-- Why the mate left the sill, as a notice (the reasons Predator/Mate gives); "mated" is said by MATED already.
function MateText.gone(reason: string): string?
	if reason == "dusk" then return "The visitor has gone for the evening. It may come back in the morning." end
	if reason == "rest" then return "The visitor wandered off while you rested." end
	if reason == "sex" then return "The visitor is not interested and leaves." end
	if reason == "driven" or reason == "rejected" or reason == "cut" then return nil end -- (told when it happened)
	return nil
end

-- The notice for an event of Mating.tick (and "sac" from Mating.woke), or nil when the event has no words. `ctx`: sex (the mate's), needsDance, device, reason.
function MateText.notice(event: string, ctx: { sex: string?, needsDance: boolean?, device: ControlText.Device?, reason: string? }): string?
	if event == "arrived" then return MateText.arrived(ctx.sex or "male", ctx.needsDance == true, ctx.device or "keyboard") end
	if event == "noticed" then return MateText.NOTICED end
	if event == "driven" then return MateText.DRIVEN end
	if event == "courted" then return MateText.COURTED end
	if event == "mated" then return MateText.MATED end
	if event == "gone" then return MateText.gone(ctx.reason or "") end
	if event == "sac" then return MateText.SAC end
	if event == "guard_day" then return MateText.GUARD_DAY end
	if event == "hatched" then return MateText.HATCHING end
	if event == "rejected_thin" then return MateText.rejected(ctx.sex or "male", "thin") end
	if event == "rejected_clumsy" then return MateText.rejected(ctx.sex or "male", "clumsy") end
	if event == "rejected_choosy" then return MateText.rejected(ctx.sex or "male", "choosy") end
	if event == "cut" then return MateText.CUT end
	return nil
end

-- The status line while a mate is on the sill and courtable: what the meter wants. `near`: within courting range; `dancing`: the peacock spider's dance is up.
function MateText.courtLine(device: ControlText.Device, near: boolean, needsDance: boolean, dancing: boolean, percent: number): string
	if not near then return "A visitor is on the sill. Walk close to it." end
	if needsDance and not dancing then
		return `Courting: dance in front of it ({ControlText.name(device, "display")})`
	end
	local p = math.floor(math.clamp(percent, 0, 1) * 100 + 0.5)
	return `Courting {p}%: face it and keep still`
end

-- The status line while the sac is guarded: guard day `day` of `days`.
function MateText.guardLine(day: number, days: number): string
	return `Guarding the eggs: day {day} of {days}. Rest in the crack to pass the nights.`
end

-- The captions of the mating scene (ROBLOX-89; Settings: Captions), by the scene's seconds. Device-neutral (nothing here names a button). `playerSex` is the played spider's:
-- the first spider is the game's female ("She turns to face him."), the peacock spider the male ("She turns to face you."). The last beat is the mirror when the player is
-- the male: the female turns away and stays, and the player goes on. The game is for children and about nature: they touch, they settle, one goes.
MateText.SCENE_TURN_FEMALE = "She turns to face him."
MateText.SCENE_TURN_MALE = "She turns to face you."
MateText.SCENE_TOUCH = "They touch, very lightly, with their front legs and palps."
MateText.SCENE_SETTLE = "They settle together, still."
MateText.SCENE_GOES = "He goes. The sill is yours again."
MateText.SCENE_STAYS = "She stays. You go on."
function MateText.matingCaption(seconds: number, playerSex: string): { text: string, alpha: number }?
	if seconds < 0 then return nil end
	local text: string
	if seconds < 3 then text = if playerSex == "male" then MateText.SCENE_TURN_MALE else MateText.SCENE_TURN_FEMALE
	elseif seconds < 7 then text = MateText.SCENE_TOUCH
	elseif seconds < 11 then text = MateText.SCENE_SETTLE
	elseif seconds < 15 then text = if playerSex == "male" then MateText.SCENE_STAYS else MateText.SCENE_GOES
	else return nil end
	return { text = text, alpha = 1 }
end

-- The notebook's dated line for the page "Eggs, silk and wind" (a thing the player saw; ROBLOX-89): the day, and who came.
function MateText.entry(day: number, mateSex: string): string
	if mateSex == "female" then
		return `Day {day}: A female was on the sill. The two spiders stayed together a while, and then you went on.`
	end
	return `Day {day}: A male came to the sill. The two spiders stayed together a while, and then he went.`
end
-- The captions of the hatching scene, by the seconds since it began.
function MateText.sceneCaption(seconds: number): { text: string, alpha: number }?
	if seconds < 0 then return nil end
	if seconds < 9 then return { text = "[tiny rustling from the egg sac]", alpha = 1 } end
	if seconds < 24 then return { text = "[silk threads lift the spiderlings away]", alpha = 1 } end
	return nil
end

-- The ending card: the title, the line about the generation and the body (the brood, the day). `brood` is the number of spiderlings that hatched.
-- ROBLOX-120: in the preserve (`wind`) the body offers the two ways on: follow one on the wind, or stay at the hut as one of them.
function MateText.card(brood: number, day: number, generation: number, wind: boolean?): (string, string, string)
	local sub = `{brood} spiderlings hatched on day {day}, climbed into the light and floated away on silk, one by one.`
	local body = if wind == true then `You were generation {generation + 1}. Follow one of them on the wind to wherever it comes down, or stay at the hut as one of them, small again in the same crack.`
		else `You were generation {generation + 1}. You carry on as one of them, small again, in the same crack on the same sill.`
	return MateText.TITLE, sub, body
end
-- (ROBLOX-120) The card's two ways on in the preserve (Life/Ballooning), the ride's caption and the words where it lands.
MateText.FOLLOW = "Follow one"
MateText.STAY = "Stay at the hut"
MateText.RIDE_CAPTION = "[the wind takes the thread]"
function MateText.landed(place: string): string
	return `The thread came down in {place}. A new life begins here, in the wild.`
end
-- The notebook's dated line for "Eggs, silk and wind" when one was followed.
function MateText.rideEntry(day: number, place: string): string
	return `Day {day}: One spiderling went up on its thread, and the wind set it down in {place}.`
end

-- The toast of the new generation. `generation` is the number carryOn returns (1 for the first carry on); the first spider is generation 1. ROBLOX-120: `place`, where
-- it landed when it was followed on the wind (nil: it stayed at the hut).
function MateText.generationToast(generation: number, day: number, place: string?): string
	if place ~= nil then return `Generation {generation + 1} — hatched on day {day}, landed in {place}` end
	return `Generation {generation + 1} — hatched on day {day}`
end

-- The day line's tag ("" while the family is the first).
function MateText.dayTag(generation: number): string
	return if generation > 0 then ` | Generation {generation + 1}` else ""
end

return MateText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="153">
          <Properties>
            <string name="Name">NotebookText</string>
            <string name="Source"><![CDATA[--!strict
-- The notebook's words and its layout rules for the screen (ROBLOX-37), from Godot's notebook_panel.gd: the heading, the empty
-- page, "In this game:" and the sources, the note that a page opened, and how to open and use the book on the device in use. Pure,
-- so tests/notebook.luau checks them (and the layout at phone, tablet and desktop sizes) without Roblox. Button names come from
-- ControlText (PlayStation names on a PlayStation controller).
local ControlText = require(script.Parent.ControlText)
local TarantulaText = require(script.Parent.TarantulaText)

local NotebookText = {}

NotebookText.HEADING = "Field notebook"
NotebookText.EMPTY = "Pages appear here as you play."
NotebookText.GAME = "In this game: "
NotebookText.CLOSE = "Close"
NotebookText.PAGES = "Pages"
NotebookText.MENU_CHOICE = "Notebook"
NotebookText.BUTTON = "Notebook"

-- Fills {reel}, {letGo}, {drop}, {focus}, {display} (any ControlText action name) in a page's "In this game" line with the device's name for it. {display} is the
-- display key (ROBLOX-92: the tarantula page's rear-up); on touch its button is the tarantulas' own, "Rear up", not the peacock's "Dance".
function NotebookText.fill(text: string, device: ControlText.Device): string
	local out = string.gsub(text, "{(%w+)}", function(action: string): string
		local name = if action == "display" and device == "touch" then TarantulaText.touchDisplay(false) else ControlText.name(device, action)
		return if name ~= "" then name else "{" .. action .. "}"
	end)
	return out
end

-- The page's "In this game: ..." line, or nil when the page has none (Godot: an empty `game` shows nothing).
function NotebookText.gameLine(game: string, device: ControlText.Device): string?
	if game == "" then
		return nil
	end
	
	return NotebookText.GAME .. NotebookText.fill(game, device)
end

-- ROBLOX-89: the lines the game has added to a page ("Day 4: ..."), under the page's "In this game" line, or nil when there are none.
NotebookText.SEEN = "Things you saw:"
function NotebookText.seenText(entries: { { day: number, text: string } }): string?
	if #entries == 0 then return nil end
	local lines = { NotebookText.SEEN }
	for _, e in entries do table.insert(lines, e.text) end
	return table.concat(lines, "\n")
end

-- "Source: x" for one source, "Sources:\nx\ny" for several. The links stay in the text as they are.
function NotebookText.sourcesText(sources: { string }): string
	return (if #sources == 1 then "Source: " else "Sources:\n") .. table.concat(sources, "\n")
end

-- How to open the notebook, on the device in use: N on a keyboard; the Notebook button on touch; a controller has no spare button (the
-- D-pad walks), so it is the life menu (View, or the Touchpad on a PlayStation controller) and then Notebook.
function NotebookText.openHint(device: ControlText.Device): string
	if device == "gamepad" then
		return `{ControlText.name("gamepad", "menu")}, then {NotebookText.MENU_CHOICE},`
	elseif device == "touch" then
		return `the {NotebookText.BUTTON} button`
	end
	return ControlText.name("keyboard", "notebook")
end

-- The note when a page opens during play (Godot: "New in your notebook: %s\n(%s to read)").
function NotebookText.note(title: string, device: ControlText.Device): string
	return `New in your notebook: {title}\n({NotebookText.openHint(device)} to read)`
end

-- The line under the page: what the controls do, on the device in use. `stacked`: one pane at a time (small screens).
function NotebookText.controls(device: ControlText.Device, stacked: boolean): string
	local back = ControlText.name(device, "cancel")
	if device == "gamepad" then
		local a = ControlText.name("gamepad", "jump")
		return `Stick or D-pad: pages    {a}: open    Right stick: scroll    {back}: {if stacked then "back / close" else "close"}`
	elseif device == "touch" then
		return `Tap a page. Drag to scroll.`
	end
	return `Up and Down: pages    {if stacked then "Enter: open    Left and Right: previous and next    " else ""}Wheel, PageUp or PageDown: scroll    N or {back}: close`
end

-- ---------------------------------------------------------------- layout

-- Text sizes by kind at normal text, and the large-text option's factor (the life menu's switch: the Player attribute LargeText).
NotebookText.SIZES = { heading = 26, title = 24, body = 19, game = 17, sources = 14, button = 18, controls = 14 }
NotebookText.LARGE = 1.5
-- A touch target is at least this tall (before the text scale).
NotebookText.MIN_TARGET = 44

export type Layout = { sideBySide: boolean, listFraction: number }

-- Side by side (the pages on the left, the page on the right) needs room; a phone held sideways, a portrait phone or large text
-- show one pane at a time instead. `width` and `height` are the safe area's, `scale` the text scale (1 to LARGE).
function NotebookText.layout(width: number, height: number, scale: number): Layout
	local sideBySide = width >= 640 * scale and height >= 340
	return { sideBySide = sideBySide, listFraction = if sideBySide then 0.34 else 1.0 }
end

export type Metrics = { paperW: number, paperH: number, head: number, hint: number, foot: number, body: number }

-- Pixel sizes of the panel for a safe area of this size: the paper (97% by 95%, at most 1040 by 820), the heading band, the controls
-- line (two lines of text; 0 when the pages would be left with less than MIN_BODY px without it), the footer's buttons and the height
-- left for the pages (what scrolls). Pure, so a short screen can be checked: a phone held sideways is 568 by 320.
NotebookText.MIN_BODY = 120
function NotebookText.metrics(width: number, height: number, scale: number): Metrics
	local paperW, paperH = math.min(width * 0.97, 1040), math.min(height * 0.95, 820)
	local head = math.floor((NotebookText.SIZES.heading + 10) * scale)
	local foot = math.floor((NotebookText.MIN_TARGET + 8) * scale)
	local hint = math.floor(5 * NotebookText.SIZES.controls * scale) + 4
	local body = paperH - 20 - head - foot - 12
	if body - hint >= NotebookText.MIN_BODY then
		body -= hint
	else
		hint = 0
	end
	return { paperW = paperW, paperH = paperH, head = head, hint = hint, foot = foot, body = body }
end


-- Nathan requested an optional checklist on 2026-10-17 (ROBLOX-38).
-- These are invitations, not all possible pages or a completion gate. No task asks a child to starve or get caught.
NotebookText.TRY = {
 {id="bold_jumper",text="Meet your spider and explore the sill."},
 {id="dragline",text="Make a jump and see the safety silk."},
 {id="eight_eyes",text="Switch to the spider-eye view."},
 {id="moving_retinas",text="Spend a little time looking through its eyes."},
 {id="hunting_by_sight",text="Focus on a fly until you recognise it."},
 {id="venom",text="Catch a fly."},
 {id="drinking",text="Finish a meal."},
 {id="retreat",text="Rest inside the silk-lined crack."},
 {id="home_before_dark",text="Sleep in the crack through a night."},
 {id="new_skin",text="Eat, then rest when ready to moult."},
 {id="grown_up",text="Grow through three moults."},
 {id="peacock_dance",text="Change to the peacock (in Settings, or while resting), then dance outside."},
 {id="walking_like_an_ant",text="Change to the ant mimic (in Settings, or while resting), then stand still."},
 {id="eggs_and_wind",text="Raise a family: court a mate, guard the sac, watch the hatching."},
 {id="tarantula_cousins",text="Change to a tarantula (in Settings, or while resting), then rear up outside."},
}
function NotebookText.checklist(book:any):string
 local lines={}
 for _,entry in NotebookText.TRY do
  table.insert(lines,(if book:isOpen(entry.id) then "[x] " else "[ ] ")..entry.text)
 end
 return table.concat(lines,"\n\n")
end

return NotebookText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="154">
          <Properties>
            <string name="Name">PeacockText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of the peacock spider for the screen (ROBLOX-31): choosing the spider in the crack, the dance's prompts and status
-- line, the controls card's extra lines and the felt caption. Button names come from ControlText for the device in use. The dance's
-- own words are never shown for the first spider; choosing is offered in the crack to both, or the peacock spider could not be found.
-- Pure: checked in tests/peacock.luau.
local ControlText = require(script.Parent.ControlText)
local Peacock = require(script.Parent.Parent.Data.Peacock)
local SpiderChoice = require(script.Parent.Parent.Rig.SpiderChoice)
local AntMimicText = require(script.Parent.AntMimicText)
local TarantulaText = require(script.Parent.TarantulaText)

local PeacockText = {}

PeacockText.NAMES = {
	first_spider = "the first spider", maratus_volans_male = "the peacock spider", myrmarachne_formicaria_female = "the ant-mimicking spider",
	brachypelma_hamorii = "the Mexican redknee", chromatopelma_cyaneopubescens = "the Greenbottle blue",
} :: { [string]: string }
PeacockText.STAND = "Stand still on a surface to dance"
PeacockText.NOT_RESTING = "You can change spider while resting in the silk-lined crack"
-- The Settings row's refusal (ROBLOX-71): the spider stays as it was. Said as a toast and on the panel's own line.
PeacockText.NOT_NOW = "Your spider will not change now. Stand safely on a surface first"

-- A spider's name for a row or a button: the name, with its first letter capital.
function PeacockText.title(id: string): string
	local name = PeacockText.NAMES[id] or id
	return string.upper(string.sub(name, 1, 1)) .. string.sub(name, 2)
end

-- The controls card's pointer to the Settings row (ROBLOX-71): where to open it on the device in use.
function PeacockText.settingsLine(device: ControlText.Device): string
	if device == "gamepad" then return `Spider: change it in Settings ({ControlText.name("gamepad", "menu")}, then Settings)` end
	if device == "touch" then return "Spider: change it in Menu, then Settings" end
	return `Spider: change it in Settings ({ControlText.name(device, "settings")}) when standing safe`
end

-- The crack's extra hint while resting: how to become the other spider.
function PeacockText.change(device: ControlText.Device, current: string): string
	local other = SpiderChoice.next(current)
	return `{ControlText.name(device, "choose")}: become {PeacockText.NAMES[other] or other}`
end

function PeacockText.changed(id: string): string
	return `You are {PeacockText.NAMES[id] or id} now`
end

-- The walking hint's extra words for the peacock spider.
function PeacockText.displayHint(device: ControlText.Device, dancing: boolean): string
	if dancing then return `{ControlText.name(device, "display")}: stop dancing` end
	return `{ControlText.name(device, "display")}: courtship dance`
end

-- The status line while the dance runs.
function PeacockText.dancingLine(device: ControlText.Device): string
	return `COURTSHIP DANCE    {ControlText.name(device, "display")} or move: stop`
end

-- The touch buttons' words.
function PeacockText.touchChange(): string return "Change" end
function PeacockText.touchDisplay(dancing: boolean): string return if dancing then "Stop" else "Dance" end

-- The card's line for the crack (ROBLOX-92): changing spider and, folded in, the close look (ROBLOX-90: the same key held 0.6 s). On touch the key is the Change button's own
-- label, so it is "tap Change", not "Change change spider".
function PeacockText.crackLine(device: ControlText.Device): string
	local choose = ControlText.name(device, "choose")
	if device == "touch" then return `In the crack: tap {choose} to change spider; hold: look closely` end -- (ROBLOX-110: one line at the card's width, so the lock's line fits in ten)
	return `In the crack: {choose} change spider (hold {choose}: look closely)`
end

-- Lines added to the controls card (H): the crack's choice for every spider and the close look, the pointer to the Settings row (ROBLOX-71), then the display key's line for the spider that has one:
-- `display` is "dance" (the peacock spider), "antennae" (the ant-mimicking spider), "threat" (the tarantulas), nil (the first spider). true means "dance" and false nil.
function PeacockText.helpExtra(device: ControlText.Device, display: (string | boolean)?): string
	local kind: string? = if display == true then "dance" elseif type(display) == "string" then display else nil
	local lines = { PeacockText.crackLine(device), PeacockText.settingsLine(device) }
	if kind == "dance" then
		local key = ControlText.name(device, "display")
		table.insert(lines, `{key}{if device == "touch" then " button:" else ""} courtship dance (any move, jump or Cancel stops it)`)
	elseif kind == "antennae" then
		table.insert(lines, AntMimicText.helpLine(device))
	elseif kind == "threat" then
		table.insert(lines, TarantulaText.helpLine(device))
	end
	return "\n" .. table.concat(lines, "\n")
end

-- The whole controls card the HUD shows (and the Studio spec measures): the device's own bindings, then the crack's line, the Settings pointer and the display key's line.
-- ROBLOX-92: this one string is what is on the screen; the close look's hint is inside the crack's line, not a line of its own.
function PeacockText.card(device: ControlText.Device, display: (string | boolean)?, runAvailable: boolean?, lockAvailable: boolean?): string
	return ControlText.helpCard(device, runAvailable, lockAvailable) .. PeacockText.helpExtra(device, display)
end

-- The felt caption while a rumble-rump is on: { text, alpha }, or nil when there is none. The vibration is felt through the feet, not seen.
function PeacockText.caption(rumble: number): { text: string, alpha: number }?
	if rumble <= 0.02 then return nil end
	return { text = Peacock.feltCaption, alpha = math.clamp(rumble, 0, 1) }
end

return PeacockText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="155">
          <Properties>
            <string name="Name">PerceptionShapes</string>
            <string name="Source"><![CDATA[--!strict
-- PerceptionShapes: the geometry the perception HUD draws with (ROBLOX-20, the drawer's polish), pure. A last-seen ring is 12 short
-- bars along a circle, an off-screen cue's chevron is two bars, the Focus ticks are four, and a label hangs under the ring it
-- names. Client/PerceptionHud draws each bar as a thin rounded Frame; nothing here reads the engine, so tests/hud.luau checks every
-- rule. What is drawn, its words, opacities and timings are PerceptionView's and are not touched here.
-- Pixels, screen y down; a rotation is in degrees, clockwise, as GuiObject.Rotation.
local Shapes = {}

-- A thin bar: centred on (x, y), `length` long. `rotation` turns a horizontal bar clockwise to lie along it (a bar looks the same
-- turned half a turn, so it is kept in -90 to 90).
export type Bar = { x: number, y: number, length: number, rotation: number }

local function axis(deg: number): number
	return (deg + 90) % 180 - 90
end

-- A last-seen ring (PerceptionView kind "mark") is DASHES dashes at equal steps, the first at the top. `dash` (PerceptionView: 1
-- when the sighting is fresh, 0.3 when it is as stale as it gets) says how much of its step each dash covers, up to DASH_FILL, so
-- the gaps grow as the sighting ages. A dash is straight with both ends on the circle, never shorter than MIN_DASH pixels.
Shapes.DASHES = 12
Shapes.DASH_FILL = 0.85
Shapes.MIN_DASH = 2

function Shapes.dashRing(cx: number, cy: number, radius: number, dash: number): { Bar }
	local step = 2 * math.pi / Shapes.DASHES
	local half = step * Shapes.DASH_FILL * math.clamp(dash, 0, 1) * 0.5 -- half the angle a dash covers
	local length = math.max(2 * radius * math.sin(half), Shapes.MIN_DASH)
	local reach = radius * math.cos(half) -- the middle of a chord lies a little inside the circle
	local out: { Bar } = {}
	for i = 0, Shapes.DASHES - 1 do
		local a = -math.pi / 2 + i * step
		out[i + 1] = { x = cx + math.cos(a) * reach, y = cy + math.sin(a) * reach, length = length, rotation = axis(math.deg(a) + 90) }
	end
	return out
end

-- An off-screen cue's chevron, pointing along the unit direction (dx, dy) from the middle of the screen out to the edge: two arms of
-- CHEVRON_ARM pixels meeting at the tip, each lying CHEVRON_SPREAD degrees back from that direction. It is centred on (x, y)
-- along its direction, which is where the mark sits on the edge.
Shapes.CHEVRON_ARM = 15
Shapes.CHEVRON_SPREAD = 40

function Shapes.chevron(x: number, y: number, dx: number, dy: number): { Bar }
	local arm, spread = Shapes.CHEVRON_ARM, math.rad(Shapes.CHEVRON_SPREAD)
	local heading = math.atan2(dy, dx)
	local depth = arm * math.cos(spread) -- how far the arms reach back from the tip
	local tx, ty = x + math.cos(heading) * depth * 0.5, y + math.sin(heading) * depth * 0.5
	local out: { Bar } = {}
	for i, side in { -1, 1 } do
		local back = heading + math.pi + side * spread
		out[i] = { x = tx + math.cos(back) * arm * 0.5, y = ty + math.sin(back) * arm * 0.5, length = arm, rotation = axis(math.deg(back)) }
	end
	return out
end

-- The Focus ticks around the middle (cx, cy): four short bars, each lying along the line out from the middle, FOCUS_RADIUS pixels
-- out (their middles) and FOCUS_LENGTH long.
Shapes.FOCUS_RADIUS = 11
Shapes.FOCUS_LENGTH = 10

function Shapes.focusTicks(cx: number, cy: number): { Bar }
	local out: { Bar } = {}
	for i = 0, 3 do
		local a = i * math.pi / 2
		out[i + 1] = { x = cx + math.cos(a) * Shapes.FOCUS_RADIUS, y = cy + math.sin(a) * Shapes.FOCUS_RADIUS, length = Shapes.FOCUS_LENGTH, rotation = axis(math.deg(a)) }
	end
	return out
end

-- The lock's cue (ROBLOX-110): four short ticks on the diagonals round the locked thing's place on screen, fainter and wider than Focus's, so
-- the two never read as one. The only thing the lock draws.
Shapes.LOCK_RADIUS = 22
Shapes.LOCK_LENGTH = 7
Shapes.LOCK_ALPHA = 0.6 -- (0.45 all but vanished on the sunlit floor in the mock of ROBLOX-110; the dark edge at 0.6 reads on light and dark ground)
function Shapes.lockTicks(cx: number, cy: number): { Bar }
	local out: { Bar } = {}
	for i = 0, 3 do
		local a = math.pi / 4 + i * math.pi / 2
		out[i + 1] = { x = cx + math.cos(a) * Shapes.LOCK_RADIUS, y = cy + math.sin(a) * Shapes.LOCK_RADIUS, length = Shapes.LOCK_LENGTH, rotation = axis(math.deg(a)) }
	end
	return out
end

-- Where a label's top middle goes. (px, py) is the middle of the ring it names and `offset` PerceptionView's gap from there to the
-- label (the ring's radius and 8). Under the ring, unless the screen has no room for LABEL_HEIGHT pixels there, then above it. When
-- the label's width is known (> 0) it is kept LABEL_MARGIN pixels inside the screen sideways. Returns x, y and whether it is below.
Shapes.LABEL_HEIGHT = 28
Shapes.LABEL_MARGIN = 8

function Shapes.labelAt(px: number, py: number, offset: number, width: number, viewportW: number, viewportH: number): (number, number, boolean)
	local below = py + offset + Shapes.LABEL_HEIGHT <= viewportH - Shapes.LABEL_MARGIN
	local y = if below then py + offset else py - offset - Shapes.LABEL_HEIGHT
	local x = px
	if width > 0 then
		local half = width * 0.5 + Shapes.LABEL_MARGIN
		x = math.clamp(px, math.min(half, viewportW * 0.5), math.max(viewportW - half, viewportW * 0.5))
	end
	return x, y, below
end

return Shapes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="156">
          <Properties>
            <string name="Name">PerceptionText</string>
            <string name="Source"><![CDATA[--!strict
-- Frozen perception_text.gd: words belong to presentation, never the sensor.
local Text = {}
local names = {movement="movement", possible_prey="possible prey", fly_like_prey="fly-like prey"}
function Text.category(category: string): string
	return (names :: {[string]: string})[category] or "movement"
end
function Text.hasNumber(text: string): boolean return string.find(text, "[%d%%]") ~= nil end
Text.LOST = "lost sight"
return table.freeze(Text)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="157">
          <Properties>
            <string name="Name">PerceptionView</string>
            <string name="Source"><![CDATA[--!strict
-- Pure build_view from perception_hud.gd. Only memory and a camera adapter enter; never world actors.
local Text = require(script.Parent.PerceptionText)
local View = {}
function View.edgeFade(age: number): number
	if age < 0 or age >= 1.4 then return 0 end
	local t = math.clamp(age / 0.12, 0, 1)
	return t*t*(3-2*t) * (1-age/1.4)^1.5
end
function View.build(memory: any, camera: any, showMark: boolean?): any
	local out: any = {edges={}, rings={}, labels={}}
	local sectors: {[number]: any} = {}
	for _, c in memory:contacts() do
		if c.cueCount > 0 and c.cueDirection.Magnitude > 0.7 and not c:isInspectedNow() then
			local alpha = 0.6 * View.edgeFade(memory:cueAgeS(c))
			if alpha > 0 then
				local e = camera.edge(c.cueDirection)
				e.alpha, e.trackId = alpha, c.trackId
				local sector = math.floor(math.atan2(c.cueDirection.X, c.cueDirection.Z) / (math.pi/8) + 0.5)
				if not sectors[sector] or sectors[sector].alpha < alpha then sectors[sector] = e end
			end
		end
		if not c.hasPosition then continue end
		local point, visible, radius = camera.project(c.position, c.sizeWu)
		if not visible then continue end
		if c:isInspectedNow() then
			table.insert(out.rings, {pos=point, radius=radius, alpha=0.85, dash=1, kind="live", trackId=c.trackId})
			table.insert(out.labels, {pos=point, offset=radius+8, text=Text.category(c.category), alpha=1})
		elseif c:hasMark() then
			local stale = memory:stalenessOf(c)
			local covered = camera.covered(c.position, math.max(c.sizeWu, 0.2)*0.5+0.06)
			if showMark ~= false then
				table.insert(out.rings, {pos=point, radius=radius, alpha=(0.6-0.48*stale)*(if covered then 0.6 else 1),
					dash=1-0.7*stale, kind="mark", trackId=c.trackId})
			end
			local age = memory:ageS(c)
			if age < 2.5 then table.insert(out.labels, {pos=point, offset=radius+8, text=Text.LOST, alpha=math.clamp(1-age/2.5,0,1)}) end
		end
	end
	for _, e in sectors do table.insert(out.edges, e) end
	return out
end
return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="158">
          <Properties>
            <string name="Name">PreyText</string>
            <string name="Source"><![CDATA[--!strict
-- What the screen says when a prey gets out of the jaws by its own trick (ROBLOX-101, Prey/PreyKinds.grip, kept by Prey/PreyWorld as `event`): a moth whose
-- scales came away in the fangs, a crane fly that left a leg. One short note each, shown as the notebook's notes are. Pure; checked in tests/garden_life.luau.
-- ROBLOX-105: and when a strike comes within something that is not food (Prey/PreyWorld.strikeAmbient: { kind = "refused", prey = kind }): the spider lets it
-- go, and the note says why in a few words, each reason from the kind's notebook page and its sources (docs/NOTEBOOK_SOURCES.md).
local PreyText = {}

PreyText.NOTES = {
	slip = "The moth slipped free, leaving scales in your fangs.",
	shed = "The crane fly left a leg in your fangs and got away.",
} :: { [string]: string }

-- (ROBLOX-105) Why a strike at each kind of thing that is not food came to nothing.
PreyText.REFUSED = {
	ladybird = "A foul fluid wells from the ladybird's leg joints. You let it go.",
	millipede = "The millipede coils tight, armour out, and smells foul. You let it go.",
	snail = "The snail is far too big, and it has drawn into its shell.",
	harvestman = "The harvestman gives off a foul smell and stalks on. You let it go.",
	ant = "The ant turns on you, jaws open. You let it go.", -- (ROBLOX-119: the meadow's ants)
	skater = "The water strider skates off over the water, out of reach.", -- (ROBLOX-122: the pond's water striders)
	woodlouse = "The woodlouse's glands give off a secretion spiders avoid. You let it go.",
} :: { [string]: string }

-- (ROBLOX-120) The field cricket's song, captioned (the Captions setting) when the nearest singing cricket (Prey/PreyKinds.chirping) is within CHIRP_HEAR studs of the
-- spider; `direction` UI/WaspText.directionWord's. How loud it is to the spider: 1 at the cricket, nothing at CHIRP_HEAR.
PreyText.CHIRP_HEAR = 400
function PreyText.chirp(direction: string, loud: number): { text: string, alpha: number }
	return { text = `[a cricket chirping, {direction}]`, alpha = math.clamp(0.35 + loud, 0, 1) }
end

-- How long a note stays (seconds).
PreyText.SECONDS = 4

-- The note for an event ({ kind = "slip" | "shed" | "refused", prey = kind }), or nil for one this table does not know.
function PreyText.note(event: any): string?
	if type(event) ~= "table" then return nil end
	if event.kind == "refused" then return PreyText.REFUSED[event.prey] end
	return PreyText.NOTES[event.kind]
end

return PreyText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="159">
          <Properties>
            <string name="Name">QuietHud</string>
            <string name="Source"><![CDATA[--!strict
-- The quiet HUD (ROBLOX-113, W5 of docs/OPEN_WORLD_DESIGN.md): what the screen may say in Normal. Nathan: "minimal HUD", "no hand holding", "Normal mode should feel
-- like it doesn't want you to survive". Every string the game can put on the screen during play is one of the kinds below, and each kind has a class:
--
--   needed   always shown: the hunger bar, the day line, what the senses report (the sound captions), the answer to a press, a state the world cannot show
--   day_one  in Normal only on the life's first day (the first day of a new life, or of a spiderling's generation); the gentle modes always
--   gentle   never in Normal; Easy and Free play as before
--   removed  never shown in any mode (none at present: the gentle modes keep every word they had)
--
-- Easy and Free play keep their helpfulness: in the gentle rules every kind shows, as it did. The player's own settings still apply on top ("Show control hints",
-- Captions, "Show what the spider notices", the notebook's notes). Nothing is added for the garden: the day line does not name the region (the decision is
-- ROBLOX-113's: the regions are seamless, their names are the map's, and a label on the world is what Nathan's minimal HUD leaves out).
-- The perception HUD's labels are calmed here too (`calmLabels`): one at a time in an area of the screen, the newest winning, and "lost sight" gone in a breath.
-- Pure: checked in tests/quiet.luau, which also drives the real client. docs/HUD_AUDIT.md lists every string with its kind.
local QuietHud = {}

export type Class = "needed" | "day_one" | "gentle" | "removed"
export type Context = { normal: boolean, dayOne: boolean }

QuietHud.game = {
	labelAreaPx = 120, -- two perception labels whose rings are closer than this on the screen are one area: only one is drawn
	lostSeconds = 1.0, -- "lost sight" fades out over this (the view's own fade is 2.5 s, Godot's; the calm makes it a breath)
}

-- Every kind of thing the play screen can say, its class, and where it shows (for the audit, docs/HUD_AUDIT.md, and the tests).
QuietHud.KINDS = {
	-- the top column: the hunger bar and the day box
	hunger = { class = "needed", where = "hunger bar", what = "Hunger 72% (· hungry, · starving, · gentle)" },
	day = { class = "needed", where = "day line", what = "Day 2, afternoon | Juvenile (| EASY, | FREE PLAY, | Generation 2)" },
	growth_count = { class = "needed", where = "day box", what = "Next moult: 2 of 5 meals; Ready to moult" },
	growth_rule = { class = "day_one", where = "day box", what = "· 3 gnats = 1 housefly; Ready to moult: rest in the crack.; Moulting: stay in the crack.; Adult: keep your hunger bar full." },
	starving_weak = { class = "needed", where = "day box", what = "Starving: your spider will not last another day. Too hungry to sleep; find food." },
	hunger_words = { class = "day_one", where = "day box", what = "Starving: your spider's reserve is gone. It must eat soon.; Hungry: time to hunt." },
	dusk_words = { class = "day_one", where = "day box", what = "Evening. Jumping spiders go into their silk retreat before dark.; It is dark, and your eyes reach only a little way. Home is ..." },
	soft_skin = { class = "gentle", where = "day box", what = "Soft new skin: slower steps and shorter jumps until it hardens." },
	notebook_note = { class = "needed", where = "day box", what = "New in your notebook: <page>" },
	notebook_open_hint = { class = "day_one", where = "day box", what = "(N to read)" },
	prey_note = { class = "needed", where = "day box", what = "The moth slipped free, leaving scales in your fangs.; A foul fluid wells from the ladybird's leg joints. You let it go. ..." },
	-- the top column: the status lines
	wasp_line = { class = "gentle", where = "status", what = "A deep hum outside: a wasp is coming ... Hide in the crack ...; The wasp has seen you! Get away ...; The wasp is leaving." },
	save_broken = { class = "needed", where = "status", what = "Saving is off" },
	court_line = { class = "gentle", where = "status", what = "A visitor is on the sill. Walk close to it.; Courting: dance in front of it (X); Courting 45%: face it and keep still" },
	skip_line = { class = "needed", where = "status", what = "Space or Q: part (the mating scene, once it can be skipped)" },
	guard_line = { class = "gentle", where = "status", what = "Guarding the eggs: day 1 of 2. Rest in the crack to pass the nights." },
	feeding_lines = { class = "day_one", where = "status", what = "Caught — tap Space to keep your grip; Feeding — move to stop; Meal paused — E to eat; Holding the rival — tap Space ...; Eating rival — stay still (2 meals)" },
	display_status = { class = "day_one", where = "status", what = "COURTSHIP DANCE    X or move: stop; ANTENNAE UP ...; THREAT DISPLAY ..." },
	focus_status = { class = "needed", where = "status", what = "FOCUS ON    Right mouse again to stop / Q (the Focus toggle setting)" },
	eye_status = { class = "day_one", where = "status", what = "SPIDER-EYE VIEW    V: back" },
	slow_status = { class = "needed", where = "status", what = "SLOW MOTION 50%    T: normal speed" },
	-- the top column: captions and notices
	eye_caption = { class = "day_one", where = "caption", what = "the spider-eye view's explanation, the first time it is opened" },
	sound_captions = { class = "needed", where = "caption", what = "[a deep, heavy hum outside, ahead-left, coming closer]; [a fine buzzing through your feet]; the mating and hatching scenes' captions (the Captions setting)" },
	notice = { class = "needed", where = "notice", what = "the life's notices not listed in NOTICES: Last rest kept.; Moulted: now a ...; the mate's and the rival's events; A cold night in the open ...; Your spider is an adult! ..." },
	-- toasts: what a jump or the line did (the kinds Motor and JumpInput report)
	["toast:refused"] = { class = "day_one", where = "toast", what = "Jump cancelled: too far or too high (the aim's words said it before the release)" },
	["toast:hop_refused"] = { class = "day_one", where = "toast", what = "No hop: nothing to land on ahead" },
	["toast:cancelled"] = { class = "day_one", where = "toast", what = "Jump cancelled" },
	["toast:out_of_bounds"] = { class = "needed", where = "toast", what = "Out of bounds: back to the last safe spot" },
	["toast:caught"] = { class = "day_one", where = "toast", what = "Caught by your line" },
	["toast:drop_walk"] = { class = "day_one", where = "toast", what = "To the edge, to let yourself down" },
	["toast:dropped"] = { class = "day_one", where = "toast", what = "Letting yourself down: hold F to lower, W to climb" },
	["toast:drop_refused"] = { class = "needed", where = "toast", what = "Nothing below to let yourself down into from here; This surface won't hold your silk; Couldn't get to the edge" },
	["toast:completed"] = { class = "day_one", where = "toast", what = "Holding on again. The line stays behind for a moment" },
	["toast:released"] = { class = "day_one", where = "toast", what = "You let go of the line" },
	["toast:lost"] = { class = "needed", where = "toast", what = "Your line came loose: its anchor is gone" },
	["toast:blocked"] = { class = "needed", where = "toast", what = "Can't reel in: something is in the way. Lower, or let go; Reeled in as far as it goes" },
	["toast:snagged"] = { class = "needed", where = "toast", what = "The line is caught on a second edge and can't be reeled in. Lower, or let go" },
	toast_answer = { class = "needed", where = "toast", what = "the answer to a press or a choice: You are the peacock spider now; Stand still on a surface to dance; the close look's refusals and framings; the save's status; the returns to a rest; Generation 2 — hatched on day 5; The dry leaf tip gave way ..." },
	-- the prompt panel at the bottom
	line_panel = { class = "day_one", where = "prompt", what = "On your line / W: reel in    S: lower    hold Q: let go" },
	line_cue = { class = "needed", where = "prompt", what = "Letting go... 40%; the line's blocks and snags" },
	edge_walk_hint = { class = "day_one", where = "prompt", what = "To the edge, to let yourself down    Q or move: stop" },
	rest_state = { class = "needed", where = "prompt", what = "Asleep in the silk-lined crack; Resting under the stone; Moulting in the silk-lined crack; Ready to moult (the titles)" },
	rest_prompt = { class = "day_one", where = "prompt", what = "The silk-lined crack / E: rest; the hints under the titles (Move, E or Q to wake; C: become ...; the display key)" },
	home_line = { class = "day_one", where = "prompt", what = "Home: the silk-lined crack / Walk through the silk-framed opening under the wooden roof, then stop to rest." },
	walk_hint = { class = "day_one", where = "prompt", what = "Tap Space: hop    hold Space: aim a leap    F: let yourself down on silk (and the setting Show control hints)" },
	controls_card_start = { class = "day_one", where = "card", what = "the controls card for 20 s at the start (and the setting Show control hints)" },
	controls_card_asked = { class = "needed", where = "card", what = "the controls card when asked for: H, or Menu then Controls" },
	close_look = { class = "needed", where = "prompt", what = "the close look's name line and its one line of controls (the player opened it)" },
	-- the words at the aim
	aim_title = { class = "needed", where = "aim", what = "Reachable; Out of reach: too far or too high; No surface in view" },
	aim_hint = { class = "day_one", where = "aim", what = "release to leap    Q: cancel the jump" },
	anchor_ok = { class = "day_one", where = "aim", what = "Safety line: anchored here" },
	anchor_warning = { class = "needed", where = "aim", what = "No safety line: this surface won't hold silk; No safety line: this jump needs more line than you have" },
	-- the perception HUD (its own setting, Show what the spider notices)
	perception = { class = "needed", where = "perception", what = "the rings, last-seen marks and edge chevrons; possible prey; fly-like prey; lost sight (one label to an area of the screen)" },
} :: { [string]: { class: Class, where: string, what: string } }

-- The life's notices (LifeLoop's, the mate's, the rival's, the client's own), line by line: a line matching `find` has the kind's class; `short` (a pattern with one
-- capture) is what Normal shows of it after the first day instead of the whole line. A line no entry matches is the kind `notice` (needed): so a new notice shows
-- until it is classified here. LifeLoop's words are Godot's and are not changed; only what is shown of them is.
QuietHud.NOTICES = {
	{ find = "^Ready to moult%. Rest in the silk%-lined crack%.", short = "^(Ready to moult%.)", class = "needed" },
	{ find = "^Moulting in the crack%.", class = "gentle" }, -- (the prompt's title says it: Moulting in the silk-lined crack)
	{ find = "^Morning, day %d+%. Rested through the night", class = "day_one" }, -- (the day line says it; the rest's kept line after it stays)
	{ find = "^Awake before morning", class = "day_one" },
	{ find = "^Returned to your last rest: the sill as it was when you rested", class = "gentle" }, -- (Normal's end card said what a return is)
	{ find = "^Another young spider, somewhere new on the sill", class = "day_one" },
	{ find = "^A visitor: ", short = "^(A visitor: [^.]*%.)", class = "needed" }, -- (not how to court: the notebook's page says that)
	{ find = "^Caught the rival! It fights back%.", short = "^(Caught the rival! It fights back%.)", class = "needed" },
	{ find = "^The rival goes still%.", short = "^(The rival goes still%.)", class = "needed" },
	{ find = "^It bit back!", short = "^(It bit back!)", class = "needed" },
	{ find = "^The other spider crouches to jump", class = "gentle" }, -- (its crouch and the spider's own alarm are the warning)
} :: { { find: string, short: string?, class: Class } }

-- The context for a frame: Normal (the standard rules: not Easy, not Free play) and whether it is the life's first day. `day` is the clock's day and `born` the
-- day before the generation began (0 for the first; Life/Mating.grace), as the wasp and the rival count a first day.
function QuietHud.context(rules: string, day: number, born: number?): Context
	return { normal = rules == "standard", dayOne = day - (born or 0) <= 1 }
end

-- Whether a class shows in this context.
function QuietHud.classShows(class: Class, ctx: Context): boolean
	if class == "removed" then return false end
	if not ctx.normal or class == "needed" then return true end
	if class == "day_one" then return ctx.dayOne end
	return false -- gentle
end

-- Whether a kind shows. An unknown kind shows (a new string is never silently hidden: tests/quiet.luau lists every kind the client asks for).
function QuietHud.shows(kind: string, ctx: Context): boolean
	local k = QuietHud.KINDS[kind]
	return k == nil or QuietHud.classShows(k.class, ctx)
end

-- Whether Normal's quiet is on now: the standard rules after the first day (every day_one and gentle kind is hidden).
function QuietHud.quiet(ctx: Context): boolean
	return ctx.normal and not ctx.dayOne
end

-- What a notice shows: each line by its entry in NOTICES (or as the kind `notice`), the lines kept joined; nil when nothing is left.
function QuietHud.notice(text: string?, ctx: Context): string?
	if text == nil or text == "" then return nil end
	local out: { string } = {}
	for line in string.gmatch(text, "[^\n]+") do
		local kept: string? = line
		for _, n in QuietHud.NOTICES do
			if string.find(line, n.find) then
				if not QuietHud.classShows(n.class, ctx) then
					kept = nil
				elseif n.short ~= nil and QuietHud.quiet(ctx) then
					kept = string.match(line, n.short) or line
				end
				break
			end
		end
		if kept ~= nil then table.insert(out, kept) end
	end
	return if #out > 0 then table.concat(out, "\n") else nil
end

-- The kind of a notice line ("notice" when no entry matches), for the audit and the tests.
function QuietHud.noticeKind(line: string): (Class, boolean)
	for _, n in QuietHud.NOTICES do
		if string.find(line, n.find) then return n.class, n.short ~= nil end
	end
	return "needed", false
end

-- The perception HUD's labels, calmed (Nathan saw three "lost sight" labels piled on the soil): "lost sight" fades over `lostSeconds` instead of the view's 2.5 s,
-- and in any area of the screen (rings closer than `labelAreaPx`) one label is drawn: a live one (what the principal eyes hold now) before a lost one, the newest
-- lost one before an older. `labels` is PerceptionView's list ({ pos, offset, text, alpha }); `lost` its "lost sight" words; `out` a list to fill (cleared first).
function QuietHud.calmLabels(labels: { any }, lost: string, out: { any }): { any }
	table.clear(out)
	local fade = 2.5 / QuietHud.game.lostSeconds -- (the view's alpha is 1 - age / 2.5: the age read back from it, run out over lostSeconds)
	local area = QuietHud.game.labelAreaPx
	-- the candidates, best first: the live ones in the view's order, then the lost ones, the newest first
	local order: { any } = {}
	local gone: { any } = {}
	for _, l in labels do
		if l.text ~= lost then
			table.insert(order, l)
		else
			local alpha = 1 - (1 - l.alpha) * fade
			if alpha > 0 then table.insert(gone, { pos = l.pos, offset = l.offset, text = l.text, alpha = alpha }) end
		end
	end
	if #gone > 1 then table.sort(gone, function(a: any, b: any): boolean return a.alpha > b.alpha end) end
	for _, l in gone do table.insert(order, l) end
	for _, l in order do
		local free = true
		for _, k in out do
			if (k.pos - l.pos).Magnitude < area then free = false; break end
		end
		if free then table.insert(out, l) end
	end
	return out
end

return QuietHud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="160">
          <Properties>
            <string name="Name">RivalText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of the brown rival's contest for the screen (ROBLOX-73): what the spider's strike did to a rival that had seen it coming. The
-- first line is the old line for a catch (a rival that had not noticed is caught outright, as before); the others are the new outcomes.
-- Pure: checked in tests/rival.luau and tests/client_rival.luau.
local RivalText = {}

RivalText.CAPTURED = "Caught the rival! It fights back. Tap to keep your grip."
-- ROBLOX-77: the rival must be subdued with the tapping grip before it can be eaten, and it can tear free.
RivalText.SUBDUED = "The rival goes still. Stay still to eat; worth two housefly meals."
RivalText.TORE = "The rival tore free of your fangs."
RivalText.TORE_GENTLE = "The rival tore free of your fangs. You are safe in this mode."
RivalText.SPRANG = "It sprang clear of your strike."
RivalText.COUNTER = "It bit back! Jump away!"
RivalText.COUNTER_GENTLE = "It bit back, but you are safe in this mode. Jump away!"

-- The line for a counter-bite: the gentle modes cost nothing and say so.
function RivalText.counter(gentle: boolean): string
	return if gentle then RivalText.COUNTER_GENTLE else RivalText.COUNTER
end

-- The status line while the caught rival is being eaten (ROBLOX-91): `meals` is what it is worth in housefly meals (Growth.mealsOf of its food), not a number written here.
function RivalText.eating(meals: number): string
	return `Eating rival — stay still ({meals} meals)`
end

-- The status line while the rival fights the grip: the fly's wording (Caught — tap Jump to keep your grip), in the rival's own words. `button` is
-- the name of the jump button on this device.
function RivalText.struggle(button: string): string
	return "Holding the rival — tap " .. button .. " to keep your grip"
end

-- The notice for the rival tearing free: it never harms the player, and the gentle modes say so.
function RivalText.tore(gentle: boolean): string
	return if gentle then RivalText.TORE_GENTLE else RivalText.TORE
end

-- The notice for a strike's outcome event ("captured", "sprang", "counter"), or nil for any other event.
function RivalText.strike(event: string, gentle: boolean): string?
	if event == "captured" then return RivalText.CAPTURED end
	if event == "sprang" then return RivalText.SPRANG end
	if event == "counter" then return RivalText.counter(gentle) end
	return nil
end

return RivalText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="161">
          <Properties>
            <string name="Name">SaveText</string>
            <string name="Source"><![CDATA[--!strict
-- The words about saving (ROBLOX-39): what the menu and a short toast say. Plain and honest: saved, saving, or off for this visit and why.
-- The reasons are SaveRules.REASONS. Pure; checked in tests/state_client.luau.
local SaveText = {}

SaveText.SAVED = "Your notebook and last rests are saved."
SaveText.SAVING = "Saving..."
SaveText.TROUBLE = "Having trouble saving. Your progress is kept for now and the game keeps trying."
SaveText.REST_REFUSED = "Your latest rest could not be saved online. It is kept for this visit; your earlier saved rest is unchanged."
SaveText.OFF = "Saving is off for this visit: your notebook and rests will last only until you leave."
SaveText.LOOKING = "Finding your saved game..."
SaveText.BACK = "Saving is back on."
-- ROBLOX-92: the client's saving broke (something in it raised): saving is off for the rest of the visit, and the game goes on. The one status line, and the menu's.
SaveText.BROKEN = "Saving is off"

SaveText.WHY = {
	offline = "The game could not reach its saving service.",
	no_api = "Saving is not available here.",
	load_failed = "Your saved game could not be read just now. It has not been changed, and the game keeps trying.",
	other_session = "Your game is open somewhere else, and this copy cannot save over it.",
	corrupt = "Your saved game could not be read, so it was left exactly as it is.",
	newer = "Your saved game was made by a newer version of this game, so it was left exactly as it is.",
	write_failed = "This visit could not be saved. Your earlier saved game is still kept.",
	rest_refused = SaveText.REST_REFUSED,
} :: { [string]: string }

local function because(reason: string?): string?
	if reason == nil then return nil end
	return SaveText.WHY[reason]
end

-- The line for the menu: one or two sentences.
function SaveText.menuLine(status: string?, reason: string?): string
	if status == "session" then
		local why = because(reason)
		return SaveText.OFF .. (if why then "\n" .. why else "")
	elseif status == "saving" then
		if reason == "rest_refused" then return SaveText.REST_REFUSED end
		return if reason == "write_failed" then SaveText.TROUBLE else SaveText.SAVING
	elseif status == "saved" then
		return SaveText.SAVED
	end
	return SaveText.LOOKING
end

-- The line for the menu once the client's own saving has broken (the server's word no longer matters: nothing more is sent).
function SaveText.brokenLine(): string
	return SaveText.OFF .. "\nSomething in the saving broke, so this visit will not be saved."
end

-- A short toast when the status changes, or "" when nothing needs saying (a plain saving/saved flicker is not announced).
function SaveText.toast(oldStatus: string?, oldReason: string?, status: string?, reason: string?): string
	local was: string = oldStatus or ""
	local now: string = status or ""
	local toSession = now == "session" and was ~= "session"
	local fromSession = was == "session" and (now == "saved" or now == "saving")
	local newTrouble = now == "saving" and reason == "write_failed" and was ~= "" and not (was == "saving" and oldReason == "write_failed")
	if now == "saving" and reason == "rest_refused" and not (was == "saving" and oldReason == "rest_refused") then return SaveText.REST_REFUSED end
	if toSession then
		local why = because(reason)
		return SaveText.OFF .. (if why then " " .. why else "")
	elseif fromSession then
		return SaveText.BACK
	elseif newTrouble then
		return SaveText.TROUBLE
	end
	return ""
end

return SaveText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="162">
          <Properties>
            <string name="Name">SettingsModel</string>
            <string name="Source"><![CDATA[--!strict
-- The settings as logic (ROBLOX-49): looking one up, cleaning a value, stepping it, saying it in words, putting everything back to the
-- defaults and carrying saved settings forward. Pure; the table itself is Shared/Data/SettingsSpec. Nothing here knows about Roblox, the
-- panel or the save: the panel (Client/SettingsPanel) and the save (Shared/Persistence/SaveProgress) both call these.
--
-- A value is clean when it has the kind's type and sits in its range. clean() never raises:
--   * an id this build does not know ................ dropped quietly (a newer build's setting must not break an older one)
--   * the wrong type, or a number that is not finite .. a problem (corruption, not a choice)
--   * a number outside the range ...................... clamped to it (a range may be tightened later; the value stays usable)
--   * a choice that is not an option .................. dropped quietly (an option may be removed later)
local SettingsSpec = require(script.Parent.Parent.Data.SettingsSpec)
local SpiderChoice = require(script.Parent.Parent.Rig.SpiderChoice)
local PeacockText = require(script.Parent.PeacockText)
local InspectText = require(script.Parent.InspectText)

local SettingsModel = {}

export type Value = boolean | number | string

local BY_ID: { [string]: SettingsSpec.Setting } = {}
local ORDER: { string } = {}
for _, s in SettingsSpec.LIST do
	BY_ID[s.id] = s
	table.insert(ORDER, s.id)
end

-- The live rows (ROBLOX-71) are not settings in the saved sense: they are found by spec() and listed in sections(), but ids(), defaults(), clean()
-- and get() know nothing of them, so nothing about them is ever saved, read from a save or put back by Reset. Each steps and speaks through
-- the part that owns it.
local LIVE_BY_ID: { [string]: SettingsSpec.Setting } = {}
for _, s in SettingsSpec.LIVE do LIVE_BY_ID[s.id] = s end
local LIVE_STEP: { [string]: (any, number, any) -> any } = {
	-- `owned` (nil now) is where the Game Pass answer goes when the add-ons are sold: SpiderChoice.locked skips what is not owned.
	Spider = function(current: any, dir: number, owned: any): string
		return SpiderChoice.step(SpiderChoice.start(current, nil), dir, owned)
	end,
	-- A button (ROBLOX-90): switching it is the whole act, so the value it steps to is only "true, it was pressed".
	Inspect = function(): boolean return true end,
}
local LIVE_TEXT: { [string]: (any) -> string } = {
	Spider = function(value: any): string return PeacockText.title(SpiderChoice.start(value, nil)) end,
	Inspect = function(): string return InspectText.BUTTON end,
}

SettingsModel.VERSION = SettingsSpec.VERSION

-- Steps that carry saved settings from version N to N + 1: { [N] = function(values) -> values }. None yet (version 1 is the first).
SettingsModel.MIGRATIONS = {} :: { [number]: ({ [string]: any }) -> { [string]: any } }

local function finite(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

-- ---------------------------------------------------------------- the table
function SettingsModel.ids(): { string }
	return table.clone(ORDER)
end

function SettingsModel.spec(id: string): SettingsSpec.Setting?
	return BY_ID[id] or LIVE_BY_ID[id]
end

-- Is this a live row (a choice the game drives, not a saved setting)?
function SettingsModel.live(id: any): boolean
	return type(id) == "string" and LIVE_BY_ID[id] ~= nil
end

function SettingsModel.known(id: any): boolean
	return type(id) == "string" and BY_ID[id] ~= nil
end

-- The rows of one section, in the table's order: the settings, then the live rows.
function SettingsModel.items(sectionId: string): { SettingsSpec.Setting }
	local out: { SettingsSpec.Setting } = {}
	for _, s in SettingsSpec.LIST do
		if s.section == sectionId then table.insert(out, s) end
	end
	for _, s in SettingsSpec.LIVE do
		if s.section == sectionId then table.insert(out, s) end
	end
	return out
end

function SettingsModel.sections(): { { id: string, title: string, items: { SettingsSpec.Setting } } }
	local out = {}
	for _, sec in SettingsSpec.SECTIONS do
		local items = SettingsModel.items(sec.id)
		if #items > 0 then table.insert(out, { id = sec.id, title = sec.title, items = items }) end
	end
	return out
end

function SettingsModel.default(id: string): Value?
	local s = BY_ID[id]
	return if s then s.default else nil
end

function SettingsModel.defaults(): { [string]: Value }
	local out: { [string]: Value } = {}
	for _, s in SettingsSpec.LIST do out[s.id] = s.default end
	return out
end

-- ---------------------------------------------------------------- cleaning
-- (clean value or nil, problem or nil). Both nil: the value is dropped quietly (see the header).
function SettingsModel.clean(id: any, value: any): (Value?, string?)
	if type(id) ~= "string" then return nil, "a setting without a name" end
	local s = BY_ID[id]
	if s == nil then return nil, nil end
	if s.kind == "toggle" then
		if type(value) ~= "boolean" then return nil, `setting {id} is not true or false` end
		return value, nil
	elseif s.kind == "slider" then
		if not finite(value) then return nil, `setting {id} is not a number` end
		return math.clamp(value :: number, s.min :: number, s.max :: number), nil
	else
		if type(value) ~= "string" then return nil, `setting {id} is not a choice` end
		for _, o in (s.options :: { SettingsSpec.Option }) do
			if o.id == value then return value, nil end
		end
		return nil, nil
	end
end

-- A value for a client's use: the clean one, else the default. `read(id)` gives whatever is held (a Player attribute) or nil.
function SettingsModel.get(read: (string) -> any, id: string): Value
	local s = BY_ID[id]
	if s == nil then error(`unknown setting {id}`) end
	local raw = read(id)
	if raw == nil then return s.default end
	local v = SettingsModel.clean(id, raw)
	if v == nil then return s.default end
	return v
end

-- Cleans a table of settings: (problems, clean copy). Unknown ids and values dropped quietly are left out of the copy.
function SettingsModel.cleanAll(raw: any, maxProblems: number?): ({ string }, { [string]: Value })
	local problems: { string } = {}
	local out: { [string]: Value } = {}
	if raw == nil then return problems, out end
	if type(raw) ~= "table" then return { "settings are not a table" }, out end
	local cap = maxProblems or 12
	for id, value in raw do
		local v, problem = SettingsModel.clean(id, value)
		if problem ~= nil then
			if #problems < cap then table.insert(problems, problem) end
		elseif v ~= nil then
			out[id] = v
		end
	end
	return problems, out
end

-- Carries settings written at `fromVersion` up to this build's VERSION. `steps` is for tests; the default is SettingsModel.MIGRATIONS.
function SettingsModel.migrate(values: { [string]: any }, fromVersion: number, steps: { [number]: ({ [string]: any }) -> { [string]: any } }?, toVersion: number?): { [string]: any }
	local table_ = steps or SettingsModel.MIGRATIONS
	local to = toVersion or SettingsModel.VERSION
	local out = values
	local v = fromVersion
	while v < to do
		local step = table_[v]
		if step ~= nil then out = step(table.clone(out)) end
		v += 1
	end
	return out
end

-- ---------------------------------------------------------------- changing
local function snap(s: SettingsSpec.Setting, x: number): number
	local step = s.step :: number
	local lo = s.min :: number
	local k = math.floor((x - lo) / step + 0.5)
	-- the grid's own value, rounded to the step's digits so 0.05 added three times is 0.15 and not 0.1500000001
	local digits = 0
	while digits < 6 and math.abs(step * 10 ^ digits - math.floor(step * 10 ^ digits + 0.5)) > 1e-9 do digits += 1 end
	local scale = 10 ^ digits
	return math.clamp(math.floor((lo + k * step) * scale + 0.5) / scale, lo, s.max :: number)
end

-- The value one step in `dir` (+1 or -1) from `current`: a live row steps as its owner says (the Spider row, skipping any spider that is locked); a toggle flips, a slider moves a step (and stays on its grid), a choice moves to the
-- next option and wraps. A current value that is not clean counts as the default.
function SettingsModel.step(id: string, current: any, dir: number, owned: { [string]: boolean }?): Value
	local stepLive = LIVE_STEP[id]
	if stepLive ~= nil then return stepLive(current, dir, owned) end
	local s = BY_ID[id]
	if s == nil then error(`unknown setting {id}`) end
	local v = SettingsModel.clean(id, current)
	if v == nil then v = s.default end
	if s.kind == "toggle" then
		return not (v :: boolean)
	elseif s.kind == "slider" then
		local on = snap(s, v :: number)
		return snap(s, on + (if dir < 0 then -1 else 1) * (s.step :: number))
	else
		local options = s.options :: { SettingsSpec.Option }
		local at = 1
		for i, o in options do if o.id == v then at = i end end
		return options[(at - 1 + (if dir < 0 then -1 else 1)) % #options + 1].id
	end
end

-- Where a slider's value sits between its ends, 0 to 1 (for drawing the bar); 0 for the other kinds.
function SettingsModel.fraction(id: string, value: any): number
	local s = BY_ID[id]
	if s == nil or s.kind ~= "slider" then return 0 end
	local v = SettingsModel.clean(id, value)
	if v == nil then v = s.default end
	return ((v :: number) - (s.min :: number)) / ((s.max :: number) - (s.min :: number))
end

-- The value a slider takes when its bar is pressed at `fraction` (0 to 1) of the way along: on the grid.
function SettingsModel.fromFraction(id: string, fraction: number): Value?
	local s = BY_ID[id]
	if s == nil or s.kind ~= "slider" then return nil end
	local f = math.clamp(fraction, 0, 1)
	return snap(s, (s.min :: number) + f * ((s.max :: number) - (s.min :: number)))
end

function SettingsModel.isDefault(id: string, value: any): boolean
	local s = BY_ID[id]
	if s == nil then return false end
	local v = SettingsModel.clean(id, value)
	if v == nil then return true end
	if s.kind == "slider" then return math.abs((v :: number) - (s.default :: number)) < 1e-9 end
	return v == s.default
end

-- ---------------------------------------------------------------- words
local function trim(x: number, digits: number): string
	local text = string.format("%." .. digits .. "f", x)
	return text
end

-- The value in words: "On", "80%", "1.00x", "65 degrees", "5.0 studs", or the option's label.
function SettingsModel.valueText(id: string, value: any): string
	local sayLive = LIVE_TEXT[id]
	if sayLive ~= nil then return sayLive(value) end
	local s = BY_ID[id]
	if s == nil then return "" end
	local v = SettingsModel.clean(id, value)
	if v == nil then v = s.default end
	if s.kind == "toggle" then
		return if v then SettingsSpec.WORDS.on else SettingsSpec.WORDS.off
	elseif s.kind == "slider" then
		local x = v :: number
		if s.unit == "percent" then return `{math.floor(x * 100 + 0.5)}%`
		elseif s.unit == "times" then return trim(x, 2) .. "x"
		elseif s.unit == "degrees" then return `{math.floor(x + 0.5)} degrees`
		elseif s.unit == "studs" then return trim(x, 1) .. " studs"
		end
		return trim(x, 2)
	else
		for _, o in (s.options :: { SettingsSpec.Option }) do
			if o.id == v then return o.label end
		end
		return ""
	end
end

-- "Label: value" for a single line (a toggle shows On or Off).
function SettingsModel.line(id: string, value: any): string
	local s = SettingsModel.spec(id)
	if s == nil then return "" end
	return `{s.label}: {SettingsModel.valueText(id, value)}`
end

return SettingsModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="163">
          <Properties>
            <string name="Name">SettingsNav</string>
            <string name="Source"><![CDATA[--!strict
-- Moving about the settings panel without a mouse (ROBLOX-49): the rows in order (a header per section, the settings, then Reset and Back)
-- and which one is chosen. Up and Down step through the choosable rows and wrap; the shoulder buttons (PageUp and PageDown) jump from section
-- to section. Pure: tests/settings.luau checks it; Client/SettingsPanel draws it.
local SettingsModel = require(script.Parent.SettingsModel)

local SettingsNav = {}
SettingsNav.__index = SettingsNav

export type Row = { kind: string, id: string?, title: string?, section: string? }
-- kind: "header" (not choosable), "setting" (id), "reset", "back"

function SettingsNav.rows(): { Row }
	local out: { Row } = {}
	for _, sec in SettingsModel.sections() do
		table.insert(out, { kind = "header", id = sec.id, title = sec.title, section = sec.id })
		for _, item in sec.items do
			table.insert(out, { kind = "setting", id = item.id, section = sec.id })
		end
	end
	table.insert(out, { kind = "reset" })
	table.insert(out, { kind = "back" })
	return out
end

function SettingsNav.new(): any
	local rows = SettingsNav.rows()
	local self = setmetatable({ rows = rows, at = 1 }, SettingsNav)
	self:first()
	return self
end

local function choosable(row: Row): boolean
	return row.kind ~= "header"
end

function SettingsNav.first(self: any)
	for i, r in self.rows do
		if choosable(r) then
			self.at = i
			return
		end
	end
end

function SettingsNav.current(self: any): Row
	return self.rows[self.at]
end

function SettingsNav.select(self: any, index: number): boolean
	local r = self.rows[index]
	if r == nil or not choosable(r) then return false end
	self.at = index
	return true
end

function SettingsNav.selectId(self: any, id: string): boolean
	for i, r in self.rows do
		if r.kind == "setting" and r.id == id then
			self.at = i
			return true
		end
	end
	return false
end

-- One choosable row down (+1) or up (-1), wrapping.
function SettingsNav.move(self: any, dir: number)
	local n = #self.rows
	local step = if dir < 0 then -1 else 1
	local i = self.at
	for _ = 1, n do
		i = (i - 1 + step) % n + 1
		if choosable(self.rows[i]) then
			self.at = i
			return
		end
	end
end

-- The first setting of the next (+1) or previous (-1) section, wrapping; from Reset or Back, the first or last section.
function SettingsNav.section(self: any, dir: number)
	local starts: { number } = {}
	for i, r in self.rows do
		if r.kind == "header" then table.insert(starts, i + 1) end
	end
	if #starts == 0 then return end
	local here = self.rows[self.at]
	local current = 0
	for k, s in starts do
		if s <= self.at then current = k end
	end
	local target: number
	if dir < 0 then
		-- partway down a section, Previous goes to its start first
		if here.kind == "setting" and starts[current] ~= self.at then target = current else target = (current - 2) % #starts + 1 end
		if here.kind ~= "setting" then target = #starts end
	else
		target = current % #starts + 1
		if here.kind ~= "setting" then target = 1 end
	end
	self.at = starts[target]
end

return SettingsNav
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="164">
          <Properties>
            <string name="Name">SettingsText</string>
            <string name="Source"><![CDATA[--!strict
-- The settings panel's words for the device in use, and its layout rules for the screen (ROBLOX-49): sizes by kind, how a row is laid out
-- (the label beside its control, or the control underneath on a narrow screen or with large text), and how much room the panel has.
-- Pure, so tests/settings.luau checks the layout at phone, tablet and desktop sizes without Roblox; Client/SettingsPanel only places what
-- this says. Button names come from ControlText (PlayStation names on a PlayStation controller).
local ControlText = require(script.Parent.ControlText)
local NotebookText = require(script.Parent.NotebookText)

local SettingsText = {}

-- Text sizes by kind at normal text; LARGE is the large-text option's factor (the same one the notebook and menus use).
SettingsText.SIZES = { heading = 26, section = 20, label = 18, value = 16, note = 14, controls = 14, button = 18 }
SettingsText.LARGE = NotebookText.LARGE
-- A button, a row and a bar's hit area are at least this tall at normal text (touch targets; scaled with the text).
SettingsText.MIN_TARGET = 44
-- The widest control cluster of each kind at normal text: a toggle's button; a choice's two arrows and its word; a slider's minus, bar,
-- number and plus.
-- An action's (ROBLOX-90) is one wider button, for "Look closely".
SettingsText.CONTROL = { toggle = 96, choice = 240, slider = 360, action = 160 } :: { [string]: number }
-- A label needs at least this much width beside its control; otherwise the control goes underneath.
SettingsText.MIN_LABEL = 170
SettingsText.PAD = 10
SettingsText.GAP = 6
SettingsText.VALUE_WIDTH = 104 -- a slider's number (e.g. "100%", "65 degrees")
SettingsText.SCROLLBAR = 8
SettingsText.MIN_BODY = 120
SettingsText.MAX_PANEL = { w = 900, h = 820 }
-- Holding Left or Right on a slider: the pause before it repeats and the seconds between repeats; the right stick's scroll speed in pixels a
-- second at full tilt; a key press that scrolls this many pixels.
SettingsText.REPEAT_DELAY = 0.4
SettingsText.REPEAT_RATE = 0.08
SettingsText.SCROLL_PX_S = 520
SettingsText.STEP_PX = 120

function SettingsText.scale(large: boolean): number
	return if large then SettingsText.LARGE else 1
end

-- The line under the list: what the controls do, on the device in use.
function SettingsText.controls(device: ControlText.Device): string
	if device == "gamepad" then
		local n = function(action: string): string return ControlText.name("gamepad", action) end
		return `Stick or D-pad: choose and change    {n("jump")}: switch    {n("lock")} and {n("choose")}: sections    {n("cancel")}: back`
	elseif device == "touch" then
		return "Tap a setting to switch it. Use - and + or drag a bar."
	end
	return `Up/Down: choose    Left/Right: change    Enter: switch    PageUp/PageDown: sections    {ControlText.name("keyboard", "settings")} or {ControlText.name("keyboard", "cancel")}: back`
end

-- How to open the settings, on the device in use.
function SettingsText.openHint(device: ControlText.Device): string
	if device == "gamepad" then
		return `{ControlText.name("gamepad", "menu")}, then Settings`
	elseif device == "touch" then
		return "Menu, then Settings"
	end
	return `{ControlText.name("keyboard", "settings")}, or {ControlText.name("keyboard", "menu")} then Settings`
end

export type Metrics = { paperW: number, paperH: number, head: number, hint: number, foot: number, body: number, bodyW: number }

-- Pixel sizes for a safe area of this size: the paper (97% by 95%, at most MAX_PANEL), the heading band, the controls line (two lines, three on a narrow phone; 0 when
-- the list would be left with less than MIN_BODY px), the footer's buttons and the height left for the list.
function SettingsText.metrics(width: number, height: number, scale: number): Metrics
	local paperW, paperH = math.min(width * 0.97, SettingsText.MAX_PANEL.w), math.min(height * 0.95, SettingsText.MAX_PANEL.h)
	local head = math.floor((SettingsText.SIZES.heading + 10) * scale)
	local foot = math.floor((SettingsText.MIN_TARGET + 8) * scale)
	local lines = if paperW < 500 then (if scale > 1 then 4 else 3) else 2 -- (a narrow phone wraps the line to a third row, or a fourth in large text)
	local hint = math.ceil(lines * SettingsText.SIZES.controls * scale * 1.25) + 4
	local body = paperH - 20 - head - foot - 12
	if body - hint >= SettingsText.MIN_BODY then body -= hint else hint = 0 end
	return { paperW = paperW, paperH = paperH, head = head, hint = hint, foot = foot, body = body, bodyW = paperW - 28 - SettingsText.SCROLLBAR }
end

export type RowLayout = { stacked: boolean, labelW: number, controlW: number, valueTop: boolean }

-- A row's layout for a list this wide: the label beside the control, or (a narrow screen, large text) the control underneath, full width.
-- A stacked slider keeps its number on the label's line (top right) so the bar has room between its - and +.
function SettingsText.controlWidth(kind: string, scale: number): number
	return math.floor(SettingsText.CONTROL[kind] * scale)
end
function SettingsText.rowLayout(bodyW: number, kind: string, scale: number): RowLayout
	local pad = SettingsText.PAD * scale
	local cw = SettingsText.controlWidth(kind, scale)
	local labelW = bodyW - cw - 3 * pad
	if labelW >= SettingsText.MIN_LABEL * scale then
		return { stacked = false, labelW = labelW, controlW = cw, valueTop = false }
	end
	local full = bodyW - 2 * pad
	if kind == "slider" then
		return { stacked = true, labelW = full - math.floor(SettingsText.VALUE_WIDTH * scale) - SettingsText.GAP * scale, controlW = full, valueTop = true }
	end
	return { stacked = true, labelW = full, controlW = math.min(full, math.max(cw, math.floor(bodyW * 0.7))), valueTop = false }
end

-- A row's height from its measured label and note heights (0 for no note).
function SettingsText.rowHeight(layout: RowLayout, labelH: number, noteH: number, scale: number): number
	local pad = SettingsText.PAD * scale
	local target = math.floor(SettingsText.MIN_TARGET * scale)
	local text = labelH + (if noteH > 0 then noteH + 2 else 0)
	if layout.stacked then
		return math.ceil(pad + math.max(text, if layout.valueTop then target * 0.6 else 0) + SettingsText.GAP * scale + target + pad)
	end
	return math.ceil(math.max(target + pad, text + 2 * pad))
end

-- The largest text size (at most `wanted`, at least 10) at which `word` fits a button `width` px wide and `height` tall: the word wraps, so
-- the lines it needs (an estimate a little wider than Gotham's real letters) must fit the height.
function SettingsText.buttonTextSize(word: string, width: number, height: number, wanted: number): number
	local size = wanted
	while size > 10 do
		local lines = math.ceil(#word * size * 0.58 / math.max(1, width - 10))
		if lines * size * 1.2 <= height then return size end
		size -= 1
	end
	return 10
end

return SettingsText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="165">
          <Properties>
            <string name="Name">TarantulaText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of the tarantulas' display key for the screen (ROBLOX-82): the prompt, the status line, the touch button and the controls card's
-- line. The walking hint, the status line and the card carry them only for the two tarantulas. Button names come from ControlText for the
-- device in use, except on touch, where the button says "Rear up" (ControlText's "Dance" is the peacock's, AntMimicText's "Wave" the ant's).
-- Pure: checked in tests/tarantula.luau.
local ControlText = require(script.Parent.ControlText)

local TarantulaText = {}

TarantulaText.STAND = "Stand still on a surface to rear up"

local function key(device: ControlText.Device): string
	return if device == "touch" then "Rear up" else ControlText.name(device, "display")
end

-- The walking hint's extra words.
function TarantulaText.displayHint(device: ControlText.Device, showing: boolean): string
	if showing then return `{key(device)}: stop` end
	return `{key(device)}: rear up`
end

-- The status line while the pose is on.
function TarantulaText.statusLine(device: ControlText.Device): string
	return `THREAT DISPLAY    {key(device)} or move: stop`
end

-- The touch button's words.
function TarantulaText.touchDisplay(showing: boolean): string return if showing then "Stop" else "Rear up" end

-- The controls card's line (ROBLOX-92: "rear up and turn", as the notebook page says; the pose is a drawn loop and no silk mat is laid). On touch the key is the button's own
-- label, so it says "button" rather than repeating the label ("Rear up rear up").
function TarantulaText.helpLine(device: ControlText.Device): string
	return `{key(device)}{if device == "touch" then " button:" else ""} rear up and turn (any move, jump or Cancel stops it)`
end

return TarantulaText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="166">
          <Properties>
            <string name="Name">TitleText</string>
            <string name="Source"><![CDATA[--!strict
-- The words and the typeface of the first minute (ROBLOX-109): the splash while the world streams in (First/SplashScreen), the title card the start
-- menu becomes (Client/CaughtPanel's "title" look), the intro of a new life (Client/TitleCard) and the death and ending cards' typeface. Every word a
-- player reads in those is here; the death and ending cards keep their own words (WaspText, LifeText, MateText). Pure: tests/title.luau checks them.
--
-- The typeface: Merriweather, a serif Roblox ships as a font family, Light for the title, Regular for the choices, Italic for the subtitle and the
-- captions (a naturalist's notebook in print). A family Roblox cannot find falls back to its default face on its own; Studio is the judge of the look.
local ControlText = require(script.Parent.ControlText)

local TitleText = {}

TitleText.TITLE = "The Windowsill"
TitleText.SUBTITLE = "A small life in a city's nature preserve." -- (ROBLOX-118: the preserve is the game; it begins on the ranger hut's windowsill)

TitleText.FAMILY = "rbxasset://fonts/families/Merriweather.json"
-- The colours: warm paper white for the words, a deep brown-black for the veil and the choices' ground.
TitleText.INK = Color3.fromRGB(244, 238, 226)
TitleText.SOFT = Color3.fromRGB(214, 205, 188)
TitleText.GROUND = Color3.fromRGB(16, 14, 12)

-- The title's size in pixels for a screen this wide: large on a monitor, still one line at a phone's width (360 px portrait).
function TitleText.titleSize(width: number): number
	return math.clamp(math.floor(width * 0.1), 30, 58)
end

-- The start menu's choices. On the title card (no life begun this visit) Continue is one word; in the life menu, beside "Resume this spider", it says
-- where it goes back to. The ids are CaughtPanel's choice ids and the buttons' names.
local START: { [string]: string } = {
	Continue = "Continue",
	ContinueEasy = "Continue the Easy life",
	New = "Begin a new life",
	Easy = "Begin a new life on Easy",
	Free = "Free play - gentle rules",
}
local IN_LIFE: { [string]: string } = {
	Resume = "Resume this spider",
	Controls = "Controls",
	Continue = "Continue from last rest",
	ContinueEasy = "Continue the Easy life from its last rest",
	New = "Begin a new life",
	Easy = "Begin a new life on Easy",
	Free = "Free play - gentle rules",
}
function TitleText.choice(id: string, started: boolean): string
	return (if started then IN_LIFE[id] else START[id]) or START[id] or id
end

-- The one line under the choices for a controller (the D-pad or the stick moves, the confirm button chooses, the back button goes back): in the
-- controller's own names (Cross and Circle on a PlayStation, A and B otherwise). The mouse, the keys and touch need no line.
function TitleText.navHint(device: ControlText.Device): string
	if device ~= "gamepad" then return "" end
	return `D-pad: move    {ControlText.name("gamepad", "jump")}: choose    {ControlText.name("gamepad", "cancel")}: back`
end

-- The intro's skip, shown once it can be skipped (after TitleShots.INTRO.skipAfter seconds): the jump key, the confirm button, or a tap.
function TitleText.skipHint(device: ControlText.Device): string
	if device == "touch" then return "Tap to skip" end
	return `{ControlText.name(device, "jump")}: skip`
end

-- The intro's captions, in the notebook's voice: what this spider is, how it hunts, and the day's one need. Each is backed by a notebook page
-- (bold_jumper, retreat, hunting_by_sight; the last by the game's own numbers: a new spider's reserve lasts under a day in the standard rules,
-- NeedsModel.ENERGY_START 0.55 at 0.612 a day, ROBLOX-88; the gentle rules drain it at 0.177 a day, ROBLOX-91).
function TitleText.captions(gentle: boolean): { string }
	return {
		"A young bold jumping spider. Home is a silk-lined crack in the sill.",
		"It spins no web to catch food. It hunts with its eyes.",
		if gentle then "Hunger is gentler in these rules. It is never gone." else "It has not eaten. It must eat today.",
	}
end

return TitleText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="167">
          <Properties>
            <string name="Name">WaspText</string>
            <string name="Source"><![CDATA[--!strict
-- The words of the wasp's visit for the screen (ROBLOX-26): the sound captions, the status line while it visits and the plain screen
-- after a catch. The texts are Godot's (scripts/habitat/habitat_loop.gd _wasp_line, scripts/audio/soundscape.gd WASP_CAPTIONS,
-- scripts/presentation/caught_panel.gd); where they differ it is said here. Button names come from ControlText for the device in use.
-- Pure: checked in tests/wasp.luau.
--
-- Differences from Godot: the captions say where the hum is, as the flies' "[buzzing, ahead-left]" does (Godot's wasp captions did
-- not); the second line after a catch does not point to a notebook, which the port does not have yet; with no rest to go back to the
-- one choice is "Back to the start"; with one, the screen also offers another spider as a new life (the client's presentEnd, ROBLOX-91: the sac and the generation are left behind).
local ControlText = require(script.Parent.ControlText)
local Data = require(script.Parent.Parent.Data.Wasp)
local Heard = require(script.Parent.Heard)

local WaspText = {}

WaspText.LINE = "A mud dauber wasp stung the spider and carried it away."
WaspText.SUB = "Its sting does not kill: it paralyses."
WaspText.RIVAL_TAKEN = "The wasp seized the other spider and carried it off. It is gone for today."
WaspText.BACK = "Back to your last rest"
WaspText.START = "Back to the start"

local NAMES = { "ahead", "ahead-left", "left", "behind-left", "behind", "behind-right", "right", "ahead-right" }

local function roundHalfAway(x: number): number
	return if x >= 0 then math.floor(x + 0.5) else -math.floor(-x + 0.5)
end

-- Where `point` is from the spider (Godot VibrationSense.direction_word): the eighth of the compass round its heading, counted
-- counter-clockwise seen from its up, then "above" or "below" when it is more than 35 degrees off the plane the spider stands on.
function WaspText.directionWord(spider: Vector3, heading: Vector3, up: Vector3, point: Vector3): string
	local n = up
	local to = point - spider
	local rise = to:Dot(n)
	local flat = to - n * rise
	local word = ""
	if flat:Dot(flat) > 1.0e-6 then
		local f = flat.Unit
		local angle = math.deg(math.atan2(n:Dot(heading:Cross(f)), heading:Dot(f)))
		word = NAMES[(roundHalfAway(angle / 45.0) % 8) + 1]
	end
	local elevation = math.deg(math.atan2(rise, math.max(flat.Magnitude, 1.0e-6)))
	if elevation > 35.0 then
		word = if word == "" then "above" else "above, " .. word
	elseif elevation < -35.0 then
		word = if word == "" then "below" else "below, " .. word
	end
	return if word ~= "" then word else "here"
end

-- The caption of the visit now: { text, alpha }, or nil when there is none. While it arrives (the whole warning), when it has seen the
-- spider (inspecting, striking), and for a few seconds as it leaves. None begins "[buzzing", which is the flies'.
function WaspText.caption(phase: string, phaseS: number, direction: string): { text: string, alpha: number }?
	if phase == "arriving" then
		return { text = `[a deep, heavy hum outside, {direction}, coming closer]`, alpha = 1.0 }
	elseif phase == "inspecting" or phase == "striking" then
		return { text = `[the deep hum turns toward you, {direction}]`, alpha = 1.0 }
	elseif phase == "taking" or phase == "seizing" then
		-- (The wasp going for the rival male, ROBLOX-70; the host shows these only when it is near, WaspText.heardRival.)
		return { text = `[the deep hum drops toward something on the sill, {direction}]`, alpha = 1.0 }
	elseif phase == "bearing" then
		return { text = `[a short scuffle, then the deep hum rising away with something, {direction}]`, alpha = 1.0 }
	elseif phase == "leaving" and phaseS < Data.captionTailS then
		local left = Data.captionTailS - phaseS
		return { text = `[the deep hum fades away, {direction}]`, alpha = math.clamp(left / Data.captionFadeS, 0.0, 1.0) }
	end
	return nil
end

-- Whether the player hears or sees the wasp take the rival: it is within earshot of the spider, or in clear sight of it (`seen`) and not too far.
function WaspText.heardRival(distance: number, seen: boolean): boolean
	return Heard.within(distance, seen) -- (the rule is UI/Heard's, ROBLOX-92; the mate's notices use it too)
end

-- What the status says while the wasp visits (nil when it is away). The first visit says what wasps do and how to get away.
function WaspText.line(phase: string, confused: boolean, visits: number, spared: boolean, device: ControlText.Device): string?
	if phase == "arriving" then
		if visits <= 1 then
			return `A deep hum outside: a wasp is coming, and wasps hunt spiders. Hide in the crack, keep still, or let yourself down on your line ({ControlText.name(device, "drop")}).`
		end
		return "A deep hum outside: a wasp is coming. Hide in the crack, keep still, or drop on your line."
	elseif phase == "searching" then
		if confused then return "The wasp has lost you. Get out of sight." end
		return "A wasp is searching the sill. Keep still, keep out of sight, or get home to the crack."
	elseif phase == "inspecting" or phase == "striking" then
		return "The wasp has seen you! Get away: jump, drop on your line, or reach the crack."
	elseif phase == "taking" or phase == "seizing" then
		return "The wasp is after something else on the sill. Keep still or keep out of sight until it goes."
	elseif phase == "bearing" then
		return "The wasp has taken something and is leaving with it."
	elseif phase == "carrying" then
		return "Stung, the spider cannot move. The wasp carries it away."
	elseif phase == "leaving" then
		if spared then return "The wasp touched you with its antennae, gave up, and is leaving." end
		return "The wasp is leaving."
	end
	return nil
end

-- The life in a few plain lines: how long it lived, its meals, the wasp. Never a score. `hours` of life, `meals` finished, and the
-- wasp's visits and escapes.
function WaspText.summary(hours: number, meals: number, visits: number, escapes: number): string
	local lived = "less than a day"
	if hours >= 24.0 then
		local days = math.floor(hours / 24.0)
		lived = `{days} day{if days == 1 then "" else "s"}`
	end
	local out = { `It lived {lived}.`, `It ate {meals} meal{if meals == 1 then "" else "s"}.` }
	if visits > 0 then
		table.insert(out, `The wasp came {visits} time{if visits == 1 then "" else "s"}; it got away from it {escapes} time{if escapes == 1 then "" else "s"}.`)
	end
	return table.concat(out, "\n")
end

-- The catch screen `seconds` after it began: how dim the world is, and whether the line, then the summary and the choices, show.
function WaspText.panel(seconds: number): { dim: number, line: boolean, choices: boolean }
	return {
		dim = math.clamp(seconds / Data.caughtQuietS, 0.0, 1.0) * Data.caughtDim,
		line = seconds >= Data.caughtQuietS,
		choices = seconds >= Data.caughtQuietS + Data.caughtLineS,
	}
end

-- The button's words: back to the last rest when there is one, else back to the start.
function WaspText.choice(hasRest: boolean): string
	return if hasRest then WaspText.BACK else WaspText.START
end

return WaspText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="168">
          <Properties>
            <string name="Name">WaterText</string>
            <string name="Source"><![CDATA[--!strict
-- The water in words (ROBLOX-122; the water is Life/Water): the caption while the spider struggles at the surface, its death card, and the notices when it gets out
-- or is pulled out (the gentle rules). Pure: tests/preserve.luau checks the words, tests/quiet.luau their classes.
local WaterText = {}

WaterText.STRUGGLE = "[splashing at the surface]"
WaterText.LINE = "The water held on."
WaterText.SUB = "A jumping spider cannot walk on water. Nothing it could reach stood out of the pond, and the struggle wore it out."
WaterText.OUT = "You scrambled out of the water."
WaterText.PULLED = "The ripples carried you to something to climb. You hauled yourself out."
WaterText.CAUSE = "drowned" -- (the end of a life's cause, LifeSession; Life/Water.CAUSE)

return table.freeze(WaterText)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="169">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="170">
          <Properties>
            <string name="Name">AntForage</string>
            <string name="Source"><![CDATA[--!strict
-- Clock-derived ambient workers. The carried fragments are presentation, not
-- food removed from the saved prey ecology. No locomotion/capture rule changes.
local Environment=require(script.Parent.Environment)
local AntForage={}
local TAU=math.pi*2
local routes: {[number]:any}={}
function AntForage.route(index: number): any
 if routes[index] then return routes[index] end
 local angle=Environment.hash(914,index,211)*TAU
 local direction=Vector3.new(math.cos(angle),0,math.sin(angle))
 local distance=9+Environment.hash(914,index,223)*6
 local speed=1.1+Environment.hash(914,index,227)*.8
 local route=table.freeze({direction=direction,across=Vector3.new(-direction.Z,0,direction.X),distance=distance,
  bow=(Environment.hash(914,index,229)-.5)*2,travel=distance/speed,pause=2.5,inside=4})
 routes[index]=route;return route
end
function AntForage.sample(seconds: number,index: number): any
 local r=AntForage.route(index)
 local period=r.inside+r.travel*2+r.pause
 local phase=(seconds+index*7.3)%period
 local mode,u="inside",0
 if phase>=r.inside+r.travel+r.pause then
  mode="return";u=1-(phase-r.inside-r.travel-r.pause)/r.travel
 elseif phase>=r.inside+r.travel then mode="forage";u=1
 elseif phase>=r.inside then mode="outbound";u=(phase-r.inside)/r.travel end
 local offset=r.direction*(r.distance*u)+r.across*(r.bow*math.sin(math.pi*u))
 local heading=(r.direction*r.distance+r.across*(r.bow*math.pi*math.cos(math.pi*u))).Unit
 if mode=="return" then heading=-heading end
 local distance=offset.Magnitude
 return {offset=offset,heading=heading,mode=mode,visible=mode~="inside",moving=mode=="outbound" or mode=="return",
  carrying=mode=="return" and distance>.4,burrow=math.clamp(1-distance/.4,0,1)*.45,
  period=period}
end
return table.freeze(AntForage)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="171">
          <Properties>
            <string name="Name">DogGround</string>
            <string name="Source"><![CDATA[--!strict
-- Cosmetic dog's ground LOD: an index of the same authored physical boxes the
-- server builds. No new floor, queryable part, or player collision is created.
-- The native ray wins when streamed; this covers distant unloaded ground.
local Region=require(script.Parent.Region)
local Environment=require(script.Parent.Environment)
local Ground={}
local CELL=64
local function key(x: number,z: number): string return math.floor(x/CELL)..":"..math.floor(z/CELL) end
function Ground.new(map: any): any
 local cells: {[string]: {any}}={}
 if type(map.regions)~="function" then return {cells=cells} end
 local minX,maxX,minZ,maxZ=math.huge,-math.huge,math.huge,-math.huge
 for _,p in Environment.DOG_ROUTE do
  minX,maxX=math.min(minX,p.X-50),math.max(maxX,p.X+50)
  minZ,maxZ=math.min(minZ,p.Z-50),math.max(maxZ,p.Z+50)
 end
 for _,r in map.regions() do
  local a,b=r.bounds[1],r.bounds[2]
  if b.X<minX or a.X>maxX or b.Z<minZ or a.Z>maxZ or b.Y< -93 or a.Y> -76 then continue end
  for _,p in Region.pieces(r) do
  -- This dog lives on the outdoor circuit, near its ground level. Upper
  -- leaves, roofs and indoor furniture are not distant proxy terrain.
  if p.hi.Y>=-93 and p.hi.Y<=-76 then
   for x=math.floor(p.lo.X/CELL),math.floor(p.hi.X/CELL) do
    for z=math.floor(p.lo.Z/CELL),math.floor(p.hi.Z/CELL) do
     local k=x..":"..z;cells[k]=cells[k] or {};table.insert(cells[k],p)
    end
   end
  end
 end end
 return {cells=cells}
end
function Ground.at(self: any,at: Vector3,up: number,down: number): Vector3?
 local best=nil :: number?
 for _,p in self.cells[key(at.X,at.Z)] or {} do
  if at.X>=p.lo.X and at.X<=p.hi.X and at.Z>=p.lo.Z and at.Z<=p.hi.Z
   and p.hi.Y<=at.Y+up and p.hi.Y>=at.Y+up-down and (best==nil or p.hi.Y>best) then best=p.hi.Y end
 end
 return if best then Vector3.new(at.X,best,at.Z) else nil
end
return Ground
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="172">
          <Properties>
            <string name="Name">Environment</string>
            <string name="Source"><![CDATA[--!strict
-- Habitat weather is reconstructed from the saved life clock, not rerolled on load.
-- Weather probabilities, temperatures and wind are authored temperate late-summer art direction.
-- Solar elevation uses the standard latitude/declination/hour-angle relation (NOAA solar equations).
-- Hours are local apparent solar time; no claim of matching the player's real location or civil timezone.
local Environment = {}
Environment.LATITUDE = 41.88
Environment.START_DAY_OF_YEAR = 235
Environment.FRONT_HOURS = 2
Environment.INDOORS = table.freeze({sill=true,counter=true,kitchen_floor=true,hut_floor=true,hut_upper=true,hut_desk=true,
 hut_board=true,hut_shelf=true,hut_chair=true,hut_window=true,hut_doorway=true,hut_door_up=true,
 room_floor=true,room_sofa=true,room_tv=true,room_games=true,room_window=true})

local TAU = math.pi*2
local function good(x: number, fallback: number): number
 return if x==x and math.abs(x)<1e12 then x else fallback
end
local function smooth(x: number): number
 local t=math.clamp(x,0,1);return t*t*(3-2*t)
end
function Environment.hash(seed: number, n: number, salt: number): number
 local x=(math.floor(seed)+math.floor(n)*7919+salt*104729)%2147483647
 x=(x*16807+12345)%2147483647;x=(x*16807)%2147483647
 return x/2147483647
end
local function front(seed: number, n: number): any
 local h=Environment.hash(seed,n,13)
 local rain=if h>.84 then .85 elseif h>.65 then .32 else 0
 return {rain=rain,cloud=if rain>0 then .85 else .12+.5*Environment.hash(seed,n,17),
  wind=.6+Environment.hash(seed,n,19)*3.2,angle=Environment.hash(seed,n,23)*TAU}
end
function Environment.solar(day: number, hour: number): any
 local doy=(Environment.START_DAY_OF_YEAR+math.floor(good(day,1))-2)%365+1
 local gamma=TAU*(doy-1+(hour-12)/24)/365
 local dec=.006918-.399912*math.cos(gamma)+.070257*math.sin(gamma)-.006758*math.cos(2*gamma)
  +.000907*math.sin(2*gamma)-.002697*math.cos(3*gamma)+.00148*math.sin(3*gamma)
 local lat=math.rad(Environment.LATITUDE);local ha=math.rad((hour-12)*15)
 local east=-math.cos(dec)*math.sin(ha)
 local north=math.cos(lat)*math.sin(dec)-math.sin(lat)*math.cos(dec)*math.cos(ha)
 local up=math.sin(lat)*math.sin(dec)+math.cos(lat)*math.cos(dec)*math.cos(ha)
 local altitude=math.deg(math.asin(math.clamp(up,-1,1)))
 return {direction=Vector3.new(east,up,-north),altitude=altitude,declination=math.deg(dec),dayOfYear=doy,
  daylight=smooth((altitude+6)/12)}
end
-- Roblox's native sky uses a tilted circular track: changing ClockTime alone
-- gives a constant north/south component. Convert the astronomical direction to
-- the two rendering controls instead. The life clock remains local solar time.
-- The 23.5-degree engine tilt was checked against Lighting:GetSunDirection in Studio.
function Environment.nativeSun(direction: Vector3): any
 local v=direction.Unit
 return {clock=(12+math.atan2(-v.X,v.Y)*12/math.pi)%24,
  latitude=23.5+math.deg(math.asin(math.clamp(v.Z,-1,1)))}
end
function Environment.sample(day: number, hour: number, seed: number?): any
 local d=math.max(1,good(day,1));local h=good(hour,9)
 local total=(d-1)*24+h;local slot=math.floor(total/Environment.FRONT_HOURS)
 local t=smooth((total-slot*Environment.FRONT_HOURS)/.75)
 local s=seed or 914;local a,b=front(s,slot-1),front(s,slot)
 local rain=a.rain+(b.rain-a.rain)*t;local cloud=a.cloud+(b.cloud-a.cloud)*t
 -- Blend vectors, rather than angles, so a front never spins through the long way round north.
 local wx=math.cos(a.angle)*a.wind*(1-t)+math.cos(b.angle)*b.wind*t
 local wz=math.sin(a.angle)*a.wind*(1-t)+math.sin(b.angle)*b.wind*t
 local gust=.8+.16*math.sin(total*147)+.12*math.sin(total*53+.7)
 local solar=Environment.solar(d,h%24)
 local damp=rain
 for back=1,4 do damp=math.max(damp,front(s,slot-back).rain*(1-back*.19)) end
 local seasonal=math.cos(TAU*(solar.dayOfYear-200)/365)
 local temperature=13+9*seasonal+5*math.cos(TAU*((h%24)-15)/24)-3*rain
 return {day=d,hour=h%24,totalHours=total,solar=solar,cloud=cloud,rain=rain,
  name=if rain>.62 then "rain" elseif rain>.08 then "drizzle" elseif cloud>.55 then "overcast" else "fair",
  wind=Vector3.new(wx,0,wz)*gust,wetness=math.clamp(damp,0,1),temperature=temperature,
  humidity=math.clamp(.42+cloud*.27+rain*.25+(1-solar.daylight)*.12,0,1),
  mist=math.clamp(damp*(1-solar.daylight)*.45,0,.4)}
end
function Environment.grub(day: number, hour: number, index: number, wetness: number): (number, number)
 local t=((day-1)*24+hour)*3600/48 -- action seconds at the sill's normal clock rate
 local period=34+Environment.hash(914,index,47)*37
 local phase=(t+Environment.hash(914,index,53)*period)%period
 local show=if wetness>.18 and phase<7 then math.sin(math.pi*phase/7) else 0
 return show,phase
end
function Environment.flea(seconds: number, index: number): (Vector3, boolean, Vector3)
 local period=2.7+Environment.hash(914,index,59)*2.2
 local phase=(seconds+index*.83)%period;local hop=.22
 local u=math.clamp(phase/hop,0,1)
 local cycle=math.floor((seconds+index*.83)/period)
 local function landing(n: number): Vector3
  local angle=Environment.hash(914,n,index+61)*TAU
  local radius=.25+Environment.hash(914,n,index+67)*.95
  return Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
 end
 local from,to=landing(cycle-1),landing(cycle)
 local direction=to-from
 local heading=if direction.Magnitude>1e-6 then direction.Unit else Vector3.zAxis
 -- Endpoints depend only on the clock. The next hop begins at this landing;
 -- keeping the movement local never requires snapping back to the spawn.
 return from:Lerp(to,u)+Vector3.new(0,if phase<hop then 4*1.8*u*(1-u) else 0,0),phase<hop,heading
end
-- A leashed-sized park dog on a lawn circuit, with stops to sniff. No attack or save outcome is added.
-- The dog needs room for its whole body, not merely four supported paw points.
-- This lawn loop stays west of the raised beds and inside the authored ground.
Environment.DOG_ROUTE=table.freeze({Vector3.new(-340,-84.6,-100),Vector3.new(-235,-84.6,-100),
 Vector3.new(-285,-84.6,-150)})
function Environment.dog(seconds: number, rain: number): any
 local route=Environment.DOG_ROUTE;local durations={};local total=0
 for i,a in route do
  local move=(route[i%#route+1]-a).Magnitude/140
  durations[i]=move+5.5;total+=durations[i]
 end
 local cycle=seconds%total;local leg=1
 while cycle>durations[leg] and leg<#route do cycle-=durations[leg];leg+=1 end
 local a,b=route[leg],route[leg%#route+1]
 local moving=durations[leg]-5.5;local sniff=cycle>=moving
 local u=math.clamp(cycle/moving,0,1)
 local position=a:Lerp(b,u)
 local heading=(b-a).Unit
 if sniff then
  local nextHeading=(route[(leg+1)%#route+1]-b).Unit
  local turn=smooth(math.clamp((cycle-moving-4)/1.5,0,1))
  local yaw=math.atan2(heading.Z,heading.X)
  local nextYaw=math.atan2(nextHeading.Z,nextHeading.X)
  local delta=math.atan2(math.sin(nextYaw-yaw),math.cos(nextYaw-yaw))
  yaw+=delta*turn;heading=Vector3.new(math.cos(yaw),0,math.sin(yaw))
 end
 return {position=position,heading=heading,sniff=sniff,visible=true,
  stride=if sniff then 0 else math.sin(seconds*TAU*2.4),tail=math.sin(seconds*TAU*2.2)*(.3-.2*math.clamp(rain,0,1))}
end

-- Local presentation state, separate from the saved ecology. In rain, finish
-- the supported circuit to a sniff stop near the hut; never cut across beds.
-- Keep the route clock there until rain eases, then resume without a jump.
function Environment.stepDog(wander: any,seconds: number,rain: number): any
 local delta=if wander.raw then seconds-wander.raw else 0
 if wander.time==nil or delta<0 or delta>2 then wander.time=seconds;wander.rest=false;delta=0 end
 wander.raw=seconds
 if wander.rest and rain<.45 then wander.rest=false end
 if not wander.rest then wander.time+=delta end
 local pose=Environment.dog(wander.time,rain)
 if rain>.7 and pose.sniff and pose.position.Z>-130 then wander.rest=true end
 pose.rainRest=wander.rest==true
 return pose
end

return table.freeze(Environment)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="173">
          <Properties>
            <string name="Name">Garden</string>
            <string name="Source"><![CDATA[--!strict
-- The world outside the glass (ROBLOX-95, docs/OPEN_WORLD_DESIGN.md W2): the generators of the three regions under the window, as pure data. Region asks here for every
-- kind that is not the sill; nothing here builds a part or knows the engine, so the server, the client and the CLI tests all get the same boxes from the same region.
--   outer_sill .. the stone slab the raised sash opens onto (top y 0, x -30..30, z -24..-13.5) and the window box's two halves that stand on it (Data/Flora's
--                 garden box, drawn by the sill's Decor and solid here); its look is worn paint over stone, moss in the corners, grit and rain streaks down its face.
--   house_wall ... the brick wall under it, face at z -24 from y 0 to the lawn at y -90.4, x -40..40: one box below the slab and two shoulders beside it, all
--                 drawn as brick courses over recessed mortar (the boxes turn invisible once the bricks exist), with the house going on above the outer sill
--                 around the window (drawn only).
--   bed .......... the soil under the window (top y -90, x -25..25, z -24..-74): soil mounds, three stones (one raised on two rests over a gap, the bed's
--                 retreat, World/WorldMap's bed_a_stone), two plants whose stems and leaves are boxes as the Pilea's are, and drawn soil, leaf litter, grass,
--                 twigs, pebbles, lichen and moss.
-- Everything placed is placed from the region's own seed (WorldMap.seed), by a Park-Miller stream of its own for each kind of thing, so the same region is the
-- same garden forever, and a drawn thing that the low tier drops (`full`) never moves what the low tier keeps. The physical pieces are the walkable world: the
-- motor walks their faces, RivalRoute builds the region's graph from them. A drawn record is one part (Habitat/Scenery.look builds them); the region's budget
-- (Region.budget) is a ceiling the placer keeps to at both tiers, and tests/world.luau holds the counts.
-- ROBLOX-96 (W3, garden life): the bed's life is placed here too, from the same seed: `prey(region)` is the bed's perch and vent list for a Prey/PreyDirector
-- (on the soil, the mounds' and stones' tops, under the dock's leaves for the gnats; on the plants' leaves and the dock's stem for the aphids, which only walk),
-- and `bugs(region)` the woodlice's starting places and the spots they hide in (under the big stone, at the other stones' feet, under the litter). The wall's look
-- gains the descent's dressing: lichen on the brick, a weathered course and cobweb strands in the corner under the outer sill.
-- ROBLOX-101 (W3b part A, the garden's bestiary): `bestiary(region)` is the list of the region's other prey, one spec per kind, each for a director of its own
-- (Prey/PreyWorld): springtails on the soil round the stones and the litter and leafhoppers on the dock's and the dandelion's stems and leaves in the bed; small
-- moths and crane flies on the house wall and on the outer sill (the slab by the window, the window box's fronts, the slab's front edge). From the same seed
-- by streams of their own, so W3's perches, vents and prey are what they were.
-- ROBLOX-103 (W3c, the look): a fourth kind, `wall_upper` (docs/WORLD_MAP_PLAN.md region 4: the house is a single story): the brick above the window up to the
-- eaves on the window's two jambs, the eaves' soffit, the fascia, the gutter hung on it (a walkable high perch) and the eave course of the roof; its look carries
-- the rest of the house as a backdrop (the back wall on either side to 5 m out, the roof over it all, the eaves and gutter along it, a downpipe, a window and the
-- back door), all drawn only until wall_west and wall_east are built. And more on the three built looks: drip stains and moss in the wall's joints, petals and
-- seeds on the outer sill, veins on the bed's leaves, seed heads on its grass and more kinds of litter, each from a stream of its own after what was placed
-- before, so nothing placed before moves.
-- ROBLOX-112 (the house in true proportion, and the first of the inside): `wall_upper` is the window and the wall round it (the jambs, the window's box above the back
-- frame, which the sill's Decor draws, the room's reveal and its wall beside the window), the brick above the window's head is the kind `eaves` (and `eaves_west` on
-- the west wall, which now stops at the head), and the kitchen begins: `counter` (the worktop under the sill board, the sink, the tap, the toaster over its gap, the
-- kettle) and `kitchen_floor` (the floor in front of it, the cupboards). The eaves' look draws the room beyond the window until the rooms are built.
local Flora = require(script.Parent.Parent.Data.Flora)
local WorldMap = require(script.Parent.WorldMap)
local Hut = require(script.Parent.Hut) -- (ROBLOX-116: the preserve's hut garden lives by the same questions; its answers are World/Hut's)
local Meadow = require(script.Parent.Meadow) -- (ROBLOX-119: and the meadow's edge and the bench patch, World/Meadow's)
local Pond = require(script.Parent.Pond) -- (ROBLOX-122: and the pond's edge, World/Pond's)

local Pocket = require(script.Parent.GardenPocket)
local Verge = require(script.Parent.Verge)
local Garden = {}

-- A physical box (WindowsillLayout.Piece) with the material it is drawn in when nothing draws it instead.
export type Piece = { id: string, lo: Vector3, hi: Vector3, profile: string, color: Color3, material: string? }
-- A drawn-only part: centred `at`, `size`, turned by `turn` (degrees about X, Y and Z, in that order, as CFrame.Angles), `shape` "Block" (the default),
-- "Ball", "Cylinder" (its axis along X) or "Ellipsoid" (a sphere mesh); `full`: the low tier drops it (FullOnly); `group`: the folder it is built into.
export type Drawn = {
	id: string, size: Vector3, at: Vector3, color: Color3, transparency: number?,
	material: string?, shape: string?, turn: Vector3?, full: boolean?, group: string?, shadow: boolean?,
	far: boolean?, reflectance: number?, -- (ROBLOX-115: the preserve's backdrop: in the zone's far look; a shine)
	dew: number?, -- (ROBLOX-117: a dew drop's lag: Habitat/DayLight.applyDew shows it by the hour, Habitat/Scenery.look hides it until then)
}
export type Box = { min: Vector3, max: Vector3 }

local TAU = 2 * math.pi
local MOD = 2147483647

local function hex(s: string): Color3
	return Color3.fromHex(s)
end
local function v(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end
-- A Park-Miller stream from the region's seed and a salt for the kind of thing it places (the same stream as Habitat/Shapes.rng).
local function rng(seed: number, salt: number): () -> number
	local state = (seed + salt * 7919) % MOD
	if state <= 0 then state += MOD - 1 end
	return function(): number
		state = (state * 16807) % MOD
		return (state - 1) / (MOD - 1)
	end
end
local function between(rand: () -> number, a: number, b: number): number
	return a + (b - a) * rand()
end
local function pick<T>(list: { T }, rand: () -> number): T
	return list[1 + math.floor(rand() * #list)]
end
local function overlaps(a: Box, b: Box, margin: number): boolean
	return a.min.X < b.max.X + margin and a.max.X > b.min.X - margin and a.min.Z < b.max.Z + margin and a.max.Z > b.min.Z - margin
end

