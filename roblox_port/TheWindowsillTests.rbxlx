          <string name="Name">Movement</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">CameraMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pure camera and stick math, ported from the frozen Godot reference (c87ce00):
--   scripts/movement/boom_math.gd    (orbit basis, boom recovery, eased offsets, pitch pick)
--   scripts/movement/surface_input.gd (camera-relative walking on floors, walls and undersides)
--   scripts/movement/camera_rig.gd   (aim free-look clamp, spider-eye gaze clamp, recenter yaw)
-- Vector3 only, no Instances, so tests/run.luau checks it against values exported from Godot itself.
-- Conventions match Godot and Roblox alike: right-handed, -Z forward, yaw about world up,
-- elevation positive puts the camera above the pivot.

local CameraMath = {}

CameraMath.PIVOT_HEIGHT = 0.45
CameraMath.BOOM_RADIUS = 0.15
CameraMath.DEFAULT_ELEVATION_DEG = 18.0
CameraMath.MIN_ELEVATION_DEG = -20.0
CameraMath.MAX_ELEVATION_DEG = 80.0
CameraMath.MOUSE_DEG_PER_PIXEL = 0.1
CameraMath.STICK_DEG_PER_SECOND = 150.0
CameraMath.RECOVER_SPEED = 6.0
CameraMath.RECENTER_SECONDS = 0.25
CameraMath.BODY_HIDE_LENGTH = 0.8
CameraMath.COMFORT_BOOM = 2.5
CameraMath.AUTO_PITCH_STEP_DEG = 10.0
CameraMath.MIN_AUTO_ELEVATION_DEG = -45.0
CameraMath.AUTO_PITCH_IN_SECONDS = 0.08
CameraMath.AUTO_PITCH_OUT_SECONDS = 0.35
CameraMath.AIM_PITCH_MIN_DEG = -20.0
CameraMath.AIM_PITCH_MAX_DEG = 50.0
CameraMath.AIM_VIEW_LIMIT_DEG = 85.0
CameraMath.AIM_RETURN_SECONDS = 0.25
CameraMath.EYE_FOV_DEG = 80.0
CameraMath.EYE_AHEAD = 0.53
CameraMath.EYE_HEIGHT = 0.09
CameraMath.EYE_PITCH_LIMIT_DEG = 80.0
CameraMath.EYE_ROLL_DEG_S = 240.0
CameraMath.PRINCIPAL_SCAN_DEG = 30.0
CameraMath.EYE_SETTLE_DEG = 4.0
CameraMath.FOV_DEG = 65.0
CameraMath.CAMERA_DISTANCE = 5.0

local SETTLE = 2e-4
local TIE = 1e-3
local FLOOR_BLEND_START = 0.5
local FLOOR_BLEND_END = 0.8660254

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function smoothstep(a: number, b: number, x: number): number
	if a == b then
		return if x < a then 0 else 1
	end
	local t = math.clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end
CameraMath.smoothstep = smoothstep

local function dirOn(v: Vector3, n: Vector3): Vector3
	local t = v - n * v:Dot(n)
	local length = t.Magnitude
	return if length > 1e-6 then t / length else Vector3.new(0, 0, 0)
end

-- BoomMath.next_length: a shorter allowed length is taken at once; growth is rate limited.
function CameraMath.nextLength(current: number, allowed: number, desired: number, recoverSpeed: number, dt: number): number
	if not (finite(current) and finite(allowed) and finite(desired) and finite(recoverSpeed) and finite(dt)) then
		return 0
	end
	local target = math.max(0, math.min(allowed, desired))
	if target <= current then
		return target
	end
	return math.min(current + math.max(recoverSpeed, 0) * math.max(dt, 0), target)
end

-- BoomMath.ease_offset: exponential ease, faster away from zero than back toward it.
function CameraMath.easeOffset(current: number, target: number, dt: number, inSeconds: number, outSeconds: number): number
	if not (finite(current) and finite(target) and finite(dt) and finite(inSeconds) and finite(outSeconds)) then
		return 0
	end
	local seconds = math.max(if math.abs(target) >= math.abs(current) then inSeconds else outSeconds, 1e-4)
	local nextValue = current + (target - current) * (1 - math.exp(-math.max(dt, 0) / seconds))
	return if math.abs(target - nextValue) < SETTLE then target else nextValue
end

-- BoomMath.pick_pitch_offset: the first comfortable boom, else the longest.
function CameraMath.pickPitchOffset(offsets: { number }, lengths: { number }, comfort: number): number
	if #offsets == 0 or #offsets ~= #lengths or not finite(comfort) then
		return 0
	end
	local best = 1
	for i = 1, #offsets do
		if lengths[i] >= comfort then
			return offsets[i]
		end
		if lengths[i] > lengths[best] + TIE then
			best = i
		end
	end
	return offsets[best]
end

-- BoomMath.back_direction: unit vector from the pivot toward the camera.
function CameraMath.backDirection(yaw: number, elevation: number): Vector3
	local ce = math.cos(elevation)
	return Vector3.new(math.sin(yaw) * ce, math.sin(elevation), math.cos(yaw) * ce)
end

-- The orbit camera's right and up vectors (SurfaceInput.camera_basis x and y columns).
function CameraMath.cameraRight(yaw: number, _elevation: number): Vector3
	return Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
end
function CameraMath.cameraUp(yaw: number, elevation: number): Vector3
	local se = math.sin(elevation)
	return Vector3.new(-se * math.sin(yaw), math.cos(elevation), -se * math.cos(yaw))
end

-- SurfaceInput.tangent_axes: camera-relative right and forward on the plane with normal n.
function CameraMath.tangentAxes(yaw: number, elevation: number, n: Vector3): (Vector3, Vector3)
	local normal = if n.Magnitude > 1e-5 then n.Unit else Vector3.new(0, 1, 0)
	local camRight = CameraMath.cameraRight(yaw, elevation)
	local camUp = CameraMath.cameraUp(yaw, elevation)
	local flatForward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local pf = dirOn(flatForward, normal)
	local pu = dirOn(camUp, normal)
	local w = smoothstep(FLOOR_BLEND_START, FLOOR_BLEND_END, math.abs(normal.Y))
	local forward = pf * w + pu * (1 - w)
	if forward:Dot(forward) < 1e-6 then
		local pr = dirOn(camRight, normal)
		if pr.Magnitude == 0 then
			pr = dirOn(Vector3.new(1, 0, 0), normal)
		end
		forward = normal:Cross(pr)
	end
	forward = dirOn(forward, normal)
	local right = forward:Cross(normal)
	right = if right.Magnitude > 1e-9 then right.Unit else right
	if right:Dot(camRight) < 0 then
		right = -right
	end
	return right, forward
end

-- SurfaceInput.map_stick: x right, y forward, length kept (at most 1).
function CameraMath.mapStick(x: number, y: number, yaw: number, elevation: number, n: Vector3): Vector3
	local length = math.sqrt(x * x + y * y)
	if not finite(length) or length < 1e-6 then
		return Vector3.new(0, 0, 0)
	end
	if length > 1 then
		x, y = x / length, y / length
	end
	local right, forward = CameraMath.tangentAxes(yaw, elevation, n)
	return right * x + forward * y
end

-- Spider-eye walking: forward is the gaze laid on the surface, right is its right on it.
function CameraMath.mapStickEye(x: number, y: number, gaze: Vector3, bodyForward: Vector3, n: Vector3): Vector3
	local length = math.sqrt(x * x + y * y)
	if not finite(length) or length < 1e-6 then
		return Vector3.new(0, 0, 0)
	end
	if length > 1 then
		x, y = x / length, y / length
	end
	local forward = gaze - n * gaze:Dot(n)
	if forward:Dot(forward) < 1e-6 then
		forward = bodyForward - n * bodyForward:Dot(n)
	end
	if forward:Dot(forward) < 1e-6 then
		return Vector3.new(0, 0, 0)
	end
	forward = forward.Unit
	local right = forward:Cross(n).Unit
	return right * x + forward * y
end

-- camera_rig._clamp_aim_pitch: the aim free-look range, and the whole view short of straight up or down.
function CameraMath.clampAimPitch(value: number, elevation: number): number
	local limit = math.rad(CameraMath.AIM_VIEW_LIMIT_DEG)
	local low = math.max(math.rad(CameraMath.AIM_PITCH_MIN_DEG), elevation - limit)
	local high = math.min(math.rad(CameraMath.AIM_PITCH_MAX_DEG), elevation + limit)
	return math.clamp(value, low, math.max(low, high))
end

-- camera_rig._effective_elevation: the player's pitch plus the auto-pitch, inside the automatic range.
function CameraMath.effectiveElevation(elevation: number, offset: number): number
	local low = math.min(elevation, math.rad(CameraMath.MIN_AUTO_ELEVATION_DEG))
	local high = math.max(elevation, math.rad(CameraMath.MAX_ELEVATION_DEG))
	return math.clamp(elevation + offset, low, high)
end

-- The yaw whose flat forward (-sin, 0, -cos) points along v.
function CameraMath.yawOf(v: Vector3): number
	return math.atan2(-v.X, -v.Z)
end

-- SpiderMotor.get_recenter_yaw: behind the heading on floors and undersides, toward the surface on walls.
function CameraMath.recenterYaw(heading: Vector3, visualUp: Vector3, fallback: number): number
	local w = visualUp.Y * visualUp.Y
	local v = Vector3.new(heading.X, 0, heading.Z) * w + Vector3.new(-visualUp.X, 0, -visualUp.Z) * (1 - w)
	if v.Magnitude < 1e-3 then
		return fallback
	end
	return math.atan2(-v.X, -v.Z)
end

local function anyPerpendicular(v: Vector3): Vector3
	local other = if math.abs(v.Y) < 0.9 then Vector3.new(0, 1, 0) else Vector3.new(1, 0, 0)
	return v:Cross(other).Unit
end

-- camera_rig._clamp_gaze: unit, and at least EYE_PITCH_LIMIT_DEG from the surface normal either way.
function CameraMath.clampGaze(g: Vector3, up: Vector3, bodyForward: Vector3): Vector3
	if not (finite(g.X) and finite(g.Y) and finite(g.Z)) or g:Dot(g) < 1e-10 then
		g = bodyForward
	end
	g = g.Unit
	local tangent = g - up * g:Dot(up)
	if tangent:Dot(tangent) < 1e-8 then
		tangent = bodyForward - up * bodyForward:Dot(up)
		if tangent:Dot(tangent) < 1e-8 then
			tangent = anyPerpendicular(up)
		end
	end
	tangent = tangent.Unit
	local limit = math.rad(CameraMath.EYE_PITCH_LIMIT_DEG)
	local elev = math.clamp(math.asin(math.clamp(g:Dot(up), -1, 1)), -limit, limit)
	return (tangent * math.cos(elev) + up * math.sin(elev)).Unit
end

-- Rodrigues rotation of v about unit axis k by angle a (right-handed).
function CameraMath.rotate(v: Vector3, k: Vector3, a: number): Vector3
	local c, s = math.cos(a), math.sin(a)
	return v * c + k:Cross(v) * s + k * (k:Dot(v) * (1 - c))
end

-- camera_rig._look_eye (no level-horizon switch): yaw about the view's up (positive looks right),
-- pitch about the view's right (positive looks down).
function CameraMath.lookEye(gaze: Vector3, up: Vector3, yawRad: number, pitchRad: number, bodyForward: Vector3): Vector3
	local g = CameraMath.rotate(gaze, up, -yawRad)
	local right = g:Cross(up)
	if right:Dot(right) > 1e-10 then
		g = CameraMath.rotate(g, right.Unit, -pitchRad)
	end
	return CameraMath.clampGaze(g, up, bodyForward)
end

return CameraMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">InputState</string>
            <string name="Source"><![CDATA[--!strict
-- Pure input state: test without Studio. +Y is forward on the control pad; look +X is right, +Y is down
-- (the Godot camera rig's convention: look(dx, dy) with dy > 0 looking down).
local InputState = {}
InputState.__index = InputState

local MOVE_DEAD = 0.2
local LOOK_DEAD = 0.15

function InputState.new()
	return setmetatable({ held = {} :: {[string]: boolean}, x = 0, y = 0, lx = 0, ly = 0 }, InputState)
end
function InputState.set(self: any, action: string, down: boolean)
	self.held[action] = down
end
local function radial(x: number, y: number, dead: number): (number, number)
	local length = math.sqrt(x*x + y*y)
	local strength = math.clamp((length - dead) / (1 - dead), 0, 1)
	if length <= 0 then return 0, 0 end
	return x / length * strength, y / length * strength
end
function InputState.stick(self: any, x: number, y: number)
	self.x, self.y = radial(x, y, MOVE_DEAD)
end
-- Right stick: Roblox reports +Y up; store it as look-down positive.
function InputState.look(self: any, x: number, y: number)
	local rx, ry = radial(x, y, LOOK_DEAD)
	self.lx, self.ly = rx, -ry
end
function InputState.axes(self: any): (number, number)
	local x = self.x + (if self.held.Right then 1 else 0) - (if self.held.Left then 1 else 0)
	local y = self.y + (if self.held.Forward then 1 else 0) - (if self.held.Back then 1 else 0)
	local length = math.max(1, math.sqrt(x*x + y*y))
	return x / length, y / length
end
-- Look rate in -1..1 per axis: right stick plus arrow keys.
function InputState.lookAxes(self: any): (number, number)
	local x = self.lx + (if self.held.LookRight then 1 else 0) - (if self.held.LookLeft then 1 else 0)
	local y = self.ly + (if self.held.LookDown then 1 else 0) - (if self.held.LookUp then 1 else 0)
	return math.clamp(x, -1, 1), math.clamp(y, -1, 1)
end
function InputState.clear(self: any)
	table.clear(self.held)
	self.x, self.y, self.lx, self.ly = 0, 0, 0, 0
end
return InputState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">JumpMath</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/movement/jump_math.gd (spec 6.3, 27). Pure math, no Instances, so it runs in tests/run.luau too.
--
-- The motor flies a committed jump with semi-implicit Euler at a fixed 60 Hz tick:
--   v = v + g * dt, then p = p + v * dt.
-- After n ticks from launch velocity v0 at p0 that gives, exactly,
--   p_n = p0 + n * dt * v0 + g * dt^2 * n * (n + 1) / 2
-- so the launch velocity is solved in this discrete form, not with the continuous 0.5 * g * T^2.

local JumpMath = {}

-- Matches SurfaceProfile.STAND_MAX_DEG.
JumpMath.STAND_MAX_DEG = 45.0
JumpMath.MIN_LAUNCH_NORMAL_SPEED = 0.05
JumpMath.STAND_APPROACH_MIN = 0.05
JumpMath.LAND_APPROACH_MIN = 0.3

local UP = Vector3.new(0, 1, 0)

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function finiteVec(v: Vector3): boolean
	return finite(v.X) and finite(v.Y) and finite(v.Z)
end

export type Solution = {
	steps: number,
	duration: number,
	velocity: Vector3,
	speed: number,
	arrivalVelocity: Vector3,
	approach: number,
}

export type SolveResult = {
	valid: { Solution },
	reason: string, -- "ok", "no_durations", "too_far", "no_launch", "no_arrival"
	minSpeed: number,
}

-- Tick counts n whose duration n * dt lies inside [tMin, tMax]. nMax < nMin when none fits.
function JumpMath.stepRange(tMin: number, tMax: number, dt: number): (number, number)
	if not (finite(tMin) and finite(tMax) and finite(dt)) or dt <= 0 then
		return 1, 0
	end
	local nMin = math.ceil(tMin / dt - 1e-6)
	local nMax = math.floor(tMax / dt + 1e-6)
	return math.max(nMin, 1), nMax
end

function JumpMath.positionAfter(p0: Vector3, v0: Vector3, g: Vector3, dt: number, n: number): Vector3
	return p0 + v0 * (n * dt) + g * (dt * dt * n * (n + 1) * 0.5)
end

function JumpMath.velocityAfter(v0: Vector3, g: Vector3, dt: number, n: number): Vector3
	return v0 + g * (dt * n)
end

function JumpMath.launchVelocity(p0: Vector3, seat: Vector3, g: Vector3, dt: number, n: number): Vector3
	return (seat - p0 - g * (dt * dt * n * (n + 1) * 0.5)) / (n * dt)
end

-- Body-centre positions p_0 .. p_steps by repeated ticks, in the order the motor does them.
function JumpMath.path(p0: Vector3, v0: Vector3, g: Vector3, dt: number, steps: number): { Vector3 }
	local out = { p0 }
	local v, p = v0, p0
	for _ = 1, steps do
		v += g * dt
		p += v * dt
		table.insert(out, p)
	end
	return out
end

function JumpMath.isStanding(normal: Vector3): boolean
	if not finiteVec(normal) or normal:Dot(normal) < 1e-10 then
		return false
	end
	return normal.Unit:Dot(UP) >= math.cos(math.rad(JumpMath.STAND_MAX_DEG)) - 1e-6
end

function JumpMath.minApproach(targetNormal: Vector3): number
	return if JumpMath.isStanding(targetNormal) then JumpMath.STAND_APPROACH_MIN else JumpMath.LAND_APPROACH_MIN
end

-- Every launch solution for a landing seat, one per allowed whole-tick duration, filtered by the launch speed limit,
-- by leaving the launch surface and by arriving into the target fast enough. Sorted by speed, lowest first.
function JumpMath.solve(
	p0: Vector3,
	seat: Vector3,
	launchNormal: Vector3,
	targetNormal: Vector3,
	g: Vector3,
	dt: number,
	tMin: number,
	tMax: number,
	maxSpeed: number
): SolveResult
	local valid: { Solution } = {}
	local nMin, nMax = JumpMath.stepRange(tMin, tMax, dt)
	local minSpeed = math.huge
	local anySpeedOk, anyLaunchOk = false, false
	local need = JumpMath.minApproach(targetNormal)
	for n = nMin, nMax do
		local v0 = JumpMath.launchVelocity(p0, seat, g, dt, n)
		if finiteVec(v0) then
			local speed = v0.Magnitude
			minSpeed = math.min(minSpeed, speed)
			if speed <= maxSpeed then
				anySpeedOk = true
				if v0:Dot(launchNormal) >= JumpMath.MIN_LAUNCH_NORMAL_SPEED then
					anyLaunchOk = true
					local arrival = JumpMath.velocityAfter(v0, g, dt, n)
					local approach = -arrival:Dot(targetNormal)
					if approach >= need then
						table.insert(valid, {
							steps = n,
							duration = n * dt,
							velocity = v0,
							speed = speed,
							arrivalVelocity = arrival,
							approach = approach,
						})
					end
				end
			end
		end
	end
	table.sort(valid, function(a: Solution, b: Solution): boolean
		if math.abs(a.speed - b.speed) > 1e-9 then
			return a.speed < b.speed
		end
		return a.steps < b.steps
	end)
	local reason = "ok"
	if #valid == 0 then
		if nMax < nMin then
			reason = "no_durations"
		elseif not anySpeedOk then
			reason = "too_far"
		elseif not anyLaunchOk then
			reason = "no_launch"
		else
			reason = "no_arrival"
		end
	end
	return { valid = valid, reason = reason, minSpeed = minSpeed }
end

return JumpMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">SupportMath</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/movement/support_math.gd (spec 6.1, 6.2). Pure geometry for supported locomotion; unit vectors in world space.

local SupportMath = {}

local RIGHT = Vector3.new(1, 0, 0)
local BACK = Vector3.new(0, 0, 1)

local function angleTo(a: Vector3, b: Vector3): number
	return math.atan2(a:Cross(b).Magnitude, a:Dot(b))
end
SupportMath.angleTo = angleTo

-- The part of v that lies in the plane with unit normal n.
function SupportMath.tangent(v: Vector3, n: Vector3): Vector3
	return v - n * v:Dot(n)
end

-- Unit direction of v on the plane with normal n, or zero when v is (nearly) along n.
function SupportMath.tangentDir(v: Vector3, n: Vector3, eps: number?): Vector3
	local t = SupportMath.tangent(v, n)
	local length = t.Magnitude
	return if length > (eps or 1e-5) then t / length else Vector3.zero
end

-- Hysteresis for the support normal: a candidate within ignoreDeg of the current one is ignored.
function SupportMath.filterNormal(current: Vector3, candidate: Vector3, ignoreDeg: number): Vector3
	if candidate:Dot(candidate) < 1e-10 or candidate.Magnitude ~= candidate.Magnitude then
		return current
	end
	local c = candidate.Unit
	if current:Dot(current) < 1e-10 then
		return c
	end
	if angleTo(current.Unit, c) <= math.rad(ignoreDeg) then
		return current
	end
	return c
end

function SupportMath.anyPerpendicular(v: Vector3): Vector3
	local other = if math.abs(v.Unit.X) < 0.9 then RIGHT else BACK
	return v:Cross(other).Unit
end

-- Turns unit vector `from` toward `to` by at most maxAngle radians (shortest arc).
function SupportMath.rotateToward(from: Vector3, to: Vector3, maxAngle: number): Vector3
	local angle = angleTo(from, to)
	if angle <= maxAngle or angle < 1e-6 then
		return to
	end
	local axis = from:Cross(to)
	if axis:Dot(axis) < 1e-12 then
		axis = SupportMath.anyPerpendicular(from)
	end
	return (CFrame.fromAxisAngle(axis.Unit, maxAngle) * from).Unit
end

-- Signed angle from a to b about axis n.
function SupportMath.signedAngle(a: Vector3, b: Vector3, n: Vector3): number
	return math.atan2(n:Dot(a:Cross(b)), a:Dot(b))
end

-- Body frame for an up vector and a heading: Y is up, -Z (LookVector) is the heading made perpendicular to up.
function SupportMath.bodyCFrame(position: Vector3, up: Vector3, heading: Vector3): CFrame
	local u = up.Unit
	local f = SupportMath.tangentDir(heading, u)
	if f == Vector3.zero then
		f = SupportMath.anyPerpendicular(u)
	end
	local z = -f
	local x = u:Cross(z).Unit
	return CFrame.fromMatrix(position, x, u, z)
end

return SupportMath
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Rig</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Setae</string>
            <string name="Source"><![CDATA[--!strict
-- Where the spider's hairs (setae) go: pure layout from the appearance table, Vector3 only, so tests/run.luau checks it.
-- Body frame as in SpiderRig: +Y up, -Z forward. Deterministic: the same appearance always gives the same fuzz.
-- SpiderRig turns each entry into one thin anchored part.

local Setae = {}

export type Hair = { at: Vector3, dir: Vector3, length: number, white: boolean, grey: boolean }
export type LegHair = { segment: number, t: number, theta: number, length: number, white: boolean, grey: boolean }

-- Must match SpiderRig's body layout.
Setae.HEAD_CENTER = Vector3.new(0, 0.02, -0.20)
Setae.ABDOMEN_CENTER = Vector3.new(0, 0.04, 0.20)
local GOLDEN = 2.399963229728653
local EYES = {
	Vector3.new(-0.075, 0.09, -0.455), Vector3.new(0.075, 0.09, -0.455),
	Vector3.new(-0.165, 0.10, -0.40), Vector3.new(0.165, 0.10, -0.40),
	Vector3.new(-0.13, 0.17, -0.14), Vector3.new(0.13, 0.17, -0.14),
	Vector3.new(-0.11, 0.185, -0.27), Vector3.new(0.11, 0.185, -0.27),
}

-- A repeatable 0..1 value per index (no global RNG state).
local function hash(i: number, salt: number): number
	local x = math.sin(i * 12.9898 + salt * 78.233) * 43758.5453
	return x - math.floor(x)
end
Setae.hash = hash

local function v3(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

-- Leans a hair from its surface normal toward the rear (+Z) along the surface.
local function lean(normal: Vector3, amount: number, i: number): Vector3
	local back = Vector3.new(0, 0, 1)
	local along = back - normal * back:Dot(normal)
	if along.Magnitude < 1e-4 then along = Vector3.new(0, 1, 0) - normal * normal.Y end
	if along.Magnitude < 1e-4 then return normal end
	local side = normal:Cross(along.Unit)
	local jitter = (hash(i, 3) - 0.5) * 0.7
	return (normal + along.Unit * amount + side * jitter).Unit
end

local function whiteOnAbdomen(look: any, x: number, z: number): boolean
	-- x, z: fractions of the abdomen's X/Z radii, the coordinates the markings use.
	local ar = look.abdomenRadii
	for _, s in look.spots do
		local dx = (x - s.x) * ar[1] / s.rx
		local dz = (z - s.z) * ar[3] / s.rz
		if dx * dx + dz * dz < 1.4 then return true end
	end
	return z < -0.58 and z > -0.78 and math.abs(x) < 0.72 -- the pale front band
end

local function ellipsoidHairs(out: { Hair }, look: any, center: Vector3, radii: Vector3, samples: number, salt: number, keep: (Vector3, Vector3) -> boolean, white: (Vector3) -> boolean)
	local f = look.fuzz
	for i = 0, samples - 1 do
		local y = 1 - 2 * (i + 0.5) / samples
		local r = math.sqrt(math.max(0, 1 - y * y))
		local a = i * GOLDEN
		local unit = Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
		if unit.Y > -0.25 then
			local at = center + Vector3.new(unit.X * radii.X, unit.Y * radii.Y, unit.Z * radii.Z)
			local normal = Vector3.new(unit.X / radii.X, unit.Y / radii.Y, unit.Z / radii.Z).Unit
			if keep(at, unit) then
				local length = f.length[1] + (f.length[2] - f.length[1]) * hash(i, salt)
				local dir = lean(normal, f.lieBack, i + salt * 1000)
				table.insert(out, { at = at - dir * length * 0.25, dir = dir, length = length, white = white(unit), grey = hash(i, salt + 11) < f.greyShare })
			end
		end
	end
end

function Setae.body(look: any): { Hair }
	local out: { Hair } = {}
	local f = look.fuzz
	if not f or not f.enabled then return out end
	local ar, hr = v3(look.abdomenRadii), v3(look.headRadii)
	ellipsoidHairs(out, look, Setae.ABDOMEN_CENTER, ar, f.abdomenSamples, 1, function(_at, unit)
		return unit.Z > -0.93 -- not where the abdomen meets the pedicel
	end, function(unit)
		return whiteOnAbdomen(look, unit.X, unit.Z)
	end)
	ellipsoidHairs(out, look, Setae.HEAD_CENTER, hr, f.headSamples, 2, function(at, unit)
		if unit.Z < -0.55 and unit.Y < 0.75 then return false end -- the eye face stays clear
		for _, e in EYES do
			if (at - e).Magnitude < 0.075 then return false end
		end
		return true
	end, function(unit)
		return math.abs(unit.X) > 0.82 and unit.Z < 0.1 and unit.Y < 0.45 -- pale cheeks
	end)
	-- Phidippus eyebrow tufts: long dark hairs above each side of the eye row, leaning forward and out.
	for _, side in { -1, 1 } do
		for k = 1, f.tuftHairs do
			local s = (k - 1) / math.max(1, f.tuftHairs - 1) - 0.5
			local at = Vector3.new(side * (0.12 + s * 0.03), 0.17, -0.34 + s * 0.04)
			local dir = Vector3.new(side * (0.35 + 0.15 * s), 1, -0.45 + 0.2 * hash(k, 9)).Unit
			table.insert(out, { at = at, dir = dir, length = f.tuftLength * (0.85 + 0.3 * hash(k, 7 + side)), white = false, grey = false })
		end
	end
	return out
end

-- Hairs on one leg: segment 1 femur, 2 tibia, 3 tarsus; t along it (0 base .. 1 tip); theta around it.
-- White over the leg's pale band (the middle bandFraction of each segment, as SpiderRig draws it), else dark.
function Setae.leg(look: any, legIndex: number): { LegHair }
	local out: { LegHair } = {}
	local f = look.fuzz
	if not f or not f.enabled then return out end
	local front = (legIndex - 1) % 4 == 0 -- the first legs carry a denser, longer fringe, as in Phidippus
	for segment = 1, 3 do
		local n = if front and segment < 3 then math.floor(f.legHairs[segment] * 1.6) else f.legHairs[segment]
		for k = 1, n do
			local i = legIndex * 100 + segment * 10 + k
			local t = (k - 0.5) / n
			local theta = k * GOLDEN + legIndex
			local white = math.abs(t - 0.5) < look.bandFraction * 0.6
			table.insert(out, { segment = segment, t = t, theta = theta, length = f.legLength * (0.7 + 0.6 * hash(i, 5)) * (if segment == 3 then 0.6 elseif front then 1.4 else 1), white = white, grey = hash(i, 13) < f.greyShare })
		end
	end
	return out
end

return Setae
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">SpiderRig</string>
            <string name="Source"><![CDATA[--!strict
-- The drawn spider for Roblox: a port of scripts/presentation/spider_body.gd and surface_legs.gd (VISUAL-01 look).
-- Every part is anchored, non-colliding and non-queryable, and is placed each frame with one Workspace:BulkMoveTo call.
-- Display only: the controller owns the body's CFrame; nothing here feeds back into movement.
-- Body frame: +Y support-up, -Z forward, about 1 stud long (1 Godot WU = 1 cm = 1 stud).

local Workspace = game:GetService("Workspace")
local Appearances = require(script.Parent.Parent.Data.Appearances)
local Setae = require(script.Parent.Setae)

local SpiderRig = {}
SpiderRig.__index = SpiderRig

export type GaitMode = "Tetrapod" | "Unilateral"

local HIP_Z = { -0.36, -0.24, -0.12, 0.0 }
local TIP_Z = { -0.82, -0.52, 0.12, 0.62 }
-- Stout front legs, slimmer back legs: { femur, tibia } diameters per pair.
local LEG_D = { { 0.078, 0.064 }, { 0.065, 0.053 }, { 0.057, 0.045 }, { 0.059, 0.047 } }
local STEP_ERROR = 0.24
local SWING_SECONDS = 0.10
local STEP_HEIGHT = 0.12
local ANKLE_SHARE = 0.62
local ANKLE_LIFT = 0.045
local PALP_DRUM_HZ = 3.2
local PALP_DRUM_DEG = 11


type Leg = {
	side: number,
	pair: number,
	planted: Vector3?,
	swing: number, -- < 0 planted, 0..1 swinging
	from: Vector3,
	to: Vector3,
	up: Vector3,
	foot: Vector3,
	femur: Part,
	tibia: Part,
	tarsus: Part,
	knee: Part,
	ankle: Part,
	bands: {Part},
	hairs: { { part: Part, spec: Setae.LegHair } },
}

type Fixed = { part: Part, offset: CFrame, palp: number? }

export type Rig = typeof(setmetatable(
	{} :: {
		model: Model,
		root: Part,
		gaitMode: GaitMode,
		reducedMotion: boolean,
		_fixed: { Fixed },
		_legs: { Leg },
		_group: number,
		_t: number,
		_drum: number,
		_spots: { Part },
	_appearance: any,
		_setae: { Part },
		_eyeView: boolean,
		_bodyHidden: boolean,
		_highlight: Highlight?,
		_params: RaycastParams,
		_parts: { BasePart },
		_cframes: { CFrame },
	},
	SpiderRig
))

local function newPart(model: Model, name: string, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = Vector3.new(0.1, 0.1, 0.1)
	p.Parent = model
	return p
end

local function ellipsoid(model: Model, name: string, radii: Vector3, color: Color3, material: Enum.Material): Part
	local p = newPart(model, name, color, material)
	p.Size = radii * 2
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function rod(model: Model, name: string, d: number, color: Color3): Part
	local p = newPart(model, name, color, Enum.Material.SmoothPlastic)
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(1, d, d)
	return p
end

local function ball(model: Model, name: string, d: number, color: Color3): Part
	local p = newPart(model, name, color, Enum.Material.SmoothPlastic)
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(d, d, d)
	p.CastShadow = false
	return p
end

-- A cylinder's axis is its local X: aim it from a to b.
local function rodCFrame(a: Vector3, b: Vector3): CFrame
	return CFrame.lookAt((a + b) * 0.5, b) * CFrame.Angles(0, math.pi / 2, 0)
end

-- detail "low" keeps every third hair (phones and tablets until a real-device frame-time check says otherwise).
function SpiderRig.new(parent: Instance, worldFolder: Instance, appearanceId: string?, detail: string?): Rig
	local look = Appearances.profiles[appearanceId or Appearances.default]
	assert(look, "Unknown spider appearance")
	local function color(rgb): Color3 return Color3.new(rgb[1], rgb[2], rgb[3]) end
	local BODY, LEG = color(look.body), color(look.legs)
	local JOINT, EYE, FANG = color(look.white), color(look.eyes), color(look.fangs)
	local WHITE = color(look.white)
	local model = Instance.new("Model")
	model.Name = "Spider"
	model:SetAttribute("AppearanceId", look.id)
	local root = newPart(model, "Root", BODY, Enum.Material.SmoothPlastic)
	root.Size = Vector3.new(1, 0.5, 1)
	root.Transparency = 1
	root.CastShadow = false
	model.PrimaryPart = root

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { worldFolder }

	local self = setmetatable({
		model = model,
		root = root,
		gaitMode = "Tetrapod" :: GaitMode,
		reducedMotion = false,
		_fixed = {} :: { Fixed },
		_legs = {} :: { Leg },
		_group = 0,
		_t = 0,
		_drum = 0,
		_spots = {} :: { Part },
		_appearance = look,
		_setae = {} :: { Part },
		_eyeView = false,
		_bodyHidden = false,
		_highlight = nil :: Highlight?,
		_params = params,
		_parts = {} :: { BasePart },
		_cframes = {} :: { CFrame },
	}, SpiderRig)

	local function fixed(part: Part, at: Vector3, rot: CFrame?, palp: number?)
		table.insert(self._fixed, { part = part, offset = CFrame.new(at) * (rot or CFrame.identity), palp = palp })
	end
	local fabric = Enum.Material.SmoothPlastic -- clean high-contrast silhouette
	fixed(ellipsoid(model, "Cephalothorax", Vector3.new(table.unpack(look.headRadii)), BODY, fabric), Vector3.new(0, 0.02, -0.20))
	fixed(ellipsoid(model, "EyeFace", Vector3.new(0.205, 0.165, 0.125), BODY, fabric), Vector3.new(0, 0.055, -0.355))
	fixed(ellipsoid(model, "Pedicel", Vector3.new(0.05, 0.05, 0.06), BODY, fabric), Vector3.new(0, -0.035, -0.06))
	fixed(ellipsoid(model, "Abdomen", Vector3.new(table.unpack(look.abdomenRadii)), BODY, fabric), Vector3.new(0, 0.04, 0.20))
	local ar = look.abdomenRadii
	local function marking(name: string, x: number, z: number, rx: number, rz: number, angle: number)
		local y = ar[2] * math.sqrt(math.max(0, 1 - x*x - z*z))
		local spot = ellipsoid(model, name, Vector3.new(rx, 0.012, rz), WHITE, fabric)
		fixed(spot, Vector3.new(x * ar[1], 0.047 + y, 0.20 + z * ar[3]), CFrame.Angles(0, angle, 0))
		table.insert(self._spots, spot)
	end
	-- A curved pale band across the front of the abdomen.
	for i = -4, 4 do
		marking("FrontBand", i * 0.16, -0.66, 0.031, 0.018, 0)
	end
	for _, spot in look.spots do
		marking("AbdomenSpot", spot.x, spot.z, spot.rx, spot.rz, spot.angle)
	end
	-- Fixed deterministic stippling: no per-frame RNG or extra updates.
	for i = 1, look.speckleCount do
		local angle = i * 2.399963229728653
		local radius = 0.40 + (i % 5) * 0.10
		marking("Speckle", math.cos(angle) * radius, math.sin(angle) * radius, 0.0035, 0.005, angle)
	end
	for _, side in { -1, 1 } do
		fixed(ellipsoid(model, "PaleCheek", Vector3.new(0.018, 0.066, 0.105), WHITE, fabric), Vector3.new(side * 0.235, 0.055, -0.23))
		local ame = Vector3.new(side * 0.075, 0.09, -0.455)
		local eye = ellipsoid(model, "PrincipalEye", Vector3.new(0.080, 0.080, 0.063), EYE, Enum.Material.Glass)
		eye.Reflectance = 0.35
		fixed(eye, ame)
		local glint = ellipsoid(model, "Catchlight", Vector3.new(0.013, 0.013, 0.006), Color3.new(1, 1, 1), Enum.Material.Neon)
		glint.CastShadow = false
		fixed(glint, ame + Vector3.new(side * -0.018, 0.03, -0.052))
		local secondary: { { at: Vector3, r: number } } = {
			{ at = Vector3.new(side * 0.165, 0.10, -0.40), r = 0.042 }, -- anterior lateral
			{ at = Vector3.new(side * 0.13, 0.17, -0.14), r = 0.048 }, -- posterior lateral
			{ at = Vector3.new(side * 0.11, 0.185, -0.27), r = 0.018 }, -- posterior median
		}
		for _, e in secondary do
			local small = ellipsoid(model, "Eye", Vector3.one * e.r, EYE, Enum.Material.Glass)
			small.Reflectance = 0.3
			fixed(small, e.at)
		end
		local fang = ellipsoid(model, "Chelicera", Vector3.new(0.045, 0.08, 0.04), FANG, Enum.Material.Foil)
		fang.Reflectance = 0.15
		fixed(fang, Vector3.new(side * 0.052, -0.075, -0.445), CFrame.Angles(-0.35, 0, side * 0.12))
		-- Pedipalp: stalk and pale-tipped club, rotating about a pivot at its base.
		local palpIndex = if side < 0 then 1 else 2
		local base = Vector3.new(side * 0.10, -0.035, -0.43)
		local tip = base + Vector3.new(side * 0.03, -0.10, -0.09)
		local stalk = rod(model, "PalpStalk", 0.042, LEG)
		stalk.Size = Vector3.new((tip-base).Magnitude, 0.042, 0.042)
		fixed(stalk, Vector3.zero, CFrame.new(base):Inverse() * rodCFrame(base, tip), palpIndex)
		local ring = rod(model, "PalpBand", 0.044, WHITE)
		ring.Size = Vector3.new((tip-base).Magnitude * look.bandFraction, 0.044, 0.044)
		fixed(ring, Vector3.zero, CFrame.new(base):Inverse() * rodCFrame(base, tip), palpIndex)
		fixed(ellipsoid(model, "PalpClub", Vector3.new(0.03, 0.03, 0.045), LEG, fabric), tip + Vector3.new(0, -0.005, -0.02) - base, nil, palpIndex)
		fixed(ellipsoid(model, "PalpTip", Vector3.new(0.022, 0.018, 0.022), JOINT, fabric), tip + Vector3.new(0, 0.006, -0.045) - base, nil, palpIndex)
	end
	-- Fuzz: thin hairs over the head and abdomen (Setae.body), moved with the body like every fixed part.
	local fuzz = look.fuzz
	local DARK = if fuzz then color(fuzz.dark) else BODY
	local GREY = if fuzz then color(fuzz.grey) else BODY
	local function seta(white: boolean, grey: boolean, width: number, length: number): Part
		local h = newPart(model, "Seta", if white then WHITE elseif grey then GREY else DARK, Enum.Material.SmoothPlastic)
		h.Size = Vector3.new(width, width, length)
		h.CastShadow = false
		h.Transparency = fuzz.transparency
		table.insert(self._setae, h)
		return h
	end
	if fuzz and fuzz.enabled then
		local SHELL = color(fuzz.shellColor)
		local hr, abr = Vector3.new(table.unpack(look.headRadii)), Vector3.new(table.unpack(look.abdomenRadii))
		for k, shell in fuzz.shells do
			local a = ellipsoid(model, "FuzzShell", abr * shell.scale, SHELL, Enum.Material.SmoothPlastic)
			a.Transparency, a.CastShadow = shell.transparency, false
			fixed(a, Setae.ABDOMEN_CENTER)
			-- The head's shell sits back from the eye row so the eyes stay clear and glossy.
			local h = ellipsoid(model, "FuzzShell", Vector3.new(hr.X * shell.scale, hr.Y * shell.scale, hr.Z * 0.82), SHELL, Enum.Material.SmoothPlastic)
			h.Transparency, h.CastShadow = shell.transparency, false
			fixed(h, Setae.HEAD_CENTER + Vector3.new(0, 0, 0.05 + 0.01 * k))
		end
	end
	local keepEvery = if detail == "low" then 3 else 1
	for n, hair in Setae.body(look) do
		if n % keepEvery ~= 0 then continue end
		local h = seta(hair.white, hair.grey, fuzz.width, hair.length)
		local mid = hair.at + hair.dir * (hair.length * 0.5)
		local upv = if math.abs(hair.dir.Y) < 0.9 then Vector3.yAxis else Vector3.zAxis
		fixed(h, mid, CFrame.lookAt(Vector3.zero, hair.dir, upv))
	end
	for i = 1, 8 do
		local side = if i <= 4 then -1 else 1
		local pair = (i - 1) % 4 + 1
		local raw = LEG_D[pair]
		local factor = if pair == 1 then look.frontLegScale else 1
		local d = {raw[1] * factor, raw[2] * factor}
		table.insert(self._legs, {
			side = side,
			pair = pair,
			planted = nil :: Vector3?,
			swing = -1,
			from = Vector3.zero,
			to = Vector3.zero,
			up = Vector3.yAxis,
			foot = Vector3.zero,
			femur = rod(model, "Femur" .. i, d[1], LEG),
			tibia = rod(model, "Tibia" .. i, d[2], LEG),
			tarsus = rod(model, "Tarsus" .. i, d[2] * 0.6, LEG),
			knee = ball(model, "Knee" .. i, d[1] * 0.95, JOINT),
			ankle = ball(model, "Ankle" .. i, d[2] * 0.95, JOINT),
			bands = {rod(model, "FemurBand" .. i, d[1], WHITE), rod(model, "TibiaBand" .. i, d[2], WHITE), rod(model, "TarsusBand" .. i, d[2] * 0.6, WHITE)},
			hairs = {},
		})
		local leg = self._legs[#self._legs]
		for n, spec in Setae.leg(look, i) do
			if n % keepEvery ~= 0 then continue end
			table.insert(leg.hairs, { part = seta(spec.white, spec.grey, fuzz.width * 0.85, spec.length), spec = spec })
		end
	end
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1
	hl.OutlineColor = WHITE
	hl.OutlineTransparency = 0.82
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = model
	self._highlight = hl
	model.Parent = parent
	self:setGrowthStage(0)
	return self
end

-- The selected appearance stays black and white at every life stage.
-- Growth is a separate display scale when LIFE is ported; it must not recolor this design.
function SpiderRig.setGrowthStage(self: Rig, stage: number)
	self.model:SetAttribute("GrowthStage", math.clamp(stage, 0, 3))
end

local function legGroup(self: Rig, i: number): number
	if self.gaitMode == "Unilateral" then
		return if i <= 4 then 0 else 1
	end
	-- Godot's (i % 4 + i / 4) % 2 with 0-based i: L1 R2 L3 R4 against R1 L2 R3 L4.
	local j = i - 1
	return (j % 4 + j // 4) % 2
end

local function restLocal(leg: Leg): Vector3
	return Vector3.new(leg.side * 0.78, -0.30, TIP_Z[leg.pair])
end

-- Display-only foothold: retract toward the body at a narrow edge; never invents a platform.
local function target(self: Rig, body: CFrame, leg: Leg): RaycastResult?
	local up = body.UpVector
	local rest = restLocal(leg)
	for _, reach in { 1.0, 0.65, 0.35, 0.12 } do
		local point = body:PointToWorldSpace(Vector3.new(rest.X * reach, 0, rest.Z * reach))
		local hit = Workspace:Raycast(point + up * 0.35, -up * 1.0, self._params)
		if hit and hit.Normal:Dot(up) > 0.35 then
			return hit
		end
	end
	return nil
end

-- body: the drawn body's CFrame. grounded: standing on a surface. moving: walking speed > 0 (for palp drumming).
function SpiderRig.update(self: Rig, body: CFrame, dt: number, grounded: boolean, moving: boolean)
	self._t += dt
	local up = body.UpVector
	local parts, cframes = self._parts, self._cframes
	table.clear(parts)
	table.clear(cframes)
	local function put(p: BasePart, cf: CFrame)
		table.insert(parts, p)
		table.insert(cframes, cf)
	end
	put(self.root, body)

	-- Palps drum in bursts while the spider stands still.
	self._drum = math.clamp(self._drum + (if grounded and not moving and not self.reducedMotion then 3 else -3) * dt, 0, 1)
	local palpAngle = {}
	for k = 1, 2 do
		local burst = math.clamp((math.sin(self._t * 1.3 + 0.7 * k) - 0.55) / 0.3, 0, 1)
		local beat = math.max(0, math.sin(self._t * 2 * math.pi * PALP_DRUM_HZ + math.pi * k))
		palpAngle[k] = math.rad(PALP_DRUM_DEG) * self._drum * burst * beat
	end
	for _, f in self._fixed do
		if f.palp then
			local side = if f.palp == 1 then -1 else 1
			local pivot = CFrame.new(side * 0.10, -0.035, -0.43) * CFrame.Angles(palpAngle[f.palp], 0, 0)
			put(f.part, body * pivot * f.offset)
		else
			put(f.part, body * f.offset)
		end
	end

	-- Legs: planted feet stay put in the world; a leg too far from its rest spot steps, in alternating groups.
	local swinging = false
	for _, leg in self._legs do
		swinging = swinging or leg.swing >= 0
	end
	if grounded and not swinging then
		local worst = STEP_ERROR
		for i, leg in self._legs do
			if leg.planted then
				local err = (body:PointToWorldSpace(restLocal(leg)) - leg.planted :: Vector3).Magnitude
				if err > worst then
					worst = err
					self._group = legGroup(self, i)
				end
			end
		end
	end
	local started = false
	for i, leg in self._legs do
		local rest = body:PointToWorldSpace(restLocal(leg))
		if not grounded then
			leg.planted = nil
			leg.swing = -1
			leg.foot = body:PointToWorldSpace(Vector3.new(leg.side * 0.47, -0.12, TIP_Z[leg.pair] * 0.72))
		else
			if leg.planted == nil then
				local hit = target(self, body, leg)
				leg.planted = if hit then hit.Position else nil
				leg.foot = if hit then hit.Position else rest + up * 0.16
				leg.swing = -1
			end
			local anchor = leg.planted
			if anchor then
				if leg.swing >= 0 then
					leg.swing = math.min(1, leg.swing + dt / SWING_SECONDS)
					local s = leg.swing
					local smooth = s * s * (3 - 2 * s)
					leg.foot = leg.from:Lerp(anchor, smooth) + leg.up * math.sin(math.pi * s) * STEP_HEIGHT
					if leg.swing >= 1 then
						leg.swing = -1
						leg.foot = anchor
					end
				else
					leg.foot = anchor
					local err = (rest - anchor).Magnitude
					if err > STEP_ERROR and ((not swinging and legGroup(self, i) == self._group) or err > 0.60) then
						local hit = target(self, body, leg)
						if hit and (anchor - hit.Position).Magnitude > 0.12 then
							leg.from = anchor
							leg.planted = hit.Position
							leg.up = hit.Normal
							leg.swing = 0
							started = true
						end
					end
					if body:PointToObjectSpace(leg.foot).Magnitude > 1.4 then
						leg.planted = nil
						leg.foot = rest
					end
				end
			end
		end
	end
	if started then
		self._group = 1 - self._group
	end
	for _, leg in self._legs do
		local hip = body:PointToWorldSpace(Vector3.new(leg.side * 0.16, 0.02, HIP_Z[leg.pair]))
		local foot = leg.foot
		local knee = hip:Lerp(foot, 0.48) + up * (if grounded then 0.30 else 0.24)
		local ankle = knee:Lerp(foot, ANKLE_SHARE) + up * ANKLE_LIFT
		local function segment(index: number, p: Part, band: Part, a: Vector3, b: Vector3)
			local len = math.max((b - a).Magnitude, 0.01)
			if math.abs(p.Size.X - len) > 1e-3 then
				p.Size = Vector3.new(len, p.Size.Y, p.Size.Z)
			end
			local rc = rodCFrame(a, b) -- local +X runs from a toward b (toward the foot)
			put(p, rc)
			band.Size = Vector3.new(len * self._appearance.bandFraction, p.Size.Y * 1.035, p.Size.Z * 1.035)
			put(band, rc)
			-- Leg setae stand out from the segment and lean toward the foot.
			local r = p.Size.Y * 0.5
			for _, hair in leg.hairs do
				local spec = hair.spec
				if spec.segment == index then
					local c, s = math.cos(spec.theta), math.sin(spec.theta)
					local base = Vector3.new((spec.t - 0.5) * len, r * 0.8 * c, r * 0.8 * s)
					local dir = Vector3.new(1.3, c, s).Unit
					put(hair.part, rc * CFrame.lookAt(base + dir * (spec.length * 0.5), base + dir * spec.length, Vector3.xAxis))
				end
			end
		end
		segment(1, leg.femur, leg.bands[1], hip, knee)
		segment(2, leg.tibia, leg.bands[2], knee, ankle)
		segment(3, leg.tarsus, leg.bands[3], ankle, foot)
		put(leg.knee, CFrame.new(knee))
		put(leg.ankle, CFrame.new(ankle))
	end
	Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Spider-eye view (Godot SpiderBody.set_eye_view + SurfaceLegs.eye_view): the body, head and palps are hidden and only the
-- front legs' lower segments stay, reaching into the view. Client-only (LocalTransparencyModifier).
local function applyVisibility(self: Rig)
	local function show(p: BasePart, visible: boolean)
		p.LocalTransparencyModifier = if visible then 0 else 1
	end
	local hideBody = self._eyeView or self._bodyHidden
	if self._highlight then (self._highlight :: Highlight).Enabled = not hideBody end
	for _, f in self._fixed do
		show(f.part, not hideBody)
	end
	for _, leg in self._legs do
		local frontReach = self._eyeView and leg.pair == 1
		local all = not hideBody
		show(leg.femur, all); show(leg.bands[1], all); show(leg.knee, all)
		show(leg.tibia, all or frontReach); show(leg.bands[2], all or frontReach)
		show(leg.tarsus, all or frontReach); show(leg.bands[3], all or frontReach); show(leg.ankle, all or frontReach)
		for _, hair in leg.hairs do
			show(hair.part, all or (frontReach and hair.spec.segment >= 2))
		end
	end
end

function SpiderRig.setEyeView(self: Rig, on: boolean)
	self._eyeView = on
	applyVisibility(self)
end

-- The orbit camera hides the spider when its boom is squeezed shorter than BODY_HIDE_LENGTH.
function SpiderRig.setBodyHidden(self: Rig, hidden: boolean)
	self._bodyHidden = hidden
	applyVisibility(self)
end

-- Where the dragline leaves the body.
function SpiderRig.spinneretPoint(_self: Rig, body: CFrame): Vector3
	return body:PointToWorldSpace(Vector3.new(0, 0.06, 0.48))
end

function SpiderRig.destroy(self: Rig)
	self.model:Destroy()
end

return SpiderRig
]]></string>
          </Properties>
        </Item>
      </Item>
