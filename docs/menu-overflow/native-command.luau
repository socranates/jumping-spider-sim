   assert(game:GetService("RunService"):IsStudio() and game:GetService("RunService"):IsClient()) assert(game.PlaceId==109879630247781 and game.GameId==10771634917) local player=assert(game:GetService("Players").LocalPlayer) local gui:any=assert(player.PlayerGui:FindFirstChild("SpiderLifeMenu")) local box:any=assert(gui:FindFirstChild("Box",true)) local list:any=assert(box:FindFirstChildWhichIsA("UIListLayout")) local Panel:any=(require :: any)(player.PlayerScripts.Client.CaughtPanel)  local view:any=setmetatable({gui=gui,box=box,line=box.Line,sub=box.Sub,summary=box.Summary,hint=box.Hint,look="title",scale=1,buttons={}},{__index=Panel}) for _,child in box:GetChildren()do if child:IsA("TextButton")then table.insert(view.buttons,child)end end table.sort(view.buttons,function(a:any,b:any):boolean return a.LayoutOrder<b.LayoutOrder end) local run=tostring(DateTime.now().UnixTimestampMillis) local function emit(kind:string,value:any)print("[MENU_NATIVE_"..kind.."]",run,game:GetService("HttpService"):JSONEncode(value))end local function settle()for _=1,3 do game:GetService("RunService").Heartbeat:Wait()end end local function sample(name:string)  box.CanvasPosition=Vector2.zero;settle()  local row={name=name,window=box.AbsoluteWindowSize.Y,content=list.AbsoluteContentSize.Y,   line_top=box.Line.AbsolutePosition.Y,box_top=box.AbsolutePosition.Y,canvas=box.CanvasPosition.Y,   alignment=tostring(list.VerticalAlignment),text_size=box.Line.TextSize}  assert(row.window>0 and row.canvas==0 and row.line_top>=row.box_top-.5,"first row is clipped above the scroll origin")  local last=if box.Hint.Visible then box.Hint elseif box.Summary.Visible then box.Summary else view.buttons[#view.buttons]  box.CanvasPosition=Vector2.new(0,math.max(0,box.AbsoluteCanvasSize.Y-box.AbsoluteWindowSize.Y));settle()  local footer_bottom=last.AbsolutePosition.Y+last.AbsoluteSize.Y  assert(footer_bottom<=box.AbsolutePosition.Y+box.AbsoluteWindowSize.Y+.5,"last row is not reachable by scrolling")  emit("SAMPLE",{bounds=row,footer_bottom=footer_bottom,visible_bottom=box.AbsolutePosition.Y+box.AbsoluteWindowSize.Y,max_scroll=box.CanvasPosition.Y}) end task.spawn(function()  local ok,problem=xpcall(function()   view:setTextScale(1);settle();sample("normal")   view:setTextScale(1.5);settle();sample("large")   view:setTextScale(1);settle();sample("restored")  end,debug.traceback)  view:setTextScale(1);box.CanvasPosition=Vector2.zero;settle()  emit("END",{ok=ok,problem=if ok then "" else tostring(problem),restored=true}) end)
