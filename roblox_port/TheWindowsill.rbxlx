            <string name="Name">Appearances</string>
            <string name="Source"><![CDATA[--!strict
-- Artist-directed appearance, independent of species tuning, growth and physics.
-- Nathan's daughter's pick: docs/art/first-spider-reference.jpg (2026-10-14). ROBLOX-13 made it cuter without changing it:
-- proportions, eyes, fuzz and a little idle motion. Every number the look needs is in this table.
-- Body frame: +Y up, -Z forward. Lengths are studs (1 stud = 1 Godot WU = 1 cm). Markings are fractions of the abdomen's X/Z radii.
local first = {
	id = "first_spider",
	name = "First spider",

	-- ---------------------------------------------------------------- the daughter's design: colours and pattern
	-- tests/look.luau pins every value in this block. Change them only if she does.
	body = { 0, 0, 0 },
	legs = { 0, 0, 0 },
	white = { 0.94, 0.94, 0.92 },
	eyes = { 0.008, 0.008, 0.008 },
	fangs = { 0.025, 0.025, 0.025 },
	abdomenRadii = { 0.25, 0.205, 0.285 },
	frontLegScale = 1.28,
	bandFraction = 0.23, -- the pale band on each leg and palp segment
	speckleCount = 24,
	-- Large centre, two small elongated anterior spots, two posterior ovals.
	spots = {
		{ x = 0, z = 0.10, rx = 0.080, rz = 0.074, angle = 0 },
		{ x = -0.34, z = -0.46, rx = 0.018, rz = 0.034, angle = -0.35 },
		{ x = 0.34, z = -0.46, rx = 0.018, rz = 0.034, angle = 0.35 },
		{ x = -0.35, z = 0.67, rx = 0.025, rz = 0.035, angle = 0.4 },
		{ x = 0.35, z = 0.67, rx = 0.025, rz = 0.035, angle = -0.4 },
	},
	-- The pale band across the front of the abdomen: `count` dabs, `step` apart, at z.
	band = { count = 9, step = 0.16, z = -0.66, rx = 0.031, rz = 0.018 },
	-- Fine speckles on a spiral: radius `from` + (i % 5) * `step`.
	speckle = { from = 0.40, step = 0.10, rx = 0.0035, rz = 0.005 },

	-- ---------------------------------------------------------------- cuter proportions (ROBLOX-13)
	-- A slightly bigger, rounder head than the abdomen (head volume about 1.07 x the abdomen's; it was 0.77).
	headCenter = { 0, 0.03, -0.21 },
	headRadii = { 0.27, 0.215, 0.27 },
	abdomenCenter = { 0, 0.04, 0.20 },
	pedicel = { center = { 0, -0.035, -0.06 }, radii = { 0.05, 0.05, 0.06 } },
	face = { center = { 0, 0.05, -0.37 }, radii = { 0.225, 0.18, 0.12 } }, -- the rounded muzzle under the eyes
	neck = { 0, 0.0, -0.06 }, -- the head tilts about this point
	-- Pale side patches (the daughter's "cheeks"): placed on the head's side at height y, depth z (body frame).
	cheek = { y = 0.055, z = -0.235, radii = { 0.02, 0.07, 0.115 }, inset = 0.006 },
	chelicerae = { x = 0.055, y = -0.085, z = -0.447, radii = { 0.05, 0.072, 0.045 }, pitch = -0.35, splay = 0.12, reflectance = 0.1 },
	-- Eyes. Never a human face: no brows, no mouth. Big glossy front eyes read as an animal's.
	eye = {
		-- Principal (front) eyes: large, glossy, set low in a big forehead. x, y: where on the head they sit; `out`: how far
		-- they stand out of the head, as a share of their depth. Two catchlights on each, the same on both eyes: a larger one
		-- high toward +X (the light) and a smaller one low toward -X (its reflection).
		ame = {
			x = 0.115, y = 0.095, radii = { 0.100, 0.100, 0.082 }, out = 0.30, reflectance = 0.5,
			socket = { scale = 1.13, color = { 0.11, 0.11, 0.11 } }, -- a dark-grey rim so the black eye reads against the black head
			glints = { { dx = 0.030, dy = 0.036, r = 0.022 }, { dx = -0.028, dy = -0.034, r = 0.010 } },
		},
		ale = { x = 0.235, y = 0.085, r = 0.050, out = 0.15, reflectance = 0.3 }, -- anterior lateral, at the sides of the face
		ple = { x = 0.150, z = -0.150, r = 0.052, out = 0.10, reflectance = 0.3 }, -- posterior lateral, on the dome
		pme = { x = 0.115, z = -0.270, r = 0.019, out = 0.10, reflectance = 0.3 }, -- posterior median, a tiny dot
		glintColor = { 1, 1, 1 },
	},
	-- Pedipalps: stout, pale-banded, pale-tipped, with a fluffy club.
	palp = {
		x = 0.115, y = -0.045, -- where it leaves the face
		drop = 0.105, reach = 0.10, spread = 0.035, -- tip: this far down, forward and out from the base
		stalk = 0.05, club = { 0.042, 0.040, 0.052 }, tipRadii = { 0.030, 0.026, 0.030 },
		fluff = { hairs = 7, length = 0.055, width = 0.012, flat = 0.7, transparency = 0.15 },
		drumHz = 3.2, drumDeg = 13,
	},
	-- Legs (display only): plump, a little shorter and more crouched than before; round feet.
	limbs = {
		hipX = 0.17, hipY = 0.02,
		hipZ = { -0.36, -0.24, -0.12, 0.0 },
		tipZ = { -0.82, -0.52, 0.12, 0.62 },
		-- femur and tibia diameters per pair, stout front legs to slim back legs; `thickness` scales them all.
		diameters = { { 0.078, 0.064 }, { 0.065, 0.053 }, { 0.057, 0.045 }, { 0.059, 0.047 } },
		thickness = 1.12,
		stance = { x = 0.78, y = -0.30, reach = 0.93 }, -- rest foot spot: reach scales x and the pairs' z
		kneeLift = 0.28, kneeLiftAir = 0.22, ankleLift = 0.045,
		pad = 1.6, -- foot ball diameter as a multiple of the tarsus' (full detail)
	},

	-- ---------------------------------------------------------------- fuzz (ROBLOX-07, retuned for the real camera in ROBLOX-13)
	-- The camera sits 5 studs away (CameraMath.CAMERA_DISTANCE), 1 stud is about 170 px on a 1080p screen, so a hair is a few
	-- pixels at most. The first coat answered that with big stiff hairs, and they stood off the body like a hedgehog's and
	-- covered the white spots; the second coat (this one) is short, thin and combed flat, and leaves the softness to the shells.
	fuzz = {
		enabled = true,
		-- The coat is short and sleek, like a real jumping spider's, and it takes its colour from the pattern it grows on:
		-- black hairs on the black areas, white hairs only inside the white spots and the band, nothing grey or frosted on the
		-- body (the daughter's white stays crisp, and a hair is never a pale shard). The softness comes from the fur shells.
		-- `abdomen` and `head` are Fibonacci sample points before the belly is skipped (about 60 % of them become hairs).
		-- `length` and `lift` are ranges (studs; degrees off the surface: 0 lies flat, 90 stands up); `yaw` scatters the
		-- combing (degrees either side of straight back); `flat` is the thickness as a share of the width; `black` is the share
		-- of the blackest tone (the rest is `dark`); `transparency` keeps the coat a little see-through.
		-- Locks: the pelt, lying nearly flat and combed toward the rear.
		locks = { abdomen = 340, head = 130, length = { 0.024, 0.040 }, width = 0.018, flat = 0.22, lift = { 3, 13 }, yaw = 18, black = 0.45, transparency = 0.10 },
		-- Guard hairs: a few short, fine hairs that stand up from the pelt.
		guard = { abdomen = 50, head = 24, length = { 0.030, 0.046 }, width = 0.0085, flat = 1.0, lift = { 50, 75 }, yaw = 35, black = 0.5, transparency = 0.20 },
		-- The fringe: short hairs along the sides (`side`: how far round to the side, as a share of the radius, a hair has to
		-- be), lifted a little, so the outline is ragged by a pixel or two and not by a spike.
		fringe = { abdomen = 170, head = 60, side = 0.78, length = { 0.026, 0.040 }, width = 0.011, flat = 0.5, lift = { 14, 32 }, yaw = 22, black = 0.5, transparency = 0.20 },
		-- White hairs inside the white spots and the band: `density` per square stud of marking, lying on it, kept only when the
		-- whole hair stays `margin` studs inside the edge, so the white keeps its edge.
		pale = { density = 600, length = { 0.021, 0.028 }, width = 0.013, flat = 0.3, lift = { 3, 10 }, yaw = 14, margin = 0.004, transparency = 0.05 },
		clear = 0.006, -- black hairs stay this far (studs) from any white marking
		black = { 0.03, 0.03, 0.03 },
		dark = { 0.13, 0.13, 0.13 },
		grey = { 0.50, 0.50, 0.48 }, -- grey and frost: the face (tufts, ruff) and the palps' fluff only
		frost = { 0.76, 0.76, 0.73 },
		-- Fur shells: see-through layers outside the body, strongest nearest it, so the outline goes soft. Four at full detail,
		-- one at low. A shell tints what is under it as well as what is around it, so they are dark and faint: the white of the
		-- pattern must stay white.
		shellColor = { 0.08, 0.08, 0.08 },
		shells = { { scale = 1.05, transparency = 0.86 }, { scale = 1.10, transparency = 0.92 }, { scale = 1.16, transparency = 0.955 }, { scale = 1.23, transparency = 0.975 } },
		headShell = { zScale = 0.80, shift = 0.05 }, -- the head's shells sit back from the eye row so the eyes stay clear
		-- Little tufts that bold jumping spiders have above the eyes, at the upper sides of the head: a fan of dark and
		-- silvery hairs that sweeps up and out. Not eyebrows: they sit behind the eyes at the sides, not over them.
		tuftHairs = 10, -- per side
		tuftLength = 0.078,
		tuft = { at = { 0.52, 0.80, -0.28 }, lean = { 0.60, 1.0, -0.22 }, fan = 0.46, spread = 0.02, width = 0.0165, flat = 0.8, transparency = 0.1 },
		-- A soft ruff of pale hair low on each cheek, beside the jaws (not a moustache: it sits at the sides).
		ruff = { hairs = 5, length = 0.052, width = 0.0135, flat = 0.7, at = { 0.52, -0.36, -0.74 }, lean = { 0.65, -0.55, -0.45 }, whiteShare = 0.6, transparency = 0.15 },
		legHairs = { 7, 6, 3 }, -- femur, tibia, tarsus, per leg (front legs carry 1.6 x as many on femur and tibia)
		legLength = 0.052,
		legWidth = 0.0125,
		legTransparency = 0.2,
		legBlack = 0.4, -- the share of the blackest tone on the legs (the rest is dark; white over the pale bands)
	},

	-- ---------------------------------------------------------------- idle motion (drawn rig only, ROBLOX-13)
	-- Eased in after the spider has stood still for a moment; off while walking, in the air, in low detail and with reducedMotion
	-- (the palps' drumming follows the same rule).
	idle = {
		riseSeconds = 1.0, fallSeconds = 0.25,
		breathe = { period = 3.3, bodyLift = 0.006, lift = 0.016, pitchDeg = 2.4 },
		-- A small, slow, curious head tilt: sums of sines (periods in seconds), always inside these angles.
		tilt = { rollDeg = 7, yawDeg = 6, pitchDeg = 3.5, periods = { 9.1, 5.3, 11.3, 6.7, 8.3 } },
	},

	-- ---------------------------------------------------------------- detail modes
	-- Full is for PCs. Low is for phones and tablets (touch-only devices, or Workspace attribute Detail = "low"): fewer
	-- hairs (keep one in `every`; 0 drops the whole class, so the low tier has no standing guard hairs), a single fur shell,
	-- no foot balls, half the speckles, no outline and no idle motion at all (no breathing, head tilt or palp drumming).
	-- The pattern, eyes, catchlights and tufts stay.
	detail = {
		full = {
			every = { lock = 1, guard = 1, fringe = 1, pale = 1, tuft = 1, ruff = 1, palp = 1, leg = 1 },
			shells = 4, speckleEvery = 1, pads = true, sockets = true, idle = true, highlight = true,
		},
		low = {
			every = { lock = 3, guard = 0, fringe = 3, pale = 2, tuft = 2, ruff = 2, palp = 2, leg = 4 },
			shells = 1, speckleEvery = 2, pads = false, sockets = false, idle = false, highlight = false,
		},
	},
}

-- ================================================================ the peacock spider (ROBLOX-30)
-- Maratus volans, the male in courtship colours: a second profile beside the daughter's, chosen from the crack (Client/SpiderClient).
-- Morphology after Otto & Hill 2011 (Peckhamia 96.1): a male about 4 to 5 mm long (DOC); a dark carapace with three red-orange
-- stripes and a pale margin (DOC); white palp brushes (DOC); legs III longer and darker than the rest, with black brushes and white
-- tips (DOC); an abdominal fan whose lateral flaps lie folded round the abdomen until the display and then show as a near-round
-- disc: an iridescent blue-green field with a black central figure, red-orange arches and a white fringe (DOC). The exact
-- colours, proportions, stripe sizes and the angles below are ART. 1 stud = 1 cm, so the male is 0.45 studs long: the drawn
-- body is the default spider's face and build at SCALE, with its own colours, a fan and legs III. Collider, senses and physics are
-- the default spider's: this is a drawn appearance only (ROBLOX-30).
local SCALE = 0.47 -- body length 0.455 studs against the default spider's 0.97 (ART, from 4.5 mm and 1 stud = 1 cm)

-- A copy of a table with every number in it multiplied by k, except under the keys in `skip` (angles, shares, counts, colours).
local function scaled(node: any, k: number, skip: { [string]: boolean }): any
	if type(node) == "number" then return node * k end
	if type(node) ~= "table" then return node end
	local out: { [any]: any } = {}
	for key, value in node do
		out[key] = if skip[key] then value else scaled(value, k, skip)
	end
	return out
end
local FACE_SKIP = { out = true, reflectance = true, scale = true, color = true, glintColor = true, pitch = true, splay = true }
local LIMB_SKIP = { thickness = true, pad = true, reach = true }
local PALP_SKIP = { hairs = true, drumHz = true, drumDeg = true, flat = true, transparency = true }
local limbs = scaled(first.limbs, SCALE, LIMB_SKIP)
limbs.thickness = 1.0
limbs.stance = { x = limbs.stance.x, y = -0.10, reach = 0.62 } -- ART: low and compact, the legs not much longer than the body
limbs.pairReach = { 1.0, 1.0, 1.2, 1.0 } -- legs III are the longest (DOC)
local eye = scaled(first.eye, SCALE, FACE_SKIP)
eye.ame.socket = { scale = 1.12, color = { 0.50, 0.31, 0.14 } } -- tan and orange ocular setae frame the big eyes (DOC)
local palp = scaled(first.palp, SCALE, PALP_SKIP)
palp.club = { 0.021, 0.019, 0.026 } -- the white brushes clothe the palps (DOC; sizes ART)
palp.tipRadii = { 0.014, 0.012, 0.014 }
palp.fluff = { hairs = 0, length = 0, width = 0, flat = 1, transparency = 0 }

local volans = {
	id = "maratus_volans_male",
	name = "Peacock spider (male)",
	scale = SCALE, -- SpiderRig scales its own distances (foot search, stepping) by this
	cameraScale = 0.62, -- closer framing for the small appearance; user zoom still applies
 bodyDrop = 0.21, -- the drawn body sits this far (studs) below the collider's centre, so it stands on the surface (the collider is 0.31 high)

	-- ---------------------------------------------------------------- colours (ART, after the photographs in Otto & Hill 2011)
	body = { 0.09, 0.05, 0.04 }, -- carapace: dark brown-black
	legs = { 0.34, 0.22, 0.12 }, -- legs I, II and IV: brown
	white = { 0.93, 0.90, 0.80 }, -- cream: the pale margin, palp brushes, leg bands, the fan's fringe
	eyes = { 0.01, 0.01, 0.01 },
	fangs = { 0.14, 0.08, 0.04 },
	joint = { 0.20, 0.12, 0.07 }, -- knees and ankles
	palpColors = { stalk = { 0.20, 0.12, 0.07 }, club = { 0.93, 0.90, 0.80 }, tip = { 0.97, 0.96, 0.90 } },
	abdomenColor = { 0.05, 0.34, 0.68 }, -- the abdomen is the blue field's colour under the fan's pattern
	stripes = { -- three red-orange stripes down the carapace behind the eyes (DOC); x, z, half widths in studs, body frame
		color = { 0.86, 0.26, 0.07 },
		{ x = 0, z = -0.030, rx = 0.011, rz = 0.050, angle = 0 },
		{ x = -0.050, z = -0.026, rx = 0.009, rz = 0.040, angle = 0.18 },
		{ x = 0.050, z = -0.026, rx = 0.009, rz = 0.040, angle = -0.18 },
	},

	-- ---------------------------------------------------------------- proportions: the default spider's face and build at SCALE
	headCenter = { 0, 0.014, -0.099 },
	headRadii = { 0.125, 0.100, 0.125 }, -- the carapace is boxy and high: a little taller than the scaled default
	abdomenCenter = { 0, 0.019, 0.094 },
	abdomenRadii = { 0.104, 0.088, 0.125 }, -- an oval, narrower than the default's
	pedicel = scaled(first.pedicel, SCALE, {}),
	face = scaled(first.face, SCALE, {}),
	neck = scaled(first.neck, SCALE, {}),
	-- The pale margin along the lower edge of the carapace (DOC): the rig draws these as the "cheek" patches.
	cheek = { y = -0.012, z = -0.075, radii = { 0.010, 0.020, 0.075 }, inset = 0.003 },
	chelicerae = scaled(first.chelicerae, SCALE, FACE_SKIP),
	eye = eye,
	palp = palp,
	limbs = limbs,
	frontLegScale = 1.0,
	bandFraction = 0.12, -- the pale bands on legs I, II and IV
	speckleCount = 0,
	spots = {},
	band = { count = 0, step = 0.1, z = 0, rx = 0.01, rz = 0.01 },
	speckle = { from = 0.4, step = 0.1, rx = 0.004, rz = 0.005 },
	-- Legs III (DOC): dark femur, a thick jet-black brush on the tibia, a snow-white tip, no pale bands. `up` and `swept` are
	-- where the foot goes when they are raised in a V and when a wave sweeps them down and forward (body frame, studs, x mirrored
	-- for the left leg); `kneeOut` pushes the knee outward. All ART.
	pairs = {
		[3] = {
			colors = { { 0.13, 0.08, 0.05 }, { 0.02, 0.02, 0.025 }, { 0.96, 0.95, 0.90 } },
			thick = { 1.0, 1.7, 1.9 },
			bands = false,
			up = { x = 0.21, y = 0.23, z = -0.015 },
			swept = { x = 0.10, y = 0.12, z = -0.12 },
			kneeOut = 0.05,
		},
	},

	-- ---------------------------------------------------------------- the fan (DOC: blue-green field, black figure, red-orange arches, white fringe; ART: sizes)
	-- Flat discs on the abdomen's back (dorsal) face, stacked from the fringe in. `radii` are the open fan's half width and half
	-- length (a near-round disc, a little wider than long), `folded` the share of that it shows folded; each layer is `inset` studs
	-- smaller than the one under it. `plane` is the fan's height over the abdomen's top (it floats a hair above the dome), `zShift` moves
	-- its centre toward the rear so the raised fan stands clear of the head. The figure is three black dabs (two lobes in front, a bar
	-- behind), given as fractions of the radii. The back (ventral) side repeats the rim and the field so the fan is a fan from behind.
	fan = {
		radii = { 0.165, 0.150 }, folded = { 0.42, 0.55 }, plane = 0.004, zShift = 0.018, layerStep = 0.0022, thickness = 0.004,
		foldedThickness = 0.042, foldedSink = 0.021, -- folded, the discs are thick and sunk into the dome (a lens on the abdomen) and flatten as the fan opens
		layers = {
			{ name = "FanFringe", color = { 0.95, 0.94, 0.88 }, inset = 0.0 },
			{ name = "FanArch", color = { 0.96, 0.30, 0.065 }, inset = 0.015 },
			{ name = "FanField", color = { 0.025, 0.48, 0.82 }, inset = 0.046 },
			{ name = "FanArch", color = { 0.88, 0.25, 0.06 }, inset = 0.078 },
			{ name = "FanField", color = { 0.02, 0.65, 0.67 }, inset = 0.092 },
		},
		figureColor = { 0.02, 0.02, 0.03 },
		-- A black trident on the blue: a long bar and two slanting prongs (fractions of the radii; angle in radians). Never a face.
		figure = { { x = 0, z = 0.05, rx = 0.07, rz = 0.50, angle = 0 }, { x = -0.30, z = -0.18, rx = 0.07, rz = 0.30, angle = 0.55 }, { x = 0.30, z = -0.18, rx = 0.07, rz = 0.30, angle = -0.55 } },
		back = { plane = -0.004, layers = { 1, 2, 3 } }, -- the layers (by number) the back repeats, and where (this far under the abdomen's belly)
		flaps = { color = { 0.88, 0.25, 0.06 }, radii = { 0.030, 0.006, 0.085 }, hingeX = 0.080, hingeY = 0.040, foldedDeg = -80 }, -- the folded flaps on the flanks
		sheen = 0.18,
	},
	-- Legs III in a dance: how the pose's raise and wave move them (ART).
	dance = { kneeUp = 0.03 },

	-- ---------------------------------------------------------------- no fuzz: at this size the coat would be sub-pixel
	fuzz = nil,

	idle = {
		riseSeconds = 1.0, fallSeconds = 0.25,
		breathe = { period = 3.0, bodyLift = 0.003, lift = 0.008, pitchDeg = 2.4 },
		tilt = { rollDeg = 7, yawDeg = 6, pitchDeg = 3.5, periods = { 9.1, 5.3, 11.3, 6.7, 8.3 } },
	},

	-- Full is for PCs; low is for phones and tablets: no foot balls, no eye sockets, no leg bands, no idle motion, no outline, no back to the fan, a plainer fan.
	detail = {
		full = {
			every = { lock = 1, guard = 1, fringe = 1, pale = 1, tuft = 1, ruff = 1, palp = 1, leg = 1 },
			shells = 0, speckleEvery = 1, pads = true, sockets = true, idle = true, highlight = true, fanBack = true, fanLayers = 5, legBands = true,
		},
		low = {
			every = { lock = 0, guard = 0, fringe = 0, pale = 0, tuft = 0, ruff = 0, palp = 0, leg = 0 },
			shells = 0, speckleEvery = 1, pads = false, sockets = false, idle = false, highlight = false, fanBack = false, fanLayers = 3, legBands = false,
		},
	},
}

-- ART: six fine teal scale streaks catch light on the open fan. Full detail only; mobile keeps its 80-part budget.
for _,side in {-1,1} do
 for _,z in {-0.36,0,0.36} do
  table.insert(volans.fan.figure,{x=side*0.49,z=z,rx=0.018,rz=0.10,angle=side*z*0.65,
   color={0.30,0.80,0.86},fullOnly=true})
 end
end

return { default = "first_spider", profiles = { first_spider = first, maratus_volans_male = volans } }
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Detail</string>
            <string name="Source"><![CDATA[--!strict
-- Which detail tier a device runs: "full" for computers and consoles, "low" for touch-only phones and tablets. The tier
-- decides the spider's fuzz and idle motion (Data/Appearances.detail) and which optional parts of the world stay
-- (Data/Graphics, Client/WorldDetail). A Workspace attribute `Detail` = "low" or "full" overrides the device guess, so a
-- low-powered laptop or a fast tablet can be tried either way without a code change.
local Detail = {}

export type Tier = "full" | "low"

function Detail.choose(touchOnly: boolean, override: unknown): Tier
	if override == "low" then return "low" end
	if override == "full" then return "full" end
	return if touchOnly then "low" else "full"
end

return Detail
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Eyes</string>
            <string name="Source"><![CDATA[--!strict
-- The numbers of the spider-eye picture (ROBLOX-20): how each way of seeing looks, how the two retinae move, how the lateral
-- eyes' sense of movement is drawn and what is shown the first time. Shared/UI/EyeOptics works the pictures out from these and
-- Client/SpiderEyes draws them. Presentation only: nothing here reaches the senses, the motor, the jump planner, the aim ray or
-- where the camera stands. A number that is a choice and not a measurement says so. Nothing here has been seen in Roblox Studio.
--
-- What the picture leans on (related species, not measured in the player's Phidippus audax unless a line says so):
--   * The principal eyes (anterior median, AM) are the high-acuity telephoto pair with a tiny field: the fovea-based field is
--     0.8 degrees (Portia fimbriata) to 5 degrees (Metaphidippus aeneolus) wide and up to 20 degrees tall (Shepeleva 2022,
--     Vision 6(1):2, summarising Land 1969). Each retina is a narrow boomerang- or V-shaped strip moved by three pairs of
--     muscles (side to side, up and down, rotation), so the sharp strip scans a target while the lens stays put (Land 1969,
--     J. Exp. Biol. 51, doi:10.1242/jeb.51.2.471). The retina has four layers, and distance is judged from how defocused the
--     image is on them (Nagata et al. 2012, Science 335:469-471).
--   * The principal eyes of Phidippus have a UV receptor (about 370 nm) and a green one (about 525-532 nm): possibly
--     dichromatic colour vision (DeVoe 1975, J. Gen. Physiol. 66:193-207, Phidippus regius). Several species studied lack a red
--     receptor, so red would look like dark, low-luminance green (Glenszczyk et al. 2022, Sci. Nat. 109:6, Saitis barbipes).
--   * The secondary eyes are the anterior lateral (ALE), the posterior median (often vestigial) and the posterior lateral (PLE).
--     Together they cover about 330 degrees horizontally (Trite planiceps; Shepeleva 2022). Their acuity is much lower (ALE 0.3-1.3
--     cycles per degree, PLE 0.3-0.6) than the AM eyes' (up to 12.5, Portia), and their photoreceptors are almost entirely
--     green-sensitive. The ALEs detect motion and trigger the turn toward it (Zurek et al. 2010, J. Exp. Biol. 213:2372-2378,
--     doi:10.1242/jeb.042382); the PLEs are wide-angle motion detectors.
-- What it does not claim: a spider's colour experience, the receptor responses of this species, or the all-round field. The
-- ultraviolet layer is authored decor shown only through the principal eyes, an illustration and not a measured reflectance
-- (docs/VISION_RESEARCH.md, EYE-14, still applies to prey, glass and leaves). The sensor's own peripheral cone (Species,
-- peripheral_cone_degrees 300) is narrower than the anatomical 330 degrees: the shimmer shows what the sensor found.

local Eyes = {}

Eyes.sources = {
	land1969 = "Land 1969, Movements of the retinae of jumping spiders in response to visual stimuli, J. Exp. Biol. 51 (doi:10.1242/jeb.51.2.471)",
	shepeleva2022 = "Shepeleva 2022, Vision 6(1):2 (summarising Land 1969 and others)",
	nagata2012 = "Nagata et al. 2012, Science 335:469-471 (depth from image defocus between retinal layers)",
	devoe1975 = "DeVoe 1975, J. Gen. Physiol. 66:193-207 (UV and green receptors in the principal eyes of Phidippus regius)",
	glenszczyk2022 = "Glenszczyk et al. 2022, Sci. Nat. 109:6 (no red receptor in Saitis barbipes)",
	zurek2010 = "Zurek et al. 2010, J. Exp. Biol. 213:2372-2378 (the anterior lateral eyes detect motion and trigger the turn)",
}

-- ---------------------------------------------------------------- the two ways of seeing (k = 0 and k = 1)
-- Everything that depends on k is listed here for both ends; EyeOptics.profile blends every number by k (the field of view in
-- tangent space, so the zoom looks even).
-- Side eyes (k = 0): a wide view, almost one colour, a little blurred, and loosely focused. The field of view is a choice: a flat
-- screen cannot show about 330 degrees, so it is a wide 90 degrees vertical. Saturation -0.85 and a clear green tint stand for
-- receptors that are almost all green-sensitive: one kind of receptor, so one colour. Roblox does not document whether the tint
-- is applied before or after the saturation; at -0.85 either order leaves a green picture (tint last: green monochrome; tint
-- first: reds already darkened, then mostly grey with a green cast). Judge it in Studio and tune here. The blur is far gentler than the measured acuity ratio (about 10 to 40 times lower than the
-- AM eyes), so the sill stays readable; it never touches the GUI. The loose depth of field (far 0.35, near 0.25, in focus out to at
-- least 6 studs or 0.6 of the distance looked at) says only that nothing is sharp.
-- Principal eyes (k = 1): a narrow telephoto view, sharp, in green and ultraviolet, with only the looked-at distance in focus
-- (depth from defocus, Nagata 2012). 24 degrees is a choice: just wider than the 20 degrees a retina is tall. The tint cuts red
-- (115 of 255), so reds go dark as for a green-and-UV dichromat; blue is kept as the stand-in for the short-wave (UV) receptor. That
-- is an illustration, not a spectral response. The depth of field is tight (far 0.75, near 0.6, in focus within 0.12 of the
-- distance looked at, never less than 0.6 stud).
-- The retina strips' stroke is faint while the side eyes look and a little stronger once the principal eyes do; `sweepDeg` and `torsionDeg`
-- are how far each strip swings side to side and turns about its middle (scanning with the side eyes, small tracking movements
-- with the principal eyes). The vignette is the telephoto dark edge, as an opacity at the screen's edge.
Eyes.side = {
	fovDeg = 90,
	saturation = -0.85, tint = { 170, 228, 165 }, contrast = 0.12, brightness = 0.03,
	blur = 2.5,
	dofFar = 0.35, dofNear = 0.25, dofRadiusMin = 6, dofRadiusPerStud = 0.6,
	strokeTransparency = 0.82, fillTransparency = 0.96,
	sweepDeg = 4, torsionDeg = 12,
	vignette = 0.35,
}
Eyes.principal = {
	fovDeg = 24,
	saturation = 0.15, tint = { 115, 255, 236 }, contrast = 0.16, brightness = 0.02,
	blur = 0,
	dofFar = 0.75, dofNear = 0.6, dofRadiusMin = 0.6, dofRadiusPerStud = 0.12,
	strokeTransparency = 0.68, fillTransparency = 0.93, -- fainter than first drawn: zoomed in, the strips are large and frame the target
	sweepDeg = 0.6, torsionDeg = 3,
	vignette = 0.55,
}

-- How fast k moves: it runs 0 to 1 in engageSeconds while Focus is held (or toggled on) and back in releaseSeconds. A choice; the
-- time is a duration, not a time constant, so any frame rate gives the same picture after the same time.
Eyes.timing = { engageSeconds = 0.35, releaseSeconds = 0.5 }

-- Reduced motion (Player attribute ReducedMotion = true): the retinae hold still, the shimmer holds steady, and the zoom stops at
-- 45 degrees, a gentler change than 90 to 24.
Eyes.reducedMotion = { minFovDeg = 45 }

-- Depth of field follows what is looked at: a ray along the view, at most maxDistance studs, eased with a time constant so the focus
-- racks from one distance to the next instead of jumping.
Eyes.focus = { maxDistance = 40, tauSeconds = 0.15 }

-- ---------------------------------------------------------------- the retinae
-- Each strip is drawn at its true angular size for the field of view (widthDeg x heightDeg, from Shepeleva 2022 / Land 1969: the
-- widest and the tallest reported), offsetDeg either side of the middle, tilted tiltDeg into a shallow V (the boomerang, Land
-- 1969). Offset and tilt are choices. Scanning (Land 1969: side to side, up and down, rotation) is drawn as a side-to-side sweep
-- and a turn about the strip's middle: the sweep has a period of sweepSeconds and the second strip follows the first lagSeconds
-- later in both movements; the turn has a period of torsionSeconds. The amplitudes are in Eyes.side and Eyes.principal. Land's
-- own periods are slower for the turn (about 5-15 s, up to about 50 degrees; docs/VISION_RESEARCH.md): these are faster and
-- smaller so that the scanning can be seen within a few seconds. They are presentation values.
Eyes.retina = {
	widthDeg = 5, heightDeg = 20, offsetDeg = 3, tiltDeg = 10,
	sweepSeconds = 1.7, lagSeconds = 0.3, torsionSeconds = 2.6,
	strokeColor = { 200, 255, 220 }, strokeThickness = 1.5,
	fillColor = { 200, 255, 220 },
	-- the fill's transparency along the strip, from one end to the other (more see-through toward the ends)
	fillRamp = { { 0, 0.6 }, { 0.5, 0 }, { 1, 0.6 } },
}

-- ---------------------------------------------------------------- the lateral eyes' sense of movement
-- A thing the sensor's sight-line checks found moving (Sensor.motionSeen, the T13a record the eye picture reads and nothing else
-- does) gets a ring where it is on screen, pulsing between scaleMin and scaleMax times its apparent size (never less than minPx
-- across), faded over the sensor's hold (Sensor.MOTION_HOLD_TICKS), and at alpha x insideStripFactor where it lies inside a
-- retina strip: the principal eyes see form there, the surround sees movement (Zurek 2010; Godot EYE-10). Off screen it shows as a
-- short arc at the screen's edge toward it. At most maxMovers at once, freshest first. The pulse is at or under the 3 Hz flash
-- guideline over a small area, and holds steady with reduced motion. The look (light ring with a dark outline so it reads on bright
-- and dark ground) is a choice.
Eyes.shimmer = {
	hz = 3, scaleMin = 1.0, scaleMax = 1.6, minPx = 14, maxMovers = 8,
	alpha = 0.9, insideStripFactor = 0.3,
	ringColor = { 226, 255, 232 }, ringThickness = 2,
	shadowColor = { 8, 20, 12 }, shadowThickness = 1.5, shadowAlpha = 0.6, shadowGrowPx = 2, -- the dark ring sits just outside the light one
	-- the edge arc: `segments` short bars `stepDeg` apart along a circle of `radius` px whose outermost point is `inset` px
	-- from the screen's edge, in the direction of the thing; alpha breathes with the pulse by `breath`
	arc = { inset = 20, radius = 56, segments = 5, stepDeg = 8, length = 10, thickness = 3.5, alpha = 0.85, breath = 0.25 },
}

-- ---------------------------------------------------------------- the telephoto vignette
-- Four edge frames, each darkest at the screen's edge and clear toward the middle. The peak opacity is in Eyes.side and
-- Eyes.principal. `ramp` is the gradient's transparency from the edge inward; the bands are fractions of the screen's height
-- (top and bottom) and width (left and right).
Eyes.vignette = {
	color = { 8, 20, 12 },
	ramp = { { 0, 0 }, { 0.25, 0.35 }, { 0.55, 0.75 }, { 1, 1 } },
	topBottom = 0.22, leftRight = 0.16,
}

-- ---------------------------------------------------------------- the words, the first time
-- Shown the first time the eye view is open (for `seconds` of it; leaving pauses it), under the status lines, fading in and out.
-- %s is "Hold" or "Press" (a toggled Focus) and then the Focus key or button of the device in use (ControlText).
Eyes.caption = {
	seconds = 6, fadeInSeconds = 0.4, fadeOutSeconds = 1.5,
	side = "Spider-eye view: the side eyes see wide, mostly in green, and catch movement.",
	principal = "%s %s for the principal eyes: narrow, sharp, telephoto, in green and ultraviolet (shown as violet).",
	hold = "Hold", toggle = "Press",
}

-- ---------------------------------------------------------------- the ultraviolet layer
-- Workspace.Decor.UVLayer holds parts drawn only for the principal eyes (flower petal patterns), each fully transparent with a
-- number attribute UVOpacity (the folder's own is the fallback). In the eye view a part's Transparency is 1 - k x UVOpacity on
-- this client only; outside it, 1. The folder is looked up at most every lookupSeconds until it exists.
Eyes.uv = { folder = { "Decor", "UVLayer" }, opacityAttribute = "UVOpacity", lookupSeconds = 1 }

-- ---------------------------------------------------------------- where it lives
-- The overlay sits under the jump reticle, the prompts and the perception HUD (DisplayOrder 4): SpiderHud's screens have the default
-- order 0, so the overlay's is below that.
Eyes.overlay = { name = "EyeOverlay", displayOrder = -5 }
Eyes.effects = { grade = "EyeGrade", blur = "EyeBlur", dof = "MacroDOF" }

return Eyes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Flora</string>
            <string name="Source"><![CDATA[--!strict
-- The plants of the drawn world: the Pilea on the sill, the trough's planting, and the garden outside the window. Numbers and
-- names only; Habitat/Plants builds them. Colours are hex, lengths studs (1 stud = 1 cm). Nothing here is solid or queryable, and
-- nothing here moves a physical piece: a drawn leaf's top is its piece's top, a drawn stem sits inside its piece's box.

local Flora = {}

-- ---------------------------------------------------------------- the Pilea (Chinese money plant, "pancake plant")
-- Pilea peperomioides has round, peltate leaves: the stalk joins the blade from below, away from its edge, and the veins fan out
-- from that point. These pups rooted in a crack of the old sill. Each hidden leaf piece is drawn as a pancake that fills its
-- footprint with its top at the piece's top, and each stem piece as a round petiole inscribed in its box.
Flora.pilea = {
	plants = {
		{ leaf = "leaf_west", stem = "stem_west" },
		{ leaf = "leaf_middle", stem = "stem_middle" },
		{ leaf = "leaf_east", stem = "stem_east" },
	},
	tip = "leaf_tip", -- the dry leaf, drawn as a curled fragment
	radius = 1.6, -- corner radius of the pancake, in plan
	material = "SmoothPlastic",
	top = "4f7d3a", rim = "3e6a31", under = "93b56d", dot = "bcdca0", vein = "86b567", petiole = "6a8f45",
	rimOut = 0.14, rimDrop = 0.06, rimFoot = 0.05, -- the darker rim band: how far past the blade, how far below its top, how far above its underside
	underOut = 0.02, underBelow = 0.012, underThick = 0.12, -- the lighter underside: past the blade, below it, how thick
	dotDiameter = 0.34, dotHeight = 0.012,
	veins = { count = 8, width = 0.05, height = 0.008, margin = 0.55, start = 0.22, reach = 0.94, jitter = 0.14 },
	foot = { diameter = 1.7, height = 0.2, color = "587c3a" },
	-- where each stem meets the sill: dark cracks radiating from it and a pinch of crumbled soil
	cracks = { count = 4, length = { 1.3, 3.2 }, width = 0.055, height = 0.004, color = "3b2f24", transparency = 0.1 },
	crumbs = { count = 7, size = { 0.12, 0.34 }, spread = 1.5, colors = { "4a3a2c", "5b4838", "3f3125" } },
	seed = 5,
	dry = {
		color = "c9a66b", edge = "a98250", curl = "b8935c", radius = 0.8,
		edgeWidth = 0.13, edgeHeight = 0.01, edgeInset = 0.12,
		-- curled-up corners: where (x, z), how far the plate turns about the vertical (degrees) and tips up (degrees)
		curls = { { x = 27.85, z = -4.0, turn = 35, tip = 24 }, { x = 25.9, z = -2.05, turn = -20, tip = 18 } },
		curlSize = { 0.9, 0.04, 0.55 },
	},
}

-- ---------------------------------------------------------------- the trough's planting
-- The soil patch (WindowsillLayout.DECOR "soil") is 12 x 6 at (10, 4.61, -4), on the rim slab's top.
Flora.planter = {
	soil = "4a3a2c", -- the soil's colour (the layout's own 665644 is the old look)
	area = { x0 = 4.3, x1 = 15.7, z0 = -6.7, z1 = -1.3, y = 4.615 }, -- where things may lie on the soil
	mottle = { -- damper and drier patches in the soil: x, z, width, depth, colour (full tier)
		{ x = 6.8, z = -5.3, w = 3.6, d = 1.7, color = "3d2f24" }, { x = 12.6, z = -2.6, w = 4.2, d = 1.5, color = "574433" },
		{ x = 9.6, z = -4.6, w = 2.4, d = 1.2, color = "43352a" }, { x = 14.4, z = -5.9, w = 2.8, d = 1.0, color = "534232" },
	},
	pebbles = { count = 15, length = { 0.3, 0.8 }, flat = 0.42, colors = { "b9b6ae", "a9aaa6", "c8c4b9", "9c9a94", "d2cfc6" }, seed = 21 },
	moss = {
		patches = { { x = 5.5, z = -2.2, r = 0.8, n = 8 }, { x = 14.7, z = -6.0, r = 0.9, n = 9 }, { x = 9.9, z = -1.7, r = 0.6, n = 6 } },
		size = { 0.22, 0.5 }, tall = 0.5, colors = { "5f8a3a", "6b9b47", "4f7b34" }, seed = 22,
	},
	-- tiny seedlings, under a centimetre tall: two cotyledons on a short stalk
	seedlings = { { x = 7.6, z = -4.9, turn = 20 }, { x = 12.2, z = -2.4, turn = -35 }, { x = 14.0, z = -5.2, turn = 70 } },
	stalk = 0.5, stalkWidth = 0.05, stalkColor = "b4d98a",
	cotyledon = { 0.46, 0.05, 0.22 }, cotyledonColor = "8cc466", cotyledonRise = 0.1, cotyledonTurn = 28, cotyledonTip = 14,
	-- a damp stain above the foot of the trough, and pale salt along its top edge, on all four faces of the trough
	stain = {
		color = "8a482d", transparency = 0.22, height = 0.9, thickness = 0.012,
		-- tide marks: from, to (fractions along a face) and how high
		tide = { { 0.0, 0.34, 1.3 }, { 0.34, 0.71, 1.75 }, { 0.71, 1.0, 1.1 } }, tideColor = "9a5a38", tideTransparency = 0.55,
		salt = { { 0.06, 0.22 }, { 0.46, 0.62 }, { 0.8, 0.93 } }, saltColor = "e4d6c0", saltTransparency = 0.5, saltHeight = 0.07, saltGap = 0.1,
	},
}

-- ---------------------------------------------------------------- the garden outside the window
-- A weathered window box beyond the wall (its top hides behind the wall's apron), black-eyed Susans (Rudbeckia hirta) in it, and
-- flowering shrubs further out. None of it can be reached. The view out is placed as seen from the camera's usual spot
-- (Graphics.view.eye); the box and the flowers stand where they really are.
Flora.garden = {
	box = {
		x0 = -24.5, x1 = 24.5, z0 = -21.8, z1 = -13.62, top = 2.8, bottom = -3.2,
		color = "6f8796", rim = "7f98a5", paint = "c4d0d2", soil = "392c21", soilTop = 2.55, rimWidth = 0.9,
		-- patches where the paint has lifted: x, z (on the rim and the far board), width, depth
		peel = { { -17.0, -21.6, 3.2, 0.6 }, { -2.5, -21.6, 2.4, 0.5 }, { 11.0, -21.6, 4.0, 0.6 }, { 20.5, -13.9, 3.0, 0.5 } },
	},
	-- Rudbeckia: head centre height y (above the sill), where it stands in the box (x, z), how much the head nods and turns toward the room (degrees), size
	flowers = {
		{ x = -23.2, z = -17.0, y = 5.5, nod = -8, turn = 14, size = 0.9 },
		{ x = -17.8, z = -15.8, y = 7.0, nod = -12, turn = -10, size = 1.0 },
		{ x = -12.4, z = -18.6, y = 6.0, nod = -4, turn = 22, size = 1.05 },
		{ x = -5.6, z = -16.3, y = 4.9, nod = -14, turn = -18, size = 0.95 },
		{ x = 0.8, z = -19.0, y = 7.7, nod = -9, turn = 6, size = 1.1 },
		{ x = 6.2, z = -15.9, y = 5.8, nod = -6, turn = -24, size = 1.0 },
		{ x = 12.6, z = -17.8, y = 7.2, nod = -13, turn = 16, size = 0.9 },
		{ x = 18.2, z = -16.3, y = 5.1, nod = -10, turn = -8, size = 1.05 },
		{ x = 23.0, z = -18.4, y = 6.6, nod = -5, turn = -20, size = 0.95 },
	},
	rudbeckia = {
		petals = { 12, 14 }, -- how many each head has (12 to 14)
		petalLength = 1.25, petalWidth = 0.55, petalThick = 0.07, droop = 9, -- degrees the tips sag away from the viewer
		petalColors = { "f2b705", "f6c112", "eaa900" }, disc = "e09a05", discOut = 0.45,
		centre = 0.42, centreHeight = 0.34, centreColor = "3b2414", -- the dome
		stem = "5c8a3a", stemWidth = 0.18, stemBend = 0.45,
		leaf = "4c7a33", leafSize = { 1.7, 0.05, 0.5 },
		-- the ultraviolet pattern: the outer half of each petal reflects it, the base and the centre absorb it (the classic bullseye)
		uv = { color = "b98cff", opacity = 0.85, rise = 0.03, thick = 0.02 },
		seed = 100,
	},
	-- flowering shrubs further out: where they appear on the glass (u across, v up), how far beyond it, how wide they look there
	shrubs = {
		{ u = -24, v = 3.6, depth = 30, w = 6, bloom = "pink" },
		{ u = -17, v = 3.9, depth = 44, w = 8, bloom = "white" },
		{ u = -9.5, v = 3.5, depth = 36, w = 6.5, bloom = "pink" },
		{ u = -2.5, v = 4.1, depth = 52, w = 8.5, bloom = "white" },
		{ u = 4.5, v = 3.6, depth = 32, w = 6, bloom = "pink" },
		{ u = 11.5, v = 4.0, depth = 46, w = 8, bloom = "white" },
		{ u = 18, v = 3.5, depth = 34, w = 6.5, bloom = "pink" },
		{ u = 25, v = 3.8, depth = 48, w = 8, bloom = "white" },
	},
	shrub = {
		foliage = { "4a6f3c", "56804a", "3f6334" },
		pink = { "f4c7d3", "ee9fb9", "f9dbe3", "e98fae" }, white = { "f8f4ec", "efe9de", "fbfaf5", "e6e0d2" },
		blooms = 14, bloomSize = { 0.13, 0.22 }, -- as a share of the shrub's width
		seed = 40,
	},
}

return Flora
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">FlyLook</string>
            <string name="Source"><![CDATA[--!strict
-- How a fly looks: numbers and names only; Client/FlyBodies builds the parts and places them each frame. A house fly (Musca
-- domestica) about 0.7 cm long, 1 stud = 1 cm. The prey profile (Data/Species fly_like_prototype) makes no species claim: this is
-- only how the prototype is drawn. Body frame: -Z forward, +Y up the surface normal, the origin the body's centre, which is where the
-- fly's position is, `hover` above the surface: the feet stand on y = -hover. Lengths are studs, colours hex, angles degrees. Ellipsoids
-- are Parts with a SpecialMesh sphere (Roblox forces a Ball part to be a sphere); rods are Cylinder parts, whose axis is X, so their Size
-- is (length, diameter, diameter).

local FlyLook = {}

FlyLook.hover = 0.16 -- the prey profile's body.hover_wu

FlyLook.colors = {
	eye = "8a2f1c", face = "cfd2cc", head = "4a4640", proboscis = "3a2b23",
	thorax = "5b5d58", stripe = "23211e", abdomen = "7b7266", dorsal = "35302a",
	femur = "3a332b", tibia = "2b2621", bristle = "1d1a17",
	wing = "d8e4ea", vein = "56463a", film = "f0c8ff", shadow = "2a241c",
} :: { [string]: string }

-- The ellipsoids that are always in place: centre, diameters, turn about x, y, z. The eyes are glossy.
FlyLook.body = {
	{ name = "Thorax", color = "thorax", at = { 0, 0.02, -0.05 }, size = { 0.27, 0.25, 0.30 } },
	{ name = "Abdomen", color = "abdomen", at = { 0, -0.002, 0.19 }, size = { 0.25, 0.21, 0.35 } },
	{ name = "Head", color = "head", at = { 0, -0.005, -0.28 }, size = { 0.19, 0.16, 0.15 } },
	{ name = "EyeL", color = "eye", reflectance = 0.07, at = { -0.079, 0.012, -0.275 }, size = { 0.12, 0.16, 0.14 } },
	{ name = "EyeR", color = "eye", reflectance = 0.07, at = { 0.079, 0.012, -0.275 }, size = { 0.12, 0.16, 0.14 } },
	{ name = "Face", color = "face", reflectance = 0.06, at = { 0, -0.015, -0.345 }, size = { 0.042, 0.13, 0.045 } }, -- the pale silver stripe between the eyes
	{ name = "Proboscis", color = "proboscis", at = { 0, -0.088, -0.335 }, size = { 0.045, 0.045, 0.12 }, turn = { -30, 0, 0 } }, -- short, pointing forward and down
} :: { { name: string, color: string, reflectance: number?, at: { number }, size: { number }, turn: { number }? } }

-- Thin dark slices that follow the curve of the ellipsoid `on`, `proud` of it: the thorax's four stripes and the abdomen's dorsal stripe.
-- x: where across the body, width: how wide.
FlyLook.proud = 0.002
FlyLook.slices = {
	{ name = "ThoraxStripe1", on = "Thorax", color = "stripe", x = -0.065, width = 0.024 },
	{ name = "ThoraxStripe2", on = "Thorax", color = "stripe", x = -0.025, width = 0.02 },
	{ name = "ThoraxStripe3", on = "Thorax", color = "stripe", x = 0.025, width = 0.02 },
	{ name = "ThoraxStripe4", on = "Thorax", color = "stripe", x = 0.065, width = 0.024 },
	{ name = "DorsalStripe", on = "Abdomen", color = "dorsal", x = 0, width = 0.045 },
} :: { { name: string, on: string, color: string, x: number, width: number } }

-- Six legs of two segments, a femur and a tibia with its foot: hip, knee and foot of the right front, middle and hind leg (the left
-- ones mirror them), standing and in flight (tucked and trailing). A rod runs `overlap` past the knee at each end so the joint has no gap.
FlyLook.legs = {
	femur = 0.024, tibia = 0.017, overlap = 0.01,
	stand = {
		{ name = "Front", hip = { 0.055, -0.09, -0.16 }, knee = { 0.135, -0.04, -0.24 }, foot = { 0.20, -0.16, -0.31 } },
		{ name = "Middle", hip = { 0.075, -0.09, -0.06 }, knee = { 0.175, -0.035, -0.07 }, foot = { 0.265, -0.16, -0.085 } },
		{ name = "Hind", hip = { 0.07, -0.09, 0.04 }, knee = { 0.155, -0.04, 0.17 }, foot = { 0.225, -0.16, 0.31 } },
	},
	fly = {
		{ name = "Front", hip = { 0.055, -0.09, -0.16 }, knee = { 0.10, -0.115, -0.24 }, foot = { 0.07, -0.20, -0.29 } },
		{ name = "Middle", hip = { 0.075, -0.09, -0.06 }, knee = { 0.13, -0.13, -0.03 }, foot = { 0.12, -0.21, 0.04 } },
		{ name = "Hind", hip = { 0.07, -0.09, 0.04 }, knee = { 0.105, -0.125, 0.14 }, foot = { 0.085, -0.215, 0.30 } },
	},
} :: { femur: number, tibia: number, overlap: number, stand: { { name: string, hip: { number }, knee: { number }, foot: { number } } }, fly: { { name: string, hip: { number }, knee: { number }, foot: { number } } } }

-- Tiny bristles on the head, the thorax and the abdomen: from a point just inside the body to the tip. Right side; `mirror` adds the left.
FlyLook.bristles = {
	diameter = 0.007,
	items = {
		{ from = { 0.027, 0.061, -0.284 }, to = { 0.043, 0.119, -0.319 }, mirror = true }, -- on the head, pointing up and forward
		{ from = { 0.047, 0.124, -0.022 }, to = { 0.066, 0.176, 0.011 }, mirror = true }, -- on the thorax's back
		{ from = { 0.037, 0.098, 0.044 }, to = { 0.05, 0.132, 0.103 }, mirror = true }, -- at the thorax's rear, pointing back
		{ from = { 0.078, 0.051, 0.267 }, to = { 0.111, 0.084, 0.317 }, mirror = true }, -- on the abdomen's side
	},
} :: { diameter: number, items: { { from: { number }, to: { number }, mirror: boolean } } }

-- The wings: thin ellipsoids (Glass), each with a dark leading-edge vein (a thin rod along the front, near the edge) and a faint
-- iridescent film (thin-film interference colours, Shevtsova et al. 2011, PNAS 108:668-673) just above the glass. At rest they are
-- folded back over the abdomen in a shallow V: from a root on the thorax, `yaw` turned outward from straight back, `pitch` up, `roll`
-- with the outer edge down. In flight they are replaced by a soft blur: a fan each side, flat, from the root outward and a little
-- back (`yaw`) for `reach`, `span` across, the outer edge `roll` up, two layers of translucent glass and film; the veins hide.
FlyLook.wing = {
	root = { 0.078, 0.112, -0.10 }, length = 0.60, width = 0.22, thick = 0.006,
	yaw = 9, pitch = 4, roll = 5,
	transparency = 0.55, reflectance = 0.1,
	vein = { diameter = 0.008, offset = 0.055, from = -0.42, to = 0.40, transparency = 0.2 }, -- from, to: along the wing, as shares of its length from the middle
	film = { rise = 0.004, grow = 0.004, transparency = 0.82 },
	fan = {
		reach = 0.36, span = 0.34, roll = 8, yaw = 20, back = 0.02, rise = 0.01, transparency = 0.80, -- the denser blur near the root
		film = { reach = 0.56, span = 0.54, transparency = 0.92 }, -- the fainter blur out to the tips
		shimmer = { 19, 0.05 }, -- radians per second, radians: the fan trembles a little
	},
}

-- A soft dark oval on the surface under a standing fly stands in for its shadow (the parts cast none): size, how far above the surface.
FlyLook.shadow = { size = { 0.34, 0.004, 0.70 }, lift = 0.003, transparency = 0.78 }

return FlyLook
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Graphics</string>
            <string name="Source"><![CDATA[--!strict
-- How the world looks, apart from the spider (whose look is Data/Appearances). Numbers and names only, so the whole look can
-- be tuned in one place: Habitat/Scenery builds the parts from it, Habitat/Lit sets up the lighting and the sky, Habitat/SunPick
-- finds a sun that shines in through the window, and Client/WorldDetail strips what the low tier does without.
-- Studs: 1 stud = 1 cm. Colours are hex. Materials are Roblox's own (Habitat/Materials), which carry PBR textures once
-- MaterialService.Use2022Materials is on (both Rojo projects set it). Nothing here has been seen in Roblox Studio (ROBLOX-14).

local Graphics = {}

-- ---------------------------------------------------------------- materials
-- Looks only: a surface's grip is its profile in Data/Surfaces, never its material.
Graphics.materials = {
	-- the physical pieces of the sill (Habitat/WindowsillLayout.PIECES), by id. SmoothPlastic is clean at any scale: the sill is
	-- cream enamel, the leaves are glossy; Roblox's textured materials tile in studs, so at 1 stud = 1 cm they are coarse.
	pieces = {
		sill_floor = "SmoothPlastic", front_lip = "SmoothPlastic",
		back_frame = "Plaster", left_frame = "Plaster", right_frame = "Plaster",
		planter = "Plaster", planter_rim = "Plaster",
		leaf_west = "SmoothPlastic", leaf_middle = "SmoothPlastic", leaf_east = "SmoothPlastic", leaf_tip = "Plaster",
		stem_west = "SmoothPlastic", stem_middle = "SmoothPlastic", stem_east = "SmoothPlastic",
		crevice_back = "Wood", crevice_roof = "Wood", crevice_north = "Wood", crevice_south = "Wood",
	} :: { [string]: string },
	soil = "Ground",
	-- Glass hides translucent UV petals behind the pane in native Studio. Preserve tint/reflection without refraction.
	wall = "Plaster", trim = "SmoothPlastic", glass = "SmoothPlastic",
	view = "SmoothPlastic", ground = "Grass",
	chip = "Wood", crack = "SmoothPlastic", crumb = "Sand",
	fallback = "SmoothPlastic",
}

-- The colour (and shine) a piece is drawn in when it is not the layout's own colour, which is the frozen Godot habitat's: cream
-- enamel on the sill, plaster side walls, terracotta, weathered dark wood in the crevice. Looks only. Pieces the drawn Pilea
-- replaces keep the layout's colours, which show only if the drawing could not be built.
Graphics.paint = {
	sill_floor = { color = "e8dfcb", reflectance = 0.03 }, front_lip = { color = "e8dfcb", reflectance = 0.03 },
	left_frame = { color = "efe8d8" }, right_frame = { color = "efe8d8" },
	planter = { color = "b8653f" }, planter_rim = { color = "c97a52" },
	crevice_back = { color = "362b20" }, crevice_roof = { color = "4a3c2e" }, crevice_north = { color = "3f3326" }, crevice_south = { color = "3f3326" },
} :: { [string]: { color: string, reflectance: number? } }

-- ---------------------------------------------------------------- the window
-- The back wall is a solid, climbable box (WindowsillLayout back_frame), so the window is drawn: the physical wall turns
-- invisible (still solid, still climbable) and Scenery draws a plaster wall behind its face with an opening for the glass.
Graphics.window = {
	hidden = "back_frame", -- the piece that turns invisible
	slabGap = 0.02, -- the drawn wall sits this far behind the climbable face, so the spider's feet never sink into it
	left = -27.5, right = 27.5, bottom = 3, top = 13, -- the opening: x from/to, y from/to
	trimWidth = 0.5, trimDepth = 0.10, trimReflectance = 0.04, -- the frame bars around the opening, flush with the climbable face; glossy
	wallColor = "efe8d8", trimColor = "f4efe3",
	glass = { color = "cfe3e6", transparency = 0.86, reflectance = 0.12, thickness = 0.04, setback = 0.05 },
	mullions = { -10, 10 }, mullionWidth = 0.7, -- bars between the panes
	-- WindowsillLayout.DECOR entries Scenery draws itself
	replaces = { window_glass = true, mullion_w = true, mullion_e = true } :: { [string]: boolean },
}

-- ---------------------------------------------------------------- the view out of the window
-- Items are placed as seen from a reference eye (the camera's usual spot over the middle of the sill): u, v are where the
-- item's centre appears on the glass (studs across and up), `depth` how far beyond the glass it really is; Scenery turns
-- that into world positions and sizes, so every item shows where it should whatever the depth. kind "block": a box w x h
-- on the glass, `t` deep; "ball": a sphere of diameter w; "roof": a gable (a square turned 45 degrees) w wide with its
-- eave line at v. `full`: dropped in the low tier.
Graphics.view = {
	eye = Vector3.new(0, 2.5, 5),
	ground = { y = -46, size = 2048, color = "7d8f62" },
	sky = true,
	items = {
		-- far hills
		{ id = "hill_w", kind = "ball", u = -20, v = -7.0, depth = 320, w = 22, color = "88a08d", full = false },
		{ id = "hill_m", kind = "ball", u = 3, v = -6.2, depth = 330, w = 24, color = "92a898", full = true },
		{ id = "hill_e", kind = "ball", u = 24, v = -6.6, depth = 320, w = 22, color = "8aa28f", full = false },
		-- roofs of the houses across the way
		{ id = "house_1", kind = "block", u = -24, v = -2.7, depth = 120, w = 6.0, h = 14, t = 5, color = "d8c9a8", full = false },
		{ id = "roof_1", kind = "roof", u = -24, v = 4.3, depth = 120, w = 6.5, t = 5.4, color = "8d4a3a", full = false },
		{ id = "house_2", kind = "block", u = -16.5, v = -3.1, depth = 120, w = 5.0, h = 14, t = 5, color = "c9bba0", full = true },
		{ id = "roof_2", kind = "roof", u = -16.5, v = 3.9, depth = 120, w = 5.5, t = 5.4, color = "5f6a73", full = true },
		{ id = "house_3", kind = "block", u = -8.5, v = -2.4, depth = 120, w = 6.4, h = 14, t = 5, color = "e0d3b5", full = false },
		{ id = "roof_3", kind = "roof", u = -8.5, v = 4.6, depth = 120, w = 7.0, t = 5.4, color = "9a5642", full = false },
		{ id = "house_4", kind = "block", u = 0.5, v = -3.0, depth = 120, w = 5.3, h = 14, t = 5, color = "cdbfa4", full = true },
		{ id = "roof_4", kind = "roof", u = 0.5, v = 4.0, depth = 120, w = 5.8, t = 5.4, color = "6a5a52", full = true },
		{ id = "house_5", kind = "block", u = 9, v = -2.2, depth = 120, w = 6.6, h = 14, t = 5, color = "d6c6a6", full = false },
		{ id = "roof_5", kind = "roof", u = 9, v = 4.8, depth = 120, w = 7.2, t = 5.4, color = "7b4a3d", full = false },
		{ id = "house_6", kind = "block", u = 17.5, v = -2.9, depth = 120, w = 5.5, h = 14, t = 5, color = "c4b99f", full = true },
		{ id = "roof_6", kind = "roof", u = 17.5, v = 4.1, depth = 120, w = 6.0, t = 5.4, color = "58626b", full = true },
		{ id = "house_7", kind = "block", u = 25, v = -2.5, depth = 120, w = 6.2, h = 14, t = 5, color = "dccfb0", full = false },
		{ id = "roof_7", kind = "roof", u = 25, v = 4.5, depth = 120, w = 6.8, t = 5.4, color = "93513f", full = false },
		{ id = "chimney_3", kind = "block", u = -7.3, v = 6.7, depth = 119, w = 0.6, h = 2.4, t = 0.8, color = "8c5a48", full = true },
		{ id = "chimney_5", kind = "block", u = 10.3, v = 6.85, depth = 119, w = 0.6, h = 2.5, t = 0.8, color = "86553f", full = true },
		-- a tree on the left, a smaller one on the right
		{ id = "trunk_a", kind = "block", u = -17, v = -3.2, depth = 72, w = 1.3, h = 23.5, t = 1.3, color = "4a3e30", full = false },
		{ id = "canopy_a1", kind = "ball", u = -17, v = 10.5, depth = 72, w = 11, color = "3f6238", full = false },
		{ id = "canopy_a2", kind = "ball", u = -23.5, v = 8.5, depth = 72, w = 8.5, color = "496f40", full = false },
		{ id = "canopy_a3", kind = "ball", u = -10.5, v = 9.0, depth = 72, w = 8, color = "35552f", full = true },
		{ id = "canopy_a4", kind = "ball", u = -19.5, v = 13.5, depth = 72, w = 7, color = "446a3b", full = true },
		{ id = "canopy_a5", kind = "ball", u = -13.5, v = 13.2, depth = 72, w = 6.5, color = "3a5c34", full = true },
		{ id = "canopy_a6", kind = "ball", u = -26, v = 12, depth = 72, w = 6, color = "4d7544", full = true },
		{ id = "trunk_b", kind = "block", u = 18.5, v = 1.5, depth = 100, w = 0.9, h = 14, t = 0.9, color = "50443a", full = true },
		{ id = "canopy_b1", kind = "ball", u = 18.5, v = 7.2, depth = 100, w = 6.5, color = "47703e", full = true },
		{ id = "canopy_b2", kind = "ball", u = 22, v = 6.2, depth = 100, w = 5, color = "3d6336", full = true },
		{ id = "canopy_b3", kind = "ball", u = 15, v = 6.0, depth = 100, w = 4.5, color = "4f7746", full = true },
	} :: { { id: string, kind: string, u: number, v: number, depth: number, w: number, h: number?, t: number?, color: string, full: boolean } },
}

-- ---------------------------------------------------------------- small details on the sill (full tier only)
-- Flat or tiny, away from the spawn and the silk practice spot, so the landing patch, the silk lines and the prompts stay clear.
Graphics.details = {
	-- chips in the paint, showing the bare wood: where (x, z), size (w across, d deep), turn in degrees, colour
	chips = {
		{ x = -8.6, z = 10.5, w = 0.62, d = 0.40, turn = 20, color = "9b7650" }, { x = -7.7, z = 10.9, w = 0.34, d = 0.27, turn = -35, color = "8f6b47" }, { x = -6.6, z = 10.2, w = 0.45, d = 0.30, turn = 70, color = "9b7650" },
		{ x = 11.6, z = 9.8, w = 0.55, d = 0.38, turn = -15, color = "9b7650" }, { x = 12.5, z = 10.3, w = 0.30, d = 0.22, turn = 50, color = "a58058" }, { x = 24.6, z = 7.9, w = 0.50, d = 0.33, turn = 35, color = "9b7650" },
		{ x = -3.8, z = 5.4, w = 0.36, d = 0.26, turn = -60, color = "8f6b47" }, { x = -14.9, z = 8.6, w = 0.58, d = 0.36, turn = 10, color = "9b7650" }, { x = -15.6, z = 8.1, w = 0.28, d = 0.20, turn = -25, color = "a58058" },
		{ x = 27.0, z = 11.0, w = 0.70, d = 0.45, turn = 0, color = "9b7650" }, { x = 20.5, z = 5.0, w = 0.40, d = 0.30, turn = 80, color = "8f6b47" }, { x = 0.5, z = 8.8, w = 0.32, d = 0.24, turn = -10, color = "9b7650" },
	},
	chipThickness = 0.012,
	-- cracks in the sill: polylines of x, z points; the first is the main crack, the others branch off it
	cracks = {
		{ { -11.0, 9.9 }, { -9.4, 8.9 }, { -8.3, 9.3 }, { -6.5, 7.9 }, { -5.7, 8.2 }, { -3.2, 6.6 } },
		{ { -6.5, 7.9 }, { -5.9, 6.7 }, { -6.3, 5.9 } },
	},
	crackWidth = 0.05, crackColor = "4d3d2e", crackHeight = 0.004,
	-- crumbs: centre (x, y, z), size (sx, sy, sz), turn in degrees, colour
	crumbs = {
		{ x = 14.6, y = 0.11, z = 8.6, sx = 0.34, sy = 0.22, sz = 0.27, turn = 25, color = "d6b684" },
		{ x = 14.95, y = 0.07, z = 8.75, sx = 0.20, sy = 0.14, sz = 0.16, turn = -40, color = "c9a56f" },
		{ x = 14.3, y = 0.045, z = 8.3, sx = 0.12, sy = 0.09, sz = 0.10, turn = 70, color = "e0c493" },
	},
}

-- ---------------------------------------------------------------- lighting
Graphics.lighting = {
	brightness = 2.6,
	ambient = { 70, 66, 58 }, outdoorAmbient = { 150, 146, 132 },
	colorShiftTop = { 255, 240, 214 }, -- a soft warm sun
	environmentDiffuse = 1, environmentSpecular = 1,
	shadowSoftness = 0.2, exposureCompensation = 0.1,
	clockTime = 9.6, latitude = 40.7, -- used when no through-window sun can be found (SunPick)
}
-- SunPick looks for a time of day whose sun stands behind the window and low enough to shine in across the sill.
Graphics.sun = {
	elevationDeg = 30, minElevationDeg = 18, maxElevationDeg = 48,
	azimuthDeg = 30, maxAzimuthDeg = 65, -- angle between straight out of the window (-Z) and the sun's heading
	clockFrom = 7, clockTo = 17, clockStep = 0.25,
}
-- Day and night (ROBLOX-24, after Godot's LIFE-06). The life clock's daylight (0 night to 1 day) blends the daytime values above
-- toward these. At full daylight everything is exactly the daytime look. The sun: Roblox puts the sun from ClockTime, so the
-- day keeps the through-the-window clock SunPick chose, and dusk runs that morning backwards toward `nightClock`, before
-- sunrise, so the sun sinks on the window's side and the sky goes dark with stars; dawn runs it forwards again. Night is dim
-- and blue, never black. Every number is a first guess until it is seen in Studio.
Graphics.dayNight = {
	nightClock = 4.0, -- ClockTime at full night (the sun well below the horizon)
	brightness = 0.6, -- Lighting.Brightness at night (the moon's light)
	ambient = { 38, 42, 58 }, outdoorAmbient = { 58, 68, 98 },
	exposureCompensation = -0.25,
	lowSunColorShiftTop = { 255, 196, 150 }, -- the colour of a low sun; white again by daylight warmFrom (Godot: smoothstep 0 to 0.6)
	warmFrom = 0.6,
	atmosphereColor = { 70, 82, 112 }, atmosphereDecay = { 92, 84, 110 },
	motesAtNight = 0.15, -- the dust motes' brightness at night (they catch the sun by day)
	applyStep = 0.002, -- the light is set again once daylight has changed by this much (and whenever it reaches 0 or 1)
}
Graphics.atmosphere = { density = 0.30, offset = 0.25, color = { 199, 215, 232 }, decay = { 232, 196, 150 }, glare = 0.3, haze = 1.0 }
Graphics.sky = { sunAngularSize = 12, moonAngularSize = 11, starCount = 3000 }
Graphics.clouds = { cover = 0.45, density = 0.5, color = { 250, 248, 240 } }
Graphics.bloom = { intensity = 0.45, size = 24, threshold = 1.4 }
Graphics.grade = { contrast = 0.1, saturation = 0.1, tint = { 255, 246, 232 }, brightness = 0 }
Graphics.sunRays = { intensity = 0.05, spread = 0.7 }
-- Macro depth of field: on in the full tier unless the Workspace attribute DepthOfField is false. The sill stays sharp (everything
-- within `radius` of the focus, which the client sets to the camera-to-spider distance) and the garden outside the window melts
-- into soft bokeh. Nothing near is blurred.
Graphics.depthOfField = { far = 0.3, near = 0, focus = 6, radius = 18 }

-- ---------------------------------------------------------------- dust motes and light shafts
Graphics.dust = {
	at = Vector3.new(0, 6.1, -1), size = Vector3.new(56, 11, 22),
	rate = 7, lifetime = { 14, 18 }, speed = { 0.04, 0.16 }, particle = { 0.05, 0.11 },
	transparency = 0.55, lightEmission = 0.55, lightInfluence = 0.35, color = "fff0d2",
	texture = "rbxasset://textures/particles/smoke_main.dds",
}
-- Soft shafts of light from the window along the sun, a few stacked translucent ribbons each (full tier only).
Graphics.shafts = {
	x = { -18.75, 0, 18.75 }, -- where along the window each starts (the middle of each pane)
	startY = 11.5, -- height on the glass where a shaft starts
	grow = 1.25, -- how much wider a shaft is where it reaches the floor
	layers = { { 2.4, 0.972 }, { 4.0, 0.982 }, { 6.0, 0.99 } }, -- width, transparency
	lightEmission = 0.5, color = "fff0d2",
}

-- ---------------------------------------------------------------- detail tiers
Graphics.tiers = {
	full = { dustRate = 1.0 },
	low = { dustRate = 0.4 }, -- also drops everything built with FullOnly: bloom, sun rays, clouds, shafts, details, the busier view
}

return Graphics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">NotebookPages</string>
            <string name="Source"><![CDATA[--!strict
-- The naturalist's notebook pages (LEARN-01), GENERATED by tools/gen_notebook_pages.py from the frozen Godot
-- data/notebook/pages.json. Do not edit by hand. Ids, triggers, titles, texts and sources are Godot's, word for word
-- (docs/NOTEBOOK_SOURCES.md says how far each source was checked: citations were confirmed, no paper was read in full).
-- `game` is the page's "In this game" line: Godot's own where it is true of the Roblox game, otherwise the Roblox one,
-- with Godot's kept as `godotGame` (tests/notebook.luau lists exactly which). {reel}, {letGo}, {drop} and {focus} are filled
-- in with the name of that control on the device in use. Pages are listed in Godot's order.
-- Numbers: the thresholds Godot's field_notebook.gd and notebook_watch.gd use for the moments that open a page.
local NotebookPages = {}

export type Page = { id: string, trigger: string, title: string, text: string, game: string, godotGame: string?, sources: { string } }

-- Every trigger a page may name (Godot field_notebook.gd TRIGGERS). "eye_time_N": N seconds in the spider-eye view, all told.
NotebookPages.triggers = {
	"start",
	"jump",
	"jump_far",
	"jump_long",
	"eye_view",
	"eye_time_20",
	"eye_time_60",
	"shimmer",
	"fly_recognised",
	"catch",
	"meal",
	"felt",
	"buzz",
	"rest",
	"sleep",
	"hungry",
	"well_fed",
	"moult_ready",
	"moulted",
	"adult",
	"wasp",
	"wasp_escaped",
	"wasp_caught",
	"starving",
	"dance",
}

-- The reserve at or under hungryAt is "hungry"; at or over wellFedAt, "well fed" (LIFE_DESIGN.md round 1).
NotebookPages.hungryAt = 0.25
NotebookPages.wellFedAt = 0.85
-- A leap at least this long (studs, launch to landing point; one stud is a centimetre) is far; at least jumpLongWu is long.
NotebookPages.jumpFarWu = 5.0
NotebookPages.jumpLongWu = 8.0
-- Seconds in the spider-eye view, all told, that open the pages named eye_time_N.
NotebookPages.eyeMarks = { 20, 60 }
-- A fly taking off this close (studs) is heard (Godot soundscape.gd HEAR_WU, which gave the caption the buzz page answered to).
NotebookPages.hearWu = 10.0
-- How long the note that a page opened stays on the screen (Godot notebook_panel.gd NOTE_S).
NotebookPages.noteSeconds = 6.0

NotebookPages.pages = {
	{
		id = "bold_jumper",
		trigger = "start",
		title = "The bold jumping spider",
		text = "The first spider is inspired by the bold jumping spider, Phidippus audax. It lives across much of North America, often on walls, fences and windowsills. Adults are about 6 to 15 millimetres long, and females are usually bigger than males. Look for its shining green-blue fangs and the pale spots on its black abdomen.",
		game = "The first spider is inspired by the bold jumper. The peacock is a different species with the same game rules. Our models and three growth stages are stylised; one stud represents a centimetre.",
		godotGame = "This windowsill is built at true scale: one game unit is one centimetre, about the length of the spider.",
		sources = {
			"Edwards, G. B. (2004). Revision of the jumping spiders of the genus Phidippus (Araneae: Salticidae). Occasional Papers of the Florida State Collection of Arthropods 11.",
		},
	},
	{
		id = "dragline",
		trigger = "jump",
		title = "A line before every leap",
		text = "Before it jumps, a jumping spider usually fixes a silk line to the surface behind it. In the air the line helps keep its body steady, and if it misses, it can hang from the line and climb back. Spiders of the species Hasarius adansoni landed more steadily when they had their line.",
		game = "The spider here fixes a safety line when it leaps, where the surface holds silk, and a missed jump leaves it hanging. On the line, {reel} reels in and holding {letGo} lets go. {drop} lets it down on its line; hold it to keep lowering.",
		godotGame = "The spider here dips its abdomen to fix the line, and a missed jump leaves it hanging. Reel in with W / stick up; let go with Q / B. F / D-pad down lets it down on its line from anywhere; hold it to keep lowering.",
		sources = {
			"Chen, Y.-K., Liao, C.-P., Tsai, F.-Y. & Chi, K.-J. (2013). More than a safety line: jump-stabilizing silk of salticids. Journal of the Royal Society Interface 10: 20130572. https://pmc.ncbi.nlm.nih.gov/articles/PMC3758018/",
		},
	},
	{
		id = "legs_push",
		trigger = "jump_far",
		title = "Legs that push",
		text = "Jumping spiders have no giant jumping legs like a grasshopper. High-speed films of Phidippus regius show the third and fourth pairs of legs straightening at take-off. Spiders can stretch some leg joints by raising their blood pressure, but that study found the leg muscles could supply the power for a jump.",
		game = "The drawn spider does not yet show its back legs pushing off.",
		godotGame = "Watch the back legs straighten as the spider leaves the surface.",
		sources = {
			"Nabawy, M. R. A., Sivalingam, G., Garwood, R. J., Crowther, W. J. & Sellers, W. I. (2018). Energy and time optimal trajectories in exploratory jumps of the spider Phidippus regius. Scientific Reports 8: 7142. https://doi.org/10.1038/s41598-018-25227-9",
		},
	},
	{
		id = "eight_eyes",
		trigger = "eye_view",
		title = "Eight eyes, different jobs",
		text = "Jumping spiders have eight eyes. The two big front eyes see sharp detail, but only in a narrow field. The eyes beside them watch for movement, and the others look out to the sides and behind, so the spider can notice something almost anywhere and turn to look at it.",
		game = "The spider-eye view is an impression made from this research, not a recording of what a spider sees.",
		sources = {
			"Land, M. F. (1969). Movements of the retinae of jumping spiders (Salticidae: Dendryphantinae) in response to visual stimuli. Journal of Experimental Biology 51: 471-493. https://doi.org/10.1242/jeb.51.2.471",
			"Zurek, D. B., Taylor, A. J., Evans, C. S. & Nelson, X. J. (2010). The role of the anterior lateral eyes in the vision-based behaviour of jumping spiders. Journal of Experimental Biology 213: 2372-2378. https://doi.org/10.1242/jeb.042382",
		},
	},
	{
		id = "moving_retinas",
		trigger = "eye_time_20",
		title = "Eyes that look without turning",
		text = "The big front eyes cannot turn: their lenses are fixed in the head. Instead, the retina at the back of each eye moves. It sweeps from side to side and slowly twists, so the spider can scan what it is looking at without moving its body.",
		game = "The two sharp strips that sweep and twist in the eye view show this.",
		sources = {
			"Land, M. F. (1969). Movements of the retinae of jumping spiders (Salticidae: Dendryphantinae) in response to visual stimuli. Journal of Experimental Biology 51: 471-493. https://doi.org/10.1242/jeb.51.2.471",
		},
	},
	{
		id = "motion_first",
		trigger = "shimmer",
		title = "Movement first, shape later",
		text = "The eyes beside the big front pair are motion detectors. When everything but these eyes was covered, jumping spiders of the Australian species Servaea vestita still turned toward moving dots and even stalked flies. These eyes can notice a movement smaller than the gap between their own light-sensing cells.",
		game = "The shimmering ring in the eye view shows something the side eyes saw moving before the front eyes can tell what it is.",
		sources = {
			"Zurek, D. B., Taylor, A. J., Evans, C. S. & Nelson, X. J. (2010). The role of the anterior lateral eyes in the vision-based behaviour of jumping spiders. Journal of Experimental Biology 213: 2372-2378. https://doi.org/10.1242/jeb.042382",
			"Zurek, D. B. & Nelson, X. J. (2012). Hyperacute motion detection by the lateral eyes of jumping spiders. Vision Research 66: 26-30.",
		},
	},
	{
		id = "hunting_by_sight",
		trigger = "fly_recognised",
		title = "A hunter that uses its eyes",
		text = "Jumping spiders catch their food without a web. A hunt usually goes like this: turn to face a movement, look at it with the big front eyes, creep closer, crouch, and leap.",
		game = "Here the spider becomes surer of what something is the longer it looks at it.",
		sources = {
			"Jackson, R. R. & Pollard, S. D. (1996). Predatory behavior of jumping spiders. Annual Review of Entomology 41: 287-308.",
		},
	},
	{
		id = "venom",
		trigger = "catch",
		title = "The bite",
		text = "A jumping spider grips its catch with its front legs and fangs and bites. The venom soon stops the prey from struggling.",
		game = "In this game the fly weakens over several seconds as the venom works.",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
		},
	},
	{
		id = "drinking",
		trigger = "meal",
		title = "A meal you drink",
		text = "Spiders cannot swallow solid food. They digest their meal partly outside the body: they pour digestive juices onto the prey and suck up the liquid food.",
		game = "",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
		},
	},
	{
		id = "felt",
		trigger = "felt",
		title = "Feeling through the feet",
		text = "Spiders feel vibrations through tiny slits in the hard skin of their legs, called slit sensilla. A group of them near the end of each leg picks up very small shakes of the surface the spider stands on.",
		game = "The ripple on the screen and the low thrum stand in for this. A vibration reaches the spider only through touching surfaces, never across a gap.",
		sources = {
			"Barth, F. G. (2002). A Spider's World: Senses and Behavior. Springer.",
		},
	},
	{
		id = "hearing",
		trigger = "buzz",
		title = "Hearing without ears",
		text = "Jumping spiders have no ears, yet the bold jumping spider responds to low sounds. In experiments these spiders froze at a low hum, and cells in their brains answered to sounds of 80 to 380 vibrations a second, even from more than 3 metres away. Fine hairs on the legs, moved by the air, probably do the hearing.",
		game = "Buzzing is a human-audible cue, not a recording of what a spider experiences.",
		godotGame = "The fly's buzz you hear here is about 200 vibrations a second, inside that range.",
		sources = {
			"Shamble, P. S., Menda, G., Golden, J. R., et al. (2016). Airborne acoustic perception by a jumping spider. Current Biology 26: 2913-2920. https://doi.org/10.1016/j.cub.2016.08.041",
		},
	},
	{
		id = "retreat",
		trigger = "rest",
		title = "A silk retreat",
		text = "Jumping spiders do not build webs to catch food, but they do spin retreats: small tents of silk in a crack or under a leaf, where they rest at night, moult and shelter from bad weather.",
		game = "In this game the crack in the sill is the retreat. The spider does not spin one yet.",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
		},
	},
	{
		id = "depth_blur",
		trigger = "jump_long",
		title = "Judging distance by blur",
		text = "How does a jumping spider know how far to jump? One answer is blur. The big front eyes have retinas in layers, and one layer always gets a slightly blurred picture; how blurred depends on how far away things are. In green light the spiders of the species Hasarius adansoni jumped accurately. In red light they jumped short, as this idea predicts.",
		game = "In this game a jump lands where the marker shows, whatever the light.",
		sources = {
			"Nagata, T., Koyanagi, M., Tsukamoto, H., et al. (2012). Depth perception from image defocus in a jumping spider. Science 335: 469-471. https://doi.org/10.1126/science.1211667",
		},
	},
	{
		id = "green_uv",
		trigger = "eye_time_60",
		title = "Green and ultraviolet",
		text = "In the big front eyes of the related Phidippus regius, light-sensing cells respond best to green and to ultraviolet, a colour people cannot see; no cells most sensitive to red were found. Some other jumping spiders, such as Habronattus, see red with the help of a red filter inside the eye.",
		game = "A screen cannot show ultraviolet, so the eye view shows it as violet, and only the principal eyes see it ({focus}).",
		godotGame = "A screen cannot show ultraviolet, and ordinary colours carry no ultraviolet information, so the eye view says 'UV not simulated'.",
		sources = {
			"DeVoe, R. D. (1975). Ultraviolet and green receptors in principal eyes of jumping spiders. Journal of General Physiology 66: 193-207. https://doi.org/10.1085/jgp.66.2.193",
			"Zurek, D. B., Cronin, T. W., Taylor, L. A., Byrne, K., Sullivan, M. L. G. & Morehouse, N. I. (2015). Spectral filtering enables trichromatic vision in colorful jumping spiders. Current Biology 25: R403-R404.",
		},
	},
	{
		id = "home_before_dark",
		trigger = "sleep",
		title = "Home before dark",
		text = "Jumping spiders hunt in daylight. Spiders of the related species Phidippus johnsoni go into their silk nests before dark and stay inside through the night, and in bad weather.",
		game = "Rest in the crack in the evening to sleep until morning. A day lasts about fifteen minutes of active play.",
		godotGame = "Rest in the crack in the evening to sleep until morning. The game compresses time: a day here passes in about a quarter of an hour of play, and a real bold jumping spider lives about a year.",
		sources = {
			"Jackson, R. R. (1979). Nests of Phidippus johnsoni (Araneae, Salticidae): characteristics, pattern of occupation, and function. Journal of Arachnology 7: 47-58.",
		},
	},
	{
		id = "hungry_at_home",
		trigger = "hungry",
		title = "Hungry, yet at home",
		text = "In one field study, most bold jumping spiders stayed in their silk nests during the day, and the ones inside were hungrier than the ones out hunting. The author suggests the spiders switch between resting and active spells, with hunger deciding when to switch.",
		game = "Here hunger shows in the spider's thinner abdomen and in the words under the day. A spider that goes too long without food starves, except on Easy and in free play.",
		godotGame = "Here hunger shows in the spider's thinner abdomen and its energy. A reserve that runs out does not yet end a life; that comes in a later version.",
		sources = {
			"Okuyama, T. (2011). Biphasic activity of a jumping spider. Naturwissenschaften 98: 15-22. https://doi.org/10.1007/s00114-010-0734-3",
		},
	},
	{
		id = "full_abdomen",
		trigger = "well_fed",
		title = "A full abdomen",
		text = "A spider's abdomen stretches as it feeds and shrinks as it goes without. Biologists judge how well fed a spider is by the size of its abdomen compared with the rest of its body.",
		game = "Watch the spider's abdomen grow after a meal and slowly shrink over the days.",
		sources = {
			"Jakob, E. M., Marshall, S. D. & Uetz, G. W. (1996). Estimating fitness: a comparison of body condition indices. Oikos 77: 61-67.",
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
		},
	},
	{
		id = "outgrowing_a_skin",
		trigger = "moult_ready",
		title = "Outgrowing a skin",
		text = "A spider's hard outer skin cannot stretch, so to grow it must shed it. This is called moulting. Spiders of the related species Phidippus johnsoni stay in their silk nest for about six days before a moult and two days after it.",
		game = "Rest in the crack when your spider is ready. Real spiders usually stop eating before a moult; here the spider can still eat, and the days are compressed.",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
			"Jackson, R. R. (1979). Nests of Phidippus johnsoni (Araneae, Salticidae): characteristics, pattern of occupation, and function. Journal of Arachnology 7: 47-58.",
		},
	},
	{
		id = "new_skin",
		trigger = "moulted",
		title = "A new skin",
		text = "In a moult the spider pulls itself out of its old skin and leaves an empty husk behind. The new skin is pale and soft at first and hardens over the following hours. Until it does, the spider is more easily hurt.",
		game = "Your spider is pale and its jumps shorter while its skin hardens. The ten game-hour timing is a design choice. The empty skin stays in the crack.",
		godotGame = "Your spider is paler and its jumps shorter while the new skin hardens. How long that takes for a jumping spider has not been measured; the game's timing is a guess. Look for the old skin in the crack.",
		sources = {
			"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.",
		},
	},
	{
		id = "grown_up",
		trigger = "adult",
		title = "Grown up",
		text = "Jumping spiders moult several times before they are adults. In the field, males of the related Phidippus johnsoni became adult after about six to eight moults and females after about seven to nine. Bold jumping spiders spend the winter as juveniles and become adults in spring.",
		game = "The game compresses growth into three moults. Adulthood in a Standard main life opens Easy for this session. The male peacock look and dance are cosmetic choices at every gameplay stage.",
		godotGame = "Your spider is an adult: you have finished the main life. The game shows only its last three moults.",
		sources = {
			"Jackson, R. R. (1978). The life history of Phidippus johnsoni (Araneae, Salticidae). Journal of Arachnology 6: 1-29.",
			"Taylor, B. B. & Peck, W. B. (1975). A comparison of northern and southern forms of Phidippus audax. Journal of Arachnology 2: 89-99.",
		},
	},
	{
		id = "mud_dauber",
		trigger = "wasp",
		title = "A hunter of spiders",
		text = "The black-and-yellow mud dauber, Sceliphron caementarium, is a wasp about 2 to 3 centimetres long. It builds nests of mud in sheltered places on buildings, such as under eaves, and it is active by day in spring and summer. It hunts spiders, jumping spiders among them. It finds a spider by sight, then touches it with its antennae before it stings.",
		game = "You hear the wasp before it reaches the sill. The silk-lined crack is safe. Keeping still makes you hard to notice, and a jump or a drop on your line breaks its approach.",
		godotGame = "You hear the wasp before it reaches the sill, see its shadow, and feel it land. The silk-lined crack is safe. Keeping still makes you hard to notice, and a jump or a drop on your line breaks its approach.",
		sources = {
			"Powell, E. C. & Taylor, L. A. Black and yellow mud dauber, Sceliphron caementarium (Drury, 1773). Featured Creatures EENY-654 / IN1478, University of Florida IFAS Extension. https://ask.ifas.ufl.edu/publication/IN1478",
			"Grissell, E. E. (1973). Sceliphron caementarium (Drury), a mud daubing wasp. Entomology Circular 136, Florida Department of Agriculture and Consumer Services, Division of Plant Industry.",
			"Uma, D., Durkee, C., Herzner, G. & Weiss, M. (2013). Double deception: ant-mimicking spiders elude both visually- and chemically-oriented predators. PLoS ONE 8(11): e79660.",
		},
	},
	{
		id = "what_the_wasp_does",
		trigger = "wasp_caught",
		title = "What the wasp does",
		text = "The wasp's sting does not kill a spider: it paralyses it. The wasp carries the spider to a cell in its mud nest and fills the cell with paralysed spiders, up to twenty or more. It lays an egg on one of them and seals the cell with mud. When the larva hatches, it feeds on the spiders, which have stayed fresh because they are still alive.",
		game = "A catch ends a Standard life. Return to your last rest or continue as an unrelated spider. In gentle Free play the wasp only touches and leaves.",
		godotGame = "Being caught ends this spider's life. You go back to your last rest.",
		sources = {
			"Powell, E. C. & Taylor, L. A. Black and yellow mud dauber, Sceliphron caementarium (Drury, 1773). Featured Creatures EENY-654 / IN1478, University of Florida IFAS Extension. https://ask.ifas.ufl.edu/publication/IN1478",
			"Grissell, E. E. (1973). Sceliphron caementarium (Drury), a mud daubing wasp. Entomology Circular 136, Florida Department of Agriculture and Consumer Services, Division of Plant Industry.",
			"Long, R. F. (2018). Why mud daubers are on spider patrol. UC ANR Green Blog, University of California Agriculture and Natural Resources.",
		},
	},
	{
		id = "getting_away",
		trigger = "wasp_escaped",
		title = "Getting away",
		text = "Jumping spiders watch what moves around them. When something looms toward a bold jumping spider, it backs away, and experiments showed that its side eyes, the anterior lateral eyes, are what tell it to. Not being seen matters most: the mud dauber finds its prey by sight.",
		game = "The wasp lost you, or gave up. Here a jump, a drop on your line or getting out of sight breaks its approach, and the crack is always safe. Dropping on a line to escape is the game's choice: it is not known to be what jumping spiders do.",
		sources = {
			"Spano, L., Long, S. M. & Jakob, E. M. (2012). Secondary eyes mediate the response to looming objects in jumping spiders (Phidippus audax, Salticidae). Biology Letters 8(6): 949-951.",
			"Uma, D., Durkee, C., Herzner, G. & Weiss, M. (2013). Double deception: ant-mimicking spiders elude both visually- and chemically-oriented predators. PLoS ONE 8(11): e79660.",
		},
	},
	{
		id = "going_without_food",
		trigger = "starving",
		title = "Going without food",
		text = "Spiders can go a long time without food. Adult females of the related Phidippus johnsoni were kept for 25 to 31 days without eating. As a spider uses up its reserves its abdomen shrinks: how plump the abdomen is, against the size of the body, is how scientists judge a spider's condition.",
		game = "Time is compressed here. A full reserve lasts about three days; a spider that then goes two more days without food dies, after warnings on the screen. On Easy and in free play it cannot starve.",
		sources = {
			"Jackson, R. R. (1978). The life history of Phidippus johnsoni (Araneae, Salticidae). Journal of Arachnology 6: 1-29.",
			"Jakob, E. M., Marshall, S. D. & Uetz, G. W. (1996). Estimating fitness: a comparison of body condition indices. Oikos 77: 61-67.",
		},
	},
	{
		id = "peacock_dance",
		trigger = "dance",
		title = "A fan and a dance",
		text = "A male peacock spider, Maratus volans, unfolds colourful flaps on its abdomen and waves its third pair of legs during courtship. The display also sends vibrations through the surface beneath it. It is a message to a female, not just a dance people can see.",
		game = "Our repeating dance is inspired by recorded displays. Its size, colour, timing and movement are stylised. There is no mating simulation, and the cosmetic dance is available at every gameplay growth stage.",
		sources = {
			"Girard, M. B., Kasumovic, M. M. & Elias, D. O. (2011). Multi-Modal Courtship in the Peacock Spider, Maratus volans. PLoS ONE 6(9): e25390. https://doi.org/10.1371/journal.pone.0025390",
		},
	},
} :: { Page }

return NotebookPages
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Peacock</string>
            <string name="Source"><![CDATA[--!strict
-- The peacock spider's courtship dance (ROBLOX-29): every number the dance needs, each marked DOC (reported in the paper) or ART
-- (artistic: not reported, chosen to read well on a small screen). The dance is presentation only: a pose for the drawn spider,
-- never a change to the motor, the senses, the jump or the silk.
--
-- Source: Girard, M. B., Kasumovic, M. M. & Elias, D. O. (2011). Multi-Modal Courtship in the Peacock Spider, Maratus volans
-- (O.P.-Cambridge, 1874). PLoS ONE 6(9): e25390 (PMC3181266). Rates are mean +- SD of the paper's high-speed video and laser
-- vibrometer records. Order in the paper: rumble-rumps and bobbing on approach, then leg waving with fan dancing, fan-flapping in
-- the pauses, then a pre-mount display and a mounting attempt. The last two are left out on purpose: this is a family game.
-- A real courtship lasts 6 to 51 minutes (mean 24.35, DOC); `loopSeconds` squeezes one round of it into a loop a player can watch.

local Peacock = {}

export type Phase = {
	id: string, seconds: number, ease: number?, rumble: number?,
	pitch: number, open: number, legs: number, sway: number, wave: number, flap: number, bob: number, palp: number,
}

Peacock.id = "maratus_volans_male"
Peacock.citation = "Girard, Kasumovic & Elias 2011, PLoS ONE 6(9): e25390"

-- Real courtship length in minutes (DOC: range 6 to 51, mean 24.35). The game's loop is ART.
Peacock.courtshipMinutes = { min = 6, max = 51, mean = 24.35 }
Peacock.loopSeconds = 14.0 -- ART: one compressed round of the display (the phases below add up to it)

-- ---------------------------------------------------------------- rates: DOC
-- Hz = cycles (or flicks, waves, flaps, bumps) per second; sd is the paper's standard deviation, kept for the docs and tests.
Peacock.rates = {
	palpFlicker = { hz = 3.5, sd = 1.6 }, -- pedipalps flicker up and down in unison (DOC)
	fanDance = { hz = 3.2, sd = 1.5 }, -- abdomen sways side to side with the fan raised (DOC)
	legWave = { hz = 3.2, sd = 0.6 }, -- legs III wave (DOC)
	fanFlap = { hz = 2.5, sd = 1.8 }, -- the fan flaps in and out during the pauses (DOC)
	-- Opisthosomal bobbing comes in bouts; the paper gives no rate. ART:
	bob = { hz = 4.0, boutSeconds = 0.8, restSeconds = 0.5 },
}
-- Rumble-rumps: vibrations through the substrate (felt, not seen). 2.44 +- 0.28 s long, 12.1 +- 2.9 bumps a second (DOC).
Peacock.rumble = { seconds = 2.44, sd = 0.28, bumpsHz = 12.1, bumpsSd = 2.9, edgeSeconds = 0.12 }
-- The fan dance sweeps the abdomen over an arc of 19 to 35 degrees (DOC); the game uses the middle of the range.
Peacock.fanArcDeg = { min = 19, max = 35, used = 27 }

-- ---------------------------------------------------------------- amplitudes: ART (the paper reports none of these)
Peacock.amplitude = {
	raiseDeg = 80, -- how far the abdomen pitches up (rear end up) to show the fan
	bobDeg = 6, -- the abdomen's bob, either side of its pitch
	shiverDeg = 1.2, -- the abdomen's visible tremble at 12.1 bumps a second during a rumble-rump
	waveDeg = 38, -- how far legs III sweep down in a wave
	flapDepth = 0.45, -- the fan closes to this much narrower (0.45: down to 55 % of its width) at the bottom of a flap
	palpDeg = 22, -- the pedipalps' flick
}

-- ---------------------------------------------------------------- the phases (ART: the order is DOC, the times are ART)
-- Each phase eases the levels from the previous phase's (the last phase's, for the first) over `ease` seconds, then holds them.
-- Levels run 0..1: pitch (the abdomen raised: 1 is amplitude.raiseDeg), open (the fan), legs (legs III up), sway (the fan dance),
-- wave (legs III waving), flap (fan-flapping), bob (bobbing bouts), palp (the pedipalps' flicker). `rumble` starts a rumble-rump
-- `at` seconds into the phase and lasts Peacock.rumble.seconds.
Peacock.ease = 0.45
Peacock.phases = {
	{ id = "approach", seconds = 3.2, ease = 0.4, pitch = 0, open = 0, legs = 0, sway = 0, wave = 0, flap = 0, bob = 1, palp = 0.6, rumble = 0.4 },
	{ id = "raise", seconds = 1.3, ease = 1.1, pitch = 1, open = 1, legs = 1, sway = 0, wave = 0, flap = 0, bob = 0, palp = 0.4 },
	{ id = "dance", seconds = 3.4, ease = 0.4, pitch = 1, open = 1, legs = 1, sway = 1, wave = 1, flap = 0, bob = 0, palp = 1 },
	{ id = "freeze", seconds = 2.2, ease = 0.35, pitch = 1, open = 1, legs = 1, sway = 0, wave = 0, flap = 1, bob = 0, palp = 0.5 },
	{ id = "dance_again", seconds = 2.6, ease = 0.35, pitch = 1, open = 1, legs = 1, sway = 1, wave = 1, flap = 0, bob = 0, palp = 1 },
	{ id = "fold", seconds = 1.3, ease = 1.0, pitch = 0, open = 0, legs = 0, sway = 0, wave = 0, flap = 0, bob = 0, palp = 0.2 },
} :: { Phase }

-- ---------------------------------------------------------------- starting and stopping (ART)
Peacock.rampInSeconds = 0.25 -- the pose arrives
Peacock.fadeOutSeconds = 0.2 -- a stop (a step, a jump, leaving the surface) eases the pose out over this long
Peacock.reducedMotion = 0.5 -- ReducedMotion halves the sway, wave, flap, bob and flick amplitudes and stops the tremble

-- ---------------------------------------------------------------- the words (felt, not seen)
Peacock.feltCaption = "[a fine buzzing through your feet]"

return Peacock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">SaveRules</string>
            <string name="Source"><![CDATA[--!strict
-- Every number and name the persistent saves use (ROBLOX-39): store names, key prefixes, sizes, timings, limits. The logic is in
-- Shared/Persistence/Save*.luau; none of it carries a number of its own. Sizes were measured on real checkpoints (tests/state.luau
-- prints them; docs/HANDOFF-roblox-state.md records them).
local SaveRules = {}

-- ---------------------------------------------------------------- where it is kept
SaveRules.STORE_PRODUCTION = "Windowsill_v1"
SaveRules.STORE_TEST = "WindowsillTest_v1" -- Studio and the test place: Chet's runs never touch a real save
SaveRules.KEY_PROGRESS = "P_" -- P_<UserId>: the player's progress (small, precious)
SaveRules.KEY_REST = "R_" -- R_<UserId>_main, R_<UserId>_free: the last rest of each mode (larger, replaceable)
SaveRules.MODES = { "main", "free" } :: { string }
SaveRules.FORMAT = "the-windowsill save"
SaveRules.REMOTES_NAME = "SaveRemotes" -- the folder in ReplicatedStorage holding ToServer and ToClient

-- ---------------------------------------------------------------- sizes (characters of canonical JSON)
-- Measured: a rest is about 22 thousand characters (tests/state.luau prints the real figures). The cap leaves room for a long life's
-- growth and is far under Roblox's 4,194,304-character limit even with the kept backup inside the same value.
SaveRules.MAX_REST_CHARS = 262144
SaveRules.MAX_REST_NODES = 120000 -- values (tables, numbers, strings) a rest may hold, counted before it is encoded
SaveRules.MAX_DEPTH = 24
SaveRules.MAX_PROGRESS_CHARS = 16384
SaveRules.MAX_VALUE_CHARS = 4194304 -- Roblox's own limit on one stored value
SaveRules.MAX_PROGRESS_NODES = 1500 -- values a progress message may hold, counted before anything reads it
SaveRules.MAX_PROGRESS_DEPTH = 8
SaveRules.MAX_PAGES = 200 -- notebook ids kept (the book has 25 pages; room for the future)
SaveRules.MAX_ID_CHARS = 48
SaveRules.MAX_EYE_SECONDS = 1.0e9
SaveRules.PREF_KEYS = { "FocusToggle", "ReducedMotion", "ShowLastSeen", "AutomaticGrip", "NotebookNotes", "LargeText", "SoundMuted" } :: { string }

-- ---------------------------------------------------------------- timing (seconds)
SaveRules.PROGRESS_DEBOUNCE = 30 -- at most one progress write in this time (events in between are coalesced)
SaveRules.REST_MIN_INTERVAL = 10 -- a key may be written about every 6 s; this leaves room
SaveRules.HEARTBEAT = 30 -- the session lock is refreshed this often
SaveRules.LOCK_STALE = 120 -- a lock older than this may be taken over by a newer session
SaveRules.BACKOFF_BASE = 2
SaveRules.BACKOFF_CAP = 60
SaveRules.RETRY_LOAD = 15 -- a session that could not load or lock tries again this often
SaveRules.FLUSH_ATTEMPTS = 4 -- tries at leaving or shutting down, with the backoff between
SaveRules.FLUSH_BACKOFF = 1
SaveRules.FLUSH_DEADLINE = 24 -- BindToClose has 30 s in all
SaveRules.REQUESTS_PER_MINUTE = 10 -- DataStore requests one player's session may start in a minute (the budget is 60 + 10 per player)

-- ---------------------------------------------------------------- what the client may send (per player)
SaveRules.PROGRESS_BURST = 6
SaveRules.PROGRESS_PER_SECOND = 0.5
SaveRules.REST_BURST = 2
SaveRules.REST_PER_SECOND = 0.2
SaveRules.PROTOCOL = 1 -- the version of the messages between client and server
SaveRules.CLIENT_HELLO_GAP = 2.5 -- the client says hello again this often until the server answers
SaveRules.CLIENT_HELLO_TRIES = 6
SaveRules.CLIENT_PROGRESS_GAP = 2 -- the client sends at most one progress message in this time
SaveRules.CLIENT_EYE_GAP = 30 -- and re-sends the eye-view seconds this often when they changed
SaveRules.CLIENT_WAIT_REMOTES = 1.5 -- the start menu waits this long for the server's remotes to appear
SaveRules.CLIENT_WAIT_REPLY = 4 -- and this long for the first reply after saying hello

-- ---------------------------------------------------------------- words for statuses
SaveRules.STATUS = { saved = "saved", saving = "saving", session = "session" } -- session: this visit only
SaveRules.REASONS = { "offline", "no_api", "load_failed", "other_session", "corrupt", "newer", "write_failed" } :: { string }

return SaveRules
]]></string>
          </Properties>
        </Item>
