      <Item class="ModuleScript" referent="194">
        <Properties>
          <string name="Name">GraphicsSpec</string>
          <string name="Source"><![CDATA[--!strict
-- Real Roblox values: what the place holds once Main.server has built the world. Included only in tests.project.json and run
-- by Runner.server.luau in Studio (it needs the engine); the CLI cannot run it. It checks what an engine can check: that the
-- settings took, that materials and the sun are what the table asks for, that nothing drawn is solid or queryable. Whether it
-- LOOKS right (materials, haze, light shafts, the view out of the window) is for eyes in Studio: HANDOFF "Cuter spider and graphics".
return function(check)
	local Lighting = game:GetService("Lighting")
	local MaterialService = game:GetService("MaterialService")
	local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
	local Graphics = require(Shared.Data.Graphics)
	local Materials = require(Shared.Habitat.Materials)
	local Flora = require(Shared.Data.Flora)
	local Plants = require(Shared.Habitat.Plants)
	local sill = (workspace:WaitForChild("World", 15) :: Folder):WaitForChild("Windowsill", 15) :: Folder -- (ROBLOX-94: the sill is region 0, inside the World folder)
	local decor = workspace:WaitForChild("Decor", 15) :: Model -- (a persistent model since ROBLOX-94)

	-- Protected Technology/Use2022Materials are checked by tools/build.py.
	check("every material name in the graphics table is a real Roblox material", function()
		for _, name in Materials.names() do
			assert(Enum.Material:FromName(name) ~= nil, "no Enum.Material." .. name)
		end
	end)
	check("sill pieces use the table's materials and the back wall is invisible but solid", function()
		for _, part in sill:GetChildren() do
			local want = Graphics.materials.pieces[part.Name]
			assert(want, "no material for " .. part.Name)
			assert((part :: BasePart).Material == Enum.Material:FromName(want), `{part.Name}: {tostring((part :: BasePart).Material)}`)
		end
		for _, id in Graphics.window.hidden do
			local back = sill:FindFirstChild(id) :: BasePart
			assert(back.Transparency == 1 and back.CanCollide and back.CanQuery, id .. ": the back wall must stay solid and climbable")
		end
		local hit = workspace:Raycast(Vector3.new(0, 8, 0), Vector3.new(0, 0, -30))
		assert(hit and hit.Instance == sill:FindFirstChild("back_frame_head") and math.abs(hit.Position.Z + 12.5) < 1e-3, "a ray across the sill must land on the solid back wall")
		-- ROBLOX-95: the raised sash: a ray low across the middle of the sill goes out through the opening and meets the outer sill's world, not the back wall
		local low = workspace:Raycast(Vector3.new(0, 3, 0), Vector3.new(0, 0, -30))
		assert(low == nil or not low.Instance:IsDescendantOf(sill), "the opening in the back frame must be open")
	end)
	check("a piece is invisible only where its drawing exists, and then it stays solid; every drawn leaf's top is its piece's top", function()
		local pilea = decor:FindFirstChild("Pilea")
		assert(pilea, "the drawn Pilea is missing")
		local hidden: { [string]: boolean } = {}
		for _, id in Graphics.window.hidden do hidden[id] = true end
		for _, id in Plants.pieceIds() do hidden[id] = true end
		for _, part in sill:GetChildren() do
			local p = part :: BasePart
			if hidden[p.Name] then
				assert(p.Transparency == 1 and not p.CastShadow and p.CanCollide and p.CanQuery, p.Name .. " must be invisible but solid")
			else
				assert(p.Transparency == 0, p.Name .. " must stay visible")
			end
		end
		for _, plant in Flora.pilea.plants do
			local leaf = sill:FindFirstChild(plant.leaf) :: BasePart
			local blade = (pilea:FindFirstChild(plant.leaf) :: Folder):FindFirstChild("BladeA") :: BasePart
			assert(math.abs((blade.Position.Y + blade.Size.Y / 2) - (leaf.Position.Y + leaf.Size.Y / 2)) < 1e-3, plant.leaf .. ": the drawn top is not the walkable top")
		end
	end)
	check("decor is drawn only: no collisions, no rays, no touches", function()
		local n = 0
		for _, d in decor:GetDescendants() do
			if d:IsA("BasePart") then
				n += 1
				assert(d.Anchored and not d.CanCollide and not d.CanQuery and not d.CanTouch, d:GetFullName())
			end
		end
		assert(n >= 400 and n < 1500, `decor has {n} parts`)
	end)
	check("the flowers' UV layer is invisible Neon until the eye view fades it in", function()
		local uv = decor:FindFirstChild("UVLayer")
		assert(uv and #uv:GetChildren() >= 100, "no UV layer")
		for _, d in uv:GetChildren() do
			local p = d :: BasePart
			assert(p.Transparency == 1 and p.Material == Enum.Material.Neon and p:GetAttribute("UVOpacity") == 0.85 and p.Color == Color3.fromHex("b98cff"), p.Name)
		end
	end)
	check("the sun shines in through the window", function()
		local sun = Lighting:GetSunDirection()
		local status = tostring(Lighting:GetAttribute("SunPick"))
		assert(string.sub(status, 1, 3) == "ok:", "SunPick: " .. status)
		assert(sun.Z < -0.2 and sun.Y > 0.25, "sun direction " .. tostring(sun))
		assert(Graphics.window.hidden[1] == "back_frame_west" and decor:FindFirstChild("Shafts") ~= nil, "no light shafts built")
	end)
	check("the wall casts shadows, the glass does not", function()
		local wall = decor:FindFirstChild("Wall") :: Folder
		assert((wall:FindFirstChild("ApronWest") :: BasePart).CastShadow and (wall:FindFirstChild("Mullion1") :: BasePart).CastShadow)
		local glass = wall:FindFirstChild("Glass") :: BasePart
		assert(not glass.CastShadow and glass.Transparency >= 0.6 and glass.Material == Enum.Material.SmoothPlastic, "window must not refract away translucent UV petals")
		assert(not (sill:FindFirstChild(Graphics.window.hidden[1]) :: BasePart).CastShadow, "the invisible wall must not shade the room")
	end)
	check("atmosphere, sky, grade, bloom, sun rays and clouds are in place; the macro depth of field is on unless switched off", function()
		for _, name in { "Atmosphere", "Sky", "Grade", "Bloom", "SunRays" } do assert(Lighting:FindFirstChild(name), "missing " .. name) end
		assert(workspace.Terrain:FindFirstChildOfClass("Clouds"), "missing clouds")
		local dof = Lighting:FindFirstChild("MacroDOF") :: DepthOfFieldEffect?
		assert((dof ~= nil) == (workspace:GetAttribute("DepthOfField") ~= false), "depth of field must be on unless the DepthOfField attribute is false")
		if dof then
			-- Roblox stores effect intensities as float32 (0.3 reads back as 0.3000000119).
			assert(math.abs(dof.FarIntensity - Graphics.depthOfField.far) < 1e-6 and dof.NearIntensity == 0 and math.abs(dof.InFocusRadius - Graphics.depthOfField.radius) < 1e-6, "depth of field blurs only the far")
			assert(dof:GetAttribute("FullOnly") == true, "depth of field is a full-tier effect")
		end
		local bloom = Lighting:FindFirstChild("Bloom") :: BloomEffect
		assert(bloom.Threshold >= 1.2 and bloom.Intensity <= 0.5, "bloom is not gentle")
	end)
	check("dust motes are emitting and the light shafts are faint", function()
		local motes = (decor:FindFirstChild("DustVolume") :: Instance):FindFirstChildOfClass("ParticleEmitter") :: ParticleEmitter
		assert(motes.Enabled and motes.Rate > 0)
		local beams = 0
		for _, d in decor:GetDescendants() do
			if d:IsA("Beam") then
				beams += 1
				assert(d.Transparency.Keypoints[1].Value >= 0.95, "a shaft is too strong")
			end
		end
		assert(beams == #Graphics.shafts.x * #Graphics.shafts.layers, `{beams} beams`)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="195">
        <Properties>
          <string name="Name">GrowthSpec</string>
          <string name="Source"><![CDATA[--!strict
return function(check: (string, () -> ()) -> ())
 local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
 local Rig=require(Shared.Rig.SpiderRig)
 local Growth=require(Shared.Life.Growth)
 local Support=require(Shared.Movement.SupportMath)
 local Dance=require(Shared.Rig.PeacockDance)
 local folder=Instance.new("Folder");folder.Name="GrowthTestWorld";folder.Parent=workspace
 local surface=Instance.new("Part");surface.Size=Vector3.new(20,1,20);surface.Anchored=true;surface.Parent=folder
 for _,normal in {Vector3.yAxis,Vector3.xAxis,-Vector3.yAxis} do
  check("growth: planted feet and unchanged root on "..tostring(normal),function()
   local frame=Support.bodyCFrame(Vector3.new(300,0,0),normal,-Vector3.zAxis)
   surface.CFrame=frame*CFrame.new(0,-.5,0)
   for _,id in {"first_spider","maratus_volans_male"} do
    local rig=Rig.new(folder,folder,id,"full");rig.reducedMotion=true
    local body=frame*CFrame.new(0,.31,0)
    for _=1,10 do rig:update(body,1/60,true,false) end
    local size=rig.root.Size
    for stage=1,3 do
     local feet={};for i,l in rig._legs do feet[i]=l.foot;assert(l.planted,"foot not on surface") end
     rig:setGrowthStage(stage);rig:update(body,0,true,false)
     for i,l in rig._legs do assert((l.foot-feet[i]).Magnitude<1e-4,"growth dragged planted foot") end
     for _=1,25 do rig:update(body,1/60,true,false) end
     for _,l in rig._legs do assert(math.abs((l.foot-frame.Position):Dot(normal))<.015,"foot left surface") end
     assert((rig.root.Position-body.Position).Magnitude<1e-4 and rig.root.Size==size,"root changed")
    end
    rig:setSoftness(1);rig:setCondition(.1);rig:update(body,1,true,false)
    assert(rig.model:FindFirstChild("Cephalothorax").Color.R>.5,"not pale")
    rig:destroy()
   end
  end)
 end
 check("growth: adult peacock dance and eye visibility",function()
  surface.CFrame=CFrame.new(300,-.5,0)
  local r=Rig.new(folder,folder,"maratus_volans_male","full")
  r:setGrowthStage(3);r.dance=Dance.rawPose(5.2,false)
  r:update(CFrame.new(300,.31,0),1/60,true,false)
  assert(r._fan.front[1].part.Size.X>.4,"fan didn't grow")
  r:setEyeView(true)
  for _,p in r._fan.parts do assert(p.LocalTransparencyModifier==1,"fan in eyes") end
  r:destroy()
 end)
 check("growth: interrupted record resumes exactly once",function()
  local g=Growth.new();assert(g:eat(.9));assert(g:beginMoult());g:passHours(4,Vector3.zero)
  local r=Growth.new();assert(r:load(g:toRecord()))
  assert(r:passHours(8,Vector3.zero)=="moulted")
  assert(r.stage==1 and #r.exuviae==1 and r:softness()==1)
  assert(r:passHours(10,Vector3.zero)=="hardened" and #r.exuviae==1)
 end)
 folder:Destroy()
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="196">
        <Properties>
          <string name="Name">LifeSpec</string>
          <string name="Source"><![CDATA[--!strict
-- LIFE and checkpoints in the engine (ROBLOX-24, ROBLOX-25). The pure CLI suites (tests/life.luau, tests/checkpoint.luau) check
-- the same modules under a shim; here they run in Roblox: real Vector3s and Color3s, the real Lighting service, HttpService's
-- own JSON, and real raycasts on a private copy of the sill.
local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local LifeClock = require(Shared.Life.LifeClock)
local NeedsModel = require(Shared.Life.NeedsModel)
local LifeLoop = require(Shared.Life.LifeLoop)
local DayLight = require(Shared.Habitat.DayLight)
local Graphics = require(Shared.Data.Graphics)
local Layout = require(Shared.Habitat.WindowsillLayout)
local Species = require(Shared.Data.Species)
local Surfaces = require(Shared.Data.Surfaces)
local Motor = require(Shared.Movement.SpiderMotor)
local PreyDirector = require(Shared.Prey.PreyDirector)
local Sensor = require(Shared.Perception.Sensor)
local ObservationMemory = require(Shared.Perception.ObservationMemory)
local ObjectRecord = require(Shared.Persistence.ObjectRecord)
local Checkpoint = require(Shared.Persistence.Checkpoint)
local CheckpointStore = require(Shared.Persistence.CheckpointStore)
local Json = require(Shared.Persistence.Json)

return function(check: (string, () -> ()) -> ())
	check("LIFE: the clock, the needs and the loop run in the engine as in the CLI", function()
		local c = LifeClock.new()
		assert(c.day == 1 and c.hour == 9 and c:daylight() == 1, "starts at 9 on day 1, in full day")
		c.hour = 19
		local ticks = 0
		repeat c:advance(1 / 60, true); ticks += 1 until not c.sleeping or ticks > 5000
		assert(c.day == 2 and math.abs(c.hour - 7) < 1e-9 and ticks == 515, `a night of sleep: {ticks} ticks to day {c.day}, {c.hour}`)
		local n = NeedsModel.new(true)
		n:addHours(10, false)
		n:advance(0.25, false); n:advance(0.25, false)
		assert(math.abs(n.energy - (0.55 - 0.21)) < 1e-9, `hunger by the hour ({n.energy})`)
		local l = LifeLoop.new(NeedsModel.new(true))
		l.clock.hour = 23
		l:applyLight()
		assert(l.rangeScale == LifeLoop.NIGHT_SIGHT, "the eyes reach less far at night")
	end)

	check("LIFE: the day's light is the accepted look; night is set on the real Lighting and taken back", function()
		local before = {
			ClockTime = Lighting.ClockTime, Brightness = Lighting.Brightness, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
			ColorShift_Top = Lighting.ColorShift_Top, ExposureCompensation = Lighting.ExposureCompensation,
		}
		local day = DayLight.targets(1, before.ClockTime)
		assert(math.abs(day.brightness - Graphics.lighting.brightness) < 1e-9 and day.clock == before.ClockTime, "full day is the daytime values")
		local decor = workspace:FindFirstChild("Decor")
		DayLight.apply(Lighting, DayLight.targets(0, before.ClockTime), decor)
		assert(math.abs(Lighting.ClockTime - Graphics.dayNight.nightClock) < 1e-3, `night clock {Lighting.ClockTime}`)
		assert(Lighting:GetSunDirection().Y < 0, "the sun is below the horizon at night")
		assert(Lighting.Brightness < 1 and Lighting.ExposureCompensation < 0, "dim")
		local shafts = decor and decor:FindFirstChild("Shafts")
		if shafts then
			for _, b in shafts:GetDescendants() do
				if b:IsA("Beam") then assert(not b.Enabled, "a light shaft still shows at night") end
			end
		end
		DayLight.apply(Lighting, day, decor)
		assert(math.abs(Lighting.ClockTime - before.ClockTime) < 1e-3 and math.abs(Lighting.Brightness - before.Brightness) < 1e-6, "day again")
		assert(Lighting.Ambient == before.Ambient and Lighting.OutdoorAmbient == before.OutdoorAmbient, "the room's light as it was")
		print("PORT_LIFE_LIGHT " .. HttpService:JSONEncode({ day_clock = before.ClockTime, night_clock = Graphics.dayNight.nightClock, sun_pick = Lighting:GetAttribute("SunPick") }))
	end)

	-- A private sill, as PreySpec builds it: the same pieces, casts that see only this copy.
	local world = Instance.new("Folder")
	world.Name = "LifeTestWorld"
	world.Parent = workspace
	for _, b in Layout.PIECES do
		local part = Instance.new("Part")
		part.Name = b.id
		part.Anchored = true
		part.Size = b.hi - b.lo
		part.CFrame = CFrame.new((b.hi + b.lo) * 0.5)
		part.Transparency = 1
		part.CanCollide = false
		part.Parent = world
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { world }
	local cast = Sensor.workspaceCast(params)
	local camera = { CFrame = CFrame.new(Vector3.new(0, 30, 40)), FieldOfView = 70, ViewportSize = Vector2.new(1280, 720) } -- a stand-in view (the server has no player camera)
	local function newWorld(): any
		local motor = Motor.new({
			world = world, surfaces = Surfaces, profile = Species.phidippus_audax_prototype, spawn = Layout.SPAWN,
			heading = Layout.SPAWN_HEADING, boundsMin = Layout.PLAY_BOUNDS_MIN, boundsMax = Layout.PLAY_BOUNDS_MAX,
		})
		local prey = PreyDirector.engine(world, Species.fly_like_prototype, 914, 4)
		local memory = ObservationMemory.new()
		local sensor = Sensor.new(memory)
		sensor:configureFrom(Species.phidippus_audax_prototype.perception)
		local needs = NeedsModel.new(true)
		prey.feeding.needs = needs
		local w: any = { motor = motor, prey = prey, sensor = sensor, memory = memory, needs = needs, life = LifeLoop.new(needs) }
		motor:place(Vector3.new(-25.5, Layout.SPAWN.Y, 6), Vector3.yAxis, Vector3.xAxis)
		return w
	end
	local STILL = { wish = Vector3.zero, creep = false, reel = 0, dropHeld = false, releaseHeld = false }
	local function tick(w: any, feed: boolean?)
		w.sensor:step(Motor.DT, w.motor:observer(), w.prey:percepts(), cast)
		w.prey:before(Motor.DT, w.motor.pos, w.motor:observer(), w.sensor, cast, camera)
		w.motor:tick(STILL)
		w.prey:after(Motor.DT, w.motor, w.sensor, cast)
		local holding = w.prey.feeding.held ~= nil
		w.life:step(Motor.DT, { inRetreat = Layout.inRetreat(w.motor.pos), attached = w.motor.mode == "attached", still = w.motor.vel.Magnitude < 0.15,
			holding = holding, feeding = holding and w.prey.feeding.feeding }, feed == true, false)
		w.sensor.core.rangeScale = w.life.rangeScale
		w.life:drainEvents()
	end
	local function fingerprint(w: any): string
		local saved = { w.prey.cpu, w.prey.beforeCost, w.sensor._ring, w.sensor.cpuUsTotal, w.sensor.cpuUsMax }
		w.prey.cpu, w.prey.beforeCost, w.sensor._ring, w.sensor.cpuUsTotal, w.sensor.cpuUsMax = {}, 0, {}, 0, 0
		local rec = assert(ObjectRecord.capture({ prey = w.prey, sensor = w.sensor, memory = w.memory, needs = w.needs, life = w.life }, Checkpoint.CLASSES, Checkpoint.refs(w)))
		w.prey.cpu, w.prey.beforeCost, w.sensor._ring, w.sensor.cpuUsTotal, w.sensor.cpuUsMax = saved[1], saved[2], saved[3], saved[4], saved[5]
		local text = assert(Json.canonical(rec))
		text = string.gsub(text, '%["notice","[^"]*"%]', "")
		text = string.gsub(text, '%["noticeSeconds",[^%]]*%]', "")
		text = string.gsub(text, '%["restoreGrace",[^%]]*%]', "")
		local m = w.motor
		return text .. string.format("|%.12f %.12f %.12f|%s", m.pos.X, m.pos.Y, m.pos.Z, m.mode)
	end

	check("S01-C: a retreat checkpoint goes through HttpService's JSON and back, and the world repeats exactly", function()
		local w = newWorld()
		for _ = 1, 60 do tick(w) end
		tick(w, true)
		assert(w.life.resting, "resting in the crack")
		assert(Checkpoint.boundaryProblem(w) == "", "a boundary: " .. Checkpoint.boundaryProblem(w))
		local record = assert(Checkpoint.capture(w, os.time()))
		local text = HttpService:JSONEncode(record)
		assert(#text < CheckpointStore.MemoryDataStore.MAX_CHARS, `under the DataStore limit ({#text})`)
		local back = HttpService:JSONDecode(text)
		assert(#(Checkpoint.check(back, w)) == 0, "the record survives Roblox's own JSON: " .. table.concat(Checkpoint.check(back, w), "; "))
		local first = {}
		for t = 1, 300 do
			tick(w)
			if t % 30 == 0 then table.insert(first, fingerprint(w)) end
		end
		local ok, problems = Checkpoint.restore(back, w)
		assert(ok, "restored: " .. table.concat(problems, "; "))
		local diffs = 0
		for t = 1, 300 do
			tick(w)
			if t % 30 == 0 and fingerprint(w) ~= first[t // 30] then diffs += 1 end
		end
		assert(diffs == 0, `the second run differs from the first in {diffs} of {#first} samples`)
		print("PORT_CHECKPOINT " .. HttpService:JSONEncode({ characters = #text, tables = #record.world.objects }))
	end)

	check("S02: the store keeps the last good checkpoint and refuses a bad one without touching the world", function()
		local w = newWorld()
		for _ = 1, 30 do tick(w) end
		local store = CheckpointStore.new(CheckpointStore.MemoryDataStore.new(), function(r) return (Checkpoint.check(r, w)) end)
		assert(store:save(assert(Checkpoint.capture(w, 1))).ok, "first save")
		for _ = 1, 30 do tick(w) end
		assert(store:save(assert(Checkpoint.capture(w, 2))).ok, "second save")
		store.store.data.checkpoint.checkpoint.snapshot_tick += 1
		local best = store:loadBest()
		assert(best.ok and best.source == "backup" and best.record.created_at == 1, "falls back to the backup")
		local bad = Json.copy(best.record)
		bad.content_revision = "elsewhere"
		local before = fingerprint(w)
		assert(not Checkpoint.restore(bad, w) and fingerprint(w) == before, "a bad record changes nothing")
	end)

	world:Destroy()
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="197">
        <Properties>
          <string name="Name">NotebookSpec</string>
          <string name="Source"><![CDATA[--!strict
-- The naturalist's notebook in the engine (ROBLOX-37): the pages and the panel's words with Roblox's own text metrics (TextService),
-- and the panel's instances built with real property names. The pure rules are in tests/notebook.luau (NOTEBOOK). What a player sees and
-- does with the live client (a real ScreenGui, the world waiting, text inside its boxes) is checked by tests/client/SilkPlayback.luau.
return function(check: (string, () -> ()) -> ())
	local TextService = game:GetService("TextService")
	local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
	local FieldNotebook = require(Shared.Learning.FieldNotebook)
	local NotebookPages = require(Shared.Data.NotebookPages)
	local NotebookText = require(Shared.UI.NotebookText)
	local HudLayout = require(Shared.UI.HudLayout)
	local ControlText = require(Shared.UI.ControlText)
	local Client = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("Client")
	local NotebookPanel = require(Client:WaitForChild("NotebookPanel")) :: any
	local devices: { any } = { "keyboard", "gamepad", "touch" }
	local screens = { Vector2.new(568, 320), Vector2.new(667, 375), Vector2.new(844, 390), Vector2.new(360, 640), Vector2.new(768, 1024), Vector2.new(1024, 768), Vector2.new(1280, 720), Vector2.new(1920, 1080) }
	local scales = { 1.0, NotebookText.LARGE }
	local S = NotebookText.SIZES
	local function size(text: string, textSize: number, font: Enum.Font, width: number): Vector2
		return TextService:GetTextSize(text, math.round(textSize), font, Vector2.new(width, 100000))
	end
	local function everything(): any
		local book: any = FieldNotebook.new()
		for _, p in book.pages do book:notice(p.trigger) end
		return book
	end

	check("notebook: the book in the engine is Godot's 25 pages, found once each, with no unfound page readable", function()
		local book: any = FieldNotebook.new()
		assert(#book.pages == 25 and #book.dropped == 0, `{#book.pages} pages, {#book.dropped} dropped`)
		for _, p in book.pages do assert(book:view(p.id) == nil, p.id .. " readable before it is found") end
		local all = everything() :: any
		assert(#all.opened == 25, `{#all.opened} found`)
		assert(#all:notice("jump") == 0, "a page opened twice")
	end)

	check("notebook: every page fits every screen the panel supports, one pane or two, normal and large text", function()
		local book: any = everything()
		for _, screen in screens do
			for _, scale in scales do
				local m = NotebookText.metrics(screen.X, screen.Y, scale)
				local lay = NotebookText.layout(screen.X, screen.Y, scale)
				-- the page pane: the paper less the padding, less the list when two panes show, less the scroll bar and the label's inset
				local inner = m.paperW - 28
				local width = (if lay.sideBySide then inner * (1 - lay.listFraction) - 8 else inner) - 6 - 14
				for _, p in book.pages do
					local total, widest = 0, 0
					local parts = {
						{ p.title, S.title * scale, Enum.Font.GothamBold }, { p.text, S.body * scale, Enum.Font.Gotham },
						{ NotebookText.gameLine(p.game, "keyboard") or "", S.game * scale, Enum.Font.Gotham },
						{ NotebookText.sourcesText(p.sources), S.sources * scale, Enum.Font.Gotham },
					}
					for _, part in parts do
						if part[1] ~= "" then
							local s = size(part[1], part[2], part[3], width)
							total += s.Y + 12
							widest = math.max(widest, s.X)
						end
					end
					assert(widest <= width + 0.5, `{p.id} at {screen.X}x{screen.Y} x{scale}: a line is {widest} px in {width}`)
					assert(total <= 12 * m.body, `{p.id} at {screen.X}x{screen.Y} x{scale}: {math.floor(total)} px of page for {math.floor(m.body)} px of pane`)
				end
			end
		end
	end)

	check("notebook: page titles fit the list in at most three lines, and the heading and buttons fit their bands", function()
		local book: any = everything()
		for _, screen in screens do
			for _, scale in scales do
				local m = NotebookText.metrics(screen.X, screen.Y, scale)
				local lay = NotebookText.layout(screen.X, screen.Y, scale)
				local width = (m.paperW - 28) * lay.listFraction - (if lay.sideBySide then 8 else 0) - 10 - 16 - 6 -- the list, the button's inset and padding, the scroll bar
				for _, p in book.pages do
					local s = size(p.title, S.button * scale, Enum.Font.GothamMedium, width)
					assert(s.Y <= 3 * S.button * scale * 1.3, `{p.id} at {screen.X}x{screen.Y} x{scale}: title needs {s.Y} px`)
				end
				local h = size(NotebookText.HEADING, S.heading * scale, Enum.Font.GothamBold, m.paperW - 28)
				assert(h.Y <= m.head and h.X <= m.paperW - 28, `heading {h} in {m.head} at {screen.X}x{screen.Y} x{scale}`)
				for _, label in { NotebookText.CLOSE, NotebookText.PAGES } do
					local b = size(label, S.button * scale, Enum.Font.GothamMedium, 112 * scale)
					assert(b.X <= 112 * scale - 8 and b.Y <= m.foot - 8, `button "{label}" is {b} in {112 * scale}x{m.foot - 8}`)
				end
			end
		end
	end)

	check("notebook: the controls line fits its two lines, where it is shown, for every device", function()
		for _, screen in screens do
			for _, scale in scales do
				local m = NotebookText.metrics(screen.X, screen.Y, scale)
				if m.hint > 0 then
					local lay = NotebookText.layout(screen.X, screen.Y, scale)
					for _, device in devices do
						for _, pad in { "xbox", "playstation" } do
							ControlText.setPadStyle(pad)
							local text = NotebookText.controls(device, not lay.sideBySide)
							local s = size(text, S.controls * scale, Enum.Font.Gotham, m.paperW - 28)
							assert(s.Y <= m.hint, `{device}/{pad} at {screen.X}x{screen.Y} x{scale}: "{text}" needs {s.Y} px for {m.hint}`)
						end
					end
				end
			end
		end
		ControlText.setPadStyle("xbox")
	end)

	check("notebook: the note that a page opened wraps inside the narrowest label, and the Notebook button's word fits its button", function()
		local book: any = everything()
		local width = HudLayout.MIN_PROMPT_WIDTH - 20
		for _, p in book.pages do
			for _, device in devices do
				for _, pad in { "xbox", "playstation" } do
					ControlText.setPadStyle(pad)
					local s = size(NotebookText.note(p.title, device), 15, Enum.Font.GothamMedium, width)
					assert(s.X <= width + 0.5 and s.Y <= 5 * 15 * 1.35, `{p.id}/{device}: the note is {s}`)
				end
			end
		end
		ControlText.setPadStyle("xbox")
		local b = size(NotebookText.BUTTON, 14, Enum.Font.GothamMedium, 1000)
		assert(b.X <= 88 - 6 and b.Y <= 36, `the button's word is {b} in 88x36`)
	end)

	check("notebook: the panel is built with real property names, shows each found page and nothing else", function()
		local book: any = FieldNotebook.new()
		book:notice("start"); book:notice("jump"); book:notice("buzz")
		local host = Instance.new("Folder")
		host.Name = "NotebookSpecHost"
		host.Parent = workspace
		local closed = 0
		local panel = NotebookPanel.new(host, book, function() closed += 1 end)
		panel:layout()
		panel:_rebuildList()
		assert(#panel.buttons == 3, `{#panel.buttons} list entries`)
		for _, id in { "bold_jumper", "dragline", "hearing" } do
			panel:showPage(id)
			assert(panel.title.Text == book:view(id).title and panel.title.Visible and not panel.empty.Visible, id)
		end
		panel:showPage("legs_push") -- not found: nothing shows
		assert(panel.shown == "" and panel.empty.Visible and not panel.title.Visible and not panel.sources.Visible, "an unfound page showed")
		local seen = ""
		for _, d in panel.gui:GetDescendants() do
			if d:IsA("TextLabel") or d:IsA("TextButton") then seen ..= d.Text .. "\n" end
		end
		for _, p in book.pages do
			assert((string.find(seen, p.title, 1, true) ~= nil) == book:isOpen(p.id) or p.id == "hearing", p.id .. " on screen wrongly")
		end
		assert(panel.page.ScrollingDirection == Enum.ScrollingDirection.Y and panel.list.AutomaticCanvasSize == Enum.AutomaticSize.Y, "the panes scroll")
		assert(panel.controls.TextTruncate == Enum.TextTruncate.AtEnd, "the controls line truncates")
		panel.gui:Destroy()
		host:Destroy()
		assert(NotebookPages.noteSeconds == 6.0)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="198">
        <Properties>
          <string name="Name">PeacockSpec</string>
          <string name="Source"><![CDATA[--!strict
-- The peacock spider on real Roblox parts (ROBLOX-29 to 31): the drawn male builds inside its budget, the folded fan opens with the
-- dance pose, legs III go up, every part is display only, and the dance is only a pose (nothing here touches a collider or a sense).
return function(check: (string, () -> ()) -> ())
	local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
	local Rig = require(Shared.Rig.SpiderRig)
	local Dance = require(Shared.Rig.PeacockDance)
	local folder = Instance.new("Folder")
	folder.Name = "PeacockTestWorld"
	folder.Parent = workspace
	local floor = Instance.new("Part")
	floor.Anchored = true
	floor.Size = Vector3.new(20, 1, 20)
	floor.Position = Vector3.new(200, -0.5, 0)
	floor.Parent = folder
	local body = CFrame.new(200, 0.31, 0)
	local function parts(rig: any, name: string): { BasePart }
		local out = {}
		for _, p in rig.model:GetChildren() do
			if p:IsA("BasePart") and p.Name == name then table.insert(out, p) end
		end
		return out
	end
	check("the peacock spider builds in the engine inside its part budget, display only", function()
		for _, detail in { "full", "low" } do
			local rig = Rig.new(folder, folder, "maratus_volans_male", detail)
			local count = 0
			for _, part in rig.model:GetChildren() do
				if part:IsA("BasePart") then
					count += 1
					assert(part.Anchored and not part.CanCollide and not part.CanQuery and not part.CanTouch, `{part.Name} is not display only`)
				end
			end
			assert(count <= (if detail == "full" then 130 else 80), `{detail}: {count} parts`)
			assert(rig.model:GetAttribute("AppearanceId") == "maratus_volans_male")
			rig:destroy()
		end
	end)
	check("the dance pose opens the fan and raises legs III; no pose folds it", function()
		local rig = Rig.new(folder, folder, "maratus_volans_male", "full")
		for _ = 1, 30 do rig:update(body, 1 / 60, true, false) end
		local field = parts(rig, "FanField")[1]
		local folded = field.Size.X
		rig.dance = Dance.rawPose(5.2, false)
		for _ = 1, 5 do rig:update(body, 1 / 60, true, false) end
		assert(field.Size.X > folded * 1.6, "the fan did not open")
		assert(field.CFrame.UpVector.Z < -0.9, "the raised fan does not face forward")
		assert(parts(rig, "Tarsus3")[1].Position.Y > 0.2, "legs III did not go up")
		assert((rig.root.Position - body.Position).Magnitude < 1e-6, "the root moved")
		rig.dance = nil
		for _ = 1, 5 do rig:update(body, 1 / 60, true, false) end
		assert(field.Size.X < folded * 1.05, "the fan did not fold")
		rig:destroy()
	end)
	check("a small body stands low and all eight feet find the floor", function()
		local rig = Rig.new(folder, folder, "maratus_volans_male", "full")
		for _ = 1, 60 do rig:update(body, 1 / 60, true, false) end
		for _, leg in rig._legs do
			assert(leg.planted ~= nil and math.abs(leg.planted.Y) < 0.01, "a foot is not on the floor")
		end
		assert(parts(rig, "Abdomen")[1].Position.Y < 0.2, "the body is not low")
		rig:destroy()
	end)
	folder:Destroy()
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="199">
        <Properties>
          <string name="Name">PerceptionSpec</string>
          <string name="Source"><![CDATA[--!strict
-- P01 F1-F8: real WORLD rays plus the actual memory-only view builder. Isolated from playable geometry.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sensor = require(Shared.Perception.Sensor)
local Memory = require(Shared.Perception.ObservationMemory)
local View = require(Shared.UI.PerceptionView)
local Species = require(Shared.Data.Species)
local Motor = require(Shared.Movement.SpiderMotor)
local Surfaces = require(Shared.Data.Surfaces)
return function(check: (string, () -> ()) -> ())
	local folder: Folder? = nil
	local memory: any; local sensor: any; local observer: any; local cast: any; local target: any
	local function rig()
		if folder then folder:Destroy() end
		folder = Instance.new("Folder"); folder.Name="P01World"; folder.Parent=workspace
		local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Include; params.FilterDescendantsInstances={folder :: Folder}
		cast=Sensor.workspaceCast(params)
		memory=Memory.new(); sensor=Sensor.new(memory); sensor:configureFrom(Species.phidippus_audax_prototype.perception)
		observer={eye=Vector3.new(0,100,0),gaze=-Vector3.zAxis,heading=-Vector3.zAxis,up=Vector3.yAxis}
		target={id="marker",position=Vector3.new(0,100,-8),radius=0.45,velocity=Vector3.zero,maxCategory="fly_like_prey"}
	end
	local function wall()
		local p=Instance.new("Part"); p.Size=Vector3.new(6,6,0.2); p.Position=Vector3.new(0,100,-4)
		p.Anchored=true; p.CanCollide=false; p.CanQuery=true; p.Parent=folder
		return p
	end
	local function run(n: number, present: boolean?)
		for _=1,n do sensor:step(1/60,observer,if present==false then {} else {target},cast) end
	end
	local function contact(): any return memory:getContact(sensor:trackIdFor(target.id)) end
	local adapter={
		project=function(p: Vector3, _: number) return Vector2.new(p.X,p.Z),true,12 end,
		edge=function(d: Vector3) return {pos=Vector2.new(d.X,d.Z),dir=Vector2.new(1,0)} end,
		covered=function(_: Vector3, _: number) return true end,
	}
	check("P01 F1 peripheral cue has bearing but no position or identity",function()
		rig(); target.position=Vector3.new(8,100,0); target.velocity=Vector3.xAxis*0.8; run(30)
		local c=contact(); assert(c and not c.hasPosition and c.category=="movement" and c.cueCount==1)
		local v=View.build(memory,adapter); assert(#v.edges==1 and #v.labels==0 and #v.rings==0)
	end)
	check("P01 F2 camera projection cannot rotate the sensor cone",function()
		rig(); target.position=Vector3.new(8,100,0); target.velocity=Vector3.xAxis; run(120)
		for _=1,30 do View.build(memory,adapter) end
		assert(not contact().hasPosition and sensor.core.inspectionsMade==0)
	end)
	check("P01 F3 Focus turns at capped rate and inspection refines in time",function()
		rig()
		local motor=Motor.new({world=folder,surfaces=Surfaces,profile=Species.phidippus_audax_prototype,spawn=Vector3.new(0,99.92,0),heading=Vector3.xAxis})
		-- Tick the same capped facing function used by the motor via its normal tick input.
		local floor=Instance.new("Part"); floor.Anchored=true; floor.Size=Vector3.new(30,1,30); floor.Position=Vector3.new(0,99.42,0); floor:SetAttribute("ProfileId","painted_wood_dry"); floor.Parent=folder
		motor:place(Vector3.new(0,99.92,0),Vector3.yAxis,Vector3.xAxis)
		local first, possible, fly = 0,0,0
		for tick=1,180 do
			observer=motor:observer(); sensor:step(1/60,observer,{target},cast)
			local c=contact()
			if c and c:isInspectedNow() then
				if first==0 then first=tick end
				if c.category=="possible_prey" and possible==0 then possible=tick end
				if c.category=="fly_like_prey" and fly==0 then fly=tick end
			end
			local old=motor.heading
			motor:tick({wish=Vector3.zero,focusPoint=target.position})
			assert(math.deg(math.acos(math.clamp(old:Dot(motor.heading),-1,1))) < 3.02,"Focus exceeded 180 deg/s")
		end
		assert(first>0 and possible-first+1>=24 and fly-first+1>=60,"classification timing")
		assert(View.build(memory,adapter).labels[1].text=="fly-like prey")
	end)
	check("P01 F4 hidden motion never updates observation or HUD position",function()
		rig(); run(80); local c=contact(); local pos=c.position; local tick=c.observedTick
		wall(); target.position+=Vector3.new(2,0,0); run(100)
		assert(c:hasMark() and (c.position-pos).Magnitude<1e-5 and c.observedTick==tick)
		local v=View.build(memory,adapter); assert(#v.rings==1 and v.rings[1].pos==Vector2.new(pos.X,pos.Z))
	end)
	check("P01 F5 fixed last-seen mark fades and expires",function()
		rig(); run(80); local c=contact(); wall(); run(12,false)
		local p=c.position; run(175,false); local v=View.build(memory,adapter)
		assert(c:hasMark() and c.position==p and v.rings[1].alpha<0.4 and v.rings[1].dash<0.8)
		run(200,false); assert(memory:count()==0 and #View.build(memory,adapter).rings==0)
	end)
	check("P01 F6 association follows evidence even after world id changes",function()
		rig(); run(80); local c=contact(); local w=wall(); run(30); target.id="renamed"; w:Destroy(); run(7)
		assert(contact()==c and c.reacquisitions==1 and memory:count()==1)
	end)
	check("P01 F7 only an inspected empty visible spot loses its mark",function()
		rig(); run(80); local c=contact(); run(12,false); assert(c:hasMark()); run(40,false); assert(memory:count()==0)
		rig(); run(80); c=contact(); wall(); run(100,false); assert(c:hasMark())
	end)
	check("P01 F8 never-sensed actors leave no overlay",function()
		rig(); target.position=Vector3.new(0,100,8); target.velocity=Vector3.xAxis; run(100)
		local v=View.build(memory,adapter); assert(memory:count()==0 and #v.edges==0 and #v.labels==0 and #v.rings==0)
		rig(); wall(); run(100); assert(memory:count()==0)
	end)
	if folder then folder:Destroy() end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="200">
        <Properties>
          <string name="Name">PreySpec</string>
          <string name="Source"><![CDATA[--!strict
-- Native and box-world T07 acceptance: never through cover, no teleports, reserved perches and conserved meals.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local D=require(Shared.Prey.PreyDirector)
local P=require(Shared.Prey.PreyPopulation)
local F=require(Shared.Prey.Feeding)
local Species=require(Shared.Data.Species)
local Layout=require(Shared.Habitat.WindowsillLayout)
local Sensor=require(Shared.Perception.Sensor)
local Memory=require(Shared.Perception.ObservationMemory)
return function(check: (string,()->())->())
 local p=Species.fly_like_prototype
 local world=Instance.new('Folder');world.Name='PreyTestWorld';world.Parent=workspace
 -- Use the same authored sill as the real client, moved nowhere; casts include only this private copy.
 for _,b in Layout.PIECES do
  local part=Instance.new('Part');part.Anchored=true;part.Size=b.hi-b.lo;part.CFrame=CFrame.new((b.hi+b.lo)*.5);part.Parent=world
 end
 local d=D.engine(world,p,914,4)
 check('T07 valid starts and swept flight reaches a reserved perch without teleporting',function()
  assert(#d.flies==4,'expected four validated starting perches, got '..#d.flies)
  local f=d.flies[1];assert(f:launch('move',0),'no flyable move')
  local target=f.flight.target;assert(target.reserved==f.id and f.perch.occupant=='')
  for i=1,1800 do
   local prev=f.position;f.flight:step(i/60,1/60)
   assert((f.position-prev).Magnitude<=p.flight.flee_speed_wu_s/60+.001,'teleport')
   if f.state=='PERCHED' then break end
  end
  assert(f.state=='PERCHED' and f.perch==target and target.occupant==f.id and target.reserved=='')
 end)
 check('T07 population waits, checks twice, rejects visible entrances and respects capacity',function()
  local pop=P.new(p.population,7,1);local n=0;local safe=false;local vents={{id='v'}}
  local function step(t: number) pop:step(t,n,vents,function()return safe end,function()n+=1;return true end) end
  step(0);step(24);assert(n==0);step(46);assert(n==0)
  safe=true;step(47);assert(n==0);safe=false;step(47.5);safe=true;step(48);assert(n==0)
  step(48.5);assert(n==1);step(100);assert(n==1 and #pop.owed==0)
 end)
 check('T07 feeding waits for landing, automatic grip works and nutrition cannot be duplicated',function()
  local feed=F.new();local fly={profile=p,nutrition=.35,state='CAPTURED',captureKey='meal1'}
  feed:capture(fly);feed.auto=true
  feed:step(.5,false,false,function()error('unexpected escape')end);assert(feed.grip==.4 and feed.needs.energy<=.55 and feed.needs.grantedTotal==0)
  for _=1,1500 do feed:step(1/60,true,false,function()error('unexpected escape')end) end
  assert(fly.state=='CONSUMED' and math.abs(feed.taken-.35)<1e-6 and feed.granted<=feed.taken+1e-9) -- the reserve records what it actually rose by (ROBLOX-24)
  local taken=feed.taken;feed:press();for _=1,120 do feed:step(1/60,true,false,function()end) end
  assert(feed.taken==taken and feed.ledger.meal1<=.35+1e-9)
 end)
 check('T07 no tapping lets a caught fly escape without a meal',function()
  local feed=F.new();local escaped=0;local fly={profile=p,nutrition=.35,state='CAPTURED',captureKey='meal2'}
  feed:capture(fly)
  for _=1,240 do feed:step(1/60,true,false,function()escaped+=1 end) end
  assert(escaped==1 and feed.taken==0 and not feed.held)
 end)
 check('T07 movement interrupts feeding on the same tick',function()
  local feed=F.new();feed.held={profile=p,nutrition=.35,state='CAPTURED',captureKey='meal3'};feed.feeding=true
  feed:step(1/60,true,true,function()end);assert(not feed.feeding and feed.taken==0)
 end)
 check('T07 jaws resolve one position-size contact; ambiguous capture resolves neither',function()
  local memory=Memory.new();local sensor=Sensor.new(memory);sensor:configureFrom(Species.phidippus_audax_prototype.perception)
  local observer={eye=Vector3.new(0,10,0),gaze=-Vector3.zAxis,heading=-Vector3.zAxis,up=Vector3.yAxis}
  local target={id='no-secret-id',position=Vector3.new(0,10,-4),radius=.3,velocity=Vector3.zero,maxCategory='fly_like_prey'}
  for _=1,90 do sensor:step(1/60,observer,{target},function()return nil end) end
  assert(sensor:onCapture(target.position,.3) and #memory:contacts()==0)
  local other={id='other',position=target.position+Vector3.xAxis*.2,radius=.3,velocity=Vector3.zero,maxCategory='fly_like_prey'}
  for _=1,90 do sensor:step(1/60,observer,{target,other},function()return nil end) end
  assert(not sensor:onCapture(target.position,.3) and #memory:contacts()==2)
 end)
 check('T07 a changed obstacle stops the flight before penetration',function()
  local f=d.flies[2];assert(f:launch('move',0))
  local pos=f.position;local old=d.graph.clear
  d.graph.clear=function()return false end
  f.flight:step(1/60,1/60)
  d.graph.clear=old
  assert(f.position==pos and f.velocity.Magnitude==0 and f.flight.blocked>0)
 end)
 check('T07 capture cannot cross a wall or start from an ordinary fall',function()
  local f=d.flies[1];f.state='PERCHED';f.position=Vector3.new(0,10,0);f.prevPosition=f.position
  local motor={mode='air',pos=Vector3.new(.2,10,0),events={},preparing=false,moving=false,vel=Vector3.zero,heading=Vector3.zAxis,up=Vector3.yAxis,
   eyePosition=function()return Vector3.new(.2,10,0)end}
  d.previousPosition=Vector3.new(-.2,10,0);d.previousMode='attached';d.tick=10;d.strikeEnd=-1
  local captures=0;local sensor={onCapture=function()captures+=1 end}
  d:after(1/60,motor,sensor,function()return nil end);assert(not d.feeding.held and captures==0)
  d.previousMode='attached';motor.events={{kind='launched'}}
  d:after(1/60,motor,sensor,function(a,b)return (a+b)*.5 end);assert(not d.feeding.held and captures==0)
  motor.pos=Vector3.new(.76,10,0);d.previousPosition=motor.pos
  d:after(1/60,motor,sensor,function()return nil end);assert(not d.feeding.held,"outside the modest new reach must miss")
  motor.pos=Vector3.new(.74,10,0);d.previousPosition=motor.pos
  d:after(1/60,motor,sensor,function()return nil end);assert(d.feeding.held==f and captures==1,"near miss inside new reach should catch")
 end)
 d.probe:Destroy();world:Destroy()
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="201">
        <Properties>
          <string name="Name">PromptSpec</string>
          <string name="Source"><![CDATA[--!strict
-- Device-aware prompts with Roblox's own text metrics (TextService): every prompt the HUD can show wraps inside the
-- narrowest prompt panel HudLayout allows, and the touch buttons' words fit their buttons. The live panel's placement and
-- TextFits are checked in the real client by tests/client/SilkPlayback.luau.
return function(check: (string, () -> ()) -> ())
	local TextService = game:GetService("TextService")
	local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
	local ControlText = require(Shared.UI.ControlText)
	local PeacockText = require(Shared.UI.PeacockText)
	local AntMimicText = require(Shared.UI.AntMimicText)
	local TarantulaText = require(Shared.UI.TarantulaText)
	local InspectText = require(Shared.UI.InspectText)
	local MateText = require(Shared.UI.MateText)
	local LifeText = require(Shared.UI.LifeText)
	local HudLayout = require(Shared.UI.HudLayout)
	local FONT = Enum.Font.GothamMedium
	local devices: { any } = { "keyboard", "gamepad", "touch" }
	local width = HudLayout.MIN_PROMPT_WIDTH - 20 -- the panel's narrowest span less the label's padding
	local function size(text: string, textSize: number, w: number): Vector2
		return TextService:GetTextSize(text, textSize, FONT, Vector2.new(w, 10000))
	end
	check("every device's prompts wrap inside the narrowest prompt panel in at most four lines", function()
		for _, device in devices do
			local title, hint, cue = ControlText.linePanel({ reeling = true, progress = 0, snagged = true, block = "" }, device)
			local texts = { title, hint, cue, ControlText.walkHint(device), ControlText.edgeWalkHint(device),
				ControlText.lineToast("dropped", "", false, true, device), ControlText.describe({ kind = "unreachable", reason = "no_launch" }, device) }
			for _, text in texts do
				local s = size(text, 17, width)
				assert(s.X <= width + 0.5, `{device}: "{text}" is {s.X} px wide in {width}`)
				assert(s.Y <= 4 * 17 * 1.35, `{device}: "{text}" needs {s.Y} px (over four lines)`)
			end
		end
	end)
	check("the controls card fits a phone's width in landscape for every device, every display key and both pad styles, in at most ten lines (the very string the HUD shows)", function()
		for _, style in { "xbox", "playstation" } do
			ControlText.setPadStyle(style :: any)
			for _, device in devices do
				for _, kind in { "none", "dance", "antennae", "threat" } do -- the first spider, with the peacock spider's lines, with the ant mimic's and with the tarantulas'
					-- (ROBLOX-92: this measured ControlText.helpCard .. helpExtra, which was not what the screen showed once the close look's line was added; PeacockText.card is the screen's string)
					local card = PeacockText.card(device, if kind == "none" then nil else kind)
					local s = size(card, 15, 568 - 32 - 20)
					assert(s.Y <= 10 * 15 * 1.35, `{device}: the card ({kind}, {style}) needs {s.Y} px`)
				end
			end
		end
		ControlText.setPadStyle("xbox")
	end)
	-- Every word a touch button can carry (the labels the client sets each frame: Grip for a struggle, Skip in the mating scene, Back and View in the close look, Rest, Sleep, Leave and Wake
	-- on the feed button, the three display keys' words), by action: the layout's own label first.
	local function labelsFor(b: HudLayout.Button): { string }
		local labels = { b.label }
		if b.action == "Cancel" then labels = { ControlText.touchCancelLabel(false), ControlText.touchCancelLabel(true), InspectText.TOUCH_BACK } end
		if b.action == "Display" then labels = { b.label, PeacockText.touchDisplay(true), AntMimicText.touchDisplay(false), AntMimicText.touchDisplay(true), TarantulaText.touchDisplay(false), TarantulaText.touchDisplay(true) } end
		if b.action == "Jump" then labels = { b.label, "Grip", MateText.TOUCH_SKIP } end
		if b.action == "Feed" then
			labels = { b.label, "Grip", "Eat" }
			for _, st in { { true, true, false, false }, { false, true, false, false }, { false, false, true, true }, { false, false, true, false } } do
				local word = LifeText.touchLabel(st[1], st[2], st[3], st[4]) -- (Wake, Leave, Sleep, Rest)
				if word ~= nil then table.insert(labels, word) end
			end
		end
		if b.action == "Eye" then labels = { b.label, InspectText.TOUCH_VIEW } end
		if b.action == "Choose" then labels = { b.label, PeacockText.touchChange() } end
		if b.action == "Lock" then labels = { b.label, ControlText.touchLockLabel(true) } end -- (ROBLOX-110: Lock, Unlock)
		return labels
	end
	check("touch buttons' words fit their buttons, the relabels too (Rear up, Grip, Back, View, Leave, Sleep, Wake, Skip)", function()
		local seen: { [string]: boolean } = {}
		for _, b in HudLayout.TOUCH_BUTTONS do
			for _, label in labelsFor(b) do
				seen[label] = true
				local s = size(label, b.textSize or 18, b.size - 6)
				assert(s.X <= b.size - 6 + 0.5 and s.Y <= b.size - 6, `{b.action}: "{label}" is {s.X}x{s.Y} in {b.size}`)
			end
		end
		for _, word in { "Rear up", "Grip", "Back", "View", "Leave", "Sleep", "Wake", "Skip" } do
			assert(seen[word], `("{word}" is a word the spec measures)`)
		end
	end)
	check("compact landscape touch labels fit and the prompt stays on screen (480 x 320 and 640 x 360 too), the relabels included", function()
		for _, wh in { Vector2.new(480, 320), Vector2.new(568, 320), Vector2.new(640, 360), Vector2.new(667, 375), Vector2.new(844, 390) } do
			local _, _, bottom = HudLayout.promptSpan(wh.X, wh.Y, "touch")
			assert(bottom >= 120, `{wh.X}x{wh.Y}: the prompt top would be off screen`)
			for _, spec in HudLayout.TOUCH_BUTTONS do
				local b = HudLayout.layoutButton(spec, wh.X, wh.Y)
				for _, label in labelsFor(spec) do
					local text = size(label, b.textSize or 18, b.size - 6)
					assert(text.X <= b.size - 6 + .5 and text.Y <= b.size - 6, `{wh.X}x{wh.Y}: compact {b.action} "{label}" does not fit ({text.X}x{text.Y} in {b.size})`)
				end
			end
			-- the top buttons keep their words too (the narrower pair of a short, narrow screen)
			local t = HudLayout.topLayout(wh.X, wh.Y)
			local menu, book = size("Menu", 18, 1000), size("Notebook", 16, 1000)
			assert(menu.X <= t.menu.x1 - t.menu.x0 - 8 and book.X <= t.notebook.x1 - t.notebook.x0 - 8, `{wh.X}x{wh.Y}: Menu is {menu.X}, Notebook {book.X} in ({t.menu.x1 - t.menu.x0}, {t.notebook.x1 - t.notebook.x0})`)
		end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="202">
        <Properties>
          <string name="Name">RecoveryScenarios</string>
          <string name="Source"><![CDATA[--!strict
-- Deterministic recovery scenarios (HANDOFF-roblox-silk.md, Chet's acceptance list): missed jumps caught by the line,
-- lowering from a leaf, a wall and the planter, reeling, a snag, early and pre-held let-go presses, focus-loss
-- cancellation and a ten-miss recovery sequence, plus the catch camera (no roll, never inside the sill, the 45-degree
-- framing cap, the player's look winning), the landing patch's states and the body turning to Focus, the eye view and an
-- aim. The real SpiderMotor, SilkController, JumpInput and SpiderCamera run tick by tick
-- at 1/60 s on the windowsill's own boxes (WindowsillLayout.PIECES) in a separate folder; nothing waits on the frame rate.
-- Studio runs this with the engine's raycasts and sphere casts (tests/studio/Runner.server.luau). The plain Luau CLI runs the
-- same code against the box-world emulation in tests/shim.luau (tests/scenarios.luau): a smoke test, not engine evidence.
-- A miss is made the way a player makes one (Godot M03): a jump is planned and committed to a perch that then drops away.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Breakaway=require(Shared.Habitat.Breakaway)
return function(check: (string, () -> ()) -> (), deps: any)
	local Motor, JumpInput, Layout, Species, Surfaces, SpiderCamera = deps.Motor, deps.JumpInput, deps.Layout, deps.Species, deps.Surfaces, deps.SpiderCamera
	local DT = Motor.DT
	local HEIGHT = Motor.HEIGHT
	local folders: { Instance } = {}

	local function part(folder: Instance, name: string, lo: Vector3, hi: Vector3, profile: string): BasePart
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = hi - lo
		p.Position = (hi + lo) / 2
		p:SetAttribute("ProfileId", profile)
		if deps.transparent then p.Transparency = 1 end
		p.Parent = folder
		return p
	end

	local function windowsill(name: string): Instance
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = workspace
		for _, piece in Layout.PIECES do part(folder, piece.id, piece.lo, piece.hi, piece.profile) end
		table.insert(folders, folder)
		return folder
	end

	local sill = windowsill("RecoverySill")
 check("stalking cover blocks sight with clear views above it",function()
  for _,id in {"cover_bark_west","cover_bark_east","cover_leaf_front","cover_rim"} do
   local p=sill:FindFirstChild(id) :: BasePart
   local rp=RaycastParams.new();rp.FilterType=Enum.RaycastFilterType.Include;rp.FilterDescendantsInstances={p}
   local across=if p.Size.X<p.Size.Z then Vector3.xAxis else Vector3.zAxis
   local start=p.Position-across*3
   assert(workspace:Raycast(start,across*6,rp)~=nil,id.." must block sight")
   assert(workspace:Raycast(start+Vector3.yAxis*(p.Size.Y+1),across*6,rp)==nil,id.." must leave an open view above")
  end
 end)

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = { sill }
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { sill }

	local function newMotor(world: Instance?): any
		return Motor.new({ world = world or sill, surfaces = Surfaces, profile = Species.phidippus_audax_prototype, spawn = Layout.SPAWN,
			heading = Layout.SPAWN_HEADING, boundsMin = Layout.PLAY_BOUNDS_MIN, boundsMax = Layout.PLAY_BOUNDS_MAX, probeParent = world or sill })
	end
	local function input(t: any?): any
		local i: any = Motor.idleInput()
		for k, v in t or {} do i[k] = v end
		return i
	end
	local function finite(v: Vector3): boolean
		return v.X == v.X and v.Y == v.Y and v.Z == v.Z and v.Magnitude < 1e5
	end
	local function insideSill(p: Vector3, r: number): boolean
		return #workspace:GetPartBoundsInRadius(p, r, overlap) > 0
	end
	local function has(events: { string }, kind: string): boolean
		return table.find(events, kind) ~= nil
	end

	-- A run: ticks the motor (and, when given, the camera) with an input function until `done` or the tick limit, and
	-- watches every tick: finite, the body never inside the sill, the line never longer than its rest length, the camera
	-- never rolled and never inside the sill.
	type Run = { m: any, cam: any?, events: { string }, ticks: number, problems: { string }, maxTurn: number }
	local function watch(m: any, cam: any?): Run
		return { m = m, cam = cam, events = {}, ticks = 0, problems = {}, maxTurn = 0 }
	end
	local function problem(r: Run, text: string)
		if #r.problems < 6 then table.insert(r.problems, `tick {r.ticks}: {text}`) end
	end
	local function step(r: Run, inp: any)
		local m = r.m
		m:tick(inp)
		r.ticks += 1
		for _, e in m:drainEvents() do table.insert(r.events, e.kind) end
		if not finite(m.pos) or not finite(m.vel) then problem(r, "non-finite position or velocity") end
		if insideSill(m.pos, 0.25) then problem(r, `body inside the sill at {m.pos}`) end
		local silk = m.silk
		if silk.mode == "locked" then
			-- As Godot's M03: the line may pass through geometry only on ticks flagged as snagged, where its straight
			-- segments are not its length.
			if not silk.snagged and silk:path(m.pos) > silk.rest + 0.02 then problem(r, "line longer than its rest length") end
			if silk.rest > silk.maximum + 1e-6 or silk.paid < 0 then problem(r, "line length out of range") end
		end
		local cam: any = r.cam
		if cam then
			cam:tick(DT)
			cam:render(DT, 0, 0)
			local cf = cam.camera.CFrame
			if not cam.eyeView and math.abs(cf.RightVector.Y) > 1e-5 then problem(r, "the camera rolled") end
			if insideSill(cf.Position, 0.05) then problem(r, `camera inside the sill at {cf.Position}`) end
			r.maxTurn = math.max(r.maxTurn, math.abs(cam.framing.assist))
		end
	end
	-- Studio would stop a script that runs too long without yielding; the engine run yields now and then (the CLI does not).
	local function breathe(r: Run)
		if deps.yield and r.ticks % 600 == 0 then deps.yield() end
	end
	local function runUntil(r: Run, limit: number, inp: any, done: ((any) -> boolean)?): boolean
		for _ = 1, limit do
			step(r, inp)
			breathe(r)
			if done and done(r.m) then return true end
		end
		return false
	end
	local function newCamera(m: any): any
		local camera = Instance.new("Camera")
		camera.Parent = sill
		local drawnUp = Vector3.yAxis
		local cam = SpiderCamera.new(camera, params, function()
			drawnUp = drawnUp:Lerp(m.up, 0.33).Unit
			return { pos = m.pos, drawnUp = drawnUp, heading = m.heading, onLine = m:onLine(), rest = m:lineRestPoint(), lip = m:lineLip() }
		end, function(_on: boolean) end)
		cam.mouse = false
		return cam
	end

	-- A miss: from a spot on a surface, a leap planned to a perch that drops away once the spider has left.
	local function miss(m: any, at: Vector3, heading: Vector3, perchTop: Vector3): (boolean, string)
		m:place(at, Vector3.yAxis, heading)
		local lo = perchTop + Vector3.new(-0.5, -0.4, -0.5)
		local hi = perchTop + Vector3.new(0.5, 0, 0.5)
		local perch = part(sill, "PracticePerch", lo, hi, "leaf_dry_prototype")
		local plan = m:planJump(perchTop, Vector3.yAxis, perch)
		local ok = plan.kind == "reachable" and m:commit(plan)
		perch:Destroy()
		return ok, `{plan.kind} {plan.reason}`
	end
	local hanging = function(mm: any) return mm.silk.mode == "locked" and mm.silk.taut end
	local settled = function(mm: any) return (mm.silk.mode == "locked" and mm.silk.taut and mm.vel.Magnitude < 0.3) or mm.mode == "attached" end
	local attached = function(mm: any) return mm.mode == "attached" end

	local ok, err = pcall(function()
		-- ------------------------------------------------------------------ missed jumps and reeling
		check("a missed leap off the east leaf is caught by the line, settles, and reeling takes hold of the leaf", function()
			local m = newMotor()
			local cam = newCamera(m)
			local r = watch(m, cam)
			cam:snap()
			local launched, why = miss(m, Vector3.new(21.5, 5.4 + HEIGHT, -0.6), Vector3.zAxis, Vector3.new(21.5, 5.3, 2.9))
			assert(launched, "the practice leap was not reachable: " .. why)
			assert(runUntil(r, 240, input(), hanging), "no catch")
			assert(has(r.events, "anchored") and has(r.events, "locked") and has(r.events, "caught"), "line events: " .. table.concat(r.events, ","))
			assert(m.pos.Y > 1 and m.pos.Y < 5.4, `hangs below the leaf, not on the floor: {m.pos}`)
			assert(runUntil(r, 600, input(), settled), "the swing did not settle within 10 s")
			assert(runUntil(r, 1800, input({ reel = 1 }), attached), "reeling did not take hold again")
			assert(has(r.events, "completed") and m.supportPart and m.supportPart.Name == "leaf_east", `took hold of {m.supportPart} at {m.pos}`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
			assert(r.maxTurn <= math.rad(45) + 1e-9, "framing turn over the cap")
		end)

		-- ------------------------------------------------------------------ letting down: a leaf, a wall, the planter
		check("F on the middle leaf walks to the nearest edge, lets down, and a held F lowers to the sill floor", function()
			local m = newMotor()
			local r = watch(m)
			m:place(Vector3.new(0.5, 4.2 + HEIGHT, -3.0), Vector3.yAxis, Vector3.xAxis)
			assert(m:requestDrop() and m.silk.walk ~= nil, "no walk to the edge")
			assert(runUntil(r, 240, input(), hanging), "no hang after the walk to the edge")
			assert(has(r.events, "drop_walk") and has(r.events, "dropped"), table.concat(r.events, ","))
			assert(runUntil(r, 900, input({ dropHeld = true }), attached), "lowering never reached a surface")
			assert(m.pos.Y < 0.5, `landed at {m.pos}`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)
		check("F on the back wall lets down at once and lowering reaches the floor", function()
			local m = newMotor()
			local r = watch(m)
			m:place(Vector3.new(-8, 6, -12.5 + HEIGHT), Vector3.zAxis, Vector3.yAxis)
			assert(m:requestDrop() and m.mode == "air" and m.silk.walk == nil, "a wall should let down at once")
			assert(runUntil(r, 1200, input({ dropHeld = true }), attached), "lowering never reached a surface")
			assert(m.pos.Y < 0.5, `landed at {m.pos}`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)
		check("F on the planter rim walks to its front edge, lets down clear of the planter and lowers to the floor", function()
			local m = newMotor()
			local r = watch(m)
			m:place(Vector3.new(10, 4.6 + HEIGHT, 0.0), Vector3.yAxis, Vector3.zAxis)
			assert(m:requestDrop(), "planter rim refused")
			assert(runUntil(r, 240, input(), hanging), "no hang")
			assert(runUntil(r, 900, input({ dropHeld = true }), attached), "lowering never reached a surface")
			assert(m.pos.Y < 0.5 and m.pos.Z > 0.2, `landed at {m.pos}`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)
		check("after letting down from the leaf, reeling climbs back and takes hold of the leaf", function()
			local m = newMotor()
			local r = watch(m)
			m:place(Vector3.new(0.5, 4.2 + HEIGHT, -3.0), Vector3.yAxis, Vector3.xAxis)
			m:requestDrop()
			assert(runUntil(r, 240, input(), hanging), "no hang")
			runUntil(r, 90, input())
			assert(runUntil(r, 900, input({ reel = 1 }), attached), "reeling did not take hold")
			assert(m.supportPart and m.supportPart.Name == "leaf_middle", `took hold of {m.supportPart} at {m.pos}`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)

		-- ------------------------------------------------------------------ a snag
		check("a second obstruction snags the line: reeling is refused, lowering and letting go still work", function()
			local m = newMotor()
			local r = watch(m)
			m:place(Vector3.new(0.5, 4.2 + HEIGHT, -3.0), Vector3.yAxis, Vector3.xAxis)
			m:requestDrop()
			assert(runUntil(r, 240, input(), hanging), "no hang")
			runUntil(r, 120, input())
			local bend = m.silk.bend
			assert(bend ~= nil, "the leaf's edge should hold one bend")
			local obstacle = part(sill, "SecondEdge", (bend + m.pos) / 2 - Vector3.one * 0.06, (bend + m.pos) / 2 + Vector3.one * 0.06, "bare_wood_rough")
			runUntil(r, 2, input())
			assert(m.silk.snagged and has(r.events, "snagged"), "no snag reported")
			local rest = m.silk.rest
			runUntil(r, 60, input({ reel = 1 }))
			assert(math.abs(m.silk.rest - rest) < 1e-9, "reeling shortened a snagged line")
			runUntil(r, 30, input({ reel = -1 }))
			assert(m.silk.rest > rest + 0.5, "lowering did not pay out")
			runUntil(r, 2, input())
			assert(runUntil(r, 40, input({ releaseHeld = true }), function(mm) return mm.silk.mode == "none" end), "a deliberate hold did not let go")
			assert(has(r.events, "released"), table.concat(r.events, ","))
			obstacle:Destroy()
			assert(runUntil(r, 240, input(), attached) and m.pos.Y < 0.5, "did not fall to the floor")
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)

		-- ------------------------------------------------------------------ early and pre-held let-go presses
		check("a press in the 0.4 s grace never lets go, however long it is held; a fresh 0.6 s hold does", function()
			local m = newMotor()
			local r = watch(m)
			local launched = miss(m, Vector3.new(21.5, 5.4 + HEIGHT, -0.6), Vector3.zAxis, Vector3.new(21.5, 5.3, 2.9))
			assert(launched, "no practice leap")
			assert(runUntil(r, 240, input(), function(mm) return mm.silk.mode == "locked" end), "no lock")
			runUntil(r, 5, input())
			runUntil(r, 180, input({ releaseHeld = true }))
			assert(m:onLine(), "a press inside the grace let go")
			runUntil(r, 1, input())
			runUntil(r, 35, input({ releaseHeld = true }))
			assert(m:onLine() and m.silk.release.progress > 0.9, "a 35-tick hold let go, or showed no progress")
			runUntil(r, 1, input({ releaseHeld = true }))
			assert(m.silk.mode == "none" and has(r.events, "released"), "the 36th tick of a fresh hold did not let go")
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)
		check("Q held from before the leap through the catch never lets go; a fresh hold does", function()
			local m = newMotor()
			local r = watch(m)
			local launched = miss(m, Vector3.new(21.5, 5.4 + HEIGHT, -0.6), Vector3.zAxis, Vector3.new(21.5, 5.3, 2.9))
			assert(launched, "no practice leap")
			assert(runUntil(r, 240, input({ releaseHeld = true }), function(mm) return mm.silk.mode == "locked" end), "no lock")
			runUntil(r, 300, input({ releaseHeld = true }))
			assert(m:onLine(), "a held-over press let go")
			runUntil(r, 1, input())
			assert(runUntil(r, 36, input({ releaseHeld = true }), function(mm) return mm.silk.mode == "none" end), "a fresh hold did not let go")
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)

		-- ------------------------------------------------------------------ focus loss
		check("focus loss cancels: an aim never leaps afterwards, a let-go hold starts over, a walk to the edge stops", function()
			local m = newMotor()
			local j = JumpInput.new()
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			m:setAimRay(Vector3.new(-25, 3, 6), Vector3.new(1, -0.45, 0).Unit)
			j:press()
			for _ = 1, 12 do j:step(m); m:tick(input()) end
			assert(j:isAiming() and m:isPreparing(), "no aim")
			j:drop(m)
			j:release()
			for _ = 1, 3 do j:step(m); m:tick(input()) end
			assert(m.mode == "attached" and not m:isPreparing() and j.last == nil, "a release after focus loss leaped")
			local r = watch(m)
			local launched = miss(m, Vector3.new(21.5, 5.4 + HEIGHT, -0.6), Vector3.zAxis, Vector3.new(21.5, 5.3, 2.9))
			assert(launched, "no practice leap")
			assert(runUntil(r, 240, input(), function(mm) return mm.silk.mode == "locked" end), "no lock")
			runUntil(r, 40, input())
			runUntil(r, 18, input({ releaseHeld = true }))
			assert(m.silk.release.progress > 0.4, "no let-go progress")
			local release = m.silk.release -- what the client does on focus loss (SpiderClient dropAll)
			release.down, release.counts, release.held, release.progress = true, false, 0, 0
			runUntil(r, 60, input())
			assert(m:onLine() and m.silk.release.progress == 0, "the hold survived focus loss")
			runUntil(r, 35, input({ releaseHeld = true }))
			assert(m:onLine(), "the hold resumed where it was")
			m:place(Vector3.new(0.5, 4.2 + HEIGHT, -3.0), Vector3.yAxis, Vector3.xAxis)
			m:requestDrop()
			runUntil(r, 10, input())
			assert(m:cancelWalk() and m.silk.walk == nil, "no walk to cancel")
			runUntil(r, 120, input())
			assert(m.mode == "attached" and m.silk.mode == "none" and m.pos.Y > 4, "the walk went on after focus loss")
		end)

		-- ------------------------------------------------------------------ the catch camera
		check("catch camera: a squeezed view turns by the smallest working 15-degree step, never past 45, and the player's look wins", function()
			local cliffWorld = Instance.new("Folder")
			cliffWorld.Name = "CliffWorld"
			cliffWorld.Parent = workspace
			table.insert(folders, cliffWorld)
			part(cliffWorld, "Floor", Vector3.new(-20, -1, -20), Vector3.new(20, 0, 20), "painted_wood_dry")
			-- A roofed canyon running along Z, one stud wide: only views along it have room (a quarter turn from across it).
			part(cliffWorld, "WestWall", Vector3.new(0, 0, -10), Vector3.new(4, 7, 10), "bare_wood_rough")
			part(cliffWorld, "EastWall", Vector3.new(5, 0, -10), Vector3.new(9, 7, 10), "bare_wood_rough")
			part(cliffWorld, "Roof", Vector3.new(0, 7, -10), Vector3.new(9, 8, 10), "bare_wood_rough")
			local cparams = RaycastParams.new()
			cparams.FilterType = Enum.RaycastFilterType.Include
			cparams.FilterDescendantsInstances = { cliffWorld }
			local cover = OverlapParams.new()
			cover.FilterType = Enum.RaycastFilterType.Include
			cover.FilterDescendantsInstances = { cliffWorld }
			local onLine = true
			local spot = Vector3.new(4.5, 5, 0)
			local lip = Vector3.new(4.5, 6.9, 0)
			local function cameraAt(yaw: number): any
				local camera = Instance.new("Camera")
				camera.Parent = cliffWorld
				local c = SpiderCamera.new(camera, cparams, function()
					return { pos = spot, drawnUp = Vector3.yAxis, heading = Vector3.xAxis, onLine = onLine, rest = spot, lip = lip }
				end, function(_on: boolean) end)
				c.mouse = false
				c.yaw = yaw
				return c
			end
			-- Looking across the canyon (yaw -90): the boom is in the wall at every pitch and only a quarter turn clears it.
			local squeezed = cameraAt(math.rad(-90))
			for _ = 1, 90 do squeezed:tick(DT); squeezed:render(DT, 0, 0) end
			assert(squeezed.framing.assist == 0, "a quarter turn is beyond the 45-degree cap: nothing turns")
			assert(squeezed.boom < 2.5, `as squeezed as without framing ({squeezed.boom})`)
			-- 45 degrees off: the framing turns by the smallest working step (here exactly the cap) and holds it.
			local framed = cameraAt(math.rad(-45))
			for _ = 1, 90 do framed:tick(DT); framed:render(DT, 0, 0) end
			local turn = framed.framing.assist
			local steps = turn / math.rad(15)
			assert(turn ~= 0 and math.abs(steps - math.floor(steps + 0.5)) < 1e-6 and math.abs(turn) <= math.rad(45) + 1e-9, `turn {math.deg(turn)} is not a 15-degree step within the cap`)
			local from = spot + Vector3.yAxis * framed.pivot
			for k = 0, math.floor(math.abs(steps + 0.5)) - 1 do
				for _, side in { 1, -1 } do
					local smaller = k * math.rad(15) * side
					if math.abs(smaller) < math.abs(turn) - 1e-9 then assert(not framed:_goodView(from, framed.yaw + smaller, spot, lip), `a smaller turn {math.deg(smaller)} also worked`) end
				end
			end
			assert(framed.boom >= 2.5, `the turned view is comfortable ({framed.boom})`)
			local cf = framed.camera.CFrame
			assert(math.abs(cf.RightVector.Y) < 1e-5 and #workspace:GetPartBoundsInRadius(cf.Position, 0.05, cover) == 0, "the framed camera rolled or sits in the cliff")
			local view0 = framed:viewYaw()
			for _ = 1, 150 do framed:tick(DT); framed:render(DT, 0, 0) end
			assert(math.abs(framed:viewYaw() - view0) < 1e-6, "the turn drifted while the spider hung still")
			local yaw0 = framed.yaw
			framed:look(1, 0)
			assert(framed.framing.assist == 0 and math.abs(framed:viewYaw() - (view0 - math.rad(1))) < 1e-9, "a one-degree look did not take the turn over without a jump")
			assert(math.abs(framed.yaw - (yaw0 + turn - math.rad(1))) < 1e-9, "the turn did not become the player's yaw")
			for _ = 1, 120 do framed:tick(DT); framed:render(DT, 0, 0) end
			assert(framed.framing.assist == 0, "the framing came back while the line was out")
			-- Aiming and a recenter win over a held turn as well.
			local aimed = cameraAt(math.rad(-45))
			for _ = 1, 90 do aimed:tick(DT); aimed:render(DT, 0, 0) end
			local v1 = aimed:viewYaw()
			aimed:setAiming(true)
			assert(aimed.framing.assist == 0 and math.abs(aimed:viewYaw() - v1) < 1e-9, "aiming moved the view")
			aimed:setAiming(false)
			local recentred = cameraAt(math.rad(-45))
			for _ = 1, 90 do recentred:tick(DT); recentred:render(DT, 0, 0) end
			local v2 = recentred:viewYaw()
			recentred:startRecenter()
			assert(recentred.framing.assist == 0 and math.abs(recentred:viewYaw() - v2) < 1e-9 and recentred.recenterT == 0, "a recenter jumped")
			-- The line ends: the view stays where the framing left it.
			local ending = cameraAt(math.rad(-45))
			for _ = 1, 90 do ending:tick(DT); ending:render(DT, 0, 0) end
			local v3 = ending:viewYaw()
			onLine = false
			ending:tick(DT)
			onLine = true
			assert(ending.framing.assist == 0 and math.abs(ending:viewYaw() - v3) < 1e-9, "the view moved when the line ended")
		end)

		-- ------------------------------------------------------------------ the landing patch and the body's turns
		check("the landing patch says Reachable, Blocked, Out of reach and Can't land there, as Godot's planner", function()
			local m = newMotor()
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			local floor = sill:FindFirstChild("sill_floor")
			local reach = m:planJump(Vector3.new(-19, 0, 6), Vector3.yAxis, floor)
			assert(reach.kind == "reachable" and reach.steps > 0 and (reach.path[#reach.path] - reach.seat).Magnitude < 1e-4, `open sill: {reach.kind} {reach.reason}, endpoint error {(reach.path[#reach.path] - reach.seat).Magnitude}`)
			local far = m:planJump(Vector3.new(25, 0, 6), Vector3.yAxis, floor)
			assert(far.kind == "unreachable" and far.reason ~= "", `47 studs: {far.kind} {far.reason}`)
			local plate = part(sill, "CoatedPlate", Vector3.new(-18, 0, 2), Vector3.new(-17.8, 3, 4), "ptfe_coated")
			local coated = m:planJump(Vector3.new(-18, 1.5, 3), -Vector3.xAxis, plate)
			plate:Destroy()
			assert(coated.kind == "ineligible" and coated.reason == "ineligible_surface", `coated wall: {coated.kind} {coated.reason}`)
			local tight = m:planJump(Vector3.new(-29.9, 0, 6), Vector3.yAxis, floor)
			assert(tight.kind == "obstructed" and tight.reason == "no_room", `against the frame: {tight.kind} {tight.reason}`)
			assert(not m:commit(far) and not m:commit(tight) and m.mode == "attached", "a plan that is not reachable launched")
			m:place(Vector3.new(-29.5, HEIGHT, 6), Vector3.yAxis, -Vector3.xAxis)
			local hop = m:hopPlan()
			assert(hop.kind == "obstructed" and hop.reason == "hop_blocked", `hop into the frame: {hop.kind} {hop.reason}`)
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			local open = m:hopPlan()
			assert(open.kind == "reachable" and m:commit(open) and m.mode == "air", "a hop on the open sill")
		end)
		check("Focus, the eye view and an aim turn the body toward where the view points", function()
			local m = newMotor()
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			for _ = 1, 40 do m:tick(input({ focusPoint = Vector3.new(-22, 0.3, 12) })) end
			assert(m.heading:Dot(Vector3.zAxis) > 0.999, `Focus turned to {m.heading}`)
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			local gaze = Vector3.new(math.cos(math.rad(60)), 0, math.sin(math.rad(60)))
			for _ = 1, 60 do m:tick(input({ gaze = gaze })) end
			assert(math.deg(math.acos(math.clamp(m.heading:Dot(gaze), -1, 1))) < 4.5, "the eye view did not turn the body to the gaze")
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			for _ = 1, 20 do m:tick(input({ gaze = Vector3.new(math.cos(math.rad(20)), 0, math.sin(math.rad(20))) })) end
			assert(m.heading:Dot(Vector3.xAxis) > 0.9999, "a gaze inside 30 degrees turned the body")
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			m:setAimRay(Vector3.new(-22, 3, 2), Vector3.new(0, -0.6, 1).Unit)
			assert(m:beginPrepare(), "no preparation")
			m:aimPlan()
			local before = m.pos
			for _ = 1, 30 do m:tick(input({ wish = Vector3.xAxis })) end
			assert((m.pos - before).Magnitude < 1e-9 and m.heading:Dot(Vector3.zAxis) > 0.99, `preparing: held still and turned to the aim ({m.heading})`)
		end)

		-- ------------------------------------------------------------------ walking over an edge with the stick held
		check("holding forward carries the spider over the leaf's edge, along its underside, never back and forth", function()
			local m = newMotor()
			local cam = newCamera(m)
			m:place(Vector3.new(0.5, 4.2 + HEIGHT, -0.5), Vector3.yAxis, Vector3.zAxis)
			cam:snap()
			local carry = deps.StickCarry.new()
			local r = watch(m, cam)
			local flips, lastUp, underside = 0, m.up, false
			for _ = 1, 150 do
				local d = carry:step(0, 1, cam:mapStick(0, 1, m.up), m.transitionSerial, m.intent, false)
				step(r, input({ wish = if d.Magnitude > 1e-6 then d.Unit else Vector3.zero }))
				if m.up.Y < -0.9 then underside = true end
				if lastUp.Y < 0.5 and m.up.Y > 0.9 and not underside then flips += 1 end
				lastUp = m.up
			end
			assert(flips == 0, `turned back onto the top {flips} times`)
			assert(underside and m.mode == "attached", `never reached the underside (up {m.up})`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)

		-- ------------------------------------------------------------------ ten misses
		check("ten misses from leaves and the planter are caught and recovered by reeling, lowering or letting go", function()
			local fixtures: { { any } } = {
				{ "east leaf, front", Vector3.new(21.5, 5.4, -0.6), Vector3.zAxis, Vector3.new(21.5, 5.3, 2.9), "reel" },
				{ "east leaf, back", Vector3.new(21.5, 5.4, -5.4), -Vector3.zAxis, Vector3.new(21.5, 5.3, -8.9), "reel" },
				{ "middle leaf, front", Vector3.new(0.5, 4.2, 0.4), Vector3.zAxis, Vector3.new(0.5, 4.1, 2.9), "reel" },
				{ "middle leaf, back", Vector3.new(0.5, 4.2, -3.4), -Vector3.zAxis, Vector3.new(0.5, 4.1, -5.9), "reel" },
				{ "west leaf, front", Vector3.new(-15, 4.2, 0.4), Vector3.zAxis, Vector3.new(-15, 4.1, 2.9), "reel" },
				{ "west leaf, west side", Vector3.new(-17.4, 4.2, -1.5), -Vector3.xAxis, Vector3.new(-19.9, 4.1, -1.5), "reel" },
				{ "planter rim, front", Vector3.new(10, 4.6, 0.2), Vector3.zAxis, Vector3.new(10, 4.5, 3.2), "reel" },
				{ "middle leaf, front, then lower", Vector3.new(-3, 4.2, 0.4), Vector3.zAxis, Vector3.new(-3, 4.1, 2.9), "lower" },
				{ "east leaf, front, then lower", Vector3.new(24, 5.4, -0.6), Vector3.zAxis, Vector3.new(24, 5.3, 2.9), "lower" },
				{ "west leaf, front, then let go", Vector3.new(-13, 4.2, 0.4), Vector3.zAxis, Vector3.new(-13, 4.1, 2.9), "letgo" },
			}
			local results = {}
			local recovered = 0
			for i, f in fixtures do
				local m = newMotor()
				local withCamera = deps.cameraFixtures == "all" or (type(deps.cameraFixtures) == "table" and table.find(deps.cameraFixtures, i) ~= nil)
				local r = watch(m, if withCamera then newCamera(m) else nil)
				local name, at, heading, perch, after = f[1], f[2], f[3], f[4], f[5]
				local launched, why = miss(m, at + Vector3.new(0, HEIGHT, 0), heading, perch)
				if r.cam then r.cam:snap() end
				local outcome = "not launched: " .. why
				if launched then
					local caught = runUntil(r, 300, input(), hanging)
					local calm = caught and runUntil(r, 600, input(), settled)
					local done = false
					if caught and after == "reel" then
						done = runUntil(r, 2400, input({ reel = 1 }), attached) and has(r.events, "completed")
					elseif caught and after == "lower" then
						done = runUntil(r, 2400, input({ reel = -1 }), attached) and m.pos.Y < 0.5
					elseif caught then
						runUntil(r, 1, input())
						done = runUntil(r, 40, input({ releaseHeld = true }), function(mm) return mm.silk.mode == "none" end)
							and runUntil(r, 300, input(), attached) and m.pos.Y < 0.5
					end
					outcome = `caught {caught}, settled {calm}, {after} {done}, {r.ticks} ticks, max turn {math.floor(math.deg(r.maxTurn) + 0.5)}`
					if caught and done and #r.problems == 0 then recovered += 1 else outcome ..= " " .. table.concat(r.problems, "; ") end
				end
				table.insert(results, `{i} {name}: {outcome}`)
			end
			if deps.log then for _, line in results do deps.log(line) end end
			assert(recovered == #fixtures, `{recovered}/{#fixtures} recovered:\n` .. table.concat(results, "\n"))
		end)
	end)
 check("authored leaf tip falls after launch, catches on silk and resets safely",function()
  local world=windowsill("BreakawaySill")
  local m=newMotor(world);local leaf=world:FindFirstChild("leaf_tip")
  local b=Breakaway.new(world)
  m:place(Vector3.new(23,5.71,-3),Vector3.yAxis,Vector3.xAxis)
  local plan=m:planJump(Vector3.new(27,5.35,-3),Vector3.yAxis,leaf)
  assert(plan.kind=="reachable","dry leaf must be a valid landing before commitment: "..plan.kind)
  assert(not b:step(DT,nil,m.pos,false) and leaf.CanQuery,"aim never collapses the leaf")
  assert(m:beginPrepare() and m:commit(plan),"jump commits and anchors first")
  local outcome={kind="launched",plan=plan}
  assert(b:step(DT,outcome,m.pos,false) and not leaf.CanQuery,"committed target falls")
  local caught=false
  for _=1,400 do
   m:tick(input());b:step(DT,outcome,m.pos,false)
   caught=caught or (m:onLine() and m.silk.taut)
  end
  assert(caught,"the authored miss is caught by its dragline")
  for _=1,600 do b:step(DT,outcome,Vector3.new(27,5.35,-3),false) end
  assert(not leaf.CanQuery,"never reset inside the spider")
  for _=1,60 do b:step(DT,outcome,Vector3.zero,false) end
  assert(leaf.CanQuery and (leaf.CFrame.Position-b.home.Position).Magnitude<1e-6,"leaf returns once clear")
  assert(not b:step(DT,outcome,Vector3.zero,false),"an old launch never triggers twice")
  b:apply({left=3});assert(not leaf.CanQuery and leaf.Transparency==1,"restore keeps a fallen tip down")
  b:apply(nil);assert(leaf.CanQuery,"legacy/new life resets tip")
  assert(not Breakaway.valid({left=0/0}) and not Breakaway.valid({left=9}),"reject damaged timers")
  m:destroy()
 end)
	for _, folder in folders do folder:Destroy() end
	if not ok then error(err) end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="203">
        <Properties>
          <string name="Name">RivalSpec</string>
          <string name="Source"><![CDATA[--!strict
-- The roaming rival on the engine (ROBLOX-69). The CLI (tests/rivalnav.luau) walks the rival's own SpiderMotor over the sill's boxes on an emulated
-- box world; here the same route graph and drive run on the engine's real raycasts against a private copy of the sill: every place it patrols to
-- is a real face with room for a body, and it walks to the floor, a leaf, the planter's rim and the back wall without entering the retreat.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Layout = require(Shared.Habitat.WindowsillLayout)
local Species = require(Shared.Data.Species)
local Surfaces = require(Shared.Data.Surfaces)
local Motor = require(Shared.Movement.SpiderMotor)
local Route = require(Shared.Predator.RivalRoute)
local Drive = require(Shared.Predator.RivalDrive)
local Rival = require(Shared.Predator.RivalSpider)

local DT = 1 / 60

return function(check: (string, () -> ()) -> ())
	local world = Instance.new("Folder")
	world.Name = "RivalTestWorld"
	world.Parent = workspace
	for _, b in Layout.PIECES do
		local part = Instance.new("Part")
		part.Name = b.id
		part.Anchored = true
		part.Size = b.hi - b.lo
		part.CFrame = CFrame.new((b.hi + b.lo) * 0.5)
		part.Parent = world
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { world }
	local function newMotor(): any
		return Motor.new({ world = world, surfaces = Surfaces, profile = Species.phidippus_audax_prototype, spawn = Vector3.new(25, 0.31, 8),
			heading = Vector3.new(-1, 0, 0), boundsMin = Layout.PLAY_BOUNDS_MIN, boundsMax = Layout.PLAY_BOUNDS_MAX, probeParent = world })
	end
	local function snapshot(): any
		return { position = Vector3.new(-25, 0.31, 6), previous = Vector3.new(-25, 0.31, 6), up = Vector3.yAxis, grounded = true, heading = Vector3.xAxis,
			day = 3, hour = 12, meals = 2, resting = false, safe = false, wasp = false, gentle = false, moving = false, airborne = false,
			onLine = false, holding = false, striking = false }
	end

	check("RIVAL: every place it patrols to is a real face under a body that fits (real casts)", function()
		local drive = Drive.new(newMotor(), function() return true end)
		assert(#drive.waypoints >= 80, `only {#drive.waypoints} places to patrol to`)
		for i, w in drive.waypoints do
			local centre = w.pos + w.up * Route.SEAT
			local hit = workspace:Raycast(centre, -w.up * 0.8, params)
			assert(hit ~= nil and (hit.Position - w.pos).Magnitude < 0.05, `place {i}: no face under it`)
			assert(not Layout.inRetreat(centre), `place {i} is in the retreat`)
		end
		drive:destroy()
	end)

	check("RIVAL: it walks to the floor, a leaf, the planter's rim and the back wall on real casts and never enters the retreat", function()
		local m = newMotor()
		local d = Drive.new(m, function() return true end)
		local r = Rival.new()
		r.state = "patrol"
		m:place(Vector3.new(25, 0.31, 8), Vector3.yAxis, Vector3.new(-1, 0, 0))
		r.position, r.previous, r.up, r.heading, r.origin = m.pos, m.pos, m.up, m.heading, m.pos
		d.prevState = "patrol"
		local s = snapshot()
		local targets: { any } = {
			{ "sill_floor", function(w: any): boolean return w.pos.X < 0 and w.pos.Z < -2 end },
			{ "leaf_west", function(w: any): boolean return w.up.Y > 0.9 end },
			{ "planter_rim", function(w: any): boolean return w.up.Y > 0.9 end },
			{ "back_frame_west", function(w: any): boolean return w.up.Z > 0.9 end },
		}
		for _, t in targets do
			local goal: any = nil
			for _, w in d.waypoints do
				if Route.faces()[w.face].piece == t[1] and t[2](w) then goal = w break end
			end
			assert(goal ~= nil, `no place on {t[1]}`)
			local before = d.stats.arrivals
			d:_setGoal(goal, "patrol")
			local arrived = false
			for _ = 1, math.floor(200 / DT) do
				Drive.update(d, r, DT, s)
				assert(not Layout.inRetreat(m.pos), `entered the retreat on the way to {t[1]}`)
				if d.stats.arrivals > before then arrived = true break end
				if d.goal == nil then break end
			end
			assert(arrived, `did not reach {t[1]}`)
		end
		d:destroy()
	end)

	world:Destroy()
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="204">
        <Properties>
          <string name="Name">Runner</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Included only in tests.project.json. Press Play/Run in Studio; normal place excludes it.
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then return end
local HttpService = game:GetService("HttpService")
local evidence = require(script.Parent.BuildInfo)
workspace:SetAttribute("PortEvidence",evidence.id)
local rows = {}
local passed, failed = 0, 0
local function check(name: string, fn: () -> ())
	local ok, detail = pcall(fn)
	if ok then passed += 1 else failed += 1 end
	table.insert(rows, {name = name, passed = ok, detail = if ok then "" else tostring(detail)})
end
-- A spec may report that part of itself could not run here (for instance DataStore checks without API access): never counted as passed.
local notRun = {}
local function skip(name: string, why: string)
	table.insert(notRun, {name = name, why = why})
	print("PORT_TEST_SKIPPED " .. HttpService:JSONEncode({evidence_id = evidence.id, name = name, why = why}))
end
check("Studio spec completes", function() require(script.Parent.Spec)(check) end)
check("Silk spec completes", function() require(script.Parent.SilkSpec)(check) end)
check("Graphics spec completes", function() require(script.Parent.GraphicsSpec)(check) end)
-- Recovery scenarios and the catch camera on real raycasts and sphere casts (the same module the CLI runs on its box world).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local deps = {
	Motor = require(Shared.Movement.SpiderMotor), JumpInput = require(Shared.Movement.JumpInput), StickCarry = require(Shared.Movement.StickCarry),
	Layout = require(Shared.Habitat.WindowsillLayout), Species = require(Shared.Data.Species), Surfaces = require(Shared.Data.Surfaces),
	SpiderCamera = require(game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("Client"):WaitForChild("SpiderCamera")) :: any,
	cameraFixtures = "all", transparent = true, yield = function() task.wait() end,
	log = function(line: string) print("PORT_SCENARIO " .. line) end,
}
check("Recovery scenarios complete", function() require(script.Parent.RecoveryScenarios)(check, deps) end)
check("Perception spec completes", function() require(script.Parent.PerceptionSpec)(check) end)
check("Prey spec completes", function() require(script.Parent.PreySpec)(check) end)
check("Prompt spec completes", function() require(script.Parent.PromptSpec)(check) end)
check("Life spec completes", function() require(script.Parent.LifeSpec)(check) end)
check("Wasp spec completes", function() require(script.Parent.WaspSpec)(check) end)
check("Peacock spec completes", function() require(script.Parent.PeacockSpec)(check) end)
check("Ant mimic spec completes", function() require(script.Parent.AntMimicSpec)(check) end)
check("Rival spec completes", function() require(script.Parent.RivalSpec)(check) end)
check("Growth spec completes", function() require(script.Parent.GrowthSpec)(check) end)
check("Notebook spec completes", function() require(script.Parent.NotebookSpec)(check) end)
check("State spec completes", function() require(script.Parent.StateSpec)(check, skip) end)
check("Settings spec completes", function() require(script.Parent.SettingsSpec)(check) end)
local report = {suite = "Roblox engine", evidence_id = evidence.id, passed = passed, failed = failed,
	tests = passed + failed, not_run = #notRun, skipped = notRun, engine = version(), results = rows}
local json = HttpService:JSONEncode(report)
local output = Instance.new("StringValue")
output.Name = "PortTestReport"
output.Value = json
output.Parent = game:GetService("TestService")
print("PORT_TEST_REPORT " .. json)
-- Studio truncates long individual log messages. Keep each result independently recoverable.
for _, row in rows do print("PORT_TEST_ROW " .. HttpService:JSONEncode({evidence_id=evidence.id,result=row})) end
print("PORT_TEST_SUMMARY " .. HttpService:JSONEncode({evidence_id=evidence.id,passed=passed,failed=failed,tests=passed+failed,not_run=#notRun,engine=version()}))
if failed > 0 then warn("PORT_TEST_FAIL") end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="205">
        <Properties>
          <string name="Name">SettingsSpec</string>
          <string name="Source"><![CDATA[--!strict
-- The settings in the engine (ROBLOX-49 to ROBLOX-52): the table through Roblox's own JSON, the saved envelope that carries it, every word
-- measured with TextService at the screens and text sizes the panel supports (labels, notes, values, the controls line, the buttons), and the
-- panel built with real property names. The pure rules, the navigation, the live consumers and the layout matrix are in tests/settings.luau
-- (SETTINGS). What a player sees and does on a phone, a tablet and a controller is the Studio checklist in docs/HANDOFF-roblox-settings.md.
return function(check: (string, () -> ()) -> ())
	local HttpService = game:GetService("HttpService")
	local TextService = game:GetService("TextService")
	local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
	local SettingsSpec = require(Shared.Data.SettingsSpec)
	local SettingsModel = require(Shared.UI.SettingsModel)
	local SettingsText = require(Shared.UI.SettingsText)
	local ControlText = require(Shared.UI.ControlText)
	local SaveProgress = require(Shared.Persistence.SaveProgress)
	local SaveEnvelope = require(Shared.Persistence.SaveEnvelope)
	local HudLayout = require(Shared.UI.HudLayout)
	local NotebookText = require(Shared.UI.NotebookText)
	local SpiderChoice = require(Shared.Rig.SpiderChoice)
	local PeacockText = require(Shared.UI.PeacockText)
	local InspectText = require(Shared.UI.InspectText)
	local Client = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("Client")
	local SettingsPanel = require(Client:WaitForChild("SettingsPanel")) :: any
	local devices: { any } = { "keyboard", "gamepad", "touch" }
	local screens = { Vector2.new(568, 320), Vector2.new(667, 375), Vector2.new(844, 390), Vector2.new(360, 640), Vector2.new(390, 844), Vector2.new(768, 1024), Vector2.new(1024, 768), Vector2.new(1280, 720), Vector2.new(1920, 1080) }
	local scales = { 1.0, SettingsText.LARGE }
	local S = SettingsText.SIZES
	local function size(text: string, textSize: number, font: Enum.Font, width: number): Vector2
		return TextService:GetTextSize(text, math.round(textSize), font, Vector2.new(width, 100000))
	end

	check("settings: the table, its defaults and a full set of changes survive the engine's JSON and the saved envelope unchanged", function()
		assert(#SettingsSpec.LIST == 23, `{#SettingsSpec.LIST} settings`)
		local changed: { [string]: any } = {}
		for _, s in SettingsSpec.LIST do
			local v: any = s.default
			if s.kind == "toggle" then v = not (s.default :: boolean)
			elseif s.kind == "slider" then v = s.max
			else
				local opts: { SettingsSpec.Option } = s.options :: any
				v = opts[#opts].id
			end
			changed[s.id] = v
		end
		local round = HttpService:JSONDecode(HttpService:JSONEncode(changed))
		local problems, clean = SettingsModel.cleanAll(round)
		assert(#problems == 0, "problems after the round trip: " .. table.concat(problems, "; "))
		for id, v in changed do assert(clean[id] == v, `{id}: {clean[id]} is not {v}`) end
		local progress = SaveProgress.snapshot({ opened = { "bold_jumper" }, eye_seconds = 3 }, false, nil, changed)
		local problems2 = SaveProgress.sanitize(progress)
		assert(#problems2 == 0, "the progress was refused: " .. table.concat(problems2, "; "))
		local env = SaveEnvelope.make(SaveProgress.SPEC, progress, 3000, nil, { lock = { session = "S", beat = 3000 } })
		local back = HttpService:JSONDecode(HttpService:JSONEncode(env))
		local opened = SaveEnvelope.open(SaveProgress.SPEC, back)
		assert(opened.status == "ok", "the envelope did not open: " .. tostring(opened.status))
		local problems3, again = SettingsModel.cleanAll((opened.payload :: any).settings)
		assert(#problems3 == 0, "problems in the stored settings")
		for id, v in changed do assert(again[id] == v, `{id}: stored as {again[id]}, not {v}`) end
	end)

	check("settings: every label, note, value and button fits its place at every supported screen and both text sizes", function()
		for _, screen in screens do
			for _, scale in scales do
				local m = SettingsText.metrics(screen.X, screen.Y, scale)
				local pad = SettingsText.PAD * scale
				-- (ROBLOX-92: the two live rows are rows too: the Spider choice with its longest name, and the Inspect button)
				local rowsAll: { SettingsSpec.Setting } = table.clone(SettingsSpec.LIST)
				for _, live in SettingsSpec.LIVE do table.insert(rowsAll, live) end
				for _, s in rowsAll do
					local rl = SettingsText.rowLayout(m.bodyW, s.kind, scale)
					local label = size(s.label, S.label * scale, Enum.Font.GothamMedium, rl.labelW)
					assert(label.Y <= 5 * S.label * scale * 1.3, `{s.id} at {screen.X}x{screen.Y} x{scale}: the label is {label.Y} tall in {rl.labelW}`)
					if s.note then
						local note = size(s.note, S.note * scale, Enum.Font.GothamMedium, rl.labelW)
						assert(note.Y <= 6 * S.note * scale * 1.3, `{s.id}: the note is {note.Y} tall`)
					end
					-- the words of the value, widest first
					local words: { string } = {}
					if SettingsModel.live(s.id) then
						if s.id == "Spider" then
							for _, id in SpiderChoice.ORDER do table.insert(words, PeacockText.title(id)) end
						else
							words = { InspectText.BUTTON }
						end
					elseif s.kind == "choice" then
						local opts: { SettingsSpec.Option } = s.options :: any
						for _, o in opts do table.insert(words, o.label) end
					elseif s.kind == "toggle" then
						words = { SettingsSpec.WORDS.on, SettingsSpec.WORDS.off }
					else
						for _, v in { s.min :: any, s.max :: any, s.default :: any } do table.insert(words, SettingsModel.valueText(s.id, v)) end
					end
					local room = if s.kind == "choice" then rl.controlW - 2 * math.floor(SettingsText.MIN_TARGET * scale) - 2 * SettingsText.GAP * scale
						elseif s.kind == "toggle" then rl.controlW else math.floor(SettingsText.VALUE_WIDTH * scale)
					for _, wd in words do
						if SettingsModel.live(s.id) then
							-- (a live row's word wraps and shrinks to its button, as the panel does: SettingsText.buttonTextSize; the button is a touch target tall)
							local target = math.floor(SettingsText.MIN_TARGET * scale)
							local bw2 = if s.kind == "choice" then rl.controlW - 2 * target - 2 * SettingsText.GAP * scale else rl.controlW
							local fit = SettingsText.buttonTextSize(wd, bw2, target, S.value * scale)
							local one = size(wd, fit, Enum.Font.GothamMedium, bw2 - 10)
							assert(fit >= 10 and one.Y <= target, `{s.id}: "{wd}" is {one.Y} tall at {fit} in a button {bw2} x {target} at {screen.X}x{screen.Y} x{scale}`)
						else
							local one = size(wd, S.value * scale, Enum.Font.GothamMedium, 100000)
							assert(one.X <= room - 6, `{s.id}: "{wd}" is {one.X} wide in {room} at {screen.X}x{screen.Y} x{scale}`)
						end
					end
				end
				for _, device in devices do
					for _, pad2 in { "xbox", "playstation" } do
						ControlText.setPadStyle(pad2)
						-- (a keyboard on a phone-sized screen is not a case: the long keyboard line is for windows 700 px wide or more)
						if m.hint > 0 and (device ~= "keyboard" or screen.X >= 700) then
							local line = size(SettingsText.controls(device), S.controls * scale, Enum.Font.GothamMedium, m.bodyW)
							assert(line.Y <= m.hint, `the controls line is {line.Y} tall in {m.hint} ({device}, {pad2}, {screen.X}x{screen.Y} x{scale})`)
						end
					end
				end
				ControlText.setPadStyle("xbox")
				local bw = math.floor(math.min(260 * scale, (m.paperW - 28 - 16) / 2))
				for _, word in { SettingsSpec.WORDS.reset, SettingsSpec.WORDS.resetSure, SettingsSpec.WORDS.close } do
					-- (a button's word may wrap, and shrinks as far as it must: SettingsText.buttonTextSize, which the panel uses)
					local fit = SettingsText.buttonTextSize(word, bw, m.foot - 8, S.button * scale)
					local one = size(word, fit, Enum.Font.GothamMedium, bw - 10)
					assert(fit >= 12 and one.Y <= m.foot - 8, `"{word}" is {one.Y} tall at {fit} in a {m.foot - 8} button of {bw} (screen {screen.X}x{screen.Y} x{scale})`)
				end
				assert(pad > 0)
			end
		end
	end)

	check("settings: the Menu and Notebook buttons' words fit them at their sizes", function()
		local t = HudLayout.topLayout(1280, 720)
		local menu = size("Menu", 18, Enum.Font.GothamMedium, 1000)
		local book = size(NotebookText.BUTTON, 16, Enum.Font.GothamMedium, 1000)
		assert(menu.X <= t.menu.x1 - t.menu.x0 - 8 and menu.Y <= t.menu.y1 - t.menu.y0, `Menu is {menu}`)
		assert(book.X <= t.notebook.x1 - t.notebook.x0 - 8 and book.Y <= t.notebook.y1 - t.notebook.y0, `Notebook is {book}`)
	end)

	check("settings: the panel is built with real property names and one row per setting", function()
		local host = Instance.new("Folder")
		host.Name = "SettingsSpecHost"
		host.Parent = workspace
		local values: { [string]: any } = {}
		local closed: { string } = {}
		local io = {
			get = function(id: string): any
				if SettingsModel.live(id) then return "first_spider" end -- (the Spider row reads the client's live appearance, not a setting)
				return SettingsModel.get(function(k: string): any return values[k] end, id)
			end,
			set = function(id: string, v: any): string?
				if not SettingsModel.live(id) then values[id] = v end
				return nil
			end,
			reset = function() for _, id in SettingsModel.ids() do values[id] = SettingsModel.default(id) end end,
			status = function(): string? return "saved" end,
		}
		local panel = SettingsPanel.new(host, io, function(to: string?) table.insert(closed, to or "nil") end)
		-- Server construction checks must not bind client-only ContextActionService.
		-- Opening and actual input binding are exercised by SilkPlayback on the client.
		panel.showing, panel.returnTo = true, "game"
		panel.gui.Enabled = true
		panel:refresh()
		panel:layout()
		local rows, headers = 0, 0
		for _, w in panel.widgets do
			if w.kind == "header" then headers += 1 elseif w.kind == "setting" then rows += 1 end
		end
		assert(#SettingsSpec.LIST == 23 and #SettingsSpec.LIVE == 2 and SettingsSpec.LIVE[2].id == "Inspect" and SettingsSpec.LIVE[2].kind == "action", "two live rows: Spider and the Inspect button (ROBLOX-90)")
		assert(headers == 5 and rows == 25, `{headers} headers, {rows} rows`)
		local inspect
		for _, w in panel.widgets do
			if w.kind == "setting" and w.id == "Inspect" then inspect = w end
		end
		assert(inspect ~= nil and inspect.value.Text == "Look closely" and inspect.value.Size.Y.Offset >= SettingsText.MIN_TARGET and inspect.prev == nil and inspect.minus == nil, "the Inspect row is one button, a touch target")
		assert(panel.list.ScrollingDirection == Enum.ScrollingDirection.Y and panel.list.AutomaticCanvasSize ~= Enum.AutomaticSize.X, "the list scrolls up and down")
		assert(panel.hint.TextTruncate == Enum.TextTruncate.AtEnd, "the controls line truncates")
		local target = SettingsText.MIN_TARGET
		for _, w in panel.widgets do
			if w.kind == "setting" then
				assert(w.frame.Size.Y.Offset >= target, `{w.id}: the row is {w.frame.Size.Y.Offset} tall`)
				for _, part in { w.value, w.minus, w.plus, w.prev, w.next } do
					if part and part.Size.Y.Offset > 0 then assert(part.Size.Y.Offset >= target, `{w.id}: a control is {part.Size.Y.Offset} tall`) end
				end
			end
		end
		assert(panel.resetButton.Size.Y.Offset < 0 or panel.resetButton.Size.Y.Offset > 0, "the Reset button has a size")
		panel:_apply("SoundMuted", true)
		assert(values.SoundMuted == true, "a toggle writes through the io")
		panel:close()
		assert(#closed == 1 and closed[1] == "game" and not panel:isShowing(), "closing says where it was opened from")
		panel.gui:Destroy()
		host:Destroy()
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="206">
        <Properties>
          <string name="Name">SilkSpec</string>
          <string name="Source"><![CDATA[--!strict
return function(check)
	local Shared=game:GetService("ReplicatedStorage").Shared
	local Silk=require(Shared.Movement.SilkController)
	local world=Instance.new("Folder"); world.Name="SilkTestWorld"; world.Parent=workspace
	local function part(name,position,size,profile)
		local p=Instance.new("Part"); p.Name=name; p.Position=position; p.Size=size; p.Anchored=true
		p:SetAttribute("ProfileId",profile or "solid"); p.Parent=world; return p
	end
	part("Floor",Vector3.new(100,-0.5,0),Vector3.new(30,1,20))
	local leaf=part("Leaf",Vector3.new(100,5,0),Vector3.new(4,0.2,4))
	local wall=part("Wall",Vector3.new(106,4,0),Vector3.new(0.2,8,8))
	local surfaces={solid={attachable=true,silk_anchor_allowed=true},noSilk={attachable=true,silk_anchor_allowed=false},slippery={attachable=false,silk_anchor_allowed=true}}
	local function new() return Silk.new(world,surfaces,{max_line_length_wu=20,reel_speed_wu_s=1.5},35) end
	local function drop()
		local s=new()
		local p=Vector3.new(101.95,5.41,0)
		assert(s:startDrop(p,Vector3.yAxis,Vector3.xAxis))
		return s,Vector3.new(102.36,5.41,0),Vector3.new(0.6,0,0)
	end
	local ok,err=pcall(function()
		check("floor refuses lowering without room below",function()
			local s=new(); local plan=s:planDrop(Vector3.new(110,0.31,0),Vector3.yAxis,Vector3.zAxis)
			assert(plan==nil)
		end)
		check("raised leaf chooses nearest edge",function()
			local s=new(); local plan=s:planDrop(Vector3.new(100,5.41,1),Vector3.yAxis,Vector3.zAxis)
			assert(plan and plan.direction.Z>0.95 and math.abs(plan.distance-1)<0.12)
		end)
		check("anchor policy and moving local-space anchor",function()
			local s=new(); local p=Vector3.new(100,5.41,0)
			leaf:SetAttribute("ProfileId","noSilk")
			assert(not s:startDrop(p,Vector3.yAxis,Vector3.xAxis))
			leaf:SetAttribute("ProfileId","solid")
			assert(s:startDrop(p,Vector3.yAxis,Vector3.xAxis))
			local old=s.anchor; leaf.Position+=Vector3.new(0,1,0); s:refresh()
			local offset=s.anchor-old; leaf.Position-=Vector3.new(0,1,0)
			assert((offset-Vector3.yAxis).Magnitude<1e-5)
		end)
		check("payout never constrains a valid flight",function()
			local s=new(); local p=Vector3.new(100,5.41,0)
			local hit=workspace:Raycast(p,Vector3.new(0,-1,0),s.params)
			assert(s:anchorAt(hit,p))
			for i=1,30 do s:payout(Vector3.new(100+i/10,6,0)); assert(s.mode=="payout" and not s.taut) end
		end)
		check("miss catches within paid length and settles",function()
			local s,p,v=drop(); s.lowering=false; s:lock(p,0.25)
			local caught=false
			for _=1,180 do
				local hit; p,v,hit=s:step(p,v,0,false)
				assert(not hit,"unexpected landing")
				caught=caught or s.taut
				assert(s:path(p)<=s.rest+0.02 and v.Magnitude<15)
			end
			assert(caught and v.Magnitude<0.5)
		end)
		check("deliberate leaf drop hangs then lowers to floor",function()
			local s,p,v=drop()
			for _=1,120 do local hit; p,v,hit=s:step(p,v,0,false); assert(not hit) end
			assert(s.taut and p.Y<5)
			local landed=nil
			for _=1,480 do p,v,landed=s:step(p,v,-1,false); if landed then break end end
			assert(landed and landed.Instance.Name=="Floor")
		end)
		check("reel after leaf drop grabs the leaf",function()
			local s,p,v=drop()
			for _=1,90 do p,v=s:step(p,v,0,false) end
			local landed=nil
			for _=1,360 do p,v,landed=s:step(p,v,1,false); if landed then break end end
			assert(landed and landed.Instance==leaf,`no leaf grab: {s.block} p={p}`)
		end)
		check("wall drop lowers to floor",function()
			local s=new(); local p=Vector3.new(105.59,6,0); local v=Vector3.new(-0.6,0,0)
			assert(s:startDrop(p,-Vector3.xAxis,-Vector3.xAxis))
			local landed=nil
			for _=1,480 do p,v,landed=s:step(p,v,-1,false); if landed then break end end
			assert(landed and landed.Instance.Name=="Floor")
		end)
		check("one bend snags at a second obstruction and clears again",function()
			local s,p,v=drop()
			for _=1,120 do p,v=s:step(p,v,0,false) end
			assert(s.bend~=nil,"leaf edge should retain one bend")
			local bend=s.bend
			local obstruction=part("SecondObstacle",(bend+p)*0.5,Vector3.one*0.12,"slippery")
			s:geometry(p)
			local snagged=s.snagged
			obstruction:Destroy(); s:geometry(p)
			assert(snagged and not s.snagged,"second obstruction must snag then clear")
			s:geometry(Vector3.new(101.95,5.41,0))
			assert(s.bend==nil,"clear direct path removes bend")
		end)
		check("anchor deletion releases without invalid coordinates",function()
			local s,p,v=drop(); leaf.Parent=nil
			p,v=s:step(p,v,0,false); leaf.Parent=world
			assert(s.mode=="none" and p.X==p.X and v.X==v.X)
		end)
		check("blocked reel cannot pull through nonattachable wall",function()
			local s=new(); wall:SetAttribute("ProfileId","slippery")
			local p=Vector3.new(105.5,6,0); local v=Vector3.zero
			local hit=workspace:Raycast(p,Vector3.xAxis,s.params)
			assert(s:anchorAt(hit,p)); s:lock(p,0.25)
			-- A point behind the wall must be stopped by a body sweep.
			local moved=s:move(p,Vector3.new(2,0,0),v,1)
			wall:SetAttribute("ProfileId","solid")
			assert(moved.X<105.61)
		end)
	end)
	world:Destroy()
	if not ok then error(err) end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="207">
        <Properties>
          <string name="Name">Spec</string>
          <string name="Source"><![CDATA[--!strict
-- Real Roblox values, raycasts and BulkMoveTo. No headless shim here.
return function(check)
	local Shared = game:GetService("ReplicatedStorage").Shared
	local JumpMath = require(Shared.Movement.JumpMath)
	local Rig = require(Shared.Rig.SpiderRig)
	local Appearance = require(Shared.Data.Appearances)
	local folder = Instance.new("Folder")
	folder.Name = "PortTestWorld"
	folder.Parent = workspace
	local floor = Instance.new("Part")
	floor.Anchored = true
	floor.Size = Vector3.new(20, 1, 20)
	floor.Position = Vector3.new(100, -0.5, 0)
	floor.Parent = folder
	local rig = Rig.new(folder, folder)
	local function run()
		check("real engine jump reaches seat", function()
			local from, seat = Vector3.new(100, 0.31, 0), Vector3.new(103, 0.31, 0)
			local result = JumpMath.solve(from, seat, Vector3.yAxis, Vector3.yAxis, Vector3.new(0,-35,0), 1/60, 0.1, 1.2, 20)
			assert(#result.valid > 0)
			local solution = result.valid[1]
			local path = JumpMath.path(from, solution.velocity, Vector3.new(0,-35,0), 1/60, solution.steps)
			assert((path[#path] - seat).Magnitude < 0.001)
		end)
		check("raycast planted foot stays in world space", function()
			rig:update(CFrame.new(100, 0.31, 0), 1/60, true, false)
			local foot = rig._legs[1].foot
			assert(rig._legs[1].planted ~= nil, "must hit real floor")
			rig:update(CFrame.new(100.02, 0.31, 0), 1/60, true, true)
			assert((rig._legs[1].foot - foot).Magnitude < 0.001)
		end)
		check("appearance stays white when stage changes", function()
			local before = rig._spots[1].Color
			rig:setGrowthStage(3)
			local c = Appearance.profiles[Appearance.default].white
			for _, spot in rig._spots do
				assert(spot.Color == before, "stage recolored the markings")
				assert(math.abs(spot.Color.R-c[1]) < 1/255 and math.abs(spot.Color.G-c[2]) < 1/255 and math.abs(spot.Color.B-c[3]) < 1/255)
			end
			assert(rig.model:GetAttribute("AppearanceId") == "first_spider")
		end)
		check("all rig parts are display only and bounded", function()
			local count, fuzz = 0, 0
			for _, part in rig.model:GetChildren() do
				if part:IsA("BasePart") then
					if part.Name == "Seta" or part.Name == "FuzzShell" then fuzz += 1 else count += 1 end
					assert(part.Anchored and not part.CanCollide and not part.CanQuery and not part.CanTouch)
					assert(part.Position.X == part.Position.X)
				end
			end
			assert(count <= 200, `part budget exceeded: {count}`) -- the same ceiling as tests/look.luau's `other` (the first spider has had 193 since ROBLOX-84; this said 160)
			assert(fuzz >= 300 and fuzz <= 720, `fuzz budget: {fuzz}`)
		end)
		check("spider-eye view hides the body and keeps the front legs", function()
			rig:setEyeView(true)
			local eye = rig.model:FindFirstChild("PrincipalEye") :: BasePart
			assert(eye.LocalTransparencyModifier == 1, "head still drawn in the eye view")
			assert(rig._legs[1].tibia.LocalTransparencyModifier == 0, "front leg hidden")
			assert(rig._legs[2].femur.LocalTransparencyModifier == 1, "back leg drawn")
			rig:setEyeView(false)
			assert(eye.LocalTransparencyModifier == 0 and rig._legs[2].femur.LocalTransparencyModifier == 0)
		end)
		check("low detail keeps about a fifth of the fuzz and under 300 parts", function()
			local low = Rig.new(folder, folder, nil, "low")
			local n, total = 0, 0
			for _, part in low.model:GetChildren() do
				if part:IsA("BasePart") then total += 1 end
				if part.Name == "Seta" then n += 1 end
			end
			low:destroy()
			assert(n >= 100 and n <= 260, `low fuzz: {n}`)
			assert(total <= 300, `low parts: {total}`)
		end)
		check("big glossy eyes with catchlights, no sockets or outline in low detail", function()
			local function named(model: Instance, name: string): number
				local n = 0
				for _, part in model:GetChildren() do if part.Name == name then n += 1 end end
				return n
			end
			local low = Rig.new(folder, folder, nil, "low")
			assert(named(rig.model, "Catchlight") == 4 and named(low.model, "Catchlight") == 4, "catchlights")
			assert(named(rig.model, "EyeSocket") == 2 and named(low.model, "EyeSocket") == 0, "eye sockets")
			assert(rig.model:FindFirstChildWhichIsA("Highlight") ~= nil and low.model:FindFirstChildWhichIsA("Highlight") == nil, "outline")
			local eye = rig.model:FindFirstChild("PrincipalEye") :: BasePart
			assert(eye.Material == Enum.Material.Glass and eye.Size.X >= 0.18, "the front eyes are big and glossy")
			low:destroy()
		end)
		check("idle motion moves the drawn head and palps only, and not in low detail", function()
			local body = CFrame.new(100, 0.31, 0)
			local function pose(r: any): { Vector3 }
				local out = {}
				for _, part in r.model:GetChildren() do
					if part.Name == "PalpClub" or part.Name == "EyeFace" then table.insert(out, part.Position) end
				end
				return out
			end
			local function run(r: any, seconds: number) for _ = 1, math.floor(seconds * 60) do r:update(body, 1 / 60, true, false) end end
			local function drift(a: { Vector3 }, b: { Vector3 }): number
				local most = 0
				for i, v in a do most = math.max(most, (v - b[i]).Magnitude) end
				return most
			end
			local low = Rig.new(folder, folder, nil, "low")
			run(rig, 1); run(low, 1)
			local a, b = pose(rig), pose(low)
			run(rig, 4); run(low, 4)
			assert(drift(a, pose(rig)) > 0.004, "full detail stands still")
			assert(drift(b, pose(low)) < 1e-6, "low detail moves")
			assert((rig.root.Position - body.Position).Magnitude < 1e-6, "the root moved")
			low:destroy()
		end)
		check("air and underside poses are finite", function()
			for _, up in {Vector3.yAxis, Vector3.xAxis, -Vector3.yAxis} do
				local body = CFrame.lookAt(Vector3.new(100,2,0), Vector3.new(100,2,-1), up)
				rig:update(body,1/60,false,false)
				for _, foot in rig._legs do assert(foot.foot.Magnitude < 110) end
			end
		end)
	end
	local ok, err = pcall(run)
	rig:destroy()
	folder:Destroy()
	if not ok then error(err) end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="208">
        <Properties>
          <string name="Name">StateFixture</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED from two real checkpoints (a main rest and a Free-play rest, captured by tests/state.luau's world) as the JSON text a DataStore
-- would hand back. StateSpec decodes them with HttpService:JSONDecode and runs the server's own rest check in the engine. Regenerate with
-- the snippet in docs/HANDOFF-roblox-state.md if Checkpoint.SCHEMA_VERSION or CONTENT_REVISION changes.
return {
