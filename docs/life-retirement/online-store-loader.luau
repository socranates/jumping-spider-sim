any, count: number, soil: { min: Vector3, max: Vector3 }?, boxes: { { min: Vector3, max: Vector3 } }?): any\n\tlocal self: any = setmetatable({ kind = \"harvestman\", rng = R.new(spec.seed + 5059), now = 0, items = {}, boxes = {}, surface = spec.surface or \"soil\",\n\t\thome = spec.home, rect = spec.rect }, Harvestmen)\n\tif soil ~= nil then self.soilMin, self.soilMax, self.top = soil.min, soil.max, soil.max.Y end\n\tfor _, b in (boxes or {}) :: { any } do table.insert(self.boxes, { min = b.min, max = b.max }) end\n\tlocal normal = if self.surface == \"wall\" then -Vector3.zAxis else Vector3.yAxis\n\tfor i, s in spec.starts do\n\t\tif i > count then break end\n\t\tlocal surf = if self.surface == \"wall\" then s.pos else Vector3.new(s.pos.X, self.top, s.pos.Z)\n\t\tlocal pos = surf + normal * Harvestmen.HOVER\n\t\ttable.insert(self.items, {\n\t\t\tid = (spec.prefix or \"\") .. \"harvestman_\" .. i, kind = \"harvestman\", surface = surf, position = pos, prevPosition = pos, normal = normal, heading = s.heading,\n\t\t\tspeed = self.rng:draw(Harvestmen.WALK), state = \"away\", until_ = 0, nextTurn = self.rng:draw({ 1, 3 }), hidden = true,\n\t\t})\n\tend\n\treturn self\nend\n\n-- Whether a point of its surface is free to stand over.\nfunction Harvestmen.free(self: any, p: Vector3): boolean\n\tif self.surface == \"wall\" then\n\t\tlocal r = self.rect\n\t\treturn p.X >= r.x[1] and p.X <= r.x[2] and p.Y >= r.y[1] and p.Y <= r.y[2]\n\tend\n\tif p.X < self.soilMin.X + Harvestmen.EDGE or p.X > self.soilMax.X - Harvestmen.EDGE or p.Z < self.soilMin.Z + Harvestmen.EDGE or p.Z > self.soilMax.Z - Harvestmen.EDGE then return false end\n\tfor _, b in self.boxes do\n\t\tif p.X > b.min.X - 0.6 and p.X < b.max.X + 0.6 and p.Z > b.min.Z - 0.6 and p.Z < b.max.Z + 0.6 then return false end\n\tend\n\treturn true\nend\n\n-- The heading turned by `degrees` about the surface's normal.\nlocal function turned(self: any, h: Vector3, degrees: number): Vector3\n\tlocal n = if self.surface == \"wall\" then -Vector3.zAxis else Vector3.yAxis\n\treturn CFrame.fromAxisAngle(n, math.rad(degrees)):VectorToWorldSpace(h).Unit\nend\n\nlocal function dusk(hour: number?): boolean\n\treturn hour ~= nil and (hour >= Harvestmen.DUSK.from or hour < Harvestmen.DUSK.to)\nend\n\n-- One fixed tick. The spider is ignored. `ctx.hour`: the life clock's hour (nil: day).\nfunction Harvestmen.step(self: any, dt: number, _spider: Vector3, ctx: any)\n\tself.now += dt\n\tlocal now = self.now\n\tlocal out = dusk(if ctx ~= nil then ctx.hour else nil)\n\tfor _, h in self.items do\n\t\th.prevPosition = h.position\n\t\tif h.state == \"away\" then\n\t\t\tif out then\n\t\t\t\t-- out from its corner\n\t\t\t\th.state = \"walk\"; h.hidden = false\n\t\t\t\tlocal home = self.home\n\t\t\t\tif home ~= nil then\n\t\t\t\t\th.surface = if self.surface == \"wall\" then home else Vector3.new(home.X, self.top, home.Z)\n\t\t\t\t\th.position = h.surface + h.normal * Harvestmen.HOVER\n\t\t\t\t\th.prevPosition = h.position\n\t\t\t\tend\n\t\t\tend\n\t\t\tcontinue\n\t\tend\n\t\tif not out and self.home ~= nil then\n\t\t\t-- day: back to its corner\n\t\t\tlocal home = if self.surface == \"wall\" then self.home else Vector3.new(self.home.X, self.top, self.home.Z)\n\t\t\tlocal to = home - h.surface\n\t\t\tif to.Magnitude <= 0.3 then h.state = \"away\"; h.hidden = true; continue end\n\t\t\th.heading = to.Unit\n\t\t\th.surface += h.heading * math.min(to.Magnitude, h.speed * dt)\n\t\t\th.position = h.surface + h.normal * Harvestmen.HOVER\n\t\t\tcontinue\n\t\tend\n\t\tif h.state == \"pause\" then\n\t\t\tif now >= h.until_ then h.state = \"walk\" end\n\t\t\tcontinue\n\t\tend\n\t\tif now >= h.nextTurn then\n\t\t\th.heading = turned(self, h.heading, self.rng:draw({ -60, 60 }))\n\t\t\th.nextTurn = now + self.rng:draw({ 1, 3 })\n\t\t\tif self.rng:next() < 0.2 then h.state = \"pause\"; h.until_ = now + self.rng:draw({ 1, 5 }); continue end\n\t\tend\n\t\tlocal nextPos = h.surface + h.heading * (h.speed * dt)\n\t\tif self:free(nextPos) then\n\t\t\th.surface = nextPos\n\t\t\th.position = nextPos + h.normal * Harvestmen.HOVER\n\t\telse\n\t\t\th.heading = turned(self, h.heading, self.rng:draw({ 100, 200 }))\n\t\tend\n\tend\nend\n\n-- What a strike may hit: the body, while it is out.\nfunction Harvestmen.targets(self: any): { any }\n\tlocal out = {}\n\tfor _, h in self.items do\n\t\tif not h.hidden then table.insert(out, { creature = h, position = h.position, radius = Harvestmen.RADIUS }) end\n\tend\n\treturn out\nend\n\n-- Struck: it walks on.\nfunction Harvestmen.struck(_self: any, _h: any) end\n\nfunction Harvestmen.creatures(self: any): { any } return self.items end\n\nfunction Harvestmen.problems(self: any, lo: Vector3, hi: Vector3): { string }\n\tlocal out: { string } = {}\n\tlocal states = { away = true, walk = true, pause = true }\n\tif type(self.items) ~= \"table\" then return { \"harvestmen: no list\" } end\n\tif self.surface ~= \"soil\" and self.surface ~= \"wall\" then table.insert(out, \"harvestmen: on no known surface\") end\n\tfor i, h in self.items do\n\t\tif type(h) ~= \"table\" or not states[h.state] then table.insert(out, `harvestmen: {i} is in no known state`); continue end\n\t\tlocal p = h.position\n\t\tif (typeof(p) ~= \"Vector3\" and type(p) ~= \"table\") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then\n\t\t\ttable.insert(out, `harvestmen: {i} is outside its region`)\n\t\tend\n\tend\n\treturn out\nend\n\nreturn Harvestmen\n",6696,696747913},{"Shared/Prey/Ladybird","--!strict\n-- Ladybirds (ROBLOX-105, W3b part B): ambient beetles, not food, that walk the bed's plants among the aphids (World/Garden.plants: one on the dock, one on the\n-- dandelion at the full tier). Each walks its plant's faces from one place to the next (Prey/PlantWalk over Garden.plantPath), pauses, and now and then, when its\n-- appetite has come back, walks to a perch where an aphid sits and eats it there in plain view: it stands over the aphid for 8 to 14 s and the aphid is gone\n-- (the aphid's director tidies it away and its population owes another, as after the spider's own meal). Struck by the spider it is refused (Prey/PreyWorld,\n-- UI/PreyText) and reflex-bleeds: a drop of the fluid shows at its front leg joints for a while and it keeps still. The spider does not otherwise trouble it.\n-- Pure and seeded (a Prey/PreyRandom stream of its own from the region's ambient seed), no raycast; a checkpoint records the colony with the region's prey and\n-- puts it back where it was (Persistence/Checkpoint's `garden` root, the region's `ambient`).\n-- Sources (docs/NOTEBOOK_SOURCES.md, the ladybird page): adults and larvae eat aphids and other small soft-bodied insects; the colours are a warning; disturbed,\n-- they release a noxious fluid from the leg joints. The speeds, waits and how often it eats are the game's.\nlocal R = require(script.Parent.PreyRandom)\nlocal PlantWalk = require(script.Parent.PlantWalk)\nlocal Garden = require(script.Parent.Parent.World.Garden)\n\nlocal Ladybirds = {}\nLadybirds.__index = Ladybirds\n\nLadybirds.HOVER = 0.17 -- the body's centre above the surface it walks on\nLadybirds.LENGTH = 0.6 -- studs: a seven-spot ladybird is 5 to 8 mm long\nLadybirds.RADIUS = 0.3 -- what a strike must come within\nLadybirds.WALK = { 0.35, 0.6 } -- studs a second\nLadybirds.PAUSE = { 2, 7 }\nLadybirds.EAT = { 8, 14 } -- seconds over an aphid\nLadybirds.APPETITE = { 50, 120 } -- seconds before it goes after another aphid\nLadybirds.REACH = 0.8 -- an aphid this near when it arrives is the one it eats\nLadybirds.BLEED_S = 6 -- how long the drop shows and it keeps still, struck\n\nexport type Beetle = {\n\tid: string, kind: string, plant: string, node: string, walk: PlantWalk.Walk?, surface: Vector3, position: Vector3, prevPosition: Vector3, normal: Vector3,\n\theading: Vector3, speed: number, state: string, -- walk | pause | eat | still\n\tuntil_: number, target: string?, -- the aphid's perch it is making for\n\tprey: string?, -- the aphid it is eating\n\tnextMeal: number, bleedUntil: number, eaten: number, hidden: boolean,\n}\n\n-- `spec`: one of World/Garden.ambient's (kind \"ladybird\"); `count`: how many (the tier's); `plants`: the region's World/Garden.plants.\nfunction Ladybirds.new(spec: any, count: number, plants: { [string]: any }): any\n\tlocal self: any = setmetatable({ kind = \"ladybird\", rng = R.new(spec.seed + 2027), now = 0, beetles = {} }, Ladybirds)\n\tfor i, s in spec.starts do\n\t\tif i > count then break end\n\t\tlocal plant = plants[s.plant]\n\t\tlocal node = plant and plant.nodes[s.node]\n\t\tif node ~= nil then\n\t\t\tlocal p = if #node.route > 0 then node.route[#node.route] else plant.highway[node.hub]\n\t\t\tlocal a = self.rng:next() * math.pi * 2\n\t\t\tlocal h = Vector3.new(math.cos(a), 0, math.sin(a))\n\t\t\tlocal t = h - p.normal * h:Dot(p.normal)\n\t\t\tif t.Magnitude < 1e-3 then t = Vector3.yAxis - p.normal * p.normal.Y end\n\t\t\tif t.Magnitude < 1e-3 then t = Vector3.zAxis end\n\t\t\tlocal pos = p.pos + p.normal * Ladybirds.HOVER\n\t\t\ttable.insert(self.beetles, {\n\t\t\t\tid = (spec.prefix or \"\") .. \"ladybird_\" .. i, kind = \"ladybird\", plant = s.plant, node = s.node, walk = nil, surface = p.pos, position = pos, prevPosition = pos,\n\t\t\t\tnormal = p.normal, heading = t.Unit, speed = self.rng:draw(Ladybirds.WALK), state = \"pause\", until_ = self.rng:draw(Ladybirds.PAUSE),\n\t\t\t\ttarget = nil, prey = nil, nextMeal = self.rng:draw(Ladybirds.APPETITE), bleedUntil = -1, eaten = 0, hidden = false,\n\t\t\t})\n\t\tend\n\tend\n\treturn self\nend\n\n-- The aphid (a fly of the bed's director) with this id, or nil.\nlocal function aphidById(flies: { any }, id: string?): any\n\tif id == nil then return nil end\n\tfor _, f in flies do if f.id == id then return f end end\n\treturn nil\nend\n\n-- An aphid that can be eaten: alive, sitting (not in the jaws, not on its way between perches, not another's meal).\nlocal function edible(f: any, by: string?): boolean\n\treturn f ~= nil and (f.state == \"PERCHED\" or f.state == \"ALERT\") and f.creep == nil and (f.heldBy == nil or f.heldBy == by)\n\t\tand f.profile ~= nil and f.profile.body ~= nil and f.profile.body.prey_kind == \"aphid\"\nend\n\n-- Sets off for a node of its plant: an aphid's perch on it when its appetite is back and one sits there, else a seeded place of the plant.\nlocal function setOff(self: any, b: any, plant: any, flies: { any })\n\tlocal to: string? = nil\n\tb.target = nil\n\tif self.now >= b.nextMeal then\n\t\tfor _, f in flies do\n\t\t\tif edible(f, nil) and f.perch ~= nil and plant.nodes[f.perch.id] ~= nil and f.perch.id ~= b.node then to = f.perch.id; b.target = f.perch.id; break end\n\t\tend\n\tend\n\tif to == nil then\n\t\tlocal list = {}\n\t\tfor _, id in plant.order do if id ~= b.node then table.insert(list, id) end end\n\t\tif #list == 0 then return end\n\t\tto = list[1 + math.floor(self.rng:next() * #list) % #list]\n\tend\n\tlocal path = Garden.plantPath(plant, b.node, to :: string)\n\tif path == nil then return end\n\tb.walk = PlantWalk.new(path, b.surface, b.normal)\n\tif b.target ~= nil then (b.walk :: any).length = math.max(0, (b.walk :: any).length - 0.35) end -- (it stops just short of the aphid, facing it)\n\tb.node = to :: string\n\tb.state = \"walk\"\nend\n\n-- One fixed tick. `ctx`: { plants = the region's Garden.plants, flies = the bed's prey director's flies (the aphids among them), hour = the life clock's hour? }.\nfunction Ladybirds.step(self: any, dt: number, _spider: Vector3, ctx: any)\n\tself.now += dt\n\tlocal now = self.now\n\tlocal plants = ctx.plants or {}\n\tlocal flies = ctx.flies or {}\n\tfor _, b in self.beetles do\n\t\tb.prevPosition = b.position\n\t\tlocal plant = plants[b.plant]\n\t\tif plant == nil then continue end\n\t\tif b.state == \"still\" then\n\t\t\tif now >= b.until_ then b.state = \"pause\"; b.until_ = now + self.rng:draw(Ladybirds.PAUSE) end\n\t\telseif b.state == \"pause\" then\n\t\t\tif now >= b.until_ then setOff(self, b, plant, flies) end\n\t\telseif b.state == \"eat\" then\n\t\t\tlocal f = aphidById(flies, b.prey)\n\t\t\tif not edible(f, b.id) or (f.position - b.position).Magnitude > Ladybirds.REACH + 0.4 then\n\t\t\t\tif f ~= nil and f.heldBy == b.id then f.heldBy = nil end\n\t\t\t\tb.prey = nil; b.state = \"pause\"; b.until_ = now + self.rng:draw(Ladybirds.PAUSE)\n\t\t\telseif now >= b.until_ then\n\t\t\t\t-- the meal is over: the aphid is gone (its director tidies it away; its population owes another)\n\t\t\t\tf.heldBy = nil\n\t\t\t\tif f.perch ~= nil and f.perch.occupant == f.id then f.perch.occupant = \"\" end\n\t\t\t\tf.state = \"CONSUMED\"\n\t\t\t\tb.eaten += 1\n\t\t\t\tb.prey = nil\n\t\t\t\tb.nextMeal = now + self.rng:draw(Ladybirds.APPETITE)\n\t\t\t\tb.state = \"pause\"; b.until_ = now + self.rng:draw(Ladybirds.PAUSE)\n\t\t\tend\n\t\telseif b.state == \"walk\" and b.walk ~= nil then\n\t\t\tlocal p, n, dir, done = PlantWalk.advance(b.walk, b.speed * dt)\n\t\t\tb.surface, b.normal = p, n\n\t\t\tif dir.Magnitude > 0.5 then b.heading = dir end\n\t\t\tb.position = p + n * Ladybirds.HOVER\n\t\t\tif done then\n\t\t\t\tb.walk = nil\n\t\t\t\tlocal f: any = nil\n\t\t\t\tif b.target ~= nil then\n\t\t\t\t\tfor _, x in flies do\n\t\t\t\t\t\tif edible(x, nil) and x.perch ~= nil and x.perch.id == b.target and (x.position - b.position).Magnitude <= Ladybirds.REACH + 0.4 then f = x; break end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tb.target = nil\n\t\t\t\tif f ~= nil then\n\t\t\t\t\tf.heldBy = b.id\n\t\t\t\t\tb.prey = f.id\n\t\t\t\t\tb.state = \"eat\"; b.until_ = now + self.rng:draw(Ladybirds.EAT)\n\t\t\t\t\tlocal to = f.position - b.position\n\t\t\t\t\tlocal t = to - n * to:Dot(n)\n\t\t\t\t\tif t.Magnitude > 1e-3 then b.heading = t.Unit end\n\t\t\t\telse\n\t\t\t\t\tb.state = \"pause\"; b.until_ = now + self.rng:draw(Ladybirds.PAUSE)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- What a strike may hit: { creature, position, radius }.\nfunction Ladybirds.targets(self: any): { any }\n\tlocal out = {}\n\tfor _, b in self.beetles do table.insert(out, { creature = b, position = b.position, radius = Ladybirds.RADIUS }) end\n\treturn out\nend\n\n-- Struck by the spider: it bleeds from its leg joints and keeps still (a meal under way is left).\nfunction Ladybirds.struck(self: any, b: any)\n\tb.bleedUntil = self.now + Ladybirds.BLEED_S\n\tif b.prey ~= nil then b.prey = nil end\n\tb.walk = nil\n\tb.state = \"still\"; b.until_ = self.now + Ladybirds.BLEED_S\nend\n\n-- The drawn creatures.\nfunction Ladybirds.creatures(self: any): { any }\n\treturn self.beetles\nend\n\n-- What is wrong with a colony put back from a record.\nfunction Ladybirds.problems(self: any, lo: Vector3, hi: Vector3): { string }\n\tlocal out: { string } = {}\n\tlocal states = { walk = true, pause = true, eat = true, still = true }\n\tif type(self.beetles) ~= \"table\" then return { \"ladybirds: no list\" } end\n\tfor i, b in self.beetles do\n\t\tif type(b) ~= \"table\" or not states[b.state] then table.insert(out, `ladybirds: beetle {i} is in no known state`); continue end\n\t\tlocal p = b.position\n\t\tif (typeof(p) ~= \"Vector3\" and type(p) ~= \"table\") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then\n\t\t\ttable.insert(out, `ladybirds: beetle {i} is outside its region`)\n\t\tend\n\t\tif b.plant ~= \"dock\" and b.plant ~= \"dandelion\" and b.plant ~= \"milkweed\" then table.insert(out, `ladybirds: beetle {i} is on no plant`) end -- (ROBLOX-116: the hut garden's milkweed)\n\t\tif b.walk ~= nil then\n\t\t\tlocal why = PlantWalk.problem(b.walk)\n\t\t\tif why ~= nil then table.insert(out, `ladybirds: beetle {i}: {why}`) end\n\t\tend\n\tend\n\treturn out\nend\n\nreturn Ladybirds\n",9709,3160560615},{"Shared/Prey/Millipede","--!strict\n-- Millipedes (ROBLOX-105, W3b part B): ambient, not food. A seeded few in the bed walk the soil slowly round what stands on it, as the woodlice do (Prey/Woodlouse),\n-- and now and then go under the stones for a while (the hide spots by the stones the woodlice use). The body follows the head: the head's track is kept as a\n-- trail of points (`trail`), and Client/BugBodies lays the rings along it. When the spider comes within COIL_WU it stops and coils, head in the middle; it stays\n-- coiled until the spider has been gone a while, then uncoils and walks on. Struck, it coils at once and the strike is refused (Prey/PreyWorld, UI/PreyText).\n-- Pure and seeded, no raycast; a checkpoint records it with the region's prey (Persistence/Checkpoint's `garden` root, the region's `ambient`).\n-- Sources (docs/NOTEBOOK_SOURCES.md, the millipede page): two pairs of legs on each segment; most feed on decaying vegetation and live in soil and leaf mould and\n-- beneath stones; threatened, most roll into a coil with the legs inside, and some release foul-tasting or foul-smelling substances. Speeds and waits are the game's.\nlocal R = require(script.Parent.PreyRandom)\n\nlocal Millipedes = {}\nMillipedes.__index = Millipedes\n\nMillipedes.HOVER = 0.12 -- the rings' centres above the soil\nMillipedes.RINGS = 12 -- body rings drawn behind the head\nMillipedes.SPACING = 0.19 -- studs from ring to ring: a body about 2.4 cm long\nMillipedes.RADIUS = 0.3\nMillipedes.WALK = { 0.15, 0.28 } -- studs a second\nMillipedes.COIL_WU = 2.5 -- the spider this near makes it coil\nMillipedes.CALM_WU = 5.0 -- it uncoils once the spider is this far, and has been for CALM_S\nMillipedes.CALM_S = { 6, 12 }\nMillipedes.COIL_S = 1.0 -- seconds to coil\nMillipedes.UNCOIL_S = 2.5\nMillipedes.UNDER_EVERY = { 60, 140 } -- how often it goes under a stone\nMillipedes.UNDER_S = { 20, 45 } -- and how long it stays\nMillipedes.EDGE = 1.0\nMillipedes.TURN = 90 -- degrees a second it turns at, walking on: it steers round in an arc, never folds back on itself\nMillipedes.AHEAD = 0.8 -- how far ahead it feels for what stands in its way\n\n-- `spec`: one of World/Garden.ambient's (kind \"millipede\"); `count`: the tier's; `soil` the soil's top box; `boxes` the standing boxes' footprints.\nfunction Millipedes.new(spec: any, count: number, soil: { min: Vector3, max: Vector3 }, boxes: { { min: Vector3, max: Vector3 } }): any\n\tlocal self: any = setmetatable({ kind = \"millipede\", rng = R.new(spec.seed + 3041), now = 0, hides = {}, boxes = {}, items = {},\n\t\tsoilMin = soil.min, soilMax = soil.max, top = soil.max.Y }, Millipedes)\n\tfor _, h in spec.hides or {} do table.insert(self.hides, { pos = h.pos, kind = h.kind }) end\n\tfor _, b in boxes do table.insert(self.boxes, { min = b.min, max = b.max }) end\n\tfor i, s in spec.starts do\n\t\tif i > count then break end\n\t\tlocal pos = Vector3.new(s.pos.X, self.top + Millipedes.HOVER, s.pos.Z)\n\t\tlocal trail = {}\n\t\tfor k = 1, Millipedes.RINGS do table.insert(trail, pos - s.heading * (k * Millipedes.SPACING)) end\n\t\ttable.insert(self.items, {\n\t\t\tid = (spec.prefix or \"\") .. \"millipede_\" .. i, kind = \"millipede\", position = pos, prevPosition = pos, heading = s.heading, normal = Vector3.yAxis,\n\t\t\tspeed = self.rng:draw(Millipedes.WALK), state = \"walk\", coil = 0, until_ = 0, nextTurn = self.rng:draw({ 2, 5 }),\n\t\t\tnextUnder = self.rng:draw(Millipedes.UNDER_EVERY), hide = 0, trail = trail, hidden = false, turn = 0,\n\t\t})\n\tend\n\treturn self\nend\n\n-- Whether a point on the soil is free to stand on (inside the soil's edge, in no standing box's footprint grown by `margin`).\nfunction Millipedes.free(self: any, p: Vector3, margin: number): boolean\n\tif p.X < self.soilMin.X + Millipedes.EDGE or p.X > self.soilMax.X - Millipedes.EDGE or p.Z < self.soilMin.Z + Millipedes.EDGE or p.Z > self.soilMax.Z - Millipedes.EDGE then return false end\n\tfor _, b in self.boxes do\n\t\tif p.X > b.min.X - margin and p.X < b.max.X + margin and p.Z > b.min.Z - margin and p.Z < b.max.Z + margin then return false end\n\tend\n\treturn true\nend\n\nlocal function flat(v: Vector3): Vector3 return Vector3.new(v.X, 0, v.Z) end\nlocal function turned(heading: Vector3, degrees: number): Vector3\n\tlocal a = math.atan2(heading.Z, heading.X) + math.rad(degrees)\n\treturn Vector3.new(math.cos(a), 0, math.sin(a))\nend\n\n-- The head moved: drop a trail point once it is a ring's spacing from the last.\nlocal function track(m: any)\n\tlocal last = m.trail[1]\n\tif last == nil or (m.position - last).Magnitude >= Millipedes.SPACING then\n\t\ttable.insert(m.trail, 1, m.position)\n\t\twhile #m.trail > Millipedes.RINGS + 1 do table.remove(m.trail) end\n\tend\nend\n\n-- One fixed tick. `spider`: where the spider is.\nfunction Millipedes.step(self: any, dt: number, spider: Vector3, _ctx: any)\n\tself.now += dt\n\tlocal now = self.now\n\tfor _, m in self.items do\n\t\tm.prevPosition = m.position\n\t\tlocal d = (flat(spider) - flat(m.position)).Magnitude\n\t\tlocal near = d <= Millipedes.COIL_WU and math.abs(spider.Y - m.position.Y) < 4\n\t\tif near and (m.state == \"walk\" or m.state == \"pause\" or m.state == \"going\") then m.state = \"coiled\"; m.until_ = math.huge end\n\t\tif m.state == \"coiled\" then\n\t\t\tm.coil = math.min(1, m.coil + dt / Millipedes.COIL_S)\n\t\t\tif d >= Millipedes.CALM_WU then\n\t\t\t\tif m.until_ == math.huge then m.until_ = now + self.rng:draw(Millipedes.CALM_S) end\n\t\t\t\tif now >= m.until_ then m.state = \"walk\"; m.nextTurn = now + self.rng:draw({ 2, 5 }) end\n\t\t\telse\n\t\t\t\tm.until_ = math.huge\n\t\t\tend\n\t\telseif m.coil > 0 then\n\t\t\tm.coil = math.max(0, m.coil - dt / Millipedes.UNCOIL_S) -- (uncoiling: it does not walk until it is straight)\n\t\telseif m.state == \"under\" then\n\t\t\tif now >= m.until_ then m.state = \"walk\"; m.hidden = false; m.heading = turned(m.heading, self.rng:draw({ 120, 240 })); m.nextUnder = now + self.rng:draw(Millipedes.UNDER_EVERY) end\n\t\telseif m.state == \"going\" then\n\t\t\tlocal goal = self.hides[m.hide].pos\n\t\t\tlocal to = flat(goal) - flat(m.position)\n\t\t\tif to.Magnitude <= 0.25 then\n\t\t\t\tm.state = \"under\"; m.hidden = true; m.until_ = now + self.rng:draw(Millipedes.UNDER_S)\n\t\t\telse\n\t\t\t\tm.heading = to.Unit\n\t\t\t\tm.position += m.heading * math.min(to.Magnitude, m.speed * dt)\n\t\t\t\ttrack(m)\n\t\t\tend\n\t\telseif m.state == \"pause\" then\n\t\t\tif now >= m.until_ then m.state = \"walk\"; m.nextTurn = now + self.rng:draw({ 2, 5 }) end\n\t\telseif m.state == \"walk\" then\n\t\t\tif now >= m.nextUnder and #self.hides > 0 then\n\t\t\t\tlocal best, bestD = 0, math.huge\n\t\t\t\tfor i, h in self.hides do\n\t\t\t\t\tlocal dd = (flat(h.pos) - flat(m.position)).Magnitude\n\t\t\t\t\tif dd < bestD then best, bestD = i, dd end\n\t\t\t\tend\n\t\t\t\tm.hide = best\n\t\t\t\tm.state = \"going\"\n\t\t\telse\n\t\t\t\tlocal paused = false\n\t\t\t\tif now >= m.nextTurn then\n\t\t\t\t\tm.turn = self.rng:draw({ -40, 40 })\n\t\t\t\t\tm.nextTurn = now + self.rng:draw({ 2, 5 })\n\t\t\t\t\tif self.rng:next() < 0.2 then m.state = \"pause\"; m.until_ = now + self.rng:draw({ 2, 6 }); paused = true end\n\t\t\t\tend\n\t\t\t\tif not paused then\n\t\t\t\t\t-- something ahead: steer away in an arc (the turn is drawn once, then taken a little each tick)\n\t\t\t\t\tif math.abs(m.turn or 0) < 1 and not self:free(m.position + m.heading * Millipedes.AHEAD, 0.3) then\n\t\t\t\t\t\tm.turn = (if self.rng:next() < 0.5 then -1 else 1) * self.rng:draw({ 90, 180 })\n\t\t\t\t\tend\n\t\t\t\t\tlocal turn = m.turn or 0\n\t\t\t\t\tif math.abs(turn) > 1e-6 then\n\t\t\t\t\t\tlocal by = math.clamp(turn, -Millipedes.TURN * dt, Millipedes.TURN * dt)\n\t\t\t\t\t\tm.heading = turned(m.heading, by)\n\t\t\t\t\t\tm.turn = turn - by\n\t\t\t\t\tend\n\t\t\t\t\tlocal nextPos = m.position + m.heading * (m.speed * dt)\n\t\t\t\t\tif self:free(nextPos, 0.3) then\n\t\t\t\t\t\tm.position = nextPos\n\t\t\t\t\t\ttrack(m)\n\t\t\t\t\telseif math.abs(m.turn or 0) < 1 then\n\t\t\t\t\t\tm.turn = (if self.rng:next() < 0.5 then -1 else 1) * self.rng:draw({ 90, 180 })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- What a strike may hit: the head and the body's middle.\nfunction Millipedes.targets(self: any): { any }\n\tlocal out = {}\n\tfor _, m in self.items do\n\t\tif not m.hidden then\n\t\t\ttable.insert(out, { creature = m, position = m.position, radius = Millipedes.RADIUS })\n\t\t\tlocal mid = m.trail[math.max(1, math.floor(#m.trail / 2))]\n\t\t\tif mid ~= nil and m.coil < 0.5 then table.insert(out, { creature = m, position = mid, radius = Millipedes.RADIUS }) end\n\t\tend\n\tend\n\treturn out\nend\n\n-- Struck by the spider: it coils at once.\nfunction Millipedes.struck(self: any, m: any)\n\tm.state = \"coiled\"\n\tm.until_ = math.huge\n\tm.coil = math.max(m.coil, 0.5)\nend\n\nfunction Millipedes.creatures(self: any): { any } return self.items end\n\nfunction Millipedes.problems(self: any, lo: Vector3, hi: Vector3): { string }\n\tlocal out: { string } = {}\n\tlocal states = { walk = true, pause = true, coiled = true, going = true, under = true }\n\tif type(self.items) ~= \"table\" then return { \"millipedes: no list\" } end\n\tfor i, m in self.items do\n\t\tif type(m) ~= \"table\" or not states[m.state] then table.insert(out, `millipedes: {i} is in no known state`); continue end\n\t\tlocal p = m.position\n\t\tif (typeof(p) ~= \"Vector3\" and type(p) ~= \"table\") or p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or p.X < lo.X or p.X > hi.X or p.Y < lo.Y or p.Y > hi.Y or p.Z < lo.Z or p.Z > hi.Z then\n\t\t\ttable.insert(out, `millipedes: {i} is outside its region`)\n\t\tend\n\t\tif type(m.trail) ~= \"table\" or #m.trail > Millipedes.RINGS + 1 then table.insert(out, `millipedes: {i} has no body trail`) end\n\t\tif type(m.coil) ~= \"number\" or m.coil < 0 or m.coil > 1 then table.insert(out, `millipedes: {i} is coiled beyond belief`) end\n\t\tif (m.state == \"going\" or m.state == \"under\") and (type(self.hides) ~= \"table\" or self.hides[m.hide] == nil) then table.insert(out, `millipedes: {i} hides in no known spot`) end\n\tend\n\treturn out\nend\n\nreturn Millipedes\n",9598,2912814649},{"Shared/Prey/PerchGraph","--!strict\n-- Geometry adapter for the frozen PerchGraph. Every planned leg and every flight tick is swept.\nlocal M=require(script.Parent.PreyMath)\nlocal G={};G.__index=G\nexport type Perch={id:string,position:Vector3,normal:Vector3,shelter:number,food:number,start:boolean,valid:boolean,occupant:string,reserved:string}\nfunction G.new(cast: any,sweep: any,overlap: any,profile: any): any\n return setmetatable({cast=cast,sweep=sweep,overlap=overlap,p=profile,perches={},plans=0,sweeps=0},G)\nend\nfunction G.rest(self: any,p: Perch): Vector3 return p.position+p.normal*self.p.body.hover_wu end\nfunction G.clear(self: any,a: Vector3,b: Vector3): boolean\n self.sweeps+=1\n return not self.overlap(a,self.p.flight.clearance_radius_wu) and not self.sweep(a,b,self.p.flight.clearance_radius_wu)\nend\nfunction G.add(self: any,id: string,position: Vector3,normal: Vector3,shelter: number,food: number,start: boolean): Perch\n local p: Perch={id=id,position=position,normal=normal,shelter=shelter,food=food,start=start,valid=false,occupant='',reserved=''}\n local hit=self.cast(position+normal*.5,position-normal*.5)\n if hit and math.abs((hit.Position-position):Dot(normal))<=.06 and hit.Normal:Dot(normal)>=math.cos(math.rad(12)) then\n  p.position=hit.Position;p.valid=self:clear(self:rest(p),self:rest(p)+normal*self.p.flight.lift_wu)\n end\n table.insert(self.perches,p);return p\nend\nfunction G.plan(self: any,start: Vector3,normal: Vector3,target: Perch,threat: Vector3?): {Vector3}?\n self.plans+=1;local p=self.p.flight\n -- (ROBLOX-119) the band its routes climb in: the sill's 0 to 11 studs unless the graph is told its own (`floor`, `ceiling`: PreyDirector.new from a spec that\n -- names them, World/Meadow's and World/Hut's flowers and lamps, far over and under the sill); the sill's routes are as they were\n local floor,ceil=self.floor or 0,self.ceiling or 11\n local rest=self:rest(target);if (start-rest).Magnitude>p.max_flight_wu then return nil end\n local lifted=start+normal*p.lift_wu;local approach=rest+target.normal*p.approach_wu\n if not self:clear(start,lifted) or not self:clear(approach,rest) then return nil end\n local routes: {{Vector3}}={{lifted,approach}};local mid=(lifted+approach)*.5\n for _,h in {2.5,5,8,11} do local y=math.min(mid.Y+h,ceil)\n  if y>mid.Y+.5 then table.insert(routes,{lifted,Vector3.new(mid.X,y,mid.Z),approach}) end\n end\n for _,h in {6,9,11} do local y=math.min(math.max(floor+h,math.max(lifted.Y,approach.Y)+.5),ceil)\n  if y>math.max(lifted.Y,approach.Y)+.3 then table.insert(routes,{lifted,Vector3.new(lifted.X,y,lifted.Z),Vector3.new(approach.X,y,approach.Z),approach}) end\n end\n for _,route in routes do\n  local clear=true\n  for i=2,#route do if not self:clear(route[i-1],route[i]) then clear=false;break end end\n  if clear then\n   local pts={start};for _,v in route do table.insert(pts,v) end;table.insert(pts,rest)\n   if (not threat or M.distanceToPath(pts,threat)>=p.path_threat_clearance_wu) and M.pathLength(pts)<=p.max_flight_wu*1.6 then return pts end\n  end\n end\n return nil\nend\nreturn G\n",3025,2763664658},{"Shared/Prey/PlantWalk","--!strict\n-- A walk along a list of points on surfaces (ROBLOX-105, W3b part B): the aphid's creep from one of its perches to another and the ladybird's rounds over a\n-- plant (World/Garden.plantPath), and the snail's crawl over the soil and up the wall's foot. A walk is plain data (the points, their surfaces' normals, how far\n-- along it is), so a rest records it and puts it back where it was. Pure: no engine, no random draw.\nlocal PlantWalk = {}\n\nexport type Walk = { points: { Vector3 }, normals: { Vector3 }, lengths: { number }, length: number, s: number }\n\n-- A walk over `path` ({ pos, normal } each), from `from` (a place on the first point's surface) when given.\nfunction PlantWalk.new(path: { any }, from: Vector3?, fromNormal: Vector3?): Walk\n\tlocal points, normals = {}, {}\n\tif from ~= nil and (path[1] == nil or (path[1].pos - from).Magnitude > 1e-4) then\n\t\ttable.insert(points, from)\n\t\ttable.insert(normals, fromNormal or (if path[1] ~= nil then path[1].normal else Vector3.yAxis))\n\tend\n\tfor _, p in path do\n\t\tif #points == 0 or (points[#points] - p.pos).Magnitude > 1e-6 then\n\t\t\ttable.insert(points, p.pos)\n\t\t\ttable.insert(normals, p.normal)\n\t\tend\n\tend\n\tlocal lengths, total = {}, 0\n\tfor i = 2, #points do\n\t\tlocal d = (points[i] - points[i - 1]).Magnitude\n\t\ttable.insert(lengths, d)\n\t\ttotal += d\n\tend\n\treturn { points = points, normals = normals, lengths = lengths, length = total, s = 0 }\nend\n\n-- Where the walk is at distance `s` along it: the point on the surface, the surface's normal there (turning from one face's to the next's along each leg) and\n-- the direction of travel.\nfunction PlantWalk.at(w: Walk, s: number): (Vector3, Vector3, Vector3)\n\tlocal pts, nrm = w.points, w.normals\n\tif #pts == 1 then return pts[1], nrm[1], Vector3.zero end\n\tlocal left = math.clamp(s, 0, w.length)\n\tfor i, d in w.lengths do\n\t\tif left <= d or i == #w.lengths then\n\t\t\tlocal t = if d > 1e-9 then math.clamp(left / d, 0, 1) else 1\n\t\t\tlocal n = nrm[i]:Lerp(nrm[i + 1], t)\n\t\t\tif n.Magnitude < 1e-6 then n = nrm[i + 1] end\n\t\t\tlocal dir = if d > 1e-9 then (pts[i + 1] - pts[i]) / d else Vector3.zero\n\t\t\treturn pts[i]:Lerp(pts[i + 1], t), n.Unit, dir\n\t\tend\n\t\tleft -= d\n\tend\n\treturn pts[#pts], nrm[#nrm], Vector3.zero\nend\n\n-- Moves the walk on by `distance`; returns the place, the normal, the direction (laid on the surface) and whether it has arrived.\nfunction PlantWalk.advance(w: Walk, distance: number): (Vector3, Vector3, Vector3, boolean)\n\tw.s = math.min(w.length, w.s + math.max(0, distance))\n\tlocal p, n, dir = PlantWalk.at(w, w.s)\n\tlocal flat = dir - n * dir:Dot(n)\n\treturn p, n, (if flat.Magnitude > 1e-6 then flat.Unit else Vector3.zero), w.s >= w.length - 1e-9\nend\n\n-- What is wrong with a walk put back from a record (nil for a good one).\nfunction PlantWalk.problem(w: any): string?\n\tif type(w) ~= \"table\" or type(w.points) ~= \"table\" or type(w.normals) ~= \"table\" or type(w.lengths) ~= \"table\" then return \"a walk with no points\" end\n\tif #w.points < 1 or #w.normals ~= #w.points or #w.lengths ~= #w.points - 1 then return \"a walk whose points do not match\" end\n\tif type(w.s) ~= \"number\" or w.s ~= w.s or type(w.length) ~= \"number\" or w.s < 0 or w.s > w.length + 1e-6 then return \"a walk out of its length\" end\n\treturn nil\nend\n\nreturn PlantWalk\n",3261,156707665},{"Shared/Prey/PreyDirector","--!strict\n-- Solo client world of perceivable flies. Godot order: sensor, prey, motor, capture/feeding.\n-- ROBLOX-96 (W3, garden life): a director is one region's prey. Without a `spec` it is the sill's, exactly as it always was: the twelve authored perches below, the\n-- two window vents, a house fly with every third fly a fruit fly when `mixed`. With a `spec` (World/Garden.prey, for the bed) its perches and vents are the\n-- spec's: a perch marked `walker` is a plant perch that only a walker (the aphid, Species body.walker) is spawned on, and never needs a flight to be valid; a\n-- vent marked `walker` is where an aphid appears, on a free walker perch within the vent's reach, out of the spider's sight (the population's own check), with\n-- no flight. Several directors share one Feeding (the jaws): Prey/PreyWorld runs the home director's `after` with the feeding step and every other active\n-- director's `afterShared`, which strikes and tidies but never advances the reserves; a fly that tears free is sent back to the director it belongs to.\n-- ROBLOX-101 (W3b part A): a director per bestiary kind (World/Garden.bestiary: the springtails and leafhoppers of the bed, the moths and crane flies of the wall\n-- and the outer sill), each with its kind's profile. A perch marked `hop` is one a hopper uses (it needs no flight to be valid); `behind` and `round` are the\n-- leafhopper's far-side perch and the point it passes going round (Prey/PreyKinds.sidestep). A vent marked `appear` is where a prey of the director's own kind\n-- appears on any free perch within the vent's reach, out of the spider's sight, with no flight (the walker vents' rule without the aphid). A hopper torn free\n-- hops off if it can; a flightless one that cannot is put back as a walker is.\nlocal Fly=require(script.Parent.Fly)\nlocal Species=require(script.Parent.Parent.Data.Species)\nlocal Graph=require(script.Parent.PerchGraph)\nlocal Population=require(script.Parent.PreyPopulation)\nlocal Feeding=require(script.Parent.Feeding)\nlocal M=require(script.Parent.PreyMath)\nlocal D={};D.__index=D\nlocal POINTS: {{string | number}}={\n {'sill_first_hunt',-13,0,6},{'rim_hunt',10,4.6,-3},{'leaf_hunt',-1,4.2,-1},{'east_hunt',23,0,7},\n {'west_leaf',-15,4.2,-1},{'east_leaf',22,5.4,-2},{'under_leaf',-12.8,0,-2},{'front_path',1,0,8},\n {'east_corner',27,0,-7},{'back_path',-9,0,-9},{'rim_west',5,4.6,-5},{'rim_east',15,4.6,-5},\n}\n-- A region's prey, authored or generated (World/Garden.prey): `perches` { id, position, normal, shelter, food, start, walker? }, `vents` { id, position, normal,\n-- walker?, reach? }, `prefix` (the flies' ids begin with it; the sill's is 'fly_').\nexport type Spec={perches:{any},vents:{any},prefix:string?}\nfunction D.new(graph: any,profile: any,seed: number,target: number,mixed: boolean?,spec: Spec?): any\n local self:any=setmetatable({graph=graph,p=profile,mixed=mixed==true,seed=seed,target=target,flies={},serial=0,now=0,tick=0,\n  population=Population.new(profile.population,seed+117,target),feeding=Feeding.new(),vents={},strikeEnd=-1,previousMode='attached',\n  captures=0,enabled=true,cpu={},candidates=0,entryChecks=0},D)\n if spec then\n  self.prefix=spec.prefix or 'fly_' -- (a region's flies carry its name, so no two flies of the world share an id)\n  -- (ROBLOX-119: a spec may name the band its flights climb in, `floor` and `ceiling`, PerchGraph.plan; World/Meadow's and the hut's moths and hoverflies do)\n  local band=spec::any\n  if type(band.floor)==\"number\" and type(band.ceiling)==\"number\" then graph.floor=band.floor;graph.ceiling=band.ceiling end\n  for _,row in spec.perches do\n   local p=graph:add(row.id,row.position,row.normal,row.shelter,row.food,row.start==true)\n   if row.walker then p.walker=true end\n   if row.hop then p.hop=true end -- (ROBLOX-101)\n   if row.behind then p.behind=row.behind;p.round=row.round end\n  end\n else\n  for i,row in POINTS do\n   local id=row[1]::string\n   graph:add(id,Vector3.new(row[2]::number,row[3]::number,row[4]::number),Vector3.yAxis,if id=='under_leaf' then .5 else .2,if string.find(id,'rim') then .5 else .1,i<=6)\n  end\n end\n -- Keep only perches with a valid outgoing flight (a walker's perch needs none: nothing flies from it).\n for _,p in graph.perches do\n  if p.valid and not p.walker and not p.hop then\n   local linked=false;local tries=0\n   for _,other in graph.perches do if other~=p and other.valid and (other.position-p.position).Magnitude<=profile.flight.max_flight_wu then\n    tries+=1;if graph:plan(graph:rest(p),p.normal,other,nil) then linked=true;break end\n    if tries>=5 then break end\n   end end\n   p.valid=linked\n  end\n end\n for _,p in graph.perches do if #self.flies<target and p.start and p.valid then self:spawn(p) end end\n if spec then\n  for _,v in spec.vents do\n   table.insert(self.vents,{id=v.id,position=v.position,normal=v.normal,shelter=0,food=0,start=false,valid=true,occupant='',reserved='',walker=v.walker==true,reach=v.reach or 4,appear=if v.appear then true else nil})\n  end\n else\n  for i,x in {-23,23} do\n   -- Authored window vents face into the sill. Entry paths are still swept before a fly exists.\n   table.insert(self.vents,{id='vent_'..i,position=Vector3.new(x,8,-12.5),normal=Vector3.zAxis,shelter=0,food=0,start=false,valid=true,occupant='',reserved=''})\n  end\n end\n return self\nend\nfunction D.spawn(self: any,perch: any): any\n self.serial+=1\n local profile = if perch.walker then Species.aphid_prototype elseif self.mixed~=false and self.serial%3==0 then Species.fruit_fly_prototype else self.p\n local f=Fly.new((self.prefix or 'fly_')..self.serial,self.serial,self.seed+self.serial*997,perch,self.graph,profile,self.now)\n table.insert(self.flies,f);return f\nend\nfunction D.percepts(self: any): {any}\n local out={};for _,f in self.flies do local p=f:percept();if p then table.insert(out,p) end end;return out\nend\n-- Whether this director's list holds the fly.\nfunction D.owns(self: any,f: any): boolean\n return table.find(self.flies,f)~=nil\nend\nfunction D.before(self: any,dt: number,position: Vector3,observer: any,sensor: any,cast: any,camera: any)\n if not self.enabled then return end\n local started=os.clock();self.now+=dt;self.tick+=1;self.previousPosition=position\n local alive=0;for _,f in self.flies do if f:alive() then alive+=1 end end\n self.population:step(self.now,alive,self.vents,function(v)\n  self.entryChecks+=1\n  local pos=self.graph:rest(v)\n  if (position-pos).Magnitude<self.p.population.vent_min_distance_wu then return false end\n  if M.inView(camera.CFrame,camera.FieldOfView,camera.ViewportSize.X/math.max(1,camera.ViewportSize.Y),pos,self.p.population.vent_view_margin_deg) then return false end\n  return not sensor:couldSense(observer,pos,self.p.body.radius_wu,cast)\n end,function(v)\n  if v.walker then\n   -- (ROBLOX-96) a walker is born on a free plant perch within the vent's reach: no flight, out of sight\n   for _,target in self.graph.perches do\n    if target.walker and target.valid and target.occupant=='' and target.reserved=='' and (target.position-v.position).Magnitude<=v.reach then\n     self:spawn(target);return true\n    end\n   end\n   return false\n  end\n  if v.appear then\n   -- (ROBLOX-101) a prey of the director's kind appears on any free perch within the vent's reach: no flight, out of sight\n   for _,target in self.graph.perches do\n    if target.valid and target.occupant=='' and target.reserved=='' and (target.position-v.position).Magnitude<=v.reach then\n     self:spawn(target);return true\n    end\n   end\n   return false\n  end\n  for _,target in self.graph.perches do\n   if target.valid and target.occupant=='' and target.reserved=='' then\n    local path=self.graph:plan(self.graph:rest(v),v.normal,target,nil)\n    if path and M.pathLength(path)>=self.p.population.entry_min_flight_wu then\n     local f=self:spawn(v);f.flight:begin(path,target,'move',self.now);return true\n    end\n   end\n  end\n  return false\n end)\n for _,f in self.flies do f:step(dt,self.now,position,.3,cast) end\n self.beforeCost=(os.clock()-started)*1e6\nend\nfunction D.escape(self: any,f: any)\n if f.profile.body.flightless then\n  -- (ROBLOX-101) a flightless hopper torn free flicks away if it can, and otherwise is put back as a walker is (below)\n  f.state='ALERT';f.stateSince=self.now;f.senses.awareness=f.profile.senses.awareness_max\n  f.senses.hasLastSeen=true;f.senses.lastSeenPosition=self.previousPosition;f.senses.lastSeenTime=self.now\n  if f:launch('flee',self.now) then return end\n end\n if f.profile.body.walker or f.profile.body.flightless then\n  -- (ROBLOX-96) a walker that tears free is back on its perch if the perch is still free; if not, it is gone (the population owes another)\n  local perch=f.perch;f.creep=nil;f.heldBy=nil -- (ROBLOX-105: a creep or a ladybird's meal does not survive the jaws)\n  if perch and perch.occupant=='' then\n   perch.occupant=f.id;f.position=self.graph:rest(perch);f.prevPosition=f.position;f.normal=perch.normal;f.velocity=Vector3.zero\n   f.state='ALERT';f.stateSince=self.now;f.goal='rest';f.goalSince=self.now;f:beginStay(self.now)\n  else\n   f.state='CONSUMED'\n  end\n  return\n end\n f.state='SEEK_PERCH';f.stateSince=self.now;f.senses.awareness=f.profile.senses.awareness_max\n f.senses.hasLastSeen=true;f.senses.lastSeenPosition=self.previousPosition;f.senses.lastSeenTime=self.now\n f:launch('flee',self.now)\nend\n-- The strike: a sweep of the spider's body against every living fly while a strike window is open, and a capture into the jaws. Returns the time it took.\nfunction D.strike(self: any,motor: any,sensor: any,cast: any)\n if motor.mode=='air' and self.previousMode~='air' then\n  for _,event in motor.events do if event.kind=='launched' then self.strikeEnd=self.tick+240;break end end\n end\n if self.previousMode=='air' and motor.mode~='air' then self.strikeEnd=math.min(self.strikeEnd,self.tick+3) end\n self.previousMode=motor.mode\n if self.tick<=self.strikeEnd and not self.feeding.held then\n  for _,f in self.flies do if f:alive() and not (f.freeUntil and f.freeUntil>self.now) then -- (ROBLOX-101: freeUntil, a prey that just slipped the jaws)\n   local t,d=M.sweepClosest(self.previousPosition,motor.pos,f.prevPosition,f.position)\n   if d<=f.profile.body.capture_radius_wu+.3 then\n    local a=self.previousPosition:Lerp(motor.pos,t);local b=f.prevPosition:Lerp(f.position,t)\n    if not cast(a,b) then\n     f.flight:release();if f.perch and f.perch.occupant==f.id then f.perch.occupant='' end\n     if f.hop then if f.hop.target and f.hop.target.reserved==f.id then f.hop.target.reserved='' end;f.hop=nil end;f.side=nil -- (ROBLOX-101: caught mid-hop or mid-sidestep)\n     f.state='CAPTURED';f.captureSerial+=1;f.captureKey=f.id..':'..f.captureSerial;f.velocity=Vector3.zero\n     sensor:onCapture(b,f.profile.body.radius_wu);self.feeding:capture(f);self.captures+=1;break\n    end\n   end\n  end end\n end\nend\n-- Flies that have been eaten leave the list.\nfunction D.tidy(self: any)\n for i=#self.flies,1,-1 do if self.flies[i].state=='CONSUMED' then table.remove(self.flies,i) end end\nend\n-- After the motor: the strike, the feeding (the reserves advance here, once a tick), the meal held in the jaws, and the tidying. `escape` (optional, PreyWorld's)\n-- takes a fly that tore free; without it the fly is this director's own.\nfunction D.after(self: any,dt: number,motor: any,sensor: any,cast: any,escape: ((any)->())?)\n if not self.enabled then return end\n local started=os.clock()\n self:strike(motor,sensor,cast)\n self.feeding:step(dt,motor.mode=='attached' and not motor.preparing,motor.moving or motor.vel.Magnitude>.15,escape or function(f) self:escape(f) end)\n local held=self.feeding.held\n if held then\n  held.position=motor:eyePosition()+motor.heading*(if self.feeding.struggling then .42 else .2)+motor.up*(if self.feeding.struggling then .04 else -.13)\n  held.normal=motor.up;held.heading=motor.heading;held.prevPosition=held.position\n end\n self:tidy()\n table.insert(self.cpu,(self.beforeCost or 0)+(os.clock()-started)*1e6);if #self.cpu>1200 then table.remove(self.cpu,1) end\nend\n-- After the motor, for a director whose jaws are another's (ROBLOX-96): the strike and the tidying only; the feeding step and the held fly are the home\n-- director's, run once a tick.\nfunction D.afterShared(self: any,motor: any,sensor: any,cast: any)\n if not self.enabled then return end\n local started=os.clock()\n self:strike(motor,sensor,cast)\n self:tidy()\n table.insert(self.cpu,(self.beforeCost or 0)+(os.clock()-started)*1e6);if #self.cpu>1200 then table.remove(self.cpu,1) end\nend\n-- The engine's geometry for a director: the casts against `world` and the clearance probe. Several directors may share one (PreyWorld: one set of closures, so a\n-- checkpoint names them once).\nfunction D.casts(world: Instance): any\n local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={world}\n local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Include;overlap.FilterDescendantsInstances={world}\n local probe=Instance.new('Part');probe.Name='FlyClearanceProbe';probe.Shape=Enum.PartType.Ball;probe.Anchored=true;probe.CanCollide=false;probe.CanQuery=false;probe.CanTouch=false;probe.Transparency=1;probe.Parent=workspace\n return {\n  probe=probe,\n  cast=function(a: Vector3,b: Vector3) return workspace:Raycast(a,b-a,params) end,\n  sweep=function(a: Vector3,b: Vector3,r: number) if (b-a).Magnitude<1e-7 then return false end;return workspace:Spherecast(a,r,b-a,params)~=nil end,\n  overlap=function(a: Vector3,r: number) probe.Size=Vector3.one*r*2;probe.Position=a;return #workspace:GetPartsInPart(probe,overlap)>0 end,\n }\nend\nfunction D.engine(world: Instance,profile: any,seed: number,target: number,mixed: boolean?,spec: Spec?,casts: any?): any\n local c=casts or D.casts(world)\n local graph=Graph.new(c.cast,c.sweep,c.overlap,profile)\n local self=D.new(graph,profile,seed,target,mixed,spec);self.probe=c.probe;return self\nend\nreturn D\n",13884,658299134},{"Shared/Prey/PreyKinds","--!strict\n-- The bestiary's prey behaviours (ROBLOX-101, W3b part A), kept out of the frozen fly model: Prey/Fly calls in here only for a profile whose body asks for it\n-- (Data/Species: `hop`, `sidestep`, `dusk`/`day`, `slip_chance`, `shed_chance`), and Godot's profiles ask for none of them, so the house fly, the fruit fly,\n-- the gnat and the aphid run exactly as before. Game rules, not measurements; every draw is the fly's own PreyRandom stream (recorded with it), so a rest\n-- puts back a moth that has used its slip, or a crane fly with a leg gone, and replays the same.\n--   the hop ......... a ballistic escape on the reaction model (the springtail's flick, the leafhopper's jump): a parabola from where it stands to a free perch\n--                     of its kind (or, on level ground, a spot on the same surface) between the hop's `min` and `max`, away from the danger, swept for\n--                     clearance before it leaves; in the air for `time`, as high as `apex`; it lands perched and may fly on (`fly_after`)\n--   the sidestep .... (the leafhopper) alert and watched from its own side, it goes round its stem or leaf to the perch on the far side (`behind`), passing the\n--                     perch's `round` point, in `time` seconds, and not again for `rest`\n--   dusk ............ a director of a kind with a `dusk` profile swaps every fly of it to that profile from dusk through the night and back by day; the\n--                     restlessness each fly drew is kept, its clock of restlessness starts again at the change (so they do not all take off at once)\n--   the grip ........ the moth's slip (the first grip on it fails at `slip_chance`, once) and the crane fly's shed leg (once, at `shed_chance`, `shed_after`\n--                     seconds into the struggle): the prey leaves the jaws and escapes as a torn-free fly does\n--   the ear ......... (ROBLOX-120, the field cricket: body.hear) a spider moving faster than `still` studs a second within `range` studs hushes it: it falls silent and\n--                     holds still (no walk, no fidget) for `hold` seconds after the last it heard; a `freeze` profile alert freezes where it stands (as a walker\n--                     does) until it jumps; a `chirp` profile (the night's) sings while it is perched, calm and not hushed, the males only (odd serials)\n--   the kick ........ (ROBLOX-120, the field cricket: body.kick) in the jaws its hind legs kick: `first` seconds in and then every `every`, each takes `size` times its\n--                     strength off the grip (on top of the struggle's jerks), from its own stream; a grip that falls to nothing is a prey torn free\n--   the creep ....... (ROBLOX-105, the aphid: body.creep) now and then, perched and calm, it walks slowly over its plant's faces to another free perch of the\n--                     same plant (World/Garden.plantPath: down its stem or round its rosette and out along the other leaf), at `speed`, every `every`\n--                     seconds; startled on the way it freezes where it is; it never leaves its plant\nlocal Species = require(script.Parent.Parent.Data.Species)\nlocal Garden = require(script.Parent.Parent.World.Garden)\nlocal PlantWalk = require(script.Parent.PlantWalk)\n\nlocal K = {}\n\n-- (ROBLOX-105) The aphid's creep (a profile with body.creep): carries on one under way (true while it moves or stands frozen on the way), or, perched, calm, not\n-- walking or fidgeting and its time come, begins one to a free perch of its own plant within `reach` studs of walking (the stream draws the perch and the next\n-- time). An aphid a ladybird is eating (`heldBy`) does not set off.\nfunction K.creep(f: any, now: number, dt: number): boolean\n\tlocal c = f.creep\n\tlocal hover = f.profile.body.hover_wu\n\tif c ~= nil then\n\t\tif f.state ~= \"PERCHED\" and f.state ~= \"ALERT\" then f.creep = nil; return false end\n\t\tif f.state == \"ALERT\" then return true end -- (startled on the way: it freezes where it is)\n\t\tlocal p, n, dir, done = PlantWalk.advance(c, (f.creepSpeed or 0.1) * dt)\n\t\tf.position = p + n * hover\n\t\tf.normal = n\n\t\tif dir.Magnitude > 0.5 then f.heading = dir end\n\t\tif done then\n\t\t\tf.creep = nil\n\t\t\tf.normal = f.perch.normal\n\t\t\tf.position = f.graph:rest(f.perch)\n\t\t\tlocal t = f.heading - f.normal * f.heading:Dot(f.normal)\n\t\t\tif t.Magnitude > 1e-3 then f.heading = t.Unit end\n\t\t\tf.restSpot = f.position; f.homeHeading = f.heading; f.walkLeft = 0; f.fidgetUntil = 0; f.perchedSince = now\n\t\tend\n\t\treturn true\n\tend\n\tlocal spec = f.profile.body.creep\n\tif spec == nil or f.state ~= \"PERCHED\" or f.walkLeft > 0 or now < f.fidgetUntil or f.heldBy ~= nil or f.perch == nil then return false end\n\tif f.creepNext == nil then f.creepNext = now + f.rng:draw(spec.every); return false end\n\tif now < f.creepNext then return false end\n\tf.creepNext = now + f.rng:draw(spec.every)\n\tlocal here = f.perch\n\tlocal name, plants = Garden.plantOf(here.id)\n\tif name == nil or plants == nil then return false end\n\tlocal plant = plants[name]\n\tlocal list = {}\n\tfor _, other in f.graph.perches do\n\t\tif other ~= here and other.walker and other.valid and other.occupant == \"\" and other.reserved == \"\" and plant.nodes[other.id] ~= nil then\n\t\t\tlocal path = Garden.plantPath(plant, here.id, other.id)\n\t\t\tif path ~= nil then\n\t\t\t\tlocal w = PlantWalk.new(path, f.position - f.normal * hover, f.normal)\n\t\t\t\tif w.length <= spec.reach then table.insert(list, { perch = other, walk = w }) end\n\t\t\tend\n\t\tend\n\tend\n\tif #list == 0 then return false end\n\tlocal pick = list[1 + math.floor(f.rng:next() * #list) % #list]\n\tif here.occupant == f.id then here.occupant = \"\" end\n\tpick.perch.occupant = f.id\n\tf.perch = pick.perch\n\tf.creep = pick.walk\n\tf.creepSpeed = f.rng:draw(spec.speed)\n\tf.creeps = (f.creeps or 0) + 1\n\tf.glanceTarget = nil\n\treturn true\nend\n\n-- (ROBLOX-117) The hoverfly's hover (a profile with body.hover): on a calm flight (REPOSITION: not a flight from the spider), once a flight and at `chance`, part of the way\n-- along, it stops dead in the air and holds there, wavering a little, for `hold` seconds drawn from its stream; then the flight goes on from a standstill at its quick\n-- cruise (the dart). Startled while it holds, it flees as any fly does. Returns true while it holds (the flight does not step).\nfunction K.hover(f: any, now: number, _dt: number): boolean\n\tlocal h = f.profile.body.hover\n\tlocal flight = f.flight\n\tif f.state ~= \"REPOSITION\" or flight.length <= 1e-6 then f.hoverUntil = nil; return false end\n\tif f.hoverUntil ~= nil then\n\t\tif now < f.hoverUntil then\n\t\t\tlocal t = now - (f.hoverSince or now)\n\t\t\tlocal at = f.hoverAt :: Vector3\n\t\t\tf.position = at + Vector3.new(math.sin(t * 7.3) * h.waver, math.sin(t * 5.1) * h.waver * 0.6, math.cos(t * 6.1) * h.waver)\n\t\t\tflight.speed = 0\n\t\t\treturn true\n\t\tend\n\t\tf.hoverUntil = nil\n\t\treturn false\n\tend\n\tif f.hoveredFlight ~= flight.started and flight.s > flight.length * 0.3 and flight.s < flight.length * 0.75 then\n\t\tf.hoveredFlight = flight.started\n\t\tif f.rng:next() < h.chance then\n\t\t\tf.hoverSince, f.hoverUntil, f.hoverAt = now, now + f.rng:draw(h.hold), f.position\n\t\t\tf.hovers = (f.hovers or 0) + 1\n\t\t\tflight.speed = 0\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\n-- The arc's points along the hop: s from 0 to 1.\nlocal function arcPoint(from: Vector3, to: Vector3, apex: number, s: number): Vector3\n\treturn from:Lerp(to, s) + Vector3.yAxis * (4 * apex * s * (1 - s))\nend\nK.arcPoint = arcPoint\n\n-- Whether the whole arc is clear for the fly's graph (six chords).\nlocal function arcClear(f: any, from: Vector3, to: Vector3, apex: number): boolean\n\tlocal prev = from\n\tfor i = 1, 6 do\n\t\tlocal p = arcPoint(from, to, apex, i / 6)\n\t\tif not f.graph:clear(prev, p) then return false end\n\t\tprev = p\n\tend\n\treturn true\nend\n\nlocal function begin(f: any, target: any, to: Vector3, normal: Vector3, now: number): boolean\n\tlocal h = f.profile.body.hop\n\tf.flight:release()\n\tf.side = nil\n\tif target ~= nil then\n\t\tif f.perch and f.perch.occupant == f.id then f.perch.occupant = \"\" end\n\t\ttarget.reserved = f.id\n\tend\n\tlocal d = (to - f.position).Magnitude\n\tf.hop = { from = f.position, to = to, apex = h.apex, t0 = now, time = h.time * (0.6 + 0.4 * math.clamp(d / h.max, 0, 1)), target = target, normal = normal }\n\tf.state = \"HOP\"; f.stateSince = now; f.goal = \"flee\"; f.goalSince = now; f.walkLeft = 0; f.pending = nil\n\tf.hops = (f.hops or 0) + 1\n\treturn true\nend\n\n-- The escape hop, from where the fly is (perched, alert or in the jaws): true when one began.\nfunction K.hop(f: any, now: number): boolean\n\tlocal h = f.profile.body.hop\n\tif h == nil or f.hop ~= nil then return false end\n\tlocal from = f.position\n\tlocal danger = if f.senses.hasLastSeen then f.senses.lastSeenPosition else from - f.heading\n\tlocal here = (from - danger).Magnitude\n\tlocal list = {}\n\tfor _, c in f.graph.perches do\n\t\tif c ~= f.perch and c.valid and