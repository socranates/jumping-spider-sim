assert(game.GameId==10771103250 and game.PlaceId==120119801868085 and not game:GetService("RunService"):IsRunning());local lab=Instance.new("Folder");lab.Name="ChetIsolatedSaveLab";local modules={{"Shared/Data/AntMimic","--!strict\n-- The ant-mimicking jumping spider's walk and antennae (ROBLOX-64): every number the pose needs, each marked DOC (reported in the\n-- paper) or ART (artistic: not reported, chosen to read well on a small screen). The pose is presentation only: it bends the drawn\n-- legs and turns the drawn body a little; it never changes the motor, the collider, the path, the speed, the jump, the senses or the\n-- wasp. The real animal's path is a sine-like trail (wavelength about ten body lengths); the game's spider goes where the player\n-- sends it, so the zigzag is drawn on the body and not walked.\n--\n-- Source: Shamble, P. S., Hoy, R. R., Cohen, I. & Beatus, T. (2017). Walking like an ant: a quantitative and experimental approach to\n-- understanding locomotor mimicry in the jumping spider Myrmarachne formicaria. Proceedings of the Royal Society B 284: 20170308.\n-- doi:10.1098/rspb.2017.0308. What it reports, and the game uses:\n--   * the mimic walks on all eight legs; when stationary the forelegs (legs I) are raised above head height and move in phase, like\n--     ant antennae (the \"antennal illusion\"); when moving they work as legs;\n--   * the mimic makes only short stops, 83.3 +- 82.6 ms on average, so to an observer it seems to move almost constantly, like an ant\n--     (a non-mimic jumping spider such as Salticus scenicus is stationary about 55 % of the time; ants about 5 to 10 %);\n--   * its path is sine-like, wavelength about ten body lengths (range 5 to 10), amplitude about five body lengths, statistically like\n--     a trail-following ant;\n--   * in playbacks to Phidippus audax (the genus of the game's first spider) as the predator, non-mimic spider targets were attacked\n--     4.5 times as often as ants and 3 times as often as mimics; ants and mimics did not differ (protective Batesian mimicry);\n--   * the playback target's body length was 5 mm.\n-- The drawn animal is the female (the male's chelicerae are enormous and point forward: a possible later variant).\n\nlocal AntMimic = {}\n\nAntMimic.id = \"myrmarachne_formicaria_female\"\nAntMimic.citation = \"Shamble, Hoy, Cohen & Beatus 2017, Proc. R. Soc. B 284: 20170308 (doi:10.1098/rspb.2017.0308)\"\n\n-- ---------------------------------------------------------------- reported: DOC\nAntMimic.bodyLengthMm = 5 -- the playbacks' body length (DOC); 1 stud = 1 cm, so the drawn spider is 0.5 studs long\nAntMimic.bodyLengthStuds = 0.5\nAntMimic.walkingLegs = 8 -- DOC: all eight legs walk\nAntMimic.stops = { meanMs = 83.3, sdMs = 82.6 } -- DOC: the mimic's stops are this short\nAntMimic.stationaryShare = { nonMimicSpider = 0.55, antLow = 0.05, antHigh = 0.10 } -- DOC: share of the time stationary (S. scenicus about 55 %, ants 5 to 10 %)\nAntMimic.path = { wavelengthBodyLengths = { min = 5, max = 10, used = 10 }, amplitudeBodyLengths = 5 } -- DOC: the real path; the game draws only the wavelength\nAntMimic.playback = { predator = \"Phidippus audax\", nonMimicVsAnt = 4.5, nonMimicVsMimic = 3.0 } -- DOC: times attacked more than ants, and than mimics\n\n-- ---------------------------------------------------------------- artistic: ART (the paper reports none of these)\n-- Antennae: legs I raised above head height and waving in phase. The paper gives no wave rate; both rates stay at or below 3 Hz\n-- (a slow, calm flutter, and nothing that flashes).\nAntMimic.antennae = {\n\tdelaySeconds = 0.25, -- how long the spider must keep still before the legs go up (no twitching on a key tap)\n\triseSeconds = 0.25, -- the legs go up over this long\n\tfallSeconds = 0.12, -- and come down this fast when it moves (legs I are legs again)\n\twaveHz = 1.6, -- waving rate, resting\n\twaveAmount = 0.55, -- how much of the foot's path from \"up\" to \"swept\" a wave covers, resting (0..1)\n\thighWaveHz = 3.0, -- the display key: waving faster\n\thighWaveAmount = 1.0, -- and wider\n\thighRaise = 1.0, -- and the legs lift to their highest\n}\n-- The drawn walk: the body's yaw and sideways sway follow the distance walked (so slow motion and frame rate change nothing but speed).\n-- The wavelength is DOC (ten body lengths); the drawn sizes are ART and small, because the real path cannot change.\nAntMimic.walk = {\n\tyawDeg = 12, -- ART: the drawn body turns this far either side of its heading\n\tlateralStuds = 0.04, -- ART: and sways this far to either side (0.08 body lengths)\n\teaseInSeconds = 0.15, easeOutSeconds = 0.25, -- ART: the wobble arrives and leaves over these\n\tstopHoldSeconds = AntMimic.stops.meanMs / 1000, -- DOC value, used as the drawn rule: a stop shorter than 83.3 ms is not drawn as a pause\n\tteleportStuds = 2.0, -- ART: a step longer than this in one frame is a respawn or a return, not a walk\n}\nAntMimic.reducedMotion = 0.5 -- ReducedMotion halves the yaw and the sway and stops the waving (the legs stay up)\nAntMimic.noticeSeconds = 1.0 -- ART: with the antennae fully up this long, the notebook opens its page\n\nreturn AntMimic\n",4899,1739146978},{"Shared/Data/Appearances","--!strict\n-- Artist-directed appearance, independent of species tuning, growth and physics.\n-- Nathan's daughter's pick: docs/art/first-spider-reference.jpg (2026-10-14). ROBLOX-13 made it cuter without changing it:\n-- proportions, eyes, fuzz and a little idle motion. Every number the look needs is in this table.\n-- Body frame: +Y up, -Z forward. Lengths are studs (1 stud = 1 Godot WU = 1 cm). Markings are fractions of the abdomen's X/Z radii.\nlocal first = {\n\tid = \"first_spider\",\n\tname = \"First spider\",\n\n\t-- ---------------------------------------------------------------- the daughter's design: colours and pattern\n\t-- tests/look.luau pins every value in this block. Change them only if she does.\n\tbody = { 0, 0, 0 },\n\tlegs = { 0, 0, 0 },\n\tgloss = 0.04, -- ROBLOX-85: a touch of sheen on the carapace and abdomen (Reflectance; SmoothPlastic as before); the eyes are as they were\n\twhite = { 0.94, 0.94, 0.92 },\n\teyes = { 0.008, 0.008, 0.008 },\n\tfangs = { 0.025, 0.025, 0.025 },\n\tabdomenRadii = { 0.25, 0.205, 0.285 },\n\tfrontLegScale = 1.28,\n\tbandFraction = 0.23, -- the pale band on each leg and palp segment\n\tspeckleCount = 24,\n\t-- Large centre, two small elongated anterior spots, two posterior ovals.\n\tspots = {\n\t\t{ x = 0, z = 0.10, rx = 0.080, rz = 0.074, angle = 0 },\n\t\t{ x = -0.34, z = -0.46, rx = 0.018, rz = 0.034, angle = -0.35 },\n\t\t{ x = 0.34, z = -0.46, rx = 0.018, rz = 0.034, angle = 0.35 },\n\t\t{ x = -0.35, z = 0.67, rx = 0.025, rz = 0.035, angle = 0.4 },\n\t\t{ x = 0.35, z = 0.67, rx = 0.025, rz = 0.035, angle = -0.4 },\n\t},\n\t-- The pale band across the front of the abdomen: `count` dabs, `step` apart, at z.\n\tband = { count = 9, step = 0.16, z = -0.66, rx = 0.031, rz = 0.018 },\n\t-- Fine speckles on a spiral: radius `from` + (i % 5) * `step`.\n\tspeckle = { from = 0.40, step = 0.10, rx = 0.0035, rz = 0.005 },\n\n\t-- ---------------------------------------------------------------- cuter proportions (ROBLOX-13)\n\t-- A slightly bigger, rounder head than the abdomen (head volume about 1.07 x the abdomen's; it was 0.77).\n\theadCenter = { 0, 0.03, -0.21 },\n\theadRadii = { 0.27, 0.215, 0.27 },\n\tabdomenCenter = { 0, 0.04, 0.20 },\n\tpedicel = { center = { 0, -0.035, -0.06 }, radii = { 0.05, 0.05, 0.06 } },\n\tface = { center = { 0, 0.05, -0.37 }, radii = { 0.225, 0.18, 0.12 } }, -- the rounded muzzle under the eyes\n\tneck = { 0, 0.0, -0.06 }, -- the head tilts about this point\n\t-- Pale side patches (the daughter's \"cheeks\"): placed on the head's side at height y, depth z (body frame).\n\tcheek = { y = 0.055, z = -0.235, radii = { 0.02, 0.07, 0.115 }, inset = 0.006 },\n\t-- ROBLOX-127: the chelicerae of the bold jumping spider are iridescent green (DOC: Wikipedia, Phidippus audax). `color` (new) is a black-green, a shade off the\n\t-- daughter's black (her `fangs` colour below is unchanged and still colours the claws), Foil at a stronger sheen (0.1 to 0.28), so a highlight finds the green.\n\tchelicerae = { x = 0.055, y = -0.085, z = -0.447, radii = { 0.05, 0.072, 0.045 }, pitch = -0.35, splay = 0.12, reflectance = 0.28, color = { 0.03, 0.14, 0.105 } },\n\t-- Eyes. Never a human face: no brows, no mouth. Big glossy front eyes read as an animal's.\n\teye = {\n\t\t-- Principal (front) eyes: large, glossy, set low in a big forehead. x, y: where on the head they sit; `out`: how far\n\t\t-- they stand out of the head, as a share of their depth. Two catchlights on each, the same on both eyes: a larger one\n\t\t-- high toward +X (the light) and a smaller one low toward -X (its reflection).\n\t\tame = {\n\t\t\tx = 0.115, y = 0.095, radii = { 0.100, 0.100, 0.082 }, out = 0.30, reflectance = 0.5,\n\t\t\tsocket = { scale = 1.13, color = { 0.11, 0.11, 0.11 } }, -- a dark-grey rim so the black eye reads against the black head\n\t\t\tglints = { { dx = 0.030, dy = 0.036, r = 0.022 }, { dx = -0.028, dy = -0.034, r = 0.010 } },\n\t\t\t-- ROBLOX-127: depth. The principal eye is a lens at the front of a long eye tube, the retina deep behind it; the drawn lens lets a little light through\n\t\t\t-- (`transparency`, Glass) onto a dark amber-brown retina (`retina`: radii as a share of the lens's, pushed `depth` of the lens's depth back toward the head).\n\t\t\t-- Full tier only (detail `retina`). ART.\n\t\t\tlens = { transparency = 0.32, retina = { scale = 0.62, depth = 0.42, color = { 0.10, 0.055, 0.025 } } },\n\t\t},\n\t\tale = { x = 0.235, y = 0.085, r = 0.050, out = 0.15, reflectance = 0.3 }, -- anterior lateral, at the sides of the face\n\t\tple = { x = 0.150, z = -0.150, r = 0.052, out = 0.10, reflectance = 0.3 }, -- posterior lateral, on the dome\n\t\tpme = { x = 0.115, z = -0.270, r = 0.019, out = 0.10, reflectance = 0.3 }, -- posterior median, a tiny dot\n\t\tglintColor = { 1, 1, 1 },\n\t},\n\t-- Pedipalps: stout, pale-banded, pale-tipped, with a fluffy club.\n\tpalp = {\n\t\tx = 0.115, y = -0.045, -- where it leaves the face\n\t\tdrop = 0.105, reach = 0.10, spread = 0.035, -- tip: this far down, forward and out from the base\n\t\tstalk = 0.05, club = { 0.042, 0.040, 0.052 }, tipRadii = { 0.030, 0.026, 0.030 },\n\t\tfluff = { hairs = 5, length = 0.048, width = 0.0085, flat = 0.7, transparency = 0.15 }, -- finer in ROBLOX-85 (was 0.055 long, 0.012 wide)\n\t\tdrumHz = 3.2, drumDeg = 13,\n\t},\n\t-- Legs (display only): plump, a little shorter and more crouched than before; round feet.\n\tlimbs = {\n\t\thipX = 0.17, hipY = 0.02,\n\t\thipZ = { -0.36, -0.24, -0.12, 0.0 },\n\t\ttipZ = { -0.82, -0.52, 0.12, 0.62 },\n\t\t-- femur and tibia diameters per pair, stout front legs to slim back legs; `thickness` scales them all.\n\t\tdiameters = { { 0.078, 0.064 }, { 0.065, 0.053 }, { 0.057, 0.045 }, { 0.059, 0.047 } },\n\t\tthickness = 1.12,\n\t\tstance = { x = 0.78, y = -0.30, reach = 0.93 }, -- rest foot spot: reach scales x and the pairs' z\n\t\tkneeLift = 0.28, kneeLiftAir = 0.22, ankleLift = 0.045,\n\t\tpad = 1.6, -- foot ball diameter as a multiple of the tarsus' (full detail)\n\t},\n\t-- ---------------------------------------------------------------- the shape of a leg and a fang (ROBLOX-84)\n\t-- The three links of a leg (femur, tibia, tarsus: the solver, the targets and the gait are untouched) are drawn as the segments a spider\n\t-- really has, each a part, so a leg is no longer a tube with ball joints. All numbers are ART. Shares are of the link's length (`split`:\n\t-- where the thick rod ends and the thinner one starts) and of the rod's diameter (`taper`, `tip`, `joint`, `patella`). `bend` is how far\n\t-- (studs) the break in the tarsus is lifted, so the foot reads as two segments. The knee is the patella: a short stout ellipsoid, its\n\t-- long axis along the bend. `foot` is the tarsal pad: radii as multiples of the tarsus' diameter, a flattened ellipsoid lying on the\n\t-- surface under the foot; `claws` are two tiny dark rods splayed from its front (`splay` is the share of sideways in the direction).\n\t-- Which of these a tier draws is in `detail` (taper, tibiaTaper, jointBreak, claws, strands, fangSegments).\n\tlegForm = {\n\t\tfemur = { split = 0.62, taper = 0.74 },\n\t\ttibia = { split = 0.62, taper = 0.86 },\n\t\tpatella = { length = 1.30, width = 1.10 },\n\t\ttarsus = { split = 0.55, tip = 0.78, joint = 1.15, bend = 0.012 },\n\t\tfoot = { rx = 0.85, ry = 0.50, rz = 0.72 },\n\t\tclaws = { count = 2, length = 0.036, radius = 0.0045, splay = 0.40 },\n\t},\n\t-- Two small curved fangs under the chelicerae, tucked: each is a chain of ellipsoids from the lower front of its chelicera (Anatomy.layout);\n\t-- `dir` is the segment's direction (x is mirrored; -Z forward, -Y down). Foil, a little glossy, so a highlight finds them.\n\tfang = {\n\t\tx = 0.052, y = -0.140, z = -0.466, reflectance = 0.25, color = { 0.11, 0.05, 0.035 }, -- dark mahogany, so it reads against the black jaw\n\t\tsegments = { { dir = { -0.10, -0.75, -0.65 }, length = 0.040, radius = 0.011 }, { dir = { -0.55, -0.80, -0.10 }, length = 0.032, radius = 0.008 } },\n\t},\n\n\t-- ---------------------------------------------------------------- fuzz (ROBLOX-07, retuned for the real camera in ROBLOX-13)\n\t-- The camera sits 5 studs away (CameraMath.CAMERA_DISTANCE), 1 stud is about 170 px on a 1080p screen, so a hair is a few\n\t-- pixels at most. The first coat answered that with big stiff hairs, and they stood off the body like a hedgehog's and\n\t-- covered the white spots; the second coat (this one) is short, thin and combed flat, and leaves the softness to the shells.\n\tfuzz = {\n\t\tenabled = true,\n\t\t-- ROBLOX-85: fur that lies along the body. The third coat (the second, ROBLOX-13's, was short and combed flat but its hairs were wide, flat\n\t\t-- chips, 0.018 across for 0.03 long, and read as scales or splinters) is finer, shorter and denser, and every hair of the coat lies at a low\n\t\t-- angle off the surface (15 to 25 degrees, not 3 to 13 and not standing) pointing backward and a little outward: toward the abdomen's tip on\n\t\t-- the abdomen and the head's dome, down the leg toward the foot on a leg. It takes its colour from the pattern it grows on: black hairs on the black\n\t\t-- areas, white hairs only inside the white spots and the band, and a few (`tip`) with a greyer, paler cast, which is what a dark coat does\n\t\t-- where it catches the light; nothing white is off the white. The softness still comes from the fur shells.\n\t\t-- `abdomen` and `head` are Fibonacci sample points before the belly is skipped (about 60 % of them become hairs).\n\t\t-- `length` and `lift` are ranges (studs; degrees off the surface: 0 lies flat, 90 stands up); `yaw` scatters the combing (degrees either\n\t\t-- side of straight back) and `out` turns it away from the midline (degrees, at most, per hair: the abdomen's fur flows back and out);\n\t\t-- `flat` is the thickness as a share of the width; `black` is the share of the blackest tone (the rest is `dark`); `tip` the share of the\n\t\t-- greyer tone; `transparency` keeps the coat a little see-through.\n\t\t-- Locks: the pelt, lying at a low angle and combed toward the rear.\n\t\tlocks = { abdomen = 440, head = 250, length = { 0.022, 0.036 }, width = 0.0075, flat = 0.8, lift = { 15, 25 }, yaw = 12, out = 16, black = 0.45, tip = 0.07, transparency = 0.10 },\n\t\t-- Guard hairs: a few short, fine hairs that stand up from the pelt (the only ones that do).\n\t\tguard = { abdomen = 24, head = 12, length = { 0.026, 0.038 }, width = 0.0055, flat = 1.0, lift = { 42, 56 }, yaw = 30, black = 0.5, transparency = 0.20 },\n\t\t-- The fringe: finer hairs along the sides (`side`: how far round to the side, as a share of the radius, a hair has to be), lifted a little more\n\t\t-- and leaning out, so the outline is soft by a pixel or two and not ragged by a chip.\n\t\tfringe = { abdomen = 220, head = 80, side = 0.78, length = { 0.024, 0.034 }, width = 0.0065, flat = 0.8, lift = { 20, 30 }, yaw = 14, out = 24, black = 0.5, tip = 0.07, transparency = 0.20 },\n\t\t-- White hairs inside the white spots and the band: `density` per square stud of marking, lying on it (14 to 22 degrees), kept only when the\n\t\t-- whole hair stays `margin` studs inside the edge, so the white keeps its edge.\n\t\tpale = { density = 800, length = { 0.021, 0.027 }, width = 0.0085, flat = 0.6, lift = { 14, 22 }, yaw = 12, margin = 0.004, transparency = 0.05 },\n\t\tclear = 0.006, -- black hairs stay this far (studs) from any white marking\n\t\tblack = { 0.03, 0.03, 0.03 },\n\t\tdark = { 0.13, 0.13, 0.13 },\n\t\tgrey = { 0.50, 0.50, 0.48 }, -- grey and frost: the pale tips of the coat, the face (tufts, ruff) and the palps' fluff\n\t\tfrost = { 0.76, 0.76, 0.73 },\n\t\t-- Fur shells: see-through layers outside the body, strongest nearest it, so the outline goes soft. Four at full detail, one at low. A shell\n\t\t-- tints what is under it as well as what is around it, so they are dark and faint: the white of the pattern must stay white.\n\t\tshellColor = { 0.08, 0.08, 0.08 },\n\t\tshells = { { scale = 1.05, transparency = 0.86 }, { scale = 1.10, transparency = 0.92 }, { scale = 1.16, transparency = 0.955 }, { scale = 1.23, transparency = 0.975 } },\n\t\theadShell = { zScale = 0.80, shift = 0.05 }, -- the head's shells sit back from the eye row so the eyes stay clear\n\t\t-- Little tufts that bold jumping spiders have above the eyes, at the upper sides of the head: a fan of dark and silvery hairs that sweeps\n\t\t-- up and out, finer than before. Not eyebrows: they sit behind the eyes at the sides, not over them.\n\t\ttuftHairs = 7, -- per side\n\t\ttuftLength = 0.058,\n\t\ttuft = { at = { 0.52, 0.80, -0.28 }, lean = { 0.60, 1.0, 0.05 }, fan = 0.46, spread = 0.02, width = 0.0075, flat = 0.8, transparency = 0.1 },\n\t\t-- A soft ruff of pale hair low on each cheek, beside the jaws (not a moustache: it sits at the sides).\n\t\truff = { hairs = 4, length = 0.042, width = 0.0075, flat = 0.7, at = { 0.52, -0.36, -0.74 }, lean = { 0.65, -0.55, -0.30 }, whiteShare = 0.6, transparency = 0.15 },\n\t\tlegHairs = { 4, 4, 1 }, -- femur, tibia, tarsus, per leg (front legs carry 1.6 x as many on femur and tibia)\n\t\tlegLength = 0.040,\n\t\tlegWidth = 0.0075,\n\t\tlegTransparency = 0.2,\n\t\tlegBlack = 0.4, -- the share of the blackest tone on the legs (the rest is dark; white over the pale bands)\n\t\tlegLift = { 15, 26 }, -- a leg's hairs lie at this angle off the leg, pointing down it toward the foot\n\t\tlegTip = 0.08, -- the share of the legs' hairs with the greyer cast\n\t\thipBare = { 0.6, 0.6, 0, 0 }, -- ROBLOX-93: the share of each pair's femur, from the hip, that has no hair (the hairs are spread over the rest): legs I and II start at the face, where the anterior lateral eyes are, and a walking leg I swings past them\n\t\t-- ROBLOX-127: the fringe. A bold jumping spider's legs and palps have \"white banding with fringes\" (DOC: Wikipedia, Phidippus audax): longer pale hairs standing out\n\t\t-- from the sides and underside of the tibia of legs I (Setae.legFringe). `pairs` gives, for a pair of legs, the count on the femur, tibia and tarsus; `edge` is where round\n\t\t-- the leg (degrees from its top, one side then the other), `lift` how far off the leg they stand (leaning toward the foot), `tone` their colour. Full tier only for her\n\t\t-- (detail every.legFringe 0 at low); the male mate's and the rival's are heavier (below). ART.\n\t\tlegFringe = { pairs = { [1] = { 0, 6, 0 } }, length = { 0.050, 0.064 }, width = 0.006, lift = { 56, 70 }, edge = { 80, 130 }, tone = \"frost\", transparency = 0.15 },\n\t},\n\n\t-- ---------------------------------------------------------------- idle motion (drawn rig only, ROBLOX-13)\n\t-- Eased in after the spider has stood still for a moment; off while walking, in the air, in low detail and with reducedMotion\n\t-- (the palps' drumming follows the same rule).\n\tidle = {\n\t\triseSeconds = 1.0, fallSeconds = 0.25,\n\t\t-- A breath (ROBLOX-87: 0.4 Hz, was 0.3): the body's lift and the abdomen's pitch as before, and the abdomen's scale `scale` (2.5%) with it, hairs and shell\n\t\t-- moving with it; `movingShare` of it while the spider walks, hangs or is posed.\n\t\tbreathe = { period = 2.5, bodyLift = 0.006, lift = 0.016, pitchDeg = 2.4, scale = 0.025, movingShare = 0.35 },\n\t\t-- A small, slow, curious head tilt: sums of sines (periods in seconds), always inside these angles.\n\t\ttilt = { rollDeg = 7, yawDeg = 6, pitchDeg = 3.5, periods = { 9.1, 5.3, 11.3, 6.7, 8.3 } },\n\t\t-- Living motion (ROBLOX-87, Rig/Living; every number ART). Grooming: after `after` seconds of standing, a bout `firstWait` seconds later and then every `gap` seconds\n\t\t-- after the last one ended (a seeded stream), either a palp drawn through the jaws (`strokes` of them over `palpSeconds`, the palp turning `palpYawDeg` toward\n\t\t-- the midline and `palpPitchDeg` down) or a leg I pulled forward to where `legs[1]` says (the body frame, studs; kneeOut and kneeUp bend the knee) and wiped\n\t\t-- `sweep` studs to and fro through the palps (which close `legPalpYawDeg`) for `legSeconds`; after a meal (the \"groom\" cue), `mealDelay` seconds into a stand, both\n\t\t-- palps (`mealPalpSeconds`) then legs I and II, each leg `legSeconds`. A bout fades over `fade` of its act and gives way in `abortSeconds` when the spider moves.\n\t\tgroom = {\n\t\t\tafter = 4.0, firstWait = { 0.3, 3.0 }, gap = { 8, 20 }, mealDelay = 1.5, strokes = 3,\n\t\t\tpalpSeconds = 2.0, legSeconds = 2.5, mealPalpSeconds = 2.2, palpYawDeg = 30, palpPitchDeg = 20, legPalpYawDeg = 24, fade = 0.18, abortSeconds = 0.25,\n\t\t\tlegs = {\n\t\t\t\t{ x = 0.12, y = -0.16, z = -0.64, sweep = 0.06, kneeOut = 0.22, kneeUp = 0.20 },\n\t\t\t\t{ x = 0.15, y = -0.18, z = -0.56, sweep = 0.06, kneeOut = 0.22, kneeUp = 0.20 },\n\t\t\t\t{ x = 0.15, y = -0.18, z = -0.56, sweep = 0.06, kneeOut = 0.22, kneeUp = 0.20 },\n\t\t\t\t{ x = 0.15, y = -0.18, z = -0.56, sweep = 0.06, kneeOut = 0.22, kneeUp = 0.20 },\n\t\t\t},\n\t\t},\n\t\t-- Attention: the drawn body turns toward the focus point (at most `maxDeg`, eased over `easeSeconds`); the principal eyes shift `glance` studs toward it,\n\t\t-- all of it across `glanceSpanDeg` of the angle that is left.\n\t\tattention = { maxDeg = 20, easeSeconds = 0.4, glance = 0.02, glanceSpanDeg = 28 },\n\t\t-- Alarm: legs I go to `raise` (body frame, studs) and the idle motion freezes for `seconds`, in `riseSeconds` and out over `fallSeconds`.\n\t\talarm = { seconds = 1.2, riseSeconds = 0.15, fallSeconds = 0.35, raise = { x = 0.20, y = 0.30, z = -0.52, kneeOut = 0.10, kneeUp = 0.22 } },\n\t\t-- The mating scene's two cues (ROBLOX-89; both spiders, ART). Meet: legs I go to `reach` (the body frame, studs: out in front of the head and a little off the floor, the\n\t\t-- knee out and up) and the palps lift `palpLiftDeg` and turn `palpYawDeg` toward the midline, in `riseSeconds`, held, and out over `fallSeconds`, for the cue's `seconds`. Settle:\n\t\t-- the body sinks `lower` studs and the breath is `breath` times as deep, the same way. Grooming and the accents give way to both (the breath goes on).\n\t\tmeet = { seconds = 4.0, riseSeconds = 0.8, fallSeconds = 0.8, reach = { x = 0.14, y = -0.02, z = -0.74, kneeOut = 0.12, kneeUp = 0.16 }, palpLiftDeg = 12, palpYawDeg = 8 }, -- (ROBLOX-93: kneeOut 0.08 to 0.12, the knees stand out wide enough for the legs to clear the face)\n\t\tsettle = { seconds = 4.0, riseSeconds = 0.8, fallSeconds = 0.8, lower = 0.035, breath = 1.6 },\n\t},\n\n\t-- ---------------------------------------------------------------- hanging on a dragline (ROBLOX-59, ROBLOX-86; drawn rig only)\n\t-- The body hangs with its long axis along the line, head down, tail (the spinneret) up at the line. `rate` is how fast the pose blends in (per\n\t-- second); `leanDeg` the static angle the long axis stands off the line; `sway` a damped pendulum about the spinneret (degrees, seconds; `across` is\n\t-- the share of it that swings sideways, a quarter turn out of phase) that the drop starts; `spin` a slow damped turn about the line (degrees a second,\n\t-- seconds); `climb` the head-up pose on the way up the line (the speed along the line that counts as climbing, studs a second, the blend in seconds,\n\t-- and how far the body stands off the line, as a share of the carapace's half height). `legs` are, for each pair, the directions of the femur,\n\t-- tibia and tarsus in the body frame (x is mirrored for the left; +Z toward the tail and the line, -Z toward the head): each link keeps the length it\n\t-- has standing, so legs I and II curl forward and back up toward the line and legs III and IV fold back along the body. `asym` is a fixed per-leg\n\t-- scatter and `wiggle` a small slow tremble of the feet (not with Reduced Motion); `palpTuckDeg` draws the palps in. All ART.\n\thang = {\n\t\trate = 3.5,\n\t\tleanDeg = 3.0,\n\t\tsway = { deg = 4.5, period = 2.5, decay = 4.0, across = 0.45 },\n\t\tspin = { degPerS = 8.0, decay = 7.0 },\n\t\tclimb = { speed = 0.35, seconds = 0.5, shift = 0.8 },\n\t\tpalpTuckDeg = 30,\n\t\tasym = 0.10, wiggle = 0.08,\n\t\tlegs = {\n\t\t\t{ femur = { 0.65, -0.20, -0.25 }, tibia = { -0.10, -0.25, 0.90 }, tarsus = { -0.45, -0.30, 0.50 } },\n\t\t\t{ femur = { 0.65, -0.20, -0.05 }, tibia = { -0.05, -0.25, 0.90 }, tarsus = { -0.50, -0.30, 0.50 } },\n\t\t\t{ femur = { 0.60, -0.15, 0.55 }, tibia = { 0.00, -0.20, 0.80 }, tarsus = { -0.55, -0.30, -0.35 } },\n\t\t\t{ femur = { 0.40, -0.15, 0.85 }, tibia = { 0.15, -0.20, 0.35 }, tarsus = { -0.50, -0.30, -0.20 } },\n\t\t},\n\t},\n\n\t-- ---------------------------------------------------------------- detail modes\n\t-- Full is for PCs. Low is for phones and tablets (touch-only devices, or Workspace attribute Detail = \"low\"): fewer\n\t-- hairs (keep one in `every`; 0 drops the whole class, so the low tier has no standing guard hairs), a single fur shell,\n\t-- no foot balls, half the speckles, no outline and no idle motion of its own (no breathing, head tilt or palp drumming), except that a rig built `living`\n\t-- (the mate in the mating scene) has a minimal idle (ROBLOX-89: its breath and the scene's cues).\n\t-- The pattern, eyes, catchlights and tufts stay.\n\tdetail = {\n\t\tfull = {\n\t\t\tevery = { lock = 1, guard = 1, fringe = 1, pale = 1, tuft = 1, ruff = 1, palp = 1, leg = 1, legFringe = 1 },\n\t\t\tshells = 4, speckleEvery = 1, pads = true, sockets = true, idle = true, highlight = true,\n\t\t\ttaper = true, tibiaTaper = true, jointBreak = true, claws = 2, fangSegments = 2, retina = true,\n\t\t},\n\t\tlow = {\n\t\t\tevery = { lock = 4, guard = 0, fringe = 3, pale = 2, tuft = 2, ruff = 2, palp = 2, leg = 4, legFringe = 0 },\n\t\t\tshells = 1, speckleEvery = 2, pads = false, sockets = false, idle = false, highlight = false,\n\t\t\ttaper = true, tibiaTaper = false, jointBreak = false, claws = 0, fangSegments = 1, retina = false,\n\t\t},\n\t},\n}\n\n-- ================================================================ the peacock spider (ROBLOX-30)\n-- Maratus volans, the male in courtship colours: a second profile beside the daughter's, chosen from the crack (Client/SpiderClient).\n-- Morphology after Otto & Hill 2011 (Peckhamia 96.1): a male about 4 to 5 mm long (DOC); a dark carapace with three red-orange\n-- stripes and a pale margin (DOC); white palp brushes (DOC); legs III longer and darker than the rest, with black brushes and white\n-- tips (DOC); an abdominal fan whose lateral flaps lie folded round the abdomen until the display and then show as a near-round\n-- disc: an iridescent blue-green field with a black central figure, red-orange arches and a white fringe (DOC). The exact\n-- colours, proportions, stripe sizes and the angles below are ART. 1 stud = 1 cm, so the male is 0.45 studs long: the drawn\n-- body is the default spider's face and build at SCALE, with its own colours, a fan and legs III. Collider, senses and physics are\n-- the default spider's: this is a drawn appearance only (ROBLOX-30).\nlocal SCALE = 0.47 -- body length 0.455 studs against the default spider's 0.97 (ART, from 4.5 mm and 1 stud = 1 cm)\n\n-- A copy of a table with every number in it multiplied by k, except under the keys in `skip` (angles, shares, counts, colours).\nlocal function scaled(node: any, k: number, skip: { [string]: boolean }): any\n\tif type(node) == \"number\" then return node * k end\n\tif type(node) ~= \"table\" then return node end\n\tlocal out: { [any]: any } = {}\n\tfor key, value in node do\n\t\tout[key] = if skip[key] then value else scaled(value, k, skip)\n\tend\n\treturn out\nend\nlocal FACE_SKIP = { out = true, reflectance = true, scale = true, color = true, glintColor = true, pitch = true, splay = true }\nlocal LIMB_SKIP = { thickness = true, pad = true, reach = true }\nlocal PALP_SKIP = { hairs = true, drumHz = true, drumDeg = true, flat = true, transparency = true }\nlocal limbs = scaled(first.limbs, SCALE, LIMB_SKIP)\nlimbs.thickness = 1.0\nlimbs.stance = { x = limbs.stance.x, y = -0.10, reach = 0.62 } -- ART: low and compact, the legs not much longer than the body\nlimbs.pairReach = { 1.0, 1.0, 1.2, 1.0 } -- legs III are the longest (DOC)\nlocal eye = scaled(first.eye, SCALE, FACE_SKIP)\neye.ame.socket = { scale = 1.12, color = { 0.50, 0.31, 0.14 } } -- tan and orange ocular setae frame the big eyes (DOC)\neye.ame.lens = nil -- (ROBLOX-127: the lens and retina are the first spider's; at this size they would be a pixel)\nlocal palp = scaled(first.palp, SCALE, PALP_SKIP)\npalp.club = { 0.021, 0.019, 0.026 } -- the white brushes clothe the palps (DOC; sizes ART)\npalp.tipRadii = { 0.014, 0.012, 0.014 }\npalp.fluff = { hairs = 0, length = 0, width = 0, flat = 1, transparency = 0 }\n\nlocal volans = {\n\tid = \"maratus_volans_male\",\n\tname = \"Peacock spider (male)\",\n\tscale = SCALE, -- SpiderRig scales its own distances (foot search, stepping) by this\n\t-- ROBLOX-114 (to scale): the drawn size at each growth stage (SpiderRig.growthScale). At Growth.SCALES (1 to 1.5) the body grew from 4.5 mm to 6.8 mm, past the\n\t-- species' 5 mm (both sexes about 5 mm, Wikipedia, Maratus volans); now the adult is 5.0 mm and the younger stages are smaller by Growth's own steps (3.4, 3.8\n\t-- and 4.4 mm). The collider, the senses and the camera's rules are the first spider's.\n\tgrowth = { 0.74, 0.85, 0.98, 1.11 },\n\tcameraScale = 0.62, -- closer framing for the small appearance; user zoom still applies\n bodyDrop = 0.21, -- the drawn body sits this far (studs) below the collider's centre, so it stands on the surface (the collider is 0.31 high)\n\n\t-- ---------------------------------------------------------------- colours (ART, after the photographs in Otto & Hill 2011)\n\tbody = { 0.09, 0.05, 0.04 }, -- carapace: dark brown-black\n\tlegs = { 0.34, 0.22, 0.12 }, -- legs I, II and IV: brown\n\twhite = { 0.93, 0.90, 0.80 }, -- cream: the pale margin, palp brushes, leg bands, the fan's fringe\n\teyes = { 0.01, 0.01, 0.01 },\n\tfangs = { 0.14, 0.08, 0.04 },\n\tjoint = { 0.20, 0.12, 0.07 }, -- knees and ankles\n\tpalpColors = { stalk = { 0.20, 0.12, 0.07 }, club = { 0.93, 0.90, 0.80 }, tip = { 0.97, 0.96, 0.90 } },\n\tabdomenColor = { 0.05, 0.34, 0.68 }, -- the abdomen is the blue field's colour under the fan's pattern\n\tstripes = { -- three red-orange stripes down the carapace behind the eyes (DOC); x, z, half widths in studs, body frame\n\t\tcolor = { 0.86, 0.26, 0.07 },\n\t\t{ x = 0, z = -0.030, rx = 0.011, rz = 0.050, angle = 0 },\n\t\t{ x = -0.050, z = -0.026, rx = 0.009, rz = 0.040, angle = 0.18 },\n\t\t{ x = 0.050, z = -0.026, rx = 0.009, rz = 0.040, angle = -0.18 },\n\t},\n\n\t-- ---------------------------------------------------------------- proportions: the default spider's face and build at SCALE\n\theadCenter = { 0, 0.014, -0.099 },\n\theadRadii = { 0.125, 0.100, 0.125 }, -- the carapace is boxy and high: a little taller than the scaled default\n\tabdomenCenter = { 0, 0.019, 0.094 },\n\tabdomenRadii = { 0.104, 0.088, 0.125 }, -- an oval, narrower than the default's\n\tpedicel = scaled(first.pedicel, SCALE, {}),\n\tface = scaled(first.face, SCALE, {}),\n\tneck = scaled(first.neck, SCALE, {}),\n\t-- The pale margin along the lower edge of the carapace (DOC): the rig draws these as the \"cheek\" patches.\n\tcheek = { y = -0.012, z = -0.075, radii = { 0.010, 0.020, 0.075 }, inset = 0.003 },\n\tchelicerae = scaled(first.chelicerae, SCALE, FACE_SKIP),\n\teye = eye,\n\tpalp = palp,\n\tlimbs = limbs,\n\tfrontLegScale = 1.0,\n\tbandFraction = 0.12, -- the pale bands on legs I, II and IV\n\tspeckleCount = 0,\n\tspots = {},\n\tband = { count = 0, step = 0.1, z = 0, rx = 0.01, rz = 0.01 },\n\tspeckle = { from = 0.4, step = 0.1, rx = 0.004, rz = 0.005 },\n\t-- Legs III (DOC): dark femur, a thick jet-black brush on the tibia, a snow-white tip, no pale bands. `up` and `swept` are\n\t-- where the foot goes when they are raised in a V and when a wave sweeps them down and forward (body frame, studs, x mirrored\n\t-- for the left leg); `kneeOut` pushes the knee outward. All ART.\n\tpairs = {\n\t\t[3] = {\n\t\t\tcolors = { { 0.13, 0.08, 0.05 }, { 0.02, 0.02, 0.025 }, { 0.96, 0.95, 0.90 } },\n\t\t\tthick = { 1.0, 1.7, 1.9 },\n\t\t\tbands = false,\n\t\t\tup = { x = 0.21, y = 0.23, z = -0.015 },\n\t\t\tswept = { x = 0.10, y = 0.12, z = -0.12 },\n\t\t\tkneeOut = 0.05,\n\t\t},\n\t},\n\n\t-- ---------------------------------------------------------------- the fan (DOC: blue-green field, black figure, red-orange arches, white fringe; ART: sizes)\n\t-- Flat discs on the abdomen's back (dorsal) face, stacked from the fringe in. `radii` are the open fan's half width and half\n\t-- length (a near-round disc, a little wider than long), `folded` the share of that it shows folded; each layer is `inset` studs\n\t-- smaller than the one under it. `plane` is the fan's height over the abdomen's top (it floats a hair above the dome), `zShift` moves\n\t-- its centre toward the rear so the raised fan stands clear of the head. The figure is three black dabs (two lobes in front, a bar\n\t-- behind), given as fractions of the radii. The back (ventral) side repeats the rim and the field so the fan is a fan from behind.\n\tfan = {\n\t\tradii = { 0.165, 0.150 }, folded = { 0.42, 0.55 }, plane = 0.004, zShift = 0.018, layerStep = 0.0022, thickness = 0.004,\n\t\tfoldedThickness = 0.042, foldedSink = 0.021, -- folded, the discs are thick and sunk into the dome (a lens on the abdomen) and flatten as the fan opens\n\t\tlayers = {\n\t\t\t{ name = \"FanFringe\", color = { 0.95, 0.94, 0.88 }, inset = 0.0 },\n\t\t\t{ name = \"FanArch\", color = { 0.96, 0.30, 0.065 }, inset = 0.015 },\n\t\t\t{ name = \"FanField\", color = { 0.025, 0.48, 0.82 }, inset = 0.046 },\n\t\t\t{ name = \"FanArch\", color = { 0.88, 0.25, 0.06 }, inset = 0.078 },\n\t\t\t{ name = \"FanField\", color = { 0.02, 0.65, 0.67 }, inset = 0.092 },\n\t\t},\n\t\tfigureColor = { 0.02, 0.02, 0.03 },\n\t\t-- A black trident on the blue: a long bar and two slanting prongs (fractions of the radii; angle in radians). Never a face.\n\t\tfigure = { { x = 0, z = 0.05, rx = 0.07, rz = 0.50, angle = 0 }, { x = -0.30, z = -0.18, rx = 0.07, rz = 0.30, angle = 0.55 }, { x = 0.30, z = -0.18, rx = 0.07, rz = 0.30, angle = -0.55 } },\n\t\tback = { plane = -0.004, layers = { 1, 2, 3 } }, -- the layers (by number) the back repeats, and where (this far under the abdomen's belly)\n\t\tflaps = { color = { 0.88, 0.25, 0.06 }, radii = { 0.030, 0.006, 0.085 }, hingeX = 0.080, hingeY = 0.040, foldedDeg = -80 }, -- the folded flaps on the flanks\n\t\tsheen = 0.18,\n\t},\n\t-- Legs III in a dance: how the pose's raise and wave move them (ART).\n\tdance = { kneeUp = 0.03 },\n\n\t-- ---------------------------------------------------------------- no fuzz: at this size the coat would be sub-pixel\n\tfuzz = nil,\n\n\tidle = {\n\t\triseSeconds = 1.0, fallSeconds = 0.25,\n\t\tbreathe = { period = 3.0, bodyLift = 0.003, lift = 0.008, pitchDeg = 2.4 },\n\t\ttilt = { rollDeg = 7, yawDeg = 6, pitchDeg = 3.5, periods = { 9.1, 5.3, 11.3, 6.7, 8.3 } },\n\t\t-- The mating scene's cues (ROBLOX-89): the first spider's, at this spider's size (0.47): no grooming, no alarm, but the reach and the settle.\n\t\tmeet = { seconds = 4.0, riseSeconds = 0.8, fallSeconds = 0.8, reach = { x = 0.066, y = -0.01, z = -0.35, kneeOut = 0.056, kneeUp = 0.075 }, palpLiftDeg = 12, palpYawDeg = 8 }, -- (the first spider's kneeOut 0.12 at this size)\n\t\tsettle = { seconds = 4.0, riseSeconds = 0.8, fallSeconds = 0.8, lower = 0.016, breath = 1.6 },\n\t},\n\n\t-- Full is for PCs; low is for phones and tablets: no foot balls, no eye sockets, no leg bands, no idle motion (but a rig built `living`, the mate, has a minimal idle: ROBLOX-89), no outline, no back to the fan, a plainer fan.\n\tdetail = {\n\t\tfull = {\n\t\t\tevery = { lock = 1, guard = 1, fringe = 1, pale = 1, tuft = 1, ruff = 1, palp = 1, leg = 1 },\n\t\t\tshells = 0, speckleEvery = 1, pads = true, sockets = true, idle = true, highlight = true, fanBack = true, fanLayers = 5, legBands = true,\n\t\t},\n\t\tlow = {\n\t\t\tevery = { lock = 0, guard = 0, fringe = 0, pale = 0, tuft = 0, ruff = 0, palp = 0, leg = 0 },\n\t\t\tshells = 0, speckleEvery = 1, pads = false, sockets = false, idle = false, highlight = false, fanBack = false, fanLayers = 3, legBands = false,\n\t\t},\n\t},\n}\n\n-- (ROBLOX-127: the first spider's green chelicerae are hers; the peacock spider's stay in its fang colour, at the sheen they had.)\nvolans.chelicerae.color = nil\nvolans.chelicerae.reflectance = 0.1\n\n-- ART: six fine teal scale streaks catch light on the open fan. Full detail only; mobile keeps its 80-part budget.\nfor _,side in {-1,1} do\n for _,z in {-0.36,0,0.36} do\n  table.insert(volans.fan.figure,{x=side*0.49,z=z,rx=0.018,rz=0.10,angle=side*z*0.65,\n   color={0.30,0.80,0.86},fullOnly=true})\n end\nend\n\n-- ================================================================ the rival: a male tan jumping spider (ROBLOX-127)\n-- The other spider is a male. It was a brown recolour of the first spider (ROBLOX-67; until ROBLOX-127 it kept ROBLOX-13's coat and the plain legs); it is now drawn\n-- as a male of the tan jumping spider, Platycryptus undatus, a common salticid of tree trunks and building walls from the eastern United States to Wisconsin and\n-- Texas (DOC: Wikipedia), so of a hut garden's walls and posts. What the sources say of it (DOC: Wikipedia, Platycryptus undatus; minnesotaseasons.com, Tan jumping\n-- spider): mottled tan, a thin flattened body; the carapace orangish-brown on top with white and reddish-brown hairs, its lower sides blackish-brown; a band of hair\n-- through and under the front eyes, white in general and reddish or orange in the male; a tuft of long black hairs under each posterior median eye; brown chelicerae;\n-- palps densely white-haired; the abdomen grey in front, blackish-brown at the sides, with a grey pattern down the middle that reads as chevrons; legs mottled\n-- orangish-brown and blackish-brown, the metatarsus dark at both ends and pale in the middle; males 8.5 to 9.5 mm (Wikipedia) or 6.7 to 9.2 mm (minnesotaseasons).\n-- What makes it read as a male, beyond those (the general salticid male look: in Phidippus audax the male's first legs are the longest and their fringes and the\n-- chelicerae are more striking, DOC: Wikipedia, Phidippus audax): a slimmer abdomen, longer, darker and heavier legs I with a dark fringe, bigger chelicerae and\n-- palps swollen at the tip (the palpal organ) under their white hair. Every number is ART; the species is the model for the look, honestly a likeness, not a\n-- measured animal. `contest` is the male-male display (Predator/RivalDisplay says when and how much; SpiderRig draws it).\nlocal function deep(t: any): any\n\tif type(t) ~= \"table\" then return t end\n\tlocal out: { [any]: any } = {}\n\tfor k, v in t do out[k] = deep(v) end\n\treturn out\nend\nlocal TAN, DARK_BROWN, GREY_TAN = { 0.42, 0.26, 0.13 }, { 0.13, 0.08, 0.05 }, { 0.50, 0.46, 0.40 }\nlocal rival: any = deep(first)\nrival.id = \"rival_spider\"\nrival.name = \"Tan jumping spider (male)\"\nrival.growth = { 0.9, 0.9, 0.9, 0.9 } -- drawn 9.1 mm long, the male's 8.5 to 9.5 (at 1 the body is 10.1 mm); it does not grow\nrival.gloss = 0.03\nrival.body = TAN -- the carapace's top\nrival.legs = { 0.38, 0.23, 0.11 }\nrival.white = { 0.82, 0.79, 0.72 } -- the pale hair: the cheeks, the palps' bands\nrival.joint = DARK_BROWN\nrival.fangs = { 0.09, 0.05, 0.03 } -- the claws\nrival.abdomenColor = { 0.15, 0.095, 0.06 } -- blackish-brown; the grey is in `marks`\n-- A flat, long carapace and a slim male abdomen.\nrival.headCenter = { 0, 0.015, -0.20 }\nrival.headRadii = { 0.255, 0.175, 0.29 }\nrival.abdomenCenter = { 0, 0.03, 0.225 }\nrival.abdomenRadii = { 0.185, 0.145, 0.30 }\nrival.face = { center = { 0, 0.03, -0.37 }, radii = { 0.215, 0.15, 0.12 } }\nrival.cheek = { y = 0.02, z = -0.25, radii = { 0.02, 0.05, 0.10 }, inset = 0.006 }\nrival.spots, rival.speckleCount = {}, 0\nrival.band = { count = 0, step = 0.1, z = 0, rx = 0.01, rz = 0.01 }\n-- The male's chelicerae: bigger, longer and set more forward, brown with a sheen; the fang under each a single dark curved segment at the low tier, two at full.\nrival.chelicerae = { x = 0.064, y = -0.09, z = -0.462, radii = { 0.058, 0.098, 0.052 }, pitch = -0.55, splay = 0.10, reflectance = 0.16, color = { 0.24, 0.13, 0.065 } }\nrival.fang = { x = 0.062, y = -0.170, z = -0.505, reflectance = 0.25, color = { 0.10, 0.045, 0.03 },\n\tsegments = { { dir = { -0.10, -0.70, -0.70 }, length = 0.048, radius = 0.012 }, { dir = { -0.55, -0.80, -0.10 }, length = 0.036, radius = 0.009 } } }\n-- Palps: brown stalks, the tip swollen (the male's palpal organ) and white with hair.\nrival.palp.club = { 0.046, 0.043, 0.055 }\nrival.palp.tipRadii = { 0.032, 0.028, 0.032 }\nrival.palpColors = { stalk = { 0.30, 0.18, 0.09 }, club = { 0.78, 0.76, 0.70 }, tip = { 0.70, 0.67, 0.60 } }\n-- The eyes keep the salticid's layout; the front pair's rim is the male's orange band of hair (full tier), the band under them the `FaceBand` (both tiers).\nrival.eye.ame.socket = { scale = 1.14, color = { 0.78, 0.40, 0.12 } }\nrival.eye.ame.lens = nil\nrival.eye.ale = { x = 0.212, y = 0.075, r = 0.048, out = 0.15, reflectance = 0.3 } -- (on the narrower, flatter head: inside its edge)\n-- More bodies: the carapace's blackish-brown lower sides (a wider, lower shell under the tan top) and the orange band of hair under the front eyes.\nrival.extras = {\n\t{ name = \"CarapaceSide\", center = { 0, -0.045, -0.20 }, radii = { 0.266, 0.15, 0.30 }, group = \"head\", color = DARK_BROWN },\n\t{ name = \"FaceBand\", center = { 0, 0.020, -0.452 }, radii = { 0.16, 0.034, 0.05 }, group = \"head\", color = { 0.80, 0.42, 0.14 } },\n}\n-- The abdomen's grey: a grey front, a midline and three chevrons down it (bars slanting back toward the midline from each side), on the blackish-brown.\nrival.marks = {\n\t{ name = \"AbdomenGrey\", color = GREY_TAN, x = 0, z = -0.60, rx = 0.105, rz = 0.06, angle = 0 },\n\t{ name = \"AbdomenMidline\", color = GREY_TAN, x = 0, z = 0.08, rx = 0.018, rz = 0.20, angle = 0 },\n\t{ name = \"AbdomenChevron\", color = GREY_TAN, x = 0.20, z = -0.22, rx = 0.015, rz = 0.068, angle = -0.95, mirror = true },\n\t{ name = \"AbdomenChevron\", color = GREY_TAN, x = 0.20, z = 0.12, rx = 0.015, rz = 0.068, angle = -0.95, mirror = true },\n\t{ name = \"AbdomenChevron\", color = GREY_TAN, x = 0.17, z = 0.46, rx = 0.013, rz = 0.055, angle = -0.95, mirror = true, fullOnly = true },\n}\n-- Legs: mottled; each link has its own colour and band (the femur's band dark, the tarsus' pale between dark ends: the metatarsus), knees and ankles dark.\nrival.legColors = { femur = { 0.38, 0.23, 0.11 }, tibia = { 0.33, 0.20, 0.10 }, tarsus = DARK_BROWN, knee = DARK_BROWN, ankle = DARK_BROWN }\nrival.legBands = { femur = { 0.16, 0.095, 0.05 }, tarsus = { 0.66, 0.53, 0.35 } }\n-- The male's legs I: longer (their rest spot a fifth farther out), heavier and darker, no bands.\nrival.frontLegScale = 1.18\nrival.limbs.pairReach = { 1.2, 1.0, 1.0, 1.0 }\nrival.pairs = { [1] = { colors = { { 0.17, 0.10, 0.05 }, { 0.11, 0.065, 0.04 }, { 0.20, 0.12, 0.06 } }, thick = { 1.0, 1.08, 0.95 }, bands = false } }\n-- The coat: the first spider's lying fur in the tan spider's colours (reddish-brown and dark hairs, a share of white ones: \"white and reddish-brown hairs\"), sparser;\n-- black tufts at the sides of the head; a dark fringe on legs I.\nlocal rf = rival.fuzz\nrf.black, rf.dark, rf.grey, rf.frost = { 0.11, 0.07, 0.04 }, { 0.36, 0.20, 0.09 }, { 0.66, 0.62, 0.56 }, { 0.86, 0.84, 0.78 }\nrf.shellColor = { 0.17, 0.11, 0.06 }\nrf.locks.abdomen, rf.locks.head, rf.locks.black, rf.locks.tip = 360, 210, 0.35, 0.22\nrf.fringe.abdomen, rf.fringe.head = 180, 60\nrf.legBlack = 0.5\nrf.legFringe = { pairs = { [1] = { 4, 8, 0 } }, length = { 0.070, 0.092 }, width = 0.0085, lift = { 55, 72 }, edge = { 70, 140 }, tone = \"black\", transparency = 0.1 }\nrival.contest = {\n\tpair = 1,\n\t-- where legs I's feet go (the body frame of the drawn prosoma, studs at scale 1, x mirrored for the left): held forward and raised (`up`, the face-off), high and spread\n\t-- (`wide`, the full display), and forward and down (`hook`, grappling); the knee pushed out and up; how much the raised feet tremble.\n\tup = { x = 0.24, y = 0.18, z = -0.74 }, wide = { x = 0.50, y = 0.40, z = -0.52 }, hook = { x = 0.13, y = -0.12, z = -0.98 },\n\tkneeOut = 0.12, kneeUp = 0.20, tremor = 0.02,\n\tspreadDeg = 22, -- each chelicera swings out this far: the basal segments 44 degrees apart (DOC: 30 to 90 in Cosmophasis umbratica's contests)\n\tlower = 0.05, -- how far the body sinks when it backs off\n\t-- (what the pose's tipSweep and sweepBack mean for a tarantula's spinnerets; the rival has none)\n\ttipSweep = 1, sweepBack = 0,\n}\nrival.detail = {\n\tfull = {\n\t\tevery = { lock = 1, guard = 1, fringe = 1, pale = 1, tuft = 1, ruff = 1, palp = 1, leg = 1, legFringe = 1 },\n\t\tshells = 3, speckleEvery = 1, pads = true, sockets = true, idle = true, highlight = true,\n\t\ttaper = true, tibiaTaper = true, jointBreak = true, claws = 2, fangSegments = 2, retina = false,\n\t},\n\t-- the game draws the rival at the low tier on every device (ROBLOX-108)\n\tlow = {\n\t\tevery = { lock = 5, guard = 0, fringe = 4, pale = 2, tuft = 2, ruff = 2, palp = 2, leg = 5, legFringe = 1 },\n\t\tshells = 1, speckleEvery = 2, pads = false, sockets = false, idle = false, highlight = false,\n\t\ttaper = true, tibiaTaper = false, jointBreak = false, claws = 0, fangSegments = 1, retina = false,\n\t},\n}\n\n-- ================================================================ the first spider's mate, a male (ROBLOX-127)\n-- The first spider is the game's female (ROBLOX-79), so her mate is a male; until now he was drawn with her look at 0.85 of her size. He keeps her pattern (the\n-- daughter's colours and markings) with a male bold jumping spider's build (DOC: Wikipedia, Phidippus audax: the male's first legs are the longest, his fringes,\n-- chelicerae and markings more striking than the female's, tufts of hair over his eyes): a slimmer abdomen, longer and heavier legs I with a heavier white fringe, bigger\n-- greener chelicerae, longer tufts. Drawn by Client/MateStage at the low tier (Appearances.mateLook); never a spider the player puts on. ART.\nlocal male: any = deep(first)\nmale.id = \"first_spider_male\"\nmale.name = \"First spider (male)\"\nmale.abdomenRadii = { 0.215, 0.18, 0.265 }\nmale.frontLegScale = 1.42\nmale.limbs.pairReach = { 1.16, 1.0, 1.0, 1.0 }\nmale.chelicerae.radii = { 0.058, 0.086, 0.052 }\nmale.chelicerae.color = { 0.035, 0.19, 0.14 }\nmale.chelicerae.reflectance = 0.34\nmale.fuzz.tuftHairs, male.fuzz.tuftLength = 9, 0.074\nmale.fuzz.legFringe = { pairs = { [1] = { 3, 8, 0 } }, length = { 0.060, 0.078 }, width = 0.0065, lift = { 56, 72 }, edge = { 75, 135 }, tone = \"frost\", transparency = 0.12 }\nmale.detail.low.every.legFringe = 1\nmale.detail.low.every.lock = 5 -- (his fringe's 22 hairs at the low tier paid for with a sparser pelt)\n\n-- ================================================================ the ant-mimicking spider (ROBLOX-64)\n-- Myrmarachne formicaria, the female: a third profile beside the daughter's and the peacock's, chosen from the crack (Client/SpiderClient).\n-- A jumping spider that looks like an ant (Shamble, Hoy, Cohen & Beatus 2017, Proc. R. Soc. B 284: 20170308; see Data/AntMimic): a slender,\n-- glossy dark brown-black body (DOC), the cephalothorax pinched into a \"head\" and a \"thorax\" (DOC), the abdomen joined by a narrow waist\n-- like an ant's petiole, with an oval \"gaster\" behind it (DOC), and long thin legs (DOC). It keeps a jumping spider's eight eyes with the big\n-- pair in front: take away the ant's body and it is a salticid. The playbacks' body length was 5 mm (DOC), so the drawn spider is 0.5 studs\n-- (1 stud = 1 cm). The exact colours, proportions, thicknesses and angles are ART. The male (huge forward chelicerae) is a possible later variant.\n-- Collider, senses and physics are the first spider's: this is a drawn appearance, an antennae pose and a drawn wobble, nothing more.\nlocal ant = {\n\tid = \"myrmarachne_formicaria_female\",\n\tname = \"Ant-mimicking spider (female)\",\n\tscale = 0.5, -- SpiderRig scales its own distances (foot search, stepping) by this\n\t-- ROBLOX-114 (to scale): the drawn size at each growth stage (SpiderRig.growthScale): the body is 4.9 mm at 1, so at Growth.SCALES the adult was 7.4 mm, past\n\t-- the species' 5 to 6.5 mm (Arachnologische Gesellschaft, European Spider of the Year 2019); now the adult is 6.0 mm and the younger stages 4.1, 4.6 and 5.3 mm.\n\tgrowth = { 0.82, 0.94, 1.08, 1.22 },\n\tcameraScale = 0.6, -- closer framing for the small appearance; user zoom still applies\n\tbodyDrop = 0.19, -- the drawn body sits this far (studs) below the collider's centre (0.31 over the surface): long legs, the body well off the floor\n\n\t-- ---------------------------------------------------------------- colours (ART)\n\tbody = { 0.050, 0.030, 0.022 }, -- the head: glossy dark brown-black\n\tlegs = { 0.20, 0.115, 0.055 }, -- amber-brown legs\n\twhite = { 0.50, 0.36, 0.18 }, -- palp bands: a dull amber (no white on this spider)\n\teyes = { 0.008, 0.008, 0.008 },\n\tfangs = { 0.12, 0.060, 0.030 },\n\tjoint = { 0.11, 0.065, 0.035 },\n\tpalpColors = { stalk = { 0.18, 0.10, 0.05 }, club = { 0.30, 0.18, 0.08 }, tip = { 0.42, 0.28, 0.12 } },\n\tabdomenColor = { 0.068, 0.040, 0.027 }, -- the gaster: a shade warmer than the head, so the three segments read apart\n\tgloss = 0.16, -- glossy cuticle (Reflectance on the body segments)\n\n\t-- ---------------------------------------------------------------- proportions: head, thorax, waist, gaster (body frame: -Z forward)\n\theadCenter = { 0, 0, -0.165 },\n\theadRadii = { 0.072, 0.062, 0.080 },\n\tabdomenCenter = { 0, 0.004, 0.145 },\n\tabdomenRadii = { 0.058, 0.052, 0.105 },\n\tpedicel = { center = { 0, 0.0, 0.041 }, radii = { 0.021, 0.021, 0.024 } },\n\tface = { center = { 0, -0.012, -0.205 }, radii = { 0.050, 0.040, 0.040 } },\n\tneck = { 0, 0, -0.095 }, -- the head tilts about this point\n\t-- More body segments the first spiders do not have: the thorax behind the head (the pinch between them is the \"neck\" of an ant's silhouette)\n\t-- and the node on the waist (the petiole). group: \"body\", \"head\" or \"abdomen\" (what they move with).\n\textras = {\n\t\t{ name = \"Thorax\", center = { 0, 0.004, -0.040 }, radii = { 0.056, 0.052, 0.074 }, group = \"body\", color = { 0.125, 0.070, 0.038 } },\n\t\t{ name = \"PetioleNode\", center = { 0, 0.020, 0.046 }, radii = { 0.016, 0.019, 0.015 }, group = \"body\", color = { 0.085, 0.048, 0.028 } },\n\t},\n\tchelicerae = { x = 0.016, y = -0.040, z = -0.234, radii = { 0.013, 0.019, 0.013 }, pitch = -0.35, splay = 0.12, reflectance = 0.1 }, -- the female's are small\n\t-- Eyes, as a jumping spider's: the big principal pair in front (a second look shows a spider), two smaller pairs at the sides and on the dome.\n\teye = {\n\t\tame = {\n\t\t\tx = 0.032, y = 0.012, radii = { 0.029, 0.029, 0.025 }, out = 0.30, reflectance = 0.5,\n\t\t\tsocket = { scale = 1.12, color = { 0.20, 0.115, 0.05 } },\n\t\t\tglints = { { dx = 0.009, dy = 0.011, r = 0.0075 }, { dx = -0.009, dy = -0.011, r = 0.0033 } },\n\t\t},\n\t\tale = { x = 0.055, y = 0.020, r = 0.014, out = 0.15, reflectance = 0.3 },\n\t\tple = { x = 0.050, z = -0.130, r = 0.016, out = 0.10, reflectance = 0.3 },\n\t\tpme = { x = 0.036, z = -0.190, r = 0.006, out = 0.10, reflectance = 0.3 },\n\t\tglintColor = { 1, 1, 1 },\n\t},\n\tpalp = {\n\t\tx = 0.030, y = -0.030,\n\t\tdrop = 0.022, reach = 0.004, spread = 0.008, offsetScale = 0.25, -- the club and tip sit closer to the stalk at this size\n\t\tstalk = 0.011, club = { 0.013, 0.012, 0.016 }, tipRadii = { 0.0085, 0.0075, 0.0085 },\n\t\tfluff = { hairs = 0, length = 0, width = 0, flat = 1, transparency = 0 },\n\t\tdrumHz = 3.2, drumDeg = 13,\n\t},\n\t-- Legs (display only): long and thin, standing the body well off the floor, spread like an ant's.\n\tlimbs = {\n\t\thipX = 0.040, hipY = -0.010,\n\t\thipZ = { -0.115, -0.070, -0.025, 0.020 },\n\t\ttipZ = { -0.27, -0.13, 0.09, 0.27 },\n\t\tdiameters = { { 0.020, 0.014 }, { 0.019, 0.013 }, { 0.019, 0.013 }, { 0.020, 0.014 } },\n\t\tthickness = 1.0,\n\t\tstance = { x = 0.24, y = -0.12, reach = 1.0 }, -- the rest foot spot (the drop of 0.19 puts it on the surface)\n\t\tkneeLift = 0.15, kneeLiftAir = 0.10, ankleLift = 0.02,\n\t\tpad = 1.6,\n\t\tpairReach = { 1.0, 1.0, 1.0, 1.1 },\n\t},\n\tfrontLegScale = 1.0,\n\tbandFraction = 0.12, -- the amber band on each palp\n\tspeckleCount = 0,\n\tspots = {},\n\tband = { count = 0, step = 0.1, z = 0, rx = 0.01, rz = 0.01 },\n\tspeckle = { from = 0.4, step = 0.1, rx = 0.004, rz = 0.005 },\n\t-- The antennal illusion (DOC: when stationary, legs I are raised above head height and move in phase like ant antennae): where the foot goes\n\t-- (body frame, studs, x mirrored for the left leg) when they are up, when they are up and high (the display key) and at the end of a wave\n\t-- sweep (down and forward). `kneeOut` pushes the knee outward and `kneeUp` lifts it. All ART; Rig/AntMimicPose says how far and how fast.\n\tantennae = {\n\t\tpair = 1,\n\t\tup = { x = 0.075, y = 0.175, z = -0.285 },\n\t\thigh = { x = 0.085, y = 0.225, z = -0.300 },\n\t\tswept = { x = 0.095, y = 0.130, z = -0.335 },\n\t\tkneeOut = 0.030, kneeUp = 0.020,\n\t},\n\n\t-- ---------------------------------------------------------------- no fuzz (sub-pixel at this size), no fan, no idle motion: when still it waves its legs I\n\tfuzz = nil,\n\tidle = {\n\t\triseSeconds = 1.0, fallSeconds = 0.25,\n\t\tbreathe = { period = 3.0, bodyLift = 0, lift = 0, pitchDeg = 0 },\n\t\ttilt = { rollDeg = 0, yawDeg = 0, pitchDeg = 0, periods = { 9.1, 5.3, 11.3, 6.7, 8.3 } },\n\t},\n\t-- Full is for PCs; low is for phones and tablets: no foot balls, no eye sockets, no outline. No leg bands, no hairs at either tier.\n\tdetail = {\n\t\tfull = {\n\t\t\tevery = { lock = 0, guard = 0, fringe = 0, pale = 0, tuft = 0, ruff = 0, palp = 0, leg = 0 },\n\t\t\tshells = 0, speckleEvery = 1, pads = true, sockets = true, idle = false, highlight = true, legBands = false,\n\t\t},\n\t\tlow = {\n\t\t\tevery = { lock = 0, guard = 0, fringe = 0, pale = 0, tuft = 0, ruff = 0, palp = 0, leg = 0 },\n\t\t\tshells = 0, speckleEvery = 1, pads = false, sockets = false, idle = false, highlight = false, legBands = false,\n\t\t},\n\t},\n}\n\n-- ================================================================ the tarantula pack (ROBLOX-81)\n-- Two tarantula costumes on the jumping spider's own body and senses: the Mexican redknee (Brachypelma hamorii) and the Greenbottle blue\n-- (Chromatopelma cyaneopubescens). Perplexity's design (Nathan, 2026-10-18), adapted to the rig: the colours are hers; the shapes are the\n-- first spider's size and build (a real tarantula is five or six centimetres of body, five times the first spider, and would not fit the\n-- crack or the collider, which a costume must not change), so this is a drawn appearance at the first spider's scale and nothing more:\n-- the collider, the motor, the jump, the senses, the silk, the wasp and the rival are the first spider's (SpiderChoice, ROBLOX-81).\n-- Both belong to `pack = \"tarantula_pack\"` and are free, like the peacock spider and the ant mimic (ROBLOX-66): SpiderChoice.locked is the\n-- one place a sale would go. What makes a tarantula in the rig: a broad low carapace (a dark core with a lighter rim, \"CarapaceRim\"), an\n-- ocular tubercle with eight tiny clustered eyes instead of the salticid's big front pair (`tubercle`, Anatomy), thick parallel chelicerae,\n-- leg-like pedipalps, a plump abdomen with its own markings (`marks`), two two-segment spinnerets (extras), stocky legs coloured segment by\n-- segment (`legColors`, `legBands`). Colours are Perplexity's hex values; every size and angle is ART.\nlocal function hex(h: number): { number }\n\treturn { math.floor(h / 65536) / 255, math.floor(h / 256) % 256 / 255, h % 256 / 255 }\nend\n\n-- The parts both share. `o` is what differs between the species (see the two calls below). The first spider is the base so that anything\n-- a tarantula does not say (idle motion, the palp's drum, the body's fuzz knobs) is the first spider's.\n-- A tarantula hangs through the same code as the others (a stretch for the animal: it dangles on silk only when it falls, see ROBLOX-86) but\n-- heavier: a shorter, slower swing and a slower turn.\nlocal tarantulaHang = table.clone(first.hang)\ntarantulaHang.leanDeg = 3.0\ntarantulaHang.sway = { deg = 3.5, period = 2.5, decay = 3.0, across = 0.45 }\ntarantulaHang.spin = { degPerS = 5.0, decay = 6.0 }\n\n-- A tarantula's idle is calm and heavy (ROBLOX-87): a slower breath (0.25 Hz, 2%), no grooming and no turning toward what the player watches, but every\n-- `gap` seconds (after `after` seconds of standing, the first `firstWait` into it) one leg reaches out `out` studs and `lift` up and `along` along the body and\n-- settles again over `seconds`. It keeps the first spider's alarm.\nlocal tarantulaIdle: any = table.clone(first.idle)\ntarantulaIdle.breathe = { period = 4.0, bodyLift = 0.004, lift = 0.010, pitchDeg = 1.6, scale = 0.02, movingShare = 0.35 }\ntarantulaIdle.groom = nil\ntarantulaIdle.attention = nil\ntarantulaIdle.stretch = { after = 4.0, firstWait = { 2, 6 }, gap = { 10, 24 }, seconds = 3.0, out = 0.16, lift = 0.05, along = 0.16, kneeUp = 0.07 }\n\nlocal function tarantula(o: any): any\n\tlocal apex = 0.285 + o.abdomenRadii[3] -- the abdomen's rear tip (its centre is at z = 0.285)\n\tlocal limbs = table.clone(first.limbs)\n\tlimbs.hipX, limbs.hipZ, limbs.tipZ = 0.20, { -0.30, -0.20, -0.10, -0.01 }, { -0.76, -0.50, 0.10, 0.58 }\n\tlimbs.thickness = o.legThickness\n\tlimbs.stance = { x = 0.80, y = -0.22, reach = 0.92 } -- the body sits 0.09 under the collider's centre, so the rest foot spot is this far under it\n\tlimbs.kneeLift, limbs.kneeLiftAir, limbs.ankleLift, limbs.pad = 0.22, 0.18, 0.04, 1.5\n\tlocal p = {\n\t\tid = o.id, name = o.name, pack = \"tarantula_pack\", gloss = o.gloss, legGloss = o.legGloss, outline = hex(0xE8E4DA),\n\t\tbodyDrop = 0.09, -- the drawn body sits this far (studs) under the collider's centre: low to the floor\n\t\tbody = hex(o.core), legs = hex(o.leg), white = hex(o.palpBand), eyes = { 0.006, 0.006, 0.006 }, fangs = hex(o.fangs), joint = hex(o.leg),\n\t\tabdomenColor = hex(o.abdomen),\n\t\tpalpColors = { stalk = hex(o.leg), club = hex(o.leg), tip = hex(o.palpTip) },\n\t\tlegColors = { femur = hex(o.femur), tibia = hex(o.tibia), tarsus = hex(o.tarsus), knee = hex(o.knee), ankle = hex(o.ankle) },\n\t\t-- A broad low carapace: the dark core (Cephalothorax) with a wider, flatter rim under it (CarapaceRim, an extra) that shows round its edge.\n\t\theadCenter = { 0, 0, -0.18 }, headRadii = o.headRadii,\n\t\tabdomenCenter = { 0, 0.035, 0.285 }, abdomenRadii = o.abdomenRadii,\n\t\tpedicel = { center = { 0, -0.02, 0.04 }, radii = { 0.07, 0.06, 0.07 } },\n\t\tface = { center = { 0, -0.02, -0.36 }, radii = { 0.20, 0.09, 0.12 } },\n\t\tneck = { 0, 0, -0.04 },\n\t\t-- The ocular tubercle: a small mound on the carapace with eight tiny glossy eyes clustered on it. `eyes` are x (to the right), z (from\n\t\t-- the mound's centre) and the bead's radius, for the right side; the left is the mirror. The first of each side carries a catchlight.\n\t\ttubercle = {\n\t\t\tcenter = { 0, 0.125, -0.29 }, radii = { 0.085, 0.060, 0.075 }, color = hex(o.tubercle), reflectance = 0.12,\n\t\t\teyes = { { x = 0.020, z = -0.040, r = 0.021 }, { x = 0.050, z = -0.022, r = 0.018 }, { x = 0.022, z = -0.008, r = 0.015 }, { x = 0.052, z = 0.016, r = 0.017 } },\n\t\t\tglint = { dx = 0.006, dy = 0.007, r = 0.0075 }, eyeReflectance = 0.5,\n\t\t},\n\t\t-- Thick, parallel, forward-and-down fangs (about 1.3 times the first spider's), set wide, not splayed.\n\t\tchelicerae = { x = 0.075, y = -0.10, z = -0.49, radii = { 0.065, 0.094, 0.058 }, pitch = 0.30, splay = 0, reflectance = 0.1 },\n\t\teye = { glintColor = { 1, 1, 1 } },\n\t\t-- Leg-like pedipalps: about 1.45 times the first spider's palp in length, thick, with a patella band (the palp band is the `white`).\n\t\tpalp = {\n\t\t\tx = 0.12, y = -0.03, drop = 0.147, reach = 0.152, spread = 0.049, stalk = 0.062, club = { 0.050, 0.048, 0.060 }, tipRadii = { 0.035, 0.030, 0.035 },\n\t\t\tfluff = { hairs = 0, length = 0, width = 0, flat = 1, transparency = 0 }, drumHz = 3.2, drumDeg = 13,\n\t\t},\n\t\tlimbs = limbs,\n\t\t-- ROBLOX-84: the legs and palps are drawn as the segments a tarantula has (see `legForm` on the first spider). The femur tapers, the knee is\n\t\t-- a stout patella (the redknee's orange lives on it), the tarsus has a break (a ball on the rod, no second rod: the budget is 150 parts),\n\t\t-- and each foot is a broad, rounder scopula pad of dark velvet (ROBLOX-85: its bristles are the legs' own, on the tarsus, and the pad has none\n\t\t-- of its own). The palps, which are drawn 1.45 times as long, taper the same way.\n\t\tlegForm = {\n\t\t\tfemur = { split = 0.58, taper = 0.74 },\n\t\t\tpatella = { length = 1.30, width = 1.20 },\n\t\t\ttarsus = { split = 0.55, joint = 1.20, bend = 0 },\n\t\t\tfoot = { rx = 0.80, ry = 0.58, rz = 0.92 },\n\t\t},\n\t\tpalpForm = { split = 0.58, taper = 0.78 },\n\t\t-- Larger fangs than the first spider's, one segment each, under the chelicerae and pointing forward (and a little down).\n\t\tfang = { x = 0.075, y = -0.175, z = -0.525, reflectance = 0.2, color = hex(0x2B1A12), segments = { { dir = { -0.04, -0.34, -0.94 }, length = 0.105, radius = 0.019 } } },\n\t\tfrontLegScale = o.frontLegScale or 1.1, -- (the greenbottle's first legs are a tenth heavier again: ROBLOX-93)\n\t\tbandFraction = o.bandFraction,\n\t\tspeckleCount = 0, spots = {}, band = { count = 0, step = 0.1, z = 0, rx = 0.01, rz = 0.01 }, speckle = { from = 0.4, step = 0.1, rx = 0.004, rz = 0.005 },\n\t\t-- Bodies in addition to the first spider's four: the rim, and two spinnerets of two segments behind the abdomen (the second segment is full\n\t\t-- detail only). `sweep` names the segment: the silk-mat pose (ROBLOX-82) swings them about the abdomen's rear.\n\t\textras = {\n\t\t\t{ name = \"CarapaceRim\", center = { 0, -0.035 + o.rimUp, -0.18 }, radii = o.rimRadii, group = \"head\", color = hex(o.rim) },\n\t\t\t{ name = \"Spinneret\", center = { -0.045, 0.02, apex + 0.01 }, radii = { 0.022, 0.020, 0.055 }, group = \"abdomen\", color = hex(o.spinneret), sweep = 1 },\n\t\t\t{ name = \"Spinneret\", center = { 0.045, 0.02, apex + 0.01 }, radii = { 0.022, 0.020, 0.055 }, group = \"abdomen\", color = hex(o.spinneret), sweep = 1 },\n\t\t\t{ name = \"SpinneretTip\", center = { -0.045, 0.01, apex + 0.085 }, radii = { 0.016, 0.015, 0.045 }, group = \"abdomen\", color = hex(o.spinneret), sweep = 2, fullOnly = true },\n\t\t\t{ name = \"SpinneretTip\", center = { 0.045, 0.01, apex + 0.085 }, radii = { 0.016, 0.015, 0.045 }, group = \"abdomen\", color = hex(o.spinneret), sweep = 2, fullOnly = true },\n\t\t},\n\t\tmarks = o.marks,\n\t\t-- The threat display and silk mat (Rig/TarantulaPose says how far and how fast; Data/Tarantula has the numbers): where legs I go when\n\t\t-- they are raised (body frame of the reared prosoma, studs, x mirrored for the left leg), how far the knee goes out and up, how much\n\t\t-- the raised feet tremble, how much farther the second spinneret segment swings than the first, and how far inside the abdomen's rear\n\t\t-- tip the spinnerets swing from. All ART.\n\t\tthreat = { pair = 1, up = { x = 0.42, y = 0.28, z = -0.60 }, kneeOut = 0.10, kneeUp = 0.12, tremor = 0.015, tipSweep = 1.4, sweepBack = 0.05 },\n\t\t-- ROBLOX-85: a tarantula IS its velvet. A fur shell per body mass: a slightly larger, partly transparent copy of the carapace and of the abdomen\n\t\t-- in the Fabric material, in the colour of the fur (`velvet`; the head's shell stops short of the tubercle's eyes). `cluster` is the redknee's\n\t\t-- urticating patch drawn as a denser tuft of ginger-rust hairs. The bristles are the legs' fringe: short rods standing out from the sides of\n\t\t-- each segment and leaning toward the foot (`lift`: degrees off the leg; `edge`: where round the leg, degrees from the top), `legPairs` of\n\t\t-- them on the femur, tibia and tarsus of each pair of legs, the front pair's the most; full detail only. All ART.\n\t\tvelvet = { head = { color = hex(o.velvetHead), scale = 1.07, transparency = o.velvetShade }, abdomen = { color = hex(o.velvetAbdomen), scale = 1.075, transparency = o.velvetShade } },\n\t\tcluster = o.cluster,\n\t\tfuzz = {\n\t\t\tenabled = true, legsOnly = true, legTone = \"frost\",\n\t\t\tblack = { 0.03, 0.03, 0.03 }, dark = { 0.13, 0.13, 0.13 }, grey = { 0.5, 0.5, 0.48 }, frost = hex(o.bristle), shellColor = { 0.08, 0.08, 0.08 }, shells = {},\n\t\t\tlegHairs = { 0, 0, 0 }, legPairs = o.legPairs, legLength = 0.080, legWidth = 0.009, legTransparency = 0.1, legBlack = 0,\n\t\t\tlegLift = { 32, 48 }, legEdge = { 50, 115 }, legSpan = { 0.12, 0.74 },\n\t\t},\n\t\tidle = tarantulaIdle,\n\t\thang = tarantulaHang,\n\t\tdetail = {\n\t\t\tfull = {\n\t\t\t\tevery = { lock = 1, guard = 1, fringe = 1, pale = 1, tuft = 1, ruff = 1, palp = 1, leg = 1 },\n\t\t\t\tshells = 0, speckleEvery = 1, pads = true, sockets = false, idle = true, highlight = true,\n\t\t\t\ttaper = true, jointBreak = true, fangSegments = 1, velvet = true, cluster = true,\n\t\t\t},\n\t\t\tlow = {\n\t\t\t\tevery = { lock = 0, guard = 0, fringe = 0, pale = 0, tuft = 0, ruff = 0, palp = 0, leg = 0 },\n\t\t\t\tshells = 0, speckleEvery = 1, pads = false, sockets = false, idle = false, highlight = false,\n\t\t\t\tfangSegments = 1, velvet = true, cluster = false,\n\t\t\t},\n\t\t},\n\t}\n\treturn p\nend\n\n-- Brachypelma hamorii, the Mexican redknee: velvet black-brown with copper-orange on the carapace's rim, flame-orange patellae (the \"knees\"), a\n-- warm pale-orange band on each tibia, dark feet, and a ginger-rust patch of urticating hair at the abdomen's dorsal rear. Stocky.\nlocal redknee = tarantula({\n\tid = \"brachypelma_hamorii\", name = \"Mexican redknee (Brachypelma hamorii)\",\n\tcore = 0x1A1614, rim = 0xD67638, tubercle = 0x1A1614, abdomen = 0x161312, spinneret = 0x1E1816, fangs = 0x1C1310,\n\tleg = 0x181413, femur = 0x0E0C0B, tibia = 0x181413, tarsus = 0x181413, knee = 0xEE5E22, ankle = 0x181413, palpBand = 0xEE5E22, palpTip = 0x181413,\n\tgloss = nil, legGloss = nil, legThickness = 1.12 * 1.35, bandFraction = 0.30,\n\theadRadii = { 0.285, 0.140, 0.270 }, rimRadii = { 0.335, 0.122, 0.318 }, rimUp = 0.018, -- the rim stands up a little round the carapace's edge (ROBLOX-85)\n\tabdomenRadii = { 0.290, 0.230, 0.320 },\n\tmarks = {\n\t\t{ name = \"UrticatingPatch\", color = hex(0xBA5028), x = 0, z = 0.42, rx = 0.115, rz = 0.100, angle = 0, height = 0.012, raise = 0.014 }, -- stands out of the velvet shell, not under it\n\t} :: { any },\n\t-- Velvet black-brown shells; the legs' bristles a warm ginger-brown, thinner behind than before; the patch's hairs ginger-rust, a third paler.\n\tvelvetHead = 0x2A211C, velvetAbdomen = 0x231B18, velvetShade = 0.45, bristle = 0xA8683C,\n\tlegPairs = { { 3, 2, 1 }, { 2, 2, 0 }, { 1, 1, 0 }, { 1, 1, 0 } },\n\tcluster = { mark = \"UrticatingPatch\", hairs = 8, length = { 0.045, 0.065 }, lift = { 28, 42 }, yaw = 20, width = 0.009, flat = 0.9, transparency = 0.05, color = hex(0xB5532A), light = hex(0xD9803F), paler = 0.35 },\n})\nredknee.legBands = { tibia = hex(0xE08642) }\n\n-- Chromatopelma cyaneopubescens, the Greenbottle blue: a teal-green carapace with a sheen and a lighter turquoise rim, deep metallic cobalt legs with\n-- brighter azure joint rings and pale blue-white bristles, and a burnt-orange abdomen with a dark raised midline and four pairs of softened diagonal\n-- bars. Sleeker than the redknee. The bars fade at the last growth stage (barFade), as a juvenile's pattern does. ROBLOX-85 darkened and\n-- desaturated the legs from the first costume's pure cobalt (#204AA8) to #1E3F8F (Reflectance 0.10), greened the carapace, burnt the abdomen and\n-- softened the bars (see ROBLOX-81 for the first palette and ROBLOX-85 for why).\nlocal greenbottle = tarantula({\n    id = \"chromatopelma_cyaneopubescens\", name = \"Greenbottle blue (Chromatopelma cyaneopubescens)\",\n    core = 0x1E8062, rim = 0x2A9A7E, tubercle = 0x16285C, abdomen = 0xC4551C, spinneret = 0x3A2418, fangs = 0x308E94,\n    leg = 0x1E3F8F, femur = 0x1E3F8F, tibia = 0x1E3F8F, tarsus = 0x1E3F8F, knee = 0x2E62C4, ankle = 0x2E62C4, palpBand = 0x2E62C4, palpTip = 0x2E62C4,\n    gloss = 0.14, legGloss = 0.10, legThickness = 1.12 * 1.15, frontLegScale = 1.1 * 1.1, bandFraction = 0.24,\n    headRadii = { 0.280, 0.120, 0.270 }, rimRadii = { 0.322, 0.105, 0.316 }, rimUp = 0.010,\n    abdomenRadii = { 0.245, 0.195, 0.300 },\n    marks = {\n        -- The dark midline: three raised ridges along the back (thin rod-shaped ellipsoids), a little proud of the fur shell (the middle one alone at low detail), then\n        -- four pairs of diagonal bars (x mirrored), a warm brown now and not near-black, so they are softer on the orange.\n        { name = \"AbdomenMidline\", color = hex(0x2A1C18), x = 0, z = -0.48, rx = 0.0085, rz = 0.080, angle = 0, fullOnly = true, height = 0.010, raise = 0.0065 },\n        { name = \"AbdomenMidline\", color = hex(0x2A1C18), x = 0, z = 0.0, rx = 0.0085, rz = 0.080, angle = 0, height = 0.010, raise = 0.0065 },\n        { name = \"AbdomenMidline\", color = hex(0x2A1C18), x = 0, z = 0.48, rx = 0.0085, rz = 0.080, angle = 0, fullOnly = true, height = 0.010, raise = 0.0065 },\n        { name = \"AbdomenBar\", color = hex(0x5A2A14), x = 0.50, z = -0.36, rx = 0.017, rz = 0.070, angle = 0.70, bar = true, mirror = true },\n        { name = \"AbdomenBar\", color = hex(0x5A2A14), x = 0.54, z = -0.10, rx = 0.017, rz = 0.070, angle = 0.70, bar = true, mirror = true },\n        { name = \"AbdomenBar\", color = hex(0x5A2A14), x = 0.52, z = 0.18, rx = 0.017, rz = 0.070, angle = 0.70, bar = true, mirror = true },\n        { name = \"AbdomenBar\", color = hex(0x5A2A14), x = 0.44, z = 0.44, rx = 0.017, rz = 0.065, angle = 0.70, bar = true, mirror = true },\n    } :: { any },\n    -- Light-teal fuzz on the carapace, burnt-orange fuzz on the abdomen (the shells), and pale blue-white bristles on the legs (not the golden-tan\n    -- of ROBLOX-81: the real animal's long leg hairs read pale blue).\n    velvetHead = 0x35A07F, velvetAbdomen = 0xE0782C, velvetShade = 0.62, bristle = 0xC9DCF2,\n    legPairs = { { 4, 3, 0 }, { 3, 2, 1 }, { 2, 1, 0 }, { 1, 1, 0 } },\n    cluster = nil,\n})\ngreenbottle.legBands = {} -- no pale bands on its legs: the joint rings are its markings\ngreenbottle.barFade = { 0, 0, 0, 0.6 } -- the bars' transparency at each growth stage: the juvenile pattern softens in the adult\n\n-- The peacock spider, the ant-mimicking spider and the rival hang as the first spider does (the rival is a clone of it, as it is; the legs keep\n-- their own lengths, so a small spider hangs as a small one).\nvolans.hang = first.hang\nant.hang = first.hang\n\nlocal Appearances = { default = \"first_spider\", profiles = { first_spider = first, maratus_volans_male = volans, myrmarachne_formicaria_female = ant, rival_spider = rival, brachypelma_hamorii = redknee, chromatopelma_cyaneopubescens = greenbottle, first_spider_male = male } }\n\n-- (ROBLOX-127) The look a mate of `sex` (\"male\" or \"female\") is drawn with when `played` is the played spider's: the first spider's male mate has his own build\n-- (first_spider_male); every other mate is the played spider's own look, as before (ROBLOX-80).\nfunction Appearances.mateLook(played: string, sex: string?): string\n\tif played == \"first_spider\" and sex == \"male\" then return \"first_spider_male\" end\n\treturn played\nend\n\nreturn Appearances\n\n",66100,1305127575},{"Shared/Data/Catch","--!strict\n-- The catch struggle as the game plays it (ROBLOX-72, ROBLOX-77). Game tuning, not measurements; Godot's values (Prey/Feeding's defaults, checked\n-- by the goldens) are untouched and a Feeding that is never given these replays them. Prey/Feeding:useGameRules() and :useRivalRules() apply them.\n-- The struggle: the grip starts at startGrip, drains 0.32 x drainScale x the prey's strength a second plus a jerk (0.12 x jerkScale x strength)\n-- every 0.35 to 0.75 s, each tap adds tapGain, the strength falls from 1 by `tire` over the venom's 6 to 8 s, and the prey is subdued at a grip\n-- of 1 or after `cap` seconds (12; the rival has none).\nlocal Species = require(script.Parent.Species)\n\nlocal Catch = {}\n\n-- Nathan: \"make the tapping a bit easier when catching the fly.\" Godot: startGrip 0.4, tapGain 0.085, jerkScale 1.0.\nCatch.game = {\n\tstartGrip = 0.5,\n\ttapGain = 0.12,\n\tjerkScale = 0.8, -- a jerk takes 0.096 x strength of the grip, not 0.12\n}\n\n-- ROBLOX-77: \"the smaller prey should be easier.\" The struggle scales with the prey's size: the factor is how hard the catch is against the house\n-- fly (1.0, ROBLOX-72's numbers exactly). It is read from the caught profile's body.nutrition (the prey's meal, the one mass-like number a\n-- profile has) against the house fly's, so any future prey profile gets its struggle for free. A factor below 1 is easier: the drain and the\n-- jerks are that much smaller and a tap is worth that much more. The fruit fly (half a meal) is 0.7.\nCatch.size = {\n\tslope = 0.6, -- the factor falls this much for each whole house fly of meal the prey lacks\n\tmin = 0.5, -- (the smallest prey is never a free meal)\n\tmax = 1.6, -- (nor the largest an impossible one)\n}\n\n-- How hard catching `profile` is against the house fly: 1.0 for the house fly, 0.7 for the fruit fly.\n-- ROBLOX-101: a profile whose body names its own `catch_factor` is that hard, whatever its meal (the leafhopper: half a meal that kicks like a house fly).\nfunction Catch.factorFor(profile: any): number\n\tif profile.body.catch_factor ~= nil then\n\t\tlocal z = Catch.size\n\t\treturn math.clamp(profile.body.catch_factor, z.min, z.max)\n\tend\n\tlocal base = Species.fly_like_prototype.body.nutrition\n\tlocal ratio = profile.body.nutrition / base\n\tlocal z = Catch.size\n\treturn math.clamp(1 - z.slope * (1 - ratio), z.min, z.max)\nend\n\n-- The struggle's numbers for a catch of difficulty `factor` (a number from factorFor): Catch.game's startGrip, a tap worth tapGain / factor, a\n-- drain and jerks of factor times as much.\nfunction Catch.scaled(factor: number): { [string]: number }\n\tlocal g = Catch.game\n\treturn {\n\t\tstartGrip = g.startGrip, tapGain = g.tapGain / factor, jerkScale = g.jerkScale * factor,\n\t\tdrainScale = factor, tire = 0.5, cap = 12,\n\t}\nend\n\n-- ROBLOX-77: \"the rival spider should be harder to eat than normal prey, harder tapping mechanic.\" A rival that has been caught (ROBLOX-73's\n-- contest decided that) must still be subdued with the same tapping, and it can tear free. The fly's numbers scaled the other way would have needed 10 or\n-- more taps a second, so the rival has numbers of its own, chosen for how it plays: a firmer start (0.6), each tap worth less than a house fly's (0.085,\n-- Godot's, not 0.12), no cap (it is never subdued by waiting) and, as ROBLOX-88 (\"the rival male should still be harder to take down\") set them, a drain\n-- of 0.7 of the fly's that hardly eases (the rival tires to 0.9 of its strength, not 0.5). Measured on 60 seeded rivals (tests/rival.luau): about 4.5 taps\n-- a second is the edge; 5 a second win in 5.6 to 9.8 s (mean 7.6), 3.5 or fewer a second tear free, 4 a second almost always does, and with no taps it tears\n-- free in 1.65 s (the house fly: 1.15 s, and it is subdued at 12 s whatever). The gentle modes (Catch.forRival(true)) are the house fly's struggle with no cap.\nCatch.rival = {\n\tstartGrip = 0.6,\n\ttapGain = 0.085,\n\tjerkScale = 0.8,\n\tdrainScale = 0.7, -- ROBLOX-88: it was 0.5\n\ttire = 0.1, -- (it was 0.25: the rival hardly weakens, so a thin tapper never catches up)\n\tcap = math.huge,\n}\n\n-- The rival's numbers: the gentle modes get the house fly's struggle (it can still be lost by not tapping, and never harms the player) and, like\n-- the full rival, no cap.\nfunction Catch.forRival(gentle: boolean): { [string]: number }\n\tif gentle then\n\t\tlocal g = Catch.scaled(1)\n\t\tg.cap = math.huge\n\t\treturn g\n\tend\n\tlocal r = Catch.rival\n\treturn {\n\t\tstartGrip = r.startGrip, tapGain = r.tapGain, jerkScale = r.jerkScale, drainScale = r.drainScale, tire = r.tire, cap = r.cap,\n\t}\nend\n\nreturn Catch\n",4563,360966077},{"Shared/Data/Detail","--!strict\n-- Which detail tier a device runs: \"full\" for computers and consoles, \"low\" for touch-only phones and tablets. The tier\n-- decides the spider's fuzz and idle motion (Data/Appearances.detail) and which optional parts of the world stay\n-- (Data/Graphics, Client/WorldDetail). A Workspace attribute `Detail` = \"low\" or \"full\" overrides the device guess, so a\n-- low-powered laptop or a fast tablet can be tried either way without a code change.\nlocal Detail = {}\n\nexport type Tier = \"full\" | \"low\"\n\n-- ROBLOX-108: `console` (GuiService:IsTenFootInterface(): a PlayStation or an Xbox on a television) is the full tier, whatever else the device reports. A console\n-- is no phone: Nathan plays the game on a PlayStation, and the look was judged on that television. A console has no touch screen, so this was already the answer\n-- the touch rule gave; it is said here so that a console reporting touch (a controller with a touch pad) is never taken for a phone. The Detail attribute still wins.\nfunction Detail.choose(touchOnly: boolean, override: unknown, console: boolean?): Tier\n\tif override == \"low\" then return \"low\" end\n\tif override == \"full\" then return \"full\" end\n\tif console == true then return \"full\" end\n\treturn if touchOnly then \"low\" else \"full\"\nend\n\nreturn Detail\n",1282,1712176071},{"Shared/Data/Eyes","--!strict\n-- The numbers of the spider-eye picture (ROBLOX-20): how each way of seeing looks, how the two retinae move, how the lateral\n-- eyes' sense of movement is drawn and what is shown the first time. Shared/UI/EyeOptics works the pictures out from these and\n-- Client/SpiderEyes draws them. Presentation only: nothing here reaches the senses, the motor, the jump planner, the aim ray or\n-- where the camera stands. A number that is a choice and not a measurement says so. Nothing here has been seen in Roblox Studio.\n--\n-- What the picture leans on (related species, not measured in the player's Phidippus audax unless a line says so):\n--   * The principal eyes (anterior median, AM) are the high-acuity telephoto pair with a tiny field: the fovea-based field is\n--     0.8 degrees (Portia fimbriata) to 5 degrees (Metaphidippus aeneolus) wide and up to 20 degrees tall (Shepeleva 2022,\n--     Vision 6(1):2, summarising Land 1969). Each retina is a narrow boomerang- or V-shaped strip moved by three pairs of\n--     muscles (side to side, up and down, rotation), so the sharp strip scans a target while the lens stays put (Land 1969,\n--     J. Exp. Biol. 51, doi:10.1242/jeb.51.2.471). The retina has four layers, and distance is judged from how defocused the\n--     image is on them (Nagata et al. 2012, Science 335:469-471).\n--   * The principal eyes of Phidippus have a UV receptor (about 370 nm) and a green one (about 525-532 nm): possibly\n--     dichromatic colour vision (DeVoe 1975, J. Gen. Physiol. 66:193-207, Phidippus regius). Several species studied lack a red\n--     receptor, so red would look like dark, low-luminance green (Glenszczyk et al. 2022, Sci. Nat. 109:6, Saitis barbipes).\n--   * The secondary eyes are the anterior lateral (ALE), the posterior median (often vestigial) and the posterior lateral (PLE).\n--     Together they cover about 330 degrees horizontally (Trite planiceps; Shepeleva 2022). Their acuity is much lower (ALE 0.3-1.3\n--     cycles per degree, PLE 0.3-0.6) than the AM eyes' (up to 12.5, Portia), and their photoreceptors are almost entirely\n--     green-sensitive. The ALEs detect motion and trigger the turn toward it (Zurek et al. 2010, J. Exp. Biol. 213:2372-2378,\n--     doi:10.1242/jeb.042382); the PLEs are wide-angle motion detectors.\n-- What it does not claim: a spider's colour experience, the receptor responses of this species, or the all-round field. The\n-- ultraviolet layer is authored decor shown only through the principal eyes, an illustration and not a measured reflectance\n-- (docs/VISION_RESEARCH.md, EYE-14, still applies to prey, glass and leaves). The sensor's own peripheral cone (Species,\n-- peripheral_cone_degrees 300) is narrower than the anatomical 330 degrees: the shimmer shows what the sensor found.\n\n-- Player-feedback revision: simultaneous central colour and muted surround. The four neutral\n-- edge gradients are a contrast/colour wash, NOT a true regional desaturation shader or blur.\n-- Roblox BlurEffect is global, so it is disabled to keep the centre clear. The centre is a\n-- readable approximation of combined principal-eye sampling, not a human fovea or measured\n-- angular boundary. Focus still narrows the view; retina strips and motion cues remain.\n-- The historical optical-model descriptions below refer to the earlier whole-screen blend.\nlocal Eyes = {}\n\nEyes.sources = {\n\tland1969 = \"Land 1969, Movements of the retinae of jumping spiders in response to visual stimuli, J. Exp. Biol. 51 (doi:10.1242/jeb.51.2.471)\",\n\tshepeleva2022 = \"Shepeleva 2022, Vision 6(1):2 (summarising Land 1969 and others)\",\n\tnagata2012 = \"Nagata et al. 2012, Science 335:469-471 (depth from image defocus between retinal layers)\",\n\tdevoe1975 = \"DeVoe 1975, J. Gen. Physiol. 66:193-207 (UV and green receptors in the principal eyes of Phidippus regius)\",\n\tglenszczyk2022 = \"Glenszczyk et al. 2022, Sci. Nat. 109:6 (no red receptor in Saitis barbipes)\",\n\tzurek2010 = \"Zurek et al. 2010, J. Exp. Biol. 213:2372-2378 (the anterior lateral eyes detect motion and trigger the turn)\",\n}\n\n-- ---------------------------------------------------------------- the two ways of seeing (k = 0 and k = 1)\n-- Everything that depends on k is listed here for both ends; EyeOptics.profile blends every number by k (the field of view in\n-- tangent space, so the zoom looks even).\n-- Side eyes (k = 0): a wide view, almost one colour, a little blurred, and loosely focused. The field of view is a choice: a flat\n-- screen cannot show about 330 degrees, so it is a wide 90 degrees vertical. Saturation -0.85 and a clear green tint stand for\n-- receptors that are almost all green-sensitive: one kind of receptor, so one colour. Roblox does not document whether the tint\n-- is applied before or after the saturation; at -0.85 either order leaves a green picture (tint last: green monochrome; tint\n-- first: reds already darkened, then mostly grey with a green cast). Judge it in Studio and tune here. The blur is far gentler than the measured acuity ratio (about 10 to 40 times lower than the\n-- AM eyes), so the sill stays readable; it never touches the GUI. The loose depth of field (far 0.35, near 0.25, in focus out to at\n-- least 6 studs or 0.6 of the distance looked at) says only that nothing is sharp.\n-- Principal eyes (k = 1): a narrow telephoto view, sharp, in green and ultraviolet, with only the looked-at distance in focus\n-- (depth from defocus, Nagata 2012). 24 degrees is a choice: just wider than the 20 degrees a retina is tall. The tint cuts red\n-- (115 of 255), so reds go dark as for a green-and-UV dichromat; blue is kept as the stand-in for the short-wave (UV) receptor. That\n-- is an illustration, not a spectral response. The depth of field is tight (far 0.75, near 0.6, in focus within 0.12 of the\n-- distance looked at, never less than 0.6 stud).\n-- The retina strips' stroke is faint while the side eyes look and a little stronger once the principal eyes do; `sweepDeg` and `torsionDeg`\n-- are how far each strip swings side to side and turns about its middle (scanning with the side eyes, small tracking movements\n-- with the principal eyes). The vignette is the telephoto dark edge, as an opacity at the screen's edge.\nEyes.side = {\n\tfovDeg = 90,\n\tsaturation = 0.15, tint = { 115, 255, 236 }, contrast = 0.12, brightness = 0.03,\n\tblur = 0,\n\tdofFar = 0.35, dofNear = 0.25, dofRadiusMin = 6, dofRadiusPerStud = 0.6,\n\tstrokeTransparency = 0.82, fillTransparency = 0.96,\n\tsweepDeg = 4, torsionDeg = 12,\n\tvignette = 0.65,\n}\nEyes.principal = {\n\tfovDeg = 24,\n\tsaturation = 0.15, tint = { 115, 255, 236 }, contrast = 0.16, brightness = 0.02,\n\tblur = 0,\n\tdofFar = 0.75, dofNear = 0.6, dofRadiusMin = 0.6, dofRadiusPerStud = 0.12,\n\tstrokeTransparency = 0.68, fillTransparency = 0.93, -- fainter than first drawn: zoomed in, the strips are large and frame the target\n\tsweepDeg = 0.6, torsionDeg = 3,\n\tvignette = 0.75,\n}\n\n-- How fast k moves: it runs 0 to 1 in engageSeconds while Focus is held (or toggled on) and back in releaseSeconds. A choice; the\n-- time is a duration, not a time constant, so any frame rate gives the same picture after the same time.\nEyes.timing = { engageSeconds = 0.35, releaseSeconds = 0.5 }\n\n-- Reduced motion (Player attribute ReducedMotion = true): the retinae hold still, the shimmer holds steady, and the zoom stops at\n-- 45 degrees, a gentler change than 90 to 24.\nEyes.reducedMotion = { minFovDeg = 45 }\n\n-- Depth of field follows what is looked at: a ray along the view, at most maxDistance studs, eased with a time constant so the focus\n-- racks from one distance to the next instead of jumping.\nEyes.focus = { maxDistance = 40, tauSeconds = 0.15 }\n\n-- ---------------------------------------------------------------- the retinae\n-- Each strip is drawn at its true angular size for the field of view (widthDeg x heightDeg, from Shepeleva 2022 / Land 1969: the\n-- widest and the tallest reported), offsetDeg either side of the middle, tilted tiltDeg into a shallow V (the boomerang, Land\n-- 1969). Offset and tilt are choices. Scanning (Land 1969: side to side, up and down, rotation) is drawn as a side-to-side sweep\n-- and a turn about the strip's middle: the sweep has a period of sweepSeconds and the second strip follows the first lagSeconds\n-- later in both movements; the turn has a period of torsionSeconds. The amplitudes are in Eyes.side and Eyes.principal. Land's\n-- own periods are slower for the turn (about 5-15 s, up to about 50 degrees; docs/VISION_RESEARCH.md): these are faster and\n-- smaller so that the scanning can be seen within a few seconds. They are presentation values.\nEyes.retina = {\n\twidthDeg = 5, heightDeg = 20, offsetDeg = 3, tiltDeg = 10,\n\tsweepSeconds = 1.7, lagSeconds = 0.3, torsionSeconds = 2.6,\n\tstrokeColor = { 200, 255, 220 }, strokeThickness = 1.5,\n\tfillColor = { 200, 255, 220 },\n\t-- the fill's transparency along the strip, from one end to the other (more see-through toward the ends)\n\tfillRamp = { { 0, 0.6 }, { 0.5, 0 }, { 1, 0.6 } },\n}\n\n-- ---------------------------------------------------------------- the lateral eyes' sense of movement\n-- A thing the sensor's sight-line checks found moving (Sensor.motionSeen, the T13a record the eye picture reads and nothing else\n-- does) gets a ring where it is on screen, pulsing between scaleMin and scaleMax times its apparent size (never less than minPx\n-- across), faded over the sensor's hold (Sensor.MOTION_HOLD_TICKS), and at alpha x insideStripFactor where it lies inside a\n-- retina strip: the principal eyes see form there, the surround sees movement (Zurek 2010; Godot EYE-10). Off screen it shows as a\n-- short arc at the screen's edge toward it. At most maxMovers at once, freshest first. The pulse is at or under the 3 Hz flash\n-- guideline over a small area, and holds steady with reduced motion. The look (light ring with a dark outline so it reads on bright\n-- and dark ground) is a choice.\nEyes.shimmer = {\n\thz = 3, scaleMin = 1.0, scaleMax = 1.6, minPx = 14, maxMovers = 8,\n\talpha = 0.9, insideStripFactor = 0.3,\n\tringColor = { 226, 255, 232 }, ringThickness = 2,\n\tshadowColor = { 8, 20, 12 }, shadowThickness = 1.5, shadowAlpha = 0.6, shadowGrowPx = 2, -- the dark ring sits just outside the light one\n\t-- the edge arc: `segments` short bars `stepDeg` apart along a circle of `radius` px whose outermost point is `inset` px\n\t-- from the screen's edge, in the direction of the thing; alpha breathes with the pulse by `breath`\n\tarc = { inset = 20, radius = 56, segments = 5, stepDeg = 8, length = 10, thickness = 3.5, alpha = 0.85, breath = 0.25 },\n}\n\n-- ---------------------------------------------------------------- the telephoto vignette\n-- Four edge frames, each darkest at the screen's edge and clear toward the middle. The peak opacity is in Eyes.side and\n-- Eyes.principal. `ramp` is the gradient's transparency from the edge inward; the bands are fractions of the screen's height\n-- (top and bottom) and width (left and right).\nEyes.vignette = {\n\tcolor = { 48, 52, 48 },\n\tramp = { { 0, 0 }, { 0.25, 0.35 }, { 0.55, 0.75 }, { 1, 1 } },\n\ttopBottom = 0.38, leftRight = 0.36,\n}\n\n-- ---------------------------------------------------------------- the words, the first time\n-- Shown the first time the eye view is open (for `seconds` of it; leaving pauses it), under the status lines, fading in and out.\n-- %s is \"Hold\" or \"Press\" (a toggled Focus) and then the Focus key or button of the device in use (ControlText).\nEyes.caption = {\n\tseconds = 6, fadeInSeconds = 0.4, fadeOutSeconds = 1.5,\n\tside = \"Spider-eye impression: a clear colour centre, muted edges that still catch movement.\",\n\tprincipal = \"%s %s for the principal eyes: narrow, sharp, telephoto, in green and ultraviolet (shown as violet).\",\n\thold = \"Hold\", toggle = \"Press\",\n}\n\n-- ---------------------------------------------------------------- the ultraviolet layer\n-- Workspace.Decor.UVLayer holds parts drawn only for the principal eyes (flower petal patterns), each fully transparent with a\n-- number attribute UVOpacity (the folder's own is the fallback). In the eye view a part's Transparency is 1 - k x UVOpacity on\n-- this client only; outside it, 1. The folder is looked up at most every lookupSeconds until it exists.\nEyes.uv = { folder = { \"Decor\", \"UVLayer\" }, opacityAttribute = \"UVOpacity\", lookupSeconds = 1 }\n\n-- ---------------------------------------------------------------- where it lives\n-- The overlay sits under the jump reticle, the prompts and the perception HUD (DisplayOrder 4): SpiderHud's screens have the default\n-- order 0, so the overlay's is below that.\nEyes.overlay = { name = \"EyeOverlay\", displayOrder = -5 }\nEyes.effects = { grade = \"EyeGrade\", blur = \"EyeBlur\", dof = \"MacroDOF\" }\n\nreturn Eyes\n",12720,3707977693},{"Shared/Data/Flora","--!strict\n-- The plants of the drawn world: the Pilea on the sill, the trough's planting, and the garden outside the window. Numbers and\n-- names only; Habitat/Plants builds them. Colours are hex, lengths studs (1 stud = 1 cm). Nothing here is solid or queryable, and\n-- nothing here moves a physical piece: a drawn leaf's top is its piece's top, a drawn stem sits inside its piece's box.\n\nlocal Flora = {}\n\n-- ---------------------------------------------------------------- the Pilea (Chinese money plant, \"pancake plant\")\n-- Pilea peperomioides has round, peltate leaves: the stalk joins the blade from below, away from its edge, and the veins fan out\n-- from that point. These pups rooted in a crack of the old sill. Each hidden leaf piece is drawn as a pancake that fills its\n-- footprint with its top at the piece's top, and each stem piece as a round petiole inscribed in its box.\nFlora.pilea = {\n\tplants = {\n\t\t{ leaf = \"leaf_garden\", stem = \"stem_garden\" },\n\t\t{ leaf = \"leaf_high\", stem = \"stem_high\" },\n\t\t{ leaf = \"leaf_west\", stem = \"stem_west\" },\n\t\t{ leaf = \"leaf_middle\", stem = \"stem_middle\" },\n\t\t{ leaf = \"leaf_east\", stem = \"stem_east\" },\n\t},\n\ttip = \"leaf_tip\", -- the dry leaf, drawn as a curled fragment\n\tradius = 1.6, -- corner radius of the pancake, in plan\n\tmaterial = \"SmoothPlastic\",\n\ttop = \"4f7d3a\", rim = \"3e6a31\", under = \"93b56d\", dot = \"bcdca0\", vein = \"86b567\", petiole = \"6a8f45\",\n\trimOut = 0.14, rimDrop = 0.06, rimFoot = 0.05, -- the darker rim band: how far past the blade, how far below its top, how far above its underside\n\tunderOut = 0.02, underBelow = 0.012, underThick = 0.12, -- the lighter underside: past the blade, below it, how thick\n\tdotDiameter = 0.34, dotHeight = 0.012,\n\tveins = { count = 8, width = 0.05, height = 0.008, margin = 0.55, start = 0.22, reach = 0.94, jitter = 0.14 },\n\tfoot = { diameter = 1.7, height = 0.2, color = \"587c3a\" },\n\t-- where each stem meets the sill: dark cracks radiating from it and a pinch of crumbled soil\n\tcracks = { count = 4, length = { 1.3, 3.2 }, width = 0.055, height = 0.004, color = \"3b2f24\", transparency = 0.1 },\n\tcrumbs = { count = 7, size = { 0.12, 0.34 }, spread = 1.5, colors = { \"4a3a2c\", \"5b4838\", \"3f3125\" } },\n\tseed = 5,\n\tdry = {\n\t\tcolor = \"c9a66b\", edge = \"a98250\", curl = \"b8935c\", radius = 0.8,\n\t\tedgeWidth = 0.13, edgeHeight = 0.01, edgeInset = 0.12,\n\t\t-- curled-up corners: where (x, z), how far the plate turns about the vertical (degrees) and tips up (degrees)\n\t\tcurls = { { x = 27.85, z = -4.0, turn = 35, tip = 24 }, { x = 25.9, z = -2.05, turn = -20, tip = 18 } },\n\t\tcurlSize = { 0.9, 0.04, 0.55 },\n\t},\n}\n\n-- ROBLOX-74: the world's seed (the number the prey, the wasp and the rival draw from, Client/SpiderClient) also scatters the added greenery,\n-- each part of it with a salt of its own, so every player sees the same sill and the tests can pin it.\nFlora.worldSeed = 914\n\n-- ---------------------------------------------------------------- the trough's planting\n-- The soil patch (WindowsillLayout.DECOR \"soil\") is 12 x 6 at (10, 4.61, -4), on the rim slab's top.\n-- Grass: Chet's 14 patches (x, y, z of each tuft's foot; five blades each, the last two fine) and the tufts added in ROBLOX-74. The added ones\n-- are placed from the world's seed in the regions below (y is the surface they stand on; Shapes.clearAt keeps them off pieces, the spawn and the\n-- retreat, and `apart` off each other and the old patches). Each has `blades` blades, the last `fine` of them full-tier only. A tuft grows\n-- between short and lush (`height`), each blade leans (`tilt`, radians), a blade's colour is a mix of two of `colors` times a shade, and some\n-- blades are dry. Lengths are studs (1 stud = 1 cm), so the tallest blade is 1.6 cm.\nFlora.grass = {\n\tcolors = { \"668544\", \"7a9853\", \"91aa65\" },\n\tpatches = {\n\t\t{ 5.2, 4.62, -5.8 }, { 7.0, 4.62, -6.0 }, { 11.6, 4.62, -5.9 }, { 14.9, 4.62, -3.5 },\n\t\t{ 5.3, 4.62, -2.1 }, { 11.4, 4.62, -1.8 }, { -17, 0.02, -9.5 }, { -14, 0.02, 8.8 },\n\t\t{ -8, 0.02, -9.8 }, { -3, 0.02, 9.0 }, { 3, 0.02, 9.5 }, { 19, 0.02, 8.9 }, { 24, 0.02, -9.1 }, { 18, 0.02, -8.8 },\n\t},\n\tmore = {\n\t\tsalt = 1, blades = 4, fine = 2, apart = 0.8,\n\t\theight = { 0.35, 1.6 }, width = { 0.06, 0.1 }, tilt = { 0.08, 0.5 }, shade = { 0.84, 1.14 }, dry = \"a8a468\", dryShare = 0.12,\n\t\tregions = {\n\t\t\t{ name = \"soil\", x0 = 4.6, x1 = 15.4, z0 = -6.5, z1 = -1.6, y = 4.62, n = 5 }, -- the trough's soil\n\t\t\t{ name = \"back\", x0 = -28.0, x1 = 28.0, z0 = -11.9, z1 = -10.3, y = 0.02, n = 6 }, -- along the back wall\n\t\t\t{ name = \"front\", x0 = -28.0, x1 = 28.0, z0 = 10.4, z1 = 11.7, y = 0.02, n = 4 }, -- along the front lip\n\t\t\t{ name = \"east\", x0 = 24.0, x1 = 29.4, z0 = -9.0, z1 = 9.0, y = 0.02, n = 3 }, -- by the right frame\n\t\t\t{ name = \"west\", x0 = -29.4, x1 = -26.0, z0 = -11.0, z1 = 0.5, y = 0.02, n = 2 }, -- by the left frame, north of the retreat\n\t\t},\n\t},\n}\n\n-- Moss on the shaded side (ROBLOX-74): the sun comes in through the window behind the sill, so the trough's room-side face and the foot of the\n-- back wall's room-side face stay in shade. Each patch is a scatter of flattened mounds on a face: its centre point, the face's outward normal,\n-- a radius, how many mounds and how many of them are core (the rest are full-tier). The mounds lie on the face, `mound` as thick as they are wide.\nFlora.moss = {\n\tsalt = 2, size = { 0.3, 0.75 }, mound = 0.33, colors = { \"4f7b34\", \"5f8a3a\", \"6b9b47\", \"476f30\" }, material = \"Plaster\",\n\tpatches = {\n\t\t{ x = 5.9, y = 0.9, z = 0.0, normal = { 0, 0, 1 }, r = 0.9, n = 7, core = 3 }, -- the trough's room-side face\n\t\t{ x = 12.8, y = 0.7, z = 0.0, normal = { 0, 0, 1 }, r = 0.8, n = 7, core = 3 },\n\t\t{ x = -5.5, y = 0.8, z = -12.5, normal = { 0, 0, 1 }, r = 0.7, n = 7, core = 3 }, -- the back wall's foot\n\t\t{ x = 21.0, y = 0.9, z = -12.5, normal = { 0, 0, 1 }, r = 0.8, n = 7, core = 3 },\n\t},\n}\n\n-- Pebbles and bark chips scattered on the sill floor (ROBLOX-74), clear of the pieces, the spawn and the retreat (Shapes.clearAt) and of each other\n-- by `apart`. A pebble is a flattened ellipsoid, a bark chip a thin, slightly tilted slab. `core` of each kind stay in the low tier.\nFlora.litter = {\n\tsalt = 3, apart = 0.8,\n\tarea = { x0 = -29.0, x1 = 29.0, z0 = -11.6, z1 = 11.2 },\n\tpebbles = { count = 14, core = 6, length = { 0.3, 0.85 }, flat = 0.34, colors = { \"b9b6ae\", \"a9aaa6\", \"c8c4b9\", \"9c9a94\", \"d2cfc6\" }, material = \"Plaster\" },\n\tbark = { count = 8, core = 4, length = { 0.5, 1.3 }, width = { 0.25, 0.55 }, thick = { 0.05, 0.1 }, tilt = 0.18, colors = { \"6b4f36\", \"7d5d41\", \"5a432e\", \"86694b\" }, material = \"Wood\" },\n}\n\n-- Two leaves blown in from the garden (ROBLOX-74), lying on the floor: a pointed oval blade with a lighter midrib and a stub of stalk. x, z where\n-- the middle lies, length and width, turn about the vertical and how far one edge is lifted (degrees). The midrib is full-tier.\nFlora.windfall = {\n\titems = {\n\t\t{ x = 8.4, z = 7.2, length = 2.7, width = 1.15, turn = 35, curl = 9, color = \"b4903f\", rib = \"d1b366\" }, -- dry gold\n\t\t{ x = -4.4, z = -9.0, length = 2.2, width = 0.95, turn = -62, curl = 12, color = \"7f8f3f\", rib = \"a8b56a\" }, -- olive, fallen last\n\t},\n\tthick = 0.04, stalk = 0.6, stalkColor = \"7d5c30\", material = \"Fabric\",\n}\n\n-- Morning dew (ROBLOX-74): small translucent Glass droplets on the tips of grass blades, on the rims of the Pilea's leaves and on the fallen\n-- leaves. They are drawn from the world's seed (salt) and follow the clock of the day (Habitat/DayLight.dewAt): they gather through the night\n-- from `formFrom` (20:00) to `fullBy` (05:00), stay until `burnFrom` (07:30) and are gone by `goneBy` (09:30). Each drop has a `lag`, the share\n-- of the dew at which it appears and is gone (0 to `lag`), so they come and go one by one and not all at once.\nFlora.dew = {\n\tsalt = 4, formFrom = 20.0, fullBy = 5.0, burnFrom = 7.5, goneBy = 9.5, step = 0.01,\n\tsize = { 0.07, 0.15 }, flat = 0.8, color = \"eef7f5\", transparency = { 0.28, 0.45 }, reflectance = 0.25, material = \"Glass\", lag = 0.55,\n\tgrass = { chance = 0.8, keepEvery = 2 }, -- the tallest blade of a tuft; every second tuft's drop stays in the low tier\n\tpilea = { perLeaf = 5, keep = 2, inset = 0.4 }, -- around the rim of each of the five green leaves; `keep` of them stay in the low tier\n\twindfall = { perLeaf = 3, inset = 0.25 }, -- full tier only\n}\n\nFlora.planter = {\n\tsoil = \"4a3a2c\", -- the soil's colour (the layout's own 665644 is the old look)\n\tarea = { x0 = 4.3, x1 = 15.7, z0 = -6.7, z1 = -1.3, y = 4.615 }, -- where things may lie on the soil\n\tmottle = { -- damper and drier patches in the soil: x, z, width, depth, colour (full tier)\n\t\t{ x = 6.8, z = -5.3, w = 3.6, d = 1.7, color = \"3d2f24\" }, { x = 12.6, z = -2.6, w = 4.2, d = 1.5, color = \"574433\" },\n\t\t{ x = 9.6, z = -4.6, w = 2.4, d = 1.2, color = \"43352a\" }, { x = 14.4, z = -5.9, w = 2.8, d = 1.0, color = \"534232\" },\n\t},\n\tpebbles = { count = 15, length = { 0.3, 0.8 }, flat = 0.42, colors = { \"b9b6ae\", \"a9aaa6\", \"c8c4b9\", \"9c9a94\", \"d2cfc6\" }, seed = 21 },\n\tmoss = {\n\t\tpatches = { { x = 5.5, z = -2.2, r = 0.8, n = 8 }, { x = 14.7, z = -6.0, r = 0.9, n = 9 }, { x = 9.9, z = -1.7, r = 0.6, n = 6 } },\n\t\tsize = { 0.22, 0.5 }, tall = 0.5, colors = { \"5f8a3a\", \"6b9b47\", \"4f7b34\" }, seed = 22,\n\t},\n\t-- tiny seedlings, under a centimetre tall: two cotyledons on a short stalk\n\tseedlings = { { x = 7.6, z = -4.9, turn = 20 }, { x = 12.2, z = -2.4, turn = -35 }, { x = 14.0, z = -5.2, turn = 70 } },\n\tstalk = 0.5, stalkWidth = 0.05, stalkColor = \"b4d98a\",\n\tcotyledon = { 0.46, 0.05, 0.22 }, cotyledonColor = \"8cc466\", cotyledonRise = 0.1, cotyledonTurn = 28, cotyledonTip = 14,\n\t-- a damp stain above the foot of the trough, and pale salt along its top edge, on all four faces of the trough\n\tstain = {\n\t\tcolor = \"8a482d\", transparency = 0.22, height = 0.9, thickness = 0.012,\n\t\t-- tide marks: from, to (fractions along a face) and how high\n\t\ttide = { { 0.0, 0.34, 1.3 }, { 0.34, 0.71, 1.75 }, { 0.71, 1.0, 1.1 } }, tideColor = \"9a5a38\", tideTransparency = 0.55,\n\t\tsalt = { { 0.06, 0.22 }, { 0.46, 0.62 }, { 0.8, 0.93 } }, saltColor = \"e4d6c0\", saltTransparency = 0.5, saltHeight = 0.07, saltGap = 0.1,\n\t},\n}\n\n-- ---------------------------------------------------------------- the garden outside the window\n-- A weathered window box beyond the wall (its top hides behind the wall's apron), black-eyed Susans (Rudbeckia hirta) in it, and\n-- flowering shrubs further out. None of it can be reached. The view out is placed as seen from the camera's usual spot\n-- (Graphics.view.eye); the box and the flowers stand where they really are.\nFlora.garden = {\n\t-- ROBLOX-95: the window box stands on the stone outer sill (World/Garden's outer_sill: its top is y 0), in two halves either side of the raised sash,\n\t-- so the stone in front of the opening is clear: `boxes` are the halves' x spans, each as solid as it looks (World/Garden's window_box_west and\n\t-- window_box_east, hidden once this drawing exists). It was one box, x -24.5 to 24.5, sunk to y -3.2 when there was nothing outside the glass.\n\tbox = {\n\t\tboxes = { { x0 = -24.5, x1 = -9.5, id = \"window_box_west\" }, { x0 = 9.5, x1 = 24.5, id = \"window_box_east\" } },\n\t\tz0 = -21.8, z1 = -13.62, top = 2.8, bottom = 0,\n\t\tcolor = \"6f8796\", rim = \"7f98a5\", paint = \"c4d0d2\", soil = \"392c21\", soilTop = 2.55, rimWidth = 0.9,\n\t\t-- patches where the paint has lifted: x, z (on the rim and the far board), width, depth\n\t\tpeel = { { -17.0, -21.6, 3.2, 0.6 }, { -12.6, -21.6, 2.4, 0.5 }, { 11.0, -21.6, 4.0, 0.6 }, { 20.5, -13.9, 3.0, 0.5 } },\n\t},\n\t-- Rudbeckia: head centre height y (above the sill), where it stands in the box (x, z), how much the head nods and turns toward the room (degrees), size\n\tflowers = {\n\t\t{ x = -23.2, z = -17.0, y = 5.5, nod = -8, turn = 14, size = 0.9 },\n\t\t{ x = -17.8, z = -15.8, y = 7.0, nod = -12, turn = -10, size = 1.0 },\n\t\t{ x = -12.4, z = -18.6, y = 6.0, nod = -4, turn = 22, size = 1.05 },\n\t\t{ x = -20.4, z = -19.7, y = 4.9, nod = -14, turn = -18, size = 0.95 }, -- (ROBLOX-95: these three stood in the middle, x -5.6, 0.8 and 6.2, where the stone is now clear)\n\t\t{ x = -15.0, z = -15.3, y = 7.7, nod = -9, turn = 6, size = 1.1 },\n\t\t{ x = 15.4, z = -20.0, y = 5.8, nod = -6, turn = -24, size = 1.0 },\n\t\t{ x = 12.6, z = -17.8, y = 7.2, nod = -13, turn = 16, size = 0.9 },\n\t\t{ x = 18.2, z = -16.3, y = 5.1, nod = -10, turn = -8, size = 1.05 },\n\t\t{ x = 23.0, z = -18.4, y = 6.6, nod = -5, turn = -20, size = 0.95 },\n\t},\n\trudbeckia = {\n\t\tpetals = { 12, 14 }, -- how many each head has (12 to 14)\n\t\tpetalLength = 1.25, petalWidth = 0.55, petalThick = 0.07, droop = 9, -- degrees the tips sag away from the viewer\n\t\tpetalColors = { \"f2b705\", \"f6c112\", \"eaa900\" }, disc = \"e09a05\", discOut = 0.45,\n\t\tcentre = 0.42, centreHeight = 0.34, centreColor = \"3b2414\", -- the dome\n\t\tstem = \"5c8a3a\", stemWidth = 0.18, stemBend = 0.45,\n\t\tleaf = \"4c7a33\", leafSize = { 1.7, 0.05, 0.5 },\n\t\t-- the ultraviolet pattern: the outer half of each petal reflects it, the base and the centre absorb it (the classic bullseye)\n\t\tuv = { color = \"b98cff\", opacity = 0.85, rise = 0.03, thick = 0.02 },\n\t\tseed = 100,\n\t},\n\t-- ROBLOX-103 (W3c, Nathan: \"shrubs should be bushes\"): flowering bushes to the ground, standing where they really stand in the garden (world studs: `x`, `z` the\n\t-- middle of the bush on the lawn, `h` its height, `w` its width), sized as garden shrubs are (half a metre to a metre and a half), each a dense rounded crown of\n\t-- leaf clusters over a woody frame whose stems reach the lawn. They stand round the edges where docs/WORLD_MAP_PLAN.md puts them: a hedge line west of the bed\n\t-- (shrub_west, hedge_west) and the flower border east, none over the bed, the wall or a tree's trunk. ROBLOX-95's standards on stems are gone. From the sill\n\t-- their crowns show low in the window, as the shrubs did, and from the garden they are bushes.\n\tshrubs = {\n\t\t-- (ROBLOX-107: the first four stood in the strip beside the bed, x -76, -150, -110 and -215, z -56 to -150, where shrub_west's walkable bushes stand now; they\n\t\t-- moved out along the lawn's west edge and the hedge line, the same sizes and blooms)\n\t\t{ x = -200, z = -235, h = 60, w = 50, bloom = \"pink\" },\n\t\t{ x = -290, z = -250, h = 90, w = 76, bloom = \"white\" },\n\t\t{ x = -450, z = -270, h = 110, w = 100, bloom = \"pink\" },\n\t\t{ x = -370, z = -560, h = 120, w = 110, bloom = \"white\" },\n\t\t{ x = -95, z = -250, h = 105, w = 95, bloom = \"white\" },\n\t\t{ x = 95, z = -60, h = 55, w = 46, bloom = \"pink\" },\n\t\t{ x = 440, z = -330, h = 120, w = 100, bloom = \"pink\" },\n\t\t{ x = -430, z = -420, h = 140, w = 120, bloom = \"white\" },\n\t\t{ x = 430, z = -560, h = 130, w = 110, bloom = \"white\" },\n\t\t{ x = -400, z = -700, h = 150, w = 130, bloom = \"pink\" },\n\t},\n\tshrub = {\n\t\tfoliage = { \"4a6f3c\", \"56804a\", \"3f6334\", \"5b8a4c\" }, sunlit = { \"6f9a52\", \"7fa85c\" }, -- the crown's clusters; the sunlit ones on top\n\t\tpink = { \"f4c7d3\", \"ee9fb9\", \"f9dbe3\", \"e98fae\" }, white = { \"f8f4ec\", \"efe9de\", \"fbfaf5\", \"e6e0d2\" },\n\t\tmaterial = \"LeafyGrass\", -- (PBR leaves at 1 stud = 1 cm: the texture's leaves are about a box or privet leaf's size)\n\t\t-- the crown: one rounded core (both tiers) and `clusters` lumps of leaves over its top and sides, `keep` of them at the low tier; `skirt`: how high above the\n\t\t-- lawn the core's underside is, as a share of the height (the lowest clusters still touch the lawn, the stems show under the skirt)\n\t\tclusters = 8, keep = 3, clusterSize = { 0.34, 0.5 }, skirt = 0.06,\n\t\tblooms = 7, bloomKeep = 2, bloomSize = { 0.07, 0.11 }, -- as a share of the bush's width; on the side facing the house\n\t\t-- the woody frame: `stems` stems from the lawn, splaying up into the crown (`keepStems` at the low tier), `width` of the bush's width thick\n\t\tframe = { stems = 3, keepStems = 2, width = 0.045, reach = 0.5, color = \"5a4632\", material = \"Wood\" },\n\t\tseed = 40,\n\t},\n}\n\nreturn Flora\n",15833,235218951},{"Shared/Data/FlyLook","--!strict\n-- How a fly looks: numbers and names only; Client/FlyBodies builds the parts and places them each frame. A house fly (Musca\n-- domestica) about 0.7 cm long, 1 stud = 1 cm. The prey profile (Data/Species fly_like_prototype) makes no species claim: this is\n-- only how the prototype is drawn. Body frame: -Z forward, +Y up the surface normal, the origin the body's centre, which is where the\n-- fly's position is, `hover` above the surface: the feet stand on y = -hover. Lengths are studs, colours hex, angles degrees. Ellipsoids\n-- are Parts with a SpecialMesh sphere (Roblox forces a Ball part to be a sphere); rods are Cylinder parts, whose axis is X, so their Size\n-- is (length, diameter, diameter).\n\nlocal FlyLook = {}\n\nFlyLook.hover = 0.16 -- the prey profile's body.hover_wu\n\nFlyLook.colors = {\n\teye = \"8a2f1c\", face = \"cfd2cc\", head = \"4a4640\", proboscis = \"3a2b23\",\n\tthorax = \"5b5d58\", stripe = \"23211e\", abdomen = \"7b7266\", dorsal = \"35302a\",\n\tfemur = \"3a332b\", tibia = \"2b2621\", bristle = \"1d1a17\",\n\twing = \"d8e4ea\", vein = \"56463a\", film = \"f0c8ff\", shadow = \"2a241c\",\n} :: { [string]: string }\n\n-- The ellipsoids that are always in place: centre, diameters, turn about x, y, z. The eyes are glossy.\nFlyLook.body = {\n\t{ name = \"Thorax\", color = \"thorax\", at = { 0, 0.02, -0.05 }, size = { 0.27, 0.25, 0.30 } },\n\t{ name = \"Abdomen\", color = \"abdomen\", at = { 0, -0.002, 0.19 }, size = { 0.25, 0.21, 0.35 } },\n\t{ name = \"Head\", color = \"head\", at = { 0, -0.005, -0.28 }, size = { 0.19, 0.16, 0.15 } },\n\t{ name = \"EyeL\", color = \"eye\", reflectance = 0.07, at = { -0.079, 0.012, -0.275 }, size = { 0.12, 0.16, 0.14 } },\n\t{ name = \"EyeR\", color = \"eye\", reflectance = 0.07, at = { 0.079, 0.012, -0.275 }, size = { 0.12, 0.16, 0.14 } },\n\t{ name = \"Face\", color = \"face\", reflectance = 0.06, at = { 0, -0.015, -0.345 }, size = { 0.042, 0.13, 0.045 } }, -- the pale silver stripe between the eyes\n\t{ name = \"Proboscis\", color = \"proboscis\", at = { 0, -0.088, -0.335 }, size = { 0.045, 0.045, 0.12 }, turn = { -30, 0, 0 } }, -- short, pointing forward and down\n} :: { { name: string, color: string, reflectance: number?, at: { number }, size: { number }, turn: { number }? } }\n\n-- Thin dark slices that follow the curve of the ellipsoid `on`, `proud` of it: the thorax's four stripes and the abdomen's dorsal stripe.\n-- x: where across the body, width: how wide.\nFlyLook.proud = 0.002\nFlyLook.slices = {\n\t{ name = \"ThoraxStripe1\", on = \"Thorax\", color = \"stripe\", x = -0.065, width = 0.024 },\n\t{ name = \"ThoraxStripe2\", on = \"Thorax\", color = \"stripe\", x = -0.025, width = 0.02 },\n\t{ name = \"ThoraxStripe3\", on = \"Thorax\", color = \"stripe\", x = 0.025, width = 0.02 },\n\t{ name = \"ThoraxStripe4\", on = \"Thorax\", color = \"stripe\", x = 0.065, width = 0.024 },\n\t{ name = \"DorsalStripe\", on = \"Abdomen\", color = \"dorsal\", x = 0, width = 0.045 },\n} :: { { name: string, on: string, color: string, x: number, width: number } }\n\n-- Six legs of two segments, a femur and a tibia with its foot: hip, knee and foot of the right front, middle and hind leg (the left\n-- ones mirror them), standing and in flight (tucked and trailing). A rod runs `overlap` past the knee at each end so the joint has no gap.\nFlyLook.legs = {\n\tfemur = 0.024, tibia = 0.017, overlap = 0.01,\n\tstand = {\n\t\t{ name = \"Front\", hip = { 0.055, -0.09, -0.16 }, knee = { 0.135, -0.04, -0.24 }, foot = { 0.20, -0.16, -0.31 } },\n\t\t{ name = \"Middle\", hip = { 0.075, -0.09, -0.06 }, knee = { 0.175, -0.035, -0.07 }, foot = { 0.265, -0.16, -0.085 } },\n\t\t{ name = \"Hind\", hip = { 0.07, -0.09, 0.04 }, knee = { 0.155, -0.04, 0.17 }, foot = { 0.225, -0.16, 0.31 } },\n\t},\n\tfly = {\n\t\t{ name = \"Front\", hip = { 0.055, -0.09, -0.16 }, knee = { 0.10, -0.115, -0.24 }, foot = { 0.07, -0.20, -0.29 } },\n\t\t{ name = \"Middle\", hip = { 0.075, -0.09, -0.06 }, knee = { 0.13, -0.13, -0.03 }, foot = { 0.12, -0.21, 0.04 } },\n\t\t{ name = \"Hind\", hip = { 0.07, -0.09, 0.04 }, knee = { 0.105, -0.125, 0.14 }, foot = { 0.085, -0.215, 0.30 } },\n\t},\n} :: { femur: number, tibia: number, overlap: number, stand: { { name: string, hip: { number }, knee: { number }, foot: { number } } }, fly: { { name: string, hip: { number }, knee: { number }, foot: { number } } } }\n\n-- Tiny bristles on the head, the thorax and the abdomen: from a point just inside the body to the tip. Right side; `mirror` adds the left.\nFlyLook.bristles = {\n\tdiameter = 0.007,\n\titems = {\n\t\t-- (ROBLOX-128: the head's, the thorax's rear and the abdomen's pairs gave their six parts to the wings' veins, which show far more at the spider's eye)\n\t\t{ from = { 0.047, 0.124, -0.022 }, to = { 0.066, 0.176, 0.011 }, mirror = true }, -- on the thorax's back\n\t},\n} :: { diameter: number, items: { { from: { number }, to: { number }, mirror: boolean } } }\n\n-- The wings: thin ellipsoids (Glass), each with a dark leading-edge vein (a thin rod along the front, near the edge) and a faint\n-- iridescent film (thin-film interference colours, Shevtsova et al. 2011, PNAS 108:668-673) just above the glass. At rest they are\n-- folded back over the abdomen in a shallow V: from a root on the thorax, `yaw` turned outward from straight back, `pitch` up, `roll`\n-- with the outer edge down. In flight they are replaced by a soft blur: a fan each side, flat, from the root outward and a little\n-- back (`yaw`) for `reach`, `span` across, the outer edge `roll` up, two layers of translucent glass and film; the veins hide.\nFlyLook.wing = {\n\troot = { 0.078, 0.112, -0.10 }, length = 0.60, width = 0.22, thick = 0.006,\n\tyaw = 9, pitch = 4, roll = 5,\n\ttransparency = 0.55, reflectance = 0.1,\n\tvein = { diameter = 0.008, offset = 0.055, from = -0.42, to = 0.40, transparency = 0.2 }, -- from, to: along the wing, as shares of its length from the middle\n\t-- (ROBLOX-128) the venation inside the leading vein, full tier only, at rest only (hidden in the blur): R4+5 out toward the tip, and M1+2 down the middle of the\n\t-- wing with the house fly's sharp bend up toward R4+5 near the margin (BugGuide's Musca note: \"sharply bent vein M1+2 that almost touches vein R4+5 at the wing\n\t-- margin\"). Each a rod on the wing's upper face from (x, z) to (x, z): x across the wing as a share of its half-width (+ toward the leading edge), z along it as a\n\t-- share of its length from the middle (+ toward the tip).\n\tveins = {\n\t\tdiameter = 0.006, transparency = 0.35,\n\t\titems = {\n\t\t\t{ name = \"VeinR45\", from = { 0.05, -0.36 }, to = { 0.12, 0.47 } },\n\t\t\t{ name = \"VeinM1\", from = { -0.22, -0.30 }, to = { -0.30, 0.32 } },\n\t\t\t{ name = \"VeinM2\", from = { -0.30, 0.32 }, to = { 0.07, 0.465 } }, -- the bend\n\t\t},\n\t},\n\tfilm = { rise = 0.004, grow = 0.004, transparency = 0.82 },\n\tfan = {\n\t\treach = 0.36, span = 0.34, roll = 8, yaw = 20, back = 0.02, rise = 0.01, transparency = 0.80, -- the denser blur near the root\n\t\tfilm = { reach = 0.56, span = 0.54, transparency = 0.92 }, -- the fainter blur out to the tips\n\t\tshimmer = { 19, 0.05 }, -- radians per second, radians: the fan trembles a little\n\t},\n}\n\n-- A soft dark oval on the surface under a standing fly stands in for its shadow (the parts cast none): size, how far above the surface.\nFlyLook.shadow = { size = { 0.34, 0.004, 0.70 }, lift = 0.003, transparency = 0.78 }\n\n-- ROBLOX-103 (W3c): how a body moves, pose only (Client/FlyBodies turns the parts it already has; nothing is added). Every sheet may carry a `motion` table;\n-- the house fly's is this one. Lengths are in the body's own units (before the profile's visual_scale), angles radians, rates per second.\n--   gait ...... the legs step while the body walks on a surface: each leg swings about its hip (`swing`, forward and back) and lifts its foot on the forward\n--               stroke (`lift`); a full cycle per `stride` of ground covered, so a slow walker steps slowly and a still one does not step at all. Six legs go\n--               in two tripods (front and hind of one side with the middle of the other); `wave` (the woodlouse's) is a metachronal wave instead, each\n--               pair `wave` behind the one in front. `settle`: how fast the stepping fades in and out (1/s). `jump`: a move longer than this between two\n--               drawings is a hop or a teleport, not a step.\n--   kick ...... in the jaws the legs kick at this rate (Hz).\n--   antenna ... the antennae sway a little about their bases (`amp`, at `hz`).\n--   flap ...... wings that beat visibly (the moth's): the flight fans swing up and down about their roots at `hz`, `amp` either side; without it the fans are\n--               the fly's soft blur that trembles (FlyLook.wing.fan.shimmer).\n--   resettle .. after landing the resting wings shiver for `seconds`, dying away (the moth settling its wings).\n--   wobble .... the body rocks in flight (`roll`, `pitch` at `hz`: the crane fly's unsteady flight); `dangle`: its hanging legs swing fore and aft.\n--   crouch .... a hopper about to leap (startled, its reaction pending) sinks `depth` and tips `pitch` (nose up for the leafhopper's hind-leg spring).\n--   tumble .... turns end over end in a hop (the springtail's somersault), this many turns per hop.\n-- Reduced Motion (the player's setting, as the spider's rig reads it) keeps the stepping, which is how a body gets anywhere, and stills the rest: no sway,\n-- no trembling or beating fan (a still blur), no shiver, no rocking, no crouch, no somersault.\n--   groom ..... (ROBLOX-128) standing calm and still, it grooms in bouts: after `after` seconds and then every `every` (each wait drawn from a hash of the body's id\n--               and the bout's number, never math.random), a bout of `bout` seconds: the front legs drawn in under the head and rubbed together, or the hind\n--               legs drawn back under the abdomen's tip and rubbed together (the drawing's short legs cannot sweep over the wings), the front first (Seeds et al. 2014, eLife 3:e02951: the front legs clean the head, the\n--               hind legs the abdomen and wings, rubbing bouts between; the order of priority front to back). `hz` the rub. A walk, a flight, an alarm or a\n--               scheduled take-off ends a bout at once. The timing is the game's.\n--   ready ..... (ROBLOX-128) a take-off scheduled (its reaction pending), it readies: the body raised `lift` on its legs and tipped `pitch` nose up, the middle legs\n--               swung forward `legs` (Card & Dickinson 2008, Current Biology: a fly sets its middle legs and leans in the 100 ms or so before its escape jump).\nFlyLook.groom = { after = { 2.5, 5 }, every = { 3, 7 }, bout = { 1.2, 2.4 }, hz = 5, amp = 0.16 }\nFlyLook.ready = { lift = 0.03, pitch = 0.16, legs = 0.35 }\nFlyLook.motion = { gait = { stride = 0.36, swing = 0.30, lift = 0.32, settle = 9, jump = 0.6 }, kick = 6, groom = FlyLook.groom, ready = FlyLook.ready }\n-- (ROBLOX-128) The fastest wingbeat drawn as a beat: a fly's wings beat 190 to 330 times a second, a mosquito's 600 and some midges' 1,000 (hypertextbook's\n-- table of wingbeat frequencies, after Chapman and Wigglesworth), and at 60 frames a second anything over half that, 30 Hz, steps backward or stands still on the\n-- screen (it strobes). A sheet's `flap` above BLUR_HZ is drawn as the blur that trembles (FlyLook.wing.fan.shimmer), as the house fly's always was; the moth's 5 Hz\n-- is drawn as a beat.\nFlyLook.BLUR_HZ = 12\n-- ROBLOX-114 (everything to scale): the scale a prey is drawn at. A profile's `visual_scale` is Godot's (golden, never changed here); a kind listed in `trueScale`\n-- is drawn at that instead, because the golden one draws it at a size it is not: the fruit fly at 0.6 is the house fly's 7.3 mm body made 4.4 mm, and Drosophila\n-- melanogaster is about 2.5 mm long (BioNumbers 100750), so it is drawn at 0.4, 2.9 mm. Only the drawing: its collider, its senses and its meal are the profile's.\nFlyLook.trueScale = { fruit_fly = 0.4 } :: { [string]: number }\nfunction FlyLook.drawnScale(profile: any): number\n\tif profile == nil then return 1 end\n\tlocal kind = profile.body.prey_kind\n\treturn (if kind ~= nil then FlyLook.trueScale[kind] else nil) or profile.body.visual_scale or 1\nend\n\n-- The far rule (as the rival's and the mate's rigs, Rig/SpiderRig FAR_STUDS and FAR_SECONDS): a body farther than `studs` from the camera is drawn once every\n-- `seconds` with all the time since; the simulation steps it every tick regardless.\nFlyLook.far = { studs = 25, seconds = 0.1 }\n\n-- ROBLOX-96: the bed's prey, drawn from simpler sheets (Client/FlyBodies.buildSmall) in the same body frame (feet at y = -hover, the whole scaled by the profile's\n-- visual_scale: the gnat at 0.45 is about 3 mm, the aphid at 0.4 under 3 mm). `body`: ellipsoids; `rods`: legs, antennae and the like, a rod from `from` to `to`\n-- on the right side, mirrored when `mirror`, with `fly` endpoints for the flight pose where they differ; `wing`: one pair of plain glass wings (folded flat at rest,\n-- a fan in flight), none for the aphid, which never flies; `shadow` as the fly's.\nFlyLook.small = {\n\t-- a fungus gnat (Sciaridae, the small dark flies of damp soil): a thin grey body, long legs, long antennae, one pair of wings over the back\n\tfungus_gnat = {\n\t\tcolors = { thorax = \"3b3a38\", abdomen = \"4a4744\", head = \"2f2d2b\", eye = \"1a1816\", leg = \"2d2a27\", antenna = \"2a2725\", wing = \"cfd6dc\", shadow = \"2a241c\" },\n\t\tbody = {\n\t\t\t{ name = \"Thorax\", color = \"thorax\", at = { 0, 0.02, -0.06 }, size = { 0.16, 0.17, 0.22 } },\n\t\t\t{ name = \"Abdomen\", color = \"abdomen\", at = { 0, -0.01, 0.2 }, size = { 0.12, 0.12, 0.42 } },\n\t\t\t{ name = \"Head\", color = \"head\", at = { 0, 0, -0.24 }, size = { 0.11, 0.11, 0.1 } },\n\t\t\t{ name = \"EyeL\", color = \"eye\", reflectance = 0.05, at = { -0.05, 0.01, -0.25 }, size = { 0.05, 0.06, 0.05 } },\n\t\t\t{ name = \"EyeR\", color = \"eye\", reflectance = 0.05, at = { 0.05, 0.01, -0.25 }, size = { 0.05, 0.06, 0.05 } },\n\t\t},\n\t\trods = {\n\t\t\t{ name = \"FrontFemur\", color = \"leg\", d = 0.012, from = { 0.05, -0.06, -0.15 }, to = { 0.16, 0.06, -0.26 }, fly = { { 0.05, -0.06, -0.15 }, { 0.09, -0.1, -0.24 } }, mirror = true },\n\t\t\t{ name = \"FrontTibia\", color = \"leg\", d = 0.009, from = { 0.16, 0.06, -0.26 }, to = { 0.26, -0.16, -0.36 }, fly = { { 0.09, -0.1, -0.24 }, { 0.08, -0.2, -0.3 } }, mirror = true },\n\t\t\t{ name = \"MiddleFemur\", color = \"leg\", d = 0.012, from = { 0.06, -0.06, -0.04 }, to = { 0.18, 0.07, -0.02 }, fly = { { 0.06, -0.06, -0.04 }, { 0.1, -0.11, 0.0 } }, mirror = true },\n\t\t\t{ name = \"MiddleTibia\", color = \"leg\", d = 0.009, from = { 0.18, 0.07, -0.02 }, to = { 0.3, -0.16, 0.0 }, fly = { { 0.1, -0.11, 0.0 }, { 0.09