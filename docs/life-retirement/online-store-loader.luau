2, 0.27, -0.34 }, length = 1.5, width = 0.17, thick = 0.006, yaw = 2, pitch = 3, roll = 72,\n\t\t\ttransparency = 0.6, reflectance = 0.1, fan = { reach = 1.25, span = 0.6, roll = 6, yaw = 100, back = 0.05, rise = 0.02, transparency = 0.8 } },\n\t\t{ name = \"Stigma\", color = \"stigma\", material = \"SmoothPlastic\", root = { 0.026, 0.27, 0.95 }, length = 0.08, width = 0.05, thick = 0.008, yaw = 4, pitch = 3, roll = 70,\n\t\t\ttransparency = 0, reflectance = 0, hide = true, full = true },\n\t} :: { any },\n\tshadow = { size = { 0.5, 0.004, 2.6 }, lift = 0.003, transparency = 0.84, full = true },\n\tmotion = { gait = { stride = 0.2, swing = 0.25, lift = 0.25, settle = 8, jump = 0.8 }, kick = 5, antenna = { amp = 0.02, hz = 0.5 }, flap = { hz = 25, amp = 0.5 }, ready = FlyLook.ready },\n}\n\nreturn FlyLook\n",45777,2706099346},{"Shared/Data/Graphics","--!strict\n-- How the world looks, apart from the spider (whose look is Data/Appearances). Numbers and names only, so the whole look can\n-- be tuned in one place: Habitat/Scenery builds the parts from it, Habitat/Lit sets up the lighting and the sky, Habitat/SunPick\n-- finds a sun that shines in through the window, and Client/WorldDetail strips what the low tier does without.\n-- Studs: 1 stud = 1 cm. Colours are hex. Materials are Roblox's own (Habitat/Materials), which carry PBR textures once\n-- MaterialService.Use2022Materials is on (both Rojo projects set it). Nothing here has been seen in Roblox Studio (ROBLOX-14).\n\nlocal Graphics = {}\n\n-- ---------------------------------------------------------------- materials\n-- Looks only: a surface's grip is its profile in Data/Surfaces, never its material.\nGraphics.materials = {\n\t-- the physical pieces of the sill (Habitat/WindowsillLayout.PIECES), by id. SmoothPlastic is clean at any scale: the sill is\n\t-- cream enamel, the leaves are glossy; Roblox's textured materials tile in studs, so at 1 stud = 1 cm they are coarse.\n\tpieces = {\n        cover_bark_west = \"Wood\", cover_bark_east = \"Wood\", cover_leaf_front = \"SmoothPlastic\", cover_rim = \"Wood\",\n\t\tupper_ledge = \"Wood\", garden_step = \"Plaster\",\n\t\tleaf_garden = \"SmoothPlastic\", stem_garden = \"SmoothPlastic\", leaf_high = \"SmoothPlastic\", stem_high = \"SmoothPlastic\",\n\t\tsill_floor = \"SmoothPlastic\", front_lip = \"SmoothPlastic\",\n\t\tback_frame_west = \"Plaster\", back_frame_east = \"Plaster\", back_frame_head = \"Plaster\", back_frame_rail = \"Plaster\", left_frame = \"Plaster\", right_frame = \"Plaster\",\n\t\tplanter = \"Plaster\", planter_rim = \"Plaster\",\n\t\tleaf_west = \"SmoothPlastic\", leaf_middle = \"SmoothPlastic\", leaf_east = \"SmoothPlastic\", leaf_tip = \"Plaster\",\n\t\tstem_west = \"SmoothPlastic\", stem_middle = \"SmoothPlastic\", stem_east = \"SmoothPlastic\",\n\t\tcrevice_back = \"Wood\", crevice_roof = \"Wood\", crevice_north = \"Wood\", crevice_south = \"Wood\",\n\t} :: { [string]: string },\n\tsoil = \"Ground\",\n\t-- Glass hides translucent UV petals behind the pane in native Studio. Preserve tint/reflection without refraction.\n\twall = \"Plaster\", trim = \"SmoothPlastic\", glass = \"SmoothPlastic\",\n\tview = \"SmoothPlastic\", ground = \"Grass\",\n\tchip = \"Wood\", crack = \"SmoothPlastic\", crumb = \"Sand\",\n\tfallback = \"SmoothPlastic\",\n}\n\n-- The colour (and shine) a piece is drawn in when it is not the layout's own colour, which is the frozen Godot habitat's: cream\n-- enamel on the sill, plaster side walls, terracotta, weathered dark wood in the crevice. Looks only. Pieces the drawn Pilea\n-- replaces keep the layout's colours, which show only if the drawing could not be built.\nGraphics.paint = {\n\tsill_floor = { color = \"e8dfcb\", reflectance = 0.03 }, front_lip = { color = \"e8dfcb\", reflectance = 0.03 },\n\tleft_frame = { color = \"efe8d8\" }, right_frame = { color = \"efe8d8\" },\n\tplanter = { color = \"b8653f\" }, planter_rim = { color = \"c97a52\" },\n\tcrevice_back = { color = \"362b20\" }, crevice_roof = { color = \"4a3c2e\" }, crevice_north = { color = \"3f3326\" }, crevice_south = { color = \"3f3326\" },\n} :: { [string]: { color: string, reflectance: number? } }\n\n-- ---------------------------------------------------------------- the window\n-- The back wall is solid, climbable boxes (WindowsillLayout back_frame_*), so the window is drawn: the physical wall turns\n-- invisible (still solid, still climbable) and Scenery draws a plaster wall behind its face with an opening for the glass.\nGraphics.window = {\n\t-- the pieces that turn invisible: the back frame, in four since the lower sash was raised (ROBLOX-95: WindowsillLayout's back_frame_*)\n\thidden = { \"back_frame_west\", \"back_frame_east\", \"back_frame_head\", \"back_frame_rail\" } :: { string },\n\tslabGap = 0.02, -- the drawn wall sits this far behind the climbable face, so the spider's feet never sink into it\n\tleft = -27.5, right = 27.5, bottom = 3, top = 110.5, -- the opening: x from/to, y from/to (ROBLOX-112: the glass up to y 110.5, 13 before: a real window, 1.1 m)\n\t-- ROBLOX-112: the window in true proportion. The frame and the wall round it go up to the head (`head`, y 112.5, where the brick's lintel is) over the back frame's\n\t-- 14, standing in for World/Garden's window box above it (`upper`, the region wall_upper's: hidden once drawn here). The sashes meet at the transom (`transom`, its\n\t-- bottom, `transomH` tall) across all three lights; the middle light's lower sash, raised 6 cm (`opening`), has its top rail that much over the transom, set back\n\t-- in the frame as its bottom rail is, and its glass behind the upper sash's from the transom to there.\n\thead = 112.5, upper = \"wall_upper_window\", transom = 55.5, transomH = 2.5, sashLift = 6,\n\ttrimWidth = 0.5, trimDepth = 0.10, trimReflectance = 0.04, -- the frame bars around the opening, flush with the climbable face; glossy\n\twallColor = \"efe8d8\", trimColor = \"f4efe3\",\n\tglass = { color = \"cfe3e6\", transparency = 0.86, reflectance = 0.12, thickness = 0.04, setback = 0.05 },\n\tmullions = { -10, 10 }, mullionWidth = 0.7, -- bars between the panes\n\t-- ROBLOX-95: the middle lower sash is raised 6 cm. `opening` is the gap it leaves (the layout's own: back_frame_rail's top to back_frame_head's\n\t-- underside, between back_frame_west and back_frame_east), open air from the sill rail up to the sash; the glass over it is gone. The raised sash's\n\t-- bottom rail is drawn across the top of the opening (`sashRail` tall, `sashDepth` deep, set back `sashSetback` from the face), the jambs either side\n\t-- (`jambWidth`) line the cut through the wall, and the sill rail is trim.\n\topening = { left = -8, right = 8, bottom = 0.7, top = 6 },\n\tsashRail = 0.8, sashDepth = 0.45, sashSetback = 0.12, jambWidth = 0.5,\n\t-- WindowsillLayout.DECOR entries Scenery draws itself\n\treplaces = { window_glass = true, mullion_w = true, mullion_e = true } :: { [string]: boolean },\n}\n\n-- ---------------------------------------------------------------- the view out of the window\n-- Items are placed as seen from a reference eye (the camera's usual spot over the middle of the sill): u, v are where the\n-- item's centre appears on the glass (studs across and up), `depth` how far beyond the glass it really is; Scenery turns\n-- that into world positions and sizes, so every item shows where it should whatever the depth. kind \"block\": a box w x h\n-- on the glass, `t` deep; \"ball\": a sphere of diameter w; \"roof\": a gable (a square turned 45 degrees) w wide with its\n-- eave line at v; \"hill\" (ROBLOX-103): a flattened ellipsoid w x h x t; \"trunk\" (ROBLOX-103): a round upright rod w across and h tall. `full`: dropped in the\n-- low tier.\nGraphics.view = {\n\teye = Vector3.new(0, 2.5, 5),\n\t-- ROBLOX-95: the lawn is at the garden's level now, 0.4 below the soil of the bed under the window (World/WorldMap bed_a, y -90), where the house wall\n\t-- meets it; it was at -46 when nothing could be walked outside the glass. Everything below stands on it (the trunks and a house were lengthened to reach it).\n\t-- ROBLOX-114 (everything to scale): `beyond`: a second ground of the same size past the first's far edge (z -1748), under the gardens and the houses across the\n\t-- way, which stand 21 m from this house's back wall now (a part is at most 2,048 studs: one ground could not reach them)\n\tground = { y = -90.4, size = 2048, color = \"7d8f62\", beyond = true },\n\tsky = true,\n\titems = {\n\t\t-- far hills (ROBLOX-103: kind \"hill\", a flattened ellipsoid w x h x t on the glass, low and wide, their feet under the horizon; the middle one shows only over\n\t\t-- the roofs; the balls of before stood inside the garden once it could be walked). ROBLOX-114: 36 m off (27 before), behind the bungalows now that those stand\n\t\t-- 21 m from this house; a part is at most 2,048 studs, so Scenery draws a hill bigger than that as a part of 2,048 with its sphere mesh scaled up. They are\n\t\t-- the near rise of the land beyond the houses, not a range kilometres off (no part could stand that far and be seen), and lower than they were (their tops 1.2\n\t\t-- lower on the glass, their feet where they were): at their old height and 36 m off they stood 9 to 11 m tall over the bungalows' 5 m ridges, a dome, not a rise.\n\t\t{ id = \"hill_w\", kind = \"hill\", u = -20, v = 4.0, depth = 3600, w = 13.2, h = 4.4, t = 13.2, color = \"88a08d\", full = false },\n\t\t{ id = \"hill_m\", kind = \"hill\", u = 2, v = 3.6, depth = 3600, w = 13.2, h = 3.6, t = 13.2, color = \"92a898\", full = true },\n\t\t{ id = \"hill_e\", kind = \"hill\", u = 22, v = 3.9, depth = 3600, w = 13.2, h = 4.4, t = 13.2, color = \"8aa28f\", full = false },\n\t\t-- (ROBLOX-103: the seven tall houses that stood 1.2 m beyond the glass are Graphics.view.across's bungalows beyond the back fence)\n\t\t-- a tree on the left, a smaller one on the right. ROBLOX-103: they stood 72 and 100 studs beyond the glass, lollipops a metre tall just past the bed (the\n\t\t-- standards Nathan's \"bushes\" note was about); now they are real trees in the neighbours' gardens beyond the side fences, 7.4 and 9 m out, the left 5 m tall\n\t\t-- with a crown nearly 5 m across, the right 3.5 m, exactly where they were on the glass; their trunks are round (\"trunk\": a vertical rod w across, h tall).\n\t\t-- ROBLOX-114 (to scale): at their depths a stud on the glass is 43.4 (the left) and 52.4 (the right) in the garden, so the left tree is 7.2 m tall with a crown\n\t\t-- 9.8 m across (an old apple or a field maple) and the right 5.1 m with one 6.3 m across; their trunks were 56 and 47 cm thick, an oak's, and are 33 and 24 cm\n\t\t-- now (w 0.75 and 0.45), a garden tree's trunk for those heights (a judgement from the trees' proportions, not a measured rule: urban trees vary widely,\n\t\t-- Vaz Monteiro, Doick & Handley 2016, Urban Forestry & Urban Greening).\n\t\t{ id = \"trunk_a\", kind = \"trunk\", u = -17, v = 5.43, depth = 742, w = 0.75, h = 10.14, color = \"4a3e30\", full = false },\n\t\t{ id = \"canopy_a1\", kind = \"ball\", u = -17, v = 10.5, depth = 742, w = 11, color = \"3f6238\", full = false },\n\t\t{ id = \"canopy_a2\", kind = \"ball\", u = -23.5, v = 8.5, depth = 742, w = 8.5, color = \"496f40\", full = false },\n\t\t{ id = \"canopy_a3\", kind = \"ball\", u = -10.5, v = 9.0, depth = 742, w = 8, color = \"35552f\", full = true },\n\t\t{ id = \"canopy_a4\", kind = \"ball\", u = -19.5, v = 13.5, depth = 742, w = 7, color = \"446a3b\", full = true },\n\t\t{ id = \"canopy_a5\", kind = \"ball\", u = -13.5, v = 13.2, depth = 742, w = 6.5, color = \"3a5c34\", full = true },\n\t\t{ id = \"canopy_a6\", kind = \"ball\", u = -26, v = 12, depth = 742, w = 6, color = \"4d7544\", full = true },\n\t\t{ id = \"trunk_b\", kind = \"trunk\", u = 18.5, v = 3.96, depth = 900, w = 0.45, h = 6.47, color = \"50443a\", full = true },\n\t\t{ id = \"canopy_b1\", kind = \"ball\", u = 18.5, v = 7.2, depth = 900, w = 6.5, color = \"47703e\", full = true },\n\t\t{ id = \"canopy_b2\", kind = \"ball\", u = 22, v = 6.2, depth = 900, w = 5, color = \"3d6336\", full = true },\n\t\t{ id = \"canopy_b3\", kind = \"ball\", u = 15, v = 6.0, depth = 900, w = 4.5, color = \"4f7746\", full = true },\n\t} :: { { id: string, kind: string, u: number, v: number, depth: number, w: number, h: number?, t: number?, color: string, full: boolean } },\n\t-- ROBLOX-103 (W3c, Nathan: \"the house a single story\"): the houses across the way are bungalows, one storey under a pitched roof, standing where they\n\t-- would really stand, in the garden's own studs: their fronts `front` (z) beyond the back fence, `wall` tall (2.6 m), `depth` deep, the roof's front slope\n\t-- rising at `pitch` degrees from eaves that overhang `overhang` to a ridge over the middle; one row of windows and a door, so nothing reads as a second floor.\n\t-- Each house: `x` its middle, `w` its width, its render and roof colours, how many windows, a door, a chimney (`chimney`: where along the ridge, -0.5 to 0.5).\n\t-- The low tier keeps the walls and the roofs. ROBLOX-114 (to scale): their faces stood 40 cm behind the back fence, as if they had no gardens; they stand at z -2150\n\t-- now, 21 m from this house's back wall (the usual British least distance between facing windows of one- and two-storey houses: Cheshire East\n\t-- Local Plan, policy HOU 13), their gardens 7.3 m deep behind the fence. Ridge 2.6 m + tan 30 x 4.3 m = 5.1 m above the lawn (a bungalow's ridge is about\n\t-- 4.5 to 5.5 m).\n\tacross = {\n\t\tfront = -2150, depth = 800, wall = 260, pitch = 30, overhang = 30, ridgeCap = 14,\n\t\twindow = { w = 120, h = 115, sill = 95, color = \"3c4852\", frame = \"f1ede4\" }, door = { w = 95, h = 205, color = \"5b4636\" },\n\t\tchimney = { w = 55, h = 120, t = 55, color = \"8c5a48\" },\n\t\twallMaterial = \"Plaster\", roofMaterial = \"Slate\",\n\t\thouses = {\n\t\t\t{ id = \"bungalow_1\", x = -680, w = 600, wall = \"d2bf98\", roof = \"7d3b2c\", windows = 2, door = true, chimney = 0.28 },\n\t\t\t{ id = \"bungalow_2\", x = 30, w = 760, wall = \"dccaa4\", roof = \"4c4f57\", windows = 3, door = false, chimney = -0.3 },\n\t\t\t{ id = \"bungalow_3\", x = 720, w = 520, wall = \"c9b48f\", roof = \"8a4532\", windows = 2, door = true },\n\t\t} :: { { id: string, x: number, w: number, wall: string, roof: string, windows: number, door: boolean, chimney: number? } },\n\t},\n\t-- ROBLOX-103: the garden's fences (docs/WORLD_MAP_PLAN.md: 10 m wide, 14 m deep): the back fence at `back` and the two side fences along x `x0`, `x1`, from the\n\t-- house's wall to the back fence, `height` tall (1.8 m), weathered boards; posts along the back (full tier).\n\tfence = { back = -1420, x0 = -500, x1 = 500, near = -24, height = 180, thick = 4, posts = 6, post = 9, color = \"8a6f52\", postColor = \"6f5841\", material = \"WoodPlanks\" },\n}\n\n-- ---------------------------------------------------------------- small details on the sill (full tier only)\n-- Flat or tiny, away from the spawn and the silk practice spot, so the landing patch, the silk lines and the prompts stay clear.\nGraphics.details = {\n\t-- chips in the paint, showing the bare wood: where (x, z), size (w across, d deep), turn in degrees, colour\n\tchips = {\n\t\t{ x = -8.6, z = 10.5, w = 0.62, d = 0.40, turn = 20, color = \"9b7650\" }, { x = -7.7, z = 10.9, w = 0.34, d = 0.27, turn = -35, color = \"8f6b47\" }, { x = -6.6, z = 10.2, w = 0.45, d = 0.30, turn = 70, color = \"9b7650\" },\n\t\t{ x = 11.6, z = 9.8, w = 0.55, d = 0.38, turn = -15, color = \"9b7650\" }, { x = 12.5, z = 10.3, w = 0.30, d = 0.22, turn = 50, color = \"a58058\" }, { x = 24.6, z = 7.9, w = 0.50, d = 0.33, turn = 35, color = \"9b7650\" },\n\t\t{ x = -3.8, z = 5.4, w = 0.36, d = 0.26, turn = -60, color = \"8f6b47\" }, { x = -14.9, z = 8.6, w = 0.58, d = 0.36, turn = 10, color = \"9b7650\" }, { x = -15.6, z = 8.1, w = 0.28, d = 0.20, turn = -25, color = \"a58058\" },\n\t\t{ x = 27.0, z = 11.0, w = 0.70, d = 0.45, turn = 0, color = \"9b7650\" }, { x = 20.5, z = 5.0, w = 0.40, d = 0.30, turn = 80, color = \"8f6b47\" }, { x = 0.5, z = 8.8, w = 0.32, d = 0.24, turn = -10, color = \"9b7650\" },\n\t},\n\tchipThickness = 0.012,\n\t-- cracks in the sill: polylines of x, z points; the first is the main crack, the others branch off it\n\tcracks = {\n\t\t{ { -11.0, 9.9 }, { -9.4, 8.9 }, { -8.3, 9.3 }, { -6.5, 7.9 }, { -5.7, 8.2 }, { -3.2, 6.6 } },\n\t\t{ { -6.5, 7.9 }, { -5.9, 6.7 }, { -6.3, 5.9 } },\n\t},\n\tcrackWidth = 0.05, crackColor = \"4d3d2e\", crackHeight = 0.004,\n\t-- crumbs: centre (x, y, z), size (sx, sy, sz), turn in degrees, colour\n\tcrumbs = {\n\t\t{ x = 14.6, y = 0.11, z = 8.6, sx = 0.34, sy = 0.22, sz = 0.27, turn = 25, color = \"d6b684\" },\n\t\t{ x = 14.95, y = 0.07, z = 8.75, sx = 0.20, sy = 0.14, sz = 0.16, turn = -40, color = \"c9a56f\" },\n\t\t{ x = 14.3, y = 0.045, z = 8.3, sx = 0.12, sy = 0.09, sz = 0.10, turn = 70, color = \"e0c493\" },\n\t},\n}\n\n-- ---------------------------------------------------------------- lighting\nGraphics.lighting = {\n\tbrightness = 2.6,\n\tambient = { 70, 66, 58 }, outdoorAmbient = { 150, 146, 132 },\n\tcolorShiftTop = { 255, 240, 214 }, -- a soft warm sun\n\tenvironmentDiffuse = 1, environmentSpecular = 1,\n\tshadowSoftness = 0.2, exposureCompensation = 0.1,\n\tclockTime = 9.6, latitude = 40.7, -- used when no through-window sun can be found (SunPick)\n}\n-- SunPick looks for a time of day whose sun stands behind the window and low enough to shine in across the sill.\nGraphics.sun = {\n\televationDeg = 30, minElevationDeg = 18, maxElevationDeg = 48,\n\tazimuthDeg = 30, maxAzimuthDeg = 65, -- angle between straight out of the window (-Z) and the sun's heading\n\tclockFrom = 7, clockTo = 17, clockStep = 0.25,\n}\n-- Day and night (ROBLOX-24, after Godot's LIFE-06). The life clock's daylight (0 night to 1 day) blends the daytime values above\n-- toward these. At full daylight everything is exactly the daytime look. The sun: Roblox puts the sun from ClockTime, so the\n-- day keeps the through-the-window clock SunPick chose, and dusk runs that morning backwards toward `nightClock`, before\n-- sunrise, so the sun sinks on the window's side and the sky goes dark with stars; dawn runs it forwards again. Night is dim\n-- and blue, never black. Every number is a first guess until it is seen in Studio.\nGraphics.dayNight = {\n\tnightClock = 4.0, -- ClockTime at full night (the sun well below the horizon)\n\tbrightness = 0.6, -- Lighting.Brightness at night (the moon's light)\n\tambient = { 38, 42, 58 }, outdoorAmbient = { 58, 68, 98 },\n\texposureCompensation = -0.25,\n\tlowSunColorShiftTop = { 255, 196, 150 }, -- the colour of a low sun; white again by daylight warmFrom (Godot: smoothstep 0 to 0.6)\n\twarmFrom = 0.6,\n\tatmosphereColor = { 70, 82, 112 }, atmosphereDecay = { 92, 84, 110 },\n\tmotesAtNight = 0.15, -- the dust motes' brightness at night (they catch the sun by day)\n\tapplyStep = 0.002, -- the light is set again once daylight has changed by this much (and whenever it reaches 0 or 1)\n}\nGraphics.atmosphere = { density = 0.30, offset = 0.25, color = { 199, 215, 232 }, decay = { 232, 196, 150 }, glare = 0.3, haze = 1.0 }\nGraphics.sky = { sunAngularSize = 12, moonAngularSize = 11, starCount = 3000 }\nGraphics.clouds = { cover = 0.45, density = 0.5, color = { 250, 248, 240 } }\nGraphics.bloom = { intensity = 0.45, size = 24, threshold = 1.4 }\nGraphics.grade = { contrast = 0.1, saturation = 0.1, tint = { 255, 246, 232 }, brightness = 0 }\nGraphics.sunRays = { intensity = 0.05, spread = 0.7 }\n-- Macro depth of field: on in the full tier unless the Workspace attribute DepthOfField is false. The sill stays sharp (everything\n-- within `radius` of the focus, which the client sets to the camera-to-spider distance) and the garden outside the window melts\n-- into soft bokeh. Nothing near is blurred.\nGraphics.depthOfField = { far = 0.3, near = 0, focus = 6, radius = 18 }\n\n-- ---------------------------------------------------------------- dust motes and light shafts\nGraphics.dust = {\n\tat = Vector3.new(0, 6.1, -1), size = Vector3.new(56, 11, 22),\n\trate = 7, lifetime = { 14, 18 }, speed = { 0.04, 0.16 }, particle = { 0.05, 0.11 },\n\ttransparency = 0.55, lightEmission = 0.55, lightInfluence = 0.35, color = \"fff0d2\",\n\ttexture = \"rbxasset://textures/particles/smoke_main.dds\",\n}\n-- Soft shafts of light from the window along the sun, a few stacked translucent ribbons each (full tier only).\nGraphics.shafts = {\n\tx = { -18.75, 0, 18.75 }, -- where along the window each starts (the middle of each pane)\n\tstartY = 11.5, -- height on the glass where a shaft starts\n\tgrow = 1.25, -- how much wider a shaft is where it reaches the floor\n\tlayers = { { 2.4, 0.972 }, { 4.0, 0.982 }, { 6.0, 0.99 } }, -- width, transparency\n\tlightEmission = 0.5, color = \"fff0d2\",\n}\n\n-- ---------------------------------------------------------------- detail tiers\nGraphics.tiers = {\n\tfull = { dustRate = 1.0 },\n\tlow = { dustRate = 0.4 }, -- also drops everything built with FullOnly: bloom, sun rays, clouds, shafts, details, the busier view\n}\n\nreturn Graphics\n",19623,2855323685},{"Shared/Data/MatingRules","--!strict\n-- The mating cycle's numbers (ROBLOX-79). Game tuning, not measurements: Predator/Mate and Life/Mating read these and nothing else decides them.\n-- The cycle: a full-grown, well-fed spider rests; the next morning a mate comes onto the sill; courting it fills a meter; they mate and the male leaves;\n-- the next night's sleep in the crack makes the egg sac; two days of guarding; the eggs hatch and the player carries on as one of the spiderlings.\nlocal MatingRules = {}\n\n-- Eligibility, tested at a rest in the crack: the spider is full-grown (Growth's last stage) and has at least this much energy (the hunger bar at 60%).\nMatingRules.energyMin = 0.6\n-- The mate arrives by the rival's rules (Data/RivalRules, ROBLOX-68): not on the first day, from the morning (the spider's waking hour), not while the\n-- spider rests or the wasp visits, not while the spider is within arriveDistance of where it would arrive. It is also not brought in the afternoon: from\n-- arriveUntil a visit that has not begun is not begun (it comes tomorrow). The mate goes at leaveHour, the evening (LifeClock.EVENING_H).\nMatingRules.firstDay = 2\nMatingRules.arriveHour = 7.0\nMatingRules.arriveUntil = 16.0\nMatingRules.leaveHour = 18.0\nMatingRules.arriveDistance = 8.0\nMatingRules.arriveAt = Vector3.new(26.0, 0.31, 3.0) -- the east end of the floor, away from the crack at the west end\n-- One mate at a time, for at most this many days (mornings it comes); then a new mate, the next morning.\nMatingRules.visitsMax = 3\n\n-- Courtship. The player is near the mate (within nearWu), standing still, facing it (the mate within faceDeg of where the player looks) and, for the\n-- peacock spider, dancing. The meter then fills over courtSeconds; moving, leaving, turning away or being airborne drains it at decayPerSecond (twice\n-- as fast as it fills). While the dance is the only thing missing the meter holds. Jumping at the mate (airborne within jumpAtWu) or striking it\n-- (the strike's sweep within strikeWu) drives it off for the day.\nMatingRules.courtSeconds = 8.0\nMatingRules.decayPerSecond = 0.25\nMatingRules.nearWu = 3.0\nMatingRules.attendWu = 2.0 -- an interested mate walks up to the spider and stops this far from it\nMatingRules.loseWu = 6.0 -- the spider is gone from its attention beyond this (or out of sight for loseSeconds)\nMatingRules.loseSeconds = 3.0\nMatingRules.faceDeg = 40.0\nMatingRules.strikeWu = 0.65\nMatingRules.jumpAtWu = 2.0\n-- The pause together (ROBLOX-89: it was five seconds and one caption). The mating is a scene of `sceneSeconds` in four beats (Life/MatingScene: she turns, they touch,\n-- they settle, one goes). A male mate is together with the spider for `pairSeconds` (the first three beats) and then walks off the sill during the last beat; a female\n-- mate (the peacock spider is the male) stays through the whole scene (`stayPairSeconds`), turns away and settles in the last beat, and walks off after it. The scene may\n-- be skipped after `skipAfter` seconds, or at once when a wasp comes (nothing keeps the player in the open); then the mate walks off as it always did.\nMatingRules.sceneSeconds = 15.0\nMatingRules.pairSeconds = 11.0\nMatingRules.stayPairSeconds = 15.0\nMatingRules.skipAfter = 4.0\n-- A mate that leaves (driven off, at dusk, after mating) walks to the edge of the sill, the back corner of the east end of the floor (the waypoint\n-- there); it is gone within exitRadius of it, or after leaveSeconds, whichever is first.\nMatingRules.leaveSeconds = 120.0\nMatingRules.exitAt = Vector3.new(26.4, 0.31, -10.84)\nMatingRules.exitRadius = 1.5\n\n-- The mate is drawn with the played spider's look, scaled: a male mate slimmer and smaller, a female mate larger; each mate varies by up to +-scaleSpread\n-- about it (a seeded draw from the mate's number).\n-- ROBLOX-114 (to scale): the first spider's adult is drawn 14.9 mm long and its mate is a male, so at 0.9 he was up to 14.1 mm, past Phidippus audax's adult males\n-- (6 to 13 mm, Wikipedia); at 0.85 he is 12.0 to 13.3. The peacock spider's mate is a female on its 5.0 mm adult; at 1.15 she was up to 6.0 mm against the species'\n-- \"about 5 mm\" for both sexes (Wikipedia, Maratus volans); at 1.05 she is 5.0 to 5.5.\nMatingRules.scale = { male = 0.85, female = 1.05 } :: { [string]: number }\nMatingRules.scaleSpread = 0.05\n\n-- After mating: the egg sac is made by the next sleep that reaches the morning. It is guarded for guardDays full days (surviving is guarding; nothing can\n-- harm the sac), and the eggs hatch on the morning after the last. The brood is a seeded handful for the hatching scene.\nMatingRules.guardDays = 2\nMatingRules.broodMin = 8\nMatingRules.broodMax = 12\n-- Where the sac hangs in the retreat, and its size (the crack's interior is x -27.8 to -23.3, z 3 to 9).\nMatingRules.sacAt = Vector3.new(-27.1, 0.5, 8.4)\nMatingRules.sacRadius = 0.42\n-- ROBLOX-106 (W4, Nathan: \"mating should not automatically be successful\"; \"not even mating is a guarantee if you find the mate\"): the standard rules only (the client\n-- hands `nature` in the snapshot when the rules are not gentle and `on` is true; Easy, Free play and a snapshot without it are as before: a full meter is a mating).\n-- When the meter fills the mate decides, by a draw of its own (the world's seed, the mate's number, its visit and the courts so far, all in the record): the chance is\n-- `base` x the spider's condition x the courtship's quality. Condition: the reserve, from 0 at `energyLow` up to 1 at `energyFull`, never under `conditionFloor`. Quality, over\n-- the court (from the meter's first rise to its fill): each time the spider broke off (moved, turned away, left) costs (1 / (1 + breakCost x breaks)); its mean distance\n-- while courting costs up to `farCost` from attendWu (where the mate stands, 1) out to nearWu; the share of the court spent not facing it up to `awayCost`; a court that\n-- took more than 1.5 x courtSeconds loses in proportion, to at most `longFloor`. The numbers: a still, close, facing court by a well-fed spider (0.8 or more) is\n-- accepted 0.9 of the time; at 0.6 (the least a visitor comes for) 0.5; with two breaks at full condition 0.53; a thin, halting court (0.6, two breaks) 0.3.\n-- Refused, the mate walks off for the day (\"rejected\"), and the words say what weighed most: the spider's condition (\"thin\"), the court (\"clumsy\"), or, when both\n-- were at least `fairAt`, neither (\"choosy\": the mate's own choice, the base's 0.1); one may come again the next morning. And on each visit, with `cutChance`, the rival will cut in when the meter\n-- passes a drawn level (`cutLevel`) if it is free on the sill within `cutWu` of the mate then: the mate flees for the day (\"cut\"). The rival that has been eaten, or\n-- taken by the wasp, cuts in on nothing.\nMatingRules.game = {\n\ton = true, base = 0.9, energyLow = 0.35, energyFull = 0.8, conditionFloor = 0.3,\n\tbreakCost = 0.35, farCost = 0.3, awayCost = 0.5, longFloor = 0.6, fairAt = 0.85,\n\tcutChance = 0.35, cutLevel = { 0.35, 0.85 }, cutWu = 10.0,\n}\n\n-- A new generation starts like a new life: the first growth stage and this much energy (NeedsModel.ENERGY_START); the day count goes on.\nMatingRules.freshEnergy = 0.55\n\nreturn MatingRules\n",7184,698908997},{"Shared/Data/Meshes","--!strict\n-- The preserve's first meshes (ROBLOX-126; docs/MESHES.md, assets/meshes/manifest.json): original Blender studies by Chet, uploaded by socranates and verified\n-- in Studio at their authored size (1 stud = 1 cm). A drawn record whose shape is \"Mesh:<name>\" is drawn with one of these (Habitat/Scenery.look): a\n-- SpecialMesh FileMesh on a drawn-only part, scaled to the record's size, its long horizontal axis turned onto the record's. Visual only: nothing walks on\n-- them, the walkable boxes under them are as they were.\nlocal Meshes = {}\n\nexport type Mesh = { id: string, size: Vector3, triangles: number }\n\nMeshes.TEXTURE = \"rbxassetid://116765351721069\" -- the shared colour atlas\n\nMeshes.list = {\n\tgrass_clump = { id = \"rbxassetid://93421946013090\", size = Vector3.new(9.739530, 26.041445, 11.812691), triangles = 1400 },\n\tmilkweed_leaf = { id = \"rbxassetid://128470594939908\", size = Vector3.new(7, 2.125, 19.5), triangles = 1466 },\n\tconeflower_head = { id = \"rbxassetid://136400030278193\", size = Vector3.new(10.344988, 3.975, 10.288317), triangles = 4948 },\n\tbark_chip = { id = \"rbxassetid://90087253428470\", size = Vector3.new(4.599804, 0.684588, 9), triangles = 1496 },\n\tstone = { id = \"rbxassetid://93673725524671\", size = Vector3.new(5.345497, 1.815153, 3.794619), triangles = 320 },\n\tbench_slat_end = { id = \"rbxassetid://109006316168913\", size = Vector3.new(14, 3.2, 10), triangles = 188 },\n} :: { [string]: Mesh }\n\n-- The mesh a record's shape names, or nil (\"Mesh:milkweed_leaf\" -> the leaf).\nfunction Meshes.of(shape: string?): Mesh?\n\tif shape == nil or string.sub(shape, 1, 5) ~= \"Mesh:\" then return nil end\n\treturn Meshes.list[string.sub(shape, 6)]\nend\n\n-- How a mesh fits a record's box: whether to turn it a quarter (its long horizontal axis onto the box's) and the SpecialMesh's Scale (box / native, axis by axis,\n-- after the turn). The part keeps the record's size and place; only the mesh is scaled.\nfunction Meshes.fit(mesh: Mesh, size: Vector3): (boolean, Vector3)\n\tlocal n = mesh.size\n\tlocal turn = (n.Z > n.X) ~= (size.Z > size.X) and math.abs(n.Z - n.X) > 1e-6 and math.abs(size.Z - size.X) > 1e-6\n\tlocal sx, sz = if turn then size.Z else size.X, if turn then size.X else size.Z\n\treturn turn, Vector3.new(sx / n.X, size.Y / n.Y, sz / n.Z)\nend\n\nreturn Meshes\n",2299,895145478},{"Shared/Data/NotebookPages","--!strict\n-- The naturalist's notebook pages (LEARN-01), GENERATED by tools/gen_notebook_pages.py from the frozen Godot\n-- data/notebook/pages.json. Do not edit by hand. Ids, triggers, titles and sources are Godot's, word for word, and so are the texts\n-- except four sentences the audit of 2026-10-19 corrected (the generator's TEXT_FIXES): those pages keep Godot's whole text as `godotText`. The pages after\n-- Godot's are the Roblox game's own (the generator's ROBLOX_PAGES), with their own triggers.\n-- docs/NOTEBOOK_SOURCES.md says how far each source was checked: every citation was confirmed; a few papers were opened and read in part\n-- (that file says which and which parts), none was read in full, and the other pages rest on abstracts, search snippets or textbook knowledge.\n-- `game` is the page's \"In this game\" line: Godot's own where it is true of the Roblox game, otherwise the Roblox one,\n-- with Godot's kept as `godotGame` (tests/notebook.luau lists exactly which). {reel}, {letGo}, {drop}, {focus} and {display} are filled\n-- in with the name of that control on the device in use. Pages are listed in Godot's order.\n-- Numbers: the thresholds Godot's field_notebook.gd and notebook_watch.gd use for the moments that open a page.\nlocal NotebookPages = {}\n\nexport type Page = { id: string, trigger: string, title: string, text: string, game: string, godotGame: string?, godotText: string?, sources: { string } }\n\n-- Every trigger a page may name (Godot field_notebook.gd TRIGGERS). \"eye_time_N\": N seconds in the spider-eye view, all told.\nNotebookPages.triggers = {\n\t\"start\",\n\t\"jump\",\n\t\"jump_far\",\n\t\"jump_long\",\n\t\"eye_view\",\n\t\"eye_time_20\",\n\t\"eye_time_60\",\n\t\"shimmer\",\n\t\"fly_recognised\",\n\t\"catch\",\n\t\"meal\",\n\t\"felt\",\n\t\"buzz\",\n\t\"rest\",\n\t\"sleep\",\n\t\"hungry\",\n\t\"well_fed\",\n\t\"moult_ready\",\n\t\"moulted\",\n\t\"adult\",\n\t\"wasp\",\n\t\"wasp_escaped\",\n\t\"wasp_caught\",\n\t\"starving\",\n\t\"dance\",\n\t\"antennae\",\n\t\"hatched\",\n\t\"tarantula\",\n\t\"garden_bed\",\n\t\"look_springtail\",\n\t\"look_leafhopper\",\n\t\"look_moth\",\n\t\"look_crane_fly\",\n\t\"look_ladybird\",\n\t\"look_millipede\",\n\t\"look_snail\",\n\t\"look_harvestman\",\n\t\"look_hoverfly\",\n\t\"cat\",\n\t\"crab_spider\",\n\t\"robin\",\n\t\"look_cricket\",\n\t\"water\",\n\t\"frog\",\n\t\"look_midge\",\n\t\"look_mosquito\",\n\t\"look_damselfly\",\n\t\"look_skater\",\n\t\"darner\",\n\t\"rare_luna\",\n}\n\n-- The reserve at or under hungryAt is \"hungry\"; at or over wellFedAt, \"well fed\" (LIFE_DESIGN.md round 1).\nNotebookPages.hungryAt = 0.25\nNotebookPages.wellFedAt = 0.85\n-- A leap at least this long (studs, launch to landing point; one stud is a centimetre) is far; at least jumpLongWu is long.\nNotebookPages.jumpFarWu = 5.0\nNotebookPages.jumpLongWu = 8.0\n-- Seconds in the spider-eye view, all told, that open the pages named eye_time_N.\nNotebookPages.eyeMarks = { 20, 60 }\n-- A fly taking off this close (studs) is heard (Godot soundscape.gd HEAR_WU, which gave the caption the buzz page answered to).\nNotebookPages.hearWu = 10.0\n-- How long the note that a page opened stays on the screen (Godot notebook_panel.gd NOTE_S).\nNotebookPages.noteSeconds = 6.0\n-- ROBLOX-101: a prey of the bestiary within this many studs of the spider is a close look, which opens its kind's page (`looks`: prey kind -> trigger).\nNotebookPages.lookWu = 4.0\n-- ROBLOX-105: the ambient bugs' close looks too (NotebookWatch: one of the view's bugs of the kind, out in the open, within lookWu).\nNotebookPages.looks = { springtail = \"look_springtail\", leafhopper = \"look_leafhopper\", moth = \"look_moth\", crane_fly = \"look_crane_fly\",\n\tladybird = \"look_ladybird\", millipede = \"look_millipede\", snail = \"look_snail\", harvestman = \"look_harvestman\", hoverfly = \"look_hoverfly\", cricket = \"look_cricket\",\n\tmidge = \"look_midge\", mosquito = \"look_mosquito\", damselfly = \"look_damselfly\", skater = \"look_skater\" } :: { [string]: string }\n\nNotebookPages.pages = {\n\t{\n\t\tid = \"bold_jumper\",\n\t\ttrigger = \"start\",\n\t\ttitle = \"The bold jumping spider\",\n\t\ttext = \"The first spider is inspired by the bold jumping spider, Phidippus audax. It lives across much of North America, often on walls, fences and windowsills. Adults are about 6 to 15 millimetres long, and females are usually bigger than males. Look for its shining green-blue fangs and the pale spots on its black abdomen.\",\n\t\tgame = \"The first spider is inspired by the bold jumper. The peacock spider, the ant mimic and the two tarantulas are costumes on the same body: other species, the same game rules. Our models and four growth stages (three moults) are stylised; one stud represents a centimetre.\",\n\t\tgodotGame = \"This windowsill is built at true scale: one game unit is one centimetre, about the length of the spider.\",\n\t\tsources = {\n\t\t\t\"Edwards, G. B. (2004). Revision of the jumping spiders of the genus Phidippus (Araneae: Salticidae). Occasional Papers of the Florida State Collection of Arthropods 11.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"dragline\",\n\t\ttrigger = \"jump\",\n\t\ttitle = \"A line before every leap\",\n\t\ttext = \"Before it jumps, a jumping spider usually fixes a silk line to the surface behind it. In the air the line helps keep its body steady, and if it misses, it can hang from the line and climb back. Spiders of the species Hasarius adansoni landed more steadily when they had their line.\",\n\t\tgame = \"The spider here fixes a safety line when it leaps, where the surface holds silk, and a missed jump leaves it hanging. On the line, {reel} reels in and holding {letGo} lets go. {drop} lets it down on its line; hold it to keep lowering.\",\n\t\tgodotGame = \"The spider here dips its abdomen to fix the line, and a missed jump leaves it hanging. Reel in with W / stick up; let go with Q / B. F / D-pad down lets it down on its line from anywhere; hold it to keep lowering.\",\n\t\tsources = {\n\t\t\t\"Chen, Y.-K., Liao, C.-P., Tsai, F.-Y. & Chi, K.-J. (2013). More than a safety line: jump-stabilizing silk of salticids. Journal of the Royal Society Interface 10: 20130572. https://pmc.ncbi.nlm.nih.gov/articles/PMC3758018/\",\n\t\t},\n\t},\n\t{\n\t\tid = \"legs_push\",\n\t\ttrigger = \"jump_far\",\n\t\ttitle = \"Legs that push\",\n\t\ttext = \"Jumping spiders have no giant jumping legs like a grasshopper. High-speed films of Phidippus regius show the third and fourth pairs of legs straightening at take-off. Spiders can stretch some leg joints by raising their blood pressure, but that study found the leg muscles could supply the power for a jump.\",\n\t\tgame = \"In this game the spider braces and crouches before a jump, then pushes off with its back legs. Both are drawn poses, not measurements.\",\n\t\tgodotGame = \"Watch the back legs straighten as the spider leaves the surface.\",\n\t\tsources = {\n\t\t\t\"Nabawy, M. R. A., Sivalingam, G., Garwood, R. J., Crowther, W. J. & Sellers, W. I. (2018). Energy and time optimal trajectories in exploratory jumps of the spider Phidippus regius. Scientific Reports 8: 7142. https://doi.org/10.1038/s41598-018-25227-9\",\n\t\t},\n\t},\n\t{\n\t\tid = \"eight_eyes\",\n\t\ttrigger = \"eye_view\",\n\t\ttitle = \"Eight eyes, different jobs\",\n\t\ttext = \"Jumping spiders have eight eyes. The two big front eyes see sharp detail, but only in a narrow field. The eyes beside them watch for movement, and the others look out to the sides and behind, so the spider can notice something almost anywhere and turn to look at it.\",\n\t\tgame = \"The spider-eye view is an impression made from this research, not a recording of what a spider sees.\",\n\t\tsources = {\n\t\t\t\"Land, M. F. (1969). Movements of the retinae of jumping spiders (Salticidae: Dendryphantinae) in response to visual stimuli. Journal of Experimental Biology 51: 471-493. https://doi.org/10.1242/jeb.51.2.471\",\n\t\t\t\"Zurek, D. B., Taylor, A. J., Evans, C. S. & Nelson, X. J. (2010). The role of the anterior lateral eyes in the vision-based behaviour of jumping spiders. Journal of Experimental Biology 213: 2372-2378. https://doi.org/10.1242/jeb.042382\",\n\t\t},\n\t},\n\t{\n\t\tid = \"moving_retinas\",\n\t\ttrigger = \"eye_time_20\",\n\t\ttitle = \"Eyes that look without turning\",\n\t\ttext = \"The big front eyes cannot turn: their lenses are fixed in the head. Instead, the retina at the back of each eye moves. It sweeps from side to side and slowly twists, so the spider can scan what it is looking at without moving its body.\",\n\t\tgame = \"The two sharp strips that sweep and twist in the eye view show this.\",\n\t\tsources = {\n\t\t\t\"Land, M. F. (1969). Movements of the retinae of jumping spiders (Salticidae: Dendryphantinae) in response to visual stimuli. Journal of Experimental Biology 51: 471-493. https://doi.org/10.1242/jeb.51.2.471\",\n\t\t},\n\t},\n\t{\n\t\tid = \"motion_first\",\n\t\ttrigger = \"shimmer\",\n\t\ttitle = \"Movement first, shape later\",\n\t\ttext = \"The eyes beside the big front pair are motion detectors. When everything but these eyes was covered, jumping spiders of the Australian species Servaea vestita still turned toward moving dots and even stalked flies. These eyes can notice a movement smaller than the gap between their own light-sensing cells.\",\n\t\tgame = \"The shimmering ring in the eye view shows something the side eyes saw moving before the front eyes can tell what it is.\",\n\t\tsources = {\n\t\t\t\"Zurek, D. B., Taylor, A. J., Evans, C. S. & Nelson, X. J. (2010). The role of the anterior lateral eyes in the vision-based behaviour of jumping spiders. Journal of Experimental Biology 213: 2372-2378. https://doi.org/10.1242/jeb.042382\",\n\t\t\t\"Zurek, D. B. & Nelson, X. J. (2012). Hyperacute motion detection by the lateral eyes of jumping spiders. Vision Research 66: 26-30.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"hunting_by_sight\",\n\t\ttrigger = \"fly_recognised\",\n\t\ttitle = \"A hunter that uses its eyes\",\n\t\ttext = \"Jumping spiders catch their food without a web. A hunt usually goes like this: turn to face a movement, look at it with the big front eyes, creep closer, crouch, and leap.\",\n\t\tgame = \"Here the spider becomes surer of what something is the longer it looks at it.\",\n\t\tsources = {\n\t\t\t\"Jackson, R. R. & Pollard, S. D. (1996). Predatory behavior of jumping spiders. Annual Review of Entomology 41: 287-308.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"venom\",\n\t\ttrigger = \"catch\",\n\t\ttitle = \"The bite\",\n\t\ttext = \"A jumping spider grips its catch with its front legs and fangs and bites. The venom soon stops the prey from struggling.\",\n\t\tgame = \"In this game the fly weakens over several seconds as the venom works.\",\n\t\tsources = {\n\t\t\t\"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"drinking\",\n\t\ttrigger = \"meal\",\n\t\ttitle = \"A meal you drink\",\n\t\ttext = \"Spiders cannot swallow solid food. They digest their meal partly outside the body: they pour digestive juices onto the prey and suck up the liquid food.\",\n\t\tgame = \"\",\n\t\tsources = {\n\t\t\t\"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"felt\",\n\t\ttrigger = \"felt\",\n\t\ttitle = \"Feeling through the feet\",\n\t\ttext = \"Spiders feel vibrations through tiny slits in the hard skin of their legs, called slit sensilla. A group of them near the end of each leg picks up very small shakes of the surface the spider stands on.\",\n\t\tgame = \"The ripple on the screen and the low thrum stand in for this. A vibration reaches the spider only through touching surfaces, never across a gap.\",\n\t\tsources = {\n\t\t\t\"Barth, F. G. (2002). A Spider's World: Senses and Behavior. Springer.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"hearing\",\n\t\ttrigger = \"buzz\",\n\t\ttitle = \"Hearing without ears\",\n\t\ttext = \"Jumping spiders have no ears, yet the bold jumping spider responds to low sounds. In experiments these spiders froze at a low hum, and cells in their brains answered to sounds of 80 to 380 vibrations a second, even from more than 3 metres away. Fine hairs on the legs, moved by the air, probably do the hearing.\",\n\t\tgame = \"Buzzing is a human-audible cue, not a recording of what a spider experiences.\",\n\t\tgodotGame = \"The fly's buzz you hear here is about 200 vibrations a second, inside that range.\",\n\t\tsources = {\n\t\t\t\"Shamble, P. S., Menda, G., Golden, J. R., et al. (2016). Airborne acoustic perception by a jumping spider. Current Biology 26: 2913-2920. https://doi.org/10.1016/j.cub.2016.08.041\",\n\t\t},\n\t},\n\t{\n\t\tid = \"retreat\",\n\t\ttrigger = \"rest\",\n\t\ttitle = \"A silk retreat\",\n\t\ttext = \"Jumping spiders do not build webs to catch food, but they do spin retreats: small tents of silk in a crack or under a leaf, where they rest at night, moult and shelter from bad weather.\",\n\t\tgame = \"In this game the crack in the sill is the retreat. The spider does not spin one yet.\",\n\t\tsources = {\n\t\t\t\"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"depth_blur\",\n\t\ttrigger = \"jump_long\",\n\t\ttitle = \"Judging distance by blur\",\n\t\ttext = \"How does a jumping spider know how far to jump? One answer is blur. The big front eyes have retinas in layers, and one layer always gets a slightly blurred picture; how blurred depends on how far away things are. In green light the spiders of the species Hasarius adansoni jumped accurately. In red light they jumped short, as this idea predicts.\",\n\t\tgame = \"In this game a jump lands where the marker shows, whatever the light.\",\n\t\tsources = {\n\t\t\t\"Nagata, T., Koyanagi, M., Tsukamoto, H., et al. (2012). Depth perception from image defocus in a jumping spider. Science 335: 469-471. https://doi.org/10.1126/science.1211667\",\n\t\t},\n\t},\n\t{\n\t\tid = \"green_uv\",\n\t\ttrigger = \"eye_time_60\",\n\t\ttitle = \"Green and ultraviolet\",\n\t\ttext = \"In the big front eyes of the related Phidippus regius, light-sensing cells respond best to green and to ultraviolet, a colour people cannot see; no cells most sensitive to red were found. Some other jumping spiders, such as Habronattus, see red with the help of a red filter inside the eye.\",\n\t\tgame = \"A screen cannot show ultraviolet, so the eye view shows it as violet, and only the principal eyes see it ({focus}).\",\n\t\tgodotGame = \"A screen cannot show ultraviolet, and ordinary colours carry no ultraviolet information, so the eye view says 'UV not simulated'.\",\n\t\tsources = {\n\t\t\t\"DeVoe, R. D. (1975). Ultraviolet and green receptors in principal eyes of jumping spiders. Journal of General Physiology 66: 193-207. https://doi.org/10.1085/jgp.66.2.193\",\n\t\t\t\"Zurek, D. B., Cronin, T. W., Taylor, L. A., Byrne, K., Sullivan, M. L. G. & Morehouse, N. I. (2015). Spectral filtering enables trichromatic vision in colorful jumping spiders. Current Biology 25: R403-R404.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"home_before_dark\",\n\t\ttrigger = \"sleep\",\n\t\ttitle = \"Home before dark\",\n\t\ttext = \"Jumping spiders hunt in daylight. Spiders of the related species Phidippus johnsoni go into their silk nests before dark and stay inside through the night, and in bad weather.\",\n\t\tgame = \"Rest in the crack in the evening to sleep until morning. A day lasts about fifteen minutes of active play.\",\n\t\tgodotGame = \"Rest in the crack in the evening to sleep until morning. The game compresses time: a day here passes in about a quarter of an hour of play, and a real bold jumping spider lives about a year.\",\n\t\tsources = {\n\t\t\t\"Jackson, R. R. (1979). Nests of Phidippus johnsoni (Araneae, Salticidae): characteristics, pattern of occupation, and function. Journal of Arachnology 7: 47-58.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"hungry_at_home\",\n\t\ttrigger = \"hungry\",\n\t\ttitle = \"Hungry, yet at home\",\n\t\ttext = \"In one field study, most bold jumping spiders stayed in their silk nests during the day, and the ones inside were hungrier than the ones out hunting. The author suggests the spiders switch between resting and active spells, with hunger deciding when to switch.\",\n\t\tgame = \"Here hunger shows in the spider's thinner abdomen and in the words under the day. A spider that goes too long without food starves, except on Easy and in free play.\",\n\t\tgodotGame = \"Here hunger shows in the spider's thinner abdomen and its energy. A reserve that runs out does not yet end a life; that comes in a later version.\",\n\t\tsources = {\n\t\t\t\"Okuyama, T. (2011). Biphasic activity of a jumping spider. Naturwissenschaften 98: 15-22. https://doi.org/10.1007/s00114-010-0734-3\",\n\t\t},\n\t},\n\t{\n\t\tid = \"full_abdomen\",\n\t\ttrigger = \"well_fed\",\n\t\ttitle = \"A full abdomen\",\n\t\ttext = \"A spider's abdomen stretches as it feeds and shrinks as it goes without. Biologists judge how well fed a spider is by the size of its abdomen compared with the rest of its body.\",\n\t\tgame = \"Watch the spider's abdomen grow after a meal and slowly shrink over the days.\",\n\t\tsources = {\n\t\t\t\"Jakob, E. M., Marshall, S. D. & Uetz, G. W. (1996). Estimating fitness: a comparison of body condition indices. Oikos 77: 61-67.\",\n\t\t\t\"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"outgrowing_a_skin\",\n\t\ttrigger = \"moult_ready\",\n\t\ttitle = \"Outgrowing a skin\",\n\t\ttext = \"A spider's hard outer skin cannot stretch, so to grow it must shed it. This is called moulting. Spiders of the related species Phidippus johnsoni stay in their silk nest for about six days before a moult and two days after it.\",\n\t\tgame = \"Rest in the crack when your spider is ready. Real spiders usually stop eating before a moult; here the spider can still eat, and the days are compressed.\",\n\t\tsources = {\n\t\t\t\"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.\",\n\t\t\t\"Jackson, R. R. (1979). Nests of Phidippus johnsoni (Araneae, Salticidae): characteristics, pattern of occupation, and function. Journal of Arachnology 7: 47-58.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"new_skin\",\n\t\ttrigger = \"moulted\",\n\t\ttitle = \"A new skin\",\n\t\ttext = \"In a moult the spider pulls itself out of its old skin and leaves an empty husk behind. The new skin is pale and soft at first and hardens over the following hours. Until it does, the spider is more easily hurt.\",\n\t\tgame = \"Your spider is pale and its jumps shorter while its skin hardens. The ten game-hour timing is a design choice. The empty skin stays in the crack.\",\n\t\tgodotGame = \"Your spider is paler and its jumps shorter while the new skin hardens. How long that takes for a jumping spider has not been measured; the game's timing is a guess. Look for the old skin in the crack.\",\n\t\tsources = {\n\t\t\t\"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"grown_up\",\n\t\ttrigger = \"adult\",\n\t\ttitle = \"Grown up\",\n\t\ttext = \"Jumping spiders moult several times before they are adults. In the lab, males of the related Phidippus johnsoni matured after 5 to 7 moults and females after 6 to 8. Bold jumping spiders spend the winter as juveniles and become adults in spring.\",\n\t\tgame = \"The game compresses growth into three moults. Adulthood in a Standard main life opens Easy for this session. The male peacock look and dance are cosmetic choices at every gameplay stage.\",\n\t\tgodotGame = \"Your spider is an adult: you have finished the main life. The game shows only its last three moults.\",\n\t\tgodotText = \"Jumping spiders moult several times before they are adults. In the field, males of the related Phidippus johnsoni became adult after about six to eight moults and females after about seven to nine. Bold jumping spiders spend the winter as juveniles and become adults in spring.\",\n\t\tsources = {\n\t\t\t\"Jackson, R. R. (1978). The life history of Phidippus johnsoni (Araneae, Salticidae). Journal of Arachnology 6: 1-29.\",\n\t\t\t\"Taylor, B. B. & Peck, W. B. (1975). A comparison of northern and southern forms of Phidippus audax. Journal of Arachnology 2: 89-99.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"mud_dauber\",\n\t\ttrigger = \"wasp\",\n\t\ttitle = \"A hunter of spiders\",\n\t\ttext = \"The black-and-yellow mud dauber, Sceliphron caementarium, is a wasp about 2 to 3 centimetres long. It builds nests of mud in sheltered places on buildings, such as under eaves, and it is active by day in spring and summer. It hunts spiders, jumping spiders among them. It searches by sight, then checks a spider with its antennae before it stings.\",\n\t\tgame = \"You hear the wasp before it reaches the sill. The silk-lined crack is safe. Keeping still makes you hard to notice, and a jump or a drop on your line breaks its approach.\",\n\t\tgodotGame = \"You hear the wasp before it reaches the sill, see its shadow, and feel it land. The silk-lined crack is safe. Keeping still makes you hard to notice, and a jump or a drop on your line breaks its approach.\",\n\t\tgodotText = \"The black-and-yellow mud dauber, Sceliphron caementarium, is a wasp about 2 to 3 centimetres long. It builds nests of mud in sheltered places on buildings, such as under eaves, and it is active by day in spring and summer. It hunts spiders, jumping spiders among them. It finds a spider by sight, then touches it with its antennae before it stings.\",\n\t\tsources = {\n\t\t\t\"Powell, E. C. & Taylor, L. A. Black and yellow mud dauber, Sceliphron caementarium (Drury, 1773). Featured Creatures EENY-654 / IN1478, University of Florida IFAS Extension. https://ask.ifas.ufl.edu/publication/IN1478\",\n\t\t\t\"Grissell, E. E. (1973). Sceliphron caementarium (Drury), a mud daubing wasp. Entomology Circular 136, Florida Department of Agriculture and Consumer Services, Division of Plant Industry.\",\n\t\t\t\"Uma, D., Durkee, C., Herzner, G. & Weiss, M. (2013). Double deception: ant-mimicking spiders elude both visually- and chemically-oriented predators. PLoS ONE 8(11): e79660.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"what_the_wasp_does\",\n\t\ttrigger = \"wasp_caught\",\n\t\ttitle = \"What the wasp does\",\n\t\ttext = \"The wasp's sting does not kill a spider: it paralyses it. The wasp carries the spider to a cell in its mud nest and fills the cell with paralysed spiders, up to twenty or more. It lays an egg on one of them and seals the cell with mud. When the larva hatches, it feeds on the spiders, which have stayed fresh because they are still alive.\",\n\t\tgame = \"A catch ends a Standard life. Return to your last rest or continue as an unrelated spider. In Easy and Free play the wasp only touches and leaves.\",\n\t\tgodotGame = \"Being caught ends this spider's life. You go back to your last rest.\",\n\t\tsources = {\n\t\t\t\"Powell, E. C. & Taylor, L. A. Black and yellow mud dauber, Sceliphron caementarium (Drury, 1773). Featured Creatures EENY-654 / IN1478, University of Florida IFAS Extension. https://ask.ifas.ufl.edu/publication/IN1478\",\n\t\t\t\"Grissell, E. E. (1973). Sceliphron caementarium (Drury), a mud daubing wasp. Entomology Circular 136, Florida Department of Agriculture and Consumer Services, Division of Plant Industry.\",\n\t\t\t\"Long, R. F. (2018). Why mud daubers are on spider patrol. UC ANR Green Blog, University of California Agriculture and Natural Resources.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"getting_away\",\n\t\ttrigger = \"wasp_escaped\",\n\t\ttitle = \"Getting away\",\n\t\ttext = \"Jumping spiders watch what moves around them. When something looms toward a bold jumping spider, it backs away, and experiments showed that its side eyes, the anterior lateral eyes, are what tell it to. The mud dauber searches by sight and then checks with its antennae, so a spider that stays out of sight is safer.\",\n\t\tgame = \"The wasp lost you, or gave up. Here a jump, a drop on your line or getting out of sight breaks its approach, and the crack is always safe. Dropping on a line to escape is the game's choice: it is not known to be what jumping spiders do.\",\n\t\tgodotText = \"Jumping spiders watch what moves around them. When something looms toward a bold jumping spider, it backs away, and experiments showed that its side eyes, the anterior lateral eyes, are what tell it to. Not being seen matters most: the mud dauber finds its prey by sight.\",\n\t\tsources = {\n\t\t\t\"Spano, L., Long, S. M. & Jakob, E. M. (2012). Secondary eyes mediate the response to looming objects in jumping spiders (Phidippus audax, Salticidae). Biology Letters 8(6): 949-951.\",\n\t\t\t\"Uma, D., Durkee, C., Herzner, G. & Weiss, M. (2013). Double deception: ant-mimicking spiders elude both visually- and chemically-oriented predators. PLoS ONE 8(11): e79660.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"going_without_food\",\n\t\ttrigger = \"starving\",\n\t\ttitle = \"Going without food\",\n\t\ttext = \"Spiders can go a long time without food. In the lab, jumping spiders have survived weeks without food, longer when cold and still. As a spider uses up its reserves its abdomen shrinks: how plump the abdomen is, against the size of the body, is how scientists judge a spider's condition.\",\n\t\tgame = \"Time is compressed here. The hunger bar, full when your spider is fed, empties in a little over a day and a half; a spider that then goes two more days without food dies, after warnings on the screen. On Easy and in free play it empties much more slowly and cannot starve.\",\n\t\tgodotGame = \"Time is compressed here. A full reserve lasts about three days; a spider that then goes two more days without food dies, after warnings on the screen. On Easy and in free play it cannot starve.\",\n\t\tgodotText = \"Spiders can go a long time without food. Adult females of the related Phidippus johnsoni were kept for 25 to 31 days without eating. As a spider uses up its reserves its abdomen shrinks: how plump the abdomen is, against the size of the body, is how scientists judge a spider's condition.\",\n\t\tsources = {\n\t\t\t\"Jackson, R. R. (1978). The life history of Phidippus johnsoni (Araneae, Salticidae). Journal of Arachnology 6: 1-29.\",\n\t\t\t\"Jakob, E. M., Marshall, S. D. & Uetz, G. W. (1996). Estimating fitness: a comparison of body condition indices. Oikos 77: 61-67.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"peacock_dance\",\n\t\ttrigger = \"dance\",\n\t\ttitle = \"A fan and a dance\",\n\t\ttext = \"A male peacock spider, Maratus volans, unfolds colourful flaps on its abdomen and waves its third pair of legs during courtship. The display also sends vibrations through the surface beneath it. It is a message to a female, not just a dance people can see.\",\n\t\tgame = \"Our repeating dance is inspired by recorded displays. Its size, colour, timing and movement are stylised. Here the dance is also how you court a mate: it is available at every growth stage, but only a full-grown, well-fed spider is visited by one.\",\n\t\tsources = {\n\t\t\t\"Girard, M. B., Kasumovic, M. M. & Elias, D. O. (2011). Multi-Modal Courtship in the Peacock Spider, Maratus volans. PLoS ONE 6(9): e25390. https://doi.org/10.1371/journal.pone.0025390\",\n\t\t},\n\t},\n\t{\n\t\tid = \"walking_like_an_ant\",\n\t\ttrigger = \"antennae\",\n\t\ttitle = \"Walking like an ant\",\n\t\ttext = \"Myrmarachne formicaria is a jumping spider that mimics an ant. It walks on all eight legs, and when it stands still it raises its front legs above its head and moves them together, like an ant's antennae. It makes only short stops, about a tenth of a second long, so it seems to move almost constantly, as ants do. In tests with Phidippus audax as the predator, ordinary spider targets were attacked 4.5 times as often as ants and 3 times as often as mimics; ants and mimics did not differ.\",\n\t\tgame = \"The ant mimic is a look only: where you go, how fast and what the wasp does are the first spider's. Its front legs rise when you keep still, and a stop shorter than about 83 milliseconds is not drawn as a pause. The waving, the sway of the body as it walks, the colours and the size are stylised: the real mimic's wobbling path is not walked. The female is drawn.\",\n\t\tsources = {\n\t\t\t\"Shamble, P. S., Hoy, R. R., Cohen, I. & Beatus, T. (2017). Walking like an ant: a quantitative and experimental approach to understanding locomotor mimicry in the jumping spider Myrmarachne formicaria. Proceedings of the Royal Society B 284: 20170308. https://doi.org/10.1098/rspb.2017.0308\",\n\t\t},\n\t},\n\t{\n\t\tid = \"eggs_and_wind\",\n\t\ttrigger = \"hatched\",\n\t\ttitle = \"Eggs, silk and wind\",\n\t\ttext = \"Jumping spiders court mostly by sight, and often by vibration too: a male shows a display and the female decides. She lays her eggs in a silken nest. A Phidippus johnsoni mother stays with it until the young hatch and leave: in the lab the eggs hatched about three weeks after laying, and the spiderlings left about three weeks after that. Many young spiders then travel by ballooning: they climb high, let out a thread of silk and are carried off by the air. The electric field in the air can trigger the take-off.\",\n\t\tgame = \"A game day is about fifteen minutes, so weeks become days: a mate on the sill, a courtship you hold for eight seconds, one night to the sac and two guard days. In Normal the mate decides when the courtship is full: a thin spider, or a court that broke off, stood far or looked away, is often refused, and a rival may cut in. The real mother makes and guards the sac; here the sac is drawn the same whichever spider you play, and no claim is made that a male guards eggs. A real brood is far larger than the eight to twelve shown: a Phidippus johnsoni female laid about 200 eggs in all. The first spider's sex is the game's choice (a female), and the peacock spider's mate is drawn with the male's colours although the real female is mottled grey-brown. Nothing can harm the sac. In the preserve you may follow one spiderling on its thread: the wind, the game's seeded draw, mostly sets it down near the hut, in the hut garden or at the meadow's edge, and the next life begins where it lands; or you stay at the hut as one of them. A real spiderling could not choose.\",\n\t\tsources = {\n\t\t\t\"Jackson, R. R. (1978). The life history of Phidippus johnsoni (Araneae, Salticidae). Journal of Arachnology 6: 1-29.\",\n\t\t\t\"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.\",\n\t\t\t\"Bell, J. R., Bohan, D. A., Shaw, E. M. & Weyman, G. S. (2005). Ballooning dispersal using silk: world fauna, phylogenies, genetics and models. Bulletin of Entomological Research 95(2): 69-114. https://doi.org/10.1079/BER2004350\",\n\t\t\t\"Morley, E. L. & Robert, D. (2018). Electric Fields Elicit Ballooning in Spiders. Current Biology 28(14): 2324-2330. https://doi.org/10.1016/j.cub.2018.05.057\",\n\t\t},\n\t},\n\t{\n\t\tid = \"tarantula_cousins\",\n\t\ttrigger = \"tarantula\",\n\t\ttitle = \"Velvet cousins (Theraphosidae)\",\n\t\ttext = \"Tarantulas (family Theraphosidae) are large, heavy, long-lived spiders. They are not jumping spiders: their eyes sit close together on a small mound and are poor, and they feel their way with the hairs on their legs. Their fangs strike downward, side by side. Most New World tarantulas have urticating hairs on the abdomen and cast them at an attacker. A threatened tarantula rears up and lifts its front legs, and all of them spin silk from spinnerets at the rear of the abdomen.\",\n\t\tgame = \"The Mexican redknee and the Greenbottle blue are costumes on the first spider's body, nothing more. A real tarantula's body is five or more centimetres long; yours is the first spider's size. You still see, jump, spin your safety line and are hunted exactly as the first spider does, which no real tarantula could do. The rear-up and the turn with the spinnerets sweeping ({display}) are drawn poses with invented angles and timing, and no silk mat is laid. The colours are stylised, the redknee's rust patch is drawn as a small cluster of hairs (no hairs are cast), and the greenbottle's bars soften at the last growth stage as a game choice.\",\n\t\tsources = {\n\t\t\t\"Foelix, R. F. (2011). Biology of Spiders, 3rd edition. Oxford University Press.\",\n\t\t\t\"Bertani, R. & Guadanucci, J. P. L. (2013). Morphology, evolution and usage of urticating setae by tarantulas (Araneae: Theraphosidae). Zoologia 30(4): 403-418. https://doi.org/10.1590/S1984-46702013000400006\",\n\t\t},\n\t},\n\t{\n\t\tid = \"ground_life\",\n\t\ttrigger = \"garden_bed\",\n\t\ttitle = \"Life on the ground\",\n\t\ttext = \"Fungus gnats are small dark flies whose larvae live in damp soil and eat fungi and rotting matter; the adults fly weakly. Aphids are soft, pear-shaped insects that live in colonies and suck sap from leaves and stems. A jumping spider hunts small insects of many kinds; the related Phidippus johnsoni takes aphids. Woodlice are crustaceans, not insects, with seven pairs of legs: they keep to damp places under stones and litter, and glands on the sides of the body give off a sticky secretion that puts spiders off.\",\n\t\tgame = \"The gnats and the aphids in the bed are the house fly's model made smaller and slower, with no measured numbers behind them: a gnat is a third of a housefly meal here and an aphid a sixth, and the aphids only walk. The woodlice walk the soil, go under cover when you come near and cannot be caught, which is the game's way of saying the spider leaves them alone.\",\n\t\tsources = {\n\t\t\t\"Cranshaw, W. S. & Cloyd, R. A. (2003, reviewed 2025). Fungus Gnats as Houseplant and Indoor Pests. Colorado State University Extension, Fact Sheet 5.584.\",\n\t\t\t\"Warren, P. & Schalau, J. (2014). Aphids. University of Arizona Cooperative Extension, AZ1635.\",\n\t\t\t\"Jackson, R. R. (1977). Prey of the jumping spider Phidippus johnsoni (Araneae: Salticidae). Journal of Arachnology 5: 145-149.\",\n\t\t\t\"Hopkin, S. P. (1991). A key to the woodlice of Britain and Ireland. Field Studies Council (AIDGAP), Shrewsbury.\",\n\t\t\t\"Katz, O., DeVries, Z. & Larson, J. (2023). Sowbugs and Pillbugs. University of Kentucky Entomology, ENTFACT-439.\",\n\t\t\t\"Fischer, A., Gries, R., Roman-Torres, C. A., Devireddy, A. & Gries, G. (2025). Glandular quinoline-derivates protect crustacean woodlice from spider predation. Journal of the Royal Society Interface 22: 20250260. https://doi.org/10.1098/rsif.2025.0260\",\n\t\t},\n\t},\n\t{\n\t\tid = \"springtails\",\n\t\ttrigger = \"look_springtail\",\n\t\ttitle = \"Springtails and the spring\",\n\t\ttext = \"Springtails (Collembola) have six legs like insects, but biologists count them a lineage of their own. Most are about a millimetre long, white, grey or blue-grey. Many carry a forked spring, the furcula, clasped under the abdomen; released, it strikes the ground and flips the animal into the air, up to about 10 cm. They live in damp soil and litter and eat fungi and decaying plants, and small or young spiders are among the many small predators that eat them.\",\n\t\tgame = \"Here a springtail is an eighth of a housefly meal and easy to hold once caught: the hard part is getting close. Its flick is a hop of 1.5 to 4 studs, set off when you come near or move fast beside it. The numbers are the game's, not measurements.\",\n\t\tsources = {\n\t\t\t\"Koehler, P. G., Aparicio, M. L. & Pfiester, M. (1994, revised 2022). Springtails. University of Florida IFAS Extension, ENY-228.\",\n\t\t\t\"Missouri Department of Conservation (undated, read 2026). Springtails. Missouri Field Guide, mdc.mo.gov.\",\n\t\t\t\"Blevins, H., Larson, J. & DeVries, Z. (2023). Springtails. University of Kentucky Entomology, ENTFACT-420.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"leafhoppers\",\n\t\ttrigger = \"look_leafhopper\",\n\t\ttitle = \"Leafhoppers: the sidestep and the jump\",\n\t\ttext = \"Leafhoppers (Cicadellidae) are small wedge-shaped bugs, a few millimetres long and often green, with the wings held like a tent over the back. They suck sap from leaves. Young and adults walk with a sideways sidestep; disturbed, the young often walk round to the other side of the stem or leaf, while adults jump and fly readily. The jump comes from the strong hind legs, which carry rows of spines: long-legged leafhoppers push off in 3 to 5 thousandths of a second.\",\n\t\tgame = \"Here a leafhopper is half a housefly meal but struggles as hard as a whole one. Watched from its side it slips round its stem or leaf (the game's adults do it too); come at it fast and it jumps 3 to 10 studs, and sometimes flies on. The numbers are the game's.\",\n\t\tsources = {\n\t\t\t\"University of Illinois Extension (undated, read 2026). Leafhopper. Illinois Extension insect pages, extension.illinois.edu.\",\n\t\t\t\"University of Nebraska-Lincoln Extension (undated, read 2026). Leafhoppers. Backyard Farmer, byf.unl.edu.\",\n\t\t\t\"Utah State University Extension (undated, read 2026). Leafhoppers. Utah Pests IPM Ornamental Pest Guide.\",\n\t\t\t\"Burrows, M. & Sutton, G. P. (2008). The effect of leg length on jumping performance of short- and long-legged leafhopper insects. Journal of Experimental Biology 211: 1317-1325.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"small_moths\",\n\t\ttrigger = \"look_moth\",\n\t\ttitle = \"Moths at the window\",\n\t\ttext = \"Moths are Lepidoptera, the scale-winged insects: tiny scales cover their wings like shingles. Most fly at night, and many are drawn to lights. A flying insect does not steer straight at a lamp: it keeps its back toward the light, as it would to the sky, and near a lamp that can keep it circling. The scales help it escape: they stick to a spider's sticky silk but come away from the wing. Spiders are among the many animals that eat moths, and Phidippus johnsoni has been found with one.\",\n\t\tgame = \"Here a moth is a housefly meal. It rests on the wall and the outer sill by day, drawn with its wings spread flat (many moths fold them like a tent), and flutters from dusk. Your first grab at one may slip, leaving scales; a jumping spider's catch is not a web, so that slip is the game's borrowing.\",\n\t\tsources = {\n\t\t\t\"Missouri Department of Conservation (undated, read 2026). Moths. Missouri Field Guide, mdc.mo.gov.\",\n\t\t\t\"Fabian, S. T., Sondhi, Y., Allen, P. E., Theobald, J. C. & Lin, H.-T. (2024). Why flying insects gather at artificial light. Nature Communications 15. https://doi.org/10.1038/s41467-024-44785-3\",\n\t\t\t\"Alicea-Serrano, A. M., Onyak, A., Dhinojwala, A. & Blackledge, T. A. (2021). Robust performance of spider viscid silk on hairy and smooth insect substrates. Integrative and Comparative Biology 61(4): 1432-1439, citing Eisner, T., Alsop, R. & Ettershank, G. (1964), Adhesiveness of spider silk, Science 146: 1058-1061.\",\n\t\t\t\"Jackson, R. R. (1977). Prey of the jumping spider Phidippus johnsoni (Araneae: Salticidae). Journal of Arachnology 5: 145-149.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"crane_flies\",\n\t\ttrigger = \"look_crane_fly\",\n\t\ttitle = \"Crane flies: legs to spare\",\n\t\ttext = \"Crane flies (Tipulidae) are large, slender flies on long, fragile legs. They look like giant mosquitoes, but they are not mosquitoes and do not bite, and the short-lived adults feed little or not at all. A special seam in the legs lets them break off easily, to escape predators. Like most flies they come to lights at night. A Phidippus johnsoni was found with one in the field; its prey is usually a quarter to three quarters its own size, sometimes as large or a little larger.\",\n\t\tgame = \"Here a crane fly is two housefly meals and a harder struggle than a house fly; it can leave a leg in your fangs and get away, once, and is drawn with a leg fewer after. It is bigger than your spider: real jumping spiders take prey that large only sometimes. It flies slowly from dusk.\",\n\t\tsources = {\n\t\t\t\"University of Maine Cooperative Extension (undated, read 2026). Crane Flies. Home and Garden IPM.\",\n\t\t\t\"Layton, B. (2019). Crane Fly. Bug's Eye View 5(5), Mississippi State University Extension.\",\n\t\t\t\"Jackson, R. R. (1977). Prey of the jumping spider Phidippus johnsoni (Araneae: Salticidae). Journal of Arachnology 5: 145-149.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"ladybirds\",\n\t\ttrigger = \"look_ladybird\",\n\t\ttitle = \"Ladybirds: bright for a reason\",\n\t\ttext = \"Ladybirds, or lady beetles, are beetles with domed, oval bodies, red, orange, yellow, pink or black and usually spotted. The bright colours are a warning, to discourage animals that might eat them: disturbed, a ladybird releases an odorous, noxious fluid from its leg joints, called reflex bleeding. Adults and larvae both eat aphids and other small, soft-bodied insects. The larva looks nothing like the adult: shaped like a small alligator, spiny and black with bright spots.\",\n\t\tgame = \"Here the ladybirds walk the dock and the dandelion among the aphids and now and then stop over one and eat it. Strike one and you let it go, which is the game's way of saying the spider leaves it alone. The walks, the waits and how often it eats are the game's.\",\n\t\tsources = {\n\t\t\t\"Bessin, R. (undated, revised 2026). Ladybugs. University of Kentucky Entomology, ENTFACT-702.\",\n\t\t\t\"Bohart Museum of Entomology (undated, read 2026). Lady Bugs & Lady Beetles. Information No. 055, University of California, Davis.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"millipedes\",\n\t\ttrigger = \"look_millipede\",\n\t\ttitle = \"Millipedes: the coil\",\n\t\ttext = \"Millipedes have long segmented bodies with two pairs of legs on each segment, where centipedes have one pair. Most feed on decaying vegetation, living secretively in soil and leaf mould and beneath stones, logs and bark. When threatened, most roll into a coil with their legs on the inside, offering only their body armour to the predator, and some can release substances that taste or smell foul as a defence.\",\n\t\tgame = \"Here a millipede is about 2.4 cm long and walks the bed's soil slowly, going under the stones for a while; come close and it coils, head in the middle, until you have gone. Strike it and you let it go. The speeds and the waits are the game's.\",\n\t\tsources = {\n\t\t\t\"Buglife - The Invertebrate Conservation Trust (undated, read 2026). Millipedes. Bug Directory, buglife.org.uk.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"garden_snails\",\n\t\ttrigger = \"look_snail\",\n\t\ttitle = \"Snails: eyes on stalks\",\n\t\ttext = \"The brown garden snail's shell grows to 28 to 32 mm across. A land snail's head carries retractable tentacles: the longer, upper pair bears the eyes, which see light and dark but no colours, and the shorter pair tastes and smells. It moves by waves of muscle along its foot, aided by mucus that the foot secretes all the time, which leaves a slimy trail. Most land snails are nocturnal, but after rain they may come out by day.\",\n\t\tgame = \"Here the snail is far bigger than your spider. It crawls about a millimetre a second over the bed and up the foot of the wall, mostly from dusk, and its trail fades in a few minutes. Its eye stalks draw in when you come near; strike it and it draws into its shell. The speeds and the trail's fading are the game's.\",\n\t\tsources = {\n\t\t\t\"Dekle, G. W. & Fasulo, T. R. (2001, revised 2024). Brown Garden Snail, Cornu aspersum (Muller, 1774). University of Florida IFAS Extension, EENY240.\",\n\t\t\t\"Missouri Department of Conservation (undated, read 2026). Land Snails and Slugs. Missouri Field Guide, mdc.mo.gov.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"harvestmen\",\n\t\ttrigger = \"look_harvestman\",\n\t\ttitle = \"Harvestmen: not spiders\",\n\t\ttext = \"Harvestmen, or daddy longlegs, are not spiders but opilionids. The body is one simple oval, head and abdomen fused, with only two eyes and no silk or venom glands. Disturbed, they give off a foul odour. A leg falls off easily and goes on twitching, which can distract a predator while the harvestman flees. They are mostly active at night or in shade, and eat many kinds of organic matter, dead animals among them; some prey on aphids and other small insects.\",\n\t\tgame = \"Here one harvestman walks the bed's litter and one the house wall, from dusk through the night, high on legs that span about four studs, and takes no notice of you. Strike one and you let it go. The legs drawn and the speeds are the game's.\",\n\t\tsources = {\n\t\t\t\"University of Kentucky Entomology (undated, read 2026). Kentucky Harvestmen. Kentucky Critter Files.\",\n\t\t\t\"Missouri Department of Conservation (undated, read 2026). Daddy Longlegs (Harvestmen). Missouri Field Guide, mdc.mo.gov.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"hoverflies\",\n\t\ttrigger = \"look_hoverfly\",\n\t\ttitle = \"Hoverflies: a fly dressed as a bee\",\n\t\ttext = \"Hoverflies, or flower flies (Syrphidae), are flies that look like bees or wasps, many with black and yellow stripes across the abdomen; they mimic them as protection from predators. They do not bite or sting. Tell one from a bee by its single pair of wings, its large eyes and short antennae. The adults hover over flowers and dart about, feeding on nectar and pollen. Their larvae hunt aphids: one can eat up to 400 of them.\",\n\t\tgame = \"Here a hoverfly is a housefly meal and a half that struggles like one. It holds still in the air a moment over the flowers and then darts on; the hovers, the darts and the meal are the game's numbers.\",\n\t\tsources = {\n\t\t\t\"University of Wisconsin-Madison Extension, Division of Horticulture (undated, read 2026). Hover, Flower, or Syrphid Flies, Syrphidae.\",\n\t\t\t\"University of Minnesota Extension (undated, read 2026). Syrphid flies. Beneficial insects.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"the_cat\",\n\t\ttrigger = \"cat\",\n\t\ttitle = \"The cat and the bell\",\n\t\ttext = \"A house cat stands 23 to 25 cm at the shoulder and weighs 4 to 5 kg. It hunts small mammals and birds first, and invertebrates last. Free-ranging cats kill an estimated 1.3 to 4.0 billion birds and 6.3 to 22.3 billion mammals a year in the United States. A bell on the collar warns prey: in one study, cats brought home about half as many mammals while they wore bells. A bold jumping spider can hear airborne sound, through special hairs, from more than 3 m away.\",\n\t\tgame = \"Here the ranger's cat lives in the hut and never goes outside. It sleeps much of the day and walks the two rooms at dawn and dusk, and you hear its bell before you see it. It pats at what moves near it: get up high, into a gap, or keep still. In Normal a pat that lands kills; on Easy and in free play it knocks you aside. Its day and its reach are the game's.\",\n\t\tsources = {\n\t\t\t\"Gouvernement du Quebec (undated, read 2026). Chat domestique. Fiches des especes fauniques, quebec.ca.\",\n\t\t\t\"Loss, S. R., Will, T. & Marra, P. P. (2013). The impact of free-ranging domestic cats on wildlife of the United States. Nature Communications 4: 1396. https://doi.org/10.1038/ncomms2380\",\n\t\t\t\"Ruxton, G. D., Thomas, S. & Wright, J. W. (2002). Bells reduce predation of wildlife by domestic cats (Felis catus). Journal of Zoology 256: 81-83 (as summarised by Conservation Evidence).\",\n\t\t\t\"Shamble, P. S., Menda, G., Golden, J. R., Nitzany, E. I., Walden, K., Beatus, T., Elias, D. O., Cohen, I., Miles, R. N. & Hoy, R. R. (2016). Airborne acoustic perception by a jumping spider. Current Biology 26: 2913-2920 (as reported by NPR, 14 October 2016).\",\n\t\t},\n\t},\n\t{\n\t\tid = \"crab_spider\",\n\t\ttrigger = \"crab_spider\",\n\t\ttitle = \"The crab spider on the flower\",\n\t\ttext = \"The goldenrod crab spider (Misumena vatia) lives in North America and Europe. Females are 6 to 9 mm long, males 3 to 4 mm. It waits on a flower, usually a yellow or white one, its first two pairs of legs held open, and grabs what comes near, injecting venom with small fangs. It takes flies, bees, butterflies and hoverflies. It can turn from white to yellow to match its flower; that change takes 10 to 25 days, and the change back about six. In North America it is most common on goldenrod.\",\n\t\tgame = \"Here two crab spiders sit on the meadow's flowers, a yellow one on goldenrod and a white one on yarrow, still and nearly the flower's colour, front legs open. Walk or land within their reach and they grab: in Normal that ends the life; on Easy and in free play you drop clear. Their reach and where they sit are the game's.\",\n\t\tsources = {\n\t\t\t\"Animal Diversity Web, University of Michigan Museum of Zoology (read 2026). Misumena vatia, goldenrod crab spider.\",\n\t\t\t\"University of Minnesota Extension (undated, read 2026). Goldenrod crab spider.\",\n\t\t\t\"Wikipedia (read 2026). Misumena vatia.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"robin\",\n\t\ttrigger = \"robin\",\n\t\ttitle = \"The robin on the lawn\",\n\t\ttext = \"The American robin is a thrush 20 to 28 cm long, about 77 to 85 g, its breast rusty red and its head blackish with a white eye ring broken in front and behind. It forages on the ground: it runs a few steps, stops abruptly, and stares at the ground with its head cocked to one side, finding its food by sight. It eats many earthworms, and insects, snails, spiders and much fruit. Its call is a sharp \\\"pick! tut-tut-tut\\\".\",\n\t\tgame = \"Here a robin comes to the hut garden's lawn, the gravel by the bench and the meadow's mown edge a few times a day, its shadow and its call first. Move in the open near it and it hops close, cocks its head at you and pauses, then strikes: in Normal that ends the life; on Easy and in free play it misses. Under cover, low in the meadow's grass or keeping still, you are lost to it. Its visits, its reach and its pause are the game's.\",\n\t\tsources = {\n\t\t\t\"National Audubon Society (undated, read 2026). American Robin, Turdus migratorius. Guide to North American Birds, audubon.org.\",\n\t\t\t\"Cornell Lab of Ornithology (undated, read 2026). American Robin: Life History. All About Birds.\",\n\t\t\t\"Missouri Department of Conservation (undated, read 2026). American Robin. Missouri Field Guide, mdc.mo.gov.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"field_crickets\",\n\t\ttrigger = \"look_cricket\",\n\t\ttitle = \"The field cricket\",\n\t\ttext = \"The fall field cricket (Gryllus pennsylvanicus) lives across much of North America in grassy places, often near people. Adults are 15 to 25 mm long, shiny black to dark brown, with long antennae and stout hind legs. It eats seeds, seedlings and small fruits, and dead and dying insects. Males sing mostly at night from a burrow or a crack in the ground: short chirps, two or three a second. A cricket's ears are on its front legs. Scared, it escapes into its burrow.\",\n\t\tgame = \"Here crickets live in the meadow's thatch and the hut garden's mulch, each worth about three houseflies, and the males chirp from dusk. Move near one and it falls silent and still; come closer and it jumps away. Caught, it kicks hard, and a weak grip loses it. Its hearing, its jump and its kicks are the game's numbers.\",\n\t\tsources = {\n\t\t\t\"Wikipedia (read 2026). Gryllus pennsylvanicus.\",\n\t\t\t\"Minnesota Seasons (undated, read 2026). Fall field cricket, Gryllus pennsylvanicus. minnesotaseasons.com.\",\n\t\t\t\"Geological Society of America (2011). The sound of crickets in the Eocene night: fossil insect ears from the Green River Formation. Northeastern Section meeting, abstract (paper 184321), gsa.confex.com.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"water\",\n\t\ttrigger = \"water\",\n\t\ttitle = \"Spiders and water\",\n\t\ttext = \"Most spiders are not built for water. Fishing spiders and many wolf spiders stay dry on the surface film and row across it, but in a comparison of 166 species outside that group only two jumping spiders rowed at all, and in another study the jumping spiders' rowing gave them no clear benefit over walking. Water striders hunt what falls onto the water and struggles: insects, and spiders. They find it by its ripples.\",\n\t\tgame = \"Here the pond's water is no place to stand. Fall or walk in and you struggle at the surface; a stem, a stone, a pad or the bank within a few centimetres gives you a chance to climb out. In Normal a spider that cannot reach one drowns, and a long fall into open water is the worst. On Easy and in free play you are always pulled out. The chances are the game's.\",\n\t\tsources = {\n\t\t\t\"Stratton, G. E., Suter, R. B. & Miller, P. R. (2004). Evolution of water surface locomotion by spiders: a comparative approach. Biological Journal of the Linnean Society 81: 63-78.\",\n\t\t\t\"Suter, R. B., Stratton, G. & Miller, P. R. (2003). Water surface locomotion by spiders: distinct gaits in diverse families. Journal of Arachnology 31: 428-432.\",\n\t\t\t\"Missouri Department of Conservation (undated, read 2026). Water striders. Missouri Field Guide, mdc.mo.gov.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"green_frog\",\n\t\ttrigger = \"frog\",\n\t\ttitle = \"The green frog\",\n\t\ttext = \"The green frog (Lithobates clamitans) of eastern North America is 5 to 10 cm from snout to vent, its head green and its body brown, grey or green. It lives at the edges of shallow ponds and hunts by sitting and waiting, eating any animal of a mouthful that comes within reach: insects, spiders, snails, crayfish, small frogs. A frog's eye answers to small things that move; food that keeps still is not food to it. Its tongue strikes and is back in under 0.07 seconds.\",\n\t\tgame = \"Here a green frog sits on a stone at the water's edge or on a lily pad, one or the other by the day, and keeps still. Move near it and it turns to face you; keep moving within its reach and its tongue strikes: in Normal that ends the life; on Easy and in free play it misses. Keep still and it loses interest. Its reach, its turn and its patience are the game's.\",\n\t\tsources = {\n\t\t\t\"Wikipedia (read 2026). Lithobates clamitans.\",\n\t\t\t\"Tennessee Wildlife Resources Agency (undated, read 2026). Green Frog, Lithobates clamitans. tn.gov/twra.\",\n\t\t\t\"Lettvin, J. Y., Maturana, H. R., McCulloch, W. S. & Pitts, W. H. (1959). What the frog's eye tells the frog's brain. Proceedings of the IRE 47: 1940-1951 (as summarised in D. Heeger's perception lecture notes, cns.nyu.edu).\",\n\t\t\t\"Georgia Institute of Technology, School of Physics (2017, read 2026). The frog tongue is a high-speed adhesive (on Noel, A. C. et al., Journal of the Royal Society Interface 14: 20160764).\",\n\t\t},\n\t},\n\t{\n\t\tid = \"midges\",\n\t\ttrigger = \"look_midge\",\n\t\ttitle = \"Midges over the water\",\n\t\ttext = \"Non-biting midges (Chironomidae) are delicate flies, most under 1 cm long, with clear wings and long front legs; the males have feathery antennae that sense the females' wingbeats. They do not bite. Males gather in swarms in the evening when the sun is low, over a bush or a body of water. Their larvae live in the mud of pond bottoms, some red with haemoglobin: bloodworms. Adults live only a few days. Dragonflies catch midges on passes through their swarms.\",\n\t\tgame = \"Here midges rest on the rushes and the cattails by day and rise at dusk to hang over the margin, each a third of a housefly's meal. Their swarms here are a few, the game's.\",\n\t\tsources = {\n\t\t\t\"Missouri Department of Conservation (undated, read 2026). Midges. Missouri Field Guide, mdc.mo.gov.\",\n\t\t\t\"Virginia Cooperative Extension (undated, read 2026). Non-biting midges. Publication ENTO-438, Virginia Tech.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"mosquitoes\",\n\t\ttrigger = \"look_mosquito\",\n\t\ttitle = \"Mosquitoes\",\n\t\ttext = \"Only female mosquitoes take blood, which they need for their eggs; males feed on nectar. Eggs are laid on water or on damp ground that floods, and the larvae, wrigglers, live in the water and come up to breathe. Most kinds bite from just before dark into the night. In East Africa one jumping spider, Evarcha culicivora, chooses female mosquitoes carrying blood as its prey, Anopheles above all, and can pick them out by how they rest.\",\n\t\tgame = \"Here mosquitoes rest in the rushes by day and fly at dusk over the water's edge. None bites you; each is a small meal, a third of a housefly.\",\n\t\tsources = {\n\t\t\t\"Oklahoma State University Extension (undated, read 2026). Mosquitoes. Digital Diagnostics, extension.okstate.edu.\",\n\t\t\t\"Nelson, X. J. & Jackson, R. R. (2006). A predator from East Africa that chooses malaria vectors as preferred prey. PLoS ONE 1: e132.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"damselflies\",\n\t\ttrigger = \"look_damselfly\",\n\t\ttitle = \"The eastern forktail\",\n\t\ttext = \"The eastern forktail (Ischnura verticalis) is a damselfly 22 to 30 mm long of ponds, marshes and slow streams in eastern North America. The male's thorax is striped black and green and the tip of his abdomen blue. At rest it holds its four wings together over its back. A weak flier, it keeps low in the plants at the water's edge and eats flying insects. Phidippus audax has been seen eating a cicada three times its own length, and leaping at dragonflies far bigger than itself.\",\n\t\tgame = \"Here forktails perch on the cattails by day. One is two and a half housefly meals, but it sees you from far off, and caught it thrashes: few holds last. Its wariness and its struggle are the game's numbers.\",\n\t\tsources = {\n\t\t\t\"Wikipedia (read 2026). Eastern forktail.\",\n\t\t\t\"Minnesota Seasons (undated, read 2026). Eastern forktail, Ischnura verticalis. minnesotaseasons.com.\",\n\t\t\t\"Lockley, T. C. & Young, O. P. (1987). Phidippus audax (Araneae, Salticidae) predation upon a cicada (Tibicen sp.) (Homoptera, Cicadidae). Journal of Arachnology 14: 393-394.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"water_striders\",\n\t\ttrigger = \"look_skater\",\n\t\ttitle = \"Water striders\",\n\t\ttext = \"Water striders (Gerridae) spend their lives on the water. Water-repellent hairs on their long middle and hind legs let them skate on the surface film: the middle legs row, the hind legs steer, and the short front legs are held ready to grab. Each foot makes a dimple in the surface. They eat insects, and spiders, that fall onto the water and struggle there, finding them by their ripples, and several may share one meal.\",\n\t\tgame = \"Here striders skate the open water of the margin, and if you fall in the near ones come toward your ripples. They are not your prey: a strike at one finds it gone.\",\n\t\tsources = {\n\t\t\t\"Missouri Department of Conservation (undated, read 2026). Water striders. Missouri Field Guide, mdc.mo.gov.\",\n\t\t\t\"Wikipedia (read 2026). Gerris lacustris.\",\n\t\t\t\"U.S. Geological Survey (undated, read 2026). Surface tension allows a water strider to walk on water. usgs.gov.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"green_darner\",\n\t\ttrigger = \"darner\",\n\t\ttitle = \"The green darner\",\n\t\ttext = \"The common green darner (Anax junius) is one of the commonest dragonflies in North America, 6.8 to 8 cm long with wings to 10 cm across. Its young grow in ponds, lakes and slow streams, eating small water animals. The adults catch flying insects in the air: mosquitoes, flies, moths, wasps, even other dragonflies. In autumn many fly south, on average about 900 km.\",\n\t\tgame = \"Here a darner patrols over the pond by day. It hunts what flies, not what clings to a stem: it is no danger to you, and you cannot catch it.\",\n\t\tsources = {\n\t\t\t\"Wikipedia (read 2026). Green darner.\",\n\t\t},\n\t},\n\t{\n\t\tid = \"rare_luna_moth\",\n\t\ttrigger = \"rare_luna\",\n\t\ttitle = \"Rare sighting: luna moth\",\n\t\ttext = \"Actias luna is a native Illinois silk moth, with pale green wings, four eyespots and long hindwing tails. Adults do not feed. In experiments with hunting bats, the spinning tails diverted attacks away from the body. Flight seasons vary across its range; some populations have more than one brood.\",\n\t\tgame = \"A warm, dry night may bring one to the hut's outer windowsill until dawn. It is too large to catch. A wing can bear your spider here: an authored invitation to explore, not a claim about wild moths tolerating a rider.\",\n\t\tsources = {\n\t\t\t\"Illinois Department of Natural Resources, Luna moth (species account), https://dnr.illinois.gov/education/wildaboutpages/wildaboutinvertebrates/wildaboutmoths/family-saturniidae/wamblunamoth.html\",\n\t\t\t\"University of Florida IFAS, Luna Moth Actias luna (IN737), https://ask.ifas.ufl.edu/publication/IN737\",\n\t\t\t\"Barber et al. 2015, Moth tails divert bat attack (abstract, PNAS), https://pubmed.ncbi.nlm.nih.gov/25730869/\",\n\t\t},\n\t},\n} :: { Page }\n\nreturn NotebookPages\n",58257,3656924150},{"Shared/Data/Peacock","--!strict\n-- The peacock spider's courtship dance (ROBLOX-29): every number the dance needs, each marked DOC (reported in the paper) or ART\n-- (artistic: not reported, chosen to read well on a small screen). The dance is presentation only: a pose for the drawn spider,\n-- never a change to the motor, the senses, the jump or the silk.\n--\n-- Source: Girard, M. B., Kasumovic, M. M. & Elias, D. O. (2011). Multi-Modal Courtship in the Peacock Spider, Maratus volans\n-- (O.P.-Cambridge, 1874). PLoS ONE 6(9): e25390 (PMC3181266). Rates are mean +- SD of the paper's high-speed video and laser\n-- vibrometer records. Order in the paper: rumble-rumps and bobbing on approach, then leg waving with fan dancing, fan-flapping in\n-- the pauses, then a pre-mount display and a mounting attempt. The last two are left out on purpose: this is a family game.\n-- A real courtship lasts 6 to 51 minutes (mean 24.35, DOC); `loopSeconds` squeezes one round of it into a loop a player can watch.\n\nlocal Peacock = {}\n\nexport type Phase = {\n\tid: string, seconds: number, ease: number?, rumble: number?,\n\tpitch: number, open: number, legs: number, sway: number, wave: number, flap: number, bob: number, palp: number,\n}\n\nPeacock.id = \"maratus_volans_male\"\nPeacock.citation = \"Girard, Kasumovic & Elias 2011, PLoS ONE 6(9): e25390\"\n\n-- Real courtship length in minutes (DOC: range 6 to 51, mean 24.35). The game's loop is ART.\nPeacock.courtshipMinutes = { min = 6, max = 51, mean = 24.35 }\nPeacock.loopSeconds = 14.0 -- ART: one compressed round of the display (the phases below add up to it)\n\n-- ---------------------------------------------------------------- rates: DOC\n-- Hz = cycles (or flicks, waves, flaps, bumps) per second; sd is the paper's standard deviation, kept for the docs and tests.\nPeacock.rates = {\n\tpalpFlicker = { hz = 3.5, sd = 1.6 }, -- pedipalps flicker up and down in unison (DOC)\n\tfanDance = { hz = 3.2, sd = 1.5 }, -- abdomen sways side to side with the fan raised (DOC)\n\tlegWave = { hz = 3.2, sd = 0.6 }, -- legs III wave (DOC)\n\tfanFlap = { hz = 2.5, sd = 1.8 }, -- the fan flaps in and out during the pauses (DOC)\n\t-- Opisthosomal bobbing comes in bouts; the paper gives no rate. ART:\n\tbob = { hz = 4.0, boutSeconds = 0.8, restSeconds = 0.5 },\n}\n-- Rumble-rumps: vibrations through the substrate (felt, not seen). 2.44 +- 0.28 s long, 12.1 +- 2.9 bumps a second (DOC).\nPeacock.rumble = { seconds = 2.44, sd = 0.28, bumpsHz = 12.1, bumpsSd = 2.9, edgeSeconds = 0.12 }\n-- The fan dance sweeps the abdomen over an arc of 19 to 35 degrees (DOC); the game uses the middle of the range.\nPeacock.fanArcDeg = { min = 19, max = 35, used = 27 }\n\n-- ---------------------------------------------------------------- amplitudes: ART (the paper reports none of these)\nPeacock.amplitude = {\n\traiseDeg = 80, -- how far the abdomen pitches up (rear end up) to show the fan\n\tbobDeg = 6, -- the abdomen's bob, either side of its pitch\n\tshiverDeg = 1.2, -- the abdomen's visible tremble at 12.1 bumps a second during a rumble-rump\n\twaveDeg = 38, -- how far legs III sweep down in a wave\n\tflapDepth = 0.45, -- the fan closes to this much narrower (0.45: down to 55 % of its width) at the bottom of a flap\n\tpalpDeg = 22, -- the pedipalps' flick\n}\n\n-- ---------------------------------------------------------------- the phases (ART: the order is DOC, the times are ART)\n-- Each phase eases the levels from the previous phase's (the last phase's, for the first) over `ease` seconds, then holds them.\n-- Levels run 0..1: pitch (the abdomen raised: 1 is amplitude.raiseDeg), open (the fan), legs (legs III up), sway (the fan dance),\n-- wave (legs III waving), flap (fan-flapping), bob (bobbing bouts), palp (the pedipalps' flicker). `rumble` starts a rumble-rump\n-- `at` seconds into the phase and lasts Peacock.rumble.seconds.\nPeacock.ease = 0.45\nPeacock.phases = {\n\t{ id = \"approach\", seconds = 3.2, ease = 0.4, pitch = 0, open = 0, legs = 0, sway = 0, wave = 0, flap = 0, bob = 1, palp = 0.6, rumble = 0.4 },\n\t{ id = \"raise\", seconds = 1.3, ease = 1.1, pitch = 1, open = 1, legs = 1, sway = 0, wave = 0, flap = 0, bob = 0, palp = 0.4 },\n\t{ id = \"dance\", seconds = 3.4, ease = 0.4, pitch = 1, open = 1, legs = 1, sway = 1, wave = 1, flap = 0, bob = 0, palp = 1 },\n\t{ id = \"freeze\", seconds = 2.2, ease = 0.35, pitch = 1, open = 1, legs = 1, sway = 0, wave = 0, flap = 1, bob = 0, palp = 0.5 },\n\t{ id = \"dance_again\", seconds = 2.6, ease = 0.35, pitch = 1, open = 1, legs = 1, sway = 1, wave = 1, flap = 0, bob = 0, palp = 1 },\n\t{ id = \"fold\", seconds = 1.3, ease = 1.0, pitch = 0, open = 0, legs = 0, sway = 0, wave = 0, flap = 0, bob = 0, palp = 0.2 },\n} :: { Phase }\n\n-- ---------------------------------------------------------------- starting and stopping (ART)\nPeacock.rampInSeconds = 0.25 -- the pose arrives\nPeacock.fadeOutSeconds = 0.2 -- a stop (a step, a jump, leaving the surface) eases the pose out over this long\nPeacock.reducedMotion = 0.5 -- ReducedMotion halves the sway, wave, flap, bob and flick amplitudes and stops the tremble\n\n-- ---------------------------------------------------------------- the words (felt, not seen)\nPeacock.feltCaption = \"[a fine buzzing through your feet]\"\n\nreturn Peacock\n",5201,3184999491},{"Shared/Data/RareSightings","--!strict\n-- Only finished encounters are registered. The thirteen-creature roadmap is\n-- documentation, never a locked checklist or an exposed list of future pages.\nlocal Rare = {}\nRare.luna = {\n id=\"luna_moth\",page=\"rare_luna_moth\",chance=.35,days=4,\n -- Authoring bounds for a Midwest spring/summer flight window, not a claim\n -- that all Illinois populations fly on every date in it. See source audit.\n firstDay=121,lastDay=243,minTemperature=16,maxRain=.08,\n at=Vector3.new(18,.45,-20),span=10,\n}\nreturn Rare\n",514,4196839398},{"Shared/Data/RivalRules","--!strict\n-- When the brown rival spider arrives (ROBLOX-68). Game tuning, not measurements. Predator/RivalSpider reads these; nothing else decides it.\n-- One rival at a time on the eastern sill: it arrives, and when it is eaten a new one arrives on a later morning.\nlocal RivalRules = {}\n\n-- The protections of a brand-new life, as the wasp has them: no rival on the first day, and none before the first meal is finished.\nRivalRules.firstDay = 2\nRivalRules.firstMeals = 1\n-- A rival (the first, or the one after an eaten rival) arrives from this hour of the life clock: the morning, when the spider wakes (LifeClock.WAKE_H).\nRivalRules.arriveHour = 7.0\n-- It does not arrive on top of the spider: it waits while the spider is closer than this to the east end of the sill (WU).\nRivalRules.arriveDistance = 8.0\n-- Where it arrives, at the east end of the sill (WU).\nRivalRules.arriveAt = Vector3.new(25, 0.31, 8)\n\n-- ROBLOX-69: the rival roams the whole sill with its own motor. How often it decides (the motor itself steps every tick), how far and how it moves.\nRivalRules.thinkSeconds = 0.1\nRivalRules.sightWu = 8.0 -- it perceives the player up to here with a clear line (as before)\nRivalRules.patrolSpeed = 0.8 -- WU per second (it was 0.45 on its small territory)\nRivalRules.stalkSpeed = 1.1\nRivalRules.reachWu = 3.2 -- the windup begins this close, on the same face or one that meets it (ROBLOX-73: it was 2.5)\nRivalRules.rememberSeconds = 5.0 -- it keeps stalking where it last saw the spider this long after losing sight of it (it was 3)\n-- How long it must see the spider before it stalks it: the notice (0 to 1, rising one a second while it sees the spider) at which a patrolling\n-- rival starts to stalk. It was 0.6 in Godot's rule; the game's rival is quicker to take an interest (ROBLOX-73).\nRivalRules.stalkNotice = 0.45\nRivalRules.legSeconds = 240.0 -- a patrol leg that has not arrived by now is dropped for the next\nRivalRules.stuckSeconds = 4.0 -- no progress for this long: the route is made again\n-- ROBLOX-73: striking a rival that has seen the spider coming is a contest, not a sure catch. A rival is aware when it is stalking or winding up,\n-- or patrolling with a notice of at least awareNotice; a recovering rival or a patrolling one that has not noticed is still caught outright. The\n-- draw is from a stream of its own (RivalSpider.contest, by the world's seed, the day and how many contests this rival has had): the rival is\n-- caught (contestCaptured), springs clear of the strike (contestSprang) or, for the rest, bites back and costs counterCost of the spider's energy\n-- (about half of a day's; nothing in the gentle modes). ROBLOX-88: harder to take down: 40 caught, 32 sprang clear, 28 bit back (it was 55/25/20), and a\n-- bite costs 0.30 (it was 0.25; a day costs about 0.61 at the game's hunger drain).\nRivalRules.awareNotice = 0.3\nRivalRules.contestCaptured = 0.40\nRivalRules.contestSprang = 0.32 -- (and 0.28 is left for the counter-bite)\nRivalRules.counterCost = 0.30\n-- ROBLOX-91: the gentle modes (Easy, Free play) keep ROBLOX-73's contest, 55 caught / 25 sprang clear / 20 a bite that costs nothing: ROBLOX-88's harder rival is for\n-- the standard rules (the draw is the same stream; only the thresholds differ). The gentle grip (Catch.forRival) and the free bite are as they were.\nRivalRules.contestGentle = { captured = 0.55, sprang = 0.25 }\n-- ROBLOX-106 (W4, Nathan: \"a rival that camps by the retreat\"): in the standard rules (the client's drive is told `camps`, and the snapshot `nature`), a patrol leg is now\n-- and then a watch by the crack: a draw of its own for each leg (from the world's seed and the leg's number, which the rival's record keeps) makes one leg in `chance`\n-- go to one of `spots` on the floor round the crack's mouth (each a stud or more outside the keep-out, two to five from the retreat's door) and stand there `seconds`\n-- (drawn) before it patrols on. It still sees, stalks and lunges as on any leg; while the spider is in the crack it waits where it is, as it always has. `camp` (the\n-- seconds left, once it is there) is in the rival's record.\nRivalRules.camp = {\n\tchance = 0.15, seconds = { 60.0, 180.0 },\n\tspots = { Vector3.new(-21.5, 0, 6.0), Vector3.new(-21.5, 0, 3.5), Vector3.new(-21.5, 0, 8.5), Vector3.new(-25.5, 0, 10.8) },\n}\n-- Nothing the rival does goes in here: the retreat grown by half a stud (the crack itself is also a hard check).\nRivalRules.keepOutMin = Vector3.new(-30.0, -0.5, 2.5)\nRivalRules.keepOutMax = Vector3.new(-22.8, 2.0, 9.5)\n-- The sill the rival may walk (the frames' outer faces and the underside of the floor are outside it).\nRivalRules.sillMin = Vector3.new(-31.05, -0.05, -13.55)\nRivalRules.sillMax = Vector3.new(31.05, 40.0, 12.55)\n\nreturn RivalRules\n",4763,1285962216},{"Shared/Data/SaveRules","--!strict\n-- Every number and name the persistent saves use (ROBLOX-39): store names, key prefixes, sizes, timings, limits. The logic is in\n-- Shared/Persistence/Save*.luau; none of it carries a number of its own. Sizes were measured on real checkpoints (tests/state.luau\n-- prints them; docs/HANDOFF-roblox-state.md records them).\nlocal SaveRules = {}\n\n-- ---------------------------------------------------------------- where it is kept\nSaveRules.STORE_PRODUCTION = \"Windowsill_v1\"\nSaveRules.STORE_TEST = \"WindowsillTest_v1\" -- Studio and the test place: Chet's runs never touch a real save\nSaveRules.KEY_PROGRESS = \"P_\" -- P_<UserId>: the player's progress (small, precious)\nSaveRules.KEY_REST = \"R_\" -- R_<UserId>_main, R_<UserId>_easy, R_<UserId>_free: the last rest of each slot (larger, replaceable)\n-- The slots a rest is filed in (ROBLOX-91): the standard main life (\"main\": every save made before the Easy slot existed keeps this key, whatever its rules), the main\n-- life on Easy's gentle rules (\"easy\": it used to share the main slot, so starting Easy wiped the standard rest) and free play (\"free\").\nSaveRules.MODES = { \"main\", \"free\", \"easy\" } :: { string }\nSaveRules.FORMAT = \"the-windowsill save\"\nSaveRules.REMOTES_NAME = \"SaveRemotes\" -- the folder in ReplicatedStorage holding ToServer and ToClient\n\n-- ---------------------------------------------------------------- sizes (characters of canonical JSON)\n-- Expanded validation bounds, NOT the stored-value budget. The full preserve initialization is 2.28M characters.\n-- Server/RestCompression bounds the actual compressed envelope INCLUDING its backup to 1.5M stored characters,\n-- and checks its Zstd frame size before expanding (12M maximum). Old uncompressed records remain readable.\nSaveRules.MAX_REST_CHARS = 5000000\nSaveRules.MAX_REST_NODES = 600000 -- values a rest may hold, checked before encoding/checkpoint graph construction\nSaveRules.MAX_DEPTH = 24\nSaveRules.MAX_PROGRESS_CHARS = 16384\nSaveRules.MAX_VALUE_CHARS = 4194304 -- Roblox's own limit on one stored value\nSaveRules.MAX_PROGRESS_NODES = 1500 -- values a progress message may hold, counted before anything reads it\nSaveRules.MAX_PROGRESS_DEPTH = 8\nSaveRules.MAX_PAGES = 200 -- notebook ids kept (the book has 25 pages; room for the future)\nSaveRules.MAX_ID_CHARS = 48\nSaveRules.MAX_EYE_SECONDS = 1.0e9\n\n-- ---------------------------------------------------------------- timing (seconds)\nSaveRules.PROGRESS_DEBOUNCE = 30 -- at most one progress write in this time (events in between are coalesced)\nSaveRules.REST_MIN_INTERVAL = 10 -- a key may be written about every 6 s; this leaves room\nSaveRules.HEARTBEAT = 30 -- the session lock is refreshed this often\nSaveRules.LOCK_STALE = 120 -- a lock older than this may be taken over by a newer session\nSaveRules.BACKOFF_BASE = 2\nSaveRules.BACKOFF_CAP = 60\nSaveRules.RETRY_LOAD = 15 -- a session that could not load or lock tries again this often\nSaveRules.FLUSH_ATTEMPTS = 4 -- tries at leaving or shutting down, with the backoff between\nSaveRules.FLUSH_BACKOFF = 1\nSaveRules.FLUSH_DEADLINE = 24 -- BindToClose has 30 s in all\nSaveRules.REQUESTS_PER_MINUTE = 10 -- DataStore requests one player's session may start in a minute (the budget is 60 + 10 per player)\n\n-- ---------------------------------------------------------------- what the client may send (per player)\nSaveRules.PROGRESS_BURST = 6\nSaveRules.PROGRESS_PER_SECOND = 0.5\nSaveRules.REST_BURST = 2\nSaveRules.REST_PER_SECOND = 0.2\nSaveRules.LIFE_BURST = 2\nSaveRules.LIFE_PER_SECOND = 0.2\nSaveRules.MAX_LIFE_SERIAL = 1000000000\nSaveRules.MAX_LIFE_TOKEN_CHARS = 160\nSaveRules.CLIENT_LIFE_GAP = 5 -- retry one idempotent retirement intent until durable acknowledgement\nSaveRules.PROTOCOL = 2 -- the version of the messages between client and server\nSaveRules.CLIENT_HELLO_GAP = 2.5 -- the client says hello again this often until the server answers\nSaveRules.CLIENT_HELLO_TRIES = 6\nSaveRules.CLIENT_PROGRESS_GAP = 2 -- the client sends at most one progress message in this time\nSaveRules.CLIENT_EYE_GAP = 30 -- and re-sends the eye-view seconds this often when they changed\nSaveRules.CLIENT_WAIT_REMOTES = 1.5 -- the start menu waits this long for the server's remotes to appear\nSaveRules.CLIENT_WAIT_REPLY = 4 -- and this long for the first reply after saying hello\n\n-- ---------------------------------------------------------------- words for statuses\nSaveRules.STATUS = { saved = \"saved\", saving = \"saving\", session = \"session\" } -- session: this visit only\nSaveRules.REASONS = { \"offline\", \"no_api\", \"load_failed\", \"other_session\", \"corrupt\", \"newer\", \"write_failed\", \"rest_refused\" } :: { string }\n\n-- The slot a life's rests are filed in: free play's own, the main life on the gentle rules (Easy) its own, and the standard main life the key it always had.\nfunction SaveRules.slotOf(mode: string, rules: string): string\n\tif mode == \"free\" then return \"free\" end\n\tif rules == \"gentle\" then return \"easy\" end\n\treturn \"main\"\nend\n\nreturn SaveRules\n",4993,4120987902},{"Shared/Data/SettingsSpec","--!strict\n-- Every setting the player can change (ROBLOX-49): its id, words, kind, default and range. One table, no logic: Shared/UI/SettingsModel\n-- checks and steps the values, Client/SettingsPanel shows them, Shared/Persistence/SaveProgress keeps them, and each one is read live by\n-- the part of the client it belongs to (tests/settings.luau lists who reads which).\n--\n-- An id is also the name of the Player attribute that holds the value at run time (the older toggles already were: FocusToggle, ReducedMotion,\n-- ShowLastSeen, AutomaticGrip, NotebookNotes, LargeText, SoundMuted), so a setting nobody has changed is an attribute nobody has set.\n--\n-- Kinds: \"toggle\" (true or false), \"slider\" (a number from min to max in steps), \"choice\" (one of the listed options, by id), and, for a live row only,\n-- \"action\" (a button that does something when it is switched: Inspect your spider, ROBLOX-90; it has no value).\n-- The words follow the frozen Godot game's settings (scripts/presentation/settings.gd and pause_menu.gd) where a setting matches; the ones\n-- Godot had that the port has no part for (stalk and jump-aim toggles, the jump arc, strike assist, headphones, rumble, slow-motion speed,\n-- remapping keys) are left out on purpose and listed in docs/HANDOFF-roblox-settings.md.\nlocal SettingsSpec = {}\n\n-- The version of this table's meaning. Raise it when an id is renamed or a value changes its meaning, and add a step to\n-- SettingsModel.MIGRATIONS (the saved settings are carried forward from the version they were written at).\nSettingsSpec.VERSION = 1\n\nexport type Option = { id: string, label: string }\nexport type Setting = {\n\tid: string, section: string, label: string, kind: string, default: boolean | number | string,\n\tmin: number?, max: number?, step: number?, unit: string?, options: { Option }?,\n\tnote: string?, -- a short line under the setting\n}\n\nSettingsSpec.SECTIONS = {\n\t{ id = \"sound\", title = \"Sound\" },\n\t{ id = \"camera\", title = \"Camera\" },\n\t{ id = \"comfort\", title = \"Comfort and accessibility\" },\n\t{ id = \"help\", title = \"Help and hints\" },\n\t{ id = \"spider\", title = \"Your spider\" },\n} :: { { id: string, title: string } }\n\n-- Units name how a slider's number is shown (SettingsModel.valueText): percent of 1, a plain multiplier, degrees, studs.\nSettingsSpec.LIST = {\n\t-- ---------------------------------------------------------------- sound (Client/Soundscape)\n\t{ id = \"SoundMuted\", section = \"sound\", label = \"Mute all sound\", kind = \"toggle\", default = false },\n\t{ id = \"MasterVolume\", section = \"sound\", label = \"Volume\", kind = \"slider\", default = 1.0, min = 0.0, max = 1.0, step = 0.05, unit = \"percent\" },\n\t{ id = \"AmbienceVolume\", section = \"sound\", label = \"Room sounds and birds\", kind = \"slider\", default = 1.0, min = 0.0, max = 1.0, step = 0.05, unit = \"percent\" },\n\t{ id = \"CreatureVolume\", section = \"sound\", label = \"Flies and the wasp\", kind = \"slider\", default = 1.0, min = 0.0, max = 1.0, step = 0.05, unit = \"percent\" },\n\t{ id = \"MusicVolume\", section = \"sound\", label = \"Ambient music\", kind = \"slider\", default = 1.0, min = 0.0, max = 1.0, step = 0.05, unit = \"percent\" },\n\t{ id = \"Captions\", section = \"sound\", label = \"Captions for sounds and vibrations\", kind = \"choice\", default = \"normal\",\n\t\toptions = { { id = \"off\", label = \"Off\" }, { id = \"normal\", label = \"Normal\" }, { id = \"large\", label = \"Large\" } },\n\t\tnote = \"A line for the wasp's hum and the buzz felt through the feet, with its direction.\" },\n\t-- ---------------------------------------------------------------- camera (Client/SpiderCamera)\n\t{ id = \"LookSensitivityMouse\", section = \"camera\", label = \"Mouse look speed\", kind = \"slider\", default = 1.0, min = 0.2, max = 3.0, step = 0.05, unit = \"times\" },\n\t{ id = \"LookSensitivityStick\", section = \"camera\", label = \"Stick look speed\", kind = \"slider\", default = 1.0, min = 0.2, max = 3.0, step = 0.05, unit = \"times\" },\n\t{ id = \"LookSensitivityTouch\", section = \"camera\", label = \"Touch drag look speed\", kind = \"slider\", default = 1.0, min = 0.2, max = 3.0, step = 0.05, unit = \"times\" },\n\t{ id = \"InvertY\", section = \"camera\", label = \"Invert look up and down\", kind = \"toggle\", default = false },\n\t{ id = \"InvertX\", section = \"camera\", label = \"Invert look left and right\", kind = \"toggle\", default = false },\n\t{ id = \"CameraDistance\", section = \"camera\", label = \"Camera distance\", kind = \"slider\", default = 5.0, min = 4.0, max = 7.0, step = 0.1, unit = \"studs\" },\n\t{ id = \"FieldOfView\", section = \"camera\", label = \"Field of view\", kind = \"slider\", default = 65.0, min = 50.0, max = 90.0, step = 1.0, unit = \"degrees\",\n\t\tnote = \"The spider-eye view keeps its own.\" },\n\t{ id = \"FrameLine\", section = \"camera\", label = \"Frame the line after a catch\", kind = \"toggle\", default = true,\n\t\tnote = \"The view may turn to show the line while the spider hangs on it.\" },\n\t-- ---------------------------------------------------------------- comfort and accessibility\n\t{ id = \"ReducedMotion\", section = \"comfort\", label = \"Reduced motion (a calmer spider body)\", kind = \"toggle\", default = false },\n\t{ id = \"LargeText\", section = \"comfort\", label = \"Large text\", kind = \"toggle\", default = false, note = \"Menus, panels and the notebook.\" },\n\t{ id = \"FocusToggle\", section = \"comfort\", label = \"Focus toggles (press to start and stop)\", kind = \"toggle\", default = false },\n\t{ id = \"AutomaticGrip\", section = \"comfort\", label = \"Hold prey and eat automatically\", kind = \"toggle\", default = false,\n  note = \"Keeps your grip and takes bites without repeated taps. Moving still pauses eating.\" },\n\t{ id = \"ShowNoticed\", section = \"comfort\", label = \"Show what the spider notices\", kind = \"toggle\", default = true,\n\t\tnote = \"The rings, marks and words over what it sees. A lock (R or L1) still follows it.\" }, -- L1 locks on a controller\n\t{ id = \"ShowLastSeen\", section = \"comfort\", label = \"Show the last-seen mark\", kind = \"toggle\", default = true },\n\t{ id = \"EyeLevelHorizon\", section = \"comfort\", label = \"Spider-eye view: level horizon (no roll on walls)\", kind = \"toggle\", default = false },\n\t{ id = \"EyeGrey\", section = \"comfort\", label = \"Spider-eye view: grey instead of green\", kind = \"toggle\", default = false },\n\t-- ---------------------------------------------------------------- help and hints\n\t{ id = \"ControlHints\", section = \"help\", label = \"Show control hints\", kind = \"toggle\", default = true,\n\t\tnote = \"Feeding and dusk/rest prompts, every catch and night. Menu, Controls opens the full controls card.\" },\n\t{ id = \"NotebookNotes\", section = \"help\", label = \"Say when a new notebook page opens\", kind = \"toggle\", default = true },\n} :: { Setting }\n\n-- Rows that show and drive something the game already keeps elsewhere, so they are not saved settings (ROBLOX-71): no Player attribute of the\n-- id, nothing in the save's settings, nothing in Reset to defaults. The spider is kept in the save as `appearance` (Player attribute\n-- `Appearance`), and the client drives it through the panel's Io. `default` is only what an unknown reading says. The options and the words of\n-- a live row come from the part that owns it (the Spider row's from Rig/SpiderChoice and UI/PeacockText, through SettingsModel), not from here.\nSettingsSpec.LIVE = {\n\t{ id = \"Spider\", section = \"spider\", label = \"Spider\", kind = \"choice\", default = \"first_spider\",\n\t\tnote = \"Change it anywhere you stand safely. Not while jumping, on silk, moulting or holding prey.\" },\n\t-- ROBLOX-90: a button, not a value. It closes the panel into Inspect mode (a slow, close look at the spider), when the spider stands safely.\n\t{ id = \"Inspect\", section = \"spider\", label = \"Inspect your spider\", kind = \"action\", default = false,\n\t\tnote = \"A slow, close look from every side. Only while you stand safely. Cancel leaves.\" },\n} :: { Setting }\n\n-- How big the caption text is for each Captions option, as a multiple of the HUD's caption size (0: no captions of sounds at all).\nSettingsSpec.CAPTION_SCALE = { off = 0, normal = 1, large = 1.5 } :: { [string]: number }\n\nSettingsSpec.WORDS = {\n\ttitle = \"Settings\",\n\treset = \"Reset to defaults\",\n\tresetSure = \"Press again to reset\",\n\tresetDone = \"Settings are back to their defaults.\",\n\tclose = \"Back\",\n\tmenuChoice = \"Settings\",\n\ton = \"On\",\n\toff = \"Off\",\n\tsavedLine = \"Your settings are kept with your saved game.\",\n\tsessionLine = \"Saving is off for this visit, so these settings last only until you leave.\",\n}\n\nreturn SettingsSpec\n",8416,1024431409},{"Shared/Data/Species","--!strict\n-- GENERATED by tools/json_to_luau.py from data/species/*.json. Do not edit by hand.\n-- Species profiles. 1 Godot WU = 1 stud, so every value is unchanged.\nlocal data = {\n\tfly_like_prototype = {\n\t\tschema_version = 1,\n\t\tid = \"fly_like_prototype\",\n\t\tbiological_status = \"prototype_behavior_no_species_claim\",\n\t\tbody = {\n\t\t\tradius_wu = 0.3,\n\t\t\tlength_wu = 0.7,\n\t\t\thover_wu = 0.16,\n\t\t\tcapture_radius_wu = 0.45, -- Nathan playtest: total contact allowance 0.70 -> 0.75 WU (+7%); senses unchanged\n\t\t\tnutrition = 0.35,\n\t\t\tcapture_assist_scale = 1.6,\n\t\t\tfeed_rate_per_s = 0.1,\n\t\t},\n\t\tsenses = {\n\t\t\tsight_range_wu = 14.0,\n\t\t\tfull_sensitivity_wu = 3.0,\n\t\t\tfront_half_deg = 90.0,\n\t\t\trear_half_deg = 150.0,\n\t\t\trear_gain = 0.12,\n\t\t\tmotion_threshold_deg_s = 10.0,\n\t\t\tmotion_scale_deg_s = 6.0,\n\t\t\tloom_scale_deg_s = 80.0,\n\t\t\tappear_motion_deg_s = 18.0,\n\t\t\tappear_range_wu = 8.0,\n\t\t\tsample_gap_max_s = 0.4,\n\t\t\tnear_check_ran