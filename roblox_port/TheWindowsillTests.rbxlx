    mateLegs.stage:drawMate(life.mate,appearance,if paused then 0 else simFrame,setting("ReducedMotion")==true,mateLegs.couple.focus,mateLegs.couple.turn,camera.CFrame.Position)
    mateLegs.stage:drawSac(mateLegs.Mating.hasSac(life.mating))
    if mateLegs.phase=="scene" and not paused and not mateLegs.stage:step(simFrame,setting("ReducedMotion")==true) then mateLegs.showCard(false) end
    if mateLegs.phase=="ride" and not GuiService.MenuIsOpen then mateLegs.rideFrame(frameDt) end -- (ROBLOX-120)
	M.Prof.lap("other rigs")
	updateHud(frameDt)
	M.Prof.lap("hud")
	-- (ROBLOX-103: the bodies step, sway and beat by the prey's clock; far ones ten times a second; Reduced Motion stills all but the steps)
	flyBodies:draw(M.World.prey:flies(),M.World.prey.clock,camera.CFrame.Position,setting("ReducedMotion")==true,M.meal.heldView)
	M.Prof.lap("fly bodies")
	M.Prof.count("fly parts placed", flyBodies.moved or 0)
	M.World.bugs:draw(M.World.prey:crawlers(),M.World.prey.clock,camera.CFrame.Position,setting("ReducedMotion")==true)
	M.Prof.lap("bug bodies")
	M.Prof.count("bug parts placed", M.World.bugs.moved or 0)
	local soundPaused = GuiService.MenuIsOpen or modal()
	local soundSpeed = if slow then SLOW_SPEED else 1
	local soundMuted = setting("SoundMuted") == true
	soundscape:setVolumes(setting("MasterVolume"), setting("AmbienceVolume"), setting("CreatureVolume"), setting("MusicVolume"))
	soundscape:setTitle(not testPlace and (not session.started or M.title:holding())) -- (ROBLOX-109: the music under the title card, rising the first time)
	soundscape:update(frameDt, M.World.prey.view, life.daylight, soundPaused, soundSpeed, soundMuted)
	soundscape:updateWasp(wasp, soundPaused, soundSpeed, soundMuted)
 soundscape:updateMeal(prey.feeding.bites,prey.feeding.mealsFinished,soundPaused,soundMuted,soundSpeed)
	waspBody:draw(wasp.wasp, prey.now)
	if M.crabBody ~= nil then M.crabBody:draw(M.crab) end -- (ROBLOX-119)
	if M.mouseBody ~= nil then M.mouseBody:draw(M.mouse,setting("ReducedMotion")==true) end
	if M.pondBodies ~= nil then -- (ROBLOX-122: the frog and the darner)
		local dAt, dHeading = M.Pond.darner(914, prey.now, life.clock.hour)
		if dAt ~= nil and (dAt - motor.pos).Magnitude < 150 then watch:onDarner() end
		M.pondBodies:draw(M.frog, M.frogAt, dAt, dHeading, prey.now)
	end
	if M.birdBody ~= nil then M.birdBody:draw(M.bird, frameDt, if soundMuted or soundPaused then 0 else M.bird:call(motor.pos), if soundMuted or soundPaused then 0 else M.chirp) end -- (ROBLOX-120)
	if M.catBody ~= nil then
		local bell, purr = M.cat:sound(motor.pos)
		M.catBody:draw(M.cat, prey.now, if soundPaused then 0 else simFrame, if soundMuted or soundPaused then 0 else bell, if soundMuted or soundPaused then 0 else purr,camera.CFrame.Position)
	end
	M.Prof.lap("sound")
	local silk = motor.silk
	local live, bend = liveLine, bendLine
	if live and bend and silk.mode ~= "none" then
		local tip = rig:spinneretPoint(body)
		strand(silk.anchor, silk.bend or tip, live)
		live.Transparency = 0.35
		if silk.bend then
			strand(silk.bend, tip, bend)
			bend.Transparency = 0.35
		else
			bend.Transparency = 1
		end
	end
	for _, line in lines:GetChildren() do
		if line ~= liveLine and line ~= bendLine and line:IsA("BasePart") then
			local born = line:GetAttribute("Born")
			local age = time() - (if typeof(born) == "number" then born else time())
			if age > 25 then line:Destroy() else line.Transparency = math.max(line.Transparency, 0.35 + 0.65 * age / 25) end
		end
	end
	-- The camera's settings (ROBLOX-49), read each frame so a change in the panel shows at once.
	M.Prof.lap("lines")
	camSettings.mouse, camSettings.stick, camSettings.touch = setting("LookSensitivityMouse"), setting("LookSensitivityStick"), setting("LookSensitivityTouch")
	camSettings.invertX, camSettings.invertY = setting("InvertX"), setting("InvertY")
	camSettings.fov, camSettings.distance, camSettings.framing = setting("FieldOfView"), setting("CameraDistance"), setting("FrameLine")
	camSettings.levelHorizon = setting("EyeLevelHorizon")
	camSettings.reducedMotion = setting("ReducedMotion") == true
	cam:configure(camSettings)
	-- Looking runs in real time, so slow motion never makes the camera sluggish.
	local lx, ly = controls:lookAxes(jump:isAiming())
	if M.title:frame(frameDt, session.started, modal()) then -- (ROBLOX-109: the title card's drift, or the intro, has the camera this frame)
	elseif not modal() then
		if spiderPick.inspecting then
			local _, zoom = controls:axes() -- the left stick, or W and S: forward is closer (the close look)
			cam:inspectZoom(zoom, frameDt)
		end
		cam:setLock(M.lock.point)
		cam:render(frameDt, lx, ly)
	end
	-- The Focus that feeds the perception HUD also decides how far the principal eyes are in use (the eye view's picture). The
	-- picture sets the field of view, so it comes before the HUD projects anything.
	local focusing = motor.mode == "attached" and (controls.held.Focus == true or focusActive())
	do -- (ROBLOX-113: the camera's world queries this frame, for the profile)
		local st = cam.stats
		M.Prof.count("camera casts", st.casts); M.Prof.count("camera overlaps", st.overlaps); M.Prof.count("camera rays", st.rays); M.Prof.count("framing searches", st.searches)
		st.casts, st.overlaps, st.rays, st.searches = 0, 0, 0, 0
	end
	M.Prof.lap("camera")
	eyes:update(frameDt, focusing)
	M.Prof.lap("eyes")
	perceptionHud.gui.Enabled=M.World.world~="preserve"
	if perceptionHud.gui.Enabled then perceptionHud:draw(memory,camera,sightCast,focusing,setting("ShowLastSeen") == true,setting("ShowNoticed") ~= false,M.lock.point) end
	M.Prof.lap("perception hud")
	-- Depth of field: on the spider in third person; in the eye view SpiderEyes owns it and focuses on what is looked at.
	local dof = Lighting:FindFirstChild("MacroDOF")
	if not cam.eyeView and dof and dof:IsA("DepthOfFieldEffect") then
		dof.FocusDistance = (camera.CFrame.Position - motor.pos).Magnitude
	end
	M.Prof.finish()
end)

-- The test-place-only module exercises this controller in Studio. Absent from the playable build. Its hooks are also the live place's self-test's (ROBLOX-104, below).
M.hooks = function(): any
	return {
			prey = prey, flyBodies = flyBodies, waspBody = waspBody, life = life, wasp = wasp, caughtPanel = panel, needs = needs, checkpoints = checkpoints, returnToCheckpoint = function() returnToCheckpoint() end, lifeSpider = function() return lifeSpider end, sensor = sensor, memory = memory, focusState = focusState, perceptionHud = perceptionHud, stage = stage,
			input = controls, rivalLegs = rivalLegs, mateLegs = mateLegs, spiderPick = spiderPick, saveState = saveState, hud = hud,
			notebook = book, notebookWatch = watch, notebookPanel = nbPanel, openNotebook = openNotebook, settingsPanel = settingsPanel, openSettings = openSettings, setting = setting, cam = cam, soundscape = soundscape, eyes = eyes,
   rareBody=M.rareBody,rareHistory=M.rareHistory,rareDirector=M.RareDirector,
			meal=M.meal,contextPrompts=M.contextPrompts,session=session, menu=menu, openMenu=openMenu, endLife=endLife, fresh=fresh, stores=stores, continueAnother=continueAnother, currentStore=function() return checkpoints end,
			changeSpider = function() changeSpider() end, dance = function() return dance end, ant = function() return ant.state end, antPose = function() return ant.pose end, threat = function() return ant.threat end, threatPose = function() return ant.threatPose end, appearance = function() return appearance end, rig = function() return rig end,
			drop = function() motor:requestDrop() end,
			jump = jump,
			motor = motor,
			camera = cam,
			sill = sill,
			world = M.World,
			setDevice = function(name: ControlText.Device) device = name end,
			place = function(position: Vector3, up: Vector3?) -- (ROBLOX-103: `up` for a place on a wall's face; the floor's by default)
				controls:clear()
				jump:drop(motor)
				motor:place(position, up or Vector3.yAxis, if up ~= nil and math.abs(up.Z) > 0.9 then Vector3.yAxis else Vector3.zAxis)
				dropStrands(false)
				drawnUp = motor.up
				cam:snap()
			end,
			get = function()
				return { mode = motor.mode, line = motor.silk.mode, taut = motor.silk.taut, position = motor.pos, walking = motor.silk.walk ~= nil }
			end,
			detail = detail, -- (ROBLOX-104: the tier the self-test reports its part counts at)
			title = M.title, -- (ROBLOX-109: the title card and the intro, for the self-test's intro check)
			lock = M.lock, lockOn = M.LockOn, -- (ROBLOX-110: the lock's state and its rules)
			nature = M.nature, -- (ROBLOX-106: nature's rules this tick: the cover factor, the night's passes)
			prof = M.Prof, -- (ROBLOX-111: the frame timed by part, for the self-test's frame samples)
			cat = M.cat, Cat = M.Cat, -- (ROBLOX-118: the ranger's cat, nil in the test garden, and its rules)
			crab = M.crab, CrabSpider = M.CrabSpider, -- (ROBLOX-119: the crab spiders, nil in the test garden, and their rules)
			water = M.water, Water = M.Water, frog = M.frog, Frog = M.Frog, Pond = M.Pond, pondBodies = M.pondBodies, -- (ROBLOX-122: the water and the frog, nil in the test garden)
			bird = M.bird, Bird = M.Bird, -- (ROBLOX-120: the robin, nil in the test garden, and its rules)
	}
end
local playback = script.Parent:FindFirstChild("SilkPlayback")
if RunService:IsStudio() and playback and playback:IsA("ModuleScript") then
	task.spawn(function()
		local run: any = (require :: any)(playback)
		run(M.hooks())
	end)
end
-- The live place's self-test (ROBLOX-104, Client/SelfTest): only in Studio with the Workspace attribute SelfTest set true; nothing of it is loaded otherwise.
if RunService:IsStudio() and Workspace:GetAttribute("SelfTest") == true then require(script.Parent.SelfTest).start(M.hooks()) end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="246">
          <Properties>
            <string name="Name">SpiderEyes</string>
            <string name="Source"><![CDATA[--!strict
-- The spider-eye picture (ROBLOX-20): what the eye view looks like, drawn on this client from the pure rules of Shared/UI/EyeOptics
-- and the numbers, with the science and its citations, of Shared/Data/Eyes. Two ways of seeing, blended by k:
--   k = 0, the side eyes: wide (90 degrees), soft, nearly one colour (green), a little blurred, loosely focused, and they catch
--     movement (a ring where the sensor's sight-line checks found something moving, an arc at the edge when it is out of view);
--   k = 1, the principal eyes (Focus held, or toggled on): a narrow telephoto view (24 degrees), sharp, in green and ultraviolet,
--     only the looked-at distance in focus (depth from defocus), the UV layer of the decor showing.
-- Two retina strips at their true angular size scan the view, a vignette darkens the edges and a caption explains the first time.
-- Each frame in the eye view, after the camera is placed (SpiderCamera.render) and before the perception HUD draws: the camera's
-- field of view and SpiderCamera.lookScale, the colour grade and blur (ColorCorrectionEffect EyeGrade and BlurEffect EyeBlur in
-- Lighting), the depth of field (MacroDOF, if the world has one: this module owns it in the eye view and puts back what it
-- borrowed), the overlay (a ScreenGui under the HUD), and the transparency of the UV layer's parts. Outside the eye view it draws
-- nothing and has put everything back; the camera's field of view then belongs to SpiderCamera again.
-- Presentation only: it reads the sensor's motionSeen (never a fly), the camera and the player's attributes (ReducedMotion,
-- FocusToggle, EyeGrey) and moves nothing in the game: the senses, the motor, the jump planner, the aim ray and where the camera stands
-- are as they were.
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Eyes = require(Shared.Data.Eyes)
local EyeOptics = require(Shared.UI.EyeOptics)
local ControlText = require(Shared.UI.ControlText)
local Sensor = require(Shared.Perception.Sensor)
local SettingsModel = require(Shared.UI.SettingsModel)

local SpiderEyes = {}
SpiderEyes.__index = SpiderEyes

export type Options = {
	parent: Instance, -- the PlayerGui the overlay goes in
	camera: Camera,
	player: Player,
	cam: any, -- SpiderCamera: eyeView, aimRay(), lookScale
	sensor: any, -- Sensor: motionSeen, lastEye, core.tick
	params: RaycastParams, -- world-only casts (the sill), as the sensor's
}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function sequence(points: { { number } }): NumberSequence
	local keys: { NumberSequenceKeypoint } = {}
	for _, p in points do
		table.insert(keys, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return NumberSequence.new(keys)
end

-- A transparent frame centred on its position.
local function box(name: string, parent: Instance, zIndex: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.ZIndex = zIndex
	f.Visible = false
	f.Parent = parent
	return f
end

local function round(f: GuiObject)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
end

local function outline(f: GuiObject, color: Color3, thickness: number): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = f
	return s
end

local function gradient(f: Instance, rotation: number, points: { { number } }): UIGradient
	local g = Instance.new("UIGradient")
	g.Rotation = rotation
	g.Transparency = sequence(points)
	g.Parent = f
	return g
end

local function vignetteEdge(parent: Instance, name: string, anchor: Vector2, position: UDim2, size: UDim2, rotation: number): Frame
	local f = box("Vignette" .. name, parent, 1)
	f.AnchorPoint = anchor
	f.Position = position
	f.Size = size
	f.BackgroundColor3 = rgb(Eyes.vignette.color)
	f.BackgroundTransparency = 1 - Eyes.side.vignette
	f.Visible = true
	gradient(f, rotation, Eyes.vignette.ramp)
	return f
end

function SpiderEyes.new(o: Options): any
	local gui = Instance.new("ScreenGui")
	gui.Name = Eyes.overlay.name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true -- the middle of this screen is the middle of the camera's view, where the aim ray goes
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.DisplayOrder = Eyes.overlay.displayOrder
	gui.Enabled = false
	gui.Parent = o.parent

	-- The telephoto vignette: four edge frames, darkest at the screen's edge. The gradient's start is the edge.
	local V = Eyes.vignette
	local vignette: { Frame } = {
		vignetteEdge(gui, "Top", Vector2.new(0.5, 0), UDim2.fromScale(0.5, 0), UDim2.fromScale(1, V.topBottom), 90),
		vignetteEdge(gui, "Bottom", Vector2.new(0.5, 1), UDim2.fromScale(0.5, 1), UDim2.fromScale(1, V.topBottom), -90),
		vignetteEdge(gui, "Left", Vector2.new(0, 0.5), UDim2.fromScale(0, 0.5), UDim2.fromScale(V.leftRight, 1), 0),
		vignetteEdge(gui, "Right", Vector2.new(1, 0.5), UDim2.fromScale(1, 0.5), UDim2.fromScale(V.leftRight, 1), 180),
	}

	-- The two retina strips: a faint filled capsule with a thin outline, each with a fill that fades toward its ends.
	local R = Eyes.retina
	local strips: { { frame: Frame, stroke: UIStroke } } = {}
	for i = 1, 2 do
		local f = box("Retina" .. i, gui, 2)
		f.BackgroundColor3 = rgb(R.fillColor)
		f.BackgroundTransparency = Eyes.side.fillTransparency
		round(f)
		gradient(f, 90, R.fillRamp)
		strips[i] = { frame = f, stroke = outline(f, rgb(R.strokeColor), R.strokeThickness) }
	end

	local effects = Eyes.effects
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = effects.grade
	grade.Enabled = false
	grade.Parent = Lighting
	local blur = Instance.new("BlurEffect")
	blur.Name = effects.blur
	blur.Size = 0
	blur.Enabled = false
	blur.Parent = Lighting

	return setmetatable({
		camera = o.camera, player = o.player, cam = o.cam, sensor = o.sensor, params = o.params,
		gui = gui, vignette = vignette, vignetteShown = -1, strips = strips,
		rings = {} :: { any }, arcs = {} :: { any },
		grade = grade, blur = blur,
		on = false,
		phase = 0, k = 0, clock = 0,
		focusDistance = nil :: number?,
		dofSaved = nil :: any,
		uv = { folder = nil :: Instance?, parts = {} :: { any }, wait = 0, scan = true },
		captionAge = 0,
		moversShown = 0, -- how many movement rings and edge arcs the last frame drew (the notebook's "shimmer" reads it)
	}, SpiderEyes)
end

-- ---------------------------------------------------------------- entering and leaving the eye view
function SpiderEyes._enter(self: any)
	self.on = true
	self.phase, self.k = 0, 0
	self.focusDistance = nil
	self.gui.Enabled = true
	self.grade.Enabled = true
	self.uv.scan = true
end

function SpiderEyes._leave(self: any)
	self.on = false
	self.phase, self.k = 0, 0
	self.gui.Enabled = false
	self.grade.Enabled = false
	self.blur.Enabled = false
	self.cam.lookScale = 1
	self:_restoreDepthOfField()
	self:_setUv(0)
	self:_hideMovers(0, 0)
	self.moversShown = 0
end

-- Puts the world's depth of field back as the third person had it.
function SpiderEyes._restoreDepthOfField(self: any)
	local saved = self.dofSaved
	self.dofSaved = nil
	if saved ~= nil and saved.effect.Parent ~= nil then
		saved.effect.FarIntensity = saved.far
		saved.effect.NearIntensity = saved.near
		saved.effect.InFocusRadius = saved.radius
	end
end

-- ---------------------------------------------------------------- depth of field
-- The world's own MacroDOF, if there is one (the low tier has none): in the eye view its sharp zone follows what is looked at.
function SpiderEyes._depthOfField(self: any, p: EyeOptics.Profile)
	local dof = Lighting:FindFirstChild(Eyes.effects.dof)
	if dof == nil or not dof:IsA("DepthOfFieldEffect") or dof.Enabled == false then
		return
	end
	local saved = self.dofSaved
	if saved == nil or saved.effect ~= dof then
		self.dofSaved = { effect = dof, far = dof.FarIntensity, near = dof.NearIntensity, radius = dof.InFocusRadius }
	end
	dof.FocusDistance = self.focusDistance
	dof.FarIntensity = p.dofFar
	dof.NearIntensity = p.dofNear
	dof.InFocusRadius = p.dofRadius
end

-- ---------------------------------------------------------------- the UV layer
local function findUvFolder(): Instance?
	local node: Instance? = Workspace
	for _, name in Eyes.uv.folder do
		node = if node ~= nil then node:FindFirstChild(name) else nil
	end
	return node
end

-- Every part of the folder with the opacity it asks for (its own attribute, else the folder's, else none).
function SpiderEyes._collectUv(self: any, folder: Instance)
	local U = Eyes.uv
	local parts: { any } = {}
	local fallback = folder:GetAttribute(U.opacityAttribute)
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") then
			local own = d:GetAttribute(U.opacityAttribute)
			local opacity = if type(own) == "number" then own elseif type(fallback) == "number" then fallback else 0
			table.insert(parts, { part = d, opacity = opacity, last = 1 })
		end
	end
	self.uv.parts = parts
end

-- Sets the layer for k, looking the folder up first if need be (at most every lookupSeconds until it exists).
function SpiderEyes._updateUv(self: any, k: number, dt: number)
	local uv = self.uv
	if uv.folder == nil or uv.folder.Parent == nil then
		uv.wait -= dt
		if uv.wait > 0 then
			return
		end
		uv.wait = Eyes.uv.lookupSeconds
		uv.folder = findUvFolder()
		uv.scan = true
		if uv.folder == nil then
			return
		end
	end
	if uv.scan then
		uv.scan = false
		self:_collectUv(uv.folder)
	end
	self:_setUv(k)
end

function SpiderEyes._setUv(self: any, k: number)
	for _, e in self.uv.parts do
		local t = EyeOptics.uvTransparency(k, e.opacity)
		if t ~= e.last and e.part.Parent ~= nil then
			e.part.Transparency = t
			e.last = t
		end
	end
end

-- ---------------------------------------------------------------- the overlay
function SpiderEyes._drawVignette(self: any, p: EyeOptics.Profile)
	if p.vignette == self.vignetteShown then
		return
	end
	self.vignetteShown = p.vignette
	for _, f in self.vignette do
		f.BackgroundTransparency = 1 - p.vignette
	end
end

function SpiderEyes._drawStrips(self: any, strips: { EyeOptics.Strip }, p: EyeOptics.Profile)
	for i, s in strips do
		local w = self.strips[i]
		local f = w.frame
		f.Position = UDim2.fromOffset(s.x, s.y)
		f.Size = UDim2.fromOffset(s.w, s.h)
		f.Rotation = s.rotation
		f.BackgroundTransparency = p.fillTransparency
		f.Visible = true
		w.stroke.Transparency = p.strokeTransparency
	end
end

local function newRing(parent: Instance): any
	local S = Eyes.shimmer
	local f = box("Ring", parent, 3)
	round(f)
	local shadow = box("RingShadow", f, 3)
	shadow.Position = UDim2.fromScale(0.5, 0.5)
	shadow.Size = UDim2.new(1, S.shadowGrowPx * 2, 1, S.shadowGrowPx * 2)
	shadow.Visible = true
	round(shadow)
	return {
		frame = f, stroke = outline(f, rgb(S.ringColor), S.ringThickness),
		shadow = shadow, shadowStroke = outline(shadow, rgb(S.shadowColor), S.shadowThickness),
	}
end

local function newArc(parent: Instance): any
	local S, A = Eyes.shimmer, Eyes.shimmer.arc
	local bars: { any } = {}
	for i = 1, A.segments do
		local f = box("ArcBar", parent, 3)
		f.BackgroundColor3 = rgb(S.ringColor)
		f.Size = UDim2.fromOffset(A.length, A.thickness)
		round(f)
		bars[i] = { frame = f, stroke = outline(f, rgb(S.shadowColor), 1) }
	end
	return { bars = bars }
end

-- Hides the rings and arcs from the given counts on (everything when both are 0).
function SpiderEyes._hideMovers(self: any, rings: number, arcs: number)
	for i = rings + 1, #self.rings do
		self.rings[i].frame.Visible = false
	end
	for i = arcs + 1, #self.arcs do
		for _, b in self.arcs[i].bars do
			b.frame.Visible = false
		end
	end
end

-- The lateral eyes' movement sense. Only what the sensor's sight-line checks found moving is drawn (Sensor.motionSeen): the
-- point is where the sensor put the thing (the eye, along the sensed direction, at the sensed distance), never where a fly is.
function SpiderEyes._drawMovers(self: any, strips: { EyeOptics.Strip }, p: EyeOptics.Profile, size: Vector2, reduced: boolean)
	local S, sensor, camera = Eyes.shimmer, self.sensor, self.camera
	local now: number = sensor.core.tick
	local pulse = EyeOptics.pulse(self.clock, reduced)
	local look: CFrame = camera.CFrame
	local rings, arcs = 0, 0
	for _, m in EyeOptics.pickMovers(sensor.motionSeen, S.maxMovers) do
		local fresh = EyeOptics.freshness(now, m.tick, Sensor.MOTION_HOLD_TICKS)
		if fresh <= 0 then
			continue
		end
		local world: Vector3 = sensor.lastEye + m.direction * m.distance
		local v = camera:WorldToViewportPoint(world)
		if v.Z > 0 and EyeOptics.onScreen(v.X, v.Y, size.X, size.Y, 0) then
			rings += 1
			local ring = self.rings[rings]
			if ring == nil then
				ring = newRing(self.gui)
				self.rings[rings] = ring
			end
			local d = EyeOptics.ringDiameter(m.apparent, p.fovDeg, size.Y, pulse)
			local alpha = EyeOptics.ringAlpha(fresh, EyeOptics.insideAnyStrip(v.X, v.Y, strips))
			ring.frame.Position = UDim2.fromOffset(v.X, v.Y)
			ring.frame.Size = UDim2.fromOffset(d, d)
			ring.stroke.Transparency = 1 - alpha
			ring.shadowStroke.Transparency = 1 - alpha * S.shadowAlpha
			ring.frame.Visible = true
		else
			arcs += 1
			local arc = self.arcs[arcs]
			if arc == nil then
				arc = newArc(self.gui)
				self.arcs[arcs] = arc
			end
			local towards = look:VectorToObjectSpace(world - look.Position)
			local x, y, dx, dy = EyeOptics.edgeMark(towards.X, towards.Y, size.X, size.Y, S.arc.inset)
			local alpha = EyeOptics.arcAlpha(fresh, pulse)
			for i, seg in EyeOptics.arcSegments(x, y, dx, dy) do
				local bar = arc.bars[i]
				bar.frame.Position = UDim2.fromOffset(seg.x, seg.y)
				bar.frame.Rotation = seg.rotation
				bar.frame.BackgroundTransparency = 1 - alpha
				bar.stroke.Transparency = 1 - alpha * S.shadowAlpha
				bar.frame.Visible = true
			end
		end
	end
	self:_hideMovers(rings, arcs)
	self.moversShown = rings + arcs
end

-- ---------------------------------------------------------------- the words
-- The caption for the status area (SpiderHud shows it under the status lines): {text, alpha}, or nil when there is none. It is
-- shown the first time the eye view is open, for Eyes.caption.seconds of it, and not again.
function SpiderEyes.captionView(self: any, device: ControlText.Device): { text: string, alpha: number }?
	if not self.cam.eyeView then
		return nil
	end
	local alpha = EyeOptics.captionAlpha(self.captionAge)
	if alpha <= 0 then
		return nil
	end
	return { text = EyeOptics.captionText(ControlText.name(device, "focus"), self.player:GetAttribute("FocusToggle") == true, device == "gamepad"), alpha = alpha }
end

-- ---------------------------------------------------------------- the frame
-- Once a render frame, after SpiderCamera.render. dt: real seconds (looking runs in real time, slow motion or not). focusing: the
-- client's own notion of Focus (held, or toggled on, on a surface), the same that the perception HUD gets.
function SpiderEyes.update(self: any, dt: number, focusing: boolean)
	local on = self.cam.eyeView == true
	if on ~= self.on then
		if on then
			self:_enter()
		else
			self:_leave()
		end
	end
	if not on then
		return
	end
	local reduced = self.player:GetAttribute("ReducedMotion") == true
	self.phase = EyeOptics.stepPhase(self.phase, focusing, dt)
	local k = EyeOptics.engagement(self.phase)
	self.k = k
	self.clock += dt
	if self.captionAge < Eyes.caption.seconds then
		self.captionAge += dt
	end

	-- What is looked at: along the view, to the world only, at most 40 studs; the focus racks toward it.
	local origin, direction = self.cam:aimRay()
	local hit = Workspace:Raycast(origin, direction * Eyes.focus.maxDistance, self.params)
	local target = EyeOptics.focusTarget(if hit ~= nil then hit.Distance else nil)
	local focus: number? = self.focusDistance
	focus = if focus == nil then target else EyeOptics.focusStep(focus, target, dt)
	self.focusDistance = focus
	local p = EyeOptics.profile(k, focus :: number, reduced)

	self.camera.FieldOfView = p.fovDeg
	self.cam.lookScale = EyeOptics.lookScale(p.fovDeg)
	local grade = self.grade
	grade.Saturation, grade.TintColor, grade.Contrast, grade.Brightness = p.saturation, p.tint, p.contrast, p.brightness
	-- The comfort switch "grey instead of green" (T13a, ROBLOX-49): the same picture and brightness without the tint or any colour.
	if SettingsModel.get(function(id: string): any return self.player:GetAttribute(id) end, "EyeGrey") == true then
		grade.Saturation, grade.TintColor = -1, Color3.new(1, 1, 1)
	end
	self.blur.Size = p.blur
	self.blur.Enabled = p.blur > 0.05
	self:_depthOfField(p)
	self:_updateUv(k, dt)

	local size = self.camera.ViewportSize
	if size.Y < 1 then
		return
	end
	self:_drawVignette(p)
	local strips = EyeOptics.retinaStrips(self.clock, p, size.X, size.Y)
	self:_drawStrips(strips, p)
	self:_drawMovers(strips, p, size, reduced)
end

-- Puts everything back and removes what this made (tests; the client keeps it for the session).
function SpiderEyes.destroy(self: any)
	if self.on then
		self:_leave()
	end
	self.gui:Destroy()
	self.grade:Destroy()
	self.blur:Destroy()
end

return SpiderEyes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="247">
          <Properties>
            <string name="Name">SpiderHud</string>
            <string name="Source"><![CDATA[--!strict
-- The spider's screen: the centre dot and Focus ticks, the aim's words under them (Godot jump_hud.gd), a status line and
-- short toasts at the top, the controls card, and the prompt panel at the bottom (the line's own prompts while hanging,
-- what stops a walk to the edge, or a small reminder while walking). Words come from Shared/UI/ControlText for the device
-- in use. Everything but the centre dot sits in the safe area (ScreenInsets.CoreUISafeInsets) and wraps; the prompt panel
-- keeps clear of the touch buttons (Shared/UI/HudLayout).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HudLayout = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI"):WaitForChild("HudLayout"))
local LifeText = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI"):WaitForChild("LifeText"))

local Hud = {}
Hud.__index = Hud

local TOAST_SECONDS = 2.6
local CAPTION_TEXT = 15 -- the sound captions' text size at normal; view.captionScale (the Captions setting) multiplies it
local OK_COLOR = Color3.new(0.92, 0.94, 0.98)
local WARN_COLOR = Color3.new(1.0, 0.72, 0.1)
local DANGER_COLOR = Color3.new(1.0, 0.45, 0.36)
-- The quiet screen (ROBLOX-125, Nathan: "the hud is super intrusive"): words without plates, a thin hunger line, a narrow
-- column, and the day's words and a comfortable hunger line fading back once they have been read.
local STROKE = 0.55
local TOP_WIDTH = 460 -- the status column's widest (the prompt panel keeps HudLayout.MAX_PROMPT_WIDTH)
local HUNGER_WIDTH = 220
local SETTLE_SECONDS = 5 -- how long a changed day line or hunger line stays at full strength
local FADE_SECONDS = 1.5
local RESTING = 0.8 -- the transparency they settle to (a faint trace, not gone)
local CALM_FOOD = 0.4 -- above this the hunger line settles; at or below it stays in full

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function pad(parent: Instance, x: number, y: number)
	local p = Instance.new("UIPadding")
	p.PaddingLeft, p.PaddingRight = UDim.new(0, x), UDim.new(0, x)
	p.PaddingTop, p.PaddingBottom = UDim.new(0, y), UDim.new(0, y)
	p.Parent = parent
end

-- A label that keeps its width and wraps, growing downward (the safe way to wrap with AutomaticSize).
local function wrapLabel(name: string, parent: Instance, textSize: number, order: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundColor3 = Color3.new(0, 0, 0)
	l.BackgroundTransparency = 1 -- (ROBLOX-125: no plate; the outline keeps the words readable on the world)
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.TextStrokeTransparency = STROKE
	l.Font = Enum.Font.GothamMedium
	l.TextSize = textSize
	l.TextWrapped = true
	l.RichText = false
	l.Size = UDim2.new(1, 0, 0, 0)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.LayoutOrder = order
	l.Visible = false
	pad(l, 10, 5)
	corner(l, 8)
	l.Parent = parent
	return l
end

-- A short label sized to its text (single lines broken by hand), for the aim words at the centre.
local function pill(name: string, parent: Instance, textSize: number, order: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundColor3 = Color3.new(0, 0, 0)
	l.BackgroundTransparency = 1
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.TextStrokeTransparency = STROKE
	l.Font = Enum.Font.GothamMedium
	l.TextSize = textSize
	l.TextWrapped = false
	l.AutomaticSize = Enum.AutomaticSize.XY
	l.Size = UDim2.fromOffset(0, 0)
	l.LayoutOrder = order
	l.Visible = false
	pad(l, 10, 4)
	corner(l, 8)
	l.Parent = parent
	return l
end

local function column(name: string, parent: Instance, anchor: Vector2, position: UDim2, align: Enum.VerticalAlignment, maxWidth: number?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.AnchorPoint = anchor
	f.Position = position
	f.Size = UDim2.new(1, -32, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = align
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 6)
	list.Parent = f
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(maxWidth or HudLayout.MAX_PROMPT_WIDTH, math.huge)
	limit.Parent = f
	f.Parent = parent
	return f
end

function Hud.new(playerGui: Instance): any
	-- The centre dot must be at the true viewport centre (the camera's aim ray), so this layer ignores the insets.
	local centre = Instance.new("ScreenGui")
	centre.Name = "SpiderHud"
	centre.ResetOnSpawn = false
	centre.IgnoreGuiInset = true
	centre.ScreenInsets = Enum.ScreenInsets.None
	centre.Parent = playerGui
	local reticle = Instance.new("Frame")
	reticle.Name = "Reticle"
	reticle.AnchorPoint = Vector2.new(0.5, 0.5)
	reticle.Position = UDim2.fromScale(0.5, 0.5)
	reticle.Size = UDim2.fromOffset(6, 6)
	reticle.BackgroundColor3 = Color3.new(1, 1, 1)
	reticle.Visible = false
	corner(reticle, 3)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 1.5
	stroke.Parent = reticle
	reticle.Parent = centre
	local ticks: { Frame } = {}
	for i, off in { Vector2.new(-16, 0), Vector2.new(16, 0), Vector2.new(0, -16), Vector2.new(0, 16) } do
		local t = Instance.new("Frame")
		t.AnchorPoint = Vector2.new(0.5, 0.5)
		t.Position = UDim2.new(0.5, off.X, 0.5, off.Y)
		t.Size = if i <= 2 then UDim2.fromOffset(8, 2) else UDim2.fromOffset(2, 8)
		t.BackgroundColor3 = Color3.new(1, 1, 1)
		t.BorderSizePixel = 0
		t.Visible = false
		t.Parent = centre
		ticks[i] = t
	end
	local aimBox = Instance.new("Frame")
	aimBox.Name = "AimBox"
	aimBox.BackgroundTransparency = 1
	aimBox.AnchorPoint = Vector2.new(0.5, 0)
	aimBox.Position = UDim2.new(0.5, 0, 0.5, 24)
	aimBox.Size = UDim2.fromOffset(0, 0)
	aimBox.AutomaticSize = Enum.AutomaticSize.XY
	local aimList = Instance.new("UIListLayout")
	aimList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	aimList.SortOrder = Enum.SortOrder.LayoutOrder
	aimList.Padding = UDim.new(0, 3)
	aimList.Parent = aimBox
	aimBox.Parent = centre
	local aimTitle = pill("AimTitle", aimBox, 18, 1)
	local aimHint = pill("AimHint", aimBox, 15, 2)
	local anchorLabel = pill("Anchor", aimBox, 14, 3)

	-- Everything else: inside the safe area.
	local safe = Instance.new("ScreenGui")
	safe.Name = "SpiderPrompts"
	safe.ResetOnSpawn = false
	safe.IgnoreGuiInset = false
	safe.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	safe.Parent = playerGui
	local top = column("Top", safe, Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 8), Enum.VerticalAlignment.Top, TOP_WIDTH)
	-- The hunger bar (ROBLOX-78; the energy reserve, full when fed), not a damage/health system. Always present during play, even with hints off.
	-- (ROBLOX-125) A thin line with its words small above it, no plate: 220 px wide, the line 5 px.
	local food = Instance.new("Frame")
	food.Name = "HungerBar"
	food.Size = UDim2.fromOffset(HUNGER_WIDTH, 22)
	food.AutomaticSize = Enum.AutomaticSize.Y
	food.LayoutOrder = -2
	food.BackgroundTransparency = 1
	food.BorderSizePixel = 0
	food.Visible = false
	food.Parent = top
	local foodText = Instance.new("TextLabel")
	foodText.Name = "HungerText"
	foodText.BackgroundTransparency = 1
	foodText.Size = UDim2.new(1, 0, 0, 0)
	foodText.AutomaticSize = Enum.AutomaticSize.Y
	foodText.TextColor3 = Color3.new(1, 1, 1)
	foodText.TextStrokeColor3 = Color3.new(0, 0, 0)
	foodText.TextStrokeTransparency = STROKE
	foodText.Font = Enum.Font.GothamMedium
	foodText.TextSize = 13
	foodText.Parent = food
	local track = Instance.new("Frame")
	track.Name = "HungerTrack"
	track.AnchorPoint = Vector2.new(0, 1)
	track.Position = UDim2.fromScale(0, 1)
	track.Size = UDim2.new(1, 0, 0, 5)
	track.BackgroundColor3 = Color3.new(0, 0, 0)
	track.BackgroundTransparency = 0.6
	track.BorderSizePixel = 0
	track.Parent = food
	corner(track, 3)
	local foodFill = Instance.new("Frame")
	foodFill.Name = "HungerFill"
	foodFill.Size = UDim2.fromScale(0, 1)
	foodFill.BorderSizePixel = 0
	foodFill.BackgroundColor3 = Color3.fromRGB(120, 170, 110)
	foodFill.Parent = track
	corner(foodFill, 3)
	local grip = Instance.new("Frame")
 grip.Name="GripBar";grip.Size=UDim2.new(.65,0,0,12);grip.LayoutOrder=0;grip.BackgroundColor3=Color3.fromRGB(45,12,12);grip.Visible=false;grip.Parent=top
 local gripFill=Instance.new("Frame");gripFill.Name="Grip";gripFill.Size=UDim2.fromScale(.4,1);gripFill.BackgroundColor3=Color3.fromRGB(245,35,38);gripFill.BorderSizePixel=0;gripFill.Parent=grip
 -- The courtship meter (ROBLOX-80): the grip bar's style in a warm colour, under it, shown only while a mate can be courted (view.court, 0 to 1).
 local court = Instance.new("Frame")
 court.Name="CourtshipBar";court.Size=UDim2.new(.65,0,0,12);court.LayoutOrder=0;court.BackgroundColor3=Color3.fromRGB(48,22,32);court.Visible=false;court.Parent=top
 local courtFill=Instance.new("Frame");courtFill.Name="Courtship";courtFill.Size=UDim2.fromScale(0,1);courtFill.BackgroundColor3=Color3.fromRGB(226,128,164);courtFill.BorderSizePixel=0;courtFill.Parent=court
 local status = wrapLabel("Status", top, 16, 1)
	-- The spider-eye view's explanation, the first time (ROBLOX-20): right under the status lines, in the column, so it never covers
	-- the aim words or the prompts. Shown from view.caption = { text, alpha }.
	local caption = wrapLabel("Caption", top, CAPTION_TEXT, 2)
	-- The life loop's notices ("Morning, day 2", "Checkpoint kept."), for as long as LifeLoop keeps them (ROBLOX-24).
	local notice = wrapLabel("Notice", top, 16, 3)
	local toast = wrapLabel("Toast", top, 17, 4)
	local help = wrapLabel("Controls", top, 15, 5)
	help.TextXAlignment = Enum.TextXAlignment.Left
	-- Day/stage and notices share one vertical flow, so longer life labels never overlap checkpoint messages.
	local dayBox = Instance.new("Frame")
	dayBox.Name = "DayBox"
	dayBox.BackgroundTransparency = 1
	dayBox.LayoutOrder = -1
	dayBox.Size = UDim2.new(1, 0, 0, 0)
	dayBox.AutomaticSize = Enum.AutomaticSize.Y
	local dayList = Instance.new("UIListLayout")
	dayList.HorizontalAlignment = Enum.HorizontalAlignment.Left
	dayList.SortOrder = Enum.SortOrder.LayoutOrder
	dayList.Padding = UDim.new(0, 4)
	dayList.Parent = dayBox
	dayBox.Parent = top
	local day = wrapLabel("Day", dayBox, 15, 1)
	local dayLine = wrapLabel("DayLine", dayBox, 14, 2)
	dayLine.TextXAlignment = Enum.TextXAlignment.Left
	-- The notebook's note that a page opened (ROBLOX-37): under the day, for a few seconds.
	local note = wrapLabel("NotebookNote", dayBox, 15, 3)
	note.TextXAlignment = Enum.TextXAlignment.Left
	note.TextColor3 = Color3.new(0.96, 0.93, 0.82)
	local panel = Instance.new("Frame")
	panel.Name = "PromptPanel"
	panel.BackgroundTransparency = 1
	panel.AnchorPoint = Vector2.new(0, 1)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	local plist = Instance.new("UIListLayout")
	plist.HorizontalAlignment = Enum.HorizontalAlignment.Center
	plist.VerticalAlignment = Enum.VerticalAlignment.Bottom
	plist.SortOrder = Enum.SortOrder.LayoutOrder
	plist.Padding = UDim.new(0, 4)
	plist.Parent = panel
	panel.Parent = safe
	local promptTitle = wrapLabel("PromptTitle", panel, 17, 1)
	promptTitle.Font = Enum.Font.GothamBold
	local promptHint = wrapLabel("PromptHint", panel, 16, 2)
	local promptCue = wrapLabel("PromptCue", panel, 16, 3)
	promptCue.TextColor3 = WARN_COLOR
	local self = setmetatable({
		food = food, foodFill = foodFill, foodText = foodText, track = track, foodWords = "", foodCalm = 0, dayWords = "", dayCalm = 0, grip = grip, gripFill = gripFill, court = court, courtFill = courtFill, top = top, centre = centre, safe = safe, reticle = reticle, reticleStroke = stroke, ticks = ticks,
		aimTitle = aimTitle, aimHint = aimHint, anchorLabel = anchorLabel,
		status = status, caption = caption, toastLabel = toast, help = help, notice = notice, day = day, dayLine = dayLine, noteLabel = note, noteLeft = 0,
		panel = panel, promptTitle = promptTitle, promptHint = promptHint, promptCue = promptCue,
		toastLeft = 0, toastRank = 0, device = "keyboard", lastSpan = "",
	}, Hud)
	return self
end

-- A toast has a priority (ROBLOX-92; there is one label): `level` is false or nil for information, true (or "warn") for a warning and "danger" for something coming at the spider.
-- A toast of a lower priority than the one on show waits for it to expire and is dropped (a danger toast is kept for its seconds, whatever the game says next); an equal or higher one replaces it.
function Hud.toast(self: any, text: string, level: (boolean | string)?)
	if text == "" then return end
	local rank = if level == "danger" then 2 elseif level == true or level == "warn" then 1 else 0
	if self.toastLeft > 0 and rank < self.toastRank then return end
	self.toastLabel.Text = text
	self.toastLabel.TextColor3 = if rank == 2 then DANGER_COLOR elseif rank == 1 then WARN_COLOR else OK_COLOR
	self.toastLabel.Visible = true
	self.toastLeft = TOAST_SECONDS
	self.toastRank = rank
end

-- The note that a page opened in the notebook, for `seconds`.
function Hud.setNote(self: any, text: string, seconds: number)
	self.noteLabel.Text = text
	self.noteLabel.Visible = text ~= ""
	self.noteLeft = if text ~= "" then seconds else 0
end

local function show(label: TextLabel, text: string?)
	local t = text or ""
	if label.Text ~= t then label.Text = t end
	label.Visible = t ~= ""
end

-- How far a line has settled after `calm` seconds unchanged: 0 (full) until SETTLE_SECONDS, then easing to RESTING over FADE_SECONDS.
function Hud.settle(calm: number): number
	local t = math.clamp((calm - SETTLE_SECONDS) / FADE_SECONDS, 0, 1)
	return RESTING * t * t * (3 - 2 * t)
end

-- Places the prompt panel for the safe area's size and the device (HudLayout.promptSpan).
function Hud._place(self: any)
	local size = self.safe.AbsoluteSize
	local x0, x1, bottom = HudLayout.promptSpan(size.X, size.Y, self.device)
	-- The status column makes way for the Menu and Notebook buttons (HudLayout.topLayout).
	local t = HudLayout.topLayout(size.X, size.Y)
	local key = string.format("%.1f,%.1f,%.1f,%.1f,%.1f,%.1f", x0, x1, bottom, t.columnX0, t.columnX1, t.columnY)
	if key == self.lastSpan then return end
	self.lastSpan = key
	self.top.AnchorPoint = Vector2.new(0.5, 0)
	self.top.Position = UDim2.new(0, (t.columnX0 + t.columnX1) / 2, 0, t.columnY)
	self.top.Size = UDim2.new(0, t.columnX1 - t.columnX0, 0, 0)
	-- Anchored to the safe area's bottom edge (scale 1), so the panel's gap above the bottom holds even if the reported size
	-- and the children's origin disagree about an inset.
	self.panel.Position = UDim2.new(0, x0, 1, bottom - size.Y)
	self.panel.Size = UDim2.fromOffset(math.max(x1 - x0, 0), 0)
end

-- view: device, aiming, focus, eyeView, aimTitle, aimHint, aimColor, anchorText, anchorOk, status ({string}),
-- caption ({text, alpha} or nil), prompt ({title, hint, cue} or nil), helpVisible, helpText, notice, day and dayLine (strings or nil).
-- Active preserve play: the food reserve, a tiny manual aiming dot, and earned ability
-- notices explicitly requested by the player. An opened controls card is modal
-- reference material; automatic hints never enter this projection.
function Hud.minimalView(view: any): any
	local notice=nil
	for line in string.gmatch(view.notice or "", "[^\n]+") do
		if string.find(line,"^You can now run%.") or string.find(line,"^You can now lock on%.") then notice=line end
	end
	return {minimal=true,device=view.device,food=view.food,foodGentle=view.foodGentle,dot=view.dot==true,aiming=false,focus=false,eyeView=false,
		largeText=view.largeText,notice=notice,helpVisible=view.helpVisible and view.helpRequested,
		helpText=view.helpText,prompt=view.contextPrompt,status={}}
end
function Hud.update(self: any, view: any, dt: number)
	local minimal=view.minimal==true
	if minimal then
		view=Hud.minimalView(view)
		self.toastLabel.Visible=false;self.noteLabel.Visible=false
		self.toastLeft=0;self.noteLeft=0
	end
	self.foodText.Visible=not minimal
	self.food.Size=UDim2.fromOffset(if minimal then 150 else HUNGER_WIDTH,if minimal then 6 else 22)
	self.food.AutomaticSize=if minimal then Enum.AutomaticSize.None else Enum.AutomaticSize.Y
	self.track.Size=UDim2.new(1,0,0,if minimal then 6 else 5)
	self.food.Visible = type(view.food) == "number"
	if self.food.Visible then
		local food = math.clamp(view.food, 0, 1)
		self.foodFill.Size = UDim2.fromScale(food, 1)
		self.foodFill.BackgroundColor3 = if food <= 0.25 then Color3.fromRGB(196, 104, 40) else Color3.fromRGB(120, 170, 110)
		local words = LifeText.hunger(food, view.foodGentle == true)
		self.foodText.Text = if minimal then "" else words
		self.foodText.TextSize = if view.largeText then 24 else 13
		-- Settles once read: full for SETTLE_SECONDS after the words change, then fades to a trace; never while hungry.
		if words ~= self.foodWords or food <= CALM_FOOD then self.foodWords = words; self.foodCalm = 0 else self.foodCalm += dt end
		local a = Hud.settle(self.foodCalm)
		self.foodText.TextTransparency = a
		self.foodText.TextStrokeTransparency = STROKE + (1 - STROKE) * a
		self.foodFill.BackgroundTransparency = a * 0.7
		self.track.BackgroundTransparency = 0.6 + 0.3 * a
		if minimal then self.foodFill.BackgroundTransparency=.15;self.track.BackgroundTransparency=.55 end
	end
	self.grip.Visible = view.grip ~= nil
 if view.grip then self.gripFill.Size = UDim2.fromScale(math.clamp(view.grip,0,1),1) end
 self.court.Visible = view.court ~= nil
 if view.court then self.courtFill.Size = UDim2.fromScale(math.clamp(view.court,0,1),1) end
 self.device = view.device
	self:_place()
	self.reticle.Visible = view.dot == true or view.aiming or view.focus or view.eyeView
	self.reticle.Size=UDim2.fromOffset(if minimal then 2 else 6,if minimal then 2 else 6)
	self.reticleStroke.Thickness=if minimal then .75 else 1.5
	for _, t in self.ticks do t.Visible = view.focus == true end
	show(self.aimTitle, view.aimTitle)
	if view.aimColor then self.aimTitle.TextColor3 = view.aimColor end
	show(self.aimHint, view.aimHint)
	show(self.anchorLabel, view.anchorText)
	self.anchorLabel.TextColor3 = if view.anchorOk then OK_COLOR else WARN_COLOR
	show(self.status, table.concat(view.status or {}, "\n"))
	show(self.notice, view.notice)
	show(self.day, view.day)
	show(self.dayLine, view.dayLine)
	-- The day's words settle like the hunger line (still there, faint, for a glance).
	local dayWords = (view.day or "") .. "\n" .. (view.dayLine or "")
	if dayWords ~= self.dayWords then self.dayWords = dayWords; self.dayCalm = 0 else self.dayCalm += dt end
	local da = Hud.settle(self.dayCalm)
	for _, l in { self.day, self.dayLine } do
		l.TextTransparency = da
		l.TextStrokeTransparency = STROKE + (1 - STROKE) * da
	end
	local caption = view.caption
	if caption then
		local size = math.round(CAPTION_TEXT * (view.captionScale or 1))
		if self.caption.TextSize ~= size then self.caption.TextSize = size end
		if self.caption.Text ~= caption.text then self.caption.Text = caption.text end
		self.caption.TextTransparency = 1 - caption.alpha
		self.caption.TextStrokeTransparency = 1 - (1 - STROKE) * caption.alpha
		self.caption.Visible = true
	else
		self.caption.Visible = false
	end
	local prompt = view.prompt
	show(self.promptTitle, if prompt then prompt.title else nil)
	show(self.promptHint, if prompt then prompt.hint else nil)
	show(self.promptCue, if prompt then prompt.cue else nil)
	if view.helpVisible then show(self.help, view.helpText) else show(self.help, nil) end
	if self.noteLeft > 0 then
		self.noteLeft -= dt
		if self.noteLeft <= 0 then self.noteLabel.Visible = false end
	end
	if self.toastLeft > 0 then
		self.toastLeft -= dt
		if self.toastLeft <= 0 then self.toastLabel.Visible = false; self.toastRank = 0 end
	end
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="248">
          <Properties>
            <string name="Name">SpiderInput</string>
            <string name="Source"><![CDATA[--!strict
-- One action path for keyboard, mouse, gamepad and held on-screen touch buttons, all at once.
-- Bindings follow the frozen Godot game's scripts/core/input_setup.gd wherever the action exists in the port:
--   walk WASD / left stick (D-pad too), look mouse / arrow keys / right stick / touch drag, run Shift / LT, creep Ctrl / LB / gentle stick,
--   jump Space / A (tap hop, hold aim, release leap), cancel Q / B (cancels an aim or a walk to the edge; held on the
--   line it lets go), focus right mouse / RT, spider-eye view V / Y, recenter R / middle mouse / right-stick click,
--   slow motion T, lower on silk F / X (Godot: F / D-pad down; the port keeps the D-pad for walking, ROBLOX-05).
--   Esc / Menu open Roblox's own menu: the game drops every press and hold and waits (Godot's pause).
-- Port-only: reset to the start Backspace / View (Select), gait toggle G, controls card H (Godot's H is the field notes).
-- The peacock spider (ROBLOX-31): C changes spider in the crack (RB / R1 on a controller, the touch Change button); X, or the same RB / R1
-- outside the crack, starts and stops the courtship dance (the touch Dance button).
-- Inspect mode (ROBLOX-90): the same C / RB / Change held for 0.6 s in the crack starts the close look (a tap changes spider when it is let go, as before); in the look,
-- Cancel (Q / B), the same button again or the touch Back leave, Eye (V / Y / the touch View) cycles the framings, the left stick or W and S zoom.
-- The naturalist's notebook (ROBLOX-37): N opens it. Godot's D-pad up is the port's walking, so a controller reaches it through the life
-- menu (View / Touchpad, then Notebook); touch has the Notebook button beside Menu (SpiderClient).
-- The settings (ROBLOX-49): O opens them; a controller and touch reach them through the life menu (then Settings).
-- The lock (ROBLOX-110): Recentre (R / middle mouse / right-stick click / the touch Recentre) locks onto what the spider sees, lets go of a lock, or with
-- nothing to lock recentres; touch also has a small Lock button by Jump (no key: Recentre is the keys' lock), shown while something can be locked.
-- Nathan's run/lock controls: L1 / LB holds creep and takes a contextual lock on press; R2 / RT holds Focus.
-- Run is held on Shift / L2 / the touch Run button; Ctrl creeps. A gentle left-stick push creeps too.
--
-- Every button action is held while any source holds it (InputState): a key, a controller button, a finger. Handlers hear
-- one "begin" when the first source goes down and one "end" when the last comes up, so a touch hold and a key or button
-- held at the same time never cancel each other.
local CAS = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local InputState = require(Shared:WaitForChild("Movement"):WaitForChild("InputState"))
local HudLayout = require(Shared:WaitForChild("UI"):WaitForChild("HudLayout"))
local SpiderInput = {}

export type Handlers = {
	blocked: (() -> boolean)?, menu: (() -> ())?,
	feed: (() -> ())?,
	choose: (() -> ())?, -- C: change spider (in the crack); held 0.6 s, the close look (ROBLOX-90)
	chooseEnd: ((boolean?) -> ())?, -- ... and the last source of it let go (ROBLOX-90: a tap changes spider when it is let go, a hold does not); true when it did not end by the player's hand (the touch button was hidden under the finger, the engine took the input away: ROBLOX-92, nothing is changed then)
	notebook: (() -> ())?, -- N: the naturalist's notebook
	settings: (() -> ())?, -- O: the settings (ROBLOX-49)
	display: (() -> ())?, -- X / RB: the peacock spider's courtship dance
	displayEnd: ((boolean?) -> ())?, -- ... and let go (RB in the crack is a controller's choose key, ROBLOX-90), cancelled as chooseEnd
	focus: ((string) -> ())?,
	jump: (string) -> (), -- "begin", "end", or "cancel" (the engine took the input away)
	cancel: (string) -> (),
	drop: () -> (),
	clear: () -> (), -- focus loss, the Roblox menu, a text box, a lost controller
	reset: () -> (),
	gait: () -> (),
	eye: () -> (),
	recenter: () -> (),
	recentre: (() -> ())?, -- (ROBLOX-115) a controller's right-stick click: recentre only, never a lock
	lock: (() -> ())?, -- the touch Lock button (ROBLOX-110), and a controller's L1 press
	slow: () -> (),
	help: () -> (),
	touchLook: (Vector2) -> (),
	device: ((string) -> ())?, -- the last input's UserInputType name
}

local ONE_SHOT = { Menu = "menu", Notebook = "notebook", Settings = "settings", Reset = "reset", Gait = "gait", Eye = "eye", Recenter = "recenter", Slow = "slow", Help = "help", Lock = "lock",
	PadRecenter = "recentre" }

-- Bindings by action. Exported for tests and the controls table in README.md.
SpiderInput.BINDINGS = {
	Forward = { Enum.KeyCode.W, Enum.KeyCode.DPadUp }, Back = { Enum.KeyCode.S, Enum.KeyCode.DPadDown },
	Left = { Enum.KeyCode.A, Enum.KeyCode.DPadLeft }, Right = { Enum.KeyCode.D, Enum.KeyCode.DPadRight },
	LookLeft = { Enum.KeyCode.Left }, LookRight = { Enum.KeyCode.Right }, LookUp = { Enum.KeyCode.Up }, LookDown = { Enum.KeyCode.Down },
	Jump = { Enum.KeyCode.Space, Enum.KeyCode.ButtonA }, Cancel = { Enum.KeyCode.Q, Enum.KeyCode.ButtonB },
	Feed = { Enum.KeyCode.E, Enum.KeyCode.ButtonL3 },
	Drop = { Enum.KeyCode.F, Enum.KeyCode.ButtonX },
	Creep = { Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl, Enum.KeyCode.ButtonL1 },
	Focus = { Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonR2 },
	Run = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL2 },
	Eye = { Enum.KeyCode.V, Enum.KeyCode.ButtonY },
	Recenter = { Enum.KeyCode.R, Enum.UserInputType.MouseButton3 }, PadRecenter = { Enum.KeyCode.ButtonR3 }, -- (ROBLOX-115: R3 recentres only)
	Slow = { Enum.KeyCode.T }, Help = { Enum.KeyCode.H },
	Reset = { Enum.KeyCode.Backspace }, Menu = { Enum.KeyCode.M, Enum.KeyCode.ButtonSelect }, Gait = { Enum.KeyCode.G },
	Choose = { Enum.KeyCode.C }, Notebook = { Enum.KeyCode.N }, Settings = { Enum.KeyCode.O }, Display = { Enum.KeyCode.X, Enum.KeyCode.ButtonR1 },
} :: { [string]: { any } }

local function sourceOf(input: InputObject?): any
	if input == nil then return "default" end
	local t = input.UserInputType
	if t == Enum.UserInputType.Touch then return input end -- each finger is its own source
	if t == Enum.UserInputType.Keyboard or string.sub(t.Name, 1, 7) == "Gamepad" then return input.KeyCode end
	return t -- a mouse button
end

function SpiderInput.bind(h: Handlers)
	local state = InputState.new()
	local handlers: { [string]: any } = h :: any
	-- One source of one action went down (down) or up; "cancel" means the engine took the input away (treated as up).
	local function act(action: string, down: boolean, source: any, cancelled: boolean?)
		local blocked: boolean = if h.blocked then h.blocked() else false
		if down and blocked and action ~= tostring("Menu") then return end
		local hadSource = state.sources[action] ~= nil and state.sources[action][source] == true
		local was, now = state:set(action, down, source)
		-- L1 still locks when another source is already holding Creep; repeated Begin is not another press.
		if action == "Creep" and down and not hadSource and source == Enum.KeyCode.ButtonL1 and h.lock then h.lock() end
		if was == now then return end
		if action == "Jump" then
			h.jump(if now then "begin" elseif cancelled then "cancel" else "end")
		elseif action == "Cancel" then
			h.cancel(if now then "begin" else "end")
		elseif action == "Focus" then
			if h.focus then h.focus(if now then "begin" elseif cancelled then "cancel" else "end") end
		elseif action == "Feed" then
			if now and h.feed then h.feed() end
		elseif action == "Choose" then
			if now and h.choose then h.choose() elseif not now and h.chooseEnd then h.chooseEnd(cancelled == true) end
		elseif action == "Display" then
			if now and h.display then h.display() elseif not now and h.displayEnd then h.displayEnd(cancelled == true) end
		elseif action == "Drop" then
			if now then h.drop() end
		elseif ONE_SHOT[action] then
			local fn = if now then handlers[ONE_SHOT[action]] else nil
			if fn then fn() end
		end
	end
	for action, keys in SpiderInput.BINDINGS do
		CAS:BindActionAtPriority("Spider" .. action, function(_, phase, input)
			if UIS:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
			if phase == Enum.UserInputState.Begin then
				act(action, true, sourceOf(input))
			elseif phase == Enum.UserInputState.End or phase == Enum.UserInputState.Cancel then
				act(action, false, sourceOf(input), phase == Enum.UserInputState.Cancel)
			end
			return Enum.ContextActionResult.Sink
		end, false, 3000, table.unpack(keys))
	end
	CAS:BindActionAtPriority("SpiderStick", function(_, phase, input)
		if phase == Enum.UserInputState.Cancel or UIS:GetFocusedTextBox() or (h.blocked and h.blocked()) then state:stick(0, 0)
		else state:stick(input.Position.X, input.Position.Y) end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Thumbstick1)
	CAS:BindActionAtPriority("SpiderLookStick", function(_, phase, input)
		if phase == Enum.UserInputState.Cancel or UIS:GetFocusedTextBox() then state:look(0, 0)
		else state:look(input.Position.X, input.Position.Y) end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Thumbstick2)

	-- Roblox's own touch thumbstick and jump button would sit under ours: this game has its own touch controls.
	pcall(function() GuiService.TouchControlsEnabled = false end)
	local gui = Instance.new("ScreenGui")
	gui.Name = "SpiderTouch"
	gui.ResetOnSpawn = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets -- clear of notches, the home bar and Roblox's top bar
	gui.Enabled = UIS.TouchEnabled
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local active: { [InputObject]: string } = {}
	local buttons: { [string]: TextButton } = {}
	-- The fingers that are down on the screen and not on a button, and whether a pinch is under way (ROBLOX-92): a pinch zooms the close look and must not also turn it.
	local free: { [InputObject]: boolean } = {}
	local freeCount, pinching = 0, false
	local function clear()
		state:clear()
		table.clear(active)
		table.clear(free)
		freeCount, pinching = 0, false
		h.clear()
	end
	local function button(action: string, label: string, position: UDim2, size: number, textSize: number?)
		local b = Instance.new("TextButton")
		b.Name = action
		b.Text = label
		b.TextSize = textSize or 18
		b.TextWrapped = true
		b.TextColor3 = Color3.new(1, 1, 1)
		b.BackgroundColor3 = Color3.new(0.06, 0.06, 0.06)
		b.BackgroundTransparency = 0.15
		b.Size = UDim2.fromOffset(size, size)
		b.Position = position
		b.AutoButtonColor = true
		b.Visible = action ~= "Run" and action ~= "Lock" -- The HUD reveals acquired abilities after their moults.
		b.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 14)
		corner.Parent = b
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				active[input] = action
				act(action, true, input)
			end
		end)
		buttons[action] = b
	end
	-- Left thumb: walking. Right thumb: jump (largest, nearest the corner), cancel / let go beside it, then creep, silk,
	-- recenter and the eye view further in. Offsets from the safe area's bottom corners (HudLayout, checked in tests).
	for _, b in HudLayout.TOUCH_BUTTONS do
		button(b.action, b.label, if b.right then UDim2.new(1, b.x, 1, b.y) else UDim2.new(0, b.x, 1, b.y), b.size, b.textSize)
	end
	local function layoutTouch()
		local size = gui.AbsoluteSize
		for _, spec in HudLayout.TOUCH_BUTTONS do
			local b = HudLayout.layoutButton(spec, size.X, size.Y)
			local control = buttons[b.action]
			control.Position = UDim2.new(if b.right then 1 else 0, b.x, 1, b.y)
			control.Size = UDim2.fromOffset(b.size, b.size)
			control.TextSize = b.textSize or 18
		end
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutTouch)
	layoutTouch()
	UIS.InputEnded:Connect(function(input)
		local action = active[input]
		if action then
			active[input] = nil
			act(action, false, input)
		end
	end)
	-- Touch look: a drag anywhere that is not on a button turns the view (Roblox marks button touches processed). Not while a pinch is under way or a second finger is down (ROBLOX-92:
	-- both fingers of a pinch are moving, and each would have turned the view as well as zooming it).
	UIS.TouchStarted:Connect(function(input, processed)
		if not processed and not active[input] and not free[input] then free[input] = true; freeCount += 1 end
	end)
	UIS.TouchEnded:Connect(function(input)
		if free[input] then free[input] = nil; freeCount -= 1 end
		if freeCount <= 0 then pinching = false end -- (a pinch that never said it ended)
	end)
	UIS.TouchPinch:Connect(function(_touches: any, _scale: number, _velocity: number, state2: Enum.UserInputState)
		pinching = state2 == Enum.UserInputState.Begin or state2 == Enum.UserInputState.Change
	end)
	UIS.TouchMoved:Connect(function(input, processed)
		if not processed and not active[input] and not pinching and freeCount <= 1 then h.touchLook(Vector2.new(input.Delta.X, input.Delta.Y)) end
	end)
	UIS.WindowFocusReleased:Connect(clear)
	UIS.TextBoxFocused:Connect(clear)
	UIS.GamepadDisconnected:Connect(clear)
	GuiService.MenuOpened:Connect(clear)
	UIS:GetPropertyChangedSignal("TouchEnabled"):Connect(function() gui.Enabled = UIS.TouchEnabled end)
	local deviceHandler = h.device
	if deviceHandler then
		UIS.LastInputTypeChanged:Connect(function(t: Enum.UserInputType) deviceHandler(t.Name) end)
	end

	-- The client relabels and shows/hides touch buttons with the state (the Cancel button is Let go on the line).
	local api: any = state
	function api.setTouchLabel(_self: any, action: string, text: string)
		local b = buttons[action]
		if b and b.Text ~= text then b.Text = text end
	end
	function api.setTouchVisible(_self: any, action: string, visible: boolean)
		local b = buttons[action]
		if b and b.Visible ~= visible then
			b.Visible = visible
			if not visible then
				for input, a in active do
					if a == action then
						active[input] = nil
						act(action, false, input, true) -- (a button hidden under a finger is a press that was taken away, not one let go: ROBLOX-92)
					end
				end
			end
		end
	end
	api.touchGui = gui
	-- The test place's playback drives the same path a key, button or finger takes (tests/client/SilkPlayback.luau).
	function api.simulate(_self: any, action: string, down: boolean, source: any?)
		act(action, down, source or "playback")
	end
	return api
end
return SpiderInput
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="249">
          <Properties>
            <string name="Name">StationMouseBody</string>
            <string name="Source"><![CDATA[--!strict
-- Presentation only. Shapes are anchored and non-queryable like other animals.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Shapes=require(Shared.Habitat.Shapes)
local Body={}
Body.__index=Body
function Body.new(parent: Instance): any
	local folder=Instance.new("Folder");folder.Name="StationMouse";folder.Parent=parent
	local parts={}
	local function add(name: string,size: Vector3,color: string)
		table.insert(parts,Shapes.ellipsoid(folder,name,size,CFrame.new(),Color3.fromHex(color),"Fabric"))
	end
	local v=Vector3.new
	add("Body",v(3.3,3,6.3),"7c7467");add("Head",v(2.4,2.4,3),"867d6e")
	for _,s in {-1,1} do
		add("Ear"..s,v(.45,2,1.8),"b68f82")
		add("Eye"..s,v(.4,.4,.4),"211e19")
	end
	add("Nose",v(.6,.55,.55),"c49e91")
	for i=1,4 do add("Foot"..i,v(.65,.45,1.3),"b29380") end
	for i=1,5 do add("Tail"..i,v(.45-i*.06,.45-i*.06,1.75),"a28c7b") end
	return setmetatable({folder=folder,parts=parts},Body)
end
function Body.draw(self: any, mouse: any, reduced: boolean)
	local v=Vector3.new
	local frame=CFrame.lookAt(mouse.pos,mouse.pos+mouse.heading,Vector3.yAxis)
	local p={v(0,1.8,0),v(0,2,-3.7),v(-1.1,3.2,-2.9),v(-1.2,2.4,-4.4),
		v(1.1,3.2,-2.9),v(1.2,2.4,-4.4),v(0,1.9,-5.2)}
	for i=1,4 do
		local side=if i%2==0 then 1 else -1
		local step=if mouse.moving then math.sin(mouse.distance*1.4+(i%3)*math.pi)*.7 else 0
		table.insert(p,v(side*1.45,.3,if i<=2 then -1.8+step else 2+step))
	end
	for i=1,5 do
		local sway=if reduced then 0 else math.sin(mouse.distance*.15-i*.35)*.35
		table.insert(p,v(sway,.45,3.2+i*1.5))
	end
	for i,part in self.parts do part.CFrame=frame*CFrame.new(p[i]) end
end
return Body
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="250">
          <Properties>
            <string name="Name">TitleCard</string>
            <string name="Source"><![CDATA[--!strict
-- The title card's camera and the intro of a new life (ROBLOX-109). The words are UI/TitleText's, the shots Movement/TitleShots'; this module draws them.
--
-- The title card: until a life has begun this visit, while a screen has the game (the start menu, a screen opened from it, the start's wait), the camera is TitleShots.drift at the game's clock (the splash, First/SplashScreen, drew the same
-- drift until the start menu opened, so the hand-over cannot jump) while the start menu, CaughtPanel's "title" look, is over it.
-- The intro: when a new life is begun from the start menu and this save has never seen it (`seen`, kept in the progress record as intro_seen), the
-- spider is put just inside the crack facing out and the intro plays: the morning through the glass, the sill floor to the crack, the spider walking out
-- (the motor's own walk: `wish` is the direction the client feeds it), three captions, then the view eases into the game's own camera and the controls are
-- the player's (the last caption stays a few seconds over the game). While it holds, the controls are blocked and the client's camera is not rendered.
-- The skip: after TitleShots.INTRO.skipAfter seconds, the jump key, Enter, A / Cross or a tap; the spider is put where its walk ends and the game's camera
-- comes up from a short dip to black. Reduced Motion: TitleShots holds each shot still and cuts. A screen over the game (the life menu) pauses it.
local CAS = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TitleText = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI"):WaitForChild("TitleText"))
local TitleShots = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Movement"):WaitForChild("TitleShots"))

local TitleCard = {}
TitleCard.__index = TitleCard
TitleCard.ACTION = "WindowsillIntroSkip"
TitleCard.SKIP_FADE_S = 0.45 -- the dip after a skip: from black to the game over this long
TitleCard.GUI_NAME = "WindowsillIntro"

export type Config = {
	playerGui: Instance,
	camera: Camera,
	enabled: boolean, -- the title card's drift (not in the test place, which has no start menu)
	clock: () -> number, -- the game's clock (`time()`), the drift's
	reduced: () -> boolean,
	device: () -> string,
	spider: () -> Vector3,
	place: (Vector3, Vector3) -> (), -- put the spider here, facing this way (the client's place: the motor, the drawn up, the camera's snap)
	gameCamera: (number) -> CFrame, -- the game's own camera this frame (the client renders it and hands back where it put the camera)
	onBegin: () -> (),
	onEnd: () -> (),
}

local function lerpView(a: CFrame, b: CFrame, k: number): CFrame
	if k <= 0 then return a end
	if k >= 1 then return b end
	local p = a.Position:Lerp(b.Position, k)
	local look = a.LookVector:Lerp(b.LookVector, k)
	if look.Magnitude < 1e-6 then return b end
	return CFrame.lookAt(p, p + look.Unit)
end

function TitleCard.new(cfg: Config): any
	local gui = Instance.new("ScreenGui")
	gui.Name = TitleCard.GUI_NAME
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 45 -- (under the menus, CaughtPanel's 50: a screen opened during the intro is over it)
	gui.Enabled = false
	gui.Parent = cfg.playerGui
	local veil = Instance.new("Frame")
	veil.Name = "Veil"
	veil.Size = UDim2.fromScale(1, 1)
	veil.BorderSizePixel = 0
	veil.BackgroundColor3 = Color3.new(0, 0, 0)
	veil.BackgroundTransparency = 1
	veil.Parent = gui
	local caption = Instance.new("TextLabel")
	caption.Name = "Caption"
	caption.BackgroundTransparency = 1
	caption.AnchorPoint = Vector2.new(0.5, 1)
	caption.Position = UDim2.new(0.5, 0, 1, -64)
	caption.Size = UDim2.new(0.86, 0, 0, 60)
	caption.TextWrapped = true
	caption.TextSize = 22
	caption.TextColor3 = TitleText.INK
	caption.TextStrokeColor3 = TitleText.GROUND
	caption.TextStrokeTransparency = 0.6
	caption.TextTransparency = 1
	caption.Text = ""
	caption.Parent = gui
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(760, 200)
	limit.Parent = caption
	local skip = Instance.new("TextLabel")
	skip.Name = "Skip"
	skip.BackgroundTransparency = 1
	skip.AnchorPoint = Vector2.new(1, 1)
	skip.Position = UDim2.new(1, -24, 1, -20)
	skip.Size = UDim2.fromOffset(220, 24)
	skip.TextXAlignment = Enum.TextXAlignment.Right
	skip.TextSize = 15
	skip.TextColor3 = TitleText.SOFT
	skip.TextTransparency = 1
	skip.Text = ""
	skip.Parent = gui
	-- (a tap anywhere skips, on touch; it only takes taps while the intro has the screen)
	local tap = Instance.new("TextButton")
	tap.Name = "Tap"
	tap.BackgroundTransparency = 1
	tap.Text = ""
	tap.Size = UDim2.fromScale(1, 1)
	tap.ZIndex = 0
	tap.Visible = false
	tap.Parent = gui
	pcall(function()
		caption.FontFace = Font.new(TitleText.FAMILY, Enum.FontWeight.Regular, Enum.FontStyle.Italic)
		skip.FontFace = Font.new(TitleText.FAMILY, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	end)
	local self = setmetatable({
		cfg = cfg, gui = gui, veil = veil, caption = caption, skipLabel = skip, tap = tap,
		seen = false, intro = nil :: any, fade = 0, bound = false, lines = TitleText.captions(false),
	}, TitleCard)
	tap.Activated:Connect(function() self:skip() end)
	return self
end

-- Whether the intro is running at all (holding, or its last caption over the game).
function TitleCard.playing(self: any): boolean
	return self.intro ~= nil
end

-- Whether the intro has the camera and the controls now.
function TitleCard.holding(self: any): boolean
	local i = self.intro
	return i ~= nil and not i.released
end

function TitleCard._bind(self: any, on: boolean)
	if on and not self.bound then
		self.bound = true
		CAS:BindActionAtPriority(TitleCard.ACTION, function(_, state, _input)
			if state == Enum.UserInputState.Begin then self:skip() end
			return Enum.ContextActionResult.Sink
		end, false, 3500, Enum.KeyCode.Space, Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter, Enum.KeyCode.E, Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonB)
	elseif not on and self.bound then
		self.bound = false
		CAS:UnbindAction(TitleCard.ACTION)
	end
end

-- Begins the intro of a new life, unless this save has seen it (`force`: the self-test's, whatever was seen). The spider goes just inside the crack.
-- Marks it seen at once: a skipped intro has been seen. Returns whether it began.
function TitleCard.beginIntro(self: any, force: boolean?, gentle: boolean?): boolean
	if self.seen and not force then return false end
	self:stop()
	self.seen = true
	self.lines = TitleText.captions(gentle == true)
	local start = TitleShots.INTRO.start
	self.cfg.place(start.pos, start.heading)
	self.intro = { t = 0, released = false }
	self.fade = 0
	self.gui.Enabled = true
	self.tap.Visible = true
	self:_bind(true)
	self.cfg.onBegin()
	self:_draw(TitleShots.intro(0, self.cfg.reduced(), self.cfg.spider(), workspace:GetAttribute("World")))
	return true
end

-- Ends the intro at once, with nothing more (a new life, a return to a rest, the life menu's Resume: whoever calls it puts the screen back).
function TitleCard.stop(self: any)
	self.intro = nil
	self.fade = 0
	self.gui.Enabled = false
	self.tap.Visible = false
	self:_bind(false)
end

-- The controls are the player's again (the intro's end, or a skip): once.
function TitleCard._release(self: any)
	local i = self.intro
	if i == nil or i.released then return end
	i.released = true
	self.tap.Visible = false
	self:_bind(false)
	self.skipLabel.TextTransparency = 1
	self.cfg.onEnd()
end

-- The skip: refused before INTRO.skipAfter seconds and once the controls are back. The spider is put where its walk ends if it is not out yet;
-- the captions go with it; the game's camera comes up from black.
function TitleCard.skip(self: any): boolean
	local i = self.intro
	if i == nil or i.released or i.t < TitleShots.INTRO.skipAfter then return false end
	local walk = TitleShots.INTRO.walk
	local start = TitleShots.INTRO.start
	if self.cfg.spider().X < walk.untilX then
		self.cfg.place(Vector3.new(walk.untilX, start.pos.Y, start.pos.Z), start.heading)
	end
	self:_release()
	self.intro = nil
	self.fade = TitleCard.SKIP_FADE_S
	self.caption.TextTransparency = 1
	self.veil.BackgroundTransparency = 0
	return true
end

-- The direction to walk this tick while the intro holds (out of the crack, until past the walk's end), else nil.
function TitleCard.wish(self: any, pos: Vector3): Vector3?
	local i = self.intro
	if i == nil or i.released then return nil end
	local walk = TitleShots.INTRO.walk
	if i.t >= walk.from and i.t < walk.latest and pos.X < walk.untilX then return TitleShots.INTRO.start.heading end
	return nil
end

function TitleCard._draw(self: any, f: TitleShots.Frame)
	self.veil.BackgroundTransparency = 1 - f.veil
	local n = f.caption
	if n ~= nil then
		self.caption.Text = self.lines[n] or ""
		self.caption.TextTransparency = 1 - f.captionAlpha
		self.caption.TextStrokeTransparency = 1 - 0.4 * f.captionAlpha
	else
		self.caption.TextTransparency = 1
		self.caption.TextStrokeTransparency = 1
	end
	local i = self.intro
	local skippable = i ~= nil and not i.released and i.t >= TitleShots.INTRO.skipAfter
	self.skipLabel.Text = TitleText.skipHint(self.cfg.device() :: any)
	self.skipLabel.TextTransparency = if skippable then 0.3 else 1
end

-- Each rendered frame, after the client's camera settings and before its camera would be rendered. `started`: a life has begun this visit; `paused`: a
-- screen has the game (the intro waits). Returns true when this module placed the camera this frame (the client then does not render its own).
function TitleCard.frame(self: any, dt: number, started: boolean, paused: boolean): boolean
	local camera = self.cfg.camera
	local i = self.intro
	if i ~= nil then
		if not paused then i.t += dt end
		local f = TitleShots.intro(i.t, self.cfg.reduced(), self.cfg.spider(), workspace:GetAttribute("World")) -- (ROBLOX-118: the preserve's opens in the hut)
		local wrote = false
		if not i.released then
			if f.holding then
				local fov = f.fov
				local view = f.cframe
				if f.blend > 0 then
					local gameFov = camera.FieldOfView
					view = lerpView(f.cframe, self.cfg.gameCamera(dt), f.blend)
					fov = f.fov + (gameFov - f.fov) * f.blend
				end
				camera.CFrame = view
				camera.FieldOfView = fov
				wrote = true
			else
				self:_release()
			end
		end
		self:_draw(f)
		if f.done then self:stop() end
		return wrote
	end
	if self.fade > 0 then
		self.fade = math.max(0, self.fade - dt)
		self.veil.BackgroundTransparency = 1 - self.fade / TitleCard.SKIP_FADE_S
		if self.fade <= 0 then self.gui.Enabled = false end
	end
	if self.cfg.enabled and not started and paused then -- (the start menu, a screen opened from it, or the start's wait for the save: never a life's frame)
		local cf, fov = TitleShots.drift(self.cfg.clock(), workspace:GetAttribute("World")) -- (ROBLOX-115: the world's own drift)
		camera.CFrame = cf
		camera.FieldOfView = fov
		return true
	end
	return false
end

return TitleCard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="251">
          <Properties>
            <string name="Name">TrainPass</string>
            <string name="Source"><![CDATA[--!strict
-- The trains beyond the preserve's north fence, drawn (ROBLOX-115): a silhouette of cars that runs along the railway's track when World/PreserveTrain's timetable
-- says a train is passing, and its sound. Presentation only: nothing reads it, no ray sees it (drawn-only parts, as every look is), and it is this client's own.
-- The cars are made once (as many as the longest train) and moved each frame; a car is shown only while it lies wholly inside the line (PreserveTrain.cars), so
-- a train comes out of one covered way and goes into the other. Each car is a body, a band of windows (a commuter's; a freight car's is its doors' darker band;
-- the full tier only) and the underframe with its bogies. The sound is a looped rumble on the middle car, heard by distance (Roblox's roll-off); its recording
-- (assets/audio/train.wav) is not uploaded yet, so SOUND is "" and no voice is made until it is (docs/HANDOFF-roblox-world.md).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PreserveTrain = require(Shared:WaitForChild("World"):WaitForChild("PreserveTrain"))
local Materials = require(Shared:WaitForChild("Habitat"):WaitForChild("Materials"))

local TrainPass = {}
TrainPass.__index = TrainPass

-- The rumble's asset (assets/audio/train.wav once uploaded); "" makes no voice.
TrainPass.SOUND = "rbxassetid://127788334000523"
TrainPass.VOLUME = 0.5
-- The most cars a train has (PreserveTrain.CARS), so the most made.
TrainPass.MOST = math.max(PreserveTrain.CARS.commuter[2], PreserveTrain.CARS.freight[2])

local COLORS = {
	commuter = { body = "b9bdc1", band = "2b343c", under = "3a3b3c" },
	freight = { body = "7b4a36", band = "5e3a2b", under = "2f2f2f" },
}

local function part(parent: Instance, name: string, size: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Material = Materials.get("Metal")
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- `parent`: where the train's folder goes (the looks' WorldDecor folder); `seed`: the timetable's (WorldMap.seed(world seed, "train")); `tier`: "full" or "low".
function TrainPass.new(parent: Instance, seed: number, tier: string): any
	local folder = Instance.new("Folder")
	folder.Name = "Train"
	folder.Parent = parent
	local C = PreserveTrain.CAR
	local cars = {}
	for i = 1, TrainPass.MOST do
		local f = Instance.new("Folder")
		f.Name = "Car" .. i
		local body = part(f, "Body", Vector3.new(C.length, C.height - C.floor, C.width))
		local band = if tier == "low" then nil else part(f, "Band", Vector3.new(C.length - 60, 90, C.width + 2))
		local under = part(f, "Under", Vector3.new(C.length - 100, 70, C.width - 40))
		cars[i] = { folder = f, body = body, band = band, under = under, shown = false }
	end
	local sound: Sound? = nil
	if TrainPass.SOUND ~= "" then
		local s = Instance.new("Sound")
		s.Name = "Rumble"
		s.SoundId = TrainPass.SOUND
		s.Looped = true
		s.Volume = TrainPass.VOLUME
		s.RollOffMinDistance = 600
		s.RollOffMaxDistance = 9000
		sound = s
	end
	return setmetatable({ folder = folder, schedule = PreserveTrain.schedule(seed), cars = cars, sound = sound, pass = nil :: any, shownCount = 0, passes = 0 }, TrainPass)
end

-- Each frame (`now`: the client's clock, seconds): the cars where the timetable puts them, shown or hidden, and the sound on the middle car while a train passes.
-- Returns how many cars are shown.
function TrainPass.update(self: any, now: number): number
	local p = self.schedule.at(now)
	local mids: { number } = {}
	if p ~= nil then
		local _, list = PreserveTrain.cars(p, now)
		mids = list
		if self.pass ~= p then
			self.pass = p
			self.passes += 1
			local colors = COLORS[p.kind] or COLORS.commuter
			for _, car in self.cars do
				car.body.Color = Color3.fromHex(colors.body)
				if car.band ~= nil then car.band.Color = Color3.fromHex(colors.band) end
				car.under.Color = Color3.fromHex(colors.under)
			end
		end
	else
		self.pass = nil
	end
	local L, C = PreserveTrain.LINE, PreserveTrain.CAR
	local n = 0
	for i, car in self.cars do
		local x = mids[i]
		if x ~= nil then
			n += 1
			local y0 = L.y + C.floor
			car.body.CFrame = CFrame.new(x, y0 + (C.height - C.floor) / 2, L.z)
			if car.band ~= nil then car.band.CFrame = CFrame.new(x, y0 + 170, L.z) end
			car.under.CFrame = CFrame.new(x, L.y + 50, L.z)
			if not car.shown then car.folder.Parent = self.folder; car.shown = true end
		elseif car.shown then
			car.folder.Parent = nil
			car.shown = false
		end
	end
	local s = self.sound
	if s ~= nil then
		local middle = self.cars[math.max(1, math.ceil(n / 2))]
		if n > 0 then
			if s.Parent ~= middle.body then s.Parent = middle.body end
			if not s.IsPlaying then s:Play() end
		elseif s.IsPlaying then
			s:Stop()
		end
	end
	self.shownCount = n
	return n
end

-- The parts the train holds in the workspace now.
function TrainPass.parts(self: any): number
	local n = 0
	for _, car in self.cars do
		if car.shown then n += if car.band ~= nil then 3 else 2 end
	end
	return n
end

function TrainPass.destroy(self: any)
	for _, car in self.cars do car.folder:Destroy() end
	self.folder:Destroy()
end

return TrainPass
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="252">
          <Properties>
            <string name="Name">WaspBody</string>
            <string name="Source"><![CDATA[--!strict
-- The drawn mud dauber wasp (Data/WaspLook has every number): about 2.5 cm long, built from ellipsoids and rods as the fly is
-- (Client/FlyBodies, ROBLOX-22): a black head with big dark eyes and yellow mandibles, a black thorax with a yellow collar and
-- scutellum, a very long thin yellow petiole and a black gaster, six long legs (black femurs, a yellow band at each knee, yellow
-- tibias and feet), two smoky dark wings each side and two curled antennae that flick while it searches. Every part is anchored, never
-- collides, is never seen by a ray and casts no shadow (Habitat/Shapes). One Workspace:BulkMoveTo places all its parts each frame.
-- Poses: flying (legs trailing, wings a soft translucent blur of the stroke), walking (legs striding at 3 Hz, wings folded back),
-- holding (flying, with the front legs clutching what hangs under it). Display only: where it is, which way it faces, its mode and how
-- busily it searches come from the WaspDirector; nothing here feeds back. Godot's WaspBody (wasp_body.gd) is the source of the joints.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local WaspLook = require(Shared:WaitForChild("Data"):WaitForChild("WaspLook"))
local Shapes = require(Shared:WaitForChild("Habitat"):WaitForChild("Shapes"))

local WaspBody = {}
WaspBody.__index = WaspBody

local TAU = math.pi * 2
local PHASE = 0.37 -- Godot builds the wasp with this phase for its beat

type Spec = { name: string, rod: boolean, color: Color3, reflectance: number }

local function vec(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

local function mirrored(t: { number }, side: number): Vector3
	return Vector3.new(t[1] * side, t[2], t[3])
end

-- The size and frame of a rod (a Cylinder part: its axis is X) from a to b.
local function rodBetween(a: Vector3, b: Vector3, diameter: number, grow: number?): (Vector3, CFrame)
	local d = b - a
	local length = math.max(d.Magnitude, 1e-4)
	local dir = d / length
	local up = if math.abs(dir.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local g = grow or 0
	return Vector3.new(length, diameter + g, diameter + g), CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0)
end

-- Euler turns as Godot applies them: about y, then x, then z.
local function euler(rx: number, ry: number, rz: number): CFrame
	return CFrame.Angles(0, ry, 0) * CFrame.Angles(rx, 0, 0) * CFrame.Angles(0, 0, rz)
end

-- The parts, in a fixed order: the static ones, then the antennae, the legs, the wings. `index` finds a part by name.
local function build(): ({ Spec }, { [string]: number })
	local C, G = WaspLook.colors, WaspLook.gloss
	local specs: { Spec } = {}
	local index: { [string]: number } = {}
	local function add(name: string, rod: boolean, colorName: string, gloss: number?)
		table.insert(specs, { name = name, rod = rod, color = Color3.fromHex(C[colorName]), reflectance = gloss or G[colorName] or 0 })
		index[name] = #specs
	end
	for _, item in WaspLook.body do add(item.name, false, item.color) end
	add("Petiole", true, WaspLook.petiole.color)
	local A = WaspLook.antenna
	for _, side in { "L", "R" } do
		for i = 1, #A.diameters do add(`Antenna{side}{i}`, true, A.colors[i]) end
	end
	local L = WaspLook.legs
	for _, side in { "L", "R" } do
		for pair = 1, #L.hips do
			add(`Leg{side}{pair}Femur`, true, "black")
			add(`Leg{side}{pair}Tibia`, true, "yellow")
			add(`Leg{side}{pair}Tarsus`, true, "yellow")
			add(`Leg{side}{pair}Band`, true, "yellow")
		end
	end
	local W = WaspLook.wing
	for _, side in { "L", "R" } do
		for k = 1, 2 do
			add(`Wing{side}{k}`, false, "wing", W.reflectance)
			add(`Wing{side}{k}Vein`, true, "vein", 0)
			add(`Wing{side}{k}Blur`, false, "blur", 0)
		end
	end
	return specs, index
end

function WaspBody.new(parent: Instance): any
	local folder = Instance.new("Folder")
	folder.Name = "Wasp"
	local specs, index = build()
	local parts: { Part } = {}
	for i, spec in specs do
		local part: Part
		if spec.rod then
			part = Shapes.block(folder, spec.name, Vector3.one * 0.05, CFrame.new(), spec.color, "SmoothPlastic")
			part.Shape = Enum.PartType.Cylinder
		else
			part = Shapes.ellipsoid(folder, spec.name, Vector3.one * 0.1, CFrame.new(), spec.color, "SmoothPlastic")
		end
		part.Reflectance = spec.reflectance
		parts[i] = part
	end
	local self = setmetatable({
		parent = parent, folder = folder, specs = specs, index = index, parts = parts, shown = false,
		sizes = {} :: { Vector3 }, frames = {} :: { CFrame }, transparency = {} :: { number }, world = {} :: { CFrame }, moved = {} :: { Part },
		bob = 0.0,
	}, WaspBody)
	self:pose("flying", 0, 0)
	return self
end

-- The pose of every part in the torso's frame, for this mode ("flying", "walking" or "holding"), time `beat` (seconds) and how busily
-- the antennae flick (0 to 1): fills self.sizes, self.frames and self.transparency (indexed as the parts), and self.bob (the torso's rise).
function WaspBody.pose(self: any, mode: string, beat: number, search: number)
	local sizes, frames, trans, index = self.sizes, self.frames, self.transparency, self.index
	local walking, holding = mode == "walking", mode == "holding"
	local function set(name: string, size: Vector3, frame: CFrame, transparency: number?)
		local i = index[name]
		sizes[i], frames[i], trans[i] = size, frame, transparency or 0
	end
	-- the body
	for _, item in WaspLook.body do
		set(item.name, vec(item.size), CFrame.new(vec(item.at)), 0)
	end
	local P = WaspLook.petiole
	local psize, pframe = rodBetween(vec(P.from), vec(P.to), P.diameter)
	set("Petiole", psize, pframe, 0)
	-- the antennae
	local A = WaspLook.antenna
	for i, word in { "L", "R" } do
		local side = if i == 1 then -1 else 1
		local flick = math.clamp(search, 0, 1) * math.sin(TAU * (A.hertz[1] + A.hertz[2] * (i - 1)) * beat + PHASE) * A.flick
		local node = CFrame.new(mirrored(A.base, side)) * euler(A.rest[1] + flick, side * A.rest[2] + flick * 0.5, 0)
		for s = 1, #A.diameters do
			local size, frame = rodBetween(node * mirrored(A.points[s], side), node * mirrored(A.points[s + 1], side), A.diameters[s])
			set(`Antenna{word}{s}`, size, frame, 0)
		end
	end
	-- the legs
	local L, walk = WaspLook.legs, WaspLook.walk
	for sideIndex, word in { "L", "R" } do
		local side = if sideIndex == 1 then -1 else 1
		for pair = 0, #L.hips - 1 do
			local hip = Vector3.new(side * L.hips[pair + 1][1], L.hips[pair + 1][2], L.hips[pair + 1][3])
			local knee = Vector3.new(side * (0.35 + 0.05 * pair), -0.25, 0.04 + 0.15 * pair)
			local ankle = Vector3.new(side * (0.52 + 0.09 * pair), -0.58, 0.10 + 0.23 * pair)
			local tip = ankle + Vector3.new(side * 0.03, -0.12, 0.12)
			if walking then
				-- the actor stands 0.35 above its surface: the feet reach it
				knee, ankle, tip = Vector3.new(knee.X, -0.08, knee.Z), Vector3.new(ankle.X, -0.20, ankle.Z), Vector3.new(tip.X, -0.23, tip.Z)
				local cycle = TAU * walk.hertz * beat + PHASE + math.pi * ((pair + (sideIndex - 1)) % 2)
				local stride = Vector3.new(0, math.max(0, math.sin(cycle)) * walk.lift, math.cos(cycle) * walk.reach)
				ankle += stride
				tip += stride
			elseif holding and pair < 2 then
				knee, ankle, tip = Vector3.new(side * 0.30, -0.26, -0.05), Vector3.new(side * 0.18, -0.58, -0.07), Vector3.new(side * 0.08, -0.60, -0.16)
			else
				ankle += Vector3.new(0, 0, 0.25 + 0.14 * pair)
				tip = ankle + Vector3.new(0, -0.11, 0.14)
			end
			local name = `Leg{word}{pair + 1}`
			local s1, f1 = rodBetween(hip, hip + knee, L.femur)
			local s2, f2 = rodBetween(hip + knee, hip + ankle, L.tibia)
			local s3, f3 = rodBetween(hip + ankle, hip + tip, L.tarsus)
			local along = knee.Unit
			local s4, f4 = rodBetween(hip + knee - along * L.band.length, hip + knee, L.femur, L.band.grow)
			set(name .. "Femur", s1, f1, 0)
			set(name .. "Tibia", s2, f2, 0)
			set(name .. "Tarsus", s3, f3, 0)
			set(name .. "Band", s4, f4, 0)
		end
	end
	-- the wings: folded back on the ground; in the air a soft translucent blur of the stroke, a little unsteady
	local W = WaspLook.wing
	for sideIndex, word in { "L", "R" } do
		local side = if sideIndex == 1 then -1 else 1
		for k = 1, 2 do
			local share = if k == 1 then 1.0 else W.hindShare
			local pivotAt = Vector3.new(side * W.root[1], W.root[2], W.root[3] + (k - 1) * W.hindStep)
			local yaw, roll = W.folded.yaw, W.folded.roll
			local transparency = W.transparency
			if not walking then
				yaw, roll = W.flight.yaw, W.flight.roll + W.flight.shimmerRoll * math.sin(TAU * W.flight.shimmerHertz * beat + PHASE + k)
				transparency = W.flightTransparency
			end
			local pivot = CFrame.new(pivotAt) * euler(0, math.rad(side * yaw), math.rad(-side * roll))
			local blade = CFrame.new(side * W.centre[1] * share, 0, W.centre[3] * share) * CFrame.Angles(0, math.rad(side * W.sweep), 0)
			local size = Vector3.new(W.width * share, W.thick, W.length * share)
			set(`Wing{word}{k}`, size, pivot * blade, transparency)
			local vsize, vframe = rodBetween(pivot * Vector3.new(0, W.thick, 0.02), pivot * Vector3.new(side * W.vein.tipX * share, W.thick, W.vein.to * W.length * share), W.vein.diameter)
			set(`Wing{word}{k}Vein`, vsize, vframe, transparency * 0.4)
			local widen = if walking then 1.0 else W.blur.widen
			set(`Wing{word}{k}Blur`, Vector3.new(W.width * share * widen, W.thick * 2, W.length * share), pivot * blade, if walking then 1.0 else W.blur.transparency)
		end
	end
	self.bob = if walking then 0.0 else WaspLook.bob.height * math.sin(TAU * WaspLook.bob.hertz * beat + PHASE)
end

-- Draws it as the director has it: `wasp` = { position, heading, mode, search, visible }, `now` the time in seconds. Hidden (taken out of
-- the world) while it is away.
function WaspBody.draw(self: any, wasp: any, now: number)
	if not wasp.visible then
		if self.shown then
			self.shown = false
			self.folder.Parent = nil
		end
		return
	end
	if not self.shown then
		self.shown = true
		self.folder.Parent = self.parent
	end
	self:pose(wasp.mode, now, wasp.search)
	local body = CFrame.lookAt(wasp.position, wasp.position + wasp.heading, Vector3.yAxis) * CFrame.new(0, self.bob, 0)
	local moved, world = self.moved, self.world
	table.clear(moved)
	for i, part in self.parts do
		local size = self.sizes[i]
		if part.Size ~= size then part.Size = size end
		if part.Transparency ~= self.transparency[i] then part.Transparency = self.transparency[i] end
		moved[i] = part
		world[i] = body * self.frames[i]
	end
	Workspace:BulkMoveTo(moved, world, Enum.BulkMoveMode.FireCFrameChanged)
end

function WaspBody.destroy(self: any)
	self.folder:Destroy()
end

return WaspBody
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="253">
          <Properties>
            <string name="Name">WorldClient</string>
            <string name="Source"><![CDATA[--!strict
-- The client's side of the world (ROBLOX-94, docs/OPEN_WORLD_DESIGN.md). The spider, the flies, the wasp, the rival and the mate are all simulated here, on this
-- client, as they always were; what this module knows is the world they live in:
--   where the boxes are ... `root`, the folder every ray of the sim includes (the motor, the senses, the flies' perches, the rig's feet): the server's `World` folder, with a folder
--                            for every region. `sill`, region 0's folder inside it, for what is the sill's alone (the leaf tip). A place with only the sill straight in the workspace
--                            (the test box worlds, the old places) still works: both are that folder.
--   which region we are in .. from the spider's place each frame, kept when it is momentarily in none (`region`); the pace of its day (`clockScale`, set on LifeClock's dial each
--                            frame); and `isActive`, which says whether a creature that belongs to a region is in the region the spider is in. The creatures are regional
--                            (Predator/RivalSpider, Mate and RivalDrive take their region, the sill's unless given); nothing is sent to sleep yet: the rival and the mate go on on the
--                            sill while the spider is outside (ROBLOX-95), and the regions outside have no creatures of their own until W3.
--   what to stream .......... with instance streaming on, the server sends what is near the player's replication focus. The server parks each player's (Server/WorldFocus): that
--                            is the focus streaming follows. This also points the player's own ReplicationFocus at the drawn spider's root, when it is made and again after a respawn
--                            or a return to a rest: a client's write of that property is not expected to reach the server (the docs say to set it there), so it is belt and braces,
--                            not the mechanism; a write that raises is warned about once and the game goes on. None of this has run in Studio yet.
-- The sim must never raycast beyond what is streamed in: StreamingMinRadius (96 studs around the focus) is always there, so a region and its neighbours must fit inside it, and a
-- creature is only simulated in the region the spider is in or beside.
-- With streaming, the sill's boxes and the drawn sill (the persistent Decor model) arrive after the folders do: `new` waits for every box of the sill and for the Decor, so the
-- sim begins on a whole sill. Without streaming (the test places, the box worlds) everything is there at once and nothing is waited for.
-- ROBLOX-95 (W2): the window is open and three regions lie outside it (the outer sill, the brick wall, the bed 90 studs below), the bed farther from the sill's spawn than the
-- radius. So the focus follows the spider: `update` reports the spider's place to the server through the WorldFocus remote (Server/WorldFocus) whenever it has moved more than
-- REPORT_MOVE studs from the last report or REPORT_EVERY seconds have passed, and the server moves the player's focus part there. And the client knows whether a region it is
-- in has arrived whole (`regionReady`: its folder holds every piece of Region.pieces); a spider in a region that is not whole is warned about once per region in Output, since
-- a missing box is a fall. (ROBLOX-108: the looks of the regions outside are this client's own, Client/LookStream, made near the spider by `streamLooks` and `update`;
-- nothing waits for them.) The player's motor is out of the
-- world only where no region holds it (`inBounds`); the rival's and the mate's are bound to the sill and keep its bounds (`homeMin`, `homeMax`).
-- ROBLOX-96 (W3): the garden has life. `prey` is the world's prey (Prey/PreyWorld: a director per region, run where the spider is and gated by `regionReady`) and
-- `bugs` the drawn woodlice (Client/BugBodies); both are made by the client once it has its sill director, and kept here so the client gains no local. `homeRetreat`
-- is the retreat the words call home: the one the spider is in, else the first of the region it is in, else the last one it was in (the crack to begin with).
-- ROBLOX-115 (two worlds, one engine): the world it is (`world`, World/Worlds) is the Workspace attribute World, made WorldMap's active one in `new`; in the preserve
-- the looks are its backdrop's zones too (World/LookPlan), and `train` (Client/TrainPass) runs the trains on the railway beyond the north fence.
-- ROBLOX-116 (the ranger hut, walkable): in the preserve `hut` (Client/HutLife) keeps the window's sash shut through the nursery and has the ranger prop it when the
-- spider is ready (Life/Nursery), and lights the desk lamp at night; `life` is the client's life loop (set by the client), which the rule reads each frame.
-- `hutOpen` says whether the window is open (the progress record keeps it), `openHut` opens it at once (a save that has it).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local WorldMap = require(Shared:WaitForChild("World"):WaitForChild("WorldMap"))
local Worlds = require(Shared:WaitForChild("World"):WaitForChild("Worlds"))
local Region = require(Shared:WaitForChild("World"):WaitForChild("Region"))
local LifeClock = require(Shared:WaitForChild("Life"):WaitForChild("LifeClock"))
local LookStream = require(script.Parent.LookStream)
local TrainPass = require(script.Parent.TrainPass)
local HutLife = require(script.Parent.HutLife)
local WorldShadows = require(script.Parent.WorldShadows)
local FrameProfile = require(script.Parent.FrameProfile)
local LivingWorld = require(script.Parent.LivingWorld)
local Station = require(Shared.World.StationTerritory)

local WorldClient = {}
WorldClient.__index = WorldClient

-- A line in Output (the engine's warn; the CLI tests that drive the client have none unless they collect them).
local function tell(message: string)
	local say: any = warn
	if say ~= nil then say(message) end
end

-- How long, in seconds, the sill may take to arrive under streaming before the sim begins without a missing piece (and says so), and the decor may.
WorldClient.PIECES_WAIT = 30
WorldClient.DECOR_WAIT = 10
-- The focus report (ROBLOX-95): sent when the spider is more than this many studs from where it last reported, or this many seconds after the last report.
WorldClient.REPORT_MOVE = 8
WorldClient.REPORT_EVERY = 2
-- The name of the remote the server makes for the reports (Server/WorldFocus.REMOTE).
WorldClient.REMOTE = "WorldFocus"

-- ROBLOX-115: the world the server runs (World/Worlds) is the Workspace attribute World, which the server writes at startup; with no map handed in, the client makes
-- that world WorldMap's active one before it asks anything (with streaming, it waits up to WORLD_WAIT seconds for the attribute; without it, an absent attribute is
-- the default world, as in every test place).
WorldClient.WORLD_WAIT = 10

-- `ws`: the workspace; `player`: the local player; `map`: the world map (WorldMap, unless a test hands in another with the same functions).
function WorldClient.new(ws: Instance, player: Instance, map: any?): any
	if map == nil then
		local named = ws:GetAttribute(Worlds.ATTRIBUTE)
		if named == nil and (ws :: any).StreamingEnabled == true then
			local deadline = os.clock() + WorldClient.WORLD_WAIT
			local t: any = task
			while named == nil and os.clock() < deadline and t ~= nil do
				t.wait(0.1)
				named = ws:GetAttribute(Worlds.ATTRIBUTE)
			end
		end
		WorldMap.use(Worlds.choose(named))
	end
	local m: any = map or WorldMap
	local home = m.region(m.HOME) :: WorldMap.Region
	local lo, hi = m.bounds()
	local name = Region.folderName(home)
	local flat = ws:FindFirstChild(name)
	local root: Instance, sill: Instance
	if flat ~= nil then
		root, sill = flat, flat
	else
		root = ws:WaitForChild(Region.WORLD_FOLDER)
		sill = root:WaitForChild(name)
	end
	local decor = ws:FindFirstChild("Decor")
	if (ws :: any).StreamingEnabled == true then
		local deadline = os.clock() + WorldClient.PIECES_WAIT
		for _, piece in Region.pieces(home) do
			if sill:FindFirstChild(piece.id) == nil and sill:WaitForChild(piece.id, math.max(0.1, deadline - os.clock())) == nil then
				warn(`[Windowsill] world: the sill's {piece.id} never streamed in; the spider may fall through where it should be`)
			end
		end
		if decor == nil then decor = ws:WaitForChild("Decor", WorldClient.DECOR_WAIT) end
	end
	return setmetatable({
		map = m, player = player, root = root, sill = sill, decor = decor, looks = nil :: any, -- (`looks`: the LookStream, once `streamLooks` makes it)
		home = home.id, region = home,
		boundsMin = lo, boundsMax = hi, spawnPos = home.spawn.pos, spawnHeading = home.spawn.heading,
		homeMin = home.bounds[1], homeMax = home.bounds[2],
		focused = nil :: Instance?, focusWarned = false,
		-- the focus report: the remote (found when first needed), where and when the last report was, how many were sent
		remote = nil :: Instance?, reported = nil :: Vector3?, reportedAt = -math.huge, reports = 0,
		-- the readiness guard: regions found whole, and regions already warned about
		whole = {} :: { [string]: boolean }, warned = {} :: { [string]: boolean },
		-- ROBLOX-96: the world's prey and the drawn bugs (set by the client), and the last retreat the spider was in or beside
		prey = nil :: any, bugs = nil :: any, lastRetreat = if #home.retreats > 0 then home.retreats[1].id else nil,
		world = if m.world ~= nil then m.world() else Worlds.DEFAULT, train = nil :: any, -- (ROBLOX-115: the world it is, and the preserve's train once the looks are made)
		hut = nil :: any, life = nil :: any, hutPending = false, -- (ROBLOX-116: the hut's sash and lamp in the preserve, the life the nursery rule reads, a save's open window before the hut is made)
		shadows = nil :: any, -- (ROBLOX-121: the walkable boxes' shadows kept to those an eye at the spider could see, Client/WorldShadows; made at the first update)
	}, WorldClient)
end

-- The retreat the words call home at this place (ROBLOX-96): the retreat the spider is in; else the first retreat of the region it is in; else the last one it was in
-- or beside. Remembers what it answers.
function WorldClient.homeRetreat(self: any, pos: Vector3): string?
	local inside = self.map.inRetreat(pos)
	if inside ~= nil then self.lastRetreat = inside; return inside end
	local region = self:regionAt(pos)
	if #region.retreats > 0 then self.lastRetreat = region.retreats[1].id; return region.retreats[1].id end
	return self.lastRetreat
end

-- Whether the spider is within `near` studs of the retreat's door (WorldMap's `door`, the point the line near home has always been measured from; its box's centre
-- for a retreat without one), for the line near home.
function WorldClient.nearRetreat(self: any, pos: Vector3, retreat: string?, near: number): boolean
	if retreat == nil or self.map.retreat == nil then return false end
	local t = self.map.retreat(retreat)
	if t == nil then return false end
	local door: Vector3 = t.door or (t.min + t.max) * 0.5
	return (pos - door).Magnitude < near
end

-- Whether the point is inside some region's bounds: the player's motor is out of the world only where no region holds it (SpiderMotor's `inBounds`), so a fall from the
-- sill's room side ends where it always did and a fall from the outer sill goes on down to the bed.
function WorldClient.inBounds(self: any, pos: Vector3): boolean
	return self.map.at(pos) ~= nil
end

-- The folder of a region's physical boxes, or nil while it has not arrived (a place with only the sill straight in the workspace has only the sill's).
function WorldClient.folderOf(self: any, region: WorldMap.Region): Instance?
	if region.id == self.home then return self.sill end
	if self.root == self.sill then return nil end
	return self.root:FindFirstChild(Region.folderName(region))
end

-- Whether every box of the region is here: its folder holds every piece of Region.pieces(region). With instance streaming the folders arrive at once and their parts as the
-- server sends them, so a region can be here in part; the sim must not raycast into it until it is whole. False for a region that is not on the map.
function WorldClient.regionReady(self: any, id: string): boolean
	local region = self.map.region(id)
	if region == nil then return false end
	local folder = self:folderOf(region)
	if folder == nil then return false end
	for _, piece in Region.pieces(region) do
		if folder:FindFirstChild(piece.id) == nil then return false end
	end
	return true
end

-- Sends the server where the spider is (the WorldFocus remote), when it has moved more than REPORT_MOVE studs from the last report or REPORT_EVERY seconds have passed. True
-- when it sent one. Without the remote (a place whose server has not made it, the box worlds) nothing is sent.
function WorldClient.report(self: any, pos: Vector3, now: number): boolean
	local last = self.reported
	if last ~= nil and (pos - last).Magnitude <= WorldClient.REPORT_MOVE and now - self.reportedAt < WorldClient.REPORT_EVERY then return false end
	if self.remote == nil then self.remote = ReplicatedStorage:FindFirstChild(WorldClient.REMOTE) end
	local remote = self.remote
	if remote == nil or not remote:IsA("RemoteEvent") then return false end
	(remote :: RemoteEvent):FireServer(pos)
	self.reported, self.reportedAt = pos, now
	self.reports += 1
	return true
end

-- The id of the retreat the point is in, in any region, or nil.
function WorldClient.inRetreat(self: any, pos: Vector3): string?
	return self.map.inRetreat(pos)
end

-- The region the spider is in at this place; where it is in none (a frame on the way back from outside the bounds) the region it was last in.
function WorldClient.regionAt(self: any, pos: Vector3): WorldMap.Region
	return self.map.at(pos) or self.region
end

-- Whether the spider is in this region: whether what belongs to the region is in play.
function WorldClient.isActive(self: any, regionId: string): boolean
	return self.region.id == regionId
end

-- (ROBLOX-117) Whether a creature in this region is simulated now: a region with no id (the sill's rival and mate, as they have always been) always; a region of the
-- preserve's roam when the spider is in it or in a region that meets it, and its boxes have arrived (a creature walks only on what is streamed in; elsewhere it
-- waits where it is until the spider comes near).
function WorldClient.creatureLive(self: any, regionId: string?): boolean
	if regionId == nil then return true end
	-- Residents can cross either room while the player shelters elsewhere in the
	-- station. Its physical models are persistent; wait for every one before
	-- allowing a resident to plan beyond the player's streamed neighbourhood.
	if Station.contains(regionId) then
		if not self.stationWhole then
			for id in Station.roam() do if not self:regionReady(id) then return false end end
			self.stationWhole=true
		end
		return true
	end
	local here = self.region
	local near = here.id == regionId
	if not near then
		for _, n in here.neighbors do if n.id == regionId then near = true; break end end
	end
	if not near then return false end
	if self.whole[regionId] then return true end
	if self:regionReady(regionId) then self.whole[regionId] = true; return true end
	return false
end

-- (ROBLOX-117) The box a creature's motor keeps to: the union of the roam's regions (the preserve's rival and mate walk the whole hut garden), else the sill's.
function WorldClient.rangeOf(self: any, roam: { [string]: boolean }?): (Vector3, Vector3)
	if roam == nil then return self.homeMin, self.homeMax end
	local list = {}
	for id in roam do
		local r = self.map.region(id)
		if r ~= nil then table.insert(list, r) end
	end
	if #list == 0 then return self.homeMin, self.homeMax end
	return WorldMap.unionOf(list)
end

-- Points the player's replication focus at this part (the drawn spider's root), and remembers it. A write that raises is warned about once.
function WorldClient.focus(self: any, part: Instance?)
	self.focused = part
	if part == nil then return end
	local ok, err = pcall(function() (self.player :: any).ReplicationFocus = part end)
	if not ok and not self.focusWarned then
		self.focusWarned = true
		warn("[Windowsill] world: could not set the replication focus: " .. tostring(err))
	end
end

-- After a respawn or a return to a rest: the focus is set again at the next frame.
function WorldClient.refocus(self: any)
	self.focused = nil
end

-- ROBLOX-108: the looks of the regions outside the window, made on this client at its tier ("full" or "low") near the spider from now on (Client/LookStream; each
-- `update` follows the spider). In a place with only the sill straight in the workspace (the box worlds) there is nothing to draw and nothing is made.
function WorldClient.streamLooks(self: any, ws: Instance, tier: string): any
	if self.root == self.sill then return nil end
	self.looks = LookStream.new(ws, tier, self.root, self.map)
	-- (ROBLOX-115) in the preserve, the trains beyond the north fence, with the looks
	if self.world == Worlds.PRESERVE then self.train = TrainPass.new(self.looks.folder, WorldMap.seed(WorldMap.SEED, "train"), tier) end
	-- (ROBLOX-116) and the hut's sash and lamp
	if self.world == Worlds.PRESERVE then
		self.hut = HutLife.new(self.root, self.decor, WorldMap.seed(WorldMap.SEED, "hut_window"), ws)
		self.living = LivingWorld.new(ws, self.root, tier, self.map)
		if self.hutPending then self.hut:restore(true) end
	end
	return self.looks
end

-- Each frame, before the sim's ticks (`dt`, ROBLOX-116: the frame's seconds, for the hut's own moment): the region the spider is in, the pace of its day, the focus on the drawn spider's root (`root`) when it is not set on it yet, the
-- report of where it is to the server (`now`: os.clock() unless a test gives a clock), the looks near it (ROBLOX-108), the boxes' shadows (ROBLOX-121), and whether
-- the region it is in has arrived whole (warned about once if not).
function WorldClient.update(self: any, pos: Vector3, root: Instance?, now: number?, dt: number?)
	self.region = self.map.at(pos) or self.region
	LifeClock.game.clockScale = self.region.clockScale
	if root ~= nil and root ~= self.focused then self:focus(root) end
	local clock = now or os.clock()
	self:report(pos, clock)
	FrameProfile.lap("world")
	if self.looks ~= nil then
		self.looks:update(pos, self.region)
		-- (ROBLOX-117: the morning's dew on the looks, by the life's hour)
		local life = self.life
		if life ~= nil and type(life.clock) == "table" and type(life.clock.hour) == "number" then self.looks:dew(life.clock.hour) end
	end
	if self.train ~= nil then self.train:update(clock) end
	-- (ROBLOX-116: the hut's moment runs on the frames' own time when the client gives it, so it keeps the sim's pace; else on the clock)
	self.hutClock = (self.hutClock or 0) + (if dt ~= nil then dt else 0)
	if self.hut ~= nil then self.hut:update(self.life, if dt ~= nil then self.hutClock else clock) end
	FrameProfile.lap("looks") -- (ROBLOX-111: the self-test's frame profile, Client/FrameProfile)
	-- (ROBLOX-121: a box's shadow only where it could be seen from the spider; not in a place with only the sill straight in the workspace)
	if self.shadows == nil and self.root ~= self.sill then self.shadows = WorldShadows.new(self.root, self.map, self.home) end
	if self.shadows ~= nil then self.shadows:update(pos, clock) end
	FrameProfile.lap("shadows")
	local id = self.region.id
	if not self.whole[id] then
		if self:regionReady(id) then
			self.whole[id] = true
		elseif not self.warned[id] then
			self.warned[id] = true
			tell(`[Windowsill] world: the spider is in {id}, which has not arrived whole; it may fall through where a box should be`)
		end
	end
end

-- (ROBLOX-116) Whether the hut's window is open (the preserve's progress: false in the test garden).
function WorldClient.hutOpen(self: any): boolean
	if self.hut ~= nil then return self.hut.open == true and not self.hut.trial end -- (the self-test's trial opening is never kept)
	return self.hutPending == true
end

-- (ROBLOX-116) The save says the hut's window is open: it opens now, without the ranger's moment (and when the hut is made, if it is not yet).
function WorldClient.openHut(self: any)
	self.hutPending = true
	if self.hut ~= nil then self.hut:restore(true) end
end

return WorldClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="254">
          <Properties>
            <string name="Name">WorldDetail</string>
            <string name="Source"><![CDATA[--!strict
-- The low-detail tier of the world, applied on one client: phones and tablets drop what the server built for the full tier
-- (anything carrying the attribute FullOnly: bloom, sun rays, clouds, light shafts, the small details, the busier part of the
-- view) and get a thinner dust. Only this client's copy changes; the server and other players keep theirs. (ROBLOX-108: the looks outside the window are made at
-- the client's tier by Client/LookStream, so nothing of theirs is dropped here.)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Graphics = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Data"):WaitForChild("Graphics"))

local WorldDetail = {}

-- detail: "full" or "low". roots: the places the server put optional things in (Decor, Lighting, Terrain). Returns how many
-- instances it removed.
function WorldDetail.apply(detail: string, roots: { Instance }): number
	if detail ~= "low" then return 0 end
	local scale = Graphics.tiers.low.dustRate
	local doomed: { Instance } = {}
	for _, root in roots do
		if root:GetAttribute("FullOnly") == true then
			table.insert(doomed, root)
		else
			for _, d in root:GetDescendants() do
				if d:GetAttribute("FullOnly") == true then
					table.insert(doomed, d)
				elseif d:IsA("ParticleEmitter") and d:GetAttribute("Dust") == true and d:GetAttribute("Thinned") ~= true then
					d.Rate = d.Rate * scale
					d:SetAttribute("Thinned", true)
				end
			end
		end
	end
	for _, d in doomed do d:Destroy() end
	return #doomed
end

return WorldDetail
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="255">
          <Properties>
            <string name="Name">WorldShadows</string>
            <string name="Source"><![CDATA[--!strict
-- The walkable boxes' shadows, kept to the ones an eye at the spider could see (ROBLOX-121).
--
-- Every region's boxes are parts in the server's `World` folder, and every one of them that is not hidden under a drawing casts a shadow, as a part does by default.
-- Since ROBLOX-119 the preserve has 1,410 of them, 1,393 casting (the meadow's edge alone 708: every culm, leaf and head a box), and v41's Studio self-test measured
-- the sill at 38 fps where v39's (before the meadow and the bench) had 54 to 60; the client's own Lua costs the same in both trees on the sill (tests/selftest_preserve.luau's
-- profile), so the frame went to what the engine is given. A box casts its shadow into the sun's shadow map wherever the camera is; a culm 1 cm across 12 m away
-- throws a shadow a hundredth of a pixel wide. So this client turns off the shadow of a box whose shadow would be narrower than about two pixels on a 1080p screen
-- from where the spider is (CAST: the box's middle extent, the width of the shadow a box throws, under 1/500 of its distance from the spider), and turns it on again
-- when the spider comes near. Nothing else of the box changes (it is seen, walked and raycast as before), a box hidden under a drawing (Transparency 1, CastShadow off,
-- World/WorldBuild) is never touched, and the sill's own folder (the home: the spider is always within a few studs of it there) is left as the server built it.
--
-- The rule is asked again when the spider has moved PASS_MOVE studs since the last time (a box's distance changes by no more than that, so its shadow is at most a
-- shade early or late), and only a box whose answer changed is written. With instance streaming the server sends a region's boxes as the spider comes near, so a
-- region whose folder does not yet hold all its pieces is looked at again every BIND_EVERY seconds for the ones that have arrived (each is given the rule's answer at
-- once); a box streamed out and back is a new part, found by the slow check of every box's parent (CHECK_SLICE a time).
-- These are this client's own changes to the server's parts: nothing is sent, nothing is saved, another player's client keeps its own.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Region = require(Shared:WaitForChild("World"):WaitForChild("Region"))

local WorldShadows = {}
WorldShadows.__index = WorldShadows

-- A box casts while its middle extent is at least this share of its distance from the spider: 1/500 of a radian is 1.8 pixels on a 1080p screen at the
-- camera's 65 degrees, 2.3 at the Settings' narrowest 50.
WorldShadows.CAST = 1 / 500
-- The rule is asked again when the spider has moved this many studs.
WorldShadows.PASS_MOVE = 32
-- A region not yet whole is looked at again for its arrived boxes this often (seconds); and this many bound boxes have their parent checked each time.
WorldShadows.BIND_EVERY = 2
WorldShadows.CHECK_SLICE = 100

type Entry = { part: BasePart, folder: Instance, lo: Vector3, hi: Vector3, mid: number, on: boolean }
type Holder = { id: string, folder: Instance?, expected: number, bound: { [Instance]: boolean }, count: number }

-- The middle of a box's three extents: the width of the shadow it throws (a culm's 1 of 1 by 40, a slat's 10 of 164 by 2 by 10).
function WorldShadows.middle(size: Vector3): number
	local a, b, c = size.X, size.Y, size.Z
	if a > b then a, b = b, a end
	if b > c then b, c = c, b end
	if a > b then a, b = b, a end
	return b
end

-- The distance from a point to a box (0 inside it).
function WorldShadows.distance(lo: Vector3, hi: Vector3, pos: Vector3): number
	local dx = math.max(lo.X - pos.X, 0, pos.X - hi.X)
	local dy = math.max(lo.Y - pos.Y, 0, pos.Y - hi.Y)
	local dz = math.max(lo.Z - pos.Z, 0, pos.Z - hi.Z)
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- The rule: whether a box (its corners, and its middle extent) casts its shadow with the spider at `pos`.
function WorldShadows.casts(lo: Vector3, hi: Vector3, mid: number, pos: Vector3): boolean
	return mid >= WorldShadows.CAST * WorldShadows.distance(lo, hi, pos)
end

-- `root`: the World folder; `map`: the world map (WorldMap or a test's); `home`: the id of the region whose folder is left alone (the sill).
function WorldShadows.new(root: Instance, map: any, home: string?): any
	local holders: { Holder } = {}
	local regions: { any } = if map.regions ~= nil then map.regions() else {} -- (a test's stand-in map may have no list: then there is nothing to keep)
	for _, region in regions do
		if region.id ~= home then
			local n = #Region.pieces(region)
			if n > 0 then table.insert(holders, { id = Region.folderName(region), folder = nil, expected = n, bound = {}, count = 0 }) end
		end
	end
	return setmetatable({
		root = root, holders = holders, entries = {} :: { Entry }, at = nil :: Vector3?, boundAt = -math.huge, checkAt = 1,
		passes = 0, writes = 0, -- (counts, for the tests and the self-test's INFO line)
	}, WorldShadows)
end

-- Takes in the boxes of the regions not yet whole that have arrived: a visible box casting its shadow (as the server builds every box not under a drawing) is kept,
-- and given the rule's answer now if the spider's place is known; a hidden one is never touched.
function WorldShadows.bind(self: any)
	for _, h: Holder in self.holders do
		if h.count < h.expected then
			if h.folder == nil or h.folder.Parent ~= self.root then h.folder = self.root:FindFirstChild(h.id) end
			local folder = h.folder
			if folder ~= nil then
				for _, p in folder:GetChildren() do
					if h.bound[p] == nil and p:IsA("BasePart") then
						h.bound[p] = true
						h.count += 1
						local part = p :: BasePart
						if part.Transparency < 1 and part.CastShadow ~= false then
							local size, at = part.Size, part.Position
							local e: Entry = { part = part, folder = folder, lo = at - size * 0.5, hi = at + size * 0.5, mid = WorldShadows.middle(size), on = true }
							table.insert(self.entries, e)
							local pos = self.at
							if pos ~= nil and not WorldShadows.casts(e.lo, e.hi, e.mid, pos) then
								part.CastShadow = false
								e.on = false
								self.writes += 1
							end
						end
					end
				end
			end
		end
	end
end

-- Lets go of a box that is no longer in its folder (streamed out): its region is looked at again for it.
local function release(self: any, i: number)
	local e: Entry = self.entries[i]
	for _, h: Holder in self.holders do
		if h.bound[e.part] then h.bound[e.part] = nil; h.count -= 1; break end
	end
	self.entries[i] = self.entries[#self.entries]
	self.entries[#self.entries] = nil
end

-- Asks the rule of every box with the spider at `pos` and writes the ones whose answer changed. Returns how many it wrote.
function WorldShadows.pass(self: any, pos: Vector3): number
	self.at = pos
	self.passes += 1
	local wrote = 0
	local entries = self.entries
	local i = 1
	while i <= #entries do
		local e: Entry = entries[i]
		local want = WorldShadows.casts(e.lo, e.hi, e.mid, pos)
		if want ~= e.on then
			if e.part.Parent ~= e.folder then
				release(self, i)
				continue
			end
			e.part.CastShadow = want
			e.on = want
			wrote += 1
		end
		i += 1
	end
	self.writes += wrote
	return wrote
end

-- Each frame (`now`: the clock): a pass when the spider has moved PASS_MOVE studs since the last (or there has been none), and every BIND_EVERY seconds the boxes
-- that have arrived taken in and a slice of the bound ones checked.
function WorldShadows.update(self: any, pos: Vector3, now: number)
	if now - self.boundAt >= WorldShadows.BIND_EVERY then
		self.boundAt = now
		local entries = self.entries
		local n = math.min(WorldShadows.CHECK_SLICE, #entries)
		for _ = 1, n do
			if self.checkAt > #entries then self.checkAt = 1 end
			local e: Entry = entries[self.checkAt]
			if e.part.Parent ~= e.folder then release(self, self.checkAt) else self.checkAt += 1 end
		end
		self:bind()
	end
	local last = self.at
	if last == nil or (pos - last).Magnitude >= WorldShadows.PASS_MOVE then self:pass(pos) end
end

-- How many boxes it keeps (visible ones that may cast), and how many of them cast now.
function WorldShadows.counts(self: any): (number, number)
	local on = 0
	for _, e: Entry in self.entries do if e.on then on += 1 end end
	return #self.entries, on
end

return WorldShadows
]]></string>
          </Properties>
