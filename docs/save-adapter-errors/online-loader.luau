assert(game.GameId==10771103250 and game.PlaceId==120119801868085 and not game:GetService("RunService"):IsRunning());local lab=Instance.new("Folder");lab.Name="ChetIsolatedAdapterLab";local shared=game.ReplicatedStorage.Shared:Clone();shared.Parent=lab;local server=Instance.new("Folder");server.Name="Server";server.Parent=lab;local patches={{"Shared/Data/SaveRules","--!strict\n-- Every number and name the persistent saves use (ROBLOX-39): store names, key prefixes, sizes, timings, limits. The logic is in\n-- Shared/Persistence/Save*.luau; none of it carries a number of its own. Sizes were measured on real checkpoints (tests/state.luau\n-- prints them; docs/HANDOFF-roblox-state.md records them).\nlocal SaveRules = {}\n\n-- ---------------------------------------------------------------- where it is kept\nSaveRules.STORE_PRODUCTION = \"Windowsill_v1\"\nSaveRules.STORE_TEST = \"WindowsillTest_v1\" -- Studio and the test place: Chet's runs never touch a real save\nSaveRules.KEY_PROGRESS = \"P_\" -- P_<UserId>: the player's progress (small, precious)\nSaveRules.KEY_REST = \"R_\" -- R_<UserId>_main, R_<UserId>_easy, R_<UserId>_free: the last rest of each slot (larger, replaceable)\n-- The slots a rest is filed in (ROBLOX-91): the standard main life (\"main\": every save made before the Easy slot existed keeps this key, whatever its rules), the main\n-- life on Easy's gentle rules (\"easy\": it used to share the main slot, so starting Easy wiped the standard rest) and free play (\"free\").\nSaveRules.MODES = { \"main\", \"free\", \"easy\" } :: { string }\nSaveRules.FORMAT = \"the-windowsill save\"\nSaveRules.REMOTES_NAME = \"SaveRemotes\" -- the folder in ReplicatedStorage holding ToServer and ToClient\n\n-- ---------------------------------------------------------------- sizes (characters of canonical JSON)\n-- Expanded validation bounds, NOT the stored-value budget. The full preserve initialization is 2.28M characters.\n-- Server/RestCompression bounds the actual compressed envelope INCLUDING its backup to 1.5M stored characters,\n-- and checks its Zstd frame size before expanding (12M maximum). Old uncompressed records remain readable.\nSaveRules.MAX_REST_CHARS = 5000000\nSaveRules.MAX_REST_NODES = 600000 -- values a rest may hold, checked before encoding/checkpoint graph construction\nSaveRules.MAX_DEPTH = 24\nSaveRules.MAX_PROGRESS_CHARS = 16384\nSaveRules.MAX_VALUE_CHARS = 4194304 -- Roblox's own limit on one stored value\nSaveRules.MAX_PROGRESS_NODES = 1500 -- values a progress message may hold, counted before anything reads it\nSaveRules.MAX_PROGRESS_DEPTH = 8\nSaveRules.MAX_PAGES = 200 -- notebook ids kept (the book has 25 pages; room for the future)\nSaveRules.MAX_ID_CHARS = 48\nSaveRules.MAX_EYE_SECONDS = 1.0e9\n\n-- ---------------------------------------------------------------- timing (seconds)\nSaveRules.PROGRESS_DEBOUNCE = 30 -- at most one progress write in this time (events in between are coalesced)\nSaveRules.REST_MIN_INTERVAL = 10 -- a key may be written about every 6 s; this leaves room\nSaveRules.HEARTBEAT = 30 -- the session lock is refreshed this often\nSaveRules.LOCK_STALE = 120 -- a lock older than this may be taken over by a newer session\nSaveRules.BACKOFF_BASE = 2\nSaveRules.BACKOFF_CAP = 60\nSaveRules.RETRY_LOAD = 15 -- a session that could not load or lock tries again this often\nSaveRules.FLUSH_ATTEMPTS = 4 -- tries at leaving or shutting down, with the backoff between\nSaveRules.FLUSH_BACKOFF = 1\nSaveRules.FLUSH_DEADLINE = 24 -- BindToClose has 30 s in all\nSaveRules.REQUESTS_PER_MINUTE = 10 -- DataStore requests one player's session may start in a minute (the budget is 60 + 10 per player)\n\n-- ---------------------------------------------------------------- what the client may send (per player)\nSaveRules.PROGRESS_BURST = 6\nSaveRules.PROGRESS_PER_SECOND = 0.5\nSaveRules.REST_BURST = 2\nSaveRules.REST_PER_SECOND = 0.2\nSaveRules.LIFE_BURST = 2\nSaveRules.LIFE_PER_SECOND = 0.2\nSaveRules.MAX_LIFE_SERIAL = 1000000000\nSaveRules.MAX_LIFE_TOKEN_CHARS = 160\nSaveRules.CLIENT_LIFE_GAP = 5 -- retry one idempotent retirement intent until durable acknowledgement\nSaveRules.PROTOCOL = 2 -- the version of the messages between client and server\nSaveRules.CLIENT_HELLO_GAP = 2.5 -- the client says hello again this often until the server answers\nSaveRules.CLIENT_HELLO_TRIES = 6\nSaveRules.CLIENT_PROGRESS_GAP = 2 -- the client sends at most one progress message in this time\nSaveRules.CLIENT_EYE_GAP = 30 -- and re-sends the eye-view seconds this often when they changed\nSaveRules.CLIENT_WAIT_REMOTES = 1.5 -- the start menu waits this long for the server's remotes to appear\nSaveRules.CLIENT_WAIT_REPLY = 4 -- and this long for the first reply after saying hello\n\n-- ---------------------------------------------------------------- words for statuses\nSaveRules.STATUS = { saved = \"saved\", saving = \"saving\", session = \"session\" } -- session: this visit only\nSaveRules.REASONS = { \"offline\", \"no_api\", \"load_failed\", \"other_session\", \"corrupt\", \"newer\", \"write_failed\", \"rest_refused\" } :: { string }\n\n-- The slot a life's rests are filed in: free play's own, the main life on the gentle rules (Easy) its own, and the standard main life the key it always had.\nfunction SaveRules.slotOf(mode: string, rules: string): string\n\tif mode == \"free\" then return \"free\" end\n\tif rules == \"gentle\" then return \"easy\" end\n\treturn \"main\"\nend\n\nreturn SaveRules\n"},{"Shared/Persistence/SaveRest","--!strict\n-- The last rest of a mode, as the server keeps it (ROBLOX-39): a retreat checkpoint (Checkpoint) in an envelope, one per mode.\n-- The simulation runs on the client, so the server cannot know the rest is a true one. What it can do, and does, is refuse anything that\n-- is not a whole, well-formed, sensible rest before it is stored: bounded size and depth, only plain values, the full checkpoint check\n-- (Checkpoint.check: format, schema, windowsill, the spider's pose, every reference in the object graph, the books adding up) against a\n-- stand-in world that names the same things the real one does, and the rules in the record agreeing with the mode it is filed under.\n-- This is a boundary for corruption safety, not anti-cheat: this is a solo game with no economy, so a client that lies only affects its\n-- own rest. A rest from a newer game build is refused here and, if it is already stored, left alone by SaveSession.\nlocal SaveRules = require(script.Parent.Parent.Data.SaveRules)\nlocal Species = require(script.Parent.Parent.Data.Species)\nlocal Json = require(script.Parent.Json)\nlocal Checkpoint = require(script.Parent.Checkpoint)\nlocal SaveEnvelope = require(script.Parent.SaveEnvelope)\n\nlocal SaveRest = {}\n\n-- Schema 2 accepts a checksummed {save_retired=true,save_life=token} marker or a checkpoint with optional save_life.\n-- The identity is storage metadata, not simulation state. Schema 1 migrates without changing its checkpoint.\n-- Older readers must refuse schema 2, preserving the marker and its previous-checkpoint backup.\nSaveRest.SCHEMA = 2\nfunction SaveRest.validLife(token: any): boolean\n return type(token)==\"string\" and #token>=1 and #token<=SaveRules.MAX_LIFE_TOKEN_CHARS and string.match(token,\"^[%w_:%.%-]+$\")~=nil\nend\nfunction SaveRest.isRetired(payload: any): boolean\n return type(payload)==\"table\" and rawget(payload,\"save_retired\")==true\nend\nlocal function validateStored(mode: string,payload: any): ({string},any?)\n if SaveRest.isRetired(payload) then\n  if not SaveRest.validLife(payload.save_life) then return {\"invalid retired life identity\"},nil end\n  for key in payload do if key~=\"save_retired\" and key~=\"save_life\" then return {\"unknown retirement field\"},nil end end\n  return {},payload\n end\n if type(payload)==\"table\" and (payload.save_retired~=nil or (payload.save_life~=nil and not SaveRest.validLife(payload.save_life))) then\n  return {\"invalid life identity\"},nil\n end\n return SaveRest.check(mode,payload),payload\nend\n\n-- Counts the values in `v` and refuses anything that is not a plain string, boolean, finite number or table without a metatable, a\n-- table met twice, or a structure deeper than `maxDepth` or larger than `maxNodes`. Cheap and bounded: a hostile payload is stopped\n-- before anything encodes it. Returns the problem, or nil.\nfunction SaveRest.bounded(v: any, maxNodes: number, maxDepth: number): string?\n\tlocal nodes = 0\n\tlocal seen: { [any]: boolean } = {}\n\tlocal problem: string? = nil\n\tlocal function walk(x: any, depth: number)\n\t\tif problem then return end\n\t\tnodes += 1\n\t\tif nodes > maxNodes then problem = \"too many values\"; return end\n\t\tlocal t = type(x)\n\t\tif t == \"string\" or t == \"boolean\" then return end\n\t\tif t == \"number\" then\n\t\t\tif x ~= x or x == math.huge or x == -math.huge then problem = \"a number JSON cannot hold\" end\n\t\t\treturn\n\t\tend\n\t\tif t ~= \"table\" then problem = `a {typeof(x)}, which a save cannot hold`; return end\n\t\tif depth > maxDepth then problem = \"nested too deeply\"; return end\n\t\tif getmetatable(x) ~= nil then problem = \"a table with a metatable\"; return end\n\t\tif seen[x] then problem = \"a table met twice\"; return end\n\t\tseen[x] = true\n\t\tfor k, y in x do\n\t\t\tif type(k) ~= \"string\" and type(k) ~= \"number\" then problem = \"a key that is not a string or a number\"; return end\n\t\t\twalk(y, depth + 1)\n\t\t\tif problem then return end\n\t\tend\n\tend\n\twalk(v, 1)\n\treturn problem\nend\n\n-- The stand-in world: whatever a real client's world offers to Checkpoint.refs, in the same names. A record names these by string; the\n-- server needs only that they exist. The species data is the real one (the record's profile references are paths into it).\nlocal function noop() end\nlocal function stubWorld(): Checkpoint.World\n\treturn {\n\t\tmotor = {}, \n\t\tprey = { p = Species.fly_like_prototype, graph = { cast = noop, sweep = noop, overlap = noop }, probe = {} },\n\t\tsensor = { core = { cueEmitted = {} } },\n\t\tmemory = { contactAcquired = {}, categoryChanged = {}, contactLost = {}, contactReacquired = {}, contactEnded = {} },\n\t\tneeds = { onEnergyChanged = noop },\n\t\tlife = { save = noop },\n\t} :: any\nend\nSaveRest.stubWorld = stubWorld\n\n-- Every problem with a rest filed under slot `mode` (\"main\", \"easy\" or \"free\", SaveRules.slotOf); an empty list for a good one. Never raises.\nfunction SaveRest.check(mode: any, record: any): { string }\n\tif mode ~= \"main\" and mode ~= \"free\" and mode ~= \"easy\" then return { \"unknown mode\" } end\n\tif type(record) ~= \"table\" then return { \"the rest is not a table\" } end\n if rawget(record,\"save_retired\")~=nil or (rawget(record,\"save_life\")~=nil and not SaveRest.validLife(rawget(record,\"save_life\"))) then return {\"reserved or invalid life identity\"} end\n\tlocal why = SaveRest.bounded(record, SaveRules.MAX_REST_NODES, SaveRules.MAX_DEPTH)\n\tif why then return { why } end\n\tlocal text, err = Json.canonical(record)\n\tif not text then return { \"cannot be stored: \" .. tostring(err) } end\n\tif #text > SaveRules.MAX_REST_CHARS then return { `the rest is {#text} characters; the limit is {SaveRules.MAX_REST_CHARS}` } end\n\tlocal rules = record.life_rules\n\t-- (the main slot also takes a main life on the gentle rules: an Easy rest saved before the Easy slot existed was filed there)\n\tif type(rules) ~= \"table\" or rules.mode ~= (if mode == \"free\" then \"free\" else \"main\") or (mode == \"easy\" and rules.rules ~= \"gentle\") then\n\t\treturn { `the rules in this rest are not {mode}'s` }\n\tend\n\tlocal ok, result = pcall(function(): { string }\n\t\tlocal found = Checkpoint.check(record, stubWorld())\n\t\treturn found\n\tend)\n\tif not ok then return { \"the check raised: \" .. tostring(result) } end\n\treturn result :: { string }\nend\n\n-- The envelope spec of a rest of `mode`.\nfunction SaveRest.spec(mode: string): SaveEnvelope.Spec\n\treturn {\n\t\tkind = \"rest_\" .. mode, current = SaveRest.SCHEMA,\n\t\tmigrations = { [1] = function(payload: any): any return payload end } :: { [number]: (any) -> any },\n  validate = function(payload: any): ({ string }, any?) return validateStored(mode,payload) end,\n\t}\nend\n\nSaveRest.SPECS = { main = SaveRest.spec(\"main\"), free = SaveRest.spec(\"free\"), easy = SaveRest.spec(\"easy\") }\n\nreturn SaveRest\n"},{"Shared/Persistence/SaveSession","--!strict\n-- One player's save session (ROBLOX-39): loads their records through a store backend, keeps their progress and rests in memory, and writes\n-- them back safely. All the decisions are here, with no engine in them: the backend (a real DataStore or the in-memory one), the clock and\n-- the sleep are handed in, so the tests drive every failure.\n--\n-- What it promises\n--   * Nothing stored is ever replaced by a default, a guess or a lesser copy. The first thing a session does is an UpdateAsync that reads the\n--     progress record and takes its lock; a record that cannot be read, is corrupt (checksum), is invalid, is made by a NEWER build, or is\n--     held by a live session makes the session session-only: it keeps the player's progress in memory, tells them, and writes nothing.\n--   * Writes are UpdateAsync that merge (pages are a union, eye time the longest, a finished life stays) and refuse to touch a lock another\n--     live session holds. A previous good version is kept inside the value as its backup.\n--   * One lock, one heartbeat: the progress record carries { session, beat }. A newer session may take it over once the beat is LOCK_STALE\n--     old; the older one finds out at its next write or heartbeat and goes read-only. A read-only or failed-to-load session tries again\n--     every RETRY_LOAD seconds and, once it holds the lock, merges what it kept with what is stored.\n--   * Rests are separate values (one per mode): replaceable, with their own backup. A rest is written only if nobody wrote a newer one\n--     since this session read it.\n-- States: \"loading\", \"active\", \"session\" (session-only: `reason` says why: offline, no_api, load_failed, other_session, corrupt, newer).\nlocal SaveRules = require(script.Parent.Parent.Data.SaveRules)\nlocal SaveEnvelope = require(script.Parent.SaveEnvelope)\nlocal SaveProgress = require(script.Parent.SaveProgress)\nlocal SaveRest = require(script.Parent.SaveRest)\nlocal SaveScheduler = require(script.Parent.SaveScheduler)\nlocal SaveStores = require(script.Parent.SaveStores)\nlocal Json = require(script.Parent.Json)\n\nlocal function canonical(v: any): string\n\treturn (Json.canonical(v)) or \"\"\nend\n\nlocal SaveSession = {}\nSaveSession.__index = SaveSession\n\nexport type Config = {\n\tbackend: any, userId: number | string, sessionId: string, now: () -> number,\n\tsleep: ((number) -> ())?, log: ((string) -> ())?, progressSpec: SaveEnvelope.Spec?, -- (a test may hand in a later schema)\n\tonChange: ((string, string?) -> ())?, onLoaded: ((any) -> ())?, onRest: ((string, any) -> ())?, onLife: ((string,number,string) -> ())?,\n}\n\n\nfunction SaveSession.new(cfg: Config): any\n\tlocal sched = SaveScheduler.new()\n\tsched:track(\"progress\", SaveRules.PROGRESS_DEBOUNCE)\n\tlocal rkey: { [string]: string } = {}\n\tfor _, mode in SaveRules.MODES do\n\t\tsched:track(\"rest_\" .. mode, SaveRules.REST_MIN_INTERVAL)\n\t\trkey[mode] = `{SaveRules.KEY_REST}{cfg.userId}_{mode}`\n\tend\n\treturn setmetatable({\n\t\tcfg = cfg, backend = cfg.backend, id = cfg.sessionId, now = cfg.now, pspec = cfg.progressSpec or SaveProgress.SPEC,\n\t\tpkey = SaveRules.KEY_PROGRESS .. tostring(cfg.userId),\n\t\trkey = rkey,\n\t\tsched = sched,\n\t\tstate = \"loading\", reason = nil :: string?, canRetry = false, retryAt = 0,\n\t\tprogress = SaveProgress.default(), progressTime = 0, storedTime = 0,\n\t\trests = {} :: { [string]: any }, lifeTokens = {} :: {[string]:string}, lifeRequests = {} :: {[string]:any},\n\t\trestBase = {} :: { [string]: number }, -- updatedAt of the rest this session last read or wrote (nil: unknown)\n\t\trestPending = {} :: { [string]: any }, restPendingTime = {} :: { [string]: number },\n\t\trestLoaded = {} :: { [string]: boolean }, restRetryAt = 0,\n\t\trestRejected = {} :: { [string]: boolean }, -- a locally kept rest the server could not accept\n\t\tlockHeld = false, busy = false, closed = false,\n\t\tlastStatus = \"\", lastReason = \"\",\n\t\tcounters = { requests = 0, writes = 0, rejected = 0 },\n\t}, SaveSession)\nend\n\nlocal function log(self: any, text: string)\n\tlocal l = self.cfg.log\n\tif l then l(`[save {self.cfg.userId}] {text}`) end\nend\n\nlocal function lockNow(self: any, now: number): { [string]: any }\n\treturn { session = self.id, beat = now }\nend\n\n-- Every slot's rest has been read (or found missing) at least once.\nfunction SaveSession.restsLoaded(self: any): boolean\n\tfor _, mode in SaveRules.MODES do\n\t\tif not self.restLoaded[mode] then return false end\n\tend\n\treturn true\nend\n\nfunction SaveSession.isActive(self: any): boolean\n\treturn self.state == \"active\"\nend\n\nfunction SaveSession.status(self: any): (string, string?)\n\tif self.state == \"session\" then return SaveRules.STATUS.session, self.reason end\n\tif self.state == \"loading\" then return SaveRules.STATUS.saving, nil end\n\tif next(self.restRejected) ~= nil then return SaveRules.STATUS.saving, \"rest_refused\" end\n\tif self.busy or self.sched:anyDirty() or not SaveSession.restsLoaded(self) then\n\t\tlocal trouble = false\n\t\tfor _, item in self.sched.items do\n\t\t\tif item.dirty and item.failures >= 3 then trouble = true end\n\t\tend\n\t\treturn SaveRules.STATUS.saving, if trouble then \"write_failed\" else nil\n\tend\n\treturn SaveRules.STATUS.saved, nil\nend\n\nfunction SaveSession.notify(self: any)\n\tlocal status, reason = self:status()\n\tlocal r = reason or \"\"\n\tif status ~= self.lastStatus or r ~= self.lastReason then\n\t\tself.lastStatus, self.lastReason = status, r\n\t\tlocal f = self.cfg.onChange\n\t\tif f then f(status, reason) end\n\tend\nend\n\n-- Goes session-only. The progress in memory stays; nothing more is written until the lock is held again (when `retry` is true).\nfunction SaveSession.demote(self: any, reason: string, retry: boolean)\n\tif self.state == \"session\" and self.reason == reason then return end\n\tlog(self, \"session-only: \" .. reason)\n\tself.state, self.reason, self.lockHeld = \"session\", reason, false\n\tself.canRetry = retry\n\tself.retryAt = self.now() + SaveRules.RETRY_LOAD\n\tself:notify()\nend\n\n-- ---------------------------------------------------------------- loading\n-- One try at reading the progress record and taking its lock. Returns a verdict:\n--   \"ok\" (held), \"locked\", \"newer\", \"corrupt\", \"failed\" (the store failed: class in .errClass), \"config\".\nlocal function attemptLock(self: any): (string, any)\n\tlocal now = self.now()\n\tlocal verdict = \"\"\n\tlocal info: any = nil\n\tself.sched:begin(nil, now)\n\tself.counters.requests += 1\n\tlocal ok, _, err = self.backend:update(self.pkey, function(old: any): any\n\t\tlocal op = SaveEnvelope.open(self.pspec, old)\n\t\tinfo = op\n\t\tverdict = op.status\n\t\tif op.status == \"newer\" or op.status == \"corrupt\" or op.status == \"invalid\" then return nil end\n\t\tif op.status == \"missing\" then\n\t\t\tverdict = \"ok\"\n\t\t\treturn SaveEnvelope.make(self.pspec, SaveProgress.default(), now, nil, { lock = lockNow(self, now) })\n\t\tend\n\t\tif SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then\n\t\t\tverdict = \"locked\"\n\t\t\treturn nil\n\t\tend\n\t\tverdict = \"ok\"\n\t\treturn SaveEnvelope.withLock(old, lockNow(self, now))\n\tend)\n\tif not ok then\n\t\tlocal class = SaveStores.classify(err)\n\t\treturn if class == \"config\" then \"config\" else \"failed\", { err = err, class = class }\n\tend\n\tif verdict == \"invalid\" then verdict = \"corrupt\" end\n\treturn verdict, info\nend\n\nlocal function adoptStored(self: any, info: any)\n\t-- The progress in memory (kept while the session was session-only, or sent by the client before the load finished) is merged into what is stored.\n\tlocal stored: any = if info and info.payload then info.payload else SaveProgress.default()\n\tlocal storedTime = if info and info.updatedAt then info.updatedAt else 0\n\tlocal mem = self.progress\n\tself.progress = SaveProgress.merge(stored, mem, storedTime, self.progressTime)\n\tself.storedTime = storedTime\n\tif not SaveProgress.same(self.progress, stored) then\n\t\tself.sched:markDirty(\"progress\", self.now())\n\tend\nend\n\nlocal function readRests(self: any)\n\tfor _, mode in SaveRules.MODES do\n\t\tif not self.restLoaded[mode] then\n\t\t\tlocal ok, value, err = self.backend:read(self.rkey[mode])\n\t\t\tself.sched:begin(nil, self.now())\n\t\t\tself.counters.requests += 1\n\t\t\tif not ok then\n\t\t\t\tlog(self, `could not read the {mode} rest: {tostring(err)}`)\n\t\t\t\tself.restRetryAt = self.now() + SaveScheduler.backoff(1, SaveStores.classify(err))\n\t\t\telse\n\t\t\t\tlocal spec = SaveRest.SPECS[mode]\n\t\t\t\tlocal op = SaveEnvelope.open(spec, value)\n\t\t\t\tself.restLoaded[mode] = true\n\t\t\t\tif op.status == \"ok\" or op.status == \"migrated\" then\n\t\t\t\t\tself.restBase[mode] = op.updatedAt\n\t\t\t\t\tself.lifeTokens[mode] = op.payload.save_life\n     self.rests[mode] = if SaveRest.isRetired(op.payload) then nil else op.payload\n\t\t\t\telseif op.status == \"missing\" then\n\t\t\t\t\tself.restBase[mode] = 0\n     self.lifeTokens[mode],self.rests[mode]=nil,nil\n\t\t\t\telse\n\t\t\t\t\t-- A readable backup is offered in memory only. Preserve the original unreadable record for recovery.\n\t\t\t\t\tself.restBase[mode] = op.updatedAt or 0\n\t\t\t\t\tlocal b = op.backup\n\t\t\t\t\tif b and (b.status == \"ok\" or b.status == \"migrated\") and not SaveRest.isRetired(b.payload) then self.rests[mode] = b.payload end\n\t\t\t\t\tlog(self, `the {mode} rest is {op.status}: {op.reasons[1] or \"\"}`)\n\t\t\t\t\tself:demote(if op.status == \"newer\" then \"newer\" else \"corrupt\", false)\n\t\t\t\tend\n\t\t\t\tlocal request=self.lifeRequests[mode]\n    local queued=self.restPending[mode]\n    if (request and request.done and request.token~=self.lifeTokens[mode])\n     or (queued and not SaveRest.isRetired(queued) and queued.save_life~=self.lifeTokens[mode]) then\n     self:demote(\"other_session\",false) -- another life won while ownership was unavailable; never relabel our queued world\n    end\n    if request and not request.done then self.rests[mode]=nil end\n    -- a rest we hold unsent that is newer than the one stored stays pending; an older one is dropped\n\t\t\t\tlocal pending = self.restPendingTime[mode]\n\t\t\t\tif pending ~= nil and not SaveRest.isRetired(self.restPending[mode]) and (self.restBase[mode] or 0) > pending then\n\t\t\t\t\tself.restPending[mode], self.restPendingTime[mode] = nil, nil\n\t\t\t\t\tself.sched.items[\"rest_\" .. mode].dirty = false\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- Loads the player's records. Yields (backend calls). Returns the state: \"active\" or \"session\".\nfunction SaveSession.load(self: any): string\n\tif self.closed then return self.state end\n\tlocal verdict, info = attemptLock(self)\n\tlocal first = self.state == \"loading\"\n\tif verdict == \"ok\" then\n\t\tadoptStored(self, info)\n\t\tself.state, self.reason, self.lockHeld, self.canRetry = \"active\", nil, true, false\n\t\tself.sched:beat(self.now())\n\t\tself.restLoaded = {} -- read again: another session may have written a rest while this one could not\n\t\treadRests(self)\n\telseif verdict == \"locked\" then\n\t\tif info and info.payload then self.progress = SaveProgress.merge(info.payload, self.progress, info.updatedAt or 0, self.progressTime) end\n\t\tself.state = \"session\"\n\t\tself:demote(\"other_session\", true)\n\telseif verdict == \"newer\" then\n\t\tself.state = \"session\"\n\t\tself:demote(\"newer\", false)\n\telseif verdict == \"corrupt\" then\n\t\t-- the stored record is left exactly as it is. If its backup is good the player sees that much of their notebook meanwhile.\n\t\tlocal b = info and info.backup\n\t\tif b and (b.status == \"ok\" or b.status == \"migrated\") then self.progress = SaveProgress.merge(b.payload, self.progress, b.updatedAt or 0, self.progressTime) end\n\t\tlog(self, \"the progress record is not readable: \" .. tostring(info and info.reasons and info.reasons[1]))\n\t\tself.state = \"session\"\n\t\tself:demote(\"corrupt\", false)\n\telseif verdict == \"config\" then\n\t\tself.state = \"session\"\n\t\tself:demote(\"no_api\", false)\n\telse\n\t\tlog(self, \"could not load: \" .. tostring(info and info.err))\n\t\tself.state = \"session\"\n\t\tself:demote(\"load_failed\", true)\n\tend\n\tif first or self.state == \"active\" then self:notify() end\n\treturn self.state\nend\n\n-- ---------------------------------------------------------------- what the client gives and what is known\nfunction SaveSession.setProgress(self: any, payload: any): boolean\n\tif self.closed then return false end\n\tlocal big = SaveRest.bounded(payload, SaveRules.MAX_PROGRESS_NODES, SaveRules.MAX_PROGRESS_DEPTH)\n\tif big then\n\t\tself.counters.rejected += 1\n\t\tlog(self, \"progress refused: \" .. big)\n\t\treturn false\n\tend\n\tlocal problems, clean = SaveProgress.sanitize(payload)\n\tif clean == nil then\n\t\tself.counters.rejected += 1\n\t\tlog(self, \"progress refused: \" .. tostring(problems[1]))\n\t\treturn false\n\tend\n\tlocal now = self.now()\n\tlocal merged = SaveProgress.merge(self.progress, clean, self.progressTime, now)\n\tif not SaveProgress.same(merged, self.progress) then\n\t\tself.progress = merged\n\t\tself.progressTime = now\n\t\tself.sched:markDirty(\"progress\", now)\n\t\tself:notify()\n\tend\n\treturn true\nend\n\n-- A session-local increasing intent makes retries idempotent and later New Life choices supersede earlier ones.\n-- The marker goes through the same guarded UpdateAsync and backup path as a rest; never DeleteAsync.\nfunction SaveSession.beginLife(self: any,mode: string,serial: any): boolean\n if self.closed or SaveRest.SPECS[mode]==nil or type(serial)~=\"number\" or serial~=serial or serial<1 or serial>SaveRules.MAX_LIFE_SERIAL or serial~=math.floor(serial) then return false end\n local prior=self.lifeRequests[mode]\n if prior and serial<prior.serial then return false end\n if prior and serial==prior.serial then\n  if prior.done and self.cfg.onLife then pcall(self.cfg.onLife,mode,serial,prior.token) end\n  return true\n end\n local token=`{self.id}:{mode}:{serial}`\n if not SaveRest.validLife(token) then return false end\n self.lifeRequests[mode]={serial=serial,token=token,done=false}\n self.rests[mode],self.restRejected[mode]=nil,nil\n self.restPending[mode]={save_retired=true,save_life=token}\n self.restPendingTime[mode]=self.now()\n self.sched:markDirty(\"rest_\"..mode,self.now());self:notify()\n return true\nend\n\n-- Legacy callers intentionally have no life credential; extra Lua return values are ignored here.\nfunction SaveSession.setRest(self: any,mode: string,record: any): boolean\n return self:setRestForLife(mode,record,nil)\nend\nfunction SaveSession.setRestForLife(self: any, mode: string, record: any,lifeToken: string?): boolean\n\tif self.closed or SaveRest.SPECS[mode] == nil then return false end\n local request=self.lifeRequests[mode]\n if (request and not request.done) or lifeToken~=self.lifeTokens[mode] then\n  self.counters.rejected+=1\n  return false -- never let a late prior-life rest cross a retirement boundary\n end\n-- Validate the exact stored candidate, including our identity metadata, against both size and node caps.\n local stamped=record\n local copyProblem: string?=nil\n if type(record)==\"table\" and getmetatable(record)==nil then\n  stamped={}\n  local count=0\n  for key,value in record do\n   count+=1\n   if count>SaveRules.MAX_REST_NODES then copyProblem=\"too many root values\";break end\n   stamped[key]=value\n  end\n  stamped.save_life=self.lifeTokens[mode]\n end\n local problems = if copyProblem then {copyProblem} else SaveRest.check(mode, stamped)\n\tif #problems > 0 then\n\t\tself.counters.rejected += 1\n\t\tlog(self, `the {mode} rest was refused: {problems[1]}`)\n\t\tself.restRejected[mode] = true\n\t\tself:notify()\n\t\treturn false\n\tend\n\tlocal now = self.now()\n\tself.restRejected[mode] = nil\n self.restPending[mode], self.restPendingTime[mode] = stamped, now\n\tself.sched:markDirty(\"rest_\" .. mode, now)\n\tself:notify()\n\treturn true\nend\n\n-- ---------------------------------------------------------------- writing\n-- Writes the progress (merged with what is stored). `release`: also let go of the lock. Returns true when it is stored.\nlocal function writeProgress(self: any, release: boolean): boolean\n\tlocal now = self.now()\n\tlocal version = self.sched:begin(\"progress\", now)\n\tself.counters.requests += 1\n\tlocal outcome = \"\"\n\tlocal merged: any = nil\n\tlocal newTime = now\n\tlocal ok, _, err = self.backend:update(self.pkey, function(old: any): any\n\t\toutcome = \"\"\n\t\tlocal op = SaveEnvelope.open(self.pspec, old, false)\n\t\tif op.status == \"newer\" then outcome = \"newer\"; return nil end\n\t\tif op.status == \"corrupt\" or op.status == \"invalid\" then outcome = \"corrupt\"; return nil end\n\t\tif op.status ~= \"missing\" and SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then outcome = \"locked\"; return nil end\n\t\tlocal base: any = if op.payload then op.payload else SaveProgress.default()\n\t\tlocal baseTime = op.updatedAt or 0\n\t\tmerged = SaveProgress.merge(base, self.progress, baseTime, self.progressTime)\n\t\tnewTime = math.max(now, baseTime)\n\t\toutcome = \"ok\"\n\t\tlocal lock = if release then nil else lockNow(self, now)\n\t\tif op.status ~= \"missing\" and SaveProgress.same(merged, base) and op.status == \"ok\" then\n\t\t\treturn SaveEnvelope.withLock(old, lock) -- nothing new to say: only the lock moves (payload, checksum and backup untouched)\n\t\tend\n\t\treturn SaveEnvelope.make(self.pspec, merged, newTime, old, { lock = lock })\n\tend)\n\tif not ok then\n\t\tlocal class = SaveStores.classify(err)\n\t\tif class == \"value\" then\n\t\t\tlog(self, \"the progress record cannot be stored: \" .. tostring(err))\n\t\t\tself.sched:abandon(\"progress\")\n\t\t\tself:demote(\"write_failed\", false)\n\t\t\treturn false\n\t\tend\n\t\tlocal wait = self.sched:failed(\"progress\", now, class)\n\t\tlog(self, `progress write failed ({class}, retry in {wait} s): {tostring(err)}`)\n\t\treturn false\n\tend\n\tif outcome == \"ok\" then\n\t\t-- UpdateAsync yields after its callback. Keep progress that arrived while the request was in flight.\n\t\tself.progress = SaveProgress.merge(merged, self.progress, newTime, self.progressTime)\n\t\tself.storedTime = newTime\n\t\tself.sched:succeeded(\"progress\", now, version)\n\t\tself.sched:beat(now)\n\t\tself.counters.writes += 1\n\t\tif release then self.lockHeld = false end\n\t\treturn true\n\tend\n\tif outcome == \"locked\" then\n\t\tself:demote(\"other_session\", true)\n\telseif outcome == \"newer\" then\n\t\tself:demote(\"newer\", false)\n\telseif outcome == \"corrupt\" then\n\t\tself:demote(\"corrupt\", false)\n\tend\n\treturn false\nend\n\nlocal function writeRest(self: any, mode: string): boolean\n\t-- Never overwrite a record whose load failed, including during shutdown.\n\tif not self.restLoaded[mode] or self.restBase[mode] == nil then return false end\n\tlocal name = \"rest_\" .. mode\n\tlocal record = self.restPending[mode]\n\tif record == nil then\n\t\tself.sched.items[name].dirty = false\n\t\treturn true\n\tend\n\tif not SaveRest.isRetired(record) and record.save_life~=self.lifeTokens[mode] then\n  self.restPending[mode],self.restPendingTime[mode]=nil,nil\n  self.sched:abandon(name);self:demote(\"other_session\",false)\n  return false\n end\n local now = self.now()\n local version = self.sched:begin(name, now)\n\tself.counters.requests += 1\n\tlocal spec = SaveRest.SPECS[mode]\n\tlocal outcome = \"\"\n\tlocal newTime = now\n local expectedLife=self.lifeTokens[mode]\n\tlocal ok, _, err = self.backend:update(self.rkey[mode], function(old: any): any\n\t\toutcome = \"\"\n\t\tlocal op = SaveEnvelope.open(spec, old, false)\n\t\tif op.status == \"newer\" then outcome = \"newer\"; return nil end\n\t\tif op.status == \"corrupt\" or op.status == \"invalid\" then outcome = \"corrupt\"; return nil end\n\t\tif (op.status==\"ok\" or op.status==\"migrated\") and op.payload.save_life~=expectedLife and op.session~=self.id then\n   outcome=\"superseded\";return nil -- life identities protect even simultaneous writes with equal timestamps\n  end\n  local base = self.restBase[mode]\n\t\tif (op.status == \"ok\" or op.status == \"migrated\") and base ~= nil and (op.updatedAt or 0) > base and op.session ~= self.id then\n\t\t\toutcome = \"superseded\"\n\t\t\treturn nil\n\t\tend\n\t\tif (op.status == \"ok\") and canonical(op.payload) == canonical(record) then\n\t\t\t-- already stored (an earlier try whose answer was lost): nothing to write, and the backup must not become a copy of it\n\t\t\tnewTime = op.updatedAt or now\n\t\t\toutcome = \"ok\"\n\t\t\treturn nil\n\t\tend\n\t\tnewTime = math.max(now, op.updatedAt or 0)\n\t\toutcome = \"ok\"\n\t\treturn SaveEnvelope.make(spec, record, newTime, old, { session = self.id })\n\tend)\n\tif not ok then\n\t\tlocal class = SaveStores.classify(err)\n\t\tif class == \"value\" then\n\t\t\tlog(self, `the {mode} rest cannot be stored: {tostring(err)}`)\n\t\t\tself.restPending[mode], self.restPendingTime[mode] = nil, nil\n\t\t\tself.sched:abandon(name)\n\t\t\tself:demote(\"write_failed\", false)\n\t\t\treturn false\n\t\tend\n\t\tlocal wait = self.sched:failed(name, now, class)\n\t\tlog(self, `{mode} rest write failed ({class}, retry in {wait} s): {tostring(err)}`)\n\t\treturn false\n\tend\n\tif outcome == \"ok\" then\n\t\tself.restBase[mode] = newTime\n\t\tself.lifeTokens[mode]=record.save_life\n  self.rests[mode] = if SaveRest.isRetired(record) then nil else record\n  local request=self.lifeRequests[mode]\n  if SaveRest.isRetired(record) and request and request.token==record.save_life then\n   request.done=true\n   if self.cfg.onLife then pcall(self.cfg.onLife,mode,request.serial,request.token) end\n  end\n  if self.restPending[mode] == record then self.restPending[mode], self.restPendingTime[mode] = nil, nil end\n\t\tself.sched:succeeded(name, now, version)\n\t\tself.counters.writes += 1\n\t\treturn true\n\tend\n\tif outcome == \"superseded\" then\n\t\tself:demote(\"other_session\", true)\n\telseif outcome == \"newer\" then\n\t\tself:demote(\"newer\", false)\n\telseif outcome == \"corrupt\" then\n\t\tself:demote(\"corrupt\", false)\n\tend\n\treturn false\nend\n\n-- Refreshes the lock when no write has done it lately.\nlocal function heartbeat(self: any)\n\tlocal now = self.now()\n\tself.sched:begin(nil, now)\n\tself.counters.requests += 1\n\tlocal outcome = \"\"\n\tlocal ok, _, err = self.backend:update(self.pkey, function(old: any): any\n\t\toutcome = \"\"\n\t\tlocal op = SaveEnvelope.open(self.pspec, old, false)\n\t\tif op.status == \"missing\" then outcome = \"missing\"; return nil end\n\t\tif op.status == \"newer\" then outcome = \"newer\"; return nil end\n\t\tif op.status == \"corrupt\" or op.status == \"invalid\" then outcome = \"corrupt\"; return nil end\n\t\tif SaveEnvelope.heldByOther(op.lock, self.id, now, SaveRules.LOCK_STALE) then outcome = \"locked\"; return nil end\n\t\toutcome = \"ok\"\n\t\treturn SaveEnvelope.withLock(old, lockNow(self, now))\n\tend)\n\tif not ok then\n\t\tlog(self, \"heartbeat failed: \" .. tostring(err))\n\t\tself.sched:beat(now - SaveRules.HEARTBEAT + 5) -- try again in a few seconds\n\t\treturn\n\tend\n\tself.sched:beat(now)\n\tif outcome == \"locked\" then self:demote(\"other_session\", true)\n\telseif outcome == \"newer\" then self:demote(\"newer\", false)\n\telseif outcome == \"corrupt\" then self:demote(\"corrupt\", false) end\nend\n\n-- One pass of the periodic work; the server calls it about once a second. Does at most one request per call. Returns whether it asked.\nlocal function stepInner(self: any): boolean\n\tlocal now = self.now()\n\tlocal did = true\n\tif self.state == \"session\" then\n\t\tif self.canRetry and now >= self.retryAt and self.sched:budgetOk(now) then\n\t\t\tself.retryAt = now + SaveRules.RETRY_LOAD\n\t\t\tlocal wasReason = self.reason\n\t\t\tself:load()\n\t\t\tif SaveSession.isActive(self) then\n\t\t\t\tlog(self, `holds the record again (was: {tostring(wasReason)})`)\n\t\t\t\tlocal f = self.cfg.onLoaded\n\t\t\t\tif f then f(self:snapshot()) end\n\t\t\tend\n\t\telse\n\t\t\tdid = false\n\t\tend\n\telseif self.state == \"active\" then\n\t\t-- A failed rest read must not starve lock renewal for a live player.\n\t\tif self.sched:due(\"progress\", now) then\n\t\t\twriteProgress(self, false) -- also renews the lock\n\t\telseif self.sched:heartbeatDue(now) then\n\t\t\theartbeat(self)\n\t\telseif not SaveSession.restsLoaded(self) then\n\t\t\tif now >= self.restRetryAt and self.sched:budgetOk(now) then\n\t\t\t\tlocal before: { [string]: any } = {}\n\t\t\t\tfor _, mode in SaveRules.MODES do before[mode] = self.rests[mode] end\n\t\t\t\treadRests(self)\n\t\t\t\tfor _, mode in SaveRules.MODES do\n\t\t\t\t\tif self.rests[mode] ~= nil and before[mode] == nil then\n\t\t\t\t\t\tlocal f = self.cfg.onRest\n\t\t\t\t\t\tif f then f(mode, self.rests[mode]) end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tdid = false\n\t\t\tend\n\t\telse\n\t\t\tdid = false\n\t\t\tfor _, mode in SaveRules.MODES do\n\t\t\t\tif self.sched:due(\"rest_\" .. mode, now) then\n\t\t\t\t\twriteRest(self, mode)\n\t\t\t\t\tdid = true\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\telse\n\t\tdid = false\n\tend\n\treturn did\nend\n\nfunction SaveSession.step(self: any): boolean\n\tif self.closed or self.busy then return false end\n\tself.busy = true\n\tlocal ok, did = pcall(stepInner, self)\n\tself.busy = false\n\tif not ok then\n\t\tlog(self, \"step failed: \" .. tostring(did))\n\t\treturn false\n\tend\n\tself:notify()\n\treturn did :: boolean\nend\n\n-- The state to hand the client: progress, the rests found, and the status.\nfunction SaveSession.snapshot(self: any): any\n\tlocal status, reason = self:status()\n\tlocal rests: { [string]: any } = {}\n\tfor _, mode in SaveRules.MODES do\n  local request=self.lifeRequests[mode]\n  if not request or request.done then rests[mode]=self.rests[mode] end\n end\n return { status = status, reason = reason, progress = self.progress, rests = rests, lives = Json.copy(self.lifeTokens) }\nend\n\n-- Leaving/shutdown keeps ownership until the pending records finish; a new visit must not load half a flush.\nfunction SaveSession.flush(self: any, deadline: number?)\n\tif self.closed or self.flushing then return end\n\tself.flushing = true\n\tlocal sleep = self.cfg.sleep\n\tlocal limit = deadline or (self.now() + SaveRules.FLUSH_DEADLINE)\n\twhile self.busy and self.now() < limit and sleep do sleep(0.25) end\n\tif self.busy or self.now() >= limit then\n\t\tself.closed, self.flushing = true, false\n\t\treturn -- never overlap an in-flight request; its lock will expire if it cannot finish\n\tend\n\tif self.state == \"active\" then\n\t\tself.busy = true\n\t\tlocal attempt = 0\n\t\twhile attempt < SaveRules.FLUSH_ATTEMPTS and self.state == \"active\" and self.now() < limit do\n\t\t\tattempt += 1\n\t\t\t-- Also checks ownership before touching a rest, even when progress itself is unchanged.\n\t\t\tlocal progressDone = writeProgress(self, false)\n\t\t\tlocal restsDone = true\n\t\t\tif progressDone and self.state == \"active\" then\n\t\t\t\tfor _, mode in SaveRules.MODES do\n\t\t\t\t\tif self.restPending[mode] ~= nil then\n\t\t\t\t\t\tif self.now() >= limit or self.state ~= \"active\" or not writeRest(self, mode) then restsDone = false end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif restsDone and self.state == \"active\" and self.now() < limit then\n\t\t\t\t\tif writeProgress(self, true) then break end -- release only after every rest has completed\n\t\t\t\tend\n\t\t\tend\n\t\t\tif self.now() >= limit or sleep == nil then break end\n\t\t\tsleep(math.min(SaveRules.FLUSH_BACKOFF * 2 ^ (attempt - 1), math.max(0, limit - self.now())))\n\t\tend\n\t\tself.busy = false\n\tend\n\tself.closed, self.flushing = true, false\n\tself:notify()\nend\n\nreturn SaveSession\n"},{"Shared/Prey/PreyWorld","--!strict\n-- The prey of the whole world (ROBLOX-96, W3): one Prey/PreyDirector per region that has prey, run only where the spider is. The sill's director is the one the\n-- client always had (`home`: its flies, its seed 914, its Feeding, which is the jaws and the only one that advances the reserves); the bed's is made from\n-- World/Garden.prey(region) with the region's own seed (WorldMap.seed) when the bed has first arrived whole and the spider is in it or beside it, and it keeps\n-- its own PreyRandom streams and its own clock ever after: crossing a seam rerolls nothing, and a region the spider has left simply waits (its clock stops) with its\n-- flies where they were. The gate is Client/WorldClient:regionReady (`world`): a region's director is never made, and never steps, while a box of the region may\n-- be missing, since every perch and every flight is a raycast. A neighbour's prey runs only when the farthest of its perches is inside ACTIVE_RADIUS (the\n-- streaming radius always sent) of the spider. The woodlice (Prey/Woodlouse) run beside the bed's director under the same gate, and are never swept.\n-- The directors share one set of casts (PreyDirector.casts: one probe, one set of closures) so a checkpoint names them once; the bed's director and its woodlice\n-- live in `garden` (the table Persistence/Checkpoint records as its `garden` root), so a rest under the stone keeps the bed's prey and puts it back where it was.\n-- ROBLOX-101 (W3b part A): the bestiary's prey, a director per kind per region (World/Garden.bestiary: springtails and leafhoppers in the bed, moths and crane\n-- flies on the wall and the outer sill), kept in the region's entry as `kinds` ({ [kind] = director }) and run in the spec's order beside W3's director, under the\n-- same gate. Each is made with its kind's profile, its own seed and the tier's target (`tier`: \"full\" or \"low\", the client's detail tier, read when a director is\n-- made). The moths and the crane flies follow the life clock's hour (`before`'s `hour`): restless from dusk through the night (Prey/PreyKinds.light). A moth's\n-- slip and a crane fly's shed leg are decided here, on the jaws, before their step (PreyKinds.grip), and the last of them is kept as `event` for the screen.\n-- The prey outside the sill never runs while the spider is on the sill itself (its neighbour the outer sill has prey now): the sill plays as it always did.\n-- ROBLOX-105 (W3b part B): the garden's ambient bugs that are not food (World/Garden.ambient: ladybirds on the bed's plants, millipedes and a snail on its soil\n-- and a harvestman in its litter, a harvestman on the house wall), a colony per kind per region (Prey/Ladybird, Millipede, Snail, Harvestman), kept in the\n-- region's entry as `ambient` ({ [kind] = colony }), made under the same gate and stepped beside the woodlice. None of them, and no longer the woodlice, is\n-- shown to the spider's senses: the perception modules know only movement, possible prey and fly-like prey, and a movement contact carries no name the HUD\n-- could caption \"not food\", so (Nathan's W3 call) they are left out of `percepts` rather than shown as movement the player might hunt. A strike that comes\n-- within one of them is refused (`event` { kind = \"refused\", prey = kind }, UI/PreyText) and the creature answers (a ladybird bleeds, a millipede coils, the\n-- snail withdraws, a woodlouse runs for cover); nothing of theirs is ever held.\nlocal PreyDirector = require(script.Parent.PreyDirector)\nlocal PreyKinds = require(script.Parent.PreyKinds)\nlocal Woodlouse = require(script.Parent.Woodlouse)\nlocal Ladybird = require(script.Parent.Ladybird)\nlocal Millipede = require(script.Parent.Millipede)\nlocal Snail = require(script.Parent.Snail)\nlocal Harvestman = require(script.Parent.Harvestman)\nlocal Ant = require(script.Parent.Ant) -- (ROBLOX-119: the meadow's ants)\nlocal Skater = require(script.Parent.Skater) -- (ROBLOX-122: the pond's water striders)\nlocal Species = require(script.Parent.Parent.Data.Species)\nlocal Garden = require(script.Parent.Parent.World.Garden)\nlocal Region = require(script.Parent.Parent.World.Region)\n\nlocal PreyWorld = {}\nPreyWorld.__index = PreyWorld\n\n-- (ROBLOX-105) The ambient colonies' classes by kind.\nPreyWorld.AMBIENT = { ladybird = Ladybird, millipede = Millipede, snail = Snail, harvestman = Harvestman, ant = Ant, skater = Skater } :: { [string]: any }\n-- (ROBLOX-105) Whether the woodlice and the ambient bugs are shown to the spider's senses (see the head of this file: they are not).\nPreyWorld.SENSED = false\n\n-- A neighbouring region's prey runs while its farthest perch is inside this many studs of the spider (Workspace.StreamingMinRadius, 96: what is always sent).\nPreyWorld.ACTIVE_RADIUS = 96\n\n-- `home`: the sill's director; `world`: the client's world (WorldClient: `region`, `home`, `map`, `regionReady`); `garden`: the table the checkpoint records\n-- ({ [regionId] = { prey = director?, bugs = woodlice? } }); `root`: the folder the casts include (nil: no engine, no director is ever made); `casts`: the home's\n-- casts, when it has them (PreyDirector.casts), else new ones.\nfunction PreyWorld.new(home: any, world: any, garden: { [string]: any }, root: Instance?, casts: any?): any\n\treturn setmetatable({\n\t\thome = home, world = world, garden = garden, root = root,\n\t\tcasts = casts or (if root ~= nil then PreyDirector.casts(root) else nil),\n\t\tclock = 0, -- a running clock for the drawing (the directors' own stop while they wait)\n\t\tactive = {} :: { string }, -- the regions whose prey ran this tick\n\t\tview = { flies = {}, feeding = home.feeding }, -- what the sound and the drawing read: the active flies and the jaws\n\t\tmade = 0, -- directors made so far\n\t\ttier = \"full\", -- (ROBLOX-101) the detail tier, for how many of the bestiary's prey a region holds\n\t\thour = nil :: number?, -- (ROBLOX-101) the life clock's hour, when the client gives it\n\t\tevent = nil :: any, -- (ROBLOX-101) the last prey that got out of the jaws by its own trick: { kind = \"slip\" | \"shed\", prey = prey kind }; (ROBLOX-105) or a strike refused\n\t\tstrikeEnd = -1, -- (ROBLOX-105) the ambient strike's window: open until this clock time\n\t\tstrikeMode = \"attached\", -- the motor's mode last tick\n\t\tstrikeFrom = nil :: Vector3?, -- where the spider was last tick\n\t\trefused = 0, -- strikes refused so far\n\t}, PreyWorld)\nend\n\n-- The farthest a region's prey can be from the spider: over the perches and vents of its directors where it has them, else of its specs (W3's and the\n-- bestiary's).\nlocal function reach(self: any, region: any, pos: Vector3): number\n\tlocal far = 0\n\tlocal function over(list: { any }) for _, p in list do far = math.max(far, (p.position - pos).Magnitude) end end\n\tif region.id == self.world.home then\n\t\tover(self.home.graph.perches); over(self.home.vents)\n\t\treturn far\n\tend\n\tlocal entry = self.garden[region.id] or {}\n\tlocal any = false\n\tlocal spec = Garden.prey(region)\n\tif entry.prey ~= nil then over(entry.prey.graph.perches); over(entry.prey.vents); any = true\n\telseif spec ~= nil then over(spec.perches); over(spec.vents); any = true end\n\tfor _, k in (Garden.bestiary(region) or {}) :: { any } do\n\t\tlocal d = if entry.kinds ~= nil then entry.kinds[k.kind] else nil\n\t\tif d ~= nil then over(d.graph.perches); over(d.vents) else over(k.perches); over(k.vents) end\n\t\tany = true\n\tend\n\treturn if any then far else math.huge\nend\n\n-- Whether a region has prey at all: the sill's (the home), or a kind Garden places prey in (W3's or the bestiary's). (ROBLOX-116: or woodlice or ambient bugs alone,\n-- as the hut garden's lawn by the trough and the stone has: every region of the test garden with those has prey too, so nothing there changes.)\nfunction PreyWorld.hasPrey(self: any, region: any): boolean\n\treturn region.id == self.world.home or Garden.prey(region) ~= nil or Garden.bestiary(region) ~= nil or Garden.bugs(region) ~= nil or Garden.ambient(region) ~= nil\nend\n\n-- The ids of the regions whose prey runs at this place: the spider's own, and each neighbour with prey whose farthest perch is within ACTIVE_RADIUS (none while\n-- the spider is on the sill itself: ROBLOX-101 keeps the sill as it was now that the outer sill has prey).\nfunction PreyWorld.activeAt(self: any, pos: Vector3): { string }\n\tlocal here = self.world.region\n\tlocal out: { string } = {}\n\tif self:hasPrey(here) then table.insert(out, here.id) end\n\tif here.id == self.world.home then return out end\n\tfor _, n in here.neighbors do\n\t\tlocal r = self.world.map.region(n.id)\n\t\tif r ~= nil and self:hasPrey(r) and reach(self, r, pos) <= PreyWorld.ACTIVE_RADIUS then table.insert(out, r.id) end\n\tend\n\treturn out\nend\n\n-- The region's director, made now if the region is whole and it has none yet (nil for a region with no prey, or one not yet whole). The sill's is the home.\nfunction PreyWorld.director(self: any, id: string): any\n\tif id == self.world.home then return self.home end\n\tlocal entry = self.garden[id]\n\tif entry ~= nil and entry.prey ~= nil then\n\t\tentry.prey.feeding = self.home.feeding -- (a return to a rest rebuilds the jaws: every director eats with the home's)\n\t\treturn entry.prey\n\tend\n\tlocal region = self.world.map.region(id)\n\tlocal spec = if region ~= nil then Garden.prey(region) else nil\n\tif spec == nil then return nil end\n\tif self.root == nil or not self.world:regionReady(id) then return nil end\n\tlocal d = PreyDirector.engine(self.root, Species.fungus_gnat_prototype, spec.seed, spec.target, false, spec, self.casts)\n\td.feeding = self.home.feeding -- one jaws, one reserve\n\tentry = entry or {}\n\tentry.prey = d\n\tself.garden[id] = entry\n\tself.made += 1\n\treturn d\nend\n\n-- The region's bestiary directors in the spec's order, each made now if the region is whole and it has none yet (an empty list for a region without any).\nfunction PreyWorld.kinds(self: any, id: string): { any }\n\tlocal out = {}\n\tif id == self.world.home then return out end\n\tlocal region = self.world.map.region(id)\n\tlocal specs = if region ~= nil then Garden.bestiary(region) else nil\n\tif specs == nil then return out end\n\tlocal entry = self.garden[id]\n\tfor _, spec in specs do\n\t\tlocal d = if entry ~= nil and entry.kinds ~= nil then entry.kinds[spec.kind] else nil\n\t\tif d == nil and self.root ~= nil and self.world:regionReady(id) then\n\t\t\tlocal target = if self.tier == \"low\" then spec.low else spec.target\n\t\t\td = PreyDirector.engine(self.root, (Species :: any)[spec.profile], spec.seed, target, false, spec, self.casts)\n\t\t\tentry = entry or {}\n\t\t\tentry.kinds = entry.kinds or {}\n\t\t\tentry.kinds[spec.kind] = d\n\t\t\tself.garden[id] = entry\n\t\t\tself.made += 1\n\t\tend\n\t\tif d ~= nil then\n\t\t\td.feeding = self.home.feeding -- (one jaws: a return to a rest rebuilds them)\n\t\t\ttable.insert(out, d)\n\t\tend\n\tend\n\treturn out\nend\n\n-- Every director of a region: W3's (the bed's gnats and aphids), then the bestiary's.\nfunction PreyWorld.directors(self: any, id: string): { any }\n\tlocal out = {}\n\tlocal d = self:director(id)\n\tif d ~= nil then table.insert(out, d) end\n\tfor _, k in self:kinds(id) do table.insert(out, k) end\n\treturn out\nend\n\n-- The region's woodlice, made with its director's gate (nil for a region without any, or one not yet whole).\nfunction PreyWorld.bugs(self: any, id: string): any\n\tif id == self.world.home then return nil end\n\tlocal entry = self.garden[id]\n\tif entry ~= nil and entry.bugs ~= nil then return entry.bugs end\n\tlocal region = self.world.map.region(id)\n\tlocal spec = if region ~= nil then Garden.bugs(region) else nil\n\tif spec == nil then return nil end\n\tif not self.world:regionReady(id) then return nil end\n\tlocal soil: any, boxes = nil, {}\n\tfor _, p in Region.pieces(region) do\n\t\tif p.id == region.id .. \"_soil\" then soil = { min = p.lo, max = p.hi }\n\t\telseif p.lo.Y <= region.origin.Y + 0.01 then table.insert(boxes, { min = p.lo, max = p.hi }) end\n\tend\n\tfor _, b in Garden.standingFrom(region) do table.insert(boxes, b) end -- (ROBLOX-107: the drainpipe's foot, wall_west's box, on a chunk of the bushes' litter)\n\tif soil == nil then return nil end\n\tlocal w = Woodlouse.new(spec, soil, boxes)\n\tentry = entry or {}\n\tentry.bugs = w\n\tself.garden[id] = entry\n\treturn w\nend\n\n-- The region's ambient colonies in Garden.AMBIENT's order, each made now if the region is whole and it has none yet (an empty list for a region without any).\n-- A colony on the soil needs the soil and the standing boxes, as the woodlice do.\nfunction PreyWorld.ambient(self: any, id: string): { any }\n\tlocal out = {}\n\tif id == self.world.home then return out end\n\tlocal region = self.world.map.region(id)\n\tlocal specs = if region ~= nil then Garden.ambient(region) else nil\n\tif specs == nil then return out end\n\tlocal entry = self.garden[id]\n\tlocal soil: any, boxes: { any }? = nil, nil\n\tfor _, spec in specs do\n\t\tlocal c = if entry ~= nil and entry.ambient ~= nil then entry.ambient[spec.kind] else nil\n\t\tif c == nil and self.world:regionReady(id) then\n\t\t\tlocal count = if self.tier == \"low\" then spec.low else spec.full\n\t\t\tif spec.surface == \"soil\" and soil == nil then\n\t\t\t\tboxes = {}\n\t\t\t\tfor _, p in Region.pieces(region) do\n\t\t\t\t\tif p.id == region.id .. \"_soil\" then soil = { min = p.lo, max = p.hi }\n\t\t\t\t\telseif p.lo.Y <= region.origin.Y + 0.01 then table.insert(boxes :: any, { min = p.lo, max = p.hi }) end\n\t\t\t\tend\n\t\t\t\tfor _, b in Garden.standingFrom(region) do table.insert(boxes :: any, b) end\n\t\t\tend\n\t\t\tif spec.kind == \"ladybird\" then c = Ladybird.new(spec, count, Garden.plants(region) or {})\n\t\t\telseif spec.kind == \"millipede\" and soil ~= nil then c = Millipede.new(spec, count, soil, boxes :: any)\n\t\t\telseif spec.kind == \"snail\" and soil ~= nil then c = Snail.new(spec, count, soil, boxes :: any)\n\t\t\telseif spec.kind == \"harvestman\" then c = Harvestman.new(spec, count, soil, boxes)\n\t\t\telseif spec.kind == \"ant\" and soil ~= nil then c = Ant.new(spec, count, soil, boxes)\n\t\t\telseif spec.kind == \"skater\" then c = Skater.new(spec, count) end\n\t\t\tif c ~= nil then\n\t\t\t\tentry = entry or {}\n\t\t\t\tentry.ambient = entry.ambient or {}\n\t\t\t\tentry.ambient[spec.kind] = c\n\t\t\t\tself.garden[id] = entry\n\t\t\tend\n\t\tend\n\t\tif c ~= nil then table.insert(out, c) end\n\tend\n\treturn out\nend\n\n-- Every percept of the active regions: their flies (the woodlice and the ambient bugs only if SENSED, as movement).\nfunction PreyWorld.percepts(self: any): { any }\n\tlocal out = {}\n\tfor _, id in self.active do\n\t\tfor _, d in self:directors(id) do for _, p in d:percepts() do table.insert(out, p) end end\n\t\tlocal w = if PreyWorld.SENSED then self:bugs(id) else nil\n\t\tif w ~= nil then for _, p in w:percepts() do table.insert(out, p) end end\n\tend\n\treturn out\nend\n\n-- Before the motor (the client's order): which regions are active at this place, then each active director's `before` and its woodlice.\n-- `hour` (ROBLOX-101): the life clock's hour, for the kinds that fly from dusk (nil: the last one given, or day).\nfunction PreyWorld.before(self: any, dt: number, position: Vector3, observer: any, sensor: any, cast: any, camera: any, hour: number?)\n\tself.clock += dt\n\tif hour ~= nil then self.hour = hour end\n\tself.active = self:activeAt(position)\n\tfor _, id in self.active do\n\t\tfor _, d in self:directors(id) do\n\t\t\tlocal dusk = Garden.BESTIARY.dusk\n\t\t\tif PreyKinds.counterpart(d.p, true) ~= nil or PreyKinds.counterpart(d.p, false) ~= nil then\n\t\t\t\tPreyKinds.light(d, self.hour ~= nil and PreyKinds.isDusk(self.hour, dusk.from, dusk.to))\n\t\t\tend\n\t\t\td:before(dt, position, observer, sensor, cast, camera)\n\t\tend\n\t\tlocal w = self:bugs(id)\n\t\tif w ~= nil then w:step(dt, position) end\n\t\tlocal list = self:ambient(id)\n\t\tif #list > 0 then\n\t\t\tlocal region = self.world.map.region(id)\n\t\t\tlocal aphids = {}\n\t\t\tlocal d = self:director(id)\n\t\t\tif d ~= nil then for _, f in d.flies do table.insert(aphids, f) end end\n\t\t\tlocal ctx = { hour = self.hour, flies = aphids, plants = if region ~= nil then Garden.plants(region) else nil, ripple = self.ripple } -- (ROBLOX-122: `ripple`, a spider struggling in the water: Life/Water)\n\t\t\tfor _, c in list do c:step(dt, position, ctx) end\n\t\tend\n\tend\nend\n\n-- Whether the home's prey ran this tick.\nfunction PreyWorld.homeActive(self: any): boolean\n\treturn table.find(self.active, self.world.home) ~= nil\nend\n\n-- A fly that tore free goes back to the director it belongs to (returned).\nfunction PreyWorld.escape(self: any, f: any): any\n\tif not self.home:owns(f) then\n\t\tfor _, entry in self.garden do\n\t\t\tif entry.prey ~= nil and entry.prey:owns(f) then entry.prey:escape(f); return entry.prey end\n\t\t\tfor _, d in entry.kinds or {} do\n\t\t\t\tif d:owns(f) then d:escape(f); return d end\n\t\t\tend\n\t\tend\n\tend\n\tself.home:escape(f)\n\treturn self.home\nend\n\n-- (ROBLOX-101) A prey that got out of the jaws by its own trick cannot be struck again for this long (seconds): it leaves from the spider's mouth while the\n-- strike that took it may still be open, and a slip that is caught again on the same tick would be no slip.\nPreyWorld.FREE_S = 0.5\n\n-- After the motor: the home's `after` always (the jaws, the reserves, once a tick; with no sweep where its prey did not run), every other active director's\n-- `afterShared`. Then the view the sound and the drawing read.\nfunction PreyWorld.after(self: any, dt: number, motor: any, sensor: any, cast: any)\n\tif not self:homeActive() then self.home.previousPosition = motor.pos end\n\t-- (ROBLOX-101) a moth's slip, a crane fly's shed leg: out of the jaws before they step\n\tlocal held = self.home.feeding.held\n\tlocal trick = PreyKinds.grip(self.home.feeding, function(f)\n\t\tlocal d = self:escape(f)\n\t\tf.freeUntil = d.now + PreyWorld.FREE_S\n\tend)\n\tif trick ~= nil then self.event = { kind = trick, prey = held.profile.body.prey_kind } end\n\tself.home:after(dt, motor, sensor, cast, function(f) self:escape(f) end)\n\tfor _, id in self.active do\n\t\tif id ~= self.world.home then\n\t\t\tfor _, d in self:directors(id) do d:afterShared(motor, sensor, cast) end\n\t\tend\n\tend\n\tself:strikeAmbient(motor)\n\tlocal flies = {}\n\tfor _, id in self.active do\n\t\tfor _, d in self:directors(id) do for _, f in d.flies do table.insert(flies, f) end end\n\tend\n\tself.view.flies = flies\n\tself.view.feeding = self.home.feeding\nend\n\n-- The active regions' flies, for the drawing and the notebook's watcher.\nfunction PreyWorld.flies(self: any): { any }\n\treturn self.view.flies\nend\n\n-- (ROBLOX-105) The strike against what is not food: a window opened by a leap (the motor's `launched` as it leaves the ground, as the directors' own) and closed\n-- just after it lands; while it is open and the jaws are empty, a sweep of the spider's body from last tick's place to this one against every woodlouse and\n-- ambient bug of the active regions. The first one within its radius (and the directors' 0.3) is refused: `event`, the creature's answer, the window shut.\nfunction PreyWorld.strikeAmbient(self: any, motor: any)\n\tlocal mode = motor.mode\n\tif mode == \"air\" and self.strikeMode ~= \"air\" then\n\t\tfor _, e in motor.events or {} do if e.kind == \"launched\" then self.strikeEnd = self.clock + 4; break end end\n\tend\n\tif self.strikeMode == \"air\" and mode ~= \"air\" then self.strikeEnd = math.min(self.strikeEnd, self.clock + 0.05) end\n\tself.strikeMode = mode\n\tlocal from = self.strikeFrom or motor.pos\n\tself.strikeFrom = motor.pos\n\tif self.clock > self.strikeEnd or self.home.feeding.held ~= nil then return end\n\tlocal seg = motor.pos - from\n\tlocal len2 = seg:Dot(seg)\n\tfor _, id in self.active do\n\t\tlocal colonies = {}\n\t\tlocal w = self:bugs(id)\n\t\tif w ~= nil then table.insert(colonies, { c = w, kind = \"woodlouse\" }) end\n\t\tfor _, c in self:ambient(id) do table.insert(colonies, { c = c, kind = c.kind }) end\n\t\tfor _, e in colonies do\n\t\t\tfor _, t in e.c:targets() do\n\t\t\t\tlocal u = if len2 > 1e-12 then math.clamp((t.position - from):Dot(seg) / len2, 0, 1) else 0\n\t\t\t\tif ((from + seg * u) - t.position).Magnitude <= t.radius + 0.3 then\n\t\t\t\t\te.c:struck(t.creature)\n\t\t\t\t\tself.event = { kind = \"refused\", prey = e.kind }\n\t\t\t\t\tself.refused += 1\n\t\t\t\t\tself.strikeEnd = -1\n\t\t\t\t\treturn\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- (ROBLOX-105) Every woodlouse and ambient bug of the active regions, for the drawing (Client/BugBodies: a creature with no `kind` is a woodlouse) and the\n-- notebook's close look.\nfunction PreyWorld.crawlers(self: any): { any }\n\tlocal out = {}\n\tfor _, id in self.active do\n\t\tlocal w = self:bugs(id)\n\t\tif w ~= nil then for _, l in w.lice do table.insert(out, l) end end\n\t\tfor _, c in self:ambient(id) do for _, b in c:creatures() do table.insert(out, b) end end\n\tend\n\treturn out\nend\n\n-- The active regions' woodlice, for the drawing.\nfunction PreyWorld.woodlice(self: any): { any }\n\tlocal out = {}\n\tfor _, id in self.active do\n\t\tlocal w = self:bugs(id)\n\t\tif w ~= nil then for _, l in w.lice do table.insert(out, l) end end\n\tend\n\treturn out\nend\n\n-- Every capture made, in every region.\nfunction PreyWorld.captures(self: any): number\n\tlocal n = self.home.captures\n\tfor _, entry in self.garden do\n\t\tif entry.prey ~= nil then n += entry.prey.captures end\n\t\tfor _, d in entry.kinds or {} do n += d.captures end\n\tend\n\treturn n\nend\n\nreturn PreyWorld\n"},{"Shared/UI/SaveText","--!strict\n-- The words about saving (ROBLOX-39): what the menu and a short toast say. Plain and honest: saved, saving, or off for this visit and why.\n-- The reasons are SaveRules.REASONS. Pure; checked in tests/state_client.luau.\nlocal SaveText = {}\n\nSaveText.SAVED = \"Your notebook and last rests are saved.\"\nSaveText.SAVING = \"Saving...\"\nSaveText.TROUBLE = \"Having trouble saving. Your progress is kept for now and the game keeps trying.\"\nSaveText.REST_REFUSED = \"Your latest rest could not be saved online. It is kept for this visit; your earlier saved rest is unchanged.\"\nSaveText.OFF = \"Saving is off for this visit: your notebook and rests will last only until you leave.\"\nSaveText.LOOKING = \"Finding your saved game...\"\nSaveText.BACK = \"Saving is back on.\"\n-- ROBLOX-92: the client's saving broke (something in it raised): saving is off for the rest of the visit, and the game goes on. The one status line, and the menu's.\nSaveText.BROKEN = \"Saving is off\"\n\nSaveText.WHY = {\n\toffline = \"The game could not reach its saving service.\",\n\tno_api = \"Saving is not available here.\",\n\tload_failed = \"Your saved game could not be read just now. It has not been changed, and the game keeps trying.\",\n\tother_session = \"Your game is open somewhere else, and this copy cannot save over it.\",\n\tcorrupt = \"Your saved game could not be read, so it was left exactly as it is.\",\n\tnewer = \"Your saved game was made by a newer version of this game, so it was left exactly as it is.\",\n\twrite_failed = \"This visit could not be saved. Your earlier saved game is still kept.\",\n\trest_refused = SaveText.REST_REFUSED,\n} :: { [string]: string }\n\nlocal function because(reason: string?): string?\n\tif reason == nil then return nil end\n\treturn SaveText.WHY[reason]\nend\n\n-- The line for the menu: one or two sentences.\nfunction SaveText.menuLine(status: string?, reason: string?): string\n\tif status == \"session\" then\n\t\tlocal why = because(reason)\n\t\treturn SaveText.OFF .. (if why then \"\\n\" .. why else \"\")\n\telseif status == \"saving\" then\n\t\tif reason == \"rest_refused\" then return SaveText.REST_REFUSED end\n\t\treturn if reason == \"write_failed\" then SaveText.TROUBLE else SaveText.SAVING\n\telseif status == \"saved\" then\n\t\treturn SaveText.SAVED\n\tend\n\treturn SaveText.LOOKING\nend\n\n-- The line for the menu once the client's own saving has broken (the server's word no longer matters: nothing more is sent).\nfunction SaveText.brokenLine(): string\n\treturn SaveText.OFF .. \"\\nSomething in the saving broke, so this visit will not be saved.\"\nend\n\n-- A short toast when the status changes, or \"\" when nothing needs saying (a plain saving/saved flicker is not announced).\nfunction SaveText.toast(oldStatus: string?, oldReason: string?, status: string?, reason: string?): string\n\tlocal was: string = oldStatus or \"\"\n\tlocal now: string = status or \"\"\n\tlocal toSession = now == \"session\" and was ~= \"session\"\n\tlocal fromSession = was == \"session\" and (now == \"saved\" or now == \"saving\")\n\tlocal newTrouble = now == \"saving\" and reason == \"write_failed\" and was ~= \"\" and not (was == \"saving\" and oldReason == \"write_failed\")\n\tif now == \"saving\" and reason == \"rest_refused\" and not (was == \"saving\" and oldReason == \"rest_refused\") then return SaveText.REST_REFUSED end\n\tif toSession then\n\t\tlocal why = because(reason)\n\t\treturn SaveText.OFF .. (if why then \" \" .. why else \"\")\n\telseif fromSession then\n\t\treturn SaveText.BACK\n\telseif newTrouble then\n\t\treturn SaveText.TROUBLE\n\tend\n\treturn \"\"\nend\n\nreturn SaveText\n"},{"Server/RestCompression","--!strict\n-- Storage only: independently compressed current/backup cores retain their original canonical checksums.\n-- The opaque schema-2 header makes an older server refuse this value as newer. No simulation fields change.\nlocal RestCompression={}\nRestCompression.__index=RestCompression\nRestCompression.ENCODING=\"zstd-base64-2\"\nRestCompression.MAX_STORED_CHARS=1500000\nRestCompression.MAX_CORE_BYTES=6000000\nRestCompression.MAX_EXPANDED_BYTES=12000000\nRestCompression.HEADER_RESERVE=2048\nexport type Adapter={\n compress:(string)->string, expandedSize:(string)->number?, decompress:(string)->string,\n parse:(string)->any, serialize:(any)->(string?,string?),\n}\nlocal function finite(v: any): boolean\n return type(v)==\"number\" and v==v and v~=math.huge and v~=-math.huge\nend\nlocal function whole(v: any): boolean return finite(v) and v>=1 and v==math.floor(v) end\nlocal function restKind(v: any): boolean\n return v==\"rest_main\" or v==\"rest_easy\" or v==\"rest_free\"\nend\nlocal FIELDS={format=true,kind=true,schema=true,innerSchema=true,updatedAt=true,encoding=true,bytes=true,data=true,backup=true}\nlocal function future(v: any): boolean\n if type(v)~=\"table\" or not finite(v.schema) or v.schema<2 then return false end\n if v.schema>2 or v.encoding~=RestCompression.ENCODING then return true end\n for k in v do if not FIELDS[k] then return true end end\n return false\nend\nfunction RestCompression.new(adapter: Adapter): any\n assert(2*RestCompression.MAX_CORE_BYTES<=RestCompression.MAX_EXPANDED_BYTES,\"invalid combined expansion budget\")\n return setmetatable({adapter=adapter},RestCompression)\nend\nlocal function coreEnvelope(v: any): any\n local out={}\n for k,x in v do if k~=\"backup\" then out[k]=x end end\n return out\nend\nlocal function packCore(self: any,envelope: any): any\n assert(type(envelope)==\"table\" and restKind(envelope.kind),\"not a rest envelope\")\n assert(whole(envelope.schema) and finite(envelope.updatedAt),\"invalid rest envelope header\")\n local text,why=self.adapter.serialize(coreEnvelope(envelope))\n assert(text,why)\n assert(#text<=RestCompression.MAX_CORE_BYTES,\"rest core exceeds expanded limit\")\n local data=self.adapter.compress(text)\n assert(type(data)==\"string\" and #data<=RestCompression.MAX_STORED_CHARS,\"compressed rest exceeds storage limit\")\n return {format=envelope.format,kind=envelope.kind,schema=2,innerSchema=envelope.schema,\n  updatedAt=envelope.updatedAt,encoding=RestCompression.ENCODING,bytes=#text,data=data}\nend\nfunction RestCompression.encode(self: any,envelope: any): any\n local wrapped=packCore(self,envelope)\n if envelope.backup~=nil then\n  local backup=coreEnvelope(envelope.backup)\n  backup.format,backup.kind=envelope.format,envelope.kind\n  wrapped.backup=packCore(self,backup)\n end\n local dataBytes=#wrapped.data+(if wrapped.backup then #wrapped.backup.data else 0)\n assert(dataBytes+RestCompression.HEADER_RESERVE<=RestCompression.MAX_STORED_CHARS,\"compressed rest and backup exceed storage limit\")\n assert(#assert(self.adapter.serialize(wrapped))<=RestCompression.MAX_STORED_CHARS,\"compressed rest header exceeds storage limit\")\n return wrapped\nend\nlocal function unpackCore(self: any,v: any): any\n assert(type(v)==\"table\" and v.encoding==RestCompression.ENCODING and v.schema==2,\"invalid compressed rest schema\")\n assert(restKind(v.kind) and type(v.format)==\"string\" and #v.format<=64,\"invalid compressed rest kind\")\n assert(whole(v.innerSchema) and finite(v.updatedAt),\"invalid inner rest header\")\n assert(type(v.data)==\"string\" and #v.data<=RestCompression.MAX_STORED_CHARS,\"invalid compressed rest size\")\n assert(whole(v.bytes) and v.bytes<=RestCompression.MAX_CORE_BYTES,\"invalid expanded rest size\")\n local size=self.adapter.expandedSize(v.data)\n assert(size==v.bytes,\"compressed rest frame size does not match its header\")\n local text=self.adapter.decompress(v.data)\n assert(type(text)==\"string\" and #text==size,\"decompressed rest size does not match\")\n local envelope=self.adapter.parse(text)\n assert(type(envelope)==\"table\" and envelope.format==v.format and envelope.kind==v.kind\n  and envelope.schema==v.innerSchema and envelope.updatedAt==v.updatedAt and envelope.backup==nil,\n  \"compressed rest header does not match its contents\")\n return envelope\nend\nlocal function corruptCore(v: any): any\n return {format=v.format,kind=v.kind,schema=if whole(v.innerSchema) then v.innerSchema else 1,\n  updatedAt=if finite(v.updatedAt) then v.updatedAt else 0,checksum=\"\"}\nend\n-- Read paths can expose a good independent backup through a deliberately corrupt current envelope.\n-- Write callbacks use the strict default: a corrupt current core must never reach a transform.\nfunction RestCompression.decode(self: any,v: any,recoverBackup: boolean?): any\n if type(v)~=\"table\" or v.encoding~=RestCompression.ENCODING then return v end\n if future(v) or future(v.backup) then return v end\n local backup=v.backup\n local validBackup=type(backup)==\"table\" and backup.backup==nil\n  and backup.format==v.format and backup.kind==v.kind\n local currentBytes=if type(v.data)==\"string\" then #v.data else 0\n local backupBytes=if validBackup and type(backup.data)==\"string\" then #backup.data else 0\n local withinBudget=currentBytes+backupBytes+RestCompression.HEADER_RESERVE<=RestCompression.MAX_STORED_CHARS\n if not withinBudget and not recoverBackup then error(\"compressed rest and backup exceed storage limit\",0) end\n local ok=false\n local envelope: any=\"compressed rest and backup exceed storage limit\"\n if withinBudget then ok,envelope=pcall(unpackCore,self,v) end\n if not ok then\n  if not recoverBackup then error(envelope,0) end\n  envelope=corruptCore(v)\n end\n if backup~=nil then\n  local good,decoded=false,nil\n  if validBackup and backupBytes+RestCompression.HEADER_RESERVE<=RestCompression.MAX_STORED_CHARS then good,decoded=pcall(unpackCore,self,backup) end\n  if not good then decoded=corruptCore(if type(backup)==\"table\" then backup else v) end\n  local restoredBackup=coreEnvelope(decoded)\n  restoredBackup.format,restoredBackup.kind=nil,nil\n  envelope.backup=restoredBackup\n end\n return envelope\nend\nfunction RestCompression.engine(): any\n local encoding=game:GetService(\"EncodingService\")\n local http=game:GetService(\"HttpService\")\n return RestCompression.new({\n  -- Native transport serialization is faster; canonical checksums remain inside both cores.\n  serialize=function(v: any): (string?,string?) return http:JSONEncode(v),nil end,\n  compress=function(text: string): string\n   return buffer.tostring(encoding:Base64Encode(encoding:CompressBuffer(buffer.fromstring(text),Enum.CompressionAlgorithm.Zstd,3)))\n  end,\n  expandedSize=function(data: string): number?\n   return encoding:GetDecompressedBufferSize(encoding:Base64Decode(buffer.fromstring(data)),Enum.CompressionAlgorithm.Zstd)\n  end,\n  decompress=function(data: string): string\n   return buffer.tostring(encoding:DecompressBuffer(encoding:Base64Decode(buffer.fromstring(data)),Enum.CompressionAlgorithm.Zstd))\n  end,\n  parse=function(text: string): any return http:JSONDecode(text) end,\n })\nend\nreturn RestCompression\n"},{"Server/DataStoreBackend","--!strict\n-- Roblox DataStore adapter (read and update, neither raises). An optional storage codec handles only R_ rest keys;\n-- transforms always see the original envelope. Failed decoding/compression never replaces an earlier stored value.\n-- Store and codec are injected for boundary tests; only the server owns real DataStore access.\nlocal DataStoreBackend = {}\nDataStoreBackend.__index = DataStoreBackend\n\nfunction DataStoreBackend.new(dataStore: any, restCodec: any?): any\n\treturn setmetatable({ ds = dataStore, restCodec = restCodec }, DataStoreBackend)\nend\n\nlocal function restKey(key: string): boolean return string.sub(ke