          <string name="Name">Movement</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">InputState</string>
            <string name="Source"><![CDATA[--!strict
-- Pure input state: test without Studio. +Y is forward on the control pad.
local InputState = {}
InputState.__index = InputState
function InputState.new()
	return setmetatable({ held = {} :: {[string]: boolean}, x = 0, y = 0 }, InputState)
end
function InputState.set(self, action: string, down: boolean)
	self.held[action] = down
end
function InputState.stick(self, x: number, y: number)
	local length = math.sqrt(x*x + y*y)
	local strength = math.clamp((length - 0.2) / 0.8, 0, 1)
	self.x = if length > 0 then x / length * strength else 0
	self.y = if length > 0 then y / length * strength else 0
end
function InputState.axes(self): (number, number)
	local x = self.x + (if self.held.Right then 1 else 0) - (if self.held.Left then 1 else 0)
	local y = self.y + (if self.held.Forward then 1 else 0) - (if self.held.Back then 1 else 0)
	local length = math.max(1, math.sqrt(x*x + y*y))
	return x / length, y / length
end
function InputState.clear(self)
	table.clear(self.held)
	self.x, self.y = 0, 0
end
return InputState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">JumpMath</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/movement/jump_math.gd (spec 6.3, 27). Pure math, no Instances, so it runs in tests/run.luau too.
--
-- The motor flies a committed jump with semi-implicit Euler at a fixed 60 Hz tick:
--   v = v + g * dt, then p = p + v * dt.
-- After n ticks from launch velocity v0 at p0 that gives, exactly,
--   p_n = p0 + n * dt * v0 + g * dt^2 * n * (n + 1) / 2
-- so the launch velocity is solved in this discrete form, not with the continuous 0.5 * g * T^2.

local JumpMath = {}

-- Matches SurfaceProfile.STAND_MAX_DEG.
JumpMath.STAND_MAX_DEG = 45.0
JumpMath.MIN_LAUNCH_NORMAL_SPEED = 0.05
JumpMath.STAND_APPROACH_MIN = 0.05
JumpMath.LAND_APPROACH_MIN = 0.3

local UP = Vector3.new(0, 1, 0)

local function finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

local function finiteVec(v: Vector3): boolean
	return finite(v.X) and finite(v.Y) and finite(v.Z)
end

export type Solution = {
	steps: number,
	duration: number,
	velocity: Vector3,
	speed: number,
	arrivalVelocity: Vector3,
	approach: number,
}

export type SolveResult = {
	valid: { Solution },
	reason: string, -- "ok", "no_durations", "too_far", "no_launch", "no_arrival"
	minSpeed: number,
}

-- Tick counts n whose duration n * dt lies inside [tMin, tMax]. nMax < nMin when none fits.
function JumpMath.stepRange(tMin: number, tMax: number, dt: number): (number, number)
	if not (finite(tMin) and finite(tMax) and finite(dt)) or dt <= 0 then
		return 1, 0
	end
	local nMin = math.ceil(tMin / dt - 1e-6)
	local nMax = math.floor(tMax / dt + 1e-6)
	return math.max(nMin, 1), nMax
end

function JumpMath.positionAfter(p0: Vector3, v0: Vector3, g: Vector3, dt: number, n: number): Vector3
	return p0 + v0 * (n * dt) + g * (dt * dt * n * (n + 1) * 0.5)
end

function JumpMath.velocityAfter(v0: Vector3, g: Vector3, dt: number, n: number): Vector3
	return v0 + g * (dt * n)
end

function JumpMath.launchVelocity(p0: Vector3, seat: Vector3, g: Vector3, dt: number, n: number): Vector3
	return (seat - p0 - g * (dt * dt * n * (n + 1) * 0.5)) / (n * dt)
end

-- Body-centre positions p_0 .. p_steps by repeated ticks, in the order the motor does them.
function JumpMath.path(p0: Vector3, v0: Vector3, g: Vector3, dt: number, steps: number): { Vector3 }
	local out = { p0 }
	local v, p = v0, p0
	for _ = 1, steps do
		v += g * dt
		p += v * dt
		table.insert(out, p)
	end
	return out
end

function JumpMath.isStanding(normal: Vector3): boolean
	if not finiteVec(normal) or normal:Dot(normal) < 1e-10 then
		return false
	end
	return normal.Unit:Dot(UP) >= math.cos(math.rad(JumpMath.STAND_MAX_DEG)) - 1e-6
end

function JumpMath.minApproach(targetNormal: Vector3): number
	return if JumpMath.isStanding(targetNormal) then JumpMath.STAND_APPROACH_MIN else JumpMath.LAND_APPROACH_MIN
end

-- Every launch solution for a landing seat, one per allowed whole-tick duration, filtered by the launch speed limit,
-- by leaving the launch surface and by arriving into the target fast enough. Sorted by speed, lowest first.
function JumpMath.solve(
	p0: Vector3,
	seat: Vector3,
	launchNormal: Vector3,
	targetNormal: Vector3,
	g: Vector3,
	dt: number,
	tMin: number,
	tMax: number,
	maxSpeed: number
): SolveResult
	local valid: { Solution } = {}
	local nMin, nMax = JumpMath.stepRange(tMin, tMax, dt)
	local minSpeed = math.huge
	local anySpeedOk, anyLaunchOk = false, false
	local need = JumpMath.minApproach(targetNormal)
	for n = nMin, nMax do
		local v0 = JumpMath.launchVelocity(p0, seat, g, dt, n)
		if finiteVec(v0) then
			local speed = v0.Magnitude
			minSpeed = math.min(minSpeed, speed)
			if speed <= maxSpeed then
				anySpeedOk = true
				if v0:Dot(launchNormal) >= JumpMath.MIN_LAUNCH_NORMAL_SPEED then
					anyLaunchOk = true
					local arrival = JumpMath.velocityAfter(v0, g, dt, n)
					local approach = -arrival:Dot(targetNormal)
					if approach >= need then
						table.insert(valid, {
							steps = n,
							duration = n * dt,
							velocity = v0,
							speed = speed,
							arrivalVelocity = arrival,
							approach = approach,
						})
					end
				end
			end
		end
	end
	table.sort(valid, function(a: Solution, b: Solution): boolean
		if math.abs(a.speed - b.speed) > 1e-9 then
			return a.speed < b.speed
		end
		return a.steps < b.steps
	end)
	local reason = "ok"
	if #valid == 0 then
		if nMax < nMin then
			reason = "no_durations"
		elseif not anySpeedOk then
			reason = "too_far"
		elseif not anyLaunchOk then
			reason = "no_launch"
		else
			reason = "no_arrival"
		end
	end
	return { valid = valid, reason = reason, minSpeed = minSpeed }
end

return JumpMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">SupportMath</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/movement/support_math.gd (spec 6.1, 6.2). Pure geometry for supported locomotion; unit vectors in world space.

local SupportMath = {}

local RIGHT = Vector3.new(1, 0, 0)
local BACK = Vector3.new(0, 0, 1)

local function angleTo(a: Vector3, b: Vector3): number
	return math.atan2(a:Cross(b).Magnitude, a:Dot(b))
end
SupportMath.angleTo = angleTo

-- The part of v that lies in the plane with unit normal n.
function SupportMath.tangent(v: Vector3, n: Vector3): Vector3
	return v - n * v:Dot(n)
end

-- Unit direction of v on the plane with normal n, or zero when v is (nearly) along n.
function SupportMath.tangentDir(v: Vector3, n: Vector3, eps: number?): Vector3
	local t = SupportMath.tangent(v, n)
	local length = t.Magnitude
	return if length > (eps or 1e-5) then t / length else Vector3.zero
end

-- Hysteresis for the support normal: a candidate within ignoreDeg of the current one is ignored.
function SupportMath.filterNormal(current: Vector3, candidate: Vector3, ignoreDeg: number): Vector3
	if candidate:Dot(candidate) < 1e-10 or candidate.Magnitude ~= candidate.Magnitude then
		return current
	end
	local c = candidate.Unit
	if current:Dot(current) < 1e-10 then
		return c
	end
	if angleTo(current.Unit, c) <= math.rad(ignoreDeg) then
		return current
	end
	return c
end

function SupportMath.anyPerpendicular(v: Vector3): Vector3
	local other = if math.abs(v.Unit.X) < 0.9 then RIGHT else BACK
	return v:Cross(other).Unit
end

-- Turns unit vector `from` toward `to` by at most maxAngle radians (shortest arc).
function SupportMath.rotateToward(from: Vector3, to: Vector3, maxAngle: number): Vector3
	local angle = angleTo(from, to)
	if angle <= maxAngle or angle < 1e-6 then
		return to
	end
	local axis = from:Cross(to)
	if axis:Dot(axis) < 1e-12 then
		axis = SupportMath.anyPerpendicular(from)
	end
	return (CFrame.fromAxisAngle(axis.Unit, maxAngle) * from).Unit
end

-- Signed angle from a to b about axis n.
function SupportMath.signedAngle(a: Vector3, b: Vector3, n: Vector3): number
	return math.atan2(n:Dot(a:Cross(b)), a:Dot(b))
end

-- Body frame for an up vector and a heading: Y is up, -Z (LookVector) is the heading made perpendicular to up.
function SupportMath.bodyCFrame(position: Vector3, up: Vector3, heading: Vector3): CFrame
	local u = up.Unit
	local f = SupportMath.tangentDir(heading, u)
	if f == Vector3.zero then
		f = SupportMath.anyPerpendicular(u)
	end
	local z = -f
	local x = u:Cross(z).Unit
	return CFrame.fromMatrix(position, x, u, z)
end

return SupportMath
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Rig</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">SpiderRig</string>
            <string name="Source"><![CDATA[--!strict
-- The drawn spider for Roblox: a port of scripts/presentation/spider_body.gd and surface_legs.gd (VISUAL-01 look).
-- Every part is anchored, non-colliding and non-queryable, and is placed each frame with one Workspace:BulkMoveTo call.
-- Display only: the controller owns the body's CFrame; nothing here feeds back into movement.
-- Body frame: +Y support-up, -Z forward, about 1 stud long (1 Godot WU = 1 cm = 1 stud).

local Workspace = game:GetService("Workspace")
local Appearances = require(script.Parent.Parent.Data.Appearances)

local SpiderRig = {}
SpiderRig.__index = SpiderRig

export type GaitMode = "Tetrapod" | "Unilateral"

local HIP_Z = { -0.36, -0.24, -0.12, 0.0 }
local TIP_Z = { -0.82, -0.52, 0.12, 0.62 }
-- Stout front legs, slimmer back legs: { femur, tibia } diameters per pair.
local LEG_D = { { 0.078, 0.064 }, { 0.065, 0.053 }, { 0.057, 0.045 }, { 0.059, 0.047 } }
local STEP_ERROR = 0.24
local SWING_SECONDS = 0.10
local STEP_HEIGHT = 0.12
local ANKLE_SHARE = 0.62
local ANKLE_LIFT = 0.045
local PALP_DRUM_HZ = 3.2
local PALP_DRUM_DEG = 11


type Leg = {
	side: number,
	pair: number,
	planted: Vector3?,
	swing: number, -- < 0 planted, 0..1 swinging
	from: Vector3,
	to: Vector3,
	up: Vector3,
	foot: Vector3,
	femur: Part,
	tibia: Part,
	tarsus: Part,
	knee: Part,
	ankle: Part,
	bands: {Part},
}

type Fixed = { part: Part, offset: CFrame, palp: number? }

export type Rig = typeof(setmetatable(
	{} :: {
		model: Model,
		root: Part,
		gaitMode: GaitMode,
		reducedMotion: boolean,
		_fixed: { Fixed },
		_legs: { Leg },
		_group: number,
		_t: number,
		_drum: number,
		_spots: { Part },
	_appearance: any,
		_params: RaycastParams,
		_parts: { BasePart },
		_cframes: { CFrame },
	},
	SpiderRig
))

local function newPart(model: Model, name: string, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = Vector3.new(0.1, 0.1, 0.1)
	p.Parent = model
	return p
end

local function ellipsoid(model: Model, name: string, radii: Vector3, color: Color3, material: Enum.Material): Part
	local p = newPart(model, name, color, material)
	p.Size = radii * 2
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function rod(model: Model, name: string, d: number, color: Color3): Part
	local p = newPart(model, name, color, Enum.Material.SmoothPlastic)
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(1, d, d)
	return p
end

local function ball(model: Model, name: string, d: number, color: Color3): Part
	local p = newPart(model, name, color, Enum.Material.SmoothPlastic)
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(d, d, d)
	p.CastShadow = false
	return p
end

-- A cylinder's axis is its local X: aim it from a to b.
local function rodCFrame(a: Vector3, b: Vector3): CFrame
	return CFrame.lookAt((a + b) * 0.5, b) * CFrame.Angles(0, math.pi / 2, 0)
end

function SpiderRig.new(parent: Instance, worldFolder: Instance, appearanceId: string?): Rig
	local look = Appearances.profiles[appearanceId or Appearances.default]
	assert(look, "Unknown spider appearance")
	local function color(rgb): Color3 return Color3.new(rgb[1], rgb[2], rgb[3]) end
	local BODY, LEG = color(look.body), color(look.legs)
	local JOINT, EYE, FANG = color(look.white), color(look.eyes), color(look.fangs)
	local WHITE = color(look.white)
	local model = Instance.new("Model")
	model.Name = "Spider"
	model:SetAttribute("AppearanceId", look.id)
	local root = newPart(model, "Root", BODY, Enum.Material.SmoothPlastic)
	root.Size = Vector3.new(1, 0.5, 1)
	root.Transparency = 1
	root.CastShadow = false
	model.PrimaryPart = root

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { worldFolder }

	local self = setmetatable({
		model = model,
		root = root,
		gaitMode = "Tetrapod" :: GaitMode,
		reducedMotion = false,
		_fixed = {} :: { Fixed },
		_legs = {} :: { Leg },
		_group = 0,
		_t = 0,
		_drum = 0,
		_spots = {} :: { Part },
		_appearance = look,
		_params = params,
		_parts = {} :: { BasePart },
		_cframes = {} :: { CFrame },
	}, SpiderRig)

	local function fixed(part: Part, at: Vector3, rot: CFrame?, palp: number?)
		table.insert(self._fixed, { part = part, offset = CFrame.new(at) * (rot or CFrame.identity), palp = palp })
	end
	local fabric = Enum.Material.SmoothPlastic -- clean high-contrast silhouette
	fixed(ellipsoid(model, "Cephalothorax", Vector3.new(table.unpack(look.headRadii)), BODY, fabric), Vector3.new(0, 0.02, -0.20))
	fixed(ellipsoid(model, "EyeFace", Vector3.new(0.205, 0.165, 0.125), BODY, fabric), Vector3.new(0, 0.055, -0.355))
	fixed(ellipsoid(model, "Pedicel", Vector3.new(0.05, 0.05, 0.06), BODY, fabric), Vector3.new(0, -0.035, -0.06))
	fixed(ellipsoid(model, "Abdomen", Vector3.new(table.unpack(look.abdomenRadii)), BODY, fabric), Vector3.new(0, 0.04, 0.20))
	local ar = look.abdomenRadii
	local function marking(name: string, x: number, z: number, rx: number, rz: number, angle: number)
		local y = ar[2] * math.sqrt(math.max(0, 1 - x*x - z*z))
		local spot = ellipsoid(model, name, Vector3.new(rx, 0.012, rz), WHITE, fabric)
		fixed(spot, Vector3.new(x * ar[1], 0.047 + y, 0.20 + z * ar[3]), CFrame.Angles(0, angle, 0))
		table.insert(self._spots, spot)
	end
	-- A curved pale band across the front of the abdomen.
	for i = -4, 4 do
		marking("FrontBand", i * 0.16, -0.66, 0.031, 0.018, 0)
	end
	for _, spot in look.spots do
		marking("AbdomenSpot", spot.x, spot.z, spot.rx, spot.rz, spot.angle)
	end
	-- Fixed deterministic stippling: no per-frame RNG or extra updates.
	for i = 1, look.speckleCount do
		local angle = i * 2.399963229728653
		local radius = 0.40 + (i % 5) * 0.10
		marking("Speckle", math.cos(angle) * radius, math.sin(angle) * radius, 0.0035, 0.005, angle)
	end
	for _, side in { -1, 1 } do
		fixed(ellipsoid(model, "PaleCheek", Vector3.new(0.018, 0.066, 0.105), WHITE, fabric), Vector3.new(side * 0.235, 0.055, -0.23))
		local ame = Vector3.new(side * 0.075, 0.09, -0.455)
		local eye = ellipsoid(model, "PrincipalEye", Vector3.new(0.080, 0.080, 0.063), EYE, Enum.Material.Glass)
		eye.Reflectance = 0.35
		fixed(eye, ame)
		local glint = ellipsoid(model, "Catchlight", Vector3.new(0.013, 0.013, 0.006), Color3.new(1, 1, 1), Enum.Material.Neon)
		glint.CastShadow = false
		fixed(glint, ame + Vector3.new(side * -0.018, 0.03, -0.052))
		local secondary: { { at: Vector3, r: number } } = {
			{ at = Vector3.new(side * 0.165, 0.10, -0.40), r = 0.042 }, -- anterior lateral
			{ at = Vector3.new(side * 0.13, 0.17, -0.14), r = 0.048 }, -- posterior lateral
			{ at = Vector3.new(side * 0.11, 0.185, -0.27), r = 0.018 }, -- posterior median
		}
		for _, e in secondary do
			local small = ellipsoid(model, "Eye", Vector3.one * e.r, EYE, Enum.Material.Glass)
			small.Reflectance = 0.3
			fixed(small, e.at)
		end
		local fang = ellipsoid(model, "Chelicera", Vector3.new(0.045, 0.08, 0.04), FANG, Enum.Material.Foil)
		fang.Reflectance = 0.15
		fixed(fang, Vector3.new(side * 0.052, -0.075, -0.445), CFrame.Angles(-0.35, 0, side * 0.12))
		-- Pedipalp: stalk and pale-tipped club, rotating about a pivot at its base.
		local palpIndex = if side < 0 then 1 else 2
		local base = Vector3.new(side * 0.10, -0.035, -0.43)
		local tip = base + Vector3.new(side * 0.03, -0.10, -0.09)
		local stalk = rod(model, "PalpStalk", 0.042, LEG)
		stalk.Size = Vector3.new((tip-base).Magnitude, 0.042, 0.042)
		fixed(stalk, Vector3.zero, CFrame.new(base):Inverse() * rodCFrame(base, tip), palpIndex)
		local ring = rod(model, "PalpBand", 0.044, WHITE)
		ring.Size = Vector3.new((tip-base).Magnitude * look.bandFraction, 0.044, 0.044)
		fixed(ring, Vector3.zero, CFrame.new(base):Inverse() * rodCFrame(base, tip), palpIndex)
		fixed(ellipsoid(model, "PalpClub", Vector3.new(0.03, 0.03, 0.045), LEG, fabric), tip + Vector3.new(0, -0.005, -0.02) - base, nil, palpIndex)
		fixed(ellipsoid(model, "PalpTip", Vector3.new(0.022, 0.018, 0.022), JOINT, fabric), tip + Vector3.new(0, 0.006, -0.045) - base, nil, palpIndex)
	end
	for i = 1, 8 do
		local side = if i <= 4 then -1 else 1
		local pair = (i - 1) % 4 + 1
		local raw = LEG_D[pair]
		local factor = if pair == 1 then look.frontLegScale else 1
		local d = {raw[1] * factor, raw[2] * factor}
		table.insert(self._legs, {
			side = side,
			pair = pair,
			planted = nil :: Vector3?,
			swing = -1,
			from = Vector3.zero,
			to = Vector3.zero,
			up = Vector3.yAxis,
			foot = Vector3.zero,
			femur = rod(model, "Femur" .. i, d[1], LEG),
			tibia = rod(model, "Tibia" .. i, d[2], LEG),
			tarsus = rod(model, "Tarsus" .. i, d[2] * 0.6, LEG),
			knee = ball(model, "Knee" .. i, d[1] * 0.95, JOINT),
			ankle = ball(model, "Ankle" .. i, d[2] * 0.95, JOINT),
			bands = {rod(model, "FemurBand" .. i, d[1], WHITE), rod(model, "TibiaBand" .. i, d[2], WHITE), rod(model, "TarsusBand" .. i, d[2] * 0.6, WHITE)},
		})
	end
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1
	hl.OutlineColor = WHITE
	hl.OutlineTransparency = 0.82
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = model
	model.Parent = parent
	self:setGrowthStage(0)
	return self
end

-- The selected appearance stays black and white at every life stage.
-- Growth is a separate display scale when LIFE is ported; it must not recolor this design.
function SpiderRig.setGrowthStage(self: Rig, stage: number)
	self.model:SetAttribute("GrowthStage", math.clamp(stage, 0, 3))
end

local function legGroup(self: Rig, i: number): number
	if self.gaitMode == "Unilateral" then
		return if i <= 4 then 0 else 1
	end
	-- Godot's (i % 4 + i / 4) % 2 with 0-based i: L1 R2 L3 R4 against R1 L2 R3 L4.
	local j = i - 1
	return (j % 4 + j // 4) % 2
end

local function restLocal(leg: Leg): Vector3
	return Vector3.new(leg.side * 0.78, -0.30, TIP_Z[leg.pair])
end

-- Display-only foothold: retract toward the body at a narrow edge; never invents a platform.
local function target(self: Rig, body: CFrame, leg: Leg): RaycastResult?
	local up = body.UpVector
	local rest = restLocal(leg)
	for _, reach in { 1.0, 0.65, 0.35, 0.12 } do
		local point = body:PointToWorldSpace(Vector3.new(rest.X * reach, 0, rest.Z * reach))
		local hit = Workspace:Raycast(point + up * 0.35, -up * 1.0, self._params)
		if hit and hit.Normal:Dot(up) > 0.35 then
			return hit
		end
	end
	return nil
end

-- body: the drawn body's CFrame. grounded: standing on a surface. moving: walking speed > 0 (for palp drumming).
function SpiderRig.update(self: Rig, body: CFrame, dt: number, grounded: boolean, moving: boolean)
	self._t += dt
	local up = body.UpVector
	local parts, cframes = self._parts, self._cframes
	table.clear(parts)
	table.clear(cframes)
	local function put(p: BasePart, cf: CFrame)
		table.insert(parts, p)
		table.insert(cframes, cf)
	end
	put(self.root, body)

	-- Palps drum in bursts while the spider stands still.
	self._drum = math.clamp(self._drum + (if grounded and not moving and not self.reducedMotion then 3 else -3) * dt, 0, 1)
	local palpAngle = {}
	for k = 1, 2 do
		local burst = math.clamp((math.sin(self._t * 1.3 + 0.7 * k) - 0.55) / 0.3, 0, 1)
		local beat = math.max(0, math.sin(self._t * 2 * math.pi * PALP_DRUM_HZ + math.pi * k))
		palpAngle[k] = math.rad(PALP_DRUM_DEG) * self._drum * burst * beat
	end
	for _, f in self._fixed do
		if f.palp then
			local side = if f.palp == 1 then -1 else 1
			local pivot = CFrame.new(side * 0.10, -0.035, -0.43) * CFrame.Angles(palpAngle[f.palp], 0, 0)
			put(f.part, body * pivot * f.offset)
		else
			put(f.part, body * f.offset)
		end
	end

	-- Legs: planted feet stay put in the world; a leg too far from its rest spot steps, in alternating groups.
	local swinging = false
	for _, leg in self._legs do
		swinging = swinging or leg.swing >= 0
	end
	if grounded and not swinging then
		local worst = STEP_ERROR
		for i, leg in self._legs do
			if leg.planted then
				local err = (body:PointToWorldSpace(restLocal(leg)) - leg.planted :: Vector3).Magnitude
				if err > worst then
					worst = err
					self._group = legGroup(self, i)
				end
			end
		end
	end
	local started = false
	for i, leg in self._legs do
		local rest = body:PointToWorldSpace(restLocal(leg))
		if not grounded then
			leg.planted = nil
			leg.swing = -1
			leg.foot = body:PointToWorldSpace(Vector3.new(leg.side * 0.47, -0.12, TIP_Z[leg.pair] * 0.72))
		else
			if leg.planted == nil then
				local hit = target(self, body, leg)
				leg.planted = if hit then hit.Position else nil
				leg.foot = if hit then hit.Position else rest + up * 0.16
				leg.swing = -1
			end
			local anchor = leg.planted
			if anchor then
				if leg.swing >= 0 then
					leg.swing = math.min(1, leg.swing + dt / SWING_SECONDS)
					local s = leg.swing
					local smooth = s * s * (3 - 2 * s)
					leg.foot = leg.from:Lerp(anchor, smooth) + leg.up * math.sin(math.pi * s) * STEP_HEIGHT
					if leg.swing >= 1 then
						leg.swing = -1
						leg.foot = anchor
					end
				else
					leg.foot = anchor
					local err = (rest - anchor).Magnitude
					if err > STEP_ERROR and ((not swinging and legGroup(self, i) == self._group) or err > 0.60) then
						local hit = target(self, body, leg)
						if hit and (anchor - hit.Position).Magnitude > 0.12 then
							leg.from = anchor
							leg.planted = hit.Position
							leg.up = hit.Normal
							leg.swing = 0
							started = true
						end
					end
					if body:PointToObjectSpace(leg.foot).Magnitude > 1.4 then
						leg.planted = nil
						leg.foot = rest
					end
				end
			end
		end
	end
	if started then
		self._group = 1 - self._group
	end
	for _, leg in self._legs do
		local hip = body:PointToWorldSpace(Vector3.new(leg.side * 0.16, 0.02, HIP_Z[leg.pair]))
		local foot = leg.foot
		local knee = hip:Lerp(foot, 0.48) + up * (if grounded then 0.30 else 0.24)
		local ankle = knee:Lerp(foot, ANKLE_SHARE) + up * ANKLE_LIFT
		local function segment(p: Part, band: Part, a: Vector3, b: Vector3)
			local len = math.max((b - a).Magnitude, 0.01)
			if math.abs(p.Size.X - len) > 1e-3 then
				p.Size = Vector3.new(len, p.Size.Y, p.Size.Z)
			end
			put(p, rodCFrame(a, b))
			band.Size = Vector3.new(len * self._appearance.bandFraction, p.Size.Y * 1.035, p.Size.Z * 1.035)
			put(band, rodCFrame(a, b))
		end
		segment(leg.femur, leg.bands[1], hip, knee)
		segment(leg.tibia, leg.bands[2], knee, ankle)
		segment(leg.tarsus, leg.bands[3], ankle, foot)
		put(leg.knee, CFrame.new(knee))
		put(leg.ankle, CFrame.new(ankle))
	end
	Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Where the dragline leaves the body.
function SpiderRig.spinneretPoint(_self: Rig, body: CFrame): Vector3
	return body:PointToWorldSpace(Vector3.new(0, 0.06, 0.48))
end

function SpiderRig.destroy(self: Rig)
	self.model:Destroy()
end

return SpiderRig
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="17">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Builds the windowsill (scripts/habitat/windowsill.gd) and the macro-lens lighting. The spider itself is client-side
-- (StarterPlayerScripts/Client/SpiderClient): one player, one spider, nothing to replicate yet.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared:WaitForChild("Habitat"):WaitForChild("WindowsillLayout"))
local Surfaces = require(Shared:WaitForChild("Data"):WaitForChild("Surfaces"))

Players.CharacterAutoLoads = false
Workspace.Gravity = 35 -- species gravity_wu_s2; used by any unanchored props

local MATERIAL: { [string]: Enum.Material } = {
	painted_wood_dry = Enum.Material.Wood,
	bare_wood_rough = Enum.Material.WoodPlanks,
	brick_rough = Enum.Material.Brick,
	leaf_dry_prototype = Enum.Material.SmoothPlastic,
}

local sill = Instance.new("Folder")
sill.Name = "Windowsill"
sill:SetAttribute("ContentRevision", Layout.CONTENT_REVISION)

for _, piece in Layout.PIECES do
	assert(Surfaces[piece.profile], "unknown surface profile " .. piece.profile)
	local p = Instance.new("Part")
	p.Name = piece.id
	p.Anchored = true
	p.Size = piece.hi - piece.lo
	p.Position = (piece.lo + piece.hi) * 0.5
	p.Color = piece.color
	p.Material = MATERIAL[piece.profile] or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p:SetAttribute("SurfaceId", piece.id)
	p:SetAttribute("ProfileId", piece.profile)
	p.Parent = sill
end

local decorFolder = Instance.new("Folder")
decorFolder.Name = "Decor"
for _, d in Layout.DECOR do
	local p = Instance.new("Part")
	p.Name = d.id
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false -- drawn only: the spider's rays never see it
	p.CanTouch = false
	p.Size = d.size
	p.Position = d.at
	p.Color = d.color
	p.Material = if d.id == "window_glass" then Enum.Material.Glass elseif d.id == "soil" then Enum.Material.Ground else Enum.Material.SmoothPlastic
	p.Transparency = d.transparency or 0
	p.CastShadow = d.id ~= "window_glass"
	p.Parent = decorFolder
end

-- Dust motes drifting in the window light (drawn only).
local dust = Instance.new("Part")
dust.Name = "DustVolume"
dust.Anchored = true
dust.CanCollide = false
dust.CanQuery = false
dust.CanTouch = false
dust.Transparency = 1
dust.Size = Vector3.new(56, 11, 22)
dust.Position = Vector3.new(0, 6.1, -1)
local motes = Instance.new("ParticleEmitter")
motes.Texture = "rbxasset://textures/particles/smoke_main.dds"
motes.Rate = 5
motes.Lifetime = NumberRange.new(14, 18)
motes.Speed = NumberRange.new(0.05, 0.2)
motes.SpreadAngle = Vector2.new(180, 180)
motes.Size = NumberSequence.new(0.05)
motes.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.2, 0.55),
	NumberSequenceKeypoint.new(0.8, 0.55),
	NumberSequenceKeypoint.new(1, 1),
})
motes.LightEmission = 0.6
motes.LightInfluence = 0.4
motes.Color = ColorSequence.new(Color3.fromRGB(255, 238, 205))
motes.Drag = 0.5
motes.Acceleration = Vector3.new(0, 0.01, 0)
motes.Shape = Enum.ParticleEmitterShape.Box
motes.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
motes.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
motes.Parent = dust
dust.Parent = decorFolder

decorFolder.Parent = Workspace
sill.Parent = Workspace

-- Macro-lens lighting: morning sun through the window, soft shadows, warm grade, a shallow depth of field
-- (the client keeps the focus on the spider).
-- Technology is authored in the Rojo place; runtime scripts cannot set it.
Lighting.ClockTime = 9.6
Lighting.GeographicLatitude = 40.7
Lighting.Brightness = 2.6
Lighting.Ambient = Color3.fromRGB(70, 66, 58)
Lighting.OutdoorAmbient = Color3.fromRGB(150, 146, 132)
Lighting.EnvironmentDiffuseScale = 1
Lighting.EnvironmentSpecularScale = 1
Lighting.ShadowSoftness = 0.12
Lighting.ExposureCompensation = 0.1

local function effect(className: string, name: string): Instance
	local e = Lighting:FindFirstChild(name) or Instance.new(className)
	e.Name = name
	e.Parent = Lighting
	return e
end
local cc = effect("ColorCorrectionEffect", "Grade") :: ColorCorrectionEffect
cc.Contrast = 0.06
cc.Saturation = 0.04
cc.TintColor = Color3.fromRGB(255, 248, 236)
local bloom = effect("BloomEffect", "Bloom") :: BloomEffect
bloom.Intensity = 0.3
bloom.Size = 18
bloom.Threshold = 1.6
local rays = effect("SunRaysEffect", "SunRays") :: SunRaysEffect
rays.Intensity = 0.06
rays.Spread = 0.7
local dof = effect("DepthOfFieldEffect", "MacroDOF") :: DepthOfFieldEffect
dof.FarIntensity = 0.55
dof.NearIntensity = 0.35
dof.FocusDistance = 6
dof.InFocusRadius = 3.5
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="19">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="20">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="22">
          <Properties>
            <string name="Name">SpiderClient</string>
            <string name="Source"><![CDATA[--!strict
-- The playable spider: a client-side, kinematic port of the Godot motor's core (scripts/movement/spider_motor.gd,
-- jump_controller.gd). It walks on any attachable surface (floor, walls, undersides, over edges), aims and flies jumps
-- solved by the shared JumpMath at a fixed 60 Hz tick, trails a dragline, and drives the procedural SpiderRig.
--
-- Controls: WASD walk (camera-relative), Shift creep, tap Space hop, hold Space to aim at the screen centre and release
-- to leap, G toggles the gait (alternating tetrapod / one side at a time), R respawns. Right mouse drag orbits, wheel zooms.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local SpiderInput = require(script.Parent.SpiderInput)
local controls: any = nil

local Shared = ReplicatedStorage:WaitForChild("Shared")
local JumpMath = require(Shared:WaitForChild("Movement"):WaitForChild("JumpMath"))
local SupportMath = require(Shared:WaitForChild("Movement"):WaitForChild("SupportMath"))
local Species = require(Shared:WaitForChild("Data"):WaitForChild("Species"))
local Surfaces = require(Shared:WaitForChild("Data"):WaitForChild("Surfaces"))
local Layout = require(Shared:WaitForChild("Habitat"):WaitForChild("WindowsillLayout"))
local SpiderRig = require(Shared:WaitForChild("Rig"):WaitForChild("SpiderRig"))

local profile = Species.phidippus_audax_prototype
local LOCO = profile.locomotion
local DT = 1 / 60
local G = Vector3.new(0, -LOCO.gravity_wu_s2, 0)
local HEIGHT = 0.31 -- body centre above the support plane (Godot spawn height)
local TURN_RATE = math.rad(540)
local AIM_HOLD_S = 0.18
local AIM_RANGE = 40
local HOP_DISTANCE = 1.6
local MAX_DRAGLINES = 12

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local sill = Workspace:WaitForChild("Windowsill")

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include
params.FilterDescendantsInstances = { sill }

local rig = SpiderRig.new(Workspace, sill)

type Mode = "attached" | "air"
local state = {
	mode = "attached" :: Mode,
	pos = Layout.SPAWN + Vector3.new(0, HEIGHT, 0),
	up = Vector3.yAxis,
	heading = Layout.SPAWN_HEADING,
	vel = Vector3.zero,
	drawnUp = Vector3.yAxis,
	moving = false,
	spaceDown = false,
	spaceTime = 0,
	aiming = false,
	plan = nil :: any,
	planFrom = Vector3.zero,
	lineAnchor = nil :: Vector3?,
}

local function profileOf(hit: RaycastResult): any
	local id = hit.Instance:GetAttribute("ProfileId")
	return if typeof(id) == "string" then Surfaces[id] else nil
end

local function attachable(hit: RaycastResult?): boolean
	if not hit then
		return false
	end
	local p = profileOf(hit)
	return p ~= nil and p.attachable == true
end

-- The smallest rotation taking unit a onto unit b.
local function rotationBetween(a: Vector3, b: Vector3): CFrame
	local angle = SupportMath.angleTo(a, b)
	if angle < 1e-6 then
		return CFrame.identity
	end
	local axis = a:Cross(b)
	if axis:Dot(axis) < 1e-12 then
		axis = SupportMath.anyPerpendicular(a)
	end
	return CFrame.fromAxisAngle(axis.Unit, angle)
end

local function setSupport(hit: RaycastResult)
	local turn = rotationBetween(state.up, hit.Normal)
	state.heading = SupportMath.tangentDir(turn * state.heading, hit.Normal)
	if state.heading == Vector3.zero then
		state.heading = SupportMath.anyPerpendicular(hit.Normal)
	end
	state.up = hit.Normal
	state.pos = hit.Position + hit.Normal * HEIGHT
end

local function respawn()
	state.mode = "attached"
	state.pos = Layout.SPAWN + Vector3.new(0, HEIGHT, 0)
	state.up = Vector3.yAxis
	state.heading = Layout.SPAWN_HEADING
	state.vel = Vector3.zero
	state.aiming = false
	state.plan = nil
	state.lineAnchor = nil
end

-- ---------------------------------------------------------------- dragline (drawn only)
local lines = Instance.new("Folder")
lines.Name = "Draglines"
lines.Parent = Workspace
local liveLine: Part? = nil

local function strand(a: Vector3, b: Vector3, p: Part)
	local len = math.max((b - a).Magnitude, 0.01)
	p.Size = Vector3.new(0.012, 0.012, len)
	p.CFrame = CFrame.lookAt((a + b) * 0.5, b)
end

local function newStrand(): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(236, 232, 214)
	p.Transparency = 0.35
	p.Parent = lines
	local kids = lines:GetChildren()
	if #kids > MAX_DRAGLINES then
		kids[1]:Destroy()
	end
	return p
end

-- ---------------------------------------------------------------- jump preview
local arc = Instance.new("Folder")
arc.Name = "JumpArc"
arc.Parent = Workspace
local dots: { Part } = {}
for i = 1, 28 do
	local d = Instance.new("Part")
	d.Name = "Dot" .. i
	d.Shape = Enum.PartType.Ball
	d.Size = Vector3.one * 0.07
	d.Anchored = true
	d.CanCollide = false
	d.CanQuery = false
	d.CanTouch = false
	d.CastShadow = false
	d.Material = Enum.Material.Neon
	d.Transparency = 1
	d.Parent = arc
	dots[i] = d
end
local patch = Instance.new("Part")
patch.Name = "LandingPatch"
patch.Shape = Enum.PartType.Cylinder
patch.Size = Vector3.new(0.02, 1.0, 1.0)
patch.Anchored = true
patch.CanCollide = false
patch.CanQuery = false
patch.CanTouch = false
patch.CastShadow = false
patch.Material = Enum.Material.Neon
patch.Transparency = 1
patch.Parent = arc

local function hidePreview()
	for _, d in dots do
		d.Transparency = 1
	end
	patch.Transparency = 1
end

local function aim()
	local vp = camera.ViewportSize
	local ray = camera:ViewportPointToRay(vp.X * 0.5, vp.Y * 0.5)
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * AIM_RANGE, params)
	state.plan = nil
	if not hit then
		hidePreview()
		return
	end
	local seat = hit.Position + hit.Normal * HEIGHT
	local ok = attachable(hit)
	local result = JumpMath.solve(state.pos, seat, state.up, hit.Normal, G, DT, LOCO.flight_time_min_s, LOCO.flight_time_max_s, LOCO.max_launch_speed_wu_s)
	local sol = if ok then result.valid[1] else nil
	local color = if sol then Color3.fromRGB(110, 230, 140) else Color3.fromRGB(235, 90, 70)
	patch.Color = color
	patch.Transparency = 0.45
	patch.CFrame = CFrame.lookAt(hit.Position + hit.Normal * 0.01, hit.Position + hit.Normal) * CFrame.Angles(0, math.pi / 2, 0)
	if sol then
		state.plan = sol
		state.planFrom = state.pos
		local pts = JumpMath.path(state.pos, sol.velocity, G, DT, sol.steps)
		for i, d in dots do
			local k = math.floor((i - 1) / (#dots - 1) * sol.steps) + 1
			d.Position = pts[k]
			d.Color = color
			d.Transparency = 0.2
		end
	else
		for _, d in dots do
			d.Transparency = 1
		end
	end
end

local function launch(velocity: Vector3)
	local floorHit = Workspace:Raycast(state.pos, -state.up * (HEIGHT + 0.1), params)
	local fromSurface = if floorHit then profileOf(floorHit) else nil
	state.lineAnchor = if fromSurface and fromSurface.silk_anchor_allowed then state.pos - state.up * HEIGHT else nil
	if state.lineAnchor then
		liveLine = newStrand()
	end
	state.vel = velocity
	state.mode = "air"
	hidePreview()
end

local function hop()
	local seatGuess = state.pos + state.heading * HOP_DISTANCE
	local hit = Workspace:Raycast(seatGuess + state.up * 0.6, -state.up * 1.5, params)
	if not attachable(hit) then
		return
	end
	local h = hit :: RaycastResult
	local seat = h.Position + h.Normal * HEIGHT
	local g = if JumpMath.isStanding(state.up) then G else -state.up * LOCO.gravity_wu_s2
	local result = JumpMath.solve(state.pos, seat, state.up, h.Normal, g, DT, LOCO.flight_time_min_s, LOCO.flight_time_max_s, LOCO.max_launch_speed_wu_s)
	if result.valid[1] and g == G then
		launch(result.valid[1].velocity)
	end
end

-- ---------------------------------------------------------------- the fixed tick
local function wish(): Vector3
	local r, f = controls:axes()
	if f == 0 and r == 0 then
		return Vector3.zero
	end
	local cf = camera.CFrame
	local dir = SupportMath.tangentDir(cf.LookVector * f + cf.RightVector * r, state.up)
	if dir == Vector3.zero then
		dir = SupportMath.tangentDir(cf.UpVector * f + cf.RightVector * r, state.up)
	end
	return dir
end

local function tickAttached()
	local dir = if state.aiming then Vector3.zero else wish()
	state.moving = dir ~= Vector3.zero
	if not state.moving then
		-- Re-seat on the support so a vanished or moved surface is noticed.
		local below = Workspace:Raycast(state.pos + state.up * 0.1, -state.up * (HEIGHT + 0.35), params)
		if not attachable(below) then
			state.mode = "air"
			state.vel = Vector3.zero
		end
		return
	end
	local stalk = controls.held.Creep == true
	local speed = if stalk then LOCO.stalk_speed_wu_s else LOCO.walk_speed_wu_s
	state.heading = SupportMath.tangentDir(SupportMath.rotateToward(state.heading, dir, TURN_RATE * DT), state.up)
	local step = dir * speed * DT
	-- Concave corner: a wall (or a leaf's edge, a stem) ahead becomes the new support.
	local ahead = Workspace:Raycast(state.pos, dir * (HEIGHT + step.Magnitude + 0.02), params)
	if ahead and attachable(ahead) and SupportMath.angleTo(ahead.Normal, state.up) > math.rad(20) then
		setSupport(ahead)
		return
	end
	local nextPos = state.pos + step
	local below = Workspace:Raycast(nextPos + state.up * 0.25, -state.up * (HEIGHT + 0.5), params)
	if below and attachable(below) and SupportMath.angleTo(below.Normal, state.up) < math.rad(60) then
		local n = SupportMath.filterNormal(state.up, below.Normal, 2.0)
		state.up = n
		state.pos = below.Position + n * HEIGHT
		state.heading = SupportMath.tangentDir(state.heading, n)
		return
	end
	-- Convex edge: wrap over it onto the face beyond (sill edge, leaf rim, the top of a wall).
	local around = Workspace:Raycast(nextPos - state.up * (HEIGHT + 0.15), -dir * 1.0, params)
	if around and attachable(around) then
		setSupport(around)
		return
	end
	state.mode = "air"
	state.vel = dir * speed
end

local function tickAir()
	local from = state.pos
	state.vel += G * DT
	local to = from + state.vel * DT
	local travel = to - from
	local dir = if travel.Magnitude > 1e-6 then travel.Unit else -state.up
	local hit = Workspace:Raycast(from, dir * (travel.Magnitude + HEIGHT), params)
	if hit then
		local approach = -state.vel:Dot(hit.Normal)
		if attachable(hit) and approach >= JumpMath.minApproach(hit.Normal) then
			local heading = SupportMath.tangentDir(state.vel, hit.Normal)
			setSupport(hit)
			if heading ~= Vector3.zero then
				state.heading = heading
			end
			state.vel = Vector3.zero
			state.mode = "attached"
			if liveLine and state.lineAnchor then
				strand(state.lineAnchor, rig:spinneretPoint(SupportMath.bodyCFrame(state.pos, state.up, state.heading)), liveLine)
			end
			liveLine = nil
			state.lineAnchor = nil
			return
		end
		-- Not landable here: slide along it.
		state.vel -= hit.Normal * math.min(0, state.vel:Dot(hit.Normal))
		to = hit.Position + hit.Normal * HEIGHT
	end
	state.pos = to
	-- The drawn body turns upright while falling.
	state.up = SupportMath.rotateToward(state.up, Vector3.yAxis, math.rad(240) * DT)
	local lo, hi = Layout.PLAY_BOUNDS_MIN, Layout.PLAY_BOUNDS_MAX
	if to.X < lo.X or to.Y < lo.Y or to.Z < lo.Z or to.X > hi.X or to.Y > hi.Y or to.Z > hi.Z then
		respawn()
	end
end

local function tick()
	if state.mode == "attached" then
		if state.spaceDown then
			state.spaceTime += DT
			if state.spaceTime >= AIM_HOLD_S then
				state.aiming = true
				aim()
			end
		end
		tickAttached()
	else
		tickAir()
	end
end

controls = SpiderInput.bind(function(phase: string)
	if phase == "begin" then
		state.spaceDown = true
		state.spaceTime = 0
		return
	end
	state.spaceDown = false
	if phase == "end" and state.mode == "attached" then
		if state.aiming then
			local plan = state.plan
			if plan and (state.pos - state.planFrom).Magnitude < 1e-3 then launch(plan.velocity) end
		else hop() end
	end
	state.aiming = false
	state.plan = nil
	hidePreview()
end, respawn, function()
	rig.gaitMode = if rig.gaitMode == "Tetrapod" then "Unilateral" else "Tetrapod"
end)

-- ---------------------------------------------------------------- camera
player.CameraMinZoomDistance = 1.5
player.CameraMaxZoomDistance = 30
camera.CameraType = Enum.CameraType.Custom
camera.CameraSubject = rig.root
camera.FieldOfView = 60

local accumulator = 0
RunService.RenderStepped:Connect(function(frameDt: number)
	accumulator = math.min(accumulator + frameDt, 0.25)
	while accumulator >= DT do
		accumulator -= DT
		tick()
	end
	-- Drawn frame: the up vector eases so walls and edges do not snap.
	state.drawnUp = state.drawnUp:Lerp(state.up, 1 - math.exp(-24 * frameDt)).Unit
	local body = SupportMath.bodyCFrame(state.pos, state.drawnUp, state.heading)
	rig:update(body, frameDt, state.mode == "attached", state.moving)
	if liveLine and state.lineAnchor then
		strand(state.lineAnchor, rig:spinneretPoint(body), liveLine)
	end
	local dof = Lighting:FindFirstChild("MacroDOF")
	if dof and dof:IsA("DepthOfFieldEffect") then
		dof.FocusDistance = (camera.CFrame.Position - state.pos).Magnitude
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">SpiderInput</string>
            <string name="Source"><![CDATA[--!strict
-- One action path for keyboard, gamepad and held on-screen touch buttons.
local CAS = game:GetService("ContextActionService")
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local InputState = require(game:GetService("ReplicatedStorage").Shared.Movement.InputState)
local SpiderInput = {}

function SpiderInput.bind(jump: (string) -> (), reset: () -> (), gait: () -> ())
	local state = InputState.new()
	local function act(action: string, phase: Enum.UserInputState)
		local down = phase == Enum.UserInputState.Begin
		if action == "Jump" then
			if down then jump("begin") elseif phase == Enum.UserInputState.End then jump("end") else jump("cancel") end
		elseif action == "Reset" then if down then reset() end
		elseif action == "Gait" then if down then gait() end
		else state:set(action, down) end
	end
	local bindings = {
		Forward = {Enum.KeyCode.W, Enum.KeyCode.DPadUp}, Back = {Enum.KeyCode.S, Enum.KeyCode.DPadDown},
		Left = {Enum.KeyCode.A, Enum.KeyCode.DPadLeft}, Right = {Enum.KeyCode.D, Enum.KeyCode.DPadRight},
		Jump = {Enum.KeyCode.Space, Enum.KeyCode.ButtonA}, Creep = {Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL1},
		Reset = {Enum.KeyCode.R, Enum.KeyCode.ButtonY}, Gait = {Enum.KeyCode.G},
	}
	for action, keys in bindings do
		CAS:BindActionAtPriority("Spider" .. action, function(_, phase)
			if UIS:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
			act(action, phase)
			return Enum.ContextActionResult.Sink
		end, false, 3000, table.unpack(keys))
	end
	CAS:BindActionAtPriority("SpiderStick", function(_, phase, input)
		if phase == Enum.UserInputState.Cancel or UIS:GetFocusedTextBox() then state:stick(0, 0)
		else state:stick(input.Position.X, input.Position.Y) end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Thumbstick1)
	local gui = Instance.new("ScreenGui")
	gui.Name = "SpiderTouch"
	gui.ResetOnSpawn = false
	gui.Enabled = UIS.TouchEnabled
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local active: {[InputObject]: string} = {}
	local function clear()
		state:clear()
		table.clear(active)
		jump("cancel")
	end
	local function button(action: string, label: string, position: UDim2, size: number)
		local b = Instance.new("TextButton")
		b.Name = action
		b.Text = label
		b.TextSize = 18
		b.TextColor3 = Color3.new(1, 1, 1)
		b.BackgroundColor3 = Color3.new(0.06, 0.06, 0.06)
		b.BackgroundTransparency = 0.15
		b.Size = UDim2.fromOffset(size, size)
		b.Position = position
		b.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 14)
		corner.Parent = b
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				active[input] = action
				act(action, Enum.UserInputState.Begin)
			end
		end)
	end
	button("Forward", "↑", UDim2.new(0, 78, 1, -188), 52)
	button("Left", "←", UDim2.new(0, 22, 1, -132), 52)
	button("Back", "↓", UDim2.new(0, 78, 1, -76), 52)
	button("Right", "→", UDim2.new(0, 134, 1, -132), 52)
	button("Jump", "Jump\n(hold)", UDim2.new(1, -92, 1, -102), 72)
	button("Creep", "Creep", UDim2.new(1, -86, 1, -172), 60)
	UIS.InputEnded:Connect(function(input)
		local action = active[input]
		if action then active[input] = nil; act(action, Enum.UserInputState.End) end
	end)
	UIS.WindowFocusReleased:Connect(clear)
	UIS.TextBoxFocused:Connect(clear)
	UIS.GamepadDisconnected:Connect(clear)
	UIS:GetPropertyChangedSignal("TouchEnabled"):Connect(function() gui.Enabled = UIS.TouchEnabled end)
	return state
end
return SpiderInput
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
