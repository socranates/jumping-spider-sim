      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">GraphicsSpec</string>
          <string name="Source"><![CDATA[--!strict
-- Real Roblox values: what the place holds once Main.server has built the world. Included only in tests.project.json and run
-- by Runner.server.luau in Studio (it needs the engine); the CLI cannot run it. It checks what an engine can check: that the
-- settings took, that materials and the sun are what the table asks for, that nothing drawn is solid or queryable. Whether it
-- LOOKS right (materials, haze, light shafts, the view out of the window) is for eyes in Studio: HANDOFF "Cuter spider and graphics".
return function(check)
	local Lighting = game:GetService("Lighting")
	local MaterialService = game:GetService("MaterialService")
	local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
	local Graphics = require(Shared.Data.Graphics)
	local Materials = require(Shared.Habitat.Materials)
	local sill = workspace:WaitForChild("Windowsill", 15) :: Folder
	local decor = workspace:WaitForChild("Decor", 15) :: Folder

	-- Protected Technology/Use2022Materials are checked by tools/build.py.
	check("every material name in the graphics table is a real Roblox material", function()
		for _, name in Materials.names() do
			assert(Enum.Material:FromName(name) ~= nil, "no Enum.Material." .. name)
		end
	end)
	check("sill pieces use the table's materials and the back wall is invisible but solid", function()
		for _, part in sill:GetChildren() do
			local want = Graphics.materials.pieces[part.Name]
			assert(want, "no material for " .. part.Name)
			assert((part :: BasePart).Material == Enum.Material:FromName(want), `{part.Name}: {tostring((part :: BasePart).Material)}`)
		end
		local back = sill:FindFirstChild(Graphics.window.hidden) :: BasePart
		assert(back.Transparency == 1 and back.CanCollide and back.CanQuery, "the back wall must stay solid and climbable")
		local hit = workspace:Raycast(Vector3.new(0, 8, 0), Vector3.new(0, 0, -30))
		assert(hit and hit.Instance == back and math.abs(hit.Position.Z + 12.5) < 1e-3, "a ray across the sill must land on the solid back wall")
	end)
	check("decor is drawn only: no collisions, no rays, no touches", function()
		local n = 0
		for _, d in decor:GetDescendants() do
			if d:IsA("BasePart") then
				n += 1
				assert(d.Anchored and not d.CanCollide and not d.CanQuery and not d.CanTouch, d:GetFullName())
			end
		end
		assert(n >= 70 and n <= 140, `decor has {n} parts`)
	end)
	check("the sun shines in through the window", function()
		local sun = Lighting:GetSunDirection()
		local status = tostring(Lighting:GetAttribute("SunPick"))
		assert(string.sub(status, 1, 3) == "ok:", "SunPick: " .. status)
		assert(sun.Z < -0.2 and sun.Y > 0.25, "sun direction " .. tostring(sun))
		assert(Graphics.window.hidden == "back_frame" and decor:FindFirstChild("Shafts") ~= nil, "no light shafts built")
	end)
	check("the wall casts shadows, the glass does not", function()
		local wall = decor:FindFirstChild("Wall") :: Folder
		assert((wall:FindFirstChild("Apron") :: BasePart).CastShadow and (wall:FindFirstChild("Mullion1") :: BasePart).CastShadow)
		local glass = wall:FindFirstChild("Glass") :: BasePart
		assert(not glass.CastShadow and glass.Transparency >= 0.6 and glass.Material == Enum.Material.Glass)
		assert(not (sill:FindFirstChild(Graphics.window.hidden) :: BasePart).CastShadow, "the invisible wall must not shade the room")
	end)
	check("atmosphere, sky, grade, bloom, sun rays and clouds are in place; no depth of field unless asked", function()
		for _, name in { "Atmosphere", "Sky", "Grade", "Bloom", "SunRays" } do assert(Lighting:FindFirstChild(name), "missing " .. name) end
		assert(workspace.Terrain:FindFirstChildOfClass("Clouds"), "missing clouds")
		assert((Lighting:FindFirstChild("MacroDOF") ~= nil) == (workspace:GetAttribute("DepthOfField") == true), "depth of field must be opt-in")
		local bloom = Lighting:FindFirstChild("Bloom") :: BloomEffect
		assert(bloom.Threshold >= 1.2 and bloom.Intensity <= 0.5, "bloom is not gentle")
	end)
	check("dust motes are emitting and the light shafts are faint", function()
		local motes = (decor:FindFirstChild("DustVolume") :: Instance):FindFirstChildOfClass("ParticleEmitter") :: ParticleEmitter
		assert(motes.Enabled and motes.Rate > 0)
		local beams = 0
		for _, d in decor:GetDescendants() do
			if d:IsA("Beam") then
				beams += 1
				assert(d.Transparency.Keypoints[1].Value >= 0.95, "a shaft is too strong")
			end
		end
		assert(beams == #Graphics.shafts.x * #Graphics.shafts.layers, `{beams} beams`)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">PerceptionSpec</string>
          <string name="Source"><![CDATA[--!strict
-- P01 F1-F8: real WORLD rays plus the actual memory-only view builder. Isolated from playable geometry.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sensor = require(Shared.Perception.Sensor)
local Memory = require(Shared.Perception.ObservationMemory)
local View = require(Shared.UI.PerceptionView)
local Species = require(Shared.Data.Species)
local Motor = require(Shared.Movement.SpiderMotor)
local Surfaces = require(Shared.Data.Surfaces)
return function(check: (string, () -> ()) -> ())
	local folder: Folder? = nil
	local memory: any; local sensor: any; local observer: any; local cast: any; local target: any
	local function rig()
		if folder then folder:Destroy() end
		folder = Instance.new("Folder"); folder.Name="P01World"; folder.Parent=workspace
		local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Include; params.FilterDescendantsInstances={folder :: Folder}
		cast=Sensor.workspaceCast(params)
		memory=Memory.new(); sensor=Sensor.new(memory); sensor:configureFrom(Species.phidippus_audax_prototype.perception)
		observer={eye=Vector3.new(0,100,0),gaze=-Vector3.zAxis,heading=-Vector3.zAxis,up=Vector3.yAxis}
		target={id="marker",position=Vector3.new(0,100,-8),radius=0.45,velocity=Vector3.zero,maxCategory="fly_like_prey"}
	end
	local function wall()
		local p=Instance.new("Part"); p.Size=Vector3.new(6,6,0.2); p.Position=Vector3.new(0,100,-4)
		p.Anchored=true; p.CanCollide=false; p.CanQuery=true; p.Parent=folder
		return p
	end
	local function run(n: number, present: boolean?)
		for _=1,n do sensor:step(1/60,observer,if present==false then {} else {target},cast) end
	end
	local function contact(): any return memory:getContact(sensor:trackIdFor(target.id)) end
	local adapter={
		project=function(p: Vector3, _: number) return Vector2.new(p.X,p.Z),true,12 end,
		edge=function(d: Vector3) return {pos=Vector2.new(d.X,d.Z),dir=Vector2.new(1,0)} end,
		covered=function(_: Vector3, _: number) return true end,
	}
	check("P01 F1 peripheral cue has bearing but no position or identity",function()
		rig(); target.position=Vector3.new(8,100,0); target.velocity=Vector3.xAxis*0.8; run(30)
		local c=contact(); assert(c and not c.hasPosition and c.category=="movement" and c.cueCount==1)
		local v=View.build(memory,adapter); assert(#v.edges==1 and #v.labels==0 and #v.rings==0)
	end)
	check("P01 F2 camera projection cannot rotate the sensor cone",function()
		rig(); target.position=Vector3.new(8,100,0); target.velocity=Vector3.xAxis; run(120)
		for _=1,30 do View.build(memory,adapter) end
		assert(not contact().hasPosition and sensor.core.inspectionsMade==0)
	end)
	check("P01 F3 Focus turns at capped rate and inspection refines in time",function()
		rig()
		local motor=Motor.new({world=folder,surfaces=Surfaces,profile=Species.phidippus_audax_prototype,spawn=Vector3.new(0,99.92,0),heading=Vector3.xAxis})
		-- Tick the same capped facing function used by the motor via its normal tick input.
		local floor=Instance.new("Part"); floor.Anchored=true; floor.Size=Vector3.new(30,1,30); floor.Position=Vector3.new(0,99.42,0); floor:SetAttribute("ProfileId","painted_wood_dry"); floor.Parent=folder
		motor:place(Vector3.new(0,99.92,0),Vector3.yAxis,Vector3.xAxis)
		local first, possible, fly = 0,0,0
		for tick=1,180 do
			observer=motor:observer(); sensor:step(1/60,observer,{target},cast)
			local c=contact()
			if c and c:isInspectedNow() then
				if first==0 then first=tick end
				if c.category=="possible_prey" and possible==0 then possible=tick end
				if c.category=="fly_like_prey" and fly==0 then fly=tick end
			end
			local old=motor.heading
			motor:tick({wish=Vector3.zero,focusPoint=target.position})
			assert(math.deg(math.acos(math.clamp(old:Dot(motor.heading),-1,1))) < 3.02,"Focus exceeded 180 deg/s")
		end
		assert(first>0 and possible-first+1>=24 and fly-first+1>=60,"classification timing")
		assert(View.build(memory,adapter).labels[1].text=="fly-like prey")
	end)
	check("P01 F4 hidden motion never updates observation or HUD position",function()
		rig(); run(80); local c=contact(); local pos=c.position; local tick=c.observedTick
		wall(); target.position+=Vector3.new(2,0,0); run(100)
		assert(c:hasMark() and (c.position-pos).Magnitude<1e-5 and c.observedTick==tick)
		local v=View.build(memory,adapter); assert(#v.rings==1 and v.rings[1].pos==Vector2.new(pos.X,pos.Z))
	end)
	check("P01 F5 fixed last-seen mark fades and expires",function()
		rig(); run(80); local c=contact(); wall(); run(12,false)
		local p=c.position; run(175,false); local v=View.build(memory,adapter)
		assert(c:hasMark() and c.position==p and v.rings[1].alpha<0.4 and v.rings[1].dash<0.8)
		run(200,false); assert(memory:count()==0 and #View.build(memory,adapter).rings==0)
	end)
	check("P01 F6 association follows evidence even after world id changes",function()
		rig(); run(80); local c=contact(); local w=wall(); run(30); target.id="renamed"; w:Destroy(); run(7)
		assert(contact()==c and c.reacquisitions==1 and memory:count()==1)
	end)
	check("P01 F7 only an inspected empty visible spot loses its mark",function()
		rig(); run(80); local c=contact(); run(12,false); assert(c:hasMark()); run(40,false); assert(memory:count()==0)
		rig(); run(80); c=contact(); wall(); run(100,false); assert(c:hasMark())
	end)
	check("P01 F8 never-sensed actors leave no overlay",function()
		rig(); target.position=Vector3.new(0,100,8); target.velocity=Vector3.xAxis; run(100)
		local v=View.build(memory,adapter); assert(memory:count()==0 and #v.edges==0 and #v.labels==0 and #v.rings==0)
		rig(); wall(); run(100); assert(memory:count()==0)
	end)
	if folder then folder:Destroy() end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">PromptSpec</string>
          <string name="Source"><![CDATA[--!strict
-- Device-aware prompts with Roblox's own text metrics (TextService): every prompt the HUD can show wraps inside the
-- narrowest prompt panel HudLayout allows, and the touch buttons' words fit their buttons. The live panel's placement and
-- TextFits are checked in the real client by tests/client/SilkPlayback.luau.
return function(check: (string, () -> ()) -> ())
	local TextService = game:GetService("TextService")
	local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
	local ControlText = require(Shared.UI.ControlText)
	local HudLayout = require(Shared.UI.HudLayout)
	local FONT = Enum.Font.GothamMedium
	local devices: { any } = { "keyboard", "gamepad", "touch" }
	local width = HudLayout.MIN_PROMPT_WIDTH - 20 -- the panel's narrowest span less the label's padding
	local function size(text: string, textSize: number, w: number): Vector2
		return TextService:GetTextSize(text, textSize, FONT, Vector2.new(w, 10000))
	end
	check("every device's prompts wrap inside the narrowest prompt panel in at most four lines", function()
		for _, device in devices do
			local title, hint, cue = ControlText.linePanel({ reeling = true, progress = 0, snagged = true, block = "" }, device)
			local texts = { title, hint, cue, ControlText.walkHint(device), ControlText.edgeWalkHint(device),
				ControlText.lineToast("dropped", "", false, true, device), ControlText.describe({ kind = "unreachable", reason = "no_launch" }, device) }
			for _, text in texts do
				local s = size(text, 17, width)
				assert(s.X <= width + 0.5, `{device}: "{text}" is {s.X} px wide in {width}`)
				assert(s.Y <= 4 * 17 * 1.35, `{device}: "{text}" needs {s.Y} px (over four lines)`)
			end
		end
	end)
	check("the controls card fits a phone's width in landscape for every device", function()
		for _, device in devices do
			local s = size(ControlText.helpCard(device), 15, 568 - 32 - 20)
			assert(s.Y <= 8 * 15 * 1.35, `{device}: the card needs {s.Y} px`)
		end
	end)
	check("touch buttons' words fit their buttons", function()
		for _, b in HudLayout.TOUCH_BUTTONS do
			local labels = { b.label }
			if b.action == "Cancel" then labels = { ControlText.touchCancelLabel(false), ControlText.touchCancelLabel(true) } end
			for _, label in labels do
				local s = size(label, b.textSize or 18, b.size - 6)
				assert(s.X <= b.size - 6 + 0.5 and s.Y <= b.size - 6, `{b.action}: "{label}" is {s.X}x{s.Y} in {b.size}`)
			end
		end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">RecoveryScenarios</string>
          <string name="Source"><![CDATA[--!strict
-- Deterministic recovery scenarios (HANDOFF-roblox-silk.md, Chet's acceptance list): missed jumps caught by the line,
-- lowering from a leaf, a wall and the planter, reeling, a snag, early and pre-held let-go presses, focus-loss
-- cancellation and a ten-miss recovery sequence, plus the catch camera (no roll, never inside the sill, the 45-degree
-- framing cap, the player's look winning), the landing patch's states and the body turning to Focus, the eye view and an
-- aim. The real SpiderMotor, SilkController, JumpInput and SpiderCamera run tick by tick
-- at 1/60 s on the windowsill's own boxes (WindowsillLayout.PIECES) in a separate folder; nothing waits on the frame rate.
-- Studio runs this with the engine's raycasts and sphere casts (tests/studio/Runner.server.luau). The plain Luau CLI runs the
-- same code against the box-world emulation in tests/shim.luau (tests/scenarios.luau): a smoke test, not engine evidence.
-- A miss is made the way a player makes one (Godot M03): a jump is planned and committed to a perch that then drops away.
return function(check: (string, () -> ()) -> (), deps: any)
	local Motor, JumpInput, Layout, Species, Surfaces, SpiderCamera = deps.Motor, deps.JumpInput, deps.Layout, deps.Species, deps.Surfaces, deps.SpiderCamera
	local DT = Motor.DT
	local HEIGHT = Motor.HEIGHT
	local folders: { Instance } = {}

	local function part(folder: Instance, name: string, lo: Vector3, hi: Vector3, profile: string): BasePart
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = hi - lo
		p.Position = (hi + lo) / 2
		p:SetAttribute("ProfileId", profile)
		if deps.transparent then p.Transparency = 1 end
		p.Parent = folder
		return p
	end

	local function windowsill(name: string): Instance
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = workspace
		for _, piece in Layout.PIECES do part(folder, piece.id, piece.lo, piece.hi, piece.profile) end
		table.insert(folders, folder)
		return folder
	end

	local sill = windowsill("RecoverySill")
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = { sill }
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { sill }

	local function newMotor(world: Instance?): any
		return Motor.new({ world = world or sill, surfaces = Surfaces, profile = Species.phidippus_audax_prototype, spawn = Layout.SPAWN,
			heading = Layout.SPAWN_HEADING, boundsMin = Layout.PLAY_BOUNDS_MIN, boundsMax = Layout.PLAY_BOUNDS_MAX, probeParent = world or sill })
	end
	local function input(t: any?): any
		local i: any = Motor.idleInput()
		for k, v in t or {} do i[k] = v end
		return i
	end
	local function finite(v: Vector3): boolean
		return v.X == v.X and v.Y == v.Y and v.Z == v.Z and v.Magnitude < 1e5
	end
	local function insideSill(p: Vector3, r: number): boolean
		return #workspace:GetPartBoundsInRadius(p, r, overlap) > 0
	end
	local function has(events: { string }, kind: string): boolean
		return table.find(events, kind) ~= nil
	end

	-- A run: ticks the motor (and, when given, the camera) with an input function until `done` or the tick limit, and
	-- watches every tick: finite, the body never inside the sill, the line never longer than its rest length, the camera
	-- never rolled and never inside the sill.
	type Run = { m: any, cam: any?, events: { string }, ticks: number, problems: { string }, maxTurn: number }
	local function watch(m: any, cam: any?): Run
		return { m = m, cam = cam, events = {}, ticks = 0, problems = {}, maxTurn = 0 }
	end
	local function problem(r: Run, text: string)
		if #r.problems < 6 then table.insert(r.problems, `tick {r.ticks}: {text}`) end
	end
	local function step(r: Run, inp: any)
		local m = r.m
		m:tick(inp)
		r.ticks += 1
		for _, e in m:drainEvents() do table.insert(r.events, e.kind) end
		if not finite(m.pos) or not finite(m.vel) then problem(r, "non-finite position or velocity") end
		if insideSill(m.pos, 0.25) then problem(r, `body inside the sill at {m.pos}`) end
		local silk = m.silk
		if silk.mode == "locked" then
			-- As Godot's M03: the line may pass through geometry only on ticks flagged as snagged, where its straight
			-- segments are not its length.
			if not silk.snagged and silk:path(m.pos) > silk.rest + 0.02 then problem(r, "line longer than its rest length") end
			if silk.rest > silk.maximum + 1e-6 or silk.paid < 0 then problem(r, "line length out of range") end
		end
		local cam: any = r.cam
		if cam then
			cam:tick(DT)
			cam:render(DT, 0, 0)
			local cf = cam.camera.CFrame
			if not cam.eyeView and math.abs(cf.RightVector.Y) > 1e-5 then problem(r, "the camera rolled") end
			if insideSill(cf.Position, 0.05) then problem(r, `camera inside the sill at {cf.Position}`) end
			r.maxTurn = math.max(r.maxTurn, math.abs(cam.framing.assist))
		end
	end
	-- Studio would stop a script that runs too long without yielding; the engine run yields now and then (the CLI does not).
	local function breathe(r: Run)
		if deps.yield and r.ticks % 600 == 0 then deps.yield() end
	end
	local function runUntil(r: Run, limit: number, inp: any, done: ((any) -> boolean)?): boolean
		for _ = 1, limit do
			step(r, inp)
			breathe(r)
			if done and done(r.m) then return true end
		end
		return false
	end
	local function newCamera(m: any): any
		local camera = Instance.new("Camera")
		camera.Parent = sill
		local drawnUp = Vector3.yAxis
		local cam = SpiderCamera.new(camera, params, function()
			drawnUp = drawnUp:Lerp(m.up, 0.33).Unit
			return { pos = m.pos, drawnUp = drawnUp, heading = m.heading, onLine = m:onLine(), rest = m:lineRestPoint(), lip = m:lineLip() }
		end, function(_on: boolean) end)
		cam.mouse = false
		return cam
	end

	-- A miss: from a spot on a surface, a leap planned to a perch that drops away once the spider has left.
	local function miss(m: any, at: Vector3, heading: Vector3, perchTop: Vector3): (boolean, string)
		m:place(at, Vector3.yAxis, heading)
		local lo = perchTop + Vector3.new(-0.5, -0.4, -0.5)
		local hi = perchTop + Vector3.new(0.5, 0, 0.5)
		local perch = part(sill, "PracticePerch", lo, hi, "leaf_dry_prototype")
		local plan = m:planJump(perchTop, Vector3.yAxis, perch)
		local ok = plan.kind == "reachable" and m:commit(plan)
		perch:Destroy()
		return ok, `{plan.kind} {plan.reason}`
	end
	local hanging = function(mm: any) return mm.silk.mode == "locked" and mm.silk.taut end
	local settled = function(mm: any) return (mm.silk.mode == "locked" and mm.silk.taut and mm.vel.Magnitude < 0.3) or mm.mode == "attached" end
	local attached = function(mm: any) return mm.mode == "attached" end

	local ok, err = pcall(function()
		-- ------------------------------------------------------------------ missed jumps and reeling
		check("a missed leap off the east leaf is caught by the line, settles, and reeling takes hold of the leaf", function()
			local m = newMotor()
			local cam = newCamera(m)
			local r = watch(m, cam)
			cam:snap()
			local launched, why = miss(m, Vector3.new(21.5, 5.4 + HEIGHT, -0.6), Vector3.zAxis, Vector3.new(21.5, 5.3, 2.9))
			assert(launched, "the practice leap was not reachable: " .. why)
			assert(runUntil(r, 240, input(), hanging), "no catch")
			assert(has(r.events, "anchored") and has(r.events, "locked") and has(r.events, "caught"), "line events: " .. table.concat(r.events, ","))
			assert(m.pos.Y > 1 and m.pos.Y < 5.4, `hangs below the leaf, not on the floor: {m.pos}`)
			assert(runUntil(r, 600, input(), settled), "the swing did not settle within 10 s")
			assert(runUntil(r, 1800, input({ reel = 1 }), attached), "reeling did not take hold again")
			assert(has(r.events, "completed") and m.supportPart and m.supportPart.Name == "leaf_east", `took hold of {m.supportPart} at {m.pos}`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
			assert(r.maxTurn <= math.rad(45) + 1e-9, "framing turn over the cap")
		end)

		-- ------------------------------------------------------------------ letting down: a leaf, a wall, the planter
		check("F on the middle leaf walks to the nearest edge, lets down, and a held F lowers to the sill floor", function()
			local m = newMotor()
			local r = watch(m)
			m:place(Vector3.new(0.5, 4.2 + HEIGHT, -3.0), Vector3.yAxis, Vector3.xAxis)
			assert(m:requestDrop() and m.silk.walk ~= nil, "no walk to the edge")
			assert(runUntil(r, 240, input(), hanging), "no hang after the walk to the edge")
			assert(has(r.events, "drop_walk") and has(r.events, "dropped"), table.concat(r.events, ","))
			assert(runUntil(r, 900, input({ dropHeld = true }), attached), "lowering never reached a surface")
			assert(m.pos.Y < 0.5, `landed at {m.pos}`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)
		check("F on the back wall lets down at once and lowering reaches the floor", function()
			local m = newMotor()
			local r = watch(m)
			m:place(Vector3.new(-8, 6, -12.5 + HEIGHT), Vector3.zAxis, Vector3.yAxis)
			assert(m:requestDrop() and m.mode == "air" and m.silk.walk == nil, "a wall should let down at once")
			assert(runUntil(r, 1200, input({ dropHeld = true }), attached), "lowering never reached a surface")
			assert(m.pos.Y < 0.5, `landed at {m.pos}`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)
		check("F on the planter rim walks to its front edge, lets down clear of the planter and lowers to the floor", function()
			local m = newMotor()
			local r = watch(m)
			m:place(Vector3.new(10, 4.6 + HEIGHT, 0.0), Vector3.yAxis, Vector3.zAxis)
			assert(m:requestDrop(), "planter rim refused")
			assert(runUntil(r, 240, input(), hanging), "no hang")
			assert(runUntil(r, 900, input({ dropHeld = true }), attached), "lowering never reached a surface")
			assert(m.pos.Y < 0.5 and m.pos.Z > 0.2, `landed at {m.pos}`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)
		check("after letting down from the leaf, reeling climbs back and takes hold of the leaf", function()
			local m = newMotor()
			local r = watch(m)
			m:place(Vector3.new(0.5, 4.2 + HEIGHT, -3.0), Vector3.yAxis, Vector3.xAxis)
			m:requestDrop()
			assert(runUntil(r, 240, input(), hanging), "no hang")
			runUntil(r, 90, input())
			assert(runUntil(r, 900, input({ reel = 1 }), attached), "reeling did not take hold")
			assert(m.supportPart and m.supportPart.Name == "leaf_middle", `took hold of {m.supportPart} at {m.pos}`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)

		-- ------------------------------------------------------------------ a snag
		check("a second obstruction snags the line: reeling is refused, lowering and letting go still work", function()
			local m = newMotor()
			local r = watch(m)
			m:place(Vector3.new(0.5, 4.2 + HEIGHT, -3.0), Vector3.yAxis, Vector3.xAxis)
			m:requestDrop()
			assert(runUntil(r, 240, input(), hanging), "no hang")
			runUntil(r, 120, input())
			local bend = m.silk.bend
			assert(bend ~= nil, "the leaf's edge should hold one bend")
			local obstacle = part(sill, "SecondEdge", (bend + m.pos) / 2 - Vector3.one * 0.06, (bend + m.pos) / 2 + Vector3.one * 0.06, "bare_wood_rough")
			runUntil(r, 2, input())
			assert(m.silk.snagged and has(r.events, "snagged"), "no snag reported")
			local rest = m.silk.rest
			runUntil(r, 60, input({ reel = 1 }))
			assert(math.abs(m.silk.rest - rest) < 1e-9, "reeling shortened a snagged line")
			runUntil(r, 30, input({ reel = -1 }))
			assert(m.silk.rest > rest + 0.5, "lowering did not pay out")
			runUntil(r, 2, input())
			assert(runUntil(r, 40, input({ releaseHeld = true }), function(mm) return mm.silk.mode == "none" end), "a deliberate hold did not let go")
			assert(has(r.events, "released"), table.concat(r.events, ","))
			obstacle:Destroy()
			assert(runUntil(r, 240, input(), attached) and m.pos.Y < 0.5, "did not fall to the floor")
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)

		-- ------------------------------------------------------------------ early and pre-held let-go presses
		check("a press in the 0.4 s grace never lets go, however long it is held; a fresh 0.6 s hold does", function()
			local m = newMotor()
			local r = watch(m)
			local launched = miss(m, Vector3.new(21.5, 5.4 + HEIGHT, -0.6), Vector3.zAxis, Vector3.new(21.5, 5.3, 2.9))
			assert(launched, "no practice leap")
			assert(runUntil(r, 240, input(), function(mm) return mm.silk.mode == "locked" end), "no lock")
			runUntil(r, 5, input())
			runUntil(r, 180, input({ releaseHeld = true }))
			assert(m:onLine(), "a press inside the grace let go")
			runUntil(r, 1, input())
			runUntil(r, 35, input({ releaseHeld = true }))
			assert(m:onLine() and m.silk.release.progress > 0.9, "a 35-tick hold let go, or showed no progress")
			runUntil(r, 1, input({ releaseHeld = true }))
			assert(m.silk.mode == "none" and has(r.events, "released"), "the 36th tick of a fresh hold did not let go")
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)
		check("Q held from before the leap through the catch never lets go; a fresh hold does", function()
			local m = newMotor()
			local r = watch(m)
			local launched = miss(m, Vector3.new(21.5, 5.4 + HEIGHT, -0.6), Vector3.zAxis, Vector3.new(21.5, 5.3, 2.9))
			assert(launched, "no practice leap")
			assert(runUntil(r, 240, input({ releaseHeld = true }), function(mm) return mm.silk.mode == "locked" end), "no lock")
			runUntil(r, 300, input({ releaseHeld = true }))
			assert(m:onLine(), "a held-over press let go")
			runUntil(r, 1, input())
			assert(runUntil(r, 36, input({ releaseHeld = true }), function(mm) return mm.silk.mode == "none" end), "a fresh hold did not let go")
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)

		-- ------------------------------------------------------------------ focus loss
		check("focus loss cancels: an aim never leaps afterwards, a let-go hold starts over, a walk to the edge stops", function()
			local m = newMotor()
			local j = JumpInput.new()
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			m:setAimRay(Vector3.new(-25, 3, 6), Vector3.new(1, -0.45, 0).Unit)
			j:press()
			for _ = 1, 12 do j:step(m); m:tick(input()) end
			assert(j:isAiming() and m:isPreparing(), "no aim")
			j:drop(m)
			j:release()
			for _ = 1, 3 do j:step(m); m:tick(input()) end
			assert(m.mode == "attached" and not m:isPreparing() and j.last == nil, "a release after focus loss leaped")
			local r = watch(m)
			local launched = miss(m, Vector3.new(21.5, 5.4 + HEIGHT, -0.6), Vector3.zAxis, Vector3.new(21.5, 5.3, 2.9))
			assert(launched, "no practice leap")
			assert(runUntil(r, 240, input(), function(mm) return mm.silk.mode == "locked" end), "no lock")
			runUntil(r, 40, input())
			runUntil(r, 18, input({ releaseHeld = true }))
			assert(m.silk.release.progress > 0.4, "no let-go progress")
			local release = m.silk.release -- what the client does on focus loss (SpiderClient dropAll)
			release.down, release.counts, release.held, release.progress = true, false, 0, 0
			runUntil(r, 60, input())
			assert(m:onLine() and m.silk.release.progress == 0, "the hold survived focus loss")
			runUntil(r, 35, input({ releaseHeld = true }))
			assert(m:onLine(), "the hold resumed where it was")
			m:place(Vector3.new(0.5, 4.2 + HEIGHT, -3.0), Vector3.yAxis, Vector3.xAxis)
			m:requestDrop()
			runUntil(r, 10, input())
			assert(m:cancelWalk() and m.silk.walk == nil, "no walk to cancel")
			runUntil(r, 120, input())
			assert(m.mode == "attached" and m.silk.mode == "none" and m.pos.Y > 4, "the walk went on after focus loss")
		end)

		-- ------------------------------------------------------------------ the catch camera
		check("catch camera: a squeezed view turns by the smallest working 15-degree step, never past 45, and the player's look wins", function()
			local cliffWorld = Instance.new("Folder")
			cliffWorld.Name = "CliffWorld"
			cliffWorld.Parent = workspace
			table.insert(folders, cliffWorld)
			part(cliffWorld, "Floor", Vector3.new(-20, -1, -20), Vector3.new(20, 0, 20), "painted_wood_dry")
			-- A roofed canyon running along Z, one stud wide: only views along it have room (a quarter turn from across it).
			part(cliffWorld, "WestWall", Vector3.new(0, 0, -10), Vector3.new(4, 7, 10), "bare_wood_rough")
			part(cliffWorld, "EastWall", Vector3.new(5, 0, -10), Vector3.new(9, 7, 10), "bare_wood_rough")
			part(cliffWorld, "Roof", Vector3.new(0, 7, -10), Vector3.new(9, 8, 10), "bare_wood_rough")
			local cparams = RaycastParams.new()
			cparams.FilterType = Enum.RaycastFilterType.Include
			cparams.FilterDescendantsInstances = { cliffWorld }
			local cover = OverlapParams.new()
			cover.FilterType = Enum.RaycastFilterType.Include
			cover.FilterDescendantsInstances = { cliffWorld }
			local onLine = true
			local spot = Vector3.new(4.5, 5, 0)
			local lip = Vector3.new(4.5, 6.9, 0)
			local function cameraAt(yaw: number): any
				local camera = Instance.new("Camera")
				camera.Parent = cliffWorld
				local c = SpiderCamera.new(camera, cparams, function()
					return { pos = spot, drawnUp = Vector3.yAxis, heading = Vector3.xAxis, onLine = onLine, rest = spot, lip = lip }
				end, function(_on: boolean) end)
				c.mouse = false
				c.yaw = yaw
				return c
			end
			-- Looking across the canyon (yaw -90): the boom is in the wall at every pitch and only a quarter turn clears it.
			local squeezed = cameraAt(math.rad(-90))
			for _ = 1, 90 do squeezed:tick(DT); squeezed:render(DT, 0, 0) end
			assert(squeezed.framing.assist == 0, "a quarter turn is beyond the 45-degree cap: nothing turns")
			assert(squeezed.boom < 2.5, `as squeezed as without framing ({squeezed.boom})`)
			-- 45 degrees off: the framing turns by the smallest working step (here exactly the cap) and holds it.
			local framed = cameraAt(math.rad(-45))
			for _ = 1, 90 do framed:tick(DT); framed:render(DT, 0, 0) end
			local turn = framed.framing.assist
			local steps = turn / math.rad(15)
			assert(turn ~= 0 and math.abs(steps - math.floor(steps + 0.5)) < 1e-6 and math.abs(turn) <= math.rad(45) + 1e-9, `turn {math.deg(turn)} is not a 15-degree step within the cap`)
			local from = spot + Vector3.yAxis * framed.pivot
			for k = 0, math.floor(math.abs(steps + 0.5)) - 1 do
				for _, side in { 1, -1 } do
					local smaller = k * math.rad(15) * side
					if math.abs(smaller) < math.abs(turn) - 1e-9 then assert(not framed:_goodView(from, framed.yaw + smaller, spot, lip), `a smaller turn {math.deg(smaller)} also worked`) end
				end
			end
			assert(framed.boom >= 2.5, `the turned view is comfortable ({framed.boom})`)
			local cf = framed.camera.CFrame
			assert(math.abs(cf.RightVector.Y) < 1e-5 and #workspace:GetPartBoundsInRadius(cf.Position, 0.05, cover) == 0, "the framed camera rolled or sits in the cliff")
			local view0 = framed:viewYaw()
			for _ = 1, 150 do framed:tick(DT); framed:render(DT, 0, 0) end
			assert(math.abs(framed:viewYaw() - view0) < 1e-6, "the turn drifted while the spider hung still")
			local yaw0 = framed.yaw
			framed:look(1, 0)
			assert(framed.framing.assist == 0 and math.abs(framed:viewYaw() - (view0 - math.rad(1))) < 1e-9, "a one-degree look did not take the turn over without a jump")
			assert(math.abs(framed.yaw - (yaw0 + turn - math.rad(1))) < 1e-9, "the turn did not become the player's yaw")
			for _ = 1, 120 do framed:tick(DT); framed:render(DT, 0, 0) end
			assert(framed.framing.assist == 0, "the framing came back while the line was out")
			-- Aiming and a recenter win over a held turn as well.
			local aimed = cameraAt(math.rad(-45))
			for _ = 1, 90 do aimed:tick(DT); aimed:render(DT, 0, 0) end
			local v1 = aimed:viewYaw()
			aimed:setAiming(true)
			assert(aimed.framing.assist == 0 and math.abs(aimed:viewYaw() - v1) < 1e-9, "aiming moved the view")
			aimed:setAiming(false)
			local recentred = cameraAt(math.rad(-45))
			for _ = 1, 90 do recentred:tick(DT); recentred:render(DT, 0, 0) end
			local v2 = recentred:viewYaw()
			recentred:startRecenter()
			assert(recentred.framing.assist == 0 and math.abs(recentred:viewYaw() - v2) < 1e-9 and recentred.recenterT == 0, "a recenter jumped")
			-- The line ends: the view stays where the framing left it.
			local ending = cameraAt(math.rad(-45))
			for _ = 1, 90 do ending:tick(DT); ending:render(DT, 0, 0) end
			local v3 = ending:viewYaw()
			onLine = false
			ending:tick(DT)
			onLine = true
			assert(ending.framing.assist == 0 and math.abs(ending:viewYaw() - v3) < 1e-9, "the view moved when the line ended")
		end)

		-- ------------------------------------------------------------------ the landing patch and the body's turns
		check("the landing patch says Reachable, Blocked, Out of reach and Can't land there, as Godot's planner", function()
			local m = newMotor()
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			local floor = sill:FindFirstChild("sill_floor")
			local reach = m:planJump(Vector3.new(-19, 0, 6), Vector3.yAxis, floor)
			assert(reach.kind == "reachable" and reach.steps > 0 and (reach.path[#reach.path] - reach.seat).Magnitude < 1e-4, `open sill: {reach.kind} {reach.reason}, endpoint error {(reach.path[#reach.path] - reach.seat).Magnitude}`)
			local far = m:planJump(Vector3.new(25, 0, 6), Vector3.yAxis, floor)
			assert(far.kind == "unreachable" and far.reason ~= "", `47 studs: {far.kind} {far.reason}`)
			local plate = part(sill, "CoatedPlate", Vector3.new(-18, 0, 2), Vector3.new(-17.8, 3, 4), "ptfe_coated")
			local coated = m:planJump(Vector3.new(-18, 1.5, 3), -Vector3.xAxis, plate)
			plate:Destroy()
			assert(coated.kind == "ineligible" and coated.reason == "ineligible_surface", `coated wall: {coated.kind} {coated.reason}`)
			local tight = m:planJump(Vector3.new(-29.9, 0, 6), Vector3.yAxis, floor)
			assert(tight.kind == "obstructed" and tight.reason == "no_room", `against the frame: {tight.kind} {tight.reason}`)
			assert(not m:commit(far) and not m:commit(tight) and m.mode == "attached", "a plan that is not reachable launched")
			m:place(Vector3.new(-29.5, HEIGHT, 6), Vector3.yAxis, -Vector3.xAxis)
			local hop = m:hopPlan()
			assert(hop.kind == "obstructed" and hop.reason == "hop_blocked", `hop into the frame: {hop.kind} {hop.reason}`)
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			local open = m:hopPlan()
			assert(open.kind == "reachable" and m:commit(open) and m.mode == "air", "a hop on the open sill")
		end)
		check("Focus, the eye view and an aim turn the body toward where the view points", function()
			local m = newMotor()
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			for _ = 1, 40 do m:tick(input({ focusPoint = Vector3.new(-22, 0.3, 12) })) end
			assert(m.heading:Dot(Vector3.zAxis) > 0.999, `Focus turned to {m.heading}`)
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			local gaze = Vector3.new(math.cos(math.rad(60)), 0, math.sin(math.rad(60)))
			for _ = 1, 60 do m:tick(input({ gaze = gaze })) end
			assert(math.deg(math.acos(math.clamp(m.heading:Dot(gaze), -1, 1))) < 4.5, "the eye view did not turn the body to the gaze")
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			for _ = 1, 20 do m:tick(input({ gaze = Vector3.new(math.cos(math.rad(20)), 0, math.sin(math.rad(20))) })) end
			assert(m.heading:Dot(Vector3.xAxis) > 0.9999, "a gaze inside 30 degrees turned the body")
			m:place(Vector3.new(-22, HEIGHT, 6), Vector3.yAxis, Vector3.xAxis)
			m:setAimRay(Vector3.new(-22, 3, 2), Vector3.new(0, -0.6, 1).Unit)
			assert(m:beginPrepare(), "no preparation")
			m:aimPlan()
			local before = m.pos
			for _ = 1, 30 do m:tick(input({ wish = Vector3.xAxis })) end
			assert((m.pos - before).Magnitude < 1e-9 and m.heading:Dot(Vector3.zAxis) > 0.99, `preparing: held still and turned to the aim ({m.heading})`)
		end)

		-- ------------------------------------------------------------------ walking over an edge with the stick held
		check("holding forward carries the spider over the leaf's edge, along its underside, never back and forth", function()
			local m = newMotor()
			local cam = newCamera(m)
			m:place(Vector3.new(0.5, 4.2 + HEIGHT, -0.5), Vector3.yAxis, Vector3.zAxis)
			cam:snap()
			local carry = deps.StickCarry.new()
			local r = watch(m, cam)
			local flips, lastUp, underside = 0, m.up, false
			for _ = 1, 150 do
				local d = carry:step(0, 1, cam:mapStick(0, 1, m.up), m.transitionSerial, m.intent, false)
				step(r, input({ wish = if d.Magnitude > 1e-6 then d.Unit else Vector3.zero }))
				if m.up.Y < -0.9 then underside = true end
				if lastUp.Y < 0.5 and m.up.Y > 0.9 and not underside then flips += 1 end
				lastUp = m.up
			end
			assert(flips == 0, `turned back onto the top {flips} times`)
			assert(underside and m.mode == "attached", `never reached the underside (up {m.up})`)
			assert(#r.problems == 0, table.concat(r.problems, "; "))
		end)

		-- ------------------------------------------------------------------ ten misses
		check("ten misses from leaves and the planter are caught and recovered by reeling, lowering or letting go", function()
			local fixtures: { { any } } = {
				{ "east leaf, front", Vector3.new(21.5, 5.4, -0.6), Vector3.zAxis, Vector3.new(21.5, 5.3, 2.9), "reel" },
				{ "east leaf, back", Vector3.new(21.5, 5.4, -5.4), -Vector3.zAxis, Vector3.new(21.5, 5.3, -8.9), "reel" },
				{ "middle leaf, front", Vector3.new(0.5, 4.2, 0.4), Vector3.zAxis, Vector3.new(0.5, 4.1, 2.9), "reel" },
				{ "middle leaf, back", Vector3.new(0.5, 4.2, -3.4), -Vector3.zAxis, Vector3.new(0.5, 4.1, -5.9), "reel" },
				{ "west leaf, front", Vector3.new(-15, 4.2, 0.4), Vector3.zAxis, Vector3.new(-15, 4.1, 2.9), "reel" },
				{ "west leaf, west side", Vector3.new(-17.4, 4.2, -1.5), -Vector3.xAxis, Vector3.new(-19.9, 4.1, -1.5), "reel" },
				{ "planter rim, front", Vector3.new(10, 4.6, 0.2), Vector3.zAxis, Vector3.new(10, 4.5, 3.2), "reel" },
				{ "middle leaf, front, then lower", Vector3.new(-3, 4.2, 0.4), Vector3.zAxis, Vector3.new(-3, 4.1, 2.9), "lower" },
				{ "east leaf, front, then lower", Vector3.new(24, 5.4, -0.6), Vector3.zAxis, Vector3.new(24, 5.3, 2.9), "lower" },
				{ "west leaf, front, then let go", Vector3.new(-13, 4.2, 0.4), Vector3.zAxis, Vector3.new(-13, 4.1, 2.9), "letgo" },
			}
			local results = {}
			local recovered = 0
			for i, f in fixtures do
				local m = newMotor()
				local withCamera = deps.cameraFixtures == "all" or (type(deps.cameraFixtures) == "table" and table.find(deps.cameraFixtures, i) ~= nil)
				local r = watch(m, if withCamera then newCamera(m) else nil)
				local name, at, heading, perch, after = f[1], f[2], f[3], f[4], f[5]
				local launched, why = miss(m, at + Vector3.new(0, HEIGHT, 0), heading, perch)
				if r.cam then r.cam:snap() end
				local outcome = "not launched: " .. why
				if launched then
					local caught = runUntil(r, 300, input(), hanging)
					local calm = caught and runUntil(r, 600, input(), settled)
					local done = false
					if caught and after == "reel" then
						done = runUntil(r, 2400, input({ reel = 1 }), attached) and has(r.events, "completed")
					elseif caught and after == "lower" then
						done = runUntil(r, 2400, input({ reel = -1 }), attached) and m.pos.Y < 0.5
					elseif caught then
						runUntil(r, 1, input())
						done = runUntil(r, 40, input({ releaseHeld = true }), function(mm) return mm.silk.mode == "none" end)
							and runUntil(r, 300, input(), attached) and m.pos.Y < 0.5
					end
					outcome = `caught {caught}, settled {calm}, {after} {done}, {r.ticks} ticks, max turn {math.floor(math.deg(r.maxTurn) + 0.5)}`
					if caught and done and #r.problems == 0 then recovered += 1 else outcome ..= " " .. table.concat(r.problems, "; ") end
				end
				table.insert(results, `{i} {name}: {outcome}`)
			end
			if deps.log then for _, line in results do deps.log(line) end end
			assert(recovered == #fixtures, `{recovered}/{#fixtures} recovered:\n` .. table.concat(results, "\n"))
		end)
	end)
	for _, folder in folders do folder:Destroy() end
	if not ok then error(err) end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="54">
        <Properties>
          <string name="Name">Runner</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Included only in tests.project.json. Press Play/Run in Studio; normal place excludes it.
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then return end
local HttpService = game:GetService("HttpService")
local evidence = require(script.Parent.BuildInfo)
workspace:SetAttribute("PortEvidence",evidence.id)
local rows = {}
local passed, failed = 0, 0
local function check(name: string, fn: () -> ())
	local ok, detail = pcall(fn)
	if ok then passed += 1 else failed += 1 end
	table.insert(rows, {name = name, passed = ok, detail = if ok then "" else tostring(detail)})
end
check("Studio spec completes", function() require(script.Parent.Spec)(check) end)
check("Silk spec completes", function() require(script.Parent.SilkSpec)(check) end)
check("Graphics spec completes", function() require(script.Parent.GraphicsSpec)(check) end)
-- Recovery scenarios and the catch camera on real raycasts and sphere casts (the same module the CLI runs on its box world).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local deps = {
	Motor = require(Shared.Movement.SpiderMotor), JumpInput = require(Shared.Movement.JumpInput), StickCarry = require(Shared.Movement.StickCarry),
	Layout = require(Shared.Habitat.WindowsillLayout), Species = require(Shared.Data.Species), Surfaces = require(Shared.Data.Surfaces),
	SpiderCamera = require(game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("Client"):WaitForChild("SpiderCamera")) :: any,
	cameraFixtures = "all", transparent = true, yield = function() task.wait() end,
	log = function(line: string) print("PORT_SCENARIO " .. line) end,
}
check("Recovery scenarios complete", function() require(script.Parent.RecoveryScenarios)(check, deps) end)
check("Perception spec completes", function() require(script.Parent.PerceptionSpec)(check) end)
check("Prompt spec completes", function() require(script.Parent.PromptSpec)(check) end)
local report = {suite = "Roblox engine", evidence_id = evidence.id, passed = passed, failed = failed,
	tests = passed + failed, not_run = 0, engine = version(), results = rows}
local json = HttpService:JSONEncode(report)
local output = Instance.new("StringValue")
output.Name = "PortTestReport"
output.Value = json
output.Parent = game:GetService("TestService")
print("PORT_TEST_REPORT " .. json)
-- Studio truncates long individual log messages. Keep each result independently recoverable.
for _, row in rows do print("PORT_TEST_ROW " .. HttpService:JSONEncode({evidence_id=evidence.id,result=row})) end
print("PORT_TEST_SUMMARY " .. HttpService:JSONEncode({evidence_id=evidence.id,passed=passed,failed=failed,tests=passed+failed,engine=version()}))
if failed > 0 then warn("PORT_TEST_FAIL") end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">SilkSpec</string>
          <string name="Source"><![CDATA[--!strict
return function(check)
	local Shared=game:GetService("ReplicatedStorage").Shared
	local Silk=require(Shared.Movement.SilkController)
	local world=Instance.new("Folder"); world.Name="SilkTestWorld"; world.Parent=workspace
	local function part(name,position,size,profile)
		local p=Instance.new("Part"); p.Name=name; p.Position=position; p.Size=size; p.Anchored=true
		p:SetAttribute("ProfileId",profile or "solid"); p.Parent=world; return p
	end
	part("Floor",Vector3.new(100,-0.5,0),Vector3.new(30,1,20))
	local leaf=part("Leaf",Vector3.new(100,5,0),Vector3.new(4,0.2,4))
	local wall=part("Wall",Vector3.new(106,4,0),Vector3.new(0.2,8,8))
	local surfaces={solid={attachable=true,silk_anchor_allowed=true},noSilk={attachable=true,silk_anchor_allowed=false},slippery={attachable=false,silk_anchor_allowed=true}}
	local function new() return Silk.new(world,surfaces,{max_line_length_wu=20,reel_speed_wu_s=1.5},35) end
	local function drop()
		local s=new()
		local p=Vector3.new(101.95,5.41,0)
		assert(s:startDrop(p,Vector3.yAxis,Vector3.xAxis))
		return s,Vector3.new(102.36,5.41,0),Vector3.new(0.6,0,0)
	end
	local ok,err=pcall(function()
		check("floor refuses lowering without room below",function()
			local s=new(); local plan=s:planDrop(Vector3.new(110,0.31,0),Vector3.yAxis,Vector3.zAxis)
			assert(plan==nil)
		end)
		check("raised leaf chooses nearest edge",function()
			local s=new(); local plan=s:planDrop(Vector3.new(100,5.41,1),Vector3.yAxis,Vector3.zAxis)
			assert(plan and plan.direction.Z>0.95 and math.abs(plan.distance-1)<0.12)
		end)
		check("anchor policy and moving local-space anchor",function()
			local s=new(); local p=Vector3.new(100,5.41,0)
			leaf:SetAttribute("ProfileId","noSilk")
			assert(not s:startDrop(p,Vector3.yAxis,Vector3.xAxis))
			leaf:SetAttribute("ProfileId","solid")
			assert(s:startDrop(p,Vector3.yAxis,Vector3.xAxis))
			local old=s.anchor; leaf.Position+=Vector3.new(0,1,0); s:refresh()
			local offset=s.anchor-old; leaf.Position-=Vector3.new(0,1,0)
			assert((offset-Vector3.yAxis).Magnitude<1e-5)
		end)
		check("payout never constrains a valid flight",function()
			local s=new(); local p=Vector3.new(100,5.41,0)
			local hit=workspace:Raycast(p,Vector3.new(0,-1,0),s.params)
			assert(s:anchorAt(hit,p))
			for i=1,30 do s:payout(Vector3.new(100+i/10,6,0)); assert(s.mode=="payout" and not s.taut) end
		end)
		check("miss catches within paid length and settles",function()
			local s,p,v=drop(); s.lowering=false; s:lock(p,0.25)
			local caught=false
			for _=1,180 do
				local hit; p,v,hit=s:step(p,v,0,false)
				assert(not hit,"unexpected landing")
				caught=caught or s.taut
				assert(s:path(p)<=s.rest+0.02 and v.Magnitude<15)
			end
			assert(caught and v.Magnitude<0.5)
		end)
		check("deliberate leaf drop hangs then lowers to floor",function()
			local s,p,v=drop()
			for _=1,120 do local hit; p,v,hit=s:step(p,v,0,false); assert(not hit) end
			assert(s.taut and p.Y<5)
			local landed=nil
			for _=1,480 do p,v,landed=s:step(p,v,-1,false); if landed then break end end
			assert(landed and landed.Instance.Name=="Floor")
		end)
		check("reel after leaf drop grabs the leaf",function()
			local s,p,v=drop()
			for _=1,90 do p,v=s:step(p,v,0,false) end
			local landed=nil
			for _=1,360 do p,v,landed=s:step(p,v,1,false); if landed then break end end
			assert(landed and landed.Instance==leaf,`no leaf grab: {s.block} p={p}`)
		end)
		check("wall drop lowers to floor",function()
			local s=new(); local p=Vector3.new(105.59,6,0); local v=Vector3.new(-0.6,0,0)
			assert(s:startDrop(p,-Vector3.xAxis,-Vector3.xAxis))
			local landed=nil
			for _=1,480 do p,v,landed=s:step(p,v,-1,false); if landed then break end end
			assert(landed and landed.Instance.Name=="Floor")
		end)
		check("one bend snags at a second obstruction and clears again",function()
			local s,p,v=drop()
			for _=1,120 do p,v=s:step(p,v,0,false) end
			assert(s.bend~=nil,"leaf edge should retain one bend")
			local bend=s.bend
			local obstruction=part("SecondObstacle",(bend+p)*0.5,Vector3.one*0.12,"slippery")
			s:geometry(p)
			local snagged=s.snagged
			obstruction:Destroy(); s:geometry(p)
			assert(snagged and not s.snagged,"second obstruction must snag then clear")
			s:geometry(Vector3.new(101.95,5.41,0))
			assert(s.bend==nil,"clear direct path removes bend")
		end)
		check("anchor deletion releases without invalid coordinates",function()
			local s,p,v=drop(); leaf.Parent=nil
			p,v=s:step(p,v,0,false); leaf.Parent=world
			assert(s.mode=="none" and p.X==p.X and v.X==v.X)
		end)
		check("blocked reel cannot pull through nonattachable wall",function()
			local s=new(); wall:SetAttribute("ProfileId","slippery")
			local p=Vector3.new(105.5,6,0); local v=Vector3.zero
			local hit=workspace:Raycast(p,Vector3.xAxis,s.params)
			assert(s:anchorAt(hit,p)); s:lock(p,0.25)
			-- A point behind the wall must be stopped by a body sweep.
			local moved=s:move(p,Vector3.new(2,0,0),v,1)
			wall:SetAttribute("ProfileId","solid")
			assert(moved.X<105.61)
		end)
	end)
	world:Destroy()
	if not ok then error(err) end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">Spec</string>
          <string name="Source"><![CDATA[--!strict
-- Real Roblox values, raycasts and BulkMoveTo. No headless shim here.
return function(check)
	local Shared = game:GetService("ReplicatedStorage").Shared
	local JumpMath = require(Shared.Movement.JumpMath)
	local Rig = require(Shared.Rig.SpiderRig)
	local Appearance = require(Shared.Data.Appearances)
	local folder = Instance.new("Folder")
	folder.Name = "PortTestWorld"
	folder.Parent = workspace
	local floor = Instance.new("Part")
	floor.Anchored = true
	floor.Size = Vector3.new(20, 1, 20)
	floor.Position = Vector3.new(100, -0.5, 0)
	floor.Parent = folder
	local rig = Rig.new(folder, folder)
	local function run()
		check("real engine jump reaches seat", function()
			local from, seat = Vector3.new(100, 0.31, 0), Vector3.new(103, 0.31, 0)
			local result = JumpMath.solve(from, seat, Vector3.yAxis, Vector3.yAxis, Vector3.new(0,-35,0), 1/60, 0.1, 1.2, 20)
			assert(#result.valid > 0)
			local solution = result.valid[1]
			local path = JumpMath.path(from, solution.velocity, Vector3.new(0,-35,0), 1/60, solution.steps)
			assert((path[#path] - seat).Magnitude < 0.001)
		end)
		check("raycast planted foot stays in world space", function()
			rig:update(CFrame.new(100, 0.31, 0), 1/60, true, false)
			local foot = rig._legs[1].foot
			assert(rig._legs[1].planted ~= nil, "must hit real floor")
			rig:update(CFrame.new(100.02, 0.31, 0), 1/60, true, true)
			assert((rig._legs[1].foot - foot).Magnitude < 0.001)
		end)
		check("appearance stays white when stage changes", function()
			local before = rig._spots[1].Color
			rig:setGrowthStage(3)
			local c = Appearance.profiles[Appearance.default].white
			for _, spot in rig._spots do
				assert(spot.Color == before, "stage recolored the markings")
				assert(math.abs(spot.Color.R-c[1]) < 1/255 and math.abs(spot.Color.G-c[2]) < 1/255 and math.abs(spot.Color.B-c[3]) < 1/255)
			end
			assert(rig.model:GetAttribute("AppearanceId") == "first_spider")
		end)
		check("all rig parts are display only and bounded", function()
			local count, fuzz = 0, 0
			for _, part in rig.model:GetChildren() do
				if part:IsA("BasePart") then
					if part.Name == "Seta" or part.Name == "FuzzShell" then fuzz += 1 else count += 1 end
					assert(part.Anchored and not part.CanCollide and not part.CanQuery and not part.CanTouch)
					assert(part.Position.X == part.Position.X)
				end
			end
			assert(count <= 160, `part budget exceeded: {count}`)
			assert(fuzz >= 300 and fuzz <= 720, `fuzz budget: {fuzz}`)
		end)
		check("spider-eye view hides the body and keeps the front legs", function()
			rig:setEyeView(true)
			local eye = rig.model:FindFirstChild("PrincipalEye") :: BasePart
			assert(eye.LocalTransparencyModifier == 1, "head still drawn in the eye view")
			assert(rig._legs[1].tibia.LocalTransparencyModifier == 0, "front leg hidden")
			assert(rig._legs[2].femur.LocalTransparencyModifier == 1, "back leg drawn")
			rig:setEyeView(false)
			assert(eye.LocalTransparencyModifier == 0 and rig._legs[2].femur.LocalTransparencyModifier == 0)
		end)
		check("low detail keeps about a fifth of the fuzz and under 300 parts", function()
			local low = Rig.new(folder, folder, nil, "low")
			local n, total = 0, 0
			for _, part in low.model:GetChildren() do
				if part:IsA("BasePart") then total += 1 end
				if part.Name == "Seta" then n += 1 end
			end
			low:destroy()
			assert(n >= 100 and n <= 260, `low fuzz: {n}`)
			assert(total <= 300, `low parts: {total}`)
		end)
		check("big glossy eyes with catchlights, no sockets or outline in low detail", function()
			local function named(model: Instance, name: string): number
				local n = 0
				for _, part in model:GetChildren() do if part.Name == name then n += 1 end end
				return n
			end
			local low = Rig.new(folder, folder, nil, "low")
			assert(named(rig.model, "Catchlight") == 4 and named(low.model, "Catchlight") == 4, "catchlights")
			assert(named(rig.model, "EyeSocket") == 2 and named(low.model, "EyeSocket") == 0, "eye sockets")
			assert(rig.model:FindFirstChildWhichIsA("Highlight") ~= nil and low.model:FindFirstChildWhichIsA("Highlight") == nil, "outline")
			local eye = rig.model:FindFirstChild("PrincipalEye") :: BasePart
			assert(eye.Material == Enum.Material.Glass and eye.Size.X >= 0.18, "the front eyes are big and glossy")
			low:destroy()
		end)
		check("idle motion moves the drawn head and palps only, and not in low detail", function()
			local body = CFrame.new(100, 0.31, 0)
			local function pose(r: any): { Vector3 }
				local out = {}
				for _, part in r.model:GetChildren() do
					if part.Name == "PalpClub" or part.Name == "EyeFace" then table.insert(out, part.Position) end
				end
				return out
			end
			local function run(r: any, seconds: number) for _ = 1, math.floor(seconds * 60) do r:update(body, 1 / 60, true, false) end end
			local function drift(a: { Vector3 }, b: { Vector3 }): number
				local most = 0
				for i, v in a do most = math.max(most, (v - b[i]).Magnitude) end
				return most
			end
			local low = Rig.new(folder, folder, nil, "low")
			run(rig, 1); run(low, 1)
			local a, b = pose(rig), pose(low)
			run(rig, 4); run(low, 4)
			assert(drift(a, pose(rig)) > 0.004, "full detail stands still")
			assert(drift(b, pose(low)) < 1e-6, "low detail moves")
			assert((rig.root.Position - body.Position).Magnitude < 1e-6, "the root moved")
			low:destroy()
		end)
		check("air and underside poses are finite", function()
			for _, up in {Vector3.yAxis, Vector3.xAxis, -Vector3.yAxis} do
				local body = CFrame.lookAt(Vector3.new(100,2,0), Vector3.new(100,2,-1), up)
				rig:update(body,1/60,false,false)
				for _, foot in rig._legs do assert(foot.foot.Magnitude < 110) end
			end
		end)
	end
	local ok, err = pcall(run)
	rig:destroy()
	folder:Destroy()
	if not ok then error(err) end
end
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="57">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="58">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Builds the windowsill (scripts/habitat/windowsill.gd), the drawn world around it (Habitat/Scenery, from Data/Graphics) and the
-- lighting (Habitat/Lit). The spider itself is client-side (StarterPlayerScripts/Client/SpiderClient): one player, one spider,
-- nothing to replicate yet. Lighting Technology (Future) and MaterialService.Use2022Materials are authored in the Rojo projects;
-- runtime scripts cannot set them.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Habitat = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Habitat")
local Scenery = require(Habitat:WaitForChild("Scenery"))
local Lit = require(Habitat:WaitForChild("Lit"))

Players.CharacterAutoLoads = false
Workspace.Gravity = 35 -- species gravity_wu_s2; used by any unanchored props

-- The sill is what the game needs; the looks are best effort. If the lighting or the decor fails (nothing here has run in Roblox
-- Studio yet), the server says so and carries on with the old look: a visible back wall, the plain morning light.
-- Lighting first: the light shafts follow the sun it picks. Depth of field is opt-in (Workspace attribute DepthOfField).
local litOk, sun = pcall(Lit.apply, Lighting, Workspace:FindFirstChild("Terrain"), { depthOfField = Workspace:GetAttribute("DepthOfField") == true })
if litOk then
	print("[Windowsill] sun: " .. (if sun.ok then "through the window, " else "fallback, ") .. sun.reason)
else
	warn("[Windowsill] lighting set-up failed: " .. tostring(sun))
end

local decorOk, decor = pcall(Scenery.decor, if litOk and sun.ok then sun.direction else nil)
if not decorOk then
	warn("[Windowsill] decor failed, the back wall stays as it was: " .. tostring(decor))
end

local sill = Scenery.sill(decorOk)
if decorOk then decor.Parent = Workspace end
sill.Parent = Workspace
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="59">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="60">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="61">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">PerceptionHud</string>
            <string name="Source"><![CDATA[--!strict
-- Thin drawer for the pure memory view. Reuses widgets rather than creating Instances every frame.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local View = require(Shared.UI.PerceptionView)
local Hud = {}
Hud.__index = Hud
function Hud.new(parent: Instance): any
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.IgnoreGuiInset, gui.ResetOnSpawn = "PerceptionHud", true, false
	gui.DisplayOrder = 4
	gui.Parent = parent
	return setmetatable({gui=gui, pool={}, used=0}, Hud)
end
function Hud.label(self: any, text: string, at: Vector2, alpha: number, rotation: number?, size: number?)
	self.used += 1
	local p = self.pool[self.used]
	if not p then
		p = Instance.new("TextLabel")
		p.BackgroundTransparency, p.AnchorPoint = 1, Vector2.new(0.5,0.5)
		p.Size = UDim2.fromOffset(240,28)
		p.TextColor3, p.TextStrokeColor3 = Color3.new(1,1,1), Color3.new(0,0,0)
		p.Parent = self.gui
		table.insert(self.pool,p)
	end
	p.Visible, p.Text, p.Position = true, text, UDim2.fromOffset(at.X,at.Y)
	p.TextTransparency, p.TextStrokeTransparency = 1-alpha, 1-alpha*0.9
	p.Rotation, p.TextSize = rotation or 0, size or 18
end
function Hud.draw(self: any, memory: any, camera: Camera, cast: any, focusing: boolean, showMark: boolean?)
	self.used = 0
	local viewport = camera.ViewportSize
	local adapter = {
		project = function(at: Vector3, size: number)
			local p = camera:WorldToViewportPoint(at)
			local q = camera:WorldToViewportPoint(at+camera.CFrame.RightVector*math.max(size,0.2)*0.5)
			return Vector2.new(p.X,p.Y), p.Z > 0 and p.X > -40 and p.Y > -40 and p.X < viewport.X+40 and p.Y < viewport.Y+40,
				math.clamp((Vector2.new(p.X,p.Y)-Vector2.new(q.X,q.Y)).Magnitude,10,36)
		end,
		edge = function(dir: Vector3)
			local d = camera.CFrame:VectorToObjectSpace(dir)
			local v = Vector2.new(d.X,-d.Y)
			if v.Magnitude < 0.03 then v = Vector2.new(0,-1) end
			v = v.Unit
			local half = viewport*0.5-Vector2.new(34,34)
			local t = math.min(half.X/math.max(math.abs(v.X),1e-6),half.Y/math.max(math.abs(v.Y),1e-6))
			return {pos=viewport*0.5+v*t, dir=v}
		end,
		covered = function(at: Vector3, slack: number)
			local eye = camera.CFrame.Position
			local hit = cast(eye,at)
			return hit ~= nil and (hit-eye).Magnitude < (at-eye).Magnitude-slack
		end,
	}
	local view = View.build(memory,adapter,showMark)
	for _, e in view.edges do self:label("›",e.pos,e.alpha,math.deg(math.atan2(e.dir.Y,e.dir.X)),32) end
	for _, r in view.rings do
		-- Twenty-eight small tangents form a ring; last-seen rings become broken with age.
		for i=0,27 do
			if r.kind == "mark" and i%2 == 1 and r.dash < 0.95 then continue end
			local a = i*math.pi/14
			self:label("—",r.pos+Vector2.new(math.cos(a),math.sin(a))*r.radius,r.alpha,math.deg(a)+90,8)
		end
	end
	for _, l in view.labels do self:label(l.text,l.pos-Vector2.new(0,l.offset+10),l.alpha) end
	if focusing then
		for i=0,3 do
			local a=i*math.pi/2
			self:label("—",viewport*0.5+Vector2.new(math.cos(a),math.sin(a))*11,0.8,math.deg(a),12)
		end
	end
	for i=self.used+1,#self.pool do self.pool[i].Visible=false end
	self.view = view
end
return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">PerceptionStage</string>
            <string name="Source"><![CDATA[--!strict
-- Temporary D-038 stage, away from spawn, crevice and recovery routes. Physical screen/ledge belong to WORLD.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Target = require(Shared.Habitat.TestTarget)
local Stage = {}
function Stage.new(sill: Instance): any
	local folder = Instance.new("Folder")
	folder.Name = "PerceptionStage"
	folder.Parent = sill
	local function part(name: string, at: Vector3, size: Vector3, solid: boolean): Part
		local p = Instance.new("Part")
		p.Name, p.Position, p.Size = name, at, size
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, solid, solid, false
		p.Color = Color3.fromRGB(116, 100, 91)
		if solid then p:SetAttribute("ProfileId", "bare_wood_rough"); p:SetAttribute("SurfaceId", name) end
		p.Parent = folder
		return p
	end
	part("watch_ledge", Vector3.new(-25,1,-3.5), Vector3.new(4,2,3), true)
	part("stage_screen", Vector3.new(-25,1.5,-7), Vector3.new(2,3,0.2), true)
	local marker = part("TestMarker", Vector3.new(-29,2.8,-10), Vector3.one*0.9, false)
	marker.Shape = Enum.PartType.Ball
	marker.Color = Color3.fromRGB(220,31,158)
	local sign = Instance.new("BillboardGui")
	sign.Name, sign.Size, sign.StudsOffset = "TargetSign", UDim2.fromOffset(220,55), Vector3.new(0,1,0)
	sign.AlwaysOnTop = false
	sign.Parent = marker
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1,1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1,1,1)
	label.TextStrokeTransparency = 0
	label.TextSize = 15
	label.Text = "TEST TARGET\nmoving marker, not a fly"
	label.Parent = sign
	local target = Target.new({Vector3.new(-29,2.8,-10), Vector3.new(-21,2.8,-10)})
	return {target=target, marker=marker, folder=folder}
end
return Stage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">SpiderCamera</string>
            <string name="Source"><![CDATA[--!strict
-- The spider's camera: a Roblox port of the frozen Godot rig, scripts/movement/camera_rig.gd (c87ce00).
-- A Scriptable camera, so Roblox's own orbit (which centres on the body and so aimed jumps at the spider's feet)
-- never runs. Pure math lives in Shared/Movement/CameraMath and LineFraming and is checked against Godot's values.
--
-- Orbit view: yaw/pitch only, never rolls (horizon-stable). The pivot stands PIVOT_HEIGHT along the spider's drawn up (so
-- on a wall it stands out from the wall, under an overhang it hangs below). The boom is a sphere cast from the pivot; a hit
-- retracts at once, recovery is rate limited. A squeezed boom searches steeper, then flatter pitches (auto-pitch). Close
-- in, the body is hidden so it never fills the screen. A cast that starts touching geometry counts as blocked (Godot's
-- cast_motion; Roblox's Spherecast would not see that part), so the camera is never placed inside the sill.
-- Line framing (LineFraming, A-017 with Chet's 45-degree cap): hanging on the safety line with the player's own view
-- squeezed where the spider will hang, the view turns by the smallest 15-degree step (at most 45) that sees the spider
-- and the lip; the player's look, a recenter or aiming takes the turn over at once and nothing jumps.
-- Aiming: the screen-centre ray picks the jump target. Vertical look then tilts the camera about its own position
-- (aim pitch) instead of orbiting, so the player can aim above the pivot; it eases back after.
-- Spider-eye view (V / Y): the camera sits just ahead of the principal eyes looking along a gaze the player turns; its up
-- follows the body's at most EYE_ROLL_DEG_S. Walking is relative to the gaze. Switching back snaps behind the spider.
-- Mouse: locked to the screen centre while playing (as the Godot game captures it); the Roblox menu frees it.
-- Placement order (Godot chunk 6B): no boom is trusted until the sill can be seen by queries; until then the camera sits
-- at the pivot with a boom of 0.

local GuiService = game:GetService("GuiService")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Movement = game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Movement")
local CameraMath = require(Movement:WaitForChild("CameraMath"))
local SupportMath = require(Movement:WaitForChild("SupportMath"))
local LineFraming = require(Movement:WaitForChild("LineFraming"))

local SpiderCamera = {}
SpiderCamera.__index = SpiderCamera

local MIN_DISTANCE, MAX_DISTANCE = 2.0, 12.0
local TOUCH_DEG_PER_PIXEL = 0.25

export type Target = { pos: Vector3, drawnUp: Vector3, heading: Vector3, onLine: boolean?, rest: Vector3?, lip: Vector3? }

function SpiderCamera.new(camera: Camera, params: RaycastParams, target: () -> Target, onEye: (boolean) -> ())
	local overlap = OverlapParams.new()
	overlap.FilterType = params.FilterType
	overlap.FilterDescendantsInstances = params.FilterDescendantsInstances
	local self = setmetatable({
		camera = camera,
		params = params,
		overlap = overlap,
		target = target,
		onEye = onEye,
		yaw = 0,
		elevation = math.rad(CameraMath.DEFAULT_ELEVATION_DEG),
		autoPitch = 0, autoPitchPrev = 0, settle = 0,
		aimPitch = 0,
		aiming = false,
		distance = CameraMath.CAMERA_DISTANCE,
		boom = 0, pivot = 0,
		pivotDir = Vector3.yAxis,
		recenterT = -1, recenterYaw0 = 0, recenterElev0 = 0, recenterGaze0 = Vector3.zero,
		eyeView = false,
		gaze = -Vector3.zAxis,
		gazeUp = Vector3.yAxis,
		bodyHidden = false,
		hide = nil :: ((boolean) -> ())?,
		framing = LineFraming.new(),
		wantedKey = "", wantedCache = 0,
		worldReady = false,
		mouse = true, -- false in tests: no mouse lock or mouse look (the Studio specs run on the server)
	}, SpiderCamera)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = CameraMath.FOV_DEG
	UIS.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseWheel and not processed and not self.eyeView then
			self.distance = math.clamp(self.distance * (if input.Position.Z > 0 then 0.88 else 1 / 0.88), MIN_DISTANCE, MAX_DISTANCE)
		end
	end)
	self:snap()
	return self
end

-- The view's yaw: the player's own plus the line framing's turn. Walking steers by it, so the stick means what is on screen.
function SpiderCamera.viewYaw(self: any): number
	return self.yaw + self.framing.assist
end

-- True once the geometry the camera casts against has arrived (placement order).
function SpiderCamera._ready(self: any): boolean
	if not self.worldReady then
		for _, root in self.params.FilterDescendantsInstances do
			if root:FindFirstChildWhichIsA("BasePart", true) then
				self.worldReady = true
				break
			end
		end
	end
	return self.worldReady
end

-- Boom length clear of the sill from `from` along `motion`. A start touching geometry is blocked at once.
function SpiderCamera._cast(self: any, from: Vector3, motion: Vector3): number
	local length = motion.Magnitude
	if length < 1e-6 or not self:_ready() then return 0 end
	if #Workspace:GetPartBoundsInRadius(from, CameraMath.BOOM_RADIUS, self.overlap) > 0 then return 0 end
	local hit = Workspace:Spherecast(from, CameraMath.BOOM_RADIUS, motion, self.params)
	return if hit then math.max(0, hit.Distance - 0.01) else length
end

function SpiderCamera._boomAt(self: any, from: Vector3, yaw: number, pitch: number): number
	return self:_cast(from, CameraMath.backDirection(yaw, pitch) * self.distance)
end

-- camera_rig._pitch_search: the auto-pitch offset from the pivot `from` at this yaw, and the boom it gives.
function SpiderCamera._pitchSearch(self: any, from: Vector3, yaw: number): (number, number)
	local comfort = math.min(CameraMath.COMFORT_BOOM, self.distance)
	local offsets, lengths = { 0 }, { self:_boomAt(from, yaw, self.elevation) }
	local step = math.rad(CameraMath.AUTO_PITCH_STEP_DEG)
	local roomDown = math.max(math.rad(CameraMath.MAX_ELEVATION_DEG) - self.elevation, 0)
	local roomUp = math.max(self.elevation - math.rad(CameraMath.MIN_AUTO_ELEVATION_DEG), 0)
	local offset = 0
	while lengths[#lengths] < comfort and offset < roomDown - 1e-6 do
		offset = math.min(offset + step, roomDown)
		table.insert(offsets, offset)
		table.insert(lengths, self:_boomAt(from, yaw, self.elevation + offset))
	end
	offset = 0
	while lengths[#lengths] < comfort and offset < roomUp - 1e-6 do
		offset = math.min(offset + step, roomUp)
		table.insert(offsets, -offset)
		table.insert(lengths, self:_boomAt(from, yaw, self.elevation - offset))
	end
	local picked = CameraMath.pickPitchOffset(offsets, lengths, comfort)
	local index = table.find(offsets, picked) or 1
	return picked, lengths[index]
end

-- True when nothing in the sill stands between the two points (camera_rig._sees).
function SpiderCamera._sees(self: any, a: Vector3, b: Vector3): boolean
	local d = b - a
	if d.Magnitude < 1e-6 then return true end
	local hit = Workspace:Raycast(a, d, self.params)
	return hit == nil or (hit.Position - a).Magnitude >= d.Magnitude - LineFraming.SIGHT_TOLERANCE
end

-- camera_rig._good_view: from the pivot `from`, at this yaw and the pitch the search picks, the boom is comfortable and
-- the camera sees both the spider where it will hang and the lip.
function SpiderCamera._goodView(self: any, from: Vector3, yaw: number, spot: Vector3, lip: Vector3): boolean
	local offset, length = self:_pitchSearch(from, yaw)
	if length < math.min(CameraMath.COMFORT_BOOM, self.distance) then return false end
	local camPos = from + CameraMath.backDirection(yaw, CameraMath.effectiveElevation(self.elevation, offset)) * length
	return self:_sees(camPos, spot) and self:_sees(camPos, lip)
end

-- The framing's wanted turn for the rest point and lip, recomputed only when they, the pivot or the player's view move.
function SpiderCamera._wantedTurn(self: any, t: Target): number
	local rest = t.rest or t.pos
	local lip = t.lip or rest
	local from = rest + self.pivotDir * self.pivot
	local function q(v: Vector3): string return string.format("%.2f,%.2f,%.2f", v.X, v.Y, v.Z) end
	local key = q(from) .. "|" .. q(lip) .. "|" .. string.format("%.4f,%.4f,%.2f,%.4f", self.yaw, self.elevation, self.distance, self.framing.target)
	if key ~= self.wantedKey then
		self.wantedKey = key
		self.wantedCache = LineFraming.wantedTurn(self.framing.target, self.framing.maxTurn, function(turn: number): boolean
			return self:_goodView(from, self.yaw + turn, rest, lip)
		end)
	end
	return self.wantedCache
end

function SpiderCamera._bodyForward(self: any): Vector3
	return self.target().heading
end

-- Puts the orbit camera behind the spider at once (spawn, reset, leaving the eye view). No framing turn survives it.
function SpiderCamera.snap(self: any)
	local t = self.target()
	self.yaw = CameraMath.recenterYaw(t.heading, t.drawnUp, self.yaw)
	self.elevation = math.rad(CameraMath.DEFAULT_ELEVATION_DEG)
	self.recenterT = -1
	self.framing:reset()
	self.wantedKey = ""
	self.pivotDir = t.drawnUp
	self.pivot = CameraMath.PIVOT_HEIGHT
	self.settle = 2
	self.boom = 0
	self:tick(0)
end

-- R / middle mouse / right-stick click: behind the spider over a quarter second. On the line it takes the framing's turn
-- over first (nothing jumps) and keeps the framing off until the line ends. Aiming wins over a recenter.
function SpiderCamera.startRecenter(self: any)
	if self.aiming then return end
	self.recenterT = 0
	if self.eyeView then
		self.recenterGaze0 = self.gaze
	else
		self.yaw += self.framing:playerTurns(self.target().onLine == true)
		self.recenterYaw0, self.recenterElev0 = self.yaw, self.elevation
	end
end

-- Aiming starts or ends (JumpInput). Starting takes the framing's turn over, so the view of the landing stays put.
function SpiderCamera.setAiming(self: any, on: boolean)
	self.aiming = on
	if on then
		self.yaw += self.framing:takeOver()
		self.recenterT = -1
	end
end

-- "Frame the line after a catch" (default on). Switched off with a turn held, the view stays where it is.
function SpiderCamera.setFraming(self: any, on: boolean)
	self.yaw += self.framing:setEnabled(on)
end

function SpiderCamera.setEyeView(self: any, on: boolean)
	if on == self.eyeView then return end
	self.eyeView = on
	self.recenterT = -1
	self.camera.FieldOfView = if on then CameraMath.EYE_FOV_DEG else CameraMath.FOV_DEG
	if on then
		local t = self.target()
		self.yaw += self.framing:takeOver()
		self.aimPitch = 0
		self.gazeUp = t.drawnUp
		self.gaze = CameraMath.clampGaze(t.heading, self.gazeUp, t.heading)
	else
		self:snap()
	end
	self.onEye(on)
end

function SpiderCamera.toggleEyeView(self: any)
	self:setEyeView(not self.eyeView)
end

-- look(dx, dy) in degrees: dx > 0 looks right, dy > 0 looks down (Godot camera_rig.look). Any look takes the line
-- framing's turn over at once; on the line the framing then stays off until the line ends.
function SpiderCamera.look(self: any, dx: number, dy: number)
	if dx == 0 and dy == 0 then return end
	if self.recenterT >= 0 and math.abs(dx) + math.abs(dy) > 1.5 then self.recenterT = -1 end
	if self.eyeView then
		self.gaze = CameraMath.lookEye(self.gaze, self.gazeUp, math.rad(dx), math.rad(dy), self:_bodyForward())
		return
	end
	self.yaw += self.framing:playerTurns(self.target().onLine == true)
	self.yaw -= math.rad(dx)
	if self.aiming then
		self.aimPitch = CameraMath.clampAimPitch(self.aimPitch - math.rad(dy), CameraMath.effectiveElevation(self.elevation, self.autoPitch))
	else
		self.elevation = math.clamp(self.elevation + math.rad(dy), math.rad(CameraMath.MIN_ELEVATION_DEG), math.rad(CameraMath.MAX_ELEVATION_DEG))
	end
end

function SpiderCamera.touchLook(self: any, delta: Vector2)
	self:look(delta.X * TOUCH_DEG_PER_PIXEL, delta.Y * TOUCH_DEG_PER_PIXEL)
end

-- One fixed 60 Hz tick: pivot, line framing, auto-pitch and boom (orbit), or the gaze carried with the body (eye view).
function SpiderCamera.tick(self: any, dt: number)
	local t = self.target()
	if self.eyeView then
		local up = SupportMath.rotateToward(self.gazeUp, t.drawnUp, math.rad(CameraMath.EYE_ROLL_DEG_S) * dt)
		if SupportMath.angleTo(up, self.gazeUp) > 1e-6 then
			local axis = self.gazeUp:Cross(up)
			if axis.Magnitude > 1e-9 then
				self.gaze = CameraMath.rotate(self.gaze, axis.Unit, SupportMath.angleTo(self.gazeUp, up))
			end
		end
		self.gazeUp = up
		self.gaze = CameraMath.clampGaze(self.gaze, up, t.heading)
		return
	end
	self.pivotDir = t.drawnUp
	self.pivot = CameraMath.nextLength(self.pivot, self:_cast(t.pos, self.pivotDir * CameraMath.PIVOT_HEIGHT), CameraMath.PIVOT_HEIGHT, CameraMath.RECOVER_SPEED, dt)
	local from = t.pos + self.pivotDir * self.pivot
	if dt > 0 then
		self.yaw += self.framing:tick(t.onLine == true, self.aiming, function(): number return self:_wantedTurn(t) end, dt)
	end
	local yaw = self:viewYaw()
	local wanted = self:_pitchSearch(from, yaw)
	if self.settle > 0 then
		self.settle -= 1
		self.autoPitch = wanted
	else
		self.autoPitch = CameraMath.easeOffset(self.autoPitch, wanted, dt, CameraMath.AUTO_PITCH_IN_SECONDS, CameraMath.AUTO_PITCH_OUT_SECONDS)
	end
	local elev = CameraMath.effectiveElevation(self.elevation, self.autoPitch)
	self.boom = CameraMath.nextLength(self.boom, self:_boomAt(from, yaw, elev), self.distance, CameraMath.RECOVER_SPEED, if self.settle > 0 then 1 else dt)
end

local function smooth(k: number): number
	return k * k * (3 - 2 * k)
end

-- Every rendered frame: the player's look, recentring and the aim's return, then the camera is placed.
function SpiderCamera.render(self: any, frameDt: number, lookX: number, lookY: number)
	if self.mouse then
		local menu = GuiService.MenuIsOpen
		UIS.MouseBehavior = if menu then Enum.MouseBehavior.Default else Enum.MouseBehavior.LockCenter
		UIS.MouseIconEnabled = menu
		if not menu then
			local m = UIS:GetMouseDelta()
			self:look(m.X * CameraMath.MOUSE_DEG_PER_PIXEL, m.Y * CameraMath.MOUSE_DEG_PER_PIXEL)
		end
	end
	local rate = CameraMath.STICK_DEG_PER_SECOND * frameDt
	self:look(lookX * rate, lookY * rate)
	local t = self.target()
	if self.recenterT >= 0 then
		self.recenterT += frameDt
		local k = smooth(math.clamp(self.recenterT / CameraMath.RECENTER_SECONDS, 0, 1))
		if self.eyeView then
			self.gaze = CameraMath.clampGaze(self.recenterGaze0:Lerp(t.heading, k), self.gazeUp, t.heading)
		else
			local goal = CameraMath.recenterYaw(t.heading, t.drawnUp, self.yaw)
			local d = (goal - self.recenterYaw0 + math.pi) % (2 * math.pi) - math.pi
			self.yaw = self.recenterYaw0 + d * k
			self.elevation = self.recenterElev0 + (math.rad(CameraMath.DEFAULT_ELEVATION_DEG) - self.recenterElev0) * k
		end
		if k >= 1 then self.recenterT = -1 end
	end
	if self.eyeView then
		local body = SupportMath.bodyCFrame(t.pos, self.gazeUp, t.heading)
		local eye = body:PointToWorldSpace(Vector3.new(0, CameraMath.EYE_HEIGHT, -CameraMath.EYE_AHEAD))
		self.camera.CFrame = CFrame.lookAt(eye, eye + self.gaze, self.gazeUp)
		self:_hideBody(true)
		return
	end
	if not self.aiming and self.aimPitch ~= 0 then
		self.aimPitch = CameraMath.easeOffset(self.aimPitch, 0, frameDt, CameraMath.AIM_RETURN_SECONDS, CameraMath.AIM_RETURN_SECONDS)
	end
	local yaw = self:viewYaw()
	local elev = CameraMath.effectiveElevation(self.elevation, self.autoPitch)
	local from = t.pos + self.pivotDir * self.pivot
	-- A flick between ticks: cast again along the direction about to be used; only shortening is taken.
	local length = math.min(self.boom, self:_boomAt(from, yaw, elev))
	self.boom = length
	local orbit = CFrame.new(from) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-elev, 0, 0)
	self.camera.CFrame = orbit * CFrame.new(0, 0, length) * CFrame.Angles(CameraMath.clampAimPitch(self.aimPitch, elev), 0, 0)
	self:_hideBody(length < CameraMath.BODY_HIDE_LENGTH)
end

function SpiderCamera._hideBody(self: any, hidden: boolean)
	if hidden ~= self.bodyHidden then
		self.bodyHidden = hidden
		if self.hide then (self.hide :: (boolean) -> ())(hidden) end
	end
end

-- The aim ray: the camera's centre ray.
function SpiderCamera.aimRay(self: any): (Vector3, Vector3)
	local cf = self.camera.CFrame
	return cf.Position, cf.LookVector
end

-- Walking intent for a stick (x right, y forward) on a surface with normal n, relative to the view on screen.
function SpiderCamera.mapStick(self: any, x: number, y: number, n: Vector3): Vector3
	if self.eyeView then
		return CameraMath.mapStickEye(x, y, self.gaze, self:_bodyForward(), n)
	end
	return CameraMath.mapStick(x, y, self:viewYaw(), CameraMath.effectiveElevation(self.elevation, self.autoPitch), n)
end

return SpiderCamera
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="65">
          <Properties>
            <string name="Name">SpiderClient</string>
            <string name="Source"><![CDATA[--!strict
-- The playable spider. Wires one control scheme (SpiderInput: keyboard and mouse, controller and touch together) to the
-- Godot jump controller's phases (Shared/Movement/JumpInput), the body (Shared/Movement/SpiderMotor: walking on any
-- surface, hops and aimed leaps, the safety line), the camera (SpiderCamera, a port of camera_rig.gd), the drawn spider
-- (SpiderRig) and the screen (SpiderHud, words from Shared/UI/ControlText for the device in use). Ports the frozen Godot
-- game at c87ce00: scripts/core/input_setup.gd, player_controller.gd, jump_controller.gd, tether_controller.gd.
--
-- Controls (README.md has the full table): WASD walk relative to the view, mouse looks, Shift creeps. Tap Space: a short
-- hop. Hold Space (0.15 s): the spider holds still and turns toward the centre dot; the landing patch says Reachable /
-- Blocked / Out of reach / Can't land there; release to leap, Q cancels. F lets down on silk (to the nearest edge first on
-- top of a leaf). On the line W reels in, S lowers and holding Q lets go. V spider-eye view, R recenter, right mouse Focus,
-- T slow motion, H controls card, Backspace back to the start, Esc the Roblox menu (the game waits).

local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local SpiderInput = require(script.Parent.SpiderInput)
local SpiderCamera = require(script.Parent.SpiderCamera)
local SpiderHud = require(script.Parent.SpiderHud)
local WorldDetail = require(script.Parent.WorldDetail)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Movement = Shared:WaitForChild("Movement")
local SupportMath = require(Movement:WaitForChild("SupportMath"))
local SpiderMotor = require(Movement:WaitForChild("SpiderMotor"))
local JumpInput = require(Movement:WaitForChild("JumpInput"))
local StickCarry = require(Movement:WaitForChild("StickCarry"))
local ControlText = require(Shared:WaitForChild("UI"):WaitForChild("ControlText"))
local Species = require(Shared:WaitForChild("Data"):WaitForChild("Species"))
local Surfaces = require(Shared:WaitForChild("Data"):WaitForChild("Surfaces"))
local Detail = require(Shared:WaitForChild("Data"):WaitForChild("Detail"))
local Layout = require(Shared:WaitForChild("Habitat"):WaitForChild("WindowsillLayout"))
local SpiderRig = require(Shared:WaitForChild("Rig"):WaitForChild("SpiderRig"))

local Sensor = require(Shared.Perception.Sensor)
local ObservationMemory = require(Shared.Perception.ObservationMemory)
local FocusState = require(Shared.Movement.FocusState)
local PerceptionStage = require(script.Parent.PerceptionStage)
local PerceptionHud = require(script.Parent.PerceptionHud)
local focusState = FocusState.new()
local DT = SpiderMotor.DT
local SLOW_SPEED = 0.5
local MAX_DRAGLINES = 24 -- two segments per one-bend line
local WALK_HINT_SECONDS = 60
local PATCH_GROW_FROM = 6 -- studs from the camera; beyond it the patch grows with distance (up to 4x), as in Godot
local COLORS = {
	reachable = Color3.new(0.25, 0.92, 0.38), obstructed = Color3.new(1.0, 0.72, 0.1),
	unreachable = Color3.new(1.0, 0.32, 0.28), ineligible = Color3.new(0.72, 0.45, 1.0), none = Color3.new(0.8, 0.8, 0.8),
}
local WARN_EVENTS = { drop_refused = true, snagged = true, lost = true, blocked = true }

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local sill = Workspace:WaitForChild("Windowsill")
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include
params.FilterDescendantsInstances = { sill }

local arc = Instance.new("Folder")
arc.Name = "JumpArc"
arc.Parent = Workspace
local motor: any = SpiderMotor.new({
	world = sill, surfaces = Surfaces, profile = Species.phidippus_audax_prototype,
	spawn = Layout.SPAWN, heading = Layout.SPAWN_HEADING,
	boundsMin = Layout.PLAY_BOUNDS_MIN, boundsMax = Layout.PLAY_BOUNDS_MAX, probeParent = arc,
})
local jump: any = JumpInput.new()
local carry: any = StickCarry.new()
-- Touch-only devices (phones, tablets) run the low tier until a real tablet frame-time check (ROBLOX_PORT.md): lighter fuzz and
-- no idle extras on the spider, fewer optional parts in the world. Workspace attribute Detail = "low" or "full" overrides the guess.
local detail = Detail.choose(UIS.TouchEnabled and not UIS.KeyboardEnabled, Workspace:GetAttribute("Detail"))
local rig = SpiderRig.new(Workspace, sill, nil, detail)
task.spawn(function()
	local roots: { Instance } = { Lighting }
	local decor = Workspace:WaitForChild("Decor", 10)
	if decor then table.insert(roots, decor) end
	local terrain = Workspace:FindFirstChild("Terrain")
	if terrain then table.insert(roots, terrain) end
	WorldDetail.apply(detail, roots)
end)
local hud = SpiderHud.new(player:WaitForChild("PlayerGui"))
local device: ControlText.Device = ControlText.initialDevice(UIS.TouchEnabled, UIS.KeyboardEnabled, UIS.GamepadEnabled)
local memory = ObservationMemory.new()
local sensor = Sensor.new(memory)
sensor:configureFrom(Species.phidippus_audax_prototype.perception)
local sightCast = Sensor.workspaceCast(params)
local perceptionHud = PerceptionHud.new(player:WaitForChild("PlayerGui"))
local stage = if Workspace:GetAttribute("TestTarget") ~= false then PerceptionStage.new(sill) else nil
local function focusActive(): boolean
	return focusState:active(false, player:GetAttribute("FocusToggle") == true, motor.mode == "attached")
end
local drawnUp = motor.up
local slow = false
local helpVisible, helpUntil = true, os.clock() + 20
local started = os.clock()
local afterMiss, dropped = false, false
local lastFeedback: any = nil

-- ---------------------------------------------------------------- the safety line as drawn (mechanics in SilkController)
local lines = Instance.new("Folder")
lines.Name = "Draglines"
lines.Parent = Workspace
local liveLine: Part? = nil
local bendLine: Part? = nil

local function strand(a: Vector3, b: Vector3, p: Part)
	local len = math.max((b - a).Magnitude, 0.01)
	p.Size = Vector3.new(0.012, 0.012, len)
	p.CFrame = CFrame.lookAt((a + b) * 0.5, b)
end

local function newStrand(): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(236, 232, 214)
	p.Transparency = 0.35
	p:SetAttribute("Born", time())
	p.Parent = lines
	local kids = lines:GetChildren()
	if #kids > MAX_DRAGLINES then kids[1]:Destroy() end
	return p
end

local function beginStrands()
	liveLine = newStrand()
	local bend = newStrand()
	bend.Transparency = 1
	bendLine = bend
end

local function dropStrands(keep: boolean)
	if not keep then
		if liveLine then liveLine:Destroy() end
		if bendLine then bendLine:Destroy() end
	end
	liveLine, bendLine = nil, nil
end

-- ---------------------------------------------------------------- jump preview: arc and landing patch
local dots: { Part } = {}
local function display(p: Part)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Transparency = 1
	p.Parent = arc
end
for i = 1, 28 do
	local d = Instance.new("Part")
	d.Name = "Dot" .. i
	d.Shape = Enum.PartType.Ball
	d.Size = Vector3.one * 0.07
	display(d)
	dots[i] = d
end
local patch = Instance.new("Part")
patch.Name = "LandingPatch"
patch.Shape = Enum.PartType.Cylinder
display(patch)
local ring = Instance.new("Part")
ring.Name = "LandingRing"
ring.Shape = Enum.PartType.Cylinder
display(ring)
local cross = Instance.new("Part")
cross.Name = "BlockedMark"
display(cross)

local function hidePreview()
	for _, d in dots do d.Transparency = 1 end
	patch.Transparency, ring.Transparency, cross.Transparency = 1, 1, 1
end

local function showPlan(plan: any)
	hidePreview()
	if not plan or plan.kind == "none" or not plan.point then return end
	local color = COLORS[plan.kind] or COLORS.none
	-- Beyond 6 studs from the camera the whole patch grows with the distance (up to four times), so it stays readable;
	-- its centre is still the exact landing point.
	local grow = math.clamp((camera.CFrame.Position - plan.point).Magnitude / PATCH_GROW_FROM, 1, 4)
	patch.Size = Vector3.new(0.02, 0.9 * grow, 0.9 * grow)
	ring.Size = Vector3.new(0.012, 1.15 * grow, 1.15 * grow)
	cross.Size = Vector3.new(0.5 * grow, 0.05 * grow, 0.05 * grow)
	local face = CFrame.lookAt(plan.point + plan.normal * 0.012, plan.point + plan.normal * 2) * CFrame.Angles(0, math.pi / 2, 0)
	patch.Color, ring.Color = color, color
	patch.CFrame = face
	ring.CFrame = face * CFrame.new(-0.004, 0, 0)
	patch.Transparency = if plan.kind == "reachable" then 0.55 else 0.75
	ring.Transparency = 0.25
	local path = plan.path
	if path and #path > 1 then
		for i, d in dots do
			local k = math.floor((i - 1) / (#dots - 1) * (#path - 1)) + 1
			d.Position = path[k]
			d.Color = color
			d.Transparency = 0.2
		end
	end
	if plan.blockedAt then
		cross.Color = color
		cross.CFrame = CFrame.lookAt(plan.blockedAt, camera.CFrame.Position) * CFrame.Angles(0, 0, math.rad(45))
		cross.Transparency = 0.1
	end
end

-- ---------------------------------------------------------------- camera and input
local cam: any = SpiderCamera.new(camera, params, function()
	return {
		pos = motor.pos, drawnUp = drawnUp, heading = motor.heading,
		onLine = motor:onLine(), rest = motor:lineRestPoint(), lip = motor:lineLip(),
	}
end, function(on: boolean)
	rig:setEyeView(on)
end)
cam.hide = function(hidden: boolean)
	rig:setBodyHidden(hidden)
end
jump.onAim = function(on: boolean)
	cam:setAiming(on)
end

-- Everything held is dropped with no penalty and no message: focus loss, the Roblox menu, a text box, a lost controller.
local function dropAll()
	focusState:clear()
	jump:drop(motor)
	local release = motor.silk.release
	release.down, release.counts, release.held, release.progress = true, false, 0, 0
	motor:cancelWalk()
end

local function backToStart()
	focusState:clear()
	sensor:reset()
	memory:clear()
	jump:drop(motor)
	motor:respawn()
	dropStrands(false)
	drawnUp = motor.up
	cam:snap()
end

local controls: any = SpiderInput.bind({
	focus = function(phase: string)
		if phase == "begin" then focusState:press(player:GetAttribute("FocusToggle") == true, motor.mode == "attached")
		elseif phase == "cancel" then focusState:clear() end
	end,
	jump = function(phase: string)
		if phase == "begin" then
			motor:cancelWalk() -- a jump press takes over from a walk to the edge
			jump:press()
		elseif phase == "end" then
			jump:release()
		else
			jump:cancel()
		end
	end,
	-- Q / B / touch Cancel (Let go on the line): the same button cancels an aim, stops a walk to the edge (and is nothing
	-- else's then) and, held on the line, lets go; SilkController counts only a fresh press after the 0.4 s grace, held 0.6 s.
	cancel = function(phase: string)
		if phase ~= "begin" then return end
		if motor:cancelWalk() then return end
		focusState:cancel(jump:isBusy() or #jump.events > 0 or motor:onLine())
		jump:cancel()
	end,
	drop = function() motor:requestDrop() end,
	clear = dropAll,
	reset = backToStart,
	gait = function() rig.gaitMode = if rig.gaitMode == "Tetrapod" then "Unilateral" else "Tetrapod" end,
	eye = function() cam:toggleEyeView() end,
	recenter = function() cam:startRecenter() end,
	slow = function() slow = not slow end,
	touchLook = function(delta: Vector2) cam:touchLook(delta) end,
	help = function()
		helpVisible = not helpVisible
		helpUntil = math.huge
	end,
	device = function(name: string)
		device = ControlText.deviceFor(name, device)
	end,
})

-- One fixed tick's intent from the controls, for the motor.
local function tickInput(): any
	local r, f = controls:axes()
	local wish = Vector3.zero
	if r ~= 0 or f ~= 0 then
		-- Over a sharp edge the stick keeps carrying the spider the way it was going (Godot's carry), so holding forward
		-- never walks it straight back when the camera's idea of forward flips from floor to wall.
		local d = carry:step(r, f, cam:mapStick(r, f, motor.up), motor.transitionSerial, motor.intent, false)
		if d.Magnitude > 1e-6 then wish = d.Unit end
	else
		carry:step(0, 0, Vector3.zero, motor.transitionSerial, motor.intent, false)
	end
	local focusPoint: Vector3? = nil
	if focusState:active(controls.held.Focus == true, player:GetAttribute("FocusToggle") == true, motor.mode == "attached") then
		local origin, dir = cam:aimRay()
		local hit = Workspace:Raycast(origin, dir * SpiderMotor.AIM_RANGE, params)
		focusPoint = if hit then hit.Position else origin + dir * SpiderMotor.AIM_RANGE
	end
	return {
		wish = wish, creep = controls.held.Creep == true, reel = f,
		dropHeld = controls.held.Drop == true, releaseHeld = controls.held.Cancel == true,
		focusPoint = focusPoint, gaze = if cam.eyeView then cam.gaze else nil,
	}
end

-- ---------------------------------------------------------------- the screen
local function handleEvents()
	for _, e in motor:drainEvents() do
		local kind = if e.kind == "landed" then "completed" else e.kind
		if kind == "locked" then afterMiss = true elseif kind == "dropped" then dropped = true end
		if kind == "anchored" or kind == "dropped" then beginStrands() end
		if kind == "completed" then dropStrands(true) end
		if kind == "released" or kind == "lost" or kind == "out_of_bounds" then dropStrands(false) end
		if kind == "out_of_bounds" then
			hud:toast(ControlText.toast("out_of_bounds", nil), true)
			drawnUp = motor.up
			cam:snap()
		else
			hud:toast(ControlText.lineToast(kind, e.detail, afterMiss, dropped, device), WARN_EVENTS[kind] == true)
		end
		if kind == "completed" or kind == "released" or kind == "lost" or kind == "anchored" then
			afterMiss, dropped = false, false
		end
	end
	local last = jump.last
	if last and last ~= lastFeedback then
		lastFeedback = last
		hud:toast(ControlText.toast(last.kind, last.plan), last.kind ~= "cancelled")
	end
end

local function updateHud(frameDt: number)
	handleEvents()
	local aiming = jump:isAiming()
	local view: any = {
		device = device, aiming = aiming, focus = controls.held.Focus == true or focusActive(), eyeView = cam.eyeView,
		status = {}, helpVisible = helpVisible, helpText = ControlText.helpCard(device),
	}
	if aiming then
		local plan = jump.plan
		local title, hint = ControlText.describe(plan, device)
		view.aimTitle, view.aimHint = title, hint
		view.aimColor = COLORS[if plan then plan.kind else "none"] or COLORS.none
		local reason = motor:anchorPreview(plan)
		view.anchorText, view.anchorOk = ControlText.anchorText(reason), reason == "ok"
		showPlan(plan)
	elseif jump.flash then
		showPlan(jump.flash)
	else
		hidePreview()
	end
	if focusState.latched then table.insert(view.status, "FOCUS ON    " .. ControlText.name(device,"focus") .. " again to stop" .. (if not jump:isBusy() and not motor:onLine() and not motor.silk.walk then " / " .. ControlText.name(device,"cancel") else "")) end
	if cam.eyeView then table.insert(view.status, `SPIDER-EYE VIEW    {ControlText.name(device, "eye")}: back`) end
	if slow then
		local key = ControlText.name(device, "slow")
		table.insert(view.status, `SLOW MOTION {math.floor(SLOW_SPEED * 100)}%` .. (if key ~= "" then `    {key}: normal speed` else ""))
	end
	local silk = motor.silk
	local onLine = motor:onLine()
	if onLine then
		local _, f = controls:axes()
		local title, hint, cue = ControlText.linePanel({
			reeling = f > 0.2 and silk.block == "" and not silk.snagged,
			progress = silk.release.progress, snagged = silk.snagged, block = silk.block,
		}, device)
		view.prompt = { title = title, hint = hint, cue = cue }
	elseif silk.walk then
		view.prompt = { hint = ControlText.edgeWalkHint(device) }
	elseif motor.mode == "attached" and not aiming and (helpVisible or os.clock() - started < WALK_HINT_SECONDS) then
		view.prompt = { hint = ControlText.walkHint(device) }
	end
	if os.clock() > helpUntil and helpVisible then helpVisible = false end
	controls:setTouchLabel("Cancel", ControlText.touchCancelLabel(onLine))
	controls:setTouchVisible("Jump", not onLine)
	controls:setTouchVisible("Creep", not onLine)
	hud:update(view, frameDt)
end

-- ---------------------------------------------------------------- the frame
local accumulator = 0
RunService:BindToRenderStep("SpiderSim", Enum.RenderPriority.Camera.Value + 1, function(frameDt: number)
	if GuiService.MenuIsOpen then
		accumulator = 0 -- the Roblox menu is Godot's pause: the world waits
	else
		local simDt = frameDt * (if slow then SLOW_SPEED else 1)
		accumulator = math.min(accumulator + simDt, 0.25)
		local origin, dir = cam:aimRay()
		motor:setAimRay(origin, dir)
		while accumulator >= DT do
			accumulator -= DT
			local percepts = {}
			if stage then
				local p = stage.target:percept()
				if p then table.insert(percepts,p) end
			end
			sensor:step(DT,motor:observer(),percepts,sightCast)
			jump:step(motor)
			motor:tick(tickInput())
			if motor.mode ~= "attached" then focusState:clear() end
			if stage then stage.target:step(DT); stage.marker.Position = stage.target.position end
			cam:tick(DT)
		end
	end
	-- Drawn frame: the up vector eases so walls and edges do not snap.
	local simFrame = frameDt * (if slow then SLOW_SPEED else 1)
	drawnUp = drawnUp:Lerp(motor.up, 1 - math.exp(-24 * simFrame)).Unit
	local body = SupportMath.bodyCFrame(motor.pos, drawnUp, motor.heading)
	rig:update(body, simFrame, motor.mode == "attached", motor.moving)
	updateHud(frameDt)
	local silk = motor.silk
	local live, bend = liveLine, bendLine
	if live and bend and silk.mode ~= "none" then
		local tip = rig:spinneretPoint(body)
		strand(silk.anchor, silk.bend or tip, live)
		live.Transparency = 0.35
		if silk.bend then
			strand(silk.bend, tip, bend)
			bend.Transparency = 0.35
		else
			bend.Transparency = 1
		end
	end
	for _, line in lines:GetChildren() do
		if line ~= liveLine and line ~= bendLine and line:IsA("BasePart") then
			local born = line:GetAttribute("Born")
			local age = time() - (if typeof(born) == "number" then born else time())
			if age > 25 then line:Destroy() else line.Transparency = math.max(line.Transparency, 0.35 + 0.65 * age / 25) end
		end
	end
	-- Looking runs in real time, so slow motion never makes the camera sluggish.
	local lx, ly = controls:lookAxes()
	cam:render(frameDt, lx, ly)
	perceptionHud:draw(memory,camera,sightCast,motor.mode == "attached" and (controls.held.Focus == true or focusActive()),player:GetAttribute("ShowLastSeen") ~= false)
	local dof = Lighting:FindFirstChild("MacroDOF")
	if dof and dof:IsA("DepthOfFieldEffect") then
		local focus = (camera.CFrame.Position - motor.pos).Magnitude
		if cam.eyeView then
			local origin, dir = cam:aimRay()
			local hit = Workspace:Raycast(origin, dir * 40, params)
			focus = if hit then hit.Distance else 40
		end
		dof.FocusDistance = focus
	end
end)

-- The test-place-only module exercises this controller in Studio. Absent from the playable build.
local playback = script.Parent:FindFirstChild("SilkPlayback")
if RunService:IsStudio() and playback and playback:IsA("ModuleScript") then
	task.spawn(function()
		local run: any = (require :: any)(playback)
		run({
			sensor = sensor, memory = memory, focusState = focusState, perceptionHud = perceptionHud, stage = stage,
			input = controls,
			drop = function() motor:requestDrop() end,
			jump = jump,
			motor = motor,
			camera = cam,
			sill = sill,
			setDevice = function(name: ControlText.Device) device = name end,
			place = function(position: Vector3)
				controls:clear()
				jump:drop(motor)
				motor:place(position, Vector3.yAxis, Vector3.zAxis)
				dropStrands(false)
				drawnUp = motor.up
				cam:snap()
			end,
			get = function()
				return { mode = motor.mode, line = motor.silk.mode, taut = motor.silk.taut, position = motor.pos, walking = motor.silk.walk ~= nil }
			end,
		})
	end)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">SpiderHud</string>
            <string name="Source"><![CDATA[--!strict
-- The spider's screen: the centre dot and Focus ticks, the aim's words under them (Godot jump_hud.gd), a status line and
-- short toasts at the top, the controls card, and the prompt panel at the bottom (the line's own prompts while hanging,
-- what stops a walk to the edge, or a small reminder while walking). Words come from Shared/UI/ControlText for the device
-- in use. Everything but the centre dot sits in the safe area (ScreenInsets.CoreUISafeInsets) and wraps; the prompt panel
-- keeps clear of the touch buttons (Shared/UI/HudLayout).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HudLayout = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI"):WaitForChild("HudLayout"))

local Hud = {}
Hud.__index = Hud

local TOAST_SECONDS = 2.6
local OK_COLOR = Color3.new(0.92, 0.94, 0.98)
local WARN_COLOR = Color3.new(1.0, 0.72, 0.1)

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function pad(parent: Instance, x: number, y: number)
	local p = Instance.new("UIPadding")
	p.PaddingLeft, p.PaddingRight = UDim.new(0, x), UDim.new(0, x)
	p.PaddingTop, p.PaddingBottom = UDim.new(0, y), UDim.new(0, y)
	p.Parent = parent
end

-- A label that keeps its width and wraps, growing downward (the safe way to wrap with AutomaticSize).
local function wrapLabel(name: string, parent: Instance, textSize: number, order: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundColor3 = Color3.new(0, 0, 0)
	l.BackgroundTransparency = 0.4
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.GothamMedium
	l.TextSize = textSize
	l.TextWrapped = true
	l.RichText = false
	l.Size = UDim2.new(1, 0, 0, 0)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.LayoutOrder = order
	l.Visible = false
	pad(l, 10, 5)
	corner(l, 8)
	l.Parent = parent
	return l
end

-- A short label sized to its text (single lines broken by hand), for the aim words at the centre.
local function pill(name: string, parent: Instance, textSize: number, order: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundColor3 = Color3.new(0, 0, 0)
	l.BackgroundTransparency = 0.45
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.GothamMedium
	l.TextSize = textSize
	l.TextWrapped = false
	l.AutomaticSize = Enum.AutomaticSize.XY
	l.Size = UDim2.fromOffset(0, 0)
	l.LayoutOrder = order
	l.Visible = false
	pad(l, 10, 4)
	corner(l, 8)
	l.Parent = parent
	return l
end

local function column(name: string, parent: Instance, anchor: Vector2, position: UDim2, align: Enum.VerticalAlignment): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.AnchorPoint = anchor
	f.Position = position
	f.Size = UDim2.new(1, -32, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = align
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 6)
	list.Parent = f
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(HudLayout.MAX_PROMPT_WIDTH, math.huge)
	limit.Parent = f
	f.Parent = parent
	return f
end

function Hud.new(playerGui: Instance): any
	-- The centre dot must be at the true viewport centre (the camera's aim ray), so this layer ignores the insets.
	local centre = Instance.new("ScreenGui")
	centre.Name = "SpiderHud"
	centre.ResetOnSpawn = false
	centre.IgnoreGuiInset = true
	centre.ScreenInsets = Enum.ScreenInsets.None
	centre.Parent = playerGui
	local reticle = Instance.new("Frame")
	reticle.Name = "Reticle"
	reticle.AnchorPoint = Vector2.new(0.5, 0.5)
	reticle.Position = UDim2.fromScale(0.5, 0.5)
	reticle.Size = UDim2.fromOffset(6, 6)
	reticle.BackgroundColor3 = Color3.new(1, 1, 1)
	reticle.Visible = false
	corner(reticle, 3)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 1.5
	stroke.Parent = reticle
	reticle.Parent = centre
	local ticks: { Frame } = {}
	for i, off in { Vector2.new(-16, 0), Vector2.new(16, 0), Vector2.new(0, -16), Vector2.new(0, 16) } do
		local t = Instance.new("Frame")
		t.AnchorPoint = Vector2.new(0.5, 0.5)
		t.Position = UDim2.new(0.5, off.X, 0.5, off.Y)
		t.Size = if i <= 2 then UDim2.fromOffset(8, 2) else UDim2.fromOffset(2, 8)
		t.BackgroundColor3 = Color3.new(1, 1, 1)
		t.BorderSizePixel = 0
		t.Visible = false
		t.Parent = centre
		ticks[i] = t
	end
	local aimBox = Instance.new("Frame")
	aimBox.Name = "AimBox"
	aimBox.BackgroundTransparency = 1
	aimBox.AnchorPoint = Vector2.new(0.5, 0)
	aimBox.Position = UDim2.new(0.5, 0, 0.5, 24)
	aimBox.Size = UDim2.fromOffset(0, 0)
	aimBox.AutomaticSize = Enum.AutomaticSize.XY
	local aimList = Instance.new("UIListLayout")
	aimList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	aimList.SortOrder = Enum.SortOrder.LayoutOrder
	aimList.Padding = UDim.new(0, 3)
	aimList.Parent = aimBox
	aimBox.Parent = centre
	local aimTitle = pill("AimTitle", aimBox, 18, 1)
	local aimHint = pill("AimHint", aimBox, 15, 2)
	local anchorLabel = pill("Anchor", aimBox, 14, 3)

	-- Everything else: inside the safe area.
	local safe = Instance.new("ScreenGui")
	safe.Name = "SpiderPrompts"
	safe.ResetOnSpawn = false
	safe.IgnoreGuiInset = false
	safe.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	safe.Parent = playerGui
	local top = column("Top", safe, Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 8), Enum.VerticalAlignment.Top)
	local status = wrapLabel("Status", top, 16, 1)
	local toast = wrapLabel("Toast", top, 17, 2)
	local help = wrapLabel("Controls", top, 15, 3)
	help.TextXAlignment = Enum.TextXAlignment.Left
	local panel = Instance.new("Frame")
	panel.Name = "PromptPanel"
	panel.BackgroundTransparency = 1
	panel.AnchorPoint = Vector2.new(0, 1)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	local plist = Instance.new("UIListLayout")
	plist.HorizontalAlignment = Enum.HorizontalAlignment.Center
	plist.VerticalAlignment = Enum.VerticalAlignment.Bottom
	plist.SortOrder = Enum.SortOrder.LayoutOrder
	plist.Padding = UDim.new(0, 4)
	plist.Parent = panel
	panel.Parent = safe
	local promptTitle = wrapLabel("PromptTitle", panel, 17, 1)
	promptTitle.Font = Enum.Font.GothamBold
	local promptHint = wrapLabel("PromptHint", panel, 16, 2)
	local promptCue = wrapLabel("PromptCue", panel, 16, 3)
	promptCue.TextColor3 = WARN_COLOR
	local self = setmetatable({
		centre = centre, safe = safe, reticle = reticle, ticks = ticks,
		aimTitle = aimTitle, aimHint = aimHint, anchorLabel = anchorLabel,
		status = status, toastLabel = toast, help = help,
		panel = panel, promptTitle = promptTitle, promptHint = promptHint, promptCue = promptCue,
		toastLeft = 0, device = "keyboard", lastSpan = "",
	}, Hud)
	return self
end

function Hud.toast(self: any, text: string, warn: boolean?)
	if text == "" then return end
	self.toastLabel.Text = text
	self.toastLabel.TextColor3 = if warn then WARN_COLOR else OK_COLOR
	self.toastLabel.Visible = true
	self.toastLeft = TOAST_SECONDS
end

local function show(label: TextLabel, text: string?)
	local t = text or ""
	if label.Text ~= t then label.Text = t end
	label.Visible = t ~= ""
end

-- Places the prompt panel for the safe area's size and the device (HudLayout.promptSpan).
function Hud._place(self: any)
	local size = self.safe.AbsoluteSize
	local x0, x1, bottom = HudLayout.promptSpan(size.X, size.Y, self.device)
	local key = string.format("%.1f,%.1f,%.1f", x0, x1, bottom)
	if key == self.lastSpan then return end
	self.lastSpan = key
	-- Anchored to the safe area's bottom edge (scale 1), so the panel's gap above the bottom holds even if the reported size
	-- and the children's origin disagree about an inset.
	self.panel.Position = UDim2.new(0, x0, 1, bottom - size.Y)
	self.panel.Size = UDim2.fromOffset(math.max(x1 - x0, 0), 0)
end

-- view: device, aiming, focus, eyeView, aimTitle, aimHint, aimColor, anchorText, anchorOk, status ({string}),
-- prompt ({title, hint, cue} or nil), helpVisible, helpText.
function Hud.update(self: any, view: any, dt: number)
	self.device = view.device
	self:_place()
	self.reticle.Visible = view.aiming or view.focus or view.eyeView
	for _, t in self.ticks do t.Visible = view.focus == true end
	show(self.aimTitle, view.aimTitle)
	if view.aimColor then self.aimTitle.TextColor3 = view.aimColor end
	show(self.aimHint, view.aimHint)
	show(self.anchorLabel, view.anchorText)
	self.anchorLabel.TextColor3 = if view.anchorOk then OK_COLOR else WARN_COLOR
	show(self.status, table.concat(view.status or {}, "\n"))
	local prompt = view.prompt
	show(self.promptTitle, if prompt then prompt.title else nil)
	show(self.promptHint, if prompt then prompt.hint else nil)
	show(self.promptCue, if prompt then prompt.cue else nil)
	if view.helpVisible then show(self.help, view.helpText) else show(self.help, nil) end
	if self.toastLeft > 0 then
		self.toastLeft -= dt
		if self.toastLeft <= 0 then self.toastLabel.Visible = false end
	end
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">SpiderInput</string>
            <string name="Source"><![CDATA[--!strict
-- One action path for keyboard, mouse, gamepad and held on-screen touch buttons, all at once.
-- Bindings follow the frozen Godot game's scripts/core/input_setup.gd wherever the action exists in the port:
--   walk WASD / left stick (D-pad too), look mouse / arrow keys / right stick / touch drag, creep Shift / LB,
--   jump Space / A (tap hop, hold aim, release leap), cancel Q / B (cancels an aim or a walk to the edge; held on the
--   line it lets go), focus right mouse / LT, spider-eye view V / Y, recenter R / middle mouse / right-stick click,
--   slow motion T / RT, lower on silk F / X (Godot: F / D-pad down; the port keeps the D-pad for walking, ROBLOX-05).
--   Esc / Menu open Roblox's own menu: the game drops every press and hold and waits (Godot's pause).
-- Port-only: reset to the start Backspace / View (Select), gait toggle G, controls card H (Godot's H is the field notes).
--
-- Every button action is held while any source holds it (InputState): a key, a controller button, a finger. Handlers hear
-- one "begin" when the first source goes down and one "end" when the last comes up, so a touch hold and a key or button
-- held at the same time never cancel each other.
local CAS = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local InputState = require(Shared:WaitForChild("Movement"):WaitForChild("InputState"))
local HudLayout = require(Shared:WaitForChild("UI"):WaitForChild("HudLayout"))
local SpiderInput = {}

export type Handlers = {
	focus: ((string) -> ())?,
	jump: (string) -> (), -- "begin", "end", or "cancel" (the engine took the input away)
	cancel: (string) -> (),
	drop: () -> (),
	clear: () -> (), -- focus loss, the Roblox menu, a text box, a lost controller
	reset: () -> (),
	gait: () -> (),
	eye: () -> (),
	recenter: () -> (),
	slow: () -> (),
	help: () -> (),
	touchLook: (Vector2) -> (),
	device: ((string) -> ())?, -- the last input's UserInputType name
}

local ONE_SHOT = { Reset = "reset", Gait = "gait", Eye = "eye", Recenter = "recenter", Slow = "slow", Help = "help" }

-- Bindings by action. Exported for tests and the controls table in README.md.
SpiderInput.BINDINGS = {
	Forward = { Enum.KeyCode.W, Enum.KeyCode.DPadUp }, Back = { Enum.KeyCode.S, Enum.KeyCode.DPadDown },
	Left = { Enum.KeyCode.A, Enum.KeyCode.DPadLeft }, Right = { Enum.KeyCode.D, Enum.KeyCode.DPadRight },
	LookLeft = { Enum.KeyCode.Left }, LookRight = { Enum.KeyCode.Right }, LookUp = { Enum.KeyCode.Up }, LookDown = { Enum.KeyCode.Down },
	Jump = { Enum.KeyCode.Space, Enum.KeyCode.ButtonA }, Cancel = { Enum.KeyCode.Q, Enum.KeyCode.ButtonB },
	Drop = { Enum.KeyCode.F, Enum.KeyCode.ButtonX },
	Creep = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL1 },
	Focus = { Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2 },
	Eye = { Enum.KeyCode.V, Enum.KeyCode.ButtonY },
	Recenter = { Enum.KeyCode.R, Enum.UserInputType.MouseButton3, Enum.KeyCode.ButtonR3 },
	Slow = { Enum.KeyCode.T, Enum.KeyCode.ButtonR2 }, Help = { Enum.KeyCode.H },
	Reset = { Enum.KeyCode.Backspace, Enum.KeyCode.ButtonSelect }, Gait = { Enum.KeyCode.G },
} :: { [string]: { any } }

local function sourceOf(input: InputObject?): any
	if input == nil then return "default" end
	local t = input.UserInputType
	if t == Enum.UserInputType.Touch then return input end -- each finger is its own source
	if t == Enum.UserInputType.Keyboard or string.sub(t.Name, 1, 7) == "Gamepad" then return input.KeyCode end
	return t -- a mouse button
end

function SpiderInput.bind(h: Handlers)
	local state = InputState.new()
	local handlers: { [string]: any } = h :: any
	-- One source of one action went down (down) or up; "cancel" means the engine took the input away (treated as up).
	local function act(action: string, down: boolean, source: any, cancelled: boolean?)
		local was, now = state:set(action, down, source)
		if was == now then return end
		if action == "Jump" then
			h.jump(if now then "begin" elseif cancelled then "cancel" else "end")
		elseif action == "Cancel" then
			h.cancel(if now then "begin" else "end")
		elseif action == "Focus" then
			if h.focus then h.focus(if now then "begin" elseif cancelled then "cancel" else "end") end
		elseif action == "Drop" then
			if now then h.drop() end
		elseif ONE_SHOT[action] then
			if now then handlers[ONE_SHOT[action]]() end
		end
	end
	for action, keys in SpiderInput.BINDINGS do
		CAS:BindActionAtPriority("Spider" .. action, function(_, phase, input)
			if UIS:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
			if phase == Enum.UserInputState.Begin then
				act(action, true, sourceOf(input))
			elseif phase == Enum.UserInputState.End or phase == Enum.UserInputState.Cancel then
				act(action, false, sourceOf(input), phase == Enum.UserInputState.Cancel)
			end
			return Enum.ContextActionResult.Sink
		end, false, 3000, table.unpack(keys))
	end
	CAS:BindActionAtPriority("SpiderStick", function(_, phase, input)
		if phase == Enum.UserInputState.Cancel or UIS:GetFocusedTextBox() then state:stick(0, 0)
		else state:stick(input.Position.X, input.Position.Y) end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Thumbstick1)
	CAS:BindActionAtPriority("SpiderLookStick", function(_, phase, input)
		if phase == Enum.UserInputState.Cancel or UIS:GetFocusedTextBox() then state:look(0, 0)
		else state:look(input.Position.X, input.Position.Y) end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Thumbstick2)

	-- Roblox's own touch thumbstick and jump button would sit under ours: this game has its own touch controls.
	pcall(function() GuiService.TouchControlsEnabled = false end)
	local gui = Instance.new("ScreenGui")
	gui.Name = "SpiderTouch"
	gui.ResetOnSpawn = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets -- clear of notches, the home bar and Roblox's top bar
	gui.Enabled = UIS.TouchEnabled
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local active: { [InputObject]: string } = {}
	local buttons: { [string]: TextButton } = {}
	local function clear()
		state:clear()
		table.clear(active)
		h.clear()
	end
	local function button(action: string, label: string, position: UDim2, size: number, textSize: number?)
		local b = Instance.new("TextButton")
		b.Name = action
		b.Text = label
		b.TextSize = textSize or 18
		b.TextWrapped = true
		b.TextColor3 = Color3.new(1, 1, 1)
		b.BackgroundColor3 = Color3.new(0.06, 0.06, 0.06)
		b.BackgroundTransparency = 0.15
		b.Size = UDim2.fromOffset(size, size)
		b.Position = position
		b.AutoButtonColor = true
		b.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 14)
		corner.Parent = b
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				active[input] = action
				act(action, true, input)
			end
		end)
		buttons[action] = b
	end
	-- Left thumb: walking. Right thumb: jump (largest, nearest the corner), cancel / let go beside it, then creep, silk,
	-- recenter and the eye view further in. Offsets from the safe area's bottom corners (HudLayout, checked in tests).
	for _, b in HudLayout.TOUCH_BUTTONS do
		button(b.action, b.label, if b.right then UDim2.new(1, b.x, 1, b.y) else UDim2.new(0, b.x, 1, b.y), b.size, b.textSize)
	end
	UIS.InputEnded:Connect(function(input)
		local action = active[input]
		if action then
			active[input] = nil
			act(action, false, input)
		end
	end)
	-- Touch look: a drag anywhere that is not on a button turns the view (Roblox marks button touches processed).
	UIS.TouchMoved:Connect(function(input, processed)
		if not processed and not active[input] then h.touchLook(Vector2.new(input.Delta.X, input.Delta.Y)) end
	end)
	UIS.WindowFocusReleased:Connect(clear)
	UIS.TextBoxFocused:Connect(clear)
	UIS.GamepadDisconnected:Connect(clear)
	GuiService.MenuOpened:Connect(clear)
	UIS:GetPropertyChangedSignal("TouchEnabled"):Connect(function() gui.Enabled = UIS.TouchEnabled end)
	local deviceHandler = h.device
	if deviceHandler then
		UIS.LastInputTypeChanged:Connect(function(t: Enum.UserInputType) deviceHandler(t.Name) end)
	end

	-- The client relabels and shows/hides touch buttons with the state (the Cancel button is Let go on the line).
	local api: any = state
	function api.setTouchLabel(_self: any, action: string, text: string)
		local b = buttons[action]
		if b and b.Text ~= text then b.Text = text end
	end
	function api.setTouchVisible(_self: any, action: string, visible: boolean)
		local b = buttons[action]
		if b and b.Visible ~= visible then
			b.Visible = visible
			if not visible then
				for input, a in active do
					if a == action then
						active[input] = nil
						act(action, false, input)
					end
				end
			end
		end
	end
	api.touchGui = gui
	-- The test place's playback drives the same path a key, button or finger takes (tests/client/SilkPlayback.luau).
	function api.simulate(_self: any, action: string, down: boolean, source: any?)
		act(action, down, source or "playback")
	end
	return api
end
return SpiderInput
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">WorldDetail</string>
            <string name="Source"><![CDATA[--!strict
-- The low-detail tier of the world, applied on one client: phones and tablets drop what the server built for the full tier
-- (anything carrying the attribute FullOnly: bloom, sun rays, clouds, light shafts, the small details, the busier part of the
-- view) and get a thinner dust. Only this client's copy changes; the server and other players keep theirs.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Graphics = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Data"):WaitForChild("Graphics"))

local WorldDetail = {}

-- detail: "full" or "low". roots: the places the server put optional things in (Decor, Lighting, Terrain). Returns how many
-- instances it removed.
function WorldDetail.apply(detail: string, roots: { Instance }): number
	if detail ~= "low" then return 0 end
	local scale = Graphics.tiers.low.dustRate
	local doomed: { Instance } = {}
	for _, root in roots do
		if root:GetAttribute("FullOnly") == true then
			table.insert(doomed, root)
		else
			for _, d in root:GetDescendants() do
				if d:GetAttribute("FullOnly") == true then
					table.insert(doomed, d)
				elseif d:IsA("ParticleEmitter") and d:GetAttribute("Dust") == true and d:GetAttribute("Thinned") ~= true then
					d.Rate = d.Rate * scale
					d:SetAttribute("Thinned", true)
				end
			end
		end
	end
	for _, d in doomed do d:Destroy() end
	return #doomed
end

return WorldDetail
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">SilkPlayback</string>
            <string name="Source"><![CDATA[--!strict
-- Included only in tests.project.json. Drives the real player controller, not a duplicate motor.
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
return function(driver: any)
	local rows={}
	local function untilState(predicate,seconds)
		local deadline=os.clock()+seconds
		repeat RunService.Heartbeat:Wait(); if predicate(driver.get()) then return true end until os.clock()>=deadline
		return false
	end
	local function check(name,fn)
		local ok,err=pcall(fn)
		local row={name=name,passed=ok,detail=if ok then "" else tostring(err)}
		table.insert(rows,row)
		print("PORT_CLIENT_ROW "..HttpService:JSONEncode({evidence_id=workspace:GetAttribute("PortEvidence"),result=row}))
	end
	check("player walks to edge and hangs",function()
		driver.place(Vector3.new(-1,4.51,0))
		driver.drop()
		assert(driver.get().walking,"did not start edge walk")
		assert(untilState(function(s) return s.line=="locked" and s.taut and s.position.Y<3.9 end,12),"no hanging state")
	end)
	check("held lower reaches sill floor",function()
		driver.input:set("Drop",true)
		assert(untilState(function(s) return s.mode=="attached" and s.position.Y<0.4 end,15),"did not land on sill")
		driver.input:set("Drop",false)
	end)
	check("player reels back to leaf",function()
		driver.place(Vector3.new(-1,4.51,0)); driver.drop()
		assert(untilState(function(s) return s.line=="locked" and s.taut end,12),"no line")
		driver.input:set("Forward",true)
		assert(untilState(function(s) return s.mode=="attached" and s.position.Y>3.5 end,12),"no leaf recovery")
		driver.input:set("Forward",false)
	end)
	-- ROBLOX-08 controls through the real client: the same path a key, button or finger takes (SpiderInput.simulate).
	local function wait(seconds: number)
		local t=os.clock()+seconds
		repeat RunService.Heartbeat:Wait() until os.clock()>=t
	end
	check("a tap of Jump hops forward",function()
		driver.place(Vector3.new(-22,0.31,6)); wait(0.2)
		local start=driver.get().position
		driver.input:simulate("Jump",true); RunService.Heartbeat:Wait(); driver.input:simulate("Jump",false)
		assert(untilState(function(s) return s.mode=="air" end,1),"no hop")
		assert(untilState(function(s) return s.mode=="attached" end,3),"did not land")
		local moved=(driver.get().position-start).Magnitude
		assert(moved>1.2 and moved<1.8,`hopped {moved}`)
	end)
	check("Q during an aim cancels it and the release does not leap",function()
		driver.place(Vector3.new(-22,0.31,6)); wait(0.2)
		local start=driver.get().position
		driver.input:simulate("Jump",true); wait(0.4)
		assert(driver.jump:isAiming(),"no aim after a 0.4 s hold")
		driver.input:simulate("Cancel",true); wait(0.05); driver.input:simulate("Cancel",false); wait(0.05)
		driver.input:simulate("Jump",false); wait(0.4)
		assert(driver.get().mode=="attached" and (driver.get().position-start).Magnitude<0.05,"leapt after a cancel")
		assert(driver.jump.last and driver.jump.last.kind=="cancelled","no cancel recorded")
	end)
	check("a key and a finger hold Cancel together; only a deliberate hold lets go of the line",function()
		driver.place(Vector3.new(-1,4.51,0)); driver.drop()
		assert(untilState(function(s) return s.line=="locked" and s.taut end,12),"no hang")
		wait(0.6)
		driver.input:simulate("Cancel",true,"touch")
		driver.input:simulate("Cancel",true,Enum.KeyCode.Q)
		wait(0.25)
		driver.input:simulate("Cancel",false,"touch")
		assert(driver.input.held.Cancel==true and driver.get().line=="locked","releasing the finger dropped the key's hold")
		assert(untilState(function(s) return s.line=="none" end,1.5),"a held Q did not let go")
		driver.input:simulate("Cancel",false,Enum.KeyCode.Q)
		assert(untilState(function(s) return s.mode=="attached" end,6),"did not land after letting go")
	end)
	check("on the line the prompts name each device's controls, wrap and stay on screen; the camera never rolls",function()
		driver.place(Vector3.new(-1,4.51,0)); driver.drop()
		assert(untilState(function(s) return s.line=="locked" and s.taut end,12),"no hang")
		local gui=game:GetService("Players").LocalPlayer.PlayerGui:WaitForChild("SpiderPrompts") :: ScreenGui
		local panel=gui:WaitForChild("PromptPanel") :: Frame
		local expected: {[string]: string}={keyboard="hold Q: let go",gamepad="hold B: let go",touch="hold Let go: let go"}
		for device,word in expected do
			driver.setDevice(device); wait(0.15)
			local hint=panel:FindFirstChild("PromptHint") :: TextLabel
			assert(hint.Visible and string.find(hint.Text,word,1,true),`{device}: "{hint.Text}"`)
			assert(hint.TextFits,`{device}: the hint does not fit`)
			local a,b,screen=panel.AbsolutePosition,panel.AbsoluteSize,workspace.CurrentCamera.ViewportSize
			assert(a.X>=0 and a.Y>=0 and a.X+b.X<=screen.X+1 and a.Y+b.Y<=screen.Y+1,`{device}: panel off screen ({a}, {b} in {screen})`)
		end
		driver.setDevice("keyboard")
		local overlap=OverlapParams.new(); overlap.FilterType=Enum.RaycastFilterType.Include; overlap.FilterDescendantsInstances={driver.sill}
		local deadline=os.clock()+1.5
		driver.input:simulate("Forward",true)
		repeat
			RunService.Heartbeat:Wait()
			local cf=workspace.CurrentCamera.CFrame
			assert(math.abs(cf.RightVector.Y)<1e-4,"the camera rolled")
			assert(#workspace:GetPartBoundsInRadius(cf.Position,0.05,overlap)==0,"the camera is inside the sill")
		until os.clock()>deadline
		driver.input:simulate("Forward",false)
	end)
	check("Focus toggle respects cancel ownership and ends off surface",function()
		local player=game:GetService("Players").LocalPlayer
		driver.place(Vector3.new(-22,0.31,6)); wait(0.2)
		player:SetAttribute("FocusToggle",true)
		driver.input:simulate("Focus",true); driver.input:simulate("Focus",false); wait(0.1)
		assert(driver.focusState.latched,"toggle did not latch")
		driver.input:simulate("Jump",true); wait(0.3)
		driver.input:simulate("Cancel",true); driver.input:simulate("Cancel",false); wait(0.1)
		assert(driver.focusState.latched,"aim cancel also cleared Focus")
		driver.input:simulate("Jump",false); wait(0.1)
		driver.input:simulate("Cancel",true); driver.input:simulate("Cancel",false); wait(0.1)
		assert(not driver.focusState.latched,"idle cancel did not clear Focus")
		driver.input:simulate("Focus",true); driver.input:simulate("Focus",false)
		driver.input:simulate("Jump",true); RunService.Heartbeat:Wait(); driver.input:simulate("Jump",false)
		assert(untilState(function(s) return s.mode=="air" end,1))
		assert(not driver.focusState.latched,"Focus remained latched in air")
		player:SetAttribute("FocusToggle",false)
	end)
	check("live client sensor and drawer classify the labeled stage marker",function()
		assert(driver.stage,"test stage missing")
		driver.input:clear(); driver.sensor:reset(); driver.memory:clear()
		driver.stage.target.frozen=true
		driver.stage.target.position=Vector3.new(-28,2.8,-10)
		driver.stage.target.velocity=Vector3.zero
		driver.place(Vector3.new(-26,2.31,-3.5))
		local d=driver.stage.target.position-driver.motor.pos
		driver.motor.heading=Vector3.new(d.X,0,d.Z).Unit
		driver.camera:snap()
		assert(untilState(function() local c=driver.memory:getContact(driver.sensor:trackIdFor("test_target")); return c and c.category=="fly_like_prey" end,4),"no classified client contact")
		wait(0.2)
		local v=driver.perceptionHud.view
		assert(v and #v.labels>0 and v.labels[1].text=="fly-like prey","drawer has no classification")
		driver.stage.target.frozen=false
	end)
	local passed=0
	for _,row in rows do if row.passed then passed+=1 end end
	print("PORT_CLIENT_REPORT "..HttpService:JSONEncode({evidence_id=workspace:GetAttribute("PortEvidence"),tests=#rows,passed=passed,failed=#rows-passed,results=rows}))
	print("PORT_CLIENT_SUMMARY "..HttpService:JSONEncode({evidence_id=workspace:GetAttribute("PortEvidence"),tests=#rows,passed=passed,failed=#rows-passed}))
	driver.input:clear()
	-- Leave a recoverable hanging pose for visual inspection in the test place.
	driver.place(Vector3.new(-26,2.31,-3.5)); driver.motor.heading=-Vector3.zAxis; driver.camera:snap()
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="70">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">35</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>