its own direction it took away)\n\t\tlocal length=motion.Magnitude\n\t\tself.stats.stops+=1\n\t\tif length>1e-9 then self.stats.stopped+=math.max(0,length-(p-position):Dot(motion/length)) end\n\tend\n\t-- While lowering alongside the launch wall, a nearly tangent native sweep can\n\t-- miss a shallow contact. Maintain the wall's skin without grabbing it again.\n\t-- Other faces still use the swept landing rules above.\n\tif self.lowering and math.abs(self.normal.Y)<0.707 then\n\t\tlocal face=workspace:Raycast(p,-self.normal*(RADIUS+0.01),self.params)\n\t\tif face and face.Normal:Dot(self.normal)>0.99 then\n\t\t\tlocal clearance=(p-face.Position):Dot(face.Normal)\n\t\t\tif clearance<RADIUS+0.01 then\n\t\t\t\tp+=face.Normal*(RADIUS+0.01-clearance)\n\t\t\t\tvelocity-=face.Normal*math.min(0,velocity:Dot(face.Normal))\n\t\t\tend\n\t\tend\n\tend\n\tlocal touched\n\tp,velocity,touched=self:unstick(p,velocity,intent)\n\tif touched then return p,Vector3.zero,touched end\n\treturn p,velocity,nil\nend\nfunction Silk.step(self: any, position: Vector3, velocity: Vector3, intent: number, releaseDown: boolean)\n\tif self.mode~=\"locked\" or not self:refresh() then return position,velocity,nil end\n\tlocal stats=self.stats\n\tstats.ticks+=1\n\tif Math.releaseTick(self.release,true,releaseDown) then\n\t\tself:clear(); self.message=\"Silk released\"; return position,velocity,nil\n\tend\n\tif intent<=0 and self.block==\"blocked\" then self.block=\"\" end\n\tlocal oldRest=self.rest\n\t-- (ROBLOX-99: letting down runs at the game's lowering speed, reeling in at Godot's; both are the reel speed until useGameRules.)\n\tif intent<0 or (self.block==\"\" and not self.snagged) then self.rest=Math.reel(self.rest,self:prefix(),self.maximum,intent,if intent<0 then self.lowerSpeed else self.speed) end\n\t-- \"Shortest\" only when a reel actually ran and could not shorten (Godot sets it inside its not-snagged reel branch);\n\t-- a snag while swinging under a leaf must not leave reeling refused once the line is clear again (ROBLOX-10).\n\tif intent>0 and not self.snagged and self.rest>=oldRest-1e-6 and self.block==\"\" then self.block=\"shortest\" end\n\tif intent<0 and self.rest>oldRest then self.block=\"\"; stats.letOut+=self.rest-oldRest end\n\tlocal p=position\n\t-- A padded bend can leave the shortest line just below the lip. Acquire a nearby\n\t-- real face with the legs (0.6 stud reach), never through an intervening obstacle.\n\tif intent>0 and self.block==\"shortest\" and not self.snagged then\n\t\tfor _,direction in {self:pivot()-p,Vector3.yAxis,-self.normal} do\n\t\t\tif direction.Magnitude>1e-6 then\n\t\t\t\tlocal face=workspace:Raycast(p,direction.Unit*0.6,self.params)\n\t\t\t\tlocal profile=self:profile(face)\n\t\t\t\tif face and profile and profile.attachable then\n\t\t\t\t\tlocal seat=face.Position+face.Normal*HEIGHT\n\t\t\t\t\tlocal motion=seat-p\n\t\t\t\t\tlocal obstacle=if motion.Magnitude>1e-7 then workspace:Spherecast(p,RADIUS,motion,self.params) else nil\n\t\t\t\t\tif not obstacle or obstacle.Instance==face.Instance then return seat,Vector3.zero,face end\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tif self.rest<oldRest then\n\t\tlocal excess=self:path(p)-self.rest\n\t\tif excess>1e-6 then\n\t\t\tlocal hit\n\t\t\tp,velocity,hit=self:move(p,(self:pivot()-p).Unit*excess,velocity,intent)\n\t\t\tif hit then return p,velocity,hit end\n\t\t\tif self:path(p)>self.rest+1e-4 then self.rest=math.min(self:path(p),self.maximum); self.block=\"blocked\" end\n\t\tend\n\tend\n\tlocal energy=Math.energy(p,velocity,self.gravity)\n\tvelocity+=DOWN*self.gravity*Math.DT\n\tif self.taut and (p-self:pivot()).Magnitude>1e-6 then\n\t\tlocal r=(p-self:pivot()).Unit\n\t\tvelocity-=(velocity-r*velocity:Dot(r))*(1-math.exp(-Math.DAMPING*Math.DT))\n\tend\n\tlocal c=Math.constrain(self:pivot(),math.max(self.rest-self:prefix(),0),p+velocity*Math.DT,velocity)\n\tlocal hit\n\tp,velocity,hit=self:move(p,c.position-p,c.velocity,intent)\n\tif hit then return p,velocity,hit end\n\tlocal over=self:path(p)-self.rest\n\tif over>1e-4 then\n\t\tp,velocity,hit=self:move(p,(self:pivot()-p).Unit*over,velocity,intent)\n\t\tif hit then return p,velocity,hit end\n\tend\n\tself:geometry(p)\n\tif Math.energy(p,velocity,self.gravity)>energy+1e-6 then\n\t\tlocal ke=0.5*velocity:Dot(velocity)\n\t\tvelocity*=if ke>1e-12 then math.sqrt(math.clamp((energy-self.gravity*p.Y)/ke,0,1)) else 0\n\tend\n\tstats.fell+=position.Y-p.Y\n\tlocal path=self:path(p)\n\tself.paid=math.min(math.max(self.paid,path),self.rest)\n\tself.taut=path>=self.rest-0.003\n\tself.message=if self.snagged then \"Silk snagged — lower or let go\" elseif self.block==\"blocked\" then \"Reel blocked — lower or let go\"\n\t\telseif self.block==\"shortest\" then \"At the shortest line\" elseif intent>0 then \"Reeling in\" elseif intent<0 then \"Lowering\" else \"Hanging on silk\"\n\treturn p,velocity,nil\nend\nreturn Silk\n",18959,615598198},{"Shared/Movement/SpiderMotor","--!strict\n-- The spider's body on the windowsill: a kinematic port of the frozen Godot motor's core (scripts/movement/spider_motor.gd,\n-- jump_planner.gd and the jump/line parts of player_controller.gd and tether_controller.gd, c87ce00). It walks on any\n-- attachable surface (floor, walls, undersides, over edges), plans hops and aimed leaps with the shared JumpMath at a fixed\n-- 60 Hz tick, flies them, pays out a safety line from silk-holding ground (SilkController: catch, hang, reel, lower,\n-- edge-first lowering, deliberate let-go) and reports line events for the HUD.\n--\n-- No input devices, camera or drawing here: the client passes a TickInput each fixed tick and an aim ray, so Studio specs\n-- (tests/studio/RecoverySpec.luau) run the same motor deterministically, tick by tick, against real geometry. Engine\n-- queries only: Workspace raycasts, sphere casts and one overlap query (the room probe).\n--\n-- The eyes (D-036, spider_motor.gd get_eye_position, get_gaze_direction, get_body_gaze_direction, set_scan_direction, _update_gaze): the\n-- senses read the observer() of the body, never the camera. The eyes sit EYE_FORWARD along the facing and EYE_UP along the body's up; the\n-- gaze is the facing tilted by the gaze pitch, which follows Focus (at the focus rate, up to the species' gaze limit) and settles to the\n-- support plane at half that rate; in the spider-eye view the principal eyes' retinas may point the inspection up to PRINCIPAL_SCAN_DEG\n-- off the body's gaze. The camera alone never moves the cone: only Focus and moving do.\nlocal JumpMath = require(script.Parent.JumpMath)\nlocal SupportMath = require(script.Parent.SupportMath)\nlocal SilkController = require(script.Parent.SilkController)\n\nlocal Motor = {}\nMotor.__index = Motor\n\nlocal DT = 1 / 60\nMotor.DT = DT\nMotor.RUN_MULTIPLIER = 2 -- faster ground travel; jumps and the safety line retain their own speeds\nMotor.HEIGHT = 0.31 -- body centre above the support plane: radius 0.3 + skin 0.01 (Godot seat distance)\nlocal HEIGHT = Motor.HEIGHT\nlocal SWEEP_RADIUS = 0.303 -- body radius + JumpPlanner.SWEEP_MARGIN\nlocal TURN_RATE = math.rad(540)\nlocal FOCUS_RATE = math.rad(180) -- Godot FOCUS_TURN_FALLBACK_DEG_S\nlocal PREPARE_TURN_RATE = math.rad(360) -- SpiderMotor.PREPARE_TURN_RATE_DEG_S: cosmetic turn toward the aim point\nlocal AIM_RANGE = 60\nMotor.AIM_RANGE = AIM_RANGE\nlocal HOP_DISTANCE = 1.5\nlocal HOP_PROBE_UP, HOP_PROBE_DOWN = 0.5, 1.2\nlocal MAX_DRIFT = 0.15\nlocal CONTACT_EXTRA_STEPS = 8\nlocal EYE_TURN_START_DEG, EYE_TURN_STOP_DEG = 30, 4 -- CameraMath.PRINCIPAL_SCAN_DEG, EYE_SETTLE_DEG\n-- T10a: how far either way of the body's gaze the principal eyes' retinas can point the sharp field (the scan direction).\nMotor.PRINCIPAL_SCAN_DEG = 30\nlocal PRINCIPAL_SCAN = math.rad(Motor.PRINCIPAL_SCAN_DEG)\n-- Where the eyes are: from the body centre along the facing and along the body's up. Both inside the 0.3 WU body, so a ray from the eye\n-- never starts in the world.\nMotor.EYE_FORWARD = 0.18\nMotor.EYE_UP = 0.08\nlocal EYE_FORWARD, EYE_UP = Motor.EYE_FORWARD, Motor.EYE_UP\nlocal GAZE_PITCH_FALLBACK_DEG = 35 -- used when the species profile has no perception section\nlocal FREE_UP_RATE = math.rad(240) -- the drawn up turns to world up while falling or on the line (Godot VISUAL_TURN)\n\nexport type TickInput = {\n\twish: Vector3, -- walking direction on the support plane (unit or zero), from the view\n\tcreep: boolean,\n\trun: boolean?, -- held; creep/lock and an automatic edge walk take priority\n\treel: number, -- on the line: +1 reels in, -1 lowers\n\tdropHeld: boolean, -- F / X / Silk held: lowers on the line\n\treleaseHeld: boolean, -- Q / B / Let go held: a deliberate let-go after the grace\n\tfocusPoint: Vector3?, -- Focus held: the body turns toward this point\n\tfocusDir: Vector3?, -- Focus held: the aim ray's direction, which the gaze tilts toward when the point is within 0.2 WU of the eyes\n\tgaze: Vector3?, -- spider-eye view: the body turns to face a gaze beyond 30 degrees\n\tface: Vector3?, -- the lock's sidestep (ROBLOX-110, Movement/LockOn): walking, the body keeps facing this point instead of turning to the walk\n}\n\nexport type Config = {\n\tworld: Instance,\n\tsurfaces: any,\n\tprofile: any,\n\tspawn: Vector3, -- the support point under the body\n\theading: Vector3,\n\tboundsMin: Vector3,\n\tboundsMax: Vector3,\n\tprobeParent: Instance?,\n\t-- ROBLOX-95: where the play area is, when it is not one box (the world's regions: the client's WorldClient.inBounds). Out of bounds is then outside the box or\n\t-- where this says no; without it, the box alone, as Godot has it.\n\tinBounds: ((Vector3) -> boolean)?,\n}\n\nfunction Motor.idleInput(): TickInput\n\treturn { wish = Vector3.zero, creep = false, reel = 0, dropHeld = false, releaseHeld = false }\nend\n\nfunction Motor.new(config: Config): any\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Include\n\tparams.FilterDescendantsInstances = { config.world }\n\tlocal overlap = OverlapParams.new()\n\toverlap.FilterType = Enum.RaycastFilterType.Include\n\toverlap.FilterDescendantsInstances = { config.world }\n\tlocal probe = Instance.new(\"Part\")\n\tprobe.Name = \"RoomProbe\"\n\tprobe.Shape = Enum.PartType.Ball\n\tprobe.Size = Vector3.one * (SWEEP_RADIUS * 2)\n\tprobe.Anchored = true\n\tprobe.CanCollide = false\n\tprobe.CanQuery = false\n\tprobe.CanTouch = false\n\tprobe.Transparency = 1\n\tprobe.Parent = config.probeParent or workspace\n\tlocal loco = config.profile.locomotion\n\tlocal perception = config.profile.perception\n\tlocal gazeLimitDeg = if perception ~= nil and typeof(perception.gaze_pitch_limit_deg) == \"number\" then perception.gaze_pitch_limit_deg else GAZE_PITCH_FALLBACK_DEG\n\tlocal self = setmetatable({\n\t\tconfig = config,\n\t\tsurfaces = config.surfaces,\n\t\tloco = loco,\n  reachFactor = 1,\n  speedFactor = 1,\n\t\tgravity = Vector3.new(0, -loco.gravity_wu_s2, 0),\n\t\tparams = params,\n\t\toverlap = overlap,\n\t\tprobe = probe,\n\t\tsilk = SilkController.new(config.world, config.surfaces, config.profile.silk, loco.gravity_wu_s2) :: any,\n\t\tmode = \"attached\",\n\t\tseized = false, -- taken by a predator (Motor.seize): the motor stands still and the wasp moves the body\n\t\tpos = config.spawn + Vector3.new(0, HEIGHT, 0),\n\t\tup = Vector3.yAxis,\n\t\theading = config.heading,\n\t\tvel = Vector3.zero,\n\t\tmoving = false,\n\t\tpreparing = false,\n\t\taimTarget = nil :: Vector3?,\n\t\taimOrigin = Vector3.zero,\n\t\taimDirection = -Vector3.zAxis,\n\t\tplanKey = \"\",\n\t\tplan = nil :: any,\n\t\tflightTicks = 0,\n\t\tflightLimit = 0,\n\t\teyeTurning = false,\n\t\tgazePitch = 0, -- how far the gaze is tilted off the support plane, radians, up positive (Godot _gaze_pitch)\n\t\tgazeLimit = math.rad(gazeLimitDeg),\n\t\tscanDir = nil :: Vector3?, -- T10a: where the spider-eye view points the principal eyes (a unit direction); nil: straight ahead\n\t\tfocusOn = false, -- Focus is turning the gaze (held, or the spider-eye view turning the body); Godot is_focusing\n\t\tticks = 0,\n\t\tlineSerial = 0, -- counts lines started, so the drawing knows a new one began\n\t\tafterMiss = false,\n\t\tdropped = false,\n\t\tcaught = false,\n\t\tsafe = { pos = config.spawn + Vector3.new(0, HEIGHT, 0), up = Vector3.yAxis, heading = config.heading },\n\t\tsupportPart = nil :: Instance?, -- the part the spider last took hold of\n\t\tintent = Vector3.zero, -- the walking direction last used, turned with the support at an edge (StickCarry reads it)\n\t\ttransitionSerial = 0, -- counts sharp support turns while walking (concave and convex edges)\n\t\tevents = {} :: { { kind: string, detail: string } },\n\t}, Motor)\n\treturn self\nend\n\nfunction Motor.destroy(self: any)\n\tself.probe:Destroy()\nend\n\nfunction Motor._event(self: any, kind: string, detail: string?)\n\ttable.insert(self.events, { kind = kind, detail = detail or \"\" })\nend\n\n-- The line and jump events since the last call (for the HUD's toasts), oldest first.\nfunction Motor.drainEvents(self: any): { { kind: string, detail: string } }\n\tlocal out = self.events\n\tself.events = {}\n\treturn out\nend\n\nfunction Motor.profileOf(self: any, inst: Instance?): any\n\tif not inst then return nil end\n\tlocal id = inst:GetAttribute(\"ProfileId\")\n\treturn if typeof(id) == \"string\" then self.surfaces[id] else nil\nend\n\nfunction Motor.attachable(self: any, hit: RaycastResult?): boolean\n\tif not hit then return false end\n\tlocal p = self:profileOf(hit.Instance)\n\treturn p ~= nil and p.attachable == true\nend\n\n-- SurfaceProfile.supports: an attachable surface, or any floor flat enough to stand on.\nlocal STAND_COS = math.cos(math.rad(JumpMath.STAND_MAX_DEG)) - 1e-6\nfunction Motor.supports(_self: any, p: any, normal: Vector3): boolean\n\tif p ~= nil and p.attachable then return true end\n\treturn normal.Magnitude > 1e-5 and normal.Unit:Dot(Vector3.yAxis) >= STAND_COS\nend\n\nlocal function rotationBetween(a: Vector3, b: Vector3): CFrame\n\tlocal angle = SupportMath.angleTo(a, b)\n\tif angle < 1e-6 then return CFrame.identity end\n\tlocal axis = a:Cross(b)\n\tif axis:Dot(axis) < 1e-12 then axis = SupportMath.anyPerpendicular(a) end\n\treturn CFrame.fromAxisAngle(axis.Unit, angle)\nend\n\nfunction Motor._setSupport(self: any, hit: RaycastResult)\n\tlocal turn = rotationBetween(self.up, hit.Normal)\n\tself.heading = SupportMath.tangentDir(turn * self.heading, hit.Normal)\n\tif self.heading == Vector3.zero then self.heading = SupportMath.anyPerpendicular(hit.Normal) end\n\tself.up = hit.Normal\n\tself.pos = hit.Position + hit.Normal * HEIGHT\n\tself.supportPart = hit.Instance\nend\n\n-- A sharp turn of the support while walking (a wall ahead, an edge to wrap): the walking direction turns with it, as the\n-- heading does, and the transition is counted so the controls can carry the stick's direction over the edge.\nfunction Motor._transition(self: any, hit: RaycastResult)\n\tlocal turn = rotationBetween(self.up, hit.Normal)\n\tself.intent = SupportMath.tangentDir(turn * self.intent, hit.Normal)\n\tself:_setSupport(hit)\n\tself.transitionSerial += 1\nend\n\nfunction Motor._ray(self: any, from: Vector3, motion: Vector3): RaycastResult?\n\treturn workspace:Raycast(from, motion, self.params)\nend\n\n-- Puts the spider somewhere (a reset, a test fixture). Every line, aim and walk ends.\nfunction Motor.place(self: any, position: Vector3, up: Vector3?, heading: Vector3?)\n\tself.mode = \"attached\"\n\tself.seized = false\n\tself.pos = position\n\tself.up = up or Vector3.yAxis\n\tself.heading = SupportMath.tangentDir(heading or self.config.heading, self.up)\n\tif self.heading == Vector3.zero then self.heading = SupportMath.anyPerpendicular(self.up) end\n\tself.vel = Vector3.zero\n\tself.moving = false\n\tself.intent = Vector3.zero\n\tself.preparing = false\n\tself.aimTarget = nil\n\tself.plan = nil\n\tself.planKey = \"\"\n\tself.gazePitch = 0\n\tself.silk:clear()\n\tself.afterMiss, self.dropped, self.caught = false, false, false\n\tself.safe = { pos = self.pos, up = self.up, heading = self.heading }\nend\n\n-- Back to the start, standing on the support point `spawn` facing `heading` (the config's own when none is given; ROBLOX-94: a rest from another revision of the world\n-- is put back at its region's spawn, Checkpoint.restore).\nfunction Motor.respawn(self: any, spawn: Vector3?, heading: Vector3?)\n\tself:place((spawn or self.config.spawn) + Vector3.new(0, HEIGHT, 0), Vector3.yAxis, heading or self.config.heading)\nend\n\n-- ---------------------------------------------------------------- the planner (port of jump_planner.gd)\nfunction Motor._sweep(self: any, a: Vector3, b: Vector3): Vector3?\n\tlocal d = b - a\n\tif d.Magnitude < 1e-6 then return nil end\n\tlocal hit = workspace:Spherecast(a, SWEEP_RADIUS, d, self.params)\n\treturn if hit then a + d.Unit * hit.Distance else nil\nend\n\nfunction Motor._fits(self: any, center: Vector3): boolean\n\tself.probe.CFrame = CFrame.new(center)\n\treturn #workspace:GetPartsInPart(self.probe, self.overlap) == 0\nend\n\nfunction Motor._tryCandidate(self: any, origin: Vector3, seat: Vector3, c: any): (boolean, string, { Vector3 }, Vector3?)\n\tlocal G = self.gravity\n\tlocal pts = JumpMath.path(origin, c.velocity, G, DT, c.steps)\n\tfor k = 2, #pts do\n\t\tlocal at = self:_sweep(pts[k - 1], pts[k])\n\t\tif at then\n\t\t\tlocal cut = table.move(pts, 1, k - 1, 1, {})\n\t\t\ttable.insert(cut, at)\n\t\t\treturn false, \"path_blocked\", cut, at\n\t\tend\n\tend\n\tlocal v = JumpMath.velocityAfter(c.velocity, G, DT, c.steps)\n\tlocal p = pts[#pts]\n\tfor _ = 1, CONTACT_EXTRA_STEPS do\n\t\tv += G * DT\n\t\tlocal nextP = p + v * DT\n\t\tlocal at = self:_sweep(p, nextP)\n\t\tif at then\n\t\t\tif (at - seat).Magnitude <= MAX_DRIFT then return true, \"ok\", pts, nil end\n\t\t\treturn false, \"graze\", pts, at\n\t\tend\n\t\tp = nextP\n\tend\n\treturn false, \"graze\", pts, seat\nend\n\n-- A plan for a target surface point (JumpPlanner.plan): kind reachable / obstructed / unreachable / ineligible / none, with\n-- the reason, the drawn path and, when reachable, the launch velocity and ticks. origin is where the body was.\nfunction Motor.planJump(self: any, point: Vector3?, normal: Vector3?, inst: Instance?): any\n\tif not point or not normal then return { kind = \"none\", reason = \"no_target\" } end\n\tlocal loco = self.loco\n\tlocal plan: any = { point = point, normal = normal, seat = point + normal * HEIGHT, kind = \"unreachable\", reason = \"\", origin = self.pos }\n\tif not self:supports(self:profileOf(inst), normal) then\n\t\tplan.kind, plan.reason = \"ineligible\", \"ineligible_surface\"\n\t\treturn plan\n\tend\n\tlocal solved = JumpMath.solve(self.pos, plan.seat, self.up, normal, self.gravity, DT, loco.flight_time_min_s, math.max(loco.flight_time_min_s,loco.flight_time_max_s*math.sqrt(self.reachFactor)), loco.max_launch_speed_wu_s*math.sqrt(self.reachFactor))\n\tif #solved.valid == 0 then\n\t\tplan.reason = solved.reason\n\t\treturn plan\n\tend\n\tif not self:_fits(plan.seat) then\n\t\tplan.kind, plan.reason = \"obstructed\", \"no_room\"\n\t\tplan.path = JumpMath.path(self.pos, solved.valid[1].velocity, self.gravity, DT, solved.valid[1].steps)\n\t\tplan.blockedAt = plan.seat\n\t\treturn plan\n\tend\n\tlocal firstPath, firstAt, anyBlocked = nil, nil, false\n\tfor _, c in solved.valid do\n\t\tlocal ok, why, path, at = self:_tryCandidate(self.pos, plan.seat, c)\n\t\tif ok then\n\t\t\tplan.kind, plan.reason, plan.path, plan.velocity, plan.steps = \"reachable\", \"ok\", path, c.velocity, c.steps\n\t\t\treturn plan\n\t\tend\n\t\tif not firstPath then firstPath, firstAt = path, at end\n\t\tif why == \"path_blocked\" then anyBlocked = true end\n\tend\n\tplan.path, plan.blockedAt = firstPath, firstAt\n\tplan.kind, plan.reason = if anyBlocked then \"obstructed\" else \"unreachable\", if anyBlocked then \"path_blocked\" else \"graze\"\n\treturn plan\nend\n\n-- The aim ray the client last gave (the camera's centre ray).\nfunction Motor.setAimRay(self: any, origin: Vector3, direction: Vector3)\n\tself.aimOrigin, self.aimDirection = origin, direction\nend\n\n-- The aim: whatever the centre ray meets (no target magnet). Re-planned only when the aim or the spider moves.\n-- Frozen JumpPlanner.configure: scale speed and maximum flight time by sqrt(reach), never gravity or the collider.\nfunction Motor.setReachFactor(self: any, reach: number)\n if self.reachFactor==reach then return end\n self.reachFactor=math.clamp(reach,0.1,10)\n self.planKey=\"\";self.plan=nil\nend\n\nfunction Motor.setSpeedFactor(self: any, speed: number)\n self.speedFactor=math.clamp(speed,0.1,1)\nend\n\n-- Opt in to the game's own rules on the line (ROBLOX-99, SilkController.game): the let-down at half Godot's reel speed. A motor never given them replays Godot.\nfunction Motor.useGameRules(self: any)\n self.silk:useGameRules()\nend\n\nfunction Motor.aimPlan(self: any): any\n\tlocal hit = self:_ray(self.aimOrigin, self.aimDirection * AIM_RANGE)\n\tlocal key = if hit\n\t\tthen string.format(\"%.3f,%.3f,%.3f|%.3f,%.3f,%.3f|%.3f,%.3f,%.3f|%.3f,%.3f,%.3f\", hit.Position.X, hit.Position.Y, hit.Position.Z, hit.Normal.X, hit.Normal.Y, hit.Normal.Z, self.pos.X, self.pos.Y, self.pos.Z, self.up.X, self.up.Y, self.up.Z)\n\t\telse \"none\"\n\tif key ~= self.planKey or not self.plan then\n\t\tself.planKey = key\n\t\tself.plan = if hit then self:planJump(hit.Position, hit.Normal, hit.Instance) else self:planJump(nil, nil, nil)\n\tend\n\tif self.preparing then\n\t\tself.aimTarget = if hit then hit.Position else nil\n\tend\n\treturn self.plan\nend\n\n-- JumpMotor.plan_hop: the ground HOP_DISTANCE ahead, planned and checked exactly like an aimed jump.\nfunction Motor.hopPlan(self: any): any\n\tlocal n = self.up\n\tlocal h = SupportMath.tangentDir(self.heading, n)\n\tif h == Vector3.zero then h = SupportMath.anyPerpendicular(n) end\n\tlocal ahead = self:_ray(self.pos, h * (HOP_DISTANCE + HEIGHT))\n\tif ahead then\n\t\treturn { kind = \"obstructed\", reason = \"hop_blocked\", point = ahead.Position, normal = ahead.Normal, origin = self.pos }\n\tend\n\tlocal finish = self.pos + h * HOP_DISTANCE\n\tlocal ground = self:_ray(finish + n * HOP_PROBE_UP, -n * (HOP_PROBE_UP + HOP_PROBE_DOWN))\n\tif not ground then\n\t\treturn { kind = \"unreachable\", reason = \"no_ground\", point = finish - n * HEIGHT, normal = n, origin = self.pos }\n\tend\n\treturn self:planJump(ground.Position, ground.Normal, ground.Instance)\nend\n\n-- What a leap from here does with the line (SpiderMotor.get_anchor_preview): \"ok\", \"no_silk\", \"too_long\" or \"no_support\".\nfunction Motor.anchorPreview(self: any, plan: any): string\n\tif self.mode ~= \"attached\" then return \"no_support\" end\n\tlocal hit = self:_ray(self.pos, -self.up * (HEIGHT + 0.1))\n\tlocal p = if hit then self:profileOf(hit.Instance) else nil\n\tif not p then return \"no_support\" end\n\tif not p.silk_anchor_allowed then return \"no_silk\" end\n\tif plan and plan.seat and (plan.seat - self.pos).Magnitude > self.silk.maximum then return \"too_long\" end\n\treturn \"ok\"\nend\n\n-- ---------------------------------------------------------------- the jump controller's view of the motor (JumpInput)\n-- Standing on a surface and not walking itself to an edge's drop: a press or an aim may start.\nfunction Motor.canPrepare(self: any): boolean\n\treturn self.mode == \"attached\"\nend\n\n-- ATTACHED to PREPARING: the spider holds still; a walk to the edge stops (the player took over).\nfunction Motor.beginPrepare(self: any): boolean\n\tif not self:canPrepare() then return false end\n\tif self.silk.walk then self:cancelWalk() end\n\tself.preparing = true\n\tself.vel = Vector3.zero\n\treturn true\nend\n\nfunction Motor.cancelPrepare(self: any)\n\tself.preparing = false\n\tself.aimTarget = nil\nend\n\nfunction Motor.isPreparing(self: any): boolean\n\treturn self.preparing and self.mode == \"attached\"\nend\n\nfunction Motor.clearAimTarget(self: any)\n\tself.aimTarget = nil\nend\n\n-- Commits a reachable plan made from where the body is now. Anything else changes nothing.\nfunction Motor.commit(self: any, plan: any): boolean\n\tif plan == nil or plan.kind ~= \"reachable\" or self.mode ~= \"attached\" then return false end\n\tif plan.origin and (plan.origin - self.pos).Magnitude > 1e-3 then return false end\n\tself:_launch(plan.velocity, plan.steps)\n\treturn true\nend\n\n-- A committed leap anchors a safety line at takeoff where the ground holds silk (SilkController pays it out).\nfunction Motor._launch(self: any, velocity: Vector3, steps: number)\n\tlocal floorHit = self:_ray(self.pos, -self.up * (HEIGHT + 0.1))\n\tself.afterMiss, self.dropped, self.caught = false, false, false\n\tif self.silk:anchorAt(floorHit, self.pos) then\n\t\tself.lineSerial += 1\n\t\tself:_event(\"anchored\")\n\tend\n\tself.preparing = false\n\tself.aimTarget = nil\n\tself.flightTicks, self.flightLimit = 0, steps + 4\n\tself.vel = velocity\n\tself.mode = \"air\"\n\tself:_event(\"launched\")\nend\n\n-- ---------------------------------------------------------------- letting down on a line (F / X / Silk)\nfunction Motor._beginDrop(self: any, push: Vector3): boolean\n\tif not self.silk:startDrop(self.pos, self.up, push) then return false end\n\tself.lineSerial += 1\n\tself.afterMiss, self.dropped, self.caught = false, true, false\n\tself.vel = push * 0.6\n\tself.mode = \"air\"\n\tself.preparing = false\n\tself.aimTarget = nil\n\tself:_event(\"dropped\")\n\treturn true\nend\n\n-- Godot SpiderMotor.begin_drop: on a wall or underside let down at once; on top of a leaf, walk to the nearest usable\n-- edge first. Returns whether something started; a refusal says why in an event.\nfunction Motor.requestDrop(self: any): boolean\n\tif self.mode ~= \"attached\" or self.preparing or self.silk.walk then return false end\n\tlocal plan, message = self.silk:planDrop(self.pos, self.up, self.heading)\n\tif not plan then\n\t\tself.silk.message = message\n\t\tlocal reason = if message == \"This surface cannot hold silk\" then \"no_silk\" elseif message == \"No supporting surface\" then \"no_support\" else \"no_edge\"\n\t\tself:_event(\"drop_refused\", reason)\n\t\treturn false\n\tend\n\tif plan.direction.Magnitude < 1e-6 then\n\t\tif self:_beginDrop(self.up) then self.pos += self.up * 0.01 end\n\telse\n\t\tself.silk.walk = { direction = plan.direction, ticks = math.ceil((plan.distance / (self.loco.walk_speed_wu_s*self.speedFactor) + 1.5) * 60) }\n\t\tself.silk.message = \"Walking to the edge — move or cancel to stop\"\n\t\tself:_event(\"drop_walk\")\n\tend\n\treturn true\nend\n\n-- Stops a walk to the edge (the player moved, aimed or pressed cancel). False when there was none.\nfunction Motor.cancelWalk(self: any): boolean\n\tif not self.silk.walk then return false end\n\tself.silk.walk = nil\n\tself.silk.message = \"Edge walk cancelled\"\n\treturn true\nend\n\n-- True while hanging or reeling on a locked line (Godot is_on_line).\nfunction Motor.onLine(self: any): boolean\n\treturn self.mode == \"air\" and self.silk.mode == \"locked\"\nend\n\n-- Where the spider will hang (the line's rest point below its pivot) and the lip the line leaves its support at: the\n-- camera frames the recovery from these (camera_rig._wanted_yaw_assist, A-017).\nfunction Motor.lineRestPoint(self: any): Vector3\n\tif self.silk.mode ~= \"locked\" then return self.pos end\n\tlocal pivot = self.silk:pivot()\n\treturn pivot - Vector3.yAxis * math.max(self.silk.rest - self.silk:prefix(), 0)\nend\n\nfunction Motor.lineLip(self: any): Vector3\n\treturn self.silk.bend or (self.silk.anchor + self.silk.normal * 0.04)\nend\n\n-- ---------------------------------------------------------------- the eyes (D-036)\n-- Where the eyes are (Godot get_eye_position): on the body, a little ahead and a little up.\nfunction Motor.eyePosition(self: any): Vector3\n\tlocal frame = SupportMath.bodyCFrame(self.pos, self.up, self.heading)\n\treturn self.pos + frame.LookVector * EYE_FORWARD + frame.UpVector * EYE_UP\nend\n\n-- The facing tilted by the gaze pitch about the body's right: where the eyes point with the retinas centred (Godot get_body_gaze_direction).\nfunction Motor.bodyGazeDirection(self: any): Vector3\n\tlocal frame = SupportMath.bodyCFrame(self.pos, self.up, self.heading)\n\treturn (frame.LookVector * math.cos(self.gazePitch) + frame.UpVector * math.sin(self.gazePitch)).Unit\nend\n\n-- The axis of the inspection cone (Godot get_gaze_direction). The body's own gaze, unless the spider-eye view has pointed the principal\n-- eyes' retinas elsewhere (the scan direction): then that direction, held within PRINCIPAL_SCAN_DEG of the body's gaze.\nfunction Motor.gazeDirection(self: any): Vector3\n\tlocal axis = self:bodyGazeDirection()\n\tlocal scan: Vector3? = self.scanDir\n\tif scan == nil then\n\t\treturn axis\n\tend\n\tif SupportMath.angleTo(axis, scan) <= PRINCIPAL_SCAN then\n\t\treturn scan\n\tend\n\tlocal turn = axis:Cross(scan)\n\tif turn:Dot(turn) < 1e-10 then\n\t\treturn axis\n\tend\n\treturn (CFrame.fromAxisAngle(turn.Unit, PRINCIPAL_SCAN) * axis).Unit\nend\n\n-- What the senses read of the body (Sensor.step's observer): the eyes, the axis of the cone, the body's up and its facing. Never the camera.\nfunction Motor.observer(self: any): { eye: Vector3, gaze: Vector3, up: Vector3, heading: Vector3 }\n\treturn { eye = self:eyePosition(), gaze = self:gazeDirection(), up = self.up, heading = self.heading }\nend\n\nfunction Motor.scanDirection(self: any): Vector3?\n\treturn self.scanDir\nend\n\n-- True while Focus is turning the gaze: held, or the spider-eye view turning the body to face the gaze (Godot is_focusing).\nfunction Motor.isFocusing(self: any): boolean\n\treturn self.focusOn\nend\n\nlocal function moveToward(from: number, to: number, maxStep: number): number\n\tif math.abs(to - from) <= maxStep then\n\t\treturn to\n\tend\n\treturn from + math.sign(to - from) * maxStep\nend\n\n-- The direction Focus aims the gaze (Godot player_controller.focus_direction): from the eyes to the point the camera's centre ray meets,\n-- or along that ray when the point is within 0.2 WU of them.\nfunction Motor._focusDirection(self: any, input: TickInput): Vector3?\n\tlocal point = input.focusPoint\n\tif point == nil then\n\t\treturn nil\n\tend\n\tlocal to = point - self:eyePosition()\n\tif to.Magnitude > 0.2 then\n\t\treturn to.Unit\n\tend\n\tlocal ray = input.focusDir\n\treturn if ray ~= nil and ray.Magnitude > 1e-4 then ray.Unit else nil\nend\n\n-- Godot _update_gaze: the gaze tilts toward the focus direction (within the gaze limit) while Focus is held on a support, and settles back to\n-- the support plane, at half that rate, when it is not. T10a: in the spider-eye view it tilts, at that half rate, toward the scan direction;\n-- while the body turns to face that gaze it has the full rate, as Focus does.\nfunction Motor._updateGaze(self: any, input: TickInput)\n\tlocal wanted, rate = 0.0, FOCUS_RATE * 0.5\n\tlocal supported = self.mode == \"attached\"\n\tlocal focus = self:_focusDirection(input)\n\tlocal scan: Vector3? = self.scanDir\n\tself.focusOn = focus ~= nil\n\tif supported and focus == nil and scan ~= nil and self.eyeTurning and not self.preparing then\n\t\tfocus = scan\n\t\tself.focusOn = true\n\tend\n\tif supported and focus ~= nil then\n\t\twanted = math.clamp(math.asin(math.clamp(focus:Dot(self.up), -1, 1)), -self.gazeLimit, self.gazeLimit)\n\t\trate = FOCUS_RATE\n\telseif supported and scan ~= nil then\n\t\twanted = math.clamp(math.asin(math.clamp(scan:Dot(self.up), -1, 1)), -self.gazeLimit, self.gazeLimit)\n\tend\n\tself.gazePitch = moveToward(self.gazePitch, wanted, rate * DT)\nend\n\n-- ---------------------------------------------------------------- the fixed tick\nfunction Motor._turnToward(self: any, dir: Vector3, rate: number)\n\tlocal t = SupportMath.tangentDir(dir, self.up)\n\tif t ~= Vector3.zero then\n\t\tself.heading = SupportMath.tangentDir(SupportMath.rotateToward(self.heading, t, rate * DT), self.up)\n\tend\nend\n\n-- Focus (PlayerController.focus_direction) and the spider-eye turn: standing still, the body turns to look.\nfunction Motor._lookTurns(self: any, input: TickInput, stickIdle: boolean)\n\tif input.focusPoint then\n\t\tlocal eye = self.pos + self.heading * 0.45\n\t\tlocal to = input.focusPoint - eye\n\t\tif to.Magnitude > 0.2 then self:_turnToward(to, FOCUS_RATE) end\n\t\tself.eyeTurning = false\n\t\treturn\n\tend\n\tif not input.gaze or not stickIdle then\n\t\tself.eyeTurning = false\n\t\treturn\n\tend\n\tlocal look = SupportMath.tangentDir(input.gaze, self.up)\n\tif look == Vector3.zero then return end\n\tlocal off = math.deg(SupportMath.angleTo(self.heading, look))\n\tif not self.eyeTurning and off > EYE_TURN_START_DEG then\n\t\tself.eyeTurning = true\n\telseif self.eyeTurning and off < EYE_TURN_STOP_DEG then\n\t\tself.eyeTurning = false\n\tend\n\tif self.eyeTurning then self:_turnToward(look, FOCUS_RATE) end\nend\n\nfunction Motor._outOfBounds(self: any, p: Vector3): boolean\n\tlocal lo, hi = self.config.boundsMin, self.config.boundsMax\n\tif p.X < lo.X or p.Y < lo.Y or p.Z < lo.Z or p.X > hi.X or p.Y > hi.Y or p.Z > hi.Z then return true end\n\tlocal inside = self.config.inBounds\n\treturn inside ~= nil and not inside(p)\nend\n\n-- Leaving the play area puts the spider back at its last supported spot (Godot _reset_out_of_bounds).\nfunction Motor._backToSafety(self: any)\n\tlocal safe = self.safe\n\tself:place(safe.pos, safe.up, safe.heading)\n\tself:_event(\"out_of_bounds\")\nend\n\nfunction Motor._tickAttached(self: any, input: TickInput)\n\tlocal silk = self.silk\n\tlocal preparing = self.preparing\n\tlocal manual = if preparing then Vector3.zero else input.wish\n\tif silk.walk and manual.Magnitude > 0 then self:cancelWalk() end\n\tlocal dir = if preparing then Vector3.zero elseif silk.walk then silk.walk.direction else manual\n\tif silk.walk then\n\t\tsilk.walk.ticks -= 1\n\t\tif silk.walk.ticks <= 0 then\n\t\t\tsilk.walk = nil\n\t\t\tsilk.message = \"Edge walk stopped\"\n\t\t\tself:_event(\"drop_refused\", \"stuck\")\n\t\t\treturn\n\t\tend\n\tend\n\tself.moving = dir ~= Vector3.zero\n\tself.intent = dir\n\tif preparing then\n\t\tlocal target = self.aimTarget\n\t\tif target then self:_turnToward(target - self.pos, PREPARE_TURN_RATE) end\n\telseif not silk.walk then\n\t\tself:_lookTurns(input, not self.moving)\n\tend\n\tif not self.moving then\n\t\t-- Re-seat on the support so a vanished or moved surface is noticed.\n\t\tlocal below = self:_ray(self.pos + self.up * 0.1, -self.up * (HEIGHT + 0.35))\n\t\tif not self:attachable(below) and not (below and self:supports(self:profileOf(below.Instance), below.Normal)) then\n\t\t\tself.mode = \"air\"\n\t\t\tself.vel = Vector3.zero\n\t\t\tself.preparing = false\n\t\t\tself.flightTicks, self.flightLimit = 0, 0\n\t\telse\n\t\t\tself.safe = { pos = self.pos, up = self.up, heading = self.heading }\n\t\tend\n\t\treturn\n\tend\n\tlocal stalk = input.creep and not silk.walk\n\tlocal speed = (if stalk then self.loco.stalk_speed_wu_s else self.loco.walk_speed_wu_s)*self.speedFactor\n\tif input.run == true and not stalk and not silk.walk then speed *= Motor.RUN_MULTIPLIER end\n\tlocal face = if input.face ~= nil and not silk.walk then SupportMath.tangentDir(input.face - self.pos, self.up) else Vector3.zero\n\tself.heading = SupportMath.tangentDir(SupportMath.rotateToward(self.heading, if face ~= Vector3.zero then face else dir, TURN_RATE * DT), self.up) -- (ROBLOX-110: a sidestep faces the locked thing, not the way it walks)\n\tlocal step = dir * speed * DT\n\t-- Concave corner: a wall (or a leaf's edge, a stem) ahead becomes the new support.\n\tlocal ahead = self:_ray(self.pos, dir * (HEIGHT + step.Magnitude + 0.02))\n\tif ahead and self:attachable(ahead) and SupportMath.angleTo(ahead.Normal, self.up) > math.rad(20) then\n\t\tself:_transition(ahead)\n\t\treturn\n\tend\n\tlocal nextPos = self.pos + step\n\tlocal below = self:_ray(nextPos + self.up * 0.25, -self.up * (HEIGHT + 0.5))\n\tif below and self:attachable(below) and SupportMath.angleTo(below.Normal, self.up) < math.rad(60) then\n\t\tlocal n = SupportMath.filterNormal(self.up, below.Normal, 2.0)\n\t\tself.up = n\n\t\tself.pos = below.Position + n * HEIGHT\n\t\tself.heading = SupportMath.tangentDir(self.heading, n)\n\t\tself.safe = { pos = self.pos, up = self.up, heading = self.heading }\n\t\treturn\n\tend\n\tif silk.walk then\n\t\t-- The walk reached the edge: let down from here (edge-first lowering).\n\t\tif self:_beginDrop(dir) then self.pos = nextPos + dir * (HEIGHT + 0.02) end\n\t\treturn\n\tend\n\t-- Convex edge: wrap over it onto the face beyond (sill edge, leaf rim, the top of a wall).\n\tlocal around = self:_ray(nextPos - self.up * (HEIGHT + 0.15), -dir * 1.0)\n\tif around and self:attachable(around) then\n\t\tself:_transition(around)\n\t\treturn\n\tend\n\tself.mode = \"air\"\n\tself.vel = dir * speed\n\tself.flightTicks, self.flightLimit = 0, 0\nend\n\nfunction Motor._tickLine(self: any, input: TickInput)\n\tlocal silk = self.silk\n\t-- On the line (spec 17's context override): forward reels in, back lowers, F held lowers, a held Q lets go.\n\tlocal intent = if input.dropHeld then math.min(input.reel, 0) - 1 else input.reel\n\tlocal p, v, hit = silk:step(self.pos, self.vel, math.clamp(intent, -1, 1), input.releaseHeld == true)\n\tself.pos, self.vel = p, v\n\tif hit then\n\t\tself:_setSupport(hit)\n\t\tself.vel = Vector3.zero\n\t\tself.mode = \"attached\"\n\t\tsilk:clear()\n\t\tself:_event(\"completed\")\n\t\tself.safe = { pos = self.pos, up = self.up, heading = self.heading }\n\t\treturn\n\tend\n\tif silk.mode == \"none\" then\n\t\tself:_event(if silk.message == \"Silk anchor lost\" then \"lost\" else \"released\")\n\t\tself.flightTicks, self.flightLimit = 0, 0\n\t\treturn\n\tend\n\tif silk.taut and not self.caught then\n\t\tself.caught = true\n\t\tself:_event(\"caught\")\n\tend\n\tif silk.snagged and not self.snagSeen then self:_event(\"snagged\") end\n\tself.snagSeen = silk.snagged\n\tself.up = SupportMath.rotateToward(self.up, Vector3.yAxis, FREE_UP_RATE * DT)\n\tif self:_outOfBounds(self.pos) then self:_backToSafety() end\nend\n\nfunction Motor._lock(self: any, at: Vector3)\n\tself.silk:lock(at, 0.25)\n\tself.afterMiss = true\n\tself.caught = false\n\tself:_event(\"locked\")\nend\n\nfunction Motor._tickAir(self: any, input: TickInput)\n\tlocal silk = self.silk\n\tif silk.mode == \"locked\" then\n\t\tself:_tickLine(input)\n\t\treturn\n\tend\n\tself.flightTicks += 1\n\tlocal from = self.pos\n\tself.vel += self.gravity * DT\n\tlocal to = from + self.vel * DT\n\tlocal travel = to - from\n\tlocal dir = if travel.Magnitude > 1e-6 then travel.Unit else -self.up\n\tlocal hit = self:_ray(from, dir * (travel.Magnitude + HEIGHT))\n\tif hit then\n\t\tlocal approach = -self.vel:Dot(hit.Normal)\n\t\tif self:supports(self:profileOf(hit.Instance), hit.Normal) and approach >= JumpMath.minApproach(hit.Normal) then\n\t\t\tlocal heading = SupportMath.tangentDir(self.vel, hit.Normal)\n\t\t\tself:_setSupport(hit)\n\t\t\tif heading ~= Vector3.zero then self.heading = heading end\n\t\t\tself.vel = Vector3.zero\n\t\t\tself.mode = \"attached\"\n\t\t\tif silk.mode ~= \"none\" then self:_event(\"landed\") end\n\t\t\tsilk:clear()\n\t\t\tself.safe = { pos = self.pos, up = self.up, heading = self.heading }\n\t\t\treturn\n\t\tend\n\t\t-- Not landable here: the line locks (a miss), and the body slides along it.\n\t\tif silk.mode == \"payout\" then self:_lock(self.pos) end\n\t\tself.vel -= hit.Normal * math.min(0, self.vel:Dot(hit.Normal))\n\t\tto = hit.Position + hit.Normal * HEIGHT\n\tend\n\tself.pos = to\n\tsilk:payout(to)\n\tif silk.mode == \"payout\" and self.flightTicks >= self.flightLimit then self:_lock(to) end\n\t-- The drawn body turns upright while falling.\n\tself.up = SupportMath.rotateToward(self.up, Vector3.yAxis, FREE_UP_RATE * DT)\n\tif self:_outOfBounds(to) then self:_backToSafety() end\nend\n\n-- Taken by a predator (Godot SpiderMotor.seize, LIFE round 4; ROBLOX-26): the spider lets go of its surface and its line, takes no more\n-- input, and the motor stops. Whatever took it moves the body from now on with `hold`. Nothing undoes it but `place`: the world that\n-- follows is a checkpoint's or the start.\nfunction Motor.seize(self: any)\n\tself.seized = true\n\tself.mode = \"air\"\n\tself.preparing = false\n\tself.aimTarget = nil\n\tself.plan = nil\n\tself.planKey = \"\"\n\tself.vel = Vector3.zero\n\tself.moving = false\n\tself.intent = Vector3.zero\n\tself.silk:clear()\nend\n\n-- Where the predator holds the body (the spider hangs upright under it).\nfunction Motor.hold(self: any, position: Vector3)\n\tself.pos = position\n\tself.up = SupportMath.rotateToward(self.up, Vector3.yAxis, FREE_UP_RATE * DT)\nend\n\n-- One fixed 1/60 s tick of the body.\nfunction Motor.tick(self: any, input: TickInput)\n\tif self.seized then return end\n\tself.ticks += 1\n\tlocal scan = input.gaze\n\tself.scanDir = if scan ~= nil and scan.Magnitude > 1e-4 then scan.Unit else nil\n\tif self.mode == \"attached\" then\n\t\tself:_tickAttached(input)\n\telse\n\t\tself.preparing = false\n\t\tself:_tickAir(input)\n\tend\n\tself:_updateGaze(input)\nend\n\nreturn Motor\n",34581,637874076},{"Shared/Movement/StickCarry","--!strict\n-- The carry over an edge: a port of the frozen Godot scripts/movement/player_controller.gd _carry (c87ce00).\n-- On a wall, forward is up; on a floor, away from the camera. So holding the stick forward over a sharp edge would flip\n-- the camera mapping and walk the spider straight back (it would oscillate at the edge). When the support turns sharply\n-- (the motor's transitionSerial changes) while the stick is held, the motor's own direction, which it turned with the\n-- support, is kept instead of the fresh mapping. The carry ends when the stick is released or turned by more than\n-- CARRY_STICK_DEG, or when the fresh mapping agrees with the carried direction again (within CARRY_AGREE_DEG). Pure.\nlocal StickCarry = {}\nStickCarry.__index = StickCarry\n\nStickCarry.CARRY_STICK_DEG = 30.0\nStickCarry.CARRY_AGREE_DEG = 25.0\n\nfunction StickCarry.new(): any\n\treturn setmetatable({ carrying = false, sx = 0, sy = 0, lastSerial = 0 }, StickCarry)\nend\n\nlocal function angleBetween(a: Vector3, b: Vector3): number\n\treturn math.atan2(a:Cross(b).Magnitude, a:Dot(b))\nend\n\n-- stick x right, y forward; fresh: the camera mapping on the support now; serial: the motor's transition count;\n-- carried: the motor's own walking direction (turned with the support); inTransition: rounding an edge.\nfunction StickCarry.step(self: any, sx: number, sy: number, fresh: Vector3, serial: number, carried: Vector3, inTransition: boolean): Vector3\n\tlocal turned = serial ~= self.lastSerial\n\tself.lastSerial = serial\n\tlocal length = math.sqrt(sx * sx + sy * sy)\n\tif length * length < 1e-8 then\n\t\tself.carrying = false\n\t\treturn Vector3.zero\n\tend\n\tlocal nx, ny = sx / length, sy / length\n\tif turned and not self.carrying then\n\t\tself.carrying = true\n\t\tself.sx, self.sy = nx, ny\n\tend\n\tif not self.carrying then return fresh end\n\tif math.acos(math.clamp(nx * self.sx + ny * self.sy, -1, 1)) > math.rad(StickCarry.CARRY_STICK_DEG) then\n\t\tself.carrying = false\n\t\treturn fresh\n\tend\n\tif carried:Dot(carried) < 1e-8 then\n\t\tself.carrying = false\n\t\treturn fresh\n\tend\n\tlocal dir = carried.Unit\n\tif not inTransition and fresh:Dot(fresh) > 1e-8 and angleBetween(fresh.Unit, dir) < math.rad(StickCarry.CARRY_AGREE_DEG) then\n\t\tself.carrying = false\n\t\treturn fresh\n\tend\n\treturn dir * math.min(length, 1)\nend\n\nreturn StickCarry\n",2297,1283524830},{"Shared/Movement/SupportMath","--!strict\n-- Port of scripts/movement/support_math.gd (spec 6.1, 6.2). Pure geometry for supported locomotion; unit vectors in world space.\n\nlocal SupportMath = {}\n\nlocal RIGHT = Vector3.new(1, 0, 0)\nlocal BACK = Vector3.new(0, 0, 1)\n\nlocal function angleTo(a: Vector3, b: Vector3): number\n\treturn math.atan2(a:Cross(b).Magnitude, a:Dot(b))\nend\nSupportMath.angleTo = angleTo\n\n-- The part of v that lies in the plane with unit normal n.\nfunction SupportMath.tangent(v: Vector3, n: Vector3): Vector3\n\treturn v - n * v:Dot(n)\nend\n\n-- Unit direction of v on the plane with normal n, or zero when v is (nearly) along n.\nfunction SupportMath.tangentDir(v: Vector3, n: Vector3, eps: number?): Vector3\n\tlocal t = SupportMath.tangent(v, n)\n\tlocal length = t.Magnitude\n\treturn if length > (eps or 1e-5) then t / length else Vector3.zero\nend\n\n-- Hysteresis for the support normal: a candidate within ignoreDeg of the current one is ignored.\nfunction SupportMath.filterNormal(current: Vector3, candidate: Vector3, ignoreDeg: number): Vector3\n\tif candidate:Dot(candidate) < 1e-10 or candidate.Magnitude ~= candidate.Magnitude then\n\t\treturn current\n\tend\n\tlocal c = candidate.Unit\n\tif current:Dot(current) < 1e-10 then\n\t\treturn c\n\tend\n\tif angleTo(current.Unit, c) <= math.rad(ignoreDeg) then\n\t\treturn current\n\tend\n\treturn c\nend\n\nfunction SupportMath.anyPerpendicular(v: Vector3): Vector3\n\tlocal other = if math.abs(v.Unit.X) < 0.9 then RIGHT else BACK\n\treturn v:Cross(other).Unit\nend\n\n-- Turns unit vector `from` toward `to` by at most maxAngle radians (shortest arc).\nfunction SupportMath.rotateToward(from: Vector3, to: Vector3, maxAngle: number): Vector3\n\tlocal angle = angleTo(from, to)\n\tif angle <= maxAngle or angle < 1e-6 then\n\t\treturn to\n\tend\n\tlocal axis = from:Cross(to)\n\tif axis:Dot(axis) < 1e-12 then\n\t\taxis = SupportMath.anyPerpendicular(from)\n\tend\n\treturn (CFrame.fromAxisAngle(axis.Unit, maxAngle) * from).Unit\nend\n\n-- Signed angle from a to b about axis n.\nfunction SupportMath.signedAngle(a: Vector3, b: Vector3, n: Vector3): number\n\treturn math.atan2(n:Dot(a:Cross(b)), a:Dot(b))\nend\n\n-- Body frame for an up vector and a heading: Y is up, -Z (LookVector) is the heading made perpendicular to up.\nfunction SupportMath.bodyCFrame(position: Vector3, up: Vector3, heading: Vector3): CFrame\n\tlocal u = up.Unit\n\tlocal f = SupportMath.tangentDir(heading, u)\n\tif f == Vector3.zero then\n\t\tf = SupportMath.anyPerpendicular(u)\n\tend\n\tlocal z = -f\n\tlocal x = u:Cross(z).Unit\n\treturn CFrame.fromMatrix(position, x, u, z)\nend\n\nreturn SupportMath\n",2534,4093531017},{"Shared/Movement/TetherMath","--!strict\n-- Pure safety-line operations from frozen Godot tether.gd / spider_motor.gd.\n-- No renderer, wall clock, Roblox services or collision decisions here.\nlocal T = {}\nT.BRAKE = 0.25\nT.MIN_REST = 0.4\nT.DROP_SLACK = 0.5\nT.DAMPING = 1.6\nT.DT = 1/60\n\nfunction T.constrain(pivot: Vector3, length: number, target: Vector3, velocity: Vector3)\n\tlocal d = target-pivot\n\tlocal distance = d.Magnitude\n\tlocal out = {position=target, velocity=velocity, acted=false, radial_before=0, radial_after=0,\n\t\ttangential_change=0, distance_before=distance, distance_after=distance}\n\tif distance < 1e-9 then return out end\n\tlocal radial = d/distance\n\tlocal speed = velocity:Dot(radial)\n\tout.radial_before, out.radial_after = speed, speed\n\tif distance <= length then return out end\n\tlocal v = if speed > 0 then velocity-radial*speed else velocity\n\tout.position = pivot+radial*math.max(length,0)\n\tout.velocity, out.acted = v, true\n\tout.radial_after = v:Dot(radial)\n\tout.tangential_change = ((v-radial*v:Dot(radial))-(velocity-radial*speed)).Magnitude\n\tout.distance_after = math.max(length,0)\n\treturn out\nend\nfunction T.energy(position: Vector3, velocity: Vector3, gravity: number): number\n\treturn 0.5*velocity:Dot(velocity)+gravity*position.Y\nend\nfunction T.reelWorkBound(shortening: number, gravity: number, speed: number, length: number): number\n\treturn math.max(shortening,0)*(gravity+speed*speed/math.max(length,0.05))\nend\nfunction T.sagDepth(span: number, length: number): number\n\tlocal extra = length-span\n\tif extra <= 1e-4 or span < 1e-4 then return 0 end\n\treturn math.min(math.sqrt(3*span*extra/8),3)\nend\nfunction T.lock(paid: number, path: number, maximum: number, extension: number): (number,number)\n\tlocal p = math.min(math.max(paid,path),maximum)\n\treturn p,math.min(p+math.max(extension,0),maximum)\nend\nfunction T.reel(rest: number, prefix: number, maximum: number, intent: number, speed: number): number\n\treturn math.clamp(rest-math.clamp(intent,-1,1)*speed*T.DT,math.min(prefix+T.MIN_REST,maximum),maximum)\nend\n\n-- A press that started before the grace period can NEVER become a release later.\nfunction T.newRelease()\n\treturn {ticks=0, held=0, down=false, counts=false, progress=0}\nend\nfunction T.releaseTick(s: any, onLine: boolean, down: boolean): boolean\n\ts.ticks = if onLine then s.ticks+1 else 0\n\tif down and not s.down then s.counts = onLine and s.ticks>=24; s.held=0 end\n\tif not down or not onLine then s.counts=false; s.held=0 end\n\ts.down = down\n\ts.held = if s.counts then s.held+1 else 0\n\ts.progress = math.min(s.held/36,1)\n\tif s.progress>=1 then s.counts=false; s.held=0; s.progress=0; return true end\n\treturn false\nend\nreturn T\n",2635,1894221491},{"Shared/Movement/TitleShots","--!strict\n-- The camera of the first minute (ROBLOX-109), as pure functions of time: the drift the splash (First/SplashScreen) and the title card (Client/TitleCard)\n-- both draw, and the intro of a new life, shot by shot, with its captions' times and the spider's walk out of the crack. Pure: tests/title.luau checks it,\n-- and tools/preview/scene.py --title renders its frames from these same numbers (TitleShots.views).\n--\n-- The drift: the garden in the morning seen from outside, from over the lawn beyond the bed, low, drawing in toward the window over DRIFT_S seconds, then\n-- breathing in place (a slow sway of a stud or two) for as long as the title card is up. It is a function of the game's clock (`time()`), so the splash\n-- and the title card, two scripts, put the camera in the same place on the same frame and the hand-over between them cannot jump.\n-- The intro: the morning light through the glass from low on the sill; the camera low over the sill floor finding the crack; the spider stepping out of it;\n-- then the camera eases into the game's own camera behind the spider and the controls are the player's. Captions come in the notebook's voice\n-- (UI/TitleText.captions). Reduced Motion: each shot is held still (its middle frame) and the shots cut; no ease into the game's camera, a cut.\n-- One stud is a centimetre: the sill's floor is y 0, the crack's mouth is at x -23.3 (Habitat/WindowsillLayout.RETREAT_MAX), the glass at z -12.6, the\n-- outer sill's top y 0 out to z -24 (the house's face), the bed's soil y -90.\nlocal TitleShots = {}\n\nexport type Key = { t: number, eye: Vector3, at: Vector3, fov: number }\nexport type Shot = { name: string, t0: number, t1: number, eye0: Vector3, eye1: Vector3, at0: Vector3, at1: Vector3, fov: number, follow: boolean? }\nexport type Frame = {\n\tcframe: CFrame, fov: number, shot: string, veil: number, caption: number?, captionAlpha: number,\n\tblend: number, walking: boolean, holding: boolean, done: boolean,\n}\n\nlocal v = Vector3.new\n\nTitleShots.DRIFT_S = 36\nTitleShots.DRIFT = {\n\t{ t = 0, eye = v(40, -82, -170), at = v(0, -25, -24), fov = 55 }, -- low over the lawn past the bed: the bed's foot, the bushes, the window high in the wall\n\t{ t = 18, eye = v(16, -20, -80), at = v(0, 0, -18), fov = 48 }, -- risen in front of the wall, the window in its deep reveal\n\t{ t = 36, eye = v(10, 6.5, -45), at = v(0, 2.5, -14), fov = 46 }, -- level with the outer sill, looking in: the window boxes, the glass, the sill beyond\n} :: { Key }\n-- ROBLOX-115: the preserve's drift (World/Preserve: the ranger hut's north window, the sill in it, looking north over the hut garden): from over the hut garden's far\n-- end, at a person's knee, drawing in over the herb beds to the window from outside, arriving where the test garden's does (in front of the glass, looking in).\nTitleShots.PRESERVE_DRIFT = {\n\t{ t = 0, eye = v(380, 60, -1250), at = v(0, 30, -16), fov = 55 }, -- over the far end of the hut garden: the beds, the fence, the hut with its window\n\t{ t = 18, eye = v(120, 25, -360), at = v(0, 15, -16), fov = 48 }, -- in over the herb beds, the hut's log wall and its green casing\n\t{ t = 36, eye = v(10, 6.5, -45), at = v(0, 2.5, -14), fov = 46 }, -- level with the outer sill, looking in: the glass, the sill beyond\n} :: { Key }\n-- The drift of each world (World/Worlds' ids); any other world (or none: the splash before the server has said) has the default world's, the preserve's\n-- (ROBLOX-118: World/Worlds.DEFAULT, the game's world; this module is required by the splash before World/ is known to have replicated, so it names it itself).\nTitleShots.DRIFTS = { test_garden = TitleShots.DRIFT, preserve = TitleShots.PRESERVE_DRIFT } :: { [string]: { Key } }\nTitleShots.DEFAULT_WORLD = \"preserve\"\n\n-- The breathing once the drift has arrived: amplitudes in studs and the periods' rates (radians a second), slow enough never to be noticed as a move.\nTitleShots.SWAY = { x = 1.6, y = 0.5, rateX = 0.07, rateY = 0.05 }\n\nlocal function smooth(k: number): number\n\tk = math.clamp(k, 0, 1)\n\treturn k * k * (3 - 2 * k)\nend\n\n-- The drift's camera and field of view at the game's time `t` (seconds since the client began), in the world `world` (the Workspace attribute World; the\n-- default world's drift when nil or unknown: the preserve's since ROBLOX-118).\nfunction TitleShots.drift(t: number, world: string?): (CFrame, number)\n\tlocal keys = (if world ~= nil then TitleShots.DRIFTS[world] else nil) or TitleShots.DRIFTS[TitleShots.DEFAULT_WORLD]\n\tt = math.max(t, 0)\n\tlocal last = keys[#keys]\n\tif t >= last.t then\n\t\tlocal s = TitleShots.SWAY\n\t\tlocal after = t - last.t\n\t\t-- (the sway starts from nothing: sin(0) = 0 and its rate is slow, so the arrival is still)\n\t\tlocal eye = last.eye + v(math.sin(after * s.rateX) * s.x, math.sin(after * s.rateY) * s.y, 0)\n\t\treturn CFrame.lookAt(eye, last.at), last.fov\n\tend\n\tfor i = 1, #keys - 1 do\n\t\tlocal a, b = keys[i], keys[i + 1]\n\t\tif t <= b.t then\n\t\t\tlocal k = smooth((t - a.t) / (b.t - a.t))\n\t\t\treturn CFrame.lookAt(a.eye:Lerp(b.eye, k), a.at:Lerp(b.at, k)), a.fov + (b.fov - a.fov) * k\n\t\tend\n\tend\n\treturn CFrame.lookAt(last.eye, last.at), last.fov\nend\n\n-- The intro of a new life. `start` is where the spider is put when it begins (just inside the crack, facing out: the game's spawn heading); it walks out\n-- (the motor's own walk, `walk`) from `walk.from` until it is past `walk.untilX` or `walk.latest` has come. `skipAfter`: the skip is refused before it.\n-- The captions are UI/TitleText.captions' three, each faded in and out over `captionFade`; the last outlives the intro by a few seconds, over the game.\nTitleShots.INTRO = {\n\tskipAfter = 2.0,\n\tfadeIn = 0.8,\n\tstart = { pos = v(-25.2, 0.31, 6.0), heading = v(1, 0, 0) },\n\twalk = { from = 7.4, untilX = -21.6, latest = 11.5 },\n\tshots = {\n\t\t{ name = \"glass\", t0 = 0, t1 = 3.8, eye0 = v(-15.0, 1.0, 10.5), eye1 = v(-17.0, 0.9, 9.0), at0 = v(-5.0, 4.6, -12.6), at1 = v(-8.0, 4.3, -12.6), fov = 55 },\n\t\t{ name = \"sill\", t0 = 3.8, t1 = 7.4, eye0 = v(-9.5, 0.85, 4.2), eye1 = v(-16.8, 0.7, 5.4), at0 = v(-24.5, 0.6, 6.0), at1 = v(-24.8, 0.55, 6.0), fov = 50 },\n\t\t{ name = \"out\", t0 = 7.4, t1 = 12.2, eye0 = v(-17.6, 0.75, 9.2), eye1 = v(-18.4, 0.7, 8.8), at0 = v(-24.6, 0.5, 6.0), at1 = v(-21.8, 0.5, 6.0), fov = 46, follow = true },\n\t} :: { Shot },\n\tblend = { t0 = 12.2, t1 = 13.6 },\n\ttotal = 13.6,\n\tcaptions = { { t0 = 4.2, t1 = 8.2 }, { t0 = 8.6, t1 = 11.8 }, { t0 = 12.2, t1 = 16.0 } },\n\tcaptionFade = 0.6,\n\tcaptionsEnd = 16.0,\n}\n\n-- ROBLOX-118: in the preserve the intro opens inside the ranger hut: from the room, low over the sill's front edge, the morning coming in through the hut's window\n-- over the sill (the sill, its crack and the spider's walk out of it are the same in both worlds: the sill is the same sill at the origin). The other shots are the same.\nTitleShots.PRESERVE_GLASS = { name = \"glass\", t0 = 0, t1 = 3.8, eye0 = v(-4.0, 9.0, 34.0), eye1 = v(-9.0, 6.5, 24.0), at0 = v(0.0, 16.0, -14.0), at1 = v(-3.0, 9.0, -13.0), fov = 58 } :: Shot\n\n-- The intro's shots in a world (the Workspace attribute World): the preserve's opens in the hut; any other world's (or none) is the shared list.\nfunction TitleShots.introShots(world: string?): { Shot }\n\tlocal shots: { Shot } = TitleShots.INTRO.shots\n\tif world ~= \"preserve\" then return shots end\n\tlocal out = table.clone(shots)\n\tout[1] = TitleShots.PRESERVE_GLASS\n\treturn out\nend\n\n-- One frame of the intro at `t` seconds. `reduced`: Reduced Motion. `spider`: where the spider's body is now (the \"out\" shot looks at it; the planned\n-- path when nil). `blend` is how far the view has eased into the game's camera (0 none, 1 all of it; the caller lerps); `holding` is whether the intro\n-- still has the camera and the controls, `done` whether everything, the last caption included, is over.\nfunction TitleShots.intro(t: number, reduced: boolean, spider: Vector3?, world: string?): Frame\n\tlocal I = TitleShots.INTRO\n\tlocal shots: { Shot } = TitleShots.introShots(world) -- (ROBLOX-118: `world` the Workspace attribute World; the preserve's opens in the hut)\n\tlocal shot = shots[#shots]\n\tfor _, s in shots do\n\t\tif t < s.t1 then shot = s; break end\n\tend\n\tlocal k = if reduced then 0.5 else smooth((t - shot.t0) / (shot.t1 - shot.t0))\n\tlocal eye = shot.eye0:Lerp(shot.eye1, k)\n\tlocal at = shot.at0:Lerp(shot.at1, k)\n\tif shot.follow and spider ~= nil then at = spider + v(0, 0.2, 0) end\n\tlocal caption: number? = nil\n\tlocal alpha = 0\n\tfor i, c in I.captions do\n\t\tif t >= c.t0 and t < c.t1 then\n\t\t\tcaption = i\n\t\t\talpha = math.min(1, (t - c.t0) / I.captionFade, (c.t1 - t) / I.captionFade)\n\t\tend\n\tend\n\tlocal blend = if reduced then (if t >= I.blend.t1 then 1 else 0) else smooth((t - I.blend.t0) / (I.blend.t1 - I.blend.t0))\n\treturn {\n\t\tcframe = CFrame.lookAt(eye, at), fov = shot.fov, shot = shot.name,\n\t\tveil = 1 - math.clamp(t / I.fadeIn, 0, 1),\n\t\tcaption = caption, captionAlpha = math.clamp(alpha, 0, 1),\n\t\tblend = blend,\n\t\twalking = t >= I.walk.from and t < I.walk.latest,\n\t\tholding = t < I.total,\n\t\tdone = t >= I.captionsEnd,\n\t}\nend\n\n-- The frames tools/preview/scene.py --title renders (and tests/title.luau keeps clear of the world's boxes): the drift's start, middle and arrival, and\n-- each intro shot's middle, the \"out\" shot with the spider where its walk ends.\nfunction TitleShots.views(): { { name: string, eye: Vector3, at: Vector3, fov: number } }\n\tlocal out = {}\n\tfor _, key in TitleShots.DRIFT do\n\t\ttable.insert(out, { name = `title_drift_{key.t}`, eye = key.eye, at = key.at, fov = key.fov })\n\tend\n\tfor _, s in TitleShots.INTRO.shots do\n\t\ttable.insert(out, { name = `intro_{s.name}`, eye = s.eye0:Lerp(s.eye1, 0.5), at = s.at0:Lerp(s.at1, 0.5), fov = s.fov })\n\tend\n\treturn out\nend\n\n-- ROBLOX-115: the preserve's drift's three keys as the previewer's views (tools/preview/scene.py --preserve): preserve_drift_0, _18 and _36.\nfunction TitleShots.preserveViews(): { { name: string, eye: Vector3, at: Vector3, fov: number } }\n\tlocal out = {}\n\tfor _, key in TitleShots.PRESERVE_DRIFT do\n\t\ttable.insert(out, { name = `preserve_drift_{key.t}`, eye = key.eye, at = key.at, fov = key.fov })\n\tend\n\t-- (ROBLOX-118) and the preserve's first shot of the intro, in the hut\n\tlocal g = TitleShots.PRESERVE_GLASS\n\ttable.insert(out, { name = \"preserve_intro_glass\", eye = g.eye0:Lerp(g.eye1, 0.5), at = g.at0:Lerp(g.at1, 0.5), fov = g.fov })\n\treturn out\nend\n\nreturn TitleShots\n",10378,3775720569},{"Shared/Perception/Observation","--!strict\n-- Observation (spec 21.3): one piece of sensed evidence, as the sensor makes it and the memory keeps it. A port of the frozen\n-- Godot scripts/perception/observation.gd (c87ce00), field for field. Observer, target (only when resolved), estimated position,\n-- modality, confidence in [0, 1], the tick it was observed at (an integer action tick) and a category. It is never refreshed from\n-- hidden truth: an observation is only ever made from what the observer could see at `observedTick`, and a later one is a new record.\n--\n-- Two modalities (spec 7):\n--   PERIPHERAL  broad coverage, a coarse direction only, no position and no category beyond \"movement\". The target is not resolved.\n--   INSPECTION  the forward cone: a position (to within the target's own size), a category that refines with continuous exposure\n--               (movement, possible prey, fly-like prey: A-004), and the target once it is resolved.\n-- Words for the categories belong to the presentation, never here. Pure: no engine services, so the plain Luau CLI runs it.\n--\n-- Naming: Godot's snake_case fields are camelCase here (track_id -> trackId, speed_wu_s -> speedWuS); the values are unchanged.\nlocal Observation = {}\nObservation.__index = Observation\n\nObservation.PERIPHERAL = \"peripheral_motion\"\nObservation.INSPECTION = \"forward_inspection\"\n\nObservation.MOVEMENT = \"movement\"\nObservation.POSSIBLE_PREY = \"possible_prey\"\nObservation.FLY_LIKE_PREY = \"fly_like_prey\"\n-- Refinement order: each is a finer guess than the one before it. No species is ever named (A-004).\nObservation.CATEGORIES = table.freeze({ \"movement\", \"possible_prey\", \"fly_like_prey\" })\n\nexport type Observation = {\n\tobserverId: string,\n\t-- The target's persistent id once the observer has resolved it (inspected it long enough), else \"\".\n\ttargetId: string,\n\t-- Opaque id the sensor gives one thing it keeps sensing, so the memory can follow it. It is not the target's id.\n\ttrackId: string,\n\t-- The estimate; meaningful only when hasPosition. A peripheral observation has none: only `direction`.\n\testimatedPosition: Vector3,\n\thasPosition: boolean,\n\t-- Unit direction from the observer to the thing, as sensed: exact enough to aim at for an inspection, quantised to a sector\n\t-- for a peripheral cue.\n\tdirection: Vector3,\n\tmodality: string,\n\tconfidence: number,\n\tobservedTick: number,\n\tcategory: string,\n\t-- Estimated size of the thing, WU (an inspection only). The memory uses it to judge whether a place could hide it.\n\tsizeWu: number,\n\t-- How large it looked, degrees of angle across.\n\tapparentSizeDeg: number,\n\t-- How fast it was seen moving, WU/s (an inspection only). A lost contact's plausible region grows at least this fast (A-027).\n\tspeedWuS: number,\n}\n\nlocal function isFinite(x: number): boolean\n\treturn x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal function vectorIsFinite(v: Vector3): boolean\n\treturn isFinite(v.X) and isFinite(v.Y) and isFinite(v.Z)\nend\n\n-- A new record with Godot's defaults (a peripheral movement cue straight ahead with nothing in it); `fields` overrides any of them.\nfunction Observation.new(fields: { [string]: any }?): Observation\n\tlocal o = {\n\t\tobserverId = \"\",\n\t\ttargetId = \"\",\n\t\ttrackId = \"\",\n\t\testimatedPosition = Vector3.zero,\n\t\thasPosition = false,\n\t\tdirection = Vector3.new(0, 0, -1), -- Godot's Vector3.FORWARD (both engines look down -Z)\n\t\tmodality = Observation.PERIPHERAL,\n\t\tconfidence = 0.0,\n\t\tobservedTick = 0,\n\t\tcategory = Observation.MOVEMENT,\n\t\tsizeWu = 0.0,\n\t\tapparentSizeDeg = 0.0,\n\t\tspeedWuS = 0.0,\n\t}\n\tif fields then\n\t\tfor k, v in fields do\n\t\t\t(o :: any)[k] = v\n\t\tend\n\tend\n\treturn setmetatable(o, Observation) :: any\nend\n\n-- The place of a category in the refinement order: 0 movement, 1 possible prey, 2 fly-like prey; -1 for anything else (Godot's Array.find).\nfunction Observation.rank(c: string): number\n\tlocal i = table.find(Observation.CATEGORIES, c)\n\treturn if i then i - 1 else -1\nend\n\n-- Problems with the record, empty when it is fine: the invariants of spec 21.3 (no NaN or infinity, confidence in [0, 1], a known\n-- modality and category, a position only for an inspection).\nfunction Observation.problems(o: Observation): { string }\n\tlocal out: { string } = {}\n\tif o.observerId == \"\" then\n\t\ttable.insert(out, \"no observer\")\n\tend\n\tif o.trackId == \"\" then\n\t\ttable.insert(out, \"no track\")\n\tend\n\tif not (o.modality == Observation.PERIPHERAL or o.modality == Observation.INSPECTION) then\n\t\ttable.insert(out, `unknown modality '{o.modality}'`)\n\tend\n\tif not table.find(Observation.CATEGORIES, o.category) then\n\t\ttable.insert(out, `unknown category '{o.category}'`)\n\tend\n\tif not isFinite(o.confidence) or o.confidence < 0.0 or o.confidence > 1.0 then\n\t\ttable.insert(out, `confidence {o.confidence} is not in [0, 1]`)\n\tend\n\tif o.observedTick < 0 then\n\t\ttable.insert(out, \"negative tick\")\n\tend\n\tif not vectorIsFinite(o.direction) or math.abs(o.direction.Magnitude - 1.0) > 1e-3 then\n\t\ttable.insert(out, \"direction is not a unit vector\")\n\tend\n\tif o.hasPosition and not vectorIsFinite(o.estimatedPosition) then\n\t\ttable.insert(out, \"estimated position is not finite\")\n\tend\n\tif o.modality == Observation.PERIPHERAL and o.hasPosition then\n\t\ttable.insert(out, \"a peripheral observation carries no position\")\n\tend\n\tif o.modality == Observation.PERIPHERAL and (o.category ~= Observation.MOVEMENT or o.targetId ~= \"\") then\n\t\ttable.insert(out, \"a peripheral observation has no category beyond movement and no resolved target\")\n\tend\n\tif o.modality == Observation.INSPECTION and not o.hasPosition then\n\t\ttable.insert(out, \"an inspection carries a position\")\n\tend\n\tif not isFinite(o.speedWuS) or o.speedWuS < 0.0 then\n\t\ttable.insert(out, \"speed is not a finite, non-negative number\")\n\tend\n\treturn out\nend\n\nfunction Observation.isValid(o: Observation): boolean\n\treturn #Observation.problems(o) == 0\nend\n\n-- The spec's fields as a plain table; the position is nil unless the record carries one (a cue's record has no position to read).\nfunction Observation.toDict(o: Observation): { [string]: any }\n\treturn {\n\t\tobserverId = o.observerId,\n\t\ttargetId = o.targetId,\n\t\ttrackId = o.trackId,\n\t\testimatedPosition = if o.hasPosition then o.estimatedPosition else nil,\n\t\tdirection = o.direction,\n\t\tmodality = o.modality,\n\t\tconfidence = o.confidence,\n\t\tobservedTick = o.observedTick,\n\t\tcategory = o.category,\n\t}\nend\n\nreturn Observation\n",6341,2913819601},{"Shared/Perception/ObservationMemory","--!strict\n-- ObservationMemory (spec 7, 21.3): what the observer remembers of what it sensed. A port of the frozen Godot\n-- scripts/perception/observation_memory.gd (c87ce00), method for method. The sensor hands it Observation records; it keeps one Contact\n-- per thing the sensor keeps sensing (a \"track\"), ages them, and says what is still sensed, what has been lost and what has gone. It\n-- never looks at the world: a contact changes only when an observation arrives, when time passes, or when the sensor reports that the\n-- remembered spot was inspected and is empty.\n--\n-- A contact is LIVE while observations keep coming (a peripheral cue repeats every cue cooldown, an inspection every tick) and LOST once\n-- none has arrived for the hold time of its modality. A lost contact's confidence falls in a straight line from what it was at the loss to\n-- nothing over `decayS` (6 s), and the contact is forgotten at that point. A lost contact that was inspected has a mark (A-002): its last\n-- observed position, which never moves, because the only thing that can move a position is a new inspection.\n--\n-- Which contact an observation belongs to is the sensor's decision, taken from evidence (A-027, D-040): a contact is the spider's\n-- hypothesis that some observations are of one visible thing, not the thing's identity in the world. The memory only keeps what it is\n-- told, and can fold a contact it knew only from cues into the lost contact it turned out to be (merge). The world id of a thing it is\n-- looking at is kept on the contact for as long as sight lasts (targetId) and dropped the moment sight is lost.\n--\n-- What a peripheral cue may and may not do (spec 7: coarse directional evidence, no label): it starts a contact, and it keeps a contact\n-- that is only cues alive. It never gives a position, never changes the category, the confidence or the position of a contact that has\n-- been inspected, and never brings an inspected contact back from lost: that takes another inspection (a reacquisition). What the cue\n-- did say, a bearing, is kept apart (cueTick, cueDirection) for the presentation's edge markers.\n--\n-- Differences from Godot that change no decision: the five signals are Signal objects (memory.contactAcquired:connect(fn)); contacts\n-- are walked oldest first (creation order) wherever Godot walks a dictionary, so announcements come in a fixed order.\nlocal Observation = require(script.Parent.Observation)\nlocal PerceptionMath = require(script.Parent.PerceptionMath)\nlocal Signal = require(script.Parent.Signal)\n\nlocal PERIPHERAL, INSPECTION = Observation.PERIPHERAL, Observation.INSPECTION\n\n-- =============================================================================================== Contact\n\nlocal Contact = {}\nContact.__index = Contact\nContact.LIVE = \"live\"\nContact.LOST = \"lost\"\n\nexport type Contact = {\n\ttrackId: string,\n\tobserverId: string,\n\t-- The world id of the thing this contact is live-linked to (spec 21.3: target, only when resolved), for validated interaction and\n\t-- nothing else. Set while an inspection has resolved the thing, dropped the moment the contact is lost, and never used to decide\n\t-- which contact an observation belongs to (A-027).\n\ttargetId: string,\n\tstate: string,\n\t-- Modality of the latest evidence that updated the record (a cue on an inspected contact does not).\n\tmodality: string,\n\tcategory: string,\n\t-- What the contact is believed to be worth now: the latest evidence's while live, falling after a loss.\n\tconfidence: number,\n\tconfidenceAtLoss: number,\n\t-- The last observed position: only an inspection gives one, and only another inspection changes it.\n\thasPosition: boolean,\n\tposition: Vector3,\n\tpositionTick: number,\n\tsizeWu: number,\n\tapparentSizeDeg: number,\n\t-- How fast it was seen moving at the last inspection, WU/s.\n\tspeedWuS: number,\n\t-- Latest direction from the observer of the evidence that updated the record (coarse for a cue).\n\tdirection: Vector3,\n\tfirstTick: number,\n\t-- Tick of the latest evidence that updated the record.\n\tobservedTick: number,\n\t-- The latest peripheral cue, apart from the record: its tick, its coarse bearing and how many there have been.\n\tcueTick: number,\n\tcueDirection: Vector3,\n\tcueCount: number,\n\tlostTick: number,\n\treacquisitions: number,\n\t-- False once the mark was found to be wrong (the spot was inspected and is empty).\n\tmarkValid: boolean,\n\t-- Creation order: \"oldest first\" breaks ties with it.\n\tseq: number,\n}\n\nfunction Contact.new(): Contact\n\treturn setmetatable({\n\t\ttrackId = \"\",\n\t\tobserverId = \"\",\n\t\ttargetId = \"\",\n\t\tstate = Contact.LIVE,\n\t\tmodality = PERIPHERAL,\n\t\tcategory = Observation.MOVEMENT,\n\t\tconfidence = 0.0,\n\t\tconfidenceAtLoss = 0.0,\n\t\thasPosition = false,\n\t\tposition = Vector3.zero,\n\t\tpositionTick = 0,\n\t\tsizeWu = 0.0,\n\t\tapparentSizeDeg = 0.0,\n\t\tspeedWuS = 0.0,\n\t\tdirection = Vector3.new(0, 0, -1),\n\t\tfirstTick = 0,\n\t\tobservedTick = 0,\n\t\tcueTick = -1000000,\n\t\tcueDirection = Vector3.zero,\n\t\tcueCount = 0,\n\t\tlostTick = 0,\n\t\treacquisitions = 0,\n\t\tmarkValid = true,\n\t\tseq = 0,\n\t}, Contact) :: any\nend\n\nfunction Contact.isLive(c: Contact): boolean\n\treturn c.state == Contact.LIVE\nend\n\n-- Live and being inspected: the position is where it is being seen now.\nfunction Contact.isInspectedNow(c: Contact): boolean\n\treturn c.state == Contact.LIVE and c.modality == INSPECTION\nend\n\nfunction Contact.hasMark(c: Contact): boolean\n\treturn c.state == Contact.LOST and c.hasPosition and c.markValid\nend\n\nfunction Contact.toDict(c: Contact): { [string]: any }\n\treturn {\n\t\ttrackId = c.trackId,\n\t\ttargetId = c.targetId,\n\t\tstate = c.state,\n\t\tmodality = c.modality,\n\t\tcategory = c.category,\n\t\tconfidence = c.confidence,\n\t\thasPosition = c.hasPosition,\n\t\tposition = if c.hasPosition then c.position else nil,\n\t\tobservedTick = c.observedTick,\n\t\tpositionTick = c.positionTick,\n\t\tlostTick = c.lostTick,\n\t}\nend\n\n-- =============================================================================================== Memory\n\nlocal ObservationMemory = {}\nObservationMemory.__index = ObservationMemory\nObservationMemory.Contact = Contact\n\nexport type ObservationMemory = {\n\t-- Ticks a second lasts (the physics rate), the seconds a lost contact's confidence takes to fall to nothing, and how long a contact\n\t-- may go without new evidence before it counts as lost.\n\thz: number,\n\tdecayS: number,\n\tholdInspectionS: number,\n\tholdPeripheralS: number,\n\t-- The tick the memory was last advanced to.\n\tnowTick: number,\n\t-- How many observations were ever ingested, by modality; for tests and the debug view.\n\tingested: number,\n\tingestedInspection: number,\n\tingestedPeripheral: number,\n\t-- A new contact, or a track picked up again after it had been forgotten.\n\tcontactAcquired: Signal.Signal,\n\t-- (contact, oldCategory, newCategory): the category a contact is believed to be refined (up) or fell back (down).\n\tcategoryChanged: Signal.Signal,\n\t-- Sight of a contact ended: its hold time ran out with no new observation.\n\tcontactLost: Signal.Signal,\n\t-- A lost contact was observed again: the same track, its record updated.\n\tcontactReacquired: Signal.Signal,\n\t-- (contact, reason): a contact left the memory: \"expired\" (its confidence reached nothing), \"empty\" (the sensor inspected the\n\t-- remembered spot and found nothing there), \"merged\" (a contact known only from cues turned out to be a lost one) or \"captured\".\n\tcontactEnded: Signal.Signal,\n\t_contacts: { [string]: Contact },\n\t_seq: number,\n}\n\nfunction ObservationMemory.new(): any\n\treturn setmetatable({\n\t\thz = 60.0,\n\t\tdecayS = 6.0,\n\t\tholdInspectionS = 0.15,\n\t\tholdPeripheralS = 1.0,\n\t\tnowTick = 0,\n\t\tingested = 0,\n\t\tingestedInspection = 0,\n\t\tingestedPeripheral = 0,\n\t\tcontactAcquired = Signal.new(),\n\t\tcategoryChanged = Signal.new(),\n\t\tcontactLost = Signal.new(),\n\t\tcontactReacquired = Signal.new(),\n\t\tcontactEnded = Signal.new(),\n\t\t_contacts = {},\n\t\t_seq = 0,\n\t}, ObservationMemory)\nend\n\nfunction ObservationMemory.configure(self: any, hz: number, decayS: number, holdInspectionS: number, holdPeripheralS: number)\n\tself.hz = math.max(hz, 1.0)\n\tself.decayS = math.max(decayS, 0.01)\n\tself.holdInspectionS = math.max(holdInspectionS, 0.0)\n\tself.holdPeripheralS = math.max(holdPeripheralS, 0.0)\nend\n\nfunction ObservationMemory.clear(self: any)\n\tself._contacts = {}\nend\n\nfunction ObservationMemory.getContact(self: any, trackId: string): Contact?\n\treturn self._contacts[trackId]\nend\n\nfunction ObservationMemory.count(self: any): number\n\tlocal n = 0\n\tfor _ in self._contacts do\n\t\tn += 1\n\tend\n\treturn n\nend\n\n-- Every contact, oldest first.\nfunction ObservationMemory.contacts(self: any): { Contact }\n\tlocal out: { Contact } = {}\n\tfor _, c in self._contacts do\n\t\ttable.insert(out, c)\n\tend\n\ttable.sort(out, function(a: Contact, b: Contact): boolean\n\t\tif a.firstTick ~= b.firstTick then\n\t\t\treturn a.firstTick < b.firstTick\n\t\tend\n\t\treturn a.seq < b.seq\n\tend)\n\treturn out\nend\n\nlocal function filtered(list: { Contact }, keep: (Contact) -> boolean): { Contact }\n\tlocal out: { Contact } = {}\n\tfor _, c in list do\n\t\tif keep(c) then\n\t\t\ttable.insert(out, c)\n\t\tend\n\tend\n\treturn out\nend\n\nfunction ObservationMemory.liveContacts(self: any): { Contact }\n\treturn filtered(self:contacts(), function(c) return c.state == Contact.LIVE end)\nend\n\nfunction ObservationMemory.lostContacts(self: any): { Contact }\n\treturn filtered(self:contacts(), function(c) return c.state == Contact.LOST end)\nend\n\n-- Lost contacts that were inspected and whose spot has not been found empty: the last-seen marks.\nfunction ObservationMemory.marks(self: any): { Contact }\n\treturn filtered(self:contacts(), function(c) return Contact.hasMark(c) end)\nend\n\n-- Seconds since sight of a lost contact ended; 0 for a live one.\nfunction ObservationMemory.ageS(self: any, c: Contact): number\n\tif c.state == Contact.LIVE then\n\t\treturn 0.0\n\tend\n\treturn (self.nowTick - c.lostTick) / self.hz\nend\n\n-- How much of a thing's earlier inspection still counts if it is seen again: 1 for a live contact, falling to 0 as the memory of a lost one\n-- fades, 0 for a track that is gone.\nfunction ObservationMemory.familiarity(self: any, trackId: string): number\n\tlocal c = self._contacts[trackId]\n\tif c == nil then\n\t\treturn 0.0\n\tend\n\tif c.state == Contact.LIVE then\n\t\treturn 1.0\n\tend\n\treturn PerceptionMath.decayedConfidence(1.0, self:ageS(c), self.decayS)\nend\n\n-- Seconds since the evidence that last updated the record.\nfunction ObservationMemory.observedAgeS(self: any, c: Contact): number\n\treturn (self.nowTick - c.observedTick) / self.hz\nend\n\n-- Seconds since the latest peripheral cue (a very large number if there never was one).\nfunction ObservationMemory.cueAgeS(self: any, c: Contact): number\n\treturn (self.nowTick - c.cueTick) / self.hz\nend\n\n-- 0 for a live contact and for one just lost, 1 when its memory is gone (the mark is at its stalest).\nfunction ObservationMemory.stalenessOf(self: any, c: Contact): number\n\tif c.state == Contact.LIVE then\n\t\treturn 0.0\n\tend\n\treturn PerceptionMath.staleness(self:ageS(c), self.decayS)\nend\n\n-- Ticks a contact may go without evidence of this modality before it counts as lost. The sensor reads the same number to tell unbroken\n-- sight (the thing is still the same contact) from sight that was lost.\nfunction ObservationMemory.holdTicks(self: any, modality: string): number\n\treturn math.round((if modality == INSPECTION then self.holdInspectionS else self.holdPeripheralS) * self.hz)\nend\n\n-- Take in one observation. A record that is not valid (spec 21.3) is refused and returns nil.\nfunction ObservationMemory.ingest(self: any, obs: Observation.Observation?): Contact?\n\tif obs == nil or not Observation.isValid(obs) then\n\t\treturn nil\n\tend\n\tself.ingested += 1\n\tlocal existing: Contact? = self._contacts[obs.trackId]\n\tlocal fresh = existing == nil\n\tlocal wasLost = false\n\tlocal c: Contact\n\tif existing == nil then\n\t\tc = Contact.new()\n\t\tc.trackId = obs.trackId\n\t\tc.observerId = obs.observerId\n\t\tc.firstTick = obs.observedTick\n\t\tc.category = obs.category\n\t\tself._seq += 1\n\t\tc.seq = self._seq\n\t\tself._contacts[c.trackId] = c\n\telse\n\t\tc = existing\n\t\twasLost = c.state == Contact.LOST\n\tend\n\tif obs.modality == PERIPHERAL then\n\t\tself.ingestedPeripheral += 1\n\t\tc.cueTick = obs.observedTick\n\t\tc.cueDirection = obs.direction\n\t\tc.cueCount += 1\n\t\tif not fresh and c.hasPosition then\n\t\t\treturn c -- a bearing says nothing new about something that was inspected (see the header)\n\t\tend\n\tend\n\tlocal oldCategory = c.category\n\tc.state = Contact.LIVE\n\tc.modality = obs.modality\n\tc.confidence = obs.confidence\n\tc.observedTick = obs.observedTick\n\tc.direction = obs.direction\n\tif obs.targetId ~= \"\" then\n\t\tc.targetId = obs.targetId\n\tend\n\tif obs.modality == INSPECTION then\n\t\tself.ingestedInspection += 1\n\t\tc.hasPosition = true\n\t\tc.position = obs.estimatedPosition\n\t\tc.positionTick = obs.observedTick\n\t\tc.sizeWu = obs.sizeWu\n\t\tc.apparentSizeDeg = obs.apparentSizeDeg\n\t\tc.speedWuS = obs.speedWuS\n\t\tc.markValid = true\n\t\tc.category = obs.category\n\tend\n\tif fresh then\n\t\tself.contactAcquired:emit(c)\n\telseif wasLost then\n\t\tc.reacquisitions += 1\n\t\tself.contactReacquired:emit(c)\n\tend\n\tif c.category ~= oldCategory then\n\t\tself.categoryChanged:emit(c, oldCategory, c.category)\n\tend\n\treturn c\nend\n\n-- The ids of the contacts, oldest first (the order Godot's dictionary keeps them in).\nlocal function orderedIds(self: any): { string }\n\tlocal list: { Contact } = {}\n\tfor _, c in self._contacts do\n\t\ttable.insert(list, c)\n\tend\n\ttable.sort(list, function(a: Contact, b: Contact): boolean\n\t\treturn a.seq < b.seq\n\tend)\n\tlocal ids: { string } = {}\n\tfor _, c in list do\n\t\ttable.insert(ids, c.trackId)\n\tend\n\treturn ids\nend\n\n-- Moves time on to `tick`: live contacts that have had no evidence for their hold time become lost, lost contacts lose confidence, and\n-- those with none left are forgotten.\nfunction ObservationMemory.advance(self: any, tick: number)\n\tself.nowTick = tick\n\tfor _, id in orderedIds(self) do\n\t\tlocal c: Contact? = self._contacts[id]\n\t\tif c == nil then\n\t\t\tcontinue\n\t\tend\n\t\tif c.state == Contact.LIVE then\n\t\t\tif tick - c.observedTick > self:holdTicks(c.modality) then\n\t\t\t\tc.state = Contact.LOST\n\t\t\t\tc.lostTick = tick\n\t\t\t\tc.confidenceAtLoss = c.confidence\n\t\t\t\tc.targetId = \"\" -- sight is over: the link to the world goes with it\n\t\t\t\tself.contactLost:emit(c)\n\t\t\tend\n\t\tend\n\t\tif c.state == Contact.LOST then\n\t\t\tlocal age = (tick - c.lostTick) / self.hz\n\t\t\tc.confidence = PerceptionMath.decayedConfidence(c.confidenceAtLoss, age, self.decayS)\n\t\t\tif age >= self.decayS - 1e-9 then\n\t\t\t\tself._contacts[id] = nil\n\t\t\t\tself.contactEnded:emit(c, \"expired\")\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- The sensor found that a contact it knew only from cues (it has no position) is the lost contact `intoId`, seen again: the bearing of\n-- the latest cue and the count of cues go to that record, and the cue-only contact is dropped (reason \"merged\"). Returns false when either\n-- is missing or the one to fold has a position of its own (an inspected contact is never folded into another).\nfunction ObservationMemory.merge(self: any, fromId: string, intoId: string): boolean\n\tlocal a: Contact? = self._contacts[fromId]\n\tlocal b: Contact? = self._contacts[intoId]\n\tif a == nil or b == nil or a == b or a.hasPosition then\n\t\treturn false\n\tend\n\tif a.cueTick > b.cueTick then\n\t\tb.cueTick = a.cueTick\n\t\tb.cueDirection = a.cueDirection\n\tend\n\tb.cueCount += a.cueCount\n\tself._contacts[fromId] = nil\n\tself.contactEnded:emit(a, \"merged\")\n\treturn true\nend\n\n-- The sensor looked at a lost contact's last observed position, clearly and for long enough, and nothing was there: the memory of the\n-- spot is wrong, so it is dropped. Returns false for a contact that is not lost.\nfunction ObservationMemory.invalidate(self: any, trackId: string, reason: string?): boolean\n\tlocal c: Contact? = self._contacts[trackId]\n\tif c == nil or c.state ~= Contact.LOST then\n\t\treturn false\n\tend\n\tc.markValid = false\n\tc.confidence = 0.0\n\tself._contacts[trackId] = nil\n\tself.contactEnded:emit(c, reason or \"empty\")\n\treturn true\nend\n\n-- The sensor resolved a capture by a live link or unique spatial bodily evidence.\nfunction ObservationMemory.resolveCapture(self: any, trackId: string): boolean\n\tlocal c: Contact? = self._contacts[trackId]\n\tif c == nil then\n\t\treturn false\n\tend\n\tself._contacts[trackId] = nil\n\tself.contactEnded:emit(c, \"captured\")\n\treturn true\nend\n\nreturn ObservationMemory\n",16249,2937809045},{"Shared/Perception/PerceptionMath","--!strict\n-- Pure helpers for the perception layer (spec 7): angles, apparent size, the exposure a classification needs, the evidence's\n-- confidence, the coarse direction a peripheral cue is given, how a remembered contact fades. A port of the frozen Godot\n-- scripts/perception/perception_math.gd (c87ce00), function for function, with the same numbers. Nothing here touches the scene.\n-- Checked against values exported from Godot (tests/perception_reference.json) and against the hand-written expectations of Godot's\n-- own unit tests (tests/unit/test_perception_math.gd), both in tests/perception.luau.\nlocal Observation = require(script.Parent.Observation)\n\nlocal PerceptionMath = {}\n\nlocal EPS = 1e-6\nPerceptionMath.EPS = EPS\n-- A peripheral cue is given a direction in sectors of the observer's own bearing, and in coarse bands of elevation.\nPerceptionMath.PITCH_BAND_DEG = 30.0\n-- Visibility of a sample point (A-024, D-039). A ray the world stops short of its sample point has not seen it: the world is in front of\n-- it. The only allowance is for a sample that lies in the skin of the surface the thing rests on or against and for the float error of a\n-- long cast: SIGHT_SHARE of the thing's own radius plus SIGHT_FLOAT_PER_WU for each WU of ray, and never more than SIGHT_CEILING.\nPerceptionMath.SIGHT_SHARE = 0.1\nPerceptionMath.SIGHT_FLOAT_PER_WU = 1.0e-5\nPerceptionMath.SIGHT_CEILING = 0.05\n\nlocal function isFinite(x: number): boolean\n\treturn x == x and x ~= math.huge and x ~= -math.huge\nend\n\n-- Godot's Vector3.normalized(): a vector with no length stays zero.\nlocal function normalized(v: Vector3): Vector3\n\tlocal m = v.Magnitude\n\tif m == 0 then\n\t\treturn Vector3.zero\n\tend\n\treturn v / m\nend\n\n-- How far short of its sample point a ray may be stopped by the world and still count as having seen it (A-024). The sample points sit up\n-- to 0.8 of the radius off the centre, so for a thing of radius r the allowance is a tenth of r: a speck's whole body is never inside it,\n-- and a large thing resting on a wall still has the points that lie in the wall's face counted.\nfunction PerceptionMath.sightTolerance(radius: number, rayLength: number): number\n\treturn math.min(\n\t\tPerceptionMath.SIGHT_CEILING,\n\t\tPerceptionMath.SIGHT_SHARE * math.max(radius, 0.0) + PerceptionMath.SIGHT_FLOAT_PER_WU * math.max(rayLength, 0.0)\n\t)\nend\n\n-- The furthest a lost contact's thing can be from where it was last observed when something is seen `elapsedS` later (A-027, D-040).\n-- Three parts, each an observation or an explicit assumption and none of them the truth about where the thing went: the sizes of the two\n-- sightings (a position is only good to about the size of what it was taken from), and the distance the thing could have covered in the\n-- time at the conservative speed bound, or at the speed it was last seen moving at if that was greater.\nfunction PerceptionMath.plausibleRadius(oldSizeWu: number, newSizeWu: number, elapsedS: number, speedBound: number, observedSpeed: number): number\n\treturn 0.5 * (math.max(oldSizeWu, 0.0) + math.max(newSizeWu, 0.0)) + math.max(speedBound, observedSpeed) * math.max(elapsedS, 0.0)\nend\n\n-- Whether two size estimates can belong to one thing: neither is more than `ratio` times the other. A size that is not known (zero) is\n-- compatible with anything.\nfunction PerceptionMath.sizesCompatible(a: number, b: number, ratio: number): boolean\n\tif a <= EPS or b <= EPS then\n\t\treturn true\n\tend\n\treturn math.max(a, b) <= math.min(a, b) * math.max(ratio, 1.0) + EPS\nend\n\n-- Whether a lost contact refined to `oldCategory` can be a thing whose appearance can be refined no further than `cap`: what was learned\n-- about the one cannot be finer than the other can ever look.\nfunction PerceptionMath.categoriesCompatible(oldCategory: string, cap: string): boolean\n\treturn Observation.rank(oldCategory) <= Observation.rank(cap)\nend\n\n-- Angle between two vectors (Godot's Vector3.angle_to, which needs no unit length), radians.\nfunction PerceptionMath.angleTo(a: Vector3, b: Vector3): number\n\treturn math.atan2(a:Cross(b).Magnitude, a:Dot(b))\nend\n\n-- Angle between two directions, radians; 0 when either has no length.\nfunction PerceptionMath.angleBetween(a: Vector3, b: Vector3): number\n\tif a:Dot(a) < EPS * EPS or b:Dot(b) < EPS * EPS then\n\t\treturn 0.0\n\tend\n\treturn PerceptionMath.angleTo(normalized(a), normalized(b))\nend\n\n-- True when `to` lies within `halfAngle` (radians) of `axis`.\nfunction PerceptionMath.inCone(axis: Vector3, to: Vector3, halfAngle: number): boolean\n\treturn to:Dot(to) > EPS * EPS and PerceptionMath.angleBetween(axis, to) <= halfAngle + 1e-9\nend\n\n-- How large a thing of `sizeWu` across looks from `distance`, degrees of angle.\nfunction PerceptionMath.apparentSizeDeg(sizeWu: number, distance: number): number\n\tif distance <= EPS then\n\t\treturn 180.0\n\tend\n\treturn math.deg(2.0 * math.atan(sizeWu * 0.5 / distance))\nend\n\n-- Continuous exposure a refinement needs: `baseS` for an easy target (one that looks at least `easyDeg` across), and proportionally\n-- longer the smaller it looks. Infinite for something with no apparent size.\nfunction PerceptionMath.requiredExposure(baseS: number, apparentDeg: number, easyDeg: number): number\n\tif apparentDeg <= EPS then\n\t\treturn math.huge\n\tend\n\treturn baseS * math.max(1.0, easyDeg / apparentDeg)\nend\n\n-- The category continuous exposure supports. Nothing smaller than `minDeg` is refined at all.\nfunction PerceptionMath.classify(exposureS: number, apparentDeg: number, easyS: number, flyS: number, easyDeg: number, minDeg: number): string\n\tif apparentDeg < minDeg then\n\t\treturn Observation.MOVEMENT\n\tend\n\tif exposureS + EPS >= PerceptionMath.requiredExposure(flyS, apparentDeg, easyDeg) then\n\t\treturn Observation.FLY_LIKE_PREY\n\tend\n\tif exposureS + EPS >= PerceptionMath.requiredExposure(easyS, apparentDeg, easyDeg) then\n\t\treturn Observation.POSSIBLE_PREY\n\tend\n\treturn Observation.MOVEMENT\nend\n\n-- Confidence of an inspection: it rises with exposure (to the fly-like refinement) and falls with how much of the thing is hidden. From\n-- 0.4 x 0.68 = 0.27 (one of five sample points seen, no exposure yet) to 1.\nfunction PerceptionMath.inspectionConfidence(exposureS: number, flyNeededS: number, visibleFraction: number): number\n\tlocal progress = 0.0\n\tif isFinite(flyNeededS) then\n\t\tprogress = math.clamp(exposureS / math.max(flyNeededS, EPS), 0.0, 1.0)\n\tend\n\treturn math.clamp((0.4 + 0.6 * progress) * (0.6 + 0.4 * math.clamp(visibleFraction, 0.0, 1.0)), 0.0, 1.0)\nend\n\n-- Confidence of a peripheral cue: low, and a little higher the nearer it is. In [0.1, 0.3].\nfunction PerceptionMath.peripheralConfidence(distance: number, rangeWu: number): number\n\treturn math.clamp(0.1 + 0.2 * (1.0 - distance / math.max(rangeWu, EPS)), 0.1, 0.3)\nend\n\n-- The direction of a peripheral cue, coarse: its bearing about `up` from `forward` rounded to a sector, its elevation to a band of\n-- PITCH_BAND_DEG. Returns a unit vector. This is all a peripheral observation says about where.\nfunction PerceptionMath.quantizeDirection(dir: Vector3, forward: Vector3, up: Vector3, sectorDeg: number): Vector3\n\tlocal d = normalized(dir)\n\tlocal u = normalized(up)\n\tlocal f = forward - u * forward:Dot(u)\n\tif f:Dot(f) < EPS then\n\t\tf = d - u * d:Dot(u)\n\tend\n\tif f:Dot(f) < EPS then\n\t\treturn d -- straight up or down: there is no bearing to round\n\tend\n\tf = normalized(f)\n\tlocal right = normalized(f:Cross(u))\n\tlocal yaw = math.atan2(d:Dot(right), d:Dot(f))\n\tlocal pitch = math.asin(math.clamp(d:Dot(u), -1.0, 1.0))\n\tlocal sector = math.rad(math.max(sectorDeg, 0.5))\n\tlocal band = math.rad(PerceptionMath.PITCH_BAND_DEG)\n\tlocal yq = math.round(yaw / sector) * sector\n\tlocal pq = math.round(pitch / band) * band\n\treturn normalized(f * (math.cos(pq) * math.cos(yq)) + right * (math.cos(pq) * math.sin(yq)) + u * math.sin(pq))\nend\n\n-- Confidence of a contact that is no longer sensed: it falls straight to nothing over `decayS`, from the confidence it had when it was lost.\nfunction PerceptionMath.decayedConfidence(confidenceAtLoss: number, ageS: number, decayS: number): number\n\tif decayS <= EPS then\n\t\treturn 0.0\n\tend\n\treturn math.clamp(confidenceAtLoss * (1.0 - ageS / decayS), 0.0, 1.0)\nend\n\n-- 0 when a contact has only just been lost, 1 when its memory is gone.\nfunction PerceptionMath.staleness(ageS: number, decayS: number): number\n\tif decayS <= EPS then\n\t\treturn 1.0\n\tend\n\treturn math.clamp(ageS / decayS, 0.0, 1.0)\nend\n\nreturn PerceptionMath\n",8423,2779784327},{"Shared/Perception/Sensor","--!strict\n-- Sensor: the world half of Godot's SensorSystem (scripts/perception/sensor_system.gd, c87ce00). SensorCore keeps what needs no world (which\n-- contact a sighting is filed under, how long a thing has been in view, the cue and its cooldown, the empty-spot check); this is what looks.\n-- Each tick it reads the observer's eye and gaze (never the camera's), takes the percept of every perceivable thing and decides what the\n-- senses could pick up of it:\n--   * a thing inside the broad peripheral field that moves and can be seen through at least one of its sample points gives a PERIPHERAL cue:\n--     a coarse bearing and nothing else, at most once per cue cooldown for each thing;\n--   * a thing inside the narrow inspection cone along the gaze that can be seen, and looks big enough, is INSPECTED: its position is\n--     estimated from the points that could be seen, and the longer it is held in the cone without a break the finer the category.\n-- Line of sight is five rays from the eye to sample points of the thing; a point the world stands in front of does not count. Nothing about a\n-- thing that cannot be seen reaches the memory: a hidden thing makes no observation, and the memory is never refreshed from where it\n-- really is. The sensor also looks at the spots where lost contacts were last seen (SensorCore.checkSpots, through _allVisible below).\n--\n-- Ported method for method from _physics_process (in its order), _sense, _visible_points, _sample_points, _clear, _all_visible, could_sense,\n-- describe_tracks, _record_cost, cost_percentile and reset. Not here: on_capture (the feeding chunk), Focus, and any presentation.\n--\n-- How a caller drives it: once at the START of every fixed tick (Godot's sensor runs at priority -10, before the motor and the things that\n-- move, so it reads the world as the previous tick committed it):\n--\n--   sensor:step(delta, observer, percepts, cast)\n--     observer  {eye, gaze, up, heading}: where the eyes are, the axis of the cone, the body's up and facing (the motor's observer())\n--     percepts  one SensorCore.Percept for every perceivable thing that is there to be sensed (a thing that is not simply is not listed)\n--     cast      (from, to) -> the position of the first WORLD hit on that segment, nil when it is clear. Only world geometry may stop it:\n--               not the observer, not the things sensed (Sensor.workspaceCast makes one from a RaycastParams).\n--\n-- Rates (spec 20): the broad scan of everything runs at broad_query_hz; things already tracked (a live contact), things whose last position\n-- is remembered as a mark, and things within close_check_range_wu of the eye are checked every tick. Tick numbering is Godot's: the tick\n-- counts up first (SensorCore.beginTick), so the first broad scan is tick 1 and the next is due 6 ticks later.\n--\n-- Where the counts live: the sensor's own are fields here (broadScans, rays, checks, cost); the ones SensorCore keeps for the bookkeeping it\n-- does are read from sensor.core (tick, cuesMade, inspectionsMade, spotChecksTotal and the cueEmitted signal).\nlocal PerceptionMath = require(script.Parent.PerceptionMath)\nlocal SensorCore = require(script.Parent.SensorCore)\nlocal ObservationMemory = require(script.Parent.ObservationMemory)\n\nlocal Contact = ObservationMemory.Contact\n\nlocal Sensor = {}\nSensor.__index = Sensor\n\nSensor.SAMPLE_COUNT = 5\n-- The sample points sit this share of a thing's radius off its centre.\nSensor.SAMPLE_SPREAD = 0.8\n-- CPU time of the sensor tick in microseconds: a ring of the latest, for percentiles.\nSensor.COST_RING = 1200\n-- T13a, the lateral eyes' motion sense (the spider-eye picture's shimmer): an entry stays this long after the thing was last seen moving.\nSensor.MOTION_HOLD_TICKS = 15\n\n-- The observer the sensor reads (Godot: get_eye_position, get_gaze_direction, get_visual_up, get_heading_vector).\nexport type Observer = { eye: Vector3, gaze: Vector3, up: Vector3, heading: Vector3 }\n-- The position of the first world hit on the segment from, to; nil when nothing of the world is in the way.\nexport type Cast = (Vector3, Vector3) -> Vector3?\n-- What the last check of a thing found, for the developer view (Godot's Track.last_check): the fields appear as the check passes them.\nexport type Check = {\n\tinRange: boolean,\n\tdistance: number,\n\toffAxisDeg: number?,\n\tvisiblePoints: number?,\n\tinCone: boolean?,\n\tapparentDeg: number?,\n}\n-- T13a: a thing the eyes could see moving on its last check: the sensed direction from the eye, the distance, how big it looked, the tick.\nexport type Moving = { direction: Vector3, distance: number, apparent: number, tick: number }\nexport type TrackRow = {\n\tperceptId: string,\n\ttrackId: string,\n\texposureS: number,\n\tinRange: boolean?,\n\tdistance: number?,\n\toffAxisDeg: number?,\n\tvisiblePoints: number?,\n\tinCone: boolean?,\n\tapparentDeg: number?,\n}\n\nlocal EPS = 1e-6\n\n-- Godot's Vector3.normalized(): a vector with no length stays zero.\nlocal function normalized(v: Vector3): Vector3\n\tlocal m = v.Magnitude\n\tif m == 0 then\n\t\treturn Vector3.zero\n\tend\n\treturn v / m\nend\n\nfunction Sensor.new(memory: any, observerId: string?): any\n\treturn setmetatable({\n\t\tmemory = memory,\n\t\tcore = SensorCore.new(memory, observerId),\n\t\tenabled = true,\n\t\t-- Statistics, for tests and the developer view.\n\t\tbroadScans = 0,\n\t\traysThisTick = 0,\n\t\tmaxRaysInATick = 0,\n\t\traysTotal = 0,\n\t\tchecksThisTick = 0,\n\t\tchecksTotal = 0,\n\t\t-- The memory-spot checks' rays (also counted in raysTotal); their number of checks is core.spotChecksTotal.\n\t\tspotRaysTotal = 0,\n\t\t-- CPU time of the ticks that did the work, microseconds: the total, the largest and a ring of the latest for percentiles.\n\t\tcpuUsTotal = 0,\n\t\tcpuTicks = 0,\n\t\tcpuUsMax = 0,\n\t\t-- What the observer's eyes, gaze and up were on the last tick (the developer view draws the cones from them).\n\t\tlastEye = Vector3.zero,\n\t\tlastAxis = Vector3.new(0, 0, -1),\n\t\tlastUp = Vector3.new(0, 1, 0),\n\t\t-- T13a, for the spider-eye picture only: nothing reads it to decide anything and it holds only what the sightline checks found.\n\t\tmotionSeen = {} :: { [string]: Moving },\n\t\t_checks = {} :: { [string]: Check },\n\t\t_nextBroadTick = 0,\n\t\t_ring = {} :: { number },\n\t\t_costBase = 0,\n\t}, Sensor)\nend\n\n-- Takes the perception section of a species profile (Species.<id>.perception) and sets the memory's timing to match.\nfunction Sensor.configureFrom(self: any, perception: { [string]: number })\n\tself.core:configureFrom(perception)\nend\n\nfunction Sensor.getTrack(self: any, perceptId: string): SensorCore.Track?\n\treturn self.core:getTrack(perceptId)\nend\n\n-- The track a percept id is filed under, \"\" if it was never sensed. Tests and the developer view only.\nfunction Sensor.trackIdFor(self: any, perceptId: string): string\n\treturn self.core:trackIdFor(perceptId)\nend\n\n-- What the last check of a thing found (Godot: get_track(id).last_check); nil for a thing that has no track.\nfunction Sensor.lastCheck(self: any, perceptId: string): Check?\n\treturn self._checks[perceptId]\nend\n\n-- Forget everything about what is being tracked (the memory is cleared separately). The tick and the statistics go on.\nfunction Sensor.reset(self: any)\n\tself.core:reset()\n\tself.motionSeen = {}\n\tself._checks = {}\n\tself._nextBroadTick = 0\nend\n\n-- ================================================================================================ the tick\n\n-- One physics tick of the senses (Godot _physics_process): see the header for what the caller passes.\nfunction Sensor.step(self: any, delta: number, observer: Observer, percepts: { SensorCore.Percept }, cast: Cast)\n\tself.raysThisTick = 0\n\tself.checksThisTick = 0\n\tif not self.enabled then\n\t\treturn\n\tend\n\tlocal t0 = os.clock()\n\tlocal core = self.core\n\tlocal tick: number = core:beginTick(delta) -- the tick counts up and every track's gap since it was last inspected grows\n\tlocal eye, axis, up, forward = observer.eye, observer.gaze, observer.up, observer.heading\n\tself.lastEye, self.lastAxis, self.lastUp = eye, axis, up\n\tlocal broadDue = tick >= self._nextBroadTick\n\tif broadDue then\n\t\tself._nextBroadTick = tick + math.max(1, math.round(SensorCore.HZ / math.max(core.broadHz, 0.1)))\n\t\tself.broadScans += 1\n\tend\n\tlocal inspected: { SensorCore.Inspected } = {}\n\tlocal sightings: { SensorCore.Sighting } = {}\n\tlocal present: { [string]: boolean } = {}\n\tfor _, p in percepts do\n\t\tpresent[p.id] = true\n\t\tlocal t = core:trackOf(p.id)\n\t\tlocal c: ObservationMemory.Contact? = if t.trackId ~= \"\" then core.memory:getContact(t.trackId) else nil\n\t\tlocal watching = c ~= nil and (c.state == Contact.LIVE or Contact.hasMark(c))\n\t\tif broadDue or watching or (p.position - eye).Magnitude <= core.closeRangeWu then\n\t\t\tself.checksThisTick += 1\n\t\t\tself.checksTotal += 1\n\t\t\tself:_sense(t, p, eye, axis, up, forward, cast, delta, inspected, sightings)\n\t\tend\n\tend\n\tcore:fileSightings(sightings, delta)\n\tcore:checkSpots(eye, axis, up, delta, inspected, function(from: Vector3, center: Vector3, radius: number, u: Vector3): boolean\n\t\treturn self:_allVisible(cast, from, center, radius, u)\n\tend)\n\tcore:endTick(present) -- the memory moves on to this tick, then the tracks of things that are no longer there go\n\tfor id in self._checks do\n\t\tif not present[id] then\n\t\t\tself._checks[id] = nil\n\t\tend\n\tend\n\tfor id, m in self.motionSeen do\n\t\tif not present[id] or tick - m.tick > Sensor.MOTION_HOLD_TICKS then\n\t\t\tself.motionSeen[id] = nil\n\t\tend\n\tend\n\tself.maxRaysInATick = math.max(self.maxRaysInATick, self.raysThisTick)\n\tself:_recordCost(math.floor((os.clock() - t0) * 1.0e6 + 0.5))\nend\n\n-- What the eyes make of one thing (Godot _sense): in range, inside the peripheral field, the sample points that could be seen, and then\n-- either an inspection (in the cone and big enough to look at) or, if it moves, a cue.\nfunction Sensor._sense(self: any, t: SensorCore.Track, p: SensorCore.Percept, eye: Vector3, axis: Vector3, up: Vector3, forward: Vector3, cast: Cast, delta: number, inspected: { SensorCore.Inspected }, sightings: { SensorCore.Sighting })\n\tlocal core = self.core\n\tlocal center = p.position\n\tlocal radius = math.max(p.radius, 0.01)\n\tlocal to = center - eye\n\tlocal dist = to.Magnitude\n\tlocal reach: number = core:reachWu()\n\tlocal check: Check = { inRange = dist <= reach, distance = dist }\n\tself._checks[p.id] = check\n\tif dist > reach or dist < SensorCore.MIN_DISTANCE then\n\t\treturn\n\tend\n\tlocal dir = to / dist\n\tlocal offAxis = PerceptionMath.angleTo(axis, dir)\n\tcheck.offAxisDeg = math.deg(offAxis)\n\tif offAxis > math.rad(core.peripheralConeDeg) * 0.5 then\n\t\treturn\n\tend\n\tlocal seen = self:_visiblePoints(cast, eye, center, radius, up)\n\tcheck.visiblePoints = #seen\n\tif #seen == 0 then\n\t\treturn\n\tend\n\tlocal estimate = Vector3.zero\n\tfor _, s in seen do\n\t\testimate += s\n\tend\n\testimate /= #seen\n\tlocal estDir = normalized(estimate - eye)\n\tlocal apparent = PerceptionMath.apparentSizeDeg(2.0 * radius, dist)\n\tlocal inCone = offAxis <= math.rad(core.coneDeg) * 0.5\n\tcheck.inCone = inCone\n\tcheck.apparentDeg = apparent\n\tlocal visibleFraction = #seen / Sensor.SAMPLE_COUNT\n\tlocal speed = p.velocity.Magnitude\n\tif speed >= core.motionMinSpeed then\n\t\tself.motionSeen[p.id] = { direction = estDir, distance = dist, apparent = apparent, tick = core.tick }\n\tend\n\tif inCone and apparent >= core.minApparentDeg then\n\t\ttable.insert(sightings, { t = t, p = p, estimate = estimate, estDir = estDir, apparent = apparent, visibleFraction = visibleFraction })\n\t\ttable.insert(inspected, { position = estimate, radius = radius })\n\telseif speed >= core.motionMinSpeed and core.tick >= t.nextCueTick then\n\t\tcore:cue(t, estDir, forward, up, dist)\n\tend\nend\n\n-- The sample points of a sphere of `radius` at `center` that the eye can see: the centre and four points a little off it, across the line of\n-- sight and along it. An empty list means none could be seen.\nfunction Sensor._visiblePoints(self: any, cast: Cast, eye: Vector3, center: Vector3, radius: number, up: Vector3): { Vector3 }\n\tlocal out: { Vector3 } = {}\n\tfor _, s in Sensor.samplePoints(eye, center, radius, up) do\n\t\tif self:_clear(cast, eye, s, radius) then\n\t\t\ttable.insert(out, s)\n\t\tend\n\tend\n\treturn out\nend\n\n-- Godot _sample_points: the centre, then +side, -side, +vert, -vert at SAMPLE_SPREAD of the radius, side across the line of sight and\n-- horizontal to the body (d x up; d x right when the thing is straight above or below) and vert across both.\nfunction Sensor.samplePoints(eye: Vector3, center: Vector3, radius: number, up: Vector3): { Vector3 }\n\tlocal d = normalized(center - eye)\n\tlocal side = d:Cross(up)\n\tif side:Dot(side) < 1e-6 then\n\t\tside = d:Cross(Vector3.new(1, 0, 0))\n\tend\n\tside = normalized(side)\n\tlocal vert = normalized(side:Cross(d))\n\tlocal r = radius * Sensor.SAMPLE_SPREAD\n\treturn { center, center + side * r, center - side * r, center + vert * r, center - vert * r }\nend\n\n-- True when the eye can see the sample point `to` of a thing of `radius`: the world stops the ray no further than a small allowance short of\n-- it (PerceptionMath.sightTolerance, A-024). A world hit before the point is occlusion; it is not forgiven because the point is near. Every\n-- ray is counted.\nfunction Sensor._clear(self: any, cast: Cast, from: Vector3, to: Vector3, radius: number): boolean\n\tself.raysThisTick += 1\n\tself.raysTotal += 1\n\tlocal hit = cast(from, to)\n\tif hit == nil then\n\t\treturn true\n\tend\n\tlocal length = (to - from).Magnitude\n\treturn (hit - from).Magnitude >= length - PerceptionMath.sightTolerance(radius, length)\nend\n\n-- A remembered spot is called empty only when every sample point of it is in plain view (the first one the world hides ends the check).\n-- The number of spot checks is counted by SensorCore.checkSpots; the rays they used are counted here and also in raysTotal.\nfunction Sensor._allVisible(self: any, cast: Cast, eye: Vector3, center: Vector3, radius: number, up: Vector3): boolean\n\tlocal before: number = self.raysTotal\n\tlocal all = true\n\tfor _, s in Sensor.samplePoints(eye, center, radius, up) do\n\t\tif not self:_clear(cast, eye, s, radius) then\n\t\t\tall = false\n\t\t\tbreak\n\t\tend\n\tend\n\tself.spotRaysTotal += self.raysTotal - before\n\treturn all\nend\n\n-- ================================================================================================ questions\n\n-- Whether the eye could sense a thing of `radius` at `center` right now: in range, inside the field of the peripheral eyes and at least one of\n-- its sample points in plain view, which is exactly what a sensed thing has to pass. Changes no state of the senses; the rays are counted.\n-- The prey population asks it before a replacement is let in (it must come in where the spider could not sense it).\nfunction Sensor.couldSense(self: any, observer: Observer, center: Vector3, radius: number, cast: Cast): boolean\n\tlocal core = self.core\n\tlocal eye = observer.eye\n\tlocal to = center - eye\n\tlocal dist = to.Magnitude\n\tif dist > core:reachWu() then\n\t\treturn false\n\tend\n\tif dist < SensorCore.MIN_DISTANCE then\n\t\treturn true\n\tend\n\tif PerceptionMath.angleTo(observer.gaze, to / dist) > math.rad(core.peripheralConeDeg) * 0.5 then\n\t\treturn false\n\tend\n\treturn #self:_visiblePoints(cast, eye, center, math.max(radius, 0.01), observer.up) > 0\nend\n\n-- Developer view: what the last check of each thing found (distance, off-axis angle, how many points were seen, whether it was in the cone),\n-- with the exposure so far. Truth-derived numbers, for developers only: nothing in the player's presentation reads this. Sorted by the\n-- world's id.\nfunction Sensor.describeTracks(self: any): { TrackRow }\n\tlocal core = self.core\n\tlocal out: { TrackRow } = {}\n\tfor pid, t in core._tracks do\n\t\tlocal check: Check? = self._checks[pid]\n\t\tlocal row: TrackRow = {\n\t\t\tperceptId = pid,\n\t\t\ttrackId = t.trackId,\n\t\t\texposureS = if t.gapS <= core.graceS + EPS then t.exposure else 0.0,\n\t\t}\n\t\tif check ~= nil then\n\t\t\trow.inRange, row.distance, row.offAxisDeg = check.inRange, check.distance, check.offAxisDeg\n\t\t\trow.visiblePoints, row.inCone, row.apparentDeg = check.visiblePoints, check.inCone, check.apparentDeg\n\t\tend\n\t\ttable.insert(out, row)\n\tend\n\ttable.sort(out, function(a: TrackRow, b: TrackRow): boolean\n\t\treturn a.perceptId < b.perceptId\n\tend)\n\treturn out\nend\n\n-- ================================================================================================ cost\n\nfunction Sensor._recordCost(self: any, us: number)\n\tself.cpuUsTotal += us\n\tself.cpuUsMax = math.max(self.cpuUsMax, us)\n\tself._ring[self.cpuTicks % Sensor.COST_RING + 1] = us\n\tself.cpuTicks += 1\nend\n\n-- Ticks measured since the window began (the start of the run, or the last resetCost()).\nfunction Sensor.costTicks(self: any): number\n\treturn self.cpuTicks - self._costBase\nend\n\n-- Percentile of the latest measured sensor ticks (since the window began), in microseconds.\nfunction Sensor.costPercentile(self: any, q: number): number\n\tlocal n = math.min(self:costTicks(), Sensor.COST_RING)\n\tif n <= 0 then\n\t\treturn 0\n\tend\n\tlocal xs: { number } = {}\n\tfor i = 0, n - 1 do\n\t\t-- (ROBLOX-91: a checkpoint does not keep the ring, so after a return some of the latest ticks have no reading)\n\t\tlocal us = self._ring[(self.cpuTicks - 1 - i) % Sensor.COST_RING + 1]\n\t\tif us ~= nil then table.insert(xs, us) end\n\tend\n\tif #xs == 0 then\n\t\treturn 0\n\tend\n\ttable.sort(xs)\n\treturn xs[math.clamp(math.ceil(q * #xs), 1, #xs)]\nend\n\n-- Begins a new measuring window (the totals, the largest and the percentiles start again).\nfunction Sensor.resetCost(self: any)\n\tself.cpuUsTotal = 0\n\tself.cpuUsMax = 0\n\tself._costBase = self.cpuTicks\nend\n\n-- ================================================================================================ the engine's rays\n\n-- A cast made of the engine's raycast: the position of the first hit on the segment, nil when it is clear. The caller decides what the rays\n-- may meet in `params` (the sill: not the spider, not the things sensed, not anything drawn only).\nfunction Sensor.workspaceCast(params: RaycastParams): Cast\n\treturn function(from: Vector3, to: Vector3): Vector3?\n\t\tlocal hit = workspace:Raycast(from, to - from, params)\n\t\treturn if hit ~= nil then hit.Position else nil\n\tend\nend\n\n-- Capture is bodily evidence: no world identity crosses this API.\nfunction Sensor.onCapture(self: any,position: Vector3,radius: number): boolean\n local core=self.core;local matches={}\n for _,c in self.memory:contacts() do\n  if c.position and c.sizeWu>0 and (c.state==Contact.LIVE or Contact.hasMark(c)) then\n   local age=(core.tick-c.positionTick)/SensorCore.HZ\n   local reach=PerceptionMath.plausibleRadius(c.sizeWu,radius*2,age,core.contactSpeedBound,c.speedWuS)\n   if (c.position-position).Magnitude<=reach and PerceptionMath.sizesCompatible(c.sizeWu,radius*2,core.contactSizeRatio) then table.insert(matches,c.trackId) end\n  end\n end\n if #matches~=1 then return false end\n local id=matches[1];self.memory:resolveCapture(id);core._kept[id]=nil;core._spots[id]=nil\n for pid,t in core._tracks do if t.trackId==id then core._tracks[pid]=nil end end\n return true\nend\n\nreturn Sensor\n",18908,214822141},{"Shared/Perception/SensorCore","--!strict\n-- SensorCore: the half of Godot's SensorSystem (scripts/perception/sensor_system.gd, c87ce00) that needs no world. The sensor turns world\n-- truth into evidence and nothing more; this is what it does with the evidence once the eye has found it: which contact a sighting is filed\n-- under (continuous sight, a lost contact it can only be, or a fresh one), how long a thing has been in view and so how finely it can be\n-- classified, the peripheral cue, and the looking at remembered spots that drops a mark when the place is seen empty. Ported method for\n-- method from _is_linked, _cue_contact, _file_sightings, _placed_and_unbroken, _inspection_contact, _lost_candidates, _inspect, _cue,\n-- _check_spots, _forget_gone and the head and tail of _physics_process. NOT here (the next part of the port): the rays that decide what\n-- was in plain view (_sense, _visible_points, _clear, _sample_points), the eye and gaze, the broad scan and its rates, Focus, the\n-- developer overlay and the motion shimmer. Capture (on_capture) belongs to the feeding chunk. A caller does what _physics_process does:\n--\n--   core:beginTick(delta)                      -- tick += 1, every track's gap grows by delta\n--   core:trackOf(id)                           -- once per percept that exists, sighted or not (creates its track)\n--   core:cue(...)                              -- for each thing that gave a peripheral cue this tick\n--   core:fileSightings(sightings, delta)       -- all of the tick's inspections together (the association rule needs them together)\n--   core:checkSpots(eye, axis, up, delta, inspected, allVisible)\n--   core:endTick(present)                      -- memory:advance(tick), then forget the tracks of things that left the world\n--\n-- Who is who (A-027, D-040). Three things are kept apart. The world's id for a thing is how the sensor finds it again each tick (the key of\n-- _tracks); it is never the spider's idea of who the thing is. A contact (the memory's track id) is the spider's hypothesis that some\n-- observations are of one visible thing. Familiarity is what earlier exposure to a contact taught, kept per contact (_kept) and faded with\n-- the memory of it. A thing's evidence stays under one contact while sight of it is unbroken: the contact is live and the thing itself was\n-- filed under it within the memory's hold time for that kind of evidence. Once sight has been lost the world id decides nothing: a new\n-- inspection is compared with the lost contacts by where each was last observed, how long ago, how big it looked, what it can look like and\n-- how fast it was seen moving, and is taken for a lost contact only when exactly one of them could be it and no other thing sighted in the\n-- same tick could be it either (two look-alikes that come into view together are two fresh contacts, and the order the world lists them in\n-- decides nothing); otherwise it is a fresh contact that starts again at \"movement\" and inherits no exposure. A bare cue has no place to\n-- compare, so it is always a weak new contact; the inspection that follows it makes the comparison, and a cue-only contact that turns out\n-- to be a lost one is folded into it.\nlocal Observation = require(script.Parent.Observation)\nlocal PerceptionMath = require(script.Parent.PerceptionMath)\nlocal Signal = require(script.Parent.Signal)\nlocal ObservationMemory = require(script.Parent.ObservationMemory)\n\nlocal Contact = ObservationMemory.Contact\nlocal EPS = 1e-6\n\nlocal SensorCore = {}\nSensorCore.__index = SensorCore\n\n-- One game clock: the senses count in its ticks (SimClock.HZ), never in the engine's rate.\nSensorCore.HZ = 60\nSensorCore.MIN_DISTANCE = 0.05\n\n-- What the sensor keeps for each thing it can sense, under the world's id for it. It is the channel to a visible thing, not an identity.\nexport type Track = {\n\tperceptId: string,\n\t-- The contact this thing's evidence is filed under while sight of it is unbroken. \"\" until the first observation (only a thing that has\n\t-- been sensed has one); it is replaced, not trusted, once sight of the thing has been lost.\n\ttrackId: string,\n\t-- The tick of the last evidence of this thing that was filed under that contact.\n\tlinkTick: number,\n\t-- Continuous exposure in the cone, seconds.\n\texposure: number,\n\t-- Seconds since the last inspected tick.\n\tgapS: number,\n\tnextCueTick: number,\n}\n\n-- What may be sensed: the world's truth about a thing, which only the eye reads (Godot's Perceivable percept).\nexport type Percept = {\n\tid: string,\n\tposition: Vector3,\n\tradius: number,\n\tvelocity: Vector3,\n\t-- The finest category its appearance can ever be refined to (fly-like prey for something that looks like easy prey up close, movement\n\t-- for something that never looks like more). nil is fly-like prey.\n\tmaxCategory: string?,\n}\n\n-- One thing in the inspection cone this tick, as the eye made it: where it was seen (the mean of the sample points in plain view), the\n-- direction to there, how big it looked and how much of it was in view.\nexport type Sighting = {\n\tt: Track,\n\tp: Percept,\n\testimate: Vector3,\n\testDir: Vector3,\n\tapparent: number,\n\tvisibleFraction: number,\n\tmatch: string?,\n\tcandidates: { string }?,\n}\n\n-- A thing inspected this tick (position and radius), which the spot checks must not call an empty place.\nexport type Inspected = { position: Vector3, radius: number }\n\nfunction SensorCore.new(memory: any, observerId: string?): any\n\treturn setmetatable({\n\t\tmemory = memory,\n\t\tobserverId = observerId or \"spider\",\n\t\t-- Parameters: the species profile's perception section (configureFrom). The defaults are Godot's.\n\t\tconeDeg = 30.0,\n\t\tperipheralConeDeg = 300.0,\n\t\tsectorDeg = 22.5,\n\t\trangeWu = 40.0,\n\t\t-- How far the eyes reach now, as a share of rangeWu (1 in daylight; the life clock lowers it at night).\n\t\trangeScale = 1.0,\n\t\teasyS = 0.4,\n\t\tflyS = 1.0,\n\t\teasyApparentDeg = 3.0,\n\t\tminApparentDeg = 0.6,\n\t\tmotionMinSpeed = 0.3,\n\t\tcueCooldownS = 0.8,\n\t\tbroadHz = 10.0,\n\t\tcloseRangeWu = 4.0,\n\t\tgraceS = 0.15,\n\t\tdecayS = 6.0,\n\t\t-- The association rule (A-027): the assumed top speed of anything unseen, and the size ratio that still counts as one thing.\n\t\tcontactSpeedBound = 2.0,\n\t\tcontactSizeRatio = 1.5,\n\t\t-- Statistics, for tests and the developer overlay.\n\t\ttick = 0,\n\t\tinspectionsMade = 0,\n\t\tcuesMade = 0,\n\t\tspotChecksTotal = 0,\n\t\t-- Emitted for every peripheral cue made (after the cooldown), for tests and the developer view.\n\t\tcueEmitted = Signal.new(),\n\t\t_tracks = {} :: { [string]: Track },\n\t\t_serial = 0,\n\t\t_spots = {} :: { [string]: { exposure: number, gap: number } },\n\t\t_kept = {} :: { [string]: number }, -- track id -> continuous exposure the contact had when sight of it last ended\n\t}, SensorCore)\nend\n\n-- Takes the perception section of a species profile (spec 21.1: Species.<id>.perception, snake_case as in the data) and sets the memory's\n-- timing to match.\nfunction SensorCore.configureFrom(self: any, p: { [string]: number })\n\tself.coneDeg = p.inspect_cone_degrees\n\tself.peripheralConeDeg = p.peripheral_cone_degrees\n\tself.sectorDeg = p.peripheral_sector_degrees\n\tself.rangeWu = p.sensor_range_wu\n\tself.easyS = p.easy_target_inspection_s\n\tself.flyS = p.fly_like_inspection_s\n\tself.easyApparentDeg = p.easy_apparent_size_deg\n\tself.minApparentDeg = p.min_apparent_size_deg\n\tself.motionMinSpeed = p.motion_min_speed_wu_s\n\tself.cueCooldownS = p.cue_cooldown_s\n\tself.broadHz = p.broad_query_hz\n\tself.closeRangeWu = p.close_check_range_wu\n\tself.graceS = p.exposure_grace_s\n\tself.decayS = p.memory_decay_s\n\tself.contactSpeedBound = p.contact_speed_bound_wu_s\n\tself.contactSizeRatio = p.contact_size_ratio\n\tif self.memory ~= nil then\n\t\tself:applyToMemory()\n\tend\nend\n\n-- The memory's timing follows the sensor's: a cue repeats every cooldown, so a peripheral contact is held a little longer than that; an\n-- inspection comes every tick, so it is held for the exposure grace.\nfunction SensorCore.applyToMemory(self: any)\n\tself.memory:configure(SensorCore.HZ, self.decayS, self.graceS, self.cueCooldownS + 0.2)\nend\n\n-- The range every check uses.\nfunction SensorCore.reachWu(self: any): number\n\treturn self.rangeWu * math.clamp(self.rangeScale, 0.0, 1.0)\nend\n\nfunction SensorCore.getTrack(self: any, perceptId: string): Track?\n\treturn self._tracks[perceptId]\nend\n\n-- The track a percept id is filed under, \"\" if it was never sensed. Tests and the developer overlay only.\nfunction SensorCore.trackIdFor(self: any, perceptId: string): string\n\tlocal t: Track? = self._tracks[perceptId]\n\treturn if t == nil then \"\" else t.trackId\nend\n\n-- Forget everything about what is being tracked (the memory is cleared separately).\nfunction SensorCore.reset(self: any)\n\tself._tracks = {}\n\tself._spots = {}\n\tself._kept = {}\nend\n\nfunction SensorCore.trackOf(self: any, perceptId: string): Track\n\tlocal t: Track? = self._tracks[perceptId]\n\tif t == nil then\n\t\tt = {\n\t\t\tperceptId = perceptId,\n\t\t\ttrackId = \"\",\n\t\t\tlinkTick = -1000000,\n\t\t\texposure = 0.0,\n\t\t\tgapS = 1.0e9,\n\t\t\tnextCueTick = 0,\n\t\t}\n\t\tself._tracks[perceptId] = t\n\tend\n\treturn t :: Track\nend\n\n-- The head of a physics tick: the clock moves on and every track's gap since it was last inspected grows. Returns the tick.\nfunction SensorCore.beginTick(self: any, delta: number): number\n\tself.tick += 1\n\tfor _, t in self._tracks do\n\t\tt.gapS += delta\n\tend\n\treturn self.tick\nend\n\n-- The tail of a physics tick: the memory moves on to this tick, then the tracks of things that are no longer there are dropped.\nfunction SensorCore.endTick(self: any, present: { [string]: boolean })\n\tself.memory:advance(self.tick)\n\tself:forgetGone(present)\nend\n\n-- Lifecycle (A-029): a thing that is no longer there to be sensed (its node left the world, or it gives no percept) loses its entry; the\n-- contacts it made are not touched, they fade and expire on their own clocks. Exposure kept for a contact that is gone goes too.\nfunction SensorCore.forgetGone(self: any, present: { [string]: boolean })\n\tfor pid in self._tracks do\n\t\tif not present[pid] then\n\t\t\tself._tracks[pid] = nil\n\t\tend\n\tend\n\tfor id in self._kept do\n\t\tif self.memory:getContact(id) == nil then\n\t\t\tself._kept[id] = nil\n\t\tend\n\tend\nend\n\n-- A new contact for a thing, with an opaque id; the thing is filed under it from now on.\nfunction SensorCore.newContactFor(self: any, t: Track): string\n\tself._serial += 1\n\tt.trackId = `trk_{self._serial}`\n\treturn t.trackId\nend\n\n-- True while this thing's evidence is a continuation of the contact it was last filed under (A-027): that contact is live and the thing\n-- itself was filed under it within the memory's hold time for that kind of evidence. Sight that was lost for longer is not unbroken,\n-- whatever the world's id says, and neither is sight of a thing whose contact someone else kept alive.\nfunction SensorCore.isLinked(self: any, t: Track): boolean\n\tif t.trackId == \"\" then\n\t\treturn false\n\tend\n\tlocal c: ObservationMemory.Contact? = self.memory:getContact(t.trackId)\n\treturn c ~= nil and c.state == Contact.LIVE and self.tick - t.linkTick <= self.memory:holdTicks(c.modality)\nend\n\n-- The contact a cue is filed under: the one the thing is unbrokenly filed under, else a new one (a bearing cannot say which remembered\n-- place this is).\nfunction SensorCore.cueContact(self: any, t: Track): string\n\treturn if self:isLinked(t) then t.trackId else self:newContactFor(t)\nend\n\n-- The sightings of this tick that are first looks after a loss of sight (or at a thing known only from cues) are compared with the lost\n-- contacts together, not one after the other (A-027): a lost contact is taken by a sighting only when it is that sighting's one candidate\n-- and no other sighting of the tick could be it either. Two look-alikes that come into view at once, both inside the region one lost contact\n-- could have reached, are two fresh contacts, whichever of them the sensor happens to handle first; and the order the world lists its\n-- things in, like the world's ids, decides nothing. Then each sighting is filed.\nfunction SensorCore.fileSightings(self: any, sightings: { Sighting }, delta: number)\n\tif #sightings == 0 then\n\t\treturn\n\tend\n\tlocal claims: { [string]: number } = {} -- lost contact id -> how many sightings of this tick could be it\n\tfor _, s in sightings do\n\t\ts.match = \"\"\n\t\ts.candidates = {}\n\t\tif self:placedAndUnbroken(s.t) then\n\t\t\tcontinue\n\t\tend\n\t\tlocal found = self:lostCandidates(s.estimate, 2.0 * s.p.radius, s.p.maxCategory or Observation.FLY_LIKE_PREY)\n\t\ts.candidates = found\n\t\tfor _, id in found do\n\t\t\tclaims[id] = (claims[id] or 0) + 1\n\t\tend\n\tend\n\tfor _, s in sightings do\n\t\tlocal found = s.candidates :: { string }\n\t\tif #found == 1 and claims[found[1]] == 1 then\n\t\t\ts.match = found[1]\n\t\tend\n\tend\n\tfor _, s in sightings do\n\t\tself:inspect(s.t, s.p, s.estimate, s.estDir, s.apparent, s.visibleFraction, delta, s.match :: string)\n\tend\nend\n\n-- True while the thing's evidence is a continuation of a contact that already has a place: nothing to compare.\nfunction SensorCore.placedAndUnbroken(self: any, t: Track): boolean\n\treturn self:isLinked(t) and self.memory:getContact(t.trackId).hasPosition\nend\n\n-- The contact an inspection is filed under (A-027). Unbroken sight of a thing already being inspected: the same contact. Otherwise this is\n-- the first inspection after a loss of sight, or of a thing known only from cues: if the comparison made with the other sightings of the\n-- tick (fileSightings) found exactly one lost contact it could be, it is that one (a contact known only from cues is folded into it); if it\n-- found none, or more than one, it is the contact the cues made or a new one, with nothing carried over.\nfunction SensorCore.inspectionContact(self: any, t: Track, matched: string): string\n\tlocal linked = self:isLinked(t)\n\tif linked and self.memory:getContact(t.trackId).hasPosition then\n\t\treturn t.trackId\n\tend\n\tif matched ~= \"\" then\n\t\tif linked then\n\t\t\tself.memory:merge(t.trackId, matched)\n\t\tend\n\t\tt.trackId = matched\n\t\treturn matched\n\tend\n\treturn if linked then t.trackId else self:newContactFor(t)\nend\n\n-- The lost contacts a new sighting could be (their track ids; empty when none). A contact could be it when the sighting is inside the region\n-- its thing could have reached since it was last observed (a function of the time and the speed bound, never of where the thing went),\n-- looks about as big, and is not finer in appearance than what was learned. Only a focused sighting is ever asked: a bearing cue says\n-- nothing about which remembered place this is.\nfunction SensorCore.lostCandidates(self: any, estimate: Vector3, sizeWu: number, cap: string): { string }\n\tlocal found: { string } = {}\n\tfor _, m in self.memory:marks() do\n\t\tlocal elapsed = (self.tick - m.positionTick) / SensorCore.HZ\n\t\tlocal reach = PerceptionMath.plausibleRadius(m.sizeWu, sizeWu, elapsed, self.contactSpeedBound, m.speedWuS)\n\t\tif (estimate - m.position).Magnitude > reach then\n\t\t\tcontinue\n\t\tend\n\t\tif not PerceptionMath.sizesCompatible(m.sizeWu, sizeWu, self.contactSizeRatio) then\n\t\t\tcontinue\n\t\tend\n\t\tif not PerceptionMath.categoriesCompatible(m.category, cap) then\n\t\t\tcontinue\n\t\tend\n\t\ttable.insert(found, m.trackId)\n\tend\n\treturn found\nend\n\n-- One inspection of a thing in the cone: its exposure (a new stretch after a break longer than the grace starts from what the contact it\n-- belongs to was taught, as much as the memory of it lasts), the category that exposure supports (never finer than the thing can look),\n-- and the Observation the memory takes in.\nfunction SensorCore.inspect(self: any, t: Track, p: Percept, estimate: Vector3, estDir: Vector3, apparent: number, visibleFraction: number, delta: number, matched: string)\n\tlocal cap = p.maxCategory or Observation.FLY_LIKE_PREY\n\tlocal id: string = self:inspectionContact(t, matched)\n\tif t.gapS > self.graceS + EPS then\n\t\t-- A new stretch of exposure. What an earlier one taught the contact it belongs to still counts, as much as the memory of it does: a\n\t\t-- new contact has been taught nothing.\n\t\tt.exposure = (self._kept[id] or 0.0) * self.memory:familiarity(id)\n\tend\n\tt.exposure += delta\n\tself._kept[id] = t.exposure\n\tt.gapS = 0.0\n\tlocal category = PerceptionMath.classify(t.exposure, apparent, self.easyS, self.flyS, self.easyApparentDeg, self.minApparentDeg)\n\tif Observation.rank(category) > Observation.rank(cap) then\n\t\tcategory = cap\n\tend\n\tlocal obs = Observation.new()\n\tobs.observerId = self.observerId\n\tobs.trackId = id\n\tobs.targetId = if Observation.rank(category) >= Observation.rank(Observation.POSSIBLE_PREY) then p.id else \"\"\n\tobs.modality = Observation.INSPECTION\n\tobs.hasPosition = true\n\tobs.estimatedPosition = estimate\n\tobs.direction = estDir\n\tobs.confidence = PerceptionMath.inspectionConfidence(t.exposure, PerceptionMath.requiredExposure(self.flyS, apparent, self.easyApparentDeg), visibleFraction)\n\tobs.observedTick = self.tick\n\tobs.category = category\n\tobs.sizeWu = 2.0 * p.radius\n\tobs.apparentSizeDeg = apparent\n\tobs.speedWuS = p.velocity.Magnitude\n\tif self.memory:ingest(obs) ~= nil then\n\t\tself.inspectionsMade += 1\n\t\tt.linkTick = self.tick\n\tend\nend\n\n-- A peripheral cue: a coarse bearing, low confidence, and nothing else. The caller has already decided that the thing moves, is in the\n-- field and in sight, and that `self.tick >= t.nextCueTick` (at most one cue per cooldown for each thing).\nfunction SensorCore.cue(self: any, t: Track, estDir: Vector3, forward: Vector3, up: Vector3, dist: number)\n\tt.nextCueTick = self.tick + math.round(self.cueCooldownS * SensorCore.HZ)\n\tlocal obs = Observation.new()\n\tobs.observerId = self.observerId\n\tobs.trackId = self:cueContact(t)\n\tobs.modality = Observation.PERIPHERAL\n\tobs.hasPosition = false\n\tobs.direction = PerceptionMath.quantizeDirection(estDir, forward, up, self.sectorDeg)\n\tobs.confidence = PerceptionMath.peripheralConfidence(dist, self:reachWu())\n\tobs.observedTick = self.tick\n\tobs.category = Observation.MOVEMENT\n\tif self.memory:ingest(obs) ~= nil then\n\t\tself.cuesMade += 1\n\t\tt.linkTick = self.tick\n\t\tself.cueEmitted:emit(obs)\n\tend\nend\n\n-- The remembered spots of lost contacts: inspecting one that is in plain view and empty drops its mark. A spot is looked at when it is in\n-- the cone, close enough that the thing would look big enough, and entirely in plain view (`allVisible(eye, position, radius, up)`: the\n-- rays, which the world half supplies) with nothing inspected there this tick; it must be looked at for the time an easy target needs\n-- (a break up to the grace does not start it again).\nfunction SensorCore.checkSpots(self: any, eye: Vector3, axis: Vector3, up: Vector3, delta: number, inspected: { Inspected }, allVisible: (Vector3, Vector3, number, Vector3) -> boolean)\n\tlocal half = math.rad(self.coneDeg) * 0.5\n\tlocal marks: { ObservationMemory.Contact } = self.memory:marks()\n\tfor id in self._spots do\n\t\tlocal still = false\n\t\tfor _, m in marks do\n\t\t\tif m.trackId == id then\n\t\t\t\tstill = true\n\t\t\tend\n\t\tend\n\t\tif not still then\n\t\t\tself._spots[id] = nil\n\t\tend\n\tend\n\tfor _, m in marks do\n\t\tlocal st = self._spots[m.trackId] or { exposure = 0.0, gap = 1.0e9 }\n\t\tst.gap += delta\n\t\tlocal to = m.position - eye\n\t\tlocal dist = to.Magnitude\n\t\tlocal size = math.max(m.sizeWu, 0.2)\n\t\tlocal apparent = PerceptionMath.apparentSizeDeg(size, dist)\n\t\tlocal plain = false\n\t\tif dist >= SensorCore.MIN_DISTANCE and dist <= self:reachWu() and PerceptionMath.angleTo(axis, to / dist) <= half and apparent >= self.minApparentDeg then\n\t\t\tself.spotChecksTotal += 1\n\t\t\tplain = allVisible(eye, m.position, size * 0.5, up)\n\t\t\tif plain then\n\t\t\t\tfor _, q in inspected do\n\t\t\t\t\tif (q.position - m.position).Magnitude < size + q.radius then\n\t\t\t\t\t\tplain = false -- something is there: not an empty spot\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif plain then\n\t\t\tif st.gap > self.graceS + EPS then\n\t\t\t\tst.exposure = 0.0\n\t\t\tend\n\t\t\tst.exposure += delta\n\t\t\tst.gap = 0.0\n\t\t\tif st.exposure + EPS >= PerceptionMath.requiredExposure(self.easyS, apparent, self.easyApparentDeg) then\n\t\t\t\tself.memory:invalidate(m.trackId, \"empty\")\n\t\t\t\tself._spots[m.trackId] = nil\n\t\t\t\tcontinue\n\t\t\tend\n\t\tend\n\t\tself._spots[m.trackId] = st\n\tend\nend\n\nreturn SensorCore\n",19990,482314905},{"Shared/Perception/Signal","--!strict\n-- A minimal in-process signal, the stand-in for a Godot `signal`: handlers run synchronously, in the order they were connected, when\n-- the signal is emitted. Pure Luau (no BindableEvent) so the plain CLI can run the perception logic that announces its changes with it.\nlocal Signal = {}\nSignal.__index = Signal\n\nexport type Signal = {\n\tconnect: (self: Signal, handler: (...any) -> ()) -> () -> (),\n\temit: (self: Signal, ...any) -> (),\n}\n\nfunction Signal.new(): Signal\n\treturn setmetatable({ _handlers = {} }, Signal) :: any\nend\n\n-- Returns a function that disconnects this handler.\nfunction Signal.connect(self: any, handler: (...any) -> ()): () -> ()\n\ttable.insert(self._handlers, handler)\n\treturn function()\n\t\tlocal i = table.find(self._handlers, handler)\n\t\tif i then\n\t\t\ttable.remove(self._handlers, i)\n\t\tend\n\tend\nend\n\nfunction Signal.emit(self: any, ...: any)\n\tlocal handlers: { (...any) -> () } = table.clone(self._handlers)\n\tfor _, handler in handlers do\n\t\thandler(...)\n\tend\nend\n\nreturn Signal\n",1011,2103724923},{"Shared/Persistence/Checkpoint","--!strict\n-- The retreat checkpoint (S01-C; Godot's scripts/persistence/checkpoint.gd, T09; ROBLOX-25). A checkpoint is the whole world\n-- at one tick boundary in one plain record: the spider standing on its surface, its reserves and the books of what fed them,\n-- the life clock and the rest, every fly with its random stream and whatever it was in the middle of, who sits on and who\n-- has reserved each perch, the replacements still owed, the captures made, the meal in the jaws, and what the spider's senses\n-- and memory held. Restoring one puts back all of it together, so an earlier spider is never put into a newer world and a fly\n-- eaten after the checkpoint is not eaten twice: the fly and the energy it gave come back together.\n--\n-- When: only at the end of a tick, from a still spider on a surface that is not mid-meal, mid-struggle or mid-strike\n-- (boundaryProblem). The player makes one by resting in the silk-lined crack (LifeLoop) and when a night's sleep reaches the\n-- morning. Airborne, hanging, aiming and eating are refused: exact arbitrary-state resume (the original S01) stays deferred.\n-- How: the live objects are recorded as one graph (ObjectRecord), so no field can be forgotten; the spider's body is\n-- recorded by its pose (Godot's player record) and put back with SpiderMotor.place.\n-- Validation happens on the record alone, before anything live changes: the format, schema and windowsill, the spider's\n-- pose, every reference in the graph, and then the meaning of the rebuilt world (reserves in range and books that add up,\n-- the clock, unique flies, perches held by flies that exist, the meal in the jaws one of them). A record with any problem is\n-- refused with its reasons and the live world is left exactly as it was.\n-- The wasp keeps a small record beside the graph (Godot's checkpoint schema 6): the day of its last visit and this life's visits and\n-- escapes, so a return to a rest meets the same wasp. A visit going on is not kept; restoring ends it. A record without one (the port's\n-- first checkpoints were made before the wasp) gets the record of a life it has not yet visited.\n-- Differences from Godot: the record is the port's own (its flies are the port's, Chet's ROBLOX flies, not Godot's), so\n-- Godot checkpoints are not read and schema numbers start again at 1. Schema 3 adds growth and its food ledger cursor.\n-- The passing shadow and notebook are not recorded.\n-- ROBLOX-91: nor are the two profiling windows of the live world: the prey director's `cpu` (the last 1200 ticks' microseconds) and the sensor's cost ring. They are\n-- clock readings, different on every run, and were about 2400 floats, twice the rest of the record; capture leaves them out and a restore (of an old record too)\n-- leaves them empty.\n-- ROBLOX-94: where in the world the rest was kept is `world_map` = { seed, revision, region, retreat, diffs } (not `world`: that is the recorded object graph). The world is\n-- never saved, only the seed and the revision it was made from and what changed in it (`diffs`, empty until something in the world can change). A record without one (every\n-- rest before the world) means the sill of the default world with no changes. A region that is not on the map, or a position outside that region's bounds, is refused like\n-- any bad record. A rest made in another revision of the world, or from another seed, is put back at its region's spawn: the position was kept for geometry that may have\n-- moved, so it is not trusted (the rest of the record is: the life, the reserves, the clock).\n-- ROBLOX-95: the world is at revision world-2 (the sill's back frame opened, the garden added) and a record without `world_map` is read as world-1's, the sill\n-- of before: every rest kept before this round is put back at its region's spawn with the notice. A rest in the garden (the gap under the bed's stone) records\n-- region bed_a and retreat bed_a_stone and is put back there. SCHEMA_VERSION and CONTENT_REVISION do not change (a new content revision would refuse old records).\n-- ROBLOX-112: world-3 (the window in true proportion, the eaves raised, the kitchen): a rest kept under world-2 is put back at its region's spawn the same way, and a\n-- rest under the toaster on the kitchen's counter records region kitchen_counter and retreat kitchen_toaster.\n-- ROBLOX-96: the prey is per region. The `prey` root is still the sill's director, byte for byte what it was (an old record, sill-only prey, restores unchanged);\n-- the regions outside are an optional `garden` root, { [regionId] = { prey = a PreyDirector?, bugs = a Woodlice? } } (Prey/PreyWorld's table), recorded when the\n-- world has one and checked like the sill's: every fly in a known state with a meal inside its own profile's, every held perch held by a living fly, the woodlice\n-- inside their region. A record without one leaves the live garden as it is (nothing rerolls); one with a region the map lacks is refused.\n-- ROBLOX-101: a region's entry may hold `kinds`, the bestiary's directors by kind ({ [kind] = director }), checked as W3's director is; the wall and the outer\n-- sill may now be named (they have bestiary prey). The new profiles are kept by name (springtailProfile ... craneFlyDuskProfile) and a hopper in the air is in\n-- the state HOP. A W3 record (its bed with gnats, aphids and woodlice alone) restores unchanged; the bestiary's directors it lacks are made afresh from their\n-- seeds when their region is next whole (Prey/PreyWorld.kinds), so nothing is rerolled that the record had. SCHEMA_VERSION, CONTENT_REVISION and the\n-- world's revision stay as they were (W3's precedent: an optional part an old record lacks needs none of them).\n-- ROBLOX-105: a region's entry may hold `ambient`, the ambient bugs' colonies by kind ({ ladybird = Ladybirds, millipede = Millipedes, snail = Snails,\n-- harvestman = Harvestmen }), each of the kind the region has and in order (its creatures in known states inside the region's bounds). A record without it (every\n-- rest before this round) restores unchanged and the colonies it lacks are made afresh from their seeds when their region is next whole (Prey/PreyWorld.ambient).\n-- ROBLOX-106: the life may hold `cold_day` (the morning a night out in the garden left cold, Life/Nature), the rival `camp` (its watch by the crack), the mate its\n-- courtship's record and the rival's level (`court_*`, `cut`) and the mating its counters (`courts`, `rejections`, `cut_ins`): all optional, absent in every record\n-- before, checked when present.\n-- ROBLOX-120: the life may hold `start_zone` and `start_region` (where a generation followed on the wind came down, Life/Ballooning): optional, absent in every record\n-- before and in a generation that stayed at the hut, checked when present. The robin (Predator/Bird) keeps nothing: its day is the seed's, as the crab spiders' is.\n\nlocal Species = require(script.Parent.Parent.Data.Species)\nlocal ObjectRecord = require(script.Parent.ObjectRecord)\nlocal Fly = require(script.Parent.Parent.Prey.Fly)\nlocal FlyFlight = require(script.Parent.Parent.Prey.FlyFlight)\nlocal FlySenses = require(script.Parent.Parent.Prey.FlySenses)\nlocal PreyRandom = require(script.Parent.Parent.Prey.PreyRandom)\nlocal PreyPopulation = require(script.Parent.Parent.Prey.PreyPopulation)\nlocal PerchGraph = require(script.Parent.Parent.Prey.PerchGraph)\nlocal Feeding = require(script.Parent.Parent.Prey.Feeding)\nlocal PreyDirector = require(script.Parent.Parent.Prey.PreyDirector)\nlocal Sensor = require(script.Parent.Parent.Perception.Sensor)\nlocal SensorCore = require(script.Parent.Parent.Perception.SensorCore)\nlocal ObservationMemory = require(script.Parent.Parent.Perception.ObservationMemory)\nlocal Observation = require(script.Parent.Parent.Perception.Observation)\nlocal NeedsModel = require(script.Parent.Parent.Life.NeedsModel)\nlocal LifeLoop = require(script.Parent.Parent.Life.LifeLoop)\nlocal LifeClock = require(script.Parent.Parent.Life.LifeClock)\nlocal Growth = require(script.Parent.Parent.Life.Growth)\nlocal RareDirector = require(script.Parent.Parent.Life.RareDirector)\nlocal WorldMap = require(script.Parent.Parent.World.WorldMap)\nlocal WaspDirector = require(script.Parent.Parent.Predator.WaspDirector)\nlocal Cat = require(script.Parent.Parent.Predator.Cat)\nlocal Woodlice = require(script.Parent.Parent.Prey.Woodlouse)\nlocal Ladybirds = require(script.Parent.Parent.Prey.Ladybird)\nlocal Millipedes = require(script.Parent.Parent.Prey.Millipede)\nlocal Snails = require(script.Parent.Parent.Prey.Snail)\nlocal Harvestmen = require(script.Parent.Parent.Prey.Harvestman)\nlocal Ants = require(script.Parent.Parent.Prey.Ant) -- (ROBLOX-119: the meadow's ants)\nlocal Skaters = require(script.Parent.Parent.Prey.Skater) -- (ROBLOX-122: the pond's water striders)\nlocal Garden = require(script.Parent.Parent.World.Garden)\nlocal Ballooning = require(script.Parent.Parent.Life.Ballooning) -- (ROBLOX-120: a generation's start)\nlocal Water = require(script.Parent.Parent.Life.Water) -- (ROBLOX-122: the water's falls counted)\n\nlocal RivalSpider = require(script.Parent.Parent.Predator.RivalSpider)\nlocal Mate = require(script.Parent.Parent.Predator.Mate)\nlocal Mating = require(script.Parent.Parent.Life.Mating)\nlocal Breakaway = require(script.Parent.Parent.Habitat.Breakaway)\nlocal Nature = require(script.Parent.Parent.Life.Nature)\nlocal CompactMigration = require(script.Parent.CompactMigration)\nlocal Checkpoint = {}\n\nCheckpoint.SCHEMA_VERSION = 3\nCheckpoint.KIND = \"retreat_checkpoint\"\nCheckpoint.GAME = \"the-windowsill-roblox\"\n-- Changes whenever the windowsill's pieces or perches change in a way an old checkpoint could not be put back into.\nCheckpoint.CONTENT_REVISION = \"windowsill-roblox-1\"\nCheckpoint.STILL_SPEED = 0.15\nCheckpoint.ROOTS = { \"prey\", \"sensor\", \"memory\", \"needs\", \"life\" }\n\n-- The classes a world record may hold.\nCheckpoint.CLASSES = {\n\tFly = Fly, FlyFlight = FlyFlight, FlySenses = FlySenses, PreyRandom = PreyRandom, PreyPopulation = PreyPopulation,\n\tPerchGraph = PerchGraph, Feeding = Feeding, PreyDirector = PreyDirector, Woodlice = Woodlice,\n\tLadybirds = Ladybirds, Millipedes = Millipedes, Snails = Snails, Harvestmen = Harvestmen, -- (ROBLOX-105)\n\tAnts = Ants, -- (ROBLOX-119)\n\tSkaters = Skaters, -- (ROBLOX-122)\n\tSensor = Sensor, SensorCore = SensorCore, ObservationMemory = ObservationMemory, Contact = ObservationMemory.Contact,\n\tObservation = Observation,\n\tNeedsModel = NeedsModel, LifeLoop = LifeLoop, LifeClock = LifeClock, Growth = Growth,\n}\n\n-- What the world is made of that a record keeps by name instead of copying (see ObjectRecord). The same function names them\n-- when a record is made and when it is put back, so a name always means this world's own thing.\nexport type World = {\n\tmotor: any, prey: any, sensor: any, memory: any, needs: any, life: any,\n\tbreakaway: any?,\n\twasp: any?, -- the WaspDirector (nil: no wasp in this world)\n\tcat: any?, -- (ROBLOX-118) the ranger's cat, Predator/Cat (nil: no cat in this world: the test garden)\n\twater: any?, -- (ROBLOX-122) the water, Life/Water: its falls counted (nil: no pond in this world: the test garden)\n\tgarden: { [string]: any }?, -- ROBLOX-96: the regions' prey and bugs outside the sill (Prey/PreyWorld's table; nil: a world of the sill alone)\n\textraRefs: { [string]: any }?, -- anything else the world's state points at that the record should keep by name\n}\n\nfunction Checkpoint.refs(world: World): { [string]: any }\n\tlocal refs: { [string]: any } = {}\n\tlocal prey = world.prey\n\tObjectRecord.constants(\"flyProfile\", prey.p, refs)\n\tObjectRecord.constants(\"fruitFlyProfile\", Species.fruit_fly_prototype, refs)\n\tObjectRecord.constants(\"gnatProfile\", Species.fungus_gnat_prototype, refs) -- (ROBLOX-96: the bed's prey)\n\tObjectRecord.constants(\"aphidProfile\", Species.aphid_prototype, refs)\n\t-- (ROBLOX-101: the bestiary's prey, by day and from dusk)\n\tfor _, pair in { { \"springtailProfile\", Species.springtail_prototype }, { \"leafhopperProfile\", Species.leafhopper_prototype }, { \"mothProfile\", Species.moth_prototype },\n\t\t{ \"mothDuskProfile\", Species.moth_dusk_prototype }, { \"craneFlyProfile\", Species.crane_fly_prototype }, { \"craneFlyDuskProfile\", Species.crane_fly_dusk_prototype },\n\t\t{ \"hoverflyProfile\", Species.hoverfly_prototype }, -- (ROBLOX-117: the hut garden's hoverflies)\n\t\t{ \"midgeProfile\", Species.midge_prototype }, { \"midgeDuskProfile\", Species.midge_dusk_prototype }, { \"mosquitoProfile\", Species.mosquito_prototype },\n\t\t{ \"mosquitoDuskProfile\", Species.mosquito_dusk_prototype }, { \"damselflyProfile\", Species.damselfly_prototype } } :: { { any } } do -- (ROBLOX-122: the pond's)\n\t\tlocal name: string, profile: any = pair[1], pair[2]\n\t\tObjectRecord.constants(name, profile, refs)\n\tend\n\tlocal g = prey.graph\n\trefs[\"graph.cast\"], refs[\"graph.sweep\"], refs[\"graph.overlap\"] = g.cast, g.sweep, g.overlap\n\tif prey.probe ~= nil then refs[\"prey.probe\"] = prey.probe end\n\tif world.life.save ~= nil then refs[\"life.save\"] = world.life.save end\n\tlocal m = world.memory\n\tfor _, k in { \"contactAcquired\", \"categoryChanged\", \"contactLost\", \"contactReacquired\", \"contactEnded\" } do\n\t\tif m[k] ~= nil then refs[\"memory.\" .. k] = m[k] end\n\tend\n\tlocal core = world.sensor.core\n\tif core and core.cueEmitted ~= nil then refs[\"sensor.cueEmitted\"] = core.cueEmitted end\n\tif world.needs.onEnergyChanged ~= nil then refs[\"needs.onEnergyChanged\"] = world.needs.onEnergyChanged end\n\tlocal extra: { [string]: any } = world.extraRefs or {}\n\tfor k, v in extra do refs[k] = v end\n\treturn refs\nend\n\nlocal function liveRoots(world: World): { [string]: any }\n\tlocal roots: { [string]: any } = { prey = world.prey, sensor = world.sensor, memory = world.memory, needs = world.needs, life = world.life }\n\tif world.garden ~= nil then roots.garden = world.garden end\n\treturn roots\nend\n\nlocal function v3(v: Vector3): { number }\n\treturn { v.X, v.Y, v.Z }\nend\n\nlocal function finite(x: any): boolean\n\treturn type(x) == \"number\" and x == x and x ~= math.huge and x ~= -math.huge\nend\n\nlocal function vec(t: any): Vector3?\n\tif type(t) ~= \"table\" or #t ~= 3 or not finite(t[1]) or not finite(t[2]) or not finite(t[3]) then return nil end\n\treturn Vector3.new(t[1], t[2], t[3])\nend\n\n-- The world record of a checkpoint with the defaults of a record from before there was a world: the default world's seed, the first revision of the world\n-- (WorldMap.FIRST_REVISION, ROBLOX-95: such a rest was kept on the sill before its back frame opened, so it is put back at the spawn like any rest from\n-- world-1), the sill, the retreat the player block names, no changes. Returns it and what is wrong with a record that has one (an empty list for a good one or\n-- an old one).\n-- ROBLOX-115: `world`, the world the rest was kept in (World/Worlds), written only outside the test garden: a record without it (every rest before, and every rest\n-- kept in the test garden, byte for byte as before) is the test garden's. A rest from another world than the one running is put back where a life begins here.\nexport type MapRecord = { seed: number, revision: string, region: string, retreat: string, diffs: { any }, world: string }\nlocal function mapRecord(record: any): (MapRecord, { string })\n\tlocal problems: { string } = {}\n\tlocal p = record.player\n\tlocal out: MapRecord = {\n\t\tseed = WorldMap.SEED, revision = WorldMap.FIRST_REVISION, region = WorldMap.HOME, diffs = {}, world = \"test_garden\",\n\t\tretreat = if type(p) == \"table\" and type(p.retreat_id) == \"string\" then p.retreat_id else \"\",\n\t}\n\tlocal m = record.world_map\n\tif m == nil then return out, problems end\n\tlocal function bad(t: string) table.insert(problems, t) end\n\tif type(m) ~= \"table\" then\n\t\tbad(\"world: the place in the world is not a record\")\n\t\treturn out, problems\n\tend\n\tif not finite(m.seed) or m.seed < 0 or m.seed > 4294967295 or m.seed % 1 ~= 0 then bad(\"world: the world's seed is not a whole number\") else out.seed = m.seed end\n\tif type(m.revision) ~= \"string\" or #m.revision < 1 or #m.revision > 64 then bad(\"world: the world's revision is not a name\") else out.revision = m.revision end\n\tif type(m.region) ~= \"string\" then\n\t\tbad(\"world: the region is not a name\")\n\telse\n\t\tout.region = m.region\n\tend\n\tif type(m.retreat) ~= \"string\" then bad(\"world: the retreat is not a name\") else out.retreat = m.retreat end\n\tif m.world ~= nil then\n\t\tif type(m.world) ~= \"string\" or #m.world < 1 or #m.world > 64 then bad(\"world: the world is not a name\") else out.world = m.world end\n\tend\n\tif type(m.diffs) ~= \"table\" or getmetatable(m.diffs) ~= nil then\n\t\tbad(\"world: the changes to the world are not a list\")\n\telseif next(m.diffs) ~= nil then\n\t\tbad(\"world: the world has changes this game does not know (nothing in it can change yet)\") -- later entries are { kind, region, id, data }, each kind with its own check\n\tend\n\tif #problems==0 and CompactMigration.applies(out) then out.region=CompactMigration.alias(out.region) end\n\treturn out, problems\nend\n\n-- Whether a rest was kept in another world than this game's (another revision of it, or another seed): its position is not to be trusted.\nfunction Checkpoint.worldMoved(record: any): boolean\n\tlocal map = mapRecord(record)\n\treturn map.world ~= WorldMap.world() or map.revision ~= WorldMap.revision() or map.seed ~= WorldMap.SEED\nend\n\n-- Whether a rest was kept in another world than the one running (ROBLOX-115): its region and retreat are that world's, not looked for here.\nlocal function otherWorld(record: any): boolean\n\treturn mapRecord(record).world ~= WorldMap.world()\nend\n\nlocal function hasRetreat(region: WorldMap.Region, id: string): boolean\n\tfor _, t in region.retreats do\n\t\tif t.id == id then return true end\n\tend\n\treturn false\nend\n\n-- Why a checkpoint cannot be made of the world now; \"\" when it can.\nfunction Checkpoint.boundaryProblem(world: World): string\n\tlocal motor, prey = world.motor, world.prey\n\tif motor.mode ~= \"attached\" or motor.preparing then return \"the spider is not standing on a surface\" end\n\tif motor.vel.Magnitude > Checkpoint.STILL_SPEED then return \"the spider is moving\" end\n\tif world.life.rival and world.life.rival.state==\"captured\" then\n\t\treturn if world.life.rival.subdued == false then \"the rival in the jaws is still struggling\" else \"the spider is eating its rival\"\n\tend\n\t-- ROBLOX-89: the mating scene is playing (the pause together, and a male mate's walk off the sill that ends it): no rest is kept inside it.\n\tif world.life.mate and world.life.mate.scene == true then return \"the two spiders are together\" end\n\t-- ROBLOX-79: the brood is out and the ending is the player's to take; a rest here would keep a family that has already hatched.\n\tif world.life.mating and world.life.mating.stage == \"hatched\" then return \"the brood is hatching\" end\n\tif prey.feeding.feeding then return \"the spider is feeding\" end\n\tif prey.feeding.struggling then return \"the prey in the jaws is still struggling\" end\n\tif prey.tick <= prey.strikeEnd then return \"a strike is still in progress\" end\n\treturn \"\"\nend\n\n-- The checkpoint record of the world as it is now (call boundaryProblem first). Nil and the reason if something in the world\n-- could not be recorded (a field this file does not know how to keep; the tests make sure there is none).\nfunction Checkpoint.capture(world: World, createdAt: number?): ({ [string]: any }?, string?)\n\tlocal motor = world.motor\n\t-- (the live windows are put aside for the capture and put straight back)\n\tlocal prey, sensor = world.prey, world.sensor\n\tlocal cpu, ring = prey.cpu, sensor._ring\n\tif cpu ~= nil then prey.cpu = {} end\n\tif ring ~= nil then sensor._ring = {} end\n\tlocal gardenCpu: { [any]: any } = {}\n\tfor _, entry in (world.garden or {}) :: { [string]: any } do\n\t\tif type(entry) == \"table\" and entry.prey ~= nil and entry.prey.cpu ~= nil then gardenCpu[entry.prey] = entry.prey.cpu; entry.prey.cpu = {} end\n\t\tif type(entry) == \"table\" and type(entry.kinds) == \"table\" then\n\t\t\tfor _, d in entry.kinds do if type(d) == \"table\" and d.cpu ~= nil then gardenCpu[d] = d.cpu; d.cpu = {} end end\n\t\tend\n\tend\n\tlocal graph, why = ObjectRecord.capture(liveRoots(world), Checkpoint.CLASSES, Checkpoint.refs(world))\n\tif cpu ~= nil then prey.cpu = cpu end\n\tif ring ~= nil then sensor._ring = ring end\n\tfor d, window in gardenCpu do d.cpu = window end\n\tif not graph then return nil, why end\n\tlocal region = WorldMap.at(motor.pos) or WorldMap.region(WorldMap.HOME) :: WorldMap.Region\n\tlocal retreat = WorldMap.inRetreat(motor.pos) or \"\"\n\treturn {\n\t\tschema_version = Checkpoint.SCHEMA_VERSION, kind = Checkpoint.KIND, game = Checkpoint.GAME,\n\t\tcontent_revision = Checkpoint.CONTENT_REVISION, created_at = createdAt or 0, snapshot_tick = world.prey.tick,\n\t\tplayer = {\n\t\t\tposition = v3(motor.pos), normal = v3(motor.up), heading = v3(motor.heading), gaze_pitch = motor.gazePitch,\n\t\t\tretreat_id = retreat, state = \"ATTACHED\",\n\t\t},\n\t\tworld_map = { seed = WorldMap.SEED, revision = WorldMap.revision(), region = region.id, retreat = retreat, diffs = {},\n\t\t\tworld = if WorldMap.world() == \"test_garden\" then nil else WorldMap.world() },\n\t\tworld = graph,\n\t\tlife_rules = { mode = world.life.mode or \"main\", rules = world.life.rules or \"standard\" },\n\t\tbreakaway = if world.breakaway then world.breakaway:record() else nil,\n\t\twasp = if world.wasp ~= nil then world.wasp:toRecord() else nil,\n\t\tcat = if world.cat ~= nil then world.cat:toRecord() else nil, -- (ROBLOX-118: optional; a test garden rest has none)\n\t\twater = if world.water ~= nil then world.water:toRecord() else nil, -- (ROBLOX-122: optional; a test garden rest has none)\n\t}, nil\nend\n\n-- The checks on the rebuilt (fresh, not live) world: what a good world must be.\nlocal function checkWorld(roots: { [string]: any }, problems: { string }, legacyCompact: boolean?)\n\tlocal function bad(t: string) table.insert(problems, t) end\n\tfor _, name in Checkpoint.ROOTS do\n\t\tif type(roots[name]) ~= \"table\" then bad(`world: no {name}`) end\n\tend\n\tif #problems > 0 then return end\n\tlocal prey, needs, life, sensor, memory = roots.prey, roots.needs, roots.life, roots.sensor, roots.memory\n\tif getmetatable(prey) ~= PreyDirector then bad(\"world: the prey is not a prey director\") end\n\tif getmetatable(needs) ~= NeedsModel then bad(\"world: the needs are not a needs model\") end\n\tif getmetatable(life) ~= LifeLoop then bad(\"world: the life is not a life loop\") end\n\tif getmetatable(sensor) ~= Sensor then bad(\"world: the sensor is not a sensor\") end\n\tif getmetatable(memory) ~= ObservationMemory then bad(\"world: the memory is not an observation memory\") end\n\tif #problems > 0 then return end\n\t-- The reserves and their books (NeedsModel's own record check).\n\tlocal scratch = NeedsModel.new()\n\tlocal ok, rec = pcall(function() return NeedsModel.toRecord(needs) end)\n\tif not ok or not scratch:load(rec) then bad(\"needs: the reserves or their books are not valid\") end\n\t-- One needs model: the one feeding grants to is the one the life loop reports hours to.\n\tif prey.feeding == nil or prey.feeding.needs ~= needs or life.needs ~= needs then bad(\"needs: feeding and the life loop do not share the reserves\") end\n\t-- The clock and the rest.\n\tfor _, p in LifeClock.problems(if type(life.clock) == \"table\" then LifeClock.toRecord(life.clock) else nil) do bad(p) end\n\tif getmetatable(life.clock) ~= LifeClock then bad(\"life: the clock is not a life clock\") end\n\tif getmetatable(life.growth) ~= Growth then bad(\"growth: missing growth state\")\n else\n  for _,p in Growth.problems(life.growth:toRecord()) do bad(p) end\n  if life.growth:isMoulting() and not life.resting then bad(\"growth: moult outside rest\") end\n end\n if not finite(life.grantedSeen) or life.grantedSeen<0 or life.grantedSeen>needs.grantedTotal+1e-6 then bad(\"growth: invalid food ledger cursor\") end\n if not RivalSpider.valid(life.rival) then bad(\"life: invalid rival state\") end\n -- ROBLOX-79: the mate, the mating cycle and the generation. All three are missing in a record from before (a life with no mate, stage none, generation 0).\n if not Mate.valid(life.mate) then bad(\"life: invalid mate state\") end\n for _, text in Mating.problemsWith(life.mating, life.mate) do bad(text) end\n if not Nature.validCold(life.cold_day) then bad(\"life: invalid cold morning\") end -- (ROBLOX-106: optional, set by a night out in the garden)\n if life.generation ~= nil and not (finite(life.generation) and life.generation >= 0 and life.generation <= 1e6 and life.generation % 1 == 0) then bad(\"life: invalid generation\") end\n -- ROBLOX-120: where this generation began (Life/Ballooning): absent in every record before, and in a generation that stayed at the hut; a zone that can be landed in,\n -- and its landing region with it.\n if life.start_zone ~= nil and (not Ballooning.valid(life.start_zone) or life.start_zone == Ballooning.HUT) then bad(\"life: invalid start zone\") end\n if life.start_region ~= nil and (life.start_zone == nil or not Ballooning.landsIn(life.start_zone, life.start_region)) then bad(\"life: invalid start region\") end\n if life.start_zone ~= nil and life.start_region == nil then bad(\"life: a start zone with no landing\") end\n for _,text in RareDirector.problems(life) do bad(\"life: \"..text) end\n -- ROBLOX-91: where this generation's grace began (Mating.grace); absent in a record from before (the first generation's: the sill's own day and meals).\n for _, k in { \"born\", \"mealsBase\" } do\n  local v = life[k]\n  if v ~= nil and not (finite(v) and v >= 0 and v <= 1e9 and v % 1 == 0) then bad(\"life: invalid \" .. k) end\n end\n if type(life.resting) ~= \"boolean\" then bad(\"life: 'resting' is not true or false\") end\n\t-- The flies: unique ids, a known state, finite places, a meal no bigger than the profile's (ROBLOX-96: each profile's own; the fruit fly's was special-cased\n\t-- before), perches held only by flies that exist. The same checks for each region's director outside (the `garden` root); `ids` is every fly of the world.\n\tlocal every: { [any]: boolean } = {} -- every fly of the world, by identity\n\tlocal states = { PERCHED = true, ALERT = true, TAKEOFF = true, FLEE = true, SEEK_PERCH = true, REPOSITION = true, CAPTURED = true, CONSUMED = true, HOP = true }\n\tlocal function checkFlies(director: any, label: string): boolean\n\t\tif type(director.flies) ~= \"table\" then\n\t\t\tbad(`{label}: no list of flies`)\n\t\t\treturn false\n\t\tend\n\t\tlocal ids: { [string]: any } = {}\n\t\tfor i, f in director.flies do\n\t\t\tif getmetatable(f) ~= Fly or type(f.id) ~= \"string\" then\n\t\t\t\tbad(`{label}: fly {i} is not a fly`)\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tif ids[f.id] then bad(`{label}: two flies called {f.id}`) end\n\t\t\tids[f.id] = f\n\t\t\tevery[f] = true\n\t\t\tif not states[f.state] then bad(`{label}: {f.id} is in no known state`) end\n\t\t\tif typeof(f.position) ~= \"Vector3\" and type(f.position) ~= \"table\" then bad(`{label}: {f.id} has no position`) end\n\t\t\tif type(f.profile) ~= \"table\" or type(f.profile.body) ~= \"table\" or not finite(f.profile.body.nutrition) then bad(`{label}: {f.id} has no profile`)\n\t\t\telseif not finite(f.nutrition) or f.nutrition < 0 or f.nutrition > f.profile.body.nutrition + 1e-9 then bad(`{label}: {f.id}'s nutrition is out of range`) end\n\t\t\tif f.flight == nil or f.flight.fly ~= f then bad(`{label}: {f.id}'s flight is not its own`) end\n\t\tend\n\t\tif type(director.graph) == \"table\" and type(director.graph.perches) == \"table\" then\n\t\t\tfor _, p in director.graph.perches do\n\t\t\t\tif p.occupant ~= \"\" and (ids[p.occupant] == nil or not ids[p.occupant]:alive()) then bad(`{label}: perch {p.id} is held by {p.occupant}, which is not a living fly`) end\n\t\t\t\tif p.reserved ~= \"\" and ids[p.reserved] == nil then bad(`{label}: perch {p.id} is reserved by {p.reserved}, which is not a fly`) end\n\t\t\tend\n\t\telse\n\t\t\tbad(`{label}: no perches`)\n\t\tend\n\t\treturn true\n\tend\n\tif not checkFlies(prey, \"prey\") then return end\n\t-- ROBLOX-96: the regions outside. Each a region of the map with prey of its own, its director a director sharing the jaws, its woodlice inside the region.\n\tlocal garden = roots.garden\n\tif garden ~= nil then\n\t\tif type(garden) ~= \"table\" or getmetatable(garden) ~= nil then\n\t\t\tbad(\"garden: not a record of regions\")\n\t\telse\n\t\t\tfor id, entry in garden do\n\t\t\t\tlocal region = if type(id) == \"string\" then (if legacyCompact then CompactMigration.legacyRegion(id) else WorldMap.region(id)) else nil\n\t\t\t\tlocal kinds: any = if region ~= nil then Garden.bestiary(region) else nil\n\t\t\t\tif legacyCompact and region~=nil and region.kind==\"verge\" then kinds={{kind=\"springtail\"},{kind=\"housefly\"}} end\n\t\t\t\t-- (ROBLOX-116: or with woodlice or ambient bugs alone, as the hut garden's lawn has)\n\t\t\t\tif region == nil or (Garden.prey(region) == nil and kinds == nil and Garden.bugs(region) == nil and Garden.ambient(region) == nil) then bad(`garden: {tostring(id)} is not a region with prey`); continue end\n\t\t\t\tif type(entry) ~= \"table\" or getmetatable(entry) ~= nil then bad(`garden: {id} is not a record`); continue end\n\t\t\t\tif entry.prey ~= nil then\n\t\t\t\t\tif getmetatable(entry.prey) ~= PreyDirector then bad(`garden: {id}'s prey is not a prey director`)\n\t\t\t\t\telse\n\t\t\t\t\t\tif entry.prey.feeding ~= prey.feeding then bad(`garden: {id}'s prey does not eat with the sill's jaws`) end\n\t\t\t\t\t\tcheckFlies(entry.prey, `garden {id}`)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif entry.prey ~= nil and Garden.prey(region) == nil then bad(`garden: {id} has no prey of the bed's kind`) end\n\t\t\t\t-- ROBLOX-101: the bestiary's directors, one per kind the region has\n\t\t\t\tif entry.kinds ~= nil then\n\t\t\t\t\tif type(entry.kinds) ~= \"table\" or getmetatable(entry.kinds) ~= nil then bad(`garden: {id}'s kinds are not a record`)\n\t\t\t\t\telse\n\t\t\t\t\t\tlocal known: { [string]: boolean } = {}\n\t\t\t\t\t\tfor _, k in (kinds or {}) :: { any } do known[k.kind] = true end\n\t\t\t\t\t\tfor kind, d in entry.kinds do\n\t\t\t\t\t\t\tif type(kind) ~= \"string\" or not known[kind] then bad(`garden: {id} has no prey of the kind {tostring(kind)}`)\n\t\t\t\t\t\t\telseif getmetatable(d) ~= PreyDirector then bad(`garden: {id}'s {kind} is not a prey director`)\n\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\tif d.feeding ~= prey.feeding then bad(`garden: {id}'s {kind} does not eat with the sill's jaws`) end\n\t\t\t\t\t\t\t\tcheckFlies(d, `garden {id} {kind}`)\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif entry.bugs ~= nil then\n\t\t\t\t\tif getmetatable(entry.bugs) ~= Woodlice then bad(`garden: {id}'s bugs are not woodlice`)\n\t\t\t\t\telse for _, text in entry.bugs:problems(region.bounds[1], region.bounds[2]) do bad(`garden: {id}: {text}`) end end\n\t\t\t\tend\n\t\t\t\t-- ROBLOX-105: the ambient bugs' colonies, one per kind the region has, each of its kind's class\n\t\t\t\tif entry.ambient ~= nil then\n\t\t\t\t\tif type(entry.ambient) ~= \"table\" or getmetatable(entry.ambient) ~= nil then bad(`garden: {id}'s ambient bugs are not a record`)\n\t\t\t\t\telse\n\t\t\t\t\t\tlocal known: { [string]: boolean } = {}\n\t\t\t\t\t\tfor _, a in (Garden.ambient(region) or {}) :: { any } do known[a.kind] = true end\n\t\t\t\t\t\tlocal classes = { ladybird = Ladybirds, millipede = Millipedes, snail = Snails, harvestman = Harvestmen, ant = Ants, skater = Skaters } :: { [string]: any }\n\t\t\t\t\t\tfor kind, c in entry.ambient do\n\t\t\t\t\t\t\tif type(kind) ~= \"string\" or not known[kind] then bad(`garden: {id} has no ambient bug of the kind {tostring(kind)}`)\n\t\t\t\t\t\t\telseif getmetatable(c) ~= classes[kind] then bad(`garden: {id}'s {kind} is not a colony of its kind`)\n\t\t\t\t\t\t\telse for _, text in c:problems(region.bounds[1], region.bounds[2]) do bad(`garden: {id}: {text}`) end end\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t-- The meal in the jaws.\n\tlocal held = prey.feeding.held\n\tif held ~= nil then\n\t\tif not every[held] or held.state ~= \"CAPTURED\" then bad(\"feeding: the prey in the jaws is not a caught fly of this world\") end\n\tend\n\tlocal sum = 0\n\tfor _, g in prey.feeding.ledger do\n\t\tif not finite(g) or g < 0 then bad(\"feeding: a meal's energy is not a number\") end\n\t\tsum += if finite(g) then g else 0\n\tend\n\tif math.abs(sum - prey.feeding.granted) > 1e-6 then bad(\"feeding: the meals' energy does not add up\") end\n\tif prey.feeding.granted > needs.grantedTotal + 1e-6 then bad(\"feeding: more energy was eaten than the reserves were given\") end\nend\n\n-- Every problem with `record` (an empty list for a good one), and the rebuilt world when it is good. Nothing live changes.\nfunction Checkpoint.check(record: any, world: World): ({ string }, ObjectRecord.Decoded?)\n\tlocal problems: { string } = {}\n\tlocal function bad(t: string) table.insert(problems, t) end\n\tif type(record) ~= \"table\" then return { \"not a checkpoint\" }, nil end\n\tlocal sv = record.schema_version\n\tif not finite(sv) or sv ~= math.floor(sv) or sv < 1 then\n\t\treturn { \"the schema version is not a whole number\" }, nil\n\tend\n\tif sv > Checkpoint.SCHEMA_VERSION then\n\t\treturn { `made by a newer version of the game (schema {sv}; this one reads up to {Checkpoint.SCHEMA_VERSION})` }, nil\n\tend\n\tif record.kind ~= Checkpoint.KIND then bad(\"not a retreat checkpoint\") end\n\tif record.game ~= Checkpoint.GAME then bad(\"not a checkpoint of this game\") end\n\tif record.content_revision ~= Checkpoint.CONTENT_REVISION then bad(`made for another windowsill ({tostring(record.content_revision)})`) end\n\tif not finite(record.snapshot_tick) or record.snapshot_tick < 0 then bad(\"the tick is not a number\") end\n\t-- ROBLOX-94: which region the rest was kept in, and whether this is the world it was kept in.\n\tlocal map, mapProblemList = mapRecord(record)\n\tfor _, text in mapProblemList do bad(text) end\n\tlocal elsewhere = otherWorld(record)\n\tlocal region = if elsewhere then nil else WorldMap.region(map.region)\n\tif #mapProblemList == 0 and region == nil and not elsewhere then bad(\"the spider is in a region this world does not have\") end\n\tlocal moved = Checkpoint.worldMoved(record)\n\tif region ~= nil and #mapProblemList == 0 and map.retreat ~= \"\" and not hasRetreat(region, map.retreat) then bad(\"the spider is in an unknown retreat\") end\n\tlocal p = record.player\n\tif type(p) ~= \"table\" then\n\t\tbad(\"no spider\")\n\telse\n\t\tlocal pos, n, h = vec(p.position), vec(p.normal), vec(p.heading)\n\t\tif not pos then bad(\"the spider has no position\")\n\t\telseif region ~= nil and not moved and not WorldMap.inBounds(pos, region.id) then\n\t\t\tbad(if region.id == WorldMap.HOME then \"the spider is outside the windowsill\" else `the spider is outside {region.id}`) -- (a rest from another world is put back at the spawn: its position is not tested)\n\t\tend\n\t\tif not n or math.abs(n.Magnitude - 1) > 1e-3 then bad(\"the spider's surface normal is not a unit vector\") end\n\t\tif not h or math.abs(h.Magnitude - 1) > 1e-3 then bad(\"the spider's heading is not a unit vector\") end\n\t\tif not finite(p.gaze_pitch) or math.abs(p.gaze_pitch) > math.pi / 2 then bad(\"the spider's gaze is not a number\") end\n\t\tif p.state ~= \"ATTACHED\" then bad(\"the spider is not standing on a surface\") end\n\t\tif p.retreat_id ~= \"\" and (type(p.retreat_id) ~= \"string\" or (region ~= nil and not hasRetreat(region, p.retreat_id)) or (region == nil and not elsewhere and WorldMap.retreat(p.retreat_id) == nil)) then bad(\"the spider is in an unknown retreat\") end\n\t\t-- The player block's retreat and the world record's are one answer written twice (capture writes both from the same lookup); a record where they differ was not made by a capture.\n\t\tif type(record.world_map) == \"table\" and #mapProblemList == 0 and p.retreat_id ~= map.retreat then bad(\"the spider's retreat and the world record's retreat disagree\") end\n\tend\n\tif not Breakaway.valid(record.breakaway) then bad(\"invalid falling leaf state\") end\n\tlocal rules = record.life_rules\n\tif record.schema_version >= 2 and rules == nil then bad(\"missing life rules\") end\n\tif rules ~= nil and (type(rules) ~= \"table\" or (rules.mode ~= \"main\" and rules.mode ~= \"free\") or (rules.rules ~= \"standard\" and rules.rules ~= \"gentle\") or (rules.mode == \"free\" and rules.rules ~= \"gentle\")) then bad(\"invalid life rules\") end\n\tif record.wasp ~= nil then\n\t\tfor _, text in WaspDirector.problems(record.wasp) do bad(text) end\n\tend\n\tif record.cat ~= nil then\n\t\tfor _, text in Cat.problems(record.cat) do bad(text) end\n\tend\n\tif record.water ~= nil then\n\t\tfor _, text in Water.problems(record.water) do bad(text) end\n\tend\n\tif #problems > 0 then return problems, nil end\n\tlocal decoded, why = ObjectRecord.decode(record.world, Checkpoint.CLASSES, Checkpoint.refs(world))\n\tif not decoded then\n\t\tfor _